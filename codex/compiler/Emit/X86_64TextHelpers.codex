Chapter: X86-64 Code Generator

Section: __str_eq
  emit-str-eq-head : CodegenState -> StrEqHeadResult
  emit-str-eq-head (st) =
    let st0 = record-func-offset st "__str_eq"
   in let st1 = st-append-code st0 (cmp-rr reg-rdi reg-rsi)
   in let not-same-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ne 0)
   in let st3 = st-append-code st2 (li reg-rax 1)
   in let st4 = st-append-code st3 x86-ret
   in let st5 = patch-jcc-at st4 not-same-pos (st4.code-len)
   in let st6 = st-append-code st5 (mov-load reg-rcx reg-rdi 0)
   in let st7 = st-append-code st6 (mov-load reg-rdx reg-rsi 0)
   in let st8 = st-append-code st7 (cmp-rr reg-rcx reg-rdx)
   in let len-ne-pos = st8.code-len
   in let st9 = st-append-code st8 (jcc cc-ne 0)
   in StrEqHeadResult {
    cg = st9,
    len-ne-pos = len-ne-pos
   }

  emit-str-eq-byte-loop : CodegenState -> StrEqLoopResult
  emit-str-eq-byte-loop (st) =
    let st0 = st-append-code st (li reg-r11 0)
   in let loop-pos = st0.code-len
   in let st1 = st-append-code st0 (cmp-rr reg-r11 reg-rcx)
   in let loop-done-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ge 0)
   in let st3 = st-append-code st2 (mov-rr reg-rax reg-rdi)
   in let st4 = st-append-code st3 (add-rr reg-rax reg-r11)
   in let st5 = st-append-code st4 (movzx-byte reg-rax reg-rax 8)
   in let st6 = st-append-code st5 (mov-rr reg-rdx reg-rsi)
   in let st7 = st-append-code st6 (add-rr reg-rdx reg-r11)
   in let st8 = st-append-code st7 (movzx-byte reg-rdx reg-rdx 8)
   in let st9 = st-append-code st8 (cmp-rr reg-rax reg-rdx)
   in let byte-ne-pos = st9.code-len
   in let st10 = st-append-code st9 (jcc cc-ne 0)
   in let st11 = st-append-code st10 (add-ri reg-r11 1)
   in let st12 = st-append-code st11 (jmp (loop-pos - (st11.code-len + 5)))
   in StrEqLoopResult {
    cg = st12,
    loop-done-pos = loop-done-pos,
    byte-ne-pos = byte-ne-pos
   }

  emit-str-eq : CodegenState -> CodegenState
  emit-str-eq (st) =
    let head = emit-str-eq-head st
   in let lp = emit-str-eq-byte-loop (head.cg)
   in let st1 = patch-jcc-at (lp.cg) (lp.loop-done-pos) (lp.cg.code-len)
   in let st2 = st-append-code st1 (li reg-rax 1)
   in let st3 = st-append-code st2 x86-ret
   in let st4 = patch-jcc-at st3 (head.len-ne-pos) (st3.code-len)
   in let st5 = patch-jcc-at st4 (lp.byte-ne-pos) (st4.code-len)
   in let st6 = st-append-code st5 (li reg-rax 0)
   in st-append-code st6 x86-ret

Section: __itoa
  emit-itoa-setup : CodegenState -> CodegenState
  emit-itoa-setup (st) =
    let st0 = record-func-offset st "__itoa"
   in let st1 = st-append-code st0 (push-r reg-rbx)
   in let st2 = st-append-code st1 (push-r reg-r12)
   in let st3 = st-append-code st2 (sub-ri reg-rsp 32)
   in let st4 = st-append-code st3 (mov-rr reg-rbx reg-rdi)
   in let st5 = st-append-code st4 (li reg-r12 0)
   in let st6 = st-append-code st5 (cmp-ri reg-rbx 0)
   in let not-neg-pos = st6.code-len
   in let st7 = st-append-code st6 (jcc cc-ge 0)
   in let st8 = st-append-code st7 (neg-r reg-rbx)
   in let st9 = st-append-code st8 (li reg-r12 1)
   in patch-jcc-at st9 not-neg-pos (st9.code-len)

  emit-itoa-zero-guard : CodegenState -> ItoaZeroResult
  emit-itoa-zero-guard (st) =
    let st0 = st-append-code st (li reg-rcx 0)
   in let st1 = st-append-code st0 (li reg-r11 10)
   in let st2 = st-append-code st1 (test-rr reg-rbx reg-rbx)
   in let not-zero-pos = st2.code-len
   in let st3 = st-append-code st2 (jcc cc-ne 0)
   in let st4 = st-append-code st3 (li reg-rsi 3)
   in let st5 = st-append-code st4 (mov-store-byte reg-rsp reg-rsi 0)
   in let st6 = st-append-code st5 (li reg-rcx 1)
   in let skip-digits-pos = st6.code-len
   in let st7 = st-append-code st6 (jmp 0)
   in let st8 = patch-jcc-at st7 not-zero-pos (st7.code-len)
   in ItoaZeroResult {
    cg = st8,
    skip-digits-pos = skip-digits-pos
   }

  emit-itoa-digit-loop : CodegenState -> CodegenState
  emit-itoa-digit-loop (st) =
    let digit-loop = st.code-len
   in let st0 = st-append-code st (test-rr reg-rbx reg-rbx)
   in let digit-done-pos = st0.code-len
   in let st1 = st-append-code st0 (jcc cc-e 0)
   in let st2 = st-append-code st1 (mov-rr reg-rax reg-rbx)
   in let st3 = st-append-code st2 (xor-rr reg-rdx reg-rdx)
   in let st4 = st-append-code st3 (div-r reg-r11)
   in let st5 = st-append-code st4 (mov-rr reg-rbx reg-rax)
   in let st6 = st-append-code st5 (add-ri reg-rdx 3)
   in let st7 = st-append-code st6 (mov-rr reg-rsi reg-rsp)
   in let st8 = st-append-code st7 (add-rr reg-rsi reg-rcx)
   in let st9 = st-append-code st8 (mov-store-byte reg-rsi reg-rdx 0)
   in let st10 = st-append-code st9 (add-ri reg-rcx 1)
   in let st11 = st-append-code st10 (jmp (digit-loop - (st10.code-len + 5)))
   in patch-jcc-at st11 digit-done-pos (st11.code-len)

  emit-itoa-heap-alloc : CodegenState -> CodegenState
  emit-itoa-heap-alloc (st) =
    let st0 = st-append-code st (mov-rr reg-rdx reg-rcx)
   in let st1 = st-append-code st0 (add-rr reg-rdx reg-r12)
   in let st2 = st-append-code st1 (mov-rr reg-rax reg-r10)
   in let st3 = st-append-code st2 (mov-rr reg-rsi reg-rdx)
   in let st4 = st-append-code st3 (add-ri reg-rsi 15)
   in let st5 = st-append-code st4 (and-ri reg-rsi (-8))
   in let st6 = heap-bump-reg st5 reg-rsi
   in let st7 = st-append-code st6 (mov-store reg-rax reg-rdx 0)
   in let st8 = st-append-code st7 (li reg-r11 0)
   in let st9 = st-append-code st8 (test-rr reg-r12 reg-r12)
   in let no-minus-pos = st9.code-len
   in let st10 = st-append-code st9 (jcc cc-e 0)
   in let st11 = st-append-code st10 (li reg-rsi 73)
   in let st12 = st-append-code st11 (mov-store-byte reg-rax reg-rsi 8)
   in let st13 = st-append-code st12 (li reg-r11 1)
   in patch-jcc-at st13 no-minus-pos (st13.code-len)

  emit-itoa-copy-and-epilogue : CodegenState -> CodegenState
  emit-itoa-copy-and-epilogue (st) =
    let copy-loop = st.code-len
   in let st0 = st-append-code st (test-rr reg-rcx reg-rcx)
   in let copy-done-pos = st0.code-len
   in let st1 = st-append-code st0 (jcc cc-e 0)
   in let st2 = st-append-code st1 (sub-ri reg-rcx 1)
   in let st3 = st-append-code st2 (mov-rr reg-rsi reg-rsp)
   in let st4 = st-append-code st3 (add-rr reg-rsi reg-rcx)
   in let st5 = st-append-code st4 (movzx-byte reg-rsi reg-rsi 0)
   in let st6 = st-append-code st5 (mov-rr reg-rdx reg-rax)
   in let st7 = st-append-code st6 (add-rr reg-rdx reg-r11)
   in let st8 = st-append-code st7 (mov-store-byte reg-rdx reg-rsi 8)
   in let st9 = st-append-code st8 (add-ri reg-r11 1)
   in let st10 = st-append-code st9 (jmp (copy-loop - (st9.code-len + 5)))
   in let st11 = patch-jcc-at st10 copy-done-pos (st10.code-len)
   in let st12 = st-append-code st11 (add-ri reg-rsp 32)
   in let st13 = st-append-code st12 (pop-r reg-r12)
   in let st14 = st-append-code st13 (pop-r reg-rbx)
   in st-append-code st14 x86-ret

  emit-itoa : CodegenState -> CodegenState
  emit-itoa (st) =
    let st0 = emit-itoa-setup st
   in let zero = emit-itoa-zero-guard st0
   in let st1 = emit-itoa-digit-loop (zero.cg)
   in let st2 = patch-jmp-at st1 (zero.skip-digits-pos) (st1.code-len)
   in let st3 = emit-itoa-heap-alloc st2
   in emit-itoa-copy-and-epilogue st3

Section: __str_concat
  emit-str-concat-prologue : CodegenState, Text -> CodegenState
  emit-str-concat-prologue (st) (name) =
    let st0 = record-func-offset st name
   in let st1 = st-append-code st0 (push-r reg-rbx)
   in let st2 = st-append-code st1 (push-r reg-r12)
   in let st3 = st-append-code st2 (push-r reg-r13)
   in let st4 = st-append-code st3 (mov-rr reg-rbx reg-rdi)
   in let st5 = st-append-code st4 (mov-rr reg-r12 reg-rsi)
   in let st6 = st-append-code st5 (mov-load reg-rcx reg-rbx 0)
   in st-append-code st6 (mov-load reg-rdx reg-r12 0)

  emit-str-concat-topmost-check : CodegenState -> StrConcatCheckResult
  emit-str-concat-topmost-check (st) =
    let st8 = st-append-code st (mov-rr reg-r11 reg-rcx)
   in let st9 = st-append-code st8 (add-ri reg-r11 15)
   in let st10 = st-append-code st9 (and-ri reg-r11 (-8))
   in let st11 = st-append-code st10 (mov-rr reg-r13 reg-rbx)
   in let st12 = st-append-code st11 (add-rr reg-r13 reg-r11)
   in let st13 = st-append-code st12 (cmp-rr reg-r13 reg-r10)
   in let slow-path-pos = st13.code-len
   in let st14 = st-append-code st13 (jcc cc-ne 0)
   in StrConcatCheckResult {
    cg = st14,
    slow-path-pos = slow-path-pos
   }

  emit-str-concat-fast-copy : CodegenState -> CodegenState
  emit-str-concat-fast-copy (st) =
    let st0 = st-append-code st (mov-rr reg-r13 reg-rcx)
   in let st1 = st-append-code st0 (add-rr reg-r13 reg-rdx)
   in let st2 = st-append-code st1 (mov-store reg-rbx reg-r13 0)
   in let st3 = st-append-code st2 (li reg-r11 0)
   in let fast-loop = st3.code-len
   in let st4 = st-append-code st3 (cmp-rr reg-r11 reg-rdx)
   in let fast-exit-pos = st4.code-len
   in let st5 = st-append-code st4 (jcc cc-ge 0)
   in let st6 = st-append-code st5 (mov-rr reg-rsi reg-r12)
   in let st7 = st-append-code st6 (add-rr reg-rsi reg-r11)
   in let st8 = st-append-code st7 (movzx-byte reg-rsi reg-rsi 8)
   in let st9 = st-append-code st8 (mov-rr reg-rdi reg-rbx)
   in let st10 = st-append-code st9 (add-rr reg-rdi reg-rcx)
   in let st11 = st-append-code st10 (add-rr reg-rdi reg-r11)
   in let st12 = st-append-code st11 (mov-store-byte reg-rdi reg-rsi 8)
   in let st13 = st-append-code st12 (add-ri reg-r11 1)
   in let st14 = st-append-code st13 (jmp (fast-loop - (st13.code-len + 5)))
   in patch-jcc-at st14 fast-exit-pos (st14.code-len)

  emit-str-concat-fast-bump : CodegenState -> StrConcatFastResult
  emit-str-concat-fast-bump (st) =
    let st0 = st-append-code st (mov-rr reg-r11 reg-r13)
   in let st1 = st-append-code st0 (add-ri reg-r11 15)
   in let st2 = st-append-code st1 (and-ri reg-r11 (-8))
   in let st3 = st-append-code st2 (lea reg-r10 reg-rbx 0)
   in let st4 = heap-bump-reg st3 reg-r11
   in let st5 = st-append-code st4 (mov-rr reg-rax reg-rbx)
   in let fast-done-pos = st5.code-len
   in let st6 = st-append-code st5 (jmp 0)
   in StrConcatFastResult {
    cg = st6,
    fast-done-pos = fast-done-pos
   }

  emit-str-concat-slow-alloc : CodegenState -> CodegenState
  emit-str-concat-slow-alloc (st) =
    let st1 = st-append-code st (mov-rr reg-r13 reg-rcx)
   in let st2 = st-append-code st1 (add-rr reg-r13 reg-rdx)
   in let st3 = st-append-code st2 (mov-rr reg-rax reg-r10)
   in let st4 = st-append-code st3 (mov-rr reg-r11 reg-r13)
   in let st5 = st-append-code st4 (add-ri reg-r11 15)
   in let st6 = st-append-code st5 (and-ri reg-r11 (-8))
   in let st7 = heap-bump-reg st6 reg-r11
   in st-append-code st7 (mov-store reg-rax reg-r13 0)

  emit-str-concat-slow-copy1 : CodegenState -> CodegenState
  emit-str-concat-slow-copy1 (st) =
    let st0 = st-append-code st (mov-load reg-rcx reg-rbx 0)
   in let st1 = st-append-code st0 (li reg-r11 0)
   in let loop1 = st1.code-len
   in let st2 = st-append-code st1 (cmp-rr reg-r11 reg-rcx)
   in let exit1-pos = st2.code-len
   in let st3 = st-append-code st2 (jcc cc-ge 0)
   in let st4 = st-append-code st3 (mov-rr reg-rdx reg-rbx)
   in let st5 = st-append-code st4 (add-rr reg-rdx reg-r11)
   in let st6 = st-append-code st5 (movzx-byte reg-rdx reg-rdx 8)
   in let st7 = st-append-code st6 (mov-rr reg-rsi reg-rax)
   in let st8 = st-append-code st7 (add-rr reg-rsi reg-r11)
   in let st9 = st-append-code st8 (mov-store-byte reg-rsi reg-rdx 8)
   in let st10 = st-append-code st9 (add-ri reg-r11 1)
   in let st11 = st-append-code st10 (jmp (loop1 - (st10.code-len + 5)))
   in patch-jcc-at st11 exit1-pos (st11.code-len)

  emit-str-concat-slow-copy2 : CodegenState -> CodegenState
  emit-str-concat-slow-copy2 (st) =
    let st0 = st-append-code st (mov-load reg-rcx reg-rbx 0)
   in let st1 = st-append-code st0 (mov-load reg-rdx reg-r12 0)
   in let st2 = st-append-code st1 (li reg-r11 0)
   in let loop2 = st2.code-len
   in let st3 = st-append-code st2 (cmp-rr reg-r11 reg-rdx)
   in let exit2-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ge 0)
   in let st5 = st-append-code st4 (mov-rr reg-rsi reg-r12)
   in let st6 = st-append-code st5 (add-rr reg-rsi reg-r11)
   in let st7 = st-append-code st6 (movzx-byte reg-rsi reg-rsi 8)
   in let st8 = st-append-code st7 (mov-rr reg-rdi reg-rax)
   in let st9 = st-append-code st8 (add-rr reg-rdi reg-rcx)
   in let st10 = st-append-code st9 (add-rr reg-rdi reg-r11)
   in let st11 = st-append-code st10 (mov-store-byte reg-rdi reg-rsi 8)
   in let st12 = st-append-code st11 (add-ri reg-r11 1)
   in let st13 = st-append-code st12 (jmp (loop2 - (st12.code-len + 5)))
   in patch-jcc-at st13 exit2-pos (st13.code-len)

  emit-str-concat-epilogue : CodegenState -> CodegenState
  emit-str-concat-epilogue (st) =
    let st4 = st-append-code st (pop-r reg-r13)
   in let st5 = st-append-code st4 (pop-r reg-r12)
   in let st6 = st-append-code st5 (pop-r reg-rbx)
   in st-append-code st6 x86-ret

  emit-str-concat : CodegenState -> CodegenState
  emit-str-concat (st) =
    let st0 = emit-str-concat-prologue st "__str_concat"
   in let st1 = emit-str-concat-slow-alloc st0
   in let st2 = emit-str-concat-slow-copy1 st1
   in let st3 = emit-str-concat-slow-copy2 st2
   in emit-str-concat-epilogue st3

Section: __str_concat_inplace
  emit-str-concat-inplace : CodegenState -> CodegenState
  emit-str-concat-inplace (st) =
    let st0 = emit-str-concat-prologue st "__str_concat_inplace"
   in let check = emit-str-concat-topmost-check st0
   in let st1 = emit-str-concat-fast-copy (check.cg)
   in let fast = emit-str-concat-fast-bump st1
   in let st2 = patch-jcc-at (fast.cg) (check.slow-path-pos) ((fast.cg).code-len)
   in let st3 = emit-str-concat-slow-alloc st2
   in let st4 = emit-str-concat-slow-copy1 st3
   in let st5 = emit-str-concat-slow-copy2 st4
   in let st6 = patch-jmp-at st5 (fast.fast-done-pos) (st5.code-len)
   in emit-str-concat-epilogue st6

Section: __str_own
  emit-str-own : CodegenState -> CodegenState
  emit-str-own (st) =
    let st0 = record-func-offset st "__str_own"
   in let st1 = st-append-code st0 (mov-load reg-rcx reg-rdi 0)
   in let st2 = st-append-code st1 (add-ri reg-rcx 15)
   in let st3 = st-append-code st2 (and-ri reg-rcx (-8))
   in let st4 = st-append-code st3 (add-rr reg-rcx reg-rdi)
   in let st5 = st-append-code st4 (cmp-rr reg-rcx reg-r10)
   in let skip-pos = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-ne 0)
   in let st7 = heap-bump-imm st6 16
   in let st8 = patch-jcc-at st7 skip-pos (st7.code-len)
   in st-append-code st8 x86-ret

Section: __deck_str_concat

  emit-deck-str-concat-prologue : CodegenState -> CodegenState
  emit-deck-str-concat-prologue (st) =
    let st0 = record-func-offset st "__deck_str_concat"
   in let st1 = st-append-code st0 (push-r reg-rbx)
   in let st2 = st-append-code st1 (push-r reg-r12)
   in let st3 = st-append-code st2 (push-r reg-r13)
   in let st4 = st-append-code st3 (push-r reg-r14)
   in let st5 = st-append-code st4 (li reg-r11 (st-cell st4 deck-pos-addr))
   in let st6 = st-append-code st5 (mov-load reg-r14 reg-r11 0)
   in let st7 = st-append-code st6 (mov-rr reg-rbx reg-rdi)
   in let st8 = st-append-code st7 (mov-rr reg-r12 reg-rsi)
   in let st9 = st-append-code st8 (mov-load reg-rcx reg-rbx 0)
   in let st10 = st-append-code st9 (mov-load reg-rdx reg-r12 0)
   in let st11 = st-append-code st10 (mov-rr reg-r13 reg-rcx)
   in let st12 = st-append-code st11 (add-rr reg-r13 reg-rdx)
   in let st13 = st-append-code st12 (mov-rr reg-rax reg-r14)
   in let st14 = st-append-code st13 (mov-rr reg-r11 reg-r13)
   in let st15 = st-append-code st14 (add-ri reg-r11 15)
   in let st16 = st-append-code st15 (and-ri reg-r11 (-8))
   in let st17 = st-append-code st16 (add-rr reg-r14 reg-r11)
   in st-append-code st17 (mov-store reg-rax reg-r13 0)

  emit-deck-str-concat-copy1 : CodegenState -> CodegenState
  emit-deck-str-concat-copy1 (st) =
    let st0 = st-append-code st (mov-load reg-rcx reg-rbx 0)
   in let st1 = st-append-code st0 (li reg-r11 0)
   in let loop1 = st1.code-len
   in let st2 = st-append-code st1 (cmp-rr reg-r11 reg-rcx)
   in let exit1-pos = st2.code-len
   in let st3 = st-append-code st2 (jcc cc-ge 0)
   in let st4 = st-append-code st3 (mov-rr reg-rdx reg-rbx)
   in let st5 = st-append-code st4 (add-rr reg-rdx reg-r11)
   in let st6 = st-append-code st5 (movzx-byte reg-rdx reg-rdx 8)
   in let st7 = st-append-code st6 (mov-rr reg-rsi reg-rax)
   in let st8 = st-append-code st7 (add-rr reg-rsi reg-r11)
   in let st9 = st-append-code st8 (mov-store-byte reg-rsi reg-rdx 8)
   in let st10 = st-append-code st9 (add-ri reg-r11 1)
   in let st11 = st-append-code st10 (jmp (loop1 - (st10.code-len + 5)))
   in patch-jcc-at st11 exit1-pos (st11.code-len)

  emit-deck-str-concat-copy2 : CodegenState -> CodegenState
  emit-deck-str-concat-copy2 (st) =
    let st0 = st-append-code st (mov-load reg-rcx reg-rbx 0)
   in let st1 = st-append-code st0 (mov-load reg-rdx reg-r12 0)
   in let st2 = st-append-code st1 (li reg-r11 0)
   in let loop2 = st2.code-len
   in let st3 = st-append-code st2 (cmp-rr reg-r11 reg-rdx)
   in let exit2-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-ge 0)
   in let st5 = st-append-code st4 (mov-rr reg-rsi reg-r12)
   in let st6 = st-append-code st5 (add-rr reg-rsi reg-r11)
   in let st7 = st-append-code st6 (movzx-byte reg-rsi reg-rsi 8)
   in let st8 = st-append-code st7 (mov-rr reg-rdi reg-rax)
   in let st9 = st-append-code st8 (add-rr reg-rdi reg-rcx)
   in let st10 = st-append-code st9 (add-rr reg-rdi reg-r11)
   in let st11 = st-append-code st10 (mov-store-byte reg-rdi reg-rsi 8)
   in let st12 = st-append-code st11 (add-ri reg-r11 1)
   in let st13 = st-append-code st12 (jmp (loop2 - (st12.code-len + 5)))
   in patch-jcc-at st13 exit2-pos (st13.code-len)

  emit-deck-str-concat-tail : CodegenState -> CodegenState
  emit-deck-str-concat-tail (st) =
    let st0 = st-append-code st (li reg-r11 (st-cell st deck-pos-addr))
   in let st1 = st-append-code st0 (mov-store reg-r11 reg-r14 0)
   in let st2 = st-append-code st1 (pop-r reg-r14)
   in let st3 = st-append-code st2 (pop-r reg-r13)
   in let st4 = st-append-code st3 (pop-r reg-r12)
   in let st5 = st-append-code st4 (pop-r reg-rbx)
   in st-append-code st5 x86-ret

  emit-deck-str-concat : CodegenState -> CodegenState
  emit-deck-str-concat (st) =
    let st0 = emit-deck-str-concat-prologue st
   in let st1 = emit-deck-str-concat-copy1 st0
   in let st2 = emit-deck-str-concat-copy2 st1
   in emit-deck-str-concat-tail st2

Section: __ipow
  emit-ipow-setup : CodegenState -> HelpResult2
  emit-ipow-setup (st) =
    let st0 = record-func-offset st "__ipow"
   in let st1 = st-append-code st0 (li reg-rax 1)
   in let st2 = st-append-code st1 (cmp-ri reg-rsi 0)
   in let neg-pos = st2.code-len
   in let st3 = st-append-code st2 (jcc cc-l 0)
   in let zero-pos = st3.code-len
   in let st4 = st-append-code st3 (jcc cc-e 0)
   in HelpResult2 {
    cg = st4,
    p1 = neg-pos,
    p2 = zero-pos
   }

  emit-ipow-loop : CodegenState -> CodegenState
  emit-ipow-loop (st) =
    let loop-top = st.code-len
   in let st0 = st-append-code st (mov-rr reg-rcx reg-rsi)
   in let st1 = st-append-code st0 (and-ri reg-rcx 1)
   in let skip-mul-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-e 0)
   in let st3 = st-append-code st2 (imul-rr reg-rax reg-rdi)
   in let st4 = patch-jcc-at st3 skip-mul-pos (st3.code-len)
   in let st5 = st-append-code st4 (imul-rr reg-rdi reg-rdi)
   in let st6 = st-append-code st5 (shr-ri reg-rsi 1)
   in let st7 = st-append-code st6 (cmp-ri reg-rsi 0)
   in let jmp-loop-pos = st7.code-len
   in let st8 = st-append-code st7 (jcc cc-g 0)
   in patch-jcc-at st8 jmp-loop-pos loop-top

  emit-ipow : CodegenState -> CodegenState
  emit-ipow (st) =
    let setup = emit-ipow-setup st
   in let st0 = emit-ipow-loop (setup.cg)
   in let st1 = patch-jcc-at st0 (setup.p2) (st0.code-len)
   in let st2 = st-append-code st1 x86-ret
   in let st3 = patch-jcc-at st2 (setup.p1) (st2.code-len)
   in let st4 = st-append-code st3 (li reg-rax 0)
   in st-append-code st4 x86-ret

Section: __text_to_int
  emit-text-to-int-setup : CodegenState -> HelpResult1
  emit-text-to-int-setup (st) =
    let st0 = record-func-offset st "__text_to_int"
   in let st1 = st-append-code st0 (mov-load reg-rcx reg-rdi 0)
   in let st2 = st-append-code st1 (lea reg-rdi reg-rdi 8)
   in let st3 = st-append-code st2 (li reg-rax 0)
   in let st4 = st-append-code st3 (li reg-r11 0)
   in let st5 = st-append-code st4 (li reg-rsi 0)
   in let st6 = st-append-code st5 (test-rr reg-rcx reg-rcx)
   in let empty-pos = st6.code-len
   in let st7 = st-append-code st6 (jcc cc-e 0)
   in let st8 = st-append-code st7 (movzx-byte reg-rdx reg-rdi 0)
   in let st9 = st-append-code st8 (cmp-ri reg-rdx 73)
   in let not-minus-pos = st9.code-len
   in let st10 = st-append-code st9 (jcc cc-ne 0)
   in let st11 = st-append-code st10 (li reg-rsi 1)
   in let st12 = st-append-code st11 (add-ri reg-r11 1)
   in let st13 = patch-jcc-at st12 not-minus-pos (st12.code-len)
   in HelpResult1 {
    cg = st13,
    p1 = empty-pos
   }

  emit-text-to-int-parse : CodegenState -> CodegenState
  emit-text-to-int-parse (st) =
    let parse-loop = st.code-len
   in let st0 = st-append-code st (cmp-rr reg-r11 reg-rcx)
   in let parse-done-pos = st0.code-len
   in let st1 = st-append-code st0 (jcc cc-ge 0)
   in let st2 = st-append-code st1 (mov-rr reg-rdx reg-rdi)
   in let st3 = st-append-code st2 (add-rr reg-rdx reg-r11)
   in let st4 = st-append-code st3 (movzx-byte reg-rdx reg-rdx 0)
   in let st5 = st-append-code st4 (sub-ri reg-rdx 3)
   in let st5a = st-append-code st5 (cmp-ri reg-rdx 9)
   in let not-digit-pos = st5a.code-len
   in let st5b = st-append-code st5a (jcc cc-a 0)
   in let st6 = st-append-code st5b (push-r reg-rdx)
   in let st7 = st-append-code st6 (mov-rr reg-rdx reg-rax)
   in let st8 = st-append-code st7 (shl-ri reg-rax 3)
   in let st9 = st-append-code st8 (add-rr reg-rax reg-rdx)
   in let st10 = st-append-code st9 (add-rr reg-rax reg-rdx)
   in let st11 = st-append-code st10 (pop-r reg-rdx)
   in let st12 = st-append-code st11 (add-rr reg-rax reg-rdx)
   in let st13 = st-append-code st12 (add-ri reg-r11 1)
   in let st14 = st-append-code st13 (jmp (parse-loop - (st13.code-len + 5)))
   in let st15 = patch-jcc-at st14 parse-done-pos (st14.code-len)
   in patch-jcc-at st15 not-digit-pos (st15.code-len)

  emit-text-to-int : CodegenState -> CodegenState
  emit-text-to-int (st) =
    let setup = emit-text-to-int-setup st
   in let st0 = emit-text-to-int-parse (setup.cg)
   in let st1 = st-append-code st0 (test-rr reg-rsi reg-rsi)
   in let no-neg-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-e 0)
   in let st3 = st-append-code st2 (neg-r reg-rax)
   in let st4 = patch-jcc-at st3 no-neg-pos (st3.code-len)
   in let st5 = patch-jcc-at st4 (setup.p1) (st4.code-len)
   in st-append-code st5 x86-ret

Section: __text_to_double

 Correctly rounded decimal-to-binary64, one rounding. value = N * 10^(-f) is
 computed as N / 5^f scaled by 2^(-f), by binary long division of a fixed
 256-bit magnitude: den = 5^f (four 64-bit words, little-endian), R = N, then
 normalise to den <= R < 2*den, take the leading 1, and pull 53 more bits,
 rounding to nearest with ties to even from the last bit and a sticky remainder.
 Four words hold 5^f for every f a Real literal can carry (the front end refuses
 a fraction wider than 108 digits, and 5^108 < 2^256). The magic constants are
 2^54, 2^53, 2^52, and the IEEE bias 1075 = 52 + 1023.

 __ttd_shl1 (rdi = 4-word buffer): shift left by one bit across the words.

  emit-ttd-shl1 : CodegenState -> CodegenState
  emit-ttd-shl1 (st) =
    let st0 = record-func-offset st "__ttd_shl1"
   in let a0 = st-append-code st0 (mov-load reg-rax reg-rdi 0)
   in let a1 = st-append-code a0 (mov-rr reg-rcx reg-rax)
   in let a2 = st-append-code a1 (shr-ri reg-rcx 63)
   in let a3 = st-append-code a2 (shl-ri reg-rax 1)
   in let a4 = st-append-code a3 (mov-store reg-rdi reg-rax 0)
   in let b0 = st-append-code a4 (mov-load reg-rax reg-rdi 8)
   in let b1 = st-append-code b0 (mov-rr reg-rdx reg-rax)
   in let b2 = st-append-code b1 (shr-ri reg-rdx 63)
   in let b3 = st-append-code b2 (shl-ri reg-rax 1)
   in let b4 = st-append-code b3 (or-rr reg-rax reg-rcx)
   in let b5 = st-append-code b4 (mov-store reg-rdi reg-rax 8)
   in let b6 = st-append-code b5 (mov-rr reg-rcx reg-rdx)
   in let c0 = st-append-code b6 (mov-load reg-rax reg-rdi 16)
   in let c1 = st-append-code c0 (mov-rr reg-rdx reg-rax)
   in let c2 = st-append-code c1 (shr-ri reg-rdx 63)
   in let c3 = st-append-code c2 (shl-ri reg-rax 1)
   in let c4 = st-append-code c3 (or-rr reg-rax reg-rcx)
   in let c5 = st-append-code c4 (mov-store reg-rdi reg-rax 16)
   in let c6 = st-append-code c5 (mov-rr reg-rcx reg-rdx)
   in let d0 = st-append-code c6 (mov-load reg-rax reg-rdi 24)
   in let d1 = st-append-code d0 (shl-ri reg-rax 1)
   in let d2 = st-append-code d1 (or-rr reg-rax reg-rcx)
   in let d3 = st-append-code d2 (mov-store reg-rdi reg-rax 24)
   in st-append-code d3 x86-ret

 __ttd_cmp_ge (rdi = a, rsi = b): rax = 1 if a >= b else 0, unsigned, 4 words
 from the most significant down.

  emit-ttd-cmpge-word : CodegenState, Integer -> CmpWordResult
  emit-ttd-cmpge-word (st) (off) =
    let a0 = st-append-code st (mov-load reg-rax reg-rdi off)
   in let a1 = st-append-code a0 (mov-load reg-rcx reg-rsi off)
   in let a2 = st-append-code a1 (cmp-rr reg-rax reg-rcx)
   in let ge-pos = a2.code-len
   in let a3 = st-append-code a2 (jcc cc-a 0)
   in let lt-pos = a3.code-len
   in let a4 = st-append-code a3 (jcc cc-b 0)
   in CmpWordResult { cg = a4, ge = ge-pos, lt = lt-pos }

  emit-ttd-cmp-ge : CodegenState -> CodegenState
  emit-ttd-cmp-ge (st) =
    let st0 = record-func-offset st "__ttd_cmp_ge"
   in let w3 = emit-ttd-cmpge-word st0 24
   in let w2 = emit-ttd-cmpge-word (w3.cg) 16
   in let w1 = emit-ttd-cmpge-word (w2.cg) 8
   in let e0 = st-append-code (w1.cg) (mov-load reg-rax reg-rdi 0)
   in let e1 = st-append-code e0 (mov-load reg-rcx reg-rsi 0)
   in let e2 = st-append-code e1 (cmp-rr reg-rax reg-rcx)
   in let lt0-pos = e2.code-len
   in let e3 = st-append-code e2 (jcc cc-b 0)
   in let ge-pos = e3.code-len
   in let e4 = st-append-code e3 (li reg-rax 1)
   in let e5 = st-append-code e4 x86-ret
   in let lt-pos = e5.code-len
   in let e6 = st-append-code e5 (li reg-rax 0)
   in let e7 = st-append-code e6 x86-ret
   in let p1 = patch-jcc-at e7 (w3.ge) ge-pos
   in let p2 = patch-jcc-at p1 (w3.lt) lt-pos
   in let p3 = patch-jcc-at p2 (w2.ge) ge-pos
   in let p4 = patch-jcc-at p3 (w2.lt) lt-pos
   in let p5 = patch-jcc-at p4 (w1.ge) ge-pos
   in let p6 = patch-jcc-at p5 (w1.lt) lt-pos
   in patch-jcc-at p6 lt0-pos lt-pos

 __ttd_sub (rdi = a, rsi = b): a -= b, assuming a >= b. Borrow in rcx.
 MOV zero preserves CF until SETB; li zero emits XOR and clears CF.

  emit-ttd-sub-word : CodegenState, Integer, Boolean -> CodegenState
  emit-ttd-sub-word (st) (off) (top) =
    let a0 = st-append-code st (mov-load reg-rax reg-rdi off)
   in let a1 = st-append-code a0 (mov-load reg-rdx reg-rsi off)
   in let a2 = st-append-code a1 (sub-rr reg-rax reg-rdx)
   in if top
      then let t0 = st-append-code a2 (sub-rr reg-rax reg-rcx)
        in st-append-code t0 (mov-store reg-rdi reg-rax off)
      else let a3 = st-append-code a2 (mov-ri32 reg-r8 0)
        in let a4 = st-append-code a3 (setcc cc-b reg-r8)
        in let a5 = st-append-code a4 (sub-rr reg-rax reg-rcx)
        in let a6 = st-append-code a5 (mov-ri32 reg-r9 0)
        in let a7 = st-append-code a6 (setcc cc-b reg-r9)
        in let a8 = st-append-code a7 (mov-store reg-rdi reg-rax off)
        in let a9 = st-append-code a8 (mov-rr reg-rcx reg-r8)
        in st-append-code a9 (add-rr reg-rcx reg-r9)

  emit-ttd-sub : CodegenState -> CodegenState
  emit-ttd-sub (st) =
    let st0 = record-func-offset st "__ttd_sub"
   in let s0 = st-append-code st0 (li reg-rcx 0)
   in let s1 = emit-ttd-sub-word s0 0 False
   in let s2 = emit-ttd-sub-word s1 8 False
   in let s3 = emit-ttd-sub-word s2 16 False
   in let s4 = emit-ttd-sub-word s3 24 True
   in st-append-code s4 x86-ret

 __ttd_mul5 (rdi = buffer): buffer *= 5. carry in r8; per word s = (x<<2)+x+carry,
 high part accumulated from the top two bits of x plus the two add-carries.
 MOV zero preserves CF until SETB; li zero emits XOR and clears CF.

  emit-ttd-mul5-word : CodegenState, Integer -> CodegenState
  emit-ttd-mul5-word (st) (off) =
    let a0 = st-append-code st (mov-load reg-rax reg-rdi off)
   in let a1 = st-append-code a0 (mov-rr reg-rdx reg-rax)
   in let a2 = st-append-code a1 (shr-ri reg-rdx 62)
   in let a3 = st-append-code a2 (mov-rr reg-r9 reg-rax)
   in let a4 = st-append-code a3 (shl-ri reg-r9 2)
   in let a5 = st-append-code a4 (add-rr reg-r9 reg-rax)
   in let a6 = st-append-code a5 (mov-ri32 reg-r10 0)
   in let a7 = st-append-code a6 (setcc cc-b reg-r10)
   in let a8 = st-append-code a7 (add-rr reg-rdx reg-r10)
   in let a9 = st-append-code a8 (add-rr reg-r9 reg-r8)
   in let b0 = st-append-code a9 (mov-ri32 reg-r10 0)
   in let b1 = st-append-code b0 (setcc cc-b reg-r10)
   in let b2 = st-append-code b1 (add-rr reg-rdx reg-r10)
   in let b3 = st-append-code b2 (mov-store reg-rdi reg-r9 off)
   in st-append-code b3 (mov-rr reg-r8 reg-rdx)

  emit-ttd-mul5 : CodegenState -> CodegenState
  emit-ttd-mul5 (st) =
    let st0 = record-func-offset st "__ttd_mul5"
   in let m0 = st-append-code st0 (li reg-r8 0)
   in let m1 = emit-ttd-mul5-word m0 0
   in let m2 = emit-ttd-mul5-word m1 8
   in let m3 = emit-ttd-mul5-word m2 16
   in let m4 = emit-ttd-mul5-word m3 24
   in st-append-code m4 x86-ret

 The main entry. rdi = text object (length at [rdi], bytes at [rdi+8]); returns
 the f64 bits in rax. rbx is the frame base (rbp is reserved by the runtime and
 must not be touched, so this helper uses rbx like the other text helpers). R10
 carries the heap frontier across the call and no caller saves it, so the
 prologue pushes r10 and the epilogue restores it; the frame is 120 rather than
 112 to keep rsp 16-aligned across that sixth push. From
 rbx: den at 0, R at 32, tmp at 64, neg at 96, the bit counter at 104. r12 = exp,
 r13 = f, r14 = acc.

  emit-ttd-prologue : CodegenState -> CodegenState
  emit-ttd-prologue (st) =
    let st0 = record-func-offset st "__text_to_double"
   in let a2 = st-append-code st0 (push-r reg-rbx)
   in let a3 = st-append-code a2 (push-r reg-r12)
   in let a4 = st-append-code a3 (push-r reg-r13)
   in let a5 = st-append-code a4 (push-r reg-r14)
   in let a6 = st-append-code a5 (push-r reg-r15)
   in let a6b = st-append-code a6 (push-r reg-r10)
   in let a7 = st-append-code a6b (sub-ri reg-rsp 120)
   in st-append-code a7 (mov-rr reg-rbx reg-rsp)

  emit-ttd-epilogue : CodegenState -> CodegenState
  emit-ttd-epilogue (st) =
    let a0 = st-append-code st (add-ri reg-rsp 120)
   in let a0b = st-append-code a0 (pop-r reg-r10)
   in let a1 = st-append-code a0b (pop-r reg-r15)
   in let a2 = st-append-code a1 (pop-r reg-r14)
   in let a3 = st-append-code a2 (pop-r reg-r13)
   in let a4 = st-append-code a3 (pop-r reg-r12)
   in let a5 = st-append-code a4 (pop-r reg-rbx)
   in st-append-code a5 x86-ret

 Parse: rax = N (unsigned), r13 = fraction count, r10 = negative flag.

  emit-ttd-parse2 : CodegenState -> ParseResult2
  emit-ttd-parse2 (st) =
    let a0 = st-append-code st (mov-load reg-rcx reg-rdi 0)
   in let a1 = st-append-code a0 (lea reg-rsi reg-rdi 8)
   in let a2 = st-append-code a1 (li reg-rax 0)
   in let a3 = st-append-code a2 (li reg-r13 0)
   in let a4 = st-append-code a3 (li reg-r10 0)
   in let a5 = st-append-code a4 (li reg-r9 0)
   in let a6 = st-append-code a5 (li reg-r11 0)
   in let a7 = st-append-code a6 (test-rr reg-rcx reg-rcx)
   in let empty-pos = a7.code-len
   in let a8 = st-append-code a7 (jcc cc-e 0)
   in let a9 = st-append-code a8 (lea-rr reg-rdx reg-rsi reg-r11)
   in let b0 = st-append-code a9 (movzx-byte reg-rdx reg-rdx 0)
   in let b1 = st-append-code b0 (cmp-ri reg-rdx 73)
   in let notminus-pos = b1.code-len
   in let b2 = st-append-code b1 (jcc cc-ne 0)
   in let b3 = st-append-code b2 (li reg-r10 1)
   in let b4 = st-append-code b3 (add-ri reg-r11 1)
   in let b5 = patch-jcc-at b4 notminus-pos (b4.code-len)
   in let ploop = b5.code-len
   in let c0 = st-append-code b5 (cmp-rr reg-r11 reg-rcx)
   in let pdone-pos = c0.code-len
   in let c1 = st-append-code c0 (jcc cc-ge 0)
   in let c2 = st-append-code c1 (lea-rr reg-rdx reg-rsi reg-r11)
   in let c3 = st-append-code c2 (movzx-byte reg-rdx reg-rdx 0)
   in let c4 = st-append-code c3 (cmp-ri reg-rdx 65)
   in let notdot-pos = c4.code-len
   in let c5 = st-append-code c4 (jcc cc-ne 0)
   in let c6 = st-append-code c5 (li reg-r9 1)
   in let c7 = st-append-code c6 (add-ri reg-r11 1)
   in let c8 = st-append-code c7 (jmp (ploop - (c7.code-len + 5)))
   in let c9 = patch-jcc-at c8 notdot-pos (c8.code-len)
   in let d0 = st-append-code c9 (sub-ri reg-rdx 3)
   in let d1 = st-append-code d0 (imul-rri reg-rax reg-rax 10)
   in let d2 = st-append-code d1 (add-rr reg-rax reg-rdx)
   in let d3 = st-append-code d2 (add-rr reg-r13 reg-r9)
   in let d4 = st-append-code d3 (add-ri reg-r11 1)
   in let d5 = st-append-code d4 (jmp (ploop - (d4.code-len + 5)))
   in let d6 = patch-jcc-at d5 pdone-pos (d5.code-len)
   in ParseResult2 { cg = d6, empty = empty-pos }

 Zero result: rax = 0, or the sign bit if negative (r10). Shared by the empty
 string and the N == 0 case.

  emit-ttd-zero-ret : CodegenState -> CodegenState
  emit-ttd-zero-ret (st) =
    let a0 = st-append-code st (li reg-rax 0)
   in let a1 = st-append-code a0 (test-rr reg-r10 reg-r10)
   in let pos-pos = a1.code-len
   in let a2 = st-append-code a1 (jcc cc-e 0)
   in let a3 = st-append-code a2 (li reg-r9 1)
   in let a4 = st-append-code a3 (shl-ri reg-r9 63)
   in let a5 = st-append-code a4 (or-rr reg-rax reg-r9)
   in let a6 = patch-jcc-at a5 pos-pos (a5.code-len)
   in emit-ttd-epilogue a6

 Initialise den = {1,0,0,0} at rbx, R = {N,0,0,0} at rbx+32; neg at rbx+96.

  emit-ttd-init-bufs : CodegenState -> CodegenState
  emit-ttd-init-bufs (st) =
    let a0 = st-append-code st (mov-store reg-rbx reg-r10 96)
   in let a3 = st-append-code a0 (li reg-rcx 1)
   in let a4 = st-append-code a3 (mov-store reg-rbx reg-rcx 0)
   in let a5 = st-append-code a4 (li reg-rcx 0)
   in let a6 = st-append-code a5 (mov-store reg-rbx reg-rcx 8)
   in let a7 = st-append-code a6 (mov-store reg-rbx reg-rcx 16)
   in let a8 = st-append-code a7 (mov-store reg-rbx reg-rcx 24)
   in let a9 = st-append-code a8 (mov-store reg-rbx reg-rax 32)
   in let b0 = st-append-code a9 (mov-store reg-rbx reg-rcx 40)
   in let b1 = st-append-code b0 (mov-store reg-rbx reg-rcx 48)
   in st-append-code b1 (mov-store reg-rbx reg-rcx 56)

 den = 5^f, then exp = 0.

  emit-ttd-pow5 : CodegenState -> CodegenState
  emit-ttd-pow5 (st) =
    let a0 = st-append-code st (mov-rr reg-r15 reg-r13)
   in let ploop = a0.code-len
   in let a1 = st-append-code a0 (test-rr reg-r15 reg-r15)
   in let done-pos = a1.code-len
   in let a2 = st-append-code a1 (jcc cc-e 0)
   in let a3 = st-append-code a2 (lea reg-rdi reg-rbx 0)
   in let a4 = emit-call-to a3 "__ttd_mul5"
   in let a5 = st-append-code a4 (sub-ri reg-r15 1)
   in let a6 = st-append-code a5 (jmp (ploop - (a5.code-len + 5)))
   in let a7 = patch-jcc-at a6 done-pos (a6.code-len)
   in st-append-code a7 (li reg-r12 0)

 Copy den into tmp (rbp-32), for the 2*den test in the big-normalise loop.

  emit-ttd-copy-den-tmp : CodegenState -> CodegenState
  emit-ttd-copy-den-tmp (st) =
    let a0 = st-append-code st (mov-load reg-rax reg-rbx 0)
   in let a1 = st-append-code a0 (mov-store reg-rbx reg-rax 64)
   in let a2 = st-append-code a1 (mov-load reg-rax reg-rbx 8)
   in let a3 = st-append-code a2 (mov-store reg-rbx reg-rax 72)
   in let a4 = st-append-code a3 (mov-load reg-rax reg-rbx 16)
   in let a5 = st-append-code a4 (mov-store reg-rbx reg-rax 80)
   in let a6 = st-append-code a5 (mov-load reg-rax reg-rbx 24)
   in st-append-code a6 (mov-store reg-rbx reg-rax 88)

  emit-ttd-copy-tmp-den : CodegenState -> CodegenState
  emit-ttd-copy-tmp-den (st) =
    let a0 = st-append-code st (mov-load reg-rax reg-rbx 64)
   in let a1 = st-append-code a0 (mov-store reg-rbx reg-rax 0)
   in let a2 = st-append-code a1 (mov-load reg-rax reg-rbx 72)
   in let a3 = st-append-code a2 (mov-store reg-rbx reg-rax 8)
   in let a4 = st-append-code a3 (mov-load reg-rax reg-rbx 80)
   in let a5 = st-append-code a4 (mov-store reg-rbx reg-rax 16)
   in let a6 = st-append-code a5 (mov-load reg-rax reg-rbx 88)
   in st-append-code a6 (mov-store reg-rbx reg-rax 24)

 Normalise so that den <= R < 2*den, tracking exp (r12).

  emit-ttd-normalise2 : CodegenState -> CodegenState
  emit-ttd-normalise2 (st) =
    let a0 = st-append-code st (lea reg-rdi reg-rbx 32)
   in let a1 = st-append-code a0 (lea reg-rsi reg-rbx 0)
   in let a2 = emit-call-to a1 "__ttd_cmp_ge"
   in let a3 = st-append-code a2 (test-rr reg-rax reg-rax)
   in let small-pos = a3.code-len
   in let a4 = st-append-code a3 (jcc cc-e 0)
   in let bigloop = a4.code-len
   in let b0 = emit-ttd-copy-den-tmp a4
   in let b1 = st-append-code b0 (lea reg-rdi reg-rbx 64)
   in let b2 = emit-call-to b1 "__ttd_shl1"
   in let b3 = st-append-code b2 (lea reg-rdi reg-rbx 32)
   in let b4 = st-append-code b3 (lea reg-rsi reg-rbx 64)
   in let b5 = emit-call-to b4 "__ttd_cmp_ge"
   in let b6 = st-append-code b5 (test-rr reg-rax reg-rax)
   in let normdone-pos = b6.code-len
   in let b7 = st-append-code b6 (jcc cc-e 0)
   in let b8 = emit-ttd-copy-tmp-den b7
   in let b9 = st-append-code b8 (add-ri reg-r12 1)
   in let c0 = st-append-code b9 (jmp (bigloop - (b9.code-len + 5)))
   in let smallloop = c0.code-len
   in let c1 = st-append-code c0 (lea reg-rdi reg-rbx 32)
   in let c2 = st-append-code c1 (lea reg-rsi reg-rbx 0)
   in let c3 = emit-call-to c2 "__ttd_cmp_ge"
   in let c4 = st-append-code c3 (test-rr reg-rax reg-rax)
   in let smalldone-pos = c4.code-len
   in let c5 = st-append-code c4 (jcc cc-ne 0)
   in let c6 = st-append-code c5 (lea reg-rdi reg-rbx 32)
   in let c7 = emit-call-to c6 "__ttd_shl1"
   in let c8 = st-append-code c7 (sub-ri reg-r12 1)
   in let c9 = st-append-code c8 (jmp (smallloop - (c8.code-len + 5)))
   in let normdone = c9.code-len
   in let p1 = patch-jcc-at c9 small-pos smallloop
   in let p2 = patch-jcc-at p1 normdone-pos normdone
