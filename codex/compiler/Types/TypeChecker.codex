Section: Resolve Type Expression

  resolve-type-expr : List TypeBinding, ATypeExpr -> CodexType
  resolve-type-expr (tdm) (texpr) =
   when texpr
    is ANamedType (name) (s) -> resolve-type-name tdm (name.value)
    is AFunType (param) (ret) (s) ->
     when ret
      is AEffectType (effs) (scopes) (tail) (r2) (s2) ->
       let row = make-row-from-names effs scopes (if list-length tail == 0 then "" else (list-at tail 0).value)
       in deck-record (FunTy (resolve-type-expr tdm param) row (resolve-type-expr tdm r2))
      is otherwise -> deck-record (FunTy (resolve-type-expr tdm param) empty-row (resolve-type-expr tdm ret))
    is AAppType (ctor) (args) (s) -> resolve-applied-type tdm ctor args
    is AEffectType (effs) (scopes) (tail) (ret) (s) -> deck-record (EffectfulTy effs scopes (resolve-type-expr tdm ret))
    is ABoundedIntType (base) (lo) (hi) (mode) (s) -> resolve-bounded-int-type tdm base lo hi mode
    is APropEqType (left) (right) (s) -> deck-record (PropEqTy (resolve-type-expr tdm left) (resolve-type-expr tdm right))
    is AConstrainedType (cn) (cv) (body) (s) -> resolve-type-expr tdm body
    is ALinearType (inner) (s) -> deck-record (LinearTy (resolve-type-expr tdm inner))
    is AForallType (v) (vt) (p) (s) -> ProofTy

  make-row-from-names : List Name, List Text, Text -> EffectRow
  make-row-from-names (effs) (scopes) (tail-name) =
   let labels = build-effect-labels effs scopes 0 (list-length effs) []
   in deck-record (EffectRow { labels = deck-record (sort-labels-canonical labels 0 (list-length labels) []), tail-name = tail-name, tail-id = __narrow (-1) })

  build-effect-labels : List Name, List Text, Integer, Integer, List EffectLabel -> List EffectLabel
  build-effect-labels (effs) (scopes) (i) (len) (acc) =
   if i == len then acc
   else let sc = if i < list-length scopes then list-at scopes i else ""
   in build-effect-labels effs scopes (i + 1) len (list-push acc (deck-record (EffectLabel { name = list-at effs i, scope = sc })))

  resolve-bounded-int-type : List TypeBinding, ATypeExpr, Integer, Integer, OverflowMode -> CodexType
  resolve-bounded-int-type (tdm) (base) (lo) (hi) (mode) =
   let resolved = resolve-type-expr tdm base
   in when resolved
    is IntegerTy (b-lo) (b-hi) (b-mode) -> deck-record (IntegerTy lo hi mode)
    is UnitTy (name) (inner) ->
     when inner
      is IntegerTy (b-lo) (b-hi) (b-mode) -> deck-record (UnitTy name (deck-record (IntegerTy lo hi mode)))
      is otherwise -> ErrorTy
    is otherwise -> ErrorTy

  resolve-real-quals : Name, List ATypeExpr, List TypeBinding, Integer, RealWidth, RealMode, Boolean -> CodexType
  resolve-real-quals (name) (args) (tdm) (i) (w) (m) (all-quals) =
   if list-length args == 0 then real-f64
   else if i >= list-length args then
    (if all-quals then deck-record (RealTy w m)
     else deck-record (ConstructedTy name (for a in args -> resolve-type-expr tdm a)))
   else let word = when (list-at args i) is ANamedType (qt) (qs) -> qt.value is otherwise -> ""
    in if word == "approximate" then resolve-real-quals name args tdm (i + 1) RwF32 m all-quals
    else if word == "trapping" then resolve-real-quals name args tdm (i + 1) w RmTrapping all-quals
    else if word == "saturating" then resolve-real-quals name args tdm (i + 1) w RmSaturating all-quals
    else resolve-real-quals name args tdm (i + 1) w m False

  resolve-applied-type : List TypeBinding, ATypeExpr, List ATypeExpr -> CodexType
  resolve-applied-type (tdm) (ctor) (args) =
   when ctor
    is ANamedType (name) (s) ->
     if name.value == "List" then if list-length args == 1 then deck-record (ListTy (resolve-type-expr tdm (list-at args 0)))
       else deck-record (ListTy ErrorTy)
      else if name.value == "LinkedList" then if list-length args == 1 then deck-record (LinkedListTy (resolve-type-expr tdm (list-at args 0)))
       else deck-record (LinkedListTy ErrorTy)
      else if name.value == "Real" then resolve-real-quals name args tdm 0 RwF64 RmDefault True
      else if name.value == "Vector" then if list-length args == 2 then
       let n-text = when (list-at args 0) is ANamedType (nt) (ns) -> nt.value is otherwise -> "0"
       in deck-record (VectorTy (lit-text-to-integer n-text) (resolve-type-expr tdm (list-at args 1)))
       else deck-record (VectorTy 2 ErrorTy)
      else deck-record (ConstructedTy name (for a in args -> resolve-type-expr tdm a))
    is AAppType (inner-ctor) (inner-args) (s) ->
     resolve-applied-type tdm inner-ctor (inner-args & args)
    is otherwise -> resolve-type-expr tdm ctor

  resolve-type-name : List TypeBinding, Text -> CodexType
  resolve-type-name (tdm) (name) =
   if name == "Integer" then int-ty-default
   else if name == "Real" then real-f64
   else if name == "Text" then TextTy
   else if name == "Boolean" then BooleanTy
   else if name == "Char" then CharTy
   else if name == "Nothing" then NothingTy
   else if name == "Proof" then ProofTy
   else lookup-type-def tdm name

  lookup-type-def : List TypeBinding, Text -> CodexType
  lookup-type-def (tdm) (name) =
   let len = list-length tdm
   in if len == 0 then deck-record (ConstructedTy (Name { value = name }) [])
   else let pos = bsearch-text-pos tdm name 0 len
   in if pos >= len then deck-record (ConstructedTy (Name { value = name }) [])
   else let b = list-at tdm pos
   in if b.name == name then b.bound-type
         else deck-record (ConstructedTy (Name { value = name }) [])

Section: Proof Normalizer

  SubstPair = record {
   sp-name : Text,
   sp-val : AExpr
  }

  proof-norm-fuel : Integer
  proof-norm-fuel = 100000

  normalize-prop-eq : List ADef, CodexType -> CodexType
  normalize-prop-eq (defs) (ty) =
   when ty
    is PropEqTy (l) (r) -> deck-record (PropEqTy (normalize-codextype defs l proof-norm-fuel) (normalize-codextype defs r proof-norm-fuel))
    is otherwise -> ty

  is-term-ctype : CodexType -> Boolean
  is-term-ctype (ty) =
   when ty
    is ConstructedTy (n) (args) -> all-term-ctype args 0 (list-length args)
    is otherwise -> False

  all-term-ctype : List CodexType, Integer, Integer -> Boolean
  all-term-ctype (args) (i) (len) =
   if i == len then True
   else if is-term-ctype (list-at args i) then all-term-ctype args (i + 1) len
   else False

  normalize-codextype : List ADef, CodexType, Integer -> CodexType
  normalize-codextype (defs) (ty) (fuel) =
   if is-term-ctype ty
    then let nf = normalize-aterm defs (ctype-to-aterm ty) fuel
      in if is-aterm-normal nf then aterm-to-codextype nf else ty
    else ty

  ctype-to-aterm : CodexType -> AExpr
  ctype-to-aterm (ty) =
   when ty
    is ConstructedTy (n) (args) -> ctype-args-to-app (deck-record (ANameExpr n synthetic-span)) args 0 (list-length args)
    is otherwise -> deck-record (ANameExpr (make-name "__nonterm") synthetic-span)

  ctype-args-to-app : AExpr, List CodexType, Integer, Integer -> AExpr
  ctype-args-to-app (acc) (args) (i) (len) =
   if i == len then acc
   else ctype-args-to-app (deck-record (AApplyExpr acc (ctype-to-aterm (list-at args i)) synthetic-span)) args (i + 1) len

  is-aterm-normal : AExpr -> Boolean
  is-aterm-normal (e) =
   when e
    is ANameExpr (n) (s) -> True
    is AApplyExpr (f) (a) (s) -> is-aterm-normal f & is-aterm-normal a
    is otherwise -> False

  aterm-to-codextype : AExpr -> CodexType
  aterm-to-codextype (e) =
   when e
    is ANameExpr (n) (s) -> deck-record (ConstructedTy n [])
    is AApplyExpr (f) (a) (s) ->
     when (aterm-to-codextype f)
      is ConstructedTy (n) (args) -> deck-record (ConstructedTy n (list-push args (aterm-to-codextype a)))
      is otherwise -> deck-record (ConstructedTy (make-name "__stuck") [])
    is otherwise -> deck-record (ConstructedTy (make-name "__stuck") [])

  normalize-aterm : List ADef, AExpr, Integer -> AExpr
  normalize-aterm (defs) (e) (fuel) =
   if fuel <= 0 then e
   else when e
    is ANameExpr (n) (s) ->
     let idx = find-def-index defs (n.value) 0 (list-length defs)
     in if idx >= 0
        then let d = list-at defs idx
          in if list-length (d.params) == 0 then normalize-aterm defs (d.body) (fuel - 1) else e
        else e
    is AApplyExpr (f) (a) (s) -> normalize-app defs e fuel
    is AMatchExpr (sc) (arms) (s) -> normalize-match defs sc arms fuel
    is AIfExpr (c) (t) (el) (s) ->
     let c2 = normalize-aterm defs c fuel
     in when c2
      is ALitExpr (txt) (k) (s2) ->
       when k
        is BoolLit -> if txt == "True" then normalize-aterm defs t (fuel - 1) else normalize-aterm defs el (fuel - 1)
        is otherwise -> deck-record (AIfExpr c2 t el s)
      is otherwise -> deck-record (AIfExpr c2 t el s)
    is ALetExpr (binds) (body) (s) ->
     normalize-aterm defs (subst-expr (letbinds-to-subst binds 0 (list-length binds) []) body) (fuel - 1)
    is otherwise -> e

  is-arith-op-name : Text -> Boolean
  is-arith-op-name (t) = t == "+" | t == "-" | t == "*" | t == "/"

  all-digits-from : Text, Integer, Integer -> Boolean
  all-digits-from (t) (i) (len) =
   if i == len then True
   else if is-digit (char-at t i) then all-digits-from t (i + 1) len
   else False

  is-int-literal-text : Text -> Boolean
  is-int-literal-text (t) =
   if text-length t == 0 then False
   else if char-at t 0 == '-' then if text-length t == 1 then False else all-digits-from t 1 (text-length t)
   else all-digits-from t 0 (text-length t)

  aterm-name-text : AExpr -> Text
  aterm-name-text (e) =
   when e
    is ANameExpr (n) (s) -> n.value
    is otherwise -> ""

  arith-fold-value : Text, Integer, Integer -> Integer
  arith-fold-value (op) (x) (y) =
   if op == "+" then x + y
   else if op == "-" then x - y
   else if op == "*" then x * y
   else x / y

  normalize-arith : List ADef, Text, AExpr, List AExpr, Integer -> AExpr
  normalize-arith (defs) (op) (head) (args) (fuel) =
   let a = normalize-aterm defs (list-at args 0) fuel
   in let b = normalize-aterm defs (list-at args 1) fuel
   in let at = aterm-name-text a
   in let bt = aterm-name-text b
   in if is-int-literal-text at & is-int-literal-text bt
    then let y = text-to-integer bt
     in if op == "/" & y == 0 then build-app-spine head [a, b] 0 2
      else deck-record (ANameExpr (make-name (integer-to-text (arith-fold-value op (text-to-integer at) y))) synthetic-span)
    else build-app-spine head [a, b] 0 2

  is-list-prim-name : Text -> Boolean
  is-list-prim-name (t) = t == "list-length" | t == "list-push" | t == "list-snoc" | t == "list-at" | t == "list-set-at" | t == "list-insert-at" | t == "&"

  aterm-ctor-name : AExpr -> Text
  aterm-ctor-name (e) = aterm-name-text (app-head e)

  list-prim-nil : AExpr -> Boolean
  list-prim-nil (e) = aterm-ctor-name e == "Nil" & list-length (app-args e) == 0

  list-prim-cons : AExpr -> Boolean
  list-prim-cons (e) = aterm-ctor-name e == "Cons" & list-length (app-args e) == 2

  cons-head-of : AExpr -> AExpr
  cons-head-of (e) = list-at (app-args e) 0

  cons-tail-of : AExpr -> AExpr
  cons-tail-of (e) = list-at (app-args e) 1

  int-name-term : Integer -> AExpr
  int-name-term (n) = deck-record (ANameExpr (make-name (integer-to-text n)) synthetic-span)

  normalize-list-prim : List ADef, Text, AExpr, List AExpr, Integer -> AExpr
  normalize-list-prim (defs) (op) (head) (args) (fuel) =
   if op == "list-length" & list-length args == 1 then normalize-list-length defs head args fuel
   else if (op == "list-push" | op == "list-snoc") & list-length args == 2 then normalize-list-push defs head args fuel
   else if op == "list-at" & list-length args == 2 then normalize-list-at defs head args fuel
   else if op == "list-set-at" & list-length args == 3 then normalize-list-set-at defs head args fuel
   else if op == "list-insert-at" & list-length args == 3 then normalize-list-insert-at defs head args fuel
   else if op == "&" & list-length args == 2 then normalize-list-append defs head args fuel
   else rebuild-app defs head args fuel

  cons-term : AExpr, AExpr -> AExpr
  cons-term (h) (t) = build-app-spine (deck-record (ANameExpr (make-name "Cons") synthetic-span)) [h, t] 0 2

  normalize-list-length : List ADef, AExpr, List AExpr, Integer -> AExpr
  normalize-list-length (defs) (head) (args) (fuel) =
   let a = normalize-aterm defs (list-at args 0) fuel
   in if list-prim-nil a then int-name-term 0
   else if list-prim-cons a
    then normalize-aterm defs (build-app-spine (deck-record (ANameExpr (make-name "+") synthetic-span)) [int-name-term 1, build-app-spine head [cons-tail-of a] 0 1] 0 2) (fuel - 1)
   else build-app-spine head [a] 0 1

  normalize-list-push : List ADef, AExpr, List AExpr, Integer -> AExpr
  normalize-list-push (defs) (head) (args) (fuel) =
   let a = normalize-aterm defs (list-at args 0) fuel
   in let x = normalize-aterm defs (list-at args 1) fuel
   in if list-prim-nil a
    then build-app-spine (deck-record (ANameExpr (make-name "Cons") synthetic-span)) [x, deck-record (ANameExpr (make-name "Nil") synthetic-span)] 0 2
   else if list-prim-cons a
    then build-app-spine (deck-record (ANameExpr (make-name "Cons") synthetic-span)) [cons-head-of a, normalize-aterm defs (build-app-spine head [cons-tail-of a, x] 0 2) (fuel - 1)] 0 2
   else build-app-spine head [a, x] 0 2

  normalize-list-at : List ADef, AExpr, List AExpr, Integer -> AExpr
  normalize-list-at (defs) (head) (args) (fuel) =
   let a = normalize-aterm defs (list-at args 0) fuel
   in let ix = normalize-aterm defs (list-at args 1) fuel
   in let it = aterm-name-text ix
   in if list-prim-cons a & is-int-literal-text it
    then let n = text-to-integer it
     in if n == 0 then cons-head-of a
        else if n > 0 then normalize-aterm defs (build-app-spine head [cons-tail-of a, int-name-term (n - 1)] 0 2) (fuel - 1)
        else build-app-spine head [a, ix] 0 2
   else build-app-spine head [a, ix] 0 2

  normalize-list-set-at : List ADef, AExpr, List AExpr, Integer -> AExpr
  normalize-list-set-at (defs) (head) (args) (fuel) =
   let a = normalize-aterm defs (list-at args 0) fuel
   in let ix = normalize-aterm defs (list-at args 1) fuel
   in let v = normalize-aterm defs (list-at args 2) fuel
   in let it = aterm-name-text ix
   in if list-prim-cons a & is-int-literal-text it
    then let n = text-to-integer it
     in if n == 0 then cons-term v (cons-tail-of a)
        else if n > 0 then cons-term (cons-head-of a) (normalize-aterm defs (build-app-spine head [cons-tail-of a, int-name-term (n - 1), v] 0 3) (fuel - 1))
        else build-app-spine head [a, ix, v] 0 3
   else build-app-spine head [a, ix, v] 0 3

  normalize-list-insert-at : List ADef, AExpr, List AExpr, Integer -> AExpr
  normalize-list-insert-at (defs) (head) (args) (fuel) =
   let a = normalize-aterm defs (list-at args 0) fuel
   in let ix = normalize-aterm defs (list-at args 1) fuel
   in let v = normalize-aterm defs (list-at args 2) fuel
   in let it = aterm-name-text ix
   in if (list-prim-nil a | list-prim-cons a) & is-int-literal-text it
    then let n = text-to-integer it
     in if n == 0 then cons-term v a
        else if n > 0 & list-prim-cons a then cons-term (cons-head-of a) (normalize-aterm defs (build-app-spine head [cons-tail-of a, int-name-term (n - 1), v] 0 3) (fuel - 1))
        else build-app-spine head [a, ix, v] 0 3
   else build-app-spine head [a, ix, v] 0 3

  normalize-list-append : List ADef, AExpr, List AExpr, Integer -> AExpr
  normalize-list-append (defs) (head) (args) (fuel) =
   let a = normalize-aterm defs (list-at args 0) fuel
   in let b = normalize-aterm defs (list-at args 1) fuel
   in if list-prim-nil a then b
   else if list-prim-cons a
    then cons-term (cons-head-of a) (normalize-aterm defs (build-app-spine head [cons-tail-of a, b] 0 2) (fuel - 1))
   else build-app-spine head [a, b] 0 2

  normalize-app : List ADef, AExpr, Integer -> AExpr
  normalize-app (defs) (e) (fuel) =
   let head = app-head e
   in let args = app-args e
   in when head
    is ANameExpr (n) (s) ->
     if is-arith-op-name (n.value) & list-length args == 2
     then normalize-arith defs (n.value) head args fuel
     else if is-list-prim-name (n.value)
     then normalize-list-prim defs (n.value) head args fuel
     else let idx = find-def-index defs (n.value) 0 (list-length defs)
     in if idx >= 0
        then let d = list-at defs idx
          in if list-length (d.params) == list-length args
             then let body2 = rename-binders-for (d.body) (collect-arg-names args 0 (list-length args) []) fuel
               in let unfolded = normalize-aterm defs (subst-expr (params-to-subst (d.params) args 0 (list-length args) []) body2) (fuel - 1)
               in if is-aterm-normal unfolded then unfolded else rebuild-app defs head args fuel
             else rebuild-app defs head args fuel
        else rebuild-app defs head args fuel
    is otherwise -> rebuild-app defs head args fuel

  collect-arg-names : List AExpr, Integer, Integer, List Text -> List Text
  collect-arg-names (args) (i) (len) (acc) =
   if i == len then acc
   else collect-arg-names args (i + 1) len (aexpr-names (list-at args i) acc)

  aexpr-names : AExpr, List Text -> List Text
  aexpr-names (e) (acc) =
   when e
    is ANameExpr (n) (s) -> list-push acc (n.value)
    is AApplyExpr (f) (a) (s) -> aexpr-names a (aexpr-names f acc)
    is otherwise -> acc

  rename-binders-for : AExpr, List Text, Integer -> AExpr
  rename-binders-for (e) (fv) (fuel) =
   when e
    is AMatchExpr (sc) (arms) (s) -> deck-record (AMatchExpr (rename-binders-for sc fv fuel) (rename-arms-for arms fv fuel 0 (list-length arms) []) s)
    is AApplyExpr (f) (a) (s) -> deck-record (AApplyExpr (rename-binders-for f fv fuel) (rename-binders-for a fv fuel) s)
    is AIfExpr (c) (t) (el) (s) -> deck-record (AIfExpr (rename-binders-for c fv fuel) (rename-binders-for t fv fuel) (rename-binders-for el fv fuel) s)
    is otherwise -> e

  rename-arms-for : List AMatchArm, List Text, Integer, Integer, Integer, List AMatchArm -> List AMatchArm
  rename-arms-for (arms) (fv) (fuel) (i) (len) (acc) =
   if i == len then acc
   else let arm = list-at arms i
   in let colliding = names-intersect (pat-vars (arm.pattern)) fv
   in let arm2 = if list-length colliding == 0
      then AMatchArm { pattern = arm.pattern, body = rename-binders-for (arm.body) fv fuel, guard = arm.guard, span = arm.span, alt-group = arm.alt-group }
      else AMatchArm { pattern = rename-pat-vars (arm.pattern) colliding fuel, body = subst-expr (fuel-rename-subst colliding fuel) (rename-binders-for (arm.body) fv fuel), guard = arm.guard, span = arm.span, alt-group = arm.alt-group }
   in rename-arms-for arms fv fuel (i + 1) len (list-push acc arm2)

  names-intersect : List Text, List Text -> List Text
  names-intersect (xs) (ys) = names-intersect-loop xs ys 0 (list-length xs) []

  names-intersect-loop : List Text, List Text, Integer, Integer, List Text -> List Text
  names-intersect-loop (xs) (ys) (i) (len) (acc) =
   if i == len then acc
   else if text-in-list ys (list-at xs i) 0 (list-length ys) then names-intersect-loop xs ys (i + 1) len (list-push acc (list-at xs i))
   else names-intersect-loop xs ys (i + 1) len acc

  fuel-rename-subst : List Text, Integer -> List SubstPair
  fuel-rename-subst (names) (fuel) = fuel-rename-loop names fuel 0 (list-length names) []

  fuel-rename-loop : List Text, Integer, Integer, Integer, List SubstPair -> List SubstPair
  fuel-rename-loop (names) (fuel) (i) (len) (acc) =
   if i == len then acc
   else fuel-rename-loop names fuel (i + 1) len (list-push acc (SubstPair { sp-name = list-at names i, sp-val = deck-record (ANameExpr (make-name ((list-at names i) & "~" & integer-to-text fuel)) synthetic-span) }))

  rename-pat-vars : APat, List Text, Integer -> APat
  rename-pat-vars (p) (colliding) (fuel) =
   when p
    is AVarPat (n) (s) -> if text-in-list colliding (n.value) 0 (list-length colliding) then deck-record (AVarPat (make-name ((n.value) & "~" & integer-to-text fuel)) s) else p
    is ACtorPat (cn) (subs) (s) -> deck-record (ACtorPat cn (rename-pat-vars-list subs colliding fuel 0 (list-length subs) []) s)
    is otherwise -> p

  rename-pat-vars-list : List APat, List Text, Integer, Integer, Integer, List APat -> List APat
  rename-pat-vars-list (subs) (colliding) (fuel) (i) (len) (acc) =
   if i == len then acc
   else rename-pat-vars-list subs colliding fuel (i + 1) len (list-push acc (rename-pat-vars (list-at subs i) colliding fuel))

  rebuild-app : List ADef, AExpr, List AExpr, Integer -> AExpr
  rebuild-app (defs) (head) (args) (fuel) =
   build-app-spine head (normalize-args defs args 0 (list-length args) fuel []) 0 (list-length args)

  normalize-args : List ADef, List AExpr, Integer, Integer, Integer, List AExpr -> List AExpr
  normalize-args (defs) (args) (i) (len) (fuel) (acc) =
   if i == len then acc
   else normalize-args defs args (i + 1) len fuel (list-push acc (normalize-aterm defs (list-at args i) fuel))

  build-app-spine : AExpr, List AExpr, Integer, Integer -> AExpr
  build-app-spine (head) (args) (i) (len) =
   if i == len then head
   else build-app-spine (deck-record (AApplyExpr head (list-at args i) synthetic-span)) args (i + 1) len

  normalize-match : List ADef, AExpr, List AMatchArm, Integer -> AExpr
  normalize-match (defs) (sc) (arms) (fuel) =
   let sc2 = normalize-aterm defs sc fuel
   in let head = app-head sc2
   in when head
    is ANameExpr (cn) (s) ->
     let cargs = app-args sc2
     in let ai = find-matching-arm arms (cn.value) (list-length cargs) 0 (list-length arms)
     in if ai >= 0
        then let arm = list-at arms ai
          in normalize-aterm defs (subst-expr (ctorpat-to-subst (arm.pattern) cargs) (arm.body)) (fuel - 1)
        else deck-record (AMatchExpr sc2 arms s)
    is otherwise -> deck-record (AMatchExpr sc2 arms (aexpr-span sc2))

  app-head : AExpr -> AExpr
  app-head (e) =
   when e
    is AApplyExpr (f) (a) (s) -> app-head f
    is otherwise -> e

  app-args : AExpr -> List AExpr
  app-args (e) =
   when e
    is AApplyExpr (f) (a) (s) -> list-push (app-args f) a
    is otherwise -> []

  find-def-index : List ADef, Text, Integer, Integer -> Integer
  find-def-index (defs) (nm) (i) (len) =
   if i == len then 0 - 1
   else if ((list-at defs i).name.value) == nm then i
   else find-def-index defs nm (i + 1) len

  find-matching-arm : List AMatchArm, Text, Integer, Integer, Integer -> Integer
  find-matching-arm (arms) (cn) (nargs) (i) (len) =
   if i == len then 0 - 1
   else when (list-at arms i).pattern
    is ACtorPat (pn) (subs) (s) -> if (pn.value) == cn & (list-length subs) == nargs then i else find-matching-arm arms cn nargs (i + 1) len
    is otherwise -> find-matching-arm arms cn nargs (i + 1) len

  ctorpat-to-subst : APat, List AExpr -> List SubstPair
  ctorpat-to-subst (p) (cargs) =
   when p
    is ACtorPat (pn) (subs) (s) -> bind-subpats subs cargs 0 (list-length subs) []
    is otherwise -> []

  bind-subpats : List APat, List AExpr, Integer, Integer, List SubstPair -> List SubstPair
  bind-subpats (subs) (cargs) (i) (len) (acc) =
   if i == len then acc
   else when (list-at subs i)
    is AVarPat (vn) (s) -> bind-subpats subs cargs (i + 1) len (list-push acc (SubstPair { sp-name = vn.value, sp-val = list-at cargs i }))
    is otherwise -> bind-subpats subs cargs (i + 1) len acc

  params-to-subst : List AParam, List AExpr, Integer, Integer, List SubstPair -> List SubstPair
  params-to-subst (params) (args) (i) (len) (acc) =
   if i == len then acc
   else params-to-subst params args (i + 1) len (list-push acc (SubstPair { sp-name = (list-at params i).name.value, sp-val = list-at args i }))

  letbinds-to-subst : List ALetBind, Integer, Integer, List SubstPair -> List SubstPair
  letbinds-to-subst (binds) (i) (len) (acc) =
   if i == len then acc
   else let b = list-at binds i
   in letbinds-to-subst binds (i + 1) len (list-push acc (SubstPair { sp-name = b.name.value, sp-val = b.value }))

  subst-expr : List SubstPair, AExpr -> AExpr
  subst-expr (sub) (e) =
   when e
    is ANameExpr (n) (s) ->
     let idx = find-subst sub (n.value) 0 (list-length sub)
     in if idx >= 0 then (list-at sub idx).sp-val else e
    is AApplyExpr (f) (a) (s) -> deck-record (AApplyExpr (subst-expr sub f) (subst-expr sub a) s)
    is AMatchExpr (sc) (arms) (s) -> deck-record (AMatchExpr (subst-expr sub sc) (subst-arms sub arms 0 (list-length arms) []) s)
    is AIfExpr (c) (t) (el) (s) -> deck-record (AIfExpr (subst-expr sub c) (subst-expr sub t) (subst-expr sub el) s)
    is ABinaryExpr (l) (op) (r) (s) -> deck-record (ABinaryExpr (subst-expr sub l) op (subst-expr sub r) s)
    is AUnaryExpr (x) (s) -> deck-record (AUnaryExpr (subst-expr sub x) s)
    is ALetExpr (binds) (body) (s) -> deck-record (ALetExpr (subst-letbinds sub binds 0 (list-length binds) []) (subst-expr (remove-shadowed sub (letbind-names binds 0 (list-length binds) [])) body) s)
    is otherwise -> e

  subst-arms : List SubstPair, List AMatchArm, Integer, Integer, List AMatchArm -> List AMatchArm
  subst-arms (sub) (arms) (i) (len) (acc) =
   if i == len then acc
   else let arm = list-at arms i
   in let inner = remove-shadowed sub (pat-vars (arm.pattern))
   in subst-arms sub arms (i + 1) len (list-push acc (AMatchArm { pattern = arm.pattern, body = subst-expr inner (arm.body), guard = arm.guard, span = arm.span, alt-group = arm.alt-group }))

  subst-letbinds : List SubstPair, List ALetBind, Integer, Integer, List ALetBind -> List ALetBind
  subst-letbinds (sub) (binds) (i) (len) (acc) =
   if i == len then acc
   else let b = list-at binds i
   in subst-letbinds sub binds (i + 1) len (list-push acc (ALetBind { name = b.name, value = subst-expr sub (b.value), span = b.span }))

  letbind-names : List ALetBind, Integer, Integer, List Text -> List Text
  letbind-names (binds) (i) (len) (acc) =
   if i == len then acc
   else letbind-names binds (i + 1) len (list-push acc ((list-at binds i).name.value))

  find-subst : List SubstPair, Text, Integer, Integer -> Integer
  find-subst (sub) (nm) (i) (len) =
   if i == len then 0 - 1
   else if ((list-at sub i).sp-name) == nm then i
   else find-subst sub nm (i + 1) len

  remove-shadowed : List SubstPair, List Text -> List SubstPair
  remove-shadowed (sub) (names) = remove-shadowed-loop sub names 0 (list-length sub) []

  remove-shadowed-loop : List SubstPair, List Text, Integer, Integer, List SubstPair -> List SubstPair
  remove-shadowed-loop (sub) (names) (i) (len) (acc) =
   if i == len then acc
   else let p = list-at sub i
   in if text-in-list names (p.sp-name) 0 (list-length names) then remove-shadowed-loop sub names (i + 1) len acc
      else remove-shadowed-loop sub names (i + 1) len (list-push acc p)

  text-in-list : List Text, Text, Integer, Integer -> Boolean
  text-in-list (xs) (t) (i) (len) =
   if i == len then False
   else if (list-at xs i) == t then True
   else text-in-list xs t (i + 1) len

  pat-vars : APat -> List Text
  pat-vars (p) =
   when p
    is AVarPat (n) (s) -> [n.value]
    is ACtorPat (cn) (subs) (s) -> pat-vars-list subs 0 (list-length subs) []
    is otherwise -> []

  pat-vars-list : List APat, Integer, Integer, List Text -> List Text
  pat-vars-list (subs) (i) (len) (acc) =
   if i == len then acc
   else pat-vars-list subs (i + 1) len (acc & pat-vars (list-at subs i))

Section: Parameterize Type
  is-value-name : Text -> Boolean
  is-value-name (name) =
   if text-length name == 0 then False
   else let code = char-code (char-at name 0)
   in code >= char-code 'e' & code <= char-code 'z'

  ParamEntry = record {
   param-name : Text,
   var-id : Integer between 0 and 4294967295,
   is-row : Boolean
  }

  ParamResult = record {
   parameterized : CodexType,
   entries : List ParamEntry,
   state : UnificationState
  }

  parameterize-type : UnificationState, CodexType -> ParamResult
  parameterize-type (st) (ty) =
   let r = parameterize-walk st [] ty
   in let wrapped = wrap-forall-from-entries (r.walked) (r.entries) 0 (list-length (r.entries))
   in ParamResult {
    parameterized = wrapped,
    entries = r.entries,
    state = r.state
   }

  wrap-forall-from-entries : CodexType, List ParamEntry, Integer, Integer -> CodexType
  wrap-forall-from-entries (ty) (entries) (i) (len) =
   if i == len then ty
   else let e = list-at entries i
   in let inner = wrap-forall-from-entries ty entries (i + 1) len
   in if e.is-row then deck-record (ForAllEff (e.var-id) inner)
      else deck-record (ForAllTy (e.var-id) inner)

  WalkResult = record {
   walked : CodexType,
   entries : List ParamEntry,
   state : UnificationState
  }

  parameterize-walk : UnificationState, List ParamEntry, CodexType -> WalkResult
  parameterize-walk (st) (entries) (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) | RealTy (rw) (rm) | TextTy | BooleanTy | NothingTy | VoidTy | ProofTy | ErrorTy ->
     WalkResult { walked = ty, entries = entries, state = st }
    is ConstructedTy (name) (args) ->
     if is-value-name (name.value)
      then
       let looked = find-param-entry entries (name.value) False 0 (list-length entries)
       in if looked >= 0 then if list-length args == 0 then WalkResult { walked = TypeVar (__narrow looked), entries = entries, state = st } else let ar = parameterize-walk st entries (list-at args 0) in WalkResult { walked = deck-record (TypeApply (TypeVar (__narrow looked)) (ar.walked)), entries = ar.entries, state = ar.state }
       else let (fr-ty, fr-st) = fresh-and-advance st
       in when fr-ty
          is TypeVar (new-id) ->
           let new-entry = ParamEntry {
            param-name = name.value,
            var-id = new-id,
            is-row = False
           }
       in if list-length args == 0 then WalkResult { walked = fr-ty, entries = list-push entries new-entry, state = fr-st } else let ar = parameterize-walk fr-st (list-push entries new-entry) (list-at args 0) in WalkResult { walked = deck-record (TypeApply fr-ty (ar.walked)), entries = ar.entries, state = ar.state }
          is otherwise -> WalkResult {
           walked = ty,
           entries = entries,
           state = fr-st
          }
      else parameterize-walk-children st entries ty
    is FunTy (param) (row) (ret) ->
     let pr = parameterize-walk st entries param
     in let (row2, row-entries, row-st) = parameterize-row (pr.state) (pr.entries) row
     in let rr = parameterize-walk row-st row-entries ret
     in WalkResult {
      walked = deck-record (FunTy (pr.walked) row2 (rr.walked)),
      entries = rr.entries,
      state = rr.state
     }
    is otherwise -> parameterize-walk-children st entries ty

  parameterize-row : UnificationState, List ParamEntry, EffectRow -> (EffectRow, List ParamEntry, UnificationState)
  parameterize-row (st) (entries) (row) =
   if text-length (row.tail-name) == 0 then (row, entries, st)
   else if row.tail-id >= 0 then (row, entries, st)
   else let looked = find-param-entry entries (row.tail-name) True 0 (list-length entries)
   in if looked >= 0 then (deck-record (row-with-tail-id row looked), entries, st)
   else let (new-id, fr-st) = fresh-row-id st
   in let new-entry = ParamEntry {
    param-name = row.tail-name,
    var-id = __narrow new-id,
    is-row = True
   }
   in (deck-record (row-with-tail-id row new-id), list-push entries new-entry, fr-st)

  parameterize-walk-children : UnificationState, List ParamEntry, CodexType -> WalkResult
  parameterize-walk-children (st) (entries) (ty) =
   when ty
    is FunTy (param) (row) (ret) ->
     let pr = parameterize-walk st entries param
     in let (row2, row-entries, row-st) = parameterize-row (pr.state) (pr.entries) row
     in let rr = parameterize-walk row-st row-entries ret
     in WalkResult {
      walked = deck-record (FunTy (pr.walked) row2 (rr.walked)),
      entries = rr.entries,
      state = rr.state
     }
    is ListTy (elem) ->
     let er = parameterize-walk st entries elem
     in WalkResult {
      walked = deck-record (ListTy (er.walked)),
      entries = er.entries,
      state = er.state
     }
    is LinkedListTy (elem) ->
     let er = parameterize-walk st entries elem
     in WalkResult {
      walked = deck-record (LinkedListTy (er.walked)),
      entries = er.entries,
      state = er.state
     }
    is ForAllTy (id) (body) ->
     let br = parameterize-walk st entries body
     in WalkResult {
      walked = deck-record (ForAllTy id (br.walked)),
      entries = br.entries,
      state = br.state
     }
    is ForAllEff (id) (body) ->
     let br = parameterize-walk st entries body
     in WalkResult {
      walked = deck-record (ForAllEff id (br.walked)),
      entries = br.entries,
      state = br.state
     }
    is EffectfulTy (effs) (sc) (ret) ->
     let rr = parameterize-walk st entries ret
     in WalkResult {
      walked = deck-record (EffectfulTy effs sc (rr.walked)),
      entries = rr.entries,
      state = rr.state
     }
    is ConstructedTy (name) (args) ->
     let args-r = parameterize-walk-list st entries args 0 (list-length args) []
     in WalkResult {
      walked = deck-record (ConstructedTy name (args-r.walked-list)),
      entries = args-r.entries,
      state = args-r.state
     }
    is RecordTy (rname) (rargs) (rfields) ->
     if list-length rargs == 0 & record-fields-have-open-names rfields 0 (list-length rfields) == False then WalkResult { walked = ty, entries = entries, state = st }
     else let args-r = parameterize-walk-list st entries rargs 0 (list-length rargs) []
     in let fields-r = parameterize-walk-record-fields (args-r.state) (args-r.entries) rfields 0 (list-length rfields) []
     in WalkResult {
      walked = deck-record (RecordTy rname (args-r.walked-list) (fields-r.walked-fields)),
      entries = fields-r.entries,
      state = fields-r.state
     }
    is SumTy (sname) (sargs) (sctors) ->
     if list-length sargs == 0 & sum-ctors-have-open-names sctors 0 (list-length sctors) == False then WalkResult { walked = ty, entries = entries, state = st }
     else let args-r = parameterize-walk-list st entries sargs 0 (list-length sargs) []
     in let ctors-r = parameterize-walk-sum-ctors (args-r.state) (args-r.entries) sctors 0 (list-length sctors) []
     in WalkResult {
      walked = deck-record (SumTy sname (args-r.walked-list) (ctors-r.walked-ctors)),
      entries = ctors-r.entries,
      state = ctors-r.state
     }
    is TypeApply (tf) (ta) ->
     let fr = parameterize-walk st entries tf
     in let ar = parameterize-walk (fr.state) (fr.entries) ta
     in WalkResult { walked = deck-record (TypeApply (fr.walked) (ar.walked)), entries = ar.entries, state = ar.state }
    is LinearTy (linner) ->
     let lr = parameterize-walk st entries linner
     in WalkResult {
      walked = deck-record (LinearTy (lr.walked)),
      entries = lr.entries,
      state = lr.state
     }
    is otherwise -> WalkResult {
     walked = ty,
     entries = entries,
     state = st
    }

  ParameterizeFieldsResult = record {
   walked-fields : List RecordField,
   entries : List ParamEntry,
   state : UnificationState
  }

  parameterize-walk-record-fields : UnificationState, List ParamEntry, List RecordField, Integer, Integer, List RecordField -> ParameterizeFieldsResult
  parameterize-walk-record-fields (st) (entries) (fields) (i) (len) (acc) =
   if i == len then ParameterizeFieldsResult {
    walked-fields = acc,
    entries = entries,
    state = st
   }
   else let f = list-at fields i
   in let r = parameterize-walk st entries (f.type-val)
   in let f2 = deck-record (RecordField { name = f.name, type-val = r.walked })
   in parameterize-walk-record-fields (r.state) (r.entries) fields (i + 1) len (list-push acc f2)

  ParameterizeCtorsResult = record {
   walked-ctors : List SumCtor,
   entries : List ParamEntry,
   state : UnificationState
  }

  parameterize-walk-sum-ctors : UnificationState, List ParamEntry, List SumCtor, Integer, Integer, List SumCtor -> ParameterizeCtorsResult
  parameterize-walk-sum-ctors (st) (entries) (ctors) (i) (len) (acc) =
   if i == len then ParameterizeCtorsResult {
    walked-ctors = acc,
    entries = entries,
    state = st
   }
   else let c = list-at ctors i
   in let r = parameterize-walk-list st entries (c.fields) 0 (list-length (c.fields)) []
   in let rr = parameterize-walk-list (r.state) (r.entries) (c.return-type) 0 (list-length (c.return-type)) []
   in let c2 = deck-record (SumCtor { name = c.name, fields = r.walked-list, return-type = rr.walked-list })
   in parameterize-walk-sum-ctors (rr.state) (rr.entries) ctors (i + 1) len (list-push acc c2)

  type-has-open-names : CodexType -> Boolean
  type-has-open-names (ty) =
   when ty
    is ConstructedTy (name) (args) ->
     if is-value-name (name.value) then True
     else types-have-open-names args 0 (list-length args)
    is FunTy (param) (row) (ret) ->
     if type-has-open-names param then True
     else if text-length (row.tail-name) > 0 & row.tail-id < 0 then True
     else type-has-open-names ret
    is ListTy (elem) -> type-has-open-names elem
    is LinkedListTy (elem) -> type-has-open-names elem
    is ForAllTy (id) (body) -> type-has-open-names body
    is ForAllEff (id) (body) -> type-has-open-names body
    is EffectfulTy (effs) (sc) (ret) -> type-has-open-names ret
    is LinearTy (linner) -> type-has-open-names linner
    is TypeApply (tf) (ta) ->
     if type-has-open-names tf then True else type-has-open-names ta
    is RecordTy (rname) (rargs) (rfields) ->
     if types-have-open-names rargs 0 (list-length rargs) then True
     else record-fields-have-open-names rfields 0 (list-length rfields)
    is SumTy (sname) (sargs) (sctors) ->
     if types-have-open-names sargs 0 (list-length sargs) then True
     else sum-ctors-have-open-names sctors 0 (list-length sctors)
    is otherwise -> False

  types-have-open-names : List CodexType, Integer, Integer -> Boolean
  types-have-open-names (tys) (i) (len) =
   if i == len then False
   else if type-has-open-names (list-at tys i) then True
   else types-have-open-names tys (i + 1) len

  record-fields-have-open-names : List RecordField, Integer, Integer -> Boolean
  record-fields-have-open-names (fields) (i) (len) =
   if i == len then False
   else if type-has-open-names ((list-at fields i).type-val) then True
   else record-fields-have-open-names fields (i + 1) len

  sum-ctors-have-open-names : List SumCtor, Integer, Integer -> Boolean
  sum-ctors-have-open-names (ctors) (i) (len) =
   if i == len then False
   else let c = list-at ctors i
   in if types-have-open-names (c.fields) 0 (list-length (c.fields)) then True
   else if types-have-open-names (c.return-type) 0 (list-length (c.return-type)) then True
   else sum-ctors-have-open-names ctors (i + 1) len

  find-param-entry : List ParamEntry, Text, Boolean, Integer, Integer -> Integer
  find-param-entry (entries) (name) (want-row) (i) (len) =
   if i == len then -1
   else let e = list-at entries i
   in if e.param-name == name & e.is-row == want-row then e.var-id
      else find-param-entry entries name want-row (i + 1) len

  WalkListResult = record {
   walked-list : List CodexType,
   entries : List ParamEntry,
   state : UnificationState
  }

  parameterize-walk-list : UnificationState, List ParamEntry, List CodexType, Integer, Integer, List CodexType -> WalkListResult
  parameterize-walk-list (st) (entries) (args) (i) (len) (acc) =
   if i == len then WalkListResult {
    walked-list = acc,
    entries = entries,
    state = st
   }
   else let r = parameterize-walk st entries (list-at args i)
   in parameterize-walk-list (r.state) (r.entries) args (i + 1) len (list-push acc (r.walked))

Section: Check Definition
  check-def : UnificationState, TypeEnv, List ADef, List TypeBinding, ADef, List RenameEntry -> CheckResult
  check-def (st) (env) (defs) (tdm) (def) (renames) =
   if def-is-induction def then check-induction-def st env defs tdm def
   else check-def-normal st env def renames

  check-def-normal : UnificationState, TypeEnv, ADef, List RenameEntry -> CheckResult
  check-def-normal (st) (env) (def) (renames) =
   let grounded = def-grounded-names st def
   in let st0 = __record-set st "effect-exempt" (list-length grounded > 0)
   in let rn = resolve-def-name renames (def.name.value) (def.chapter-slug)
   in let declared = resolve-declared-type st0 env def renames
   in let linked-state = if list-length (def.declared-type) == 0
        then let (_, link-st) = unify (declared.state) (env-lookup (declared.env) rn) (declared.expected-type) (def.span) in link-st
        else declared.state
   in let grant-row = declared-performing-row (declared.expected-type) (list-length (def.params))
   in let granted-st = __record-set linked-state "scope-grants" (grant-row.labels)
   in let env2 = bind-def-params granted-st (declared.env) (def.params) (declared.expected-type) 0 (list-length (def.params))
   in let body-r = infer-expr (env2.state) (env2.env) (def.body)
   in let remaining-inner = when deep-resolve (body-r.state) (env2.remaining-type)
        is EffectfulTy (res) (rsc) (rinner) -> rinner
        is otherwise -> env2.remaining-type
   in let (_, u-st) = unify (body-r.state) remaining-inner (body-r.inferred-type) (aexpr-span (def.body))
   in let ret-checked = lint-return-narrowing u-st (env2.env) (def.body) (body-r.inferred-type) remaining-inner (aexpr-span (def.body))
   in let effect-checked = check-effect-row-subset ret-checked (declared-performing-row (declared.expected-type) (list-length (def.params))) (body-r.effect-row) grounded (aexpr-span (def.body))
   in let rigid-checked = check-declared-rigidity effect-checked (declared.declared-vars) 0 (list-length (declared.declared-vars)) (def.name.value) (def.span)
   in let env-type = env-lookup env rn
   in let tied-state = when env-type
        is ForAllTy (id) (body) -> let (_, tied-u) = unify rigid-checked (declared.expected-type) (strip-forall-ty env-type) (def.span) in tied-u
        is ForAllEff (id) (body) -> let (_, tied-u) = unify rigid-checked (declared.expected-type) (strip-forall-ty env-type) (def.span) in tied-u
        is otherwise -> rigid-checked
   in let row-tied = if list-length (def.declared-type) == 0
        then let (_, row-u) = unify-row tied-state (last-arrow-row (declared.expected-type)) (body-r.effect-row) (def.span) in row-u
        else tied-state
   in CheckResult {
    inferred-type = declared.expected-type,
    effect-row = body-r.effect-row,
    state = row-tied
   }

  check-declared-rigidity : UnificationState, List Integer, Integer, Integer, Text, SourceSpan -> UnificationState
  check-declared-rigidity (st) (ids) (i) (len) (name) (span) =
   if i == len then st
   else let id = list-at ids i
   in let var = deck-record (TypeVar (__narrow id))
   in let settled = resolve-silent st var
   in let decided = when settled
        is TypeVar (rid) -> rid /= id
        is otherwise -> True
   in let st2 = if decided == False then st
        else add-unify-error st cdx-body-fixes-declared-var ("the body of '" & name & "' decides a type its own signature leaves to the caller: a declared type variable is fixed by the body to " & type-desc settled & ". A signature variable is the caller's to choose, so the body must answer every choice; if the body only ever answers " & type-desc settled & ", declare that.") span
   in check-declared-rigidity st2 ids (i + 1) len name span

  lint-return-narrowing : UnificationState, TypeEnv, AExpr, CodexType, CodexType, SourceSpan -> UnificationState
  lint-return-narrowing (st) (env) (body) (body-ty) (ret-ty) (span) =
   when deep-resolve st ret-ty
    is IntegerTy (lo) (hi) (mode) ->
     if lo <= i64-min & hi >= i64-max then st
     else lint-narrowing-check st env body body-ty (deck-record (IntegerTy lo hi mode)) span "bounded return"
    is otherwise -> st

  last-arrow-row : CodexType -> EffectRow
  last-arrow-row (ty) =
   when ty
    is FunTy (p) (row) (r) ->
     when r
      is FunTy (p2) (row2) (r2) -> last-arrow-row r
      is otherwise -> row
    is otherwise -> empty-row

  check-effect-row-subset : UnificationState, EffectRow, EffectRow, List Name, SourceSpan -> UnificationState
  check-effect-row-subset (st) (declared-row) (body-row) (grounded) (span) =
   let d = resolve-row st declared-row
   in let b = resolve-row st body-row
   in let declared-names = push-label-names (d.labels) 0 (list-length (d.labels)) []
   in let body-names = push-label-names (b.labels) 0 (list-length (b.labels)) []
   in find-uncovered-effect st body-names (declared-names & grounded) span 0 (list-length body-names)

  declared-performing-row : CodexType, Integer -> EffectRow
  declared-performing-row (ty) (pcount) =
   when ty
    is ForAllTy (id) (b) -> declared-performing-row b pcount
    is ForAllEff (id) (b) -> declared-performing-row b pcount
    is FunTy (p) (row) (r) -> if pcount <= 1 then row else declared-performing-row r (pcount - 1)
    is EffectfulTy (effs) (sc) (inner) -> make-row-from-names effs sc ""
    is otherwise -> empty-row

  collect-effect-names : CodexType -> List Name
  collect-effect-names (ty) =
   when ty
    is FunTy (p) (row) (r) -> (for l in (row.labels) -> l.name) & collect-effect-names r
    is ForAllTy (id) (b) -> collect-effect-names b
    is ForAllEff (id) (b) -> collect-effect-names b
    is EffectfulTy (effs) (sc) (inner) -> effs & collect-effect-names inner
    is otherwise -> []

  push-label-names : List EffectLabel, Integer, Integer, List Name -> List Name
  push-label-names (ls) (i) (len) (acc) =
   if i == len then acc
   else push-label-names ls (i + 1) len (list-push acc ((list-at ls i).name))

  find-uncovered-effect : UnificationState, List Name, List Name, SourceSpan, Integer, Integer -> UnificationState
  find-uncovered-effect (st) (body-effs) (declared-effs) (span) (i) (len) =
   if i == len then st
   else let e = list-at body-effs i
   in if effect-covered-by declared-effs (e.value) then find-uncovered-effect st body-effs declared-effs span (i + 1) len
      else add-unify-error st cdx-effect-undeclared ("Effect '" & (e.value) & "' not declared in function signature") span

  effect-covered-by : List Name, Text -> Boolean
  effect-covered-by (declared) (body-eff) =
   if name-list-has declared body-eff then True
   else let dot-pos = find-dot body-eff 0 (text-length body-eff)
   in if dot-pos >= 0 then name-list-has declared (substring body-eff 0 dot-pos)
      else False

 find-dot derives the dot's code from a literal because internal text
 is CCE: a bare 46 is ASCII thinking, and in CCE code 46 is the letter
 H, which made the dotted sub-effect relation dead code until CL 6509.

  find-dot : Text, Integer, Integer -> Integer
  find-dot (s) (i) (len) =
   if i == len then 0 - 1
   else if char-code (char-at s i) == char-code (char-at "." 0) then i
   else find-dot s (i + 1) len

  name-list-has : List Name, Text -> Boolean
  name-list-has (names) (target) = name-list-has-loop names target 0 (list-length names)

  name-list-has-loop : List Name, Text, Integer, Integer -> Boolean
  name-list-has-loop (names) (target) (i) (len) =
   if i == len then False
   else if (list-at names i).value == target then True
   else name-list-has-loop names target (i + 1) len

Section: Capability Scope

  row-any-scoped : List EffectLabel, Integer, Integer -> Boolean
  row-any-scoped (ls) (i) (len) =
   if i == len then False
   else if text-length ((list-at ls i).scope) > 0 then True
   else row-any-scoped ls (i + 1) len

  scoped-op-effect : Text -> Text
  scoped-op-effect (n) =
   if n == "read-file" then "FileSystem.Read"
   else if n == "read-file-raw" then "FileSystem.Read"
   else if n == "read-file-uni" then "FileSystem.Read"
   else if n == "read-text" then "FileSystem.Read"
   else if n == "file-exists" then "FileSystem.Read"
   else if n == "write-file" then "FileSystem.Write"
   else if n == "fetch" then "Network.Read"
   else if n == "resolve-dns" then "Network.Read"
   else if n == "post" then "Network.Write"
   else if text-length (console-channel-op n) > 0 then console-op-effect n
   else ""

  console-channel-op : Text -> Text
  console-channel-op (n) =
   if n == "print-line" then "stdout"
   else if n == "print-line-raw" then "stdout"
   else if n == "print-text" then "stdout"
   else if n == "print-line-uni" then "stdout"
   else if n == "print-uni" then "stdout"
   else if n == "print-error" then "stderr"
   else if n == "print-error-uni" then "stderr"
   else if n == "read-line" then "stdin"
   else if n == "read-line-cce" then "stdin"
   else if n == "read-key" then "stdin"
   else ""

  console-op-effect : Text -> Text
  console-op-effect (n) =
   if console-channel-op n == "stdin" then "Console.Read" else "Console.Write"

 Scope is not one relation, and reading it as one is not a
 simplification -- it is a hole. A filesystem grant is a path PREFIX.
 A network grant is an AUTHORITY. A console grant is a CHANNEL. Run
 all three through the single text-starts-with this check used to use
 and a grant over "api.example.com:443" silently admits
 "api.example.com:4433", while a grant over "api.example.com" admits
 "api.example.com.evil.net". A prefix is the right relation for a path
 and the wrong one for a name, so the relation is chosen by the effect
 family and only the filesystem gets prefixes.

  scope-kind-path : Integer = 0
  scope-kind-authority : Integer = 1
  scope-kind-channel : Integer = 2

  scope-kind : Text -> Integer
  scope-kind (eff) =
   if text-starts-with eff "Network" then scope-kind-authority
   else if text-starts-with eff "Console" then scope-kind-channel
   else scope-kind-path

  scope-admits : Text, Text, Text -> Boolean
  scope-admits (eff) (grant) (res) =
   let k = scope-kind eff
   in if k == scope-kind-authority then authority-admits grant res
      else if k == scope-kind-channel then res == grant
      else text-starts-with res grant

  authority-admits : Text, Text -> Boolean
  authority-admits (grant) (res) =
   if auth-host grant /= auth-host res then False
   else let gp = auth-port grant
   in let rp = auth-port res
   in if text-length gp == 0 then True
      else if text-length rp == 0 then True
      else gp == rp

 Authority is where they part, and reusing scope-admits here would
 launder. Its portless-RESOURCE rule -- "a resource that names no port is
 a resolve-dns hostname, which never reaches a port for us to check" -- is
 right about a resource and wrong about a scope: a SCOPE that names no
 port covers every port, so it is WIDER than one that names 443, not
 narrower. Run the inner scope through authority-admits as if it were a
 resource and Network.Connect "api.example.com" passes for a parameter
 that granted only "api.example.com:443". Hence authority-subsumes, which
 differs by exactly the clause that says so.

  scope-subsumes : Text, Text, Text -> Boolean
  scope-subsumes (eff) (outer) (inner) =
   let k = scope-kind eff
   in if k == scope-kind-authority then authority-subsumes outer inner
      else if k == scope-kind-channel then inner == outer
      else text-starts-with inner outer

  authority-subsumes : Text, Text -> Boolean
  authority-subsumes (outer) (inner) =
   if auth-host outer /= auth-host inner then False
   else let op = auth-port outer
   in if text-length op == 0 then True
      else auth-port inner == op

  auth-host : Text -> Text
  auth-host (a) =
   let p = find-char-at a ":" 0 (text-length a)
   in if p < 0 then a else substring a 0 p

  auth-port : Text -> Text
  auth-port (a) =
   let p = find-char-at a ":" 0 (text-length a)
   in if p < 0 then "" else substring a (p + 1) (text-length a - p - 1)

  find-char-at : Text, Text, Integer, Integer -> Integer
  find-char-at (s) (c) (i) (len) =
   if i == len then 0 - 1
   else if char-code (char-at s i) == char-code (char-at c 0) then i
   else find-char-at s c (i + 1) len

 A network operation names its resource as a URL; a grant names it as
 an authority. url-authority is the bridge, and the scheme is what
 supplies the port the URL leaves implicit -- so a grant written
 "api.example.com:443" is what a fetch of "https://api.example.com/x"
 must sit inside.

  url-authority : Text -> Text
  url-authority (u) =
   let len = text-length u
   in let s = find-scheme-end u 0 len
   in let rest = substring u s (len - s)
   in let sl = find-char-at rest "/" 0 (text-length rest)
   in let auth = if sl < 0 then rest else substring rest 0 sl
   in if find-char-at auth ":" 0 (text-length auth) >= 0 then auth
      else auth & ":" & (if text-starts-with u "https" then "443" else "80")

  find-scheme-end : Text, Integer, Integer -> Integer
  find-scheme-end (u) (i) (len) =
   if i + 2 >= len then 0
   else if is-scheme-sep u i then i + 3
   else find-scheme-end u (i + 1) len

  is-scheme-sep : Text, Integer -> Boolean
  is-scheme-sep (u) (i) =
   let a = char-code (char-at u i)
   in let b = char-code (char-at u (i + 1))
   in let c = char-code (char-at u (i + 2))
   in a == char-code (char-at ":" 0) & b == char-code (char-at "/" 0) & c == char-code (char-at "/" 0)

  op-resource : Text, Text -> Text
  op-resource (eff) (v) =
   if scope-kind eff == scope-kind-authority then url-authority v else v

  scope-permits : List EffectLabel, Text, Text, Integer, Integer -> Boolean
  scope-permits (ls) (eff) (res) (i) (len) =
   if i == len then False
   else let l = list-at ls i
   in if effect-covered-by [l.name] eff == False then scope-permits ls eff res (i + 1) len
      else if text-length (l.scope) == 0 then True
      else if scope-admits eff (l.scope) res then True
      else scope-permits ls eff res (i + 1) len

  effect-has-grant : List EffectLabel, Text, Integer, Integer -> Boolean
  effect-has-grant (ls) (eff) (i) (len) =
   if i == len then False
   else if effect-covered-by [(list-at ls i).name] eff then True
   else effect-has-grant ls eff (i + 1) len

  collect-effect-labels : CodexType -> List EffectLabel
  collect-effect-labels (ty) =
   when ty
    is FunTy (p) (row) (r) -> (row.labels) & collect-effect-labels r
    is ForAllTy (id) (b) -> collect-effect-labels b
    is ForAllEff (id) (b) -> collect-effect-labels b
    is EffectfulTy (effs) (sc) (inner) -> (make-row-from-names effs sc "").labels & collect-effect-labels inner
    is otherwise -> []

  check-callee-scopes : UnificationState, List EffectLabel, List EffectLabel, Text, SourceSpan, Integer, Integer -> UnificationState
  check-callee-scopes (st) (grants) (callee-labels) (fname) (span) (i) (len) =
   if i == len then st
   else let l = list-at callee-labels i
   in let eff = (l.name).value
   in if effect-has-grant grants eff 0 (list-length grants) == False then check-callee-scopes st grants callee-labels fname span (i + 1) len
      else if scope-permits grants eff (l.scope) 0 (list-length grants) then check-callee-scopes st grants callee-labels fname span (i + 1) len
      else if text-length (l.scope) == 0 then add-unify-error st cdx-scope-violation ("'" & fname & "' performs " & eff & " with no scope of its own, so it may touch anything, and this signature grants " & eff & " only over a narrower scope. Declare the scope on '" & fname & "', or widen the grant.") span
      else add-unify-error st cdx-scope-violation ("'" & fname & "' is declared over the scope \"" & (l.scope) & "\" for " & eff & ", which is not inside the scope this signature grants. A scope may narrow, never widen.") span

  lint-effect-scope : UnificationState, TypeEnv, AExpr, AExpr, SourceSpan -> UnificationState
  lint-effect-scope (st) (env) (func) (arg) (span) =
   let grants = st.scope-grants
   in if row-any-scoped grants 0 (list-length grants) == False then st
   else when func
    is ANameExpr (n) (s) -> lint-scoped-call st env grants (n.value) arg span
    is otherwise -> st

  lint-scoped-call : UnificationState, TypeEnv, List EffectLabel, Text, AExpr, SourceSpan -> UnificationState
  lint-scoped-call (st) (env) (grants) (fname) (arg) (span) =
   let eff = scoped-op-effect fname
   in if text-length eff == 0 then lint-callee-scopes st env grants fname span
   else let ch = console-channel-op fname
   in if text-length ch > 0 then lint-fixed-resource st grants eff fname ch span
   else lint-scoped-op st grants eff fname arg span

  lint-callee-scopes : UnificationState, TypeEnv, List EffectLabel, Text, SourceSpan -> UnificationState
  lint-callee-scopes (st) (env) (grants) (fname) (span) =
   if env-has env fname then
    let cls = collect-effect-labels (env-lookup env fname)
    in check-callee-scopes st grants cls fname span 0 (list-length cls)
   else st

  lint-fixed-resource : UnificationState, List EffectLabel, Text, Text, Text, SourceSpan -> UnificationState
  lint-fixed-resource (st) (grants) (eff) (fname) (res) (span) =
   if effect-has-grant grants eff 0 (list-length grants) == False then st
   else if scope-permits grants eff res 0 (list-length grants) then st
   else add-unify-error st cdx-scope-violation ("'" & fname & "' uses the \"" & res & "\" channel, which is outside the scope this signature grants for " & eff & ".") span

  lint-scoped-op : UnificationState, List EffectLabel, Text, Text, AExpr, SourceSpan -> UnificationState
  lint-scoped-op (st) (grants) (eff) (fname) (arg) (span) =
   if effect-has-grant grants eff 0 (list-length grants) == False then st
   else when arg
    is ALitExpr (v) (k) (s) ->
     when k
      is TextLit ->
       if scope-permits grants eff (op-resource eff v) 0 (list-length grants) then st
       else add-unify-error st cdx-scope-violation ("'" & fname & "' names \"" & v & "\", which is outside the scope this signature grants for " & eff & ".") span
      is otherwise -> st
    is otherwise -> add-unify-error st cdx-scope-violation ("'" & fname & "' is given a computed resource, so the compiler cannot prove it stays inside the scope this signature grants for " & eff & ". Pass a literal, or widen the declared scope.") span

  slug-grounded-names : List Text, Text, Integer, Integer, List Name -> List Name
  slug-grounded-names (gs) (slug) (i) (len) (acc) =
   if i >= len then acc
   else let e = list-at gs i
   in let pfx = slug & "\n"
   in if text-starts-with e pfx
      then slug-grounded-names gs slug (i + 1) len (list-push acc (make-name (deck-record (substring e (text-length pfx) (text-length e - text-length pfx)))))
      else slug-grounded-names gs slug (i + 1) len acc

  def-grounded-names : UnificationState, ADef -> List Name
  def-grounded-names (st) (def) =
   slug-grounded-names (st.chapter-grounds) (def.chapter-slug) 0 (list-length (st.chapter-grounds)) []

  DefSetup = record {
   expected-type : CodexType,
   remaining-type : CodexType,
   state : UnificationState,
   env : TypeEnv,
   declared-vars : List Integer
  }

  resolve-declared-type : UnificationState, TypeEnv, ADef, List RenameEntry -> DefSetup
  resolve-declared-type (st) (env) (def) (renames) =
   if list-length (def.declared-type) == 0
    then
     let pcount = list-length (def.params)
     in let (fun-ty, fun-st) = build-undeclared-fun-type st pcount
     in DefSetup {
      expected-type = fun-ty,
      remaining-type = fun-ty,
      state = fun-st,
      env = env,
      declared-vars = []
     }
    else let env-type = env-lookup env (resolve-def-name renames (def.name.value) (def.chapter-slug))
    in let (inst-ty, inst-st, minted) = instantiate-collect st env-type []
    in DefSetup {
      expected-type = inst-ty,
      remaining-type = inst-ty,
      state = inst-st,
      env = env,
      declared-vars = minted
     }

  build-undeclared-fun-type : UnificationState, Integer -> (CodexType, UnificationState)
  build-undeclared-fun-type (st) (pcount) =
   let (body-ty, body-st) = fresh-and-advance st
   in if pcount == 0 then (body-ty, body-st)
   else let (row-id, row-st) = fresh-row-id body-st
   in let (p-ty, p-st) = fresh-and-advance row-st
   in build-fun-type-loop p-st (pcount - 1) (FunTy p-ty (deck-record (row-var row-id)) body-ty)

  build-fun-type-loop : UnificationState, Integer, CodexType -> (CodexType, UnificationState)
  build-fun-type-loop (st) (n) (acc) =
   if n == 0 then (acc, st)
   else let (fr-ty, fr-st) = fresh-and-advance st
   in build-fun-type-loop fr-st (n - 1) (FunTy fr-ty empty-row acc)

  DefParamResult = record {
   state : UnificationState,
   env : TypeEnv,
   remaining-type : CodexType
  }

  bind-def-params : UnificationState, TypeEnv, List AParam, CodexType, Integer, Integer -> DefParamResult
  bind-def-params (st) (env) (params) (remaining) (i) (len) =
   if i == len then DefParamResult {
    state = st,
    env = env,
    remaining-type = remaining
   }
   else let p = list-at params i
   in when remaining
     is FunTy (param-ty) (row) (ret-ty) ->
      let bound-ty = strip-linear-ty param-ty
      in let env2 = env-bind-local env (p.name.value) bound-ty
   in let env3 = bind-param-range env2 (p.name.value) bound-ty
   in bind-def-params st env3 params ret-ty (i + 1) len
     is otherwise ->
      let (fr-ty, fr-st) = fresh-and-advance st
   in let env2 = env-bind-local env (p.name.value) fr-ty
   in bind-def-params fr-st env2 params remaining (i + 1) len

  bind-param-range : TypeEnv, Text, CodexType -> TypeEnv
  bind-param-range (env) (name) (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) ->
     when mode
      is OvError ->
       if lo <= i64-min & hi >= i64-max then env
       else env-add-local-range env name lo hi
      is otherwise -> env
    is otherwise -> env

Section: Check Chapter
  ChapterResult = record {
   types : List TypeBinding,
   env : TypeEnv,
   state : UnificationState,
   keep-end : Integer,
   keep-overflow : Boolean,
   batch-note : Text
  }

  register-mutable-markers : TypeEnv, List ATypeDef, Integer, Integer -> TypeEnv
  register-mutable-markers (env) (tdefs) (i) (len) =
   if i >= len then env
   else let td = list-at tdefs i
   in when td
    is ARecordTypeDef (name) (tparams) (fields) (is-mut) (s) ->
     if is-mut then let marker-name = "__mutable-" & name.value
      in register-mutable-markers (env-bind env marker-name int-ty-default) tdefs (i + 1) len
     else register-mutable-markers env tdefs (i + 1) len
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     register-mutable-markers env tdefs (i + 1) len
    is AUnitTypeDef (name) (base) (s) ->
     register-mutable-markers env tdefs (i + 1) len

  collect-mutable-names : List ATypeDef, Integer, Integer, List Text -> List Text
  collect-mutable-names (tdefs) (i) (len) (acc) =
   if i >= len then acc
   else let td = list-at tdefs i
   in when td
    is ARecordTypeDef (name) (tparams) (fields) (is-mut) (s) ->
     if is-mut then collect-mutable-names tdefs (i + 1) len (list-push acc (name.value))
     else collect-mutable-names tdefs (i + 1) len acc
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     collect-mutable-names tdefs (i + 1) len acc
    is AUnitTypeDef (name) (base) (s) ->
     collect-mutable-names tdefs (i + 1) len acc
  is-rt-name : List Text, Text, Integer, Integer -> Boolean
  is-rt-name (names) (target) (i) (len) =
   if i >= len then False
   else if list-at names i == target then True
   else is-rt-name names target (i + 1) len

  check-rt-no-lambda : UnificationState, AExpr, Text -> UnificationState
  check-rt-no-lambda (st) (expr) (fn) =
   when expr
    is ALambdaExpr (ps) (b) (s) -> __record-set st "bag" (bag-add (st.bag) (make-error cdx-rt-closure ("punctual function '" & fn & "' contains a lambda or closure") s))
    is AIfExpr (c) (t) (e) (s) -> check-rt-no-lambda (check-rt-no-lambda (check-rt-no-lambda st c fn) t fn) e fn
    is ALetExpr (bs) (b) (s) -> check-rt-no-lambda (check-rt-let-binds st bs fn 0 (list-length bs)) b fn
    is AApplyExpr (f) (a) (s) -> check-rt-no-lambda (check-rt-no-lambda st f fn) a fn
    is ABinaryExpr (l) (op) (r) (s) -> check-rt-no-lambda (check-rt-no-lambda st l fn) r fn
    is AUnaryExpr (x) (s) -> check-rt-no-lambda st x fn
    is AMatchExpr (sc) (arms) (s) -> check-rt-no-lambda-arms (check-rt-no-lambda st sc fn) arms fn 0 (list-length arms)
    is AListExpr (elems) (s) -> check-rt-lambda-elems st elems fn 0 (list-length elems)
    is ARecordExpr (n) (fields) (s) -> check-rt-lambda-fields st fields fn 0 (list-length fields)
    is AFieldAccess (obj) (f) (s) -> check-rt-no-lambda st obj fn
    is AActExpr (stmts) (s) -> check-rt-lambda-stmts st stmts fn 0 (list-length stmts)
    is ATryExpr (mx) (b) (fb) (fl) (s) -> check-rt-lambda-stmts (check-rt-lambda-stmts (check-rt-lambda-stmts st b fn 0 (list-length b)) fb fn 0 (list-length fb)) fl fn 0 (list-length fl)
    is AHandleExpr (eff) (b) (cls) (s) -> check-rt-lambda-clauses (check-rt-no-lambda st b fn) cls fn 0 (list-length cls)
    is AWithTimeoutExpr (t) (effs) (scopes) (b) (s) -> check-rt-no-lambda st b fn
    is AFieldAssignExpr (rec) (f) (val) (s) -> check-rt-no-lambda (check-rt-no-lambda st rec fn) val fn
    is ALazyExpr (inner) (s) -> check-rt-no-lambda st inner fn
    is otherwise -> st

  check-rt-let-binds : UnificationState, List ALetBind, Text, Integer, Integer -> UnificationState
  check-rt-let-binds (st) (bs) (fn) (i) (len) =
   if i >= len then st
   else let b = list-at bs i
   in check-rt-let-binds (check-rt-no-lambda st (b.value) fn) bs fn (i + 1) len

  check-rt-no-lambda-arms : UnificationState, List AMatchArm, Text, Integer, Integer -> UnificationState
  check-rt-no-lambda-arms (st) (arms) (fn) (i) (len) =
   if i >= len then st
   else let arm = list-at arms i
   in check-rt-no-lambda-arms (check-rt-no-lambda (check-rt-no-lambda st (arm.guard) fn) (arm.body) fn) arms fn (i + 1) len

  check-rt-lambda-elems : UnificationState, List AExpr, Text, Integer, Integer -> UnificationState
  check-rt-lambda-elems (st) (elems) (fn) (i) (len) =
   if i >= len then st
   else check-rt-lambda-elems (check-rt-no-lambda st (list-at elems i) fn) elems fn (i + 1) len

  check-rt-lambda-fields : UnificationState, List AFieldExpr, Text, Integer, Integer -> UnificationState
  check-rt-lambda-fields (st) (fields) (fn) (i) (len) =
   if i >= len then st
   else check-rt-lambda-fields (check-rt-no-lambda st ((list-at fields i).value) fn) fields fn (i + 1) len

  check-rt-lambda-stmts : UnificationState, List AActStmt, Text, Integer, Integer -> UnificationState
  check-rt-lambda-stmts (st) (stmts) (fn) (i) (len) =
   if i >= len then st
   else when (list-at stmts i)
    is AActExprStmt (e) (s) -> check-rt-lambda-stmts (check-rt-no-lambda st e fn) stmts fn (i + 1) len
    is AActBindStmt (n) (e) (s) -> check-rt-lambda-stmts (check-rt-no-lambda st e fn) stmts fn (i + 1) len

  check-rt-lambda-clauses : UnificationState, List AHandleClause, Text, Integer, Integer -> UnificationState
  check-rt-lambda-clauses (st) (cls) (fn) (i) (len) =
   if i >= len then st
   else check-rt-lambda-clauses (check-rt-no-lambda st ((list-at cls i).body) fn) cls fn (i + 1) len

  is-rt-unsafe-name : Text -> Boolean
  is-rt-unsafe-name (n) =
   n == "__alloc" | n == "list-push" | n == "list-concat" | n == "__list-with-capacity" | n == "__linked-list-push"

  is-rt-safe-builtin : Text -> Boolean
  is-rt-safe-builtin (n) =
   n == "list-at" | n == "list-length" | n == "text-length" | n == "text-at" | n == "array-at" | n == "array-length" | n == "bit-and" | n == "bit-or" | n == "bit-xor" | n == "bit-shl" | n == "bit-shr" | n == "bit-shru" | n == "bit-not" | n == "int-mod" | n == "int-rem" | n == "abs" | n == "min" | n == "max"

  check-rt-calls : UnificationState, AExpr, Text, List Text -> UnificationState
  check-rt-calls (st) (expr) (fn) (rt-names) =
   when expr
    is AApplyExpr (f) (a) (s) -> let st1 = check-rt-calls st a fn rt-names in when f is ANameExpr (n) (ns) -> if is-rt-name rt-names (n.value) 0 (list-length rt-names) | is-rt-safe-builtin (n.value) then st1 else __record-set st1 "bag" (bag-add (st1.bag) (make-error cdx-rt-calls-unsafe ("punctual function '" & fn & "' calls '" & n.value & "' which is not punctual") ns)) is AApplyExpr (f2) (a2) (s2) -> check-rt-calls st1 f fn rt-names is otherwise -> check-rt-calls (__record-set st1 "bag" (bag-add (st1.bag) (make-error cdx-rt-calls-unsafe ("punctual function '" & fn & "' calls through a computed head; a punctual call must name its callee") s))) f fn rt-names
    is AIfExpr (c) (t) (e) (s) -> check-rt-calls (check-rt-calls (check-rt-calls st c fn rt-names) t fn rt-names) e fn rt-names
    is ALetExpr (bs) (b) (s) -> check-rt-calls (check-rt-calls-let-binds st bs fn rt-names 0 (list-length bs)) b fn rt-names
    is ABinaryExpr (l) (op) (r) (s) -> check-rt-calls (check-rt-calls st l fn rt-names) r fn rt-names
    is AUnaryExpr (x) (s) -> check-rt-calls st x fn rt-names
    is AMatchExpr (sc) (arms) (s) -> check-rt-calls-match-arms (check-rt-calls st sc fn rt-names) arms fn rt-names 0 (list-length arms)
    is AListExpr (elems) (s) -> check-rt-calls-elems st elems fn rt-names 0 (list-length elems)
    is ARecordExpr (n) (fields) (s) -> check-rt-calls-fields st fields fn rt-names 0 (list-length fields)
    is AFieldAccess (obj) (f) (s) -> check-rt-calls st obj fn rt-names
    is AActExpr (stmts) (s) -> check-rt-calls-stmts st stmts fn rt-names 0 (list-length stmts)
    is ATryExpr (mx) (b) (fb) (fl) (s) -> check-rt-calls-stmts (check-rt-calls-stmts (check-rt-calls-stmts st b fn rt-names 0 (list-length b)) fb fn rt-names 0 (list-length fb)) fl fn rt-names 0 (list-length fl)
    is AHandleExpr (eff) (b) (cls) (s) -> check-rt-calls-clauses (check-rt-calls st b fn rt-names) cls fn rt-names 0 (list-length cls)
    is AWithTimeoutExpr (t) (effs) (scopes) (b) (s) -> check-rt-calls st b fn rt-names
    is AFieldAssignExpr (rec) (f) (val) (s) -> check-rt-calls (check-rt-calls st rec fn rt-names) val fn rt-names
    is ALazyExpr (inner) (s) -> check-rt-calls st inner fn rt-names
    is otherwise -> st

  check-rt-calls-let-binds : UnificationState, List ALetBind, Text, List Text, Integer, Integer -> UnificationState
  check-rt-calls-let-binds (st) (bs) (fn) (rt-names) (i) (len) =
   if i >= len then st
   else let b = list-at bs i
   in check-rt-calls-let-binds (check-rt-calls st (b.value) fn rt-names) bs fn rt-names (i + 1) len

  check-rt-calls-match-arms : UnificationState, List AMatchArm, Text, List Text, Integer, Integer -> UnificationState
  check-rt-calls-match-arms (st) (arms) (fn) (rt-names) (i) (len) =
   if i >= len then st
   else let arm = list-at arms i
   in check-rt-calls-match-arms (check-rt-calls (check-rt-calls st (arm.guard) fn rt-names) (arm.body) fn rt-names) arms fn rt-names (i + 1) len

  check-rt-calls-elems : UnificationState, List AExpr, Text, List Text, Integer, Integer -> UnificationState
  check-rt-calls-elems (st) (elems) (fn) (rt-names) (i) (len) =
   if i >= len then st
   else check-rt-calls-elems (check-rt-calls st (list-at elems i) fn rt-names) elems fn rt-names (i + 1) len

  check-rt-calls-fields : UnificationState, List AFieldExpr, Text, List Text, Integer, Integer -> UnificationState
  check-rt-calls-fields (st) (fields) (fn) (rt-names) (i) (len) =
   if i >= len then st
   else check-rt-calls-fields (check-rt-calls st ((list-at fields i).value) fn rt-names) fields fn rt-names (i + 1) len

  check-rt-calls-stmts : UnificationState, List AActStmt, Text, List Text, Integer, Integer -> UnificationState
  check-rt-calls-stmts (st) (stmts) (fn) (rt-names) (i) (len) =
   if i >= len then st
   else when (list-at stmts i)
    is AActExprStmt (e) (s) -> check-rt-calls-stmts (check-rt-calls st e fn rt-names) stmts fn rt-names (i + 1) len
    is AActBindStmt (n) (e) (s) -> check-rt-calls-stmts (check-rt-calls st e fn rt-names) stmts fn rt-names (i + 1) len

  check-rt-calls-clauses : UnificationState, List AHandleClause, Text, List Text, Integer, Integer -> UnificationState
  check-rt-calls-clauses (st) (cls) (fn) (rt-names) (i) (len) =
   if i >= len then st
   else check-rt-calls-clauses (check-rt-calls st ((list-at cls i).body) fn rt-names) cls fn rt-names (i + 1) len

  check-rt-no-alloc : UnificationState, AExpr, Text -> UnificationState
  check-rt-no-alloc (st) (expr) (fn) =
   when expr
    is ANameExpr (n) (s) -> if is-rt-unsafe-name (n.value) then __record-set st "bag" (bag-add (st.bag) (make-error cdx-rt-heap-alloc ("[HardRealtime] function '" & fn & "' uses heap-allocating builtin '" & n.value & "'") s)) else st
    is ABinaryExpr (l) (op) (r) (s) -> let st1 = check-rt-no-alloc (check-rt-no-alloc st l fn) r fn in when op is OpAppend -> __record-set st1 "bag" (bag-add (st1.bag) (make-error cdx-rt-heap-alloc ("[HardRealtime] function '" & fn & "' uses text concatenation (&)") s)) is OpBoolAnd -> st1 is OpAnd -> (when (expr-type-scan st1 s) is BooleanTy -> st1 is ErrorTy -> st1 is otherwise -> __record-set st1 "bag" (bag-add (st1.bag) (make-error cdx-rt-heap-alloc ("[HardRealtime] function '" & fn & "' uses concatenation (&), which allocates") s))) is otherwise -> st1
    is AIfExpr (c) (t) (e) (s) -> check-rt-no-alloc (check-rt-no-alloc (check-rt-no-alloc st c fn) t fn) e fn
    is ALetExpr (bs) (b) (s) -> check-rt-no-alloc (check-rt-alloc-let-binds st bs fn 0 (list-length bs)) b fn
    is AApplyExpr (f) (a) (s) -> check-rt-no-alloc (check-rt-no-alloc st f fn) a fn
    is AMatchExpr (sc) (arms) (s) -> check-rt-alloc-match-arms (check-rt-no-alloc st sc fn) arms fn 0 (list-length arms)
    is ARecordExpr (n) (fields) (s) -> check-rt-alloc-fields (__record-set st "bag" (bag-add (st.bag) (make-error cdx-rt-heap-alloc ("[HardRealtime] function '" & fn & "' constructs record '" & (n.value) & "' (heap allocation)") s))) fields fn 0 (list-length fields)
    is AListExpr (elems) (s) -> check-rt-alloc-elems (__record-set st "bag" (bag-add (st.bag) (make-error cdx-rt-heap-alloc ("[HardRealtime] function '" & fn & "' builds a list literal (heap allocation)") s))) elems fn 0 (list-length elems)
    is AUnaryExpr (x) (s) -> check-rt-no-alloc st x fn
    is AFieldAccess (obj) (f) (s) -> check-rt-no-alloc st obj fn
    is AActExpr (stmts) (s) -> check-rt-alloc-stmts st stmts fn 0 (list-length stmts)
    is ATryExpr (mx) (b) (fb) (fl) (s) -> check-rt-alloc-stmts (check-rt-alloc-stmts (check-rt-alloc-stmts st b fn 0 (list-length b)) fb fn 0 (list-length fb)) fl fn 0 (list-length fl)
    is AHandleExpr (eff) (b) (cls) (s) -> check-rt-alloc-clauses (check-rt-no-alloc st b fn) cls fn 0 (list-length cls)
    is AWithTimeoutExpr (t) (effs) (scopes) (b) (s) -> check-rt-no-alloc st b fn
    is AFieldAssignExpr (rec) (f) (val) (s) -> check-rt-no-alloc (check-rt-no-alloc st rec fn) val fn
    is ALazyExpr (inner) (s) -> check-rt-no-alloc st inner fn
    is otherwise -> st

  check-rt-alloc-fields : UnificationState, List AFieldExpr, Text, Integer, Integer -> UnificationState
  check-rt-alloc-fields (st) (fields) (fn) (i) (len) =
   if i >= len then st
   else check-rt-alloc-fields (check-rt-no-alloc st ((list-at fields i).value) fn) fields fn (i + 1) len

  check-rt-alloc-elems : UnificationState, List AExpr, Text, Integer, Integer -> UnificationState
  check-rt-alloc-elems (st) (elems) (fn) (i) (len) =
   if i >= len then st
   else check-rt-alloc-elems (check-rt-no-alloc st (list-at elems i) fn) elems fn (i + 1) len

  check-rt-alloc-let-binds : UnificationState, List ALetBind, Text, Integer, Integer -> UnificationState
  check-rt-alloc-let-binds (st) (bs) (fn) (i) (len) =
   if i >= len then st
   else let b = list-at bs i
   in check-rt-alloc-let-binds (check-rt-no-alloc st (b.value) fn) bs fn (i + 1) len

  check-rt-alloc-match-arms : UnificationState, List AMatchArm, Text, Integer, Integer -> UnificationState
  check-rt-alloc-match-arms (st) (arms) (fn) (i) (len) =
   if i >= len then st
   else let arm = list-at arms i
   in check-rt-alloc-match-arms (check-rt-no-alloc (check-rt-no-alloc st (arm.guard) fn) (arm.body) fn) arms fn (i + 1) len

  check-rt-alloc-stmts : UnificationState, List AActStmt, Text, Integer, Integer -> UnificationState
  check-rt-alloc-stmts (st) (stmts) (fn) (i) (len) =
   if i >= len then st
   else when (list-at stmts i)
    is AActExprStmt (e) (s) -> check-rt-alloc-stmts (check-rt-no-alloc st e fn) stmts fn (i + 1) len
    is AActBindStmt (n) (e) (s) -> check-rt-alloc-stmts (check-rt-no-alloc st e fn) stmts fn (i + 1) len

  check-rt-alloc-clauses : UnificationState, List AHandleClause, Text, Integer, Integer -> UnificationState
  check-rt-alloc-clauses (st) (cls) (fn) (i) (len) =
   if i >= len then st
   else check-rt-alloc-clauses (check-rt-no-alloc st ((list-at cls i).body) fn) cls fn (i + 1) len

  check-rt-effects : UnificationState, CodexType, Text, SourceSpan -> UnificationState
  check-rt-effects (st) (ty) (fn) (span) =
   let effs = collect-effect-names ty
   in check-rt-effects-loop st effs fn span 0 (list-length effs)

  check-rt-effects-loop : UnificationState, List Name, Text, SourceSpan, Integer, Integer -> UnificationState
  check-rt-effects-loop (st) (effs) (fn) (span) (i) (len) =
   if i >= len then st
   else let e = list-at effs i
   in check-rt-effects-loop (__record-set st "bag" (bag-add (st.bag) (make-error cdx-rt-bare-io ("punctual function '" & fn & "' declares effect '" & e.value & "'; bounded execution requires an effect-free signature") span))) effs fn span (i + 1) len

  has-self-call : AExpr, Text -> Boolean
  has-self-call (expr) (fn) =
   when expr
    is ANameExpr (n) (s) -> n.value == fn
    is AApplyExpr (f) (a) (s) -> has-self-call f fn | has-self-call a fn
    is AIfExpr (c) (t) (e) (s) -> has-self-call c fn | has-self-call t fn | has-self-call e fn
    is ALetExpr (bs) (b) (s) -> has-self-call-binds bs fn 0 (list-length bs) | has-self-call b fn
    is ABinaryExpr (l) (op) (r) (s) -> has-self-call l fn | has-self-call r fn
    is AUnaryExpr (x) (s) -> has-self-call x fn
    is AMatchExpr (sc) (arms) (s) -> has-self-call sc fn | has-self-call-arms arms fn 0 (list-length arms)
    is ALambdaExpr (ps) (b) (s) -> has-self-call b fn
    is AListExpr (elems) (s) -> has-self-call-list elems fn 0 (list-length elems)
    is ARecordExpr (n) (fields) (s) -> has-self-call-fields fields fn 0 (list-length fields)
    is AFieldAccess (obj) (f) (s) -> has-self-call obj fn
    is AActExpr (stmts) (s) -> has-self-call-stmts stmts fn 0 (list-length stmts)
    is ATryExpr (mx) (b) (fb) (fl) (s) -> has-self-call-stmts b fn 0 (list-length b) | has-self-call-stmts fb fn 0 (list-length fb) | has-self-call-stmts fl fn 0 (list-length fl)
    is AHandleExpr (eff) (b) (cls) (s) -> has-self-call b fn
    is AWithTimeoutExpr (t) (effs) (scopes) (b) (s) -> has-self-call b fn
    is AFieldAssignExpr (rec) (f) (val) (s) -> has-self-call rec fn | has-self-call val fn
    is ALazyExpr (inner) (s) -> has-self-call inner fn
    is otherwise -> False

  has-self-call-arms : List AMatchArm, Text, Integer, Integer -> Boolean
  has-self-call-arms (arms) (fn) (i) (len) =
   if i >= len then False
   else let arm = list-at arms i
   in if has-self-call (arm.guard) fn | has-self-call (arm.body) fn then True
   else has-self-call-arms arms fn (i + 1) len

  has-self-call-binds : List ALetBind, Text, Integer, Integer -> Boolean
  has-self-call-binds (bs) (fn) (i) (len) =
   if i >= len then False
   else if has-self-call ((list-at bs i).value) fn then True
   else has-self-call-binds bs fn (i + 1) len

  has-self-call-list : List AExpr, Text, Integer, Integer -> Boolean
  has-self-call-list (elems) (fn) (i) (len) =
   if i >= len then False
   else if has-self-call (list-at elems i) fn then True
   else has-self-call-list elems fn (i + 1) len

  has-self-call-fields : List AFieldExpr, Text, Integer, Integer -> Boolean
  has-self-call-fields (fields) (fn) (i) (len) =
   if i >= len then False
   else if has-self-call ((list-at fields i).value) fn then True
   else has-self-call-fields fields fn (i + 1) len

  has-self-call-stmts : List AActStmt, Text, Integer, Integer -> Boolean
  has-self-call-stmts (stmts) (fn) (i) (len) =
   if i >= len then False
   else when (list-at stmts i)
    is AActExprStmt (e) (s) -> if has-self-call e fn then True else has-self-call-stmts stmts fn (i + 1) len
    is AActBindStmt (n) (e) (s) -> if has-self-call e fn then True else has-self-call-stmts stmts fn (i + 1) len

Section: Cost Model 3.3 -- the growing rung

 Cost Model 3.3, scored against `codex/test/cost/accumulator-corpus`. Damian
 ruled the shape on 2026-08-16: the declaration is `bounded <class>`, a
 CEILING in the lattice `none < fixed < linear < growing`, inferred bottom-up
 from the body and refused transitively as CDX6001 is. This is the inference
 for the top rung only -- it answers whether a definition is `growing` -- and
 the declaration, the other three rungs and the refusal codes are not here.

 It is reached only through the `cost-report` mode flag, which is off for
 every ordinary compile, because nothing declares anything yet. Measured
 against the corpus: 5 of 5 quadratic entries inferred growing, 4 of 5 linear
 entries left alone, `n-fixed-appends` the one false positive. Section 7 of
 `docs/Designs/Active/Features/CostModel.md` carries the table.

 It raises an error rather than an info because nothing prints a bag's
 non-error diagnostics on a compile that succeeds: `bag-diagnostics` is
 defined in `DiagnosticBag.codex` and called from nowhere. An info here would
 be a measurement that cannot be read.

 The walk runs from the last definition backwards because the bag truncates
 around twenty entries and a compilation unit puts the chapter under test
 AFTER the foreword chapters it cites. Forward, the report is all
 `ListUtils` and the subject never appears, which reads exactly like a check
 that found nothing.

  cost-apply-head : AExpr -> Text
  cost-apply-head (e) = when e
    is AApplyExpr (f) (a) (s) -> cost-apply-head f
    is ANameExpr (n) (s) -> n.value
    is otherwise -> ""

 The spine is collected outermost-first, so the argument in source position
 `i` of `n` sits at `n - 1 - i`.

  cost-apply-args : AExpr, List AExpr -> List AExpr
  cost-apply-args (e) (acc) = when e
    is AApplyExpr (f) (a) (s) -> cost-apply-args f (list-push acc a)
    is otherwise -> acc

 RULE 2. An append whose right operand is an empty literal aliases rather
 than copies, so it does not grow. `n-append-empty` is the corpus entry that
 exists for this line, and without it a rule that reads the operator alone
 flags a function that is linear.

  cost-operand-grows : AExpr -> Boolean
  cost-operand-grows (e) = when e
    is AListExpr (elems) (s) -> list-length elems > 0
    is ALitExpr (t) (k) (s) -> text-length t > 0
    is otherwise -> True

 RULE 1. The argument in position `i` is this function's own parameter `i`
 appended to. That is the shape all three of the 2026-08-14 defects took.

 The operator is `OpAnd` and NOT `OpAppend`, which cost a rebuild to find.
 `desugar-bin-op` maps the `&` token to `OpAnd` (`Desugarer.codex:249`) and
 nothing maps it to `OpAppend`; `infer-and` then dispatches on the LEFT
 operand's resolved type, sending `BooleanTy` to logical-and and everything
 else to concatenation. So `&` is one token doing two jobs and only the type
 separates them. `OpAppend` reaches the AST only from the `show`-of-a-record
 desugaring, which builds it synthetically.

 RULE 3. The append is only a copy when the accumulator is not the topmost
 allocation at the moment it runs. COMPILER-8 (main 16039) extends a Text
 accumulator in place while it stays topmost, so a Text append with a
 non-allocating right operand is linear; anything allocating BETWEEN the
 appends pushes the accumulator off the frontier and the copy comes back. A
 List append has no such path and copies unconditionally. The type comes from
 `infer-and`, which records its append route at the binary span.

 The right operand is read as allocating unless it is demonstrably not one,
 which is question 1's abstain-toward-refusal in the only direction that is
 safe here: a missed `growing` is the defect this check exists for, and a
 false one is paid in a declaration an author can decline to write.

  cost-arg-is-self-append : UnificationState, AExpr, Text -> Boolean
  cost-arg-is-self-append (st) (arg) (pname) = when arg
    is ABinaryExpr (l) (op) (r) (s) -> when op
      is OpAnd -> cost-arg-is-name l pname & cost-operand-grows r & cost-append-copies st s r
      is otherwise -> False
    is otherwise -> False

  cost-append-copies : UnificationState, SourceSpan, AExpr -> Boolean
  cost-append-copies (st) (sp) (rhs) =
   when (expr-type-scan st sp)
    is TextTy -> cost-rhs-allocates rhs
    is otherwise -> True

  cost-rhs-allocates : AExpr -> Boolean
  cost-rhs-allocates (e) = when e
    is ALitExpr (t) (k) (s) -> False
    is ANameExpr (n) (s) -> False
    is AFieldAccess (obj) (f) (s) -> cost-rhs-allocates obj
    is otherwise -> True

  cost-arg-is-name : AExpr, Text -> Boolean
  cost-arg-is-name (e) (pname) = when e
    is ANameExpr (n) (s) -> n.value == pname
    is otherwise -> False

  cost-call-grows : UnificationState, List AExpr, List AParam, Integer, Integer, Integer -> Boolean
  cost-call-grows (st) (args) (params) (i) (nargs) (nparams) =
   if i >= nargs then False
   else if i >= nparams then False
   else if cost-arg-is-self-append st (list-at args (nargs - 1 - i)) ((list-at params i).name.value) then True
   else cost-call-grows st args params (i + 1) nargs nparams

  cost-expr-grows : UnificationState, AExpr, Text, List AParam -> Boolean
  cost-expr-grows (st) (e) (self) (params) = when e
    is AApplyExpr (f) (a) (s) ->
      if cost-apply-head e == self
       then let args = cost-apply-args e []
            in cost-call-grows st args params 0 (list-length args) (list-length params)
              | cost-expr-grows st f self params | cost-expr-grows st a self params
      else cost-expr-grows st f self params | cost-expr-grows st a self params
    is AIfExpr (c) (t) (el) (s) -> cost-expr-grows st c self params | cost-expr-grows st t self params | cost-expr-grows st el self params
    is ALetExpr (bs) (b) (s) -> cost-binds-grow st bs self params 0 (list-length bs) | cost-expr-grows st b self params
    is ABinaryExpr (l) (op) (r) (s) -> cost-expr-grows st l self params | cost-expr-grows st r self params
    is AUnaryExpr (x) (s) -> cost-expr-grows st x self params
    is AMatchExpr (sc) (arms) (s) -> cost-expr-grows st sc self params | cost-arms-grow st arms self params 0 (list-length arms)
    is ALambdaExpr (ps) (b) (s) -> cost-expr-grows st b self params
    is AListExpr (elems) (s) -> cost-elems-grow st elems self params 0 (list-length elems)
    is ARecordExpr (n) (fields) (s) -> cost-fields-grow st fields self params 0 (list-length fields)
    is AFieldAccess (obj) (f) (s) -> cost-expr-grows st obj self params
    is AActExpr (stmts) (s) -> cost-stmts-grow st stmts self params 0 (list-length stmts)
    is ATryExpr (mx) (b) (fb) (fl) (s) -> cost-stmts-grow st b self params 0 (list-length b) | cost-stmts-grow st fb self params 0 (list-length fb) | cost-stmts-grow st fl self params 0 (list-length fl)
    is AHandleExpr (eff) (b) (cls) (s) -> cost-expr-grows st b self params
    is AWithTimeoutExpr (t) (effs) (scopes) (b) (s) -> cost-expr-grows st b self params
    is AFieldAssignExpr (rec) (f) (val) (s) -> cost-expr-grows st rec self params | cost-expr-grows st val self params
    is ALazyExpr (inner) (s) -> cost-expr-grows st inner self params
    is otherwise -> False

  cost-binds-grow : UnificationState, List ALetBind, Text, List AParam, Integer, Integer -> Boolean
  cost-binds-grow (st) (bs) (self) (params) (i) (len) =
   if i >= len then False
   else if cost-expr-grows st ((list-at bs i).value) self params then True
   else cost-binds-grow st bs self params (i + 1) len

  cost-arms-grow : UnificationState, List AMatchArm, Text, List AParam, Integer, Integer -> Boolean
  cost-arms-grow (st) (arms) (self) (params) (i) (len) =
   if i >= len then False
   else let arm = list-at arms i
   in if cost-expr-grows st (arm.guard) self params | cost-expr-grows st (arm.body) self params then True
   else cost-arms-grow st arms self params (i + 1) len

  cost-elems-grow : UnificationState, List AExpr, Text, List AParam, Integer, Integer -> Boolean
  cost-elems-grow (st) (elems) (self) (params) (i) (len) =
   if i >= len then False
   else if cost-expr-grows st (list-at elems i) self params then True
   else cost-elems-grow st elems self params (i + 1) len

  cost-fields-grow : UnificationState, List AFieldExpr, Text, List AParam, Integer, Integer -> Boolean
  cost-fields-grow (st) (fields) (self) (params) (i) (len) =
   if i >= len then False
   else if cost-expr-grows st ((list-at fields i).value) self params then True
   else cost-fields-grow st fields self params (i + 1) len

  cost-stmts-grow : UnificationState, List AActStmt, Text, List AParam, Integer, Integer -> Boolean
  cost-stmts-grow (st) (stmts) (self) (params) (i) (len) =
   if i >= len then False
   else when (list-at stmts i)
    is AActExprStmt (e) (s) -> if cost-expr-grows st e self params then True else cost-stmts-grow st stmts self params (i + 1) len
    is AActBindStmt (n) (e) (s) -> if cost-expr-grows st e self params then True else cost-stmts-grow st stmts self params (i + 1) len

  cost-def-grows : UnificationState, ADef -> Boolean
  cost-def-grows (st) (def) = cost-expr-grows st (def.body) (def.name.value) (def.params)


  cost-growth-bag : Boolean, List ADef, UnificationState -> DiagnosticBag
  cost-growth-bag (enabled) (defs) (st) =
   if enabled == False then empty-bag
   else cost-growth-loop st defs (list-length defs - 1) (list-length defs) empty-bag

  cost-growth-loop : UnificationState, List ADef, Integer, Integer, DiagnosticBag -> DiagnosticBag
  cost-growth-loop (st) (defs) (i) (len) (bag) =
   if i < 0 then bag
   else let def = list-at defs i
   in if cost-def-grows st def
      then cost-growth-loop st defs (i - 1) len (bag-add bag (make-error cdx-cost-accumulator-growth ("'" & def.name.value & "' is inferred growing: an argument is its own parameter copied by & inside a self call") (def.span)))
      else cost-growth-loop st defs (i - 1) len bag

Section: Cost Model 3.3 -- the bounded declaration

 `bounded <class> <name>` sits in `punctual`'s slot and declares a CEILING in
 the lattice `none < fixed < linear < growing`. The parser records it as an
 `AnnotationNode` with kind "bounded" and the class in the body, the same way
 `punctual` records "hard-realtime", so nothing new is threaded through the
 chapter record.

 Three rungs are decidable here today. The inference answers whether a
 definition is `growing`, and whether it allocates at all; it does not
 separate `fixed` from `linear`, because that needs a per-builtin allocation
 class this tree has not measured. So `bounded none`, `bounded linear` and
 `bounded growing` are checked, and `bounded fixed` is REFUSED as unsupported
 rather than accepted unchecked. That is the abstain-toward-refusal direction
 the ruling asks for: an unchecked promise reads as a checked one and is
 worse than no promise.

  cost-class-rank : Text -> Integer
  cost-class-rank (c) =
   if c == "none" then 0
   else if c == "fixed" then 1
   else if c == "budgeted" then 2
   else if c == "linear" then 3
   else if c == "growing" then 4
   else 0 - 1

 The growing set is closed under CALLS, which is what makes the refusal
 transitive in the CDX6001 sense: `unpack-text` was linear in its own body and
 quadratic because of what its callee did. One pass per definition is enough
 to add every def that reaches a growing one, so the loop is bounded by the
 definition count rather than run to a fixed point without a bound.

  cost-growing-seed : UnificationState, List ADef, Integer, Integer, List Text -> List Text
  cost-growing-seed (st) (defs) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at defs i
   in if cost-def-grows st d then cost-growing-seed st defs (i + 1) len (list-push acc (d.name.value))
   else cost-growing-seed st defs (i + 1) len acc

  cost-growing-close : List ADef, List Text, Integer, Integer -> List Text
  cost-growing-close (defs) (acc) (round) (rounds) =
   if round >= rounds then acc
   else let grown = cost-growing-step defs acc 0 (list-length defs) acc
   in if list-length grown == list-length acc then acc
   else cost-growing-close defs grown (round + 1) rounds

  cost-growing-step : List ADef, List Text, Integer, Integer, List Text -> List Text
  cost-growing-step (defs) (known) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at defs i
   in if is-rt-name acc (d.name.value) 0 (list-length acc) then cost-growing-step defs known (i + 1) len acc
   else if list-length (collect-rt-mentions (d.body) (d.name.value) known []) > 0
     then cost-growing-step defs known (i + 1) len (list-push acc (d.name.value))
   else cost-growing-step defs known (i + 1) len acc

  cost-growing-set : UnificationState, List ADef -> List Text
  cost-growing-set (st) (defs) =
   let seed = cost-growing-seed st defs 0 (list-length defs) []
   in if list-length seed == 0 then seed
   else cost-growing-close defs seed 0 (list-length defs)

  check-bounded-decls : UnificationState, List ADef, List AnnotationNode -> UnificationState
  check-bounded-decls (st) (defs) (anns) =
   if list-length anns == 0 then st
   else let growing = cost-growing-set st defs
   in let allocating = if cost-any-none anns 0 (list-length anns) then cost-alloc-set st defs else []
   in let over = if cost-any-budgeted anns 0 (list-length anns) then cost-over-set st defs else []
   in check-bounded-loop st defs growing allocating over anns 0 (list-length anns)

  check-bounded-loop : UnificationState, List ADef, List Text, List Text, List Text, List AnnotationNode, Integer, Integer -> UnificationState
  check-bounded-loop (st) (defs) (growing) (allocating) (over) (anns) (i) (len) =
   if i >= len then st
   else let a = list-at anns i
   in if a.kind == "bounded" then check-bounded-loop (check-bounded-one st defs growing allocating over a) defs growing allocating over anns (i + 1) len
   else check-bounded-loop st defs growing allocating over anns (i + 1) len

  check-bounded-one : UnificationState, List ADef, List Text, List Text, List Text, AnnotationNode -> UnificationState
  check-bounded-one (st) (defs) (growing) (allocating) (over) (a) =
   let rank = cost-class-rank (a.body)
   in let span = cost-def-span defs (a.target) 0 (list-length defs)
   in if rank < 0 then __record-set st "bag" (bag-add (st.bag) (make-error cdx-bounded-unknown-class ("'bounded " & a.body & "' on '" & a.target & "' names no class; the lattice is none < fixed < budgeted < linear < growing") span))
   else if rank == 0 then (if is-rt-name allocating (a.target) 0 (list-length allocating) then __record-set st "bag" (bag-add (st.bag) (make-error cdx-bounded-exceeded ("'" & a.target & "' declares bounded none but allocates, here or in something it calls") span)) else st)
   else if rank == 1 then __record-set st "bag" (bag-add (st.bag) (make-error cdx-bounded-class-unsupported ("'bounded fixed' on '" & a.target & "' cannot be checked yet: fixed is the same bytes every call, which no builtin has been measured to be. Use 'bounded budgeted' for a bound the caller names, or 'bounded none' for the no-heap promise") span))
   else if rank == 2 then (if is-rt-name over (a.target) 0 (list-length over) then __record-set st "bag" (bag-add (st.bag) (make-error cdx-bounded-exceeded ("'" & a.target & "' declares bounded budgeted but allocates past a named bound, here or in something it calls: a builtin whose allocation follows an input, or one bounded by an argument that is not a literal") span)) else st)
   else if rank >= 4 then st
   else if is-rt-name growing (a.target) 0 (list-length growing)
     then __record-set st "bag" (bag-add (st.bag) (make-error cdx-bounded-exceeded ("'" & a.target & "' declares bounded " & a.body & " but is inferred growing: an accumulator is copied by & inside a self call, here or in something it calls") span))
   else st

  cost-def-span : List ADef, Text, Integer, Integer -> SourceSpan
  cost-def-span (defs) (name) (i) (len) =
   if i >= len then synthetic-span
   else let d = list-at defs i
   in if d.name.value == name then d.span
   else cost-def-span defs name (i + 1) len

Section: Cost Model -- the none rung

 A name in call position that is neither a definition in this unit nor a
 builtin measured at zero bytes is read as allocating. That is question 1's
 abstain-toward-refusal: a false refusal is paid in a declaration the author
 can decline to write, and a false acceptance is an unchecked promise, which
 is the thing CDX6103 exists to prevent.

 The zero-byte set now comes from the REGISTRY rather than from a list kept
 here. `bs-alloc` on `BuiltinSpec` carries each builtin's measured allocation
 class, so a measurement widens what `bounded none` accepts by changing the
 row that names the builtin, next to its type, instead of by editing a
 literal in the type checker that nothing connects to the table.

 The union with `is-rt-safe-builtin` is deliberate and is not the old list
 wearing a new coat. That set is `punctual`'s, and it earns its place a
 different way: those names are no-heap BY CONSTRUCTION, which is why
 `punctual` may call them at all. The registry's `none` is no-heap BY
 MEASUREMENT. Two independent grounds for the same claim, and dropping either
 one would narrow the check for no reason -- the arithmetic and bit builtins
 are in the first and have never been through the second.

 Everything else, including every builtin whose row still reads `unknown`,
 sits on the refusing side.

  cost-builtin-nonalloc : Text -> Boolean
  cost-builtin-nonalloc (n) =
   is-rt-safe-builtin n | builtin-alloc-by-name builtins n 0 (list-length builtins) == "none"

  cost-def-known : List ADef, Text, Integer, Integer -> Boolean
  cost-def-known (defs) (n) (i) (len) =
   if i >= len then False
   else if (list-at defs i).name.value == n then True
   else cost-def-known defs n (i + 1) len

  cost-head-allocates : List ADef, List Text, Text -> Boolean
  cost-head-allocates (defs) (allocating) (h) =
   if h == "" then True
   else if is-rt-name allocating h 0 (list-length allocating) then True
   else if cost-def-known defs h 0 (list-length defs) then False
   else cost-builtin-nonalloc h == False

 `&` is one token doing two jobs and only the recorded type separates them,
 exactly as RULE 1 of the growth check found: the boolean route allocates
 nothing and the concatenation route allocates a new value.

 `OpBoolAnd` NEEDS NO LOOKUP, which is the point of it. `OpAnd` has to ask the
 recorded type because the token is overloaded; the keyword form cannot be
 anything but boolean, so it answers here without consulting a table that may
 or may not have been written.

  cost-binop-allocates : UnificationState, BinaryOp, SourceSpan -> Boolean
  cost-binop-allocates (st) (op) (s) = when op
    is OpAnd -> when (expr-type-scan st s) is BooleanTy -> False is otherwise -> True
    is OpBoolAnd -> False
    is OpAppend -> True
    is otherwise -> False

  cost-expr-allocates : UnificationState, AExpr, List ADef, List Text -> Boolean
  cost-expr-allocates (st) (e) (defs) (allocating) = when e
    is ALitExpr (t) (k) (s) -> False
    is ANameExpr (n) (s) -> is-rt-unsafe-name (n.value) | is-rt-name allocating (n.value) 0 (list-length allocating)
    is AApplyExpr (f) (a) (s) -> cost-head-allocates defs allocating (cost-apply-head e) | cost-expr-allocates st f defs allocating | cost-expr-allocates st a defs allocating
    is ABinaryExpr (l) (op) (r) (s) -> cost-binop-allocates st op s | cost-expr-allocates st l defs allocating | cost-expr-allocates st r defs allocating
    is AUnaryExpr (x) (s) -> cost-expr-allocates st x defs allocating
    is AIfExpr (c) (t) (el) (s) -> cost-expr-allocates st c defs allocating | cost-expr-allocates st t defs allocating | cost-expr-allocates st el defs allocating
    is ALetExpr (bs) (b) (s) -> cost-binds-allocate st bs defs allocating 0 (list-length bs) | cost-expr-allocates st b defs allocating
    is AMatchExpr (sc) (arms) (s) -> cost-expr-allocates st sc defs allocating | cost-arms-allocate st arms defs allocating 0 (list-length arms)
    is AFieldAccess (obj) (f) (s) -> cost-expr-allocates st obj defs allocating
    is otherwise -> True

  cost-binds-allocate : UnificationState, List ALetBind, List ADef, List Text, Integer, Integer -> Boolean
  cost-binds-allocate (st) (bs) (defs) (allocating) (i) (len) =
   if i >= len then False
   else if cost-expr-allocates st ((list-at bs i).value) defs allocating then True
   else cost-binds-allocate st bs defs allocating (i + 1) len

  cost-arms-allocate : UnificationState, List AMatchArm, List ADef, List Text, Integer, Integer -> Boolean
  cost-arms-allocate (st) (arms) (defs) (allocating) (i) (len) =
   if i >= len then False
   else let arm = list-at arms i
   in if cost-expr-allocates st (arm.guard) defs allocating | cost-expr-allocates st (arm.body) defs allocating then True
   else cost-arms-allocate st arms defs allocating (i + 1) len

  cost-alloc-seed : UnificationState, List ADef, Integer, Integer, List Text -> List Text
  cost-alloc-seed (st) (defs) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at defs i
   in if cost-expr-allocates st (d.body) defs [] then cost-alloc-seed st defs (i + 1) len (list-push acc (d.name.value))
   else cost-alloc-seed st defs (i + 1) len acc

  cost-alloc-step : List ADef, List Text, Integer, Integer, List Text -> List Text
  cost-alloc-step (defs) (known) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at defs i
   in if is-rt-name acc (d.name.value) 0 (list-length acc) then cost-alloc-step defs known (i + 1) len acc
   else if list-length (collect-rt-mentions (d.body) (d.name.value) known []) > 0
     then cost-alloc-step defs known (i + 1) len (list-push acc (d.name.value))
   else cost-alloc-step defs known (i + 1) len acc

  cost-alloc-close : List ADef, List Text, Integer, Integer -> List Text
  cost-alloc-close (defs) (acc) (round) (rounds) =
   if round >= rounds then acc
   else let grown = cost-alloc-step defs acc 0 (list-length defs) acc
   in if list-length grown == list-length acc then acc
   else cost-alloc-close defs grown (round + 1) rounds

 THE BUDGETED RUNG (ruled 2026-08-19, CurrentPlan 17 and 18). Between "the
 same bytes every call" and "proportional to the input" sits the shape most of
 the parsing here actually has: an allocation bounded by something the CALLER
 can name. `integer-to-text` is bounded by a constant nobody has to state, an
 `Integer` having at most twenty digits. `substring` is bounded by its LENGTH
 ARGUMENT, so a four-character field out of a line of any length costs the
 same 16 bytes, while a slice that grows with the line does not. Measured both
 ways in `codex/test/cost/builtin-alloc`.

 So the registry word can NAME AN ARGUMENT: `budgeted` alone is bounded by a
 constant, `budgeted:N` is bounded by the Nth argument counting from the left.
 A `budgeted:N` call is within budget when argument N is a LITERAL, and over
 it otherwise. That rule is deliberately blunt: `substring s 0 4` passes and
 `substring s 0 (text-length s)` does not, which is the distinction the
 measurement found, but so does any computed length that happens to be small.
 Abstain toward refusal, as everywhere else here.

  cost-budget-arg : Text -> Integer
  cost-budget-arg (c) =
   if text-starts-with c "budgeted:" then text-to-integer (substring c 9 (text-length c - 9))
   else 0

 `cost-apply-args` above already collects them, and its own note records the
 convention: arguments come off a curried application OUTERMOST FIRST, so the
 list is the reverse of source order. That note counts from zero; the registry
 word counts from one, the way somebody reading `substring s i n` counts, so
 argument N sits at `count - N`.

  cost-arg-literal : List AExpr, Integer -> Boolean
  cost-arg-literal (args) (n) =
   let k = list-length args
   in if n <= 0 then False
   else if n > k then False
   else when list-at args (k - n) is ALitExpr (t) (kk) (s) -> True is otherwise -> False

  cost-head-overbudget : List ADef, List Text, Text, List AExpr -> Boolean
  cost-head-overbudget (defs) (over) (h) (args) =
   if h == "" then True
   else if is-rt-name over h 0 (list-length over) then True
   else if cost-def-known defs h 0 (list-length defs) then False
   else let c = builtin-alloc-by-name builtins h 0 (list-length builtins)
   in if c == "none" then False
      else if c == "fixed" then False
      else if c == "budgeted" then False
      else if cost-budget-arg c > 0 then cost-arg-literal args (cost-budget-arg c) == False
      else is-rt-safe-builtin h == False

 THE ARGUMENTS ARE COLLECTED ONCE AT THE OUTERMOST NODE and the walk recurses
 over THEM rather than down the function side. Recursing into `f` would meet
 the same head again with one fewer argument each time, and the innermost
 meeting has none at all, so every `budgeted:N` call would be judged on an
 empty argument list and refused. Anything nested inside an argument is still
 reached, because it is in the list.

  cost-expr-overbudget : UnificationState, AExpr, List ADef, List Text -> Boolean
  cost-expr-overbudget (st) (e) (defs) (over) = when e
    is ALitExpr (t) (k) (s) -> False
    is ANameExpr (n) (s) -> is-rt-unsafe-name (n.value) | is-rt-name over (n.value) 0 (list-length over)
    is AApplyExpr (f) (a) (s) -> cost-head-overbudget defs over (cost-apply-head e) (cost-apply-args e []) | cost-args-overbudget st (cost-apply-args e []) defs over 0
    is ABinaryExpr (l) (op) (r) (s) -> cost-binop-allocates st op s | cost-expr-overbudget st l defs over | cost-expr-overbudget st r defs over
    is AUnaryExpr (x) (s) -> cost-expr-overbudget st x defs over
    is AIfExpr (c) (t) (el) (s) -> cost-expr-overbudget st c defs over | cost-expr-overbudget st t defs over | cost-expr-overbudget st el defs over
    is ALetExpr (bs) (b) (s) -> cost-binds-overbudget st bs defs over 0 (list-length bs) | cost-expr-overbudget st b defs over
    is AMatchExpr (sc) (arms) (s) -> cost-expr-overbudget st sc defs over | cost-arms-overbudget st arms defs over 0 (list-length arms)
    is AFieldAccess (obj) (f) (s) -> cost-expr-overbudget st obj defs over
    is otherwise -> True

  cost-args-overbudget : UnificationState, List AExpr, List ADef, List Text, Integer -> Boolean
  cost-args-overbudget (st) (args) (defs) (over) (i) =
   if i >= list-length args then False
   else if cost-expr-overbudget st (list-at args i) defs over then True
   else cost-args-overbudget st args defs over (i + 1)

  cost-binds-overbudget : UnificationState, List ALetBind, List ADef, List Text, Integer, Integer -> Boolean
  cost-binds-overbudget (st) (bs) (defs) (over) (i) (len) =
   if i >= len then False
   else if cost-expr-overbudget st ((list-at bs i).value) defs over then True
   else cost-binds-overbudget st bs defs over (i + 1) len

  cost-arms-overbudget : UnificationState, List AMatchArm, List ADef, List Text, Integer, Integer -> Boolean
  cost-arms-overbudget (st) (arms) (defs) (over) (i) (len) =
   if i >= len then False
   else let arm = list-at arms i
   in if cost-expr-overbudget st (arm.guard) defs over | cost-expr-overbudget st (arm.body) defs over then True
   else cost-arms-overbudget st arms defs over (i + 1) len

  cost-over-seed : UnificationState, List ADef, Integer, Integer, List Text -> List Text
  cost-over-seed (st) (defs) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at defs i
   in if cost-expr-overbudget st (d.body) defs [] then cost-over-seed st defs (i + 1) len (list-push acc (d.name.value))
   else cost-over-seed st defs (i + 1) len acc

  cost-over-step : UnificationState, List ADef, List Text, Integer, Integer, List Text -> List Text
  cost-over-step (st) (defs) (known) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at defs i
   in if is-rt-name acc (d.name.value) 0 (list-length acc) then cost-over-step st defs known (i + 1) len acc
   else if cost-expr-overbudget st (d.body) defs known
   then cost-over-step st defs known (i + 1) len (list-push acc (d.name.value))
   else cost-over-step st defs known (i + 1) len acc

  cost-over-close : UnificationState, List ADef, List Text, Integer, Integer -> List Text
  cost-over-close (st) (defs) (acc) (round) (rounds) =
   if round >= rounds then acc
   else let grown = cost-over-step st defs acc 0 (list-length defs) acc
   in if list-length grown == list-length acc then acc
   else cost-over-close st defs grown (round + 1) rounds

  cost-over-set : UnificationState, List ADef -> List Text
  cost-over-set (st) (defs) =
   let seed = cost-over-seed st defs 0 (list-length defs) []
   in if list-length seed == 0 then seed
   else cost-over-close st defs seed 0 (list-length defs)

  cost-any-budgeted : List AnnotationNode, Integer, Integer -> Boolean
  cost-any-budgeted (anns) (i) (len) =
   if i >= len then False
   else let a = list-at anns i
   in if a.kind == "bounded" then (if a.body == "budgeted" then True else cost-any-budgeted anns (i + 1) len)
   else cost-any-budgeted anns (i + 1) len

  cost-alloc-set : UnificationState, List ADef -> List Text
  cost-alloc-set (st) (defs) =
   let seed = cost-alloc-seed st defs 0 (list-length defs) []
   in if list-length seed == 0 then seed
   else cost-alloc-close defs seed 0 (list-length defs)

  cost-any-none : List AnnotationNode, Integer, Integer -> Boolean
  cost-any-none (anns) (i) (len) =
   if i >= len then False
   else let a = list-at anns i
   in if a.kind == "bounded" & a.body == "none" then True
   else cost-any-none anns (i + 1) len

Section: Punctual Mutual Recursion

  RtEdges = record {
   re-fn : Text,
   re-calls : List Text
  }

  collect-rt-mentions : AExpr, Text, List Text, List Text -> List Text
  collect-rt-mentions (e) (self) (rt-names) (acc) =
   when e
    is ANameExpr (n) (s) ->
     if (n.value) == self then acc
     else if is-rt-name rt-names (n.value) 0 (list-length rt-names)
      then if text-in-list acc (n.value) 0 (list-length acc) then acc else list-push acc (n.value)
      else acc
    is AApplyExpr (f) (a) (s) -> collect-rt-mentions a self rt-names (collect-rt-mentions f self rt-names acc)
    is ABinaryExpr (l) (op) (r) (s) -> collect-rt-mentions r self rt-names (collect-rt-mentions l self rt-names acc)
    is AUnaryExpr (x) (s) -> collect-rt-mentions x self rt-names acc
    is AIfExpr (c) (t) (el) (s) -> collect-rt-mentions el self rt-names (collect-rt-mentions t self rt-names (collect-rt-mentions c self rt-names acc))
    is ALetExpr (bs) (b) (s) -> collect-rt-mentions b self rt-names (collect-rt-mentions-binds bs self rt-names acc 0 (list-length bs))
    is AMatchExpr (sc) (arms) (s) -> collect-rt-mentions-arms arms self rt-names (collect-rt-mentions sc self rt-names acc) 0 (list-length arms)
    is AInductionExpr (sc) (arms) (s) -> collect-rt-mentions-arms arms self rt-names (collect-rt-mentions sc self rt-names acc) 0 (list-length arms)
    is ALambdaExpr (ps) (b) (s) -> collect-rt-mentions b self rt-names acc
    is AListExpr (elems) (s) -> collect-rt-mentions-list elems self rt-names acc 0 (list-length elems)
    is ARecordExpr (n) (fields) (s) -> collect-rt-mentions-fields fields self rt-names acc 0 (list-length fields)
    is AFieldAccess (obj) (f) (s) -> collect-rt-mentions obj self rt-names acc
    is AActExpr (stmts) (s) -> collect-rt-mentions-stmts stmts self rt-names acc 0 (list-length stmts)
    is ATryExpr (mx) (b) (fb) (fl) (s) -> collect-rt-mentions-stmts fl self rt-names (collect-rt-mentions-stmts fb self rt-names (collect-rt-mentions-stmts b self rt-names acc 0 (list-length b)) 0 (list-length fb)) 0 (list-length fl)
    is AHandleExpr (eff) (b) (cls) (s) -> collect-rt-mentions-clauses cls self rt-names (collect-rt-mentions b self rt-names acc) 0 (list-length cls)
    is AWithTimeoutExpr (t) (effs) (scopes) (b) (s) -> collect-rt-mentions b self rt-names acc
    is AFieldAssignExpr (rec) (f) (val) (s) -> collect-rt-mentions val self rt-names (collect-rt-mentions rec self rt-names acc)
    is ALazyExpr (inner) (s) -> collect-rt-mentions inner self rt-names acc
    is otherwise -> acc

  collect-rt-mentions-binds : List ALetBind, Text, List Text, List Text, Integer, Integer -> List Text
  collect-rt-mentions-binds (bs) (self) (rt-names) (acc) (i) (len) =
   if i >= len then acc
   else collect-rt-mentions-binds bs self rt-names (collect-rt-mentions ((list-at bs i).value) self rt-names acc) (i + 1) len

  collect-rt-mentions-arms : List AMatchArm, Text, List Text, List Text, Integer, Integer -> List Text
  collect-rt-mentions-arms (arms) (self) (rt-names) (acc) (i) (len) =
   if i >= len then acc
   else let arm = list-at arms i
   in collect-rt-mentions-arms arms self rt-names (collect-rt-mentions (arm.body) self rt-names (collect-rt-mentions (arm.guard) self rt-names acc)) (i + 1) len

  collect-rt-mentions-list : List AExpr, Text, List Text, List Text, Integer, Integer -> List Text
  collect-rt-mentions-list (elems) (self) (rt-names) (acc) (i) (len) =
   if i >= len then acc
   else collect-rt-mentions-list elems self rt-names (collect-rt-mentions (list-at elems i) self rt-names acc) (i + 1) len

  collect-rt-mentions-fields : List AFieldExpr, Text, List Text, List Text, Integer, Integer -> List Text
  collect-rt-mentions-fields (fields) (self) (rt-names) (acc) (i) (len) =
   if i >= len then acc
   else collect-rt-mentions-fields fields self rt-names (collect-rt-mentions ((list-at fields i).value) self rt-names acc) (i + 1) len

  collect-rt-mentions-clauses : List AHandleClause, Text, List Text, List Text, Integer, Integer -> List Text
  collect-rt-mentions-clauses (cls) (self) (rt-names) (acc) (i) (len) =
   if i >= len then acc
   else collect-rt-mentions-clauses cls self rt-names (collect-rt-mentions ((list-at cls i).body) self rt-names acc) (i + 1) len

  collect-rt-mentions-stmts : List AActStmt, Text, List Text, List Text, Integer, Integer -> List Text
  collect-rt-mentions-stmts (stmts) (self) (rt-names) (acc) (i) (len) =
   if i >= len then acc
   else when (list-at stmts i)
    is AActExprStmt (e) (s) -> collect-rt-mentions-stmts stmts self rt-names (collect-rt-mentions e self rt-names acc) (i + 1) len
    is AActBindStmt (n) (e) (s) -> collect-rt-mentions-stmts stmts self rt-names (collect-rt-mentions e self rt-names acc) (i + 1) len

  build-rt-edges : List ADef, List Text, Integer, Integer, List RtEdges -> List RtEdges
  build-rt-edges (defs) (rt-names) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at defs i
   in if is-rt-name rt-names (d.name.value) 0 (list-length rt-names)
      then build-rt-edges defs rt-names (i + 1) len (list-push acc (deck-record (RtEdges { re-fn = d.name.value, re-calls = collect-rt-mentions (d.body) (d.name.value) rt-names [] })))
      else build-rt-edges defs rt-names (i + 1) len acc

  rt-edges-for : List RtEdges, Text -> List Text
  rt-edges-for (g) (fn) = rt-edges-for-loop g fn 0 (list-length g)

  rt-edges-for-loop : List RtEdges, Text, Integer, Integer -> List Text
  rt-edges-for-loop (g) (fn) (i) (len) =
   if i >= len then []
   else let e = list-at g i
   in if (e.re-fn) == fn then e.re-calls
   else rt-edges-for-loop g fn (i + 1) len

  rt-reaches : List RtEdges, Text, Text, List Text -> Boolean
  rt-reaches (g) (cur) (target) (visited) =
   if cur == target then True
   else if text-in-list visited cur 0 (list-length visited) then False
   else let ns = rt-edges-for g cur
   in rt-reaches-any g ns target (list-push visited cur) 0 (list-length ns)

  rt-reaches-any : List RtEdges, List Text, Text, List Text, Integer, Integer -> Boolean
  rt-reaches-any (g) (ns) (target) (visited) (i) (len) =
   if i >= len then False
   else if rt-reaches g (list-at ns i) target visited then True
   else rt-reaches-any g ns target visited (i + 1) len

  check-rt-cycles : List ADef, List Text, UnificationState -> UnificationState
  check-rt-cycles (defs) (rt-names) (st) =
   if list-length rt-names == 0 then st
   else let g = build-rt-edges defs rt-names 0 (list-length defs) []
   in check-rt-cycles-loop g defs 0 (list-length defs) st

  check-rt-cycles-loop : List RtEdges, List ADef, Integer, Integer, UnificationState -> UnificationState
  check-rt-cycles-loop (g) (defs) (i) (len) (st) =
   if i >= len then st
   else let d = list-at defs i
   in let calls = rt-edges-for g (d.name.value)
   in let st2 = if rt-reaches-any g calls (d.name.value) [] 0 (list-length calls)
       then __record-set st "bag" (bag-add (st.bag) (make-error cdx-rt-unbounded-recursion ("punctual function '" & (d.name.value) & "' is mutually recursive through another punctual function; bounded execution cannot be proven") (d.span)))
       else st
   in check-rt-cycles-loop g defs (i + 1) len st2

Section: Proof Acyclicity

 A proof term cannot assume its own conclusion. Declared types are
 registered before any body is checked (as ordinary mutual recursion
 requires), so without this check a proof definition whose body
 mentions itself - directly, mutually, through a recursive
 proof-returning helper, or by citing the claim under proof as a
 lemma inside an induction arm - type-checks trivially and erasure
 hides the divergence forever. The check:
 a definition is proof-relevant when its deep-resolved checked type
 mentions ProofTy or PropEqTy anywhere (resolved, not declared, so
 an undeclared intermediary def whose inferred type unifies to a
 proposition is still in the graph). Edges are every body mention of
 a proof-relevant name, collected with the same exhaustive walk the
 punctual cycle check uses, with self passed as the empty name so
 direct self-mentions are edges too. Any proof-relevant definition
 that reaches itself is rejected with CDX4023. The recursion a proof
 legitimately needs is structural induction, which discharges
 subgoals through inductive-hypothesis bindings, never through a
 name cycle; sound lemma chains are DAGs and pass unchanged. The
 type walk is fuel-capped and answers proof-relevant on exhaustion,
 so a pathological type errs toward checking, never toward silence.

  type-mentions-proof : CodexType, Integer -> Boolean
  type-mentions-proof (ty) (fuel) =
   if fuel <= 0 then True
   else when ty
    is ProofTy | PropEqTy (a) (b) -> True
    is FunTy (p) (row) (r) -> type-mentions-proof p (fuel - 1) | type-mentions-proof r (fuel - 1)
    is ListTy (e) -> type-mentions-proof e (fuel - 1)
    is LinkedListTy (e) -> type-mentions-proof e (fuel - 1)
    is ForAllTy (id) (b) -> type-mentions-proof b (fuel - 1)
    is ForAllEff (id) (b) -> type-mentions-proof b (fuel - 1)
    is EffectfulTy (effs) (sc) (r) -> type-mentions-proof r (fuel - 1)
    is UnitTy (n) (inner) -> type-mentions-proof inner (fuel - 1)
    is LinearTy (inner) -> type-mentions-proof inner (fuel - 1)
    is VectorTy (n) (e) -> type-mentions-proof e (fuel - 1)
    is TypeApply (f) (a) -> type-mentions-proof f (fuel - 1) | type-mentions-proof a (fuel - 1)
    is ConstructedTy (n) (args) -> types-mention-proof args (fuel - 1) 0 (list-length args)
    is SumTy (n) (args) (ctors) -> types-mention-proof args (fuel - 1) 0 (list-length args) | ctors-mention-proof ctors (fuel - 1) 0 (list-length ctors)
    is RecordTy (n) (args) (fields) -> types-mention-proof args (fuel - 1) 0 (list-length args) | fields-mention-proof fields (fuel - 1) 0 (list-length fields)
    is otherwise -> False

  types-mention-proof : List CodexType, Integer, Integer, Integer -> Boolean
  types-mention-proof (ts) (fuel) (i) (len) =
   if i >= len then False
   else if type-mentions-proof (list-at ts i) fuel then True
   else types-mention-proof ts fuel (i + 1) len

  ctors-mention-proof : List SumCtor, Integer, Integer, Integer -> Boolean
  ctors-mention-proof (ctors) (fuel) (i) (len) =
   if i >= len then False
   else if types-mention-proof ((list-at ctors i).fields) fuel 0 (list-length ((list-at ctors i).fields)) then True
   else ctors-mention-proof ctors fuel (i + 1) len

  fields-mention-proof : List RecordField, Integer, Integer, Integer -> Boolean
  fields-mention-proof (fields) (fuel) (i) (len) =
   if i >= len then False
   else if type-mentions-proof ((list-at fields i).type-val) fuel then True
   else fields-mention-proof fields fuel (i + 1) len

  build-proof-names : List ADef, List TypeBinding, Integer, Integer, List Text -> List Text
  build-proof-names (defs) (types) (i) (len) (acc) =
   if i >= len then acc
   else if i >= list-length types then acc
   else if type-mentions-proof ((list-at types i).bound-type) 64
    then build-proof-names defs types (i + 1) len (list-push acc ((list-at defs i).name.value))
    else build-proof-names defs types (i + 1) len acc

  build-proof-edges : List ADef, List Text, Integer, Integer, List RtEdges -> List RtEdges
  build-proof-edges (defs) (names) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at defs i
   in if is-rt-name names (d.name.value) 0 (list-length names)
      then build-proof-edges defs names (i + 1) len (list-push acc (deck-record (RtEdges { re-fn = d.name.value, re-calls = collect-rt-mentions (d.body) "" names [] })))
      else build-proof-edges defs names (i + 1) len acc

  check-proof-cycles : List ADef, List TypeBinding, UnificationState -> UnificationState
  check-proof-cycles (defs) (types) (st) =
   let names = build-proof-names defs types 0 (list-length defs) []
   in if list-length names == 0 then st
   else let g = build-proof-edges defs names 0 (list-length defs) []
   in check-proof-cycles-loop g defs names 0 (list-length defs) st

  check-proof-cycles-loop : List RtEdges, List ADef, List Text, Integer, Integer, UnificationState -> UnificationState
  check-proof-cycles-loop (g) (defs) (names) (i) (len) (st) =
   if i >= len then st
   else let d = list-at defs i
   in if is-rt-name names (d.name.value) 0 (list-length names)
      then let calls = rt-edges-for g (d.name.value)
       in let st2 = if rt-reaches-any g calls (d.name.value) [] 0 (list-length calls)
           then __record-set st "bag" (bag-add (st.bag) (make-error cdx-circular-proof ("circular proof: '" & (d.name.value) & "' justifies itself, directly or through other proof definitions or cited lemmas; a proof term cannot assume its own conclusion. Recursion in a proof is only sound through structural induction, and lemma chains must be acyclic. To assert this equality without proof, use 'assume'.") (d.span)))
           else st
       in check-proof-cycles-loop g defs names (i + 1) len st2
      else check-proof-cycles-loop g defs names (i + 1) len st

  pg-is-prop : UnificationState, AExpr -> Boolean
  pg-is-prop (sorted-st) (e) = type-mentions-proof (lookup-expr-type sorted-st (aexpr-span e)) 64

  pg-form-name : AExpr -> Text
  pg-form-name (e) = when e
   is AIfExpr (c) (t) (el) (s) -> "an if-expression"
   is AMatchExpr (sc) (arms) (s) -> "a when-expression (a proof recurses only through 'induction')"
   is ALambdaExpr (ps) (b) (s) -> "a lambda"
   is AActExpr (stmts) (s) -> "an act block"
   is ABinaryExpr (l) (op) (r) (s) -> "a binary-operator expression"
   is AUnaryExpr (x) (s) -> "a unary-operator expression"
   is AListExpr (elems) (s) -> "a list literal"
   is ARecordExpr (n) (fields) (s) -> "a record literal"
   is AFieldAccess (obj) (f) (s) -> "a field access"
   is ATryExpr (mx) (b) (fb) (fl) (s) -> "a try expression"
   is AHandleExpr (eff) (b) (cls) (s) -> "a handle expression"
   is AWithTimeoutExpr (t) (effs) (scopes) (b) (s) -> "a with-timeout expression"
   is AFieldAssignExpr (rec) (f) (val) (s) -> "a field assignment"
   is ALazyExpr (inner) (s) -> "a lazy expression"
   is otherwise -> "a non-proof expression"

  check-proof-term : UnificationState, AExpr, List Diagnostic -> List Diagnostic
  check-proof-term (sorted-st) (e) (acc) = when e
   is ANameExpr (n) (s) -> acc
   is AApplyExpr (f) (a) (s) -> let acc1 = check-proof-term sorted-st f acc
    in if pg-is-prop sorted-st a then check-proof-term sorted-st a acc1 else acc1
   is AInductionExpr (sc) (arms) (s) -> check-proof-arms sorted-st arms acc 0 (list-length arms)
   is ALetExpr (bs) (b) (s) -> check-proof-binds sorted-st bs (check-proof-term sorted-st b acc) 0 (list-length bs)
   is otherwise -> list-push acc (make-error cdx-non-grammatical-proof ("proof term uses a disallowed form: " & pg-form-name e & ". A proof body may only be a proof builtin (Refl, sym, trans, cong, app-cong, assume), an inductive hypothesis, a cited claim, an 'induction' expression, or a let of proof terms. To assert this equality without proof, use 'assume'.") (aexpr-span e))

  check-proof-arms : UnificationState, List AMatchArm, List Diagnostic, Integer, Integer -> List Diagnostic
  check-proof-arms (sorted-st) (arms) (acc) (i) (len) =
   if i >= len then acc
   else check-proof-arms sorted-st arms (check-proof-term sorted-st ((list-at arms i).body) acc) (i + 1) len

  check-proof-binds : UnificationState, List ALetBind, List Diagnostic, Integer, Integer -> List Diagnostic
  check-proof-binds (sorted-st) (bs) (acc) (i) (len) =
   if i >= len then acc
   else let v = (list-at bs i).value
   in check-proof-binds sorted-st bs (if pg-is-prop sorted-st v then check-proof-term sorted-st v acc else acc) (i + 1) len

  check-proof-grammar : List ADef, List TypeBinding, UnificationState -> UnificationState
  check-proof-grammar (defs) (types) (st) =
   let names = build-proof-names defs types 0 (list-length defs) []
   in if list-length names == 0 then st
   else let sorted-st = __record-set st "expr-types" (sort-expr-types (st.expr-types))
   in check-proof-grammar-loop sorted-st defs names 0 (list-length defs) st

  check-proof-grammar-loop : UnificationState, List ADef, List Text, Integer, Integer, UnificationState -> UnificationState
  check-proof-grammar-loop (sorted-st) (defs) (names) (i) (len) (st) =
   if i >= len then st
   else let d = list-at defs i
   in if is-rt-name names (d.name.value) 0 (list-length names)
      then let errs = check-proof-term sorted-st (d.body) []
       in check-proof-grammar-loop sorted-st defs names (i + 1) len (add-diagnostics-to-state st errs 0 (list-length errs))
      else check-proof-grammar-loop sorted-st defs names (i + 1) len st

  check-chapter : AChapter, List RenameEntry, SkipListText, List ChapterAssignment, Integer, Integer, Integer, Integer, Integer -> ChapterResult
  check-chapter (mod) (renames) (colliding) (assignments) (ceiling) (check-base) (keep-base) (keep-ceiling) (poison) =
   let p0 = __heap-save
   in let tdm = build-type-def-map (mod.type-defs) 0 (list-length (mod.type-defs)) []
   in let p1 = __heap-save
   in let arity-errors = check-all-type-arities tdm mod
   in let p2 = __heap-save
   in let tenv = register-type-defs empty-unification-state builtin-type-env tdm (mod.type-defs) 0 (list-length (mod.type-defs))
   in let p3 = __heap-save
   in let st-with-arity = add-diagnostics-to-state (tenv.state) arity-errors 0 (list-length arity-errors)
   in let env-with-mut = register-mutable-markers (tenv.env) (mod.type-defs) 0 (list-length (mod.type-defs))
   in let env = register-all-defs st-with-arity env-with-mut tdm (mod.defs) 0 (list-length (mod.defs)) renames
   in let p4 = __heap-save
   in let env2 = register-effect-ops (env.state) (env.env) tdm (mod.effect-defs) 0 (list-length (mod.effect-defs))
   in let env3 = register-class-methods (env2.state) (env2.env) tdm (mod.class-defs) (mod.instance-defs)
   in let sorted-env = env-finalize (env3.env)
   in let p5 = __heap-save
   in let reg-note = "CHECK-REG tdm=" & show (p1 - p0) & " arity=" & show (p2 - p1) & " typedefs=" & show (p3 - p2) & " defs=" & show (p4 - p3) & " effects-classes-sort=" & show (p5 - p4)
   in let def-count = list-length (mod.defs)
   in let pre-st = deck-record (UnificationState {
    substitutions = copy-list-with-headroom (env3.state.substitutions) (def-count * 12),
    row-substitutions = copy-list-with-headroom (env3.state.row-substitutions) (def-count * 2),
    next-id = env3.state.next-id,
    next-row-id = env3.state.next-row-id,
    bag = env3.state.bag,
    expr-types = copy-list-with-headroom (env3.state.expr-types) (def-count * 56),
    effect-exempt = False,
    scope-grants = [],
    chapter-grounds = mod.ground-effects,
    dirty-slots = []
   })
   in let acc0 = deck-record (__list-with-capacity def-count)
   in let slug-cache = for a in assignments -> cite-key (a.chapter-slug)
   in let exit = __deck-exit
   in let cb = check-batch-open check-base keep-base keep-ceiling def-count demand-check-batch-budget poison
   in let __seq = cb.cb-reg-note = reg-note & " pre-st=" & show (__deck-pos - p5)
   in let opened = check-batch-begin cb pre-st acc0
   in let result = check-all-defs pre-st sorted-env (mod.defs) 0 def-count acc0 renames colliding assignments (mod.citations) slug-cache "" [] (mod.rt-names) tdm ceiling cb
   in let enter = __deck-enter
   in let cycle-st = check-rt-cycles (mod.defs) (mod.rt-names) (result.state)
   in let bounded-st = check-bounded-decls cycle-st (mod.defs) (mod.annotations)
   in let proof-st = check-proof-cycles (mod.defs) (result.types) bounded-st
   in let grammar-st = check-proof-grammar (mod.defs) (result.types) proof-st
   in __record-set result "state" (check-stale-reads (mod.defs) grammar-st)

  add-diagnostics-to-state : UnificationState, List Diagnostic, Integer, Integer -> UnificationState
  add-diagnostics-to-state (st) (diags) (i) (len) =
   if i == len then st
   else let d = list-at diags i
   in add-diagnostics-to-state (__record-set st "bag" (bag-add (st.bag) d)) diags (i + 1) len

  register-all-defs : UnificationState, TypeEnv, List TypeBinding, List ADef, Integer, Integer, List RenameEntry -> LetBindResult
  register-all-defs (st) (env) (tdm) (defs) (i) (len) (renames) =
   if i == len then LetBindResult {
    state = st,
    env = env
   }
   else let def = list-at defs i
   in let resolved-name = resolve-def-name renames (def.name.value) (def.chapter-slug)
   in let env0 = register-const-range env resolved-name def
   in let ty = if list-length (def.declared-type) == 0 then let (fr-ty, fr-st) = fresh-and-advance st
   in let env2 = env-bind env0 resolved-name fr-ty
   in LetBindResult {
          state = fr-st,
          env = env2
         }
   else let resolved0 = resolve-type-expr tdm (list-at (def.declared-type) 0)
   in let resolved = normalize-prop-eq defs resolved0
   in let guarded = check-effectful-arrow-value st resolved (def.span)
   in let pr = parameterize-type guarded resolved
   in LetBindResult {
          state = pr.state,
          env = env-bind env0 resolved-name (pr.parameterized)
         }
   in register-all-defs (ty.state) (ty.env) tdm defs (i + 1) len renames

  register-const-range : TypeEnv, Text, ADef -> TypeEnv
  register-const-range (env) (name) (def) =
   if list-length (def.params) > 0 then env
   else when def.body
    is ALitExpr (val) (kind) (s) ->
     when kind
      is IntLit -> env-add-const-range env name (lit-text-to-integer val)
      is otherwise -> env
    is otherwise -> env

  check-effectful-arrow-value : UnificationState, CodexType, SourceSpan -> UnificationState
  check-effectful-arrow-value (st) (ty) (span) =
   when ty
    is EffectfulTy (effs) (sc) (inner) ->
     when inner
      is FunTy (p) (row) (r) -> add-unify-error st cdx-effectful-arrow-value "an effect bracket cannot wrap a function type in a value signature; write the effect on the arrow it decorates: A -> [E] B" span
      is otherwise -> st
    is otherwise -> st

  register-effect-ops : UnificationState, TypeEnv, List TypeBinding, List AEffectDef, Integer, Integer -> LetBindResult
  register-effect-ops (st) (env) (tdm) (effs) (i) (len) =
   if i == len then LetBindResult { state = st, env = env }
   else let eff = list-at effs i
   in let after = register-effect-ops-of st env tdm (eff.ops) 0 (list-length (eff.ops))
   in register-effect-ops (after.state) (after.env) tdm effs (i + 1) len

  register-effect-ops-of : UnificationState, TypeEnv, List TypeBinding, List AEffectOpDef, Integer, Integer -> LetBindResult
  register-effect-ops-of (st) (env) (tdm) (ops) (i) (len) =
   if i == len then LetBindResult { state = st, env = env }
   else let op = list-at ops i
   in if env-has-unsorted env (op.name.value) then register-effect-ops-of st env tdm ops (i + 1) len
   else let resolved = resolve-type-expr tdm (op.type-expr)
   in let pr = parameterize-type st resolved
   in register-effect-ops-of (pr.state) (env-bind env (op.name.value) (pr.parameterized)) tdm ops (i + 1) len

  register-class-methods : UnificationState, TypeEnv, List TypeBinding, List AClassDef, List AInstanceDef -> LetBindResult
  register-class-methods (st) (env) (tdm) (cds) (ids) =
   let bound = register-cm-bindings st env tdm cds ids 0 (list-length cds)
   in let mnames = collect-multi-method-names cds ids 0 (list-length cds) []
   in if list-length mnames == 0 then bound
      else LetBindResult {
       state = bound.state,
       env = env-bind (bound.env) "__classmethods" (deck-record (RecordTy (Name { value = "__classmethods" }) [] (for n in mnames -> deck-record (RecordField { name = Name { value = n }, type-val = int-ty-default }))))
      }

  count-instances-for : List AInstanceDef, Text, Integer, Integer, Integer -> Integer
  count-instances-for (ids) (cname) (i) (len) (acc) =
   if i == len then acc
   else let id = list-at ids i
   in count-instances-for ids cname (i + 1) len (if (id.class-name.value) == cname then acc + 1 else acc)

  register-cm-bindings : UnificationState, TypeEnv, List TypeBinding, List AClassDef, List AInstanceDef, Integer, Integer -> LetBindResult
  register-cm-bindings (st) (env) (tdm) (cds) (ids) (i) (len) =
   if i == len then LetBindResult { state = st, env = env }
   else let cd = list-at cds i
   in let ic = count-instances-for ids (cd.name.value) 0 (list-length ids) 0
   in if ic <= 1 then register-cm-bindings st env tdm cds ids (i + 1) len
      else let after = register-cm-ops st env tdm (cd.methods) 0 (list-length (cd.methods))
      in let (fr-ty, fr-st) = fresh-and-advance (after.state)
      in let dict-ty = when fr-ty
       is TypeVar (vid) -> deck-record (ForAllTy vid (deck-record (ConstructedTy (Name { value = (cd.name.value) & "Dict" }) [fr-ty])))
       is otherwise -> fr-ty
      in let env2 = env-bind (after.env) ("__dict-of-" & (cd.name.value)) dict-ty
      in register-cm-bindings fr-st env2 tdm cds ids (i + 1) len

  register-cm-ops : UnificationState, TypeEnv, List TypeBinding, List AEffectOpDef, Integer, Integer -> LetBindResult
  register-cm-ops (st) (env) (tdm) (ops) (i) (len) =
   if i == len then LetBindResult { state = st, env = env }
   else let op = list-at ops i
   in let resolved = resolve-type-expr tdm (op.type-expr)
   in let pr = parameterize-type st resolved
   in register-cm-ops (pr.state) (env-bind env (op.name.value) (pr.parameterized)) tdm ops (i + 1) len

  collect-multi-method-names : List AClassDef, List AInstanceDef, Integer, Integer, List Text -> List Text
  collect-multi-method-names (cds) (ids) (i) (len) (acc) =
   if i == len then acc
   else let cd = list-at cds i
   in let ic = count-instances-for ids (cd.name.value) 0 (list-length ids) 0
   in if ic <= 1 then collect-multi-method-names cds ids (i + 1) len acc
      else collect-multi-method-names cds ids (i + 1) len (acc & (for op in (cd.methods) -> op.name.value))

  empty-type-bindings : List TypeBinding
  empty-type-bindings = []

 This one reads the deck-pos cell (deck-short-of) and that is correct,
 which makes CHECK the exception worth naming: check-chapter issues a
 __deck-exit immediately before this walk and a __deck-enter after it,
 so the walk runs OUTSIDE the phase-wide extent. The cell is therefore
 live -- each per-definition `deck-record` inside the loop enters and
 exits on its own and writes the frontier back -- where in LOWER and
 the PARSE-KEEP copy, which stay inside their extents, the same
 predicate is frozen at the deck's base and never fires. Swapping this
 one to deck-bound-short-of reads the BIVY pointer, which is above
 every deck ceiling, and truncates the walk on its first definition:
 measured 2026-07-21, that compiles `codex/test/db-test.codex` to no
 binary at all, with 40-odd CDX2000 emit errors naming types the
 truncated walk never inferred. Stopping
 short is treated exactly like finishing: the accumulated result is
 assembled and returned, and compile-type-check tests the deck position
 afterwards to raise CDX9002. Reaching the ceiling with
 definitions left over means the types are incomplete, so the caller
 halts on the diagnostic rather than trusting them.

  check-all-defs-done : UnificationState, TypeEnv, List TypeBinding, CheckBatch -> ChapterResult
  check-all-defs-done (st) (env) (acc) (cb) =
   let final-st = deck-record (UnificationState {
    substitutions = copy-list-with-headroom (st.substitutions) 0,
    row-substitutions = copy-list-with-headroom (st.row-substitutions) 0,
    next-id = st.next-id,
    next-row-id = st.next-row-id,
    bag = st.bag,
    expr-types = copy-list-with-headroom (st.expr-types) 0,
    effect-exempt = False,
    scope-grants = [],
    chapter-grounds = st.chapter-grounds,
    dirty-slots = []
   })
   in deck-record (ChapterResult {
    types = acc,
    env = env,
    state = final-st,
    keep-end = cb.cb-keep,
    keep-overflow = cb.cb-overflow,
    batch-note = check-batch-note cb
   })

Section: Check Batches

 A batch is the unit of reclamation inside the walk. Every definition's
 inference scratch is bivy and every deck-record it makes lands on the check
 deck; both are dead once the definition's survivors have been copied out,
 and the survivors are exactly what the phase-end keep copy already
 enumerates: the substitution slots written since the batch opened (tracked
 by add-subst in dirty-slots) plus the slots minted since, every row slot,
 the expr-type entries and bindings appended since, and the bag. The copy
 runs inside a keep-deck extent through the memoized copier, whose floor is
 the check deck's base, so a box already in the keep is shared and a box on
 the check deck or in the bivy is materialized once; the address memo is
 zeroed per batch because the rewound region is reused and a stale hit would
 answer a copy of a box that no longer exists. The cons layer persists across
 batches, which is what keeps a type mentioned by a thousand definitions at
 one keep box. A list that outgrew its headroom during the batch has moved
 into the bivy; it is relocated into the keep with fresh headroom before its
 entries are rewritten.

  mutable CheckBatch = record {
   cb-mc : MemoCtx,
   cb-keep : Integer,
   cb-ceiling : Integer,
   cb-budget : Integer,
   cb-poison : Integer,
   cb-bivy-mark : Integer,
   cb-deck-mark : Integer,
   cb-subs0 : Integer,
   cb-subs-len0 : Integer,
   cb-rows0 : Integer,
   cb-et0 : Integer,
   cb-et-len0 : Integer,
   cb-acc-len0 : Integer,
   cb-bag0 : Integer,
   cb-batches : Integer,
   cb-max-bivy : Integer,
   cb-max-deck : Integer,
   cb-overflow : Boolean,
   cb-walk-floor : Integer,
   cb-reg-note : Text
  }

  check-batch-open : Integer, Integer, Integer, Integer, Integer, Integer -> CheckBatch
  check-batch-open (floor) (keep-base) (keep-ceiling) (def-count) (budget) (poison) =
   let memo-slots = demand-check-batch-memo-slots
   in let memo-table = __heap-save
   in let a1 = __heap-advance (memo-slots * 8)
   in let cons-slots = memo-pow2-at-least (def-count * 48) 4096
   in let cons-table = __heap-save
   in let a2 = __heap-advance (cons-slots * 16)
   in let cz = __memset cons-table 0 (cons-slots * 16)
   in let tcons-slots = memo-pow2-at-least (def-count * 8) 4096
   in let tcons-table = __heap-save
   in let a3 = __heap-advance (tcons-slots * 16)
   in let tz = __memset tcons-table 0 (tcons-slots * 16)
   in let cap-ty = def-count * 48 + 4096
   in let cap-text = def-count * 8 + 16384
   in let cap-row = def-count * 12 + 4096
   in let cap-list = def-count * 4 + 4096
   in let mc = MemoCtx {
    mc-table = memo-table,
    mc-slots = memo-slots,
    mc-shift = memo-shift-for memo-slots 64,
    mc-floor = floor,
    mc-ty = __list-with-capacity cap-ty,
    mc-text = __list-with-capacity cap-text,
    mc-name = __list-with-capacity cap-text,
    mc-row = __list-with-capacity cap-row,
    mc-tylist = __list-with-capacity cap-list,
    mc-fieldlist = __list-with-capacity cap-list,
    mc-ctorlist = __list-with-capacity cap-list,
    mc-labellist = __list-with-capacity cap-list,
    mc-cons = cons-table,
    mc-cons-slots = cons-slots,
    mc-cons-shift = memo-shift-for cons-slots 64,
    mc-cap-ty = cap-ty,
    mc-cap-text = cap-text,
    mc-cap-name = cap-text,
    mc-cap-row = cap-row,
    mc-cap-list = cap-list,
    mc-ceiling = keep-ceiling,
    mc-tcons = tcons-table,
    mc-tcons-slots = tcons-slots,
    mc-tcons-shift = memo-shift-for tcons-slots 64
   }
   in CheckBatch {
    cb-mc = mc,
    cb-keep = keep-base,
    cb-ceiling = keep-ceiling,
    cb-budget = budget,
    cb-poison = poison,
    cb-bivy-mark = 0,
    cb-deck-mark = 0,
    cb-subs0 = 0,
    cb-subs-len0 = 0,
    cb-rows0 = 0,
    cb-et0 = 0,
    cb-et-len0 = 0,
    cb-acc-len0 = 0,
    cb-bag0 = 0,
    cb-batches = 0,
    cb-max-bivy = 0,
    cb-max-deck = 0,
    cb-overflow = False,
    cb-walk-floor = __deck-pos,
    cb-reg-note = ""
   }

  check-batch-begin : CheckBatch, UnificationState, List TypeBinding -> Integer
  check-batch-begin (cb) (st) (acc) =
   let mz = __memset (cb.cb-mc.mc-table) 0 (cb.cb-mc.mc-slots * 8)
   in let __seq = cb.cb-bivy-mark = __heap-save
   in let __seq = cb.cb-deck-mark = __deck-pos
   in let __seq = cb.cb-subs0 = address-of (st.substitutions)
   in let __seq = cb.cb-subs-len0 = list-length (st.substitutions)
   in let __seq = cb.cb-rows0 = address-of (st.row-substitutions)
   in let __seq = cb.cb-et0 = address-of (st.expr-types)
   in let __seq = cb.cb-et-len0 = list-length (st.expr-types)
   in let __seq = cb.cb-acc-len0 = list-length acc
   in let __seq = cb.cb-bag0 = address-of (st.bag)
   in let __seq = st.dirty-slots = __list-with-capacity 4096
   in 0

  check-batch-due : CheckBatch -> Boolean
  check-batch-due (cb) =
   (__heap-save - cb.cb-bivy-mark) + (__deck-pos - cb.cb-deck-mark) >= cb.cb-budget

 The close is bare-metal memory management in its entirety -- it moves the
 deck cursor twice, poisons the two spans it is about to give back, and
 rewinds the bivy -- and its copier reaches further still: `mcopy-type`
 validates a box by ranging `peek-qword (address-of ty) 0` against the
 CodexType tags. A HOSTED target has no such memory. Its objects live wherever
 its host allocator put them, `address-of`, `peek-*` and `__heap-save` answer
 for a different region entirely, and the peek reads whatever that region
 happens to hold. `mcopy-type` then takes its unsafe escape and answers
 `ErrorTy` for every type in the chapter, which is the safe direction on bare
 metal only because the caller catches it by comparing the keep frontier
 against `mc-ceiling` -- a second measurement in the same fictional space, so
 on a hosted target it fails open. The zig arm of the plug-oracle ladder read
 `check-errors 0` and bound every top-level function to `ErrorTy`.
 Guarding the copier alone is not enough: real types behind it reach the next
 assumption and the walk dies on a corrupt switch. So the guard goes here, at
 the whole operation, exactly as `deck-reservation-guard` does.

 Nothing is lost by skipping it. The close exists to materialise the batch
 into the keep BEFORE the scratch is reclaimed, and a hosted target reclaims
 nothing -- there is no compact to survive. The batch counters and
 `cb-overflow` stay at their initial values in consequence, so
 `check-batch-note` reads zeros and CDX9002 cannot fire on a hosted arm.
 Both follow: a hosted arm has no keep to fill and no reservation to overflow.

  check-batch-close : CheckBatch, UnificationState, List TypeBinding -> Integer
  check-batch-close (cb) (st) (acc) =
   if hosted-kind /= 0 then 0
   else let bivy-now = __heap-save
   in let deck-now = __deck-pos
   in let bivy-used = bivy-now - cb.cb-bivy-mark
   in let deck-used = deck-now - cb.cb-deck-mark
   in let __seq = cb.cb-max-bivy = if bivy-used > cb.cb-max-bivy then bivy-used else cb.cb-max-bivy
   in let __seq = cb.cb-max-deck = if deck-used > cb.cb-max-deck then deck-used else cb.cb-max-deck
   in let set-keep = __deck-set (cb.cb-keep)
   in let copied = deck-record (check-batch-copy cb st acc)
   in let keep-end = __deck-pos
   in let __seq = cb.cb-keep = keep-end
   in let __seq = cb.cb-overflow = if keep-end >= cb.cb-ceiling then True else cb.cb-overflow
   in let p1 = check-batch-poison (cb.cb-deck-mark) (cb.cb-poison) (deck-now - cb.cb-deck-mark)
   in let p2 = check-batch-poison (cb.cb-bivy-mark) (cb.cb-poison) (bivy-now - cb.cb-bivy-mark)
   in let set-deck = __deck-set (cb.cb-deck-mark)
   in let restored = __heap-restore (cb.cb-bivy-mark)
   in let __seq = cb.cb-batches = cb.cb-batches + 1
   in 0

  check-batch-poison : Integer, Integer, Integer -> Nothing
  check-batch-poison (base) (byte) (len) =
   if byte == 0 | len <= 0 then __heap-advance 0
   else __memset base byte len

  check-batch-copy : CheckBatch, UnificationState, List TypeBinding -> Integer
  check-batch-copy (cb) (st) (acc) =
   let mc = cb.cb-mc
   in let subs1 = st.substitutions
   in let subs = if address-of subs1 == cb.cb-subs0 then subs1 else copy-list-with-headroom subs1 (list-length subs1 / 2 + 4096)
   in let __seq = st.substitutions = subs
   in let rows1 = st.row-substitutions
   in let rows = if address-of rows1 == cb.cb-rows0 then rows1 else copy-list-with-headroom rows1 (list-length rows1 / 2 + 1024)
   in let __seq = st.row-substitutions = rows
   in let et1 = st.expr-types
   in let et = if address-of et1 == cb.cb-et0 then et1 else copy-list-with-headroom et1 (list-length et1 / 2 + 4096)
   in let __seq = st.expr-types = et
   in let d = check-batch-rewrite-slots subs (st.dirty-slots) 0 (list-length (st.dirty-slots)) mc
   in let n = check-batch-rewrite-range subs (cb.cb-subs-len0) (list-length subs) mc
   in let r = check-batch-rewrite-rows rows 0 (list-length rows) mc
   in let e = check-batch-rewrite-et et (cb.cb-et-len0) (list-length et) mc
   in let a = check-batch-rewrite-acc acc (cb.cb-acc-len0) (list-length acc) mc
   in let b = if address-of (st.bag) == cb.cb-bag0 then 0 else check-batch-copy-bag st (mc.mc-floor)
   in 0

  check-batch-copy-bag : UnificationState, Integer -> Integer
  check-batch-copy-bag (st) (floor) =
   let nb = copy-sx-bag floor (st.bag)
   in let __seq = st.bag = nb
   in 0

  check-batch-rewrite-slots : List CodexType, List Integer, Integer, Integer, MemoCtx -> Integer
  check-batch-rewrite-slots (subs) (dirty) (i) (len) (mc) =
   if i == len then 0
   else let id = list-at dirty i
   in if id >= list-length subs then check-batch-rewrite-slots subs dirty (i + 1) len mc
   else let w = list-set-at subs id (mcopy-type (list-at subs id) 0 mc)
   in check-batch-rewrite-slots subs dirty (i + 1) len mc

  check-batch-rewrite-range : List CodexType, Integer, Integer, MemoCtx -> Integer
  check-batch-rewrite-range (subs) (i) (len) (mc) =
   if i >= len then 0
   else let w = list-set-at subs i (mcopy-type (list-at subs i) 0 mc)
   in check-batch-rewrite-range subs (i + 1) len mc

  check-batch-rewrite-rows : List EffectRow, Integer, Integer, MemoCtx -> Integer
  check-batch-rewrite-rows (rows) (i) (len) (mc) =
   if i >= len then 0
   else let w = list-set-at rows i (mcopy-row (list-at rows i) mc)
   in check-batch-rewrite-rows rows (i + 1) len mc

  check-batch-rewrite-et : List ExprTypeEntry, Integer, Integer, MemoCtx -> Integer
  check-batch-rewrite-et (et) (i) (len) (mc) =
   if i >= len then 0
   else let e = list-at et i
   in let w = list-set-at et i (ExprTypeEntry { key = e.key, ty = mcopy-type (e.ty) 0 mc })
   in check-batch-rewrite-et et (i + 1) len mc

  check-batch-rewrite-acc : List TypeBinding, Integer, Integer, MemoCtx -> Integer
  check-batch-rewrite-acc (acc) (i) (len) (mc) =
   if i >= len then 0
   else let b = list-at acc i
   in let w = list-set-at acc i (TypeBinding { name = mcopy-text (b.name) mc, bound-type = mcopy-type (b.bound-type) 0 mc })
   in check-batch-rewrite-acc acc (i + 1) len mc

  check-batch-note : CheckBatch -> Text
  check-batch-note (cb) =
   cb.cb-reg-note & " CHECK-BATCH batches=" & show (cb.cb-batches) & " max-bivy=" & show (cb.cb-max-bivy) & " max-deck=" & show (cb.cb-max-deck) & " keep-end=" & show (cb.cb-keep) & " check-base=" & show (cb.cb-mc.mc-floor) & " walk-floor=" & show (cb.cb-walk-floor) & " done-deck=" & show __deck-pos & " done-bivy=" & show __heap-save & " ty=" & show (list-length (cb.cb-mc.mc-ty)) & "/" & show (cb.cb-mc.mc-cap-ty) & " text=" & show (list-length (cb.cb-mc.mc-text)) & " name=" & show (list-length (cb.cb-mc.mc-name)) & " row=" & show (list-length (cb.cb-mc.mc-row)) & " tylists=" & show (list-length (cb.cb-mc.mc-tylist)) & " fieldlists=" & show (list-length (cb.cb-mc.mc-fieldlist)) & " ctorlists=" & show (list-length (cb.cb-mc.mc-ctorlist)) & " labellists=" & show (list-length (cb.cb-mc.mc-labellist)) & " cons-slots=" & show (cb.cb-mc.mc-cons-slots) & " overflow=" & (if cb.cb-overflow then "1" else "0")

  check-all-defs : UnificationState, TypeEnv, List ADef, Integer, Integer, List TypeBinding, List RenameEntry, SkipListText, List ChapterAssignment, List ACitesDecl, List Text, Text, List RenameEntry, List Text, List TypeBinding, Integer, CheckBatch -> ChapterResult
  check-all-defs (st) (env) (defs) (i) (len) (acc) (renames) (colliding) (assignments) (citations) (slug-cache) (cur-slug) (cur-chapter-rn) (rt-names) (tdm) (ceiling) (cb) =
   if i == len then let closed = check-batch-close cb st acc in check-all-defs-done st env acc cb
   else if cb.cb-overflow then check-all-defs-done st env acc cb
   else if deck-short-of ceiling demand-check-guard-band then let closed = check-batch-close cb st acc in check-all-defs-done st env acc cb
   else let def = list-at defs i
   in let chapter-rn = if def.chapter-slug == cur-slug then cur-chapter-rn
      else apply-cite-overrides (build-chapter-rename-map colliding assignments (def.chapter-slug)) citations colliding assignments slug-cache (def.chapter-slug) 0
   in let fresh-env = __record-set (__record-set (__record-set env "locals" empty-type-bindings) "chapter-renames" chapter-rn) "local-ranges" []
   in let r = check-def st fresh-env defs tdm def renames
   in let lin-st = check-linearity-def def fresh-env (r.state)
   in let bnd-st = check-bounded-bases-def def tdm lin-st
   in let rt-chk = is-rt-name rt-names (def.name.value) 0 (list-length rt-names)
   in let rt-st1 = if rt-chk then check-rt-calls (check-rt-no-alloc (check-rt-no-lambda bnd-st (def.body) (def.name.value)) (def.body) (def.name.value)) (def.body) (def.name.value) rt-names else bnd-st
   in let rt-st2 = if rt-chk & has-self-call (def.body) (def.name.value) then __record-set rt-st1 "bag" (bag-add (rt-st1.bag) (make-error cdx-rt-unbounded-recursion ("punctual function '" & def.name.value & "' is self-recursive") (aexpr-span (def.body)))) else rt-st1
   in let rt-st = if rt-chk then check-rt-effects rt-st2 (r.inferred-type) (def.name.value) (aexpr-span (def.body)) else rt-st2
   in let resolved = deep-resolve rt-st (r.inferred-type)
   in let entry = deck-record (TypeBinding {
    name = resolve-def-name renames (def.name.value) (def.chapter-slug),
    bound-type = resolved
   })
   in let acc2 = list-push acc entry
   in if check-batch-due cb
      then let closed = check-batch-close cb rt-st acc2
       in let opened = check-batch-begin cb rt-st acc2
       in check-all-defs rt-st env defs (i + 1) len acc2 renames colliding assignments citations slug-cache "" [] rt-names tdm ceiling cb
      else check-all-defs rt-st env defs (i + 1) len acc2 renames colliding assignments citations slug-cache (def.chapter-slug) chapter-rn rt-names tdm ceiling cb

Section: Induction Checking

  def-is-induction : ADef -> Boolean
  def-is-induction (def) =
   if list-length (def.declared-type) == 0 then False
   else atypeexpr-is-forall (list-at (def.declared-type) 0) & aexpr-is-induction (def.body)

  atypeexpr-is-forall : ATypeExpr -> Boolean
  atypeexpr-is-forall (t) =
   when t
    is AForallType (v) (vt) (p) (s) -> True
    is otherwise -> False

  aexpr-is-induction : AExpr -> Boolean
  aexpr-is-induction (e) =
   when e
    is AInductionExpr (sc) (arms) (s) -> True
    is otherwise -> False

  check-induction-def : UnificationState, TypeEnv, List ADef, List TypeBinding, ADef -> CheckResult
  check-induction-def (st) (env) (defs) (tdm) (def) =
   when (def.body)
    is AInductionExpr (scrut) (arms) (isp) ->
     when scrut
      is ANameExpr (iv) (ss) ->
       let fa = list-at (def.declared-type) 0
       in let env-fa = bind-forall-value-binders env tdm fa
       in check-induction-core st env-fa defs tdm (iv.value) (forall-binder-type fa (iv.value)) (forall-innermost-prop fa) arms isp
      is otherwise -> induction-unproven st (def.span)
    is otherwise -> induction-unproven st (def.span)

  bind-forall-value-binders : TypeEnv, List TypeBinding, ATypeExpr -> TypeEnv
  bind-forall-value-binders (env) (tdm) (fa) =
   when fa
    is AForallType (v) (vt) (p) (s) -> bind-forall-value-binders (env-bind-local env (v.value) (resolve-type-expr tdm vt)) tdm p
    is otherwise -> env

  forall-binder-type : ATypeExpr, Text -> ATypeExpr
  forall-binder-type (fa) (name) =
   when fa
    is AForallType (v) (vt) (p) (s) -> if (v.value) == name then vt else forall-binder-type p name
    is otherwise -> fa

  forall-innermost-prop : ATypeExpr -> ATypeExpr
  forall-innermost-prop (fa) =
   when fa
    is AForallType (v) (vt) (p) (s) -> forall-innermost-prop p
    is otherwise -> fa

  check-induction-core : UnificationState, TypeEnv, List ADef, List TypeBinding, Text, ATypeExpr, ATypeExpr, List AMatchArm, SourceSpan -> CheckResult
  check-induction-core (st) (env) (defs) (tdm) (indVar) (varTy) (prop) (arms) (sp) =
   let tTy = sumty-of tdm (resolve-type-expr tdm varTy)
   in when prop
    is APropEqType (lhsTe) (rhsTe) (psp) ->
     let lhsTy = resolve-type-expr tdm lhsTe
     in let rhsTy = resolve-type-expr tdm rhsTe
     in when tTy
      is SumTy (tname) (targs) (ctors) ->
       check-induction-ctors st env defs tdm indVar (tname.value) lhsTy rhsTy ctors arms sp 0 (list-length ctors)
      is otherwise -> induction-unproven st sp
    is otherwise -> induction-unproven st sp

  sumty-of : List TypeBinding, CodexType -> CodexType
  sumty-of (tdm) (ty) =
   when ty
    is SumTy (n) (a) (c) -> ty
    is ConstructedTy (n) (args) -> lookup-type-def tdm (n.value)
    is ListTy (elem) | LinkedListTy (elem) -> builtin-list-sumty elem
    is otherwise -> ty

  builtin-list-sumty : CodexType -> CodexType
  builtin-list-sumty (elem) =
   deck-record (SumTy (make-name "List") [elem] [
    deck-record (SumCtor { name = make-name "Nil", fields = [], return-type = [] }),
    deck-record (SumCtor { name = make-name "Cons", fields = [elem, deck-record (ListTy elem)], return-type = [] })])

  check-induction-ctors : UnificationState, TypeEnv, List ADef, List TypeBinding, Text, Text, CodexType, CodexType, List SumCtor, List AMatchArm, SourceSpan, Integer, Integer -> CheckResult
  check-induction-ctors (st) (env) (defs) (tdm) (nName) (tname) (lhsTy) (rhsTy) (ctors) (arms) (sp) (i) (len) =
   if i == len then CheckResult { inferred-type = ProofTy, effect-row = empty-row, state = st }
   else let c = list-at ctors i
   in let ai = find-arm-for-ctor arms (c.name.value) 0 (list-length arms)
   in let st2 = if ai < 0
      then induction-missing-arm st (c.name.value) sp
      else check-induction-arm st env defs tdm nName tname lhsTy rhsTy c (list-at arms ai) sp
   in check-induction-ctors st2 env defs tdm nName tname lhsTy rhsTy ctors arms sp (i + 1) len

  check-induction-arm : UnificationState, TypeEnv, List ADef, List TypeBinding, Text, Text, CodexType, CodexType, SumCtor, AMatchArm, SourceSpan -> UnificationState
  check-induction-arm (st) (env) (defs) (tdm) (nName) (tname) (lhsTy) (rhsTy) (c) (arm) (sp) =
   let fieldTys = c.fields
   in let m = list-length fieldTys
   in let patVars = ctorpat-var-names (arm.pattern)
   in if list-length patVars < m then induction-unproven-st st sp
   else let ctorApp = build-ctor-app-term (c.name.value) patVars 0 m
   in let subL = normalize-codextype defs (subst-ctype-name nName ctorApp lhsTy) proof-norm-fuel
   in let subR = normalize-codextype defs (subst-ctype-name nName ctorApp rhsTy) proof-norm-fuel
   in let subgoal = deck-record (PropEqTy subL subR)
   in let env2 = bind-field-vars env patVars fieldTys 0 m
   in let env3 = bind-ihs env2 defs nName lhsTy rhsTy fieldTys patVars 0 m 0 tname
   in let elab = elab-claim-apps (arm.body) env3 defs tdm 0
   in let r = infer-expr st (elab.ec-env) (elab.ec-expr)
   in let (_, u-st) = unify (r.state) subgoal (r.inferred-type) sp
   in u-st

  bind-field-vars : TypeEnv, List Text, List CodexType, Integer, Integer -> TypeEnv
  bind-field-vars (env) (vars) (tys) (i) (m) =
   if i == m then env
   else bind-field-vars (env-bind-local env (list-at vars i) (list-at tys i)) vars tys (i + 1) m

  bind-ihs : TypeEnv, List ADef, Text, CodexType, CodexType, List CodexType, List Text, Integer, Integer, Integer, Text -> TypeEnv
  bind-ihs (env) (defs) (nName) (lhsTy) (rhsTy) (fieldTys) (patVars) (j) (m) (cursor) (tname) =
   if j == m then env
   else if ctype-head-name (list-at fieldTys j) == tname
    then let fvTerm = deck-record (ConstructedTy (make-name (list-at patVars j)) [])
     in let ihL = normalize-codextype defs (subst-ctype-name nName fvTerm lhsTy) proof-norm-fuel
     in let ihR = normalize-codextype defs (subst-ctype-name nName fvTerm rhsTy) proof-norm-fuel
     in let ihTy = deck-record (PropEqTy ihL ihR)
     in if m + cursor < list-length patVars
        then bind-ihs (env-bind-local env (list-at patVars (m + cursor)) ihTy) defs nName lhsTy rhsTy fieldTys patVars (j + 1) m (cursor + 1) tname
        else bind-ihs env defs nName lhsTy rhsTy fieldTys patVars (j + 1) m cursor tname
    else bind-ihs env defs nName lhsTy rhsTy fieldTys patVars (j + 1) m cursor tname

  build-ctor-app-term : Text, List Text, Integer, Integer -> CodexType
  build-ctor-app-term (cname) (vars) (i) (m) =
   deck-record (ConstructedTy (make-name cname) (ctor-arg-terms vars 0 m []))

  ctor-arg-terms : List Text, Integer, Integer, List CodexType -> List CodexType
  ctor-arg-terms (vars) (i) (m) (acc) =
   if i == m then acc
   else ctor-arg-terms vars (i + 1) m (list-push acc (deck-record (ConstructedTy (make-name (list-at vars i)) [])))

  subst-ctype-name : Text, CodexType, CodexType -> CodexType
  subst-ctype-name (nm) (repl) (t) =
   when t
    is ConstructedTy (n) (args) ->
     if (n.value) == nm & list-length args == 0 then repl
     else deck-record (ConstructedTy n (subst-ctype-args nm repl args 0 (list-length args) []))
    is otherwise -> t

  subst-ctype-args : Text, CodexType, List CodexType, Integer, Integer, List CodexType -> List CodexType
  subst-ctype-args (nm) (repl) (args) (i) (len) (acc) =
   if i == len then acc
   else subst-ctype-args nm repl args (i + 1) len (list-push acc (subst-ctype-name nm repl (list-at args i)))

  ctype-head-name : CodexType -> Text
  ctype-head-name (t) =
   when t
    is ConstructedTy (n) (args) -> n.value
    is SumTy (n) (a) (c) -> n.value
    is RecordTy (n) (a) (f) -> n.value
    is ListTy (e) | LinkedListTy (e) -> "List"
    is otherwise -> ""

  ctorpat-var-names : APat -> List Text
  ctorpat-var-names (p) =
   when p
    is ACtorPat (cn) (subs) (s) -> collect-avar-names subs 0 (list-length subs) []
    is otherwise -> []

  collect-avar-names : List APat, Integer, Integer, List Text -> List Text
  collect-avar-names (subs) (i) (len) (acc) =
   if i == len then acc
   else when (list-at subs i)
    is AVarPat (n) (s) -> collect-avar-names subs (i + 1) len (list-push acc (n.value))
    is otherwise -> collect-avar-names subs (i + 1) len acc

  find-arm-for-ctor : List AMatchArm, Text, Integer, Integer -> Integer
  find-arm-for-ctor (arms) (cn) (i) (len) =
   if i == len then 0 - 1
   else when (list-at arms i).pattern
    is ACtorPat (pn) (subs) (s) -> if (pn.value) == cn then i else find-arm-for-ctor arms cn (i + 1) len
    is otherwise -> find-arm-for-ctor arms cn (i + 1) len

  induction-unproven : UnificationState, SourceSpan -> CheckResult
  induction-unproven (st) (sp) =
   CheckResult { inferred-type = ProofTy, effect-row = empty-row, state = induction-unproven-st st sp }

  induction-unproven-st : UnificationState, SourceSpan -> UnificationState
  induction-unproven-st (st) (sp) =
   __record-set st "bag" (bag-add (st.bag) (make-warning cdx-induction-unverified "induction proof accepted as an unproven axiom; the claim is not a variant-typed for-all equality that Stage 5 can check" sp))

  induction-missing-arm : UnificationState, Text, SourceSpan -> UnificationState
  induction-missing-arm (st) (cn) (sp) =
   __record-set st "bag" (bag-add (st.bag) (make-error cdx-non-exhaustive-match ("induction proof is missing a case for constructor '" & cn & "'") sp))

  ElabResult = record {
   ec-expr : AExpr,
   ec-env : TypeEnv,
   ec-counter : Integer
  }

  elab-claim-apps : AExpr, TypeEnv, List ADef, List TypeBinding, Integer -> ElabResult
  elab-claim-apps (e) (env) (defs) (tdm) (ctr) =
   when e
    is AApplyExpr (f) (a) (s) ->
     when (app-head e)
      is ANameExpr (nm) (hs) ->
       let ci = find-claim-def defs (nm.value) 0 (list-length defs)
       in if ci >= 0
          then let instTy = instantiate-claim tdm defs (list-at defs ci) (app-args e)
            in let fresh = "__lemma-" & integer-to-text ctr
            in ElabResult { ec-expr = deck-record (ANameExpr (make-name fresh) s), ec-env = env-bind-local env fresh instTy, ec-counter = ctr + 1 }
          else elab-claim-app-children f a s env defs tdm ctr
      is otherwise -> elab-claim-app-children f a s env defs tdm ctr
    is otherwise -> ElabResult { ec-expr = e, ec-env = env, ec-counter = ctr }

  elab-claim-app-children : AExpr, AExpr, SourceSpan, TypeEnv, List ADef, List TypeBinding, Integer -> ElabResult
  elab-claim-app-children (f) (a) (s) (env) (defs) (tdm) (ctr) =
   let rf = elab-claim-apps f env defs tdm ctr
   in let ra = elab-claim-apps a (rf.ec-env) defs tdm (rf.ec-counter)
   in ElabResult { ec-expr = deck-record (AApplyExpr (rf.ec-expr) (ra.ec-expr) s), ec-env = ra.ec-env, ec-counter = ra.ec-counter }

  find-claim-def : List ADef, Text, Integer, Integer -> Integer
  find-claim-def (defs) (name) (i) (len) =
   if i == len then 0 - 1
   else let d = list-at defs i
   in if (d.name.value) == name & list-length (d.declared-type) >= 1 & atypeexpr-is-forall (list-at (d.declared-type) 0) then i
      else find-claim-def defs name (i + 1) len

  instantiate-claim : List TypeBinding, List ADef, ADef, List AExpr -> CodexType
  instantiate-claim (tdm) (defs) (claimDef) (sargs) =
   let fa = list-at (claimDef.declared-type) 0
   in when (forall-innermost-prop fa)
    is APropEqType (lhsTe) (rhsTe) (psp) ->
     let subL = subst-claim-binders fa sargs (resolve-type-expr tdm lhsTe) 0
     in let subR = subst-claim-binders fa sargs (resolve-type-expr tdm rhsTe) 0
     in deck-record (PropEqTy (normalize-codextype defs subL proof-norm-fuel) (normalize-codextype defs subR proof-norm-fuel))
    is otherwise -> ProofTy

  subst-claim-binders : ATypeExpr, List AExpr, CodexType, Integer -> CodexType
  subst-claim-binders (fa) (sargs) (ty) (i) =
   when fa
    is AForallType (v) (vt) (p) (s) ->
     if i < list-length sargs
     then subst-claim-binders p sargs (subst-ctype-name (v.value) (aexpr-to-cterm (list-at sargs i)) ty) (i + 1)
     else ty
    is otherwise -> ty

  aexpr-to-cterm : AExpr -> CodexType
  aexpr-to-cterm (e) =
   when e
    is ANameExpr (n) (s) -> deck-record (ConstructedTy n [])
    is AApplyExpr (f) (a) (s) ->
     when (aexpr-to-cterm f)
      is ConstructedTy (n) (args) -> deck-record (ConstructedTy n (list-push args (aexpr-to-cterm a)))
      is otherwise -> deck-record (ConstructedTy (make-name "__nonterm") [])
    is otherwise -> deck-record (ConstructedTy (make-name "__nonterm") [])

Section: Linearity Checking

  LinResult = record {
   count : Integer,
   ok : Boolean,
   dead : Integer,
   ret : Boolean,
   esc : Text,
   cap : Text
  }

  lin-zero : LinResult
  lin-zero = LinResult { count = 0, ok = True, dead = 0, ret = False, esc = "", cap = "" }

  lin-one : LinResult
  lin-one = LinResult { count = 1, ok = True, dead = 0, ret = False, esc = "", cap = "" }

  lin-use : Boolean -> LinResult
  lin-use (tail) = LinResult { count = 1, ok = True, dead = 0, ret = tail, esc = "", cap = "" }

  lin-esc-first : Text, Text -> Text
  lin-esc-first (a) (b) = if a == "" then b else a

  lin-flags : LinResult -> Boolean
  lin-flags (c) =
   if c.count > 0 then True
   else if (c.dead) > 0 then True
   else if (c.esc) /= "" then True
   else (c.cap) /= ""

  lin-seq : LinResult, LinResult -> LinResult
  lin-seq (a) (b) = LinResult { count = a.count + b.count, ok = a.ok & b.ok, dead = a.dead + b.dead, ret = (a.ret) | (b.ret), esc = lin-esc-first (a.esc) (b.esc), cap = lin-esc-first (a.cap) (b.cap) }

  lin-branch : LinResult, LinResult -> LinResult
  lin-branch (a) (b) = LinResult { count = a.count, ok = a.ok & b.ok & (a.count == b.count), dead = a.dead + b.dead, ret = (a.ret) | (b.ret), esc = lin-esc-first (a.esc) (b.esc), cap = lin-esc-first (a.cap) (b.cap) }

  lin-path-max : LinResult, LinResult -> LinResult
  lin-path-max (a) (b) = LinResult { count = if a.count >= b.count then a.count else b.count, ok = a.ok & b.ok, dead = a.dead + b.dead, ret = (a.ret) | (b.ret), esc = lin-esc-first (a.esc) (b.esc), cap = lin-esc-first (a.cap) (b.cap) }

  lin-move-join : LinResult, LinResult -> LinResult
  lin-move-join (moved) (dead) = LinResult { count = moved.count, ok = moved.ok, dead = (moved.dead) + (dead.dead) + (dead.count) + (if dead.ok then 0 else 1), ret = moved.ret, esc = lin-esc-first (moved.esc) (dead.esc), cap = lin-esc-first (moved.cap) (dead.cap) }

  lin-retain-join : LinResult, LinResult, LinResult -> LinResult
  lin-retain-join (c) (moved) (dead) = LinResult { count = (moved.count) + (if c.count > 0 then (c.count) - 1 else 0), ok = c.ok & moved.ok, dead = (c.dead) + (moved.dead) + (dead.count) + (dead.dead) + (if dead.ok then 0 else 1), ret = moved.ret, esc = lin-esc-first (c.esc) (lin-esc-first (moved.esc) (dead.esc)), cap = lin-esc-first (c.cap) (lin-esc-first (moved.cap) (dead.cap)) }

  is-linear-atype : ATypeExpr -> Boolean
  is-linear-atype (t) =
   when t
    is ALinearType (inner) (s) -> True
    is otherwise -> False

  apat-binds-name : APat, Text -> Boolean
  apat-binds-name (p) (v) =
   when p
    is AVarPat (n) (s) -> (n.value) == v
    is ACtorPat (n) (subs) (s) -> apat-list-binds-name subs v 0 (list-length subs)
    is AVecPat (subs) (s) -> apat-list-binds-name subs v 0 (list-length subs)
    is otherwise -> False

  apat-list-binds-name : List APat, Text, Integer, Integer -> Boolean
  apat-list-binds-name (subs) (v) (i) (len) =
   if i >= len then False
   else if apat-binds-name (list-at subs i) v then True
   else apat-list-binds-name subs v (i + 1) len

  lin-of : TypeEnv, Text, Boolean, AExpr -> LinResult
  lin-of (env) (v) (tail) (e) =
   when e
    is ANameExpr (n) (s) -> if n.value == v then lin-use tail else lin-zero
    is AApplyExpr (f) (a) (s) -> lin-spine env v (apply-head-name e) e
    is ABinaryExpr (l) (op) (r) (s) -> lin-seq (lin-of env v False l) (lin-of env v False r)
    is AUnaryExpr (x) (s) -> lin-of env v False x
    is AIfExpr (c) (t) (el) (s) -> lin-seq (lin-of env v False c) (lin-branch (lin-of env v tail t) (lin-of env v tail el))
    is ALetExpr (binds) (body) (s) -> lin-let env v tail binds body 0 (list-length binds)
    is ALambdaExpr (params) (body) (s) -> if name-list-has params v then lin-zero else lin-lambda-node env v tail body
    is AHandleExpr (eff) (body) (clauses) (s) -> lin-seq (lin-of env v False body) (lin-clauses env v clauses 0 (list-length clauses))
    is AWithTimeoutExpr (t) (effs) (scopes) (body) (s) -> lin-of env v tail body
    is AMatchExpr (scrut) (arms) (s) -> lin-seq (lin-of env v False scrut) (lin-arms env v tail arms 0 (list-length arms))
    is AListExpr (elems) (s) -> lin-list env v elems 0 (list-length elems)
    is ARecordExpr (n) (fields) (s) -> lin-fields env v fields 0 (list-length fields)
    is AFieldAccess (obj) (f) (s) -> lin-of env v False obj
    is AActExpr (stmts) (s) -> lin-stmts env v stmts 0 (list-length stmts)
    is ATryExpr (max) (body) (fb) (fail) (s) -> lin-seq (lin-stmts env v body 0 (list-length body)) (lin-seq (lin-stmts env v fb 0 (list-length fb)) (lin-stmts env v fail 0 (list-length fail)))
    is AFieldAssignExpr (rec) (f) (val) (s) -> lin-seq (lin-of env v False rec) (lin-of env v False val)
    is ALazyExpr (inner) (s) -> lin-of env v False inner
    is otherwise -> lin-zero

  lin-spine : TypeEnv, Text, Text, AExpr -> LinResult
  lin-spine (env) (v) (head) (e) =
   when e
    is AApplyExpr (f) (a) (s) -> lin-seq (lin-spine env v head f) (lin-arg env v head (apply-arg-count f) a)
    is otherwise -> lin-of env v False e

  lin-arg : TypeEnv, Text, Text, Integer, AExpr -> LinResult
  lin-arg (env) (v) (head) (k) (a) =
   when a
    is ANameExpr (n) (s) -> if (n.value) == v then lin-arg-use env head k else lin-zero
    is ALambdaExpr (ps) (bd) (s) -> lin-arg-lambda (lin-of env v False a)
    is otherwise -> lin-of env v False a

  lin-arg-lambda : LinResult -> LinResult
  lin-arg-lambda (c) =
   if lin-flags c
    then LinResult { count = c.count, ok = c.ok, dead = c.dead, ret = False, esc = c.esc, cap = lin-esc-first (c.cap) "a closure passed as an argument" }
    else c

  lin-lambda-node : TypeEnv, Text, Boolean, AExpr -> LinResult
  lin-lambda-node (env) (v) (tail) (body) =
   let c = lin-of env v False body
   in if tail
    then (if lin-flags c then LinResult { count = c.count, ok = c.ok, dead = c.dead, ret = True, esc = c.esc, cap = c.cap } else c)
    else c

  lin-arg-use : TypeEnv, Text, Integer -> LinResult
  lin-arg-use (env) (head) (k) =
   if callee-param-linear env head k then lin-one
   else LinResult { count = 1, ok = True, dead = 0, ret = False, esc = if head == "" then "a function value" else head, cap = "" }

  callee-param-linear : TypeEnv, Text, Integer -> Boolean
  callee-param-linear (env) (head) (k) =
   if head == "" then False
   else let resolved = rename-lookup (env.chapter-renames) head
   in if env-has env resolved then registered-param-is-linear (env-lookup env resolved) k
   else False

  registered-param-is-linear : CodexType, Integer -> Boolean
  registered-param-is-linear (ty) (k) =
   when ty
    is FunTy (p) (row) (r) -> if k <= 0 then param-is-linear p else registered-param-is-linear r (k - 1)
    is ForAllTy (id) (body) -> registered-param-is-linear body k
    is ForAllEff (id) (body) -> registered-param-is-linear body k
    is otherwise -> False

  param-is-linear : CodexType -> Boolean
  param-is-linear (ty) =
   when ty
    is LinearTy (inner) -> True
    is otherwise -> False

  lin-bind-is-alias : ALetBind, Text -> Boolean
  lin-bind-is-alias (b) (v) =
   when (b.value)
    is ANameExpr (n) (s) -> (n.value) == v
    is otherwise -> False

  lin-stash-elem : AExpr, Text -> Boolean
  lin-stash-elem (e) (v) =
   when e
    is ANameExpr (n) (s) -> (n.value) == v
    is AListExpr (elems) (s) -> lin-stash-list elems v 0 (list-length elems)
    is ARecordExpr (nm) (fields) (s) -> lin-stash-fields fields v 0 (list-length fields)
    is otherwise -> False

  lin-stash-list : List AExpr, Text, Integer, Integer -> Boolean
  lin-stash-list (elems) (v) (i) (len) =
   if i >= len then False
   else if lin-stash-elem (list-at elems i) v then True
   else lin-stash-list elems v (i + 1) len

  lin-stash-fields : List AFieldExpr, Text, Integer, Integer -> Boolean
  lin-stash-fields (fields) (v) (i) (len) =
   if i >= len then False
   else if lin-stash-elem (list-at fields i).value v then True
   else lin-stash-fields fields v (i + 1) len

  registered-fun-param-count : CodexType -> Integer
  registered-fun-param-count (ty) =
   when ty
    is FunTy (p) (row) (r) -> 1 + registered-fun-param-count r
    is ForAllTy (id) (body) -> registered-fun-param-count body
    is ForAllEff (id) (body) -> registered-fun-param-count body
    is otherwise -> 0

  lin-bind-partial : TypeEnv, AExpr -> Boolean
  lin-bind-partial (env) (e) =
   let head = apply-head-name e
   in if head == "" then False
   else let resolved = rename-lookup (env.chapter-renames) head
   in if env-has env resolved
    then (apply-arg-count e) < (registered-fun-param-count (env-lookup env resolved))
    else False

  lin-bind-retains : TypeEnv, ALetBind, Text, LinResult -> Boolean
  lin-bind-retains (env) (b) (v) (c) =
   when (b.value)
    is ALambdaExpr (ps) (bd) (s) -> lin-flags c
    is AApplyExpr (f) (a) (s) -> if lin-flags c then lin-bind-partial env (b.value) else False
    is AListExpr (elems) (s) -> lin-stash-elem (b.value) v
    is ARecordExpr (nm) (fields) (s) -> lin-stash-elem (b.value) v
    is otherwise -> False

  lin-let : TypeEnv, Text, Boolean, List ALetBind, AExpr, Integer, Integer -> LinResult
  lin-let (env) (v) (tail) (binds) (body) (i) (len) =
   if i >= len then lin-of env v tail body
   else let b = list-at binds i
   in if lin-bind-is-alias b v then lin-let-moved env v (b.name.value) tail binds body (i + 1) len
   else let here = lin-of env v False (b.value)
   in if lin-bind-retains env b v here then lin-let-retained env v (b.name.value) tail here binds body (i + 1) len
   else if (b.name.value) == v then here
   else lin-seq here (lin-let env v tail binds body (i + 1) len)

  lin-let-moved : TypeEnv, Text, Text, Boolean, List ALetBind, AExpr, Integer, Integer -> LinResult
  lin-let-moved (env) (v) (h) (tail) (binds) (body) (i) (len) =
   if h == v then lin-let env v tail binds body i len
   else lin-move-join (lin-let env h tail binds body i len) (lin-let env v False binds body i len)

  lin-let-retained : TypeEnv, Text, Text, Boolean, LinResult, List ALetBind, AExpr, Integer, Integer -> LinResult
  lin-let-retained (env) (v) (h) (tail) (c) (binds) (body) (i) (len) =
   if h == v then c
   else lin-retain-join c (lin-let env h tail binds body i len) (lin-let env v False binds body i len)

  lin-list : TypeEnv, Text, List AExpr, Integer, Integer -> LinResult
  lin-list (env) (v) (elems) (i) (len) =
   if i >= len then lin-zero
   else lin-seq (lin-of env v False (list-at elems i)) (lin-list env v elems (i + 1) len)

  lin-fields : TypeEnv, Text, List AFieldExpr, Integer, Integer -> LinResult
  lin-fields (env) (v) (fields) (i) (len) =
   if i >= len then lin-zero
   else lin-seq (lin-of env v False (list-at fields i).value) (lin-fields env v fields (i + 1) len)

  lin-stmts : TypeEnv, Text, List AActStmt, Integer, Integer -> LinResult
  lin-stmts (env) (v) (stmts) (i) (len) =
   if i >= len then lin-zero
   else when (list-at stmts i)
    is AActExprStmt (e) (s) -> lin-seq (lin-of env v False e) (lin-stmts env v stmts (i + 1) len)
    is AActBindStmt (n) (e) (s) -> if (n.value) == v then lin-of env v False e else lin-seq (lin-of env v False e) (lin-stmts env v stmts (i + 1) len)

  lin-arms : TypeEnv, Text, Boolean, List AMatchArm, Integer, Integer -> LinResult
  lin-arms (env) (v) (tail) (arms) (i) (len) =
   if i >= len then lin-zero
   else let arm = list-at arms i
   in let this = if apat-binds-name (arm.pattern) v then lin-zero
       else lin-seq (lin-of env v False (arm.guard)) (lin-of env v tail (arm.body))
   in if i + 1 >= len then this
   else lin-branch this (lin-arms env v tail arms (i + 1) len)

  clause-binds-name : AHandleClause, Text -> Boolean
  clause-binds-name (cl) (v) =
   if name-list-has (cl.params) v then True else (cl.resume-name.value) == v

  lin-clause-guard : LinResult -> LinResult
  lin-clause-guard (c) =
   if lin-flags c
    then LinResult { count = c.count, ok = c.ok, dead = c.dead, ret = False, esc = c.esc, cap = lin-esc-first (c.cap) "a handler clause" }
    else c

  lin-clauses : TypeEnv, Text, List AHandleClause, Integer, Integer -> LinResult
  lin-clauses (env) (v) (clauses) (i) (len) =
   if i >= len then lin-zero
   else let cl = list-at clauses i
   in let here = if clause-binds-name cl v then lin-zero else lin-clause-guard (lin-of env v False (cl.body))
   in lin-seq here (lin-clauses env v clauses (i + 1) len)

  apply-arg-count : AExpr -> Integer
  apply-arg-count (e) =
   when e
    is AApplyExpr (f) (a) (s) -> 1 + apply-arg-count f
    is otherwise -> 0

  apply-head-name : AExpr -> Text
  apply-head-name (e) =
   when e
    is AApplyExpr (f) (a) (s) -> apply-head-name f
    is ANameExpr (n) (s) -> n.value
    is otherwise -> ""

  arg-is-bare : Text, AExpr -> Boolean
  arg-is-bare (v) (a) =
   when a
    is ANameExpr (n) (s) -> n.value == v
    is otherwise -> False

  spine-has-bare : Text, AExpr -> Boolean
  spine-has-bare (v) (e) =
   when e
    is AApplyExpr (f) (a) (s) -> if arg-is-bare v a then True else spine-has-bare v f
    is otherwise -> False

  peel-returns-n : CodexType, Integer -> CodexType
  peel-returns-n (ty) (n) =
   if n <= 0 then ty
   else when ty
    is EffectfulTy (effs) (labels) (inner) -> peel-returns-n inner n
    is otherwise -> peel-returns-n (peel-fun-return ty) (n - 1)

  type-mentions-mut : TypeEnv, CodexType, Text, Integer -> Boolean
  type-mentions-mut (env) (ty) (target) (fuel) =
   if fuel <= 0 then False
   else when ty
    is RecordTy (n) (args) (fields) ->
     if (n.value) == target then True
     else if type-list-mentions-mut env args target (fuel - 1) then True
     else fields-mention-mut env fields target (fuel - 1)
    is ConstructedTy (n) (args) ->
     if (n.value) == target then True
     else if type-list-mentions-mut env args target (fuel - 1) then True
     else type-mentions-mut env (resolve-constructed-to-record env (n.value)) target (fuel - 1)
    is FunTy (p) (row) (r) -> type-mentions-mut env r target (fuel - 1)
    is ForAllTy (id) (body) -> type-mentions-mut env body target (fuel - 1)
    is ForAllEff (id) (body) -> type-mentions-mut env body target (fuel - 1)
    is EffectfulTy (effs) (labels) (inner) -> type-mentions-mut env inner target (fuel - 1)
    is LinearTy (linner) -> type-mentions-mut env linner target (fuel - 1)
    is otherwise -> False

  type-list-mentions-mut : TypeEnv, List CodexType, Text, Integer -> Boolean
  type-list-mentions-mut (env) (xs) (target) (fuel) =
   type-list-mentions-mut-at env xs target fuel 0 (list-length xs)

  type-list-mentions-mut-at : TypeEnv, List CodexType, Text, Integer, Integer, Integer -> Boolean
  type-list-mentions-mut-at (env) (xs) (target) (fuel) (i) (len) =
   if i >= len then False
   else if type-mentions-mut env (list-at xs i) target fuel then True
   else type-list-mentions-mut-at env xs target fuel (i + 1) len

  fields-mention-mut : TypeEnv, List RecordField, Text, Integer -> Boolean
  fields-mention-mut (env) (fields) (target) (fuel) =
   fields-mention-mut-at env fields target fuel 0 (list-length fields)

  fields-mention-mut-at : TypeEnv, List RecordField, Text, Integer, Integer, Integer -> Boolean
  fields-mention-mut-at (env) (fields) (target) (fuel) (i) (len) =
   if i >= len then False
   else if type-mentions-mut env ((list-at fields i).type-val) target fuel then True
   else fields-mention-mut-at env fields target fuel (i + 1) len

  return-mentions-mut : TypeEnv, CodexType, Text, Integer -> Boolean
  return-mentions-mut (env) (ty) (target) (fuel) =
   if fuel <= 0 then False
   else when ty
    is ListTy (elem) -> return-mentions-mut env elem target (fuel - 1)
    is LinkedListTy (elem) -> return-mentions-mut env elem target (fuel - 1)
    is SumTy (n) (args) (ctors) -> type-list-mentions-mut env args target (fuel - 1)
    is FunTy (p) (row) (r) -> return-mentions-mut env r target (fuel - 1)
    is ForAllTy (id) (body) -> return-mentions-mut env body target (fuel - 1)
    is ForAllEff (id) (body) -> return-mentions-mut env body target (fuel - 1)
    is EffectfulTy (effs) (labels) (inner) -> return-mentions-mut env inner target (fuel - 1)
    is LinearTy (linner) -> return-mentions-mut env linner target (fuel - 1)
    is otherwise -> type-mentions-mut env ty target fuel

  apply-threads : TypeEnv, Text, AExpr -> Boolean
  apply-threads (env) (target) (e) =
   let h = apply-head-name e
   in if h == "" then False
   else let resolved = rename-lookup (env.chapter-renames) h
   in if env-has env resolved
    then return-mentions-mut env (peel-returns-n (env-lookup env resolved) (apply-arg-count e)) target 8
    else False

  consume-read : TypeEnv, Text, Text, AExpr -> LinResult
  consume-read (env) (target) (v) (obj) =
   when obj
    is ANameExpr (n) (s) -> lin-zero
    is otherwise -> consume-of env target v obj

  consume-of : TypeEnv, Text, Text, AExpr -> LinResult
  consume-of (env) (target) (v) (e) =
   when e
    is ANameExpr (n) (s) -> if n.value == v then lin-one else lin-zero
    is AFieldAccess (obj) (f) (s) -> consume-read env target v obj
    is AApplyExpr (f) (a) (s) ->
     let threads = if spine-has-bare v e then apply-threads env target e else False
     in consume-spine env target v threads e
    is ABinaryExpr (l) (op) (r) (s) -> lin-seq (consume-of env target v l) (consume-of env target v r)
    is AUnaryExpr (x) (s) -> consume-of env target v x
    is AIfExpr (c) (t) (el) (s) -> lin-seq (consume-of env target v c) (lin-path-max (consume-of env target v t) (consume-of env target v el))
    is ALetExpr (binds) (body) (s) -> consume-let env target v binds body 0 (list-length binds)
    is ALambdaExpr (params) (body) (s) -> if name-list-has params v then lin-zero else consume-of env target v body
    is AHandleExpr (eff) (body) (clauses) (s) -> lin-seq (consume-of env target v body) (consume-clauses env target v clauses 0 (list-length clauses))
    is AWithTimeoutExpr (t) (effs) (scopes) (body) (s) -> consume-of env target v body
    is AMatchExpr (scrut) (arms) (s) -> lin-seq (consume-of env target v scrut) (consume-arms env target v arms 0 (list-length arms))
    is AListExpr (elems) (s) -> consume-list env target v elems 0 (list-length elems)
    is ARecordExpr (n) (fields) (s) -> consume-fields env target v fields 0 (list-length fields)
    is AActExpr (stmts) (s) -> consume-stmts env target v stmts 0 (list-length stmts)
    is ATryExpr (max) (body) (fb) (fail) (s) -> lin-seq (consume-stmts env target v body 0 (list-length body)) (lin-path-max (consume-stmts env target v fb 0 (list-length fb)) (consume-stmts env target v fail 0 (list-length fail)))
    is AFieldAssignExpr (rec) (f) (val) (s) -> lin-seq (consume-read env target v rec) (consume-of env target v val)
    is ALazyExpr (inner) (s) -> consume-of env target v inner
    is otherwise -> lin-zero

  consume-spine : TypeEnv, Text, Text, Boolean, AExpr -> LinResult
  consume-spine (env) (target) (v) (threads) (e) =
   when e
    is AApplyExpr (f) (a) (s) -> lin-seq (consume-spine env target v threads f) (consume-arg env target v threads a)
    is otherwise -> consume-of env target v e

  consume-arg : TypeEnv, Text, Text, Boolean, AExpr -> LinResult
  consume-arg (env) (target) (v) (threads) (a) =
   when a
    is ANameExpr (n) (s) -> if (n.value == v) then (if threads then lin-one else lin-zero) else lin-zero
    is otherwise -> consume-of env target v a

  consume-let : TypeEnv, Text, Text, List ALetBind, AExpr, Integer, Integer -> LinResult
  consume-let (env) (target) (v) (binds) (body) (i) (len) =
   if i >= len then consume-of env target v body
   else let b = list-at binds i
   in if lin-bind-is-alias b v then consume-let-moved env target v (b.name.value) binds body (i + 1) len
   else let here = consume-of env target v (b.value)
   in if (b.name.value) == v then here
   else lin-seq here (consume-let env target v binds body (i + 1) len)

  consume-let-moved : TypeEnv, Text, Text, Text, List ALetBind, AExpr, Integer, Integer -> LinResult
  consume-let-moved (env) (target) (v) (h) (binds) (body) (i) (len) =
   if h == v then consume-let env target v binds body i len
   else lin-move-join (consume-let env target h binds body i len) (lin-let env v False binds body i len)

  consume-list : TypeEnv, Text, Text, List AExpr, Integer, Integer -> LinResult
  consume-list (env) (target) (v) (elems) (i) (len) =
   if i >= len then lin-zero
   else lin-seq (consume-of env target v (list-at elems i)) (consume-list env target v elems (i + 1) len)

  consume-fields : TypeEnv, Text, Text, List AFieldExpr, Integer, Integer -> LinResult
  consume-fields (env) (target) (v) (fields) (i) (len) =
   if i >= len then lin-zero
   else lin-seq (consume-of env target v (list-at fields i).value) (consume-fields env target v fields (i + 1) len)

  consume-stmts : TypeEnv, Text, Text, List AActStmt, Integer, Integer -> LinResult
  consume-stmts (env) (target) (v) (stmts) (i) (len) =
   if i >= len then lin-zero
   else when (list-at stmts i)
    is AActExprStmt (e) (s) -> lin-seq (consume-of env target v e) (consume-stmts env target v stmts (i + 1) len)
    is AActBindStmt (n) (e) (s) -> if (n.value) == v then consume-of env target v e else lin-seq (consume-of env target v e) (consume-stmts env target v stmts (i + 1) len)

  consume-arms : TypeEnv, Text, Text, List AMatchArm, Integer, Integer -> LinResult
  consume-arms (env) (target) (v) (arms) (i) (len) =
   if i >= len then lin-zero
   else let arm = list-at arms i
   in let this = if apat-binds-name (arm.pattern) v then lin-zero
       else lin-seq (consume-of env target v (arm.guard)) (consume-of env target v (arm.body))
   in if i + 1 >= len then this
   else lin-path-max this (consume-arms env target v arms (i + 1) len)

  consume-clauses : TypeEnv, Text, Text, List AHandleClause, Integer, Integer -> LinResult
  consume-clauses (env) (target) (v) (clauses) (i) (len) =
   if i >= len then lin-zero
   else let cl = list-at clauses i
   in let here = if clause-binds-name cl v then lin-zero else consume-of env target v (cl.body)
   in lin-seq here (consume-clauses env target v clauses (i + 1) len)

  atype-core-name : ATypeExpr -> Text
  atype-core-name (t) =
   when t
    is ALinearType (inner) (s) -> atype-core-name inner
    is ANamedType (n) (s) -> n.value
    is AAppType (head) (args) (s) -> atype-core-name head
    is otherwise -> ""

  check-linearity-def : ADef, TypeEnv, UnificationState -> UnificationState
  check-linearity-def (def) (env) (st) =
   if list-length (def.declared-type) == 0 then st
   else let st2 = check-linear-params def env (def.params) (list-at (def.declared-type) 0) 0 st
   in check-mints def env True (def.body) st2

 A range on a base that cannot carry one resolves to ErrorTy, and ErrorTy
 unifies with everything, so without this walk the declaration compiles and
 the bound is silently ignored. lint-narrowing-check cannot catch it either:
 it opens on IntegerTy and falls through for anything else, so an ErrorTy
 parameter is not merely unbounded, it is unchecked.

  check-bounded-bases-def : ADef, List TypeBinding, UnificationState -> UnificationState
  check-bounded-bases-def (def) (tdm) (st) =
   if list-length (def.declared-type) == 0 then st
   else check-bounded-bases (list-at (def.declared-type) 0) def tdm st

  check-bounded-bases : ATypeExpr, ADef, List TypeBinding, UnificationState -> UnificationState
  check-bounded-bases (t) (def) (tdm) (st) =
   when t
    is AFunType (pty) (rty) (s) -> check-bounded-bases rty def tdm (check-bounded-bases pty def tdm st)
    is ALinearType (inner) (s) -> check-bounded-bases inner def tdm st
    is AEffectType (effs) (scopes) (tail) (ret) (s) -> check-bounded-bases ret def tdm st
    is AAppType (head) (args) (s) -> check-bounded-bases-args args def tdm 0 st
    is ABoundedIntType (base) (lo) (hi) (mode) (s) ->
     when resolve-bounded-int-type tdm base lo hi mode
      is ErrorTy -> add-unify-error st cdx-bounded-base-not-integer ("In '" & (def.name.value) & "', a range was written on '" & atype-core-name base & "', which cannot carry one. Only an integer base, or a unit wrapping one, can be bounded; on anything else the range is silently ignored") s
      is otherwise -> st
    is otherwise -> st

  check-bounded-bases-args : List ATypeExpr, ADef, List TypeBinding, Integer, UnificationState -> UnificationState
  check-bounded-bases-args (args) (def) (tdm) (i) (st) =
   if i >= list-length args then st
   else check-bounded-bases-args args def tdm (i + 1) (check-bounded-bases (list-at args i) def tdm st)
  check-linear-params : ADef, TypeEnv, List AParam, ATypeExpr, Integer, UnificationState -> UnificationState
  check-linear-params (def) (env) (params) (dt) (i) (st) =
   if i >= list-length params then st
   else when dt
    is AFunType (pty) (rty) (s) ->
     let st2 = check-one-param def env pty (list-at params i) st
     in check-linear-params def env params rty (i + 1) st2
    is otherwise -> st

  check-one-param : ADef, TypeEnv, ATypeExpr, AParam, UnificationState -> UnificationState
  check-one-param (def) (env) (pty) (p) (st) =
   let tn = rename-lookup (env.chapter-renames) (atype-core-name pty)
   in if env-has env ("__mutable-" & tn) then check-one-mutable-param def env tn p st
   else if is-linear-atype pty then check-one-linear-param def env p st
   else st

  check-one-mutable-param : ADef, TypeEnv, Text, AParam, UnificationState -> UnificationState
  check-one-mutable-param (def) (env) (tn) (p) (st) =
   let r = consume-of env tn (p.name.value) (def.body)
   in if (r.dead) > 0
    then add-unify-error st cdx-mutable-alias ("In '" & (def.name.value) & "', mutable record '" & (p.name.value) & "' was moved to a new owner by a let binding and then mentioned again; after a move the original name is dead") (p.span)
    else if (r.count) > 1
    then add-unify-error st cdx-mutable-alias ("In '" & (def.name.value) & "', mutable record '" & (p.name.value) & "' is consumed " & integer-to-text (r.count) & " times on a single path; a mutable record may be handed to a new owner at most once") (p.span)
    else st

  afun-return-after : ATypeExpr, Integer -> ATypeExpr
  afun-return-after (dt) (k) =
   if k <= 0 then dt
   else when dt
    is AFunType (pty) (rty) (s) -> afun-return-after rty (k - 1)
    is otherwise -> dt

  is-freeze-door : ADef -> Boolean
  is-freeze-door (def) =
   if (def.name.value) == "freeze"
    then when (def.body)
     is ANameExpr (n) (s) -> True
     is otherwise -> False
    else False

  atype-strip-effect : ATypeExpr -> ATypeExpr
  atype-strip-effect (t) =
   when t
    is AEffectType (effs) (scopes) (tl) (ret) (s) -> ret
    is otherwise -> t

  atype-app-arg-list : ATypeExpr -> List ATypeExpr
  atype-app-arg-list (t) =
   when t
    is AAppType (head) (args) (s) -> atype-app-arg-list head & args
    is otherwise -> []

  atypes-any-linear : List ATypeExpr, Integer, Integer -> Boolean
  atypes-any-linear (ts) (i) (len) =
   if i >= len then False
   else if is-linear-atype (list-at ts i) then True
   else atypes-any-linear ts (i + 1) len

  atype-tuple-has-linear : ATypeExpr -> Boolean
  atype-tuple-has-linear (t) =
   let args = atype-app-arg-list t
   in if list-length args == 0 then False
   else if atype-core-name t == ("Tup" & integer-to-text (list-length args)) then atypes-any-linear args 0 (list-length args)
   else False

  linear-return-sanctioned : ADef -> Boolean
  linear-return-sanctioned (def) =
   if list-length (def.declared-type) == 0 then False
   else if is-freeze-door def then True
   else let rt = atype-strip-effect (afun-return-after (list-at (def.declared-type) 0) (list-length (def.params)))
   in if is-linear-atype rt then True else atype-tuple-has-linear rt

  check-one-linear-param : ADef, TypeEnv, AParam, UnificationState -> UnificationState
  check-one-linear-param (def) (env) (p) (st) =
   let r = lin-of env (p.name.value) True (def.body)
   in let bad-ret = if r.ret then (if linear-return-sanctioned def then False else True) else False
   in if (r.dead) > 0
    then add-unify-error st cdx-use-after-consume ("Linear value '" & (p.name.value) & "' was moved to a new owner by a let binding and then mentioned again; after a move the original name is dead") (p.span)
    else if (r.cap) /= ""
    then add-unify-error st cdx-linear-capture ("Linear value '" & (p.name.value) & "' is captured by " & (r.cap) & ", which may run zero or many times; a linear value may be captured only by a let-bound closure, which is then called exactly once") (p.span)
    else if (r.esc) /= ""
    then add-unify-error st cdx-linear-escape ("Linear value '" & (p.name.value) & "' is passed to a plain (non-linear) parameter of '" & (r.esc) & "'; a linear value moves only through parameters declared linear. Use freeze to exit the discipline deliberately") (p.span)
    else if bad-ret
    then add-unify-error st cdx-linear-return ("Linear value '" & (p.name.value) & "' is returned from '" & (def.name.value) & "', whose return type is not declared linear; that is an unsanctioned freeze. Declare the return linear, or consume the value with freeze") (p.span)
    else if r.ok == False
    then add-unify-error st cdx-use-after-consume ("Linear value '" & (p.name.value) & "' is used a different number of times across branches; each branch must use it exactly once") (p.span)
    else if r.count > 1
    then add-unify-error st cdx-use-after-consume ("Linear value '" & (p.name.value) & "' is used " & integer-to-text (r.count) & " times; a linear value must be used exactly once") (p.span)
    else if r.count == 0
    then add-unify-error st cdx-linear-unused ("Linear value '" & (p.name.value) & "' is never used; a linear value must be used exactly once") (p.span)
    else st

Section: Minted Linear Owners

  return-is-linear-after : CodexType, Integer -> Boolean
  return-is-linear-after (ty) (k) =
   when ty
    is ForAllTy (id) (body) -> return-is-linear-after body k
    is ForAllEff (id) (body) -> return-is-linear-after body k
    is FunTy (p) (row) (r) -> if k <= 0 then False else return-is-linear-after r (k - 1)
    is EffectfulTy (effs) (sc) (ret) -> if k == 0 then return-is-linear-after ret 0 else False
    is LinearTy (inner) -> k == 0
    is otherwise -> False

  expr-is-mint : TypeEnv, AExpr -> Boolean
  expr-is-mint (env) (e) =
   when e
    is AApplyExpr (f) (a) (s) ->
     let head = apply-head-name e
     in if head == "" then False
     else let resolved = rename-lookup (env.chapter-renames) head
     in if env-has env resolved then return-is-linear-after (env-lookup env resolved) (apply-arg-count e)
     else False
    is otherwise -> False

Section: Linear Tuple Components

  return-type-after : CodexType, Integer -> CodexType
  return-type-after (ty) (k) =
   when ty
    is ForAllTy (id) (body) -> return-type-after body k
    is ForAllEff (id) (body) -> return-type-after body k
    is FunTy (p) (row) (r) -> if k <= 0 then ErrorTy else return-type-after r (k - 1)
    is EffectfulTy (effs) (sc) (ret) -> if k == 0 then return-type-after ret 0 else ErrorTy
    is otherwise -> if k == 0 then ty else ErrorTy

  linear-arg-positions : List CodexType, Integer, Integer, List Integer -> List Integer
  linear-arg-positions (args) (i) (len) (acc) =
   if i >= len then acc
   else linear-arg-positions args (i + 1) len (if param-is-linear (list-at args i) then list-push acc i else acc)

  tuple-args-linear-positions : Text, List CodexType -> List Integer
  tuple-args-linear-positions (n) (args) =
   if n == ("Tup" & integer-to-text (list-length args)) then linear-arg-positions args 0 (list-length args) []
   else []

  tuple-linear-positions : CodexType -> List Integer
  tuple-linear-positions (ty) =
   when ty
    is ConstructedTy (n) (args) -> tuple-args-linear-positions (n.value) args
    is SumTy (n) (args) (ctors) -> tuple-args-linear-positions (n.value) args
    is otherwise -> []

  is-tuple-mint-type : CodexType -> Boolean
  is-tuple-mint-type (ty) = list-length (tuple-linear-positions ty) > 0

  tuple-mint-only : CodexType -> CodexType
  tuple-mint-only (ty) = if is-tuple-mint-type ty then ty else ErrorTy

  tuple-mint-key : Text -> Text
  tuple-mint-key (v) = "__tupmint-" & v

  expr-tuple-mint-type : TypeEnv, AExpr -> CodexType
  expr-tuple-mint-type (env) (e) =
   when e
    is AApplyExpr (f) (a) (s) ->
     let head = apply-head-name e
     in if head == "" then ErrorTy
     else let resolved = rename-lookup (env.chapter-renames) head
     in if env-has env resolved then tuple-mint-only (return-type-after (env-lookup env resolved) (apply-arg-count e))
     else ErrorTy
    is ANameExpr (n) (s) -> if env-has env (tuple-mint-key (n.value)) then env-lookup env (tuple-mint-key (n.value)) else ErrorTy
    is otherwise -> ErrorTy

  env-after-tuple-bind : TypeEnv, Text, CodexType -> TypeEnv
  env-after-tuple-bind (env) (v) (tt) =
   if is-tuple-mint-type tt then env-bind-local env (tuple-mint-key v) tt
   else if env-has env (tuple-mint-key v) then env-bind-local env (tuple-mint-key v) ErrorTy
   else env

  check-tuple-components : ADef, TypeEnv, Boolean, List Integer, List APat, AExpr, Integer, UnificationState -> UnificationState
  check-tuple-components (def) (env) (tail) (positions) (subs) (body) (j) (st) =
   if j >= list-length positions then st
   else let pos = list-at positions j
   in let st2 = if pos >= list-length subs then st else check-tuple-component def env tail (list-at subs pos) pos body st
   in check-tuple-components def env tail positions subs body (j + 1) st2

  check-tuple-component : ADef, TypeEnv, Boolean, APat, Integer, AExpr, UnificationState -> UnificationState
  check-tuple-component (def) (env) (tail) (sub) (pos) (body) (st) =
   when sub
    is AVarPat (n) (s) -> report-minted-owner def (n.value) s (lin-of env (n.value) tail body) st
    is AWildPat (s) -> add-unify-error st cdx-linear-unused ("Linear component " & integer-to-text pos & " of a tuple is discarded by a wildcard pattern; bind it and use it exactly once") s
    is otherwise -> st

  check-tuple-arm : ADef, TypeEnv, Boolean, CodexType, AMatchArm, UnificationState -> UnificationState
  check-tuple-arm (def) (env) (tail) (tt) (arm) (st) =
   when (arm.pattern)
    is ACtorPat (n) (subs) (s) -> check-mints def env tail (arm.body) (check-tuple-components def env tail (tuple-linear-positions tt) subs (arm.body) 0 st)
    is AVarPat (n) (s) -> check-mints def (env-bind-local env (tuple-mint-key (n.value)) tt) tail (arm.body) (report-minted-owner def (n.value) s (lin-of env (n.value) tail (arm.body)) st)
    is AWildPat (s) -> check-mints def env tail (arm.body) (add-unify-error st cdx-linear-unused "A tuple carrying a linear component is discarded by a wildcard pattern; bind each linear component and use it exactly once" s)
    is otherwise -> check-mints def env tail (arm.body) st

  mutable-name-of : TypeEnv, Name -> Text
  mutable-name-of (env) (n) =
   if env-has env ("__mutable-" & (n.value)) then n.value
   else let rn = rename-lookup (env.chapter-renames) (n.value)
   in if env-has env ("__mutable-" & rn) then rn else ""

  return-mutable-name-after : TypeEnv, CodexType, Integer -> Text
  return-mutable-name-after (env) (ty) (k) =
   when ty
    is ForAllTy (id) (body) -> return-mutable-name-after env body k
    is ForAllEff (id) (body) -> return-mutable-name-after env body k
    is FunTy (p) (row) (r) -> if k <= 0 then "" else return-mutable-name-after env r (k - 1)
    is EffectfulTy (effs) (sc) (ret) -> if k == 0 then return-mutable-name-after env ret 0 else ""
    is RecordTy (n) (args) (fields) -> if k == 0 then mutable-name-of env n else ""
    is ConstructedTy (n) (args) -> if k == 0 then mutable-name-of env n else ""
    is otherwise -> ""

  expr-mut-mint-name : TypeEnv, AExpr -> Text
  expr-mut-mint-name (env) (e) =
   when e
    is AApplyExpr (f) (a) (s) ->
     let head = apply-head-name e
     in if head == "" then ""
     else let resolved = rename-lookup (env.chapter-renames) head
     in if env-has env resolved then return-mutable-name-after env (env-lookup env resolved) (apply-arg-count e)
     else ""
    is ANameExpr (n) (s) ->
     let resolved = rename-lookup (env.chapter-renames) (n.value)
     in if env-has env resolved then return-mutable-name-after env (env-lookup env resolved) 0
     else ""
    is otherwise -> ""

  report-minted-mutable : ADef, Text, SourceSpan, LinResult, UnificationState -> UnificationState
  report-minted-mutable (def) (v) (sp) (r) (st) =
   if (r.dead) > 0
    then add-unify-error st cdx-mutable-alias ("In '" & (def.name.value) & "', mutable record '" & v & "', minted by a call, was moved to a new owner by a let binding and then mentioned again; after a move the original name is dead") sp
    else if (r.count) > 1
    then add-unify-error st cdx-mutable-alias ("In '" & (def.name.value) & "', mutable record '" & v & "', minted by a call, is consumed " & integer-to-text (r.count) & " times on a single path; a mutable record may be handed to a new owner at most once") sp
    else st

  report-minted-owner : ADef, Text, SourceSpan, LinResult, UnificationState -> UnificationState
  report-minted-owner (def) (v) (sp) (r) (st) =
   let bad-ret = if r.ret then (if linear-return-sanctioned def then False else True) else False
   in if (r.dead) > 0
    then add-unify-error st cdx-use-after-consume ("Linear value '" & v & "', minted by a linear-returning call, was moved to a new owner by a let binding and then mentioned again; after a move the original name is dead") sp
    else if (r.cap) /= ""
    then add-unify-error st cdx-linear-capture ("Linear value '" & v & "', minted by a linear-returning call, is captured by " & (r.cap) & ", which may run zero or many times; a linear value may be captured only by a let-bound closure, which is then called exactly once") sp
    else if (r.esc) /= ""
    then add-unify-error st cdx-linear-escape ("Linear value '" & v & "', minted by a linear-returning call, is passed to a plain (non-linear) parameter of '" & (r.esc) & "'; a linear value moves only through parameters declared linear. Use freeze to exit the discipline deliberately") sp
    else if bad-ret
    then add-unify-error st cdx-linear-return ("Linear value '" & v & "', minted by a linear-returning call, is returned from '" & (def.name.value) & "', whose return type is not declared linear; declare the return linear, or consume the value with freeze") sp
    else if r.ok == False
    then add-unify-error st cdx-use-after-consume ("Linear value '" & v & "', minted by a linear-returning call, is used a different number of times across branches; each branch must use it exactly once") sp
    else if r.count > 1
    then add-unify-error st cdx-use-after-consume ("Linear value '" & v & "', minted by a linear-returning call, is used " & integer-to-text (r.count) & " times; a linear value must be used exactly once") sp
    else if r.count == 0
    then add-unify-error st cdx-linear-unused ("Linear value '" & v & "', minted by a linear-returning call, is never used; a linear value must be used exactly once") sp
    else st

  check-mints : ADef, TypeEnv, Boolean, AExpr, UnificationState -> UnificationState
  check-mints (def) (env) (tail) (e) (st) =
   when e
    is ALetExpr (binds) (body) (s) -> check-mints-binds def env tail binds body 0 (list-length binds) st
    is AIfExpr (c) (t) (el) (s) -> check-mints def env tail el (check-mints def env tail t (check-mints def env False c st))
    is AApplyExpr (f) (a) (s) -> check-mints def env False a (check-mints def env False f st)
    is ABinaryExpr (l) (op) (r) (s) -> check-mints def env False r (check-mints def env False l st)
    is AUnaryExpr (x) (s) -> check-mints def env False x st
    is ALambdaExpr (params) (body) (s) -> check-mints def env False body st
    is AHandleExpr (eff) (body) (clauses) (s) -> check-mints-clauses def env clauses 0 (list-length clauses) (check-mints def env False body st)
    is AWithTimeoutExpr (t) (effs) (scopes) (body) (s) -> check-mints def env tail body st
    is AMatchExpr (scrut) (arms) (s) -> check-mints-arms def env tail (expr-tuple-mint-type env scrut) arms 0 (list-length arms) (check-mints def env False scrut st)
    is AListExpr (elems) (s) -> check-mints-list def env elems 0 (list-length elems) st
    is ARecordExpr (n) (fields) (s) -> check-mints-fields def env fields 0 (list-length fields) st
    is AFieldAccess (obj) (f) (s) -> check-mints def env False obj st
    is AActExpr (stmts) (s) -> check-mints-stmts def env stmts 0 (list-length stmts) st
    is ATryExpr (max) (body) (fb) (fail) (s) -> check-mints-stmts def env fail 0 (list-length fail) (check-mints-stmts def env fb 0 (list-length fb) (check-mints-stmts def env body 0 (list-length body) st))
    is AFieldAssignExpr (rec) (f) (val) (s) -> check-mints def env False val (check-mints def env False rec st)
    is ALazyExpr (inner) (s) -> check-mints def env False inner st
    is otherwise -> st

  check-mints-binds : ADef, TypeEnv, Boolean, List ALetBind, AExpr, Integer, Integer, UnificationState -> UnificationState
  check-mints-binds (def) (env) (tail) (binds) (body) (i) (len) (st) =
   if i >= len then check-mints def env tail body st
   else let b = list-at binds i
   in let st1 = check-mints def env False (b.value) st
   in let tt = expr-tuple-mint-type env (b.value)
   in let st2 = if expr-is-mint env (b.value)
       then report-minted-owner def (b.name.value) (b.span) (lin-let env (b.name.value) tail binds body (i + 1) len) st1
       else if is-tuple-mint-type tt
       then report-minted-owner def (b.name.value) (b.span) (lin-let env (b.name.value) tail binds body (i + 1) len) st1
       else let mtn = expr-mut-mint-name env (b.value)
       in if mtn /= ""
          then report-minted-mutable def (b.name.value) (b.span) (consume-let env mtn (b.name.value) binds body (i + 1) len) st1
          else st1
   in check-mints-binds def (env-after-tuple-bind env (b.name.value) tt) tail binds body (i + 1) len st2

  check-mints-stmts : ADef, TypeEnv, List AActStmt, Integer, Integer, UnificationState -> UnificationState
  check-mints-stmts (def) (env) (stmts) (i) (len) (st) =
   if i >= len then st
   else when (list-at stmts i)
    is AActExprStmt (e) (s) -> check-mints-stmts def env stmts (i + 1) len (check-mints def env False e st)
    is AActBindStmt (n) (e) (s) ->
     let st1 = check-mints def env False e st
     in let tt = expr-tuple-mint-type env e
     in let st2 = if expr-is-mint env e
         then report-minted-owner def (n.value) s (lin-stmts env (n.value) stmts (i + 1) len) st1
         else if is-tuple-mint-type tt
         then report-minted-owner def (n.value) s (lin-stmts env (n.value) stmts (i + 1) len) st1
         else let mtn = expr-mut-mint-name env e
         in if mtn /= ""
            then report-minted-mutable def (n.value) s (consume-stmts env mtn (n.value) stmts (i + 1) len) st1
            else st1
     in check-mints-stmts def (env-after-tuple-bind env (n.value) tt) stmts (i + 1) len st2

  check-mints-arms : ADef, TypeEnv, Boolean, CodexType, List AMatchArm, Integer, Integer, UnificationState -> UnificationState
  check-mints-arms (def) (env) (tail) (tt) (arms) (i) (len) (st) =
   if i >= len then st
   else let arm = list-at arms i
   in let st1 = check-mints def env False (arm.guard) st
   in let st2 = if is-tuple-mint-type tt then check-tuple-arm def env tail tt arm st1 else check-mints def env tail (arm.body) st1
   in check-mints-arms def env tail tt arms (i + 1) len st2

  check-mints-clauses : ADef, TypeEnv, List AHandleClause, Integer, Integer, UnificationState -> UnificationState
  check-mints-clauses (def) (env) (clauses) (i) (len) (st) =
   if i >= len then st
   else check-mints-clauses def env clauses (i + 1) len (check-mints def env False (list-at clauses i).body st)

  check-mints-list : ADef, TypeEnv, List AExpr, Integer, Integer, UnificationState -> UnificationState
  check-mints-list (def) (env) (elems) (i) (len) (st) =
   if i >= len then st
   else check-mints-list def env elems (i + 1) len (check-mints def env False (list-at elems i) st)

  check-mints-fields : ADef, TypeEnv, List AFieldExpr, Integer, Integer, UnificationState -> UnificationState
  check-mints-fields (def) (env) (fields) (i) (len) (st) =
   if i >= len then st
   else check-mints-fields def env fields (i + 1) len (check-mints def env False (list-at fields i).value st)

Section: Stale Read After In-Place Update

  MutatorEntry = record {
   me-fn : Text,
   me-param : Integer,
   me-field : Text
  }

  ConsumedVar = record {
   cv-name : Text,
   cv-field : Text
  }

  apply-nth-arg-r : AExpr, Integer -> AExpr
  apply-nth-arg-r (e) (n) =
   when e
    is AApplyExpr (f) (a) (s) -> if n == 0 then a else apply-nth-arg-r f (n - 1)
    is otherwise -> e

  apply-arg-left : AExpr, Integer, Integer -> AExpr
  apply-arg-left (e) (k) (total) = apply-nth-arg-r e (total - 1 - k)

  bare-name-value : AExpr -> Text
  bare-name-value (e) =
   when e
    is ANameExpr (n) (s) -> n.value
    is otherwise -> ""

  text-lit-value : AExpr -> Text
  text-lit-value (e) =
   when e
    is ALitExpr (t) (k) (s) -> t
    is otherwise -> ""

  rs-here : Text, AExpr, List Text -> List Text
  rs-here (pn) (e) (acc) =
   if (apply-head-name e) == "__record-set" then rs-here2 pn e acc else acc

  rs-here2 : Text, AExpr, List Text -> List Text
  rs-here2 (pn) (e) (acc) =
   if (apply-arg-count e) >= 3 then rs-here3 pn e acc else acc

  rs-here3 : Text, AExpr, List Text -> List Text
  rs-here3 (pn) (e) (acc) =
   if (bare-name-value (apply-arg-left e 0 (apply-arg-count e))) == pn
   then list-push acc (text-lit-value (apply-arg-left e 1 (apply-arg-count e)))
   else acc

  rs-fields-on : Text, AExpr, List Text -> List Text
  rs-fields-on (pn) (e) (acc) =
   when e
    is AApplyExpr (f) (a) (s) -> rs-fields-on pn a (rs-fields-on pn f (rs-here pn e acc))
    is ABinaryExpr (l) (op) (r) (s) -> rs-fields-on pn r (rs-fields-on pn l acc)
    is AUnaryExpr (x) (s) -> rs-fields-on pn x acc
    is AIfExpr (c) (t) (el) (s) -> rs-fields-on pn el (rs-fields-on pn t (rs-fields-on pn c acc))
    is ALetExpr (binds) (body) (s) -> rs-fields-on pn body (rs-fields-binds pn binds 0 (list-length binds) acc)
    is ALambdaExpr (ps) (body) (s) -> rs-fields-on pn body acc
    is AMatchExpr (scrut) (arms) (s) -> rs-fields-arms pn arms 0 (list-length arms) (rs-fields-on pn scrut acc)
    is AListExpr (elems) (s) -> rs-fields-list pn elems 0 (list-length elems) acc
    is ARecordExpr (n) (fields) (s) -> rs-fields-fexprs pn fields 0 (list-length fields) acc
    is AFieldAccess (obj) (fld) (s) -> rs-fields-on pn obj acc
    is AActExpr (stmts) (s) -> rs-fields-stmts pn stmts 0 (list-length stmts) acc
    is AHandleExpr (eff) (body) (cls) (s) -> rs-fields-on pn body acc
    is AWithTimeoutExpr (t) (effs) (scopes) (body) (s) -> rs-fields-on pn body acc
    is ATryExpr (mx) (b) (fb) (fl) (s) -> rs-fields-stmts pn b 0 (list-length b) (rs-fields-stmts pn fb 0 (list-length fb) (rs-fields-stmts pn fl 0 (list-length fl) acc))
    is AFieldAssignExpr (rec) (fld) (val) (s) -> rs-fields-on pn val (rs-fields-on pn rec acc)
    is ALazyExpr (inner) (s) -> rs-fields-on pn inner acc
    is otherwise -> acc

  rs-fields-binds : Text, List ALetBind, Integer, Integer, List Text -> List Text
  rs-fields-binds (pn) (binds) (i) (len) (acc) =
   if i >= len then acc
   else rs-fields-binds pn binds (i + 1) len (rs-fields-on pn (list-at binds i).value acc)

  rs-fields-list : Text, List AExpr, Integer, Integer, List Text -> List Text
  rs-fields-list (pn) (elems) (i) (len) (acc) =
   if i >= len then acc
   else rs-fields-list pn elems (i + 1) len (rs-fields-on pn (list-at elems i) acc)

  rs-fields-fexprs : Text, List AFieldExpr, Integer, Integer, List Text -> List Text
  rs-fields-fexprs (pn) (fields) (i) (len) (acc) =
   if i >= len then acc
   else rs-fields-fexprs pn fields (i + 1) len (rs-fields-on pn (list-at fields i).value acc)

  rs-fields-arms : Text, List AMatchArm, Integer, Integer, List Text -> List Text
  rs-fields-arms (pn) (arms) (i) (len) (acc) =
   if i >= len then acc
   else let arm = list-at arms i
   in rs-fields-arms pn arms (i + 1) len (rs-fields-on pn (arm.body) (rs-fields-on pn (arm.guard) acc))

  rs-fields-stmts : Text, List AActStmt, Integer, Integer, List Text -> List Text
  rs-fields-stmts (pn) (stmts) (i) (len) (acc) =
   if i >= len then acc
   else when (list-at stmts i)
    is AActExprStmt (e) (s) -> rs-fields-stmts pn stmts (i + 1) len (rs-fields-on pn e acc)
    is AActBindStmt (n) (e) (s) -> rs-fields-stmts pn stmts (i + 1) len (rs-fields-on pn e acc)

  cv-without : List ConsumedVar, Text, List ConsumedVar, Integer, Integer -> List ConsumedVar
  cv-without (cs) (nm) (acc) (i) (len) =
   if i >= len then acc
   else let c = list-at cs i
   in if (c.cv-name) == nm then cv-without cs nm acc (i + 1) len
      else cv-without cs nm (list-push acc c) (i + 1) len

  cv-stale : List ConsumedVar, Text, Text, Integer, Integer -> Boolean
  cv-stale (cs) (nm) (fld) (i) (len) =
   if i >= len then False
   else let c = list-at cs i
   in if ((c.cv-name) == nm) & ((c.cv-field) == fld) then True
      else cv-stale cs nm fld (i + 1) len

  mutator-acc : Text, AExpr, Integer, MutatorEntry, List ConsumedVar -> List ConsumedVar
  mutator-acc (head) (call) (n) (me) (acc) =
   if (me.me-fn) == head then mutator-acc2 call n me acc else acc

  mutator-acc2 : AExpr, Integer, MutatorEntry, List ConsumedVar -> List ConsumedVar
  mutator-acc2 (call) (n) (me) (acc) =
   if (me.me-param) < n then mutator-acc3 call n me acc else acc

  mutator-acc3 : AExpr, Integer, MutatorEntry, List ConsumedVar -> List ConsumedVar
  mutator-acc3 (call) (n) (me) (acc) =
   if (bare-name-value (apply-arg-left call (me.me-param) n)) == "" then acc
   else list-push acc (ConsumedVar { cv-name = bare-name-value (apply-arg-left call (me.me-param) n), cv-field = me.me-field })

  mutator-consumes : List MutatorEntry, Text, AExpr, Integer, Integer, Integer, List ConsumedVar -> List ConsumedVar
  mutator-consumes (summary) (head) (call) (n) (i) (len) (acc) =
   if i >= len then acc
   else mutator-consumes summary head call n (i + 1) len (mutator-acc head call n (list-at summary i) acc)

  rs-consume-one : AExpr, Integer -> List ConsumedVar
  rs-consume-one (rhs) (n) =
   if (bare-name-value (apply-arg-left rhs 0 n)) == "" then []
   else list-push [] (ConsumedVar { cv-name = bare-name-value (apply-arg-left rhs 0 n), cv-field = text-lit-value (apply-arg-left rhs 1 n) })

  rs-consume-rset : AExpr, Integer -> List ConsumedVar
  rs-consume-rset (rhs) (n) =
   if n >= 3 then rs-consume-one rhs n else []

  rhs-consumes-app : List MutatorEntry, AExpr, Text, Integer -> List ConsumedVar
  rhs-consumes-app (summary) (rhs) (head) (n) =
   if head == "__record-set" then rs-consume-rset rhs n
   else mutator-consumes summary head rhs n 0 (list-length summary) []

  rhs-consumes : List MutatorEntry, AExpr -> List ConsumedVar
  rhs-consumes (summary) (rhs) =
   when rhs
    is AApplyExpr (f) (a) (s) -> rhs-consumes-app summary rhs (apply-head-name rhs) (apply-arg-count rhs)
    is otherwise -> []

  cv-add-skip : List ConsumedVar, List ConsumedVar, Text, Integer, Integer -> List ConsumedVar
  cv-add-skip (acc) (news) (bindname) (i) (len) =
   if i >= len then acc
   else let c = list-at news i
   in if (c.cv-name) == bindname then cv-add-skip acc news bindname (i + 1) len
      else cv-add-skip (list-push acc c) news bindname (i + 1) len

  update-consumed : List MutatorEntry, List ConsumedVar, Text, AExpr -> List ConsumedVar
  update-consumed (summary) (consumed) (bindname) (rhs) =
   let removed = cv-without consumed bindname [] 0 (list-length consumed)
   in let news = rhs-consumes summary rhs
   in cv-add-skip removed news bindname 0 (list-length news)

 Arguments to one call evaluate LEFT TO RIGHT, measured 2026-08-18 rather than
 assumed: `two (addn s 10) (s.n)` answers 1111 under left-to-right and 1101
 under right-to-left, and it answers 1111. So an argument that mutates has
 already run by the time an argument to its right is read, and a mutation does
 not have to be bound by a `let` to be visible. This walks the spine of the
 already-evaluated part of an application and collects what its arguments
 mutated.

  arg-mutations : List MutatorEntry, AExpr -> List ConsumedVar
  arg-mutations (summary) (e) =
   when e
    is AApplyExpr (f) (a) (s) ->
     let deeper = arg-mutations summary f
     in let here = rhs-consumes summary a
     in cv-add-skip deeper here "" 0 (list-length here)
    is otherwise -> []

  add-stale-warn : UnificationState, Text, Text, SourceSpan -> UnificationState
  add-stale-warn (st) (vname) (fld) (sp) =
   __record-set st "bag" (bag-add (st.bag) (make-warning cdx-stale-read-after-update ("Field '" & fld & "' is read from '" & vname & "' after '" & vname & "' was updated in place by an earlier call bound to a different name; '" & vname & "' now holds the updated value, not the original. Read the updated binding, or capture '" & vname & "." & fld & "' into a let before that call.") sp))

  scan-stale : List MutatorEntry, List ConsumedVar, AExpr, UnificationState -> UnificationState
  scan-stale (summary) (consumed) (e) (st) =
   when e
    is ALetExpr (binds) (body) (s) -> scan-stale-let summary consumed binds body 0 (list-length binds) st
    is AFieldAccess (obj) (fld) (s) ->
     when obj
      is ANameExpr (vn) (osp) -> if cv-stale consumed (vn.value) (fld.value) 0 (list-length consumed)
           then add-stale-warn st (vn.value) (fld.value) s
           else st
      is otherwise -> scan-stale summary consumed obj st
    is AApplyExpr (f) (a) (s) ->
     let st1 = scan-stale summary consumed f st
     in let news = arg-mutations summary f
     in scan-stale summary (cv-add-skip consumed news "" 0 (list-length news)) a st1
    is ABinaryExpr (l) (op) (r) (s) -> scan-stale summary consumed r (scan-stale summary consumed l st)
    is AUnaryExpr (x) (s) -> scan-stale summary consumed x st
    is AIfExpr (c) (t) (el) (s) -> scan-stale summary consumed el (scan-stale summary consumed t (scan-stale summary consumed c st))
    is ALambdaExpr (ps) (body) (s) -> scan-stale summary consumed body st
    is AMatchExpr (scrut) (arms) (s) -> scan-stale-arms summary consumed arms 0 (list-length arms) (scan-stale summary consumed scrut st)
    is AListExpr (elems) (s) -> scan-stale-list summary consumed elems 0 (list-length elems) st
    is ARecordExpr (n) (fields) (s) -> scan-stale-fexprs summary consumed fields 0 (list-length fields) st
    is AActExpr (stmts) (s) -> scan-stale-stmts summary consumed stmts 0 (list-length stmts) st
    is AHandleExpr (eff) (body) (cls) (s) -> scan-stale summary consumed body st
    is AWithTimeoutExpr (t) (effs) (scopes) (body) (s) -> scan-stale summary consumed body st
    is ATryExpr (mx) (b) (fb) (fl) (s) -> scan-stale-stmts summary consumed fl 0 (list-length fl) (scan-stale-stmts summary consumed fb 0 (list-length fb) (scan-stale-stmts summary consumed b 0 (list-length b) st))
    is AFieldAssignExpr (rec) (fld) (val) (s) -> scan-stale summary consumed val (scan-stale summary consumed rec st)
    is ALazyExpr (inner) (s) -> scan-stale summary consumed inner st
    is otherwise -> st

  scan-stale-let : List MutatorEntry, List ConsumedVar, List ALetBind, AExpr, Integer, Integer, UnificationState -> UnificationState
  scan-stale-let (summary) (consumed) (binds) (body) (i) (len) (st) =
   if i >= len then scan-stale summary consumed body st
   else let b = list-at binds i
   in let st1 = scan-stale summary consumed (b.value) st
   in let consumed2 = update-consumed summary consumed (b.name.value) (b.value)
   in scan-stale-let summary consumed2 binds body (i + 1) len st1

  scan-stale-arms : List MutatorEntry, List ConsumedVar, List AMatchArm, Integer, Integer, UnificationState -> UnificationState
  scan-stale-arms (summary) (consumed) (arms) (i) (len) (st) =
   if i >= len then st
   else let arm = list-at arms i
   in scan-stale-arms summary consumed arms (i + 1) len (scan-stale summary consumed (arm.body) (scan-stale summary consumed (arm.guard) st))

  scan-stale-list : List MutatorEntry, List ConsumedVar, List AExpr, Integer, Integer, UnificationState -> UnificationState
  scan-stale-list (summary) (consumed) (elems) (i) (len) (st) =
   if i >= len then st
   else scan-stale-list summary consumed elems (i + 1) len (scan-stale summary consumed (list-at elems i) st)

  scan-stale-fexprs : List MutatorEntry, List ConsumedVar, List AFieldExpr, Integer, Integer, UnificationState -> UnificationState
  scan-stale-fexprs (summary) (consumed) (fields) (i) (len) (st) =
   if i >= len then st
   else scan-stale-fexprs summary consumed fields (i + 1) len (scan-stale summary consumed (list-at fields i).value st)

  scan-stale-stmts : List MutatorEntry, List ConsumedVar, List AActStmt, Integer, Integer, UnificationState -> UnificationState
  scan-stale-stmts (summary) (consumed) (stmts) (i) (len) (st) =
   if i >= len then st
   else when (list-at stmts i)
    is AActExprStmt (e) (s) -> scan-stale-stmts summary consumed stmts (i + 1) len (scan-stale summary consumed e st)
    is AActBindStmt (n) (e) (s) ->
     let st1 = scan-stale summary consumed e st
     in let consumed2 = update-consumed summary consumed (n.value) e
     in scan-stale-stmts summary consumed2 stmts (i + 1) len st1

  append-mutator-entries : List MutatorEntry, Text, Integer, List Text, Integer, Integer -> List MutatorEntry
  append-mutator-entries (acc) (fn) (k) (flds) (i) (len) =
   if i >= len then acc
   else append-mutator-entries (list-push acc (MutatorEntry { me-fn = fn, me-param = k, me-field = list-at flds i })) fn k flds (i + 1) len

  collect-def-mutators : ADef, List AParam, Integer, Integer, List MutatorEntry -> List MutatorEntry
  collect-def-mutators (d) (params) (k) (len) (acc) =
   if k >= len then acc
   else let p = list-at params k
   in let flds = rs-fields-on (p.name.value) (d.body) []
   in collect-def-mutators d params (k + 1) len (append-mutator-entries acc (d.name.value) k flds 0 (list-length flds))

  build-mutators : List ADef, Integer, Integer, List MutatorEntry -> List MutatorEntry
  build-mutators (defs) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at defs i
   in build-mutators defs (i + 1) len (collect-def-mutators d (d.params) 0 (list-length (d.params)) acc)

  check-stale-defs : List MutatorEntry, List ADef, Integer, Integer, UnificationState -> UnificationState
  check-stale-defs (summary) (defs) (i) (len) (st) =
   if i >= len then st
   else let d = list-at defs i
   in check-stale-defs summary defs (i + 1) len (scan-stale summary [] (d.body) st)

  check-stale-reads : List ADef, UnificationState -> UnificationState
  check-stale-reads (defs) (st) =
   let summary = build-mutators defs 0 (list-length defs) []
   in check-stale-defs summary defs 0 (list-length defs) st

Section: Register Type Definitions
  build-type-def-map : List ATypeDef, Integer, Integer, List TypeBinding -> List TypeBinding
  build-type-def-map (tdefs) (i) (len) (acc) =
   if i == len then acc
   else let td = list-at tdefs i
   in let entry = when td
       is AVariantTypeDef (name) (type-params) (ctors) (s) ->
        let sum-ctors = build-sum-ctors tdefs ctors 0 (list-length ctors) [] acc
   in let ty-args = for p in type-params -> deck-record (ConstructedTy p [])
   in deck-record (TypeBinding {
         name = name.value,
         bound-type = deck-record (SumTy name ty-args sum-ctors)
        })
       is ARecordTypeDef (name) (type-params) (fields) (is-mut) (s) ->
        let rec-fields = build-record-fields-for-map tdefs fields 0 (list-length fields) [] acc
   in let ty-args = for p in type-params -> deck-record (ConstructedTy p [])
   in deck-record (TypeBinding {
         name = name.value,
         bound-type = deck-record (RecordTy name ty-args rec-fields)
        })
       is AUnitTypeDef (name) (base-texpr) (s) ->
        let resolved-base = resolve-type-expr acc base-texpr
   in deck-record (TypeBinding {
         name = name.value,
         bound-type = deck-record (UnitTy name resolved-base)
        })
   in build-type-def-map tdefs (i + 1) len (list-insert-at acc (bsearch-text-pos acc (entry.name) 0 (list-length acc)) entry)

  build-sum-ctors : List ATypeDef, List AVariantCtorDef, Integer, Integer, List SumCtor, List TypeBinding -> List SumCtor
  build-sum-ctors (tdefs) (ctors) (i) (len) (acc) (partial-tdm) =
   if i == len then acc
   else let c = list-at ctors i
   in let field-types = resolve-type-expr-list-for-map tdefs (c.fields) 0 (list-length (c.fields)) [] partial-tdm
   in let ret-types = resolve-type-expr-list-for-map tdefs (c.return-type) 0 (list-length (c.return-type)) [] partial-tdm
   in let sc = deck-record (SumCtor {
    name = c.name,
    fields = field-types,
    return-type = ret-types
   })
   in build-sum-ctors tdefs ctors (i + 1) len (list-push acc sc) partial-tdm

  build-record-fields-for-map : List ATypeDef, List ARecordFieldDef, Integer, Integer, List RecordField, List TypeBinding -> List RecordField
  build-record-fields-for-map (tdefs) (fields) (i) (len) (acc) (partial-tdm) =
   if i == len then acc
   else let f = list-at fields i
   in let rfield = deck-record (RecordField {
    name = f.name,
    type-val = resolve-type-expr partial-tdm (f.type-expr)
   })
   in build-record-fields-for-map tdefs fields (i + 1) len (list-push acc rfield) partial-tdm

  resolve-type-expr-list-for-map : List ATypeDef, List ATypeExpr, Integer, Integer, List CodexType, List TypeBinding -> List CodexType
  resolve-type-expr-list-for-map (tdefs) (args) (i) (len) (acc) (partial-tdm) =
   if i == len then acc
   else resolve-type-expr-list-for-map tdefs args (i + 1) len (list-push acc (resolve-type-expr partial-tdm (list-at args i))) partial-tdm

  register-type-defs : UnificationState, TypeEnv, List TypeBinding, List ATypeDef, Integer, Integer -> LetBindResult
  register-type-defs (st) (env) (tdm) (tdefs) (i) (len) =
   if i == len then LetBindResult {
    state = st,
    env = env
   }
   else let td = list-at tdefs i
   in let r = register-one-type-def st env tdm td
   in register-type-defs (r.state) (r.env) tdm tdefs (i + 1) len

  register-one-type-def : UnificationState, TypeEnv, List TypeBinding, ATypeDef -> LetBindResult
  register-one-type-def (st) (env) (tdm) (td) =
   when td
    is AVariantTypeDef (name) (type-params) (ctors) (s) ->
     let sum-ty = lookup-type-def tdm (name.value)
     in let env1 = env-bind env (name.value) sum-ty
     in let result-ty = if list-length type-params == 0 then sum-ty
          else deck-record (ConstructedTy name (for p in type-params -> deck-record (ConstructedTy p [])))
     in register-variant-ctors st env1 tdm ctors result-ty 0 (list-length ctors)
    is ARecordTypeDef (name) (type-params) (fields) (is-mut) (s) ->
     let resolved-fields = for f in fields -> deck-record (RecordField { name = f.name, type-val = resolve-type-expr tdm (f.type-expr) })
     in let ty-args = for p in type-params -> deck-record (ConstructedTy p [])
     in let result-ty = deck-record (RecordTy name ty-args resolved-fields)
     in let ctor-ty = build-record-ctor-type tdm fields result-ty 0 (list-length fields)
     in let pr = parameterize-type st ctor-ty
     in LetBindResult {
      state = pr.state,
      env = env-bind env (name.value) (pr.parameterized)
     }
    is AUnitTypeDef (name) (base-texpr) (s) ->
     let unit-ty = lookup-type-def tdm (name.value)
     in let ctor-ty = deck-record (FunTy (resolve-type-expr tdm base-texpr) empty-row unit-ty)
     in LetBindResult {
      state = st,
      env = env-bind env (name.value) ctor-ty
     }

  lookup-record-field : List RecordField, Text -> CodexType
  lookup-record-field (fields) (name) =
   if list-length fields == 0 then ErrorTy
   else let f = list-at fields 0
   in if f.name.value == name then f.type-val
      else lookup-record-field-loop fields name 1 (list-length fields)

  lookup-record-field-loop : List RecordField, Text, Integer, Integer -> CodexType
  lookup-record-field-loop (fields) (name) (i) (len) =
   if i == len then ErrorTy
   else let f = list-at fields i
   in if f.name.value == name then f.type-val
      else lookup-record-field-loop fields name (i + 1) len

  register-variant-ctors : UnificationState, TypeEnv, List TypeBinding, List AVariantCtorDef, CodexType, Integer, Integer -> LetBindResult
  register-variant-ctors (st) (env) (tdm) (ctors) (result-ty) (i) (len) =
   if i == len then LetBindResult {
    state = st,
    env = env
   }
   else let ctor = list-at ctors i
   in let ctor-result = if list-length (ctor.return-type) > 0 then resolve-type-expr tdm (list-at (ctor.return-type) 0) else result-ty
   in let ctor-ty = build-ctor-type tdm (ctor.fields) ctor-result 0 (list-length (ctor.fields))
   in let pr = parameterize-type st ctor-ty
   in let env2 = env-bind env (ctor.name.value) (pr.parameterized)
   in register-variant-ctors (pr.state) env2 tdm ctors result-ty (i + 1) len

  build-ctor-type : List TypeBinding, List ATypeExpr, CodexType, Integer, Integer -> CodexType
  build-ctor-type (tdm) (fields) (result) (i) (len) =
   if i == len then result
   else let rest = build-ctor-type tdm fields result (i + 1) len
   in deck-record (FunTy (resolve-type-expr tdm (list-at fields i)) empty-row rest)

  build-record-ctor-type : List TypeBinding, List ARecordFieldDef, CodexType, Integer, Integer -> CodexType
  build-record-ctor-type (tdm) (fields) (result) (i) (len) =
   if i == len then result
   else let f = list-at fields i
   in let rest = build-record-ctor-type tdm fields result (i + 1) len
   in deck-record (FunTy (resolve-type-expr tdm (f.type-expr)) empty-row rest)

Section: Type Arity Check
  FlatAppResult = record {
   ctor : ATypeExpr,
   args : List ATypeExpr
  }

  flatten-app : ATypeExpr, List ATypeExpr -> FlatAppResult
  flatten-app (expr) (outer-args) =
   when expr
    is AAppType (ctor) (args) (s) -> flatten-app ctor (args & outer-args)
    is otherwise -> FlatAppResult { ctor = expr, args = outer-args }

  expected-arity-for : Text, List TypeBinding -> Integer
  expected-arity-for (name) (tdm) =
   if name == "List" then 1
   else if name == "LinkedList" then 1
   else let t = lookup-type-def tdm name
   in when t
     is RecordTy (n) (args) (fields) | SumTy (n) (args) (ctors) -> list-length args
     is otherwise -> -1

  atype-named : ATypeExpr -> Text
  atype-named (expr) =
   when expr
    is ANamedType (name) (s) -> name.value
    is otherwise -> ""

  tdm-has : List TypeBinding, Text -> Boolean
  tdm-has (tdm) (name) =
   let len = list-length tdm
   in if len == 0 then False
   else let pos = bsearch-text-pos tdm name 0 len
   in if pos >= len then False
   else (list-at tdm pos).name == name

  builtin-type-name : Text -> Boolean
  builtin-type-name (name) =
   name == "Integer" | name == "Real" | name == "Text" | name == "Boolean"
   | name == "Char" | name == "Nothing" | name == "Proof"
   | name == "List" | name == "LinkedList" | name == "Vector"

  type-name-known : List TypeBinding, Text -> Boolean
  type-name-known (tdm) (name) =
   if text-length name == 0 then True
   else if is-upper (char-at name 0) == False then True
   else if builtin-type-name name then True
   else tdm-has tdm name

  check-type-name-exists : List TypeBinding, Text, SourceSpan, List Diagnostic -> List Diagnostic
  check-type-name-exists (tdm) (name) (s) (acc) =
   if type-name-known tdm name then acc
   else list-push acc (make-error cdx-undefined-type-name ("Undefined type name: " & name) s)

  check-arity-in-expr : List TypeBinding, ATypeExpr, List Diagnostic -> List Diagnostic
  check-arity-in-expr (tdm) (expr) (acc) =
   when expr
    is ANamedType (name) (s) -> check-type-name-exists tdm (name.value) s acc
    is AAppType (ctor) (args) (s) ->
     let flat = flatten-app ctor args
     in let flat-name = atype-named (flat.ctor)
     in let expected = if text-length flat-name == 0 then -1 else expected-arity-for flat-name tdm
     in let actual = list-length (flat.args)
     in let acc1 = check-type-name-exists tdm flat-name s acc
     in let acc2 = if expected >= 0 & actual /= expected
                   then list-push acc1 (make-error cdx-type-arity ("Type '" & flat-name & "' expects " & integer-to-text expected & " type argument(s), got " & integer-to-text actual) s)
                   else acc1
     in check-arity-in-expr-list tdm (flat.args) 0 (list-length (flat.args)) acc2
    is AFunType (param) (ret) (s) -> check-arity-in-expr tdm ret (check-arity-in-expr tdm param acc)
    is AEffectType (effs) (scopes) (tail) (ret) (s) -> check-arity-in-expr tdm ret acc
    is ALinearType (inner) (s) -> check-arity-in-expr tdm inner acc
    is otherwise -> acc

  check-arity-in-expr-list : List TypeBinding, List ATypeExpr, Integer, Integer, List Diagnostic -> List Diagnostic
  check-arity-in-expr-list (tdm) (xs) (i) (len) (acc) =
   if i == len then acc
   else check-arity-in-expr-list tdm xs (i + 1) len (check-arity-in-expr tdm (list-at xs i) acc)

  check-arity-in-record-fields : List TypeBinding, List ARecordFieldDef, Integer, Integer, List Diagnostic -> List Diagnostic
  check-arity-in-record-fields (tdm) (fields) (i) (len) (acc) =
   if i == len then acc
   else let f = list-at fields i
   in check-arity-in-record-fields tdm fields (i + 1) len (check-arity-in-expr tdm (f.type-expr) acc)

  check-arity-in-variant-ctors : List TypeBinding, List AVariantCtorDef, Integer, Integer, List Diagnostic -> List Diagnostic
  check-arity-in-variant-ctors (tdm) (ctors) (i) (len) (acc) =
   if i == len then acc
   else let c = list-at ctors i
   in check-arity-in-variant-ctors tdm ctors (i + 1) len (check-arity-in-expr-list tdm (c.fields) 0 (list-length (c.fields)) acc)

  check-arity-in-typedef : List TypeBinding, ATypeDef, List Diagnostic -> List Diagnostic
  check-arity-in-typedef (tdm) (td) (acc) =
   when td
    is AVariantTypeDef (name) (type-params) (ctors) (s) -> check-arity-in-variant-ctors tdm ctors 0 (list-length ctors) acc
    is ARecordTypeDef (name) (type-params) (fields) (is-mut) (s) -> check-arity-in-record-fields tdm fields 0 (list-length fields) acc
    is AUnitTypeDef (name) (base) (s) -> check-arity-in-expr tdm base acc

  check-arity-in-def : List TypeBinding, ADef, List Diagnostic -> List Diagnostic
  check-arity-in-def (tdm) (def) (acc) =
   if list-length (def.declared-type) == 0 then acc
   else check-arity-in-expr tdm (list-at (def.declared-type) 0) acc

  check-arity-in-defs : List TypeBinding, List ADef, Integer, Integer, List Diagnostic -> List Diagnostic
  check-arity-in-defs (tdm) (defs) (i) (len) (acc) =
   if i == len then acc
   else check-arity-in-defs tdm defs (i + 1) len (check-arity-in-def tdm (list-at defs i) acc)

  check-arity-in-typedefs : List TypeBinding, List ATypeDef, Integer, Integer, List Diagnostic -> List Diagnostic
  check-arity-in-typedefs (tdm) (tdefs) (i) (len) (acc) =
   if i == len then acc
   else check-arity-in-typedefs tdm tdefs (i + 1) len (check-arity-in-typedef tdm (list-at tdefs i) acc)

  check-all-type-arities : List TypeBinding, AChapter -> List Diagnostic
  check-all-type-arities (tdm) (mod) =
   let defs-errors = check-arity-in-defs tdm (mod.defs) 0 (list-length (mod.defs)) []
   in check-arity-in-typedefs tdm (mod.type-defs) 0 (list-length (mod.type-defs)) defs-errors

Section: Capability Checker

 This list is the capability VOCABULARY, not a grant. It names every
 effect the manifest emitter can map to a capability id, and the
 check below rejects an opening that declares an effect outside it --
 an effect no policy could ever inspect and no boot grant could ever
 satisfy. The authority itself comes from the binary's own manifest
 at boot (emit-grant-cap-mask) and from the trust policy at load
 (VerifiedLoader). The old name `granted-capabilities` read like a
 grant-all list; it never granted anything.

  capability-vocabulary : List Text
  capability-vocabulary = capability-names

  check-opening-capabilities : List TypeBinding -> List Diagnostic
  check-opening-capabilities (types) =
   let opening-ty = find-opening-type types 0 (list-length types)
   in let effs = collect-effect-names opening-ty
   in check-cap-list effs capability-vocabulary 0 (list-length effs)

  find-opening-type : List TypeBinding, Integer, Integer -> CodexType
  find-opening-type (types) (i) (len) =
   if i == len then NothingTy
   else let t = list-at types i
   in if t.name == "opening" then t.bound-type
      else find-opening-type types (i + 1) len

  check-cap-list : List Name, List Text, Integer, Integer -> List Diagnostic
  check-cap-list (effs) (vocab) (i) (len) =
   if i == len then []
   else let e = list-at effs i
   in let rest = check-cap-list effs vocab (i + 1) len
   in if cap-name-covered vocab (e.value) 0 (list-length vocab) then rest
      else list-push rest (make-error cdx-capability-not-granted ("Effect '" & (e.value) & "' has no capability the manifest can carry") synthetic-span)

  cap-name-covered : List Text, Text, Integer, Integer -> Boolean
  cap-name-covered (vocab) (eff) (i) (len) =
   if i == len then let dot-pos = find-dot eff 0 (text-length eff)
   in if dot-pos >= 0 then cap-name-covered vocab (substring eff 0 dot-pos) 0 len
      else False
   else if list-at-text vocab i == eff then True
   else cap-name-covered vocab eff (i + 1) len

  list-at-text : List Text, Integer -> Text
  list-at-text (xs) (i) = list-at xs i

