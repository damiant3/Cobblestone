Chapter: Unification
  cites Foreword chapter Sort
  cites Codex chapter Build Settings (max-recursion-depth)
  cites Foreword chapter Tuple
  cites Foreword chapter MathLib (int-widen)

 Row variables have their own id space and their own substitution
 table: rows are not CodexTypes, so a type position can never resolve
 to a row nor a row to a type, and a row id can never be confused
 with a type-variable id because no operation accepts both. The table
 is dense -- slot i holds the binding for row id i, unbound slots hold
 the self-row (row-var i), mirroring the TypeVar self-slot trick -- so
 lookup is a direct index. Stage 3 mints a row variable per
 application site; an association list here would make resolution
 quadratic in program size. Row ids share the 32-bit bound ruling
 with type-variable ids. The table grows on first binding past its
 length (fresh ids alone allocate nothing); an index past the end
 reads as unbound.

Section: State
  ExprTypeEntry = record {
   key : Integer,
   ty : CodexType
  }

  mutable UnificationState = record {
   substitutions : List CodexType,
   row-substitutions : List EffectRow,
   next-id : Integer between 0 and 4294967295,
   next-row-id : Integer between 0 and 4294967295,
   bag : DiagnosticBag,
   expr-types : List ExprTypeEntry,
   effect-exempt : Boolean,
   scope-grants : List EffectLabel,
   chapter-grounds : List Text,
   dirty-slots : List Integer
  }

Section: Construction
  empty-unification-state : UnificationState
  empty-unification-state =
   UnificationState {
    substitutions = deck-record [deck-record (TypeVar 0), deck-record (TypeVar 1)],
    row-substitutions = [],
    next-id = 2,
    next-row-id = 0,
    bag = empty-bag,
    expr-types = [],
    effect-exempt = False,
    scope-grants = [],
    chapter-grounds = [],
    dirty-slots = []
   }

Section: Fresh Variables
  fresh-var : UnificationState -> CodexType
  fresh-var (st) =
   TypeVar (st.next-id)

  advance-id : UnificationState -> UnificationState
  advance-id (st) =
   let new-subs = list-push (st.substitutions) (deck-record (TypeVar (st.next-id)))
   in let new-id = st.next-id + 1
   in let __seq = st.substitutions = new-subs
   in let __seq = st.next-id = new-id
   in st

  fresh-and-advance : UnificationState -> (CodexType, UnificationState)
  fresh-and-advance (st) =
   (TypeVar (st.next-id), advance-id st)

 next-row-id is declared 0..4294967295 and a type argument is invariant, so
 the pair below would otherwise be a Tup2 carrying those bounds. Widening
 HERE rather than declaring the narrow type in the signature keeps all
 eleven call sites seeing a plain Integer; declaring it narrow pushes the
 bounds out to every caller and moves the mismatch rather than fixing it.

  fresh-row-id : UnificationState -> (Integer, UnificationState)
  fresh-row-id (st) =
   let id = st.next-row-id
   in let __seq = st.next-row-id = __narrow (id + 1)
   in (int-widen id, st)

Section: Fuel Budget

 Recursive type-level operations cap at max-recursion-depth stack
 frames. A legitimate AST is nowhere near that deep; exceeding this
 bound means a bypassed occurs-check, a substitution cycle, or an
 adversarial input. Emit CDX9001 and bail rather than stack-overflow.

Section: Resolve

  resolve-silent : UnificationState, CodexType -> CodexType
  resolve-silent (st) (ty) = resolve-silent-at st ty 0

  resolve-silent-at : UnificationState, CodexType, Integer -> CodexType
  resolve-silent-at (st) (ty) (depth) =
   if depth >= max-recursion-depth then ErrorTy
   else when ty
    is TypeVar (id) ->
     if id >= list-length (st.substitutions) then ty
     else let slot = list-at (st.substitutions) id
     in if slot-is-unbound slot id then ty else resolve-silent-at st slot (depth + 1)
    is otherwise -> ty

  slot-is-unbound : CodexType, Integer -> Boolean
  slot-is-unbound (slot) (id) =
   when slot
    is TypeVar (slot-id) -> slot-id == id
    is otherwise -> False

Section: Add Substitution
  add-subst : UnificationState, Integer, CodexType -> UnificationState
  add-subst (st) (var-id) (ty) =
   let __seq = st.substitutions = list-set-at (st.substitutions) var-id ty
   in let __seq = st.dirty-slots = list-push (st.dirty-slots) var-id
   in st

Section: Expr Types

 Records per-expression resolved types keyed by span, for lowering to
 consult after type-checking finishes. Spans are keyed as a composite
 integer packed as file-id (16 bits) | start offset (32 bits) | span
 length capped at 65535 (16 bits) - an exact 64-bit fit. The previous
 decimal packing multiplied by 1e6 with the raw end offset in the low
 field; any source past one megabyte overflowed the field and bled
 into the start digits, silently aliasing distinct spans and
 shadowing entries behind the binary search. Entries are appended
 unsorted during type-checking via list-push (O(1) per call), then
 merge-sorted once at the check-lower boundary via sort-expr-types
 (O(N log N)). Lookup after sort is O(log N) via binary search.
 Populated only from narrow inference sites (ANameExpr, ARecordExpr).

  expr-type-key : SourceSpan -> Integer
  expr-type-key (sp) =
   let len = sp.end.offset - sp.start.offset
   in let capped = if len > 65535 then 65535 else if len < 0 then 0 else len
   in sp.file-id * 281474976710656 + sp.start.offset * 65536 + capped

  bsearch-expr-type-pos : List ExprTypeEntry, Integer, Integer, Integer -> Integer
  bsearch-expr-type-pos (entries) (k) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-key = (list-at entries mid).key
   in if k <= mid-key then bsearch-expr-type-pos entries k lo mid
      else bsearch-expr-type-pos entries k (mid + 1) hi

  record-expr-type : UnificationState, SourceSpan, CodexType -> UnificationState
  record-expr-type (st) (sp) (ty) =
   if is-synthetic-span sp then st
   else let k = expr-type-key sp
   in let __seq = st.expr-types = list-push (st.expr-types) (deck-record (ExprTypeEntry { key = k, ty = ty }))
   in st

  expr-type-recorded-unsorted : UnificationState, SourceSpan -> Boolean
  expr-type-recorded-unsorted (st) (sp) =
   when (expr-type-scan st sp)
    is ErrorTy -> False
    is otherwise -> True

  expr-type-scan : UnificationState, SourceSpan -> CodexType
  expr-type-scan (st) (sp) =
   if is-synthetic-span sp then ErrorTy
   else scan-expr-type-key (st.expr-types) (expr-type-key sp) 0 (list-length (st.expr-types))

  scan-expr-type-key : List ExprTypeEntry, Integer, Integer, Integer -> CodexType
  scan-expr-type-key (entries) (k) (i) (len) =
   if i >= len then ErrorTy
   else if (list-at entries i).key == k then (list-at entries i).ty
   else scan-expr-type-key entries k (i + 1) len

  compare-expr-type-keys : ExprTypeEntry, ExprTypeEntry -> Integer
  compare-expr-type-keys (a) (b) =
   if a.key < b.key then (0 - 1) else if a.key > b.key then 1 else 0

  sort-expr-types : List ExprTypeEntry -> List ExprTypeEntry
  sort-expr-types (xs) = sort-by xs compare-expr-type-keys

  lookup-expr-type : UnificationState, SourceSpan -> CodexType
  lookup-expr-type (st) (sp) =
   if is-synthetic-span sp then ErrorTy
   else let k = expr-type-key sp
   in let entries = st.expr-types
   in let len = list-length entries
   in let pos = bsearch-expr-type-pos entries k 0 len
   in if pos < len
      then if (list-at entries pos).key == k
           then (list-at entries pos).ty
           else ErrorTy
      else ErrorTy

Section: Add Error
  add-unify-error : UnificationState, Integer between 0 and 65535, Text, SourceSpan -> UnificationState
  add-unify-error (st) (code) (msg) (span) =
   let __seq = st.bag = bag-add (st.bag) (make-error code msg span)
   in st

  add-fuel-error : UnificationState, Text, SourceSpan -> UnificationState
  add-fuel-error (st) (op) (span) =
   add-unify-error st cdx-resource-exhausted ("compiler resource exhausted in unifier." & op & " (budget " & integer-to-text max-recursion-depth & ")") span

Section: Occurs Check
  occurs-in : UnificationState, Integer, CodexType, Integer -> Boolean
  occurs-in (st) (var-id) (ty) (depth) =
   if depth >= max-recursion-depth then True
   else let resolved = resolve-silent st ty
   in when resolved
    is TypeVar (id) -> id == var-id
    is FunTy (param) (row) (ret) -> occurs-in st var-id param (depth + 1) | occurs-in st var-id ret (depth + 1)
    is ListTy (elem) | LinkedListTy (elem) -> occurs-in st var-id elem (depth + 1)
    is TypeApply (tf) (ta) -> occurs-in st var-id tf (depth + 1) | occurs-in st var-id ta (depth + 1)
    is LinearTy (inner) -> occurs-in st var-id inner (depth + 1)
    is otherwise -> False

Section: Effect Row Substitution

  label-compare : EffectLabel, EffectLabel -> Integer
  label-compare (a) (b) =
   let nc = text-compare (a.name.value) (b.name.value)
   in if nc /= 0 then nc else text-compare (a.scope) (b.scope)

  insert-label-sorted : List EffectLabel, EffectLabel, Integer, Integer, List EffectLabel, Boolean -> List EffectLabel
  insert-label-sorted (xs) (x) (i) (len) (acc) (placed) =
   if i == len then if placed then acc else list-push acc x
   else let cur = list-at xs i
   in let c = label-compare x cur
   in if placed then insert-label-sorted xs x (i + 1) len (list-push acc cur) True
      else if c == 0 then insert-label-sorted xs x (i + 1) len (list-push acc cur) True
      else if c < 0 then insert-label-sorted xs x (i + 1) len (list-push (list-push acc x) cur) True
      else insert-label-sorted xs x (i + 1) len (list-push acc cur) False

  sort-labels-canonical : List EffectLabel, Integer, Integer, List EffectLabel -> List EffectLabel
  sort-labels-canonical (xs) (i) (len) (acc) =
   if i == len then acc
   else sort-labels-canonical xs (i + 1) len (insert-label-sorted acc (list-at xs i) 0 (list-length acc) [] False)

  make-row : List EffectLabel, Text, Integer -> EffectRow
  make-row (labels) (tname) (tid) =
   deck-record (EffectRow { labels = deck-record (sort-labels-canonical labels 0 (list-length labels) []), tail-name = tname, tail-id = __narrow tid })

  labels-equal : List EffectLabel, List EffectLabel -> Boolean
  labels-equal (xs) (ys) =
   if list-length xs /= list-length ys then False
   else labels-equal-loop xs ys 0 (list-length xs)

  labels-equal-loop : List EffectLabel, List EffectLabel, Integer, Integer -> Boolean
  labels-equal-loop (xs) (ys) (i) (len) =
   if i == len then True
   else if label-compare (list-at xs i) (list-at ys i) == 0 then labels-equal-loop xs ys (i + 1) len
   else False

  labels-minus : List EffectLabel, List EffectLabel -> List EffectLabel
  labels-minus (xs) (ys) =
   labels-minus-merge xs ys 0 0 (list-length xs) (list-length ys) []

  labels-minus-merge : List EffectLabel, List EffectLabel, Integer, Integer, Integer, Integer, List EffectLabel -> List EffectLabel
  labels-minus-merge (xs) (ys) (i) (j) (xlen) (ylen) (acc) =
   if i == xlen then acc
   else if j == ylen then labels-minus-merge xs ys (i + 1) j xlen ylen (list-push acc (list-at xs i))
   else let c = label-compare (list-at xs i) (list-at ys j)
   in if c == 0 then labels-minus-merge xs ys (i + 1) (j + 1) xlen ylen acc
      else if c < 0 then labels-minus-merge xs ys (i + 1) j xlen ylen (list-push acc (list-at xs i))
      else labels-minus-merge xs ys i (j + 1) xlen ylen acc

  row-slot-unbound : EffectRow, Integer -> Boolean
  row-slot-unbound (slot) (id) =
   slot.tail-id == id & list-length (slot.labels) == 0

  grow-row-substs : List EffectRow, Integer, Integer -> List EffectRow
  grow-row-substs (entries) (len) (want) =
   if len > want then entries
   else grow-row-substs (list-push entries (deck-record (row-var len))) (len + 1) want

  add-row-subst : UnificationState, Integer, EffectRow -> UnificationState
  add-row-subst (st) (id) (row) =
   let grown = grow-row-substs (st.row-substitutions) (list-length (st.row-substitutions)) id
   in let __seq = st.row-substitutions = list-set-at grown id row
   in st

  resolve-row : UnificationState, EffectRow -> EffectRow
  resolve-row (st) (row) = resolve-row-at st row 0

  resolve-row-at : UnificationState, EffectRow, Integer -> EffectRow
  resolve-row-at (st) (row) (depth) =
   if depth >= max-recursion-depth then row
   else if row.tail-id < 0 then row
   else let entries = st.row-substitutions
   in if row.tail-id >= list-length entries then row
   else let slot = list-at entries (row.tail-id)
   in if row-slot-unbound slot (row.tail-id) then row
   else let bound = resolve-row-at st slot (depth + 1)
   in make-row ((row.labels) & (bound.labels)) (bound.tail-name) (bound.tail-id)

  row-occurs : UnificationState, Integer, EffectRow, Integer -> Boolean
  row-occurs (st) (tid) (row) (depth) =
   if depth >= max-recursion-depth then True
   else if row.tail-id < 0 then False
   else if row.tail-id == tid then True
   else let entries = st.row-substitutions
   in if row.tail-id >= list-length entries then False
   else let slot = list-at entries (row.tail-id)
   in if row-slot-unbound slot (row.tail-id) then False
   else row-occurs st tid slot (depth + 1)

  row-desc : EffectRow -> Text
  row-desc (row) =
   "[" & row-desc-labels (row.labels) 0 (list-length (row.labels)) & row-desc-tail row (list-length (row.labels) > 0) & "]"

  row-desc-labels : List EffectLabel, Integer, Integer -> Text
  row-desc-labels (labels) (i) (len) =
   if i == len then ""
   else let l = list-at labels i
   in let prefix = if i == 0 then "" else ", "
   in let scope-part = if text-length (l.scope) > 0 then " \"" & (l.scope) & "\"" else ""
   in prefix & (l.name.value) & scope-part & row-desc-labels labels (i + 1) len

  row-desc-tail : EffectRow, Boolean -> Text
  row-desc-tail (row) (have-labels) =
   if row.tail-id < 0 then ""
   else let sep = if have-labels then ", " else ""
   in if text-length (row.tail-name) > 0 then sep & (row.tail-name)
      else sep & "e" & integer-to-text (row.tail-id)

Section: Row Unification

 unify-row implements the ACI1 set-row algorithm: resolve both
 rows, cancel shared labels with one sorted
 merge, then case on the tails. Label equality is EXACT -- the dotted
 sub-effect lattice lives only in the directed row-le check (stage
 3), never in symmetric unification. Under payload-free labels and
 at most one tail per row this produces a unifier that is most
 general up to ACI1 equivalence: the only candidate divergence --
 re-adding a shared label into both tails -- is collapsed by
 idempotence.

  rows-identical : EffectRow, EffectRow -> Boolean
  rows-identical (a) (b) =
   a.tail-id == b.tail-id & labels-equal (a.labels) (b.labels)

  row-mismatch-msg : EffectRow, EffectRow -> Text
  row-mismatch-msg (a) (b) =
   "cannot reconcile effect rows " & row-desc a & " and " & row-desc b & ": an effect on one side is not allowed by the other"

  unify-row : UnificationState, EffectRow, EffectRow, SourceSpan -> (Boolean, UnificationState)
  unify-row (st) (r1) (r2) (span) =
   let a = resolve-row st r1
   in let b = resolve-row st r2
   in if rows-identical a b then (True, st)
   else let only1 = labels-minus (a.labels) (b.labels)
   in let only2 = labels-minus (b.labels) (a.labels)
   in if a.tail-id < 0 & b.tail-id < 0 then unify-row-both-closed st a b only1 only2 span
   else if a.tail-id >= 0 & b.tail-id < 0 then unify-row-open-closed st a only1 only2 b span
   else if a.tail-id < 0 & b.tail-id >= 0 then unify-row-open-closed st b only2 only1 a span
   else if a.tail-id == b.tail-id then unify-row-both-closed st a b only1 only2 span
   else unify-row-open-open st a b only1 only2 span

  unify-row-both-closed : UnificationState, EffectRow, EffectRow, List EffectLabel, List EffectLabel, SourceSpan -> (Boolean, UnificationState)
  unify-row-both-closed (st) (a) (b) (only1) (only2) (span) =
   if list-length only1 == 0 & list-length only2 == 0 then (True, st)
   else (False, add-unify-error st cdx-row-mismatch (row-mismatch-msg a b) span)

  unify-row-open-closed : UnificationState, EffectRow, List EffectLabel, List EffectLabel, EffectRow, SourceSpan -> (Boolean, UnificationState)
  unify-row-open-closed (st) (open-r) (open-only) (closed-only) (closed-r) (span) =
   if list-length open-only /= 0 then (False, add-unify-error st cdx-row-mismatch (row-mismatch-msg open-r closed-r) span)
   else (True, add-row-subst st (open-r.tail-id) (make-row closed-only "" (-1)))

 row-union joins two ambient rows (the effects a compound expression
 performs = the union of what its parts perform). A representable
 row has at most one tail, so joining two open rows with distinct
 tails EQUATES them (bind t1 := {| t2}) -- the Koka shared-ambient
 move: every performing site inside one body ends up sharing one
 effect variable. That over-approximates (sound direction, section
 2) and never fails: both tails are unbound after resolution and
 distinct, so no occurs violation is possible. An empty operand
 returns the other unchanged -- the all-pure case allocates nothing.

  row-union : UnificationState, EffectRow, EffectRow -> (EffectRow, UnificationState)
  row-union (st) (r1) (r2) =
   let a = resolve-row st r1
   in let b = resolve-row st r2
   in if row-is-empty a then (b, st)
   else if row-is-empty b then (a, st)
   else if rows-identical a b then (a, st)
   else let merged = (a.labels) & (b.labels)
   in if a.tail-id < 0 then (make-row merged (b.tail-name) (b.tail-id), st)
   else if b.tail-id < 0 then (make-row merged (a.tail-name) (a.tail-id), st)
   else if a.tail-id == b.tail-id then (make-row merged (a.tail-name) (a.tail-id), st)
   else let st2 = add-row-subst st (a.tail-id) (deck-record (row-var (b.tail-id)))
   in (make-row merged (b.tail-name) (b.tail-id), st2)

  unify-row-open-open : UnificationState, EffectRow, EffectRow, List EffectLabel, List EffectLabel, SourceSpan -> (Boolean, UnificationState)
  unify-row-open-open (st) (a) (b) (only1) (only2) (span) =
   let (t3, st2) = fresh-row-id st
   in let bind-a = make-row only2 "" t3
   in let bind-b = make-row only1 "" t3
   in if row-occurs st2 (a.tail-id) bind-a 0 | row-occurs st2 (b.tail-id) bind-b 0
      then (False, add-unify-error st2 cdx-row-infinite "effect row would be infinite (a row variable absorbs itself)" span)
      else (True, add-row-subst (add-row-subst st2 (a.tail-id) bind-a) (b.tail-id) bind-b)

Section: Unify
 The `inv` flag threaded from here down means "this pair sits in a type
 ARGUMENT position", where `docs/DevelopersGuide.md` "Variance of Type
 Arguments" requires the two types to be the same rather than merely
 compatible. It is set at the argument positions below and never cleared,
 so nesting inside an argument stays invariant. Everything reached with it
 False keeps the assignability the language has always had.

  unify : UnificationState, CodexType, CodexType, SourceSpan -> (Boolean, UnificationState)
  unify (st) (a) (b) (span) =
   unify-at st a b span 0 False

  unify-at : UnificationState, CodexType, CodexType, SourceSpan, Integer, Boolean -> (Boolean, UnificationState)
  unify-at (st) (a) (b) (span) (depth) (inv) =
   if depth >= max-recursion-depth then (False, add-fuel-error st "unify" span)
   else let ra = strip-linear-ty (resolve-silent st a)
   in let rb = strip-linear-ty (resolve-silent st b)
   in unify-resolved st ra rb span (depth + 1) inv

  unify-resolved : UnificationState, CodexType, CodexType, SourceSpan, Integer, Boolean -> (Boolean, UnificationState)
  unify-resolved (st) (a) (b) (span) (depth) (inv) =
   if types-equal a b then (True, st)
   else when a
    is TypeVar (id-a) -> when b
     is TypeVar (id-b) ->
      if id-a < id-b
       then (True, add-subst st id-b a)
       else (True, add-subst st id-a b)
     is otherwise ->
      if occurs-in st id-a b 0 then (False, add-unify-error st cdx-infinite-type "Infinite type" span)
       else (True, add-subst st id-a b)
    is otherwise -> unify-rhs st a b span depth inv

  types-equal : CodexType, CodexType -> Boolean
  types-equal (a) (b) =
   when a
    is TypeVar (id-a) -> when b
     is TypeVar (id-b) -> id-a == id-b
     is otherwise -> False
    is IntegerTy (a-lo) (a-hi) (a-mode) -> when b
     is IntegerTy (b-lo) (b-hi) (b-mode) -> a-lo == b-lo & a-hi == b-hi
     is otherwise -> False
    is RealTy (a-w) (a-m) -> when b
     is RealTy (b-w) (b-m) -> real-width-eq a-w b-w & real-mode-eq a-m b-m
     is otherwise -> False
    is TextTy -> when b
     is TextTy -> True
     is otherwise -> False
    is BooleanTy -> when b
     is BooleanTy -> True
     is otherwise -> False
    is CharTy -> when b
     is CharTy -> True
     is otherwise -> False
    is NothingTy -> when b
     is NothingTy -> True
     is otherwise -> False
    is VoidTy -> when b
     is VoidTy -> True
     is otherwise -> False
    is ProofTy -> when b
     is ProofTy | PropEqTy (b1) (b2) -> True
     is otherwise -> False
    is PropEqTy (a1) (a2) -> when b
     is PropEqTy (b1) (b2) -> types-equal a1 b1 & types-equal a2 b2
     is ProofTy -> True
     is otherwise -> False
    is ErrorTy -> when b
     is ErrorTy -> True
     is otherwise -> False
    is UnitTy (na) (inner-a) -> when b
     is UnitTy (nb) (inner-b) -> na.value == nb.value & types-equal inner-a inner-b
     is otherwise -> False
    is VectorTy (na) (ta) -> when b
     is VectorTy (nb) (tb) -> na == nb & types-equal ta tb
     is otherwise -> False
    is VectorMaskTy (na) -> when b
     is VectorMaskTy (nb) -> na == nb
     is otherwise -> False
    is TypeCon (na) -> when b
     is TypeCon (nb) -> na.value == nb.value
     is otherwise -> False
    is TypeApply (fa) (aa) -> when b
     is TypeApply (fb) (ab) -> types-equal fa fb & types-equal aa ab
     is otherwise -> False
    is FunTy (pa) (rwa) (ra) -> when b
     is FunTy (pb) (rwb) (rb) -> types-equal pa pb & rows-identical rwa rwb & types-equal ra rb
     is otherwise -> False
    is ListTy (ea) -> when b
     is ListTy (eb) -> types-equal ea eb
     is otherwise -> False
    is LinkedListTy (ea) -> when b
     is LinkedListTy (eb) -> types-equal ea eb
     is otherwise -> False
    is LinearTy (ia) -> when b
     is LinearTy (ib) -> types-equal ia ib
     is otherwise -> False
    is ForAllTy (id-a) (body-a) -> when b
     is ForAllTy (id-b) (body-b) -> id-a == id-b & types-equal body-a body-b
     is otherwise -> False
    is ForAllEff (id-a) (body-a) -> when b
     is ForAllEff (id-b) (body-b) -> id-a == id-b & types-equal body-a body-b
     is otherwise -> False
    is SumTy (na) (args-a) (ctors-a) -> when b
     is SumTy (nb) (args-b) (ctors-b) -> na.value == nb.value & type-lists-equal args-a args-b
     is otherwise -> False
    is RecordTy (na) (args-a) (fields-a) -> when b
     is RecordTy (nb) (args-b) (fields-b) -> na.value == nb.value & type-lists-equal args-a args-b
     is otherwise -> False
    is ConstructedTy (na) (args-a) -> when b
     is ConstructedTy (nb) (args-b) -> na.value == nb.value & type-lists-equal args-a args-b
     is otherwise -> False
    is EffectfulTy (ea) (sa) (ia) -> when b
     is EffectfulTy (eb) (sb) (ib) -> name-sets-equal ea eb & types-equal ia ib
     is otherwise -> False
    is otherwise -> False

  type-lists-equal : List CodexType, List CodexType -> Boolean
  type-lists-equal (xs) (ys) =
   if list-length xs /= list-length ys then False
   else type-lists-equal-loop xs ys 0 (list-length xs)

  type-lists-equal-loop : List CodexType, List CodexType, Integer, Integer -> Boolean
  type-lists-equal-loop (xs) (ys) (i) (len) =
   if i == len then True
   else if types-equal (list-at xs i) (list-at ys i) then type-lists-equal-loop xs ys (i + 1) len
   else False

  unify-rhs : UnificationState, CodexType, CodexType, SourceSpan, Integer, Boolean -> (Boolean, UnificationState)
  unify-rhs (st) (a) (b) (span) (depth) (inv) =
   when b
    is TypeVar (id-b) ->
     if occurs-in st id-b a 0 then (False, add-unify-error st cdx-infinite-type "Infinite type" span)
      else (True, add-subst st id-b a)
    is otherwise -> unify-structural st a b span depth inv

 The integer arm is where every widening in the language is actually
 admitted, and at a non-argument position it stays exactly as it was:
 either range inside the other, or merely OVERLAPPING, is accepted. In an
 argument position the bounds must match. Overflow mode is not compared in
 either branch, which is pre-existing and is a separate question from
 variance.

  unify-structural : UnificationState, CodexType, CodexType, SourceSpan, Integer, Boolean -> (Boolean, UnificationState)
  unify-structural (st) (a) (b) (span) (depth) (inv) =
   when a
    is IntegerTy (a-lo) (a-hi) (a-mode) -> when b
     is IntegerTy (b-lo) (b-hi) (b-mode) ->
      if inv then
       if a-lo == b-lo & a-hi == b-hi then (True, st) else unify-mismatch st a b span
      else if a-lo >= b-lo & a-hi <= b-hi then (True, st)
      else if b-lo >= a-lo & b-hi <= a-hi then (True, st)
      else if a-lo <= b-hi & b-lo <= a-hi then (True, st)
      else unify-mismatch st a b span
     is UnitTy (nb) (inner-b) -> unify-at st a inner-b span (depth + 1) inv
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is RealTy (a-w) (a-m) -> when b
     is RealTy (b-w) (b-m) ->
      if real-width-eq a-w b-w & real-mode-eq a-m b-m then (True, st)
      else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is UnitTy (nb) (inner-b) -> unify-at st a inner-b span (depth + 1) inv
     is otherwise -> unify-mismatch st a b span
    is TextTy -> when b
     is TextTy | ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is BooleanTy -> when b
     is BooleanTy | ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is NothingTy -> when b
     is NothingTy | ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is VoidTy -> when b
     is VoidTy | ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is ProofTy -> when b
     is ProofTy | PropEqTy (b1) (b2) | ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is PropEqTy (a1) (a2) -> when b
     is PropEqTy (b1) (b2) ->
      let (ok1, st1) = unify-at st a1 b1 span (depth + 1) inv
      in if ok1 then unify-at st1 a2 b2 span (depth + 1) inv
         else (ok1, st1)
     is ProofTy | ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is ErrorTy -> (True, st)
    is FunTy (pa) (rwa) (ra) -> when b
     is FunTy (pb) (rwb) (rb) -> unify-fun st pa rwa ra pb rwb rb span depth inv
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is EffectfulTy (ea) (sa) (ia) -> when b
     is EffectfulTy (eb) (sb) (ib) ->
      if name-sets-equal ea eb then unify-at st ia ib span (depth + 1) inv
      else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is ListTy (ea) -> when b
     is ListTy (eb) | LinkedListTy (eb) -> unify-at st ea eb span (depth + 1) True
     is TypeApply (fb) (ab) -> let (ok1, st1) = unify-at st (deck-record (TypeCon (Name { value = "List" }))) fb span (depth + 1) inv in if ok1 then unify-at st1 ea ab span (depth + 1) True else (ok1, st1)
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is LinkedListTy (ea) -> when b
     is LinkedListTy (eb) | ListTy (eb) -> unify-at st ea eb span (depth + 1) True
     is TypeApply (fb) (ab) -> let (ok1, st1) = unify-at st (deck-record (TypeCon (Name { value = "LinkedList" }))) fb span (depth + 1) inv in if ok1 then unify-at st1 ea ab span (depth + 1) True else (ok1, st1)
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is ConstructedTy (na) (args-a) -> when b
     is ConstructedTy (nb) (args-b) ->
      if na.value == nb.value then unify-constructed-args st args-a args-b 0 (list-length args-a) span depth
       else unify-mismatch st a b span
     is SumTy (sb-name) (sb-args) (sb-ctors) ->
      if na.value == sb-name.value then unify-constructed-args st args-a sb-args 0 (list-length args-a) span depth
      else unify-mismatch st a b span
     is RecordTy (rb-name) (rb-args) (rb-fields) ->
      if na.value == rb-name.value then unify-constructed-args st args-a rb-args 0 (list-length args-a) span depth
      else unify-mismatch st a b span
     is TypeApply (fb) (ab) -> if list-length args-a >= 1 then unify-ctor-apply-peel st na args-a fb ab span depth inv else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is SumTy (sa-name) (sa-args) (sa-ctors) -> when b
     is SumTy (sb-name) (sb-args) (sb-ctors) ->
      if sa-name.value == sb-name.value then unify-constructed-args st sa-args sb-args 0 (list-length sa-args) span depth
      else unify-mismatch st a b span
     is ConstructedTy (nb) (args-b) ->
      if sa-name.value == nb.value then unify-constructed-args st sa-args args-b 0 (list-length sa-args) span depth
      else unify-mismatch st a b span
     is TypeApply (fb) (ab) -> if list-length sa-args == 1 then let (ok1, st1) = unify-at st (deck-record (TypeCon sa-name)) fb span (depth + 1) inv in if ok1 then unify-at st1 (list-at sa-args 0) ab span (depth + 1) True else (ok1, st1) else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is RecordTy (ra-name) (ra-args) (ra-fields) -> when b
     is RecordTy (rb-name) (rb-args) (rb-fields) ->
      if ra-name.value == rb-name.value then unify-constructed-args st ra-args rb-args 0 (list-length ra-args) span depth
      else unify-mismatch st a b span
     is ConstructedTy (nb) (args-b) ->
      if ra-name.value == nb.value then unify-constructed-args st ra-args args-b 0 (list-length ra-args) span depth
      else unify-mismatch st a b span
     is TypeApply (fb) (ab) -> if list-length ra-args == 1 then let (ok1, st1) = unify-at st (deck-record (TypeCon ra-name)) fb span (depth + 1) inv in if ok1 then unify-at st1 (list-at ra-args 0) ab span (depth + 1) True else (ok1, st1) else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is ForAllTy (id) (body) -> unify-at st body b span (depth + 1) inv
    is ForAllEff (id) (body) -> unify-at st body b span (depth + 1) inv
    is UnitTy (na) (inner-a) -> when b
     is UnitTy (nb) (inner-b) ->
      unify-at st inner-a inner-b span (depth + 1) inv
     is ErrorTy -> (True, st)
     is otherwise -> unify-at st inner-a b span (depth + 1) inv
    is VectorTy (na) (ta) -> when b
     is VectorTy (nb) (tb) ->
      if na == nb | na < 0 | nb < 0 then unify-at st ta tb span (depth + 1) True
      else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is VectorMaskTy (na) -> when b
     is VectorMaskTy (nb) ->
      if na == nb then (True, st)
      else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is TypeCon (na) -> when b
     is TypeCon (nb) -> if na.value == nb.value then (True, st) else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is TypeApply (fa) (aa) -> when b
     is TypeApply (fb) (ab) -> let (ok1, st1) = unify-at st fa fb span (depth + 1) inv in if ok1 then unify-at st1 aa ab span (depth + 1) True else (ok1, st1)
     is ListTy (eb) -> let (ok1, st1) = unify-at st fa (deck-record (TypeCon (Name { value = "List" }))) span (depth + 1) inv in if ok1 then unify-at st1 aa eb span (depth + 1) True else (ok1, st1)
     is LinkedListTy (eb) -> let (ok1, st1) = unify-at st fa (deck-record (TypeCon (Name { value = "LinkedList" }))) span (depth + 1) inv in if ok1 then unify-at st1 aa eb span (depth + 1) True else (ok1, st1)
     is ConstructedTy (nb) (args-b) -> if list-length args-b >= 1 then unify-ctor-apply-peel st nb args-b fa aa span depth inv else unify-mismatch st a b span
     is SumTy (sb-name) (sb-args) (sb-ctors) -> if list-length sb-args == 1 then let (ok1, st1) = unify-at st fa (deck-record (TypeCon sb-name)) span (depth + 1) inv in if ok1 then unify-at st1 aa (list-at sb-args 0) span (depth + 1) True else (ok1, st1) else unify-mismatch st a b span
     is RecordTy (rb-name) (rb-args) (rb-fields) -> if list-length rb-args == 1 then let (ok1, st1) = unify-at st fa (deck-record (TypeCon rb-name)) span (depth + 1) inv in if ok1 then unify-at st1 aa (list-at rb-args 0) span (depth + 1) True else (ok1, st1) else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is otherwise -> when b
     is UnitTy (nb) (inner-b) -> unify-at st a inner-b span (depth + 1) inv
     is TypeApply (fb) (ab) -> unify-at st b a span (depth + 1) inv
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span

 unify-constructed-args and unify-cargs-loop take no inv parameter because
 every pair they compare is a type argument by construction, so they pass
 True unconditionally.

  unify-constructed-args : UnificationState, List CodexType, List CodexType, Integer, Integer, SourceSpan, Integer -> (Boolean, UnificationState)
  unify-constructed-args (st) (args-a) (args-b) (i) (len) (span) (depth) =
   if len /= list-length args-b then (False, add-unify-error st cdx-type-mismatch "Type mismatch: type constructor applied at different arities" span)
   else unify-cargs-loop st args-a args-b i len span depth

  unify-cargs-loop : UnificationState, List CodexType, List CodexType, Integer, Integer, SourceSpan, Integer -> (Boolean, UnificationState)
  unify-cargs-loop (st) (args-a) (args-b) (i) (len) (span) (depth) =
   if i == len then (True, st)
   else let (ok, st1) = unify-at st (list-at args-a i) (list-at args-b i) span (depth + 1) True
   in if ok then unify-cargs-loop st1 args-a args-b (i + 1) len span depth
        else (ok, st1)

  unify-ctor-apply-peel : UnificationState, Name, List CodexType, CodexType, CodexType, SourceSpan, Integer, Boolean -> (Boolean, UnificationState)
  unify-ctor-apply-peel (st) (name) (args) (fb) (ab) (span) (depth) (inv) =
   let n = list-length args
   in if n == 1
    then let (ok1, st1) = unify-at st (deck-record (TypeCon name)) fb span (depth + 1) inv
      in if ok1 then unify-at st1 (list-at args 0) ab span (depth + 1) True else (ok1, st1)
    else let head-ty = deck-record (ConstructedTy name (ctype-list-take args 0 (n - 1) []))
      in let (ok1, st1) = unify-at st head-ty fb span (depth + 1) inv
      in if ok1 then unify-at st1 (list-at args (n - 1)) ab span (depth + 1) True else (ok1, st1)

  ctype-list-take : List CodexType, Integer, Integer, List CodexType -> List CodexType
  ctype-list-take (xs) (i) (k) (acc) =
   if i == k then acc
   else ctype-list-take xs (i + 1) k (list-push acc (list-at xs i))

  unify-fun : UnificationState, CodexType, EffectRow, CodexType, CodexType, EffectRow, CodexType, SourceSpan, Integer, Boolean -> (Boolean, UnificationState)
  unify-fun (st) (pa) (rwa) (ra) (pb) (rwb) (rb) (span) (depth) (inv) =
   let (ok1, st1) = unify-at st pa pb span (depth + 1) inv
   in if ok1 then
       let (ok2, st2) = unify-row st1 rwa rwb span
       in if ok2 then unify-at st2 ra rb span (depth + 1) inv
          else (ok2, st2)
      else (ok1, st1)

  name-sets-equal : List Name, List Name -> Boolean
  name-sets-equal (xs) (ys) =
   names-all-in xs ys 0 (list-length xs) & names-all-in ys xs 0 (list-length ys)

  names-all-in : List Name, List Name, Integer, Integer -> Boolean
  names-all-in (xs) (ys) (i) (len) =
   if i == len then True
   else if name-list-has ys ((list-at xs i).value) then names-all-in xs ys (i + 1) len
   else False

  unify-mismatch : UnificationState, CodexType, CodexType, SourceSpan -> (Boolean, UnificationState)
  unify-mismatch (st) (a) (b) (span) =
   let base = "Type mismatch: " & type-desc a & " vs " & type-desc b
   in (False, add-unify-error st cdx-type-mismatch (base & (ctor-as-type-hint a & ctor-as-type-hint b)) span)

  ctor-as-type-hint : CodexType -> Text
  ctor-as-type-hint (ty) =
   when ty
    is ConstructedTy (name) (args) ->
     if list-length args == 0 & is-maybe-value-ctor (name.value)
      then " (note: '" & name.value & "' is a Maybe value constructor, not a type; an effectful procedure returns 'Nothing', and the empty Maybe value is 'None')"
      else ""
    is otherwise -> ""

  is-maybe-value-ctor : Text -> Boolean
  is-maybe-value-ctor (n) =
   if n == "None" then True
   else if n == "Just" then True
   else False

 The bounds are printed only when they are narrower than the default,
 because "Integer vs Integer" is what this message said for every bounded
 mismatch and it names neither side. Invariance of type arguments makes
 that pair common, and locating one such error in the compiler's own
 57,000 lines cost a full diagnostic cycle against a message that could
 have answered it.

  int-bounds-desc : Integer, Integer -> Text
  int-bounds-desc (lo) (hi) =
   if lo == i64-min & hi == i64-max then ""
   else " between " & integer-to-text lo & " and " & integer-to-text hi

  type-desc : CodexType -> Text
  type-desc (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> "Integer" & int-bounds-desc lo hi
    is RealTy (w) (m) -> "Real" & real-width-suffix w & real-mode-suffix m
    is TextTy -> "Text"
    is BooleanTy -> "Boolean"
    is CharTy -> "Char"
    is VoidTy -> "Void"
    is NothingTy -> "Nothing"
    is ErrorTy -> "Error"
    is NoExpectTy -> "NoExpect"
    is FunTy (p) (row) (r) -> "Fun"
    is ListTy (e) -> "List"
    is LinkedListTy (e) -> "LinkedList"
    is TypeVar (id) -> "T" & integer-to-text id
    is ForAllTy (id) (body) -> "ForAll"
    is ForAllEff (id) (body) -> "ForAllEff"
    is EffectfulTy (effs) (sc) (ret) -> "Effectful"
    is ProofTy -> "Proof"
    is PropEqTy (a) (b) -> "PropEq[" & type-desc a & "," & type-desc b & "]"
    is ConstructedTy (name) (args) -> if list-length args == 0 then "Con:" & name.value
                                       else "Con:" & name.value & "[" & type-desc-args args 0 & "]"
    is RecordTy (name) (args) (fields) -> if list-length args == 0 then "Rec:" & name.value
                                          else "Rec:" & name.value & "[" & type-desc-args args 0 & "]"
    is SumTy (name) (args) (ctors) -> if list-length args == 0 then "Sum:" & name.value
                                       else "Sum:" & name.value & "[" & type-desc-args args 0 & "]"
    is UnitTy (name) (inner) -> "Unit:" & name.value
    is VectorTy (vn) (vt) -> "Vector " & integer-to-text vn & " " & type-desc vt
    is VectorMaskTy (n) -> "VectorMask " & integer-to-text n
    is TypeCon (name) -> "TCon:" & name.value
    is TypeApply (f) (a) -> "App[" & type-desc f & " " & type-desc a & "]"
    is LinearTy (inner) -> "linear " & type-desc inner

  type-desc-args : List CodexType, Integer -> Text
  type-desc-args (args) (i) =
   if i >= list-length args then ""
   else let prefix = if i == 0 then "" else ", "
   in prefix & type-desc (list-at args i) & type-desc-args args (i + 1)

Section: Deep Resolve

  ty-has-typevars : CodexType -> Boolean
  ty-has-typevars (ty) =
   when ty
    is TypeVar (id) -> True
    is otherwise -> codex-type-fold-children ty-has-typevars-fold ty False

  ty-has-typevars-fold : CodexType, Boolean -> Boolean
  ty-has-typevars-fold (c) (acc) =
   if acc then True else ty-has-typevars c

  deep-resolve : UnificationState, CodexType -> CodexType
  deep-resolve (st) (ty) =
   if ty-has-typevars ty then deep-resolve-at st ty 0
   else ty

  deep-resolve-at : UnificationState, CodexType, Integer -> CodexType
  deep-resolve-at (st) (ty) (depth) =
   if depth >= max-recursion-depth then ty
   else let resolved = resolve-silent st ty
   in if ty-has-typevars resolved == False then resolved
   else when resolved
    is SumTy (name) (args) (ctors) -> deck-record (SumTy name (for a in args -> deep-resolve-at st a (depth + 1)) ctors)
    is TypeApply (tf) (ta) -> reduce-type-apply (deep-resolve-at st tf (depth + 1)) (deep-resolve-at st ta (depth + 1))
    is otherwise -> codex-type-map-children (\c -> deep-resolve-at st c (depth + 1)) resolved

  reduce-type-apply : CodexType, CodexType -> CodexType
  reduce-type-apply (f) (a) =
   when f
    is TypeCon (name) -> if name.value == "List" then deck-record (ListTy a) else if name.value == "LinkedList" then deck-record (LinkedListTy a) else deck-record (ConstructedTy name [a])
    is otherwise -> deck-record (TypeApply f a)

Section: Deep Type Copy

 A memoized structural deep copy of type graphs onto the CURRENT
 allocator (call inside deck-record to land copies on a deck).
 deep-resolve above SHARES every subtree that contains no type
 variables, so resolved binding and expr-type graphs still point
 into the scratch arena the checker worked in (check-all-defs runs
 deck-exited), and the check compact poisons that scratch under the
 survivors' feet. The memo table (open addressing, key32/val32
 slots, Fibonacci top-bits index) maps each source box address to
 its copy, so sharing topology is preserved and the copy volume is
 the unique-box count, not the unshared traversal count (measured
 9x larger on the selfhost - an unmemoized copy exhausts the heap).
 Copies are read back through four typed side lists; a slot value
 is index+1 into its kind's list. A slot is claimed BEFORE children
 are copied, so a cycle back-edge finds value 0 and receives the
 ORIGINAL pointer instead of recursing forever. Boxes below the memo
 FLOOR (the keep reservation base) are SHARED, not copied: nothing
 rewinds R10 below the keep after the check compact, so parse- and
 scope-era Texts, Names and type boxes - the bulk of the population
 - survive in place and only check-era boxes are materialized into
 the keep. A degraded path (probe fuel exhausted, side list at
 capacity, tag out of range, depth cap) returns the original box
 unchanged for Texts, Names, rows and the four list kinds;
 `mcopy-type` answers `ErrorTy` on its unsafe escapes instead, because a
 CodexType handed back into scratch is the one that reached codegen.
 That is never wrong for one box, but it is NOT merely
 less deduplicated in aggregate: a saturated address memo makes
 every re-visit of a shared subtree a fresh unmemoized copy, the
 re-copies feed fresh addresses into the cons keys of every parent
 list so the content layer stops matching too, and the copy volume
 explodes combinatorially - measured 95 MB of keep deck for a graph
 whose memoized copy is 0.17 MB (measured on ShellBuild). The
 table is therefore sized from the CHECK deck's measured usage -
 the population the memo actually keys is address-distinct boxes,
 not post-dedup contents - and mc-ceiling is the second line: a
 copy entry that would allocate once the keep frontier has climbed
 past the ceiling shares the original instead (`mcopy-type` answers
 `ErrorTy` there), and the caller raises CDX9002 for the phase by
 comparing the keep deck's measured end against mc-ceiling. That
 comparison is calibrated: forced below the measured keep use it
 raises CDX9002 naming CHECK-KEEP, forced above it the same edited
 line raises nothing. A shared original is a pointer into scratch the
 caller is about to reclaim, so the phase must not be allowed to
 succeed once one has been handed out. The copy must never write
 past its reservation into the scratch it is still reading; that
 silent breach is how ShellBuild died with no diagnostic. The interned
 empty-row is preserved so arrows keep sharing one empty row.
 Null-tolerant (calloc-zero fields pass through unchanged).

  MemoCtx = record {
   mc-table : Integer,
   mc-slots : Integer,
   mc-shift : Integer,
   mc-floor : Integer,
   mc-ty : List CodexType,
   mc-text : List Text,
   mc-name : List Name,
   mc-row : List EffectRow,
   mc-tylist : List (List CodexType),
   mc-fieldlist : List (List RecordField),
   mc-ctorlist : List (List SumCtor),
   mc-labellist : List (List EffectLabel),
   mc-cons : Integer,
   mc-cons-slots : Integer,
   mc-cons-shift : Integer,
   mc-cap-ty : Integer,
   mc-cap-text : Integer,
   mc-cap-name : Integer,
   mc-cap-row : Integer,
   mc-cap-list : Integer,
   mc-ceiling : Integer,
   mc-tcons : Integer,
   mc-tcons-slots : Integer,
   mc-tcons-shift : Integer
  }

 The text layer. The address memo is reset every batch of the CHECK walk,
 so a text the memo alone deduplicated would be copied again on every batch
 that mentions it, and a Name's key mixes its text's address, so every label,
 row and list above it would stop matching too. This table keys a text by
 its CONTENT, 16-byte slots like the cons layer, and it persists for the
 phase: a hit is verified by comparing the characters, so a key collision
 costs a copy and never a wrong text.

  text-content-key : Text -> Integer
  text-content-key (t) =
   cons-norm (text-content-key-loop t 0 (text-length t) (cons-mix 801 (text-length t)))

  text-content-key-loop : Text, Integer, Integer, Integer -> Integer
  text-content-key-loop (t) (i) (len) (acc) =
   if i == len then acc
   else text-content-key-loop t (i + 1) len (cons-mix acc (char-code-at t i))

  tcons-probe : Integer, MemoCtx -> Integer
  tcons-probe (k) (mc) =
   if mc.mc-tcons == 0 then 0
   else cons-probe-at k (mc.mc-tcons) (mc.mc-tcons-slots) (bit-shru (k * 2177342782468422677) (mc.mc-tcons-shift)) 64

  tcons-lookup : Integer, Text, MemoCtx -> Integer
  tcons-lookup (k) (t) (mc) =
   let slot = tcons-probe k mc
   in if slot == 0 then 0
   else if peek-qword slot 0 /= k then 0
   else let v = peek-32 (slot + 8) 0
   in if v == 0 then 0
   else if text-compare (list-at (mc.mc-text) (v - 1)) t == 0 then v
   else 0

  memo-pow2-at-least : Integer, Integer -> Integer
  memo-pow2-at-least (n) (p) =
   if p >= n then p else memo-pow2-at-least n (p * 2)

  memo-shift-for : Integer, Integer -> Integer
  memo-shift-for (p) (s) =
   if p <= 1 then s else memo-shift-for (p / 2) (s - 1)

  memo-probe : Integer, MemoCtx -> Integer
  memo-probe (a) (mc) =
   let h = a * 2177342782468422677
   in memo-probe-at a (mc.mc-table) (mc.mc-slots) (bit-shru h (mc.mc-shift)) 64

  memo-probe-at : Integer, Integer, Integer, Integer, Integer -> Integer
  memo-probe-at (a) (table) (slots) (idx) (fuel) =
   if fuel == 0 then 0
   else let slot = table + idx * 8
   in let k = bit-and (peek-32 slot 0) 4294967295
   in if k == bit-and a 4294967295 then slot
   else if k == 0 then slot
   else memo-probe-at a table slots (if idx + 1 == slots then 0 else idx + 1) (fuel - 1)

  memo-slot-key : Integer -> Integer
  memo-slot-key (slot) = bit-and (peek-32 slot 0) 4294967295

 The cons layer. The address memo above deduplicates by SOURCE box;
 the checker's AST-to-CodexType conversion materializes a full
 distinct structure per mention, so address identity recovers almost
 nothing across mentions. The cons table deduplicates by CONTENT: a
 64-bit key mixed from a node's tag, scalars, and the addresses of
 its ALREADY-CANONICAL children (each key function canonicalizes
 children through mcopy before mixing, so structurally equal trees
 cascade to equal keys bottom-up with no construction on the hit
 path). Slots are 16 bytes: the full 64-bit key plus a 32-bit
 index+1 into the kind's side list. Hits compare the FULL key - at
 half a million keys the 64-bit collision probability is on the
 order of 1e-8 per compile, below hardware error rates, and the
 fixed-point, battery and poison gates stand behind it. Every
 degraded path (probe fuel, side list at capacity) constructs a
 private copy - never wrong, only less deduplicated. OverflowMode
 is keyed by ordinal, never by box address (a fresh mode box per
 copy would make every IntegerTy key unique).

  cons-mix : Integer, Integer -> Integer
  cons-mix (h) (v) = h * 1099511628211 + v

  cons-norm : Integer -> Integer
  cons-norm (k) = if k == 0 then 1 else k

  cons-probe : Integer, MemoCtx -> Integer
  cons-probe (k) (mc) =
   cons-probe-at k (mc.mc-cons) (mc.mc-cons-slots) (bit-shru (k * 2177342782468422677) (mc.mc-cons-shift)) 64

  cons-probe-at : Integer, Integer, Integer, Integer, Integer -> Integer
  cons-probe-at (k) (table) (slots) (idx) (fuel) =
   if fuel == 0 then 0
   else let slot = table + idx * 16
   in let cur = peek-qword slot 0
   in if cur == k then slot
   else if cur == 0 then slot
   else cons-probe-at k table slots (if idx + 1 == slots then 0 else idx + 1) (fuel - 1)

  cons-slot-set : Integer, Integer, Integer -> Integer
  cons-slot-set (slot) (k) (v) =
   let vlo = poke-32 slot 0 (bit-and k 4294967295)
   in let vhi = poke-32 (slot + 4) 0 (bit-shru k 32)
   in poke-32 (slot + 8) 0 v

  mode-ordinal : OverflowMode -> Integer
  mode-ordinal (m) =
   if address-of m == 0 then 0
   else when m
    is OvError -> 1
    is OvWrapping -> 2
    is OvClamping -> 3

  real-width-ordinal : RealWidth -> Integer
  real-width-ordinal (w) =
   if address-of w == 0 then 0
   else when w
    is RwF64 -> 1
    is RwF32 -> 2

  real-mode-ordinal : RealMode -> Integer
  real-mode-ordinal (m) =
   if address-of m == 0 then 0
   else when m
    is RmDefault -> 1
    is RmTrapping -> 2
    is RmSaturating -> 3

  real-width-suffix : RealWidth -> Text
  real-width-suffix (w) =
   when w
    is RwF32 -> " approximate"
    is otherwise -> ""

  real-mode-suffix : RealMode -> Text
  real-mode-suffix (m) =
   when m
    is RmTrapping -> " trapping"
    is RmSaturating -> " saturating"
    is otherwise -> ""

 A CodexType box carries its constructor index in its first word, and there
 are 27 of them, so a first word outside 0..28 is not a CodexType. Returning
 the argument in that case hands the caller a pointer into scratch it is about
 to reclaim, and the value is already known to be wrong; ErrorTy is a defined
 value the rest of the compiler already understands.

  mcopy-text : Text, MemoCtx -> Text
  mcopy-text (t) (mc) =
   let a = address-of t
   in if a == 0 then t
   else if a < mc.mc-floor then t
   else if __heap-save >= mc.mc-ceiling then t
   else mcopy-text-memo t a (memo-probe a mc) mc

  mcopy-text-memo : Text, Integer, Integer, MemoCtx -> Text
  mcopy-text-memo (t) (a) (slot) (mc) =
   if slot == 0 then mcopy-text-content t 0 mc
   else if memo-slot-key slot == bit-and a 4294967295 then mcopy-text-hit t slot mc
   else mcopy-text-fresh t a slot mc

  mcopy-text-hit : Text, Integer, MemoCtx -> Text
  mcopy-text-hit (t) (slot) (mc) =
   let v = peek-32 slot 4
   in if v == 0 then t else list-at (mc.mc-text) (v - 1)

 A saturated side list leaves the memo slot claimed with no value, and a
 later mention of the same address would then read that as a cycle and hand
 back the ORIGINAL, which under the batched walk is a pointer into scratch
 about to be rewound. Every fresh path unclaims its slot on saturation, so
 the next mention copies again instead: less deduplicated, never dangling.

  memo-unclaim : Integer -> Integer
  memo-unclaim (slot) = poke-32 slot 0 0

  mcopy-text-fresh : Text, Integer, Integer, MemoCtx -> Text
  mcopy-text-fresh (t) (a) (slot) (mc) =
   let claimed = poke-32 slot 0 a
   in mcopy-text-content t slot mc

  mcopy-text-content : Text, Integer, MemoCtx -> Text
  mcopy-text-content (t) (slot) (mc) =
   let k = text-content-key t
   in let v = tcons-lookup k t mc
   in if v /= 0 then mcopy-text-adopt slot v mc
   else let copy = substring t 0 (text-length t)
   in let n = list-length (mc.mc-text)
   in if n >= mc.mc-cap-text then let un = if slot == 0 then 0 else memo-unclaim slot in copy
   else let pushed = list-push (mc.mc-text) copy
   in let vset = if slot == 0 then 0 else poke-32 slot 4 (n + 1)
   in let tslot = tcons-probe k mc
   in let w = if tslot == 0 then 0 else cons-slot-set tslot k (n + 1)
   in copy

  mcopy-text-adopt : Integer, Integer, MemoCtx -> Text
  mcopy-text-adopt (slot) (v) (mc) =
   let aset = if slot == 0 then 0 else poke-32 slot 4 v
   in list-at (mc.mc-text) (v - 1)

  mcopy-texts : List Text, MemoCtx -> List Text
  mcopy-texts (ts) (mc) =
   let a = address-of ts
   in if a == 0 then ts
   else if a < mc.mc-floor then ts
   else for t in ts -> mcopy-text t mc

  mcopy-name : Name, MemoCtx -> Name
  mcopy-name (nm) (mc) =
   let a = address-of nm
   in if a == 0 then nm
   else if a < mc.mc-floor then nm
   else if __heap-save >= mc.mc-ceiling then nm
   else mcopy-name-memo nm a (memo-probe a mc) mc

  mcopy-name-memo : Name, Integer, Integer, MemoCtx -> Name
  mcopy-name-memo (nm) (a) (slot) (mc) =
   if slot == 0 then Name { value = mcopy-text (nm.value) mc }
   else if memo-slot-key slot == bit-and a 4294967295 then mcopy-name-hit nm slot mc
   else mcopy-name-fresh nm a slot mc

  mcopy-name-hit : Name, Integer, MemoCtx -> Name
  mcopy-name-hit (nm) (slot) (mc) =
   let v = peek-32 slot 4
   in if v == 0 then nm else list-at (mc.mc-name) (v - 1)

  mcopy-name-fresh : Name, Integer, Integer, MemoCtx -> Name
  mcopy-name-fresh (nm) (a) (slot) (mc) =
   let claimed = poke-32 slot 0 a
   in let tv = mcopy-text (nm.value) mc
   in let k = cons-norm (cons-mix 701 (address-of tv))
   in let v = cons-lookup k mc
   in if v /= 0 then mcopy-name-adopt slot v mc
   else let copy = Name { value = tv }
   in let n = list-length (mc.mc-name)
   in if n >= mc.mc-cap-name then let un = memo-unclaim slot in copy
   else let pushed = list-push (mc.mc-name) copy
   in let vset = poke-32 slot 4 (n + 1)
   in let cslot = cons-probe k mc
   in let w = if cslot == 0 then 0 else cons-slot-set cslot k (n + 1)
   in copy

  mcopy-name-adopt : Integer, Integer, MemoCtx -> Name
  mcopy-name-adopt (slot) (v) (mc) =
   let aset = poke-32 slot 4 v
   in list-at (mc.mc-name) (v - 1)

  mcopy-names : List Name, MemoCtx -> List Name
  mcopy-names (ns) (mc) =
   let a = address-of ns
   in if a == 0 then ns
   else if a < mc.mc-floor then ns
   else for nm in ns -> mcopy-name nm mc

  mcopy-row : EffectRow, MemoCtx -> EffectRow
  mcopy-row (row) (mc) =
   let a = address-of row
   in if a == 0 then row
   else if row-is-empty row then empty-row
   else if a < mc.mc-floor then row
   else if __heap-save >= mc.mc-ceiling then row
   else mcopy-row-memo row a (memo-probe a mc) mc

  mcopy-row-memo : EffectRow, Integer, Integer, MemoCtx -> EffectRow
  mcopy-row-memo (row) (a) (slot) (mc) =
   if slot == 0 then mcopy-row-node row mc
   else if memo-slot-key slot == bit-and a 4294967295 then mcopy-row-hit row slot mc
   else mcopy-row-fresh row a slot mc

  mcopy-row-hit : EffectRow, Integer, MemoCtx -> EffectRow
  mcopy-row-hit (row) (slot) (mc) =
   let v = peek-32 slot 4
   in if v == 0 then row else list-at (mc.mc-row) (v - 1)

  mcopy-row-fresh : EffectRow, Integer, Integer, MemoCtx -> EffectRow
  mcopy-row-fresh (row) (a) (slot) (mc) =
   let claimed = poke-32 slot 0 a
   in let k = cons-norm (mkey-row row mc)
   in let v = cons-lookup k mc
   in if v /= 0 then mcopy-row-adopt slot v mc
   else let copy = mcopy-row-node row mc
   in let v2 = cons-lookup k mc
   in if v2 /= 0 then mcopy-row-adopt slot v2 mc
   else let n = list-length (mc.mc-row)
   in if n >= mc.mc-cap-row then let un = memo-unclaim slot in copy
   else let pushed = list-push (mc.mc-row) copy
   in let aset = poke-32 slot 4 (n + 1)
   in let cslot = cons-probe k mc
   in let w = if cslot == 0 then 0 else cons-slot-set cslot k (n + 1)
   in copy

  mcopy-row-adopt : Integer, Integer, MemoCtx -> EffectRow
  mcopy-row-adopt (slot) (v) (mc) =
   let aset = poke-32 slot 4 v
   in list-at (mc.mc-row) (v - 1)

  mkey-row : EffectRow, MemoCtx -> Integer
  mkey-row (row) (mc) =
   cons-mix (cons-mix (cons-mix 601 (address-of (mcopy-labels (row.labels) mc))) (row.tail-id)) (mkey-textlen (row.tail-name))

  mcopy-row-node : EffectRow, MemoCtx -> EffectRow
  mcopy-row-node (row) (mc) =
   EffectRow { labels = mcopy-labels (row.labels) mc, tail-name = mcopy-text (row.tail-name) mc, tail-id = row.tail-id }

  mcopy-labels : List EffectLabel, MemoCtx -> List EffectLabel
  mcopy-labels (ls) (mc) =
   let a = address-of ls
   in if a == 0 then ls
   else if a < mc.mc-floor then ls
   else if __heap-save >= mc.mc-ceiling then ls
   else let k = cons-norm (mkey-labels ls mc)
   in let v = cons-lookup k mc
   in if v /= 0 then list-at (mc.mc-labellist) (v - 1)
   else mcopy-labels-insert ls k mc

  mcopy-labels-insert : List EffectLabel, Integer, MemoCtx -> List EffectLabel
  mcopy-labels-insert (ls) (k) (mc) =
   let copy = mcopy-labels-node ls mc
   in let v2 = cons-lookup k mc
   in if v2 /= 0 then list-at (mc.mc-labellist) (v2 - 1)
   else let cslot = cons-probe k mc
   in if cslot == 0 then copy
   else let n = list-length (mc.mc-labellist)
   in if n >= mc.mc-cap-list then copy
   else let pushed = list-push (mc.mc-labellist) copy
   in let w = cons-slot-set cslot k (n + 1)
   in copy

  mcopy-labels-node : List EffectLabel, MemoCtx -> List EffectLabel
  mcopy-labels-node (ls) (mc) =
   for l in ls -> EffectLabel { name = mcopy-name (l.name) mc, scope = mcopy-text (l.scope) mc }

  mkey-labels : List EffectLabel, MemoCtx -> Integer
  mkey-labels (ls) (mc) =
   mkey-labels-loop ls 0 (list-length ls) mc (cons-mix 401 (list-length ls))

  mkey-labels-loop : List EffectLabel, Integer, Integer, MemoCtx, Integer -> Integer
  mkey-labels-loop (ls) (i) (len) (mc) (acc) =
   if i == len then acc
   else let l = list-at ls i
   in mkey-labels-loop ls (i + 1) len mc (cons-mix (cons-mix acc (address-of (mcopy-name (l.name) mc))) (address-of (mcopy-text (l.scope) mc)))

  mcopy-rows : List EffectRow, MemoCtx -> List EffectRow
  mcopy-rows (rs) (mc) =
   if address-of rs == 0 then rs
   else for r in rs -> mcopy-row r mc

  mcopy-mode : OverflowMode -> OverflowMode
  mcopy-mode (m) =
   if address-of m == 0 then m
   else when m
    is OvError -> OvError
    is OvWrapping -> OvWrapping
    is OvClamping -> OvClamping

  mcopy-real-width : RealWidth -> RealWidth
  mcopy-real-width (w) =
   if address-of w == 0 then w
   else when w
    is RwF64 -> RwF64
    is RwF32 -> RwF32

  mcopy-real-mode : RealMode -> RealMode
  mcopy-real-mode (m) =
   if address-of m == 0 then m
   else when m
    is RmDefault -> RmDefault
    is RmTrapping -> RmTrapping
    is RmSaturating -> RmSaturating

  mcopy-types : List CodexType, Integer, MemoCtx -> List CodexType
  mcopy-types (ts) (depth) (mc) =
   let a = address-of ts
   in if a == 0 then ts
   else if a < mc.mc-floor then ts
   else if __heap-save >= mc.mc-ceiling then ts
   else let k = cons-norm (mkey-types ts depth mc)
   in let v = cons-lookup k mc
   in if v /= 0 then list-at (mc.mc-tylist) (v - 1)
   else mcopy-types-insert ts k depth mc

  mcopy-types-insert : List CodexType, Integer, Integer, MemoCtx -> List CodexType
  mcopy-types-insert (ts) (k) (depth) (mc) =
   let copy = mcopy-types-node ts depth mc
   in let v2 = cons-lookup k mc
   in if v2 /= 0 then list-at (mc.mc-tylist) (v2 - 1)
   else let cslot = cons-probe k mc
   in if cslot == 0 then copy
   else let n = list-length (mc.mc-tylist)
   in if n >= mc.mc-cap-list then copy
   else let pushed = list-push (mc.mc-tylist) copy
   in let w = cons-slot-set cslot k (n + 1)
   in copy

  mcopy-types-node : List CodexType, Integer, MemoCtx -> List CodexType
  mcopy-types-node (ts) (depth) (mc) =
   for t in ts -> mcopy-type t depth mc

  mkey-types : List CodexType, Integer, MemoCtx -> Integer
  mkey-types (ts) (depth) (mc) =
   mkey-types-loop ts 0 (list-length ts) depth mc (cons-mix 101 (list-length ts))

  mkey-types-loop : List CodexType, Integer, Integer, Integer, MemoCtx, Integer -> Integer
  mkey-types-loop (ts) (i) (len) (depth) (mc) (acc) =
   if i == len then acc
   else mkey-types-loop ts (i + 1) len depth mc (cons-mix acc (address-of (mcopy-type (list-at ts i) depth mc)))

  mcopy-fields : List RecordField, Integer, MemoCtx -> List RecordField
  mcopy-fields (fs) (depth) (mc) =
   let a = address-of fs
   in if a == 0 then fs
   else if a < mc.mc-floor then fs
   else if __heap-save >= mc.mc-ceiling then fs
   else let k = cons-norm (mkey-fields fs depth mc)
   in let v = cons-lookup k mc
   in if v /= 0 then list-at (mc.mc-fieldlist) (v - 1)
   else mcopy-fields-insert fs k depth mc

  mcopy-fields-insert : List RecordField, Integer, Integer, MemoCtx -> List RecordField
  mcopy-fields-insert (fs) (k) (depth) (mc) =
   let copy = mcopy-fields-node fs depth mc
   in let v2 = cons-lookup k mc
   in if v2 /= 0 then list-at (mc.mc-fieldlist) (v2 - 1)
   else let cslot = cons-probe k mc
   in if cslot == 0 then copy
   else let n = list-length (mc.mc-fieldlist)
   in if n >= mc.mc-cap-list then copy
   else let pushed = list-push (mc.mc-fieldlist) copy
   in let w = cons-slot-set cslot k (n + 1)
   in copy

  mcopy-fields-node : List RecordField, Integer, MemoCtx -> List RecordField
  mcopy-fields-node (fs) (depth) (mc) =
   for f in fs -> RecordField { name = mcopy-name (f.name) mc, type-val = mcopy-type (f.type-val) depth mc }

  mkey-fields : List RecordField, Integer, MemoCtx -> Integer
  mkey-fields (fs) (depth) (mc) =
   mkey-fields-loop fs 0 (list-length fs) depth mc (cons-mix 201 (list-length fs))

  mkey-fields-loop : List RecordField, Integer, Integer, Integer, MemoCtx, Integer -> Integer
  mkey-fields-loop (fs) (i) (len) (depth) (mc) (acc) =
   if i == len then acc
   else let f = list-at fs i
   in mkey-fields-loop fs (i + 1) len depth mc (cons-mix (cons-mix acc (address-of (mcopy-name (f.name) mc))) (address-of (mcopy-type (f.type-val) depth mc)))

  mcopy-ctors : List SumCtor, Integer, MemoCtx -> List SumCtor
  mcopy-ctors (cs) (depth) (mc) =
   let a = address-of cs
   in if a == 0 then cs
   else if a < mc.mc-floor then cs
   else if __heap-save >= mc.mc-ceiling then cs
   else let k = cons-norm (mkey-ctors cs depth mc)
   in let v = cons-lookup k mc
   in if v /= 0 then list-at (mc.mc-ctorlist) (v - 1)
   else mcopy-ctors-insert cs k depth mc

  mcopy-ctors-insert : List SumCtor, Integer, Integer, MemoCtx -> List SumCtor
  mcopy-ctors-insert (cs) (k) (depth) (mc) =
   let copy = mcopy-ctors-node cs depth mc
   in let v2 = cons-lookup k mc
   in if v2 /= 0 then list-at (mc.mc-ctorlist) (v2 - 1)
   else let cslot = cons-probe k mc
   in if cslot == 0 then copy
   else let n = list-length (mc.mc-ctorlist)
   in if n >= mc.mc-cap-list then copy
   else let pushed = list-push (mc.mc-ctorlist) copy
   in let w = cons-slot-set cslot k (n + 1)
   in copy

  mcopy-ctors-node : List SumCtor, Integer, MemoCtx -> List SumCtor
  mcopy-ctors-node (cs) (depth) (mc) =
   for c in cs -> SumCtor { name = mcopy-name (c.name) mc, fields = mcopy-types (c.fields) depth mc, return-type = mcopy-types (c.return-type) depth mc }

  mkey-ctors : List SumCtor, Integer, MemoCtx -> Integer
  mkey-ctors (cs) (depth) (mc) =
   mkey-ctors-loop cs 0 (list-length cs) depth mc (cons-mix 301 (list-length cs))

  mkey-ctors-loop : List SumCtor, Integer, Integer, Integer, MemoCtx, Integer -> Integer
  mkey-ctors-loop (cs) (i) (len) (depth) (mc) (acc) =
   if i == len then acc
   else let c = list-at cs i
   in mkey-ctors-loop cs (i + 1) len depth mc (cons-mix (cons-mix (cons-mix acc (address-of (mcopy-name (c.name) mc))) (address-of (mcopy-types (c.fields) depth mc))) (address-of (mcopy-types (c.return-type) depth mc)))

  mcopy-type : CodexType, Integer, MemoCtx -> CodexType
  mcopy-type (ty) (depth) (mc) =
   let a = address-of ty
   in if a == 0 then ty
   else if a < mc.mc-floor then ty
   else if __heap-save >= mc.mc-ceiling then ErrorTy
   else if depth >= max-recursion-depth then ErrorTy
   else if peek-qword a 0 < 0 then ErrorTy
   else if peek-qword a 0 > 28 then ErrorTy
   else mcopy-type-memo ty a (memo-probe a mc) depth mc

  mcopy-type-memo : CodexType, Integer, Integer, Integer, MemoCtx -> CodexType
  mcopy-type-memo (ty) (a) (slot) (depth) (mc) =
   if slot == 0 then mcopy-type-node ty depth mc
   else if memo-slot-key slot == bit-and a 4294967295 then mcopy-type-hit ty slot mc
   else mcopy-type-fresh ty a slot depth mc

  mcopy-type-hit : CodexType, Integer, MemoCtx -> CodexType
  mcopy-type-hit (ty) (slot) (mc) =
   let v = peek-32 slot 4
   in if v == 0 then ty else list-at (mc.mc-ty) (v - 1)

  cons-lookup : Integer, MemoCtx -> Integer
  cons-lookup (k) (mc) =
   let slot = cons-probe k mc
   in if slot == 0 then 0
   else if peek-qword slot 0 == k then peek-32 (slot + 8) 0
   else 0

  mkey-textlen : Text -> Integer
  mkey-textlen (t) =
   if address-of t == 0 then 0
   else text-length t

  mcopy-type-fresh : CodexType, Integer, Integer, Integer, MemoCtx -> CodexType
  mcopy-type-fresh (ty) (a) (slot) (depth) (mc) =
   let claimed = poke-32 slot 0 a
   in let k = cons-norm (mkey-type ty depth mc)
   in let v = cons-lookup k mc
   in if v /= 0 then mcopy-type-adopt slot v mc
   else let copy = mcopy-type-node ty depth mc
   in let v2 = cons-lookup k mc
   in if v2 /= 0 then mcopy-type-adopt slot v2 mc
   else let n = list-length (mc.mc-ty)
   in if n >= mc.mc-cap-ty then let un = memo-unclaim slot in copy
   else let pushed = list-push (mc.mc-ty) copy
   in let aset = poke-32 slot 4 (n + 1)
   in let cslot = cons-probe k mc
   in let w = if cslot == 0 then 0 else cons-slot-set cslot k (n + 1)
   in copy

  mcopy-type-adopt : Integer, Integer, MemoCtx -> CodexType
  mcopy-type-adopt (slot) (v) (mc) =
   let aset = poke-32 slot 4 v
   in list-at (mc.mc-ty) (v - 1)

  mkey-type : CodexType, Integer, MemoCtx -> Integer
  mkey-type (ty) (depth) (mc) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> cons-mix (cons-mix (cons-mix 1 lo) hi) (mode-ordinal mode)
    is RealTy (w) (m) -> cons-mix (cons-mix 2 (real-width-ordinal w)) (real-mode-ordinal m)
    is TextTy -> 6
    is BooleanTy -> 7
    is CharTy -> 8
    is VoidTy -> 9
    is NothingTy -> 10
    is ErrorTy -> 11
    is NoExpectTy -> 30
    is FunTy (p) (row) (r) -> cons-mix (cons-mix (cons-mix 12 (address-of (mcopy-type p (depth + 1) mc))) (address-of (mcopy-row row mc))) (address-of (mcopy-type r (depth + 1) mc))
    is ListTy (e) -> cons-mix 13 (address-of (mcopy-type e (depth + 1) mc))
    is LinkedListTy (e) -> cons-mix 14 (address-of (mcopy-type e (depth + 1) mc))
    is TypeVar (i) -> cons-mix 15 i
    is ForAllTy (i) (b) -> cons-mix (cons-mix 16 i) (address-of (mcopy-type b (depth + 1) mc))
    is SumTy (n) (a) (ctors) -> cons-mix (cons-mix (cons-mix 17 (address-of (mcopy-name n mc))) (address-of (mcopy-types a (depth + 1) mc))) (address-of (mcopy-ctors ctors (depth + 1) mc))
    is RecordTy (n) (a) (fields) -> cons-mix (cons-mix (cons-mix 18 (address-of (mcopy-name n mc))) (address-of (mcopy-types a (depth + 1) mc))) (address-of (mcopy-fields fields (depth + 1) mc))
    is ConstructedTy (n) (a) -> cons-mix (cons-mix 19 (address-of (mcopy-name n mc))) (address-of (mcopy-types a (depth + 1) mc))
    is EffectfulTy (effs) (sc) (r) -> cons-mix (cons-mix (cons-mix 20 (address-of (mcopy-names effs mc))) (address-of (mcopy-texts sc mc))) (address-of (mcopy-type r (depth + 1) mc))
    is ProofTy -> 21
    is PropEqTy (pa) (pb) -> cons-mix (cons-mix 22 (address-of (mcopy-type pa (depth + 1) mc))) (address-of (mcopy-type pb (depth + 1) mc))
    is UnitTy (n) (inner) -> cons-mix (cons-mix 23 (address-of (mcopy-name n mc))) (address-of (mcopy-type inner (depth + 1) mc))
    is VectorTy (vn) (vt) -> cons-mix (cons-mix 24 vn) (address-of (mcopy-type vt (depth + 1) mc))
    is VectorMaskTy (mn) -> cons-mix 25 mn
    is TypeCon (n) -> cons-mix 26 (address-of (mcopy-name n mc))
    is TypeApply (tf) (ta) -> cons-mix (cons-mix 27 (address-of (mcopy-type tf (depth + 1) mc))) (address-of (mcopy-type ta (depth + 1) mc))
    is ForAllEff (i) (b) -> cons-mix (cons-mix 28 i) (address-of (mcopy-type b (depth + 1) mc))
    is LinearTy (inner) -> cons-mix 29 (address-of (mcopy-type inner (depth + 1) mc))

  mcopy-type-node : CodexType, Integer, MemoCtx -> CodexType
  mcopy-type-node (ty) (depth) (mc) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> IntegerTy lo hi (mcopy-mode mode)
    is RealTy (w) (m) -> RealTy (mcopy-real-width w) (mcopy-real-mode m)
    is TextTy -> TextTy
    is BooleanTy -> BooleanTy
    is CharTy -> CharTy
    is VoidTy -> VoidTy
    is NothingTy -> NothingTy
    is ErrorTy -> ErrorTy
    is NoExpectTy -> NoExpectTy
    is FunTy (p) (row) (r) -> FunTy (mcopy-type p (depth + 1) mc) (mcopy-row row mc) (mcopy-type r (depth + 1) mc)
    is ListTy (e) -> ListTy (mcopy-type e (depth + 1) mc)
    is LinkedListTy (e) -> LinkedListTy (mcopy-type e (depth + 1) mc)
    is TypeVar (i) -> TypeVar i
    is ForAllTy (i) (b) -> ForAllTy i (mcopy-type b (depth + 1) mc)
    is SumTy (n) (a) (ctors) -> SumTy (mcopy-name n mc) (mcopy-types a (depth + 1) mc) (mcopy-ctors ctors (depth + 1) mc)
    is RecordTy (n) (a) (fields) -> RecordTy (mcopy-name n mc) (mcopy-types a (depth + 1) mc) (mcopy-fields fields (depth + 1) mc)
    is ConstructedTy (n) (a) -> ConstructedTy (mcopy-name n mc) (mcopy-types a (depth + 1) mc)
    is EffectfulTy (effs) (sc) (r) -> EffectfulTy (mcopy-names effs mc) (mcopy-texts sc mc) (mcopy-type r (depth + 1) mc)
    is ProofTy -> ProofTy
    is PropEqTy (a) (b) -> PropEqTy (mcopy-type a (depth + 1) mc) (mcopy-type b (depth + 1) mc)
    is UnitTy (n) (inner) -> UnitTy (mcopy-name n mc) (mcopy-type inner (depth + 1) mc)
    is VectorTy (vn) (vt) -> VectorTy vn (mcopy-type vt (depth + 1) mc)
    is VectorMaskTy (mn) -> VectorMaskTy mn
    is TypeCon (n) -> TypeCon (mcopy-name n mc)
    is TypeApply (tf) (ta) -> TypeApply (mcopy-type tf (depth + 1) mc) (mcopy-type ta (depth + 1) mc)
    is ForAllEff (i) (b) -> ForAllEff i (mcopy-type b (depth + 1) mc)
    is LinearTy (inner) -> LinearTy (mcopy-type inner (depth + 1) mc)

  copy-bindings-deep : List TypeBinding, MemoCtx -> List TypeBinding
  copy-bindings-deep (bs) (mc) =
   if address-of bs == 0 then bs
   else for b in bs -> TypeBinding { name = mcopy-text (b.name) mc, bound-type = mcopy-type (b.bound-type) 0 mc }

  copy-expr-types-deep : List ExprTypeEntry, MemoCtx -> List ExprTypeEntry
  copy-expr-types-deep (es) (mc) =
   if address-of es == 0 then es
   else for e in es -> ExprTypeEntry { key = e.key, ty = mcopy-type (e.ty) 0 mc }

Section: List Pre-Allocation

  copy-list-with-headroom : List a, Integer -> List a
  copy-list-with-headroom (src) (extra-cap) =
   let len = list-length src
   in let dst = __list-with-capacity (len + extra-cap)
   in copy-list-loop src dst 0 len

  copy-list-loop : List a, List a, Integer, Integer -> List a
  copy-list-loop (src) (dst) (i) (len) =
   if i == len then dst
   else copy-list-loop src (list-push dst (list-at src i)) (i + 1) len

Section: GADT Snapshot

  SubstSnapshot = record {
   snap-types : List CodexType,
   snap-rows : List EffectRow
  }

  snapshot-substitutions : UnificationState -> SubstSnapshot
  snapshot-substitutions (st) =
   SubstSnapshot {
    snap-types = copy-list-with-headroom (st.substitutions) 16,
    snap-rows = copy-list-with-headroom (st.row-substitutions) 8
   }

  restore-substitutions : UnificationState, SubstSnapshot -> UnificationState
  restore-substitutions (st) (saved) =
   let __seq = __record-set st "substitutions" (saved.snap-types)
   in let __seq2 = __record-set st "row-substitutions" (saved.snap-rows)
   in st

