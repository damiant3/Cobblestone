   BuiltinSpec { bs-name = "s-recv", bs-type = Just (ForAllTy 0 (ForAllTy 1 (FunTy (deck-record (ConstructedTy schan-name [deck-record (ConstructedTy srecv-name [TypeVar 0, TypeVar 1])])) empty-row (deck-record (ConstructedTy schan-name [TypeVar 1]))))), bs-emit = Just (\s a -> emit-helper-call-1 s a "chan-kern-recv-block") },
   BuiltinSpec { bs-name = "s-recv-value", bs-type = Just (ForAllTy 0 (FunTy (deck-record (ConstructedTy schan-name [TypeVar 0])) empty-row int-ty-default)), bs-emit = Just (\s a -> emit-helper-call-1 s a "chan-kern-recv-block") },
   BuiltinSpec { bs-name = "s-close", bs-type = Just (FunTy (deck-record (ConstructedTy schan-name [deck-record (ConstructedTy send-name [])])) empty-row int-ty-default), bs-emit = Just (\s a -> emit-helper-call-1 s a "chan-kern-close") },
   BuiltinSpec { bs-name = "True", bs-type = None, bs-emit = None },
   BuiltinSpec { bs-name = "False", bs-type = None, bs-emit = None },
   BuiltinSpec { bs-name = "Nothing", bs-type = None, bs-emit = None },
   BuiltinSpec { bs-name = "open-file", bs-type = None, bs-emit = None },
   BuiltinSpec { bs-name = "close-file", bs-type = None, bs-emit = None },
   BuiltinSpec { bs-name = "read-all", bs-type = None, bs-emit = None },
