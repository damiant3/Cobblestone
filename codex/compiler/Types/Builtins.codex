Section: Projections

  builtin-names-from : List BuiltinSpec, Integer, Integer, List Text -> List Text
  builtin-names-from (bs) (i) (len) (acc) =
   if i >= len then acc
   else builtin-names-from bs (i + 1) len (list-push acc ((list-at bs i).bs-name))

Section: Constant Definitions

  builtin-alloc-by-name : List BuiltinSpec, Text, Integer, Integer -> Text
  builtin-alloc-by-name (bs) (n) (i) (len) =
   if i >= len then "unknown"
   else let b = list-at bs i
   in if b.bs-name == n then b.bs-alloc
      else builtin-alloc-by-name bs n (i + 1) len

  builtin-varies-by-name : List BuiltinSpec, Text, Integer, Integer -> Boolean
  builtin-varies-by-name (bs) (n) (i) (len) =
   if i >= len then True
   else let b = list-at bs i
   in if b.bs-name == n then b.bs-varies
      else builtin-varies-by-name bs n (i + 1) len

  const-name-in : List Text, Text, Integer -> Boolean
  const-name-in (xs) (n) (i) =
   if i >= list-length xs then False
   else if list-at xs i == n then True
   else const-name-in xs n (i + 1)

  const-param-names : List IRParam, Integer, List Text -> List Text
  const-param-names (ps) (i) (acc) =
   if i >= list-length ps then acc
   else const-param-names ps (i + 1) (list-push acc ((list-at ps i).name))

  const-mentions-any : IRExpr, List Text, Integer -> Boolean
  const-mentions-any (e) (names) (fuel) =
   if fuel <= 0 then True
   else when e
    is IrName (n) (t) (s) -> const-name-in names n 0
    is IrBinary (op) (l) (r) (t) (s) -> const-mentions-any l names (fuel - 1) | const-mentions-any r names (fuel - 1)
    is IrNegate (x) (t) (s) -> const-mentions-any x names (fuel - 1)
    is IrIf (c) (th) (el) (t) (s) -> const-mentions-any c names (fuel - 1) | const-mentions-any th names (fuel - 1) | const-mentions-any el names (fuel - 1)
    is IrLet (n) (t) (v) (b) (s) -> const-mentions-any v names (fuel - 1) | const-mentions-any b names (fuel - 1)
    is IrApply (f) (a) (t) (s) -> const-mentions-any f names (fuel - 1) | const-mentions-any a names (fuel - 1)
    is IrLambda (ps) (b) (t) (s) -> const-mentions-any b names (fuel - 1)
    is IrFieldAccess (r) (f) (t) (s) -> const-mentions-any r names (fuel - 1)
    is IrList (es) (t) (s) -> const-mentions-any-list es names (fuel - 1) 0
    is IrRecord (nm) (fs) (t) (s) -> const-mentions-any-fields fs names (fuel - 1) 0
    is IrIntLit (v) (s) -> False
    is IrNumLit (v) (s) -> False
    is IrTextLit (v) (s) -> False
    is IrBoolLit (v) (s) -> False
    is IrCharLit (v) (s) -> False
    is otherwise -> True

  const-mentions-any-list : List IRExpr, List Text, Integer, Integer -> Boolean
  const-mentions-any-list (es) (names) (fuel) (i) =
   if i >= list-length es then False
   else if const-mentions-any (list-at es i) names fuel then True
   else const-mentions-any-list es names fuel (i + 1)

  const-mentions-any-fields : List IRFieldVal, List Text, Integer, Integer -> Boolean
  const-mentions-any-fields (fs) (names) (fuel) (i) =
   if i >= list-length fs then False
   else if const-mentions-any ((list-at fs i).value) names fuel then True
   else const-mentions-any-fields fs names fuel (i + 1)

  const-expr-invariant : IRExpr, SkipListText, List Text, Integer -> Boolean
  const-expr-invariant (e) (pure) (bound) (d) =
   if d <= 0 then False
   else when e
    is IrIntLit (v) (s) -> True
    is IrNumLit (v) (s) -> True
    is IrTextLit (v) (s) -> True
    is IrBoolLit (v) (s) -> True
    is IrCharLit (v) (s) -> True
    is IrName (n) (t) (s) -> const-name-invariant n pure bound
    is IrBinary (op) (l) (r) (t) (s) -> const-expr-invariant l pure bound (d - 1) & const-expr-invariant r pure bound (d - 1)
    is IrNegate (x) (t) (s) -> const-expr-invariant x pure bound (d - 1)
    is IrIf (c) (th) (el) (t) (s) -> const-expr-invariant c pure bound (d - 1) & const-expr-invariant th pure bound (d - 1) & const-expr-invariant el pure bound (d - 1)
    is IrLet (n) (t) (v) (b) (s) -> const-expr-invariant v pure bound (d - 1) & const-expr-invariant b pure (list-push bound n) (d - 1)
    is IrApply (f) (a) (t) (s) -> const-expr-invariant f pure bound (d - 1) & const-expr-invariant a pure bound (d - 1)
    is IrFieldAccess (r) (f) (t) (s) -> const-expr-invariant r pure bound (d - 1)
    is IrList (es) (t) (s) -> const-list-invariant es pure bound (d - 1) 0
    is IrRecord (nm) (fs) (t) (s) -> const-fields-invariant fs pure bound (d - 1) 0
    is IrLambda (ps) (b) (t) (s) -> const-mentions-any b bound 64 == False
    is otherwise -> False

  const-list-invariant : List IRExpr, SkipListText, List Text, Integer, Integer -> Boolean
  const-list-invariant (es) (pure) (bound) (d) (i) =
   if i >= list-length es then True
   else if const-expr-invariant (list-at es i) pure bound d then const-list-invariant es pure bound d (i + 1)
   else False

  const-fields-invariant : List IRFieldVal, SkipListText, List Text, Integer, Integer -> Boolean
  const-fields-invariant (fs) (pure) (bound) (d) (i) =
   if i >= list-length fs then True
   else if const-expr-invariant ((list-at fs i).value) pure bound d then const-fields-invariant fs pure bound d (i + 1)
   else False

  const-name-invariant : Text, SkipListText, List Text -> Boolean
  const-name-invariant (n) (pure) (bound) =
   if const-name-in bound n 0 then True
   else if skip-list-text-has pure n then True
   else builtin-varies-by-name builtins n 0 (list-length builtins) == False

 It is a fixpoint and not a recursive descent for a measured reason. Descending
 into each called definition spends no fuel across siblings, so a body naming N
 definitions whose bodies each name N more is N to the depth -- exponential,
 inside the emitter, which is the shape rule 8 exists to catch. One round here
 walks each body once and answers every name by lookup.

  const-pure-round : List IRDef, SkipListText, Integer, List Text -> List Text
  const-pure-round (defs) (pure) (i) (acc) =
   if i >= list-length defs then acc
   else let d = list-at defs i
   in if const-expr-invariant (d.body) pure (const-param-names (d.params) 0 []) 40
      then const-pure-round defs pure (i + 1) (list-push acc (d.name))
      else const-pure-round defs pure (i + 1) acc

  const-pure-set : List IRDef, SkipListText, Integer, Integer -> SkipListText
  const-pure-set (defs) (pure) (prev-size) (rounds) =
   if rounds <= 0 then pure
   else let next = skip-list-text-from-list (const-pure-round defs pure 0 [])
   in if next.size == prev-size then next
      else const-pure-set defs next (next.size) (rounds - 1)

  const-pure-names : List IRDef -> SkipListText
  const-pure-names (defs) = const-pure-set defs skip-list-text-empty (0 - 1) 2

  const-def-qualifies : IRDef, SkipListText -> Boolean
  const-def-qualifies (d) (pure) =
   if list-length (d.params) > 0 then False
   else const-expr-invariant (d.body) pure [] 40

 Only a body that allocates is worth a slot. A scalar or a text literal costs
 nothing to name a second time, and memoizing one trades an immediate for a
 memory load.

  const-worth-memo : IRExpr -> Boolean
  const-worth-memo (e) =
   when e
    is IrList (es) (t) (s) -> True
    is IrRecord (n) (fs) (t) (s) -> True
    is IrApply (f) (a) (t) (s) -> True
    is otherwise -> False

  const-slot-index : List Text, Text, Integer -> Integer
  const-slot-index (names) (n) (i) =
   if i >= list-length names then 0 - 1
   else if list-at names i == n then i
   else const-slot-index names n (i + 1)
