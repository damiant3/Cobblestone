Chapter: Type Checker
  cites Codex chapter Lists
  cites Codex chapter Build Settings (max-recursion-depth)
  cites Foreword chapter Tuple

 Expression type inference dispatch.

Section: Check Result

 The judgment is Γ ⊢ e : τ | ε (EffectRows.md §12 stage 3, ruled
 2026-07-02): effect-row is the expression's AMBIENT row — what
 evaluating it performs. The effects of a function VALUE the
 expression produces live on that value's arrow, never in the
 ambient; a lambda's ambient is empty and its body's ambient becomes
 the synthesized arrow's row. Compound expressions row-union their
 parts; applications add the row captured from the callee's arrow.
 Until stage 3b migrates concrete effects onto arrows, every ambient
 row computes to the interned empty row, which is what keeps this
 plumbing inert and the fixed point byte-identical.

  CheckResult = record {
   inferred-type : CodexType,
   effect-row : EffectRow,
   state : UnificationState
  }

Section: Infer Literal
  infer-literal : UnificationState, LiteralKind -> CheckResult
  infer-literal (st) (kind) =
   when kind
    is IntLit -> CheckResult {
     inferred-type = int-ty-default,
     effect-row = empty-row,
     state = st
    }
    is NumLit -> CheckResult {
     inferred-type = RealTy,
     effect-row = empty-row,
     state = st
    }
    is TextLit -> CheckResult {
     inferred-type = TextTy,
     effect-row = empty-row,
     state = st
    }
    is CharLit -> CheckResult {
     inferred-type = CharTy,
     effect-row = empty-row,
     state = st
    }
    is BoolLit -> CheckResult {
     inferred-type = BooleanTy,
     effect-row = empty-row,
     state = st
    }

Section: Literal Range

 An integer literal wider than 64 bits would silently wrap in
 lit-text-to-integer at lowering, so the checker rejects it here from
 the digit text alone: skip underscores and leading zeros, then a
 significant-digit count beyond nineteen always overflows, and at
 exactly nineteen a digit-wise compare against the maximum decides.
 A hash literal is a raw bit pattern, so its bound is simpler: up
 to sixteen significant hex digits fill 64 bits exactly, and more
 always overflow. No conversion, no allocation.

  int-lit-first-sig : Text, Integer, Integer -> Integer
  int-lit-first-sig (val) (i) (len) =
   if i >= len then len
   else let c = char-code-at val i
   in if c == char-code '0' | c == char-code '_' then int-lit-first-sig val (i + 1) len
      else i

  int-lit-sig-digits : Text, Integer, Integer, Integer -> Integer
  int-lit-sig-digits (val) (i) (len) (acc) =
   if i >= len then acc
   else if char-code-at val i == char-code '_' then int-lit-sig-digits val (i + 1) len acc
   else int-lit-sig-digits val (i + 1) len (acc + 1)

  int-lit-exceeds : Text, Integer, Integer, Text, Integer -> Boolean
  int-lit-exceeds (val) (i) (len) (max-text) (j) =
   if i >= len then False
   else let c = char-code-at val i
   in if c == char-code '_' then int-lit-exceeds val (i + 1) len max-text j
      else let m = char-code-at max-text j
      in if c > m then True
         else if c < m then False
         else int-lit-exceeds val (i + 1) len max-text (j + 1)

  int-lit-out-of-range : Text -> Boolean
  int-lit-out-of-range (val) =
   let len = text-length val
   in if is-hex-literal-text val then
       let start = int-lit-first-sig val 1 len
       in int-lit-sig-digits val start len 0 > 16
      else
       let start = int-lit-first-sig val 0 len
       in let sig = int-lit-sig-digits val start len 0
       in if sig < 19 then False
          else if sig > 19 then True
          else int-lit-exceeds val start len "9223372036854775807" 0

  check-int-lit-range : UnificationState, Text, LiteralKind, SourceSpan -> UnificationState
  check-int-lit-range (st) (val) (kind) (span) =
   when kind
    is IntLit ->
     if int-lit-out-of-range val
     then __record-set st "bag" (bag-add (st.bag) (make-error cdx-int-literal-overflow ("Integer literal '" & val & "' exceeds 64 bits (decimal max 9223372036854775807, hash form max 16 hex digits) and would be silently truncated") span))
     else st
    is otherwise -> st

Section: Infer Name
 A name reference instantiates, then OPENS each closed spine row with
 a fresh tail (the Koka open rule, §6a): a pure or less-effectful
 function flows into a more-effectful context through plain
 unification. Opening happens only here — never at binding positions
 (a def's own signature, record fields, parameter annotations), which
 instantiate through resolve-declared-type and the ctor paths.
 Referencing an effectful VALUE (read-line) performs its effects:
 they become the reference's ambient row and the type unwraps to the
 inner value type.

  infer-name : UnificationState, TypeEnv, Text, SourceSpan -> CheckResult
  infer-name (st) (env) (name) (span) =
   let resolved = rename-lookup (env.chapter-renames) name
   in if env-has env resolved
    then
     let raw = env-lookup env resolved
     in let (inst-ty0, inst-st) = instantiate-type st raw
     in let (inst-ty, opened-st) = open-spine-rows inst-st inst-ty0
     in let warned-st = if name == "assume"
      then __record-set opened-st "bag" (bag-add (opened-st.bag) (make-warning cdx-axiom-assumed "Proof uses 'assume': this equality is asserted as an unproven axiom, not checked. It is part of the trust trail." span))
      else opened-st
     in when inst-ty
        is EffectfulTy (effs) (sc) (inner) -> CheckResult {
         inferred-type = inner,
         effect-row = make-row-from-names effs sc "",
         state = record-expr-type warned-st span inner
        }
        is otherwise -> CheckResult {
         inferred-type = inst-ty,
         effect-row = empty-row,
         state = record-expr-type warned-st span inst-ty
        }
    else CheckResult {
     inferred-type = ErrorTy,
     effect-row = empty-row,
     state = if name == "Nothing"
      then add-unify-error st cdx-nothing-as-value "'Nothing' is a type, not a value. For an empty Maybe use 'None' (cite Foreword chapter Maybe); 'Nothing' is only the return type of effectful procedures, e.g. [Console] Nothing." span
      else add-unify-error st cdx-unknown-name ("Unknown name: " & name) span
    }

  open-spine-rows : UnificationState, CodexType -> (CodexType, UnificationState)
  open-spine-rows (st) (ty) =
   when ty
    is FunTy (p) (row) (r) ->
     let (r2, st2) = open-spine-rows st r
     in if row.tail-id < 0 & text-length (row.tail-name) == 0
        then let (t, st3) = fresh-row-id st2
             in (deck-record (FunTy p (deck-record (row-with-tail-id row t)) r2), st3)
        else (deck-record (FunTy p row r2), st2)
    is otherwise -> (ty, st)

  instantiate-type : UnificationState, CodexType -> (CodexType, UnificationState)
  instantiate-type (st) (ty) =
   when ty
    is ForAllTy (var-id) (body) ->
     let (fr-ty, fr-st) = fresh-and-advance st
     in let substituted = subst-type-var body var-id fr-ty
     in instantiate-type fr-st substituted
    is ForAllEff (var-id) (body) ->
     let (new-id, fr-st) = fresh-row-id st
     in let substituted = subst-row-var body var-id new-id
     in instantiate-type fr-st substituted
    is otherwise -> (ty, st)

  subst-type-var : CodexType, Integer, CodexType -> CodexType
  subst-type-var (ty) (var-id) (replacement) =
   if ty-has-typevars ty == False then ty
   else when ty
    is TypeVar (id) -> if id == var-id then replacement else ty
    is ForAllTy (inner-id) (body) ->
     if inner-id == var-id then ty
     else deck-record (ForAllTy inner-id (subst-type-var body var-id replacement))
    is otherwise -> codex-type-map-children (\c -> subst-type-var c var-id replacement) ty

 subst-row-var freshens one row-variable id through a type: every
 arrow row whose tail carries the old id is rebuilt with the new id.
 Row ids live only on FunTy rows and ForAllEff binders, never inside
 any other constructor's payload, so everything else recurses through
 the shared children walker. A ForAllEff binding the same id shadows
 it — stop there. No ty-has-typevars short-circuit applies: that
 guard sees type variables, not row tails.

  subst-row-var : CodexType, Integer, Integer -> CodexType
  subst-row-var (ty) (old-id) (new-id) =
   when ty
    is FunTy (p) (row) (r) ->
     let row2 = if row.tail-id == old-id then deck-record (row-with-tail-id row new-id) else row
     in deck-record (FunTy (subst-row-var p old-id new-id) row2 (subst-row-var r old-id new-id))
    is ForAllEff (inner-id) (body) ->
     if inner-id == old-id then ty
     else deck-record (ForAllEff inner-id (subst-row-var body old-id new-id))
    is otherwise -> codex-type-map-children (\c -> subst-row-var c old-id new-id) ty

Section: Infer Binary
 The operand-shape helpers below construct their results with the
 empty ambient; infer-binary is the one entry point and stamps the
 union of the operands' ambients onto whatever they return.

  infer-binary : UnificationState, TypeEnv, AExpr, BinaryOp, AExpr, SourceSpan -> CheckResult
  infer-binary (st) (env) (left) (op) (right) (span) =
   let lr = infer-expr st env left
   in let rr = infer-expr (lr.state) env right
   in let base = infer-binary-op (rr.state) (lr.inferred-type) (rr.inferred-type) op span
   in let (amb, amb-st) = row-union (base.state) (lr.effect-row) (rr.effect-row)
   in CheckResult {
    inferred-type = base.inferred-type,
    effect-row = amb,
    state = amb-st
   }

  is-real-type : CodexType -> Boolean
  is-real-type (ty) =
   when ty
    is RealTy | RealApproxTy | RealTrappingTy | RealSaturatingTy -> True
    is otherwise -> False

  infer-binary-op : UnificationState, CodexType, CodexType, BinaryOp, SourceSpan -> CheckResult
  infer-binary-op (st) (lt) (rt) (op) (span) =
   when op
    is OpAdd | OpSub | OpMul | OpDiv | OpPow -> infer-arithmetic st lt rt span
    is OpEq | OpNotEq ->
     let result = infer-comparison st lt rt span
     in if is-real-type lt | is-real-type rt
      then CheckResult {
       inferred-type = BooleanTy,
       effect-row = empty-row,
       state = add-unify-error (result.state) cdx-real-equality-banned "Floating-point equality is not safe. Use the ~ operator: x ~ y (approximately equal, 4 ULP tolerance), x ~0 y (bitwise exact, if you are certain)" span
      }
      else result
    is OpLt | OpGt | OpLtEq | OpGtEq | OpApproxEq | OpApproxEqExact -> infer-comparison st lt rt span
    is OpAnd -> infer-and st lt rt span
    is OpOr -> infer-logical st lt rt span
    is OpAppend -> infer-append st lt rt span
    is OpCons -> infer-cons st lt rt span
    is OpDefEq -> infer-comparison st lt rt span

  infer-arithmetic : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
  infer-arithmetic (st) (lt) (rt) (span) =
   when lt
    is UnitTy (ln) (li) ->
     when rt
      is UnitTy (rn) (ri) ->
       let (_, u-st) = unify st lt rt span
       in let st2 = if is-arithmetic-type lt & is-arithmetic-type rt then u-st
                    else add-unify-error u-st cdx-arithmetic-requires-numeric "Arithmetic operator requires Integer or Real" span
       in CheckResult { inferred-type = lt, effect-row = empty-row, state = st2 }
      is otherwise ->
       let (_, u-st) = unify st li rt span
       in CheckResult { inferred-type = lt, effect-row = empty-row, state = u-st }
    is otherwise ->
     when rt
      is UnitTy (rn) (ri) ->
       let (_, u-st) = unify st lt ri span
       in CheckResult { inferred-type = rt, effect-row = empty-row, state = u-st }
      is otherwise ->
       let (_, u-st) = unify st lt rt span
       in let st2 = if is-arithmetic-type lt & is-arithmetic-type rt then u-st
                    else add-unify-error u-st cdx-arithmetic-requires-numeric "Arithmetic operator requires Integer or Real" span
       in CheckResult { inferred-type = lt, effect-row = empty-row, state = st2 }

  is-arithmetic-type : CodexType -> Boolean
  is-arithmetic-type (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) | RealTy | RealApproxTy | RealTrappingTy | RealSaturatingTy | VectorTy (vn) (vt) | TypeVar (id) | ErrorTy -> True
    is UnitTy (n) (inner) -> is-arithmetic-type inner
    is otherwise -> False

  infer-comparison : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
  infer-comparison (st) (lt) (rt) (span) =
   let (_, u-st) = unify st lt rt span
   in when lt
    is VectorTy (n) (et) -> CheckResult {
     inferred-type = VectorMaskTy n,
     effect-row = empty-row,
     state = u-st
    }
    is otherwise -> CheckResult {
     inferred-type = BooleanTy,
     effect-row = empty-row,
     state = u-st
    }

  infer-logical : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
  infer-logical (st) (lt) (rt) (span) =
   let (_, u-st1) = unify st lt BooleanTy span
   in let (_, u-st2) = unify u-st1 rt BooleanTy span
   in CheckResult {
    inferred-type = BooleanTy,
    effect-row = empty-row,
    state = u-st2
   }

  infer-and : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
  infer-and (st) (lt) (rt) (span) =
   let resolved = resolve-silent st lt
   in when resolved
    is BooleanTy -> infer-logical st lt rt span
    is TextTy | otherwise -> infer-append st lt rt span

  infer-append : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
  infer-append (st) (lt) (rt) (span) =
   let resolved = resolve-silent st lt
   in when resolved
    is TextTy ->
     let (_, u-st) = unify st rt TextTy span
   in CheckResult {
      inferred-type = TextTy,
      effect-row = empty-row,
      state = u-st
     }
    is otherwise ->
     let (_, u-st) = unify st lt rt span
   in CheckResult {
      inferred-type = lt,
      effect-row = empty-row,
      state = u-st
     }

  infer-cons : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
  infer-cons (st) (lt) (rt) (span) =
   let list-ty = deck-record (ListTy lt)
   in let (_, u-st) = unify st rt list-ty span
   in CheckResult {
    inferred-type = list-ty,
    effect-row = empty-row,
    state = u-st
   }

Section: Infer If
  infer-if : UnificationState, TypeEnv, AExpr, AExpr, AExpr, SourceSpan -> CheckResult
  infer-if (st) (env) (cond) (then-e) (else-e) (span) =
   let cr = infer-expr st env cond
   in let (_, u-st1) = unify (cr.state) (cr.inferred-type) BooleanTy (aexpr-span cond)
   in let tr = infer-expr u-st1 env then-e
   in let er = infer-expr (tr.state) env else-e
   in let (_, u-st2) = unify (er.state) (tr.inferred-type) (er.inferred-type) span
   in let (amb1, amb1-st) = row-union u-st2 (cr.effect-row) (tr.effect-row)
   in let (amb, amb-st) = row-union amb1-st amb1 (er.effect-row)
   in CheckResult {
    inferred-type = tr.inferred-type,
    effect-row = amb,
    state = amb-st
   }

Section: Infer Let

 A let's ambient is the union of every binding value's ambient with
 the body's — a binding value is evaluated even if the body never
 reads the name. The binding loop accumulates the union as it walks.

  infer-let : UnificationState, TypeEnv, List ALetBind, AExpr -> CheckResult
  infer-let (st) (env) (bindings) (body) =
   let env2 = infer-let-bindings st env bindings 0 (list-length bindings) empty-row
   in let br = infer-expr (env2.state) (env2.env) body
   in let (amb, amb-st) = row-union (br.state) (env2.binds-row) (br.effect-row)
   in CheckResult {
    inferred-type = br.inferred-type,
    effect-row = amb,
    state = amb-st
   }

 LetBindResult is the plain (state, env) pair the def/effect/class
 registration walkers share; let-body inference carries the bindings'
 accumulated ambient row alongside, so it gets its own shape.

  LetBindResult = record {
   state : UnificationState,
   env : TypeEnv
  }

  LetInferResult = record {
   state : UnificationState,
   env : TypeEnv,
   binds-row : EffectRow
  }

  infer-let-bindings : UnificationState, TypeEnv, List ALetBind, Integer, Integer, EffectRow -> LetInferResult
  infer-let-bindings (st) (env) (bindings) (i) (len) (acc-row) =
   if i == len then LetInferResult {
    state = st,
    env = env,
    binds-row = acc-row
   }
   else let b = list-at bindings i
   in let vr = infer-expr st env (b.value)
   in let (acc2, acc-st) = row-union (vr.state) acc-row (vr.effect-row)
   in let checked-st = check-let-bind-row acc-st (vr.effect-row) (b.name.value) (aexpr-span (b.value))
   in let resolved-ty = deep-resolve checked-st (vr.inferred-type)
   in let env2 = env-bind-local env (b.name.value) resolved-ty
   in let env3 = record-local-range env2 (b.name.value) (b.value) resolved-ty
   in infer-let-bindings checked-st env3 bindings (i + 1) len acc2

 A let-local whose value proves narrower than the full i64 range
 carries that range forward for the narrowing lint. The value is
 analyzed in the pre-binding env (a let has no recursion), and only a
 genuinely-narrower proof is recorded, so unknown-range locals cost
 nothing. When the expression analysis cannot prove but the value's
 RESOLVED TYPE is a bounded IntegerTy, the type's range is recorded
 instead: a direct store of that value would type-fit silently, so a
 local carrying the same range makes local-mediated flows exactly as
 permissive as direct ones - no more - and lets the local
 participate in the arithmetic arms (255 - v proves when v carries a
 field's 0..255).

  record-local-range : TypeEnv, Text, AExpr, CodexType -> TypeEnv
  record-local-range (env) (name) (value) (resolved-ty) =
   let (lo, hi) = aexpr-proven-range env value
   in if lo > i64-min | hi < i64-max then env-add-local-range env name lo hi
   else when resolved-ty
    is IntegerTy (t-lo) (t-hi) (mode) ->
     if t-lo <= i64-min & t-hi >= i64-max then env
     else env-add-local-range env name t-lo t-hi
    is otherwise -> env

 The let boundary reads the binding VALUE's ambient row: concrete
 labels mean an effectful call is being let-bound outside an
 act-bind, which silently corrupts on bare metal (CDX2033). A row
 whose only content is an unsolved tail is allowed — it is the HOF
 body pattern, where the effects are the caller's and the def
 boundary answers for them.

  check-let-bind-row : UnificationState, EffectRow, Text, SourceSpan -> UnificationState
  check-let-bind-row (st) (row) (name) (span) =
   if st.effect-exempt then st
   else let r = resolve-row st row
   in if list-length (r.labels) == 0 then st
   else add-unify-error st cdx-let-binds-effectful-value ("let-binding '" & name & "' to an effectful value is not allowed outside an act-bind. Use '" & name & " <- ...' inside an act block.") span

Section: Infer Lambda

 A lambda VALUE performs nothing — its ambient is empty. What the
 body performs becomes the row on the innermost synthesized arrow,
 the arrow whose application will perform it (§4 curried placement).
 The row is opened with a fresh tail when the body's ambient is
 closed (§6a: inferred literals are born open), so a pure lambda
 flows into an effectful-arrow context through plain unification.

  open-row-if-closed : UnificationState, EffectRow -> (EffectRow, UnificationState)
  open-row-if-closed (st) (row) =
   let r = resolve-row st row
   in if r.tail-id >= 0 then (r, st)
   else let (t, st2) = fresh-row-id st
   in (make-row (r.labels) "" t, st2)

  infer-lambda : UnificationState, TypeEnv, List Name, AExpr -> CheckResult
  infer-lambda (st) (env) (params) (body) =
   let pr = bind-lambda-params st env params 0 (list-length params) []
   in let br = infer-expr (pr.state) (pr.env) body
   in let (lam-row, lam-st) = open-row-if-closed (br.state) (br.effect-row)
   in let fun-ty = wrap-fun-type (pr.param-types) lam-row (br.inferred-type)
   in CheckResult {
    inferred-type = fun-ty,
    effect-row = empty-row,
    state = lam-st
   }

  LambdaBindResult = record {
   state : UnificationState,
   env : TypeEnv,
   param-types : List CodexType
  }

  bind-lambda-params : UnificationState, TypeEnv, List Name, Integer, Integer, List CodexType -> LambdaBindResult
  bind-lambda-params (st) (env) (params) (i) (len) (acc) =
   if i == len then LambdaBindResult {
    state = st,
    env = env,
    param-types = acc
   }
   else let p = list-at params i
   in let (fr-ty, fr-st) = fresh-and-advance st
   in let env2 = env-bind-local env (p.value) fr-ty
   in bind-lambda-params fr-st env2 params (i + 1) len (list-push acc fr-ty)

  wrap-fun-type : List CodexType, EffectRow, CodexType -> CodexType
  wrap-fun-type (param-types) (body-row) (result) =
   let n = list-length param-types
   in if n == 0 then result
   else wrap-fun-type-loop param-types (deck-record (FunTy (list-at param-types (n - 1)) body-row result)) (n - 2)

  wrap-fun-type-loop : List CodexType, CodexType, Integer -> CodexType
  wrap-fun-type-loop (param-types) (result) (i) =
   if i < 0 then result
   else wrap-fun-type-loop param-types (deck-record (FunTy (list-at param-types i) empty-row result)) (i - 1)

Section: Class Instance Check

 `show` and `compare` require an instance for their operand type. A
 primitive (Integer, Number, Text, Boolean, Char) has a built-in one; a
 user type must derive the class, which leaves a `__show_T`/`__compare_T`
 definition in scope (mirrors the dispatch probe in Lowering, so the
 checker rejects exactly when codegen would otherwise fall back to a
 meaningless number or a pointer compare). Primitives, type variables,
 lists, and other non-nominal types are never rejected here; type
 variables are deferred to the constraint pass.

 `==` / `/=` are intentionally not checked: the emitter already compares
 sums and text structurally (`emit-sum-structural-eq`, `__str_eq`), so
 equality is sound there without deriving. Record equality is a separate
 concern handled in codegen, not here.

  class-prefix-for : Text -> Text
  class-prefix-for (cls) =
   if cls == "Show" then "__show_"
   else "__compare_"

  class-derives : TypeEnv, Text, Text -> Boolean
  class-derives (env) (prefix) (tn) =
   if text-length tn == 0 then False
   else env-has env (rename-lookup (env.chapter-renames) (prefix & tn))

  nominal-type-name : CodexType -> Text
  nominal-type-name (ty) =
   when ty
    is SumTy (n) (a) (cs) | RecordTy (n) (ra) (rf) | ConstructedTy (n) (ca) -> n.value
    is otherwise -> ""

  class-op-ok : TypeEnv, Text, CodexType -> Boolean
  class-op-ok (env) (cls) (ty) =
   let tn = nominal-type-name ty
   in if text-length tn == 0 then True
   else class-derives env (class-prefix-for cls) tn

  check-class-op : UnificationState, TypeEnv, Text, CodexType, SourceSpan -> UnificationState
  check-class-op (st) (env) (cls) (ty) (span) =
   let rty = deep-resolve st ty
   in if class-op-ok env cls rty then st
   else add-unify-error st cdx-no-class-instance ("No " & cls & " instance for type '" & nominal-type-name rty & "'; derive " & cls & " on the type or convert manually") span

  check-class-op-app : UnificationState, TypeEnv, AExpr, CodexType, SourceSpan -> UnificationState
  check-class-op-app (st) (env) (func) (arg-ty) (span) =
   when func
    is ANameExpr (n) (ns) ->
     if (n.value) == "show" then check-class-op st env "Show" arg-ty span
     else if (n.value) == "compare" then check-class-op st env "Ord" arg-ty span
     else st
    is otherwise -> st

Section: Infer Application
 The synthesized expected arrow carries a FRESH row variable, not the
 empty row: unification binds it to the callee arrow's row, and that
 captured row joins the ambient — evaluating an application performs
 the function expression's effects, the argument expression's
 effects, and whatever the consumed arrow declares. An empty row
 here would instead FORCE every callee arrow closed-pure, which is
 wrong the moment stage 3b puts concrete effects on arrows.

  infer-application : UnificationState, TypeEnv, AExpr, AExpr, SourceSpan -> CheckResult
  infer-application (st) (env) (func) (arg) (span) =
   let fr = infer-expr st env func
   in let ar = when arg
       is ALitExpr (val) (kind) (s) -> infer-int-lit-arg (check-int-lit-range (fr.state) val kind s) (fr.inferred-type) val kind
       is otherwise -> infer-expr (fr.state) env arg
   in let (ret-ty, ret-st) = fresh-and-advance (ar.state)
   in let (call-row-id, row-st) = fresh-row-id ret-st
   in let (ok, r-st) = unify row-st (fr.inferred-type) (deck-record (FunTy (ar.inferred-type) (deck-record (row-var call-row-id)) ret-ty)) span
   in let st-cls = check-class-op-app r-st env func (ar.inferred-type) span
   in let st-arg = lint-arg-narrowing st-cls env func (fr.inferred-type) arg (ar.inferred-type) span
   in let st-final = lint-record-set st-arg env func arg (ar.inferred-type) ret-ty span
   in let refined-ty = refine-vec-result st-final func (ar.inferred-type) ret-ty
   in let (amb1, amb1-st) = row-union st-final (fr.effect-row) (ar.effect-row)
   in let (amb, amb-st) = row-union amb1-st amb1 (deck-record (row-var call-row-id))
   in CheckResult {
    inferred-type = refined-ty,
    effect-row = amb,
    state = amb-st
   }

 The CL 6494-era effect-le argument check is retired (stage 3b): its
 job — an effectful function may not flow into a pure parameter — is
 now done by row unification itself. A concrete pure parameter's
 arrow row is the closed empty row; an effectful argument's opened
 row cannot reconcile with it (CDX2090), and a row-polymorphic
 parameter constrains through its row variable instead of being
 waved through, which was the leniency this check had to carry.

 An argument flowing into a bounded parameter draws the same hybrid
 check as a bounded field store — and a constructor is a function
 whose payload is a parameter, so one check serves both. The declared
 parameter is read from the callee arrow BEFORE the application unify
 (overlap-permissive on IntegerTy, so the concrete bound survives).
 Literal out of range is the CDX2050 error, a wider static type the
 CDX2051 warning, an explicit __narrow suppresses — exactly as at
 record fields. The descriptor names a constructor field when the head
 is one of its sum type's own constructors (FabledTreasureMap entry
 11), a bounded parameter otherwise. Range PROPAGATION from the bound
 into the body is done at bind-def-params, not here, and only behind
 the stage-B runtime guard (BoundedSignatures.md section 4).

  lint-arg-narrowing : UnificationState, TypeEnv, AExpr, CodexType, AExpr, CodexType, SourceSpan -> UnificationState
  lint-arg-narrowing (st) (env) (func) (func-ty) (arg) (arg-ty) (span) =
   let declared-param = when strip-forall-ty (deep-resolve st func-ty)
    is FunTy (p) (row) (r) -> deep-resolve st p
    is otherwise -> ErrorTy
   in when declared-param
    is IntegerTy (lo) (hi) (mode) ->
     if lo <= i64-min & hi >= i64-max then st
     else let head = apply-head-name func
          in let desc = if is-ctor-of-own-sum env head then "field of constructor '" & head & "'" else "bounded parameter"
          in lint-narrowing-check st env arg arg-ty declared-param span desc
    is otherwise -> st
    is otherwise -> st

  is-ctor-of-own-sum : TypeEnv, Text -> Boolean
  is-ctor-of-own-sum (env) (name) =
   let resolved = rename-lookup (env.chapter-renames) name
   in if env-has env resolved == False then False
   else when strip-fun-args (strip-forall-ty (env-lookup env resolved))
    is SumTy (sn) (sa) (sctors) -> sum-ctors-have sctors resolved 0 (list-length sctors)
    is otherwise -> False

  sum-ctors-have : List SumCtor, Text, Integer, Integer -> Boolean
  sum-ctors-have (cs) (name) (i) (len) =
   if i == len then False
   else if ((list-at cs i).name.value) == name then True
   else sum-ctors-have cs name (i + 1) len

  refine-vec-result : UnificationState, AExpr, CodexType, CodexType -> CodexType
  refine-vec-result (st) (func) (arg-ty) (ret-ty) =
   let rr = deep-resolve st ret-ty
   in when rr
    is VectorTy (rn) (rt) -> if rn >= 0 then ret-ty else refine-vec-op st func arg-ty rt ret-ty
    is otherwise -> ret-ty

  refine-vec-op : UnificationState, AExpr, CodexType, CodexType, CodexType -> CodexType
  refine-vec-op (st) (func) (arg-ty) (elem-ty) (fallback) =
   let ra = deep-resolve st arg-ty
   in let arg-len = when ra is VectorTy (an) (at) -> an is otherwise -> 0 - 1
   in when func
    is ANameExpr (n) (s) ->
     if n.value == "vec-tail" & arg-len > 0 then deck-record (VectorTy (arg-len - 1) elem-ty)
     else if n.value == "vec-map" & arg-len >= 0 then deck-record (VectorTy arg-len elem-ty)
     else fallback
    is AApplyExpr (inner) (first-arg) (s) ->
     let inner-name = when inner is ANameExpr (n2) (s2) -> n2.value is otherwise -> ""
     in if inner-name == "vec-cons" & arg-len >= 0 then deck-record (VectorTy (arg-len + 1) elem-ty)
     else fallback
    is otherwise -> fallback

Section: Lint __record-set narrowing

 Tripwire pass for silent narrowing at __record-set call sites. When a
 `__record-set st "field" value` is detected and the field has a
 bounded Integer type that the value's static type does not fit, emit
 a warning. Codegen would silently truncate at runtime via narrow-store;
 this lint surfaces the site so the author can decide whether the
 runtime value range actually fits or needs an explicit narrow.

 Literal Integer values are checked against the field bound directly
 (a literal that fits is silent). All other value shapes (field reads,
 arithmetic, function calls) compare the inferred type's bound against
 the field's bound.

  lint-record-set : UnificationState, TypeEnv, AExpr, AExpr, CodexType, CodexType, SourceSpan -> UnificationState
  lint-record-set (st) (env) (func) (value-arg) (value-ty) (return-ty) (span) =
   when func
    is AApplyExpr (inner-func) (field-name-arg) (s2) ->
     when inner-func
      is AApplyExpr (rs-name) (obj-arg) (s3) ->
       when rs-name
        is ANameExpr (n) (s4) ->
         if n.value == "__record-set" then
          lint-record-set-check st env value-arg value-ty return-ty field-name-arg span
         else st
        is otherwise -> st
      is otherwise -> st
    is otherwise -> st

  lint-record-set-check : UnificationState, TypeEnv, AExpr, CodexType, CodexType, AExpr, SourceSpan -> UnificationState
  lint-record-set-check (st) (env) (value-arg) (value-ty) (return-ty) (field-name-arg) (span) =
   when field-name-arg
    is ALitExpr (text-val) (kind) (s) ->
     when kind
      is TextLit ->
       let resolved-record-ty = deep-resolve st return-ty
       in let field-ty = lookup-field-ty-for-lint env resolved-record-ty text-val
       in lint-narrowing-check st env value-arg value-ty field-ty span ("field '" & text-val & "'")
      is otherwise -> st
    is otherwise -> st

  lookup-field-ty-for-lint : TypeEnv, CodexType, Text -> CodexType
  lookup-field-ty-for-lint (env) (ty) (field-name) =
   when ty
    is RecordTy (rname) (rargs) (rfields) -> lookup-record-field rfields field-name
    is ConstructedTy (cname) (cargs) ->
     let rec-ty = resolve-constructed-to-record env (cname.value)
     in when rec-ty
      is RecordTy (rname) (rargs) (rfields) ->
       let raw-ftype = lookup-record-field rfields field-name
       in apply-type-args-subst rargs cargs raw-ftype 0 (list-length rargs)
      is otherwise -> ErrorTy
    is otherwise -> ErrorTy

  is-narrow-call : AExpr -> Boolean
  is-narrow-call (e) =
   when e
    is AApplyExpr (func) (arg) (s) ->
     when func
      is ANameExpr (name) (s2) -> name.value == "__narrow"
      is otherwise -> False
    is otherwise -> False

Section: Lint value-expression range analysis

 The checker-side twin of the emit prover's ir-expr-proven-range: a
 structural walk of the value EXPRESSION at a bounded store, run only
 when the inferred type's range has already failed to fit. It proves
 ranges the type system deliberately does not carry — a constant
 defined as a literal keeps its declared plain-Integer TYPE (refining
 it would make two distinct constants disjoint under unification),
 but its value is known exactly, so the lint can see the store is
 safe and elide the warning (BoundsProverReach.md). Unknown shapes
 return the full i64 range, which never fits a real bound: the
 analysis can only silence true positives, never invent one.

  aexpr-proven-range : TypeEnv, AExpr -> (Integer, Integer)
  aexpr-proven-range (env) (e) =
   when e
    is ALitExpr (val) (kind) (s) ->
     when kind
      is IntLit -> let n = lit-text-to-integer val in (n, n)
      is otherwise -> (i64-min, i64-max)
    is ANameExpr (n) (s) ->
     if env-is-local env (n.value) then local-proven-range env (n.value)
     else name-proven-range env (rename-lookup (env.chapter-renames) (n.value))
    is AApplyExpr (func) (arg) (s) -> apply-proven-range env func arg
    is ABinaryExpr (l) (op) (r) (s) -> binary-proven-range env op l r
    is AIfExpr (c) (t) (el) (s) -> proven-range-union (aexpr-proven-range env t) (aexpr-proven-range env el)
    is ALetExpr (binds) (body) (s) -> aexpr-proven-range env body
    is otherwise -> (i64-min, i64-max)

 A bare name proves as a literal-defined constant first, then as a
 zero-argument builtin fact (__deck-pos).

  name-proven-range : TypeEnv, Text -> (Integer, Integer)
  name-proven-range (env) (name) =
   let idx = env-const-find (env.const-ranges) name 0 (list-length (env.const-ranges))
   in if idx < 0 then builtin-return-range name
   else let c = list-at (env.const-ranges) idx
   in (c.lo, c.hi)

 A let-local proves by its recorded range (populated at its binding
 when the value proved narrower than full i64). A local with no
 recorded range is unknown — the safe default.

  local-proven-range : TypeEnv, Text -> (Integer, Integer)
  local-proven-range (env) (name) =
   let idx = env-local-find (env.local-ranges) name 0 (list-length (env.local-ranges))
   in if idx < 0 then (i64-min, i64-max)
   else let c = list-at (env.local-ranges) idx
   in (c.lo, c.hi)

 A binary arithmetic expression proves by interval arithmetic over
 its operands' proven ranges — the checker-side twin of the emit
 prover's proven-add/sub/mul/div-range, with the same guards: both
 operands non-negative, and the additive and multiplicative arms
 refuse when the resulting hi would exceed the i64 ceiling. An
 unknown operand carries the full i64 range, which fails the
 non-negative guard, so unknowns poison the result — the analysis
 stays silence-only.

  binary-proven-range : TypeEnv, BinaryOp, AExpr, AExpr -> (Integer, Integer)
  binary-proven-range (env) (op) (l) (r) =
   let (l-lo, l-hi) = aexpr-proven-range env l
   in let (r-lo, r-hi) = aexpr-proven-range env r
   in when op
    is OpAdd -> range-arith-add l-lo l-hi r-lo r-hi
    is OpSub -> range-arith-sub l-lo l-hi r-lo r-hi
    is OpMul -> range-arith-mul l-lo l-hi r-lo r-hi
    is OpDiv -> range-arith-div l-lo l-hi r-lo r-hi
    is otherwise -> (i64-min, i64-max)

  range-arith-add : Integer, Integer, Integer, Integer -> (Integer, Integer)
  range-arith-add (l-lo) (l-hi) (r-lo) (r-hi) =
   if l-lo >= 0 & r-lo >= 0
   then if l-hi <= i64-max - r-hi then (l-lo + r-lo, l-hi + r-hi)
        else (i64-min, i64-max)
   else (i64-min, i64-max)

  range-arith-sub : Integer, Integer, Integer, Integer -> (Integer, Integer)
  range-arith-sub (l-lo) (l-hi) (r-lo) (r-hi) =
   if l-lo >= 0 & r-lo >= 0
   then (l-lo - r-hi, l-hi - r-lo)
   else (i64-min, i64-max)

  range-arith-mul : Integer, Integer, Integer, Integer -> (Integer, Integer)
  range-arith-mul (l-lo) (l-hi) (r-lo) (r-hi) =
   if l-lo >= 0 & r-lo >= 0
   then if l-hi == 0 then (0, 0)
   else if r-hi <= i64-max / l-hi then (l-lo * r-lo, l-hi * r-hi)
        else (i64-min, i64-max)
   else (i64-min, i64-max)

  range-arith-div : Integer, Integer, Integer, Integer -> (Integer, Integer)
  range-arith-div (l-lo) (l-hi) (r-lo) (r-hi) =
   if l-lo >= 0 & r-lo > 0
   then (l-lo / r-hi, l-hi / r-lo)
   else (i64-min, i64-max)

 An application proves through three doors. `__narrow x` passes its
 argument's range through, mirroring the emit prover. Otherwise the
 head name is tried against the builtin return facts, and finally
 against the head's DECLARED bounded return - the stage-B
 postcondition guard enforces a declared bounded return at runtime
 (BoundedSignatures.md section 4), so the declared range is a sound
 fact at every call. Both lookups are guarded by env-is-local so a
 binding that shadows a global name never borrows its fact. A
 partial application walks past its remaining arrows to a range the
 lint never uses (its store value is function-typed, which the lint
 skips). A wrong fact here could only silence the warning; the
 runtime narrow-store check is emitted regardless, so program
 soundness never rests on this table.

  apply-proven-range : TypeEnv, AExpr, AExpr -> (Integer, Integer)
  apply-proven-range (env) (func) (arg) =
   let head = apply-head-name func
   in if text-length head == 0 then (i64-min, i64-max)
   else if head == "__narrow" then aexpr-proven-range env arg
   else if env-is-local env head then (i64-min, i64-max)
   else let (b-lo, b-hi) = builtin-return-range head
   in if b-lo > i64-min | b-hi < i64-max then (b-lo, b-hi)
   else declared-return-range env (rename-lookup (env.chapter-renames) head)

  declared-return-range : TypeEnv, Text -> (Integer, Integer)
  declared-return-range (env) (name) =
   if env-has env name == False then (i64-min, i64-max)
   else fun-final-return-range (strip-forall-ty (env-lookup env name))

  fun-final-return-range : CodexType -> (Integer, Integer)
  fun-final-return-range (ty) =
   when ty
    is FunTy (p) (row) (r) -> fun-final-return-range r
    is EffectfulTy (effs) (sc) (ret) -> fun-final-return-range ret
    is IntegerTy (lo) (hi) (mode) -> (lo, hi)
    is otherwise -> (i64-min, i64-max)

 Builtin return facts. All are heap-backed quantities in the 3 GB-RAM
 design: a list cannot hold 2^32 elements in a 4 GB address space
 (elements are at least 8 bytes), a text's byte length cannot exceed
 the heap that holds it, and __deck-pos and __heap-save are heap
 addresses below 4 GB — the same design-era contract the
 bivy-origin/deck-origin field bounds document. Add a fact only when
 the bound is structural, not conventional.

  builtin-return-range : Text -> (Integer, Integer)
  builtin-return-range (name) =
   if name == "list-length" then (0, 4294967295)
   else if name == "text-length" then (0, 4294967295)
   else if name == "__deck-pos" then (0, 4294967295)
   else if name == "__heap-save" then (0, 4294967295)
   else if name == "__buf-write-bytes" then (0, 4294967295)
   else (i64-min, i64-max)

  proven-range-union : (Integer, Integer), (Integer, Integer) -> (Integer, Integer)
  proven-range-union (a) (b) =
   let (a-lo, a-hi) = a
   in let (b-lo, b-hi) = b
   in ((if a-lo <= b-lo then a-lo else b-lo), (if a-hi >= b-hi then a-hi else b-hi))

 A refined position — record field, constructor payload, function
 parameter, or function return — draws the same hybrid check. The
 `descriptor` is the full noun phrase naming the position (e.g.
 "field 'code'", "bounded parameter", "bounded return") so one
 mechanism serves every site (BoundedSignatures.md).

  lint-narrowing-check : UnificationState, TypeEnv, AExpr, CodexType, CodexType, SourceSpan, Text -> UnificationState
  lint-narrowing-check (st) (env) (value-arg) (value-ty) (field-ty) (span) (descriptor) =
   if is-narrow-call value-arg then st
   else when field-ty
    is IntegerTy (f-lo) (f-hi) (f-mode) ->
     when f-mode
      is OvError ->
       when value-arg
        is ALitExpr (val-text) (kind) (s) ->
         when kind
          is IntLit ->
           let n = lit-text-to-integer val-text
           in if n >= f-lo & n <= f-hi then st
           else __record-set st "bag" (bag-add (st.bag) (make-error cdx-narrowing-record-set-literal (descriptor & " has bound " & integer-to-text f-lo & ".." & integer-to-text f-hi & " but assigned literal " & integer-to-text n & " is out of range") span))
          is otherwise -> st
        is otherwise ->
         let resolved-vty = deep-resolve st value-ty
         in when resolved-vty
          is IntegerTy (v-lo) (v-hi) (v-mode) ->
           if v-lo >= f-lo & v-hi <= f-hi then st
           else lint-narrowing-prove st env value-arg f-lo f-hi v-lo v-hi span descriptor
          is otherwise -> st
      is otherwise -> st
    is otherwise -> st

 The type range failed to fit; before rejecting, try the expression
 analysis. A NON-TRIVIAL proof — one whose proven range is a real
 interval (p-lo < p-hi), the prover deriving a bound from arithmetic
 or flow — is reported as the CDX2053 info so the elision stays
 visible in build logs and assertable in .diag sidecars. A TRIVIAL
 proof, whose proven range is a single point (p-lo == p-hi, a literal
 or a named constant that folds to one value), elides silently: the
 fit is self-evident and reporting it drowned the informative proofs
 (~96% of CDX2053s on a self-compile were single-point constants).
 The elision itself is unchanged in both cases — only the info line
 is gated. An unproven flow is the CDX2051 error — the campaign
 endgame (BoundedSignatures.md): a bound is a contract, so a value
 that cannot be shown to honour it does not compile. The author
 either strengthens the source (a bounded field, parameter, return,
 or constant the prover can see) or takes responsibility with
 __narrow, which traps at runtime if violated.

  lint-narrowing-prove : UnificationState, TypeEnv, AExpr, Integer, Integer, Integer, Integer, SourceSpan, Text -> UnificationState
  lint-narrowing-prove (st) (env) (value-arg) (f-lo) (f-hi) (v-lo) (v-hi) (span) (descriptor) =
   let (p-lo, p-hi) = aexpr-proven-range env value-arg
   in if p-lo >= f-lo & p-hi <= f-hi
   then if p-lo == p-hi then st
    else __record-set st "bag" (bag-add (st.bag) (make-info cdx-narrowing-proven (descriptor & " has bound " & integer-to-text f-lo & ".." & integer-to-text f-hi & " and the value expression is proven within " & integer-to-text p-lo & ".." & integer-to-text p-hi & "; bounds check elided") span))
   else __record-set st "bag" (bag-add (st.bag) (make-error cdx-narrowing-record-set (descriptor & " has bound " & integer-to-text f-lo & ".." & integer-to-text f-hi & " but value type is " & integer-to-text v-lo & ".." & integer-to-text v-hi & "; prove the value's range or assert it with __narrow, which traps at runtime if violated") span))
  infer-int-lit-arg : UnificationState, CodexType, Text, LiteralKind -> CheckResult
  infer-int-lit-arg (st) (func-ty) (val) (kind) =
   when kind
    is IntLit ->
     let stripped = strip-forall-ty func-ty
     in when stripped
      is FunTy (param-ty) (row) (ret-ty) ->
       when param-ty
        is IntegerTy (lo) (hi) (mode) ->
         let n = lit-text-to-integer val
         in if n >= lo & n <= hi then CheckResult {
          inferred-type = deck-record (IntegerTy lo hi mode),
          effect-row = empty-row,
          state = st
         }
         else infer-literal st kind
        is otherwise -> infer-literal st kind
      is otherwise -> infer-literal st kind
    is otherwise -> infer-literal st kind

Section: Infer List
  infer-list : UnificationState, TypeEnv, List AExpr, SourceSpan -> CheckResult
  infer-list (st) (env) (elems) (span) =
   if list-length elems == 0
    then
     let (fr-ty, fr-st) = fresh-and-advance st
     in CheckResult {
      inferred-type = fr-ty,
      effect-row = empty-row,
      state = fr-st
     }
    else let first = infer-expr st env (list-at elems 0)
    in let (elems-row, st2) = unify-list-elems (first.state) env elems (first.inferred-type) 1 (list-length elems) (first.effect-row)
    in CheckResult {
      inferred-type = deck-record (ListTy (first.inferred-type)),
      effect-row = elems-row,
      state = st2
     }

  unify-list-elems : UnificationState, TypeEnv, List AExpr, CodexType, Integer, Integer, EffectRow -> (EffectRow, UnificationState)
  unify-list-elems (st) (env) (elems) (elem-ty) (i) (len) (acc-row) =
   if i == len then (acc-row, st)
   else let e = list-at elems i
   in let er = infer-expr st env e
   in let (_, u-st) = unify (er.state) (er.inferred-type) elem-ty (aexpr-span e)
   in let (acc2, acc-st) = row-union u-st acc-row (er.effect-row)
   in unify-list-elems acc-st env elems elem-ty (i + 1) len acc2

Section: Infer Match
  is-gadt-type : UnificationState, CodexType -> Boolean
  is-gadt-type (st) (ty) =
   let resolved = deep-resolve st ty
   in when resolved
    is SumTy (name) (args) (ctors) -> any-ctor-has-return-type ctors 0 (list-length ctors)
    is otherwise -> False

  any-ctor-has-return-type : List SumCtor, Integer, Integer -> Boolean
  any-ctor-has-return-type (ctors) (i) (len) =
   if i >= len then False
   else if list-length ((list-at ctors i).return-type) > 0 then True
   else any-ctor-has-return-type ctors (i + 1) len

 A match's ambient is the scrutinee's union every arm's guard and
 body — an over-approximation across arms (only one arm runs), which
 is the sound direction. The arm walkers thread the accumulated row.
 A GADT arm's ambient union survives the substitution restore
 deliberately: the arm really is evaluated at runtime, so its
 effects are part of the match's ambient even though its speculative
 type bindings are rolled back.

  infer-match : UnificationState, TypeEnv, AExpr, List AMatchArm -> CheckResult
  infer-match (st) (env) (scrutinee) (arms) =
   let sr = infer-expr st env scrutinee
   in let (fr-ty, fr-st) = fresh-and-advance (sr.state)
   in let gadt = is-gadt-type fr-st (sr.inferred-type)
   in let (arms-row, st2) = infer-match-arms fr-st env (sr.inferred-type) fr-ty arms 0 (list-length arms) gadt (sr.effect-row)
   in let st3 = check-match-exhaustiveness st2 (sr.inferred-type) arms (aexpr-span scrutinee)
   in CheckResult {
    inferred-type = fr-ty,
    effect-row = arms-row,
    state = st3
   }

  infer-match-arms : UnificationState, TypeEnv, CodexType, CodexType, List AMatchArm, Integer, Integer, Boolean, EffectRow -> (EffectRow, UnificationState)
  infer-match-arms (st) (env) (scrut-ty) (result-ty) (arms) (i) (len) (is-gadt) (acc-row) =
   if i == len then (acc-row, st)
   else let arm = list-at arms i
   in if is-gadt then infer-gadt-arm st env scrut-ty result-ty arm arms (i + 1) len acc-row else infer-plain-arm st env scrut-ty result-ty arm arms (i + 1) len is-gadt acc-row

  infer-plain-arm : UnificationState, TypeEnv, CodexType, CodexType, AMatchArm, List AMatchArm, Integer, Integer, Boolean, EffectRow -> (EffectRow, UnificationState)
  infer-plain-arm (st) (env) (scrut-ty) (result-ty) (arm) (arms) (next) (len) (is-gadt) (acc-row) =
   let pr = bind-pattern st env (arm.pattern) scrut-ty
   in let gr = infer-expr (pr.state) (pr.env) (arm.guard)
   in let (_, gu-st) = unify (gr.state) (gr.inferred-type) BooleanTy (aexpr-span (arm.guard))
   in let br = infer-expr gu-st (pr.env) (arm.body)
   in let (_, u-st) = unify (br.state) (br.inferred-type) result-ty (aexpr-span (arm.body))
   in let (acc2, acc-st) = row-union u-st acc-row (gr.effect-row)
   in let (acc3, acc-st2) = row-union acc-st acc2 (br.effect-row)
   in infer-match-arms acc-st2 env scrut-ty result-ty arms next len is-gadt acc3

  infer-gadt-arm : UnificationState, TypeEnv, CodexType, CodexType, AMatchArm, List AMatchArm, Integer, Integer, EffectRow -> (EffectRow, UnificationState)
  infer-gadt-arm (st) (env) (scrut-ty) (result-ty) (arm) (arms) (next) (len) (acc-row) =
   let saved = snapshot-substitutions st
   in let pr = bind-pattern st env (arm.pattern) scrut-ty
   in let gr = infer-expr (pr.state) (pr.env) (arm.guard)
   in let (_, gu-st) = unify (gr.state) (gr.inferred-type) BooleanTy (aexpr-span (arm.guard))
   in let br = infer-expr gu-st (pr.env) (arm.body)
   in let (_, u-st) = unify (br.state) (br.inferred-type) result-ty (aexpr-span (arm.body))
   in let restored = restore-substitutions u-st saved
   in let (acc2, acc-st) = row-union restored acc-row (gr.effect-row)
   in let (acc3, acc-st2) = row-union acc-st acc2 (br.effect-row)
   in infer-match-arms acc-st2 env scrut-ty result-ty arms next len True acc3

  check-match-exhaustiveness : UnificationState, CodexType, List AMatchArm, SourceSpan -> UnificationState
  check-match-exhaustiveness (st) (scrut-ty) (arms) (span) =
   let resolved = deep-resolve st scrut-ty
   in when resolved
    is SumTy (name) (args) (ctors) ->
     if match-has-catchall arms 0 (list-length arms) then st
     else let covered = collect-covered-ctors arms 0 (list-length arms) []
      in let missing = find-missing-ctors ctors covered 0 (list-length ctors) []
      in if list-length missing == 0 then st
         else __record-set st "bag" (bag-add (st.bag) (make-error cdx-non-exhaustive-match ("Non-exhaustive match on '" & name.value & "': missing " & format-missing-ctors missing 0 (list-length missing) "") span))
    is otherwise -> st

  match-has-catchall : List AMatchArm, Integer, Integer -> Boolean
  match-has-catchall (arms) (i) (len) =
   if i == len then False
   else let pat = (list-at arms i).pattern
   in when pat
    is AWildPat (s) | AVarPat (n) (s) -> True
    is otherwise -> match-has-catchall arms (i + 1) len

  collect-covered-ctors : List AMatchArm, Integer, Integer, List Text -> List Text
  collect-covered-ctors (arms) (i) (len) (acc) =
   if i == len then acc
   else let pat = (list-at arms i).pattern
   in when pat
    is ACtorPat (ctor-name) (sub-pats) (s) ->
     collect-covered-ctors arms (i + 1) len (list-push acc (ctor-name.value))
    is otherwise -> collect-covered-ctors arms (i + 1) len acc

  find-missing-ctors : List SumCtor, List Text, Integer, Integer, List Text -> List Text
  find-missing-ctors (ctors) (covered) (i) (len) (acc) =
   if i == len then acc
   else let c = list-at ctors i
   in if text-list-contains covered (c.name.value) 0 (list-length covered)
      then find-missing-ctors ctors covered (i + 1) len acc
      else find-missing-ctors ctors covered (i + 1) len (list-push acc (c.name.value))

  text-list-contains : List Text, Text, Integer, Integer -> Boolean
  text-list-contains (xs) (target) (i) (len) =
   if i == len then False
   else if list-at xs i == target then True
   else text-list-contains xs target (i + 1) len

  format-missing-ctors : List Text, Integer, Integer, Text -> Text
  format-missing-ctors (names) (i) (len) (acc) =
   if i == len then acc
   else let sep = if i == 0 then "" else ", "
   in format-missing-ctors names (i + 1) len (acc & sep & list-at names i)

  PatBindResult = record {
   state : UnificationState,
   env : TypeEnv
  }

  bind-pattern : UnificationState, TypeEnv, APat, CodexType -> PatBindResult
  bind-pattern (st) (env) (pat) (ty) =
   when pat
    is AVarPat (name) (s) -> PatBindResult {
     state = st,
     env = env-bind-local env (name.value) ty
    }
    is AWildPat (s) | ALitPat (val) (kind) (s) -> PatBindResult {
     state = st,
     env = env
    }
    is AVecPat (sub-pats) (s) ->
     let elem-ty = when ty is VectorTy (n) (t) -> t is otherwise -> ErrorTy
     in bind-vec-sub-patterns st env sub-pats elem-ty 0 (list-length sub-pats)
    is ACtorPat (ctor-name) (sub-pats) (s) ->
     if env-has env (ctor-name.value) == False
     then let err-st = __record-set st "bag" (bag-add (st.bag) (make-error cdx-unknown-pattern-ctor ("Pattern constructor '" & ctor-name.value & "' is not in scope; this arm could never match. Check the constructor names of the scrutinee's type.") s))
      in bind-ctor-sub-patterns err-st env sub-pats ErrorTy 0 (list-length sub-pats)
     else
      let (ctor-ty, ctor-st) = instantiate-type st (env-lookup env (ctor-name.value))
      in let ctor-ret = strip-fun-args ctor-ty
      in let (ok, unified-st) = unify ctor-st ctor-ret ty s
      in bind-ctor-sub-patterns unified-st env sub-pats ctor-ty 0 (list-length sub-pats)

  bind-ctor-sub-patterns : UnificationState, TypeEnv, List APat, CodexType, Integer, Integer -> PatBindResult
  bind-ctor-sub-patterns (st) (env) (sub-pats) (ctor-ty) (i) (len) =
   if i == len then PatBindResult {
    state = st,
    env = env
   }
   else when ctor-ty
     is FunTy (param-ty) (row) (ret-ty) ->
      let pr = bind-pattern st env (list-at sub-pats i) param-ty
      in bind-ctor-sub-patterns (pr.state) (pr.env) sub-pats ret-ty (i + 1) len
     is otherwise ->
      let (fr-ty, fr-st) = fresh-and-advance st
      in let pr = bind-pattern fr-st env (list-at sub-pats i) fr-ty
      in bind-ctor-sub-patterns (pr.state) (pr.env) sub-pats ctor-ty (i + 1) len

  bind-vec-sub-patterns : UnificationState, TypeEnv, List APat, CodexType, Integer, Integer -> PatBindResult
  bind-vec-sub-patterns (st) (env) (sub-pats) (elem-ty) (i) (len) =
   if i == len then PatBindResult {
    state = st,
    env = env
   }
   else let pr = bind-pattern st env (list-at sub-pats i) elem-ty
   in bind-vec-sub-patterns (pr.state) (pr.env) sub-pats elem-ty (i + 1) len

Section: Infer Act

 An act block performs every statement, so its ambient row is the
 union of its statements' ambients; the act's TYPE is simply the
 last statement's. The stage-3b readers consume the row, so the old
 EffectfulTy name-union machinery (act-wrap-effects, act-value-type,
 union-names) is retired — effects no longer ride result types.
 Effectful values and calls arrive at the statements already
 unwrapped by infer-name and infer-application, their effects in the
 ambient.

  infer-act : UnificationState, TypeEnv, List AActStmt -> CheckResult
  infer-act (st) (env) (stmts) =
   infer-act-loop st env stmts 0 (list-length stmts) NothingTy empty-row

  infer-act-loop : UnificationState, TypeEnv, List AActStmt, Integer, Integer, CodexType, EffectRow -> CheckResult
  infer-act-loop (st) (env) (stmts) (i) (len) (last-ty) (acc-row) =
   if i == len then CheckResult {
    inferred-type = deep-resolve st last-ty,
    effect-row = acc-row,
    state = st
   }
   else let stmt = list-at stmts i
   in when stmt
     is AActExprStmt (e) (s) ->
      let er = infer-expr st env e
   in let (acc2, acc-st) = row-union (er.state) acc-row (er.effect-row)
   in infer-act-loop acc-st env stmts (i + 1) len (er.inferred-type) acc2
     is AActBindStmt (name) (e) (s) ->
      let er = infer-expr st env e
   in let (acc2, acc-st) = row-union (er.state) acc-row (er.effect-row)
   in let env2 = env-bind-local env (name.value) (deep-resolve acc-st (er.inferred-type))
   in infer-act-loop acc-st env2 stmts (i + 1) len (er.inferred-type) acc2

Section: Infer Expression (dispatch)
  infer-expr : UnificationState, TypeEnv, AExpr -> CheckResult
  infer-expr (st) (env) (expr) = infer-expr-at st env expr 0

  infer-expr-at : UnificationState, TypeEnv, AExpr, Integer -> CheckResult
  infer-expr-at (st) (env) (expr) (depth) =
   if depth >= max-recursion-depth then CheckResult {
    inferred-type = ErrorTy,
    effect-row = empty-row,
    state = add-unify-error st cdx-resource-exhausted ("compiler resource exhausted in type-checker.infer-expr (budget " & integer-to-text max-recursion-depth & ")") (aexpr-span expr)
   }
   else when expr
    is ALitExpr (val) (kind) (s) -> infer-literal (check-int-lit-range st val kind s) kind
    is ANameExpr (name) (s) -> infer-name st env (name.value) s
    is ABinaryExpr (left) (op) (right) (s) -> infer-binary st env left op right s
    is AUnaryExpr (operand) (s) ->
     let r = infer-expr-at st env operand (depth + 1)
     in let op-ty = deep-resolve (r.state) (r.inferred-type)
     in if is-real-type op-ty then CheckResult {
      inferred-type = op-ty,
      effect-row = r.effect-row,
      state = r.state
     }
     else let (_, u-st) = unify (r.state) op-ty int-ty-default (aexpr-span operand)
     in CheckResult {
      inferred-type = int-ty-default,
      effect-row = r.effect-row,
      state = u-st
     }
    is AApplyExpr (func) (arg) (s) -> infer-application st env func arg s
    is AIfExpr (cond) (then-e) (else-e) (s) -> infer-if st env cond then-e else-e s
    is ALetExpr (bindings) (body) (s) -> infer-let st env bindings body
    is ALambdaExpr (params) (body) (s) -> infer-lambda st env params body
    is AMatchExpr (scrutinee) (arms) (s) -> infer-match st env scrutinee arms
    is AListExpr (elems) (s) -> infer-list st env elems s
    is AActExpr (stmts) (s) -> infer-act st env stmts
    is AFieldAccess (obj) (field) (s) ->
     let r = infer-expr-at st env obj (depth + 1)
     in let resolved = deep-resolve (r.state) (r.inferred-type)
     in when resolved
      is RecordTy (rname) (rargs) (rfields) ->
       let ftype = lookup-record-field rfields (field.value)
     in let st2 = when ftype
          is ErrorTy -> add-unify-error (r.state) cdx-unknown-record-field ("Record type has no field '" & field.value & "'") s
          is otherwise -> r.state
     in CheckResult {
        inferred-type = ftype,
        effect-row = r.effect-row,
        state = st2
       }
      is ConstructedTy (cname) (cargs) ->
       let record-type = resolve-constructed-to-record env (cname.value)
     in when record-type
        is RecordTy (rname) (rargs) (rfields) ->
         let raw-ftype = lookup-record-field rfields (field.value)
     in let ftype = apply-type-args-subst rargs cargs raw-ftype 0 (list-length rargs)
     in let st2 = when raw-ftype
            is ErrorTy -> add-unify-error (r.state) cdx-unknown-record-field ("Record type '" & cname.value & "' has no field '" & field.value & "'") s
            is otherwise -> r.state
     in CheckResult {
          inferred-type = ftype,
          effect-row = r.effect-row,
          state = st2
         }
        is otherwise ->
         let (fr-ty, fr-st) = fresh-and-advance (r.state)
     in CheckResult {
          inferred-type = fr-ty,
          effect-row = r.effect-row,
          state = fr-st
         }
      is otherwise ->
       let (fr-ty, fr-st) = fresh-and-advance (r.state)
     in CheckResult {
        inferred-type = fr-ty,
        effect-row = r.effect-row,
        state = fr-st
       }

    is ARecordExpr (name) (fields) (s) ->
     let ctor-raw = if env-has env (name.value) then env-lookup env (name.value) else ErrorTy
     in let (inst-ty, inst-st) = instantiate-type st ctor-raw
     in let result-type = strip-fun-args inst-ty
     in let (fields-row, st2) = infer-and-unify-record-fields inst-st env fields result-type 0 (list-length fields) empty-row
     in let st3 = check-mutation-in-ctor-fields (record-expr-type st2 s result-type) fields 0 (list-length fields)
     in CheckResult {
      inferred-type = result-type,
      effect-row = fields-row,
      state = st3
     }
    is AHandleExpr (eff) (body) (clauses) (s) ->
     let body-r = infer-expr-at st env body (depth + 1)
     in let resolved-b = resolve-row (body-r.state) (body-r.effect-row)
     in let has-e = row-labels-have resolved-b (eff.value)
     in let (after-row, after-st) = if has-e | resolved-b.tail-id >= 0
        then let (tp, tp-st) = fresh-row-id (body-r.state)
             in let ext = make-row [deck-record (EffectLabel { name = Name { value = eff.value }, scope = "" })] "" tp
             in let (_, u-st) = unify-row tp-st (body-r.effect-row) ext s
             in (deck-record (row-var tp), u-st)
        else (body-r.effect-row, __record-set (body-r.state) "bag" (bag-add ((body-r.state).bag) (make-warning cdx-handler-unused ("handler for '" & eff.value & "' encloses a body whose type performs no " & eff.value) s)))
     in let (handle-row, cl-st) = infer-handle-clauses after-st env clauses 0 (list-length clauses) after-row
     in CheckResult {
      inferred-type = body-r.inferred-type,
      effect-row = handle-row,
      state = cl-st
     }
    is AWithTimeoutExpr (timeout) (effs) (scopes) (body) (s) ->
     infer-expr-at st env body (depth + 1)
    is ATryExpr (max) (body) (fb) (fail) (s) ->
     let body-r = infer-act st env body
     in let fb-r = if list-length fb > 0 then infer-act (body-r.state) env fb else body-r
     in let fail-r = if list-length fail > 0 then infer-act (fb-r.state) env fail else fb-r
     in let (amb1, amb1-st) = row-union (fail-r.state) (body-r.effect-row) (fb-r.effect-row)
     in let (amb, amb-st) = row-union amb1-st amb1 (fail-r.effect-row)
     in CheckResult { inferred-type = body-r.inferred-type, effect-row = amb, state = amb-st }
    is AFieldAssignExpr (rec) (field) (val) (s) ->
     let rr = infer-expr-at st env rec (depth + 1)
     in let vr = infer-expr-at (rr.state) env val (depth + 1)
     in let resolved = deep-resolve (vr.state) (rr.inferred-type)
     in let type-name = when resolved
      is RecordTy (rname) (rargs) (rfields) -> rname.value
      is ConstructedTy (cname) (cargs) -> cname.value
      is otherwise -> ""
     in let marker-name = "__mutable-" & type-name
     in let mut-ok = env-has env marker-name
     in let st-mut = if mut-ok then vr.state
      else add-unify-error (vr.state) cdx-field-assign-immutable ("Field assignment requires a mutable record; '" & type-name & "' is immutable") s
     in let field-ty = when resolved
      is RecordTy (rname) (rargs) (rfields) -> lookup-record-field rfields (field.value)
      is ConstructedTy (cname) (cargs) ->
       let record-type = resolve-constructed-to-record env (cname.value)
     in when record-type
        is RecordTy (rname) (rargs) (rfields) ->
         let raw-ftype = lookup-record-field rfields (field.value)
     in apply-type-args-subst rargs cargs raw-ftype 0 (list-length rargs)
        is otherwise -> ErrorTy
      is otherwise -> ErrorTy
     in let st2 = when field-ty
      is ErrorTy -> add-unify-error st-mut cdx-unknown-record-field ("Record type has no field '" & field.value & "'") s
      is otherwise -> let (_, u-st) = unify st-mut (vr.inferred-type) field-ty s in u-st
     in let (amb, amb-st) = row-union st2 (rr.effect-row) (vr.effect-row)
     in CheckResult {
      inferred-type = rr.inferred-type,
      effect-row = amb,
      state = amb-st
     }
    is ALazyExpr (inner) (s) ->
     let ir = infer-expr-at st env inner (depth + 1)
     in let (thunk-row, thunk-st) = open-row-if-closed (ir.state) (ir.effect-row)
     in CheckResult {
      inferred-type = deck-record (FunTy int-ty-default thunk-row (ir.inferred-type)),
      effect-row = empty-row,
      state = thunk-st
     }
    is AErrorExpr (msg) (s) -> CheckResult {
     inferred-type = ErrorTy,
     effect-row = empty-row,
     state = st
    }
    is AInductionExpr (scrut) (arms) (s) -> CheckResult {
     inferred-type = ProofTy,
     effect-row = empty-row,
     state = __record-set st "bag" (bag-add (st.bag) (make-warning cdx-induction-unverified "induction proof accepted as an unproven axiom; structural subgoal checking did not apply (proof-system Stage 5)" s))
    }

  check-mutation-in-ctor-fields : UnificationState, List AFieldExpr, Integer, Integer -> UnificationState
  check-mutation-in-ctor-fields (st) (fields) (i) (len) =
   if i >= len then st
   else let f = list-at fields i
     in let st2 = if aexpr-mentions-record-set (f.value) then __record-set st "bag" (bag-add (st.bag) (make-warning cdx-mutation-in-constructor ("Field '" & f.name.value & "' contains __record-set, which mutates in place. Other fields reading the same record will see the mutated value. Bind the __record-set result to a let before the constructor, or use revised.") (f.span)))
       else st
     in check-mutation-in-ctor-fields st2 fields (i + 1) len

  aexpr-mentions-record-set : AExpr -> Boolean
  aexpr-mentions-record-set (e) =
   when e
    is ANameExpr (n) (s) -> n.value == "__record-set"
    is AApplyExpr (f) (a) (s) -> aexpr-mentions-record-set f | aexpr-mentions-record-set a
    is ABinaryExpr (l) (op) (r) (s) -> aexpr-mentions-record-set l | aexpr-mentions-record-set r
    is AIfExpr (c) (t) (el) (s) -> aexpr-mentions-record-set c | aexpr-mentions-record-set t | aexpr-mentions-record-set el
    is ALetExpr (binds) (body) (s) -> aexpr-mentions-record-set body | aexpr-list-mentions-record-set-binds binds 0 (list-length binds)
    is AMatchExpr (scrut) (arms) (s) -> aexpr-mentions-record-set scrut
    is AFieldAccess (obj) (f) (s) -> aexpr-mentions-record-set obj
    is otherwise -> False

  aexpr-list-mentions-record-set-binds : List ALetBind, Integer, Integer -> Boolean
  aexpr-list-mentions-record-set-binds (binds) (i) (len) =
   if i >= len then False
   else let b = list-at binds i
     in if aexpr-mentions-record-set (b.value) then True
     else aexpr-list-mentions-record-set-binds binds (i + 1) len

 The handler rule (EffectRows.md §7): if the body's row can perform
 the handled effect (has the label, or is open), unifying it against
 the extension {E | t'} forces E into the concrete part and t' is
 exactly everything else the body does — precise discharge, one unify
 call. A closed body row without E discharges nothing: legal,
 suspicious, CDX2092. Clause bodies are inferred for their own
 ambient rows (a Console handler whose clause writes files yields
 FileSystem) and unioned into the result; clause VALUE typing stays
 with lowering, as before this stage.

  row-labels-have : EffectRow, Text -> Boolean
  row-labels-have (row) (name) =
   row-labels-have-loop (row.labels) name 0 (list-length (row.labels))

  row-labels-have-loop : List EffectLabel, Text, Integer, Integer -> Boolean
  row-labels-have-loop (ls) (name) (i) (len) =
   if i == len then False
   else if ((list-at ls i).name.value) == name then True
   else row-labels-have-loop ls name (i + 1) len

  infer-handle-clauses : UnificationState, TypeEnv, List AHandleClause, Integer, Integer, EffectRow -> (EffectRow, UnificationState)
  infer-handle-clauses (st) (env) (clauses) (i) (len) (acc-row) =
   if i == len then (acc-row, st)
   else let c = list-at clauses i
   in let pr = bind-lambda-params st env (c.params) 0 (list-length (c.params)) []
   in let (rs-ty, rs-st) = fresh-and-advance (pr.state)
   in let env3 = env-bind-local (pr.env) ((c.resume-name).value) rs-ty
   in let br = infer-expr rs-st env3 (c.body)
   in let (acc2, acc-st) = row-union (br.state) acc-row (br.effect-row)
   in infer-handle-clauses acc-st env clauses (i + 1) len acc2

 The flat-effect handler machinery (strip-effect-from-env's
 whole-environment rewrite, strip-handled-effect, filter-effect) is
 retired: discharge is the §7 row unification above, and effects no
 longer ride result types where stripping could reach them.

  resolve-constructed-to-record : TypeEnv, Text -> CodexType
  resolve-constructed-to-record (env) (name) =
   if env-has env name then strip-fun-args (env-lookup env name)
   else ErrorTy

  apply-type-args-subst : List CodexType, List CodexType, CodexType, Integer, Integer -> CodexType
  apply-type-args-subst (generic) (concrete-args) (ty) (i) (len) =
   if i == len then ty
   else if i >= list-length concrete-args then ty
   else let g = list-at generic i
   in when g
    is TypeVar (id) -> apply-type-args-subst generic concrete-args (subst-type-var ty id (list-at concrete-args i)) (i + 1) len
    is otherwise -> apply-type-args-subst generic concrete-args ty (i + 1) len

  infer-record-fields : UnificationState, TypeEnv, List AFieldExpr, Integer, Integer -> UnificationState
  infer-record-fields (st) (env) (fields) (i) (len) =
   if i == len then st
   else let f = list-at fields i
   in let r = infer-expr st env (f.value)
   in infer-record-fields (r.state) env fields (i + 1) len

  infer-and-unify-record-fields : UnificationState, TypeEnv, List AFieldExpr, CodexType, Integer, Integer, EffectRow -> (EffectRow, UnificationState)
  infer-and-unify-record-fields (st) (env) (fields) (record-ty) (i) (len) (acc-row) =
   if i == len then (acc-row, st)
   else let f = list-at fields i
   in let r = infer-expr st env (f.value)
   in let expected = when record-ty
       is RecordTy (rname) (rargs) (rfields) -> lookup-record-field rfields (f.name.value)
       is otherwise -> ErrorTy
   in let st2 = when expected
       is ErrorTy -> r.state
       is otherwise -> let (_, u-st) = unify (r.state) (r.inferred-type) expected (aexpr-span (f.value)) in u-st
   in let st3 = lint-narrowing-check st2 env (f.value) (r.inferred-type) expected (aexpr-span (f.value)) ("field '" & (f.name.value) & "'")
   in let (acc2, acc-st) = row-union st3 acc-row (r.effect-row)
   in infer-and-unify-record-fields acc-st env fields record-ty (i + 1) len acc2

Page 2 of 2

