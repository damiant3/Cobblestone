Chapter: Type Checker
  cites Codex chapter Build Settings (max-recursion-depth, max-list-literal-elems)
  cites Foreword chapter Tuple
  cites Math chapter Interval

 Expression type inference dispatch.

Section: Check Result

 The judgment is Γ ⊢ e : τ | ε (ruled
 2026-07-02): effect-row is the expression's AMBIENT row -- what
 evaluating it performs. The effects of a function VALUE the
 expression produces live on that value's arrow, never in the
 ambient; a lambda's ambient is empty and its body's ambient becomes
 the synthesized arrow's row. Compound expressions row-union their
 parts; applications add the row captured from the callee's arrow.
 Until stage 3b migrates concrete effects onto arrows, every ambient
 row computes to the interned empty row, which is what keeps this
 plumbing inert and the fixed point byte-identical.

  CheckResult = record {
   inferred-type : CodexType,
   effect-row : EffectRow,
   state : UnificationState
  }

Section: Infer Literal
  infer-literal : UnificationState, LiteralKind -> CheckResult
  infer-literal (st) (kind) =
   when kind
    is IntLit -> CheckResult {
     inferred-type = int-ty-default,
     effect-row = empty-row,
     state = st
    }
    is NumLit -> CheckResult {
     inferred-type = real-f64,
     effect-row = empty-row,
     state = st
    }
    is TextLit -> CheckResult {
     inferred-type = TextTy,
     effect-row = empty-row,
     state = st
    }
    is CharLit -> CheckResult {
     inferred-type = CharTy,
     effect-row = empty-row,
     state = st
    }
    is BoolLit -> CheckResult {
     inferred-type = BooleanTy,
     effect-row = empty-row,
     state = st
    }

Section: Literal Range

 An integer literal wider than 64 bits would silently wrap in
 lit-text-to-integer at lowering, so the checker rejects it here from
 the digit text alone: skip underscores and leading zeros, then a
 significant-digit count beyond nineteen always overflows, and at
 exactly nineteen a digit-wise compare against the maximum decides.
 A hash literal is a raw bit pattern, so its bound is simpler: up
 to sixteen significant hex digits fill 64 bits exactly, and more
 always overflow. No conversion, no allocation.

  int-lit-first-sig : Text, Integer, Integer -> Integer
  int-lit-first-sig (val) (i) (len) =
   if i >= len then len
   else let c = char-code-at val i
   in if c == char-code '0' | c == char-code '_' then int-lit-first-sig val (i + 1) len
      else i

  int-lit-sig-digits : Text, Integer, Integer, Integer -> Integer
  int-lit-sig-digits (val) (i) (len) (acc) =
   if i >= len then acc
   else if char-code-at val i == char-code '_' then int-lit-sig-digits val (i + 1) len acc
   else int-lit-sig-digits val (i + 1) len (acc + 1)

  int-lit-exceeds : Text, Integer, Integer, Text, Integer -> Boolean
  int-lit-exceeds (val) (i) (len) (max-text) (j) =
   if i >= len then False
   else let c = char-code-at val i
   in if c == char-code '_' then int-lit-exceeds val (i + 1) len max-text j
      else let m = char-code-at max-text j
      in if c > m then True
         else if c < m then False
         else int-lit-exceeds val (i + 1) len max-text (j + 1)

  int-lit-out-of-range : Text -> Boolean
  int-lit-out-of-range (val) =
   let len = text-length val
   in if is-hex-literal-text val then
       let start = int-lit-first-sig val 1 len
       in int-lit-sig-digits val start len 0 > 16
      else
       let start = int-lit-first-sig val 0 len
       in let sig = int-lit-sig-digits val start len 0
       in if sig < 19 then False
          else if sig > 19 then True
          else int-lit-exceeds val start len "9223372036854775807" 0

  check-int-lit-range : UnificationState, Text, LiteralKind, SourceSpan -> UnificationState
  check-int-lit-range (st) (val) (kind) (span) =
   when kind
    is IntLit ->
     if int-lit-out-of-range val
     then __record-set st "bag" (bag-add (st.bag) (make-error cdx-int-literal-overflow ("Integer literal '" & val & "' exceeds 64 bits (decimal max 9223372036854775807, hash form max 16 hex digits) and would be silently truncated") span))
     else st
    is otherwise -> st

Section: Infer Name
 A name reference instantiates, then OPENS each closed spine row with
 a fresh tail (the Koka open rule, §6a): a pure or less-effectful
 function flows into a more-effectful context through plain
 unification. Opening happens only here -- never at binding positions
 (a def's own signature, record fields, parameter annotations), which
 instantiate through resolve-declared-type and the ctor paths.
 Referencing an effectful VALUE (read-line) performs its effects:
 they become the reference's ambient row and the type unwraps to the
 inner value type.

  infer-name : UnificationState, TypeEnv, Text, SourceSpan -> CheckResult
  infer-name (st) (env) (name) (span) =
   let resolved = rename-lookup (env.chapter-renames) name
   in if env-has env resolved
    then
     let raw = env-lookup env resolved
     in let (inst-ty0, inst-st) = instantiate-type st raw
     in let (inst-ty, opened-st) = open-spine-rows inst-st inst-ty0
     in let warned-st = if name == "assume"
      then __record-set opened-st "bag" (bag-add (opened-st.bag) (make-warning cdx-axiom-assumed "Proof uses 'assume': this equality is asserted as an unproven axiom, not checked. It is part of the trust trail." span))
      else opened-st
     in when inst-ty
        is EffectfulTy (effs) (sc) (inner) -> CheckResult {
         inferred-type = inner,
         effect-row = make-row-from-names effs sc "",
         state = record-expr-type warned-st span inner
        }
        is otherwise -> CheckResult {
         inferred-type = inst-ty,
         effect-row = empty-row,
         state = record-expr-type warned-st span inst-ty
        }
    else CheckResult {
     inferred-type = ErrorTy,
     effect-row = empty-row,
     state = if name == "Nothing"
      then add-unify-error st cdx-nothing-as-value "'Nothing' is a type, not a value. For an empty Maybe use 'None' (cite Foreword chapter Maybe); 'Nothing' is only the return type of effectful procedures, e.g. [Console] Nothing." span
      else add-unify-error st cdx-unknown-name ("Unknown name: " & name) span
    }

  open-spine-rows : UnificationState, CodexType -> (CodexType, UnificationState)
  open-spine-rows (st) (ty) =
   when ty
    is FunTy (p) (row) (r) ->
     let (r2, st2) = open-spine-rows st r
     in if row.tail-id < 0 & text-length (row.tail-name) == 0
        then let (t, st3) = fresh-row-id st2
             in (deck-record (FunTy p (deck-record (row-with-tail-id row t)) r2), st3)
        else (deck-record (FunTy p row r2), st2)
    is otherwise -> (ty, st)

 Instantiation strips a type's ForAll binders and hands each one a
 fresh unification variable. That is what a CALL SITE wants: the
 caller is free to choose, so the choice must be solvable.

 instantiate-type runs on the hottest path in the type checker -- every
 variable reference instantiates its type -- so it allocates nothing it
 does not have to. It returns a pair, and a pair is a heap record.

 A def's own body wants the opposite of instantiation, and needs to
 know which variables the caller owns in order to say so, so
 instantiate-collect below reports the type-variable ids it mints.
 That report is a third component, which is a second heap record per
 call, and it is why the two walks are SEPARATE rather than one walk
 wrapped by the other: wrapping put that record on every variable
 reference in the program and blew the CHECK deck (a #GP with no
 diagnostic, at ~228 MB -- the 2.16 signature). instantiate-collect is
 called once per definition and can afford it; instantiate-type cannot.

 The duplication is deliberate and must stay in step: the two walks
 differ only in the report. Change one, change the other.

  instantiate-type : UnificationState, CodexType -> (CodexType, UnificationState)
  instantiate-type (st) (ty) =
   when ty
    is ForAllTy (var-id) (body) ->
     let (fr-ty, fr-st) = fresh-and-advance st
     in let substituted = subst-type-var body var-id fr-ty
     in instantiate-type fr-st substituted
    is ForAllEff (var-id) (body) ->
     let (new-id, fr-st) = fresh-row-id st
     in let substituted = subst-row-var body var-id new-id
     in instantiate-type fr-st substituted
    is otherwise -> (ty, st)

 Row ids are not collected: a row variable is an effect-axis binder,
 checked by row-le at stage 3b, not by the rigidity check.

  instantiate-collect : UnificationState, CodexType, List Integer -> (CodexType, UnificationState, List Integer)
  instantiate-collect (st) (ty) (acc) =
   when ty
    is ForAllTy (var-id) (body) ->
     let (fr-ty, fr-st) = fresh-and-advance st
     in let acc2 = when fr-ty
          is TypeVar (new-id) -> list-push acc new-id
          is otherwise -> acc
     in instantiate-collect fr-st (subst-type-var body var-id fr-ty) acc2
    is ForAllEff (var-id) (body) ->
     let (new-id, fr-st) = fresh-row-id st
     in instantiate-collect fr-st (subst-row-var body var-id new-id) acc
    is otherwise -> (ty, st, acc)

  subst-type-var : CodexType, Integer, CodexType -> CodexType
  subst-type-var (ty) (var-id) (replacement) =
   if ty-has-typevars ty == False then ty
   else when ty
    is TypeVar (id) -> if id == var-id then replacement else ty
    is ForAllTy (inner-id) (body) ->
     if inner-id == var-id then ty
     else deck-record (ForAllTy inner-id (subst-type-var body var-id replacement))
    is otherwise -> codex-type-map-children (\c -> subst-type-var c var-id replacement) ty

 subst-row-var freshens one row-variable id through a type: every
 arrow row whose tail carries the old id is rebuilt with the new id.
 Row ids live only on FunTy rows and ForAllEff binders, never inside
 any other constructor's payload, so everything else recurses through
 the shared children walker. A ForAllEff binding the same id shadows
 it -- stop there. No ty-has-typevars short-circuit applies: that
 guard sees type variables, not row tails.

  subst-row-var : CodexType, Integer, Integer -> CodexType
  subst-row-var (ty) (old-id) (new-id) =
   when ty
    is FunTy (p) (row) (r) ->
     let row2 = if row.tail-id == old-id then deck-record (row-with-tail-id row new-id) else row
     in deck-record (FunTy (subst-row-var p old-id new-id) row2 (subst-row-var r old-id new-id))
    is ForAllEff (inner-id) (body) ->
     if inner-id == old-id then ty
     else deck-record (ForAllEff inner-id (subst-row-var body old-id new-id))
    is otherwise -> codex-type-map-children (\c -> subst-row-var c old-id new-id) ty

Section: Infer Binary
 The operand-shape helpers below construct their results with the
 empty ambient; infer-binary is the one entry point and stamps the
 union of the operands' ambients onto whatever they return.

  infer-binary : UnificationState, TypeEnv, AExpr, BinaryOp, AExpr, SourceSpan, Integer -> CheckResult
  infer-binary (st) (env) (left) (op) (right) (span) (depth) =
   let lr = infer-expr-at st env left (depth + 1)
   in let rr = infer-expr-at (lr.state) env right (depth + 1)
   in let base = infer-binary-op (rr.state) (lr.inferred-type) (rr.inferred-type) op span
   in let (amb, amb-st) = row-union (base.state) (lr.effect-row) (rr.effect-row)
   in CheckResult {
    inferred-type = base.inferred-type,
    effect-row = amb,
    state = amb-st
   }

 Ordering is refused on both of these and for one reason stated two ways.
 On Text the operands reach a machine cmp as ADDRESSES, so the answer
 followed allocation order: two separately built copies of "a" compared
 unequal, one of them less than the other. On a character the comparison is
 well defined and misleads instead, because CCE numbers characters by
 English letter frequency -- 'd' is 22 and 'b' is 32, so `'d' < 'b'` is
 True. Neither has a single meaning to lower to, which is the same argument
 that made `==` on Real a refusal rather than a silent choice.

 The unit wrapper is stripped first. A predicate that dispatches on the
 wrapper is how `unit Real` reached the integer adder, and the lesson from
 that is written at `strip-unit-ty`: derive the question once and let every
 caller read it.

  is-text-or-char-type : CodexType -> Boolean
  is-text-or-char-type (ty) =
   when strip-unit-ty ty
    is TextTy | CharTy -> True
    is otherwise -> False

 A type the checker has not decided yet: an application's result is a fresh
 variable until unification binds it. Unary minus must not force such a type
 to Integer -- `-(f x)` where f returns a Real would be typed Integer and then
 collide with the declared Real. It stays undecided and the surrounding
 context binds it, exactly as `-x` on a Real parameter already does.

  is-undecided-type : CodexType -> Boolean
  is-undecided-type (ty) =
   when ty
    is TypeVar (i) -> True
    is otherwise -> False

  infer-binary-op : UnificationState, CodexType, CodexType, BinaryOp, SourceSpan -> CheckResult
  infer-binary-op (st) (lt) (rt) (op) (span) =
   when op
    is OpAdd | OpSub | OpMul | OpDiv | OpPow -> infer-arithmetic st lt rt span
    is OpEq | OpNotEq ->
     let result = infer-comparison st lt rt span
     in if is-real-type lt | is-real-type rt
      then CheckResult {
       inferred-type = BooleanTy,
       effect-row = empty-row,
       state = add-unify-error (result.state) cdx-real-equality-banned "Floating-point equality is not safe. Use the ~ operator: x ~ y (approximately equal, 4 ULP tolerance), x ~0 y (bitwise exact, if you are certain)" span
      }
      else result
    is OpLt | OpGt | OpLtEq | OpGtEq ->
     let result = infer-comparison st lt rt span
     in if is-text-or-char-type lt | is-text-or-char-type rt
      then CheckResult {
       inferred-type = BooleanTy,
       effect-row = empty-row,
       state = add-unify-error (result.state) cdx-text-ordering-banned "Ordering on Text or a character has no single meaning. On Text this compared the operands as POINTERS, so the answer followed allocation order and not content. CCE numbers characters by frequency rather than alphabetically, so even a code-point order is not the alphabet. Use text-collate (Foreword chapter Collate) for alphabetical order, or text-compare for code-point order; for a character, compare char-code c as an Integer, which says what it is doing" span
      }
      else result
    is OpApproxEq | OpApproxEqExact -> infer-comparison st lt rt span
    is OpAnd -> infer-and st lt rt span
    is OpOr -> infer-logical st lt rt span
    is OpAppend -> infer-append st lt rt span
    is OpCons -> infer-cons st lt rt span
    is OpDefEq -> infer-comparison st lt rt span

 An arithmetic result used to be the LEFT operand's type verbatim, which
 made the judgment depend on the order the author wrote the operands in.
 `b.val + 1` over a 0..255 byte kept 0..255 and compiled; `1 + b.val` --
 the same sum -- took the literal's type and was rejected, because an
 integer literal is typed int-ty-default, the FULL i64 range. A literal
 is not "some integer" to the reader, and reporting that a byte plus one
 might be nine quintillion is not a judgment anyone can act on.

 Keeping the bound is the right answer and always was. It is not a claim
 that the sum cannot exceed it: it is the CONTRACT. The emit prover keeps
 a bounds check at the store precisely because it cannot prove the sum
 fits, and that check traps -- Eiffel-style, as the guide describes. So
 the type carries the author's declared intent and the runtime enforces
 it. What was broken is only that the intent survived on one side and not
 the other.

 So take the narrower operand rather than the left one. When one side is
 an unbounded literal it is the bounded side that wins, whichever way it
 was written, and the two spellings agree. Where both are plain Integer
 nothing changes -- the result is plain, and a store into a bounded field
 is still rejected (codex/test/errors/narrowing-unproven), because there
 the author declared no intent to carry.

  arith-result-ty : CodexType, CodexType -> CodexType
  arith-result-ty (lt) (rt) =
   when lt
    is IntegerTy (l-lo) (l-hi) (l-mode) ->
     when rt
      is IntegerTy (r-lo) (r-hi) (r-mode) ->
       if r-lo >= l-lo & r-hi <= l-hi then rt else lt
      is otherwise -> lt
    is otherwise -> lt

  infer-arithmetic : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
  infer-arithmetic (st) (lt) (rt) (span) =
   when lt
    is UnitTy (ln) (li) ->
     when rt
      is UnitTy (rn) (ri) ->
       let (_, u-st) = unify st lt rt span
       in let st2 = if is-arithmetic-type lt & is-arithmetic-type rt then u-st
                    else add-unify-error u-st cdx-arithmetic-requires-numeric "Arithmetic operator requires Integer or Real" span
       in CheckResult { inferred-type = lt, effect-row = empty-row, state = st2 }
      is otherwise ->
       let (_, u-st) = unify st li rt span
       in CheckResult { inferred-type = lt, effect-row = empty-row, state = u-st }
    is otherwise ->
     when rt
      is UnitTy (rn) (ri) ->
       let (_, u-st) = unify st lt ri span
       in CheckResult { inferred-type = rt, effect-row = empty-row, state = u-st }
      is otherwise ->
       let (_, u-st) = unify st lt rt span
       in let st2 = if is-arithmetic-type lt & is-arithmetic-type rt then u-st
                    else add-unify-error u-st cdx-arithmetic-requires-numeric "Arithmetic operator requires Integer or Real" span
       in CheckResult { inferred-type = arith-result-ty lt rt, effect-row = empty-row, state = st2 }

  is-arithmetic-type : CodexType -> Boolean
  is-arithmetic-type (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) | RealTy (rw) (rm) | VectorTy (vn) (vt) | TypeVar (id) | ErrorTy -> True
    is UnitTy (n) (inner) -> is-arithmetic-type inner
    is otherwise -> False

  infer-comparison : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
  infer-comparison (st) (lt) (rt) (span) =
   let (_, u-st) = unify st lt rt span
   in when lt
    is VectorTy (n) (et) -> CheckResult {
     inferred-type = VectorMaskTy n,
     effect-row = empty-row,
     state = u-st
    }
    is otherwise -> CheckResult {
     inferred-type = BooleanTy,
     effect-row = empty-row,
     state = u-st
    }

  infer-logical : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
  infer-logical (st) (lt) (rt) (span) =
   let (_, u-st1) = unify st lt BooleanTy span
   in let (_, u-st2) = unify u-st1 rt BooleanTy span
   in CheckResult {
    inferred-type = BooleanTy,
    effect-row = empty-row,
    state = u-st2
   }

  infer-and : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
  infer-and (st) (lt) (rt) (span) =
   let resolved = resolve-silent st lt
   in when resolved
    is BooleanTy -> infer-logical st lt rt span
    is TextTy | otherwise -> infer-append st lt rt span

  infer-append : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
  infer-append (st) (lt) (rt) (span) =
   let resolved = resolve-silent st lt
   in when resolved
    is TextTy ->
     let (_, u-st) = unify st rt TextTy span
   in CheckResult {
      inferred-type = TextTy,
      effect-row = empty-row,
      state = u-st
     }
    is otherwise ->
     let (_, u-st) = unify st lt rt span
   in CheckResult {
      inferred-type = lt,
      effect-row = empty-row,
      state = u-st
     }

  infer-cons : UnificationState, CodexType, CodexType, SourceSpan -> CheckResult
  infer-cons (st) (lt) (rt) (span) =
   let list-ty = deck-record (ListTy lt)
   in let (_, u-st) = unify st rt list-ty span
   in CheckResult {
    inferred-type = list-ty,
    effect-row = empty-row,
    state = u-st
   }

Section: Infer If

 Each arm is inferred under the branch-refined environment
 (cond-refine, Lint value-expression range analysis): a comparison
 between a bare local and an expression with a provable range narrows
 the local's recorded range inside the arm the comparison guards, and
 only there -- the refined entry rides the env copy handed to that
 arm's walk and never escapes it. Only the narrowing lint reads the
 refined table, so this shapes diagnostics, never types or codegen.
 Both arms are always inferred: static feasibility only shapes the
 prover's union (if-proven-range), never type checking.

  infer-if : UnificationState, TypeEnv, AExpr, AExpr, AExpr, SourceSpan, Integer -> CheckResult
  infer-if (st) (env) (cond) (then-e) (else-e) (span) (depth) =
   let cr = infer-expr-at st env cond (depth + 1)
   in let (_, u-st1) = unify (cr.state) (cr.inferred-type) BooleanTy (aexpr-span cond)
   in let rf = cond-refine env cond
   in let tr = infer-expr-at u-st1 (arm-refined-env env rf (rf.then-iv) then-e) then-e (depth + 1)
   in let er = infer-expr-at (tr.state) (arm-refined-env env rf (rf.else-iv) else-e) else-e (depth + 1)
   in let (_, u-st2) = unify (er.state) (tr.inferred-type) (er.inferred-type) span
   in let (amb1, amb1-st) = row-union u-st2 (cr.effect-row) (tr.effect-row)
   in let (amb, amb-st) = row-union amb1-st amb1 (er.effect-row)
   in CheckResult {
    inferred-type = tr.inferred-type,
    effect-row = amb,
    state = amb-st
   }

Section: Infer Let

 A let's ambient is the union of every binding value's ambient with
 the body's -- a binding value is evaluated even if the body never
 reads the name. The binding loop accumulates the union as it walks.

  infer-let : UnificationState, TypeEnv, List ALetBind, AExpr, Integer -> CheckResult
  infer-let (st) (env) (bindings) (body) (depth) =
   let env2 = infer-let-bindings st env bindings 0 (list-length bindings) empty-row depth
   in let br = infer-expr-at (env2.state) (env2.env) body (depth + 1)
   in let (amb, amb-st) = row-union (br.state) (env2.binds-row) (br.effect-row)
   in CheckResult {
    inferred-type = br.inferred-type,
    effect-row = amb,
    state = amb-st
   }

 LetBindResult is the plain (state, env) pair the def/effect/class
 registration walkers share; let-body inference carries the bindings'
 accumulated ambient row alongside, so it gets its own shape.

  LetBindResult = record {
   state : UnificationState,
   env : TypeEnv
  }

  LetInferResult = record {
   state : UnificationState,
   env : TypeEnv,
   binds-row : EffectRow
  }

  infer-let-bindings : UnificationState, TypeEnv, List ALetBind, Integer, Integer, EffectRow, Integer -> LetInferResult
  infer-let-bindings (st) (env) (bindings) (i) (len) (acc-row) (depth) =
   if i == len then LetInferResult {
    state = st,
    env = env,
    binds-row = acc-row
   }
   else let b = list-at bindings i
   in let vr = infer-expr-at st env (b.value) (depth + 1)
   in let (acc2, acc-st) = row-union (vr.state) acc-row (vr.effect-row)
   in let checked-st = check-let-bind-row acc-st (vr.effect-row) (b.name.value) (aexpr-span (b.value))
   in let resolved-ty = deep-resolve checked-st (vr.inferred-type)
   in let env2 = env-bind-local env (b.name.value) resolved-ty
   in let env3 = record-local-range env2 (b.name.value) (b.value) resolved-ty
   in infer-let-bindings checked-st env3 bindings (i + 1) len acc2 depth

 A let-local whose value proves narrower than the full i64 range
 carries that range forward for the narrowing lint. The value is
 analyzed in the pre-binding env (a let has no recursion), and only a
 genuinely-narrower proof is recorded, so unknown-range locals cost
 nothing. When the expression analysis cannot prove but the value's
 RESOLVED TYPE is a bounded IntegerTy, the type's range is recorded
 instead: a direct store of that value would type-fit silently, so a
 local carrying the same range makes local-mediated flows exactly as
 permissive as direct ones - no more - and lets the local
 participate in the arithmetic arms (255 - v proves when v carries a
 field's 0..255).

  record-local-range : TypeEnv, Text, AExpr, CodexType -> TypeEnv
  record-local-range (env) (name) (value) (resolved-ty) =
   let (lo, hi) = aexpr-proven-range env value
   in if lo > i64-min | hi < i64-max then env-add-local-range env name lo hi
   else when resolved-ty
    is IntegerTy (t-lo) (t-hi) (mode) ->
     if t-lo <= i64-min & t-hi >= i64-max then env
     else env-add-local-range env name t-lo t-hi
    is otherwise -> env

 The let boundary reads the binding VALUE's ambient row: concrete
 labels mean an effectful call is being let-bound outside an
 act-bind, which silently corrupts on bare metal (CDX2033). A row
 whose only content is an unsolved tail is allowed -- it is the HOF
 body pattern, where the effects are the caller's and the def
 boundary answers for them.

  check-let-bind-row : UnificationState, EffectRow, Text, SourceSpan -> UnificationState
  check-let-bind-row (st) (row) (name) (span) =
   if st.effect-exempt then st
   else let r = resolve-row st row
   in if list-length (r.labels) == 0 then st
   else add-unify-error st cdx-let-binds-effectful-value ("let-binding '" & name & "' to an effectful value is not allowed outside an act-bind. Use '" & name & " <- ...' inside an act block.") span

Section: Infer Lambda

 A lambda VALUE performs nothing -- its ambient is empty. What the
 body performs becomes the row on the innermost synthesized arrow,
 the arrow whose application will perform it (§4 curried placement).
 The row is opened with a fresh tail when the body's ambient is
 closed (§6a: inferred literals are born open), so a pure lambda
 flows into an effectful-arrow context through plain unification.

  open-row-if-closed : UnificationState, EffectRow -> (EffectRow, UnificationState)
  open-row-if-closed (st) (row) =
   let r = resolve-row st row
   in if r.tail-id >= 0 then (r, st)
   else let (t, st2) = fresh-row-id st
   in (make-row (r.labels) "" t, st2)

  infer-lambda : UnificationState, TypeEnv, List Name, AExpr, Integer -> CheckResult
  infer-lambda (st) (env) (params) (body) (depth) =
   let pr = bind-lambda-params st env params 0 (list-length params) []
   in let br = infer-expr-at (pr.state) (pr.env) body (depth + 1)
   in let (lam-row, lam-st) = open-row-if-closed (br.state) (br.effect-row)
   in let fun-ty = wrap-fun-type (pr.param-types) lam-row (br.inferred-type)
   in CheckResult {
    inferred-type = fun-ty,
    effect-row = empty-row,
    state = lam-st
   }

  LambdaBindResult = record {
   state : UnificationState,
   env : TypeEnv,
   param-types : List CodexType
  }

  bind-lambda-params : UnificationState, TypeEnv, List Name, Integer, Integer, List CodexType -> LambdaBindResult
  bind-lambda-params (st) (env) (params) (i) (len) (acc) =
   if i == len then LambdaBindResult {
    state = st,
    env = env,
    param-types = acc
   }
   else let p = list-at params i
   in let (fr-ty, fr-st) = fresh-and-advance st
   in let env2 = env-bind-local env (p.value) fr-ty
   in bind-lambda-params fr-st env2 params (i + 1) len (list-push acc fr-ty)

  wrap-fun-type : List CodexType, EffectRow, CodexType -> CodexType
  wrap-fun-type (param-types) (body-row) (result) =
   let n = list-length param-types
   in if n == 0 then result
   else wrap-fun-type-loop param-types (deck-record (FunTy (list-at param-types (n - 1)) body-row result)) (n - 2)

  wrap-fun-type-loop : List CodexType, CodexType, Integer -> CodexType
  wrap-fun-type-loop (param-types) (result) (i) =
   if i < 0 then result
   else wrap-fun-type-loop param-types (deck-record (FunTy (list-at param-types i) empty-row result)) (i - 1)

Section: Class Instance Check

 `show` and `compare` require an instance for their operand type. A
 primitive (Integer, Number, Text, Boolean, Char) has a built-in one; a
 user type must derive the class, which leaves a `__show_T`/`__compare_T`
 definition in scope (mirrors the dispatch probe in Lowering, so the
 checker rejects exactly when codegen would otherwise fall back to a
 meaningless number or a pointer compare). Primitives, type variables,
 lists, and other non-nominal types are never rejected here; type
 variables are deferred to the constraint pass.

 `==` / `/=` are intentionally not checked: the emitter already compares
 sums and text structurally (`emit-sum-structural-eq`, `__str_eq`), so
 equality is sound there without deriving. Record equality is a separate
 concern handled in codegen, not here.

  class-prefix-for : Text -> Text
  class-prefix-for (cls) =
   if cls == "Show" then "__show_"
   else "__compare_"

  class-derives : TypeEnv, Text, Text -> Boolean
  class-derives (env) (prefix) (tn) =
   if text-length tn == 0 then False
   else env-has env (rename-lookup (env.chapter-renames) (prefix & tn))

  nominal-type-name : CodexType -> Text
  nominal-type-name (ty) =
   when ty
    is SumTy (n) (a) (cs) | RecordTy (n) (ra) (rf) | ConstructedTy (n) (ca) -> n.value
    is otherwise -> ""

  class-op-ok : TypeEnv, Text, CodexType -> Boolean
  class-op-ok (env) (cls) (ty) =
   let tn = nominal-type-name ty
   in if text-length tn == 0 then True
   else class-derives env (class-prefix-for cls) tn

  check-class-op : UnificationState, TypeEnv, Text, CodexType, SourceSpan -> UnificationState
  check-class-op (st) (env) (cls) (ty) (span) =
   let rty = deep-resolve st ty
   in if class-op-ok env cls rty then st
   else add-unify-error st cdx-no-class-instance ("No " & cls & " instance for type '" & nominal-type-name rty & "'; derive " & cls & " on the type or convert manually") span

  check-class-op-app : UnificationState, TypeEnv, AExpr, CodexType, SourceSpan -> UnificationState
  check-class-op-app (st) (env) (func) (arg-ty) (span) =
   when func
    is ANameExpr (n) (ns) ->
     if (n.value) == "show" then check-class-op st env "Show" arg-ty span
     else if (n.value) == "compare" then check-class-op st env "Ord" arg-ty span
     else st
    is otherwise -> st

Section: Infer Application
 The synthesized expected arrow carries a FRESH row variable, not the
 empty row: unification binds it to the callee arrow's row, and that
 captured row joins the ambient -- evaluating an application performs
 the function expression's effects, the argument expression's
 effects, and whatever the consumed arrow declares. An empty row
 here would instead FORCE every callee arrow closed-pure, which is
 wrong the moment stage 3b puts concrete effects on arrows.

  infer-application : UnificationState, TypeEnv, AExpr, AExpr, SourceSpan, Integer -> CheckResult
  infer-application (st) (env) (func) (arg) (span) (depth) =
   let fr = infer-expr-at st env func (depth + 1)
   in let ar = when arg
       is ALitExpr (val) (kind) (s) -> infer-int-lit-arg (check-int-lit-range (fr.state) val kind s) (fr.inferred-type) val kind
       is otherwise -> infer-expr-at (fr.state) env arg (depth + 1)
   in let (ret-ty, ret-st) = fresh-and-advance (ar.state)
   in let (call-row-id, row-st) = fresh-row-id ret-st
   in let passed-ty = widen-arg-to-param row-st (fr.inferred-type) (ar.inferred-type)
   in let (ok, r-st) = unify row-st (fr.inferred-type) (deck-record (FunTy passed-ty (deck-record (row-var call-row-id)) ret-ty)) span
   in let st-cls = check-class-op-app r-st env func (ar.inferred-type) span
   in let st-arg = lint-arg-narrowing st-cls env func (fr.inferred-type) arg (ar.inferred-type) span
   in let st-rs = lint-record-set st-arg env func arg (ar.inferred-type) ret-ty span
   in let st-lint = lint-effect-scope st-rs env func arg span
   in let st-final = lint-vec-lane st-lint func arg span
   in let refined-ty = refine-vec-result st-final func (ar.inferred-type) ret-ty
   in let (amb1, amb1-st) = row-union st-final (fr.effect-row) (ar.effect-row)
   in let (amb, amb-st) = row-union amb1-st amb1 (deck-record (row-var call-row-id))
   in CheckResult {
    inferred-type = refined-ty,
    effect-row = amb,
    state = amb-st
   }

 A function that performs less than it was asked for is safe to hand
 over. print-line-uni performs Console.Write; a parameter declared
 Text -> [Console] Nothing promises its caller only that it may do
 something Console-ish, and Console.Write is something Console-ish. The
 def boundary has always understood this -- a [Console] def may perform
 Console.Write -- but the argument boundary compared rows for EQUALITY
 and turned the same program away (CDX2090).

 The lattice does NOT move into unify-row, and this is the point:
 unification is symmetric, and a symmetric relation that accepted
 Console.Write against Console would accept it in both directions --
 which is laundering -- and would stop being most general. So the
 directed reasoning stays outside, here, where the direction is known:
 the argument is being handed TO the parameter. Each of the argument
 row's labels is rewritten to the parameter's label that covers it,
 and then the rows are equal and ordinary unification finishes the
 job, principality intact.

 Two relations are applied, and both only ever widen TOWARD a label the
 parameter actually names. An argument label the parameter does not cover
 at all is left alone, so unify still refuses it -- this only ever accepts
 more, never less, and never in the unsound direction (a Console argument
 into a Console.Write parameter still fails: Console has no dot, so
 nothing covers it; and an UNSCOPED Console argument into a
 Console "stdout" parameter fails because an argument that states no
 restriction is wider than the parameter, not narrower).

 The first relation is parent-of, over the dot: Console.Write widens to
 Console.

 The second contains a scope. Console "stdout" widens to Console, because
 a label with no scope states no restriction and everything falls under no
 restriction -- that case needs to know nothing about what a scope MEANS.
 FileSystem.Read "/config/app/" widens to FileSystem.Read "/config/", and
 that case does: a filesystem scope is a path prefix where a network scope
 is an authority and a console scope a channel. `scope-subsumes`
 (TypeChecker) chooses per family off the effect's own name, which is
 where `scope-admits` has always got it from -- the family was never
 missing, it was only ever read off the name.

 Dropping the scope is the SAFE direction for the same reason parent-of
 is: the argument does LESS than the parameter promises. A
 Text -> [Console "stdout"] Nothing writes only to stdout; a parameter
 declared Text -> [Console] Nothing promises its caller only that it may
 do something Console-ish. Nothing is laundered, because the callee's own
 declared row is what its caller pays for, and that row is unchanged by
 what is handed to it. The scope the argument really honours has already
 been enforced against the argument's own signature at its def boundary
 (CDX4002); this widening is used to unify with the parameter and nowhere
 else.

 Cost: this runs on EVERY application, so it allocates nothing unless a
 widening actually applies. The guards are length checks and two label
 walks over rows that carry at most a couple of labels; the row is
 rebuilt only when some label really is a proper child of one the
 parameter names, which is rare.

  widen-arg-to-param : UnificationState, CodexType, CodexType -> CodexType
  widen-arg-to-param (st) (func-ty) (arg-ty) =
   when arg-ty
    is FunTy (ap) (arow) (aret) ->
     when strip-forall-ty (resolve-silent st func-ty)
      is FunTy (p) (frow) (fret) -> widen-arg-row st (resolve-silent st p) arg-ty ap arow aret
      is otherwise -> arg-ty
    is otherwise -> arg-ty

  widen-arg-row : UnificationState, CodexType, CodexType, CodexType, EffectRow, CodexType -> CodexType
  widen-arg-row (st) (param-ty) (arg-ty) (ap) (arow) (aret) =
   when param-ty
    is FunTy (pp) (prow) (pret) ->
     let pr = resolve-row st prow
     in let arr = resolve-row st arow
     in if list-length (pr.labels) == 0 then arg-ty
        else if list-length (arr.labels) == 0 then arg-ty
        else if labels-need-widening (pr.labels) (arr.labels) 0 (list-length (arr.labels)) == False then arg-ty
        else deck-record (FunTy ap (make-row (widen-labels (pr.labels) (arr.labels) 0 (list-length (arr.labels)) []) (arr.tail-name) (arr.tail-id)) aret)
    is otherwise -> arg-ty

 True when at least one argument label is a proper child of a label the
 parameter names. A label the parameter already carries needs nothing;
 one it cannot cover is unify's business, not ours.

  labels-need-widening : List EffectLabel, List EffectLabel, Integer, Integer -> Boolean
  labels-need-widening (plabels) (alabels) (i) (len) =
   if i == len then False
   else if label-parent-index plabels (list-at alabels i) >= 0 then True
   else labels-need-widening plabels alabels (i + 1) len

  widen-labels : List EffectLabel, List EffectLabel, Integer, Integer, List EffectLabel -> List EffectLabel
  widen-labels (plabels) (alabels) (i) (len) (acc) =
   if i == len then acc
   else let al = list-at alabels i
   in let pi = label-parent-index plabels al
   in widen-labels plabels alabels (i + 1) len (list-push acc (if pi >= 0 then list-at plabels pi else al))

 The index of the parameter label that covers this argument label, or -1.
 A strict widening only: an exact match is not a widening and must not
 report one, or widen-labels would rebuild a row that was already equal
 and labels-need-widening would never settle on a fixed point.

 Scope-drop is tried before parent-of because it is the more specific
 answer. Console.Write "stdout" handed to a parameter naming both
 Console.Write and Console widens to Console.Write, keeping the dot the
 argument earned rather than spending it.

  label-parent-index : List EffectLabel, EffectLabel -> Integer
  label-parent-index (plabels) (al) =
   let same = label-scope-drop-index plabels al
   in if same >= 0 then same else label-dot-parent-index plabels al

 The parameter label with this argument's exact name whose scope contains
 the argument's. Only a SCOPED argument can be widened this way:
 unscoped-to-unscoped with the same name is an exact match, not a
 widening, and reporting it would spin labels-need-widening forever.

 An unscoped parameter label contains everything, which is why the
 unscoped case needs no family knowledge and shipped first. A scoped one
 has to be asked, and scope-subsumes asks the right question per family:
 a path contains what extends it, an authority contains the same host at
 the port it named (or every port, if it named none), a channel contains
 only itself. Note which direction is being asked: the PARAMETER's scope
 is the outer, the ARGUMENT's the inner, because the safe direction is the
 argument doing less than the parameter promised.

 An exact match anywhere in the row means no widening is wanted at all --
 the label the argument already carries is one the parameter names, so the
 rows can meet without help. Checking that first also keeps a row holding
 both FileSystem.Read "/a/" and FileSystem.Read "/a/b/" from rewriting an
 argument's "/a/b/" to the wider "/a/", which would be sound and would
 still be a loss.

  label-scope-drop-index : List EffectLabel, EffectLabel -> Integer
  label-scope-drop-index (plabels) (al) =
   if text-length (al.scope) == 0 then 0 - 1
   else if label-has-exact plabels al 0 (list-length plabels) then 0 - 1
   else label-index-covering plabels al 0 (list-length plabels)

  label-has-exact : List EffectLabel, EffectLabel, Integer, Integer -> Boolean
  label-has-exact (plabels) (al) (i) (len) =
   if i == len then False
   else let pl = list-at plabels i
   in if (pl.name.value) == (al.name.value) & (pl.scope) == (al.scope) then True
      else label-has-exact plabels al (i + 1) len

  label-index-covering : List EffectLabel, EffectLabel, Integer, Integer -> Integer
  label-index-covering (plabels) (al) (i) (len) =
   if i == len then 0 - 1
   else let pl = list-at plabels i
   in if (pl.name.value) /= (al.name.value) then label-index-covering plabels al (i + 1) len
      else if text-length (pl.scope) == 0 then i
      else if scope-subsumes (al.name.value) (pl.scope) (al.scope) then i
      else label-index-covering plabels al (i + 1) len

  label-dot-parent-index : List EffectLabel, EffectLabel -> Integer
  label-dot-parent-index (plabels) (al) =
   let dot = find-dot (al.name.value) 0 (text-length (al.name.value))
   in if dot < 0 then 0 - 1
      else label-index-named plabels (substring (al.name.value) 0 dot) 0 (list-length plabels)

  label-index-named : List EffectLabel, Text, Integer, Integer -> Integer
  label-index-named (plabels) (nm) (i) (len) =
   if i == len then 0 - 1
   else let pl = list-at plabels i
   in if text-length (pl.scope) == 0 & (pl.name.value) == nm then i
      else label-index-named plabels nm (i + 1) len

 The CL 6494-era effect-le argument check is retired (stage 3b): its
 job -- an effectful function may not flow into a pure parameter -- is
 now done by row unification itself. A concrete pure parameter's
 arrow row is the closed empty row; an effectful argument's opened
 row cannot reconcile with it (CDX2090), and a row-polymorphic
 parameter constrains through its row variable instead of being
 waved through, which was the leniency this check had to carry.

 An argument flowing into a bounded parameter draws the same hybrid
 check as a bounded field store -- and a constructor is a function
 whose payload is a parameter, so one check serves both. The declared
 parameter is read from the callee arrow BEFORE the application unify
 (overlap-permissive on IntegerTy, so the concrete bound survives).
 Literal out of range is the CDX2050 error, a wider static type the
 CDX2051 warning, an explicit __narrow suppresses -- exactly as at
 record fields. The descriptor names a constructor field when the head
 is one of its sum type's own constructors (FabledTreasureMap entry
 11), a bounded parameter otherwise. Range PROPAGATION from the bound
 into the body is done at bind-def-params, not here, and only behind
 the stage-B runtime guard on bounded signatures.

  lint-arg-narrowing : UnificationState, TypeEnv, AExpr, CodexType, AExpr, CodexType, SourceSpan -> UnificationState
  lint-arg-narrowing (st) (env) (func) (func-ty) (arg) (arg-ty) (span) =
   let declared-param = when strip-forall-ty (deep-resolve st func-ty)
    is FunTy (p) (row) (r) -> deep-resolve st p
    is otherwise -> ErrorTy
   in when declared-param
    is IntegerTy (lo) (hi) (mode) ->
     if lo <= i64-min & hi >= i64-max then st
     else let head = apply-head-name func
          in let desc = if is-ctor-of-own-sum env head then "field of constructor '" & head & "'" else "bounded parameter"
          in lint-narrowing-check st env arg arg-ty declared-param span desc
    is otherwise -> st
    is otherwise -> st

  is-ctor-of-own-sum : TypeEnv, Text -> Boolean
  is-ctor-of-own-sum (env) (name) =
   let resolved = rename-lookup (env.chapter-renames) name
   in if env-has env resolved == False then False
   else when strip-fun-args (strip-forall-ty (env-lookup env resolved))
    is SumTy (sn) (sa) (sctors) -> sum-ctors-have sctors resolved 0 (list-length sctors)
    is otherwise -> False

  sum-ctors-have : List SumCtor, Text, Integer, Integer -> Boolean
  sum-ctors-have (cs) (name) (i) (len) =
   if i == len then False
   else if ((list-at cs i).name.value) == name then True
   else sum-ctors-have cs name (i + 1) len

 A lane index is checked against a lane count the compiler already knows.
 `vec-extract`'s own type takes a `Vector 2` and `vec4-extract`'s a
 `Vector 4`, so the count is fixed by the builtin rather than inferred, and
 a literal lane outside it is decidable HERE. Damian's ruling, 2026-07-28:
 a compile error, not a runtime trap. It is the stronger answer for the
 same reason CDX2089 is -- the program never ships, where a trap only fires
 on the run that reaches the line.

 This is the opposite decision to the one the list builtins got, and the
 difference is where the length lives. A list's length is discovered while
 the program runs, so `list-at` can only be guarded at runtime; a vector's
 lane count is on its type, so this can be refused before the binary exists.

 **A computed lane is NOT covered and cannot be.** `vec-extract v i` with
 `i` a parameter reads out of bounds exactly as it did before, because the
 compiler does not know `i`. Four such sites exist in the tree today
 (`vec-lanes-smoke`, `vec-arith-hazards`, `vec-extract-hazards`). That is
 the honest limit of a static check, not an oversight, and it is written
 down here so nobody reads this refusal as full coverage.

 The check is keyed on the builtin's NAME. A chapter that shadows
 `vec-extract` with its own differently-shaped definition would be judged
 against the builtin's lane count, which is wrong; nothing in the tree does,
 and CDX3005 already warns when a builtin is shadowed.

  vec-lane-count : Text -> Integer
  vec-lane-count (name) =
   if name == "vec-extract" then 2
   else if name == "vec4-extract" then 4
   else 0 - 1

 Whether the lane is a literal and what it is are two questions and they
 get two functions, because every way of folding them into one number
 needs a sentinel and every sentinel is a lane somebody can write. The
 first draft answered -2 for "not a literal", which silently waved through
 `vec-extract v -2`; -1 has the same problem one lane over. There is no
 safe out-of-band Integer here, so the flag is a Boolean.

 A negative lane arrives as `AUnaryExpr` wrapping the literal, not as a
 literal with a minus in its text -- the desugarer discards the operator
 token and keeps the operand. Negation is the only unary operator in the
 language, so an `AUnaryExpr` around an IntLit is a negative literal and
 nothing else. Measured rather than assumed: before this arm existed,
 `vec-extract (vec-splat 1.5) -1` compiled clean and emitted a binary,
 which made the zero-comparison arm a guard no input could reach.

  vec-lane-is-literal : AExpr -> Boolean
  vec-lane-is-literal (arg) =
   when arg
    is ALitExpr (val) (kind) (s) ->
     when kind
      is IntLit -> True
      is otherwise -> False
    is AUnaryExpr (inner) (s) ->
     when inner
      is ALitExpr (v2) (k2) (s2) ->
       when k2
        is IntLit -> True
        is otherwise -> False
      is otherwise -> False
    is otherwise -> False

  vec-lane-literal : AExpr -> Integer
  vec-lane-literal (arg) =
   when arg
    is ALitExpr (val) (kind) (s) -> lit-text-to-integer val
    is AUnaryExpr (inner) (s) ->
     when inner
      is ALitExpr (v2) (k2) (s2) -> 0 - (lit-text-to-integer v2)
      is otherwise -> 0
    is otherwise -> 0

  lint-vec-lane : UnificationState, AExpr, AExpr, SourceSpan -> UnificationState
  lint-vec-lane (st) (func) (arg) (span) =
   let lanes = if is-two-arg-call func "vec-extract" then 2
    else if is-two-arg-call func "vec4-extract" then 4
    else 0 - 1
   in if lanes < 0 then st
   else if vec-lane-is-literal arg == False then st
   else let idx = vec-lane-literal arg
   in if idx >= 0 & idx < lanes then st
   else add-unify-error st cdx-vec-lane-out-of-range ("Lane " & integer-to-text idx & " is outside this vector: it has " & integer-to-text lanes & " lanes, numbered 0 to " & integer-to-text (lanes - 1) & ". The lane count comes from the builtin's own type, so this is decided here rather than read out of bounds at runtime. Use a lane in range, or vec-reduce-add if you meant to combine every lane.") span

  refine-vec-result : UnificationState, AExpr, CodexType, CodexType -> CodexType
  refine-vec-result (st) (func) (arg-ty) (ret-ty) =
   let rr = deep-resolve st ret-ty
   in when rr
    is VectorTy (rn) (rt) -> if rn >= 0 then ret-ty else refine-vec-op st func arg-ty rt ret-ty
    is otherwise -> ret-ty

  refine-vec-op : UnificationState, AExpr, CodexType, CodexType, CodexType -> CodexType
  refine-vec-op (st) (func) (arg-ty) (elem-ty) (fallback) =
   let ra = deep-resolve st arg-ty
   in let arg-len = when ra is VectorTy (an) (at) -> an is otherwise -> 0 - 1
   in when func
    is ANameExpr (n) (s) ->
     if n.value == "vec-tail" & arg-len > 0 then deck-record (VectorTy (arg-len - 1) elem-ty)
     else if n.value == "vec-map" & arg-len >= 0 then deck-record (VectorTy arg-len elem-ty)
     else fallback
    is AApplyExpr (inner) (first-arg) (s) ->
     let inner-name = when inner is ANameExpr (n2) (s2) -> n2.value is otherwise -> ""
     in if inner-name == "vec-cons" & arg-len >= 0 then deck-record (VectorTy (arg-len + 1) elem-ty)
     else fallback
    is otherwise -> fallback

Section: Lint __record-set narrowing

 Tripwire pass for silent narrowing at __record-set call sites. When a
 `__record-set st "field" value` is detected and the field has a
 bounded Integer type that the value's static type does not fit, emit
 a warning. Codegen would silently truncate at runtime via narrow-store;
 this lint surfaces the site so the author can decide whether the
 runtime value range actually fits or needs an explicit narrow.

 Literal Integer values are checked against the field bound directly
 (a literal that fits is silent). All other value shapes (field reads,
 arithmetic, function calls) compare the inferred type's bound against
 the field's bound.

  lint-record-set : UnificationState, TypeEnv, AExpr, AExpr, CodexType, CodexType, SourceSpan -> UnificationState
  lint-record-set (st) (env) (func) (value-arg) (value-ty) (return-ty) (span) =
   when func
    is AApplyExpr (inner-func) (field-name-arg) (s2) ->
     when inner-func
      is AApplyExpr (rs-name) (obj-arg) (s3) ->
       when rs-name
        is ANameExpr (n) (s4) ->
         if n.value == "__record-set" then
          lint-record-set-check st env value-arg value-ty return-ty field-name-arg span
         else st
        is otherwise -> st
      is otherwise -> st
    is otherwise -> st

  lint-record-set-check : UnificationState, TypeEnv, AExpr, CodexType, CodexType, AExpr, SourceSpan -> UnificationState
  lint-record-set-check (st) (env) (value-arg) (value-ty) (return-ty) (field-name-arg) (span) =
   when field-name-arg
    is ALitExpr (text-val) (kind) (s) ->
     when kind
      is TextLit ->
       let resolved-record-ty = deep-resolve st return-ty
       in let field-ty = lookup-field-ty-for-lint env resolved-record-ty text-val
       in lint-narrowing-check st env value-arg value-ty field-ty span ("field '" & text-val & "'")
      is otherwise -> st
    is otherwise -> st

  lookup-field-ty-for-lint : TypeEnv, CodexType, Text -> CodexType
  lookup-field-ty-for-lint (env) (ty) (field-name) =
   when ty
    is RecordTy (rname) (rargs) (rfields) -> lookup-record-field rfields field-name
    is ConstructedTy (cname) (cargs) ->
     let rec-ty = resolve-constructed-to-record env (cname.value)
     in when rec-ty
      is RecordTy (rname) (rargs) (rfields) ->
       let raw-ftype = lookup-record-field rfields field-name
       in apply-type-args-subst rargs cargs raw-ftype 0 (list-length rargs)
      is otherwise -> ErrorTy
    is otherwise -> ErrorTy

  is-narrow-call : AExpr -> Boolean
  is-narrow-call (e) =
   when e
    is AApplyExpr (func) (arg) (s) ->
     when func
      is ANameExpr (name) (s2) -> name.value == "__narrow"
      is otherwise -> False
    is otherwise -> False

Section: Lint value-expression range analysis

 The checker-side twin of the emit prover's ir-expr-proven-range: a
 structural walk of the value EXPRESSION at a bounded store, run only
 when the inferred type's range has already failed to fit. It proves
 ranges the type system deliberately does not carry -- a constant
 defined as a literal keeps its declared plain-Integer TYPE (refining
 it would make two distinct constants disjoint under unification),
 but its value is known exactly, so the lint can see the store is
 safe and elide the warning. Unknown shapes
 return the full i64 range, which never fits a real bound: the
 analysis can only silence true positives, never invent one.

  aexpr-proven-range : TypeEnv, AExpr -> (Integer, Integer)
  aexpr-proven-range (env) (e) =
   when e
    is ALitExpr (val) (kind) (s) ->
     when kind
      is IntLit -> let n = lit-text-to-integer val in (n, n)
      is otherwise -> (i64-min, i64-max)
    is ANameExpr (n) (s) ->
     if env-is-local env (n.value) then local-proven-range env (n.value)
     else name-proven-range env (rename-lookup (env.chapter-renames) (n.value))
    is AApplyExpr (func) (arg) (s) -> apply-proven-range env func arg
    is ABinaryExpr (l) (op) (r) (s) -> binary-proven-range env op l r
    is AIfExpr (c) (t) (el) (s) -> if-proven-range env c t el
    is ALetExpr (binds) (body) (s) -> aexpr-proven-range (bind-let-ranges env binds 0 (list-length binds)) body
    is AFieldAccess (obj) (field) (s) -> field-proven-range env obj (field.value)
    is otherwise -> (i64-min, i64-max)

 A `let` body is proven in an env carrying the let's OWN bindings. The
 arm used to recurse into the body with the env it was handed, and the
 binder's range still arrived -- `record-local-range` had written it into
 this very env when inference walked the same def, because
 `env-add-local-range` reached the caller's record. That made every
 bounded return over a let read a range the prover had not derived.
 Cutting that delivery left the arm to derive it: same proofs,
 obtained rather than inherited. `codex/compiler/Core/PhaseAllocator.
 pitch` is the site that proved the difference.

 A binder is bound as a local even when its range is unknown. Every
 `env-is-local` guard downstream (`apply-proven-range`,
 `local-proven-range`) exists to stop a local from borrowing a
 same-named global's fact, and a binder the prover skipped would borrow
 exactly that. The bound type is a placeholder: no prover path reads a
 local's type -- the guards answer before any lookup -- only whether the
 name is one.

  bind-let-ranges : TypeEnv, List ALetBind, Integer, Integer -> TypeEnv
  bind-let-ranges (env) (binds) (i) (len) =
   if i == len then env
   else let b = list-at binds i
   in let (lo, hi) = aexpr-proven-range env (b.value)
   in let env2 = env-bind-local env (b.name.value) int-ty-default
   in let env3 = if lo > i64-min | hi < i64-max then env-add-local-range env2 (b.name.value) lo hi else env2
   in bind-let-ranges env3 binds (i + 1) len

 A bare name proves as a literal-defined constant first, then as a
 zero-argument builtin fact (__deck-pos).

  name-proven-range : TypeEnv, Text -> (Integer, Integer)
  name-proven-range (env) (name) =
   let idx = env-const-find (env.const-ranges) name 0 (list-length (env.const-ranges))
   in if idx < 0 then builtin-return-range name
   else let c = list-at (env.const-ranges) idx
   in (c.lo, c.hi)

 A let-local proves by its recorded range (populated at its binding
 when the value proved narrower than full i64). A local with no
 recorded range is unknown -- the safe default.

  local-proven-range : TypeEnv, Text -> (Integer, Integer)
  local-proven-range (env) (name) =
   let idx = env-local-find (env.local-ranges) name 0 (list-length (env.local-ranges))
   in if idx < 0 then (i64-min, i64-max)
   else let c = list-at (env.local-ranges) idx
   in (c.lo, c.hi)

 A bounded record field proves by its declared bound, on the same
 argument that lets bind-param-range trust a bounded parameter: the
 store that put the value there was itself guarded, so the declared
 range is a fact about whatever is read back out. The emit prover has
 carried this arm all along (ir-expr-proven-range's IrFieldAccess);
 its absence here is why `Nibble { n = b.val / 16 }` was rejected --
 provably 0..15, and provable by the emitter -- while a far weaker
 store went through untouched.

 The receiver must be a plain name. An arbitrary receiver needs
 inference and a UnificationState, which a structural walk does not
 carry, whereas a name's declared type is already in the env. Deeper
 shapes stay unknown, which is the safe answer: this analysis only
 ever silences a true positive, it cannot invent one.

 Only OvError bounds are read, mirroring bind-param-range. A wrapping
 or clamping field is total at its store, but claiming a range that no
 guard enforces would let the lint silence a real overflow, so that
 door stays shut until something needs it open.

  field-declared-range : TypeEnv, Text, Text -> (Integer, Integer)
  field-declared-range (env) (recv) (fname) =
   let obj-ty = if env-has env recv then env-lookup env recv else ErrorTy
   in when lookup-field-ty-for-lint env obj-ty fname
    is IntegerTy (lo) (hi) (mode) ->
     when mode
      is OvError -> (lo, hi)
      is otherwise -> (i64-min, i64-max)
    is otherwise -> (i64-min, i64-max)

 A guard's refinement outranks the declaration, and can only narrow it:
 make-field-cond-refine intersects what the comparison implies with the
 declared range before recording it, so a recorded entry is always inside
 the bound the field was declared with.

  field-proven-range : TypeEnv, AExpr, Text -> (Integer, Integer)
  field-proven-range (env) (obj) (fname) =
   when obj
    is ANameExpr (n) (s) ->
     let key = field-refine-key (n.value) fname
     in let idx = env-local-find (env.local-ranges) key 0 (list-length (env.local-ranges))
     in if idx >= 0 then let c = list-at (env.local-ranges) idx in (c.lo, c.hi)
     else field-declared-range env (n.value) fname
    is otherwise -> (i64-min, i64-max)

 A binary arithmetic expression proves by the shared interval kernel
 (Math chapter Interval): operand ranges convert to Interval at the
 boundary, the iv-* transfer function computes full signed i64
 interval arithmetic, and the result converts back. The kernel
 refuses to iv-unknown whenever an endpoint computation would
 overflow, and iv-unknown converts back to the full i64 range, which
 never fits a real bound -- the analysis stays silence-only. Full
 signed support replaces the hand-written non-negative-only guards
 the checker carried before the kernel existed; it strictly widens
 what can be proven, never what can be stored. An empty interval can
 only reach the boundary through a dead-branch intersection and
 converts to the full range: claiming nothing is sound where nothing
 can flow, and it keeps every downstream tuple a real lo <= hi pair.

  range-interval : (Integer, Integer) -> Interval
  range-interval (p) =
   let (lo, hi) = p
   in Interval { lo = lo, hi = hi }

  interval-range : Interval -> (Integer, Integer)
  interval-range (a) =
   if iv-is-empty a then (i64-min, i64-max)
   else (a.lo, a.hi)

  binary-proven-range : TypeEnv, BinaryOp, AExpr, AExpr -> (Integer, Integer)
  binary-proven-range (env) (op) (l) (r) =
   let l-iv = range-interval (aexpr-proven-range env l)
   in let r-iv = range-interval (aexpr-proven-range env r)
   in when op
    is OpAdd -> interval-range (iv-add l-iv r-iv)
    is OpSub -> interval-range (iv-sub l-iv r-iv)
    is OpMul -> interval-range (iv-mul l-iv r-iv)
    is OpDiv -> interval-range (iv-div l-iv r-iv)
    is otherwise -> (i64-min, i64-max)

 An application proves through three doors. `__narrow x` passes its
 argument's range through, mirroring the emit prover. Otherwise the
 head name is tried against the builtin return facts, and finally
 against the head's DECLARED bounded return - the stage-B
 postcondition guard enforces a declared bounded return at
 runtime, so the declared range is a sound
 fact at every call. Both lookups are guarded by env-is-local so a
 binding that shadows a global name never borrows its fact. A
 partial application walks past its remaining arrows to a range the
 lint never uses (its store value is function-typed, which the lint
 skips). A wrong fact here could only silence the warning; the
 runtime narrow-store check is emitted regardless, so program
 soundness never rests on this table.

 `int-mod` cannot be a `builtin-return-range` row, and that is why the
 checker used to refuse a bounded return the EMITTER proves. That table
 holds one constant interval per builtin name; `int-mod x n` is bounded by
 `[0, n - 1]`, which depends on an argument and so has no constant row to
 sit in. The emit-side prover reads the divisor (`proven-mod-shallow`,
 X86_64Compound), the checker did not, and the two disagreed about the
 same expression -- `ret (n) = int-mod n 200` declared `0..255` was
 rejected with CDX2051 quoting the full i64 interval.

 The divisor is matched STRUCTURALLY rather than by head name: only an
 apply whose own function is the bare name is a genuine two-argument call,
 so a partial application (`int-mod x`, whose argument is the DIVIDEND)
 cannot be mistaken for one and read its dividend as a divisor. The guard
 `lo > 0` is the same one the emitter uses, and it is doing real work: a
 divisor whose range admits zero or negatives proves nothing here, because
 `math-mod` takes the sign of neither operand in a way this interval could
 describe.

  apply-proven-range : TypeEnv, AExpr, AExpr -> (Integer, Integer)
  apply-proven-range (env) (func) (arg) =
   let head = apply-head-name func
   in if text-length head == 0 then (i64-min, i64-max)
   else if head == "__narrow" then aexpr-proven-range env arg
   else if env-is-local env head then (i64-min, i64-max)
   else if is-two-arg-call func "int-mod" then mod-proven-range env arg
   else let (b-lo, b-hi) = builtin-return-range head
   in if b-lo > i64-min | b-hi < i64-max then (b-lo, b-hi)
   else declared-return-range env (rename-lookup (env.chapter-renames) head)

  is-two-arg-call : AExpr, Text -> Boolean
  is-two-arg-call (func) (name) =
   when func
    is AApplyExpr (inner) (a) (s) ->
     when inner
      is ANameExpr (n) (s2) -> n.value == name
      is otherwise -> False
    is otherwise -> False

  mod-proven-range : TypeEnv, AExpr -> (Integer, Integer)
  mod-proven-range (env) (divisor) =
   let (lo, hi) = aexpr-proven-range env divisor
   in if lo > 0 then (0, hi - 1) else (i64-min, i64-max)

  declared-return-range : TypeEnv, Text -> (Integer, Integer)
  declared-return-range (env) (name) =
   if env-has env name == False then (i64-min, i64-max)
   else fun-final-return-range (strip-forall-ty (env-lookup env name))

  fun-final-return-range : CodexType -> (Integer, Integer)
  fun-final-return-range (ty) =
   when ty
    is FunTy (p) (row) (r) -> fun-final-return-range r
    is EffectfulTy (effs) (sc) (ret) -> fun-final-return-range ret
    is IntegerTy (lo) (hi) (mode) -> (lo, hi)
    is otherwise -> (i64-min, i64-max)

 Builtin return facts. All are heap-backed quantities in the 3 GB-RAM
 design: a list cannot hold 2^32 elements in a 4 GB address space
 (elements are at least 8 bytes), a text's byte length cannot exceed
 the heap that holds it, and __deck-pos and __heap-save are heap
 addresses below 4 GB -- the same design-era contract the
 bivy-origin/deck-origin field bounds document. Add a fact only when
 the bound is structural, not conventional.

  builtin-return-range : Text -> (Integer, Integer)
  builtin-return-range (name) =
   if name == "list-length" then (0, 4294967295)
   else if name == "text-length" then (0, 4294967295)
   else if name == "__deck-pos" then (0, 4294967295)
   else if name == "__heap-save" then (0, 4294967295)
   else if name == "__buf-write-bytes" then (0, 4294967295)
   else (i64-min, i64-max)

  proven-range-union : (Integer, Integer), (Integer, Integer) -> (Integer, Integer)
  proven-range-union (a) (b) = interval-range (iv-union (range-interval a) (range-interval b))

 Branch refinement: when an if's
 condition compares a bare local against an expression with a
 provable range, each arm is analyzed with the local's recorded range
 intersected with what the comparison being true (then) or false
 (else) implies -- ABCD's pi-nodes collapsed onto lexical scope. The
 refined entry is pushed onto the env copy that walks one arm and
 never escapes it; a refinement that says nothing (iv-unknown) or
 that proves the arm unreachable (iv-empty) pushes nothing. Both
 orientations are handled: name-on-left directly, name-on-right
 through the swapped operator. An arm whose refined range is empty
 cannot execute, so the if proves as the surviving arm alone (SCCP
 feasibility); an infeasible arm is otherwise walked with the
 unrefined env, which can only widen, never invent.

 A field assignment writes into the record the receiver evaluates to. That
 is only useful when the receiver names a BINDING -- a parameter or a let
 -- because then the caller holds the same record and sees the write. When
 the receiver names a top-level DEFINITION instead, the definition is a
 function of no arguments: every mention of the name evaluates its body
 again and builds a fresh record, so the write lands in a value nothing
 else holds and is discarded on return.

 This type-checks perfectly and is silent at runtime, which is what makes
 it worth a diagnostic. `a64-effect-cell` (`codex/plugs/arm64`) was written
 on every module emit for as long as it existed and never read back
 anything but its initial value; its loader had no callers, so nothing
 noticed. The same idiom was reached for again in CL 9208 to carry a flag
 and silently answered False.

 A receiver that is anything other than a bare name -- a field of another
 record, a subscript, a call result -- is left alone here. Those have their
 own ownership questions and none of them is the flat always-discarded
 write this catches.

  field-assign-observable : TypeEnv, AExpr -> Boolean
  field-assign-observable (env) (rec) =
   when rec
    is ANameExpr (n) (s) -> env-is-local env (n.value)
    is otherwise -> True

  field-assign-receiver-name : AExpr -> Text
  field-assign-receiver-name (rec) =
   when rec
    is ANameExpr (n) (s) -> n.value
    is otherwise -> "the receiver"

  CondRefine = record {
   target : Text,
   recv : Text,
   then-iv : Interval,
   else-iv : Interval
  }

  no-cond-refine : CondRefine = CondRefine { target = "", recv = "", then-iv = iv-unknown, else-iv = iv-unknown }

  compare-op-refines : BinaryOp -> Boolean
  compare-op-refines (op) =
   when op
    is OpLt -> True
    is OpGt -> True
    is OpLtEq -> True
    is OpGtEq -> True
    is OpEq -> True
    is otherwise -> False

  swap-compare-op : BinaryOp -> BinaryOp
  swap-compare-op (op) =
   when op
    is OpLt -> OpGt
    is OpGt -> OpLt
    is OpLtEq -> OpGtEq
    is OpGtEq -> OpLtEq
    is otherwise -> op

 The interval a comparison against [o-lo, o-hi] implies for the
 refined side. The bounds quantify over every concrete value the
 other side can take: v < e with e <= o-hi means v <= o-hi - 1, and
 v < e being false means v >= e >= o-lo. A strict bound one past an
 i64 endpoint has no satisfying value and answers iv-empty. The
 false side of == is not an interval, so it answers iv-unknown.

  interval-lt-bound : Integer -> Interval
  interval-lt-bound (bound) =
   if bound == i64-min then iv-empty
   else Interval { lo = i64-min, hi = bound - 1 }

  interval-gt-bound : Integer -> Interval
  interval-gt-bound (bound) =
   if bound == i64-max then iv-empty
   else Interval { lo = bound + 1, hi = i64-max }

  compare-implied-interval : BinaryOp, Integer, Integer, Boolean -> Interval
  compare-implied-interval (op) (o-lo) (o-hi) (taken) =
   when op
    is OpLt -> if taken then interval-lt-bound o-hi else Interval { lo = o-lo, hi = i64-max }
    is OpLtEq -> if taken then Interval { lo = i64-min, hi = o-hi } else interval-gt-bound o-lo
    is OpGt -> if taken then interval-gt-bound o-lo else Interval { lo = i64-min, hi = o-hi }
    is OpGtEq -> if taken then Interval { lo = o-lo, hi = i64-max } else interval-lt-bound o-hi
    is OpEq -> if taken then Interval { lo = o-lo, hi = o-hi } else iv-unknown
    is otherwise -> iv-unknown

  make-cond-refine : TypeEnv, Text, BinaryOp, (Integer, Integer) -> CondRefine
  make-cond-refine (env) (name) (op) (other) =
   let (o-lo, o-hi) = other
   in let (c-lo, c-hi) = local-proven-range env name
   in let cur = Interval { lo = c-lo, hi = c-hi }
   in CondRefine {
    target = name,
    recv = "",
    then-iv = iv-intersect cur (compare-implied-interval op o-lo o-hi True),
    else-iv = iv-intersect cur (compare-implied-interval op o-lo o-hi False)
   }

 A guard on a FIELD refines it too, and until now it did not: only a
 bare local was a target, so `if b.val <= 15 then Nibble { n = b.val }`
 read b.val as its declared 0..255 and was rejected, while the identical
 `let v = b.val in if v <= 15 then Nibble { n = v }` was proven. The
 guard was the same; the thing guarded was not a name.

 A field key is `recv.field`. It cannot collide with a local: a dot ends
 an identifier, so no local is ever spelled this way, and the entry
 rides local-ranges like any other refinement.

  field-refine-key : Text, Text -> Text
  field-refine-key (recv) (fname) = recv & "." & fname

  make-field-cond-refine : TypeEnv, Text, Text, BinaryOp, (Integer, Integer) -> CondRefine
  make-field-cond-refine (env) (recv) (fname) (op) (other) =
   let (o-lo, o-hi) = other
   in let (c-lo, c-hi) = field-declared-range env recv fname
   in let cur = Interval { lo = c-lo, hi = c-hi }
   in CondRefine {
    target = field-refine-key recv fname,
    recv = recv,
    then-iv = iv-intersect cur (compare-implied-interval op o-lo o-hi True),
    else-iv = iv-intersect cur (compare-implied-interval op o-lo o-hi False)
   }

  cond-refine-target : TypeEnv, AExpr, BinaryOp, (Integer, Integer) -> CondRefine
  cond-refine-target (env) (side) (op) (other) =
   when side
    is ANameExpr (n) (s) ->
     if env-is-local env (n.value) then make-cond-refine env (n.value) op other
     else no-cond-refine
    is AFieldAccess (obj) (f) (s) ->
     when obj
      is ANameExpr (rn) (s2) -> make-field-cond-refine env (rn.value) (f.value) op other
      is otherwise -> no-cond-refine
    is otherwise -> no-cond-refine

  cond-refine : TypeEnv, AExpr -> CondRefine
  cond-refine (env) (c) =
   when c
    is ABinaryExpr (l) (op) (r) (s) ->
     if compare-op-refines op == False then no-cond-refine
     else let from-left = cond-refine-target env l op (aexpr-proven-range env r)
     in if text-length (from-left.target) > 0 then from-left
     else cond-refine-target env r (swap-compare-op op) (aexpr-proven-range env l)
    is otherwise -> no-cond-refine

 The condition a field refinement carries that a local does not need.

 A local is a VALUE: once bound it cannot change, so a range proven at
 the guard still holds at the store. A field is a LOCATION -- `b.val` is
 re-read at the store, and __record-set mutates in place -- so the
 refinement holds only while the arm cannot reach the record. It can only
 reach it by NAMING it: you cannot mutate a record you do not mention. So
 the refinement stands exactly when the receiver appears in the arm
 solely as the object of a field access. `b.val` reads and cannot write;
 `f b` or `__record-set b "val" 200` mentions it bare, and the refinement
 is dropped rather than trusted.

 Unknown shapes answer False and drop it. That is the safe direction:
 dropping a refinement costs a diagnostic the author can satisfy with
 __narrow, while keeping a stale one would silence a real overflow.

 What this does not see: a closure created BEFORE the if that captured
 the record and is called inside the arm. The arm names the closure, not
 the record. Nothing in the tree does this, and the store's own runtime
 bounds check is the backstop either way -- the emit prover does not
 refine on conditions, so it keeps that check regardless of what the
 lint concludes here.

  arm-reads-only : AExpr, Text -> Boolean
  arm-reads-only (e) (name) =
   when e
    is ALitExpr (v) (k) (s) -> True
    is ANameExpr (n) (s) -> n.value /= name
    is AFieldAccess (obj) (f) (s) ->
     when obj
      is ANameExpr (rn) (s2) -> True
      is otherwise -> arm-reads-only obj name
    is AApplyExpr (fn) (a) (s) -> arm-reads-only fn name & arm-reads-only a name
    is ABinaryExpr (l) (op) (r) (s) -> arm-reads-only l name & arm-reads-only r name
    is AUnaryExpr (x) (s) -> arm-reads-only x name
    is AIfExpr (c) (t) (el) (s) -> arm-reads-only c name & arm-reads-only t name & arm-reads-only el name
    is ALazyExpr (x) (s) -> arm-reads-only x name
    is AListExpr (xs) (s) -> arm-reads-only-list xs name 0 (list-length xs)
    is ARecordExpr (rn) (fields) (s) -> arm-reads-only-fields fields name 0 (list-length fields)
    is ALetExpr (binds) (body) (s) -> arm-reads-only body name & arm-reads-only-binds binds name 0 (list-length binds)
    is otherwise -> False

  arm-reads-only-list : List AExpr, Text, Integer, Integer -> Boolean
  arm-reads-only-list (xs) (name) (i) (len) =
   if i >= len then True
   else if arm-reads-only (list-at xs i) name == False then False
   else arm-reads-only-list xs name (i + 1) len

  arm-reads-only-fields : List AFieldExpr, Text, Integer, Integer -> Boolean
  arm-reads-only-fields (fields) (name) (i) (len) =
   if i >= len then True
   else if arm-reads-only ((list-at fields i).value) name == False then False
   else arm-reads-only-fields fields name (i + 1) len

  arm-reads-only-binds : List ALetBind, Text, Integer, Integer -> Boolean
  arm-reads-only-binds (binds) (name) (i) (len) =
   if i >= len then True
   else if arm-reads-only ((list-at binds i).value) name == False then False
   else arm-reads-only-binds binds name (i + 1) len

  arm-refined-env : TypeEnv, CondRefine, Interval, AExpr -> TypeEnv
  arm-refined-env (env) (rf) (iv) (arm) =
   if text-length (rf.target) == 0 then env
   else if iv-is-empty iv | iv-is-unknown iv then env
   else if text-length (rf.recv) > 0 & (arm-reads-only arm (rf.recv) == False) then env
   else env-add-local-range env (rf.target) (iv.lo) (iv.hi)

  if-proven-range : TypeEnv, AExpr, AExpr, AExpr -> (Integer, Integer)
  if-proven-range (env) (c) (t) (el) =
   let rf = cond-refine env c
   in if text-length (rf.target) > 0 & iv-is-empty (rf.then-iv)
   then aexpr-proven-range (arm-refined-env env rf (rf.else-iv) el) el
   else if text-length (rf.target) > 0 & iv-is-empty (rf.else-iv)
   then aexpr-proven-range (arm-refined-env env rf (rf.then-iv) t) t
   else proven-range-union (aexpr-proven-range (arm-refined-env env rf (rf.then-iv) t) t) (aexpr-proven-range (arm-refined-env env rf (rf.else-iv) el) el)

 A refined position -- record field, constructor payload, function
 parameter, or function return -- draws the same hybrid check. The
 `descriptor` is the full noun phrase naming the position (e.g.
 "field 'code'", "bounded parameter", "bounded return") so one
 mechanism serves every bounded-signature site.

  lint-narrowing-check : UnificationState, TypeEnv, AExpr, CodexType, CodexType, SourceSpan, Text -> UnificationState
  lint-narrowing-check (st) (env) (value-arg) (value-ty) (field-ty) (span) (descriptor) =
   if is-narrow-call value-arg then st
   else when field-ty
    is IntegerTy (f-lo) (f-hi) (f-mode) ->
     when f-mode
      is OvError ->
       when value-arg
        is ALitExpr (val-text) (kind) (s) ->
         when kind
          is IntLit ->
           let n = lit-text-to-integer val-text
           in if n >= f-lo & n <= f-hi then st
           else __record-set st "bag" (bag-add (st.bag) (make-error cdx-narrowing-record-set-literal (descriptor & " has bound " & integer-to-text f-lo & ".." & integer-to-text f-hi & " but assigned literal " & integer-to-text n & " is out of range") span))
          is otherwise -> st
        is otherwise ->
         let resolved-vty = deep-resolve st value-ty
         in when resolved-vty
          is IntegerTy (v-lo) (v-hi) (v-mode) ->
           if v-lo >= f-lo & v-hi <= f-hi then st
           else lint-narrowing-prove st env value-arg f-lo f-hi v-lo v-hi span descriptor
          is otherwise -> st
      is otherwise -> st
    is otherwise -> st

 The type range failed to fit; before rejecting, try the expression
 analysis. A NON-TRIVIAL proof -- one whose proven range is a real
 interval (p-lo < p-hi), the prover deriving a bound from arithmetic
 or flow -- is reported as the CDX2053 info so the elision stays
 visible in build logs and assertable in .diag sidecars. A TRIVIAL
 proof, whose proven range is a single point (p-lo == p-hi, a literal
 or a named constant that folds to one value), elides silently: the
 fit is self-evident and reporting it drowned the informative proofs
 (~96% of CDX2053s on a self-compile were single-point constants).
 The elision itself is unchanged in both cases -- only the info line
 is gated. An unproven flow is the CDX2051 error -- the campaign
 endgame: a bound is a contract, so a value
 that cannot be shown to honour it does not compile. The author
 either strengthens the source (a bounded field, parameter, return,
 or constant the prover can see) or takes responsibility with
 __narrow, which traps at runtime if violated.

 The verdict is reached on the PROVEN range and the error used to quote
 the inferred TYPE's, so it named a quantity the decision had not used:
 `b.val / 8` over a 0..255 byte is provably 0..31, and the message read
 "value type is 0..255" -- neither the bound nor the proof, and an
 understatement of what had already been worked out. An author cannot act
 on a number the compiler did not use.

 It reports the proof, and only the proof. The two are not
 interchangeable and must not be combined: since arithmetic keeps the
 narrower operand's bound, an inferred type is a CONTRACT the store's
 runtime check enforces, not a fact about the value -- `b.val - 10` types
 as 0..255 and evaluates to -10. Intersecting the two would "prove" a
 range the value can leave, which is the one thing this analysis must
 never do. The proof is sound on its own, and it already reaches every
 sound thing the type knows: a field's declared bound (enforced at every
 store), a bounded return, a bounded parameter, a literal.

  lint-narrowing-prove : UnificationState, TypeEnv, AExpr, Integer, Integer, Integer, Integer, SourceSpan, Text -> UnificationState
  lint-narrowing-prove (st) (env) (value-arg) (f-lo) (f-hi) (v-lo) (v-hi) (span) (descriptor) =
   let (p-lo, p-hi) = aexpr-proven-range env value-arg
   in if p-lo >= f-lo & p-hi <= f-hi
   then if p-lo == p-hi then st
    else __record-set st "bag" (bag-add (st.bag) (make-info cdx-narrowing-proven (descriptor & " has bound " & integer-to-text f-lo & ".." & integer-to-text f-hi & " and the value expression is proven within " & integer-to-text p-lo & ".." & integer-to-text p-hi & "; bounds check elided") span))
   else __record-set st "bag" (bag-add (st.bag) (make-error cdx-narrowing-record-set (descriptor & " has bound " & integer-to-text f-lo & ".." & integer-to-text f-hi & " but the value's proven range is " & integer-to-text p-lo & ".." & integer-to-text p-hi & "; prove the value's range or assert it with __narrow, which traps at runtime if violated") span))
  infer-int-lit-arg : UnificationState, CodexType, Text, LiteralKind -> CheckResult
  infer-int-lit-arg (st) (func-ty) (val) (kind) =
   when kind
    is IntLit ->
     let stripped = strip-forall-ty func-ty
     in when stripped
      is FunTy (param-ty) (row) (ret-ty) ->
       when param-ty
        is IntegerTy (lo) (hi) (mode) ->
         let n = lit-text-to-integer val
         in if n >= lo & n <= hi then CheckResult {
          inferred-type = deck-record (IntegerTy lo hi mode),
          effect-row = empty-row,
          state = st
         }
         else infer-literal st kind
        is otherwise -> infer-literal st kind
      is otherwise -> infer-literal st kind
    is otherwise -> infer-literal st kind

Section: Infer List
  infer-list : UnificationState, TypeEnv, List AExpr, SourceSpan, Integer -> CheckResult
  infer-list (st0) (env) (elems) (span) (depth) =
   let st = if list-length elems > max-list-literal-elems
      then __record-set st0 "bag" (bag-add (st0.bag) (make-error cdx-list-literal-too-large ("List literal has " & integer-to-text (list-length elems) & " elements; at most " & integer-to-text max-list-literal-elems & " are accepted. Split it across several definitions and join them.") span))
      else st0
   in if list-length elems == 0
    then
     let (fr-ty, fr-st) = fresh-and-advance st
     in CheckResult {
      inferred-type = fr-ty,
      effect-row = empty-row,
      state = fr-st
     }
    else let first = infer-expr-at st env (list-at elems 0) (depth + 1)
    in let (elems-row, st2) = unify-list-elems (first.state) env elems (first.inferred-type) 1 (list-length elems) (first.effect-row) depth
    in CheckResult {
      inferred-type = deck-record (ListTy (first.inferred-type)),
      effect-row = elems-row,
      state = st2
     }

  unify-list-elems : UnificationState, TypeEnv, List AExpr, CodexType, Integer, Integer, EffectRow, Integer -> (EffectRow, UnificationState)
  unify-list-elems (st) (env) (elems) (elem-ty) (i) (len) (acc-row) (depth) =
   if i == len then (acc-row, st)
   else let e = list-at elems i
   in let er = infer-expr-at st env e (depth + 1)
   in let (_, u-st) = unify (er.state) (er.inferred-type) elem-ty (aexpr-span e)
   in let (acc2, acc-st) = row-union u-st acc-row (er.effect-row)
   in unify-list-elems acc-st env elems elem-ty (i + 1) len acc2 depth

Section: Infer Match
  is-gadt-type : UnificationState, CodexType -> Boolean
  is-gadt-type (st) (ty) =
   let resolved = deep-resolve st ty
   in when resolved
    is SumTy (name) (args) (ctors) -> any-ctor-has-return-type ctors 0 (list-length ctors)
    is otherwise -> False

  any-ctor-has-return-type : List SumCtor, Integer, Integer -> Boolean
  any-ctor-has-return-type (ctors) (i) (len) =
   if i >= len then False
   else if list-length ((list-at ctors i).return-type) > 0 then True
   else any-ctor-has-return-type ctors (i + 1) len

 A match's ambient is the scrutinee's union every arm's guard and
 body -- an over-approximation across arms (only one arm runs), which
 is the sound direction. The arm walkers thread the accumulated row.
 A GADT arm's ambient union survives the substitution restore
 deliberately: the arm really is evaluated at runtime, so its
 effects are part of the match's ambient even though its speculative
 type bindings are rolled back.

  infer-match : UnificationState, TypeEnv, AExpr, List AMatchArm, Integer -> CheckResult
  infer-match (st) (env) (scrutinee) (arms) (depth) =
   let sr = infer-expr-at st env scrutinee (depth + 1)
   in let (fr-ty, fr-st) = fresh-and-advance (sr.state)
   in let gadt = is-gadt-type fr-st (sr.inferred-type)
   in let (arms-row, st2) = infer-match-arms fr-st env (sr.inferred-type) fr-ty arms 0 (list-length arms) gadt (sr.effect-row) depth
   in let st3 = check-match-exhaustiveness st2 (sr.inferred-type) arms (aexpr-span scrutinee)
   in CheckResult {
    inferred-type = fr-ty,
    effect-row = arms-row,
    state = st3
   }

  infer-match-arms : UnificationState, TypeEnv, CodexType, CodexType, List AMatchArm, Integer, Integer, Boolean, EffectRow, Integer -> (EffectRow, UnificationState)
  infer-match-arms (st) (env) (scrut-ty) (result-ty) (arms) (i) (len) (is-gadt) (acc-row) (depth) =
   if i == len then (acc-row, st)
   else let arm = list-at arms i
   in if is-gadt then infer-gadt-arm st env scrut-ty result-ty arm arms (i + 1) len acc-row depth else infer-plain-arm st env scrut-ty result-ty arm arms (i + 1) len is-gadt acc-row depth

 A guard on a Nil or Cons arm is refused: the lowering desugar chains
 arms as nested ifs, and a failed guard would need the rest of the
 chain duplicated under the arm's bindings. The parser writes a True
 literal where the source carries no guard, therefore that literal is
 the shape a guardless arm presents here.

  is-trivial-guard : AExpr -> Boolean
  is-trivial-guard (g) =
   when g
    is ALitExpr (t) (k) (s) -> t == "True"
    is otherwise -> False

  check-list-arm-guard : UnificationState, CodexType, AMatchArm -> UnificationState
  check-list-arm-guard (st) (scrut-ty) (arm) =
   let rty = deep-resolve st scrut-ty
   in when rty
    is ListTy (e) ->
     (when (arm.pattern)
      is ACtorPat (cn) (subs) (s) ->
       if is-builtin-list-ctor (cn.value)
       then if is-trivial-guard (arm.guard) then st
        else list-pattern-shape-error st "a guard on a Nil or Cons arm; test inside the arm body" s
       else st
      is otherwise -> st)
    is otherwise -> st

  infer-plain-arm : UnificationState, TypeEnv, CodexType, CodexType, AMatchArm, List AMatchArm, Integer, Integer, Boolean, EffectRow, Integer -> (EffectRow, UnificationState)
  infer-plain-arm (st) (env) (scrut-ty) (result-ty) (arm) (arms) (next) (len) (is-gadt) (acc-row) (depth) =
   let st-g = check-list-arm-guard st scrut-ty arm
   in let pr = bind-pattern st-g env (arm.pattern) scrut-ty
   in let gr = infer-expr-at (pr.state) (pr.env) (arm.guard) (depth + 1)
   in let (_, gu-st) = unify (gr.state) (gr.inferred-type) BooleanTy (aexpr-span (arm.guard))
   in let br = infer-expr-at gu-st (pr.env) (arm.body) (depth + 1)
   in let (_, u-st) = unify (br.state) (br.inferred-type) result-ty (aexpr-span (arm.body))
   in let (acc2, acc-st) = row-union u-st acc-row (gr.effect-row)
   in let (acc3, acc-st2) = row-union acc-st acc2 (br.effect-row)
   in infer-match-arms acc-st2 env scrut-ty result-ty arms next len is-gadt acc3 depth

  infer-gadt-arm : UnificationState, TypeEnv, CodexType, CodexType, AMatchArm, List AMatchArm, Integer, Integer, EffectRow, Integer -> (EffectRow, UnificationState)
  infer-gadt-arm (st) (env) (scrut-ty) (result-ty) (arm) (arms) (next) (len) (acc-row) (depth) =
   let saved = snapshot-substitutions st
   in let pr = bind-pattern st env (arm.pattern) scrut-ty
   in let gr = infer-expr-at (pr.state) (pr.env) (arm.guard) (depth + 1)
   in let (_, gu-st) = unify (gr.state) (gr.inferred-type) BooleanTy (aexpr-span (arm.guard))
   in let br = infer-expr-at gu-st (pr.env) (arm.body) (depth + 1)
   in let (_, u-st) = unify (br.state) (br.inferred-type) result-ty (aexpr-span (arm.body))
   in let restored = restore-substitutions u-st saved
   in let (acc2, acc-st) = row-union restored acc-row (gr.effect-row)
   in let (acc3, acc-st2) = row-union acc-st acc2 (br.effect-row)
   in infer-match-arms acc-st2 env scrut-ty result-ty arms next len True acc3 depth

  check-match-exhaustiveness : UnificationState, CodexType, List AMatchArm, SourceSpan -> UnificationState
  check-match-exhaustiveness (st) (scrut-ty) (arms) (span) =
   let resolved0 = deep-resolve st scrut-ty
   in let resolved = when resolved0
      is ListTy (le) -> builtin-list-sumty le
      is otherwise -> resolved0
   in when resolved
    is SumTy (name) (args) (ctors) ->
     if match-has-catchall arms 0 (list-length arms) then st
     else let covered = collect-covered-ctors arms 0 (list-length arms) []
      in let missing = find-missing-ctors ctors covered 0 (list-length ctors) []
      in if list-length missing == 0 then st
         else __record-set st "bag" (bag-add (st.bag) (make-error cdx-non-exhaustive-match ("Non-exhaustive match on '" & name.value & "': missing " & format-missing-ctors missing 0 (list-length missing) "") span))
    is otherwise -> st

  match-has-catchall : List AMatchArm, Integer, Integer -> Boolean
  match-has-catchall (arms) (i) (len) =
   if i == len then False
   else let pat = (list-at arms i).pattern
   in when pat
    is AWildPat (s) | AVarPat (n) (s) -> True
    is otherwise -> match-has-catchall arms (i + 1) len

  collect-covered-ctors : List AMatchArm, Integer, Integer, List Text -> List Text
  collect-covered-ctors (arms) (i) (len) (acc) =
   if i == len then acc
   else let pat = (list-at arms i).pattern
   in when pat
    is ACtorPat (ctor-name) (sub-pats) (s) ->
     collect-covered-ctors arms (i + 1) len (list-push acc (ctor-name.value))
    is otherwise -> collect-covered-ctors arms (i + 1) len acc

  find-missing-ctors : List SumCtor, List Text, Integer, Integer, List Text -> List Text
  find-missing-ctors (ctors) (covered) (i) (len) (acc) =
   if i == len then acc
   else let c = list-at ctors i
   in if text-list-contains covered (c.name.value) 0 (list-length covered)
      then find-missing-ctors ctors covered (i + 1) len acc
      else find-missing-ctors ctors covered (i + 1) len (list-push acc (c.name.value))

  text-list-contains : List Text, Text, Integer, Integer -> Boolean
  text-list-contains (xs) (target) (i) (len) =
   if i == len then False
   else if list-at xs i == target then True
   else text-list-contains xs target (i + 1) len

  format-missing-ctors : List Text, Integer, Integer, Text -> Text
  format-missing-ctors (names) (i) (len) (acc) =
   if i == len then acc
   else let sep = if i == 0 then "" else ", "
   in format-missing-ctors names (i + 1) len (acc & sep & list-at names i)

  PatBindResult = record {
   state : UnificationState,
   env : TypeEnv
  }

  bind-pattern : UnificationState, TypeEnv, APat, CodexType -> PatBindResult
  bind-pattern (st) (env) (pat) (ty) =
   when pat
    is AVarPat (name) (s) -> PatBindResult {
     state = st,
     env = env-bind-local env (name.value) ty
    }
    is AWildPat (s) | ALitPat (val) (kind) (s) -> PatBindResult {
     state = st,
     env = env
    }
    is AVecPat (sub-pats) (s) ->
     let elem-ty = when ty is VectorTy (n) (t) -> t is otherwise -> ErrorTy
     in bind-vec-sub-patterns st env sub-pats elem-ty 0 (list-length sub-pats)
    is ACtorPat (ctor-name) (sub-pats) (s) ->
     let rty = deep-resolve st ty
     in when rty
      is ListTy (elem) ->
       if is-builtin-list-ctor (ctor-name.value)
       then bind-list-ctor-pattern st env (ctor-name.value) sub-pats elem s
       else bind-ctor-pattern-generic st env ctor-name sub-pats ty s
      is otherwise -> bind-ctor-pattern-generic st env ctor-name sub-pats ty s

  bind-ctor-pattern-generic : UnificationState, TypeEnv, Name, List APat, CodexType, SourceSpan -> PatBindResult
  bind-ctor-pattern-generic (st) (env) (ctor-name) (sub-pats) (ty) (s) =
   if env-has env (ctor-name.value) == False
   then let err-st = __record-set st "bag" (bag-add (st.bag) (make-error cdx-unknown-pattern-ctor ("Pattern constructor '" & ctor-name.value & "' is not in scope; this arm could never match. Check the constructor names of the scrutinee's type.") s))
    in bind-ctor-sub-patterns err-st env sub-pats ErrorTy 0 (list-length sub-pats)
   else
    let (ctor-ty, ctor-st) = instantiate-type st (env-lookup env (ctor-name.value))
    in let ctor-ret = strip-fun-args ctor-ty
    in let (ok, unified-st) = unify ctor-st ctor-ret ty s
    in bind-ctor-sub-patterns unified-st env sub-pats ctor-ty 0 (list-length sub-pats)

 The builtin List has no declared constructors, therefore Nil and Cons
 on a List scrutinee bind against the same synthesized view Stage 5
 induction already checks against: Nil takes nothing, Cons takes the
 element and a tail of the same List type. Only name and wildcard
 fields are accepted -- a nested pattern in a Cons field would force
 the lowering desugar to duplicate the rest of the match per nesting
 level, therefore the checker refuses the shape here, where the
 message can say what to write instead. LinkedList scrutinees are
 excluded: the linked representation has no view runtime.

  is-builtin-list-ctor : Text -> Boolean
  is-builtin-list-ctor (n) = if n == "Cons" then True else n == "Nil"

  list-subpat-simple : APat -> Boolean
  list-subpat-simple (p) =
   when p
    is AVarPat (n) (sp) -> True
    is AWildPat (sp) -> True
    is otherwise -> False

  list-pattern-shape-error : UnificationState, Text, SourceSpan -> UnificationState
  list-pattern-shape-error (st) (msg) (s) =
   __record-set st "bag" (bag-add (st.bag) (make-error cdx-list-pattern-shape ("List pattern not supported yet: " & msg) s))

  bind-list-ctor-pattern : UnificationState, TypeEnv, Text, List APat, CodexType, SourceSpan -> PatBindResult
  bind-list-ctor-pattern (st) (env) (cn) (sub-pats) (elem) (s) =
   if cn == "Nil"
   then if list-length sub-pats == 0 then PatBindResult { state = st, env = env }
    else PatBindResult { state = list-pattern-shape-error st "Nil takes no fields" s, env = env }
   else if list-length sub-pats /= 2
    then PatBindResult { state = list-pattern-shape-error st "Cons over the builtin List takes exactly two fields, the head and the tail" s, env = env }
   else if list-subpat-simple (list-at sub-pats 0) & list-subpat-simple (list-at sub-pats 1)
    then let pr0 = bind-pattern st env (list-at sub-pats 0) elem
     in bind-pattern (pr0.state) (pr0.env) (list-at sub-pats 1) (deck-record (ListTy elem))
    else PatBindResult { state = list-pattern-shape-error st "a Cons field over the builtin List must be a name or _; bind the tail and match it in a nested when" s, env = env }

  bind-ctor-sub-patterns : UnificationState, TypeEnv, List APat, CodexType, Integer, Integer -> PatBindResult
  bind-ctor-sub-patterns (st) (env) (sub-pats) (ctor-ty) (i) (len) =
   if i == len then PatBindResult {
    state = st,
    env = env
   }
   else when ctor-ty
     is FunTy (param-ty) (row) (ret-ty) ->
      let pr = bind-pattern st env (list-at sub-pats i) param-ty
      in bind-ctor-sub-patterns (pr.state) (pr.env) sub-pats ret-ty (i + 1) len
     is otherwise ->
      let (fr-ty, fr-st) = fresh-and-advance st
      in let pr = bind-pattern fr-st env (list-at sub-pats i) fr-ty
      in bind-ctor-sub-patterns (pr.state) (pr.env) sub-pats ctor-ty (i + 1) len

  bind-vec-sub-patterns : UnificationState, TypeEnv, List APat, CodexType, Integer, Integer -> PatBindResult
  bind-vec-sub-patterns (st) (env) (sub-pats) (elem-ty) (i) (len) =
   if i == len then PatBindResult {
    state = st,
    env = env
   }
   else let pr = bind-pattern st env (list-at sub-pats i) elem-ty
   in bind-vec-sub-patterns (pr.state) (pr.env) sub-pats elem-ty (i + 1) len

Section: Infer Act

 An act block performs every statement, so its ambient row is the
 union of its statements' ambients; the act's TYPE is simply the
 last statement's. The stage-3b readers consume the row, so the old
 EffectfulTy name-union machinery (act-wrap-effects, act-value-type,
 union-names) is retired -- effects no longer ride result types.
 Effectful values and calls arrive at the statements already
 unwrapped by infer-name and infer-application, their effects in the
 ambient.

  infer-act : UnificationState, TypeEnv, List AActStmt, Integer -> CheckResult
  infer-act (st) (env) (stmts) (depth) =
   infer-act-loop st env stmts 0 (list-length stmts) NothingTy empty-row depth

  infer-act-loop : UnificationState, TypeEnv, List AActStmt, Integer, Integer, CodexType, EffectRow, Integer -> CheckResult
  infer-act-loop (st) (env) (stmts) (i) (len) (last-ty) (acc-row) (depth) =
   if i == len then CheckResult {
    inferred-type = deep-resolve st last-ty,
    effect-row = acc-row,
    state = st
   }
   else let stmt = list-at stmts i
   in when stmt
     is AActExprStmt (e) (s) ->
      when e
       is ALetExpr (binds) (lbody) (ls) -> infer-act-let st env binds lbody stmts i len acc-row depth
       is otherwise ->
        let er = infer-expr-at st env e (depth + 1)
        in let (acc2, acc-st) = row-union (er.state) acc-row (er.effect-row)
        in infer-act-loop acc-st env stmts (i + 1) len (er.inferred-type) acc2 depth
     is AActBindStmt (name) (e) (s) ->
      let er = infer-expr-at st env e (depth + 1)
   in let (acc2, acc-st) = row-union (er.state) acc-row (er.effect-row)
   in let env2 = env-bind-local env (name.value) (deep-resolve acc-st (er.inferred-type))
   in infer-act-loop acc-st env2 stmts (i + 1) len (er.inferred-type) acc2 depth

 A `let` statement in an act block is do-notation: it scopes over the
 REST of the block, not merely over its own `in` body. Lowering says
 this by nesting the remaining statements inside the let's body
 (`lower-act-let`); the checker has to say the same thing, and it says
 it by threading the extended env into both the let's body AND the
 statements that follow.

 The checker once did not thread it at all -- the binding
 reached the following statements only because `env-bind-local` aliased
 the caller's locals list, so the sibling statements read a binding
 that had merely never been removed. That made the act-block case work
 by the same accident that let an if-arm's local escape its arm. The
 threading here is what lets the bind stop aliasing.

 A let CHAIN is peeled to its innermost body, so every binding in the
 chain scopes over the rest of the block -- the shape `codex/test/
 mask-ops` pins, and the same peel `lower-act-let` performs.

  infer-act-let : UnificationState, TypeEnv, List ALetBind, AExpr, List AActStmt, Integer, Integer, EffectRow, Integer -> CheckResult
  infer-act-let (st) (env) (binds) (body) (stmts) (i) (len) (acc-row) (depth) =
   let lr = infer-let-bindings st env binds 0 (list-length binds) empty-row depth
   in let (acc2, acc-st) = row-union (lr.state) acc-row (lr.binds-row)
   in when body
    is ALetExpr (binds2) (body2) (ls2) -> infer-act-let acc-st (lr.env) binds2 body2 stmts i len acc2 (depth + 1)
    is otherwise ->
     let br = infer-expr-at acc-st (lr.env) body (depth + 1)
     in let (acc3, acc-st2) = row-union (br.state) acc2 (br.effect-row)
     in infer-act-loop acc-st2 (lr.env) stmts (i + 1) len (br.inferred-type) acc3 depth

Section: Infer Expression (dispatch)

 infer-expr is how a DEFINITION is entered, and it is the only place the
 budget returns to zero: each definition legitimately starts fresh. Every
 walker inside the inference cycle calls infer-expr-at and passes
 depth + 1, so the budget measures real AST nesting. A helper that calls
 infer-expr rather than infer-expr-at silently restores the hole below.

 That rule is load-bearing, and it was broken from the day the budget was
 added until 2026-07-16. The dispatch arms handed their work to helpers
 that called infer-expr, which reset the count at every match, let, act
 and application. Depth accumulated only across chained unary operators
 and field accesses, which no real program writes, and CDX9001 could
 therefore never fire for the constructs that actually recurse. A runaway
 inference walked the stack a gigabyte down into the demand-paged range
 and double-faulted, where the CPU cannot deliver a page fault onto the
 faulting stack: the compiler died silently instead of reporting
 exhaustion.

  infer-expr : UnificationState, TypeEnv, AExpr -> CheckResult
  infer-expr (st) (env) (expr) = infer-expr-at st env expr 0

  infer-expr-at : UnificationState, TypeEnv, AExpr, Integer -> CheckResult
  infer-expr-at (st) (env) (expr) (depth) =
   if depth >= max-recursion-depth then CheckResult {
    inferred-type = ErrorTy,
    effect-row = empty-row,
    state = add-unify-error st cdx-resource-exhausted ("compiler resource exhausted in type-checker.infer-expr (budget " & integer-to-text max-recursion-depth & ")") (aexpr-span expr)
   }
   else when expr
    is ALitExpr (val) (kind) (s) -> infer-literal (check-int-lit-range st val kind s) kind
    is ANameExpr (name) (s) -> infer-name st env (name.value) s
    is ABinaryExpr (left) (op) (right) (s) -> infer-binary st env left op right s depth
    is AUnaryExpr (operand) (s) ->
     let r = infer-expr-at st env operand (depth + 1)
     in let op-ty = deep-resolve (r.state) (r.inferred-type)
     in if is-real-type op-ty then CheckResult {
      inferred-type = op-ty,
      effect-row = r.effect-row,
      state = r.state
     }
     else if is-undecided-type op-ty then CheckResult {
      inferred-type = op-ty,
      effect-row = r.effect-row,
      state = r.state
     }
     else let (_, u-st) = unify (r.state) op-ty int-ty-default (aexpr-span operand)
     in CheckResult {
      inferred-type = int-ty-default,
      effect-row = r.effect-row,
      state = u-st
     }
    is AApplyExpr (func) (arg) (s) -> infer-application st env func arg s depth
    is AIfExpr (cond) (then-e) (else-e) (s) -> infer-if st env cond then-e else-e s depth
    is ALetExpr (bindings) (body) (s) -> infer-let st env bindings body depth
    is ALambdaExpr (params) (body) (s) -> infer-lambda st env params body depth
    is AMatchExpr (scrutinee) (arms) (s) -> infer-match st env scrutinee arms depth
    is AListExpr (elems) (s) -> infer-list st env elems s depth
    is AActExpr (stmts) (s) -> infer-act st env stmts depth
    is AFieldAccess (obj) (field) (s) ->
     let r = infer-expr-at st env obj (depth + 1)
     in let resolved = deep-resolve (r.state) (r.inferred-type)
     in when resolved
      is RecordTy (rname) (rargs) (rfields) ->
       let ftype = lookup-record-field rfields (field.value)
     in let st2 = when ftype
          is ErrorTy -> add-unify-error (r.state) cdx-unknown-record-field ("Record type has no field '" & field.value & "'") s
          is otherwise -> r.state
     in CheckResult {
        inferred-type = ftype,
        effect-row = r.effect-row,
        state = st2
       }
      is ConstructedTy (cname) (cargs) ->
       let record-type = resolve-constructed-to-record env (cname.value)
     in when record-type
        is RecordTy (rname) (rargs) (rfields) ->
         let raw-ftype = lookup-record-field rfields (field.value)
     in let ftype = apply-type-args-subst rargs cargs raw-ftype 0 (list-length rargs)
     in let st2 = when raw-ftype
            is ErrorTy -> add-unify-error (r.state) cdx-unknown-record-field ("Record type '" & cname.value & "' has no field '" & field.value & "'") s
            is otherwise -> r.state
     in CheckResult {
          inferred-type = ftype,
          effect-row = r.effect-row,
          state = st2
         }
        is otherwise ->
         let (fr-ty, fr-st) = fresh-and-advance (r.state)
     in CheckResult {
          inferred-type = fr-ty,
          effect-row = r.effect-row,
          state = fr-st
         }
      is UnitTy (uname) (uinner) ->
       CheckResult {
        inferred-type = ErrorTy,
        effect-row = r.effect-row,
        state = add-unify-error (r.state) cdx-field-on-unit-type ("'" & uname.value & "' is a unit type, not a record: the wrapper is a distinct type of its own and has no field '" & field.value & "'. A unit over a record has no accessor and is not accepted where the record is expected, so the field cannot be reached through it -- use the record directly, or declare the unit over a primitive") s
       }
      is otherwise ->
       let (fr-ty, fr-st) = fresh-and-advance (r.state)
     in CheckResult {
        inferred-type = fr-ty,
        effect-row = r.effect-row,
        state = fr-st
       }

    is ARecordExpr (name) (fields) (s) ->
     let ctor-raw = if env-has env (name.value) then env-lookup env (name.value) else ErrorTy
     in let (inst-ty, inst-st) = instantiate-type st ctor-raw
     in let result-type = strip-fun-args inst-ty
     in let (fields-row, st2) = infer-and-unify-record-fields inst-st env fields result-type 0 (list-length fields) empty-row depth
     in let st3 = check-mutation-in-ctor-fields (record-expr-type st2 s result-type) fields 0 (list-length fields)
     in let st4 = check-record-complete st3 fields result-type s
     in CheckResult {
      inferred-type = result-type,
      effect-row = fields-row,
      state = st4
     }
    is AHandleExpr (eff) (body) (clauses) (s) ->
     let body-r = infer-expr-at st env body (depth + 1)
     in let resolved-b = resolve-row (body-r.state) (body-r.effect-row)
     in let (after-row, after-st) = if row-labels-covered resolved-b (eff.value)
        then (row-drop-covered resolved-b (eff.value), body-r.state)
        else if resolved-b.tail-id >= 0
        then let (tp, tp-st) = fresh-row-id (body-r.state)
             in let ext = make-row [deck-record (EffectLabel { name = Name { value = eff.value }, scope = "" })] "" tp
             in let (_, u-st) = unify-row tp-st (body-r.effect-row) ext s
             in (deck-record (row-var tp), u-st)
        else (body-r.effect-row, __record-set (body-r.state) "bag" (bag-add ((body-r.state).bag) (make-warning cdx-handler-unused ("handler for '" & eff.value & "' encloses a body whose type performs no " & eff.value) s)))
     in let (handle-row, cl-st) = infer-handle-clauses after-st env clauses 0 (list-length clauses) after-row depth
     in CheckResult {
      inferred-type = body-r.inferred-type,
      effect-row = handle-row,
      state = cl-st
     }
    is AWithTimeoutExpr (timeout) (effs) (scopes) (body) (s) ->
     infer-expr-at st env body (depth + 1)
    is ATryExpr (max) (body) (fb) (fail) (s) ->
     let body-r = infer-act st env body (depth + 1)
     in let fb-r = if list-length fb > 0 then infer-act (body-r.state) env fb (depth + 1) else body-r
     in let fail-r = if list-length fail > 0 then infer-act (fb-r.state) env fail (depth + 1) else fb-r
     in let (amb1, amb1-st) = row-union (fail-r.state) (body-r.effect-row) (fb-r.effect-row)
     in let (amb, amb-st) = row-union amb1-st amb1 (fail-r.effect-row)
     in CheckResult { inferred-type = body-r.inferred-type, effect-row = amb, state = amb-st }
    is AFieldAssignExpr (rec) (field) (val) (s) ->
     let rr = infer-expr-at st env rec (depth + 1)
     in let vr = infer-expr-at (rr.state) env val (depth + 1)
     in let resolved = deep-resolve (vr.state) (rr.inferred-type)
     in let type-name = when resolved
      is RecordTy (rname) (rargs) (rfields) -> rname.value
      is ConstructedTy (cname) (cargs) -> cname.value
      is otherwise -> ""
     in let unit-name = when resolved
      is UnitTy (uname) (uinner) -> uname.value
      is otherwise -> ""
     in let unit-recv = text-length unit-name > 0
     in let st-unit = if unit-recv
      then add-unify-error (vr.state) cdx-field-on-unit-type ("'" & unit-name & "' is a unit type, not a record: the wrapper is a distinct type of its own and has no field '" & field.value & "'. A unit over a record has no accessor and is not accepted where the record is expected, so the field cannot be reached through it -- use the record directly, or declare the unit over a primitive") s
      else vr.state
     in let marker-name = "__mutable-" & type-name
     in let mut-ok = env-has env marker-name
     in let st-mut = if unit-recv | mut-ok then st-unit
      else add-unify-error st-unit cdx-field-assign-immutable ("Field assignment requires a mutable record; '" & type-name & "' is immutable") s
     in let st-obs = if unit-recv | field-assign-observable env rec then st-mut
      else add-unify-error st-mut cdx-field-assign-unobservable ("Field assignment to '" & (field-assign-receiver-name rec) & "' cannot be observed: it names a definition, not a binding, so each mention builds a new '" & type-name & "' and this write is discarded. Bind the record with a let and thread it, or make the definition take the record as a parameter") s
     in let field-ty = when resolved
      is RecordTy (rname) (rargs) (rfields) -> lookup-record-field rfields (field.value)
      is ConstructedTy (cname) (cargs) ->
       let record-type = resolve-constructed-to-record env (cname.value)
     in when record-type
        is RecordTy (rname) (rargs) (rfields) ->
         let raw-ftype = lookup-record-field rfields (field.value)
     in apply-type-args-subst rargs cargs raw-ftype 0 (list-length rargs)
        is otherwise -> ErrorTy
      is otherwise -> ErrorTy
     in let st2 = when field-ty
      is ErrorTy -> if unit-recv then st-obs
       else add-unify-error st-obs cdx-unknown-record-field ("Record type has no field '" & field.value & "'") s
      is otherwise -> let (_, u-st) = unify st-obs (vr.inferred-type) field-ty s in u-st
     in let (amb, amb-st) = row-union st2 (rr.effect-row) (vr.effect-row)
     in CheckResult {
      inferred-type = rr.inferred-type,
      effect-row = amb,
      state = amb-st
     }
    is ALazyExpr (inner) (s) ->
     let ir = infer-expr-at st env inner (depth + 1)
     in let (thunk-row, thunk-st) = open-row-if-closed (ir.state) (ir.effect-row)
     in CheckResult {
      inferred-type = deck-record (FunTy int-ty-default thunk-row (ir.inferred-type)),
      effect-row = empty-row,
      state = thunk-st
     }
    is AErrorExpr (msg) (s) -> CheckResult {
     inferred-type = ErrorTy,
     effect-row = empty-row,
     state = st
    }
    is AInductionExpr (scrut) (arms) (s) -> CheckResult {
     inferred-type = ProofTy,
     effect-row = empty-row,
     state = __record-set st "bag" (bag-add (st.bag) (make-warning cdx-induction-unverified "induction proof accepted as an unproven axiom; structural subgoal checking did not apply (proof-system Stage 5)" s))
    }

  check-mutation-in-ctor-fields : UnificationState, List AFieldExpr, Integer, Integer -> UnificationState
  check-mutation-in-ctor-fields (st) (fields) (i) (len) =
   if i >= len then st
   else let f = list-at fields i
     in let st2 = if aexpr-mentions-record-set (f.value) then __record-set st "bag" (bag-add (st.bag) (make-warning cdx-mutation-in-constructor ("Field '" & f.name.value & "' contains __record-set, which mutates in place. Other fields reading the same record will see the mutated value. Bind the __record-set result to a let before the constructor, or use revised.") (f.span)))
       else st
     in check-mutation-in-ctor-fields st2 fields (i + 1) len

  aexpr-mentions-record-set : AExpr -> Boolean
  aexpr-mentions-record-set (e) =
   when e
    is ANameExpr (n) (s) -> n.value == "__record-set"
    is AApplyExpr (f) (a) (s) -> aexpr-mentions-record-set f | aexpr-mentions-record-set a
    is ABinaryExpr (l) (op) (r) (s) -> aexpr-mentions-record-set l | aexpr-mentions-record-set r
    is AIfExpr (c) (t) (el) (s) -> aexpr-mentions-record-set c | aexpr-mentions-record-set t | aexpr-mentions-record-set el
    is ALetExpr (binds) (body) (s) -> aexpr-mentions-record-set body | aexpr-list-mentions-record-set-binds binds 0 (list-length binds)
    is AMatchExpr (scrut) (arms) (s) -> aexpr-mentions-record-set scrut
    is AFieldAccess (obj) (f) (s) -> aexpr-mentions-record-set obj
    is otherwise -> False

  aexpr-list-mentions-record-set-binds : List ALetBind, Integer, Integer -> Boolean
  aexpr-list-mentions-record-set-binds (binds) (i) (len) =
   if i >= len then False
   else let b = list-at binds i
     in if aexpr-mentions-record-set (b.value) then True
     else aexpr-list-mentions-record-set-binds binds (i + 1) len

 The handler rule. Discharge is by the dotted
 sub-effect lattice, not by exact name: `with FileSystem` handles a
 body that performs FileSystem.Read and FileSystem.Write, because
 effect-covered-by is the same relation the def boundary already uses
 to accept those labels against a declared [FileSystem].

 So the FIRST question is what the body's CONCRETE labels say, not
 whether its row is open. An inferred row is almost always open -- it
 carries a fresh tail -- and the old rule asked about the tail first,
 unified against the extension {E | t'}, and thereby forced the bare
 label E into the row while every dotted member fell into t' and
 survived. `with Store` over a body performing Store.Read left
 Store.Read in the row and manufactured a Store nobody performed.
 That is why the tail is now the fallback and never the first question.

 If any concrete label is covered, drop every covered label and keep
 the tail as it was: the tail was never what carried them. For the
 exact case this is what the old unify already computed -- a row
 [Console] under `with Console` bound t' to the rest -- so handler-smoke
 is unchanged, and the dotted case stops being a no-op with a CDX2092.

 Only a body whose row is a BARE tail (no concrete label covered, tail
 open) still unifies: E can only have entered through the tail, and
 only unification can bind it. Family discharge through a tail is not
 attempted -- it would have to invent the member names.

 Clause bodies are inferred for their own
 ambient rows (a Console handler whose clause writes files yields
 FileSystem) and unioned into the result; clause VALUE typing stays
 with lowering, as before this stage.

  row-labels-covered : EffectRow, Text -> Boolean
  row-labels-covered (row) (name) =
   row-labels-covered-loop (row.labels) name 0 (list-length (row.labels))

  row-labels-covered-loop : List EffectLabel, Text, Integer, Integer -> Boolean
  row-labels-covered-loop (ls) (name) (i) (len) =
   if i == len then False
   else if effect-covered-by [Name { value = name }] (((list-at ls i).name).value) then True
   else row-labels-covered-loop ls name (i + 1) len

  row-drop-covered : EffectRow, Text -> EffectRow
  row-drop-covered (row) (name) =
   make-row (row-keep-uncovered (row.labels) name 0 (list-length (row.labels)) []) (row.tail-name) (row.tail-id)

  row-keep-uncovered : List EffectLabel, Text, Integer, Integer, List EffectLabel -> List EffectLabel
  row-keep-uncovered (ls) (name) (i) (len) (acc) =
   if i == len then acc
   else let l = list-at ls i
   in if effect-covered-by [Name { value = name }] ((l.name).value) then row-keep-uncovered ls name (i + 1) len acc
      else row-keep-uncovered ls name (i + 1) len (list-push acc l)

  infer-handle-clauses : UnificationState, TypeEnv, List AHandleClause, Integer, Integer, EffectRow, Integer -> (EffectRow, UnificationState)
  infer-handle-clauses (st) (env) (clauses) (i) (len) (acc-row) (depth) =
   if i == len then (acc-row, st)
   else let c = list-at clauses i
   in let pr = bind-lambda-params st env (c.params) 0 (list-length (c.params)) []
   in let (rs-ty, rs-st) = fresh-and-advance (pr.state)
   in let env3 = env-bind-local (pr.env) ((c.resume-name).value) rs-ty
   in let br = infer-expr-at rs-st env3 (c.body) (depth + 1)
   in let (acc2, acc-st) = row-union (br.state) acc-row (br.effect-row)
   in infer-handle-clauses acc-st env clauses (i + 1) len acc2 depth

 The flat-effect handler machinery (strip-effect-from-env's
 whole-environment rewrite, strip-handled-effect, filter-effect) is
 retired: discharge is the §7 row unification above, and effects no
 longer ride result types where stripping could reach them.

  resolve-constructed-to-record : TypeEnv, Text -> CodexType
  resolve-constructed-to-record (env) (name) =
   if env-has env name then strip-fun-args (env-lookup env name)
   else ErrorTy

  apply-type-args-subst : List CodexType, List CodexType, CodexType, Integer, Integer -> CodexType
  apply-type-args-subst (generic) (concrete-args) (ty) (i) (len) =
   if i == len then ty
   else if i >= list-length concrete-args then ty
   else let g = list-at generic i
   in when g
    is TypeVar (id) -> apply-type-args-subst generic concrete-args (subst-type-var ty id (list-at concrete-args i)) (i + 1) len
    is otherwise -> apply-type-args-subst generic concrete-args ty (i + 1) len

  infer-record-fields : UnificationState, TypeEnv, List AFieldExpr, Integer, Integer, Integer -> UnificationState
  infer-record-fields (st) (env) (fields) (i) (len) (depth) =
   if i == len then st
   else let f = list-at fields i
   in let r = infer-expr-at st env (f.value) (depth + 1)
   in infer-record-fields (r.state) env fields (i + 1) len depth

 A record literal names every field of its type, and no other. Neither
 was checked until 2026-07-14, and both silences were dangerous in the
 same way: the emitter writes the fields it was given and leaves the
 rest of the record as __alloc left it, which is zero.

 A field left OUT came back as zero. That is a plausible value for an
 integer, an empty list and a null pointer alike, so it does not look
 like a mistake anywhere downstream. It cost a real memory-corruption
 bug: net-io-send-chunk (NetIO.codex) rebuilt a TcpTransportState
 naming four of its seven fields, so every send zeroed recv-base -- a
 raw heap address -- and the next inbound frame wrote the bytes off the
 wire to physical address 0, over the IDT and the kernel metadata
 cells. Nothing complained, at any severity, for months.

 A field MISSPELLED was dropped on the floor: it matched no field of
 the type, so nothing was written, and the field the author meant to
 set kept its zero. CDX2005 already existed for exactly this mistake on
 a field ACCESS and a field ASSIGNMENT. The literal was the one place
 it was not raised.

  record-field-unknown : UnificationState, CodexType, Text, SourceSpan -> UnificationState
  record-field-unknown (st) (record-ty) (fname) (s) =
   when record-ty
    is RecordTy (rname) (rargs) (rfields) -> add-unify-error st cdx-unknown-record-field ("Record '" & rname.value & "' has no field '" & fname & "'") s
    is otherwise -> st

  check-record-complete : UnificationState, List AFieldExpr, CodexType, SourceSpan -> UnificationState
  check-record-complete (st) (given) (record-ty) (s) =
   when record-ty
    is RecordTy (rname) (rargs) (rfields) -> check-record-missing st (rname.value) rfields given 0 (list-length rfields) s
    is otherwise -> st

  check-record-missing : UnificationState, Text, List RecordField, List AFieldExpr, Integer, Integer, SourceSpan -> UnificationState
  check-record-missing (st) (tname) (rfields) (given) (i) (len) (s) =
   if i == len then st
   else let rf = list-at rfields i
   in let st2 = if given-names-field given (rf.name.value) 0 (list-length given) then st
      else add-unify-error st cdx-missing-record-field ("Record '" & tname & "' is built without a value for field '" & (rf.name.value) & "'. A field left out of a literal is not left alone -- it is zero.") s
   in check-record-missing st2 tname rfields given (i + 1) len s

  given-names-field : List AFieldExpr, Text, Integer, Integer -> Boolean
  given-names-field (given) (n) (i) (len) =
   if i == len then False
   else if ((list-at given i).name).value == n then True
   else given-names-field given n (i + 1) len

  infer-and-unify-record-fields : UnificationState, TypeEnv, List AFieldExpr, CodexType, Integer, Integer, EffectRow, Integer -> (EffectRow, UnificationState)
  infer-and-unify-record-fields (st) (env) (fields) (record-ty) (i) (len) (acc-row) (depth) =
   if i == len then (acc-row, st)
   else let f = list-at fields i
   in let r = infer-expr-at st env (f.value) (depth + 1)
   in let expected = when record-ty
       is RecordTy (rname) (rargs) (rfields) -> lookup-record-field rfields (f.name.value)
       is otherwise -> ErrorTy
   in let st2 = when expected
       is ErrorTy -> record-field-unknown (r.state) record-ty (f.name.value) (aexpr-span (f.value))
       is otherwise -> let (_, u-st) = unify (r.state) (r.inferred-type) expected (aexpr-span (f.value)) in u-st
   in let st3 = lint-narrowing-check st2 env (f.value) (r.inferred-type) expected (aexpr-span (f.value)) ("field '" & (f.name.value) & "'")
   in let (acc2, acc-st) = row-union st3 acc-row (r.effect-row)
   in infer-and-unify-record-fields acc-st env fields record-ty (i + 1) len acc2 depth

