Chapter: Name

 A wrapper for identifier names.

Section: Types
  Name = record {
   value : Text
  }

Section: Functions
  make-name : Text -> Name
  make-name (s) =
   Name { value = s }

  name-value : Name -> Text
  name-value (n) =
   n.value

Section: Entry Point
  opening-entry-point : Text = "opening"

Page 1

