Chapter: Diagnostics

Section: Type
  Diagnostic = record {
   code : Integer between 0 and 65535,
   message : Text,
   severity : Integer between 0 and 4,
   span : SourceSpan,
   related-spans : List SourceSpan
  }

Section: Constructors

 The `message` field is passed through `substring` so its bytes are
 freshly allocated inside the surrounding `deck-record` region. Many
 emit-time call sites build the message with `&` in a per-function
 bivy that is reclaimed by `__heap-restore` before the bag is merged;
 storing the bivy pointer would leave a dangling Text behind.

  make-diagnostic : Integer between 0 and 4, Integer between 0 and 65535, Text, SourceSpan -> Diagnostic
  make-diagnostic (sev) (code) (msg) (span) =
   deck-record (Diagnostic {
    code = code,
    message = substring msg 0 (text-length msg),
    severity = sev,
    span = span,
    related-spans = []
   })

  make-error : Integer between 0 and 65535, Text, SourceSpan -> Diagnostic
  make-error (code) (msg) (span) = make-diagnostic sev-error code msg span

  make-warning : Integer between 0 and 65535, Text, SourceSpan -> Diagnostic
  make-warning (code) (msg) (span) = make-diagnostic sev-warning code msg span

  make-info : Integer between 0 and 65535, Text, SourceSpan -> Diagnostic
  make-info (code) (msg) (span) = make-diagnostic sev-info code msg span

  make-error-related : Integer between 0 and 65535, Text, SourceSpan, List SourceSpan -> Diagnostic
  make-error-related (code) (msg) (span) (related) =
   deck-record (Diagnostic {
    code = code,
    message = substring msg 0 (text-length msg),
    severity = sev-error,
    span = span,
    related-spans = related
   })

Section: Display
  format-cdx-code : Integer -> Text
  format-cdx-code (n) = "CDX" & integer-to-text-padded n 4

  diagnostic-display : Diagnostic, FileTable -> Text
  diagnostic-display (d) (table) =
   let loc = span-display (d.span) table
   in let prefix = if loc == "" then "" else loc & ": "
   in prefix & severity-label (d.severity) & " " & format-cdx-code (d.code) & ": " & d.message

