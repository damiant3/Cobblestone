Chapter: Parser

  cites Foreword chapter Maybe
  cites Foreword chapter Tuple

Section: Type Parsing
  is-forall-start : ParseState -> Boolean
  is-forall-start (st) =
   when (current-kind st)
    is ForAllKeyword -> True
    is Identifier ->
     if token-text (current st) == "for" then
      let idx = (st.pos) + 1
      in if idx >= list-length (st.tokens) then False
      else token-text (list-at (st.tokens) idx) == "all"
     else False
    is otherwise -> False

  parse-forall-type : ParseState -> ParseTypeResult
  parse-forall-type (st) =
   let qtok = current st
   in let st1 = when (current-kind st) is ForAllKeyword -> advance st is otherwise -> advance (advance st)
   in let st2 = expect LeftParen st1
   in let var-tok = current st2
   in let st3 = if is-ident (current-kind st2) then advance st2 else st2
   in let st4 = expect Colon st3
   in when (parse-type st4)
    is TypeOk (vty) (st5) ->
     let st6 = expect RightParen st5
     in let st7 = expect Comma st6
     in when (parse-type st7)
      is TypeOk (pty) (st8) ->
       TypeOk (deck-record (ForAllType var-tok vty pty)) st8

  parse-type : ParseState -> ParseTypeResult
  parse-type (st) =
   if parse-fuel-exhausted st then TypeOk (deck-record (NamedType (current st))) (emit-parse-fuel-error st "parse-type")
   else let st0 = consume-parse-fuel st
   in if is-forall-start st0 then parse-forall-type st0
   else when (current-kind st0)
    is LinearKeyword ->
     let atom-r = parse-type-atom (advance st0)
     in unwrap-type-ok atom-r parse-linear-after
    is MutableKeyword ->
     let atom-r = parse-type-atom (advance st0)
     in unwrap-type-ok atom-r parse-type-with-args
    is otherwise ->
     let atom-r = parse-type-atom st0
     in unwrap-type-ok atom-r parse-type-with-args

  parse-linear-after : TypeExpr, ParseState -> ParseTypeResult
  parse-linear-after (atom) (st) =
   let applied-r = parse-type-args atom st
   in unwrap-type-ok applied-r wrap-linear-continue

  wrap-linear-continue : TypeExpr, ParseState -> ParseTypeResult
  wrap-linear-continue (applied) (st) =
   parse-type-bound-or-continue (deck-record (LinearTypeExpr applied)) st

  parse-type-with-args : TypeExpr, ParseState -> ParseTypeResult
  parse-type-with-args (atom) (st) =
   let applied-r = parse-type-args atom st
   in unwrap-type-ok applied-r parse-type-bound-or-continue

  parse-type-bound-or-continue : TypeExpr, ParseState -> ParseTypeResult
  parse-type-bound-or-continue (left) (st) =
   if is-between-keyword (current-kind st) then parse-bound-between left (advance st)
   else unwrap-type-ok (parse-type-mul-tail left st) parse-type-add-tail

  is-type-mul-op : TokenKind -> Boolean
  is-type-mul-op (k) =
   when k
    is Star | Slash -> True
    is otherwise -> False

  is-type-add-op : TokenKind -> Boolean
  is-type-add-op (k) =
   when k
    is Plus | Minus -> True
    is otherwise -> False

  parse-type-arith-operand : ParseState -> ParseTypeResult
  parse-type-arith-operand (st) =
   let atom-r = parse-type-atom st
   in unwrap-type-ok atom-r parse-type-args

  parse-type-mul-tail : TypeExpr, ParseState -> ParseTypeResult
  parse-type-mul-tail (left) (st) =
   if parse-fuel-exhausted st then TypeOk left (emit-parse-fuel-error st "parse-type-mul-tail")
   else let st-fueled = consume-parse-fuel st
   in if is-type-mul-op (current-kind st-fueled)
    then let op-tok = current st-fueled
     in unwrap-type-ok (parse-type-arith-operand (advance st-fueled)) (make-type-arith-mul left op-tok)
    else TypeOk left st-fueled

  make-type-arith-mul : TypeExpr, Token, TypeExpr, ParseState -> ParseTypeResult
  make-type-arith-mul (left) (op-tok) (right) (st) =
   parse-type-mul-tail (deck-record (AppType (deck-record (NamedType op-tok)) [left, right])) st

  parse-type-add-tail : TypeExpr, ParseState -> ParseTypeResult
  parse-type-add-tail (left) (st) =
   unwrap-type-ok (parse-type-add-loop left st) parse-type-append-tail

  parse-type-add-loop : TypeExpr, ParseState -> ParseTypeResult
  parse-type-add-loop (left) (st) =
   if parse-fuel-exhausted st then TypeOk left (emit-parse-fuel-error st "parse-type-add-tail")
   else let st-fueled = consume-parse-fuel st
   in if is-type-add-op (current-kind st-fueled)
    then let op-tok = current st-fueled
     in unwrap-type-ok (parse-type-add-operand (advance st-fueled)) (make-type-arith-add left op-tok)
    else TypeOk left st-fueled

  parse-type-add-operand : ParseState -> ParseTypeResult
  parse-type-add-operand (st) =
   unwrap-type-ok (parse-type-arith-operand st) parse-type-mul-tail

  make-type-arith-add : TypeExpr, Token, TypeExpr, ParseState -> ParseTypeResult
  make-type-arith-add (left) (op-tok) (right) (st) =
   parse-type-add-loop (deck-record (AppType (deck-record (NamedType op-tok)) [left, right])) st

  parse-type-append-tail : TypeExpr, ParseState -> ParseTypeResult
  parse-type-append-tail (left) (st) =
   if parse-fuel-exhausted st then TypeOk left (emit-parse-fuel-error st "parse-type-append-tail")
   else let st-fueled = consume-parse-fuel st
   in if current-kind st-fueled == Ampersand
    then let op-tok = current st-fueled
     in unwrap-type-ok (parse-type-append-operand (advance st-fueled)) (make-type-append left op-tok)
    else parse-type-continue left st-fueled

  parse-type-append-operand : ParseState -> ParseTypeResult
  parse-type-append-operand (st) =
   unwrap-type-ok (unwrap-type-ok (parse-type-arith-operand st) parse-type-mul-tail) parse-type-add-loop

  make-type-append : TypeExpr, Token, TypeExpr, ParseState -> ParseTypeResult
  make-type-append (left) (op-tok) (right) (st) =
   parse-type-append-tail (deck-record (AppType (deck-record (NamedType op-tok)) [left, right])) st

  parse-bound-int : ParseState -> (Integer, ParseState)
  parse-bound-int (st) =
   if is-minus (current-kind st) then
    let st1 = advance st
    in if is-literal (current-kind st1) then (-(lit-text-to-integer (token-text (current st1))), advance st1)
    else (0, report-bound-int-error st1)
   else if is-literal (current-kind st) then (lit-text-to-integer (token-text (current st)), advance st)
   else (0, report-bound-int-error st)

  report-bound-int-error : ParseState -> ParseState
  report-bound-int-error (st) =
   let tok = current st
   in __record-set st "bag" (bag-add (st.bag) (make-error cdx-expected-token-kind ("expected integer literal in bound annotation, got '" & (token-text tok) & "'") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))

  parse-bound-between : TypeExpr, ParseState -> ParseTypeResult
  parse-bound-between (base) (st) =
   let (lo, st-lo) = parse-bound-int st
   in let st-and = expect-and-keyword st-lo
   in let (hi, st-hi) = parse-bound-int st-and
   in let mode-tok = current st-hi
   in let (mode, st-mode) = parse-overflow-mode st-hi
   in let st-mode-ok = check-wrapping-band lo hi mode mode-tok st-mode
   in parse-type-continue (deck-record (BoundedIntType base lo hi mode)) st-mode-ok

  check-wrapping-band : Integer, Integer, OverflowMode, Token, ParseState -> ParseState
  check-wrapping-band (lo) (hi) (mode) (tok) (st) =
   when mode
    is OvWrapping ->
     if bounds-are-hw-width lo hi then st
     else __record-set st "bag" (bag-add (st.bag) (make-error cdx-wrapping-band-not-hw-width ("a wrapping band must be exactly its hardware width, and " & show lo & " to " & show hi & " is not: the store wraps at the width, so the field can hold a value outside the declared range while the bounds prover still trusts that range. Widen the band to the whole width, or use clamping or error") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))
    is otherwise -> st

 `and` USED TO BE AN ORDINARY IDENTIFIER matched by text in this one position,
 which is why a bound annotation could spell its separator without spending a
 keyword. It became a keyword on 2026-08-19 (boolean `and`), so the token KIND
 is what to look for now; the old text test stays behind it because it costs
 one comparison and it is the only thing that would have caught this.

  expect-and-keyword : ParseState -> ParseState
  expect-and-keyword (st) =
   if current-kind st == AndKeyword then advance st
   else if is-ident (current-kind st) & token-text (current st) == "and"
   then advance st
   else let tok = current st
        in __record-set st "bag" (bag-add (st.bag) (make-error cdx-expected-token-kind ("expected 'and' in bound annotation, got '" & (token-text tok) & "'") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))

  parse-overflow-mode : ParseState -> (OverflowMode, ParseState)
  parse-overflow-mode (st) =
   if is-ident (current-kind st) then
    let txt = token-text (current st)
    in if txt == "wrapping" then (deck-record OvWrapping, advance st)
       else if txt == "clamping" then (deck-record OvClamping, advance st)
       else if txt == "error" then (deck-record OvError, advance st)
       else (deck-record OvError, st)
   else (deck-record OvError, st)

  parse-type-continue : TypeExpr, ParseState -> ParseTypeResult
  parse-type-continue (left) (st) =
   if parse-fuel-exhausted st then TypeOk left (emit-parse-fuel-error st "parse-type-continue")
   else let st-fueled = consume-parse-fuel st
   in if is-arrow (current-kind st-fueled) then let arrow-span = token-to-span (current st-fueled)
     in let st2 = advance st-fueled
     in let right-result = parse-type st2
     in unwrap-type-ok right-result (make-fun-type-arrow left arrow-span)
    else if is-fat-arrow (current-kind st-fueled) then let st2 = advance st-fueled
     in let right-result = parse-type st2
     in unwrap-type-ok right-result (make-constrained-type left)
    else if current-kind st-fueled == TripleEquals then let eq-span = token-to-span (current st-fueled)
     in let st2 = advance st-fueled
     in let right-result = parse-type st2
     in unwrap-type-ok right-result (make-prop-eq-type left eq-span)
    else if is-comma (current-kind st-fueled) then if comma-starts-type-param st-fueled
     then let st2 = skip-newlines (advance st-fueled)
       in let right-result = parse-type st2
       in unwrap-type-ok right-result (make-fun-type left)
     else TypeOk left st-fueled
    else TypeOk left st-fueled

  comma-starts-type-param : ParseState -> Boolean
  comma-starts-type-param (st) =
   let next = peek-kind st 1
   in if is-type-ident next then True
      else if is-left-bracket next then True
      else if is-left-paren next then True
      else if is-ident next then if is-colon (peek-kind st 2) then False else True
      else False

  make-fun-type : TypeExpr, TypeExpr, ParseState -> ParseTypeResult
  make-fun-type (left) (right) (st) =
   TypeOk (deck-record (FunType left right)) st

  make-prop-eq-type : TypeExpr, SourceSpan, TypeExpr, ParseState -> ParseTypeResult
  make-prop-eq-type (left) (span) (right) (st) =
   TypeOk (deck-record (PropEqType left right span)) st

  make-constrained-type : TypeExpr, TypeExpr, ParseState -> ParseTypeResult
  make-constrained-type (constraint) (body) (st) =
   TypeOk (deck-record (ConstrainedType constraint body)) st

  make-fun-type-arrow : TypeExpr, SourceSpan, TypeExpr, ParseState -> ParseTypeResult
  make-fun-type-arrow (left) (arrow-span) (right) (st) =
   let st2 = when right
    is FunType (p) (r) -> __record-set st "bag" (bag-add (st.bag) (make-error cdx-chained-arrow-type "Chained '->' in a type is not allowed; use commas for multiple parameters: 'A, B -> C' not 'A -> B -> C'" arrow-span))
    is otherwise -> st
   in TypeOk (deck-record (FunType left right)) st2

  unwrap-type-ok : ParseTypeResult, (TypeExpr, ParseState -> ParseTypeResult) -> ParseTypeResult
  unwrap-type-ok (r) (f) =
   when r
    is TypeOk (t) (st) -> f t st

  parse-type-atom : ParseState -> ParseTypeResult
  parse-type-atom (st) =
   if is-ident (current-kind st) then let tok = current st
   in TypeOk (deck-record (NamedType tok)) (advance st)
   else if is-type-ident (current-kind st) then let tok = current st
   in TypeOk (deck-record (NamedType tok)) (advance st)
   else if is-left-paren (current-kind st) then parse-paren-type (advance st)
   else if is-left-bracket (current-kind st) then parse-effect-type (advance st)
   else if is-signed-literal-atom st then parse-signed-literal-atom st
   else let tok = current st
   in TypeOk (deck-record (NamedType tok)) (advance st)

 Adjacency is what separates this from binary subtraction, and it has
 to be adjacency in the SOURCE rather than token order: `1 - 3` and
 `-2` produce the same two token kinds. The digits must begin at the
 byte immediately after the minus. That also makes the synthesized
 token honest -- its text is read straight out of the source across
 both tokens, so `token-text` answers "-2" without anything being
 fabricated.

  is-signed-literal-atom : ParseState -> Boolean
  is-signed-literal-atom (st) =
   if current-kind st == Minus then
    let nxt = peek-kind st 1
    in if nxt == IntegerLiteral | nxt == NumberLiteral
       then (list-at (st.tokens) (st.pos + 1)).offset == (current st).offset + 1
       else False
   else False

  parse-signed-literal-atom : ParseState -> ParseTypeResult
  parse-signed-literal-atom (st) =
   let minus-tok = current st
   in let num-tok = list-at (st.tokens) (st.pos + 1)
   in let signed = deck-record (Token {
    kind = num-tok.kind,
    source = minus-tok.source,
    offset = minus-tok.offset,
    length = (num-tok.offset + num-tok.length) - minus-tok.offset,
    line = minus-tok.line,
    column = minus-tok.column,
    file-id = minus-tok.file-id
   })
   in TypeOk (deck-record (NamedType signed)) (advance (advance st))

  parse-paren-type : ParseState -> ParseTypeResult
  parse-paren-type (st) =
   if classify-paren-type st 0 False False == 2 then parse-tuple-type st
   else let inner = parse-type st
   in unwrap-type-ok inner finish-paren-type

  classify-paren-type : ParseState, Integer, Boolean, Boolean -> Integer
  classify-paren-type (st) (depth) (saw-arrow) (saw-comma) =
   if is-done st then classify-paren-result saw-arrow saw-comma
   else let k = current-kind st
   in if is-left-paren k then classify-paren-type (advance st) (depth + 1) saw-arrow saw-comma
    else if is-left-bracket k then classify-paren-type (advance st) (depth + 1) saw-arrow saw-comma
    else if is-right-paren k then if depth == 0 then classify-paren-result saw-arrow saw-comma
       else classify-paren-type (advance st) (depth - 1) saw-arrow saw-comma
    else if is-right-bracket k then classify-paren-type (advance st) (depth - 1) saw-arrow saw-comma
    else if depth == 0 then if is-arrow k then classify-paren-type (advance st) depth True saw-comma
       else if is-comma k then classify-paren-type (advance st) depth saw-arrow True
       else classify-paren-type (advance st) depth saw-arrow saw-comma
    else classify-paren-type (advance st) depth saw-arrow saw-comma

  classify-paren-result : Boolean, Boolean -> Integer
  classify-paren-result (saw-arrow) (saw-comma) =
   if saw-arrow then 1 else if saw-comma then 2 else 0

  parse-tuple-type : ParseState -> ParseTypeResult
  parse-tuple-type (st) =
   let e = parse-tuple-type-elem st
   in unwrap-type-ok e tuple-type-after-first

  parse-tuple-type-elem : ParseState -> ParseTypeResult
  parse-tuple-type-elem (st) =
   if current-kind st == LinearKeyword then unwrap-type-ok (parse-tuple-type-elem (advance st)) wrap-linear-elem
   else let atom-r = parse-type-atom st
   in unwrap-type-ok atom-r parse-type-args

  wrap-linear-elem : TypeExpr, ParseState -> ParseTypeResult
  wrap-linear-elem (t) (st) = TypeOk (deck-record (LinearTypeExpr t)) st

  tuple-type-after-first : TypeExpr, ParseState -> ParseTypeResult
  tuple-type-after-first (first) (st) =
   if is-comma (current-kind st) then collect-tuple-type (__linked-list-push [] first) (advance st)
   else finish-paren-type first st

  collect-tuple-type : LinkedList TypeExpr, ParseState -> ParseTypeResult
  collect-tuple-type (acc) (st) =
   let e = parse-tuple-type-elem st
   in unwrap-type-ok e (after-tuple-type-elem acc)

  after-tuple-type-elem : LinkedList TypeExpr, TypeExpr, ParseState -> ParseTypeResult
  after-tuple-type-elem (acc) (e) (st) =
   let acc2 = __linked-list-push acc e
   in if is-comma (current-kind st) then collect-tuple-type acc2 (advance st)
   else let st2 = expect RightParen st
   in TypeOk (deck-record (TupleType (deck-record (__linked-list-to-list acc2)))) st2

  finish-paren-type : TypeExpr, ParseState -> ParseTypeResult
  finish-paren-type (t) (st) =
   let st2 = expect RightParen st
   in TypeOk (deck-record (ParenType t)) st2

  parse-effect-type : ParseState -> ParseTypeResult
  parse-effect-type (st) =
   let (eff-names, st-effs, eff-scopes, eff-tail) = parse-effect-names st [] [] []
   in let ret = parse-type st-effs
   in unwrap-type-ok ret (finish-effect-type eff-names eff-scopes eff-tail)

  finish-effect-type : List Token, List Token, List Token, TypeExpr, ParseState -> ParseTypeResult
  finish-effect-type (effs) (scopes) (tail) (ret) (st) =
   TypeOk (deck-record (EffectTypeExpr effs scopes tail ret)) st

  empty-scope-tok : Token = Token {
   kind = TextLiteral,
   source = "",
   offset = 0,
   length = 0,
   line = 0,
   column = 0,
   file-id = 0
  }

 Inside effect brackets the identifier case is load-bearing:
 a PascalCase identifier is a concrete
 effect name; a lowercase identifier is the row's tail variable. A
 row names at most one tail (CDX1120), and a tail is bare -- no scope
 literal, no dotted sub-effect (CDX1121).

  parse-effect-names : ParseState, List Token, List Token, List Token -> (List Token, ParseState, List Token, List Token)
  parse-effect-names (st) (acc) (sacc) (tacc) =
   if is-done st then (acc, st, sacc, tacc)
   else if is-right-bracket (current-kind st) then (acc, advance st, sacc, tacc)
   else if is-comma (current-kind st) then parse-effect-names (advance st) acc sacc tacc
   else if is-ident (current-kind st) then parse-row-tail st acc sacc tacc
   else if is-type-ident (current-kind st) then
    let tok = current st
    in let st2 = advance st
    in if is-dot (current-kind st2) then parse-dotted-effect st2 tok acc sacc tacc
       else parse-effect-with-scope st2 tok acc sacc tacc
   else parse-effect-names (advance st) acc sacc tacc

  parse-row-tail : ParseState, List Token, List Token, List Token -> (List Token, ParseState, List Token, List Token)
  parse-row-tail (st) (acc) (sacc) (tacc) =
   let tok = current st
   in let st2 = advance st
   in if is-dot (current-kind st2) then
       let st3 = __record-set st2 "bag" (bag-add (st2.bag) (make-error cdx-row-tail-decorated ("a row variable is a bare lowercase identifier; '" & token-text tok & "' cannot take a dotted sub-effect") (token-to-span tok)))
       in parse-dotted-effect st3 tok acc sacc tacc
      else if is-text-lit (current-kind st2) then
       let st3 = __record-set st2 "bag" (bag-add (st2.bag) (make-error cdx-row-tail-decorated ("a row variable is a bare lowercase identifier; '" & token-text tok & "' cannot take a scope literal") (token-to-span tok)))
       in parse-effect-names (advance st3) acc sacc (list-push tacc tok)
      else if list-length tacc > 0 then
       let st3 = __record-set st2 "bag" (bag-add (st2.bag) (make-error cdx-row-two-tails ("an effect row may name at most one row variable; found '" & token-text tok & "' after an earlier row variable") (token-to-span tok)))
       in parse-effect-names st3 acc sacc tacc
      else parse-effect-names st2 acc sacc (list-push tacc tok)

  parse-effect-with-scope : ParseState, Token, List Token, List Token, List Token -> (List Token, ParseState, List Token, List Token)
  parse-effect-with-scope (st) (name-tok) (acc) (sacc) (tacc) =
   if is-text-lit (current-kind st) then
    let scope-tok = current st
    in parse-effect-names (advance st) (list-push acc name-tok) (list-push sacc scope-tok) tacc
   else parse-effect-names st (list-push acc name-tok) (list-push sacc empty-scope-tok) tacc

  parse-dotted-effect : ParseState, Token, List Token, List Token, List Token -> (List Token, ParseState, List Token, List Token)
  parse-dotted-effect (st) (base-tok) (acc) (sacc) (tacc) =
   let st2 = advance st
   in if is-ident (current-kind st2) | is-type-ident (current-kind st2) then
    let sub = current st2
    in let combined = deck-record (Token {
     kind = Identifier,
     source = base-tok.source,
     offset = base-tok.offset,
     length = sub.offset + sub.length - base-tok.offset,
     line = base-tok.line,
     column = base-tok.column,
     file-id = base-tok.file-id
    })
    in parse-effect-with-scope (advance st2) combined acc sacc tacc
   else parse-effect-names st2 (list-push acc base-tok) (list-push sacc empty-scope-tok) tacc

  parse-type-args : TypeExpr, ParseState -> ParseTypeResult
  parse-type-args (base-type) (st) =
   if parse-fuel-exhausted st then TypeOk base-type (emit-parse-fuel-error st "parse-type-args")
   else let st-fueled = consume-parse-fuel st
   in if is-done st-fueled then TypeOk base-type st-fueled
   else if is-type-arg-start (current-kind st-fueled) then parse-type-arg-next base-type st-fueled
   else TypeOk base-type st-fueled

  parse-type-arg-next : TypeExpr, ParseState -> ParseTypeResult
  parse-type-arg-next (base-type) (st) =
   let arg-result = parse-type-atom st
   in unwrap-type-ok arg-result (continue-type-args base-type)

  continue-type-args : TypeExpr, TypeExpr, ParseState -> ParseTypeResult
  continue-type-args (base-type) (arg) (st) =
   parse-type-args (deck-record (AppType base-type [arg])) st

Section: Pattern Parsing
  parse-pattern : ParseState -> ParsePatResult
  parse-pattern (st) =
   if parse-fuel-exhausted st then PatOk (deck-record (WildPat (current st))) (emit-parse-fuel-error st "parse-pattern")
   else let st-fueled = consume-parse-fuel st
   in if is-wildcard-pat (current-kind st-fueled) then PatOk (deck-record (WildPat (current st-fueled))) (advance st-fueled)
   else if is-literal (current-kind st-fueled) then PatOk (deck-record (LitPat (current st-fueled))) (advance st-fueled)
   else if is-type-ident (current-kind st-fueled) then let tok = current st-fueled
       in parse-ctor-pattern-fields tok [] (advance st-fueled)
   else if is-ident (current-kind st-fueled) then PatOk (deck-record (VarPat (current st-fueled))) (advance st-fueled)
   else if is-keyword (current-kind st-fueled) then PatOk (deck-record (VarPat (current st-fueled))) (advance (report-reserved-keyword "a pattern variable" st-fueled))
   else if is-left-paren (current-kind st-fueled) then parse-tuple-pattern (advance st-fueled)
       else PatOk (deck-record (WildPat (current st-fueled))) (advance st-fueled)

  parse-tuple-pattern : ParseState -> ParsePatResult
  parse-tuple-pattern (st) =
   let p = parse-pattern st
   in unwrap-pat-ok p continue-tuple-pat

  continue-tuple-pat : Pat, ParseState -> ParsePatResult
  continue-tuple-pat (first) (st) =
   if is-comma (current-kind st) then collect-tuple-pat (__linked-list-push [] first) (advance st)
   else PatOk first (expect RightParen st)

  collect-tuple-pat : LinkedList Pat, ParseState -> ParsePatResult
  collect-tuple-pat (acc) (st) =
   let p = parse-pattern st
   in unwrap-pat-ok p (after-tuple-pat acc)

  after-tuple-pat : LinkedList Pat, Pat, ParseState -> ParsePatResult
  after-tuple-pat (acc) (p) (st) =
   let acc2 = __linked-list-push acc p
   in if is-comma (current-kind st) then collect-tuple-pat acc2 (advance st)
   else PatOk (deck-record (TuplePat (deck-record (__linked-list-to-list acc2)))) (expect RightParen st)

  parse-ctor-pattern-fields : Token, LinkedList Pat, ParseState -> ParsePatResult
  parse-ctor-pattern-fields (ctor) (acc) (st) =
   if parse-fuel-exhausted st then PatOk (deck-record (CtorPat ctor (deck-record (__linked-list-to-list acc)))) (emit-parse-fuel-error st "parse-ctor-pattern-fields")
   else let st-fueled = consume-parse-fuel st
   in if token-text ctor == "Vector" & is-left-bracket (current-kind st-fueled) then parse-vec-pat-elems [] (advance st-fueled)
    else if is-left-paren (current-kind st-fueled) then let st2 = advance st-fueled
     in let sub = parse-pattern st2
     in unwrap-pat-ok sub (continue-ctor-fields ctor acc)
    else PatOk (deck-record (CtorPat ctor (deck-record (__linked-list-to-list acc)))) st-fueled

  continue-ctor-fields : Token, LinkedList Pat, Pat, ParseState -> ParsePatResult
  continue-ctor-fields (ctor) (acc) (p) (st) =
   let st2 = expect RightParen st
   in parse-ctor-pattern-fields ctor (__linked-list-push acc p) st2

  parse-vec-pat-elems : List Pat, ParseState -> ParsePatResult
  parse-vec-pat-elems (acc) (st) =
   if is-right-bracket (current-kind st) then PatOk (deck-record (VecPat acc)) (advance st)
   else let p = parse-pattern st
   in unwrap-pat-ok p (after-vec-pat-elem acc)

  after-vec-pat-elem : List Pat, Pat, ParseState -> ParsePatResult
  after-vec-pat-elem (acc) (p) (st) =
   let acc2 = list-push acc p
   in if is-comma (current-kind st) then parse-vec-pat-elems acc2 (advance st)
   else PatOk (deck-record (VecPat acc2)) (expect RightBracket st)

  unwrap-pat-ok : ParsePatResult, (Pat, ParseState -> ParsePatResult) -> ParsePatResult
  unwrap-pat-ok (r) (f) =
   when r
    is PatOk (p) (st) -> f p st

Section: Definition Parsing
  parse-type-annotation : ParseState -> ParseTypeResult
  parse-type-annotation (st) =
   let st2 = advance st
   in let st3 = expect Colon st2
   in parse-type st3

  parse-definition : ParseState -> ParseDefResult
  parse-definition (st) =
   if is-done st then ParseDefResult { maybe-def = None, state = st }
   else if is-claim-keyword (current-kind st) then skip-claim-def st
   else if is-proof-keyword (current-kind st) then parse-definition (advance st)
   else if is-ident (current-kind st) then try-parse-def st
   else if is-type-ident (current-kind st) then try-parse-def st
     else ParseDefResult { maybe-def = None, state = st }

  is-simple-claim : ParseState -> Boolean
  is-simple-claim (st) =
   if is-ident (peek-kind st 1) then is-colon (peek-kind st 2)
   else False

  parse-claim-annotation : ParseState -> AnnotationNode
  parse-claim-annotation (st) =
   let st1 = advance st
   in if is-ident (current-kind st1) then
    let name = token-text (current st1)
    in let prop = collect-claim-prop (advance st1) ""
    in deck-record (AnnotationNode { kind = "claim", target = name, body = prop })
   else deck-record (AnnotationNode { kind = "claim", target = "", body = "" })

  collect-claim-prop : ParseState, Text -> Text
  collect-claim-prop (st) (acc) =
   if is-done st then acc
   else when current-kind st
    is Newline -> acc
    is otherwise -> collect-claim-prop (advance st) (acc & " " & token-text (current st))

  skip-claim-def : ParseState -> ParseDefResult
  skip-claim-def (st) =
   let col = (current st).column
   in let st2 = advance st
   in let st3 = skip-claim-tokens st2 col
   in parse-definition st3

  skip-claim-tokens : ParseState, Integer -> ParseState
  skip-claim-tokens (st) (col) =
   if is-done st then st
   else if (current st).column <= col & is-claim-or-def-start (current-kind st) then st
   else skip-claim-tokens (advance st) col

  is-claim-or-def-start : TokenKind -> Boolean
  is-claim-or-def-start (k) =
   when k
    is Identifier | TypeIdentifier | ClaimKeyword | ProofKeyword -> True
    is otherwise -> False

  try-parse-def : ParseState -> ParseDefResult
  try-parse-def (st) =
   if is-colon (peek-kind st 1) then let first-name = current st
     in let ann-result = parse-type-annotation st
     in unwrap-type-for-def first-name ann-result
    else parse-def-body-with-ann [] st

  unwrap-type-for-def : Token, ParseTypeResult -> ParseDefResult
  unwrap-type-for-def (first-name) (r) =
   when r
    is TypeOk (ann-type) (st) ->
     if is-equals (current-kind st) then
      let ann = deck-record ([deck-record (TypeAnn {
       name = first-name,
       type-expr = ann-type
      })])
      in let st2 = advance st
      in let st3 = skip-newlines st2
      in let body-result = parse-def-body-seq st3 (first-name.column)
      in unwrap-def-body body-result ann first-name []
     else
      let name-tok = deck-record (Token {
       kind = Identifier,
       source = "",
       offset = 0,
       length = 0,
       line = 0,
       column = 0,
       file-id = 0
      })
      in let ann = deck-record ([deck-record (TypeAnn {
       name = name-tok,
       type-expr = ann-type
      })])
      in let st2 = skip-newlines st
      in parse-def-body-with-ann ann st2

  parse-def-body-with-ann : List TypeAnn, ParseState -> ParseDefResult
  parse-def-body-with-ann (ann) (st) =
   let st-skip = if is-proof-keyword (current-kind st) then advance st else st
   in let name-tok = current st-skip
   in let st2 = advance st-skip
   in parse-def-params-then ann name-tok [] st2

  parse-def-params-then : List TypeAnn, Token, LinkedList Token, ParseState -> ParseDefResult
  parse-def-params-then (ann) (name-tok) (acc) (st) =
   if is-left-paren (current-kind st) then parse-def-params-after-lparen ann name-tok acc (advance st)
   else finish-def ann name-tok (deck-record (__linked-list-to-list acc)) st

  parse-def-params-after-lparen : List TypeAnn, Token, LinkedList Token, ParseState -> ParseDefResult
  parse-def-params-after-lparen (ann) (name-tok) (acc) (st) =
   if is-ident (current-kind st) then let param = current st
     in let st2 = expect RightParen (advance st)
     in parse-def-params-then ann name-tok (__linked-list-push acc param) st2
    else if is-reserved-keyword (current-kind st) then
     let st2 = report-reserved-keyword "a parameter name" st
     in let st3 = expect RightParen (advance st2)
     in parse-def-params-then ann name-tok acc st3
      else finish-def ann name-tok (deck-record (__linked-list-to-list acc)) st

  finish-def : List TypeAnn, Token, List Token, ParseState -> ParseDefResult
  finish-def (ann) (name-tok) (params) (st) =
   if is-equals (current-kind st) then
    let st2 = advance st
    in let st3 = skip-newlines st2
    in let body-result = parse-def-body-seq st3 (name-tok.column)
    in unwrap-def-body body-result ann name-tok params
   else let tok = current st
    in let err-st = expect Equals st
    in let st2 = skip-body-tokens err-st (name-tok.column)
    in ParseDefResult {
     maybe-def = Just (deck-record (Def {
      name = name-tok,
      params = params,
      ann = ann,
      body = ErrExpr tok,
      chapter-slug = ""
     })),
     state = st2
    }

  unwrap-def-body : ParseExprResult, List TypeAnn, Token, List Token -> ParseDefResult
  unwrap-def-body (r) (ann) (name-tok) (params) =
   when r
    is ExprOk (b) (st) ->
     ParseDefResult {
      maybe-def = Just (deck-record (Def {
       name = name-tok,
       params = params,
       ann = ann,
       body = b,
       chapter-slug = ""
      })),
      state = st
     }

Section: Type Definition Parsing
  is-paren-type-param : ParseState -> Boolean
  is-paren-type-param (st) =
   if is-left-paren (current-kind st) then let k1 = peek-kind st 1
   in if is-ident k1 then is-right-paren (peek-kind st 2)
      else if is-type-ident k1 then is-right-paren (peek-kind st 2)
      else False
    else False

  is-type-param-pattern : ParseState -> Boolean
  is-type-param-pattern (st) =
   if is-paren-type-param st then True
   else is-ident (current-kind st)

  parse-type-params : ParseState, LinkedList Token -> ParseState
  parse-type-params (st) (acc) =
   if is-paren-type-param st then parse-type-params (advance (advance (advance st))) (__linked-list-push acc (list-at (st.tokens) (st.pos + 1)))
   else if is-ident (current-kind st) then parse-type-params (advance st) (__linked-list-push acc (current st))
   else st

  parse-unit-family : Token, List Token, ParseState -> ParseTypeDefResult
  parse-unit-family (name-tok) (tparams) (st) =
   let base-tok = current st
   in let st2 = skip-newlines (advance st)
   in let (members, st3) = parse-family-members st2 []
   in ParseTypeDefResult {
    maybe-type-def = Just (deck-record (TypeDef {
     name = name-tok,
     type-params = tparams,
     body = UnitFamilyBody base-tok members,
     is-mutable = False,
     deriving = []
    })),
    state = st3
   }

  parse-family-members : ParseState, LinkedList UnitFamilyMember -> (List UnitFamilyMember, ParseState)
  parse-family-members (st) (acc) =
   if is-done st then (deck-record (__linked-list-to-list acc), st)
   else if is-type-ident (current-kind st) then let mem-tok = current st
     in let st2 = advance st
     in if is-equals (current-kind st2) then let st3 = advance st2
       in if current-kind st3 == IntegerLiteral then let factor = lit-text-to-integer (token-text (current st3))
         in let member = deck-record (UnitFamilyMember { member-name = mem-tok, factor = factor })
         in parse-family-members (skip-newlines (advance st3)) (__linked-list-push acc member)
       else (deck-record (__linked-list-to-list acc), st)
     else (deck-record (__linked-list-to-list acc), st)
   else (deck-record (__linked-list-to-list acc), st)

  collect-type-params : ParseState, LinkedList Token -> List Token
  collect-type-params (st) (acc) =
   if is-paren-type-param st then collect-type-params (advance (advance (advance st))) (__linked-list-push acc (list-at (st.tokens) (st.pos + 1)))
   else if is-ident (current-kind st) then collect-type-params (advance st) (__linked-list-push acc (current st))
   else deck-record (__linked-list-to-list acc)

  parse-type-def : ParseState -> ParseTypeDefResult
  parse-type-def (st) =
   if is-mutable-keyword (current-kind st) then let st0 = advance st
     in parse-type-def-inner True st0
   else parse-type-def-inner False st

  parse-type-def-inner : Boolean, ParseState -> ParseTypeDefResult
  parse-type-def-inner (is-mut) (st) =
   if is-type-ident (current-kind st) then let name-tok = current st
     in let st2 = advance st
     in let tparams = collect-type-params st2 []
     in let st3 = parse-type-params st2 []
     in if is-equals (current-kind st3) then let st4 = skip-newlines (advance st3)
     in if is-unit-keyword (current-kind st4) then let st-after-unit = advance st4
            in if is-ident (current-kind st-after-unit) & token-text (current st-after-unit) == "family" then parse-unit-family name-tok tparams (advance st-after-unit)
            else when parse-type st-after-unit
            is TypeOk (base-te) (st5) -> ParseTypeDefResult {
             maybe-type-def = Just (deck-record (TypeDef {
              name = name-tok,
              type-params = tparams,
              body = UnitBody base-te,
              is-mutable = False,
              deriving = []
             })),
             state = st5
            }
            else if is-record-keyword (current-kind st4) then attach-deriving (parse-record-type name-tok tparams is-mut st4)
            else if is-pipe (current-kind st4) then attach-deriving (parse-variant-type name-tok tparams st4)
            else if is-type-ident (current-kind st4) & looks-like-variant st4 then attach-deriving (parse-variant-type name-tok tparams st4)
            else ParseTypeDefResult { maybe-type-def = None, state = st }
         else ParseTypeDefResult { maybe-type-def = None, state = st }
    else ParseTypeDefResult { maybe-type-def = None, state = st }

  is-deriving-kw : ParseState -> Boolean
  is-deriving-kw (st) =
   if is-ident (current-kind st) then token-text (current st) == "deriving"
   else False

  parse-deriving-names : ParseState, LinkedList Token -> (List Token, ParseState)
  parse-deriving-names (st) (acc) =
   if is-type-ident (current-kind st) then let acc2 = __linked-list-push acc (current st)
     in let st2 = advance st
     in if is-comma (current-kind st2) then parse-deriving-names (skip-newlines (advance st2)) acc2
        else (deck-record (__linked-list-to-list acc2), st2)
   else (deck-record (__linked-list-to-list acc), st)

  attach-deriving : ParseTypeDefResult -> ParseTypeDefResult
  attach-deriving (r) =
   when (r.maybe-type-def)
    is None -> r
    is Just (td) ->
     let st1 = skip-newlines (r.state)
     in if is-deriving-kw st1 then let (deriv-names, st-deriv) = parse-deriving-names (skip-newlines (advance st1)) []
          in ParseTypeDefResult { maybe-type-def = Just (deck-record (__record-set td "deriving" deriv-names)), state = st-deriv }
        else r

  parse-record-type : Token, List Token, Boolean, ParseState -> ParseTypeDefResult
  parse-record-type (name-tok) (tparams) (is-mut) (st) =
   let st2 = advance st
   in let st3 = expect LeftBrace st2
   in let st4 = skip-newlines st3
   in parse-record-fields-loop name-tok tparams is-mut [] st4

  parse-record-fields-loop : Token, List Token, Boolean, LinkedList RecordFieldDef, ParseState -> ParseTypeDefResult
  parse-record-fields-loop (name-tok) (tparams) (is-mut) (acc) (st) =
   if is-right-brace (current-kind st) then ParseTypeDefResult {
    maybe-type-def = Just (deck-record (TypeDef {
     name = name-tok,
     type-params = tparams,
     body = RecordBody (deck-record (__linked-list-to-list acc)),
     is-mutable = is-mut,
     deriving = []
    })),
    state = advance st
   }
   else if is-field-name-token (current-kind st) then parse-one-record-field name-tok tparams is-mut acc st
   else ParseTypeDefResult {
    maybe-type-def = Just (deck-record (TypeDef {
     name = name-tok,
     type-params = tparams,
     body = RecordBody (deck-record (__linked-list-to-list acc)),
     is-mutable = is-mut,
     deriving = []
    })),
    state = st
   }

  parse-one-record-field : Token, List Token, Boolean, LinkedList RecordFieldDef, ParseState -> ParseTypeDefResult
  parse-one-record-field (name-tok) (tparams) (is-mut) (acc) (st) =
   let field-name = current st
   in let st2 = advance st
   in let st3 = expect Colon st2
   in let field-type-result = parse-type st3
   in unwrap-record-field-type name-tok tparams is-mut acc field-name field-type-result

  unwrap-record-field-type : Token, List Token, Boolean, LinkedList RecordFieldDef, Token, ParseTypeResult -> ParseTypeDefResult
  unwrap-record-field-type (name-tok) (tparams) (is-mut) (acc) (field-name) (r) =
   when r
    is TypeOk (ft) (st) ->
     let field = deck-record (RecordFieldDef {
      name = field-name,
      type-expr = ft
     })
     in let st2 = skip-newlines st
     in if is-comma (current-kind st2) then parse-record-fields-loop name-tok tparams is-mut (__linked-list-push acc field) (skip-newlines (advance st2))
         else parse-record-fields-loop name-tok tparams is-mut (__linked-list-push acc field) st2

  looks-like-variant : ParseState -> Boolean
  looks-like-variant (st) =
   looks-like-variant-scan (st.tokens) (st.pos + 1) (list-length (st.tokens))

  looks-like-variant-scan : List Token, Integer, Integer -> Boolean
  looks-like-variant-scan (tokens) (i) (len) =
   if i >= len then False
   else let k = (list-at tokens i).kind
   in if is-pipe k then True
      else when k
      is Newline | EndOfFile -> False
      is otherwise -> looks-like-variant-scan tokens (i + 1) len

  parse-variant-type : Token, List Token, ParseState -> ParseTypeDefResult
  parse-variant-type (name-tok) (tparams) (st) =
   if is-type-ident (current-kind st) then let ctor-name = current st
     in let st2 = advance st
     in parse-ctor-fields ctor-name [] st2 name-tok tparams []
    else parse-variant-ctors name-tok tparams [] st

  parse-variant-ctors : Token, List Token, LinkedList VariantCtorDef, ParseState -> ParseTypeDefResult
  parse-variant-ctors (name-tok) (tparams) (acc) (st) =
   if is-pipe (current-kind st) then let st2 = skip-newlines (advance st)
     in let ctor-name = current st2
     in let st3 = advance st2
     in parse-ctor-fields ctor-name [] st3 name-tok tparams acc
    else ParseTypeDefResult {
     maybe-type-def = Just (deck-record (TypeDef {
      name = name-tok,
      type-params = tparams,
      body = VariantBody (deck-record (__linked-list-to-list acc)),
      is-mutable = False,
      deriving = []
     })),
     state = st
    }

  parse-ctor-fields : Token, LinkedList TypeExpr, ParseState, Token, List Token, LinkedList VariantCtorDef -> ParseTypeDefResult
  parse-ctor-fields (ctor-name) (fields) (st) (name-tok) (tparams) (acc) =
   if is-left-paren (current-kind st) then let field-result = parse-type (advance st)
     in unwrap-ctor-field field-result ctor-name fields name-tok tparams acc
    else let st2 = skip-newlines st
    in if is-colon (current-kind st2) then let ret-result = parse-type (advance st2) in unwrap-ctor-return ret-result ctor-name fields name-tok tparams acc else let ctor = deck-record (VariantCtorDef { name = ctor-name, fields = deck-record (__linked-list-to-list fields), return-type = [] }) in parse-variant-ctors name-tok tparams (__linked-list-push acc ctor) st2

  unwrap-ctor-field : ParseTypeResult, Token, LinkedList TypeExpr, Token, List Token, LinkedList VariantCtorDef -> ParseTypeDefResult
  unwrap-ctor-field (r) (ctor-name) (fields) (name-tok) (tparams) (acc) =
   when r
    is TypeOk (ty) (st) ->
     let st2 = expect RightParen st
      in parse-ctor-fields ctor-name (__linked-list-push fields ty) st2 name-tok tparams acc

  unwrap-ctor-return : ParseTypeResult, Token, LinkedList TypeExpr, Token, List Token, LinkedList VariantCtorDef -> ParseTypeDefResult
  unwrap-ctor-return (r) (ctor-name) (fields) (name-tok) (tparams) (acc) =
   when r
    is TypeOk (ty) (st) -> let ctor = deck-record (VariantCtorDef { name = ctor-name, fields = deck-record (__linked-list-to-list fields), return-type = [ty] }) in parse-variant-ctors name-tok tparams (__linked-list-push acc ctor) (skip-newlines st)

Section: Document Parsing

 The ceiling is the PARSE scratch reservation's top. THREE walks write
 that deck here and all three are bounded, because guarding only the
 middle one does not keep the deck inside its floor -- measured
 2026-07-21 by keying the phase's report on the post-hoc parse-ov flag
 alone, where a compile with parse-top-level guarded still raised
 CDX9002 at a 2.5 MB floor. scan-class-instance-defs and check-pagination
 each walk the whole token list again, after parse-top-level has stopped,
 and between them they carried the deck past the ceiling on their own.

  parse-document : ParseState, Integer -> Document
  parse-document (st) (ceiling) =
   let st0 = __record-set st "deck-ceiling" ceiling
   in let st2 = skip-newlines st0
   in let (imp-list, imp-st) = parse-citations st2 "" []
   in let doc = parse-top-level [] [] [] imp-list "" [] [] [] [] imp-st
   in let short = deck-short-of ceiling demand-parse-scratch-guard-band
   in let ci = if short then empty-class-instance-scan else scan-class-instance-defs (make-parse-state (st.tokens) "") [] []
   in let pag-errs = if short then [] else check-pagination (scan-chapter-pages (make-parse-state (st.tokens) "") [])
   in let doc2 = __record-set (__record-set doc "class-defs" (ci.class-defs)) "instance-defs" (ci.instance-defs)
   in __record-set doc2 "parse-bag" (add-bag-diags (doc2.parse-bag) pag-errs 0 (list-length pag-errs))

  deck-copy-text : Text -> Text
  deck-copy-text (t) =
   if text-length t == 0 then "" else deck-record (substring t 0 (text-length t))

  collect-cite-title : ParseState, Text -> (Text, ParseState)
  collect-cite-title (st) (acc) =
   if is-done st then (deck-copy-text acc, st)
    else when current-kind st
     is Newline | LeftParen -> (deck-copy-text acc, st)
     is otherwise -> let tok = current st
      in collect-cite-title (advance st) (join-title-parts acc (token-text tok))

  parse-citations : ParseState, Text, LinkedList CitesDecl -> (List CitesDecl, ParseState)
  parse-citations (st) (citing) (acc) =
   if is-cites-keyword (current-kind st) then let st2 = advance st
     in let quire-tok = current st2
     in let st3 = advance st2
     in let st4 = advance st3
     in let (cite-title, st5) = collect-cite-title st4 ""
     in if is-left-paren (current-kind st5) then let (sel-names, st-sel) = parse-selected-names (advance st5) []
     in let st6 = skip-newlines st-sel
     in parse-citations st6 citing (__linked-list-push acc (deck-record (CitesDecl {
           quire = quire-tok,
           chapter-name = cite-title,
           selected-names = sel-names,
           citing-chapter = citing,
           decl-kind = decl-cite,
           content-hash = "",
           trust-floor = 0
          })))
     else let st6 = skip-newlines st5
     in parse-citations st6 citing (__linked-list-push acc (deck-record (CitesDecl {
          quire = quire-tok,
          chapter-name = cite-title,
          selected-names = [],
          citing-chapter = citing,
          decl-kind = decl-cite,
          content-hash = "",
          trust-floor = 0
         })))
    else (deck-record (__linked-list-to-list acc), st)

Section: Quotations

  quote-body-text : Token -> Text
  quote-body-text (tok) =
   let n = tok.length
   in if n < 2 then ""
      else deck-record (substring (tok.source) (tok.offset + 1) (n - 2))

  parse-quotation : ParseState, Text -> (CitesDecl, ParseState)
  parse-quotation (st) (citing) =
   let qtok = current st
   in let st1 = advance st
   in let hash-tok = current st1
   in let st2 = advance st1
   in let st3 = if is-ident (current-kind st2) then advance st2 else st2
   in let name-tok = current st3
   in let st4 = skip-newlines (advance st3)
   in (deck-record (CitesDecl {
        quire = qtok,
        chapter-name = deck-copy-text (token-text name-tok),
        selected-names = [],
        citing-chapter = citing,
        decl-kind = decl-quote,
        content-hash = quote-body-text hash-tok,
        trust-floor = 0
       }), st4)

  parse-trusting : ParseState, Text -> (CitesDecl, ParseState)
  parse-trusting (st) (citing) =
   let ttok = current st
   in let st1 = advance st
   in if is-text-lit (current-kind st1)
      then parse-trusting-key ttok st1 citing
      else parse-trusting-floor ttok st1 citing

 A trust FLOOR: trusting above N. The floor is the threshold every quoted
 work's signer must clear. The above word is optional.

  parse-trusting-floor : Token, ParseState, Text -> (CitesDecl, ParseState)
  parse-trusting-floor (ttok) (st1) (citing) =
   let st2 = if is-above-keyword (current-kind st1) then advance st1 else st1
   in let n-tok = current st2
   in let st3 = skip-newlines (advance st2)
   in (deck-record (CitesDecl {
        quire = ttok,
        chapter-name = "",
        selected-names = [],
        citing-chapter = citing,
        decl-kind = decl-trust,
        content-hash = "",
        trust-floor = text-to-integer (token-text n-tok)
       }), st3)

 A trusted KEY: trusting "<fingerprint>" "<public-key-hex>" <score>. The
 fingerprint is the lookup name a signed work will claim; the public key is
 the bytes its signature is verified against; the score is how far this
 source trusts that key. Because the key is named here in the source rather
 than in the offered works, a forged work signed by any other key is
 verified against the wrong bytes and refused -- the messenger cannot
 vouch for its own message. The two texts still carry their quotation
 marks in the token, so the body is what quote-body-text lifts out.

  parse-trusting-key : Token, ParseState, Text -> (CitesDecl, ParseState)
  parse-trusting-key (ttok) (st1) (citing) =
   let fp-tok = current st1
   in let st2 = advance st1
   in let pub-tok = current st2
   in let st3 = advance st2
   in let score-tok = current st3
   in let st4 = skip-newlines (advance st3)
   in (deck-record (CitesDecl {
        quire = ttok,
        chapter-name = quote-body-text fp-tok,
        selected-names = [],
        citing-chapter = citing,
        decl-kind = decl-trust-key,
        content-hash = quote-body-text pub-tok,
        trust-floor = text-to-integer (token-text score-tok)
       }), st4)

Section: Grounds

 A grounds declaration names the hardware effects a chapter is the
 SOURCE of -- the layer where the abstraction meets the metal. Its
 functions may perform those effects without declaring them (the
 internal exemption, no bookkeeping); a function that DECLARES the
 effect in its signature publishes it to out-of-kernel callers (a root).
 The exemption is scoped to the named effects, so a chapter grounding
 Device.Port that performs Device.Mmio is still rejected. Each named
 effect rides the header as a decl-grounds CitesDecl carrying the effect
 name (chapter-name) and the chapter that grounds it (citing-chapter);
 grounds-strings collects them into the Document as "slug\neffect"
 entries the type checker reads. A dotted effect
 (Device.Mmio) is read base-dot-member, the same shape parse-effect-names
 reads inside a row.

  parse-grounds : Token, ParseState, Text, LinkedList CitesDecl -> (List CitesDecl, ParseState)
  parse-grounds (gtok) (st) (citing) (acc) =
   if is-type-ident (current-kind st) | is-ident (current-kind st) then
    let tok = current st
    in let st2 = advance st
    in if is-dot (current-kind st2) then
        let st3 = advance st2
        in let sub = current st3
        in parse-grounds gtok (advance st3) citing (__linked-list-push acc (deck-record (CitesDecl {
             quire = gtok,
             chapter-name = deck-copy-text (token-text tok & "." & token-text sub),
             selected-names = [],
             citing-chapter = citing,
             decl-kind = decl-grounds,
             content-hash = "",
             trust-floor = 0
            })))
       else parse-grounds gtok st2 citing (__linked-list-push acc (deck-record (CitesDecl {
             quire = gtok,
             chapter-name = deck-copy-text (token-text tok),
             selected-names = [],
             citing-chapter = citing,
             decl-kind = decl-grounds,
             content-hash = "",
             trust-floor = 0
            })))
   else if is-comma (current-kind st) then parse-grounds gtok (advance st) citing acc
   else (deck-record (__linked-list-to-list acc), skip-newlines st)

  grounds-strings : List CitesDecl, Integer, Integer, List Text -> List Text
  grounds-strings (ds) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at ds i
   in if d.decl-kind == decl-grounds
      then grounds-strings ds (i + 1) len (list-push acc (deck-record ((d.citing-chapter) & "\n" & (d.chapter-name))))
      else grounds-strings ds (i + 1) len acc

Section: Sorting Out The Header

  filter-decl-kind : List CitesDecl, Integer, Integer, Integer, List CitesDecl -> List CitesDecl
  filter-decl-kind (ds) (want) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at ds i
   in if d.decl-kind == want
      then filter-decl-kind ds want (i + 1) len (list-push acc d)
      else filter-decl-kind ds want (i + 1) len acc

  header-trust-floor : List CitesDecl, Integer, Integer, Integer -> Integer
  header-trust-floor (ds) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at ds i
   in if d.decl-kind == decl-trust
      then header-trust-floor ds (i + 1) len (d.trust-floor)
      else header-trust-floor ds (i + 1) len acc

  stamp-trust-floor : List CitesDecl, Integer, Integer, Integer, List CitesDecl -> List CitesDecl
  stamp-trust-floor (qs) (floor) (i) (len) (acc) =
   if i >= len then acc
   else let q = list-at qs i
   in let stamped = deck-record (__record-set q "trust-floor" floor)
   in stamp-trust-floor qs floor (i + 1) len (list-push acc stamped)

  parse-selected-names : ParseState, LinkedList Token -> (List Token, ParseState)
  parse-selected-names (st) (acc) =
   if is-ident (current-kind st) | is-type-ident (current-kind st) then let tok = current st
     in let st2 = advance st
     in let acc2 = __linked-list-push acc tok
     in if is-comma (current-kind st2) then parse-selected-names (skip-newlines (advance st2)) acc2
        else if is-right-paren (current-kind st2) then (deck-record (__linked-list-to-list acc2), advance st2)
        else (deck-record (__linked-list-to-list acc2), st2)
    else if is-right-paren (current-kind st) then (deck-record (__linked-list-to-list acc), advance st)
    else (deck-record (__linked-list-to-list acc), st)

  is-chapter-header : ParseState -> Boolean
  is-chapter-header (st) =
   if is-type-ident (current-kind st) then let tok = current st
      in if tok.length == 7 then if (token-text tok) == "Chapter" then is-colon (peek-kind st 1)
            else False
         else False
    else False

  is-section-header : ParseState -> Boolean
  is-section-header (st) =
   if is-type-ident (current-kind st) then let tok = current st
      in if tok.length == 7 then if (token-text tok) == "Section" then is-colon (peek-kind st 1)
            else False
         else False
    else False

Section: Chapter Pagination

 A chapter may span several files. Each file is a PAGE, and says so:
 `Page 3 of 13`. That is why a repeated `Chapter:` name is not an error
 -- the X86-64 code generator is one chapter across thirteen files, and
 the parser is right to merge them.

 So: a chapter that appears once needs nothing. A chapter that appears
 k > 1 times must have, on every page, `Page N of M` with M == k and
 the N distinct. Anything else is CDX3004.

  PageOcc = record {
   po-chapter : Text,
   po-n : Integer,
   po-m : Integer,
   po-span : SourceSpan
  }

  page-marker-n : ParseState -> Integer
  page-marker-n (st) = text-to-integer (token-text (current (advance st)))

  page-marker-m : ParseState -> Integer
  page-marker-m (st) =
   let st2 = advance (advance st)
   in if is-ident (current-kind st2) then
       if (token-text (current st2)) == "of" then text-to-integer (token-text (current (advance st2)))
       else 0
      else 0

  set-last-page : List PageOcc, Integer, Integer -> List PageOcc
  set-last-page (occs) (n) (m) =
   let len = list-length occs
   in if len == 0 then occs
   else let last = list-at occs (len - 1)
   in list-set-at occs (len - 1) (deck-record (PageOcc {
    po-chapter = last.po-chapter,
    po-n = n,
    po-m = m,
    po-span = last.po-span
   }))

  scan-chapter-pages : ParseState, List PageOcc -> List PageOcc
  scan-chapter-pages (st) (acc) =
   if is-done st then acc
   else if is-chapter-header st then
    let tok = current st
    in let title = extract-header-title st
    in scan-chapter-pages (skip-to-next-line st) (list-push acc (deck-record (PageOcc {
     po-chapter = title,
     po-n = 0,
     po-m = 0,
     po-span = token-to-span tok
    })))
   else if is-page-marker st then
    let n = page-marker-n st
    in let m = page-marker-m st
    in scan-chapter-pages (skip-to-next-line st) (set-last-page acc n m)
   else scan-chapter-pages (advance st) acc

  count-chapter-occs : List PageOcc, Text, Integer, Integer, Integer -> Integer
  count-chapter-occs (occs) (name) (i) (len) (acc) =
   if i == len then acc
   else if (list-at occs i).po-chapter == name then count-chapter-occs occs name (i + 1) len (acc + 1)
   else count-chapter-occs occs name (i + 1) len acc

  count-chapter-page-n : List PageOcc, Text, Integer, Integer, Integer, Integer -> Integer
  count-chapter-page-n (occs) (name) (n) (i) (len) (acc) =
   if i == len then acc
   else let o = list-at occs i
   in if o.po-chapter == name then
       if o.po-n == n then count-chapter-page-n occs name n (i + 1) len (acc + 1)
       else count-chapter-page-n occs name n (i + 1) len acc
      else count-chapter-page-n occs name n (i + 1) len acc

  check-pagination : List PageOcc -> List Diagnostic
  check-pagination (occs) = check-pagination-loop occs 0 (list-length occs) []

  check-pagination-loop : List PageOcc, Integer, Integer, List Diagnostic -> List Diagnostic
  check-pagination-loop (occs) (i) (len) (errs) =
   if i == len then errs
   else let o = list-at occs i
   in let k = count-chapter-occs occs (o.po-chapter) 0 len 0
   in if k <= 1 then check-pagination-loop occs (i + 1) len errs
      else if o.po-m == 0
       then check-pagination-loop occs (i + 1) len (errs & [make-error cdx-chapter-pagination ("Chapter '" & (o.po-chapter) & "' spans " & show k & " files, but this page carries no 'Page N of M' marker. Number the pages, or an accidental duplicate chapter name is indistinguishable from a deliberate page and the two merge silently.") (o.po-span)])
      else if o.po-m /= k
       then check-pagination-loop occs (i + 1) len (errs & [make-error cdx-chapter-pagination ("Chapter '" & (o.po-chapter) & "' spans " & show k & " files but this page declares 'of " & show (o.po-m) & "'. The declared page count must equal the number of files the chapter spans.") (o.po-span)])
      else if count-chapter-page-n occs (o.po-chapter) (o.po-n) 0 len 0 > 1
       then check-pagination-loop occs (i + 1) len (errs & [make-error cdx-chapter-pagination ("Chapter '" & (o.po-chapter) & "' has two pages numbered " & show (o.po-n) & ". Each page of a chapter needs a distinct number.") (o.po-span)])
      else check-pagination-loop occs (i + 1) len errs

  add-bag-diags : DiagnosticBag, List Diagnostic, Integer, Integer -> DiagnosticBag
  add-bag-diags (bag) (ds) (i) (len) =
   if i == len then bag
   else add-bag-diags (bag-add bag (list-at ds i)) ds (i + 1) len

  is-page-number : TokenKind -> Boolean
  is-page-number (k) =
   when k
    is IntegerLiteral -> True
    is otherwise -> False

  is-page-marker : ParseState -> Boolean
  is-page-marker (st) =
   if is-type-ident (current-kind st) then let tok = current st
      in if tok.length == 4 then if (token-text tok) == "Page" then is-page-number (peek-kind st 1)
         else False
      else False
    else False

  extract-header-title : ParseState -> Text
  extract-header-title (st) =
   let st2 = advance (advance st)
   in deck-copy-text (collect-title-tokens st2 "")

  join-title-parts : Text, Text -> Text
  join-title-parts (acc) (next) =
   if text-length acc == 0 then next
    else if text-length next == 0 then acc
    else let prev-last = char-code-at acc (text-length acc - 1)
     in let next-first = char-code-at next 0
     in if (is-letter-code prev-last | is-digit-code prev-last) & (is-letter-code next-first | is-digit-code next-first)
        then deck-record (acc & " " & next)
        else deck-record (acc & next)

  collect-title-tokens : ParseState, Text -> Text
  collect-title-tokens (st) (acc) =
   if is-done st then acc
   else when current-kind st
    is Newline -> acc
    is otherwise -> let tok = current st
     in collect-title-tokens (advance st) (join-title-parts acc (token-text tok))

  is-prose-line : ParseState -> Boolean
  is-prose-line (st) = (current st).column == 2

  skip-body-lines : ParseState -> ParseState
  skip-body-lines (st) =
   let st2 = skip-newlines st
   in if is-done st2 then st2
   else if (current st2).column >= 3 then skip-body-lines (skip-to-next-line st2)
   else st2

  skip-prose-lines : ParseState -> ParseState
  skip-prose-lines (st) =
   let st2 = skip-newlines st
   in if is-done st2 then st2
      else if is-prose-line st2 then skip-prose-lines (skip-to-next-line st2)
      else if (current st2).column > 3 then skip-prose-lines (skip-to-next-line st2)
      else st2

  is-prose-token : ParseState -> Boolean
  is-prose-token (st) = current-kind st == ProseText

  classify-transition : Text -> ProseTransition
  classify-transition (line) =
   if text-contains line "We say:" then PtWeSay
   else if text-contains line "This is written:" then PtThisIsWritten
   else PtNone

  extract-template-name : Text, Text -> Text
  extract-template-name (line) (marker) =
   let parts = text-split line marker
   in if list-length parts < 1 then ""
      else let prefix = list-at parts 0
   in let words = text-split prefix " "
   in extract-last-word words (list-length words)

  extract-last-word : List Text, Integer -> Text
  extract-last-word (words) (len) =
   if len == 0 then ""
   else let w = list-at words (len - 1)
   in if text-length w == 0 then extract-last-word words (len - 1)
      else w

  extract-function-name : Text -> Text
  extract-function-name (line) =
   let parts = text-split line " "
   in if list-length parts < 2 then ""
      else let second = list-at parts 1
   in if text-length second == 0 then "" else second

  classify-template : Text -> ProseTemplate
  classify-template (line) =
   if text-contains line "is a record containing:" then
    PtRecordTemplate (extract-template-name line "is a record containing:")
   else if text-contains line "is one of:" then
    PtVariantTemplate (extract-template-name line "is one of:")
   else if text-contains line "is either:" then
    PtVariantTemplate (extract-template-name line "is either:")
   else if text-starts-with line "To " then
    PtFunctionTemplate (extract-function-name line)
   else if text-starts-with line "such that " then PtConstraintTemplate
   else if text-starts-with line "where " then PtConstraintTemplate
   else if text-starts-with line "provided that " then PtConstraintTemplate
   else if text-starts-with line "claim:" then PtProofTemplate
   else if text-starts-with line "Claim:" then PtProofTemplate
   else if text-starts-with line "therefore," then PtProofTemplate
   else if text-starts-with line "it follows that " then PtProofTemplate
   else if text-starts-with line "first," then PtProcedureTemplate
   else if text-starts-with line "First," then PtProcedureTemplate
   else if text-starts-with line "then," then PtProcedureTemplate
   else if text-starts-with line "Then," then PtProcedureTemplate
   else if text-starts-with line "finally," then PtProcedureTemplate
   else if text-starts-with line "Finally," then PtProcedureTemplate
   else if text-starts-with line "for every " then PtQuantifiedTemplate
   else if text-starts-with line "For every " then PtQuantifiedTemplate
   else if text-starts-with line "there exists " then PtQuantifiedTemplate
   else if text-starts-with line "There exists " then PtQuantifiedTemplate
   else if text-starts-with line "no " then PtQuantifiedTemplate
   else PtNoTemplate

  classify-prose-line : Text, Integer -> ProseBlock
  classify-prose-line (line) (off) =
   deck-record (ProseBlock {
    text = line,
    transition = classify-transition line,
    template = classify-template line,
    anchor = "",
    offset = off
   })

  CollectProseResult = record { state : ParseState, lines : LinkedList Text, blocks : LinkedList ProseBlock }

  collect-prose-with-text : ParseState, LinkedList Text, LinkedList ProseBlock -> CollectProseResult
  collect-prose-with-text (st) (acc) (blk-acc) =
   let st2 = skip-newlines st
   in if is-done st2 then CollectProseResult { state = st2, lines = acc, blocks = blk-acc }
      else if is-prose-token st2 then let txt = token-text (current st2)
        in let block = classify-prose-line txt ((current st2).offset)
        in collect-prose-with-text (skip-to-next-line (advance st2)) (__linked-list-push acc (txt & "\n")) (__linked-list-push blk-acc block)
      else if is-prose-line st2 then collect-prose-with-text (skip-to-next-line st2) acc blk-acc
      else if (current st2).column > 3 then collect-prose-with-text (skip-to-next-line st2) acc blk-acc
      else CollectProseResult { state = st2, lines = acc, blocks = blk-acc }

  skip-to-next-line : ParseState -> ParseState
  skip-to-next-line (st) =
   if is-done st then st
   else when current-kind st
    is Newline -> advance st
    is otherwise -> skip-to-next-line (advance st)

  is-conversion-decl : ParseState -> Boolean
  is-conversion-decl (st) =
   if current-kind st == IntegerLiteral then let st1 = advance st
   in if is-done st1 then False
   else if is-type-ident (current-kind st1) then let st2 = advance st1
     in if is-done st2 then False
     else is-equals (current-kind st2)
   else False
   else False

  parse-conversion-decl : ParseState -> AnnotationNode
  parse-conversion-decl (st) =
   let from-val = token-text (current st)
   in let st1 = advance st
   in let from-unit = token-text (current st1)
   in let st2 = advance (advance st1)
   in let to-val = if is-done st2 then "1" else token-text (current st2)
   in let st3 = if is-done st2 then st2 else advance st2
   in let to-unit = if is-done st3 then from-unit else token-text (current st3)
   in let factor = text-to-integer to-val / text-to-integer from-val
   in deck-record (AnnotationNode { kind = "conversion", target = from-unit, body = integer-to-text factor & " " & to-unit })

  empty-parse-document : DiagnosticBag -> Document
  empty-parse-document (bag) =
   deck-record (Document {
    defs = [],
    type-defs = [],
    effect-defs = [],
    class-defs = [],
    instance-defs = [],
    citations = [],
    quotations = [],
    trust-keys = [],
    ground-effects = [],
    chapter-title = "",
    section-titles = [],
    prose = "",
    prose-blocks = [],
    annotations = [],
    parse-bag = bag
   })

  parse-top-level : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document
  parse-top-level (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =
   if deck-short-of (st.deck-ceiling) demand-parse-scratch-guard-band then empty-parse-document (st.bag)
   else if is-done st then let prose-text = deck-record (text-concat-list (deck-record (__linked-list-to-list prose)))
    in let hdr-len = list-length imports
    in let floor = header-trust-floor imports 0 hdr-len (-1)
    in let raw-quotes = filter-decl-kind imports decl-quote 0 hdr-len []
    in let defs-list = deck-record (__linked-list-to-list defs)
    in let type-defs-list = deck-record (__linked-list-to-list type-defs)
    in let raw-blocks = deck-record (__linked-list-to-list blocks)
    in deck-record (Document {
    defs = defs-list,
    type-defs = type-defs-list,
    effect-defs = deck-record (__linked-list-to-list effect-defs),
    class-defs = [],
    instance-defs = [],
    citations = deck-record (filter-decl-kind imports decl-cite 0 hdr-len []),
    quotations = deck-record (stamp-trust-floor raw-quotes floor 0 (list-length raw-quotes) []),
    trust-keys = deck-record (filter-decl-kind imports decl-trust-key 0 hdr-len []),
    ground-effects = deck-record (grounds-strings imports 0 hdr-len []),
    chapter-title = ch-title,
    section-titles = deck-record (__linked-list-to-list sec-titles),
    prose = prose-text,
    prose-blocks = deck-record (anchor-prose-blocks raw-blocks defs-list type-defs-list),
    annotations = deck-record (__linked-list-to-list anns),
    parse-bag = st.bag
   })
   else if is-chapter-header st then let title = extract-header-title st
     in let pr = collect-prose-with-text (skip-to-next-line st) prose blocks
     in parse-top-level defs type-defs effect-defs imports title sec-titles (pr.lines) (pr.blocks) anns (pr.state)
   else if is-section-header st then let title = extract-header-title st
     in let pr = collect-prose-with-text (skip-to-next-line st) prose blocks
     in parse-top-level defs type-defs effect-defs imports ch-title (__linked-list-push sec-titles title) (pr.lines) (pr.blocks) anns (pr.state)
   else if is-page-marker st then parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-to-next-line st)
   else if is-cites-keyword (current-kind st) then let (cite-imports, cite-st) = parse-citations st ch-title []
     in parse-top-level defs type-defs effect-defs (deck-record (imports & cite-imports)) ch-title sec-titles prose blocks anns cite-st
   else if is-quotes-keyword (current-kind st) then let (q, q-st) = parse-quotation st ch-title
     in parse-top-level defs type-defs effect-defs (deck-record (imports & [q])) ch-title sec-titles prose blocks anns q-st
   else if is-trusting-keyword (current-kind st) then let (t, t-st) = parse-trusting st ch-title
     in parse-top-level defs type-defs effect-defs (deck-record (imports & [t])) ch-title sec-titles prose blocks anns t-st
   else if is-grounds-keyword (current-kind st) then let (g, g-st) = parse-grounds (current st) (advance st) ch-title []
     in parse-top-level defs type-defs effect-defs (deck-record (imports & g)) ch-title sec-titles prose blocks anns g-st
   else if is-effect-keyword (current-kind st) then parse-top-level-effect defs type-defs effect-defs imports ch-title sec-titles prose blocks anns st
   else if is-class-keyword (current-kind st) then let st-c1 = advance st
    in let st-c2 = advance st-c1
    in let st-c2b = if is-ident (current-kind st-c2) & is-fat-arrow (peek-kind st-c2 1)
      then advance (advance (advance st-c2))
      else st-c2
    in let st-c3 = if is-where-keyword (current-kind st-c2b) then skip-newlines (advance st-c2b) else st-c2b
    in let (_, ops-st) = parse-effect-ops st-c3 []
    in parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines ops-st)
   else if is-instance-keyword (current-kind st) then let st-i1 = advance st
    in let st-i2 = advance st-i1
    in let st-i3 = advance st-i2
    in let st-i4 = if is-where-keyword (current-kind st-i3) then skip-newlines (advance st-i3) else st-i3
    in parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-body-lines st-i4)
   else if is-claim-keyword (current-kind st) then parse-claim-arm defs type-defs effect-defs imports ch-title sec-titles prose blocks anns st
   else if is-proof-keyword (current-kind st) then let item = parse-top-def-item defs type-defs ch-title (advance st)
    in parse-top-level (item.ti-defs) (item.ti-type-defs) effect-defs imports ch-title sec-titles prose blocks anns (item.ti-state)
   else if is-punctual-keyword (current-kind st) then let pst = advance st
     in if is-done pst then parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns pst
     else if current-kind pst == IntegerLiteral then let budget-text = token-text (current pst)
       in let pst2 = advance pst
       in let pname = if is-done pst2 then "" else token-text (current pst2)
       in let pann = deck-record (AnnotationNode { kind = "hard-realtime", target = pname, body = budget-text })
       in let item = parse-top-def-item defs type-defs ch-title pst2
       in parse-top-level (item.ti-defs) (item.ti-type-defs) effect-defs imports ch-title sec-titles prose blocks (__linked-list-push anns pann) (item.ti-state)
     else let pname = token-text (current pst)
     in let pann = deck-record (AnnotationNode { kind = "hard-realtime", target = pname, body = "" })
     in let item = parse-top-def-item defs type-defs ch-title pst
     in parse-top-level (item.ti-defs) (item.ti-type-defs) effect-defs imports ch-title sec-titles prose blocks (__linked-list-push anns pann) (item.ti-state)
   else if is-bounded-keyword (current-kind st) then let bst = advance st
     in if is-done bst then parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns bst
     else let bclass = token-text (current bst)
     in let bst2 = advance bst
     in let bname = if is-done bst2 then "" else token-text (current bst2)
     in let bann = deck-record (AnnotationNode { kind = "bounded", target = bname, body = bclass })
     in let item = parse-top-def-item defs type-defs ch-title bst2
     in parse-top-level (item.ti-defs) (item.ti-type-defs) effect-defs imports ch-title sec-titles prose blocks (__linked-list-push anns bann) (item.ti-state)
   else if is-conversion-decl st then let conv-ann = parse-conversion-decl st
     in parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks (__linked-list-push anns conv-ann) (skip-to-next-line st)
   else if is-prose-line st then let pr = collect-prose-with-text st prose blocks
     in parse-top-level defs type-defs effect-defs imports ch-title sec-titles (pr.lines) (pr.blocks) anns (pr.state)
   else if (current st).column > 3 then parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-to-next-line st)
   else let item = parse-top-item defs type-defs ch-title st
   in parse-top-level (item.ti-defs) (item.ti-type-defs) effect-defs imports ch-title sec-titles prose blocks anns (item.ti-state)

  parse-top-level-effect : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document
  parse-top-level-effect (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =
   let st1 = advance st
   in let name-tok = current st1
   in let st2 = advance st1
   in let st3 = if is-where-keyword (current-kind st2) then skip-newlines (advance st2) else st2
   in let (ops-list, ops-st) = parse-effect-ops st3 []
   in let ed = deck-record (EffectDef {
        name = name-tok,
        ops = ops-list
       })
   in parse-top-level defs type-defs (__linked-list-push effect-defs ed) imports ch-title sec-titles prose blocks anns (skip-newlines ops-st)

  parse-effect-ops : ParseState, LinkedList EffectOpDef -> (List EffectOpDef, ParseState)
  parse-effect-ops (st) (acc) =
   if is-ident (current-kind st) then if is-colon (peek-kind st 1) then let op-tok = current st
      in let st2 = advance (advance st)
      in let type-result = parse-type st2
      in when type-result
         is TypeOk (ty) (st3) ->
          let op = deck-record (EffectOpDef {
           name = op-tok,
           type-expr = ty
          })
      in parse-effect-ops (skip-newlines st3) (__linked-list-push acc op)
     else (deck-record (__linked-list-to-list acc), st)
    else (deck-record (__linked-list-to-list acc), st)

  ClassDefsResult = record { class-defs : List ClassDef, instance-defs : List InstanceDef }

  empty-class-instance-scan : ClassDefsResult
  empty-class-instance-scan = ClassDefsResult { class-defs = [], instance-defs = [] }

  scan-class-instance-defs : ParseState, LinkedList ClassDef, LinkedList InstanceDef -> ClassDefsResult
  scan-class-instance-defs (st) (cacc) (iacc) =
   if is-done st then ClassDefsResult {
    class-defs = deck-record (__linked-list-to-list cacc),
    instance-defs = deck-record (__linked-list-to-list iacc)
   }
   else if is-class-keyword (current-kind st) & (is-ident (peek-kind st 1) | is-type-ident (peek-kind st 1)) then let st1 = advance st
    in let name-tok = current st1
    in let st2 = advance st1
    in if is-ident (current-kind st2) & is-fat-arrow (peek-kind st2 1) then
      let super-name = token-text name-tok
      in let st3 = advance (advance st2)
      in let real-name = current st3
      in let st4 = advance st3
      in let st5 = if is-where-keyword (current-kind st4) then skip-newlines (advance st4) else st4
      in let (ops-list, ops-st) = parse-effect-ops st5 []
      in let cd = deck-record (ClassDef { name = real-name, methods = ops-list, superclass = super-name })
      in scan-class-instance-defs (skip-newlines ops-st) (__linked-list-push cacc cd) iacc
    else let st3 = if is-where-keyword (current-kind st2) then skip-newlines (advance st2) else st2
    in let (ops-list, ops-st) = parse-effect-ops st3 []
    in let cd = deck-record (ClassDef { name = name-tok, methods = ops-list, superclass = "" })
    in scan-class-instance-defs (skip-newlines ops-st) (__linked-list-push cacc cd) iacc
   else if is-instance-keyword (current-kind st) & is-type-ident (peek-kind st 1) then let st1 = advance st
    in let class-tok = current st1
    in let st2 = advance st1
    in let (it-head, it-st) = parse-instance-type-head st2
    in let st4 = if is-where-keyword (current-kind it-st) then skip-newlines (advance it-st) else it-st
    in let (method-defs, methods-st) = parse-instance-methods st4 []
    in let id = deck-record (InstanceDef { class-name = class-tok, type-name = it-head, methods = method-defs })
    in scan-class-instance-defs (skip-newlines methods-st) cacc (__linked-list-push iacc id)
   else scan-class-instance-defs (advance st) cacc iacc

  parse-instance-type-head : ParseState -> (Token, ParseState)
  parse-instance-type-head (st) =
   if is-left-paren (current-kind st)
    then let st1 = advance st
     in (current st1, skip-to-close-paren (advance st1) 1)
   else (current st, advance st)

  skip-to-close-paren : ParseState, Integer -> ParseState
  skip-to-close-paren (st) (depth) =
   if depth <= 0 then st
   else when (current-kind st)
    is EndOfFile -> st
    is otherwise ->
     if is-left-paren (current-kind st) then skip-to-close-paren (advance st) (depth + 1)
     else if is-right-paren (current-kind st) then skip-to-close-paren (advance st) (depth - 1)
     else skip-to-close-paren (advance st) depth

  finish-instance-methods : LinkedList InstanceMethodDef, ParseState -> (List InstanceMethodDef, ParseState)
  finish-instance-methods (acc) (st) =
   (deck-record (__linked-list-to-list acc), st)

  parse-instance-methods : ParseState, LinkedList InstanceMethodDef -> (List InstanceMethodDef, ParseState)
  parse-instance-methods (st) (acc) =
   if is-ident (current-kind st) then let name-tok = current st
    in let st2 = advance st
    in let (inst-params, params-st) = parse-instance-params st2 []
    in if is-equals (current-kind params-st)
     then let st3 = skip-newlines (advance params-st)
      in let expr-result = parse-expr st3
      in when expr-result
       is ExprOk (body) (st4) ->
        let md = deck-record (InstanceMethodDef { name = name-tok, params = inst-params, body = body })
        in parse-instance-methods (skip-newlines st4) (__linked-list-push acc md)
     else finish-instance-methods acc st
   else finish-instance-methods acc st

  parse-instance-params : ParseState, LinkedList Token -> (List Token, ParseState)
  parse-instance-params (st) (acc) =
   if is-left-paren (current-kind st) then let st2 = advance st
    in let p = current st2
    in let st3 = advance st2
    in let st4 = if is-right-paren (current-kind st3) then advance st3 else st3
    in parse-instance-params st4 (__linked-list-push acc p)
   else (deck-record (__linked-list-to-list acc), st)

 The parse's own version of the same shape, and the one the stack probe
 catches at the deeper cliff: parse-top-level, try-top-level-type-def and
 try-top-level-def nested once per definition (3,385 frames of the first
 on the same unit). Both try-functions now RETURN what they found, so
 every arm of parse-top-level tail-calls itself.

  TopItem = record {
   ti-defs : LinkedList Def,
   ti-type-defs : LinkedList TypeDef,
   ti-state : ParseState
  }

  parse-top-def-item : LinkedList Def, LinkedList TypeDef, Text, ParseState -> TopItem
  parse-top-def-item (defs) (type-defs) (ch-title) (st) =
   let def-result = parse-definition st
   in let st2 = def-result.state
   in when def-result.maybe-def
    is Just (d) ->
     let tagged = deck-record (Def {
      name = d.name,
      params = d.params,
      ann = d.ann,
      body = d.body,
      chapter-slug = ch-title
     })
     in TopItem { ti-defs = __linked-list-push defs tagged, ti-type-defs = type-defs, ti-state = skip-newlines st2 }
    is None ->
     TopItem { ti-defs = defs, ti-type-defs = type-defs, ti-state = skip-newlines (advance st2) }

 A type definition is tried first and the definition parse re-reads from
 the SAME state when it is not one -- st, not the type parser's returned
 state, exactly as the two functions this replaces did.

  parse-top-item : LinkedList Def, LinkedList TypeDef, Text, ParseState -> TopItem
  parse-top-item (defs) (type-defs) (ch-title) (st) =
   let td-result = parse-type-def st
   in let st2 = td-result.state
   in when td-result.maybe-type-def
    is Just (td) ->
     TopItem { ti-defs = defs, ti-type-defs = __linked-list-push type-defs td, ti-state = skip-newlines st2 }
    is None ->
     parse-top-def-item defs type-defs ch-title st

  parse-claim-arm : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document
  parse-claim-arm (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =
   if is-simple-claim st then parse-simple-claim defs type-defs effect-defs imports ch-title sec-titles prose blocks anns st
   else let claim-ann = parse-claim-annotation st
    in parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks (__linked-list-push anns claim-ann) (skip-to-next-line st)

  parse-simple-claim : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document
  parse-simple-claim (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =
   let name-tok = current (advance st)
   in when parse-type-annotation (advance st)
    is TypeOk (prop-ty) (st4) ->
     let ann = deck-record ([deck-record (TypeAnn { name = name-tok, type-expr = prop-ty })])
     in let st5 = skip-newlines st4
     in let st6 = if is-proof-keyword (current-kind st5) then advance st5 else st5
     in let proof-name = current st6
     in let dr = parse-def-params-then ann proof-name [] (advance st6)
     in when dr.maybe-def
      is Just (d) ->
       let tagged = deck-record (Def {
        name = d.name,
        params = d.params,
        ann = d.ann,
        body = d.body,
        chapter-slug = ch-title
       })
       in parse-top-level (__linked-list-push defs tagged) type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines (dr.state))
      is None ->
       parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines (advance (dr.state)))
    is otherwise ->
     parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-to-next-line st)

Section: Prose Anchoring

  template-anchor : ProseTemplate -> Text
  template-anchor (t) =
   when t
    is PtRecordTemplate (n) -> n
    is PtVariantTemplate (n) -> n
    is PtFunctionTemplate (n) -> n
    is PtNoTemplate | PtConstraintTemplate | PtProofTemplate | PtProcedureTemplate | PtQuantifiedTemplate -> ""

  def-name-offset : List Def, Integer -> Integer
  def-name-offset (defs) (i) =
   let tok = (list-at defs i).name
   in tok.offset

  type-def-name-offset : List TypeDef, Integer -> Integer
  type-def-name-offset (type-defs) (i) =
   let tok = (list-at type-defs i).name
   in tok.offset

  advance-defs-past : List Def, Integer, Integer, Integer -> Integer
  advance-defs-past (defs) (di) (dlen) (off) =
   if di >= dlen then di
   else if def-name-offset defs di < off then advance-defs-past defs (di + 1) dlen off
   else di

  advance-type-defs-past : List TypeDef, Integer, Integer, Integer -> Integer
  advance-type-defs-past (type-defs) (ti) (tlen) (off) =
   if ti >= tlen then ti
   else if type-def-name-offset type-defs ti < off then advance-type-defs-past type-defs (ti + 1) tlen off
   else ti

  following-def-name : List Def, List TypeDef, Integer, Integer, Integer, Integer -> Text
  following-def-name (defs) (type-defs) (di) (ti) (dlen) (tlen) =
   if di >= dlen then if ti >= tlen then "" else token-text ((list-at type-defs ti).name)
   else if ti >= tlen then token-text ((list-at defs di).name)
   else if def-name-offset defs di <= type-def-name-offset type-defs ti then token-text ((list-at defs di).name)
   else token-text ((list-at type-defs ti).name)

  anchor-one-block : ProseBlock, List Def, List TypeDef, Integer, Integer, Integer, Integer -> ProseBlock
  anchor-one-block (block) (defs) (type-defs) (di) (ti) (dlen) (tlen) =
   let claimed = template-anchor (block.template)
   in let name = if text-length claimed > 0 then claimed
      else following-def-name defs type-defs di ti dlen tlen
   in deck-record (ProseBlock {
    text = block.text,
    transition = block.transition,
    template = block.template,
    anchor = name,
    offset = block.offset
   })

  anchor-blocks-loop : List ProseBlock, List Def, List TypeDef, Integer, Integer, Integer, Integer, Integer, Integer, List ProseBlock -> List ProseBlock
  anchor-blocks-loop (blocks) (defs) (type-defs) (i) (di) (ti) (blen) (dlen) (tlen) (acc) =
   if i >= blen then acc
   else let block = list-at blocks i
   in let di2 = advance-defs-past defs di dlen (block.offset)
   in let ti2 = advance-type-defs-past type-defs ti tlen (block.offset)
   in anchor-blocks-loop blocks defs type-defs (i + 1) di2 ti2 blen dlen tlen (list-push acc (anchor-one-block block defs type-defs di2 ti2 dlen tlen))

  anchor-prose-blocks : List ProseBlock, List Def, List TypeDef -> List ProseBlock
  anchor-prose-blocks (blocks) (defs) (type-defs) =
   anchor-blocks-loop blocks defs type-defs 0 0 0 (list-length blocks) (list-length defs) (list-length type-defs) []

Section: Prose-Notation Consistency

  find-type-def-named : List TypeDef, Text, Integer -> Integer
  find-type-def-named (type-defs) (name) (i) =
   if i >= list-length type-defs then 0 - 1
   else if token-text ((list-at type-defs i).name) == name then i
   else find-type-def-named type-defs name (i + 1)

  check-prose-type-name : Text, List TypeDef, Integer between 0 and 65535, Text, List Diagnostic -> List Diagnostic
  check-prose-type-name (template-name) (type-defs) (diag-code) (kind) (acc) =
   let found = find-type-def-named type-defs template-name 0
   in if found < 0 then list-push acc (make-warning diag-code ("Prose declares " & kind & " '" & template-name & "' but no type definition with that name exists") synthetic-span)
   else acc

  parser-find-def-index : List Def, Text, Integer, Integer -> Integer
  parser-find-def-index (defs) (name) (i) (len) =
   if i >= len then (-1)
   else if token-text ((list-at defs i).name) == name then i
   else parser-find-def-index defs name (i + 1) len

  effect-op-declares : List EffectOpDef, Text, Integer, Integer -> Boolean
  effect-op-declares (ops) (name) (i) (len) =
   if i >= len then False
   else if token-text ((list-at ops i).name) == name then True
   else effect-op-declares ops name (i + 1) len

  effect-defs-declare : List EffectDef, Text, Integer, Integer -> Boolean
  effect-defs-declare (eds) (name) (i) (len) =
   if i >= len then False
   else let ops = (list-at eds i).ops
   in if effect-op-declares ops name 0 (list-length ops) then True
      else effect-defs-declare eds name (i + 1) len

  check-prose-function : Text, List Def, List EffectDef, List Diagnostic -> List Diagnostic
  check-prose-function (template-name) (defs) (effect-defs) (acc) =
   if list-length defs == 0 then acc
   else if parser-find-def-index defs template-name 0 (list-length defs) >= 0 then acc
      else if effect-defs-declare effect-defs template-name 0 (list-length effect-defs) then acc
      else list-push acc (make-warning cdx-prose-function-name-mismatch ("Prose declares function '" & template-name & "' but no definition of that name appears in this chapter") synthetic-span)

  extract-prose-params : Text, Integer, Integer, List Text -> List Text
  extract-prose-params (line) (i) (len) (acc) =
   if i >= len then acc
   else if char-at line i == '(' then extract-prose-param-name line (i + 1) len acc
   else extract-prose-params line (i + 1) len acc

  extract-prose-param-name : Text, Integer, Integer, List Text -> List Text
  extract-prose-param-name (line) (i) (len) (acc) =
   if i >= len then acc
   else if char-at line i == ')' then
    let name = extract-prose-param-word line i (i - 1)
    in extract-prose-params line (i + 1) len (if text-length name > 0 then list-push acc name else acc)
   else if char-at line i == ':' then
    let name = extract-prose-param-word line i (i - 1)
    in let skip = prose-skip-close-paren line (i + 1) len
    in extract-prose-params line (skip + 1) len (if text-length name > 0 then list-push acc name else acc)
   else extract-prose-param-name line (i + 1) len acc

  extract-prose-param-word : Text, Integer, Integer -> Text
  extract-prose-param-word (line) (limit) (j) =
   if j < 0 then ""
   else if char-at line j == '(' then substring line (j + 1) (limit - j - 1)
   else if char-at line j == ' ' then substring line (j + 1) (limit - j - 1)
   else extract-prose-param-word line limit (j - 1)

  prose-skip-close-paren : Text, Integer, Integer -> Integer
  prose-skip-close-paren (line) (i) (len) =
   if i >= len then len
   else if char-at line i == ')' then i
   else prose-skip-close-paren line (i + 1) len

  check-prose-params : Text, List Text, List Def, List Diagnostic -> List Diagnostic
  check-prose-params (template-name) (prose-params) (defs) (acc) =
   if list-length defs == 0 then acc
   else let idx = parser-find-def-index defs template-name 0 (list-length defs)
   in if idx >= 0 then
    let matched-def = list-at defs idx
    in let def-name = token-text (matched-def.name)
    in let def-params = matched-def.params
    in let def-count = list-length def-params
    in let prose-count = list-length prose-params
    in if prose-count == 0 then acc
       else if prose-count == def-count then check-prose-param-names prose-params def-params 0 def-count acc
       else list-push acc (make-warning cdx-prose-parameter-mismatch ("Prose declares " & show prose-count & " parameters but '" & def-name & "' has " & show def-count) synthetic-span)
      else acc

  check-prose-param-names : List Text, List Token, Integer, Integer, List Diagnostic -> List Diagnostic
  check-prose-param-names (prose-params) (def-params) (i) (len) (acc) =
   if i >= len then acc
   else let prose-name = list-at prose-params i
   in let def-name = token-text (list-at def-params i)
   in if prose-name == def-name then check-prose-param-names prose-params def-params (i + 1) len acc
      else list-push (check-prose-param-names prose-params def-params (i + 1) len acc) (make-warning cdx-prose-parameter-mismatch ("Prose parameter " & show (i + 1) & " is '" & prose-name & "' but notation has '" & def-name & "'") synthetic-span)

  check-prose-block-against-defs : ProseBlock, List Def, List TypeDef, List EffectDef, List Diagnostic -> List Diagnostic
  check-prose-block-against-defs (block) (defs) (type-defs) (effect-defs) (acc) =
   when (block.template)
    is PtFunctionTemplate (fn) ->
     let name-diags = check-prose-function (block.anchor) defs effect-defs acc
     in let prose-params = extract-prose-params (block.text) 0 (text-length (block.text)) []
     in check-prose-params (block.anchor) prose-params defs name-diags
    is PtRecordTemplate (rn) -> check-prose-type-name (block.anchor) type-defs cdx-prose-record-field-mismatch "record" acc
    is PtVariantTemplate (vn) -> check-prose-type-name (block.anchor) type-defs cdx-prose-variant-ctor-mismatch "variant" acc
    is PtNoTemplate | PtConstraintTemplate | PtProofTemplate | PtProcedureTemplate | PtQuantifiedTemplate -> acc

  check-prose-consistency : Document -> List Diagnostic
  check-prose-consistency (doc) =
   check-prose-blocks-loop (doc.prose-blocks) (doc.defs) (doc.type-defs) (doc.effect-defs) 0 (list-length (doc.prose-blocks)) []

  check-prose-blocks-loop : List ProseBlock, List Def, List TypeDef, List EffectDef, Integer, Integer, List Diagnostic -> List Diagnostic
  check-prose-blocks-loop (blocks) (defs) (type-defs) (effect-defs) (i) (len) (acc) =
   if i >= len then acc
   else let block = list-at blocks i
   in check-prose-blocks-loop blocks defs type-defs effect-defs (i + 1) len (check-prose-block-against-defs block defs type-defs effect-defs acc)

Section: Banned Word Enforcement

  BannedWord = record {
   word : Text,
   substitute : Text
  }

  banned-words : List BannedWord = [
   BannedWord { word = " it ", substitute = "the named value" },
   BannedWord { word = " this ", substitute = "the named value" },
   BannedWord { word = " they ", substitute = "the named collection" },
   BannedWord { word = " some ", substitute = "a quantifier (all, every, exactly one, ...)" },
   BannedWord { word = " many ", substitute = "a quantifier or explicit bound" },
   BannedWord { word = " few ", substitute = "a quantifier or explicit bound" },
   BannedWord { word = " etc.", substitute = "exhaust the list or use a type" },
   BannedWord { word = " etc ", substitute = "exhaust the list or use a type" },
   BannedWord { word = " so ", substitute = "'therefore' or 'in order to'" },
   BannedWord { word = " since ", substitute = "'because' (causal) or 'after' (temporal)" },
   BannedWord { word = " while ", substitute = "'during' or 'at the same time as'" },
   BannedWord { word = " may ", substitute = "'can' (possibility) or 'is permitted to' (permission)" },
   BannedWord { word = " might ", substitute = "'can' (possibility) or 'is permitted to' (permission)" },
   BannedWord { word = " should ", substitute = "'must' (obligation) or 'is recommended to' (recommendation)" }
  ]

  check-banned-word : Text, BannedWord -> Maybe Diagnostic
  check-banned-word (line) (bw) =
   if text-contains line (bw.word) then
    Just (make-warning cdx-prose-banned-word ("Banned word '" & bw.word & "' in load-bearing prose; use " & bw.substitute) synthetic-span)
   else None

  check-banned-words-in-line : Text, List BannedWord, Integer, Integer, List Diagnostic -> List Diagnostic
  check-banned-words-in-line (line) (words) (i) (len) (acc) =
   if i >= len then acc
   else let bw = list-at words i
   in when check-banned-word line bw
    is Just (d) -> check-banned-words-in-line line words (i + 1) len (list-push acc d)
    is None -> check-banned-words-in-line line words (i + 1) len acc

  check-banned-in-blocks : List ProseBlock, Integer, Integer, Boolean, List Diagnostic -> List Diagnostic
  check-banned-in-blocks (blocks) (i) (len) (in-we-say) (acc) =
   if i >= len then acc
   else let block = list-at blocks i
   in let now-in-we-say = when (block.transition) is PtWeSay | PtThisIsWritten -> True is PtNone -> in-we-say
   in if now-in-we-say then let diags = check-banned-words-in-line (block.text) banned-words 0 (list-length banned-words) acc
      in check-banned-in-blocks blocks (i + 1) len now-in-we-say diags
      else check-banned-in-blocks blocks (i + 1) len now-in-we-say acc

  check-prose-banned : Document -> List Diagnostic
  check-prose-banned (doc) =
   check-banned-in-blocks (doc.prose-blocks) 0 (list-length (doc.prose-blocks)) False []

Section: Header Scanning (streaming)

  scan-document : ParseState -> ScanResult
  scan-document (st) =
   let st2 = skip-newlines st
   in let (imp-list, imp-st) = parse-citations st2 "" []
   in scan-top-level [] [] [] imp-list "" "" [] [] imp-st

  scan-top-level : LinkedList DefHeader, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, Text, LinkedList Text, LinkedList Text, ParseState -> ScanResult
  scan-top-level (headers) (type-defs) (effect-defs) (imports) (cur-chap) (ch-title) (sec-titles) (chap-names) (st) =
   if is-done st then deck-record (ScanResult {
    type-defs = deck-record (__linked-list-to-list type-defs),
    effect-defs = deck-record (__linked-list-to-list effect-defs),
    class-defs = [],
    instance-defs = [],
    def-headers = deck-record (__linked-list-to-list headers),
    citations = imports,
    chapter-title = ch-title,
    section-titles = deck-record (__linked-list-to-list sec-titles),
    chapter-names = deck-record (__linked-list-to-list chap-names)
   })
   else if is-chapter-header st then let title = extract-header-title st
     in scan-top-level headers type-defs effect-defs imports title title sec-titles (__linked-list-push chap-names title) (skip-prose-lines (skip-to-next-line st))
   else if is-section-header st then let title = extract-header-title st
     in scan-top-level headers type-defs effect-defs imports cur-chap ch-title (__linked-list-push sec-titles title) chap-names (skip-prose-lines (skip-to-next-line st))
   else if is-page-marker st then scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-to-next-line st)
   else if is-cites-keyword (current-kind st) then let (cite-imports, cite-st) = parse-citations st cur-chap []
     in scan-top-level headers type-defs effect-defs (deck-record (imports & cite-imports)) cur-chap ch-title sec-titles chap-names cite-st
   else if is-quotes-keyword (current-kind st) | is-trusting-keyword (current-kind st) | is-grounds-keyword (current-kind st) then scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-to-next-line st)
   else if is-effect-keyword (current-kind st) then scan-top-level-effect headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names st
   else if is-class-keyword (current-kind st) then let st-c1 = advance st
    in let st-c2 = advance st-c1
    in let st-c2b = if is-ident (current-kind st-c2) & is-fat-arrow (peek-kind st-c2 1)
      then advance (advance (advance st-c2))
      else st-c2
    in let st-c3 = if is-where-keyword (current-kind st-c2b) then skip-newlines (advance st-c2b) else st-c2b
    in let (_, ops-st) = parse-effect-ops st-c3 []
    in scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-newlines ops-st)
   else if is-instance-keyword (current-kind st) then let st-i1 = advance st
    in let st-i2 = advance st-i1
    in let st-i3 = advance st-i2
    in let st-i4 = if is-where-keyword (current-kind st-i3) then skip-newlines (advance st-i3) else st-i3
    in scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-body-lines st-i4)
   else if is-prose-line st then scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-prose-lines st)
   else if (current st).column > 3 then scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-to-next-line st)
   else let item = scan-top-item headers type-defs cur-chap st
   in scan-top-level (item.si-headers) (item.si-type-defs) effect-defs imports cur-chap ch-title sec-titles chap-names (item.si-state)

  scan-top-level-effect : LinkedList DefHeader, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, Text, LinkedList Text, LinkedList Text, ParseState -> ScanResult
  scan-top-level-effect (headers) (type-defs) (effect-defs) (imports) (cur-chap) (ch-title) (sec-titles) (chap-names) (st) =
   let st1 = advance st
   in let name-tok = current st1
   in let st2 = advance st1
   in let st3 = if is-where-keyword (current-kind st2) then skip-newlines (advance st2) else st2
   in let (ops-list, ops-st) = parse-effect-ops st3 []
   in let ed = deck-record (EffectDef {
        name = name-tok,
        ops = ops-list
       })
   in scan-top-level headers type-defs (__linked-list-push effect-defs ed) imports cur-chap ch-title sec-titles chap-names (skip-newlines ops-st)

 One top-level item, scanned and RETURNED rather than handed onward.
 These two used to tail-call scan-top-level between them, which made the
 scan a three-function mutual recursion nesting once per top-level
 definition: measured at 2,393 nested scan-top-level frames on the
 2.5 MB back-end unit, and mutual tail calls are what no plug and not
 bare metal flattens (every TCO in the fleet is self-only). Returning
 the outcome instead leaves scan-top-level tail-calling ITSELF, which is
 the shape everyone already flattens.

  ScanItem = record {
   si-headers : LinkedList DefHeader,
   si-type-defs : LinkedList TypeDef,
   si-state : ParseState
  }

  scan-top-item : LinkedList DefHeader, LinkedList TypeDef, Text, ParseState -> ScanItem
  scan-top-item (headers) (type-defs) (cur-chap) (st) =
   let td-result = parse-type-def st
   in let st2 = td-result.state
   in when td-result.maybe-type-def
    is Just (td) ->
     ScanItem { si-headers = headers, si-type-defs = __linked-list-push type-defs td, si-state = skip-newlines st2 }
    is None ->
     let hdr-result = scan-definition cur-chap st
     in let st3 = hdr-result.state
     in when hdr-result.maybe-header
      is Just (hdr) ->
       ScanItem { si-headers = __linked-list-push headers hdr, si-type-defs = type-defs, si-state = skip-newlines st3 }
      is None ->
       ScanItem { si-headers = headers, si-type-defs = type-defs, si-state = skip-newlines (advance st3) }

  scan-definition : Text, ParseState -> ScanDefResult
  scan-definition (cur-chap) (st) =
   if is-done st then ScanDefResult { maybe-header = None, state = st }
   else if is-ident (current-kind st) then try-scan-def cur-chap st
   else if is-type-ident (current-kind st) then try-scan-def cur-chap st
     else ScanDefResult { maybe-header = None, state = st }

  try-scan-def : Text, ParseState -> ScanDefResult
  try-scan-def (cur-chap) (st) =
   if is-colon (peek-kind st 1) then let first-name = current st
     in let ann-result = parse-type-annotation st
     in unwrap-type-for-scan cur-chap first-name ann-result
    else scan-def-body-with-ann cur-chap [] st

  unwrap-type-for-scan : Text, Token, ParseTypeResult -> ScanDefResult
  unwrap-type-for-scan (cur-chap) (first-name) (r) =
   when r
    is TypeOk (ann-type) (st) ->
     if is-equals (current-kind st) then
      let ann = deck-record ([deck-record (TypeAnn {
       name = first-name,
       type-expr = ann-type
      })])
      in let st2 = advance st
      in let st3 = skip-newlines st2
      in let body-pos = st3.pos
      in let st4 = skip-body-tokens st3 (first-name.column)
      in ScanDefResult {
          maybe-header = Just (deck-record (DefHeader {
           name = first-name,
           params = [],
           ann = ann,
           body-pos = body-pos,
           chapter-slug = cur-chap
          })),
          state = st4
         }
     else
      let name-tok = deck-record (Token {
       kind = Identifier,
       source = "",
       offset = 0,
       length = 0,
       line = 0,
       column = 0,
       file-id = 0
      })
      in let ann = deck-record ([deck-record (TypeAnn {
       name = name-tok,
       type-expr = ann-type
      })])
      in let st2 = skip-newlines st
      in scan-def-body-with-ann cur-chap ann st2

  scan-def-body-with-ann : Text, List TypeAnn, ParseState -> ScanDefResult
  scan-def-body-with-ann (cur-chap) (ann) (st) =
   let name-tok = current st
   in let st2 = advance st
   in scan-def-params-then cur-chap ann name-tok [] st2

  scan-def-params-then : Text, List TypeAnn, Token, LinkedList Token, ParseState -> ScanDefResult
  scan-def-params-then (cur-chap) (ann) (name-tok) (acc) (st) =
   if is-left-paren (current-kind st) then let st2 = advance st
   in if is-ident (current-kind st2) then let param = current st2
   in let st3 = advance st2
   in let st4 = expect RightParen st3
   in scan-def-params-then cur-chap ann name-tok (__linked-list-push acc param) st4
      else finish-def-scan cur-chap ann name-tok (deck-record (__linked-list-to-list acc)) st
    else finish-def-scan cur-chap ann name-tok (deck-record (__linked-list-to-list acc)) st

  finish-def-scan : Text, List TypeAnn, Token, List Token, ParseState -> ScanDefResult
  finish-def-scan (cur-chap) (ann) (name-tok) (params) (st) =
   if is-equals (current-kind st) == False then ScanDefResult { maybe-header = None, state = st }
   else let st2 = advance st
   in let st3 = skip-newlines st2
   in let body-pos = st3.pos
   in let st4 = skip-body-tokens st3 (name-tok.column)
   in ScanDefResult {
       maybe-header = Just (deck-record (DefHeader {
        name = name-tok,
        params = params,
        ann = ann,
        body-pos = body-pos,
        chapter-slug = cur-chap
       })),
       state = st4
      }

  skip-body-tokens : ParseState, Integer -> ParseState
  skip-body-tokens (st) (name-col) =
   if is-done st then st
   else let tok = current st
   in when tok.kind
     is Newline | Indent | Dedent -> skip-body-tokens (advance st) name-col
     is otherwise -> if tok.column <= name-col then st
      else skip-body-tokens (advance st) name-col

