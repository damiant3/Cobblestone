Chapter: Syntax Nodes

 The concrete syntax tree represents the structure of a parsed Codex
 source file. Each node carries position information for diagnostics.

  cites Foreword chapter Maybe

Section: Expressions
  Expr =
   | LitExpr (Token)
   | NameExpr (Token)
   | AppExpr (Expr) (Expr)
   | BinExpr (Expr) (Token) (Expr)
   | UnaryExpr (Token) (Expr)
   | IfExpr (Expr) (Expr) (Expr)
   | LetExpr (List LetBind) (Expr)
   | MatchExpr (Expr) (List MatchArm)
   | ListExpr (List Expr)
   | RecordExpr (Token) (List RecordFieldExpr)
   | FieldExpr (Expr) (Token)
   | ParenExpr (Expr)
   | TupleExpr (List Expr)
   | ActExpr (List ActStmt)
   | HandleExpr (Token) (Expr) (List HandleClause)
   | WithTimeoutExpr (Token) (List Token) (List Token) (Expr)
   | LambdaExpr (List Token) (Expr)
   | TryExpr (Token) (List ActStmt) (List ActStmt) (List ActStmt)
   | FieldAssignExpr (Expr) (Token) (Expr)
   | SeqExpr (Expr) (Expr)
   | LazyExpr (Expr)
   | ForExpr (Token) (Expr) (Expr)
   | ErrExpr (Token)
   | RevisedExpr (Expr) (List RecordFieldExpr)
   | InductionExpr (Expr) (List MatchArm)

  LetBind = record {
   name : Token,
   value : Expr
  }

  MatchArm = record {
   pattern : Pat,
   body : Expr,
   guard : Expr,
   alt-group : Integer
  }

  RecordFieldExpr = record {
   name : Token,
   value : Expr
  }

  ActStmt =
   | ActBindStmt (Token) (Expr)
   | ActExprStmt (Expr)

  HandleClause = record {
   op-name : Token,
   params : List Token,
   resume-name : Token,
   body : Expr
  }

Section: Patterns
  Pat =
   | VarPat (Token)
   | LitPat (Token)
   | CtorPat (Token) (List Pat)
   | WildPat (Token)
   | TuplePat (List Pat)
   | VecPat (List Pat)

Section: Types
  TypeExpr =
   | NamedType (Token)
   | FunType (TypeExpr) (TypeExpr)
   | AppType (TypeExpr) (List TypeExpr)
   | ParenType (TypeExpr)
   | ListType (TypeExpr)
   | LinearTypeExpr (TypeExpr)
   | EffectTypeExpr (List Token) (List Token) (List Token) (TypeExpr)
   | BoundedIntType (TypeExpr) (Integer) (Integer) (OverflowMode)
   | PropEqType (TypeExpr) (TypeExpr) (SourceSpan)
   | ConstrainedType (TypeExpr) (TypeExpr)
   | TupleType (List TypeExpr)
   | ForAllType (Token) (TypeExpr) (TypeExpr)

Section: Definitions
  TypeAnn = record {
   name : Token,
   type-expr : TypeExpr
  }

  Def = record {
   name : Token,
   params : List Token,
   ann : List TypeAnn,
   body : Expr,
   chapter-slug : Text
  }

  RecordFieldDef = record {
   name : Token,
   type-expr : TypeExpr
  }

  VariantCtorDef = record {
   name : Token,
   fields : List TypeExpr,
   return-type : List TypeExpr
  }

  EffectOpDef = record {
   name : Token,
   type-expr : TypeExpr
  }

  EffectDef = record {
   name : Token,
   ops : List EffectOpDef
  }

  ClassDef = record {
   name : Token,
   methods : List EffectOpDef,
   superclass : Text
  }

  InstanceMethodDef = record {
   name : Token,
   params : List Token,
   body : Expr
  }

  InstanceDef = record {
   class-name : Token,
   type-name : Token,
   methods : List InstanceMethodDef
  }

  UnitFamilyMember = record {
   member-name : Token,
   factor : Integer
  }

  TypeBody =
   | RecordBody (List RecordFieldDef)
   | VariantBody (List VariantCtorDef)
   | UnitBody (TypeExpr)
   | UnitFamilyBody (Token) (List UnitFamilyMember)

  TypeDef = record {
   name : Token,
   type-params : List Token,
   body : TypeBody,
   is-mutable : Boolean,
   deriving : List Token
  }

Section: Prose Classification

  ProseTransition =
   | PtNone
   | PtWeSay
   | PtThisIsWritten

  ProseTemplate =
   | PtNoTemplate
   | PtRecordTemplate (Text)
   | PtVariantTemplate (Text)
   | PtFunctionTemplate (Text)
   | PtConstraintTemplate
   | PtProofTemplate
   | PtProcedureTemplate
   | PtQuantifiedTemplate

  ProseBlock = record {
   text : Text,
   transition : ProseTransition,
   template : ProseTemplate
  }

Section: Annotations

  AnnotationNode = record {
   kind : Text,
   target : Text,
   body : Text
  }

Section: Document
 A chapter header carries three kinds of declaration — a citation, a
 quotation, and a trust floor — and the parser accumulates all three in
 one list before sorting them out.

 A citation names a work; a quotation reproduces one. A citation
 resolves through its quire to whatever file is on disk under that name.
 A quotation resolves through its digest to exactly one text — the text
 that hashes to it, or nothing at all. That is the whole difference, and
 it is why quoting can be trusted and citing cannot.

 decl-kind says which of the four a record is. On a quotation,
 chapter-name holds the local name it was bound to and content-hash
 holds the digest. On a trust floor, trust-floor holds the threshold and
 nothing else is meaningful. On a trusted key, chapter-name holds the
 signer fingerprint, content-hash holds the public key as hex, and
 trust-floor holds the score the source assigns that key.

 The trusted-key declaration is where a chapter says WHOSE signatures it
 will accept, and it lives in the source on purpose. The source is the one
 input the compiler is asked to compile and therefore trusts; the offered
 works arrive over a transport it does not. A manifest read from the works
 would let the messenger vouch for the message. Reading it from the source
 is the whole of the gate's protection.

 The floor is stamped onto every quotation only once the whole header
 has been read, because a chapter may declare its trust after the
 quotations that trust governs — a reader should not have to say how
 much they trust before saying what they are trusting.

  decl-cite : Integer = 0
  decl-quote : Integer = 1
  decl-trust : Integer = 2
  decl-trust-key : Integer = 3
  decl-grounds : Integer = 4

  CitesDecl = record {
   quire : Token,
   chapter-name : Text,
   selected-names : List Token,
   citing-chapter : Text,
   decl-kind : Integer,
   content-hash : Text,
   trust-floor : Integer
  }

  Document = record {
   defs : List Def,
   type-defs : List TypeDef,
   effect-defs : List EffectDef,
   class-defs : List ClassDef,
   instance-defs : List InstanceDef,
   citations : List CitesDecl,
   quotations : List CitesDecl,
   trust-keys : List CitesDecl,
   ground-effects : List Text,
   chapter-title : Text,
   section-titles : List Text,
   prose : Text,
   prose-blocks : List ProseBlock,
   annotations : List AnnotationNode,
   parse-bag : DiagnosticBag
  }

 Quotations are kept out of citations deliberately. Every phase after
 the parser — the desugarer, the chapter scoper, the name resolver, the
 type checker — walks citations, and a quotation is not a thing any of
 them should try to resolve to a file. Giving quotations their own field
 means none of those phases has to learn an exception.

Section: Deck Copies

 The parser allocates the Document in PARSE's scratch region. To let
 the parse phase compact, compile-parse copies the Document into a
 deck reservation built below the scratch; everything the copy does
 not reach is reclaimed. The sharing rule is positional, not
 structural: a value whose address sits below the reservation base
 survives the compact and is shared; anything at or above it is
 scratch and must be copied. Every copier threads the base as its
 first argument. Lexer tokens (and their kind cells) live in the LEX
 deck below and are shared wholesale -- this avoids duplicating the
 token store. Parser-synthesized tokens land in parse scratch and are
 rebuilt, including their kind cells, because constructor cells are
 heap values that dangle like any other. Texts are shared when
 durable and rematerialized through substring when they live in
 scratch -- substring copies bytes, so the rebuilt text does not
 point into the reclaimed region.

  copy-sx-text : Integer, Text -> Text
  copy-sx-text (b) (t) = substring t 0 (text-length t)

  copy-sx-texts : Integer, List Text -> List Text
  copy-sx-texts (b) (ts) = for t in ts -> copy-sx-text b t

  copy-sx-kind : TokenKind -> TokenKind
  copy-sx-kind (k) =
   when k
    is EndOfFile -> EndOfFile
    is Newline -> Newline
    is Indent -> Indent
    is Dedent -> Dedent
    is IntegerLiteral -> IntegerLiteral
    is NumberLiteral -> NumberLiteral
    is TextLiteral -> TextLiteral
    is CharLiteral -> CharLiteral
    is TrueKeyword -> TrueKeyword
    is FalseKeyword -> FalseKeyword
    is Identifier -> Identifier
    is TypeIdentifier -> TypeIdentifier
    is ProseText -> ProseText
    is ChapterHeader -> ChapterHeader
    is SectionHeader -> SectionHeader
    is LetKeyword -> LetKeyword
    is InKeyword -> InKeyword
    is BetweenKeyword -> BetweenKeyword
    is IfKeyword -> IfKeyword
    is IsKeyword -> IsKeyword
    is OtherwiseKeyword -> OtherwiseKeyword
    is ThenKeyword -> ThenKeyword
    is ElseKeyword -> ElseKeyword
    is WhenKeyword -> WhenKeyword
    is WhereKeyword -> WhereKeyword
    is SuchThatKeyword -> SuchThatKeyword
    is ActKeyword -> ActKeyword
    is EndKeyword -> EndKeyword
    is RecordKeyword -> RecordKeyword
    is CitesKeyword -> CitesKeyword
    is GroundsKeyword -> GroundsKeyword
    is QuotesKeyword -> QuotesKeyword
    is TrustingKeyword -> TrustingKeyword
    is AboveKeyword -> AboveKeyword
    is ClaimKeyword -> ClaimKeyword
    is ProofKeyword -> ProofKeyword
    is QedKeyword -> QedKeyword
    is InductionKeyword -> InductionKeyword
    is ForAllKeyword -> ForAllKeyword
    is ThereExistsKeyword -> ThereExistsKeyword
    is LinearKeyword -> LinearKeyword
    is MutableKeyword -> MutableKeyword
    is PunctualKeyword -> PunctualKeyword
    is EffectKeyword -> EffectKeyword
    is ClassKeyword -> ClassKeyword
    is InstanceKeyword -> InstanceKeyword
    is WithKeyword -> WithKeyword
    is WithTimeoutKeyword -> WithTimeoutKeyword
    is TryingKeyword -> TryingKeyword
    is LazyKeyword -> LazyKeyword
    is ForKeyword -> ForKeyword
    is Equals -> Equals
    is Colon -> Colon
    is Arrow -> Arrow
    is LeftArrow -> LeftArrow
    is Pipe -> Pipe
    is PipeForward -> PipeForward
    is Ampersand -> Ampersand
    is Plus -> Plus
    is Minus -> Minus
    is Star -> Star
    is Slash -> Slash
    is Caret -> Caret
    is ColonColon -> ColonColon
    is DoubleEquals -> DoubleEquals
    is NotEquals -> NotEquals
    is LessThan -> LessThan
    is GreaterThan -> GreaterThan
    is LessOrEqual -> LessOrEqual
    is GreaterOrEqual -> GreaterOrEqual
    is TripleEquals -> TripleEquals
    is FatArrow -> FatArrow
    is LeftParen -> LeftParen
    is RightParen -> RightParen
    is LeftBracket -> LeftBracket
    is RightBracket -> RightBracket
    is LeftBrace -> LeftBrace
    is RightBrace -> RightBrace
    is Comma -> Comma
    is Dot -> Dot
    is Underscore -> Underscore
    is Backslash -> Backslash
    is AtSign -> AtSign
    is ErrorToken -> ErrorToken
    is UnitKeyword -> UnitKeyword
    is RevisedKeyword -> RevisedKeyword
    is Tilde -> Tilde
    is TildeZero -> TildeZero

  copy-sx-token : Integer, Token -> Token
  copy-sx-token (b) (t) =
   if address-of t < b then t
   else Token {
    kind = copy-sx-kind (t.kind),
    source = copy-sx-text b (t.source),
    offset = t.offset,
    length = t.length,
    line = t.line,
    column = t.column,
    file-id = t.file-id
   }

  copy-sx-tokens : Integer, List Token -> List Token
  copy-sx-tokens (b) (ts) = for t in ts -> copy-sx-token b t

  copy-sx-prov : Provenance -> Provenance
  copy-sx-prov (p) =
   when p
    is ProvParsed -> ProvParsed
    is ProvDesugared -> ProvDesugared
    is ProvSynthetic -> ProvSynthetic

  copy-sx-pos : SourcePosition -> SourcePosition
  copy-sx-pos (p) = SourcePosition { line = p.line, column = p.column, offset = p.offset }

  copy-sx-span : Integer, SourceSpan -> SourceSpan
  copy-sx-span (b) (s) =
   if address-of s < b then s
   else SourceSpan {
    start = copy-sx-pos (s.start),
    end = copy-sx-pos (s.end),
    file-id = s.file-id,
    provenance = copy-sx-prov (s.provenance)
   }

  copy-sx-ov : OverflowMode -> OverflowMode
  copy-sx-ov (m) =
   when m
    is OvError -> OvError
    is OvWrapping -> OvWrapping
    is OvClamping -> OvClamping

  copy-sx-typeexpr : Integer, TypeExpr -> TypeExpr
  copy-sx-typeexpr (b) (t) =
   when t
    is NamedType (tok) -> NamedType (copy-sx-token b tok)
    is FunType (a) (r) -> FunType (copy-sx-typeexpr b a) (copy-sx-typeexpr b r)
    is AppType (f) (args) -> AppType (copy-sx-typeexpr b f) (for a in args -> copy-sx-typeexpr b a)
    is ParenType (inner) -> ParenType (copy-sx-typeexpr b inner)
    is ListType (el) -> ListType (copy-sx-typeexpr b el)
    is LinearTypeExpr (inner) -> LinearTypeExpr (copy-sx-typeexpr b inner)
    is EffectTypeExpr (effs) (caps) (tail) (inner) -> EffectTypeExpr (copy-sx-tokens b effs) (copy-sx-tokens b caps) (copy-sx-tokens b tail) (copy-sx-typeexpr b inner)
    is BoundedIntType (inner) (lo) (hi) (mode) -> BoundedIntType (copy-sx-typeexpr b inner) lo hi (copy-sx-ov mode)
    is PropEqType (l) (r) (sp) -> PropEqType (copy-sx-typeexpr b l) (copy-sx-typeexpr b r) (copy-sx-span b sp)
    is ConstrainedType (inner) (c) -> ConstrainedType (copy-sx-typeexpr b inner) (copy-sx-typeexpr b c)
    is TupleType (els) -> TupleType (for el in els -> copy-sx-typeexpr b el)
    is ForAllType (v) (vt) (p) -> ForAllType (copy-sx-token b v) (copy-sx-typeexpr b vt) (copy-sx-typeexpr b p)

  copy-sx-pat : Integer, Pat -> Pat
  copy-sx-pat (b) (p) =
   when p
    is VarPat (tok) -> VarPat (copy-sx-token b tok)
    is LitPat (tok) -> LitPat (copy-sx-token b tok)
    is CtorPat (tok) (args) -> CtorPat (copy-sx-token b tok) (for a in args -> copy-sx-pat b a)
    is WildPat (tok) -> WildPat (copy-sx-token b tok)
    is TuplePat (els) -> TuplePat (for el in els -> copy-sx-pat b el)
    is VecPat (els) -> VecPat (for el in els -> copy-sx-pat b el)

  copy-sx-letbind : Integer, LetBind -> LetBind
  copy-sx-letbind (b) (lb) = LetBind { name = copy-sx-token b (lb.name), value = copy-sx-expr b (lb.value) }

  copy-sx-matcharm : Integer, MatchArm -> MatchArm
  copy-sx-matcharm (b) (a) = MatchArm {
   pattern = copy-sx-pat b (a.pattern),
   body = copy-sx-expr b (a.body),
   guard = copy-sx-expr b (a.guard),
   alt-group = a.alt-group
  }

  copy-sx-fieldexpr : Integer, RecordFieldExpr -> RecordFieldExpr
  copy-sx-fieldexpr (b) (f) = RecordFieldExpr { name = copy-sx-token b (f.name), value = copy-sx-expr b (f.value) }

  copy-sx-actstmt : Integer, ActStmt -> ActStmt
  copy-sx-actstmt (b) (s) =
   when s
    is ActBindStmt (tok) (e) -> ActBindStmt (copy-sx-token b tok) (copy-sx-expr b e)
    is ActExprStmt (e) -> ActExprStmt (copy-sx-expr b e)

  copy-sx-handleclause : Integer, HandleClause -> HandleClause
  copy-sx-handleclause (b) (c) = HandleClause {
   op-name = copy-sx-token b (c.op-name),
   params = copy-sx-tokens b (c.params),
   resume-name = copy-sx-token b (c.resume-name),
   body = copy-sx-expr b (c.body)
  }

  copy-sx-expr : Integer, Expr -> Expr
  copy-sx-expr (b) (e) =
   when e
    is LitExpr (tok) -> LitExpr (copy-sx-token b tok)
    is NameExpr (tok) -> NameExpr (copy-sx-token b tok)
    is AppExpr (f) (a) -> AppExpr (copy-sx-expr b f) (copy-sx-expr b a)
    is BinExpr (l) (op) (r) -> BinExpr (copy-sx-expr b l) (copy-sx-token b op) (copy-sx-expr b r)
    is UnaryExpr (op) (inner) -> UnaryExpr (copy-sx-token b op) (copy-sx-expr b inner)
    is IfExpr (c) (t) (f) -> IfExpr (copy-sx-expr b c) (copy-sx-expr b t) (copy-sx-expr b f)
    is LetExpr (binds) (body) -> LetExpr (for lb in binds -> copy-sx-letbind b lb) (copy-sx-expr b body)
    is MatchExpr (scrut) (arms) -> MatchExpr (copy-sx-expr b scrut) (for a in arms -> copy-sx-matcharm b a)
    is ListExpr (els) -> ListExpr (for el in els -> copy-sx-expr b el)
    is RecordExpr (name) (fields) -> RecordExpr (copy-sx-token b name) (for f in fields -> copy-sx-fieldexpr b f)
    is FieldExpr (rec) (field) -> FieldExpr (copy-sx-expr b rec) (copy-sx-token b field)
    is ParenExpr (inner) -> ParenExpr (copy-sx-expr b inner)
    is TupleExpr (els) -> TupleExpr (for el in els -> copy-sx-expr b el)
    is ActExpr (stmts) -> ActExpr (for s in stmts -> copy-sx-actstmt b s)
    is HandleExpr (tok) (body) (clauses) -> HandleExpr (copy-sx-token b tok) (copy-sx-expr b body) (for c in clauses -> copy-sx-handleclause b c)
    is WithTimeoutExpr (tok) (budget) (handler) (body) -> WithTimeoutExpr (copy-sx-token b tok) (copy-sx-tokens b budget) (copy-sx-tokens b handler) (copy-sx-expr b body)
    is LambdaExpr (params) (body) -> LambdaExpr (copy-sx-tokens b params) (copy-sx-expr b body)
    is TryExpr (tok) (t-stmts) (c-stmts) (f-stmts) -> TryExpr (copy-sx-token b tok) (for ts in t-stmts -> copy-sx-actstmt b ts) (for cs in c-stmts -> copy-sx-actstmt b cs) (for fs in f-stmts -> copy-sx-actstmt b fs)
    is FieldAssignExpr (target) (field) (value) -> FieldAssignExpr (copy-sx-expr b target) (copy-sx-token b field) (copy-sx-expr b value)
    is SeqExpr (first) (second) -> SeqExpr (copy-sx-expr b first) (copy-sx-expr b second)
    is LazyExpr (inner) -> LazyExpr (copy-sx-expr b inner)
    is ForExpr (var) (coll) (body) -> ForExpr (copy-sx-token b var) (copy-sx-expr b coll) (copy-sx-expr b body)
    is ErrExpr (tok) -> ErrExpr (copy-sx-token b tok)
    is RevisedExpr (base) (fields) -> RevisedExpr (copy-sx-expr b base) (for f in fields -> copy-sx-fieldexpr b f)
    is InductionExpr (scrut) (arms) -> InductionExpr (copy-sx-expr b scrut) (for a in arms -> copy-sx-matcharm b a)

  copy-sx-typeann : Integer, TypeAnn -> TypeAnn
  copy-sx-typeann (b) (a) = TypeAnn { name = copy-sx-token b (a.name), type-expr = copy-sx-typeexpr b (a.type-expr) }

  copy-sx-def : Integer, Def -> Def
  copy-sx-def (b) (d) = Def {
   name = copy-sx-token b (d.name),
   params = copy-sx-tokens b (d.params),
   ann = for a in (d.ann) -> copy-sx-typeann b a,
   body = copy-sx-expr b (d.body),
   chapter-slug = copy-sx-text b (d.chapter-slug)
  }

  copy-sx-fielddef : Integer, RecordFieldDef -> RecordFieldDef
  copy-sx-fielddef (b) (f) = RecordFieldDef { name = copy-sx-token b (f.name), type-expr = copy-sx-typeexpr b (f.type-expr) }

  copy-sx-ctordef : Integer, VariantCtorDef -> VariantCtorDef
  copy-sx-ctordef (b) (c) = VariantCtorDef { name = copy-sx-token b (c.name), fields = for f in (c.fields) -> copy-sx-typeexpr b f, return-type = for r in (c.return-type) -> copy-sx-typeexpr b r }

  copy-sx-typebody : Integer, TypeBody -> TypeBody
  copy-sx-typebody (b) (body) =
   when body
    is RecordBody (fields) -> RecordBody (for f in fields -> copy-sx-fielddef b f)
    is VariantBody (ctors) -> VariantBody (for c in ctors -> copy-sx-ctordef b c)
    is UnitBody (base) -> UnitBody (copy-sx-typeexpr b base)
    is UnitFamilyBody (base-tok) (members) -> UnitFamilyBody (copy-sx-token b base-tok) (for m in members -> UnitFamilyMember { member-name = copy-sx-token b (m.member-name), factor = m.factor })

  copy-sx-typedef : Integer, TypeDef -> TypeDef
  copy-sx-typedef (b) (d) = TypeDef {
   name = copy-sx-token b (d.name),
   type-params = copy-sx-tokens b (d.type-params),
   body = copy-sx-typebody b (d.body),
   is-mutable = d.is-mutable,
   deriving = copy-sx-tokens b (d.deriving)
  }

  copy-sx-opdef : Integer, EffectOpDef -> EffectOpDef
  copy-sx-opdef (b) (o) = EffectOpDef { name = copy-sx-token b (o.name), type-expr = copy-sx-typeexpr b (o.type-expr) }

  copy-sx-effectdef : Integer, EffectDef -> EffectDef
  copy-sx-effectdef (b) (d) = EffectDef { name = copy-sx-token b (d.name), ops = for o in (d.ops) -> copy-sx-opdef b o }

  copy-sx-classdef : Integer, ClassDef -> ClassDef
  copy-sx-classdef (b) (d) = ClassDef { name = copy-sx-token b (d.name), methods = for m in (d.methods) -> copy-sx-opdef b m, superclass = copy-sx-text b (d.superclass) }

  copy-sx-imethod : Integer, InstanceMethodDef -> InstanceMethodDef
  copy-sx-imethod (b) (m) = InstanceMethodDef {
   name = copy-sx-token b (m.name),
   params = copy-sx-tokens b (m.params),
   body = copy-sx-expr b (m.body)
  }

  copy-sx-instancedef : Integer, InstanceDef -> InstanceDef
  copy-sx-instancedef (b) (d) = InstanceDef {
   class-name = copy-sx-token b (d.class-name),
   type-name = copy-sx-token b (d.type-name),
   methods = for m in (d.methods) -> copy-sx-imethod b m
  }

  copy-sx-citesdecl : Integer, CitesDecl -> CitesDecl
  copy-sx-citesdecl (b) (c) = CitesDecl {
   quire = copy-sx-token b (c.quire),
   chapter-name = copy-sx-text b (c.chapter-name),
   selected-names = copy-sx-tokens b (c.selected-names),
   citing-chapter = copy-sx-text b (c.citing-chapter),
   decl-kind = c.decl-kind,
   content-hash = copy-sx-text b (c.content-hash),
   trust-floor = c.trust-floor
  }

  copy-sx-ptrans : ProseTransition -> ProseTransition
  copy-sx-ptrans (t) =
   when t
    is PtNone -> PtNone
    is PtWeSay -> PtWeSay
    is PtThisIsWritten -> PtThisIsWritten

  copy-sx-ptemplate : Integer, ProseTemplate -> ProseTemplate
  copy-sx-ptemplate (b) (t) =
   when t
    is PtNoTemplate -> PtNoTemplate
    is PtRecordTemplate (n) -> PtRecordTemplate (copy-sx-text b n)
    is PtVariantTemplate (n) -> PtVariantTemplate (copy-sx-text b n)
    is PtFunctionTemplate (n) -> PtFunctionTemplate (copy-sx-text b n)
    is PtConstraintTemplate -> PtConstraintTemplate
    is PtProofTemplate -> PtProofTemplate
    is PtProcedureTemplate -> PtProcedureTemplate
    is PtQuantifiedTemplate -> PtQuantifiedTemplate

  copy-sx-proseblock : Integer, ProseBlock -> ProseBlock
  copy-sx-proseblock (b) (p) = ProseBlock {
   text = copy-sx-text b (p.text),
   transition = copy-sx-ptrans (p.transition),
   template = copy-sx-ptemplate b (p.template)
  }

  copy-sx-annotation : Integer, AnnotationNode -> AnnotationNode
  copy-sx-annotation (b) (a) = AnnotationNode {
   kind = copy-sx-text b (a.kind),
   target = copy-sx-text b (a.target),
   body = copy-sx-text b (a.body)
  }

  copy-sx-diag : Integer, Diagnostic -> Diagnostic
  copy-sx-diag (b) (d) = Diagnostic {
   code = d.code,
   message = copy-sx-text b (d.message),
   severity = d.severity,
   span = copy-sx-span b (d.span),
   related-spans = for s in (d.related-spans) -> copy-sx-span b s
  }

  copy-sx-bag : Integer, DiagnosticBag -> DiagnosticBag
  copy-sx-bag (b) (bag) = DiagnosticBag {
   diagnostics = for d in (bag.diagnostics) -> copy-sx-diag b d,
   error-count = bag.error-count,
   truncated = bag.truncated
  }

  copy-sx-document : Integer, Document -> Document
  copy-sx-document (b) (d) = Document {
   defs = for fd in (d.defs) -> copy-sx-def b fd,
   type-defs = for t in (d.type-defs) -> copy-sx-typedef b t,
   effect-defs = for e in (d.effect-defs) -> copy-sx-effectdef b e,
   class-defs = for c in (d.class-defs) -> copy-sx-classdef b c,
   instance-defs = for i in (d.instance-defs) -> copy-sx-instancedef b i,
   citations = for c in (d.citations) -> copy-sx-citesdecl b c,
   quotations = for q in (d.quotations) -> copy-sx-citesdecl b q,
   trust-keys = for k in (d.trust-keys) -> copy-sx-citesdecl b k,
   ground-effects = copy-sx-texts b (d.ground-effects),
   chapter-title = copy-sx-text b (d.chapter-title),
   section-titles = copy-sx-texts b (d.section-titles),
   prose = copy-sx-text b (d.prose),
   prose-blocks = for p in (d.prose-blocks) -> copy-sx-proseblock b p,
   annotations = for a in (d.annotations) -> copy-sx-annotation b a,
   parse-bag = copy-sx-bag b (d.parse-bag)
  }

Section: Definition Headers (for streaming)
  DefHeader = record {
   name : Token,
   params : List Token,
   ann : List TypeAnn,
   body-pos : Integer between 0 and 4294967295,
   chapter-slug : Text
  }

  ScanDefResult = record {
   maybe-header : Maybe DefHeader,
   state : ParseState
  }

  ScanResult = record {
   type-defs : List TypeDef,
   effect-defs : List EffectDef,
   class-defs : List ClassDef,
   instance-defs : List InstanceDef,
   def-headers : List DefHeader,
   citations : List CitesDecl,
   chapter-title : Text,
   section-titles : List Text
  }

