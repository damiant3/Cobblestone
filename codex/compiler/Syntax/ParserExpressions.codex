Chapter: Parser
  cites Codex chapter Lists

 Expression and compound expression parsing.

Section: Expression Parsing
  parse-expr : ParseState -> ParseExprResult
  parse-expr (st) =
   if parse-fuel-exhausted st then ExprOk (ErrExpr (current st)) (emit-parse-fuel-error st "parse-expr")
   else parse-expr-col (consume-parse-fuel st) 0

  parse-expr-col : ParseState, Integer -> ParseExprResult
  parse-expr-col (st) (min-col) =
   parse-binary st 0 min-col

  unwrap-expr-ok : ParseExprResult, (Expr -> ParseState -> ParseExprResult) -> ParseExprResult
  unwrap-expr-ok (r) (f) =
   when r
    is ExprOk (e) (st) -> f e st

  parse-binary : ParseState, Integer, Integer -> ParseExprResult
  parse-binary (st) (min-prec) (min-col) =
   if parse-fuel-exhausted st then ExprOk (ErrExpr (current st)) (emit-parse-fuel-error st "parse-binary")
   else let st0 = consume-parse-fuel st
   in let left-result = parse-unary st0
   in unwrap-expr-ok left-result (start-binary-loop min-prec min-col)

  start-binary-loop : Integer, Integer, Expr, ParseState -> ParseExprResult
  start-binary-loop (min-prec) (min-col) (left) (st) =
   parse-binary-loop left st min-prec min-col

  parse-binary-loop : Expr, ParseState, Integer, Integer -> ParseExprResult
  parse-binary-loop (left) (st) (min-prec) (min-col) =
   if parse-fuel-exhausted st then ExprOk left (emit-parse-fuel-error st "parse-binary-loop")
   else let st-fueled = consume-parse-fuel st
   in let st1 = skip-newlines st-fueled
   in if is-done st1 then ExprOk left st1
      else if min-col > 0 & (current st1).column > 0 & (current st1).column <= min-col then ExprOk left st1
   else let prec = operator-precedence (current-kind st1)
   in if prec < min-prec then ExprOk left st1
   else let op = current st1
   in let st2 = skip-newlines (advance st1)
   in let next-min = if is-right-assoc (op.kind) then prec else prec + 1
   in let right-result = parse-binary st2 next-min min-col
   in unwrap-expr-ok right-result (continue-binary left op min-prec min-col)

  continue-binary : Expr, Token, Integer, Integer, Expr, ParseState -> ParseExprResult
  continue-binary (left) (op) (min-prec) (min-col) (right) (st) =
   let st2 = if is-plus-plus (op.kind) then if bag-has-code (st.bag) cdx-deprecated-plus-plus then st
     else __record-set st "bag" (bag-add (st.bag) (make-deprecated cdx-deprecated-plus-plus "++ is deprecated; use & instead" (token-to-span op)))
     else st
   in parse-binary-loop (deck-record (BinExpr left op right)) st2 min-prec min-col

  parse-unary : ParseState -> ParseExprResult
  parse-unary (st) =
   if parse-fuel-exhausted st then ExprOk (ErrExpr (current st)) (emit-parse-fuel-error st "parse-unary")
   else let st0 = consume-parse-fuel st
   in if is-minus (current-kind st0) then let op = current st0
     in let result = parse-unary (advance st0)
     in unwrap-expr-ok result (finish-unary op)
    else parse-application st0

  finish-unary : Token, Expr, ParseState -> ParseExprResult
  finish-unary (op) (operand) (st) =
   ExprOk (deck-record (UnaryExpr op operand)) st

  parse-application : ParseState -> ParseExprResult
  parse-application (st) =
   let app-col = (current st).column
   in let func-result = parse-atom st
   in unwrap-expr-ok func-result (app-loop-start app-col)

  app-loop-start : Integer, Expr, ParseState -> ParseExprResult
  app-loop-start (app-col) (func) (st) = parse-app-loop app-col func st

  parse-app-loop : Integer, Expr, ParseState -> ParseExprResult
  parse-app-loop (app-col) (func) (st) =
   if parse-fuel-exhausted st then ExprOk func (emit-parse-fuel-error st "parse-app-loop")
   else let st-fueled = consume-parse-fuel st
   in if is-compound func then parse-dot-only func st-fueled
   else if is-done st-fueled then ExprOk func st-fueled
   else let st1 = if st-fueled.paren-depth > 0 then skip-newlines st-fueled else st-fueled
   in if is-app-start (current-kind st1) then
     let arg-result = parse-atom st1
     in unwrap-expr-ok arg-result (continue-app app-col func)
   else let st2 = check-multiline-app app-col func st1
   in parse-field-access func st2

  is-applied : Expr -> Boolean
  is-applied (e) = when e
   is AppExpr (f) (a) -> True
   is otherwise -> False

  check-multiline-app : Integer, Expr, ParseState -> ParseState
  check-multiline-app (app-col) (func) (st) =
   if st.paren-depth > 0 then st
   else if is-applied func == False then st
   else if st.pos == 0 then st
   else let peek-pos = skip-newlines-pos (st.tokens) (st.pos) (list-length (st.tokens))
   in if peek-pos == st.pos then st
   else if peek-pos >= list-length (st.tokens) - 1 then st
   else let next-tok = list-at (st.tokens) peek-pos
   in let last-tok = list-at (st.tokens) (st.pos - 1)
   in if is-left-paren (next-tok.kind) | is-left-bracket (next-tok.kind)
      then if next-tok.line > last-tok.line
           then let span = span-at (next-tok.line) (next-tok.column) (next-tok.offset) (next-tok.length) (next-tok.file-id)
                in __record-set st "bag" (bag-add (st.bag) (make-warning cdx-multiline-application ("Application ended at newline; '" & token-text next-tok & "' on line " & integer-to-text (next-tok.line) & " is not parsed as an argument (column " & integer-to-text (next-tok.column) & ", application started at column " & integer-to-text app-col & "). Place all arguments on one line or wrap in parentheses.") span))
           else st
      else st

  continue-app : Integer, Expr, Expr, ParseState -> ParseExprResult
  continue-app (app-col) (func) (arg) (st) =
   parse-app-loop app-col (deck-record (AppExpr func arg)) st

  parse-atom : ParseState -> ParseExprResult
  parse-atom (st) =
   if is-literal (current-kind st) then ExprOk (deck-record (LitExpr (current st))) (advance st)
   else if is-ident (current-kind st) & (token-text (current st)) == "for" then parse-for-expr st
   else if is-ident (current-kind st) then parse-field-access (deck-record (NameExpr (current st))) (advance st)
   else if is-type-ident (current-kind st) then parse-atom-type-ident st
   else if is-left-paren (current-kind st) then parse-paren-expr (advance st)
   else if is-left-bracket (current-kind st) then parse-list-expr st
   else if is-if-keyword (current-kind st) then parse-if-expr st
   else if is-let-keyword (current-kind st) then parse-let-expr st
   else if is-when-keyword (current-kind st) then parse-match-expr st
   else if is-act-keyword (current-kind st) then parse-act-expr st
   else if is-trying-keyword (current-kind st) then parse-try-expr st
   else if is-with-keyword (current-kind st) then parse-handle-expr st
   else if is-with-timeout-keyword (current-kind st) then parse-with-timeout-expr st
   else if is-backslash (current-kind st) then parse-lambda-expr st
   else if is-dot (current-kind st) then parse-selector-expr st
   else if is-lazy-keyword (current-kind st) then parse-lazy-expr st
              else ExprOk (ErrExpr (current st)) (advance st)

  parse-field-access : Expr, ParseState -> ParseExprResult
  parse-field-access (node) (st) =
   if parse-fuel-exhausted st then ExprOk node (emit-parse-fuel-error st "parse-field-access")
   else let st-fueled = consume-parse-fuel st
   in if is-dot (current-kind st-fueled) then let st2 = advance st-fueled
     in if is-field-name-token (current-kind st2) then let field = current st2
     in let st3 = advance st2
     in let fe = deck-record (FieldExpr node field)
     in if is-equals (current-kind st3) then finish-field-assign fe field st3
        else parse-field-access fe st3
        else ExprOk node st-fueled
    else ExprOk node st-fueled

  finish-field-assign : Expr, Token, ParseState -> ParseExprResult
  finish-field-assign (lhs) (field) (st) =
   let st2 = advance st
   in let rhs = parse-expr st2
   in unwrap-expr-ok rhs (make-field-assign lhs field)

  make-field-assign : Expr, Token, Expr, ParseState -> ParseExprResult
  make-field-assign (lhs) (field) (rhs) (st) =
   ExprOk (deck-record (FieldAssignExpr lhs field rhs)) st

  parse-dot-only : Expr, ParseState -> ParseExprResult
  parse-dot-only (node) (st) =
   if parse-fuel-exhausted st then ExprOk node (emit-parse-fuel-error st "parse-dot-only")
   else let st-fueled = consume-parse-fuel st
   in if is-dot (current-kind st-fueled) then let st2 = advance st-fueled
     in if is-field-name-token (current-kind st2) then let field = current st2
     in let st3 = advance st2
     in parse-dot-only (deck-record (FieldExpr node field)) st3
        else ExprOk node st-fueled
    else ExprOk node st-fueled

  parse-atom-type-ident : ParseState -> ParseExprResult
  parse-atom-type-ident (st) =
   let tok = current st
   in let st2 = advance st
   in if is-left-brace (current-kind st2) then
       let rec-result = parse-record-expr tok st2
       in unwrap-expr-ok rec-result parse-field-access
      else parse-field-access (deck-record (NameExpr tok)) st2

  parse-paren-expr : ParseState -> ParseExprResult
  parse-paren-expr (st) =
   let st2 = skip-newlines (enter-paren st)
   in let inner = parse-expr st2
   in unwrap-expr-ok inner finish-paren-or-tuple

  finish-paren-or-tuple : Expr, ParseState -> ParseExprResult
  finish-paren-or-tuple (first) (st) =
   let st1 = skip-newlines st
   in if is-comma (current-kind st1) then collect-tuple-elems (__linked-list-push [] first) (skip-newlines (advance st1))
   else finish-paren-expr first st

  collect-tuple-elems : LinkedList Expr, ParseState -> ParseExprResult
  collect-tuple-elems (acc) (st) =
   let e = parse-expr st
   in unwrap-expr-ok e (after-tuple-elem acc)

  after-tuple-elem : LinkedList Expr, Expr, ParseState -> ParseExprResult
  after-tuple-elem (acc) (e) (st) =
   let acc2 = __linked-list-push acc e
   in let st1 = skip-newlines st
   in if is-comma (current-kind st1) then collect-tuple-elems acc2 (skip-newlines (advance st1))
   else let st2 = expect RightParen st1
   in parse-field-access (deck-record (TupleExpr (deck-record (__linked-list-to-list acc2)))) (exit-paren st2)

  finish-paren-expr : Expr, ParseState -> ParseExprResult
  finish-paren-expr (e) (st) =
   let st2 = skip-newlines st
   in let st3 = expect RightParen st2
   in parse-field-access (deck-record (ParenExpr e)) (exit-paren st3)

Section: Compound Expression Parsing
  parse-record-expr : Token, ParseState -> ParseExprResult
  parse-record-expr (type-name) (st) =
   let st2 = advance st
   in let st3 = skip-newlines st2
   in parse-record-expr-fields type-name [] st3

  parse-record-expr-fields : Token, LinkedList RecordFieldExpr, ParseState -> ParseExprResult
  parse-record-expr-fields (type-name) (acc) (st) =
   let kind = current-kind st
   in if is-right-brace kind then ExprOk (deck-record (RecordExpr type-name (deck-record (__linked-list-to-list acc)))) (advance st)
      else if is-field-name-token kind then parse-record-field type-name acc st
      else ExprOk (deck-record (RecordExpr type-name (deck-record (__linked-list-to-list acc)))) (__record-set st "bag" (bag-add (st.bag) (make-error cdx-bad-field-syntax "Expected field name in record literal" (token-to-span (current st)))))

  parse-record-field : Token, LinkedList RecordFieldExpr, ParseState -> ParseExprResult
  parse-record-field (type-name) (acc) (st) =
   let field-name = current st
   in let st2 = advance st
   in let st3 = expect Equals st2
   in let val-result = parse-expr st3
   in unwrap-expr-ok val-result (finish-record-field type-name acc field-name)

  finish-record-field : Token, LinkedList RecordFieldExpr, Token, Expr, ParseState -> ParseExprResult
  finish-record-field (type-name) (acc) (field-name) (v) (st) =
   let field = deck-record (RecordFieldExpr {
    name = field-name,
    value = v
   })
   in let st2 = skip-newlines st
   in if is-comma (current-kind st2) then parse-record-expr-fields type-name (__linked-list-push acc field) (skip-newlines (advance st2))
      else parse-record-expr-fields type-name (__linked-list-push acc field) st2

  parse-list-expr : ParseState -> ParseExprResult
  parse-list-expr (st) =
   let st2 = advance st
   in let st3 = skip-newlines st2
   in parse-list-elements [] st3

  parse-list-elements : LinkedList Expr, ParseState -> ParseExprResult
  parse-list-elements (acc) (st) =
   if is-right-bracket (current-kind st) then ExprOk (deck-record (ListExpr (deck-record (__linked-list-to-list acc)))) (advance st)
   else if is-done st then ExprOk (deck-record (ListExpr (deck-record (__linked-list-to-list acc)))) (__record-set st "bag" (bag-add (st.bag) (make-error cdx-list-no-close "Unclosed list literal: expected ']' before end of input" (token-to-span (current st)))))
   else let elem = parse-expr st
   in unwrap-expr-ok elem (finish-list-element acc)

  finish-list-element : LinkedList Expr, Expr, ParseState -> ParseExprResult
  finish-list-element (acc) (e) (st) =
   let st2 = skip-newlines st
   in if is-comma (current-kind st2) then parse-list-elements (__linked-list-push acc e) (skip-newlines (advance st2))
      else if is-right-bracket (current-kind st2) then parse-list-elements (__linked-list-push acc e) st2
      else ExprOk (deck-record (ListExpr (deck-record (__linked-list-to-list (__linked-list-push acc e))))) (__record-set st2 "bag" (bag-add (st2.bag) (make-error cdx-list-no-close "Unclosed list literal: expected ',' or ']'" (token-to-span (current st2)))))

  parse-if-expr : ParseState -> ParseExprResult
  parse-if-expr (st) =
   let st2 = skip-newlines (advance st)
   in let cond = parse-expr st2
   in unwrap-expr-ok cond parse-if-then

  parse-if-then : Expr, ParseState -> ParseExprResult
  parse-if-then (c) (st) =
   let st2 = skip-newlines st
   in let st3 = expect-coded ThenKeyword cdx-if-no-then "Expected 'then' in if expression" st2
   in let st4 = skip-newlines st3
   in let then-result = parse-expr st4
   in unwrap-expr-ok then-result (parse-if-else c)

  parse-if-else : Expr, Expr, ParseState -> ParseExprResult
  parse-if-else (c) (t) (st) =
   let st2 = skip-newlines st
   in let st3 = expect-coded ElseKeyword cdx-if-no-else "Expected 'else' in if expression" st2
   in let st4 = skip-newlines st3
   in let else-result = parse-expr st4
   in unwrap-expr-ok else-result (finish-if c t)

  finish-if : Expr, Expr, Expr, ParseState -> ParseExprResult
  finish-if (c) (t) (e) (st) = ExprOk (deck-record (IfExpr c t e)) st

  parse-let-expr : ParseState -> ParseExprResult
  parse-let-expr (st) =
   let st2 = skip-newlines (advance st)
   in parse-let-bindings [] st2

  parse-let-bindings : LinkedList LetBind, ParseState -> ParseExprResult
  parse-let-bindings (acc) (st) =
   if is-left-paren (current-kind st) then parse-let-pattern-binding acc (advance st)
   else if is-ident (current-kind st) then parse-let-binding acc st
   else if is-reserved-keyword-let-name st then parse-let-binding acc (report-reserved-keyword "a let-binding name" st)
   else if is-in-keyword (current-kind st) then let st2 = skip-newlines (advance st)
      in let body = parse-let-body st2
      in unwrap-expr-ok body (finish-let acc)
     else let st-err = __record-set st "bag" (bag-add (st.bag) (make-error cdx-let-no-in "Expected 'in' after let bindings" (token-to-span (current st))))
     in let body = parse-let-body st-err
     in unwrap-expr-ok body (finish-let acc)

  parse-let-body : ParseState -> ParseExprResult
  parse-let-body (st) =
   let r = parse-expr st
   in unwrap-expr-ok r continue-let-seq

  continue-let-seq : Expr, ParseState -> ParseExprResult
  continue-let-seq (stmt) (st) =
   if is-field-assign-expr stmt then
     let st1 = skip-newlines st
     in if is-in-keyword (current-kind st1) then let st2 = skip-newlines (advance st1)
       in let rest = parse-let-body st2
       in unwrap-expr-ok rest (make-stmt-seq stmt)
      else ExprOk stmt st
   else ExprOk stmt st

  is-field-assign-expr : Expr -> Boolean
  is-field-assign-expr (e) =
   when e
    is FieldAssignExpr (l) (f) (r) -> True
    is otherwise -> False

  make-stmt-seq : Expr, Expr, ParseState -> ParseExprResult
  make-stmt-seq (stmt) (rest) (st) =
   ExprOk (deck-record (SeqExpr stmt rest)) st

  parse-def-body-seq : ParseState, Integer -> ParseExprResult
  parse-def-body-seq (st) (min-col) =
   let r = parse-expr-col st min-col
   in unwrap-expr-ok r (continue-def-seq min-col)

  continue-def-seq : Integer, Expr, ParseState -> ParseExprResult
  continue-def-seq (min-col) (stmt) (st) =
   if is-field-assign-expr stmt then
     let st1 = skip-newlines st
     in if is-done st1 then ExprOk stmt st
        else if (current st1).column > min-col then let rest-r = parse-def-body-seq st1 min-col
          in unwrap-expr-ok rest-r (make-stmt-seq stmt)
        else ExprOk stmt st
   else ExprOk stmt st

  is-reserved-keyword-let-name : ParseState -> Boolean
  is-reserved-keyword-let-name (st) =
   if is-reserved-keyword (current-kind st) then is-equals (peek-kind st 1)
   else False

  finish-let : LinkedList LetBind, Expr, ParseState -> ParseExprResult
  finish-let (acc) (b) (st) = ExprOk (deck-record (LetExpr (deck-record (__linked-list-to-list acc)) b)) st

  parse-let-binding : LinkedList LetBind, ParseState -> ParseExprResult
  parse-let-binding (acc) (st) =
   let name-tok = current st
   in let st2 = advance st
   in let st3 = expect Equals st2
   in let val-result = parse-expr st3
   in unwrap-expr-ok val-result (finish-let-binding acc name-tok)

  finish-let-binding : LinkedList LetBind, Token, Expr, ParseState -> ParseExprResult
  finish-let-binding (acc) (name-tok) (v) (st) =
   let binding = deck-record (LetBind {
    name = name-tok,
    value = v
   })
   in let st2 = skip-newlines st
   in if is-comma (current-kind st2) then parse-let-bindings (__linked-list-push acc binding) (skip-newlines (advance st2))
      else parse-let-bindings (__linked-list-push acc binding) st2

  parse-let-pattern-binding : LinkedList LetBind, ParseState -> ParseExprResult
  parse-let-pattern-binding (acc) (st) =
   let pr = parse-tuple-pattern st
   in unwrap-pat-for-expr pr (after-let-pattern acc)

  after-let-pattern : LinkedList LetBind, Pat, ParseState -> ParseExprResult
  after-let-pattern (acc) (pat) (st) =
   let st2 = expect Equals st
   in let vr = parse-expr st2
   in unwrap-expr-ok vr (after-let-pattern-value acc pat)

  after-let-pattern-value : LinkedList LetBind, Pat, Expr, ParseState -> ParseExprResult
  after-let-pattern-value (acc) (pat) (val) (st) =
   let st1 = skip-newlines st
   in if is-in-keyword (current-kind st1)
      then let st2 = skip-newlines (advance st1)
        in let body-r = parse-let-body st2
        in unwrap-expr-ok body-r (finish-let-pattern acc pat val)
      else let st-err = __record-set st1 "bag" (bag-add (st1.bag) (make-error cdx-let-no-in "Expected 'in' after let bindings" (token-to-span (current st1))))
        in let body-r = parse-let-body st-err
        in unwrap-expr-ok body-r (finish-let-pattern acc pat val)

  finish-let-pattern : LinkedList LetBind, Pat, Expr, Expr, ParseState -> ParseExprResult
  finish-let-pattern (acc) (pat) (val) (body) (st) =
   let arm = deck-record (MatchArm { pattern = pat, body = body, guard = make-true-guard st })
   in let m = deck-record (MatchExpr val (deck-record [arm]))
   in let binds = deck-record (__linked-list-to-list acc)
   in if list-length binds == 0 then ExprOk m st
      else ExprOk (deck-record (LetExpr binds m)) st

  parse-match-expr : ParseState -> ParseExprResult
  parse-match-expr (st) =
   let st2 = advance st
   in let scrut = parse-expr st2
   in unwrap-expr-ok scrut start-match-branches

  start-match-branches : Expr, ParseState -> ParseExprResult
  start-match-branches (s) (st) =
   let st2 = skip-newlines st
   in let tok = current st2
   in parse-match-branches s [] (tok.column) (tok.line) st2

  parse-match-branches : Expr, LinkedList MatchArm, Integer, Integer, ParseState -> ParseExprResult
  parse-match-branches (scrut) (acc) (col) (ln) (st) =
   let tok = current st
   in if is-match-arm-start (current-kind st) & (tok.line == ln | tok.column == col)
      then parse-one-match-branch scrut acc col ln st
      else ExprOk (deck-record (MatchExpr scrut (deck-record (__linked-list-to-list acc)))) st

  unwrap-pat-for-expr : ParsePatResult, (Pat -> ParseState -> ParseExprResult) -> ParseExprResult
  unwrap-pat-for-expr (r) (f) =
   when r
    is PatOk (p) (st) -> f p st

  parse-one-match-branch : Expr, LinkedList MatchArm, Integer, Integer, ParseState -> ParseExprResult
  parse-one-match-branch (scrut) (acc) (col) (ln) (st) =
   let st2 = advance st
   in let pat = parse-pattern st2
   in unwrap-pat-for-expr pat (parse-match-branch-body scrut acc col ln)

  parse-match-branch-body : Expr, LinkedList MatchArm, Integer, Integer, Pat, ParseState -> ParseExprResult
  parse-match-branch-body (scrut) (acc) (col) (ln) (p) (st) =
   if is-pipe (current-kind st)
   then collect-alt-patterns scrut acc col ln (__linked-list-push [] p) st
   else if is-when-keyword (current-kind st)
   then let st2 = advance st
        in let gp = extract-guard-pair (parse-expr st2)
        in let st3 = expect-coded Arrow cdx-match-no-arrow "Expected '->' after guard" (gp.state)
        in let st4 = skip-newlines st3
        in let bp = extract-guard-pair (parse-expr-col st4 col)
        in let arm = deck-record (MatchArm { pattern = p, body = bp.expr, guard = gp.expr })
        in let st5 = skip-newlines (bp.state)
        in parse-match-branches scrut (__linked-list-push acc arm) col ln st5
   else let st2 = expect-coded Arrow cdx-match-no-arrow "Expected '->' in match arm" st
        in let st3 = skip-newlines st2
        in let body = parse-expr-col st3 col
        in unwrap-expr-ok body (finish-match-branch scrut acc col ln p)

  collect-alt-patterns : Expr, LinkedList MatchArm, Integer, Integer, LinkedList Pat, ParseState -> ParseExprResult
  collect-alt-patterns (scrut) (acc) (col) (ln) (pats) (st) =
   let st2 = skip-newlines (advance st)
   in if is-arrow (current-kind st2)
      then let tok = current st2
           in let st3 = __record-set st2 "bag" (bag-add (st2.bag) (make-error cdx-match-no-arrow ("Expected pattern after '|' in match arm (got '" & (token-text tok) & "')") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))
           in let st4 = skip-newlines (advance st3)
           in let body = parse-expr-col st4 col
           in unwrap-expr-ok body (finish-alt-match scrut acc col ln pats)
      else let pat-result = parse-pattern st2
           in unwrap-pat-for-expr pat-result (after-alt-pattern scrut acc col ln pats)

  after-alt-pattern : Expr, LinkedList MatchArm, Integer, Integer, LinkedList Pat, Pat, ParseState -> ParseExprResult
  after-alt-pattern (scrut) (acc) (col) (ln) (pats) (p) (st) =
   let pats2 = __linked-list-push pats p
   in if is-pipe (current-kind st)
      then collect-alt-patterns scrut acc col ln pats2 st
      else if is-when-keyword (current-kind st)
      then let st2 = advance st
           in let gp = extract-guard-pair (parse-expr st2)
           in let st3 = expect-coded Arrow cdx-match-no-arrow "Expected '->' after guard" (gp.state)
           in let st4 = skip-newlines st3
           in let bp = extract-guard-pair (parse-expr-col st4 col)
           in let pat-list = deck-record (__linked-list-to-list pats2)
           in let acc2 = push-alt-arms acc pat-list (bp.expr) (gp.expr) 0 (list-length pat-list)
           in let st5 = skip-newlines (bp.state)
           in parse-match-branches scrut acc2 col ln st5
      else let st2 = expect-coded Arrow cdx-match-no-arrow "Expected '->' in match arm" st
           in let st3 = skip-newlines st2
           in let body = parse-expr-col st3 col
           in unwrap-expr-ok body (finish-alt-match scrut acc col ln pats2)

  finish-alt-match : Expr, LinkedList MatchArm, Integer, Integer, LinkedList Pat, Expr, ParseState -> ParseExprResult
  finish-alt-match (scrut) (acc) (col) (ln) (pats) (b) (st) =
   let pat-list = deck-record (__linked-list-to-list pats)
   in let g = make-true-guard st
   in let acc2 = push-alt-arms acc pat-list b g 0 (list-length pat-list)
   in let st2 = skip-newlines st
   in parse-match-branches scrut acc2 col ln st2

  GuardPair = record {
   expr : Expr,
   state : ParseState
  }

  extract-guard-pair : ParseExprResult -> GuardPair
  extract-guard-pair (r) =
   when r
    is ExprOk (e) (st) -> GuardPair { expr = e, state = st }

  make-true-guard : ParseState -> Expr
  make-true-guard (st) =
   let tok = current st
   in deck-record (LitExpr (deck-record (Token { kind = deck-record TrueKeyword, source = "True", offset = 0, length = 4, line = tok.line, column = tok.column, file-id = tok.file-id })))

  push-alt-arms : LinkedList MatchArm, List Pat, Expr, Expr, Integer, Integer -> LinkedList MatchArm
  push-alt-arms (acc) (pats) (b) (g) (i) (len) =
   if i >= len then acc
   else let arm = deck-record (MatchArm {
         pattern = list-at pats i,
         body = b,
         guard = g
        })
        in push-alt-arms (__linked-list-push acc arm) pats b g (i + 1) len

  finish-match-branch : Expr, LinkedList MatchArm, Integer, Integer, Pat, Expr, ParseState -> ParseExprResult
  finish-match-branch (scrut) (acc) (col) (ln) (p) (b) (st) =
   let arm = deck-record (MatchArm {
    pattern = p,
    body = b,
    guard = make-true-guard st
   })
   in let st2 = skip-newlines st
   in parse-match-branches scrut (__linked-list-push acc arm) col ln st2

  looks-like-top-level-def : ParseState -> Boolean
  looks-like-top-level-def (st) =
   if is-ident (current-kind st) | is-type-ident (current-kind st) then is-colon (peek-kind st 1)
   else False

  is-act-bind : ParseState -> Boolean
  is-act-bind (st) =
   if is-ident (current-kind st) then is-left-arrow (peek-kind st 1)
   else False

  parse-act-expr : ParseState -> ParseExprResult
  parse-act-expr (st) =
   let st2 = skip-newlines (advance st)
   in parse-act-stmts [] st2

  parse-act-stmts : LinkedList ActStmt, ParseState -> ParseExprResult
  parse-act-stmts (acc) (st) =
   if is-done st then ExprOk (deck-record (ActExpr (deck-record (__linked-list-to-list acc)))) st
   else if is-end-keyword (current-kind st) then let acc-list = deck-record (__linked-list-to-list acc)
        in if list-length acc-list == 0
        then ExprOk (deck-record (ActExpr acc-list)) (advance (__record-set st "bag" (bag-add (st.bag) (make-error cdx-empty-act "Empty act block: 'act end' must contain at least one statement" (token-to-span (current st))))))
        else ExprOk (deck-record (ActExpr acc-list)) (advance st)
     else if is-act-bind st then parse-act-bind-stmt acc st
      else parse-act-expr-stmt acc st

  parse-act-bind-stmt : LinkedList ActStmt, ParseState -> ParseExprResult
  parse-act-bind-stmt (acc) (st) =
   let name-tok = current st
   in let st2 = advance (advance st)
   in let val-result = parse-expr st2
   in unwrap-expr-ok val-result (finish-act-bind acc name-tok)

  finish-act-bind : LinkedList ActStmt, Token, Expr, ParseState -> ParseExprResult
  finish-act-bind (acc) (name-tok) (v) (st) =
   let st2 = skip-newlines st
   in parse-act-stmts (__linked-list-push acc (deck-record (ActBindStmt name-tok v))) st2

  parse-act-expr-stmt : LinkedList ActStmt, ParseState -> ParseExprResult
  parse-act-expr-stmt (acc) (st) =
   let expr-result = parse-expr st
   in unwrap-expr-ok expr-result (finish-act-expr acc)

  finish-act-expr : LinkedList ActStmt, Expr, ParseState -> ParseExprResult
  finish-act-expr (acc) (e) (st) =
   let st2 = skip-newlines st
   in parse-act-stmts (__linked-list-push acc (deck-record (ActExprStmt e))) st2

  is-ident-text : ParseState, Text -> Boolean
  is-ident-text (st) (txt) =
   if is-ident (current-kind st) then token-text (current st) == txt
   else False

  parse-try-expr : ParseState -> ParseExprResult
  parse-try-expr (st) =
   let st1 = skip-newlines (advance st)
   in if is-literal (current-kind st1) then let count-tok = current st1
     in let st2 = skip-newlines (advance st1)
     in let st3 = if is-ident-text st2 "times" then skip-newlines (advance st2)
       else __record-set st2 "bag" (bag-add (st2.bag) (make-error cdx-empty-act "Expected 'times' after attempt count in trying expression" (token-to-span (current st2))))
     in parse-try-body count-tok [] st3
     else ExprOk (deck-record (ErrExpr (current st1))) (advance st1)

  parse-try-body : Token, LinkedList ActStmt, ParseState -> ParseExprResult
  parse-try-body (count-tok) (acc) (st) =
   if is-done st then finish-try count-tok acc [] [] st
   else if is-end-keyword (current-kind st) then finish-try count-tok acc [] [] (advance st)
   else if is-ident-text st "falling" then let st2 = skip-newlines (advance st)
     in let st3 = if is-ident-text st2 "back" then skip-newlines (advance st2)
       else __record-set st2 "bag" (bag-add (st2.bag) (make-error cdx-empty-act "Expected 'back to' after 'falling'" (token-to-span (current st2))))
     in let st4 = if is-ident-text st3 "to" then skip-newlines (advance st3)
       else __record-set st3 "bag" (bag-add (st3.bag) (make-error cdx-empty-act "Expected 'to' after 'falling back'" (token-to-span (current st3))))
     in parse-try-fallback count-tok acc [] st4
   else if is-ident-text st "on" then let peek-st = advance st
     in if is-ident-text peek-st "failure" then let st2 = skip-newlines (advance peek-st)
       in parse-try-failure count-tok acc [] [] st2
       else parse-try-stmt count-tok acc st
   else parse-try-stmt count-tok acc st

  parse-try-stmt : Token, LinkedList ActStmt, ParseState -> ParseExprResult
  parse-try-stmt (count-tok) (acc) (st) =
   if is-act-bind st then let name-tok = current st
     in let st2 = advance (advance st)
     in let val-result = parse-expr st2
     in unwrap-expr-ok val-result (finish-try-bind count-tok acc name-tok)
   else let expr-result = parse-expr st
     in unwrap-expr-ok expr-result (finish-try-expr-stmt count-tok acc)

  finish-try-bind : Token, LinkedList ActStmt, Token, Expr, ParseState -> ParseExprResult
  finish-try-bind (count-tok) (acc) (name-tok) (v) (st) =
   let st2 = skip-newlines st
   in parse-try-body count-tok (__linked-list-push acc (deck-record (ActBindStmt name-tok v))) st2

  finish-try-expr-stmt : Token, LinkedList ActStmt, Expr, ParseState -> ParseExprResult
  finish-try-expr-stmt (count-tok) (acc) (e) (st) =
   let st2 = skip-newlines st
   in parse-try-body count-tok (__linked-list-push acc (deck-record (ActExprStmt e))) st2

  parse-try-fallback : Token, LinkedList ActStmt, LinkedList ActStmt, ParseState -> ParseExprResult
  parse-try-fallback (count-tok) (body-acc) (fb-acc) (st) =
   if is-done st then finish-try count-tok body-acc fb-acc [] st
   else if is-end-keyword (current-kind st) then finish-try count-tok body-acc fb-acc [] (advance st)
   else if is-ident-text st "on" then let peek-st = advance st
     in if is-ident-text peek-st "failure" then let st2 = skip-newlines (advance peek-st)
       in parse-try-failure count-tok body-acc fb-acc [] st2
       else parse-try-fallback-stmt count-tok body-acc fb-acc st
   else parse-try-fallback-stmt count-tok body-acc fb-acc st

  parse-try-fallback-stmt : Token, LinkedList ActStmt, LinkedList ActStmt, ParseState -> ParseExprResult
  parse-try-fallback-stmt (count-tok) (body-acc) (fb-acc) (st) =
   if is-act-bind st then let name-tok = current st
     in let st2 = advance (advance st)
     in let val-result = parse-expr st2
     in unwrap-expr-ok val-result (finish-try-fb-bind count-tok body-acc fb-acc name-tok)
   else let expr-result = parse-expr st
     in unwrap-expr-ok expr-result (finish-try-fb-expr count-tok body-acc fb-acc)

  finish-try-fb-bind : Token, LinkedList ActStmt, LinkedList ActStmt, Token, Expr, ParseState -> ParseExprResult
  finish-try-fb-bind (count-tok) (body-acc) (fb-acc) (name-tok) (v) (st) =
   let st2 = skip-newlines st
   in parse-try-fallback count-tok body-acc (__linked-list-push fb-acc (deck-record (ActBindStmt name-tok v))) st2

  finish-try-fb-expr : Token, LinkedList ActStmt, LinkedList ActStmt, Expr, ParseState -> ParseExprResult
  finish-try-fb-expr (count-tok) (body-acc) (fb-acc) (e) (st) =
   let st2 = skip-newlines st
   in parse-try-fallback count-tok body-acc (__linked-list-push fb-acc (deck-record (ActExprStmt e))) st2

  parse-try-failure : Token, LinkedList ActStmt, LinkedList ActStmt, LinkedList ActStmt, ParseState -> ParseExprResult
  parse-try-failure (count-tok) (body-acc) (fb-acc) (fail-acc) (st) =
   if is-done st then finish-try count-tok body-acc fb-acc fail-acc st
   else if is-end-keyword (current-kind st) then finish-try count-tok body-acc fb-acc fail-acc (advance st)
   else if is-act-bind st then let name-tok = current st
     in let st2 = advance (advance st)
     in let val-result = parse-expr st2
     in unwrap-expr-ok val-result (finish-try-fail-bind count-tok body-acc fb-acc fail-acc name-tok)
   else let expr-result = parse-expr st
     in unwrap-expr-ok expr-result (finish-try-fail-expr count-tok body-acc fb-acc fail-acc)

  finish-try-fail-bind : Token, LinkedList ActStmt, LinkedList ActStmt, LinkedList ActStmt, Token, Expr, ParseState -> ParseExprResult
  finish-try-fail-bind (count-tok) (body-acc) (fb-acc) (fail-acc) (name-tok) (v) (st) =
   let st2 = skip-newlines st
   in parse-try-failure count-tok body-acc fb-acc (__linked-list-push fail-acc (deck-record (ActBindStmt name-tok v))) st2

  finish-try-fail-expr : Token, LinkedList ActStmt, LinkedList ActStmt, LinkedList ActStmt, Expr, ParseState -> ParseExprResult
  finish-try-fail-expr (count-tok) (body-acc) (fb-acc) (fail-acc) (e) (st) =
   let st2 = skip-newlines st
   in parse-try-failure count-tok body-acc fb-acc (__linked-list-push fail-acc (deck-record (ActExprStmt e))) st2

  finish-try : Token, LinkedList ActStmt, LinkedList ActStmt, LinkedList ActStmt, ParseState -> ParseExprResult
  finish-try (count-tok) (body-acc) (fb-acc) (fail-acc) (st) =
   let body-list = deck-record (__linked-list-to-list body-acc)
   in let fb-list = deck-record (__linked-list-to-list fb-acc)
   in let fail-list = deck-record (__linked-list-to-list fail-acc)
   in ExprOk (deck-record (TryExpr count-tok body-list fb-list fail-list)) st

  parse-handle-expr : ParseState -> ParseExprResult
  parse-handle-expr (st) =
   let st1 = advance st
   in let eff-tok = current st1
   in let st2 = advance st1
   in let body-result = parse-expr st2
   in unwrap-expr-ok body-result (finish-handle-body eff-tok)

  finish-handle-body : Token, Expr, ParseState -> ParseExprResult
  finish-handle-body (eff-tok) (body) (st) =
   let st2 = skip-newlines st
   in let clauses = parse-handle-clauses st2 []
   in ExprOk (deck-record (HandleExpr eff-tok body (clauses.clauses))) (clauses.state)

  HandleParseResult = record { clauses : List HandleClause, state : ParseState }

  parse-handle-clauses : ParseState, LinkedList HandleClause -> HandleParseResult
  parse-handle-clauses (st) (acc) =
   if is-ident (current-kind st) then let op-tok = current st
     in let st1 = advance st
     in let all-params = parse-handle-params st1 []
     in let all-params-list = deck-record (__linked-list-to-list (all-params.toks))
     in if list-length all-params-list > 0 then let resume-tok = list-at all-params-list (list-length all-params-list - 1)
          in let arg-params = take-tokens all-params-list (list-length all-params-list - 1) 0 []
          in let st5 = expect Equals (all-params.state)
          in let st6 = skip-newlines st5
          in let body-result = parse-expr st6
          in unwrap-handle-clause-body op-tok (deck-record (__linked-list-to-list arg-params)) resume-tok body-result acc
        else HandleParseResult {
         clauses = deck-record (__linked-list-to-list acc),
         state = st
        }
   else HandleParseResult {
    clauses = deck-record (__linked-list-to-list acc),
    state = st
   }

  take-tokens : List Token, Integer, Integer, LinkedList Token -> LinkedList Token
  take-tokens (toks) (n) (i) (acc) =
   if i >= n then acc
   else take-tokens toks n (i + 1) (__linked-list-push acc (list-at toks i))

  HandleParamsResult = record { toks : LinkedList Token, state : ParseState }

  parse-handle-params : ParseState, LinkedList Token -> HandleParamsResult
  parse-handle-params (st) (acc) =
   if is-left-paren (current-kind st) then let st1 = advance st
     in let tok = current st1
     in let st2 = advance st1
     in let st3 = expect RightParen st2
     in parse-handle-params st3 (__linked-list-push acc tok)
    else HandleParamsResult {
     toks = acc,
     state = st
    }

  unwrap-handle-clause-body : Token, List Token, Token, ParseExprResult, LinkedList HandleClause -> HandleParseResult
  unwrap-handle-clause-body (op-tok) (arg-params) (resume-tok) (result) (acc) =
   when result
    is ExprOk (body) (st) ->
     let clause = deck-record (HandleClause {
      op-name = op-tok,
      params = arg-params,
      resume-name = resume-tok,
      body = body
     })
     in let st2 = skip-newlines st
     in parse-handle-clauses st2 (__linked-list-push acc clause)

  parse-with-timeout-expr : ParseState -> ParseExprResult
  parse-with-timeout-expr (st) =
   let st1 = advance st
   in let timeout-tok = current st1
   in let st2 = advance st1
   in let st3 = expect LeftBracket st2
   in let (eff-names, st-effs, eff-scopes) = parse-effect-names st3 [] []
   in let body-result = parse-expr st-effs
   in unwrap-expr-ok body-result (finish-with-timeout timeout-tok eff-names eff-scopes)

  finish-with-timeout : Token, List Token, List Token, Expr, ParseState -> ParseExprResult
  finish-with-timeout (timeout-tok) (effs) (scopes) (body) (st) =
   ExprOk (deck-record (WithTimeoutExpr timeout-tok effs scopes body)) st

  parse-lambda-expr : ParseState -> ParseExprResult
  parse-lambda-expr (st) =
   let st2 = advance st
   in let params-result = collect-lambda-params st2 []
   in let st3 = expect Arrow (params-result.state)
   in let st4 = skip-newlines st3
   in let body = parse-expr st4
   in unwrap-expr-ok body (finish-lambda (deck-record (__linked-list-to-list (params-result.toks))))

  LambdaParamsResult = record { toks : LinkedList Token, state : ParseState }

  collect-lambda-params : ParseState, LinkedList Token -> LambdaParamsResult
  collect-lambda-params (st) (acc) =
   if is-ident (current-kind st) then let tok = current st
     in collect-lambda-params (advance st) (__linked-list-push acc tok)
    else LambdaParamsResult {
     toks = acc,
     state = st
    }

  finish-lambda : List Token, Expr, ParseState -> ParseExprResult
  finish-lambda (params) (body) (st) =
   ExprOk (deck-record (LambdaExpr params body)) st

  parse-selector-expr : ParseState -> ParseExprResult
  parse-selector-expr (st) =
   let dot-tok = current st
   in let st2 = advance st
   in if is-field-name-token (current-kind st2) then let field = current st2
     in let st3 = advance st2
     in let param = deck-record (Token { kind = Identifier, source = "__r", offset = 0, length = 3, line = dot-tok.line, column = dot-tok.column, file-id = dot-tok.file-id })
     in let param-ref = deck-record (NameExpr param)
     in let access = deck-record (FieldExpr param-ref field)
     in ExprOk (deck-record (LambdaExpr [param] access)) st3
     else ExprOk (ErrExpr (current st)) st

  parse-lazy-expr : ParseState -> ParseExprResult
  parse-lazy-expr (st) =
   let st2 = advance st
   in let inner = parse-atom st2
   in unwrap-expr-ok inner finish-lazy

  finish-lazy : Expr, ParseState -> ParseExprResult
  finish-lazy (inner) (st) = ExprOk (deck-record (LazyExpr inner)) st

  parse-for-expr : ParseState -> ParseExprResult
  parse-for-expr (st) =
   let st1 = advance st
   in let var-tok = current st1
   in let st2 = advance st1
   in if is-in-keyword (current-kind st2) then let st3 = advance st2
     in let list-result = parse-expr st3
     in unwrap-expr-ok list-result (finish-for-list var-tok)
   else ExprOk (deck-record (ErrExpr var-tok)) st2

  finish-for-list : Token, Expr, ParseState -> ParseExprResult
  finish-for-list (var-tok) (list-expr) (st) =
   if is-arrow (current-kind st) then let st2 = advance st
     in let body-result = parse-expr st2
     in unwrap-expr-ok body-result (finish-for-body var-tok list-expr)
   else ExprOk (deck-record (ErrExpr var-tok)) st

  finish-for-body : Token, Expr, Expr, ParseState -> ParseExprResult
  finish-for-body (var-tok) (list-expr) (body) (st) =
   ExprOk (deck-record (ForExpr var-tok list-expr body)) st

