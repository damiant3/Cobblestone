    is otherwise -> False

 A minus that touches the token after it is a negation and begins an
 argument; one with a space on both sides is subtraction. `f a -2` and
 `f a - 2` carry the identical three token KINDS, so nothing but the source
 offsets can tell them apart, exactly as is-signed-literal-atom found for
 types. The lexer has already resolved the other two spacings: `a-2` and
 `a-` arrive as single identifiers and never reach this test.

  is-abutted-negation : ParseState -> Boolean
  is-abutted-negation (st) =
   if is-minus (current-kind st) then
    if is-app-start (peek-kind st 1)
    then (list-at (st.tokens) (st.pos + 1)).offset == (current st).offset + 1
    else False
   else False

  is-compound : Expr -> Boolean
  is-compound (e) =
   when e
    is MatchExpr (s) (arms) | IfExpr (c) (t) (el) | LetExpr (binds) (body) | ActExpr (stmts) | FieldAssignExpr (l) (f) (r) | SeqExpr (a) (b) | LambdaExpr (ltok) (ps) (bd) | ForExpr (v) (l) (b) -> True
    is otherwise -> False

  is-type-arg-start : TokenKind -> Boolean
  is-type-arg-start (k) =
   when k
    is TypeIdentifier | Identifier | LeftParen | IntegerLiteral -> True
    is otherwise -> False

 `xor` SITS BETWEEN `or` AND `and`, which is the conventional ordering and the
 one a reader assumes rather than checks: `a and b xor c or d` groups as
 `((a and b) xor c) or d`. Inserting it shifted every level above it up by one;
 the ORDER is what matters and not the numbers, which are internal.

 The keyword forms share a level with the symbol they join, `and` with `&` and
 `or` with `|`, so a file mixing the two spellings groups the same way it
 would if it used one throughout.

  operator-precedence : TokenKind -> Integer
  operator-precedence (k) =
   when k
    is ColonColon -> 6
    is Plus | Minus -> 7
    is Star | Slash -> 8
    is Caret -> 9
    is DoubleEquals | NotEquals | LessThan | GreaterThan | LessOrEqual | GreaterOrEqual | TripleEquals | Tilde | TildeZero -> 5
    is Ampersand | AndKeyword -> 4
    is XorKeyword -> 3
    is Pipe | OrKeyword -> 2
    is PipeForward -> 1
    is otherwise -> -1

  is-right-assoc : TokenKind -> Boolean
  is-right-assoc (k) =
   when k
    is ColonColon | Caret | Arrow -> True
    is otherwise -> False

Section: Token Helpers
  expect : TokenKind, ParseState -> ParseState
  expect (kind) (st) =
   if is-done st then st
   else if current-kind st == kind then advance st
   else let tok = current st
   in __record-set st "bag" (bag-add (st.bag) (make-error cdx-expected-token-kind ("Expected token kind mismatch, got '" & (token-text tok) & "'") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))

  expect-coded : TokenKind, Integer between 0 and 65535, Text, ParseState -> ParseState
  expect-coded (kind) (code) (msg) (st) =
   if is-done st then st
   else if current-kind st == kind then advance st
   else let tok = current st
   in __record-set st "bag" (bag-add (st.bag) (make-error code (msg & " (got '" & (token-text tok) & "')") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))

  report-reserved-keyword : Text, ParseState -> ParseState
  report-reserved-keyword (context) (st) =
   let tok = current st
   in __record-set st "bag" (bag-add (st.bag) (make-error cdx-reserved-keyword-as-identifier ("'" & (token-text tok) & "' is a reserved keyword and cannot be used as " & context & "; rename it") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))

  skip-newlines-pos : List Token, Integer between 0 and 4294967295, Integer -> Integer between 0 and 4294967295
  skip-newlines-pos (tokens) (pos) (len) =
   if pos >= len - 1 then pos
   else let kind = (list-at tokens pos).kind
   in when kind
     is Newline | Indent | Dedent -> skip-newlines-pos tokens (pos + 1) len
     is otherwise -> pos

  skip-newlines : ParseState -> ParseState
  skip-newlines (st) =
   let end-pos = skip-newlines-pos (st.tokens) (st.pos) (list-length (st.tokens))
   in if end-pos == st.pos then st
      else __record-set st "pos" end-pos

