    is Dot -> True
    is otherwise -> False

  is-text-lit : TokenKind -> Boolean
  is-text-lit (k) =
   when k
    is TextLiteral -> True
    is otherwise -> False

  is-left-paren : TokenKind -> Boolean
  is-left-paren (k) =
   when k
    is LeftParen -> True
    is otherwise -> False

  is-left-brace : TokenKind -> Boolean
  is-left-brace (k) =
