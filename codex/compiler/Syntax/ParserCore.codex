Chapter: Parser
  cites Codex chapter Build Settings (max-parse-fuel, max-parse-stall)

  cites Foreword chapter Maybe

Section: Parser State

  ParseState = record {
   tokens : List Token,
   pos : Integer between 0 and 4294967295,
   bag : DiagnosticBag,
   paren-depth : Integer between 0 and 65535,
   fuel : Integer,
   stall-pos : Integer,
   stall : Integer,
   deck-ceiling : Integer
  }

  make-parse-state : List Token, Text -> ParseState
  make-parse-state (toks) (source) =
   ParseState {
    tokens = toks,
    pos = 0,
    bag = empty-bag,
    paren-depth = 0,
    fuel = max-parse-fuel,
    stall-pos = 0 - 1,
    stall = 0,
    deck-ceiling = 0
   }

  current : ParseState -> Token
  current (st) =
   list-at (st.tokens) (st.pos)

  current-kind : ParseState -> TokenKind
  current-kind (st) = (current st).kind

  parse-state-keep : Integer, ParseState -> ParseState
  parse-state-keep (b) (st) =
   ParseState {
    tokens = st.tokens,
    pos = st.pos,
    bag = copy-sx-bag b (st.bag),
    paren-depth = st.paren-depth,
    fuel = st.fuel,
    stall-pos = st.stall-pos,
    stall = st.stall,
    deck-ceiling = st.deck-ceiling
   }

  advance : ParseState -> ParseState
  advance (st) =
   if st.pos >= list-length (st.tokens) - 1 then st
   else ParseState {
    tokens = st.tokens,
    pos = st.pos + 1,
    bag = st.bag,
    paren-depth = st.paren-depth,
    fuel = st.fuel,
    stall-pos = st.stall-pos,
    stall = st.stall,
    deck-ceiling = st.deck-ceiling
   }

  parse-fuel-exhausted : ParseState -> Boolean
  parse-fuel-exhausted (st) = st.fuel <= 0 | st.stall >= max-parse-stall

  parse-stalled : ParseState -> Boolean
  parse-stalled (st) = st.stall >= max-parse-stall

  consume-parse-fuel : ParseState -> ParseState
  consume-parse-fuel (st) =
   let st1 = if st.pos == st.stall-pos
      then __record-set st "stall" (st.stall + 1)
      else __record-set (__record-set st "stall-pos" (st.pos)) "stall" 0
   in __record-set st1 "fuel" (st1.fuel - 1)

 The stalled arm CONSUMES THE TOKEN, and it has to. Reporting alone does
 not end a spin: the caller has still made no progress, comes straight
 back, and the guard fires again -- one diagnostic per call, forever, so
 the stack stops dying and the heap dies instead. Measured, both ways.
 Forcing the position forward turns the spin into ordinary error recovery:
 the count resets, the parse carries on to the end of the unit, and the
 bag gets one diagnostic per stuck token rather than millions.

  emit-parse-fuel-error : ParseState, Text -> ParseState
  emit-parse-fuel-error (st) (op) =
   if parse-stalled st
    then let st1 = __record-set st "bag" (bag-add (st.bag) (make-error cdx-resource-exhausted ("parser." & op & " made no progress over " & integer-to-text max-parse-stall & " calls at this token, so the token was skipped. This is a parser defect, not a fault in this source: some arm returned without consuming a token or reporting why. Please report the token and the construct around it.") (token-to-span (current st))))
     in let st2 = __record-set (__record-set st1 "stall" 0) "stall-pos" (0 - 1)
     in advance st2
    else __record-set st "bag" (bag-add (st.bag) (make-error cdx-resource-exhausted ("compiler resource exhausted in parser." & op & " (budget " & integer-to-text max-parse-fuel & ")") (token-to-span (current st))))

  token-to-span : Token -> SourceSpan
  token-to-span (tok) =
   span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id)

  enter-paren : ParseState -> ParseState
  enter-paren (st) =
   __record-set st "paren-depth" (st.paren-depth + 1)

  exit-paren : ParseState -> ParseState
  exit-paren (st) =
   __record-set st "paren-depth" (st.paren-depth - 1)

  is-done : ParseState -> Boolean
  is-done (st) =
   when current-kind st
    is EndOfFile -> True
    is otherwise -> False

  peek-kind : ParseState, Integer -> TokenKind
  peek-kind (st) (offset) =
   let idx = st.pos + offset
   in if idx >= list-length (st.tokens) then EndOfFile
      else (list-at (st.tokens) idx).kind

Section: Parse Results
  ParseExprResult =
   | ExprOk (Expr) (ParseState)

  ParsePatResult =
   | PatOk (Pat) (ParseState)

  ParseTypeResult =
   | TypeOk (TypeExpr) (ParseState)

  ParseDefResult = record {
   maybe-def : Maybe Def,
   state : ParseState
  }

  ParseTypeDefResult = record {
   maybe-type-def : Maybe TypeDef,
   state : ParseState
  }

Section: TokenKind Predicates
  is-keyword : TokenKind -> Boolean
  is-keyword (k) =
   when k
    is LetKeyword | InKeyword | BetweenKeyword | IfKeyword | IsKeyword | OtherwiseKeyword | ThenKeyword | ElseKeyword | WhenKeyword | WhereKeyword | SuchThatKeyword | ActKeyword | EndKeyword | RecordKeyword | CitesKeyword | GroundsKeyword | ClaimKeyword | ProofKeyword | QedKeyword | InductionKeyword | ForAllKeyword | ThereExistsKeyword | LinearKeyword | MutableKeyword | PunctualKeyword | UnitKeyword | EffectKeyword | ClassKeyword | InstanceKeyword | WithKeyword | WithTimeoutKeyword | TryingKeyword | LazyKeyword | ForKeyword | RevisedKeyword | TrueKeyword | FalseKeyword -> True
    is otherwise -> False

  is-revised-keyword : TokenKind -> Boolean
  is-revised-keyword (k) =
   when k
    is RevisedKeyword -> True
    is otherwise -> False

  is-ident : TokenKind -> Boolean
  is-ident (k) =
   when k
    is Identifier -> True
    is otherwise -> False

  is-ident-like : TokenKind -> Boolean
  is-ident-like (k) =
   when k
    is Identifier | ActKeyword | EndKeyword | QedKeyword -> True
    is otherwise -> False

  is-field-name-token : TokenKind -> Boolean
  is-field-name-token (k) =
   when k
    is Identifier | ActKeyword | EndKeyword | QedKeyword | EffectKeyword | WhereKeyword | WithKeyword | LinearKeyword | ClaimKeyword | ProofKeyword | RecordKeyword | ClassKeyword | InstanceKeyword -> True
    is otherwise -> False

  is-type-ident : TokenKind -> Boolean
  is-type-ident (k) =
   when k
    is TypeIdentifier -> True
    is otherwise -> False

  is-arrow : TokenKind -> Boolean
  is-arrow (k) =
   when k
    is Arrow -> True
    is otherwise -> False

  is-equals : TokenKind -> Boolean
  is-equals (k) =
   when k
    is Equals -> True
    is otherwise -> False

  is-colon : TokenKind -> Boolean
  is-colon (k) =
   when k
    is Colon -> True
    is otherwise -> False

  is-comma : TokenKind -> Boolean
  is-comma (k) =
   when k
    is Comma -> True
    is otherwise -> False

  is-pipe : TokenKind -> Boolean
  is-pipe (k) =
   when k
    is Pipe -> True
    is otherwise -> False

  is-pipe-forward : TokenKind -> Boolean
  is-pipe-forward (k) =
   when k
    is PipeForward -> True
    is otherwise -> False

  is-dot : TokenKind -> Boolean
  is-dot (k) =
