Chapter: Tokens
  cites Codex chapter Text

Section: Types
  TokenKind =
   | EndOfFile
   | Newline
   | Indent
   | Dedent
   | IntegerLiteral
   | NumberLiteral
   | TextLiteral
   | CharLiteral
   | TrueKeyword
   | FalseKeyword
   | Identifier
   | TypeIdentifier
   | ProseText
   | ChapterHeader
   | SectionHeader
   | LetKeyword
   | InKeyword
   | BetweenKeyword
   | IfKeyword
   | IsKeyword
   | OtherwiseKeyword
   | ThenKeyword
   | ElseKeyword
   | WhenKeyword
   | WhereKeyword
   | SuchThatKeyword
   | ActKeyword
   | EndKeyword
   | RecordKeyword
   | CitesKeyword
   | ClaimKeyword
   | ProofKeyword
   | QedKeyword
   | ForAllKeyword
   | ThereExistsKeyword
   | LinearKeyword
   | MutableKeyword
   | EffectKeyword
   | WithKeyword
   | WithTimeoutKeyword
   | TryingKeyword
   | Equals
   | Colon
   | Arrow
   | LeftArrow
   | Pipe
   | PipeForward
   | Ampersand
   | Plus
   | Minus
   | Star
   | Slash
   | Caret
   | PlusPlus
   | ColonColon
   | DoubleEquals
   | NotEquals
   | LessThan
   | GreaterThan
   | LessOrEqual
   | GreaterOrEqual
   | TripleEquals
   | Turnstile
   | LinearProduct
   | ForAllSymbol
   | ExistsSymbol
   | LeftParen
   | RightParen
   | LeftBracket
   | RightBracket
   | LeftBrace
   | RightBrace
   | Comma
   | Dot
   | DotDot
   | DashGreater
   | Underscore
   | Backslash
   | AtSign
   | ErrorToken

  Token = record {
   kind : TokenKind,
   source : Text,
   offset : Integer between 0 and 4294967295,
   length : Integer between 0 and 4294967295,
   line : Integer between 0 and 131071,
   column : Integer between 0 and 65535,
   file-id : Integer between 0 and 65535
  }

Section: Functions
  token-text : Token -> Text
  token-text (t) =
   substring (t.source) (t.offset) (t.length)

