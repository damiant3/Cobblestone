   | ErrorToken
   | UnitKeyword
   | RevisedKeyword

  Token = record {
   kind : TokenKind,
   source : Text,
   offset : Integer between 0 and 4294967295,
   length : Integer between 0 and 4294967295,
   line : Integer between 0 and 131071,
   column : Integer between 0 and 4294967295,
   file-id : Integer between 0 and 65535
  }

Section: Functions
  token-text : Token -> Text
  token-text (t) =
   substring (t.source) (t.offset) (t.length)

Section: Literal Values

  hex-digit-value : Integer -> Integer
  hex-digit-value (c) =
   if c >= char-code '0' & c <= char-code '9' then c - char-code '0'
   else if c == char-code 'a' | c == char-code 'A' then 10
   else if c == char-code 'b' | c == char-code 'B' then 11
   else if c == char-code 'c' | c == char-code 'C' then 12
   else if c == char-code 'd' | c == char-code 'D' then 13
   else if c == char-code 'e' | c == char-code 'E' then 14
   else if c == char-code 'f' | c == char-code 'F' then 15
   else -1

  hex-text-value : Text, Integer, Integer, Integer between -9223372036854775808 and 9223372036854775807 wrapping -> Integer
  hex-text-value (t) (i) (len) (acc) =
   if i >= len then acc
   else let c = char-code-at t i
   in if hex-digit-value c < 0 then hex-text-value t (i + 1) len acc
      else hex-text-value t (i + 1) len (acc * 16 + hex-digit-value c)

  is-hex-literal-text : Text -> Boolean
  is-hex-literal-text (t) =
   text-length t > 0 & char-code-at t 0 == char-code '#'

  dec-text-value : Text, Integer, Integer, Integer between -9223372036854775808 and 9223372036854775807 wrapping -> Integer
  dec-text-value (t) (i) (len) (acc) =
   if i >= len then acc
   else let c = char-code-at t i
   in if c == char-code '_' then dec-text-value t (i + 1) len acc
      else dec-text-value t (i + 1) len (acc * 10 + (c - char-code '0'))

  lit-text-to-integer : Text -> Integer
  lit-text-to-integer (t) =
   if is-hex-literal-text t then hex-text-value t 1 (text-length t) 0
   else dec-text-value t 0 (text-length t) 0

  pat-lit-to-integer : Text -> Integer
  pat-lit-to-integer (t) =
   if t == "True" then 1
   else if t == "False" then 0
   else lit-text-to-integer t

