Section: Library Loading

  is-library-quire : Text -> Boolean
  is-library-quire (q) =
   if q == "Foreword" then True
   else if q == "Kernel" then True
   else if q == "OS" then True
   else if q == "Works" then True
   else if q == "Trust" then True
   else if q == "Net" then True
   else if q == "Verify" then True
   else if q == "Replay" then True
   else if q == "Sched" then True
   else if q == "Observe" then True
   else if q == "Game" then True
   else if q == "Signal" then True
   else if q == "Compress" then True
   else if q == "Encode" then True
   else if q == "Math" then True
   else if q == "Sim" then True
   else if q == "AI" then True
   else if q == "UI" then True
   else if q == "Punctual" then True
   else if q == "Dev" then True
   else False

  quire-to-dir : Text -> Text
  quire-to-dir (q) =
   if q == "Foreword" then "foreword/"
   else if q == "Kernel" then "kernel/"
   else if q == "OS" then "os/"
   else if q == "Works" then "works/"
   else if q == "Trust" then "os.trust/"
   else if q == "Net" then "os.net/"
   else if q == "Verify" then "os.verify/"
   else if q == "Replay" then "os.replay/"
   else if q == "Sched" then "os.sched/"
   else if q == "Observe" then "os.observe/"
   else if q == "Game" then "foreword.game/"
   else if q == "Signal" then "foreword.signal/"
   else if q == "Compress" then "foreword.compress/"
   else if q == "Encode" then "foreword.encode/"
   else if q == "Math" then "foreword.math/"
   else if q == "Sim" then "foreword.sim/"
   else if q == "AI" then "foreword.ai/"
   else if q == "UI" then "foreword.ui/"
   else if q == "Punctual" then "foreword.punctual/"
   else if q == "Dev" then "os.dev/"
   else "foreword/"

  filter-library-cites : List CitesDecl, Integer, Integer, List CitesDecl -> List CitesDecl
  filter-library-cites (citations) (i) (len) (acc) =
   if i == len then acc
   else let c = list-at citations i
   in if is-library-quire (token-text (c.quire))
      then filter-library-cites citations (i + 1) len (list-push acc c)
      else filter-library-cites citations (i + 1) len acc

Section: Disk Foreword Loading

  DiskLoadState = record {
   dls-seen : List Text,
   dls-chunks : List Text
  }

  disk-extract-cites : Text, Integer -> List CitesDecl
  disk-extract-cites (source) (ceiling) =
   let tok-result = tokenize-into source 1 False ceiling
   in let doc = parse-document (make-parse-state (tok-result.tokens) source) ceiling
   in filter-library-cites (doc.citations) 0 (list-length (doc.citations)) []

  disk-load-cite : Fat16Volume, DiskLoadState, Text, Text, Integer -> [Console] DiskLoadState
  disk-load-cite (vol) (st) (quire) (name) (ceiling) =
   let key = quire & ":" & name
   in if text-set-has (st.dls-seen) key then st
   else let seen2 = text-set-insert (st.dls-seen) key
   in let path = quire-to-dir quire & name & ".codex"
   in when fat16-read-source vol path
     is Just (content) ->
       let deps = disk-extract-cites content ceiling
       in let st2 = disk-load-cites-list vol (DiskLoadState { dls-seen = seen2, dls-chunks = st.dls-chunks }) deps 0 (list-length deps) ceiling
       in let renamed = text-replace content ("Chapter: " & name) ("Chapter: " & quire & "--" & name)
       in DiskLoadState { dls-seen = st2.dls-seen, dls-chunks = list-push (st2.dls-chunks) (renamed & "\n\n") }
     is None ->
       let noted = print-line-uni ("CITE-MISSING " & quire & " " & name)
       in DiskLoadState { dls-seen = seen2, dls-chunks = st.dls-chunks }

  disk-load-cites-list : Fat16Volume, DiskLoadState, List CitesDecl, Integer, Integer, Integer -> [Console] DiskLoadState
  disk-load-cites-list (vol) (st) (cite-list) (i) (len) (ceiling) =
   if i >= len then st
   else let c = list-at cite-list i
   in let st2 = disk-load-cite vol st (token-text (c.quire)) (c.chapter-name) ceiling
   in disk-load-cites-list vol st2 cite-list (i + 1) len ceiling

  disk-resolve-forewords : Fat16Volume, Text, Text -> [Console] Text
  disk-resolve-forewords (vol) (source) (mode) =
   let scan-scale = effective-deck-scale mode (text-length source)
   in let scan-height = scaled-floor scan-scale demand-disk-scan-floor demand-disk-scan-guard-band
   in let scan-base = build scan-height
   in let ceiling = scan-base + scan-height
   in let cite-list = disk-extract-cites source ceiling
   in let st = disk-load-cites-list vol (DiskLoadState { dls-seen = [], dls-chunks = [] }) cite-list 0 (list-length cite-list) ceiling
   in let joined = deck-record (text-concat-list (st.dls-chunks))
   in let compacted = phase-compact
   in joined

Section: Quoted Works

 Threat model: the transport is untrusted. Whoever hands us these bytes
 may hand us anything at all, so the gate takes the messenger's word for
 nothing -- content that does not match its digest, a signer the source
 did not pin, a forged signature, and a score below the floor are each
 refused independently.

 The offered-works wire format, after the marker line: a KEY line per
 trusted key, giving its fingerprint, its public key in hex, and the
 score; and a WORK line per offered definition, giving its digest, its
 author, its timestamp, the fingerprint that signed it, the signature in
 hex, and the number of lines of content that follow.

  quoted-works-marker : Text = "%%QUOTED-WORKS%%"

  SourceSplit = record {
   sp-body : Text,
   sp-works : Text
  }

  match-at : Text, Text, Integer, Integer, Integer -> Boolean
  match-at (t) (m) (i) (j) (mlen) =
   if j >= mlen then True
   else if char-code-at t (i + j) /= char-code-at m j then False
   else match-at t m i (j + 1) mlen

  index-of-from : Text, Text, Integer, Integer, Integer -> Integer
  index-of-from (t) (m) (i) (tlen) (mlen) =
   if i + mlen > tlen then -1
   else if match-at t m i 0 mlen then i
   else index-of-from t m (i + 1) tlen mlen

 The source is CCE by the time it reaches here, and CCE is not ASCII: a
 newline is 1, a space is 2, and 10 is the digit seven. A guard written
 against the ASCII numbers asks whether the character before the marker
 is a seven, decides it is not, and hands the offered works to the parser
 as if they were code. Ask the encoding for its own numbers. Never write
 them down.

  at-line-start : Text, Integer -> Boolean
  at-line-start (t) (i) =
   if i == 0 then True else char-code-at t (i - 1) == char-code '\n'

  at-line-end : Text, Integer, Integer -> Boolean
  at-line-end (t) (i) (tlen) =
   if i >= tlen then True else char-code-at t i == char-code '\n'

  marker-line-at : Text, Integer, Integer, Integer -> Integer
  marker-line-at (src) (from) (tlen) (mlen) =
   let at = index-of-from src quoted-works-marker from tlen mlen
   in if at < 0 then -1
      else if at-line-start src at & at-line-end src (at + mlen) tlen then at
      else marker-line-at src (at + 1) tlen mlen

  split-quoted-works : Text -> SourceSplit
  split-quoted-works (src) =
   let tlen = text-length src
   in let mlen = text-length quoted-works-marker
   in let at = marker-line-at src 0 tlen mlen
   in if at < 0
      then SourceSplit { sp-body = src, sp-works = "" }
      else SourceSplit {
        sp-body = substring src 0 at,
        sp-works = substring src (at + mlen) (tlen - at - mlen)
      }

  next-line-at : Text, Integer, Integer -> Integer
  next-line-at (t) (i) (tlen) =
   if i >= tlen then tlen
   else if char-code-at t i == char-code '\n' then i + 1
   else next-line-at t (i + 1) tlen

  line-opens-quotes : Text, Integer, Integer -> Boolean
  line-opens-quotes (t) (i) (tlen) =
   if i >= tlen then False
   else if char-code-at t i == char-code ' ' then line-opens-quotes t (i + 1) tlen
   else if i + 7 > tlen then False
   else if match-at t "quotes" i 0 6 then char-code-at t (i + 6) == char-code ' '
   else False

  scan-for-quotes : Text, Integer, Integer -> Boolean
  scan-for-quotes (t) (i) (tlen) =
   if i >= tlen then False
   else if line-opens-quotes t i tlen then True
   else scan-for-quotes t (next-line-at t i tlen) tlen

  has-quotations : Text -> Boolean
  has-quotations (body) = scan-for-quotes body 0 (text-length body)

Section: Hex

 The digits are contiguous in CCE and the letters are not: CCE orders
 them by frequency, so a is 15 and f is 28, and everything from o to w
 sits between them. A hex decoder written as two range checks over ASCII
 therefore accepts a dozen letters that are not hex digits and mis-values
 every one of them.

  hex-to-bytes : Text, Integer, Integer, List Integer -> List Integer
  hex-to-bytes (t) (i) (len) (acc) =
   if i + 1 >= len then acc
   else let hi = hex-digit-value (char-code-at t i)
   in let lo = hex-digit-value (char-code-at t (i + 1))
   in hex-to-bytes t (i + 2) len (list-push acc (hi * 16 + lo))

  decode-hex : Text -> List Integer
  decode-hex (t) = hex-to-bytes t 0 (text-length t) []

Section: Reading The Offered Works

  WorksState = record {
   ws-bundle : FactBundle,
   ws-manifest : TrustManifest
  }

  works-empty : WorksState = WorksState { ws-bundle = bundle-empty, ws-manifest = manifest-empty }

  join-work-lines : List Text, Integer, Integer, Text -> Text
  join-work-lines (lines) (i) (stop) (acc) =
   if i >= stop then acc
   else join-work-lines lines (i + 1) stop (acc & list-at lines i & "\n")

 The trust manifest is built from the SOURCE, never from the offered works.
 A KEY line in the works blob is ignored on purpose: it arrives over the
 transport, and the transport is what the gate must not believe. A signer
 the source did not pin is an unknown signer, whatever the works claim.

  build-source-manifest : List CitesDecl, Integer, Integer, TrustManifest -> TrustManifest
  build-source-manifest (ks) (i) (len) (m) =
   if i >= len then m
   else let k = list-at ks i
   in let pub = decode-hex (k.content-hash)
   in let m2 = manifest-add m (k.chapter-name) pub (k.trust-floor)
   in build-source-manifest ks (i + 1) len m2

  parse-works : List Text, Integer, Integer, WorksState -> WorksState
  parse-works (lines) (i) (len) (st) =
   if i >= len then st
   else let ln = list-at lines i
   in if text-starts-with ln "KEY " then parse-works lines (i + 1) len st
      else if text-starts-with ln "WORK " then apply-work-line lines i len st
      else if text-starts-with ln "OFFER " then apply-offer-line lines i len st
      else parse-works lines (i + 1) len st

  apply-offer-line : List Text, Integer, Integer, WorksState -> WorksState
  apply-offer-line (lines) (i) (len) (st) =
   let f = text-split (list-at lines i) " "
   in if list-length f < 5 then parse-works lines (i + 1) len st
   else let nlines = text-to-integer (list-at f 4)
   in let content = join-work-lines lines (i + 1) (i + 1 + nlines) ""
   in let ts = text-to-integer (list-at f 3)
   in let fact = Fact { hash = list-at f 1, kind = DefinitionFact, content = content, author = list-at f 2, timestamp = ts }
   in let st2 = __record-set st "ws-bundle" (bundle-offer (st.ws-bundle) fact)
   in parse-works lines (i + 1 + nlines) len st2

  apply-work-line : List Text, Integer, Integer, WorksState -> WorksState
  apply-work-line (lines) (i) (len) (st) =
   let f = text-split (list-at lines i) " "
   in if list-length f < 7 then parse-works lines (i + 1) len st
   else let nlines = text-to-integer (list-at f 6)
   in let content = join-work-lines lines (i + 1) (i + 1 + nlines) ""
   in let ts = text-to-integer (list-at f 3)
   in let fact = Fact { hash = list-at f 1, kind = DefinitionFact, content = content, author = list-at f 2, timestamp = ts }
   in let sf = SignedFact { fact = fact, signature = decode-hex (list-at f 5), signer-fingerprint = list-at f 4 }
   in let st2 = __record-set st "ws-bundle" (bundle-publish (st.ws-bundle) sf)
   in parse-works lines (i + 1 + nlines) len st2

 No carriage return survives to be stripped here. CCE has no code point
 for one -- 13 is not in the table -- so the conversion at the I/O
 boundary drops it, and a CRLF file and an LF file are the same text by
 the time the gate sees them.

  build-works : Text -> WorksState
  build-works (works) =
   let lines = text-split works "\n"
   in parse-works lines 0 (list-length lines) works-empty

Section: Refusing A Quotation

  quotation-code : ImportOutcome -> Integer
  quotation-code (o) = when o
   is ImportOk (f) -> 0
   is ImportMissing -> cdx-quotation-missing
   is ImportCorrupt -> cdx-quotation-corrupt
   is ImportUnsigned -> cdx-quotation-unsigned
   is ImportUnknownSigner -> cdx-quotation-unknown-signer
   is ImportForged -> cdx-quotation-forged
   is ImportUntrusted (score) -> cdx-quotation-untrusted

  quotation-message : CitesDecl, ImportOutcome -> Text
  quotation-message (q) (o) = when o
   is ImportOk (f) -> ""
   is ImportMissing -> "Quoted work '" & q.chapter-name & "' was not supplied; nothing offered has hash " & q.content-hash
   is ImportCorrupt -> "Quoted work '" & q.chapter-name & "' does not hash to " & q.content-hash
   is ImportUnsigned -> "Quoted work '" & q.chapter-name & "' carries no signature; a hash says what a definition is, only a signature says who stands behind it"
   is ImportUnknownSigner -> "Quoted work '" & q.chapter-name & "' is signed by a key that is not in the trust manifest"
   is ImportForged -> "Quoted work '" & q.chapter-name & "' has a signature that does not verify against its signer's key"
   is ImportUntrusted (score) -> quotation-untrusted-message q score

  quotation-untrusted-message : CitesDecl, Integer -> Text
  quotation-untrusted-message (q) (score) =
   "Quoted work '" & q.chapter-name & "' is signed by a key scoring " & show score & ", below the floor of " & show (q.trust-floor)

  quotation-diag : CitesDecl, ImportOutcome -> Diagnostic
  quotation-diag (q) (o) =
   let sp = span-at (q.quire.line) (q.quire.column) (q.quire.offset) (q.quire.length) (q.quire.file-id)
   in make-error (__narrow (quotation-code o)) (quotation-message q o) sp

  quotation-no-floor-diag : CitesDecl -> Diagnostic
  quotation-no-floor-diag (q) =
   let sp = span-at (q.quire.line) (q.quire.column) (q.quire.offset) (q.quire.length) (q.quire.file-id)
   in make-error cdx-quotation-no-floor ("Chapter '" & q.citing-chapter & "' quotes a work but declares no trust floor; write 'trusting above N' (0 to 10000) to say how much trust a quoted work's signer must clear") sp

  QuoteResolve = record {
   qr-prefix : Text,
   qr-bag : DiagnosticBag
  }

 A quotation names its digest with the algorithm that produced it, so
 that the day we outgrow SHA-256 the old quotations still say what they
 meant. The store is keyed by the digest alone.

  digest-of : Text -> Text
  digest-of (h) =
   if text-starts-with h "sha256:" then substring h 7 (text-length h - 7) else h

  resolve-each : List CitesDecl, Integer, Integer, WorksState, Text, DiagnosticBag -> QuoteResolve
  resolve-each (qs) (i) (len) (ws) (prefix) (bag) =
   if i >= len then QuoteResolve { qr-prefix = prefix, qr-bag = bag }
   else let q = list-at qs i
   in let r = gate-import (ws.ws-bundle) (ws.ws-manifest) (q.trust-floor) (digest-of (q.content-hash)) (q.chapter-name)
   in when r.outcome
    is ImportOk (f) -> resolve-admit qs i len ws prefix bag q (f.content)
    is otherwise -> resolve-each qs (i + 1) len ws prefix (bag-add bag (quotation-diag q (r.outcome)))

  resolve-admit : List CitesDecl, Integer, Integer, WorksState, Text, DiagnosticBag, CitesDecl, Text -> QuoteResolve
  resolve-admit (qs) (i) (len) (ws) (prefix) (bag) (q) (content) =
   let renamed = rewrite-chapter-header content (q.chapter-name)
   in resolve-each qs (i + 1) len ws (prefix & renamed & "\n\n") bag

  line-end-at : Text, Integer, Integer -> Integer
  line-end-at (t) (i) (len) =
   if i >= len then len
   else if char-code-at t i == char-code '\n' then i
   else line-end-at t (i + 1) len

  rewrite-chapter-header : Text, Text -> Text
  rewrite-chapter-header (content) (local-name) =
   let len = text-length content
   in let nl = line-end-at content 0 len
   in let head = substring content 0 nl
   in if text-starts-with head "Chapter:"
      then "Chapter: " & local-name & substring content nl (len - nl)
      else content

  resolve-quotations : Text, FactBundle -> QuoteResolve
  resolve-quotations (body) (bundle) =
   let tok-result = tokenize body 1
   in let doc = parse-document (make-parse-state (tok-result.tokens) body) 0
   in let qs = doc.quotations
   in if list-length qs == 0 then QuoteResolve { qr-prefix = "", qr-bag = empty-bag }
   else let q0 = list-at qs 0
   in if q0.trust-floor < 0
      then QuoteResolve { qr-prefix = "", qr-bag = bag-add empty-bag (quotation-no-floor-diag q0) }
   else let ks = doc.trust-keys
   in let manifest = build-source-manifest ks 0 (list-length ks) manifest-empty
   in let ws = WorksState { ws-bundle = bundle, ws-manifest = manifest }
   in resolve-each qs 0 (list-length qs) ws "" empty-bag

Section: Text Compilation

  compile-text : CompileFrontend, CompileTarget -> Text
  compile-text (fe) (target) =
   if bag-has-errors (fe.bag) then ""
   else emit-for-text-target target (fe.ir) (fe.text-meta) (fe.type-defs) (fe.renames)

  emit-for-text-target : CompileTarget, IRChapter, IRTextMeta, List ATypeDef, List RenameEntry -> Text
  emit-for-text-target (target) (ir) (meta) (type-defs) (renames) =
   when target
    is CtCodexText -> codex-emit-text-chapter ir meta type-defs renames
    is CtX86_64Bare | CtCdx -> ""

Section: Binary Compilation

  compile-to-cdx : CompileFrontend -> EmitChapterResult
  compile-to-cdx (fe) = compile-to-cdx-with-exit-mode fe Exit False False WatchdogProgress 0

  cdx-emit-roots : List Text
  cdx-emit-roots = ["opening", "fat16-servicer-read", "fat16-servicer-write"]

 The IR handed to a native plug needs the same treatment for the same
 reason, one lane over. A plug's block builtin is emitted machine code
 that calls the Codex virtio driver (`Arm64Runtime.codex`, block device
 helpers), and the compiler cannot see that caller, so pruning from
 `opening` alone deletes the driver and the plug's branch resolves to
 nothing. These roots are the driver's entry points, and they are exactly
 as much a root as `fat16-servicer-read` is: reached from an emitter, not
 from Codex.

 Ruled 2026-08-16 (red): reachability is derived from the program's own
 declaration and a disk program never cites a driver chapter to make its
 disk exist. That would be a guarantee held by whoever remembers the
 incantation (L-FREEDOM), which fails silently for the next reader.

 **A new driver entry point must be added here.** Nothing checks that, and
 the symptom is an unresolved-call warning naming the missing function
 rather than anything at this line.

  ir-emit-roots : List Text
  ir-emit-roots = ["opening", "vb-capacity-auto", "vb-read-auto", "vb-write-auto", "fat16-servicer-read", "fat16-servicer-write"]

  compile-to-cdx-with-exit-mode : CompileFrontend, X86_64ExitMode, Boolean, Boolean, X86_64WatchdogMode, Integer between 0 and 2 -> EmitChapterResult
  compile-to-cdx-with-exit-mode (fe) (exit-mode) (poison) (trace) (wd-mode) (hosted-target) =
   if bag-has-errors (fe.bag) then EmitChapterResult { header-bytes = [], content-buf = 0, content-len = 0, tail-bytes = [], bag = fe.bag, symbol-map = [] }
   else let all-defs = (fe.cdx-ir).defs
    in let proofs = keep-proof-defs [] all-defs 0
    in let pruned = ir-prune-unreachable-roots (fe.cdx-ir) cdx-emit-roots
    in let dropped = ir-dropped-budgeted-punctuals all-defs (pruned.defs)
    in let emit-result = x86-64-emit-cdx-with-exit-mode (ir-chapter-with-proofs pruned proofs) (fe.sorted-type-defs) exit-mode poison trace wd-mode dropped hosted-target
    in EmitChapterResult {
     header-bytes = emit-result.header-bytes,
     content-buf = emit-result.content-buf,
     content-len = emit-result.content-len,
     tail-bytes = emit-result.tail-bytes,
     bag = bag-merge-all [fe.bag, emit-result.bag],
     symbol-map = emit-result.symbol-map
    }

Section: Measurement

  phase-labels : List Text
  phase-labels =
   ["h0-start", "h1-tokenize", "h2-scan", "h3-assignments",
    "h4-parse", "h5-desugar", "h6-scope", "h7-resolve",
    "h8-check", "h9-lower", "h10-ctors",
    "h-pre-emit", "h-post-emit"]

  phase-metric-names : List Text
  phase-metric-names = ["lex", "parse", "desugar", "scope", "check", "lower", "resolve", "lift"]

  format-phase-metrics-wd : List PhaseMetrics -> Text
  format-phase-metrics-wd (metrics) =
   format-phase-metrics-loop metrics phase-metric-names 0 (list-length metrics) ""

  format-phase-metrics-loop : List PhaseMetrics, List Text, Integer, Integer, Text -> Text
  format-phase-metrics-loop (metrics) (names) (i) (len) (acc) =
   if i >= len then acc
   else let m = list-at metrics i
   in let name = if i < list-length names then list-at names i else "?"
   in let deck-usage = m.deck-end - m.deck-origin
   in let bivy-usage = m.bivy-hwm - m.bivy-origin
   in let line = "WD:PM-" & name & ":deck-origin=" & integer-to-text (m.deck-origin) & ",deck-end=" & integer-to-text (m.deck-end) & ",deck-usage=" & integer-to-text deck-usage & ",bivy-hwm=" & integer-to-text (m.bivy-hwm) & ",bivy-usage=" & integer-to-text bivy-usage & "\n"
   in format-phase-metrics-loop metrics names (i + 1) len (acc & line)

  format-heap-marks : List Integer -> Text
  format-heap-marks (marks) =
   text-concat-list (format-heap-marks-prefix marks phase-labels "PHASE-" 0 (list-length marks) [])

  format-heap-marks-wd : List Integer -> Text
  format-heap-marks-wd (marks) =
   text-concat-list (format-heap-marks-prefix marks phase-labels "WD:PHASE-" 0 (list-length marks) [])

  emit-mark-labels : List Text
  emit-mark-labels = ["h-pre-emit", "h-post-emit"]

  format-emit-marks : Integer, Integer, Text -> Text
  format-emit-marks (pre) (post) (pfx) =
   text-concat-list (format-heap-marks-prefix [pre, post] emit-mark-labels pfx 0 2 [])

  format-heap-marks-prefix : List Integer, List Text, Text, Integer, Integer, List Text -> List Text
  format-heap-marks-prefix (marks) (labels) (pfx) (i) (len) (acc) =
   if i == len then acc
   else let label = if i < list-length labels then list-at labels i else "h?"
    in format-heap-marks-prefix marks labels pfx (i + 1) len (list-push acc (pfx & label & ":" & integer-to-text (list-at marks i) & "\n"))

Section: Codegen Diagnostics

  print-codegen-errors : List Diagnostic, Integer, Integer -> [Console] Nothing
  print-codegen-errors (errs) (i) (len) =
   if i == len then print-line-uni ""
   else act
    print-line-uni (diagnostic-display (list-at errs i) empty-file-table)
    print-codegen-errors errs (i + 1) len
   end

  print-codegen-error-header : List Diagnostic -> [Console] Nothing
  print-codegen-error-header (errs) =
   let n = list-length errs
   in if n == 0 then print-line-uni ""
   else act
    print-line-uni ("CODEGEN-ERRORS:" & integer-to-text n)
    print-codegen-errors errs 0 n
   end

  print-bag-notices : DiagnosticBag -> [Console] Nothing
  print-bag-notices (bag) =
   print-notices-loop (bag.diagnostics) 0 (list-length (bag.diagnostics))

  print-notices-loop : List Diagnostic, Integer, Integer -> [Console] Nothing
  print-notices-loop (ds) (i) (len) =
   if i == len then print-line-uni ""
   else let d = list-at ds i
   in if d.severity > sev-error then act
     print-line-uni (diagnostic-display d empty-file-table)
     print-notices-loop ds (i + 1) len
    end
    else print-notices-loop ds (i + 1) len

Section: Streaming Emission

  emit-streaming-ir-defs : List IRDef, List Text, List RenameEntry, Integer, Integer -> [Console] Nothing
  emit-streaming-ir-defs (ir-defs) (ctor-names) (renames) (i) (len) =
   if i == len then print-line-uni ""
   else let h = __heap-save
   in let text = codex-emit-def (list-at ir-defs i) ctor-names renames
   in act
    print-line-uni text
    let restored = __heap-restore h
    in emit-streaming-ir-defs ir-defs ctor-names renames (i + 1) len
   end

  emit-text-streaming : Text, CompileFlags -> [Console] Nothing
  emit-text-streaming (source) (flags) =
   let fe = compile-frontend source "Program" flags
   in let emit-deck = emit-build (list-length (fe.ir.defs) * 65536 + 8388608)
   in if bag-has-errors (fe.bag) then act
    print-codegen-error-header (bag-errors (fe.bag))
    print-line-uni (format-heap-marks-wd (fe.heap-marks))
    print-line-uni "CODEGEN-HALTED: errors in bag; no text emitted"
   end
   else let wd-marks = format-heap-marks-wd (fe.heap-marks) & format-phase-metrics-wd (fe.phase-metrics)
   in let ir-defs = fe.ir.defs
   in let len = list-length ir-defs
   in if len == 0
      then let header = if fe.text-meta.chapter-title == "" then ""
           else "Chapter: " & fe.text-meta.chapter-title & "\n"
             & codex-emit-grounds-line (fe.text-meta.ground-effects) & "\n"
             & if fe.text-meta.prose == "" then "" else " " & fe.text-meta.prose & "\n\n"
      in let type-defs-text = codex-emit-type-defs (fe.type-defs) 0
      in act
       print-line-uni wd-marks
       print-line-uni (header & type-defs-text)
      end
   else let h-emit = __heap-save
   in let header = if fe.text-meta.chapter-title == "" then ""
      else "Chapter: " & fe.text-meta.chapter-title & "\n"
        & codex-emit-grounds-line (fe.text-meta.ground-effects) & "\n"
        & if fe.text-meta.prose == "" then "" else " " & fe.text-meta.prose & "\n\n"
   in let type-defs-text = codex-emit-type-defs (fe.type-defs) 0
   in let first-text = codex-emit-def (list-at ir-defs 0) (fe.text-meta.ctor-names) (fe.renames)
   in act
    print-line-uni wd-marks
    print-line-uni (header & type-defs-text & first-text)
    let restored = __heap-restore h-emit
    in emit-streaming-ir-defs ir-defs (fe.text-meta.ctor-names) (fe.renames) 1 len
   end

Section: Entry Point

  emit-cdx : Text, Text, CompileFlags, Boolean -> [Console, FileSystem, Device.Block] Nothing
  emit-cdx (source) (mode) (flags) (force-disk) =
   let exit-mode = if has-mode-flag mode "repl" then ExitRepl
    else if has-mode-flag mode "uefi" then ExitUefi
    else Exit
   in let want-map = has-mode-flag mode "map"
   in let want-disk = if force-disk then True else has-mode-flag mode "diskout"
   in let poison = has-mode-flag mode "poison"
   in let trace = has-mode-flag mode "trace"
   in let debug = has-mode-flag mode "debug"
   in let prof = has-mode-flag mode "profile"
   in let wd-mode = if has-mode-flag mode "pet" then WatchdogPet else WatchdogProgress
   in let hosted-target = if has-mode-flag mode "hosted-windows" then 2 else if has-mode-flag mode "hosted" then 1 else 0
   in act
    if debug then print-line-uni ("DBG:frontend src=" & show (text-length source))
    else print-line-uni ""
    if prof then print-line-uni ("PROF-BEGIN: " & show (prof-start 0))
    else print-line-uni ""
    let fe = compile-frontend-cdx source "Codex_Codex" flags
    in act
     if debug then act
      print-line-uni ("DBG:emit defs=" & show (list-length (fe.cdx-ir.defs)))
      dbg-print-def-names (fe.cdx-ir.defs) 0 (list-length (fe.cdx-ir.defs))
     end
     else print-line-uni ""
     let result = compile-to-cdx-with-exit-mode fe exit-mode poison trace wd-mode hosted-target
     in act
      if prof then print-line-uni ("PROF-END: " & show (prof-dump 0))
      else print-line-uni ""
      print-codegen-error-header (bag-errors (result.bag))
      print-bag-notices (result.bag)
      if want-map then emit-binary-tail-with-map result want-disk
      else emit-binary-tail result want-disk
     end
    end
   end

  emit-binary-size : EmitChapterResult -> Integer
  emit-binary-size (result) =
   list-length (result.header-bytes) + result.content-len + list-length (result.tail-bytes)

  disk-halted : Boolean -> [Console] Nothing
  disk-halted (to-disk) = act
   print-line-uni "CODEGEN-HALTED: errors in bag; no binary emitted"
   disk-stop to-disk bp-orange
  end

  emit-binary-tail : EmitChapterResult, Boolean -> [Console, FileSystem, Device.Block] Nothing
  emit-binary-tail (result) (to-disk) =
   if bag-has-errors (result.bag) then disk-halted to-disk
   else act
    print-line-uni ("SIZE:" & integer-to-text (emit-binary-size result))
    if to-disk then emit-binary-to-disk result
    else act
     write-binary (result.header-bytes)
     write-binary-buf (result.content-buf) 0 (result.content-len)
     write-binary (result.tail-bytes)
    end
   end

 write-binary and write-binary-buf reach a board through neither of their two
 arms: the fast one probes for codex-vm on port 0x511 and the fallback writes
 COM1 a byte at a time, and a UEFI machine with no UART answers neither. So a
 metal compile puts the CDX on the boot volume instead, and the verdict beside
 it, because print-line-uni is that same serial line.

 DISK mode takes this arm unconditionally, and emit-from-disk says so with an
 argument rather than emit-cdx re-deriving it from the mode line. Measured
 2026-08-09 with a probe at the head of emit-cdx: on that path `mode` is not a
 damaged string but not a string at all, arriving as twelve bytes of unrelated
 memory, so every has-mode-flag answers False and `parse-mode-cmd mode` does
 not equal "DISK" either. Deriving the sink from a value in that state is what
 made an earlier attempt dead code.

 The segments go down uncopied. The content is already a buffer, and routing it
 through a List would cost eight bytes of arena per byte of file.

  emit-binary-to-disk : EmitChapterResult -> [Console, Device.Block] Nothing
  emit-binary-to-disk (result) = act
   disk-rung "compiled" 1 bp-blue bp-orange
   ok <- fat16-write-segments "OUT.CDX" (result.header-bytes) (result.content-buf) (result.content-len) (result.tail-bytes)
   emit-disk-verdict ok (emit-binary-size result)
  end

 The verdict re-reads the directory instead of taking the writer's word.
 Measured 2026-08-11: with the medium read-only, codex-vm printed
 `WARN: cannot reopen disk ... for write` on every sector and
 fat16-write-segments still answered True, so a rung that trusted `ok` was a
 rung that could not fail.

  disk-entry-size : Maybe Fat16DirEntry -> Integer
  disk-entry-size (m) = when m
    is Just (e) -> e.de-size
    is None -> 0 - 1

  disk-landed : Boolean, Integer, Integer -> Integer
  disk-landed (ok) (got) (want) =
    if got /= want then 0
    else if ok then 1
    else 0

  emit-disk-verdict : Boolean, Integer -> [Console, Device.Block] Nothing
  emit-disk-verdict (ok) (size) = act
   vol <- fat16-boot-volume
   entry <- fat16-resolve-path vol "OUT.CDX"
   emit-disk-say (disk-landed ok (disk-entry-size entry) size) size (disk-entry-size entry)
  end

 The footer: verdict, total wall seconds, then the phase table the pipeline
 banked through bp-log-phase. A row's first qword is eight packed label
 bytes; unpacking stops at the first zero byte.

  disk-unpack8 : Integer, Integer, Text -> Text
  disk-unpack8 (v) (i) (acc) =
   if i >= 8 then acc
   else let b = int-mod (bit-shru v (i * 8)) 256
   in if b == 0 then acc
   else disk-unpack8 v (i + 1) (acc & char-encode (code-to-char (from-unicode b)))

  disk-print-phases : Integer, Integer -> [Console] Nothing
  disk-print-phases (i) (n) =
   if i >= n then print-text ""
   else act
    print-line-uni ("PHASE " & disk-unpack8 (peek-qword (bp-log-rows + i * 24) 0) 0 "" & " " & integer-to-text (peek-qword (bp-log-rows + i * 24) 8) & "s heap " & integer-to-text (peek-qword (bp-log-rows + i * 24) 16) & "MB")
    disk-print-phases (i + 1) n
   end

  emit-disk-say : Integer, Integer, Integer -> [Console, Device.Block] Nothing
  emit-disk-say (landed) (size) (got) = act
   disk-mark "wrote" landed bp-white bp-blue
   let line = if landed == 1 then "OK OUT.CDX " & integer-to-text size else "FAILED " & integer-to-text got & " of " & integer-to-text size
   in act
    v <- fat16-write-file "OUT.TXT" line
    print-line-uni ("DISK-OUT: " & line)
    t <- disk-build-footer landed
    disk-stop True (if landed == 1 then bp-white else bp-blue)
   end
  end

  disk-build-footer : Integer -> [Console] Nothing
  disk-build-footer (landed) =
   if bp-armed 0 == False then print-text ""
   else act
    p <- disk-print-phases 0 (peek-qword bp-log-count-cell 0)
    print-line-uni ("BUILD " & (if landed == 1 then "YAY" else "NAY") & " " & bp-hms-text (bp-rtc-seconds 0) & " total " & integer-to-text (phase-took (peek-qword bp-log-start-cell 0) (bp-rtc-seconds 0)) & "s")
   end

  emit-binary-tail-with-map : EmitChapterResult, Boolean -> [Console, FileSystem, Device.Block] Nothing
  emit-binary-tail-with-map (result) (to-disk) =
   if bag-has-errors (result.bag) then disk-halted to-disk
   else act
    print-line-uni ("SIZE:" & integer-to-text (emit-binary-size result))
    if to-disk then emit-binary-to-disk result
    else act
     write-binary (result.header-bytes)
     write-binary-buf (result.content-buf) 0 (result.content-len)
     write-binary (result.tail-bytes)
    end
    emit-symbol-map (result.symbol-map) 0 (list-length (result.symbol-map))
   end

  emit-symbol-map : List Text, Integer, Integer -> [Console] Nothing
  emit-symbol-map (lines) (i) (len) =
   if len == 0 then print-line-uni "MAP:0"
   else act
    print-line-uni ("MAP:" & show len)
    emit-map-lines lines i len
   end

  emit-map-lines : List Text, Integer, Integer -> [Console] Nothing
  emit-map-lines (lines) (i) (len) =
   if i >= len then print-line-uni "MAP-END"
   else act
    print-line-uni (list-at lines i)
    emit-map-lines lines (i + 1) len
   end

  emit-text : CompileTarget, Text, CompileFlags -> [Console] Nothing
  emit-text (target) (source) (flags) =
   let fe = compile-frontend source "Program" flags
   in let h-pre-emit = __heap-save
   in let text = compile-text fe target
   in let h-post-emit = __heap-save
   in act
    print-codegen-error-header (bag-errors (fe.bag))
    if bag-has-errors (fe.bag) then print-line-uni "CODEGEN-HALTED: errors in bag; no text emitted"
    else print-line-uni text
    print-line-uni ((format-heap-marks-wd (fe.heap-marks) & format-emit-marks h-pre-emit h-post-emit "WD:PHASE-"))
   end

 Both IR front doors emit the SAME IR, and this is the function that makes that
 true. From main 19558 until 20144 emit-ir-cce lifted and emit-ir-uni did not,
 so `-IrUni` and `-IrCce` carried different IR for the same program while
 `-IrUni` was the only readable one. COMPILER-29's cause was recorded wrong
 twice off an `-IrUni` dump for exactly that reason. Both call this now, so a
 future divergence has to be written down deliberately.

 `no-lift` is the deliberate exception and it has one caller, build/jonquil.ps1,
 which needs the SOURCE-shaped defs: lifting relocates a lambda body into
 __lam_N, and jonquil compares a def's string data against its OWN header, so a
 self-reproducing construction hidden inside a lambda would move out from under
 the comparison. Suppressing the lift there preserves exactly the arm that
 shipped before this change.

  lift-ir-for-emit : IRChapter, CompileFlags -> IRChapter
  lift-ir-for-emit (ir) (flags) =
   if flags.no-lift then ir
   else let lift-deck-height = scaled-floor (flags.deck-scale) demand-lift-floor demand-lift-guard-band
   in let lift-base = build lift-deck-height
   in let lift-ceiling = lift-base + lift-deck-height
   in deck-record (lift-lambdas ir lift-ceiling)

  emit-ir-uni : Text, CompileFlags -> [Console] Nothing
  emit-ir-uni (source) (flags) =
   let fe = compile-frontend-ir source "Program" flags
   in let h-pre-emit = __heap-save
   in act
    print-codegen-error-header (bag-errors (fe.bag))
    print-bag-notices (fe.bag)
    if bag-has-errors (fe.bag) then print-line-uni "CODEGEN-HALTED: errors in bag; no IR emitted"
    else let lifted-ir = lift-ir-for-emit (fe.ir) flags
     in act
     print-line-uni "IR-BEGIN"
     print-line-uni (emit-ir-chapter (ir-prune-unreachable-roots lifted-ir ir-emit-roots) (fe.text-meta) (fe.type-defs))
     print-line-uni "IR-END"
    end
    let h-post-emit = __heap-save
    in print-line-uni ((format-heap-marks-wd (fe.heap-marks) & format-emit-marks h-pre-emit h-post-emit "WD:PHASE-"))
   end

 The SIZE-framed wire format the emit plugs consume: the SIZE line must
 precede the first payload byte, and the closing print-line supplies the
 one raw linefeed that follows the payload. Only emission knows a def's
 length, hence two passes -- ir-defs-wire-size for the total, then
 ir-print-defs through print-text so the wire bytes are exactly what
 emit-ir-chapter produced.

  emit-ir-cce : Text, CompileFlags -> [Console] Nothing
  emit-ir-cce (source) (flags) =
   let fe = compile-frontend-ir source "Program" flags
   in let h-pre-emit = __heap-save
   in act
    if flags.wire-trace then print-line-uni ("FE-DONE frontier " & integer-to-text h-pre-emit) else print-text ""
    print-codegen-error-header (bag-errors (fe.bag))
    if bag-has-errors (fe.bag) then print-line-uni "CODEGEN-HALTED: errors in bag; no IR emitted"
    else let lifted-ir = lift-ir-for-emit (fe.ir) flags
     in let raw-defs = lifted-ir.defs
     in act
      if flags.wire-trace then ir-trace-dce-cost raw-defs 0 (list-length raw-defs) else print-text ""
      let ir = ir-prune-unreachable-roots lifted-ir ir-emit-roots
      in let defs-len = list-length (ir.defs)
      in act
       if flags.wire-trace then ir-trace-def-sizes (ir.defs) 0 defs-len else print-text ""
       let prefix = emit-ir-chapter-prefix ir (fe.text-meta) (fe.type-defs)
       in let total = text-length prefix + ir-defs-wire-size (ir.defs) 0 defs-len 0 + 3
       in act
        print-line-uni ("SIZE:" & show total)
        print-text prefix
        ir-print-defs (ir.defs) 0 defs-len
        print-line ""
       end
      end
     end
    let h-post-emit = __heap-save
    in print-line-uni ((format-heap-marks-wd (fe.heap-marks) & format-emit-marks h-pre-emit h-post-emit "WD:PHASE-"))
   end

  emit-measure : Text, CompileFlags -> [Console] Nothing
  emit-measure (source) (flags) =
   let fe = compile-frontend source "Program" flags
   in let h-pre-emit = __heap-save
   in let text = compile-text fe CtCodexText
   in let h-post-emit = __heap-save
   in print-line-uni ((format-heap-marks (fe.heap-marks) & format-emit-marks h-pre-emit h-post-emit "PHASE-") & format-phase-decks (fe.phase-metrics) 0 (list-length (fe.phase-metrics)) "" & "EMIT-BYTES:" & integer-to-text (text-length text) & "\n")

  format-phase-decks : List PhaseMetrics, Integer, Integer, Text -> Text
  format-phase-decks (ms) (i) (len) (acc) =
   if i == len then acc
   else let m = list-at ms i
   in format-phase-decks ms (i + 1) len (acc & "DECK-" & integer-to-text i & ":phase=" & (m.label) & " origin=" & integer-to-text (m.deck-origin) & " end=" & integer-to-text (m.deck-end) & " used=" & integer-to-text (m.deck-end - m.deck-origin) & " bivy-origin=" & integer-to-text (m.bivy-origin) & " bivy-hwm=" & integer-to-text (m.bivy-hwm) & " bivy-used=" & integer-to-text (m.bivy-hwm - m.bivy-origin) & "\n")

  parse-mode-cmd : Text -> Text
  parse-mode-cmd (mode) =
   let parts = text-split mode " "
   in if list-length parts == 0 then mode
      else list-at parts 0

  dbg-print-def-names : List IRDef, Integer, Integer -> [Console] Nothing
  dbg-print-def-names (defs) (i) (len) = act
   if i >= len then print-line-uni ""
   else let d = list-at defs i
   in act
    print-line-uni ("DBG:def " & show i & " " & d.name)
    dbg-print-def-names defs (i + 1) len
   end
  end

  parse-mode-flags : Text, Integer -> CompileFlags
  parse-mode-flags (mode) (unit-len) =
   CompileFlags { prose = has-mode-flag mode "prose", escape-check = has-mode-flag mode "escape-check", poison-compact = has-mode-flag mode "poison-compact", deck-scale = effective-deck-scale mode unit-len, phase-trace = has-mode-flag mode "debug", wire-trace = has-mode-flag mode "wsz", cost-report = has-mode-flag mode "cost-report", no-lift = has-mode-flag mode "no-lift", pipeline = pipeline-of mode }

 The volume is resolved from the disk's own GPT rather than assumed to
 start at LBA 2048. That constant is only right for an image our own
 GptWriter laid down; a stick partitioned elsewhere puts the volume at a
 different offset. 2048 remains the fallback when there is no readable GPT.

  emit-from-disk : Text -> [Console, FileSystem] Nothing
  emit-from-disk (mode) = act
   disk-rung "mode" 1 bp-yellow bp-cyan
   path-result <- read-line
   vol <- disk-locate-volume
   disk-rung "volume" (bp-truth (vol.vol-bytes-per-sector == 512)) bp-magenta bp-yellow
   d <- disk-diag path-result
   m <- disk-diag-mem vol
   v <- disk-diag-vol vol
   when disk-source vol disk-default-path
     is Just (source) ->
       let o = bp-pass 1 bp-orange bp-magenta
       in let foreword-prefix = disk-resolve-forewords vol source mode
       in let full = foreword-prefix & source
       in let flags = parse-mode-flags mode (text-length full)
       in emit-cdx full mode flags True
     is None -> disk-no-source ("DISK: file not found: " & disk-default-path)
  end

 The volume rung reads the BPB rather than the mount's own answer.
 fat16-boot-volume returns a record whatever the medium said, so a payload
 built without UEFI mode reads down the bare-metal path, gets zeroes, and
 mounts a volume that satisfies every pointer test.

 The source rung paints on the way through and does not trace, because
 `mode` is intact in this frame and damaged one call deeper. The next rung's
 line names it: nothing reaches `compiled` without ORANGE having been painted.

 On this box every sector of the source is a separate firmware Block I/O call
 over USB, and a 2.78 MB source is 5,429 of them. The bed's disk is an
 in-memory image, so the same read costs nothing there and the difference does
 not appear until a stick is in a machine.

 The two phases are counted separately because they fail differently. The
 chain walk is I/O and is slow only on metal; the conversion is arithmetic and
 costs the same in both. Which of them a stall lands in is what no flight has
 been able to say.

 The counter starts AT the threshold so the first bar is drawn before the
 first sector is asked for. A heartbeat whose first beat is minutes away
 answers the question too late to be worth having.

  disk-read-report-every : Integer
  disk-read-report-every = 64

  disk-convert-chunk : Integer
  disk-convert-chunk = 65536

  disk-sector-total : Fat16Volume, Integer -> Integer
  disk-sector-total (vol) (size) =
   (size + (vol.vol-bytes-per-sector) - 1) / (vol.vol-bytes-per-sector)

  disk-read-tick : Integer, Integer, Integer -> Integer
  disk-read-tick (since) (n) (total) =
   if since < disk-read-report-every then 0
   else bp-progress n total 0 bp-white

  disk-read-chain : Fat16Volume, Integer, Integer, Integer, List Integer, Integer, Integer, Integer -> [Device.Block] List Integer
  disk-read-chain (vol) (cluster) (remaining) (sector-off) (acc) (n) (since) (total) =
   if remaining <= 0 then acc
   else if fat16-is-end cluster then acc
   else act
    t <- disk-read-tick since n total
    buf <- block-read-sector (fat16-cluster-sector vol cluster + sector-off)
    disk-read-step vol cluster remaining sector-off acc buf n (if since < disk-read-report-every then since + 1 else 0) total
   end

  disk-read-step : Fat16Volume, Integer, Integer, Integer, List Integer, Integer, Integer, Integer, Integer -> [Device.Block] List Integer
  disk-read-step (vol) (cluster) (remaining) (sector-off) (acc) (buf) (n) (since) (total) =
   let bytes-this = if remaining < (vol.vol-bytes-per-sector) then remaining else (vol.vol-bytes-per-sector)
   in let acc2 = fat16-copy-bytes buf 0 bytes-this acc
   in let next-sector-off = sector-off + 1
   in if next-sector-off >= (vol.vol-sectors-per-cluster)
     then disk-read-chain vol (fat16-next-cluster vol cluster) (remaining - bytes-this) 0 acc2 (n + 1) since total
     else disk-read-chain vol cluster (remaining - bytes-this) next-sector-off acc2 (n + 1) since total

 The chunking exists for the bar and for nothing else: fat16-source-chars
 threads its accumulator, so converting in pieces pushes onto the same list
 the single call would have built and the text is identical either way.

  disk-convert : List Integer, List Integer, Integer, Integer, List Text -> Text
  disk-convert (tbl) (bs) (i) (len) (acc) =
   if i >= len then text-concat-list acc
   else let p = bp-progress i len bp-progress-height bp-cyan
   in let hi = if i + disk-convert-chunk > len then len else i + disk-convert-chunk
   in disk-convert tbl bs hi len (fat16-source-chars tbl bs i hi acc)

 The board's state, printed as integers only. Every previous build died before
 its first line here, and each of them built that line out of the path Text --
 so nothing below touches the path as text until its length has been shown to
 be sane. The addresses are proc 0's filesystem and network scope
 (proc-table-base + proc-scope-offset / + proc-net-scope-offset) and the serial
 ring's write and read positions (serial-write-pos-addr, serial-read-pos-addr),
 all in X86_64Boot.codex.

  disk-diag-stamp : Integer
  disk-diag-stamp = 20260815

  disk-diag : Maybe Text -> [Console] Nothing
  disk-diag (pr) = act
   print-line-uni ("DIAG stamp " & integer-to-text disk-diag-stamp)
   print-line-uni ("DIAG scope " & integer-to-text (peek-qword 20544 0) & " net " & integer-to-text (peek-qword 20504 0))
   print-line-uni ("DIAG ring w " & integer-to-text (peek-qword 28704 0) & " r " & integer-to-text (peek-qword 28712 0))
   disk-diag-path pr
  end

 Where things LIVE, and whether painting moves them. The 2026-08-13 flight of
 a5fix.img read every field of the volume record as 71777214294589695, which
 is 00FF00FF00FF00FF -- two MAGENTA pixels -- after the volume rung's magenta
 fill, on a board where the same binary under OVMF reads them correctly. So
 either the record's memory is being painted over, or the record pointer has
 come to point into painted memory, and the addresses decide which: the
 record's own address against the handoff's base + h*stride*4 extent, read
 raw off the block the stub published. The stomp pair reads one field, paints
 the full field magenta again, and reads it back: a value that MOVES convicts
 the paint live, with every address needed for the arithmetic already on the
 glass.

  disk-diag-mem : Fat16Volume -> [Console] Nothing
  disk-diag-mem (vol) = act
   print-line-uni ("DIAG mem vol " & integer-to-text (address-of vol) & " heap " & integer-to-text __heap-save)
   print-line-uni ("DIAG hand base " & integer-to-text (peek-qword 126976 16) & " wh " & integer-to-text (peek-qword 126976 24) & " stride " & integer-to-text (peek-qword 126976 32))
   print-line-uni ("DIAG stomp pre " & integer-to-text (vol.vol-bytes-per-sector))
   p <- bp-paint bp-magenta
   print-line-uni ("DIAG stomp post " & integer-to-text (vol.vol-bytes-per-sector))
  end

 Which volume was actually mounted. fat16-boot-volume takes the first usable
 GPT partition and the ladder only ever checked bytes-per-sector, so any real
 FAT volume on the machine passes -- including one on a different disk, which
 would mount cleanly and hold no SOURCE.SRC. Our own image is part 2048, root
 32 sectors, 26591 total.

  disk-diag-vol : Fat16Volume -> [Console] Nothing
  disk-diag-vol (vol) = act
   print-line-uni ("DIAG vol part " & integer-to-text (vol.vol-part-start) & " bps " & integer-to-text (vol.vol-bytes-per-sector) & " spc " & integer-to-text (vol.vol-sectors-per-cluster))
   print-line-uni ("DIAG vol fat " & integer-to-text (vol.vol-fat-start) & " root " & integer-to-text (vol.vol-root-start) & " ents " & integer-to-text (vol.vol-root-entry-count))
   print-line-uni ("DIAG vol data " & integer-to-text (vol.vol-data-start) & " total " & integer-to-text (vol.vol-total-sectors) & " clusters " & integer-to-text (vol.vol-cluster-count))
  end

 Measured on the ASUS 2026-08-13: the three lines above print and this one does
 not, and the None arm would have printed too, so the Maybe read-line returns
 for the SECOND call cannot be dispatched on at all. The first call's value is
 sound -- the mode line reaches dispatch-on-mode and selects DISK. The ring is
 sound: write 32, read 16, both lines consumed, the sixteen extra bytes are the
 UART poll's phantoms and sit past the read point. So the bytes are right and
 the value built from them is not. Left here as the record of what was measured;
 the path below no longer depends on it.

  disk-diag-path : Maybe Text -> [Console] Nothing
  disk-diag-path (pr) = print-line-uni "DIAG path SKIPPED (see chapter note)"

 The name is fixed by the image builder: build-img -Source always writes
 SOURCE.SRC, and the stub's second stdin line has never said anything else.

  disk-default-path : Text
  disk-default-path = "SOURCE.SRC"

 The device behind block-read-sector depends on how the block helper bound
 it. Bound through LoadedImage->DeviceHandle the firmware hands a PARTITION,
 whose LBA 0 is the volume's own boot sector and whose GPT read fails; bound
 through the LocateProtocol fallback it is a raw disk, and on a board with
 more than one the firmware chooses which. So the mount is a ladder judged
 by content rather than by the BPB alone -- a foreign FAT volume parses
 cleanly and holds no source file: take the GPT walk if the source resolves
 on it, then partition-relative LBA 0, and otherwise keep the GPT walk's
 answer so the geometry that gets printed is the mount that refused.

  disk-vol-has-source : Fat16Volume -> [Device.Block] Boolean
  disk-vol-has-source (vol) =
   if fat16-vol-is-usable vol == False then False
   else when fat16-resolve-path vol disk-default-path
     is Just (e) -> True
     is None -> False

  disk-locate-volume : [Device.Block] Fat16Volume
  disk-locate-volume = act
   g <- fat16-boot-volume
   ok <- disk-vol-has-source g
   if ok then g else disk-locate-volume-zero g
  end

 fat16-parse-bpb divides by the bytes-per-sector and sectors-per-cluster it
 reads off the sector, so LBA 0 is probed raw before fat16-init is allowed
 near it: on a raw disk LBA 0 is a protective MBR whose byte 11 is zero, and
 handing that to the parser is the divide fault Fat16's own prose warns
 about. 11 and 13 are the FAT BPB's bytes-per-sector and sectors-per-cluster
 offsets.

  disk-locate-volume-zero : Fat16Volume -> [Device.Block] Fat16Volume
  disk-locate-volume-zero (g) = act
   buf <- block-read-sector 0
   disk-locate-volume-zero-buf g buf
  end

  disk-locate-volume-zero-buf : Fat16Volume, Integer -> [Device.Block] Fat16Volume
  disk-locate-volume-zero-buf (g) (buf) =
   let bps = peek-byte buf 11 + peek-byte buf 12 * 256
   in let spc = peek-byte buf 13
   in if (bps == 512) & (spc > 0) then disk-locate-volume-zero-init g else g

  disk-locate-volume-zero-init : Fat16Volume -> [Device.Block] Fat16Volume
  disk-locate-volume-zero-init (g) = act
   z <- fat16-init 0
   ok <- disk-vol-has-source z
   if ok then z else g
  end

  disk-diag-len : Text, Integer -> [Console] Nothing
  disk-diag-len (p) (n) = act
   print-line-uni ("DIAG path len " & integer-to-text n)
   disk-diag-chars p n
  end

  disk-diag-chars : Text, Integer -> [Console] Nothing
  disk-diag-chars (p) (n) =
   if n <= 0 then print-line-uni "DIAG path EMPTY"
   else if n > 64 then print-line-uni "DIAG path len INSANE"
   else print-line-uni ("DIAG path c0 " & integer-to-text (char-code-at p 0)
     & " c1 " & integer-to-text (char-code-at p (if n > 1 then 1 else 0))
     & " c2 " & integer-to-text (char-code-at p (if n > 2 then 2 else 0))
     & " c3 " & integer-to-text (char-code-at p (if n > 3 then 3 else 0)))

 Each step announces itself BEFORE it acts, so the last line on the glass names
 the step that did not return rather than the last one that did.

 The build header. Wall clock off the CMOS RTC (armed-guarded, zeroes in any
 bed with no handoff), then the log cells are zeroed so the footer's phase
 table starts empty, and the start second is banked for the footer's total.

  disk-build-header : Text -> [Console] Nothing
  disk-build-header (path) =
   if bp-armed 0 == False then print-text ""
   else act
    print-line-uni ("BUILD " & bp-rtc-date-text 0 & " " & bp-hms-text (bp-rtc-seconds 0) & " " & path)
    z <- bp-poke64 bp-log-count-cell 0
    s <- bp-poke64 bp-log-start-cell (bp-rtc-seconds 0)
    print-text ""
   end

  disk-source : Fat16Volume, Text -> [Console, Device.Block] Maybe Text
  disk-source (vol) (path) = act
   hd <- disk-build-header path
   print-line-uni ("DISK-SOURCE resolving [" & path & "] over " & integer-to-text (disk-root-sectors vol) & " root sectors")
   disk-source-found vol path
  end

  disk-source-found : Fat16Volume, Text -> [Console, Device.Block] Maybe Text
  disk-source-found (vol) (path) =
   when fat16-resolve-path vol path
     is Just (entry) -> disk-source-read vol entry
     is None -> None

  disk-source-read : Fat16Volume, Fat16DirEntry -> [Console, Device.Block] Maybe Text
  disk-source-read (vol) (entry) = act
   print-line-uni ("DISK-SOURCE found cluster " & integer-to-text (entry.de-cluster) & " size " & integer-to-text (entry.de-size) & " sectors " & integer-to-text (disk-sector-total vol (entry.de-size)))
   disk-source-bytes vol entry
  end

 The checksum is FNV-1a over the raw bytes as read, printed before the CCE
 conversion so a conversion defect cannot contaminate the fingerprint. The
 offset basis and prime are FNV's own constants; the products wrap, which is
 what FNV requires and what bare imul does.

  disk-fnv : List Integer, Integer, Integer, Integer -> Integer
  disk-fnv (bs) (i) (n) (h) =
   if i >= n then h
   else disk-fnv bs (i + 1) n ((bit-xor h (list-at bs i)) * 1099511628211)

 The seed constant is FNV-1a 64's offset basis, #CBF29CE484222325. Its top bit
 is set, so read back as a signed i64 it is a large negative number, which is
 why a fingerprint printed as decimal reads negative.

  disk-build-fnv : Fat16DirEntry, List Integer -> [Console] Nothing
  disk-build-fnv (entry) (bs) =
   if bp-armed 0 == False then print-text ""
   else print-line-uni ("SOURCE " & integer-to-text (entry.de-size) & " bytes fnv " & integer-to-text (disk-fnv bs 0 (list-length bs) (#CBF29CE484222325)))

  disk-source-bytes : Fat16Volume, Fat16DirEntry -> [Console, Device.Block] Maybe Text
  disk-source-bytes (vol) (entry) = act
   bs <- disk-read-chain vol (entry.de-cluster) (entry.de-size) 0 [] 0 disk-read-report-every (disk-sector-total vol (entry.de-size))
   f <- disk-build-fnv entry bs
   Just (disk-convert cce-to-unicode-table bs 0 (list-length bs) [])
  end

  disk-root-sectors : Fat16Volume -> Integer
  disk-root-sectors (vol) =
   ((vol.vol-root-entry-count) * 32 + (vol.vol-bytes-per-sector) - 1) / (vol.vol-bytes-per-sector)

 The print comes FIRST. disk-rung holds on a failed rung and never returns, so
 a reason printed after it is a reason nobody has ever read: both of these
 callers looked identical on the glass for as long as the ladder has existed.

 The memory line prints LAST, in the failure path itself, because the
 firmware console scrolls and keeps no history: the 2026-08-13 boot printed
 the addresses that would have settled the corruption question and they were
 off the top of the glass before the failure line landed. The last lines are
 the only ones an operator can photograph.

  disk-no-source : Text -> [Console] Nothing
  disk-no-source (why) = act
   print-line-uni why
   print-line-uni ("DIAG heap " & integer-to-text __heap-save & " hand base " & integer-to-text (peek-qword 126976 16) & " wh " & integer-to-text (peek-qword 126976 24) & " stride " & integer-to-text (peek-qword 126976 32))
   h <- bp-hold-band-if-armed bp-magenta
   print-line-uni "DISK-LADDER stopped at source"
  end

  compile-plain : Text, Text, Text, CompileFlags -> [Console, FileSystem] Nothing
  compile-plain (source) (cmd) (mode) (flags) =
   if cmd == "CDX" then emit-cdx source mode flags (has-mode-flag mode "diskout")
   else if cmd == "IR-UNI" then emit-ir-uni source flags
   else if cmd == "IR-CCE" then emit-ir-cce source flags
   else if cmd == "MEASURE" then emit-measure source flags
   else if cmd == "TEXT" then emit-text-streaming source flags
   else refuse-unknown-mode cmd

 TEXT is named here rather than reached by falling through, and the fall-through
 is a refusal. An `is otherwise` on a front door makes a setting that does
 nothing look exactly like one that works (L-ACCEPTED): measured at seed
 8769F31E, `ELF`, `EFI`, `UEFI` and `IMG` each emitted text byte-identical to
 `TEXT` and to a deliberately nonsensical `ZZZZ-NOT-A-MODE` once the WD:/HEAP:
 telemetry every consumer already strips is removed, with `CDX` at 89,466 bytes
 as the control.

 The refusal ships only because a census said no live caller dies by it. The
 mode token is the first space-separated word, so flags ride along untouched;
 every producer in the tree sends CDX, TEXT, IR-UNI, IR-CCE, MEASURE, or DISK,
 which `dispatch-on-mode` takes before this. The single producer of anything
 else is `codex/plugs/elf/extract-x86-output.ps1`, which sends `ELF` and which
 nothing invokes: both greps that name it are comments, one of them the elf
 plug's own instructions for a workflow that this defect had already broken.

  refuse-unknown-mode : Text -> [Console, FileSystem] Nothing
  refuse-unknown-mode (cmd) = act
   print-line-uni "CODEGEN-ERRORS:1"
   print-line-uni ("  unknown mode '" & cmd & "': nothing emitted, because a mode this compiler does not implement must not come back looking like a successful TEXT build. Modes are CDX, TEXT, IR-UNI, IR-CCE, MEASURE, DISK and RESOLVE.")
   print-line-uni ("CODEGEN-HALTED: unknown mode '" & cmd & "'; nothing emitted")
  end

  compile-with-quotations : SourceSplit, Text, Text, CompileFlags -> [Console, FileSystem, Device.Block] Nothing
  compile-with-quotations (split) (cmd) (mode) (flags) =
   let mountain = init-phase-allocator
   in let keep-height = scaled-floor (flags.deck-scale) demand-quote-keep-floor 0
   in let keep-base = build keep-height
   in let scratch-height = scaled-floor (flags.deck-scale) demand-quote-scratch-floor 0
   in let scratch-base = build scratch-height
   in let base-ws = build-works (split.sp-works)
   in let base-bundle = base-ws.ws-bundle
   in act
    bundle <- if has-mode-flag mode "store" then store-read-bundle base-bundle else act base-bundle end
    let qr = resolve-quotations (split.sp-body) bundle
    in if bag-has-errors (qr.qr-bag)
       then refuse-quotations (bag-errors (qr.qr-bag))
       else admit-quotations split cmd mode flags keep-base keep-height (qr.qr-prefix)
   end

  refuse-quotations : List Diagnostic -> [Console, FileSystem] Nothing
  refuse-quotations (errs) = act
   print-codegen-error-header errs
   print-line-uni "CODEGEN-HALTED: quotation refused; nothing emitted"
  end

  admit-quotations : SourceSplit, Text, Text, CompileFlags, Integer, Integer, Text -> [Console, FileSystem] Nothing
  admit-quotations (split) (cmd) (mode) (flags) (keep-base) (keep-height) (prefix) =
   if check-deck-overflow (text-length prefix * 2 + 4096) keep-height == 1
   then refuse-quotations (bag-errors (deck-overflow-bag "QUOTE-KEEP"))
   else let dset = __deck-set keep-base
   in let kept = deck-record (copy-sx-text keep-base prefix)
   in let sealed = compact-phase flags poison-parse
   in compile-plain (kept & split.sp-body) cmd mode flags

 RESOLVE's wire, for the consumers built against it (the Prism page and
 its beds; the boundary and this wire are recorded in
 PrismDevEnvironment.md's stage-2 convergence): source arrives on stdin
 exactly as TEXT/CDX take it; the disk is the linear-memory contract
 (`disk_reserve` before `_start` on wasm, the boot medium on metal);
 stdout carries the RESOLVED UNIT between `RESOLVE-BEGIN` and
 `RESOLVE-END` lines, in UNICODE like every other text mode and not in
 the CCE wire encoding -- the frame's whole purpose is to be read by a
 host, and `print-text` is `IR-CCE`'s writer, so a frame printed with it
 came back as mojibake for a consumer that had done nothing wrong --
 resolved chapters first, renamed
 `Chapter: quire--name` exactly as `disk-load-cite` does, then the source
 verbatim. A host with no volume (`block-sector-count` 0) gets the source
 back unchanged: the mount is never attempted, so the zeroed-BPB divide a
 bare medium produces cannot happen here. Resolution is best-effort: a
 cite whose chapter is not on the volume prepends nothing, and the
 downstream compile answers ONE CDX3007 at the cite (measured against a
 library image and its no-library control, 2026-08-28 -- an earlier
 draft of this paragraph claimed a use-site cascade, and the measurement
 killed it). `disk-load-cite` still prints one
 `CITE-MISSING <quire> <name>` line per absent chapter, before the
 frame, as a refinement CDX3007 cannot make: CDX3007's "not present in
 this compilation unit" is also what a typo'd chapter name produces,
 while CITE-MISSING says specifically that the medium was asked and did
 not have it, and it says so before a compile is paid for.

  emit-resolved : Text -> [Console, FileSystem, Device.Block] Nothing
  emit-resolved (mode) = act
   source-raw <- read-file-uni mode
   let source = utf8-to-cce source-raw
   in act
    sectors <- block-sector-count
    prefix <- if sectors == 0 then act "" end
     else act
      vol <- disk-locate-volume
      disk-resolve-forewords vol source mode
     end
    print-line-uni "RESOLVE-BEGIN"
    print-uni (prefix & source)
    print-line-uni ""
    print-line-uni "RESOLVE-END"
   end
  end

  dispatch-on-mode : Text -> [Console, FileSystem, Device.Block] Nothing
  dispatch-on-mode (mode) = act
   let cmd = parse-mode-cmd mode
   in if cmd == "DISK" then emit-from-disk mode
   else if cmd == "RESOLVE" then emit-resolved mode
   else act
    source-raw <- read-file-uni mode
    let raw = utf8-to-cce source-raw
    in let split = split-quoted-works raw
    in let flags = parse-mode-flags mode (text-length raw)
    in if has-quotations (split.sp-body)
       then compile-with-quotations split cmd mode flags
       else compile-plain (split.sp-body) cmd mode flags
   end
  end

  opening : [Console, FileSystem, Device.Block] Nothing = act
   disk-rung "entered" 1 bp-cyan bp-red
   mode-result <- read-line
   when mode-result
    is Just (mode) -> dispatch-on-mode mode
    is None -> disk-no-mode 0
  end

  disk-no-mode : Integer -> [Console] Nothing
  disk-no-mode (dummy) = act
   disk-rung "mode" 0 bp-yellow bp-cyan
   print-line-uni "Codex: no input mode on stdin"
  end

Page 1
