Chapter: UnitBounded
  cites Foreword chapter Console

Section: Types

  Meter = unit Integer

  Span = record {
    m : Meter between 0 and 10
  }

Section: Definitions

  three : Meter between 0 and 10
  three = Meter 3

  span-of : Meter between 0 and 10 -> Span
  span-of (x) = Span { m = x }

Section: Body

  opening : [Console] Nothing = act
    let a = Span { m = Meter 10 }
    in let b = span-of (Meter 0)
    in act
      print-line-uni (show (a.m))
      print-line-uni (show (b.m))
      print-line-uni (show three)
    end
  end

