Chapter: HalFlashDoubleSeal
  cites Foreword chapter Board

Section: Body
  double-seal : Integer -> [Flash, Device.Mmio] Integer
  double-seal (base) = act
    brd0 <- board-open 0 0
    ob <- flash-open-bank brd0 base
    when ob
     is (brd1, b0) -> act
       r <- flash-seal-bank b0
       r2 <- flash-seal-bank b0
       bc <- (board-close brd1)
       r2
     end
  end

  opening : Text = "double"
