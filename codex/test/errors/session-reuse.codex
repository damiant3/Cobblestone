Chapter: SessionReuse
  cites Foreword chapter Console
  cites Encode chapter DtlsSession

Section: Body

  both : Integer -> Integer
  both (n) =
    let s = dtls-session-hello dtls-session-open n
    in let a = dtls-session-flight (session-right s) 50
    in let b = dtls-session-retry (session-left s) [1] 60
    in list-length ((dtls-session-done (dtls-session-ack a 90)).step-actions) + list-length ((session-abandon b).step-actions)

  opening : [Console] Nothing = act
    print-line-uni ("both: " & show (both 0))
  end

