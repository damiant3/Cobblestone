Chapter: ScopeLetArmEscape
  cites Foreword chapter Console

Section: Entry

  escapes : Integer -> Integer
  escapes (n) =
   let w = if n > 0 then let inner = n * 10 in inner + 1 else 0
   in w + inner

  opening : [Console] Nothing = act
   print-line-uni ("escapes: " & integer-to-text (escapes 2))
  end
