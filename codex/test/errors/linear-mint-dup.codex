Chapter: LinearMintDup

Section: Defs

  bus-acquire : Integer -> linear Integer
  bus-acquire (n) = n

  bus-release : linear Integer -> Integer
  bus-release (g) = g + 0

  dup-use : Integer -> Integer
  dup-use (n) =
   let g = bus-acquire n
   in bus-release g + bus-release g

Section: Entry

  opening : Integer
  opening = dup-use 7
