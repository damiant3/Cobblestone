Chapter: HalGpioLeak
  cites Foreword chapter Board

Section: Body
  leak : Integer -> [Gpio, Device.Mmio] Integer
  leak (base) = act
    b0 <- board-open 0 0
    r <- gpio-open b0 base 5 PinOutput
    when r
     is (b1, p) -> act
       bc <- board-close b1
       mmio-read-32 base
     end
  end

  opening : Text = "leak"
