Chapter: MutLaunderSumReturn
  cites Foreword chapter Maybe

Section: Definitions

  mutable Counter = record {
   value : Integer
  }

  stash : Counter -> Maybe Counter
  stash (c) = Some c

  double-stash : Counter -> Integer
  double-stash (m) =
   let a = stash m
   in let b = stash m
   in 0

  opening : Text = show (double-stash (Counter { value = 21 }))
