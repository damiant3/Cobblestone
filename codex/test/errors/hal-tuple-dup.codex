Chapter: HalTupleDup
  cites Foreword chapter Board

Section: Body
  dup : Integer -> [Gpio, Device.Mmio] Boolean
  dup (base) = act
    b0 <- board-open 0 0
    r <- gpio-open b0 base 5 PinInput
    when r
     is (b1, p0) ->
       let (p1, level) = gpio-read p0
       in act
         c <- gpio-close p1
         d <- gpio-close p1
         bc <- (board-close b1)
         level
       end
  end

  opening : Text = "dup"