Chapter: HalTupleDup
  cites Foreword chapter Board

Section: Body
  dup : Integer -> [Gpio, Device.Mmio] Boolean
  dup (base) = act
    p0 <- gpio-open base 5 PinInput
    let (p1, level) = gpio-read p0
    in act
      c <- gpio-close p1
      d <- gpio-close p1
      level
    end
  end

  opening : Text = "dup"