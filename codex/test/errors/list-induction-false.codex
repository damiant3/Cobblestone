Chapter: ListInductionFalse

Section: Claims

  claim bogus : for all (xs : List Integer), 5 === 6
  proof bogus =
   induction on xs
    is Nil -> Refl
    is Cons (h) (t) (ih) -> Refl
   qed

Section: Main

  opening : [Console] Nothing
  opening = act
   print-line-uni "list-induction-false: should not compile"
  end
