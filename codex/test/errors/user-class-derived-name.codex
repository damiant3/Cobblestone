Chapter: UserClassDerivedName
  cites Foreword chapter Console

class Eq where
  alike : a, a -> Boolean

instance Eq Integer where
  alike (x) (y) = True

class Ord where
  before : a, a -> Boolean

instance Ord Integer where
  before (x) (y) = x < y

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (if alike 1 2 then "alike" else "different")
    print-line-uni (if before 1 2 then "before" else "after")
  end

