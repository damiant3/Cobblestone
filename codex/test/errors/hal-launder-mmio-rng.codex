Chapter: HalLaunderMmioRng
  cites Foreword chapter Board

Section: Body
  rng-lane : Integer -> [Device.Mmio] Integer
  rng-lane (base) = act
    brd0 <- board-open 0 0
    r <- rng-open brd0 base 512 32 base
    when r
     is (brd1, u0) -> act
       c <- rng-close u0
       bc <- (board-close brd1)
       c
     end
  end

  opening : Text = "launder"
