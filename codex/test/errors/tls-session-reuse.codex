Chapter: TlsSessionReuse
  cites Foreword chapter Console
  cites Encode chapter TlsSession

Section: Body

  answers : Answered p TlsEpStep -> Integer
  answers (a) =
    when a
      is Accepted (s) -> list-length ((session-abandon s).tes-out)
      is Rejected (v) -> list-length (v.tes-out)

  twice : Offered (SRecv TsClientHello (SSend TsServerFlight (SRecv TsClientFinished (SSend TsCloseNotify SEnd)))) (SRecv TsClientFinished (SSend TsCloseNotify SEnd)) TlsEpStep -> Integer
  twice (o) =
    when o
      is TookLeft (sl) -> answers (tls-session-accept-retry sl []) + answers (tls-session-accept-retry sl [])
      is TookRight (s1) -> list-length ((session-abandon s1).tes-out)
      is Refused (s) -> 0

  opening : [Console] Nothing = act
    print-line-uni ("outs: " & show (twice (tls-session-accept (tls-session-server-open (tls-ep-server-new [] [] [] [] [])) [])))
  end

