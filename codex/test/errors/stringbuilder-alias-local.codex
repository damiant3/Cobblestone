Chapter: StringBuilderAliasLocal
  cites Foreword chapter StringBuilder

 We say:

Section: Probe

  sbal-two-owners : Integer -> Text
  sbal-two-owners (x) =
    let base = sb-new
    in let a = sb-append base "alpha"
    in let b = sb-append base "beta"
    in sb-to-text a & "|" & sb-to-text b

  opening : [Console] Nothing
  opening = act
    print-line-uni (sbal-two-owners 0)
  end
