Chapter: HandlerShadowsBuiltin
  cites Foreword chapter Console

Section: Effects

  effect Store where
    get-state : [Store] Integer
    set-state : Integer -> [Store] Nothing

Section: Definitions

  bump : Integer -> [Store] Integer
  bump (n) = act
    set-state (n * 3)
    get-state
  end

  run : Integer -> [Console] Integer
  run (n) = act
    with Store (bump n)
      get-state (resume) = resume 40
      set-state (v) (resume) = print-line-uni ("set " & show v)
  end

  opening : [Console] Nothing = act
    print-line-uni (show (run 2))
  end
