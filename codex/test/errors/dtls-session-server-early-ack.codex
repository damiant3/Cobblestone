Chapter: DtlsSessionServerEarlyAck
  cites Foreword chapter Console
  cites Encode chapter DtlsSession

Section: Body

  early : Answered (SSend ServerFlight (SRecv ClientFinished (SSend HandshakeAck SEnd))) DtlsAction -> Integer
  early (a) =
    when a
      is Accepted (s0) -> list-length [dtls-session-server-done (dtls-session-server-flight s0)]
      is Rejected (v) -> 0

  opening : [Console] Nothing = act
    print-line-uni ("acks: " & show (early (dtls-session-admit [1] [2] [])))
  end

