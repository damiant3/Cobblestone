Chapter: HalLaunderMmioSpi
  cites Foreword chapter Board

Section: Body
  bus : Integer -> [Device.Mmio] Integer
  bus (base) = act
    b0 <- board-open 0 0
    r <- spi-open b0 base default-spi-config
    when r
     is (b1, s0) -> act
       c <- spi-close s0
       bc <- (board-close b1)
       c
     end
  end

  opening : Text = "launder"
