Chapter: InductionUnsound

Section: Nat

  Nat =
   | Zero
   | Succ (Nat)

  add : Nat, Nat -> Nat
  add (a) (b) = when a
   is Zero -> b
   is Succ (n) -> Succ (add n b)

Section: Bad Proof

  claim add-zero-bad : for all (n : Nat), add n Zero === n
  proof add-zero-bad =
   induction on n
    is Zero -> Refl
    is Succ (k) (ih) -> Refl
   qed

Section: Main

  opening : [Console] Nothing
  opening = act
   print-line-uni "unreachable"
  end
