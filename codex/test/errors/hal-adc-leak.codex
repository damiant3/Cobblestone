Chapter: HalAdcLeak
  cites Foreword chapter Board

Section: Body
  leak : Integer -> [Adc, Device.Mmio] Integer
  leak (base) = act
    brd0 <- board-open 0 0
    r <- adc-open brd0 base default-adc-config
    when r
     is (brd1, a0) ->
       let (a1, v) = adc-sample a0 3
       in act
         bc <- (board-close brd1)
         v
       end
  end

  opening : Text = "leak"