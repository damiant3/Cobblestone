Chapter: FlashLaunderMmio
  cites Foreword chapter Board

Section: Body
  stage : Integer -> [Device.Mmio] Integer
  stage (base) = act
    brd0 <- board-open 0 0
    ob <- flash-open-bank brd0 base
    when ob
     is (brd1, b0) -> act
       b1 <- flash-write-page b0 (base + 4096) [1, 2]
       s <- flash-seal-bank b1
       bc <- (board-close brd1)
       s
     end
  end

  opening : Text = "launder"
