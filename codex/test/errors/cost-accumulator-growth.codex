Chapter: CostAccumulatorGrowth
  cites Foreword chapter Console

Section: Body

  grow : Integer, Integer, List Integer -> List Integer
  grow (n) (i) (acc) =
    if i >= n then acc
    else grow n (i + 1) (acc & [i])

  opening : [Console] Nothing = act
    print-line-uni (show (list-length (grow 8 0 [])))
  end
