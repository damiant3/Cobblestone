Chapter: HalBoardDup
  cites Foreword chapter Board

Section: Body
  twice : Integer -> [Gpio, Device.Mmio] Integer
  twice (base) = act
    b0 <- board-open 0 0
    r1 <- gpio-open b0 base 5 PinOutput
    r2 <- gpio-open b0 base 6 PinOutput
    when r1
     is (b1, p1) -> act
       c1 <- gpio-close p1
       when r2
        is (b2, p2) -> act
          c2 <- gpio-close p2
          x1 <- board-close b1
          x2 <- (board-close b2)
          c1 + c2
        end
     end
  end

  opening : Text = "twice"
