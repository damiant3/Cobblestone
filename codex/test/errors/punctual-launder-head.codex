Chapter: PunctualLaunderHead

Section: Definitions

  slow-sum : Integer -> Integer
  slow-sum (n) = if n <= 0 then 0 else n + slow-sum (n - 1)

  slow-dbl : Integer -> Integer
  slow-dbl (n) = if n <= 0 then 0 else 2 + slow-dbl (n - 1)

  punctual spend : Integer, Integer -> Integer
  spend (c) (x) = (if c > 0 then slow-sum else slow-dbl) x

  opening : Text = show (spend 1 9)

