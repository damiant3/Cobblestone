Chapter: HalTupleOwnerLeak
  cites Foreword chapter Board

Section: Body
  drop : Integer -> [Uart, Device.Mmio] Integer
  drop (base) = act
    brd0 <- board-open 0 0
    u <- uart-open brd0 base default-uart-config
    when u
     is (brd1, u0) -> act
       r <- uart-recv u0 1
       bc <- board-close brd1
       mmio-read-32 base
     end
  end

  opening : Text = "drop"