Chapter: HalFlashLeak
  cites Foreword chapter Board

Section: Body
  leak : Integer -> [Flash, Device.Mmio] Integer
  leak (base) = act
    brd0 <- board-open 0 0
    ob <- flash-open-bank brd0 base
    when ob
     is (brd1, b) -> act
       bc <- board-close brd1
       mmio-read-32 base
     end
  end

  opening : Text = "leak"
