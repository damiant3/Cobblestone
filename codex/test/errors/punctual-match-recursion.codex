Chapter: PunctualMatchRecursion

Section: Definitions

  punctual spin : Integer -> Integer
  spin (n) =
   when n
    is 0 -> 0
    is otherwise -> spin (n - 1)

  punctual spin-let : Integer -> Integer
  spin-let (n) =
   if n == 0 then 0
   else let deeper = spin-let (n - 1)
   in deeper

  opening : Integer = 0
