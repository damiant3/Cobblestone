Chapter: HalSpiCsLeak
  cites Foreword chapter Board

Section: Body
  asserted : Integer -> [Spi, Device.Mmio] Integer
  asserted (base) = act
    brd0 <- board-open 0 0
    s <- spi-open brd0 base default-spi-config
    when s
     is (brd1, s0) -> act
       t0 <- spi-select s0 2
       bc <- board-close brd1
       mmio-read-32 base
     end
  end

  opening : Text = "asserted"