Chapter: TlsSessionSecondRetry
  cites Foreword chapter Console
  cites Encode chapter TlsSession

Section: Body

  count : Offered l r TlsEpStep -> Integer
  count (o) =
    when o
      is TookLeft (s) -> list-length ((session-abandon s).tes-out)
      is TookRight (s) -> list-length ((session-abandon s).tes-out)
      is Refused (v) -> list-length (v.tes-out)

  again : Offered (SRecv TsClientHello (SSend TsServerFlight (SRecv TsClientFinished (SSend TsCloseNotify SEnd)))) (SRecv TsClientFinished (SSend TsCloseNotify SEnd)) TlsEpStep -> Integer
  again (o) =
    when o
      is TookLeft (sl) -> count (tls-session-accept sl [])
      is TookRight (s1) -> list-length ((session-abandon s1).tes-out)
      is Refused (s) -> 0

  opening : [Console] Nothing = act
    print-line-uni ("outs: " & show (again (tls-session-accept (tls-session-server-open (tls-ep-server-new [] [] [] [] [])) [])))
  end

