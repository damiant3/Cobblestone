Chapter: TaskListIndex
  cites Foreword chapter Console
  cites Foreword chapter Concurrent

Section: Body

  first : Integer -> Integer
  first (n) =
    let ts = tasks-push [] (fork (\x -> n))
    in await (list-at ts 0)

  opening : [Console] Nothing = act
    print-line-uni ("first: " & show (first 5))
  end

