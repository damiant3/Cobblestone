Chapter: GenericEqWithheld
  cites Foreword chapter Console

Section: Types

  Reading = record {
    level : Real,
    tag : Text
  }

Section: Entry

  same : Eq a => a, a -> Boolean
  same (x) (y) = x == y

  opening : [Console] Nothing = act
    print-line-uni (if same (Reading { level = 1.5, tag = "a" }) (Reading { level = 1.5, tag = "a" }) then "equal" else "different")
  end

