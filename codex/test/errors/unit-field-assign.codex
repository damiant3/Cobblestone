Chapter: UnitFieldAssign
  cites Foreword chapter Console

   CDX2060  Field assignment requires a mutable record; '' is immutable
   CDX2005  Record type has no field 'x'

Section: Types

  mutable Point = record {
   x : Integer,
   y : Integer
  }

  Spot = unit Point

Section: Body

  opening : [Console] Nothing = act
    let s = Spot (Point { x = 7, y = 9 })
    in act
      s.x = 5
      print-line-uni "done"
    end
  end
