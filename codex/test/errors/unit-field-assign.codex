Chapter: UnitFieldAssign
  cites Foreword chapter Console

Section: Types

  mutable Point = record {
   x : Integer,
   y : Integer
  }

  Spot = unit Point

Section: Body

  opening : [Console] Nothing = act
    let s = Spot (Point { x = 7, y = 9 })
    in act
      s.x = 5
      print-line-uni "done"
    end
  end
