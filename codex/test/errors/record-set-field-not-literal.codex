Chapter: RecordSetFieldNotLiteral

Section: Entry

  Box = record { first : Text, flag : Boolean }

  set-named : Box, Text, Boolean -> Box
  set-named (b) (field) (val) = __record-set b field val

  opening : [Console] Nothing = act
    b <- set-named (Box { first = "kept", flag = False }) "flag" True
    print-line-uni b.first
  end
