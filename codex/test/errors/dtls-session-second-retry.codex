Section: Body

  twice : Integer = list-length ((session-abandon (dtls-session-retry (dtls-session-retry (session-left (dtls-session-hello dtls-session-open 0)) [1] 10) [2] 20)).step-actions)

  opening : [Console] Nothing = act
    print-line-uni ("retries: " & show twice)
  end

