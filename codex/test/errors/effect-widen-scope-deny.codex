Chapter: EffectWidenScopeDeny

Section: Body

  plain-print : Text -> [Console] Nothing
  plain-print (t) = act
    print-line-uni t
  end

  apply-scoped : (Text -> [Console "stdout"] Nothing), Text -> [Console "stdout"] Nothing
  apply-scoped (f) (t) = act
    f t
  end

  opening : [Console "stdout"] Nothing = act
    apply-scoped plain-print "laundered"
  end
