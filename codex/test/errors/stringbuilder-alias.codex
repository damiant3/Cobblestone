Chapter: StringBuilderAlias
  cites Foreword chapter StringBuilder

 We say:

Section: Probe

  sba-two-owners : StringBuilder -> Text
  sba-two-owners (base) =
    let a = sb-append base "alpha"
    in let b = sb-append base "beta"
    in sb-to-text a & "|" & sb-to-text b

  opening : [Console] Nothing
  opening = act
    print-line-uni (sba-two-owners sb-new)
  end
