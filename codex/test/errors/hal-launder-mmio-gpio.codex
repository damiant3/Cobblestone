Chapter: HalLaunderMmioGpio
  cites Foreword chapter Board

Section: Body
  drive : Integer -> [Device.Mmio] Integer
  drive (base) = act
    b0 <- board-open 0 0
    r <- gpio-open b0 base 5 PinOutput
    when r
     is (b1, p0) -> act
       p1 <- gpio-write p0 True
       c <- gpio-close p1
       bc <- (board-close b1)
       c
     end
  end

  opening : Text = "launder"
