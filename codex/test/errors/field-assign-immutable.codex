Chapter: Field Assign Immutable
  cites Foreword chapter Console

Section: Definitions

  Counter = record {
   value : Integer
  }

  bump : Counter -> Integer
  bump (c) = act
   c.value = c.value + 1
   c.value
  end

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (show (bump (Counter { value = 0 })))
  end
