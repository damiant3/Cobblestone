Chapter: TypeclassMethodLocalFixedBinder
  cites Foreword chapter Console

class Converter where
  convert : a, b -> b

instance Converter Integer where
  convert (x) (y) = y + 1

Section: Body

  opening : [Console] Nothing = act
    let d = Converter-dict-Integer
    in print-line-uni (show ((d.convert-impl) 0 41))
  end
