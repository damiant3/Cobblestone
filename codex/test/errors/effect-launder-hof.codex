Chapter: EffectLaunderHof
  cites Foreword chapter Console

Section: Definitions

  apply-pure : (Integer -> Integer), Integer -> Integer
  apply-pure (f) (x) = f x

  leaky : Integer -> [Console] Integer
  leaky (n) = act
    print-line-uni "side channel"
    n + 1
  end

  opening : [Console] Nothing = act
    print-line-uni (show (apply-pure leaky 41))
  end
