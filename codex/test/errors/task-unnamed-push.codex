Chapter: TaskUnnamedPush
  cites Foreword chapter Console

Section: Body

  spawn-all : Integer, List (Task Integer) -> List (Task Integer)
  spawn-all (n) (acc) =
    if n <= 0 then acc
    else spawn-all (n - 1) (list-push acc (fork (\x -> n)))

  opening : [Console] Nothing = act
    print-line-uni ("tasks: " & show (list-length (spawn-all 3 [])))
  end

