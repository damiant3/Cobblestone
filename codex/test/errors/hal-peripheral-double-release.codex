Chapter: HalPeripheralDoubleRelease
  cites Foreword chapter Board

Section: Body
  double-release : Integer -> [Uart, Device.Mmio] Integer
  double-release (base) = act
    brd0 <- board-open 0 0
    u <- uart-open brd0 base default-uart-config
    when u
     is (brd1, p) -> act
       a <- uart-close p
       b <- uart-close p
       bc <- (board-close brd1)
       a + b
     end
  end

  opening : Text = "double"
