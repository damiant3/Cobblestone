Chapter: SessionTypedMismatch
  cites Foreword chapter Console

Section: Body

  ping : SChan (SSend Integer (SRecv Integer SEnd)) -> [Concurrent] SChan SEnd
  ping (c) = act
    c1 <- s-send c 9
    c1
  end

  opening : [Console, Concurrent] Nothing = act
    c0 <- s-new
    c1 <- ping c0
    closed <- s-close c1
    print-line-uni ("closed: " & show closed)
  end

