Chapter: HalPeripheralLeak
  cites Foreword chapter Board

Section: Body
  leak : Integer -> [Uart, Device.Mmio] Integer
  leak (base) = act
    b0 <- board-open 0 0
    u <- uart-open b0 base default-uart-config
    when u
     is (b1, p) -> act
       bc <- board-close b1
       mmio-read-32 base
     end
  end

  opening : Text = "leak"
