Chapter: Ctor Field Comma
  cites Foreword chapter Console

Section: Body

  Act =
    | Seen (Integer, Text)
    | Plain (Integer)

  describe : Act -> Text
  describe (a) =
    when a
      is Seen (n) (s) -> show n & s
      is Plain (n) -> show n

  opening : [Console] Nothing = print-line-uni (describe (Plain 5))
