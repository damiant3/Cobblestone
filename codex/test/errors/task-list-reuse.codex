Chapter: TaskListReuse
  cites Foreword chapter Console
  cites Foreword chapter Concurrent

Section: Body

  both : Integer -> Integer
  both (n) =
    let ts = tasks-push [] (fork (\x -> n))
    in list-length (tasks-await-all ts) + list-length (tasks-await-all ts)

  opening : [Console] Nothing = act
    print-line-uni ("both: " & show (both 5))
  end

