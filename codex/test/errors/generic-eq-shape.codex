Chapter: GenericEqShape
  cites Foreword chapter Console

Section: Entry

  same-fn : Eq a => (a -> Integer), (a -> Integer) -> Boolean
  same-fn (f) (g) = f == g

  size : Text -> Integer
  size (s) = text-length s

  opening : [Console] Nothing = act
    print-line-uni (if same-fn size size then "equal" else "different")
  end

