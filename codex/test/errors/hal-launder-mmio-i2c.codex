Chapter: HalLaunderMmioI2c
  cites Foreword chapter Board

Section: Body
  bus : Integer -> [Device.Mmio] Integer
  bus (base) = act
    brd0 <- board-open 0 0
    r <- i2c-open brd0 base default-i2c-config
    when r
     is (brd1, b0) -> act
       c <- i2c-close b0
       bc <- (board-close brd1)
       c
     end
  end

  opening : Text = "launder"