Chapter: HalSleepOpenBank
  cites Foreword chapter Board

Section: Body
  hot : Integer -> [Power, Flash, Device.Mmio] Integer
  hot (base) = act
    b0 <- board-open base (base + 1024)
    ob <- flash-open-bank b0 (base + 2048)
    when ob
     is (b1, bank) -> sleep-deep b1 default-sleep-config
  end

  opening : Text = "hot"
