Chapter: EffectLaunderInstance
  cites Foreword chapter Console

Section: Definitions

  class Reporter where
    report : Integer -> Integer

  instance Reporter Integer where
    report (n) = act
      print-line-uni "instance side channel"
      n + 1
    end

  opening : [Console] Nothing = act
    print-line-uni ("result " & show (report 41))
  end
