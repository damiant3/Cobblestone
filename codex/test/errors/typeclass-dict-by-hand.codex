Chapter: TypeclassDictByHand
  cites Foreword chapter Console

class Converter where
  convert : a, b -> b

instance Converter Integer where
  convert (x) (y) = y

Section: Body

  opening : [Console] Nothing = act
    let d = ConverterDict { convert-impl = \x y -> y + 1 }
    in print-line-uni (show ((d.convert-impl) 0 41))
  end
