Chapter: GenericEqUnconstrained
  cites Foreword chapter Console

Section: Entry

  same : Eq a => a, a -> Boolean
  same (x) (y) = x == y

  relay : a, a -> Boolean
  relay (x) (y) = same x y

  opening : [Console] Nothing = act
    print-line-uni (if relay "a" "a" then "equal" else "different")
  end

