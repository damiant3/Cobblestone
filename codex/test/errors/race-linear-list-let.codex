Chapter: RaceLinearListLet
  cites Foreword chapter Console

Section: Body

  consume : linear Integer -> Integer
  consume (n) = n * 2

  hold : linear Integer -> Integer
  hold (n) = let fs = [\u -> consume n, \u -> 3] in race fs

  opening : [Console, Concurrent] Nothing = act
    print-line-uni (show (hold 5))
  end

