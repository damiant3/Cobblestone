Chapter: HalSleepOpenHandle
  cites Foreword chapter Board

Section: Body
  hot : Integer -> [Power, Gpio, Device.Mmio] Integer
  hot (base) = act
    b0 <- board-open base (base + 1024)
    r <- gpio-open b0 1073876992 5 PinOutput
    when r
     is (b1, p0) -> sleep-deep b1 default-sleep-config
  end

  opening : Text = "hot"
