Chapter: MutLaunderTupleReturn
  cites Foreword chapter Tuple

Section: Definitions

  mutable Counter = record {
   value : Integer
  }

  step : Counter -> (Integer, Counter)
  step (c) = (c.value, c)

  double-step : Counter -> Integer
  double-step (m) =
   let a = step m
   in let b = step m
   in 0

  opening : Text = show (double-step (Counter { value = 21 }))
