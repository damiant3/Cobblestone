Chapter: AmbigAlpha

Section: Alpha
  ambig-helper : Integer -> Integer
  ambig-helper (n) = n + 1

Chapter: AmbigBeta

Section: Beta
  ambig-helper : Integer -> Integer
  ambig-helper (n) = n + 100

Chapter: AmbigGamma

Section: Entry
  opening : [Console] Nothing
