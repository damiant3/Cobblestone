Chapter: HalRngNoUnit
  cites Foreword chapter Board
  cites Boards chapter Rp2040Board

Section: Body
  rng-lane : Integer -> [Rng, Device.Mmio] Integer
  rng-lane (n) = act
    brd0 <- board-open 0 0
    r <- rp-rng-open brd0
    when r
     is (brd1, u0) -> act
       c <- rng-close u0
       bc <- (board-close brd1)
       c
     end
  end

  opening : Text = "no unit"
