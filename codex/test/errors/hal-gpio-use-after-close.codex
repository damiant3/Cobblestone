Chapter: HalGpioUseAfterClose
  cites Foreword chapter Board

Section: Body
  use-after-close : Integer -> [Gpio, Device.Mmio] Integer
  use-after-close (base) = act
    b0 <- board-open 0 0
    q <- gpio-open b0 base 5 PinOutput
    when q
     is (b1, p0) -> act
       r <- gpio-close p0
       p1 <- gpio-write p0 True
       c <- gpio-close p1
       bc <- (board-close b1)
       c
     end
  end

  opening : Text = "uaf"
