Chapter: CircularHelper

Section: Types

  Nat =
   | Zero
   | Succ (Nat)

Section: Proofs

  helper : Nat -> (Zero === Succ Zero)
  helper (n) = helper n

  bad-c : Zero === Succ Zero
  bad-c = helper Zero

Section: Main

  opening : [Console] Nothing
  opening = act
   print-line-uni "recursive helper proof accepted"
  end
