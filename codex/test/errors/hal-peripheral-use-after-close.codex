Chapter: HalPeripheralUseAfterClose
  cites Foreword chapter Board

Section: Body
  use-after-close : Integer -> [Uart, Device.Mmio] Integer
  use-after-close (base) = act
    p0 <- uart-open base default-uart-config
    r <- uart-close p0
    p1 <- uart-send p0 65
    uart-close p1
  end

  opening : Text = "uaf"
