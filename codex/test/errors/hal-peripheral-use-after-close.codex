Chapter: HalPeripheralUseAfterClose
  cites Foreword chapter Board

Section: Body
  use-after-close : Integer -> [Uart, Device.Mmio] Integer
  use-after-close (base) = act
    b0 <- board-open 0 0
    u <- uart-open b0 base default-uart-config
    when u
     is (b1, p0) -> act
       r <- uart-close p0
       p1 <- uart-send p0 65
       c <- uart-close p1
       bc <- (board-close b1)
       c
     end
  end

  opening : Text = "uaf"
