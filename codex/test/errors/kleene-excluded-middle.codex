Chapter: KleeneExcludedMiddle

Section: Three-valued logic

  Tri =
   | TFalse
   | TUnknown
   | TTrue

  tnot : Tri -> Tri
  tnot (t) = when t
   is TFalse -> TTrue
   is TUnknown -> TUnknown
   is TTrue -> TFalse

  tor-unknown : Tri -> Tri
  tor-unknown (b) = when b
   is TFalse -> TUnknown
   is TUnknown -> TUnknown
   is TTrue -> TTrue

  tor : Tri, Tri -> Tri
  tor (a) (b) = when a
   is TFalse -> b
   is TUnknown -> tor-unknown b
   is TTrue -> TTrue

Section: The claim that must be refused

  claim excluded-middle : for all (t : Tri), tor t (tnot t) === TTrue
  proof excluded-middle =
   induction on t
    is TFalse -> Refl
    is TUnknown -> Refl
    is TTrue -> Refl
   qed

Section: Main

  opening : [Console] Nothing
  opening = act
   print-line-uni "unreachable"
  end
