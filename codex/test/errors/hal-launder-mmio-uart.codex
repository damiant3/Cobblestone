Chapter: HalLaunderMmioUart
  cites Foreword chapter Board

Section: Body
  talk : Integer -> [Device.Mmio] Integer
  talk (base) = act
    b0 <- board-open 0 0
    r <- uart-open b0 base default-uart-config
    when r
     is (b1, p0) -> act
       p1 <- uart-send p0 65
       c <- uart-close p1
       bc <- (board-close b1)
       c
     end
  end

  opening : Text = "launder"
