Chapter: EffectWidenArgDeny
  cites Foreword chapter Console

Section: Definitions

  broad : Text -> [Console] Nothing
  broad (t) = print-line-uni t

  apply-narrow : (Text -> [Console.Write] Nothing), Text -> [Console.Write] Nothing
  apply-narrow (f) (t) = f t

  opening : [Console] Nothing = act
    apply-narrow broad "refused"
  end
