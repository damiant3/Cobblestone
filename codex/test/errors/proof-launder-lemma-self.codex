Chapter: LemmaSelfApply

Section: Types

  Nat =
   | Zero
   | Succ (Nat)

Section: Proofs

  claim all-zero : for all (n : Nat), n === Zero
  proof all-zero =
    induction on n
      is Zero -> Refl
      is Succ (k) (ih) -> all-zero (Succ k)
  qed

Section: Main

  opening : [Console] Nothing
  opening = act
   print-line-uni "lemma self application accepted"
  end
