Chapter: LemmaMutual

Section: Types

  Nat =
   | Zero
   | Succ (Nat)

Section: Proofs

  claim all-zero-a : for all (n : Nat), n === Zero
  proof all-zero-a =
    induction on n
      is Zero -> Refl
      is Succ (k) (ih) -> all-zero-b (Succ k)
  qed

  claim all-zero-b : for all (n : Nat), n === Zero
  proof all-zero-b =
    induction on n
      is Zero -> Refl
      is Succ (k) (ih) -> all-zero-a (Succ k)
  qed

Section: Main

  opening : [Console] Nothing
  opening = act
   print-line-uni "mutual lemma cycle accepted"
  end
