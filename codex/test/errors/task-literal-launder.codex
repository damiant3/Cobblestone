Chapter: TaskLiteralLaunder
  cites Foreword chapter Console

Section: Body

  twice : Integer -> Integer
  twice (n) =
    let ts = [fork (\x -> n)]
    in await (list-at ts 0) + await (list-at ts 0)

  opening : [Console] Nothing = act
    print-line-uni ("twice: " & show (twice 5))
  end

