Chapter: HalLaunderMmioAdc
  cites Foreword chapter Board

Section: Body
  adc-lane : Integer -> [Device.Mmio] Integer
  adc-lane (base) = act
    brd0 <- board-open 0 0
    r <- adc-open brd0 base default-adc-config
    when r
     is (brd1, a0) -> act
       c <- adc-close a0
       bc <- (board-close brd1)
       c
     end
  end

  opening : Text = "launder"