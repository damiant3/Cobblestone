Chapter: HalI2cLeak
  cites Foreword chapter Board

Section: Body
  leak : Integer -> [I2c, Device.Mmio] Integer
  leak (base) = act
    brd0 <- board-open 0 0
    r <- i2c-open brd0 base default-i2c-config
    when r
     is (brd1, b0) ->
       let (b1, n) = i2c-write b0 #68 [1]
       in act
         bc <- (board-close brd1)
         n
       end
  end

  opening : Text = "leak"