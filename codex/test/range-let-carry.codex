Chapter: RangeLetCarry

Section: Probe

  Small = record {
   s-val : Integer between 0 and 255
  }

  direct : Integer -> Small
  direct (n) = Small { s-val = __narrow (int-mod n 200) }

  via-let : Integer -> Small
  via-let (n) =
   let v = int-mod n 200
   in Small { s-val = __narrow v }

  via-two-lets : Integer -> Small
  via-two-lets (n) =
   let a = int-mod n 100
   in let b = a
   in Small { s-val = __narrow b }

  opening : [Console] Nothing
  opening = act
   print-line-uni (show ((direct 1234).s-val))
   print-line-uni (show ((via-let 1234).s-val))
   print-line-uni (show ((via-two-lets 1234).s-val))
  end
