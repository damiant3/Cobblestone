Chapter: Fat16SourceCr
  cites Foreword chapter Fat16

Section: Entry

  opening : [Console, Device.Block] Nothing
  opening = act
    vol <- fat16-init 2048

    w <- fat16-write-binary-file "CRLF.SRC" [65, 66, 13, 10, 67, 68]
    print-line-uni ("write " & show w)

    src <- fat16-read-source vol "CRLF.SRC"
    print-line-uni ("source len " & show (cr-len src))
    print-line-uni ("source codes " & cr-codes src)

    raw <- fat16-read-text vol "CRLF.SRC"
    print-line-uni ("text len " & show (cr-len raw))
    print-line-uni ("text codes " & cr-codes raw)

    lf <- fat16-write-binary-file "LF.SRC" [65, 66, 10, 67, 68]
    lfs <- fat16-read-source vol "LF.SRC"
    print-line-uni ("lf codes " & cr-codes lfs)
  end

Section: Reporting

  cr-len : Maybe Text -> Integer
  cr-len (m) = when m
    is Just (t) -> text-length t
    is None -> -1

  cr-codes : Maybe Text -> Text
  cr-codes (m) = when m
    is Just (t) -> cr-codes-loop t 0 (text-length t) ""
    is None -> "<none>"

  cr-codes-loop : Text, Integer, Integer, Text -> Text
  cr-codes-loop (t) (i) (len) (acc) =
    if i >= len then acc
    else if i == 0 then cr-codes-loop t (i + 1) len (acc & show (char-code-at t i))
    else cr-codes-loop t (i + 1) len (acc & " " & show (char-code-at t i))
