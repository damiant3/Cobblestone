Chapter: HalI2cAdcLinear
  cites Foreword chapter Board

Section: Body
  i2c-round : Integer -> [I2c, Device.Mmio] Integer
  i2c-round (base) = act
    b0 <- i2c-open base default-i2c-config
    let (b1, n) = i2c-write b0 #68 [#6B, 0]
    in act
      r <- i2c-read b1 #68 1
      when r
       is (b2, got) -> act
         c <- (i2c-close b2)
         n * 10 + list-length got
       end
    end
  end

  adc-round : Integer -> [Adc, Device.Mmio] Integer
  adc-round (base) = act
    w <- mmio-write-32 (base + adc-dr-offset) 2047
    a0 <- adc-open base default-adc-config
    let (a1, v) = adc-sample a0 3
    in act
      c <- (adc-close a1)
      v
    end
  end

  opening : [Console, I2c, Adc, Device.Mmio] Nothing = act
    i <- i2c-round 1073763328
    print-line-uni ("i2c write*10+read=" & show i)
    a <- adc-round 1073815552
    print-line-uni ("adc sample=" & show a)
  end