Section: Body

  orch-show-bool : Boolean -> Text
  orch-show-bool (b) = if b then "true" else "false"

  test-app-new : Text =
    let root = widget-panel "root" DirColumn 4 []
    in let app = app-new root theme-terminal 320 240
    in format-app-state app

  test-app-tick : Text =
    let root = widget-panel "root" DirColumn 4 [widget-label "lbl" "Hello"]
    in let app = app-new root theme-terminal 320 240
    in let app2 = app-tick app 16 []
    in "frame=" & show (app-frame-count app2) & " t=" & show (app-elapsed app2)

  test-app-timer : Text =
    let root = widget-panel "root" DirColumn 0 []
    in let app = app-new root theme-terminal 320 240
    in let app2 = app-add-timer app "refresh" 100 True
    in let app3 = app-tick app2 50 []
    in let app4 = app-tick app3 60 []
    in "timers=" & show (app4.app-timer-count) & " frame=" & show (app-frame-count app4)

  test-app-focus : Text =
    let root = widget-panel "root" DirColumn 4 [widget-input "inp" "" 0]
    in let app = app-new root theme-terminal 320 240
    in let app2 = app-set-focus app "inp"
    in "focus=" & app2.app-focused

  test-app-theme-swap : Text =
    let root = widget-panel "root" DirColumn 0 []
    in let app = app-new root theme-terminal 320 240
    in let app2 = app-set-theme app theme-lcars
    in "theme=" & (app2.app-theme).th-name & " dirty=" & orch-show-bool (app-is-dirty app2)

  test-app-overlay : Text =
    let root = widget-panel "root" DirColumn 0 []
    in let app = app-new root theme-terminal 320 240
    in let ov = overlay-modal "dialog" 50 50 200 100 (widget-label "msg" "Confirm?")
    in let app2 = app-push-overlay app ov
    in "modal=" & orch-show-bool (app-has-modal app2)

  test-app-sound : Text =
    let root = widget-panel "root" DirColumn 0 []
    in let app = app-new root theme-terminal 320 240
    in let app2 = app-play-sound app snd-click
    in "pending=" & show ((app2.app-sounds).sq-count)

  test-app-binding : Text =
    let root = widget-panel "root" DirColumn 0 [widget-gauge "hp-bar" 50 100]
    in let app = app-new root theme-terminal 320 240
    in let app2 = app-bind app "hp" 50 (bind-to-gauge "hp" "hp-bar")
    in let app3 = app-update-binding app2 "hp" 75
    in let val = bt-get (app3.app-bindings) "hp"
    in "hp=" & show val

  opening : [Console] Nothing = act
    print-line test-app-new
    print-line test-app-tick
    print-line test-app-timer
    print-line test-app-focus
    print-line test-app-theme-swap
    print-line test-app-overlay
    print-line test-app-sound
    print-line test-app-binding
  end

