Section: Body

  bc-sum : List Integer, Integer, Integer, Integer -> Integer
  bc-sum (xs) (i) (n) (acc) =
    if i >= n then acc
    else let a2 = acc * 31 + list-at xs i
    in bc-sum xs (i + 1) n (a2 - (a2 / 1000000007) * 1000000007)

  bc-line : Text, List Integer -> Text
  bc-line (name) (s) =
    let d = brotli-decompress s
    in let n = list-length d
    in if n == 0 then name & " len=0" else name & " len=" & show n & " sum=" & show (bc-sum d 0 n 0)

  opening : [Console] Nothing
  opening = act
    print-line-uni (bc-line "wbits-10" bc-wbits-10)
    print-line-uni (bc-line "wbits-16" bc-wbits-16)
    print-line-uni (bc-line "wbits-17" bc-wbits-17)
    print-line-uni (bc-line "wbits-18" bc-wbits-18)
    print-line-uni (bc-line "wbits-24" bc-wbits-24)
    print-line-uni (bc-line "window-10" bc-window-10)
    print-line-uni (bc-line "metadata-skip" bc-metadata-skip)
    print-line-uni (bc-line "simple-nsym3" bc-simple-nsym3)
