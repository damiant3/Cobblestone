Section: Helpers

  first-diff : List Integer, List Integer -> Integer
  first-diff (a) (b) =
    if list-length a /= list-length b then 0 - 2
    else fd-loop a b 0

  fd-loop : List Integer, List Integer, Integer -> Integer
  fd-loop (a) (b) (i) =
    if i >= list-length a then 0 - 1
    else if list-at a i /= list-at b i then i
    else fd-loop a b (i + 1)

  other-key : List Integer = list-set-at (for b in s-key -> b) 31 34

Section: Cases

  got-pub : List Integer = ecdsa-p256-public s-key
  got-sample : List Integer = ecdsa-p256-sign s-key msg-sample
  got-test : List Integer = ecdsa-p256-sign s-key msg-test
  got-other : List Integer = ecdsa-p256-sign other-key msg-sample

  opening : [Console] Nothing = act
    print-line-uni ("public key first difference = " & show (first-diff got-pub s-pub))
    print-line-uni ("sample signature first difference = " & show (first-diff got-sample sig-sample))
    print-line-uni ("test signature first difference = " & show (first-diff got-test sig-test))
    print-line-uni ("own sample signature verifies = " & show (ecdsa-p256-verify got-pub msg-sample got-sample))
    print-line-uni ("sample signature verifies against test = " & show (ecdsa-p256-verify got-pub msg-test got-sample))
    print-line-uni ("other key signature differs = " & show (first-diff got-other sig-sample >= 0))
    print-line-uni ("other key signature verifies under this key = " & show (ecdsa-p256-verify got-pub msg-sample got-other))
    print-line-uni ("zero key signs = " & show (list-length (ecdsa-p256-sign (list-set-at (for b in s-key -> 0) 0 0) msg-sample)))
    print-line-uni ("order key signs = " & show (list-length (ecdsa-p256-sign ec-n-bytes msg-sample)))
    print-line-uni ("short key signs = " & show (list-length (ecdsa-p256-sign [1, 2, 3] msg-sample)))
  end
