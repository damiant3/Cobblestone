Chapter: RaytracerTest
  cites Game chapter Raytracer
  cites Game chapter Rasterizer
  cites Game chapter Color
  cites Game chapter Bresenham
  cites Math chapter Geometry
  cites Math chapter Quaternion

Section: Body

  test-scene : RtScene =
    let s1 = ObjSphere (RtSphere { rt-center = vec3-new 0.0 0.0 5000.0, rt-radius = 1000.0, rt-mat = mat-shiny rgb-red })
    in let s2 = ObjSphere (RtSphere { rt-center = vec3-new 2000.0 0.0 6000.0, rt-radius = 1500.0, rt-mat = mat-matte rgb-green })
    in let floor = ObjPlane (RtPlane { rt-point = vec3-new 0.0 (0.0 - 1000.0) 0.0, rt-normal = vec3-new 0.0 1000.0 0.0, rt-mat = mat-matte (rgb 128 128 128) })
    in let light = vec3-new (0.0 - 3000.0) 5000.0 2000.0
    in let sc = scene-new light rgb-white 200 (rgb 32 32 64)
    in scene-add (scene-add (scene-add sc s1) s2) floor

  test-camera : RtCamera = rt-camera-new (vec3-new 0.0 0.0 0.0) 1000

  test-render : Text =
    let fb = rt-render test-scene test-camera 16 12
    in let total = 192
    in let bg-packed = rgb-to-packed (rgb 32 32 64)
    in let bg-count = fb-count-color fb bg-packed
    in let hit-count = total - bg-count
    in "pixels=" & show total & " bg=" & show bg-count & " hit=" & show hit-count

  test-trace-miss : Text =
    let ray = ray3-new vec3-zero (vec3-new 0.0 1000.0 0.0)
    in let hit = rt-trace ray test-scene
    in "miss=" & show (hit.rt-did-hit)

  test-trace-hit : Text =
    let ray = ray3-new vec3-zero (rt-normalize (vec3-new 0.0 0.0 1000.0))
    in let hit = rt-trace ray test-scene
    in "sphere-hit=" & show (hit.rt-did-hit) & " dist=" & show (hit.rt-dist)

  test-shade : Text =
    let ray = ray3-new vec3-zero (rt-normalize (vec3-new 0.0 0.0 1000.0))
    in let hit = rt-trace ray test-scene
    in let color = rt-shade hit test-scene (rt-normalize (vec3-new 0.0 0.0 1000.0))
    in "color=" & format-rgb color

  test-material : Text =
    let m1 = mat-matte rgb-blue
    in let m2 = mat-shiny rgb-white
    in "matte-d=" & show (m1.mat-diffuse) & " shiny-s=" & show (m2.mat-specular)

  opening : [Console] Nothing = act
    print-line-uni test-material
    print-line-uni test-trace-miss
    print-line-uni test-trace-hit
    print-line-uni test-shade
    print-line-uni test-render
  end

