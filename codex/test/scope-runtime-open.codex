Chapter: ScopeRuntimeOpen
  cites Foreword chapter Fat16

Section: Entry

  opening : [Console, Device.Block] Nothing
  opening = act
    wrote <- fat16-write-file "NO.TXT" "nope"
    print-line-uni ("wrote " & show wrote)

    vol <- fat16-init 2048
    back <- fat16-read-text vol "NO.TXT"
    print-line-uni ("read " & maybe-text back)

    names <- fat16-list-root vol
    print-line-uni ("root " & show (list-length names))
  end

Section: Reporting

  maybe-text : Maybe Text -> Text
  maybe-text (m) = when m
    is Just (t) -> t
    is None -> "<none>"
