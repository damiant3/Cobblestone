  c-capub : List Integer =
    [25, 191, 68, 9, 105, 132, 205, 254, 133, 65, 186, 193, 103, 220, 59, 150, 
     200, 80, 134, 170, 48, 182, 182, 203, 12, 92, 56, 173, 112, 49, 102, 225]

Section: Structure

  c-top : Maybe Asn1Tlv = asn1-read c-cert 0

  c-kids : List Asn1Tlv =
    when c-top
      is None -> []
      is Just (t) -> asn1-children c-cert t

  c-tbs-raw : List Integer =
    when asn1-nth c-kids 0
      is None -> []
      is Just (t) -> asn1-raw c-cert t

  c-sig : List Integer =
    when asn1-nth c-kids 2
      is None -> []
      is Just (t) -> bytes-or-empty (asn1-bit-string c-cert (t.tlv-hdr))

 The Ed25519 OID, 1.3.101.112, in its encoded form: 06 03 2b 65 70. The
 content octets are the identity -- see the chapter note on comparing OIDs
 as bytes rather than as decoded numbers.

  oid-ed25519 : List Integer = [43, 101, 112]

  c-sigalg-is-ed25519 : Boolean =
    when asn1-nth c-kids 1
      is None -> False
      is Just (alg) -> alg-oid-is c-cert alg

  alg-oid-is : List Integer, Asn1Tlv -> Boolean
  alg-oid-is (buf) (alg) =
    when asn1-nth (asn1-children buf alg) 0
      is None -> False
      is Just (o) -> asn1-oid-is buf o oid-ed25519

Section: Helpers

  bytes-or-empty : Maybe (List Integer) -> List Integer
  bytes-or-empty (m) = when m is None -> [] is Just (bs) -> bs

  yn : Boolean -> Text
  yn (b) = if b then "True" else "False"

  tlv-none : Maybe Asn1Tlv -> Boolean
  tlv-none (m) = when m is None -> True is Just (t) -> False

  bytes-none : Maybe (List Integer) -> Boolean
  bytes-none (m) = when m is None -> True is Just (bs) -> False

Section: Negatives

  n-indefinite : List Integer = [#30, #80, #00, #00]

 Non-minimal length: 0x81 0x05 says five, and so does a bare 0x05. Two
 encodings of one certificate means one of them can be signed and the
 other served.

  n-nonminimal : List Integer = [#02, #81, #05, 1, 2, 3, 4, 5]

  n-overrun : List Integer = [#04, #10, 1, 2]

 The high-tag-number form. X.509 does not need it.

  n-high-tag : List Integer = [#1F, #01, #00]

  n-leading-zero : List Integer = [#30, #82, #00, #05, 1, 2, 3, 4, 5]

 A BIT STRING claiming three unused trailing bits. Every key and signature
 X.509 puts in a BIT STRING has zero, so this is a value we do not
 understand, and we refuse it rather than shift it.

  n-bit-unused : List Integer = [#03, #03, #03, #AA, #BB]

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("asn1 top-tag=" & show (when c-top is None -> 0 - 1 is Just (t) -> t.tlv-tag))
    print-line-uni ("asn1 kids=" & show (list-length c-kids))
    print-line-uni ("asn1 tbs-raw-len=" & show (list-length c-tbs-raw))
    print-line-uni ("asn1 sig-len=" & show (list-length c-sig))
    print-line-uni ("asn1 sigalg-ed25519=" & yn c-sigalg-is-ed25519)
    print-line-uni ("asn1 verify-published=" & yn (ed25519-verify c-capub c-tbs-raw c-sig))
    print-line-uni ("asn1 rej-indefinite=" & yn (tlv-none (asn1-read n-indefinite 0)))
    print-line-uni ("asn1 rej-nonminimal=" & yn (tlv-none (asn1-read n-nonminimal 0)))
    print-line-uni ("asn1 rej-overrun=" & yn (tlv-none (asn1-read n-overrun 0)))
    print-line-uni ("asn1 rej-high-tag=" & yn (tlv-none (asn1-read n-high-tag 0)))
    print-line-uni ("asn1 rej-leading-zero=" & yn (tlv-none (asn1-read n-leading-zero 0)))
    print-line-uni ("asn1 rej-bit-unused=" & yn (bytes-none (asn1-bit-string n-bit-unused 0)))
  end
