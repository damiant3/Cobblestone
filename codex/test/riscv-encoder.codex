Chapter: RiscVEncoderTest
  cites Foreword chapter RiscVEncoder

Section: Helpers

  show-hex-word : Integer -> Text
  show-hex-word (w) =
    let b0 = bit-and w 255
    in let b1 = bit-and (bit-shru w 8) 255
    in let b2 = bit-and (bit-shru w 16) 255
    in let b3 = bit-and (bit-shru w 24) 255
    in hex-byte b3 & hex-byte b2 & hex-byte b1 & hex-byte b0

  hex-byte : Integer -> Text
  hex-byte (b) = hex-nib (b / 16) & hex-nib (bit-and b 15)

  hex-nib : Integer -> Text
  hex-nib (n) =
    when n
      is 0 -> "0"
      is 1 -> "1"
      is 2 -> "2"
      is 3 -> "3"
      is 4 -> "4"
      is 5 -> "5"
      is 6 -> "6"
      is 7 -> "7"
      is 8 -> "8"
      is 9 -> "9"
      is 10 -> "A"
      is 11 -> "B"
      is 12 -> "C"
      is 13 -> "D"
      is 14 -> "E"
      is 15 -> "F"
      is otherwise -> "?"

  show-insn : List Integer -> Text
  show-insn (bytes) =
    let w = list-at bytes 0 + list-at bytes 1 * 256 + list-at bytes 2 * 65536 + list-at bytes 3 * 16777216
    in show-hex-word w

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("add a0,a1,a2=" & show-insn (rv-add 10 11 12))
    print-line-uni ("sub a0,a1,a2=" & show-insn (rv-sub 10 11 12))
    print-line-uni ("mul a0,a1,a2=" & show-insn (rv-mul 10 11 12))
    print-line-uni ("and a0,a1,a2=" & show-insn (rv-and 10 11 12))
    print-line-uni ("or a0,a1,a2=" & show-insn (rv-or 10 11 12))
    print-line-uni ("addi a0,a1,42=" & show-insn (rv-addi 10 11 42))
    print-line-uni ("ld a0,0(a1)=" & show-insn (rv-ld 10 11 0))
    print-line-uni ("sd a1,8(a0)=" & show-insn (rv-sd 10 11 8))
    print-line-uni ("beq a0,a1,+16=" & show-insn (rv-beq 10 11 16))
    print-line-uni ("lui a0,#12345=" & show-insn (rv-lui 10 #12345))
    print-line-uni ("jal ra,+100=" & show-insn (rv-jal 1 100))
    print-line-uni ("ret=" & show-insn rv-ret)
    print-line-uni ("nop=" & show-insn rv-nop)
    print-line-uni ("mv a0,a1=" & show-insn (rv-mv 10 11))
    let li-result = rv-li 10 #DEADBEEF
    in print-line-uni ("li a0,#DEADBEEF len=" & show (list-length li-result / 4))
  end

