Chapter: EffectValuePoly
  cites Foreword chapter Maybe

Section: Definitions

  read-nothing : [Console] (Maybe a)
  read-nothing = act
   print-line-uni "read"
   None
  end

  from-int : Maybe Integer -> Integer
  from-int (m) = when m
   is Just (x) -> x + 1
   is None -> 0

  from-text : Maybe Text -> Text
  from-text (m) = when m
   is Just (s) -> s & "!"
   is None -> "none"

  opening : [Console] Nothing = act
   m1 <- read-nothing
   m2 <- read-nothing
   print-line-uni (show (from-int m1) & " " & from-text m2)
  end
