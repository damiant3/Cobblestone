Chapter: Arm64TimerTest
  cites Kernel chapter Arm64Timer
  cites Foreword chapter Console

Section: Entry

  opening : [Console, Device.Mmio] Nothing = act
    let a = read-cntvct-el0
    in let i = arm64-timer-init 0
    in let b = read-cntvct-el0
    in act
      print-line-uni ("init answers " & show i)
      print-line-uni ("frequency stored and positive: " & (if peek-qword timer-freq-addr 0 > 0 then "yes" else "no"))
      print-line-uni ("virtual counter advanced: " & (if b > a then "yes" else "no"))
    end
  end

