Chapter: CoapEncodeTest

  cites Encode chapter Coap

 Exercise the CoAP module: content-format constants, GET/POST
 request builders, ACK builder, and packet length checks.

Section: Definitions

  test-format-text : Integer
  test-format-text =
    if coap-format-text == 0 then 1 else 0

  test-format-json : Integer
  test-format-json =
    if coap-format-json == 50 then 1 else 0

  test-format-cbor : Integer
  test-format-cbor =
    if coap-format-cbor == 60 then 1 else 0

  test-get : Integer
  test-get =
    let pkt = coap-get 1 [#AA] "temperature"
    in if list-length pkt > 0 then 1 else 0

  test-post : Integer
  test-post =
    let pkt = coap-post 2 [#BB] "actuator" [1, 2, 3]
    in if list-length pkt > 0 then 1 else 0

  test-ack : Integer
  test-ack =
    let pkt = coap-ack 1
    in if list-length pkt > 0 then 1 else 0

  opening : Integer =
    let ft = test-format-text
    in let fj = test-format-json
    in let fc = test-format-cbor
    in let g = test-get
    in let p = test-post
    in let a = test-ack
    in ft + fj + fc + g + p + a

