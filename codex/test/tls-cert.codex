  opening : [Console] Nothing = act
    print-line-uni r-content-len
    print-line-uni r-content-exact
    print-line-uni r-roles-differ
    print-line-uni r-cv-len
    print-line-uni r-cv-good
    print-line-uni r-cv-reflected
    print-line-uni r-cv-othertx
    print-line-uni r-cv-trunc
    print-line-uni r-msg-len
    print-line-uni r-roundtrip
    print-line-uni r-bad-len
    print-line-uni r-empty
    print-line-uni r-sigalgs
    print-line-uni r-sigalgs-type
    print-line-uni r-sigalgs-schemes
  end
