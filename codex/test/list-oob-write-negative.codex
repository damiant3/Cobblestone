Chapter: ListOobWriteNegative
  cites Foreword chapter Console

Section: Entry

  write-before : List Integer, List Integer -> Integer
  write-before (marker) (t) =
    let corrupted = list-set-at t (0 - 1) 424242
    in list-at marker 0

  opening : [Console] Nothing = act
    print-line-uni ("marker0=" & show (write-before [999, 999, 999] [1, 2, 3]))
  end

