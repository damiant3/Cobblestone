Chapter: TypeclassInstanceTypes
  cites Foreword chapter Console

class FormatValue where
  format-value : a -> Text

instance FormatValue Integer where
  format-value (x) = show x

instance FormatValue Boolean where
  format-value (x) = show x

instance FormatValue (List Integer) where
  format-value (xs) = show (list-length xs)

class KeepValue where
  keep-value : a, b -> b

instance KeepValue Integer where
  keep-value (x) (y) = y

Section: Functions

  describe-value : FormatValue a => a -> Text
  describe-value (x) = format-value x

  opening : [Console] Nothing = act
    print-line-uni (format-value 11)
    print-line-uni (format-value True)
    print-line-uni (describe-value 12)
    print-line-uni (describe-value False)
    print-line-uni (format-value [1, 2])
    print-line-uni (show (keep-value 9 True))
    print-line-uni (keep-value 9 "free")
  end
