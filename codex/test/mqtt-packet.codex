Chapter: MqttPacketTest
  cites Encode chapter Mqtt

 Verify MQTT v5.0 packet builders produce correct wire lengths.

Section: Body

  opening : [Console] Nothing = act
   let connect = mqtt-build-connect default-mqtt-connect
   in let publish = mqtt-build-publish "sensor/temp" [50, 51, 46, 53] QosAtMostOnce False 0
   in let subscribe = mqtt-build-subscribe 1 "sensor/#" QosAtLeastOnce
   in let ping = mqtt-build-pingreq
   in act
    print-line-uni ("CONNECT len=" & show (list-length connect))
    print-line-uni ("PUBLISH len=" & show (list-length publish))
    print-line-uni ("SUBSCRIBE len=" & show (list-length subscribe))
    print-line-uni ("PINGREQ len=" & show (list-length ping))
   end
  end

