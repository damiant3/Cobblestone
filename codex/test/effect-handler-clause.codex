Chapter: EffectHandlerClause
  cites Foreword chapter Console

Section: Effects

  effect Reader where
    ask : [Reader] Integer

Section: Definitions

  quiet : Integer -> Integer
  quiet (n) =
   let r = with Reader ask
     ask (resume) = act
       print-line-uni "clause side channel"
       resume n
     end
   in r

  opening : [Console] Nothing = act
    print-line-uni ("result " & show (quiet 41))
  end
