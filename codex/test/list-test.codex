Chapter: List Test

  cites Foreword chapter List

Section: Definitions

  double : Integer -> Integer
  double (n) = n * 2

  is-even : Integer -> Boolean
  is-even (n) = (n / 2) * 2 == n

  add : Integer, Integer -> Integer
  add (a) (b) = a + b

  show-list : ConsList Integer -> Text
  show-list (xs) = when xs
    is Cons (h) (t) -> if cl-is-empty t then show h else show h & ", " & show-list t
    is Nil -> ""

  check : Text, Text, Text -> Text
  check (name) (actual) (expected) =
    if actual == expected then "PASS: " & name
    else "FAIL: " & name & " expected [" & expected & "] got [" & actual & "]"

  nums : ConsList Integer = cl-cons 1 (cl-cons 2 (cl-cons 3 (cl-cons 4 (cl-cons 5 cl-nil))))

  opening : [Console] Nothing = act
    print-line-uni "=== ConsList Prelude Module ==="
    print-line-uni ""
    print-line-uni (check "length" (show (cl-length nums)) "5")
    print-line-uni (check "head" (show (cl-head nums)) "1")
    print-line-uni (check "tail length" (show (cl-length (cl-tail nums))) "4")
    print-line-uni (check "map double" (show-list (cl-map double nums)) "2, 4, 6, 8, 10")
    print-line-uni (check "filter even" (show-list (cl-filter is-even nums)) "2, 4")
    print-line-uni (check "foldl sum" (show (cl-foldl add 0 nums)) "15")
    print-line-uni (check "reverse" (show-list (cl-reverse nums)) "5, 4, 3, 2, 1")
    print-line-uni (check "append" (show-list (cl-append (cl-cons 1 (cl-cons 2 cl-nil)) (cl-cons 3 (cl-cons 4 cl-nil)))) "1, 2, 3, 4")
    print-line-uni (check "take 3" (show-list (cl-take 3 nums)) "1, 2, 3")
    print-line-uni (check "drop 3" (show-list (cl-drop 3 nums)) "4, 5")
    print-line-uni (check "any even" (show (cl-any is-even nums)) "True")
    print-line-uni (check "all even" (show (cl-all is-even nums)) "False")
    print-line-uni (check "sum" (show (cl-sum nums)) "15")
    print-line-uni (check "is-empty nil" (show (cl-is-empty cl-nil)) "True")
    print-line-uni (check "is-empty cons" (show (cl-is-empty nums)) "False")
    print-line-uni ""
    print-line-uni "=== Array-List Operations ==="
    let xs = [10, 20, 30]
    in let ys = list-set-at xs 1 99
    in print-line-uni (check "set-at" (show (list-at ys 0) & "/" & show (list-at ys 1) & "/" & show (list-at ys 2)) "10/99/30")
    let xs2 = [1, 2, 4, 5]
    in let ys2 = list-insert-at xs2 2 3
    in print-line-uni (check "insert-at" (show (list-at ys2 0) & "/" & show (list-at ys2 1) & "/" & show (list-at ys2 2) & "/" & show (list-at ys2 3) & "/" & show (list-at ys2 4)) "1/2/3/4/5")
    print-line-uni (check "empty-direct" (show (list-length (if True then [] else [1]))) "0")
    print-line-uni (check "empty-let" (show (list-length (let zs = if True then [] else [1] in zs))) "0")
    let people = [Person { name = "Alice", age = 30 }, Person { name = "Bob", age = 25 }, Person { name = "Carol", age = 40 }]
    in print-line-uni (check "list-of-records" (show (ages-sum people 0 0)) "95")
  end

  Person = record { name : Text, age : Integer }

  ages-sum : List Person, Integer, Integer -> Integer
  ages-sum (ps) (i) (acc) =
    if i >= list-length ps then acc
    else ages-sum ps (i + 1) (acc + (list-at ps i).age)

