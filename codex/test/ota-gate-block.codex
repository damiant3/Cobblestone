Chapter: OtaGateBlock
  cites Foreword chapter OtaUpdate
  cites Foreword chapter Sha256
  cites Foreword chapter Hkdf

Section: Helpers

  flag : Boolean -> Integer
  flag (b) = if b then 1 else 0

  passed : GateAResult -> Boolean
  passed (r) =
   when r
    is GateAPass -> True
    is otherwise -> False

  block : List Integer = [67, 68, 88, 49, 10, 20, 30, 40, 50, 60]

  good-digest : List Integer
  good-digest = ota-digest-bytes block

  flip-at : List Integer, Integer -> List Integer
  flip-at (xs) (i) = list-set-at (copy-of xs) i (bit-xor (list-at xs i) 255)

  copy-of : List Integer -> List Integer
  copy-of (xs) = copy-loop xs 0 (list-length xs) []

  copy-loop : List Integer, Integer, Integer, List Integer -> List Integer
  copy-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else copy-loop xs (i + 1) len (list-push acc (list-at xs i))

Section: Checks

  check-digest-is-bytes : Integer
  check-digest-is-bytes = flag (list-length good-digest == 32)

  check-correct-digest-passes : Integer
  check-correct-digest-passes = flag (passed (gate-a-verify-block block good-digest))

  check-first-byte : Integer
  check-first-byte = flag (passed (gate-a-verify-block block (flip-at good-digest 0)) == False)

  check-middle-byte : Integer
  check-middle-byte = flag (passed (gate-a-verify-block block (flip-at good-digest 16)) == False)

  check-last-byte : Integer
  check-last-byte = flag (passed (gate-a-verify-block block (flip-at good-digest 31)) == False)

  check-short-digest : Integer
  check-short-digest = flag (passed (gate-a-verify-block block [1, 2, 3]) == False)

  check-empty-digest : Integer
  check-empty-digest = flag (passed (gate-a-verify-block block []) == False)

  check-other-block : Integer
  check-other-block = flag (passed (gate-a-verify-block [1, 2, 3, 4] good-digest) == False)

Section: Body

  opening : Integer =
   check-digest-is-bytes
   + check-correct-digest-passes
   + check-first-byte
   + check-middle-byte
   + check-last-byte
   + check-short-digest
   + check-empty-digest
   + check-other-block
