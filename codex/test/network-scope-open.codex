Chapter: NetworkScopeOpen
  cites Net chapter HttpFetch

Section: Entry

  opening : [Console, Network.Write] Nothing
  opening = act
    let a = if net-scope-admits "http://ok.host/path" then 10 else 0
    in let b = if net-scope-admits "http://evil.host/path" then 1 else 0
    in print-line-uni (show (a + b))
  end
