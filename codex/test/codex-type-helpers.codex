Chapter: CodexTypeHelpersTest
  cites Codex chapter CodexType Helpers
  cites Codex chapter Codex Types
  cites Foreword chapter Console

Section: Names
  ty-tag : CodexType -> Text
  ty-tag (ty) =
    when ty
     is TextTy -> "Text"
     is BooleanTy -> "Boolean"
     is NoExpectTy -> "none"
     is TypeVar (id) -> "v" & show id
     is IntegerTy (lo) (hi) (m) -> "Int[" & show lo & "," & show hi & "]"
     is FunTy (p) (row) (r) -> "Fun(" & ty-tag p & "->" & ty-tag r & ")"
     is ForAllTy (id) (body) -> "forall " & show id & "." & ty-tag body
     is LinearTy (inner) -> "linear " & ty-tag inner
     is otherwise -> "?"

  hw-name : HwIntWidth -> Text
  hw-name (w) =
    when w
     is HwU8 -> "U8"
     is HwU16 -> "U16"
     is HwU32 -> "U32"
     is HwU64 -> "U64"
     is HwI8 -> "I8"
     is HwI16 -> "I16"
     is HwI32 -> "I32"
     is HwI64 -> "I64"

  band : Integer, Integer -> Text
  band (lo) (hi) =
    let w = bounds-to-hw-width lo hi
    in "[" & show lo & "," & show hi & "] bytes=" & show (bounds-byte-width lo hi) & " " & hw-name w & " size=" & show (hw-width-bytes w) & " signed=" & show (hw-width-signed w) & " exact=" & show (bounds-are-hw-width lo hi)

Section: Types
  two-arg : CodexType = ForAllTy 1 (FunTy TextTy empty-row (FunTy BooleanTy empty-row (TypeVar 1)))

  opening : [Console] Nothing = act
    print-line-uni (band 0 255)
    print-line-uni (band 0 254)
    print-line-uni (band 0 256)
    print-line-uni (band 0 65535)
    print-line-uni (band 0 65536)
    print-line-uni (band 0 4294967295)
    print-line-uni (band 0 4294967296)
    print-line-uni (band (0 - 128) 127)
    print-line-uni (band (0 - 129) 127)
    print-line-uni (band (0 - 128) 128)
    print-line-uni (band (0 - 1) 0)
    print-line-uni (band (0 - 32768) 32767)
    print-line-uni (band (0 - 32769) 0)
    print-line-uni (band (0 - 2147483648) 2147483647)
    print-line-uni (band (0 - 2147483649) 0)
    print-line-uni (band i64-min i64-max)
    print-line-uni ("two-arg: " & ty-tag two-arg)
    print-line-uni ("peel-fun-param: " & ty-tag (peel-fun-param two-arg))
    print-line-uni ("peel-fun-return: " & ty-tag (peel-fun-return two-arg))
    print-line-uni ("strip-fun-args: " & ty-tag (strip-fun-args two-arg))
    print-line-uni ("peel-applied-return 0: " & ty-tag (peel-applied-return two-arg 0))
    print-line-uni ("peel-applied-return 1: " & ty-tag (peel-applied-return two-arg 1))
    print-line-uni ("peel-applied-return 2: " & ty-tag (peel-applied-return two-arg 2))
    print-line-uni ("peel-applied-return 3: " & ty-tag (peel-applied-return two-arg 3))
    print-line-uni ("strip-forall-ty: " & ty-tag (strip-forall-ty two-arg))
    print-line-uni ("peel-fun-param Text: " & ty-tag (peel-fun-param TextTy))
    print-line-uni ("strip-linear-ty: " & ty-tag (strip-linear-ty (LinearTy (LinearTy TextTy))))
  end
