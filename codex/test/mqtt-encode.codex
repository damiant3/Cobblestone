Chapter: MqttEncodeTest

  cites Encode chapter Mqtt

Section: Definitions

  test-vbi-small : Integer
  test-vbi-small =
    let encoded = mqtt-encode-vbi 127 []
    in if list-length encoded == 1 then 1 else 0

  test-vbi-large : Integer
  test-vbi-large =
    let encoded = mqtt-encode-vbi 128 []
    in if list-length encoded == 2 then 1 else 0

  test-connect : Integer
  test-connect =
    let pkt = mqtt-build-connect default-mqtt-connect
    in if list-length pkt > 0 then 1 else 0

  test-publish : Integer
  test-publish =
    let pkt = mqtt-build-publish "sensor/temp" [50, 51] QosAtMostOnce False 0
    in if list-length pkt > 0 then 1 else 0

  test-subscribe : Integer
  test-subscribe =
    let pkt = mqtt-build-subscribe 1 "sensor/#" QosAtLeastOnce
    in if list-length pkt > 0 then 1 else 0

  test-pingreq : Integer
  test-pingreq =
    let pkt = mqtt-build-pingreq
    in if list-length pkt == 2 then 1 else 0

  test-disconnect : Integer
  test-disconnect =
    let pkt = mqtt-build-disconnect
    in if list-length pkt == 2 then 1 else 0

  bytes-eq : List Integer, List Integer -> Boolean
  bytes-eq (a) (b) =
    if list-length a /= list-length b then False
    else bytes-eq-loop a b 0 (list-length a)

  bytes-eq-loop : List Integer, List Integer, Integer, Integer -> Boolean
  bytes-eq-loop (a) (b) (i) (n) =
    if i >= n then True
    else if list-at a i /= list-at b i then False
    else bytes-eq-loop a b (i + 1) n

  test-utf8-ascii : Integer
  test-utf8-ascii =
    if bytes-eq (mqtt-encode-utf8 "MQTT") [0, 4, 77, 81, 84, 84] then 1 else 0

  test-connect-bytes : Integer
  test-connect-bytes =
    let pkt = mqtt-build-connect default-mqtt-connect
    in if bytes-eq pkt [16, 22, 0, 4, 77, 81, 84, 84, 5, 2, 0, 60, 0, 0, 9, 99, 111, 100, 101, 120, 45, 105, 111, 116] then 1 else 0

  test-publish-bytes : Integer
  test-publish-bytes =
    let pkt = mqtt-build-publish "sensor/temp" [50, 51, 46, 53] QosAtMostOnce False 0
    in if bytes-eq pkt [48, 18, 0, 11, 115, 101, 110, 115, 111, 114, 47, 116, 101, 109, 112, 0, 50, 51, 46, 53] then 1 else 0

  test-subscribe-bytes : Integer
  test-subscribe-bytes =
    let pkt = mqtt-build-subscribe 1 "sensor/#" QosAtLeastOnce
    in if bytes-eq pkt [130, 14, 0, 1, 0, 0, 8, 115, 101, 110, 115, 111, 114, 47, 35, 1] then 1 else 0

  opening : Integer =
    let vs = test-vbi-small
    in let vl = test-vbi-large
    in let co = test-connect
    in let pu = test-publish
    in let su = test-subscribe
    in let pi = test-pingreq
    in let di = test-disconnect
    in let ua = test-utf8-ascii
    in let cb = test-connect-bytes
    in let pb = test-publish-bytes
    in let sb = test-subscribe-bytes
    in vs + vl + co + pu + su + pi + di + ua + cb + pb + sb

