Chapter: MqttEncodeTest

  cites Encode chapter Mqtt

 Exercise the MQTT module: variable-byte integer encoding,
 CONNECT, PUBLISH, SUBSCRIBE, PINGREQ, and DISCONNECT packets.

Section: Definitions

  test-vbi-small : Integer
  test-vbi-small =
    let encoded = mqtt-encode-vbi 127 []
    in if list-length encoded == 1 then 1 else 0

  test-vbi-large : Integer
  test-vbi-large =
    let encoded = mqtt-encode-vbi 128 []
    in if list-length encoded == 2 then 1 else 0

  test-connect : Integer
  test-connect =
    let pkt = mqtt-build-connect default-mqtt-connect
    in if list-length pkt > 0 then 1 else 0

  test-publish : Integer
  test-publish =
    let pkt = mqtt-build-publish "sensor/temp" [50, 51] QosAtMostOnce False
    in if list-length pkt > 0 then 1 else 0

  test-subscribe : Integer
  test-subscribe =
    let pkt = mqtt-build-subscribe 1 "sensor/#" QosAtLeastOnce
    in if list-length pkt > 0 then 1 else 0

  test-pingreq : Integer
  test-pingreq =
    let pkt = mqtt-build-pingreq
    in if list-length pkt == 2 then 1 else 0

  test-disconnect : Integer
  test-disconnect =
    let pkt = mqtt-build-disconnect
    in if list-length pkt == 2 then 1 else 0

  opening : Integer =
    let vs = test-vbi-small
    in let vl = test-vbi-large
    in let co = test-connect
    in let pu = test-publish
    in let su = test-subscribe
    in let pi = test-pingreq
    in let di = test-disconnect
    in vs + vl + co + pu + su + pi + di

