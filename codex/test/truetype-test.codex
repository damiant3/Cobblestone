Chapter: TrueTypeTest
  cites Encode chapter TrueType
  cites Ui chapter GlyphRasterizer
  cites Ui chapter FontAtlas

Section: Binary Helpers
  test-u16 : Text =
    let buf = [0, 1, 2, 3]
    in let v = ttf-u16 buf 0
    in "u16=" & show v

  test-u32 : Text =
    let buf = [0, 0, 1, 0]
    in let v = ttf-u32 buf 0
    in "u32=" & show v

  test-i16-positive : Text =
    let buf = [0, 42]
    in let v = ttf-i16 buf 0
    in "i16+=" & show v

  test-i16-negative : Text =
    let buf = [255, 214]
    in let v = ttf-i16 buf 0
    in "i16-=" & show v

Section: Bit Operations
  test-bit0 : Text =
    let v = ttf-bit-test 5 0
    in "bit0of5=" & show v

  test-bit1 : Text =
    let v = ttf-bit-test 5 1
    in "bit1of5=" & show v

  test-bit2 : Text =
    let v = ttf-bit-test 5 2
    in "bit2of5=" & show v

Section: Cmap Lookup
  test-mod65536 : Text =
    let v = ttf-mod65536 65537
    in "mod=" & show v

Section: Points and Contours
  test-scale-point : Text =
    let pt = TtfPoint { tp-x = 500, tp-y = 1000, tp-on-curve = 1 }
    in let contour = TtfContour { tc-points = [pt] }
    in let scaled = gr-scale-contour contour 16 2048 0 0
    in let sp = list-at scaled 0
    in "sx=" & show (sp.sp-x / 64) & " sy=" & show (sp.sp-y / 64)

  test-midpoint-expand : Text =
    let p0 = sp-new 0 0 1
    in let p1 = sp-new 100 200 0
    in let p2 = sp-new 200 0 0
    in let p3 = sp-new 300 200 1
    in let expanded = gr-expand-midpoints [p0, p1, p2, p3]
    in "expanded=" & show (list-length expanded)

Section: Empty Glyph
  test-empty-glyph : Text =
    let g = ttf-empty-glyph
    in "contours=" & show (list-length (g.tg-contours)) & " adv=" & show (g.tg-advance)

Section: Edge Creation
  test-edge : Text =
    let e = Edge { e-x0 = 0, e-y0 = 0, e-x1 = 100, e-y1 = 100 }
    in "edge=" & show (e.e-x0) & "," & show (e.e-y0) & "->" & show (e.e-x1) & "," & show (e.e-y1)

Section: Atlas Types
  test-atlas-format : Text =
    "atlas-ok"

  opening : [Console] Nothing = act
    print-line-uni test-u16
    print-line-uni test-u32
    print-line-uni test-i16-positive
    print-line-uni test-i16-negative
    print-line-uni test-bit0
    print-line-uni test-bit1
    print-line-uni test-bit2
    print-line-uni test-mod65536
    print-line-uni test-scale-point
    print-line-uni test-midpoint-expand
    print-line-uni test-empty-glyph
    print-line-uni test-edge
    print-line-uni test-atlas-format
  end

