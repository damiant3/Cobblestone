Chapter: Matrix3Test
  cites Math chapter Matrix3
  cites Math chapter Geometry
  cites Math chapter Quaternion

Section: Body

  test-identity : Text =
    let p = vec2-new 3000 4000
    in let result = mat3-transform mat3-identity p
    in "id=" & format-vec2 result

  test-translate : Text =
    let m = mat3-translate 1000 2000
    in let p = mat3-transform m (vec2-new 500 500)
    in "trans=" & format-vec2 p

  test-scale : Text =
    let m = mat3-scale 2000 3000
    in let p = mat3-transform m (vec2-new 100 200)
    in "scale=" & format-vec2 p

  test-rotate-90 : Text =
    let m = mat3-rotate 1571
    in let p = mat3-transform m (vec2-new 1000 0)
    in "rot90=" & format-vec2 p

  test-compose : Text =
    let t = mat3-translate 500 0
    in let s = mat3-scale 2000 2000
    in let combined = mat3-mul t s
    in let p = mat3-transform combined (vec2-new 100 100)
    in "compose=" & format-vec2 p

  test-det : Text =
    let m = mat3-scale 2000 3000
    in "det=" & show (mat3-det m)

  test-transform-list : Text =
    let m = mat3-translate 100 200
    in let pts = [vec2-new 0 0, vec2-new 1000 0, vec2-new 0 1000]
    in let result = mat3-transform-list m pts
    in "count=" & show (list-length result) & " p0=" & format-vec2 (list-at result 0)

  opening : [Console] Nothing = act
    print-line-uni test-identity
    print-line-uni test-translate
    print-line-uni test-scale
    print-line-uni test-rotate-90
    print-line-uni test-compose
    print-line-uni test-det
    print-line-uni test-transform-list
  end

