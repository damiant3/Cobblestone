Chapter: QemuVirtBoardRvTest

  cites Boards chapter QemuVirtBoard

Section: Definitions

  test-rv-uart-base : Integer
  test-rv-uart-base =
    if qemu-rv-uart-base == #10000000 then 1 else 0

  test-rv-ram-base : Integer
  test-rv-ram-base =
    if qemu-rv-ram-base == #80000000 then 1 else 0

  test-rv-uart-putc : [Device.Mmio] Integer
  test-rv-uart-putc = act
    w <- (qemu-rv-uart-putc 65)
    1
  end

  test-rv-uart-linear : [Uart, Device.Mmio] Integer
  test-rv-uart-linear = act
    brd0 <- board-open 0 0
    o <- qemu-uart-open brd0 qemu-rv-uart-thr
    when o
     is (brd1, p0) -> act
       p1 <- qemu-uart-write p0 72
       p2 <- (qemu-uart-write p1 73)
       c <- (qemu-uart-close p2)
       bc <- (board-close brd1)
       1
     end
  end

  opening : [Uart, Device.Mmio] Integer = act
    rp <- test-rv-uart-putc
    rl <- test-rv-uart-linear
    test-rv-uart-base + test-rv-ram-base + rp + rl
  end

