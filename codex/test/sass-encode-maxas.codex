Section: Main

  print-from : Integer -> [Console] Nothing
  print-from (j) = act
   if j >= list-length vectors then print-text "" else act
    print-line-uni (sass-word-hex (sass-encode (list-at vectors j)) & " " & sass-insn-text (list-at vectors j))
    print-from (j + 1)
   end
  end

  opening : [Console] Nothing = act
   print-from 0
  end
