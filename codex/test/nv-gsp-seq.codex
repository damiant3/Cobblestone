Chapter: NvGspSeqTest
  cites Kernel chapter NvGspSeq

 The expected output is tinygrad's own run_cpu_seq, run by Python against a
 stub device that logs every action: build/nv-gsp-seq-oracle.ps1.

Section: Main

  le32 : Integer -> List Integer
  le32 (v) = [bit-and v 255, bit-and (bit-shru v 8) 255, bit-and (bit-shru v 16) 255, bit-and (bit-shru v 24) 255]

  le32s : List Integer, Integer, List Integer -> List Integer
  le32s (ws) (i) (acc) = if i >= list-length ws then acc else le32s ws (i + 1) (acc & le32 (list-at ws i))

  zeros : Integer, List Integer -> List Integer
  zeros (n) (acc) = if n <= 0 then acc else zeros (n - 1) (acc & [0])

  buffer : List Integer -> List Integer
  buffer (ws) = le32 (list-length ws + 16) & le32 (list-length ws) & zeros 32 [] & le32s ws 0 []

  print-trace : Integer, List Text, Integer -> [Console] Nothing
  print-trace (k) (ts) (i) = act
   if i >= list-length ts then print-text "" else act
    print-line-uni ("T " & show k & " " & list-at ts i)
    print-trace k ts (i + 1)
   end
  end

  opening : [Console] Nothing = act
   print-trace 0 (nv-gsp-seq-trace (buffer [0, #110000, #DEADBEEF, 1, #110004, #12345678, #FF00FF, 2, #110008, #F0, #30, 1000, 0, 3, 50, 4, #11000C, 5, 5, 6, 7, 8]) #123456789A) 0
   print-trace 1 (nv-gsp-seq-trace (buffer [1, #840000, #CAFEF00D, #FFFFFFFF, 1, #840004, #CAFEF00D, 0, 3, 0, 4, #840008, 0, 2, #84000C, #FFFFFFFF, #80000000, 5, 5, 9, 0, 1]) #FFFFF000) 0
  end
