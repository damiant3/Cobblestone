Chapter: ExplicitConstructorReturn
  cites Foreword chapter Console

  Annotated =
    | AnnEmpty
    | AnnValue (Integer)

  pick : Annotated -> Integer
  pick (a) = when a
    is AnnEmpty -> 0
    is AnnValue (n) -> n

  opening : [Console] Nothing = act
    print-line-uni (show (pick AnnEmpty))
    print-line-uni (show (pick (AnnValue 7)))
  end
