Chapter: Fat32ReadGuard

  cites Foreword chapter Fat32
  cites Foreword chapter Fat16
  cites Foreword chapter Maybe

Section: Helpers

  pat : Integer, List Integer -> List Integer
  pat (n) (acc) = if list-length acc >= n then acc else pat n (list-push acc (int-mod (list-length acc * 7 + 3) 251))

  sum-of : List Integer, Integer, Integer -> Integer
  sum-of (bs) (i) (acc) = if i >= list-length bs then acc else sum-of bs (i + 1) (int-mod (acc + list-at bs i * (i + 1)) 65521)

  first-of : Maybe Fat16DirEntry -> Integer
  first-of (m) = when m
    is Just (e) -> e.de-cluster
    is None -> 0

  judge : Text, Maybe (List Integer), Integer -> Text
  judge (name) (m) (n) = when m
    is None -> name & " refused"
    is Just (bs) -> name & " ok len-match=" & (if list-length bs == n then "yes" else "no") & " sum-match=" & (if sum-of bs 0 0 == sum-of (pat n []) 0 0 then "yes" else "no")

Section: Entry

  opening : [Console, Device.Block] Nothing
  opening = act
    fmt <- fat32-format 2048 30720 "CODEX"
    vol <- fat32-init 2048
    print-line-uni ("format " & show fmt)

    w1 <- fat32-write-file vol "GOOD.TXT" (pat ((vol.f32-sectors-per-cluster) * 1024 + 100) [])
    g <- fat32-read-bytes vol "GOOD.TXT"
    print-line-uni (judge "good" g ((vol.f32-sectors-per-cluster) * 1024 + 100))

    w2 <- fat32-write-file vol "EMPTY.TXT" []
    e <- fat32-read-bytes vol "EMPTY.TXT"
    print-line-uni (judge "empty" e 0)

    w3 <- fat32-write-file vol "CYCLE.TXT" (pat ((vol.f32-sectors-per-cluster) * 1536 + 10) [])
    c1r <- fat32-resolve-path vol "CYCLE.TXT"
    c2 <- fat32-next-cluster vol (first-of c1r)
    c3 <- fat32-next-cluster vol c2
    s1 <- fat32-set-fat-entry vol c3 (first-of c1r)
    cy <- fat32-read-bytes vol "CYCLE.TXT"
    print-line-uni (judge "cycle-3-of-4" cy ((vol.f32-sectors-per-cluster) * 1536 + 10))

    w6 <- fat32-write-file vol "LOOP.TXT" (pat ((vol.f32-sectors-per-cluster) * 6144 + 10) [])
    lr <- fat32-resolve-path vol "LOOP.TXT"
    l2 <- fat32-next-cluster vol (first-of lr)
    l3 <- fat32-next-cluster vol l2
    s4 <- fat32-set-fat-entry vol l3 (first-of lr)
    lp <- fat32-read-bytes vol "LOOP.TXT"
    print-line-uni (judge "cycle-3-of-13" lp ((vol.f32-sectors-per-cluster) * 6144 + 10))

    w4 <- fat32-write-file vol "SHORT.TXT" (pat ((vol.f32-sectors-per-cluster) * 1536 + 10) [])
    sr <- fat32-resolve-path vol "SHORT.TXT"
    s2 <- fat32-set-fat-entry vol (first-of sr) 268435455
    sh <- fat32-read-bytes vol "SHORT.TXT"
    print-line-uni (judge "short" sh ((vol.f32-sectors-per-cluster) * 1536 + 10))

    w5 <- fat32-write-file vol "EXACT.TXT" (pat ((vol.f32-sectors-per-cluster) * 1024) [])
    xr <- fat32-resolve-path vol "EXACT.TXT"
    x2 <- fat32-next-cluster vol (first-of xr)
    s3 <- fat32-set-fat-entry vol x2 x2
    ex <- fat32-read-bytes vol "EXACT.TXT"
    print-line-uni (judge "cycle-after-end" ex ((vol.f32-sectors-per-cluster) * 1024))

    bad <- fat32-read-cluster-bytes vol 999999 100 0 [] 999999 1 0
    print-line-uni (judge "bad-first" bad 100)
  end
