Chapter: Arm64HttpTest
  cites Works chapter Http
  cites Foreword chapter Maybe

Section: Request Bytes

  get-root-request : List Integer =
    [71, 69, 84, 32, 47, 32, 72, 84, 84, 80, 47, 49, 46, 49, 13, 10,
     72, 111, 115, 116, 58, 32, 108, 111, 99, 97, 108, 104, 111, 115, 116, 13, 10,
     13, 10]

  get-health-request : List Integer =
    [71, 69, 84, 32, 47, 97, 112, 105, 47, 104, 101, 97, 108, 116, 104, 32,
     72, 84, 84, 80, 47, 49, 46, 49, 13, 10,
     72, 111, 115, 116, 58, 32, 108, 111, 99, 97, 108, 104, 111, 115, 116, 13, 10,
     13, 10]

  get-nope-request : List Integer =
    [71, 69, 84, 32, 47, 110, 111, 112, 101, 32, 72, 84, 84, 80, 47, 49, 46, 49, 13, 10,
     72, 111, 115, 116, 58, 32, 108, 111, 99, 97, 108, 104, 111, 115, 116, 13, 10,
     13, 10]

Section: Route

  test-route : HttpRequest -> HttpResponse
  test-route (req) =
    if req.path == "/" then HttpResponse { status = http-200, content-type = "text/html", body = "<h1>Codex</h1>" }
    else if req.path == "/api/health" then HttpResponse { status = http-200, content-type = "application/json", body = "{\"ok\":true}" }
    else HttpResponse { status = http-404, content-type = "text/plain", body = "not found" }

Section: Tests

  test-parse-get : Text =
    let req = http-parse-request get-root-request
    in "parse: method=" & req.method & " path=" & req.path & " valid=" & show req.valid

  test-route-root : Text =
    let req = http-parse-request get-root-request
    in let resp = test-route req
    in "route-root: status=" & resp.status & " ct=" & resp.content-type

  test-route-health : Text =
    let req = http-parse-request get-health-request
    in let resp = test-route req
    in "route-health: status=" & resp.status & " body=" & resp.body

  test-route-404 : Text =
    let req = http-parse-request get-nope-request
    in let resp = test-route req
    in "route-404: status=" & resp.status & " body=" & resp.body

  test-encode : Text =
    let resp = HttpResponse { status = http-200, content-type = "text/plain", body = "hello" }
    in let encoded = http-encode resp
    in "encode: len=" & show (list-length encoded)

  test-round-trip : Text =
    let req = http-parse-request get-health-request
    in let resp = test-route req
    in let encoded = http-encode resp
    in "round-trip: req-bytes=" & show (list-length get-health-request) & " resp-bytes=" & show (list-length encoded)

  opening : [Console] Nothing = act
    print-line-uni test-parse-get
    print-line-uni test-route-root
    print-line-uni test-route-health
    print-line-uni test-route-404
    print-line-uni test-encode
    print-line-uni test-round-trip
  end

