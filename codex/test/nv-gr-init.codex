Chapter: NvGrInitTest
  cites Kernel chapter NvGrInit
  cites Foreword chapter Format
  cites Foreword chapter Maybe

Section: Test

  gr-fixture : List Integer, Integer, List Integer -> List Integer
  gr-fixture (ws) (i) (acc) = if i >= list-length ws * 4 then acc else gr-fixture ws (i + 1) (list-push acc (bit-and (bit-shru (list-at ws (i / 4)) (int-mod i 4 * 8)) 255))

  gr-dump-entries : Text, List NvGrEntry, Integer -> [Console] Nothing
  gr-dump-entries (tag) (es) (i) = act
   if i >= list-length es then print-uni ""
   else let e = list-at es i
   in act
    print-line-uni (tag & " " & show i & " " & show e.group & " " & fmt-hex-pad e.class 8 & " " & fmt-hex-pad e.address 8 & " " & show e.count & " " & show e.pitch & " " & fmt-hex-pad e.data 16)
    gr-dump-entries tag es (i + 1)
   end
  end

  gr-dump : Text, Maybe (List NvGrEntry) -> [Console] Nothing
  gr-dump (tag) (result) = act
   when result
    is None -> print-line-uni (tag & " REFUSED")
    is Just (es) -> act
     print-line-uni (tag & " COUNT " & show (list-length es))
     gr-dump-entries tag es 0
    end
  end

  gr-many : Integer, Integer, List Integer -> List Integer
  gr-many (n) (i) (acc) = if i >= n then acc else gr-many n (i + 1) (list-push (list-push acc (bit-or #1000000 (256 + i))) (1000 + i))

  opening : [Console] Nothing = act
   gr-dump "AV" (nv-gr-av (gr-fixture [#419E44, #1FFFFE, #41E100, 3, #FFFFFFFF, #80000000] 0 []))
   gr-dump "AIV" (nv-gr-aiv (gr-fixture [#405800, #DEADBEEF, #10203040, #405804, 7, #FFFFFFFF] 0 []))
   gr-dump "METHOD" (nv-gr-methods (gr-fixture [#0110B1C0, 17, #0111B1C0, 18, #0020B097, 19, #0030B1C0, 20, #FFFEB1C0, #FFFFFFFF] 0 []))
   gr-dump "METHOD15" (nv-gr-methods (gr-fixture (gr-many 15 0 []) 0 []))
   gr-dump "METHOD16" (nv-gr-methods (gr-fixture (gr-many 16 0 []) 0 []))
   gr-dump "EMPTY" (nv-gr-av [])
   gr-dump "SHORT" (nv-gr-av [1, 2, 3])
   gr-dump "BYTE" (nv-gr-av [256, 0, 0, 0, 0, 0, 0, 0])
   gr-dump "CLASS0" (nv-gr-methods [0, 0, 0, 1, 0, 0, 0, 0])
   gr-dump "AIVSHORT" (nv-gr-aiv [0, 0, 0, 0, 0, 0, 0, 0])
   gr-dump "METHODSHORT" (nv-gr-methods [1, 2, 3])
   gr-dump "NEGATIVE" (nv-gr-av [-1, 0, 0, 0, 0, 0, 0, 0])
   gr-dump "LATECLASS0" (nv-gr-methods (gr-fixture [#0110B1C0, 17, #01000000, 0] 0 []))
  end
