Chapter: RecordSmoke
  cites Codex chapter Text
  cites Foreword chapter Maybe
  cites Foreword chapter Console

 Combined record/variant tests: record-in-record, keyword fields,
 variant record payloads, nested match, nested variant, closure/func
 in record.

Section: Types

  Point = record { x : Integer, y : Integer }
  Rect = record { origin : Point, width : Integer, height : Integer }

  Color = | Red | Green | Blue
  Shape = | Circle (Color) (Integer) | Square (Color) (Integer)

  Wrapped = | Wrapped (Color) (Shape)

  TestRec = record { name : Text, effect : Integer, value : Integer }

  Inner = record { x-val : Integer, y-val : Integer, label : Text }
  Outer = | OWrapped (Inner) | OPlain (Integer) | OEmpty

  Rec1 = record { rx : Integer, ry : Integer }
  Rec2 = record { ra : Text, rb : Integer }
  V = | VarA (Rec1) | VarB (Rec2)

  Box = record { box-label : Text, apply : Integer -> Text }
  Entry = record { ent-name : Text, emit : Integer -> Text }

Section: Functions

  area : Rect -> Integer
  area (r) = r.width * r.height

  describe-rect : Rect -> Text
  describe-rect (r) = "rect at " & integer-to-text (r.origin.x) & "," & integer-to-text (r.origin.y) & " area=" & integer-to-text (area r)

  color-name : Color -> Text
  color-name (c) = when c is Red -> "red" is Green -> "green" is Blue -> "blue"

  describe-shape : Shape -> Text
  describe-shape (s) = when s
    is Circle (c) (r) -> "circle-" & color-name c & "-r" & show r
    is Square (c) (side) -> "square-" & color-name c & "-s" & show side

  describe-wrapped : Wrapped -> Text
  describe-wrapped (w) = when w
    is Wrapped (c) (s) -> when s
      is Circle (c2) (r) -> color-name c & " circle r=" & show r
      is Square (c2) (side) -> color-name c & " square s=" & show side

  make-test : Integer -> TestRec
  make-test (n) = TestRec { name = "hello", effect = n * 2, value = n }

  make-wrapped : Integer -> Outer
  make-wrapped (n) = OWrapped (Inner { x-val = n, y-val = n * 2, label = "test" })

  use-wrapped : Outer -> Integer
  use-wrapped (o) = when o is OWrapped (i) -> i.x-val + i.y-val is OPlain (n) -> n is OEmpty -> 0

  extract-int : V -> Integer
  extract-int (v) = when v is VarA (r) -> r.rx is VarB (r) -> r.rb

  make-box : Text, Integer -> Box
  make-box (lbl) (offset) = Box { box-label = lbl, apply = \x -> lbl & ":" & integer-to-text (x + offset) }

  emit-one : Integer -> Text
  emit-one (x) = "one:" & integer-to-text x

  emit-two : Integer -> Text
  emit-two (x) = "two:" & integer-to-text (x + x)

Section: Body

  opening : [Console] Nothing = act
    print-line-uni (describe-rect (Rect { origin = Point { x = 10, y = 20 }, width = 7, height = 3 }))
    let tr = make-test 5 in print-line-uni (show (tr.effect + tr.value))
    print-line-uni (describe-shape (Circle Green 5))
    print-line-uni (describe-wrapped (Wrapped Red (Circle Red 5)))
    print-line-uni (show (use-wrapped (make-wrapped 5)))
    print-line-uni (show (extract-int (VarA (Rec1 { rx = 42, ry = 7 }))))
    print-line-uni (show (extract-int (VarB (Rec2 { ra = "hello", rb = 99 }))))
    let b1 = make-box "a" 10 in print-line-uni (b1.apply 3)
    let e = Entry { ent-name = "one", emit = emit-one } in print-line-uni (e.emit 5)
  end

