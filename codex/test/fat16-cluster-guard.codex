Chapter: Fat16ClusterGuard

  cites Foreword chapter Fat16

 The foreword's own cluster walk, which the compiler reads its source
 through. The existing fat16-* arms do not reach it: the FAT16 root
 directory is a fixed sector region rather than a chain, and every file
 on their fixtures fits in one cluster, so fat16-next-cluster is either
 never called or called once and answers end-of-chain. A guard that
 refuses every cluster leaves all eight of them green, which is why this
 arm calls the function directly rather than through a file operation.

Section: Reporting

  yn : Boolean -> Text
  yn (v) = if v then "yes" else "no"

Section: Entry

  opening : [Console, Device.Block] Nothing
  opening = act
    vol <- fat16-init 2048
    print-line-uni ("clusters " & show (vol.vol-cluster-count) & " last " & show (fat16-last-cluster vol))
    print-line-uni ("ok c0=" & yn (fat16-cluster-ok vol 0)
      & " c1=" & yn (fat16-cluster-ok vol 1)
      & " c2=" & yn (fat16-cluster-ok vol 2)
      & " last=" & yn (fat16-cluster-ok vol (fat16-last-cluster vol))
      & " past=" & yn (fat16-cluster-ok vol (fat16-last-cluster vol + 1))
      & " big=" & yn (fat16-cluster-ok vol 70000))
    inrange <- fat16-next-cluster vol 2
    print-line-uni ("next-c2-is-a-number " & show (inrange >= 0))
    past <- fat16-next-cluster vol (fat16-last-cluster vol + 1)
    print-line-uni ("next-past " & show past)
    big <- fat16-next-cluster vol 70000
    print-line-uni ("next-big " & show big)
    low <- fat16-next-cluster vol 1
    print-line-uni ("next-low " & show low)
  end
