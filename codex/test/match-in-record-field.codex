Chapter: MatchInRecordField
  cites Foreword chapter KvStore
  cites Foreword chapter Hamt
  cites Foreword chapter Maybe

Section: Body

  Pair = record {
    p-a : Integer,
    p-b : Integer
  }

  field-match : KvStore, Maybe Text -> Pair
  field-match (s) (m) = Pair { p-a = 7, p-b = when m is Just (v) -> s.kv-count is None -> s.kv-count + 1 }

  opening : [Console] Nothing = act
    print-line-uni ("field-match " & show ((field-match kv-empty None).p-b))
  end
