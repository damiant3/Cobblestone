Chapter: NvGspAllocTest
  cites Kernel chapter NvGspAlloc
  cites Foreword chapter Format

 The expected output is tinygrad's own rpc_rm_alloc, run by Python:
 build/nv-gsp-alloc-oracle.ps1.

Section: Main

  hex-bytes : List Integer, Integer, Text -> Text
  hex-bytes (bs) (i) (acc) = if i >= list-length bs then acc else hex-bytes bs (i + 1) (acc & fmt-hex-pad (list-at bs i) 2)

  line : List Integer -> Text
  line (bs) = "F " & show nv-gsp-fn-rm-alloc & " " & hex-bytes bs 0 ""

  opening : [Console] Nothing = act
   print-line-uni (line (nv-gsp-rm-alloc #C1E00004 #CAF00001 #CAF00002 #2080 [1, 0, 0, 0]))
   print-line-uni (line (nv-gsp-rm-alloc #C1D00000 #C1D00000 #CAF00010 #90F1 []))
   print-line-uni (line (nv-gsp-rm-alloc #C1E00004 #CAF00002 #CAF00020 #C5B5 [9, 8, 7, 6, 5, 4, 3, 2, 1, 0, 255, 254, 253]))
   print-line-uni (line (nv-gsp-rm-alloc #C1E00004 0 #CAF00100 0 nv-gsp-root-params))
   print-line-uni (line (nv-gsp-rm-alloc #C1E00004 #C1E00004 #CAF00101 #80 (nv-gsp-device-params #C1E00004)))
   print-line-uni (line (nv-gsp-rm-alloc #C1E00004 #CAF00101 #CAF00102 #2080 nv-gsp-subdevice-params))
   print-line-uni (line (nv-gsp-rm-alloc #C1E00004 #CAF00101 #CAF00103 #90F1 nv-gsp-vaspace-params))
   print-line-uni (line (nv-gsp-rm-alloc #12345678 0 #CAF00100 0 nv-gsp-root-params))
   print-line-uni (line (nv-gsp-rm-alloc #12345678 #12345678 #CAF00101 #80 (nv-gsp-device-params #12345678)))
   print-line-uni (line (nv-gsp-rm-alloc #12345678 #CAF00101 #CAF00102 #2080 nv-gsp-subdevice-params))
   print-line-uni (line (nv-gsp-rm-alloc #12345678 #CAF00101 #CAF00103 #90F1 nv-gsp-vaspace-params))
   print-line-uni (line (nv-gsp-rm-alloc #C1E00004 #CAF00101 #CAF00104 #C56F (nv-gsp-golden-channel-params #12345678000 #23456780100 #34567890000 #456789A0000 #CAF00103)))
   print-line-uni (line (nv-gsp-rm-alloc #12345678 #BEE00101 #BEE00104 #C56F (nv-gsp-golden-channel-params #7654321000 #6543210100 #5432100000 #4321000000 #BEE00103)))
  end
