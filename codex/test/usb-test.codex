Chapter: UsbTest
  cites Kernel chapter Usb
  cites Kernel chapter UsbAudio
  cites Kernel chapter Pci
  cites Foreword chapter Maybe

 What is left here after the kernel xHCI driver was retired. `Usb` and
 `UsbAudio` survive it: `Usb` holds the descriptor and setup-packet
 structures that `UsbHid` needs, and `UsbHid` is cited by real
 `codex/os/dev` chapters. The TRB and speed-name cases that used to sit
 alongside these belonged to the retired driver and went with it.

 `usb-audio-frame` is here rather than in `hda-codec-test` because that
 test covers every other `UsbAudio` entry point and not this one; it
 would have been the only casualty of deleting this file.

Section: Body

  test-setup-packet : Text =
    let pkt = usb-setup-get-descriptor usb-desc-device 0 18
    in let bytes = usb-encode-setup pkt
    in "setup: len=" & show (list-length bytes) & " req=" & show (pkt.sp-request)

  test-endpoint : Text =
    let bytes = [7, 5, 129, 1, 192, 0, 1]
    in let ep = usb-parse-endpoint bytes 0
    in "ep: " & format-usb-endpoint ep

  test-audio-format : Text =
    let cd = audio-format-cd
    in "cd: " & format-audio-format cd

  test-audio-frame : Text =
    let left = [500, 0 - 500]
    in let right = [300, 0 - 300]
    in let frame = usb-audio-frame left right audio-format-cd
    in "frame: bytes=" & show (list-length frame)

  test-latency : Text =
    let fmt = audio-format-48k
    in "latency-256=" & show (usb-audio-latency-ms fmt 256) & "ms bps=" & show (usb-audio-bytes-per-second fmt)

  opening : [Console] Nothing = act
    print-line-uni test-setup-packet
    print-line-uni test-endpoint
    print-line-uni test-audio-format
    print-line-uni test-audio-frame
    print-line-uni test-latency
  end

