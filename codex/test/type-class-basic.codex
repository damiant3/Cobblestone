Chapter: TypeClassBasic
  cites Foreword chapter Console

class Showable where
  to-text : a -> Text

instance Showable Integer where
  to-text (x) = show x

Section: Polymorphic Function

  describe : Showable a => a -> Text
  describe (x) = "Value: " & to-text x

Section: Opening

  opening : [Console] Nothing
  opening = act
   print-line-uni (to-text 42)
   print-line-uni (describe 99)
  end
