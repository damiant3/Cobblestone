Chapter: HalBoardSleep
  cites Foreword chapter Board

Section: Body
  nap : Integer, Integer -> [Power, Gpio, Device.Mmio] Integer
  nap (pwr) (scb) = act
    b0 <- board-open pwr scb
    r <- gpio-open b0 1073876992 5 PinOutput
    when r
     is (b1, p0) -> act
       p1 <- gpio-write p0 True
       c <- gpio-close p1
       s <- (sleep-deep b1 default-sleep-config)
       mmio-read-32 (pwr + pwr-cr1-offset)
     end
  end

  wake-code : WakeReason -> Integer
  wake-code (w) =
   when w
    is WakeReset -> 0
    is WakePin -> 1
    is WakeTimer -> 2

  opening : [Console, Power, Gpio, Device.Mmio] Nothing = act
    cr1 <- nap 1073770496 1073771520
    print-line-uni ("sleep lpms=" & show (bit-and cr1 7))
    scr <- mmio-read-32 (1073771520 + scb-scr-offset)
    print-line-uni ("scr sleepdeep=" & show (bit-and scr 4))
    w0 <- wake-source 1073770496
    print-line-uni ("wake0=" & show (wake-code w0))
    wf <- mmio-write-32 (1073770496 + pwr-sr1-offset) 1
    w1 <- wake-source 1073770496
    print-line-uni ("wake1=" & show (wake-code w1))
    sl <- sleep-light 1073771520
    scr2 <- mmio-read-32 (1073771520 + scb-scr-offset)
    print-line-uni ("light scr=" & show (bit-and scr2 4))
  end
