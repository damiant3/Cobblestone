Chapter: WaDemoCodebookTest
  cites WaDemo chapter NhgisCodebook
  cites Foreword chapter Maybe

Section: Helpers

  bin-text : Text -> Text
  bin-text (label) =
    let b = nc-age-bin label
    in show (b.nab-lo) & ".." & show (b.nab-hi) & " w=" & show (b.nab-width)
      & " cohort=" & show (nc-cohort-valid b)

  series-text : Text -> Text
  series-text (line) =
    let s = nc-parse-series line
    in if s.ncs-ok == False then "rejected"
    else s.ncs-code & " | " & s.ncs-universe & " | " & dims-text (s.ncs-dims) 0 ""

  dims-text : List Text, Integer, Text -> Text
  dims-text (ds) (i) (acc) =
    if i >= list-length ds then acc
    else dims-text ds (i + 1) (acc & (if i > 0 then " / " else "") & list-at ds i)

Section: Entry

  opening : [Console] Nothing
  opening = act
   print-line-uni ("under: " & bin-text "Under 1 year")
   print-line-uni ("one:   " & bin-text "1 year")
   print-line-uni ("mid:   " & bin-text "45 years")
   print-line-uni ("range: " & bin-text "100 to 104 years")
   print-line-uni ("open:  " & bin-text "110 years and over")
   print-line-uni ("sex m: " & show (nc-sex-of "Male"))
   print-line-uni ("sex f: " & show (nc-sex-of "Female"))
   print-line-uni ("sex ?: " & show (nc-sex-of "Total"))
   print-line-uni ("series: " & series-text "    Time series AA: Persons: Male ~ Under 1 year")
   print-line-uni ("series: " & series-text "    Time series HX: Persons: Female ~ 110 years and over")
   print-line-uni ("not a series: " & series-text "        A61AA1980:   1980: Persons: Male ~ Under 1 year")
   print-line-uni ("blank: " & series-text "")
   print-line-uni ("col: " & nc-column-name "A61" "AA" 1980)
   print-line-uni ("col: " & nc-column-name "A61" "HX" 2020)
  end
