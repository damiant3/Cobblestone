Chapter: Arm64ProcCells

Section: Bits

  cap-bit : Integer, Integer -> Integer
  cap-bit (word) (n) = if bit-and word (bit-shl 1 n) /= 0 then 1 else 0

Section: Entry

  opening : [Console, Capability] Nothing = act
    let pid = process-get-pid
    in act
      print-line-uni ("pid " & show pid)
      print-line-uni ("bad-cap " & show (process-get-cap 99))
      r99 <- process-restrict-cap 99 5
      print-line-uni ("restrict-99 " & show r99)
      s99 <- process-set-scope 99 "x"
      print-line-uni ("set-scope-99 " & show s99)
      print-line-uni ("scope-99 " & show (text-length (process-get-scope 99)))
      print-line-uni ("net-scope-99 " & show (text-length (process-get-network-scope 99)))
      print-line-uni ("admin " & show (cap-bit (process-get-cap pid) 14))
      print-line-uni ("con-write-before " & show (cap-bit (process-get-cap pid) 5))
      r0 <- process-restrict-cap pid 5
      print-line-uni ("restrict-self " & show r0)
      print-line-uni ("con-write-after " & show (cap-bit (process-get-cap pid) 5))
      print-line-uni ("state-0 " & show (peek-qword 20480 0))
    end
  end