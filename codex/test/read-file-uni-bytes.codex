Chapter: Read File Uni Bytes

Section: Body

  codes-of : Text, Integer, Integer -> Text
  codes-of (s) (i) (n) =
   if i >= n then ""
   else " " & integer-to-text (char-code-at s i) & codes-of s (i + 1) n

  opening : [Console, FileSystem] Nothing = act
   t <- read-file-uni ""
   print-line-uni (integer-to-text (text-length t) & ":" & codes-of t 0 (text-length t))
  end