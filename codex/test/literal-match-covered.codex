Chapter: LiteralMatchCovered
  cites Foreword chapter Console

 The controls for `errors/literal-match-open`: every shape here covers the
 values it can be handed, so the literal-match refusal must leave it alone.

Section: Body

  by-catch : Integer -> Integer
  by-catch (n) = when n is 1 -> 10 is 2 -> 20 is otherwise -> 0

  by-var : Integer -> Integer
  by-var (n) = when n is 1 -> 10 is k -> k

  by-bool : Boolean -> Integer
  by-bool (b) = when b is True -> 1 is False -> 0

  by-text : Text -> Integer
  by-text (s) = when s is "a" -> 1 is "b" -> 2 is _ -> 0

  opening : [Console] Nothing = act
    print-line-uni (show (by-catch 3))
    print-line-uni (show (by-var 7))
    print-line-uni (show (by-bool False))
    print-line-uni (show (by-text "c"))
  end

