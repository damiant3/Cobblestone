Chapter: Iec104EncodeTest

  cites Encode chapter Iec104

 Exercise the IEC 60870-5-104 builders: APCI control fields (I/S/U
 formats, including a 15-bit sequence-number split), full APDU frames,
 ASDU headers, and information objects (single point, interrogation,
 and a short-float measured value). Every byte sequence is checked
 against an independent reference computed by iec104_truth.py, and the
 short-float vector against Python struct '<f' packing. opening returns
 the count of passing checks.

Section: Helpers

  bytes-eq : List Integer, List Integer -> Boolean
  bytes-eq (a) (b) =
   if list-length a /= list-length b then False
   else bytes-eq-loop a b 0 (list-length a)

  bytes-eq-loop : List Integer, List Integer, Integer, Integer -> Boolean
  bytes-eq-loop (a) (b) (i) (len) =
   if i >= len then True
   else if list-at a i /= list-at b i then False
   else bytes-eq-loop a b (i + 1) len

  flag : Boolean -> Integer
  flag (b) = if b then 1 else 0

Section: Sample ASDUs

  asdu-single-point : List Integer
  asdu-single-point =
   i104-asdu-header i104-type-single-point (i104-vsq False 1) i104-cot-spontaneous 0 1
   & i104-io-single-point 100 1

  asdu-interrogation : List Integer
  asdu-interrogation =
   i104-asdu-header i104-type-interrogation (i104-vsq False 1) i104-cot-activation 0 1
   & i104-io-interrogation 0 i104-qoi-station

  asdu-short-float : List Integer
  asdu-short-float =
   i104-asdu-header i104-type-measured-short-float (i104-vsq False 1) i104-cot-spontaneous 0 1
   & i104-io-measured-short-float 200 (to-real-approx 42.5) 0

Section: Checks

  check-ctrl-i-seq : Integer
  check-ctrl-i-seq = flag (bytes-eq (i104-ctrl-i 300 127) [88, 2, 254, 0])

  check-ctrl-s : Integer
  check-ctrl-s = flag (bytes-eq (i104-ctrl-s 5) [1, 0, 10, 0])

  check-ctrl-u : Integer
  check-ctrl-u = flag (bytes-eq (i104-ctrl-u i104-u-startdt-act) [7, 0, 0, 0])

  check-frame-u-startdt : Integer
  check-frame-u-startdt =
   flag (bytes-eq (i104-frame-u i104-u-startdt-act) [104, 4, 7, 0, 0, 0])

  check-frame-u-testfr : Integer
  check-frame-u-testfr =
   flag (bytes-eq (i104-frame-u i104-u-testfr-act) [104, 4, 67, 0, 0, 0])

  check-frame-s : Integer
  check-frame-s = flag (bytes-eq (i104-frame-s 5) [104, 4, 1, 0, 10, 0])

  check-asdu-single-point : Integer
  check-asdu-single-point =
   flag (bytes-eq asdu-single-point [1, 1, 3, 0, 1, 0, 100, 0, 0, 1])

  check-frame-i-single-point : Integer
  check-frame-i-single-point =
   flag (bytes-eq (i104-frame-i 0 0 asdu-single-point)
     [104, 14, 0, 0, 0, 0, 1, 1, 3, 0, 1, 0, 100, 0, 0, 1])

  check-asdu-interrogation : Integer
  check-asdu-interrogation =
   flag (bytes-eq asdu-interrogation [100, 1, 6, 0, 1, 0, 0, 0, 0, 20])

  check-f32-le : Integer
  check-f32-le = flag (bytes-eq (i104-f32-le (to-real-approx 42.5)) [0, 0, 42, 66])

  check-asdu-short-float : Integer
  check-asdu-short-float =
   flag (bytes-eq asdu-short-float [13, 1, 3, 0, 1, 0, 200, 0, 0, 0, 0, 42, 66, 0])

  opening : Integer =
   let a = check-ctrl-i-seq
   in let b = check-ctrl-s
   in let c = check-ctrl-u
   in let d = check-frame-u-startdt
   in let e = check-frame-u-testfr
   in let f = check-frame-s
   in let g = check-asdu-single-point
   in let h = check-frame-i-single-point
   in let i = check-asdu-interrogation
   in let j = check-f32-le
   in let k = check-asdu-short-float
   in a + b + c + d + e + f + g + h + i + j + k
