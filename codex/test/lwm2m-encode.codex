Chapter: Lwm2mEncodeTest

  cites Encode chapter Lwm2m

 Exercise the LwM2M module: object ID constants, URI builders,
 TLV encoding, and registration record fields.

Section: Definitions

  test-device-obj : Integer
  test-device-obj =
    if lwm2m-obj-device == 3 then 1 else 0

  test-firmware-obj : Integer
  test-firmware-obj =
    if lwm2m-obj-firmware == 5 then 1 else 0

  test-uri : Integer
  test-uri =
    let u = lwm2m-uri 3 0 1
    in if text-length u > 0 then 1 else 0

  test-object-uri : Integer
  test-object-uri =
    let u = lwm2m-object-uri 3 0
    in if text-length u > 0 then 1 else 0

  test-tlv-encode : Integer
  test-tlv-encode =
    let encoded = lwm2m-encode-tlv-resource 1 [65, 66, 67]
    in if list-length encoded > 0 then 1 else 0

  tlv-matches : List Integer, List Integer, Integer, Integer -> Integer
  tlv-matches (a) (b) (i) (n) =
    if list-length a /= n then 0
    else if i >= n then 1
    else if list-at a i /= list-at b i then 0
    else tlv-matches a b (i + 1) n

  test-tlv-short : Integer
  test-tlv-short =
    let e = lwm2m-encode-tlv-resource 1 [65, 66, 67]
    in tlv-matches e [195, 1, 65, 66, 67] 0 5

  test-tlv-long-id : Integer
  test-tlv-long-id =
    let e = lwm2m-encode-tlv-resource 3303 [7]
    in tlv-matches e [225, 12, 231, 7] 0 4

  test-tlv-long-value : Integer
  test-tlv-long-value =
    let e = lwm2m-encode-tlv-resource 1 [0, 1, 2, 3, 4, 5, 6, 7]
    in tlv-matches e [200, 1, 8, 0, 1, 2, 3, 4, 5, 6, 7] 0 11

  test-registration-fields : Integer
  test-registration-fields =
    let reg = default-lwm2m-registration
    in let ok-endpoint = if reg.endpoint == "codex-device" then 1 else 0
    in let ok-lifetime = if reg.lifetime == 300 then 1 else 0
    in let ok-binding = if reg.binding == "U" then 1 else 0
    in ok-endpoint + ok-lifetime + ok-binding

  test-registration-path : Integer
  test-registration-path =
    let path = lwm2m-registration-path default-lwm2m-registration
    in if text-length path > 0 then 1 else 0

  opening : Integer =
    let d = test-device-obj
    in let f = test-firmware-obj
    in let u = test-uri
    in let ou = test-object-uri
    in let t = test-tlv-encode
    in let rf = test-registration-fields
    in let rp = test-registration-path
    in let s = test-tlv-short
    in let li = test-tlv-long-id
    in let lv = test-tlv-long-value
    in d + f + u + ou + t + rf + rp + s + li + lv

