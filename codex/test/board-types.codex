Chapter: BoardTypes
  cites Foreword chapter Board

 Verify that the Board HAL types and config records compile
 and that default configs produce valid values.

Section: Body

  opening : [Console] Nothing = act
   let uc = default-uart-config
   in let sc = default-spi-config
   in let ic = default-i2c-config
   in let ac = default-adc-config
   in act
    print-line-uni ("uart-baud=" & show (uc.baud))
    print-line-uni ("spi-clock=" & show (sc.clock-hz))
    print-line-uni ("i2c-clock=" & show (ic.clock-hz))
    print-line-uni ("adc-bits=" & show (ac.resolution-bits))
   end
  end

