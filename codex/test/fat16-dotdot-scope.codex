Chapter: Fat16DotDotScope
  cites Foreword chapter Fat16

 The disk holds directories A, A/C and A/E and the file A/E/F.TXT ("secret"), written by an unscoped program; this
 program holds FileSystem.Read "A/C" only. A/C/../E/F.TXT starts with the grant, and FAT16 directories carry a real
 ".." entry, so a walk that follows it reads A/E/F.TXT outside the grant.

Section: Entry

  opening : [Console, FileSystem.Read "A/C", Device.Block] Nothing
  opening = act
    vol <- fat16-init 2048
    ok <- fat16-write-file "A/C/OK.TXT" "inside"
    back <- fat16-read-text vol "A/C/OK.TXT"
    print-line-uni ("in-scope write and read " & show ok & " " & maybe-text back)
    direct <- fat16-read-text vol "A/E/F.TXT"
    print-line-uni ("out-of-scope read A/E/F.TXT " & maybe-text direct)
    climb <- fat16-read-text vol "A/C/../E/F.TXT"
    print-line-uni ("read through .. A/C/../E/F.TXT " & maybe-text climb)
    here <- fat16-read-text vol "A/C/./OK.TXT"
    print-line-uni ("read through . A/C/./OK.TXT " & maybe-text here)
    planted <- fat16-write-file "A/C/../E/G.TXT" "planted"
    print-line-uni ("write through .. A/C/../E/G.TXT " & show planted)
  end

Section: Reporting

  maybe-text : Maybe Text -> Text
  maybe-text (m) = when m
    is Just (t) -> t
    is None -> "<none>"

