Chapter: LetDestScope

  cites Foreword chapter StringUtils
  cites Foreword chapter Console

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (show (text-length "hello world"))
    print-line-uni (show (str-prefix-match-at "hello world" "world" 6 0 5))
    print-line-uni (show (str-index-loop "hello world" "world" 0 7 5))
    print-line-uni (show (text-index-of "hello world" "world"))
    print-line-uni (show (text-contains "hello world" "world"))
  end
