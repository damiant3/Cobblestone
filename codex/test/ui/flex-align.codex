Chapter: FlexAlign
  cites UI chapter Layout
  cites UI chapter Widget
  cites UI chapter Event
  cites Foreword chapter Console

 One row 60 tall holding items 10 tall at each alignment: start at y 0,
 centre at y 25, end at y 50, and a start item with a preferred height of 20
 taking 20. The stretch item is the control: its rect is the whole line, as
 every item's was before alignment existed. One column 200 wide centres an
 item 40 wide at x 80, and the tree path carries `widget-set-align` through
 `widget-layout`.

  rs : LayoutResult, Integer -> LayoutRect
  rs (r) (i) = list-at r.lrs i

  yh : LayoutRect -> Text
  yh (b) = integer-to-text (b.lr-y) & "+" & integer-to-text (b.lr-h)

  report : Text, Text, Boolean -> [Console] Nothing
  report (name) (got) (ok) = print-line-uni (name & " " & got & ": " & if ok then "PASS" else "FAIL")

  opening : [Console] Nothing = act
    let row = flex-layout (layout-rect 0 0 200 60) DirRow 0 [
          layout-item 20 10 0,
          layout-item-align (layout-item 20 10 0) align-start,
          layout-item-align (layout-item 20 10 0) align-center,
          layout-item-align (layout-item 20 10 0) align-end,
          layout-item-align (layout-item-full 20 10 0 edges-zero 0 0 0 20) align-start
        ] 5
    in let col = flex-layout (layout-rect 0 0 200 60) DirColumn 0 [layout-item-align (layout-item 40 10 0) align-center] 1
    in let tree = widget-stack "row" DirRow 0 [widget-set-align (widget-fixed (widget-stack "a" DirRow 0 []) 30 12) align-end, widget-fixed (widget-stack "b" DirRow 0 []) 30 12]
    in let laid = widget-layout tree theme-terminal (layout-rect 0 0 200 60)
    in let ta = (list-at laid.wn-children 0).wn-bounds
    in let tb = (list-at laid.wn-children 1).wn-bounds
    in act
      report "control, stretch fills the line" (yh (rs row 0)) ((rs row 0).lr-y == 0 & (rs row 0).lr-h == 60)
      report "start" (yh (rs row 1)) ((rs row 1).lr-y == 0 & (rs row 1).lr-h == 10)
      report "centre" (yh (rs row 2)) ((rs row 2).lr-y == 25 & (rs row 2).lr-h == 10)
      report "end" (yh (rs row 3)) ((rs row 3).lr-y == 50 & (rs row 3).lr-h == 10)
      report "start at the preferred height" (yh (rs row 4)) ((rs row 4).lr-y == 0 & (rs row 4).lr-h == 20)
      report "column centre" (integer-to-text ((rs col 0).lr-x) & "+" & integer-to-text ((rs col 0).lr-w)) ((rs col 0).lr-x == 80 & (rs col 0).lr-w == 40)
      report "widget-layout carries the alignment" (yh ta & " beside " & yh tb) (ta.lr-y == 48 & ta.lr-h == 12 & tb.lr-y == 0 & tb.lr-h == 60)
    end
  end
