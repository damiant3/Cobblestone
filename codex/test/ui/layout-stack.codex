Chapter: LayoutStack
  cites UI chapter Widget
  cites UI chapter Event
  cites Foreword chapter Console

  report : Text, Boolean -> [Console] Nothing
  report (name) (ok) = print-line-uni (name & ": " & if ok then "PASS" else "FAIL")

  opening : [Console] Nothing = act
    let child = widget-fixed (widget-button "action" "OK") 40 24
    in let stack = widget-stack "layout" DirRow 7 [child]
    in let surface = widget-panel "surface" DirRow 7 [child]
    in let sm = widget-measure stack theme-terminal
    in let pm = widget-measure surface theme-terminal
    in let laid = widget-layout stack theme-terminal (layout-rect 50 30 200 60)
    in let button = list-at laid.wn-children 0
    in let hit = ev-hit-widget laid (button.wn-bounds.lr-x + 5) (button.wn-bounds.lr-y + 5)
    in act
      report "typed layout container" (widget-kind-name stack.wn-kind == "stack")
      report "stack has no surface overhead" (style-overhead-w (widget-resolve-style stack theme-terminal) == 0 & style-overhead-h (widget-resolve-style stack theme-terminal) == 0)
      report "surface retains decoration" (pm.wn-min-w > sm.wn-min-w & pm.wn-min-h > sm.wn-min-h)
      report "stack measures children" (sm.wn-min-w == 44 & sm.wn-min-h == 28)
      report "offset child remains hittable" (when hit is Just (found) -> found.wn-id == "action" is None -> False)
    end
  end
