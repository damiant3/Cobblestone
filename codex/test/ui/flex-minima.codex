Chapter: FlexMinima
  cites UI chapter Layout
  cites Foreword chapter Console

  widths : LayoutResult, Integer, Integer, Integer -> Boolean
  widths (r) (a) (b) (c) =
    (list-at r.lrs 0).lr-w == a & (list-at r.lrs 1).lr-w == b & (list-at r.lrs 2).lr-w == c

  report : Text, Boolean -> [Console] Nothing
  report (name) (ok) = print-line-uni (name & ": " & if ok then "PASS" else "FAIL")

  opening : [Console] Nothing = act
    let box = layout-rect 9 37 100 101
    in let cascade = flex-layout box DirRow 0 [layout-item 50 0 1, layout-item 30 0 1, layout-item 0 0 1] 3
    in let column = flex-layout box DirColumn 0 [layout-item 0 0 1, layout-item 0 0 2, layout-item 0 0 3] 3
    in let tight = layout-rect 9 37 70 20
    in let shortage = flex-layout tight DirRow 0 [layout-item 50 0 1, layout-item 40 0 1] 2
    in let mixed = flex-layout box DirRow 0 [layout-item 70 0 0, layout-item 50 0 1] 2
    in let margined = flex-layout (layout-rect 9 37 120 20) DirRow 4 [layout-item-m 50 0 1 (edges-uniform 2), layout-item-m 0 0 1 (edges-uniform 2)] 2
    in let empty = flex-layout box DirRow 12 [] 0
    in let asymmetric = flex-layout box DirRow 0 [layout-item-m 0 0 1 (edges-uniform 5), layout-item 0 0 1] 2
    in act
      report "cascading floors redistribute" (widths cascade 50 30 20 & cascade.lr-used-w == 100)
      report "rounding consumes every pixel" ((list-at column.lrs 0).lr-h == 16 & (list-at column.lrs 1).lr-h == 34 & (list-at column.lrs 2).lr-h == 51 & (list-at column.lrs 2).lr-y == 87 & column.lr-used-h == 101)
      report "shortage preserves minima and reports overflow" ((list-at shortage.lrs 0).lr-w == 50 & (list-at shortage.lrs 1).lr-w == 40 & layout-overflow-w shortage tight == 20)
      report "fixed plus flex overflow" ((list-at mixed.lrs 0).lr-w == 70 & (list-at mixed.lrs 1).lr-w == 50 & layout-overflow-w mixed box == 20)
      report "margins and gap counted once in allocation" ((list-at margined.lrs 0).lr-x == 11 & (list-at margined.lrs 1).lr-x == 73 & (list-at margined.lrs 0).lr-w == 54 & margined.lr-used-w == 120 & margined.lr-used-h == 20)
      report "empty has no extent" (empty.lr-count == 0 & empty.lr-used-w == 0 & empty.lr-used-h == 0)
      report "unequal margins do not change equal flex shares" ((list-at asymmetric.lrs 0).lr-w == 45 & (list-at asymmetric.lrs 1).lr-w == 45 & asymmetric.lr-used-w == 100)
    end
  end
