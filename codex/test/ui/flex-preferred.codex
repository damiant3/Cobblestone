Chapter: FlexPreferred
  cites UI chapter Layout
  cites UI chapter Widget
  cites UI chapter Event
  cites Foreword chapter Console

 One row at three widths: above the preferred sum each preferred item keeps
 its basis and the excess is shared by weight; between the minimum and
 preferred sums the bases shrink toward the minimums in proportion to their
 slack; under the minimums every item sits at its minimum and the row
 reports the overflow. The control row is the same three items with no
 preferred sizes, the zero-basis split every existing layout still gets.

  ws : LayoutResult, Integer -> Integer
  ws (r) (i) = (list-at r.lrs i).lr-w

  three : LayoutResult -> Text
  three (r) = integer-to-text (ws r 0) & "/" & integer-to-text (ws r 1) & "/" & integer-to-text (ws r 2)

  report : Text, Text, Boolean -> [Console] Nothing
  report (name) (got) (ok) = print-line-uni (name & " " & got & ": " & if ok then "PASS" else "FAIL")

  row : Integer -> LayoutResult
  row (w) = flex-layout (layout-rect 0 0 w 20) DirRow 0 [layout-item-full 20 0 1 edges-zero 0 0 60 0, layout-item-full 10 0 1 edges-zero 0 0 40 0, layout-item 0 0 1] 3

  opening : [Console] Nothing = act
    let wide = row 200
    in let mid = row 70
    in let tight = row 20
    in let plain = flex-layout (layout-rect 0 0 200 20) DirRow 0 [layout-item 20 0 1, layout-item 10 0 1, layout-item 0 0 1] 3
    in let tree = widget-stack "row" DirRow 0 [widget-set-pref (widget-stack "a" DirRow 0 []) 150 0, widget-stack "b" DirRow 0 []]
    in let laid = widget-layout tree theme-terminal (layout-rect 0 0 200 60)
    in let wa = (list-at laid.wn-children 0).wn-bounds
    in let wb = (list-at laid.wn-children 1).wn-bounds
    in act
      report "above the preferred sum" (three wide) (ws wide 0 == 93 & ws wide 1 == 73 & ws wide 2 == 34 & wide.lr-used-w == 200)
      report "between the sums" (three mid) (ws mid 0 == 42 & ws mid 1 == 28 & ws mid 2 == 0 & mid.lr-used-w == 70)
      report "under the minimums" (three tight & " overflow " & integer-to-text (layout-overflow-w tight (layout-rect 0 0 20 20))) (ws tight 0 == 20 & ws tight 1 == 10 & ws tight 2 == 0 & layout-overflow-w tight (layout-rect 0 0 20 20) == 10)
      report "control, no preferred sizes" (three plain) (ws plain 0 == 66 & ws plain 1 == 67 & ws plain 2 == 67)
      report "widget-layout carries the preference" (integer-to-text (wa.lr-w) & "/" & integer-to-text (wb.lr-w)) (wa.lr-w == 175 & wb.lr-w == 25)
    end
  end
