Chapter: SetAlgebra
  cites Foreword chapter Set

Section: Checks

  truth : Boolean -> Text
  truth (b) = if b then "True" else "False"

  abc : TextSet
  abc = set-from-list ["a", "b", "c"]

  bcd : TextSet
  bcd = set-from-list ["b", "c", "d", "d"]

  long-key : Text -> Boolean
  long-key (k) = text-length k > 1

  members : TextSet -> Text
  members (s) = truth (set-contains s "a") & truth (set-contains s "b") & truth (set-contains s "c") & truth (set-contains s "d")

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (show (set-size abc) & " " & show (set-size bcd) & " " & truth (set-is-empty set-empty))
    print-line-uni (show (set-size (set-union abc bcd)) & " " & members (set-union abc bcd))
    print-line-uni (show (set-size (set-intersection abc bcd)) & " " & members (set-intersection abc bcd))
    print-line-uni (show (set-size (set-difference abc bcd)) & " " & members (set-difference abc bcd))
    print-line-uni (show (set-size (set-remove abc "b")) & " " & members (set-remove abc "b") & " " & show (set-size abc))
    print-line-uni (truth (set-any long-key abc) & " " & truth (set-all long-key (set-from-list ["xy", "zw"])) & " " & show (list-length (set-to-list bcd)))
  end
