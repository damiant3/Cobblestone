 We say:

Section: Test

  opening : [Console] Nothing = act
    let ev = event-key-down 65 0 0
    in when ev.ev-kind
      is EvKeyDown (k) (mods) -> print-line ("key=" & show k)
      is EvTimer (name) -> print-line ("timer=" & name)
      is otherwise -> print-line "other"
  end
