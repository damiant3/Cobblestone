Chapter: UiSoundTest
  cites UI chapter Sound

Section: Body

  test-sound-effect : Text =
    format-sound snd-click

  test-sound-beep : Text =
    format-sound snd-beep

  test-waveform : Text =
    let s = sound-effect "custom" WavTriangle 330 100 500
    in waveform-name (s.snd-wave)

  test-queue : Text =
    let sq = sound-queue-new 4
    in let sq2 = sq-enqueue (sq-enqueue sq snd-click) snd-beep
    in let empty = sq-is-empty sq
    in let notempty = sq-is-empty sq2
    in "empty=" & snd-bool empty & " count=" & show (sq2.sq-count) & " notempty=" & snd-bool notempty

  test-queue-drain : Text =
    let sq = sq-enqueue (sound-queue-new 4) snd-click
    in let sq2 = sq-drain sq
    in "drained=" & snd-bool (sq-is-empty sq2)

  test-queue-overflow : Text =
    let sq = sound-queue-new 2
    in let sq2 = sq-enqueue (sq-enqueue (sq-enqueue sq snd-click) snd-beep) snd-error
    in "count=" & show (sq2.sq-count)

  test-peek : Text =
    let sq = sq-enqueue (sound-queue-new 4) snd-warning
    in let top = sq-peek sq
    in when top
      is Just (s) -> "peek=" & s.snd-name
      is None -> "empty"

  test-sound-seq : Text =
    let steps = [sound-step snd-click 0, sound-step snd-beep 100]
    in let seq = sound-seq steps
    in let sq = sound-queue-new 4
    in let r1 = sound-seq-tick seq 0 sq
    in let r2 = sound-seq-tick (r1.ssr-seq) 100 (r1.ssr-queue)
    in "q-count=" & show ((r2.ssr-queue).sq-count) & " done=" & snd-bool ((r2.ssr-seq).sseq-done)

  snd-bool : Boolean -> Text
  snd-bool (b) = if b then "true" else "false"

  opening : [Console] Nothing = act
    print-line-uni test-sound-effect
    print-line-uni test-sound-beep
    print-line-uni test-waveform
    print-line-uni test-queue
    print-line-uni test-queue-drain
    print-line-uni test-queue-overflow
    print-line-uni test-peek
    print-line-uni test-sound-seq
  end

