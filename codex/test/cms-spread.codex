Chapter: CmsSpreadTest
  cites Foreword chapter CountMinSketch

 `cms-row-hash` is `hash * (row + 1) * 2654435761 + row * 1103515245` followed
 by a remainder against the width, with no downward fold. Multiplication
 carries entropy upward only, so the low bits selecting the column are a
 function of the low bits of the key hash and the row index, and the rows of
 one sketch are near-copies of each other rather than independent.

Section: Fixtures

  cst-width : Integer
  cst-width = 64

  cst-depth : Integer
  cst-depth = 4

  cst-keys : Integer
  cst-keys = 40

  cst-key : Integer -> Text
  cst-key (i) = "key" & show i

  cst-fill : CmSketch, Integer, Integer -> CmSketch
  cst-fill (s) (i) (n) =
    if i >= n then s
    else cst-fill (cms-add s (cst-key i) 1) (i + 1) n

Section: Measurement

  cst-exact : CmSketch, Integer, Integer, Integer -> Integer
  cst-exact (s) (i) (n) (acc) =
    if i >= n then acc
    else let e = cms-count s (cst-key i)
    in cst-exact s (i + 1) n (acc + (if e == 1 then 1 else 0))

  cst-worst : CmSketch, Integer, Integer, Integer -> Integer
  cst-worst (s) (i) (n) (acc) =
    if i >= n then acc
    else let e = cms-count s (cst-key i)
    in cst-worst s (i + 1) n (if e > acc then e else acc)

  cst-occupied : CmSketch, Integer, Integer, Integer, Integer -> Integer
  cst-occupied (s) (row) (col) (w) (acc) =
    if col >= w then acc
    else let v = list-at (s.cms-table) (row * w + col)
    in cst-occupied s row (col + 1) w (acc + (if v > 0 then 1 else 0))

Section: Entry

  opening : [Console] Nothing =
    let s = cst-fill (cms-new cst-width cst-depth) 0 cst-keys
    in let exact = cst-exact s 0 cst-keys 0
    in let worst = cst-worst s 0 cst-keys 0
    in let r0 = cst-occupied s 0 0 cst-width 0
    in let r1 = cst-occupied s 1 0 cst-width 0
    in let r2 = cst-occupied s 2 0 cst-width 0
    in let r3 = cst-occupied s 3 0 cst-width 0
    in act
      print-line-uni ("keys:           " & show cst-keys)
      print-line-uni ("exact:          " & show exact)
      print-line-uni ("worst estimate: " & show worst)
      print-line-uni ("cols used:      " & show r0 & " " & show r1 & " " & show r2 & " " & show r3)
      print-line-uni ("mostly exact:   " & show (exact * 4 >= cst-keys * 3))
      print-line-uni ("rows spread:    " & show ((r0 > 20) & (r1 > 20) & (r2 > 20) & (r3 > 20)))
      print-line-uni ("total:          " & show (cms-total s))
    end
