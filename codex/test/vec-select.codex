Chapter: VecSelect
  cites Foreword chapter Console

Section: Entry
  opening : [Console] Nothing
  opening = act
    let a = vec-splat 3.0
    in let b = vec-splat 7.0
    in let mask = a < b
    in let picked = vec-select mask a b
    in act
      print-line-uni ("lt-true: " & show (vec-extract picked 0))
    end
    let c = vec-splat 10.0
    in let d = vec-splat 2.0
    in let mask2 = c < d
    in let picked2 = vec-select mask2 c d
    in act
      print-line-uni ("lt-false: " & show (vec-extract picked2 0))
    end
  end
