Chapter: VecSelect
  cites Foreword chapter Console

Section: Helpers

  test-select-true : [Console] Nothing
  test-select-true = act
    let a = vec-splat 3.0
    in let b = vec-splat 7.0
    in let mask = a < b
    in let picked = vec-select mask a b
    in print-line-uni ("lt-true: " & show (vec-extract picked 0))
  end

  test-select-false : [Console] Nothing
  test-select-false = act
    let c = vec-splat 10.0
    in let d = vec-splat 2.0
    in let mask2 = c < d
    in let picked2 = vec-select mask2 c d
    in print-line-uni ("lt-false: " & show (vec-extract picked2 0))
  end

Section: Entry

  opening : [Console] Nothing
  opening = act
    test-select-true
    test-select-false
  end
