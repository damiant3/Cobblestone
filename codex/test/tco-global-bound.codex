Chapter: Tco Global Bound

  lim : Integer = 5

  es : Integer, Integer -> Integer
  es (i) (acc) = if i >= lim then acc else es (i + 1) (acc + i * 7)

  es2 : Integer, Integer, Integer -> Integer
  es2 (i) (n) (acc) = if i >= n then acc else es2 (i + 1) n (acc + i * 7)

  cnt : Integer -> Integer
  cnt (i) = if i >= lim then i else cnt (i + 1)

  opening : [Console] Nothing = act
    print-line-uni ("lim " & show lim)
    print-line-uni ("cmp " & show (if 3 >= lim then 1 else 0))
    print-line-uni ("es2 " & show (es2 0 lim 0))
    print-line-uni ("cnt " & show (cnt 0))
    print-line-uni ("es " & show (es 0 0))
  end

