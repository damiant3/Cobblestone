Chapter: GlobalRenamePrecedence
  cites Codex chapter Opening

  gr-assign : Text, Text -> ChapterAssignment
  gr-assign (name) (slug) = ChapterAssignment { def-name = name, chapter-slug = slug }

  gr-name : Integer -> Text
  gr-name (i) = "n" & show i

  gr-slug : Integer -> Text
  gr-slug (c) = "c" & show c

  gr-names : Integer, Integer, List Text -> List Text
  gr-names (i) (n) (acc) = if i >= n then acc else gr-names (i + 1) n (acc & [gr-name i])

  gr-round : Integer, Integer, Integer, List ChapterAssignment -> List ChapterAssignment
  gr-round (k) (i) (n) (acc) =
    if i >= n then acc
    else gr-round k (i + 1) n (acc & [gr-assign (gr-name i) (gr-slug (int-mod (i + k) 5))])

  gr-rounds : Integer, Integer, List ChapterAssignment -> List ChapterAssignment
  gr-rounds (k) (n) (acc) = if k >= 5 then acc else gr-rounds (k + 1) n (gr-round k 0 n acc)

  gr-wrong : List RenameEntry, Integer, Integer, Integer -> Integer
  gr-wrong (table) (i) (n) (bad) =
    if i >= n then bad
    else gr-wrong table (i + 1) n (if rename-lookup table (gr-name i) == mangle-name (gr-slug (int-mod i 5)) (gr-name i) then bad else bad + 1)

  opening : [Console] Nothing
  opening =
    let n = 40
    in let assignments = gr-rounds 0 n [gr-assign "solo" "c9"]
    in let table = build-global-rename-table assignments (skip-list-text-from-list (gr-names 0 n []))
    in act
      print-line-uni ("assignments " & show (list-length assignments))
      print-line-uni ("entries " & show (list-length table))
      print-line-uni ("names not bound to their first assignment " & show (gr-wrong table 0 n 0))
      print-line-uni ("solo " & rename-lookup table "solo")
    end
