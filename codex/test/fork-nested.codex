Chapter: ForkNested
  cites Codex chapter Concurrency

Section: Definitions

  double : Nothing -> Integer
  double (x) = 21 * 2

  triple : Nothing -> Integer
  triple (x) = 14 * 3

  opening : [Concurrent] Integer = act
    t1 <- fork double
    t2 <- fork triple
    a <- await t1
    b <- await t2
    a + b
  end

