Chapter: Let Effectful Bug
  cites Codex chapter Text

Section: Definitions

  recurse : Integer, Integer -> [Console] Integer
  recurse (i) (n) =
    if i >= n then i
    else act
      print-line-uni ("step " & integer-to-text i)
      recurse (i + 1) n
    end

  use-let : [Console] Nothing = act
    let r = recurse 0 3
    in act
      print-line-uni "let-bound r ="
      print-line-uni (integer-to-text r)
    end
  end

  use-bind : [Console] Nothing = act
    r <- recurse 0 3
    print-line-uni "do-bound r ="
    print-line-uni (integer-to-text r)
  end

  opening : [Console] Nothing = act
    print-line-uni "=== use-bind (expected: 3) ==="
    use-bind
    print-line-uni ""
    print-line-uni "=== use-let (expected: 3) ==="
    use-let
  end

