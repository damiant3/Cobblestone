Chapter: TextHelperNative

  cites Foreword chapter Console

Section: Body

  b2 : Boolean -> Text
  b2 (x) = if x then "T" else "F"

  join-loop : List Text, Integer, Text -> Text
  join-loop (xs) (i) (acc) =
    if i >= list-length xs then acc
    else join-loop xs (i + 1) (acc & "[" & list-at xs i & "]")

  sp : Text, Text -> Text
  sp (s) (sep) = show (list-length (text-split s sep)) & join-loop (text-split s sep) 0 ""

  opening : [Console] Nothing = act
    print-line-uni ("sw " & b2 (text-starts-with "hello" "he") & b2 (text-starts-with "hello" "") & b2 (text-starts-with "" "") & b2 (text-starts-with "" "a") & b2 (text-starts-with "he" "hello") & b2 (text-starts-with "hello" "hello") & b2 (text-starts-with "abc" "abd"))
    print-line-uni ("ct " & b2 (text-contains "hello" "ell") & b2 (text-contains "hello" "") & b2 (text-contains "" "") & b2 (text-contains "" "a") & b2 (text-contains "hello" "lo") & b2 (text-contains "hello" "hex") & b2 (text-contains "aaa" "aa") & b2 (text-contains "abc" "abcd"))
    print-line-uni ("rp " & text-replace "hello" "l" "L" & "|" & text-replace "hello" "hello" "" & "|" & text-replace "aaaa" "aa" "b" & "|" & text-replace "abc" "z" "y" & "|" & text-replace "" "a" "b" & "|" & text-replace "abab" "ab" "abab" & "|" & text-replace "hello" "" "x")
    print-line-uni ("sp1 " & sp "a,b,,c" ",")
    print-line-uni ("sp2 " & sp "" ",")
    print-line-uni ("sp3 " & sp "abc" ",")
    print-line-uni ("sp4 " & sp ",a," ",")
    print-line-uni ("sp5 " & sp "a::b::c" "::")
    print-line-uni ("sp6 " & sp "abc" "")
    print-line-uni ("sp7 " & sp "aXbXc" "X")
    print-line-uni ("ti " & show (text-to-integer "42") & " " & show (text-to-integer "-42") & " " & show (text-to-integer "+7") & " " & show (text-to-integer "0") & " " & show (text-to-integer "007") & " " & show (text-to-integer "abc") & " " & show (text-to-integer "12abc") & " " & show (text-to-integer "") & " " & show (text-to-integer " 42") & " " & show (text-to-integer "-") & " " & show (text-to-integer "9223372036854775807"))
  end