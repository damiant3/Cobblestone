Chapter: CdxExportRetention
  cites Foreword chapter Console

Section: Definitions

  wasm-exports : Text = "|drive|export-only|"

  drive : Integer -> Integer
  drive (x) = x + 1

  export-only : Integer -> Integer
  export-only (x) = x * 2

  dead-code : Integer -> Integer
  dead-code (x) = x - 1

Section: Entry

  opening : [Console] Nothing = print-line-uni (show (drive 41))
