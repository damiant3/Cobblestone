Chapter: List O1 Probe

 A list literal whose elements are not trivial: each one allocates
 (a concat) or calls, so the buffer must survive element evaluation.
 Nested literals check that a literal inside a literal still works
 when the outer buffer is already reserved below it.

Section: Entry

  tag : Integer -> Text
  tag (n) = "e" & show n

  flat : List Integer
  flat = [1, 2, 3, 4, 5]

  nested : List (List Integer)
  nested = [[1, 2], [3, 4, 5], [6]]

  report : Integer -> Text
  report (x) =
   let alloc = [tag 1, tag 2, tag 3]
   in let mixed = [list-length flat, list-length (list-at nested 1), 7]
   in "flat-len=" & show (list-length flat)
    & " ends=" & show (list-at flat 0 + list-at flat 4)
    & " alloc=" & list-at alloc 0 & list-at alloc 1 & list-at alloc 2
    & " nested=" & show (list-at (list-at nested 1) 2)
    & " nested-len=" & show (list-length nested)
    & " mixed=" & show (list-at mixed 0 + list-at mixed 1 + list-at mixed 2)

  opening : [Console] Integer
  opening = act
    (print-line-uni (report 0))
    0
  end
