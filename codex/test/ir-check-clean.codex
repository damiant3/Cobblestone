Chapter: IRCheckClean
  cites Foreword chapter Console

 The silence-only test for the `ir-check` IR validator. This is an
 ordinary program, and that is the whole point: compiled with
 `passes=fold-constants,ir-check,inline-leaf-calls,ir-check` it must
 produce a binary byte-identical to the default pipeline's, and print
 exactly what it prints under the default pipeline. A validator that
 fires on valid IR is worse than no validator, so the property under
 test is that nothing happens.

 The constructs here are the ones the scope walk has to get right:
 shadowed lets (an inner binder with the same name as an outer one),
 lambdas and their parameters, match branches whose patterns bind
 sub-names, recursion (a definition naming itself), calls to chapter
 definitions and to builtins by bare name, records and field access,
 and list literals.

Section: Shadowing

  shadow : Integer -> Integer
  shadow (x) =
   let x = x + 1
   in let y = x * 2
   in let x = y + x
   in x

Section: Lambdas

  apply-twice : Integer -> Integer
  apply-twice (n) =
   let f = \a -> a + a
   in f (f n)

  capture : Integer -> Integer
  capture (n) =
   let k = n + 5
   in let g = \a -> a * k
   in g 3

Section: Sum Types

  Tree =
   | Leaf (Integer)
   | Node (Tree) (Tree)

  tree-sum : Tree -> Integer
  tree-sum (t) =
   when t
    is Leaf (v) -> v
    is Node (l) (r) -> tree-sum l + tree-sum r

  sample-tree : Tree
  sample-tree = Node (Leaf 3) (Node (Leaf 4) (Leaf 5))

Section: Records

  Point = record {
   x : Integer,
   y : Integer
  }

  manhattan : Point -> Integer
  manhattan (p) = abs (p.x) + abs (p.y)

Section: Lists

  total : List Integer -> Integer
  total (xs) = total-loop xs 0 (list-length xs) 0

  total-loop : List Integer, Integer, Integer, Integer -> Integer
  total-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else total-loop xs (i + 1) len (acc + list-at xs i)

Section: Entry

  opening : [Console] Nothing = act
   print-line-uni ("shadow: " & show (shadow 3))
   print-line-uni ("apply-twice: " & show (apply-twice 5))
   print-line-uni ("capture: " & show (capture 1))
   print-line-uni ("tree-sum: " & show (tree-sum sample-tree))
   print-line-uni ("manhattan: " & show (manhattan (Point { x = 0 - 3, y = 4 })))
   print-line-uni ("total: " & show (total [1, 2, 3, 4, 5]))
   print-line-uni ("text: " & ("ir" & "-" & "check"))
  end
