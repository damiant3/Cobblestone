Chapter: MulTrapRecursive
  cites Foreword chapter Console

Section: Body

  mr : Integer, Integer -> Integer
  mr (a) (k) = if k <= 0 then a * 10 else mr a (k - 1)

  f : Integer -> Integer
  f (a) = a * 10

  opening : [Console] Nothing = act
    print-line-uni (show (mr 1000000000000000000 0))
  end

