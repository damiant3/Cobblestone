Chapter: VectorF32Mask
  cites Foreword chapter Console

Section: Mixed Lanes

  make4 : Real, Real, Real, Real -> Vector 4 (Real approximate)
  make4 (a) (b) (c) (d) =
   let v = vec4-splat (to-real-approx 0.0)
   in let p = address-of v
   in let w0 = poke-32 p 0 (real-approx-to-bits (to-real-approx a))
   in let w1 = poke-32 p 4 (real-approx-to-bits (to-real-approx b))
   in let w2 = poke-32 p 8 (real-approx-to-bits (to-real-approx c))
   in let w3 = poke-32 p 12 (real-approx-to-bits (to-real-approx d))
   in v

  lane-value : Integer, Integer -> Real
  lane-value (bits) (bit) = if bit-and bits bit > 0 then 0.0 else 2.0

  mask-score : Integer -> Integer
  mask-score (bits) =
   let v = make4 (lane-value bits 1) (lane-value bits 2) (lane-value bits 4) (lane-value bits 8)
   in let m = v < vec4-splat (to-real-approx 1.0)
   in mask4-count m + (if mask4-any m then 8 else 0) + (if mask4-all m then 16 else 0) + (if mask4-none m then 32 else 0)

Section: Entry
  opening : [Console] Nothing
  opening = act
    let three = vec4-splat (to-real-approx 3.0)
    in let four = vec4-splat (to-real-approx 4.0)
    in let all-lt = three < four
    in let none-lt = four < three
    in let picked = vec4-select all-lt three four
    in let missed = vec4-select none-lt three four
    in act
      print-line-uni ("all-any: " & show (mask4-any all-lt))
      print-line-uni ("all-all: " & show (mask4-all all-lt))
      print-line-uni ("all-none: " & show (mask4-none all-lt))
      print-line-uni ("all-count: " & show (mask4-count all-lt))
      print-line-uni ("none-any: " & show (mask4-any none-lt))
      print-line-uni ("none-all: " & show (mask4-all none-lt))
      print-line-uni ("none-none: " & show (mask4-none none-lt))
      print-line-uni ("none-count: " & show (mask4-count none-lt))
      print-line-uni ("picked0: " & show (from-real-approx (vec4-extract picked 0)))
      print-line-uni ("picked3: " & show (from-real-approx (vec4-extract picked 3)))
      print-line-uni ("missed0: " & show (from-real-approx (vec4-extract missed 0)))
      print-line-uni ("reduce: " & show (from-real-approx (vec4-reduce-add three)))
      print-line-uni ("mask-0: " & show (mask-score 0))
      print-line-uni ("mask-1: " & show (mask-score 1))
      print-line-uni ("mask-2: " & show (mask-score 2))
      print-line-uni ("mask-3: " & show (mask-score 3))
      print-line-uni ("mask-4: " & show (mask-score 4))
      print-line-uni ("mask-5: " & show (mask-score 5))
      print-line-uni ("mask-6: " & show (mask-score 6))
      print-line-uni ("mask-7: " & show (mask-score 7))
      print-line-uni ("mask-8: " & show (mask-score 8))
      print-line-uni ("mask-9: " & show (mask-score 9))
      print-line-uni ("mask-10: " & show (mask-score 10))
      print-line-uni ("mask-11: " & show (mask-score 11))
      print-line-uni ("mask-12: " & show (mask-score 12))
      print-line-uni ("mask-13: " & show (mask-score 13))
      print-line-uni ("mask-14: " & show (mask-score 14))
      print-line-uni ("mask-15: " & show (mask-score 15))
      let mixed = make4 0.0 2.0 0.0 2.0
      in let chosen = vec4-select (mixed < three) mixed four
      in let high = vec4-select (mixed < vec4-splat (to-real-approx 1.0)) three four
      in act
        print-line-uni ("mixed-reduce: " & show (from-real-approx (vec4-reduce-add chosen)))
        print-line-uni ("selected0: " & show (from-real-approx (vec4-extract high 0)))
        print-line-uni ("selected1: " & show (from-real-approx (vec4-extract high 1)))
        print-line-uni ("selected2: " & show (from-real-approx (vec4-extract high 2)))
        print-line-uni ("selected3: " & show (from-real-approx (vec4-extract high 3)))
        print-line-uni ("ordered-reduce: " & show (from-real-approx (vec4-reduce-add (make4 100000000.0 1.0 -100000000.0 1.0))))
        let unique = make4 1.0 2.0 3.0 4.0
        in let asymmetric = vec4-select (unique < vec4-splat (to-real-approx 2.0)) unique (make4 10.0 20.0 30.0 40.0)
        in act
          print-line-uni ("unique0: " & show (from-real-approx (vec4-extract asymmetric 0)))
          print-line-uni ("unique1: " & show (from-real-approx (vec4-extract asymmetric 1)))
          print-line-uni ("unique2: " & show (from-real-approx (vec4-extract asymmetric 2)))
          print-line-uni ("unique3: " & show (from-real-approx (vec4-extract asymmetric 3)))
        end
      end
    end
  end
