Chapter: WallpaperStateTest
  cites Dev chapter Wallpaper

Section: Entry
  opening : [Console] Nothing = act
    m1 <- (wp-preset-midnight).wp-color1
    d1 <- (wp-preset-dawn).wp-color1
    m2 <- (wp-preset-midnight).wp-color1
    print-line-uni ("presets midnight " & show m1 & " dawn " & show d1 & " midnight again " & show m2 & " new " & show (wallpaper-new).wp-color1 & " " & wp-current-mode-label wallpaper-new)
    s <- wp-set-solid wallpaper-new #102030
    print-line-uni ("scale " & show (wp-set-pattern-scale s 2).wp-pattern-scale & " " & show (wp-set-pattern-scale s 500).wp-pattern-scale & " interval " & show (wp-set-slideshow-interval s 3).wp-slideshow-interval & " " & show (wp-set-slideshow-interval s 100000).wp-slideshow-interval)
    shows <- __record-set (__record-set s "wp-slideshow-paths" ["a", "b", "c"]) "wp-slideshow-count" 3
    print-line-uni ("slides " & show (wp-slideshow-advance shows).wp-slideshow-index & " " & show (wp-slideshow-advance shows).wp-slideshow-index & " " & show (wp-slideshow-advance shows).wp-slideshow-index & " empty " & show (wp-slideshow-advance wallpaper-new).wp-slideshow-index)
    print-line-uni ("pattern " & wp-current-mode-label (wp-set-pattern s PatHexagons 1 2))
  end
