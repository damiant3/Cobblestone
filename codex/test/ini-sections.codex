Chapter: IniSections
  cites Encode chapter Ini

Section: Checks

  sample : Text
  sample = "name = top\n[server]\nhost = example\nport=8080\n; note = skipped\n# hash = skipped\n\n[client]\n  port = 9  \n"

  parsed : IniFile
  parsed = ini-parse sample

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (format-ini-entry parsed "default" "name")
    print-line-uni (format-ini-entry parsed "server" "host")
    print-line-uni (format-ini-entry parsed "server" "port")
    print-line-uni (format-ini-entry parsed "client" "port")
    print-line-uni (format-ini-entry parsed "server" "; note")
    print-line-uni (format-ini-entry parsed "server" "# hash")
    print-line-uni (ini-get-or parsed "client" "host" "fallback")
    print-line-uni (show (parsed.ini-section-count))
  end
