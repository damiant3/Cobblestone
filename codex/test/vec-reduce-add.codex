Chapter: VecReduceAdd
  cites Foreword chapter Console

Section: Entry
  opening : [Console] Nothing
  opening = act
    let a = vec-splat 3.0
    in let b = vec-splat 4.0
    in let sum = a + b
    in act
      print-line-uni ("splat3: " & show (vec-reduce-add a))
      print-line-uni ("splat4: " & show (vec-reduce-add b))
      print-line-uni ("sum: " & show (vec-reduce-add sum))
      print-line-uni ("dot: " & show (vec-reduce-add (a * b)))
    end
  end
