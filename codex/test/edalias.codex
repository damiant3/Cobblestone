Chapter: EdAliasTest

Section: Mutating helpers

  add-into : List Integer, List Integer -> List Integer
  add-into (a) (b) = add-loop a b 0

  add-loop : List Integer, List Integer, Integer -> List Integer
  add-loop (a) (b) (i) =
    if i == 4 then a
    else let v = list-set-at a i (list-at a i + list-at b i)
    in add-loop v b (i + 1)

  copy4 : List Integer -> List Integer
  copy4 (a) = copy-loop a 0 [0, 0, 0, 0]

  copy-loop : List Integer, Integer, List Integer -> List Integer
  copy-loop (a) (i) (out) =
    if i == 4 then out
    else copy-loop a (i + 1) (list-set-at out i (list-at a i))

  sum4 : List Integer -> Integer
  sum4 (xs) = list-at xs 0 + list-at xs 1 + list-at xs 2 + list-at xs 3

  bump : List Integer, Integer -> Integer
  bump (log) (tag) =
    let cur = list-at log 0
    in let l2 = list-set-at log (cur + 1) tag
    in let l3 = list-set-at l2 0 (cur + 1)
    in tag

  pair : Integer, Integer -> Integer
  pair (a) (b) = a * 0 + b * 0

Section: Reports

  r1 : Text =
    "inplace=" & show (let xs = copy4 [1, 2, 3, 4]
                       in let ys = list-set-at xs 0 11
                       in sum4 xs)

  r2 : Text =
    "same-object=" & show (let xs = copy4 [1, 2, 3, 4]
                           in let ys = list-set-at xs 0 11
                           in sum4 ys - sum4 xs)

  r3 : Text =
    "add-into-sum=" & show (let src = copy4 [1, 2, 3, 4]
                            in sum4 (add-into (copy4 src) src))

  r4 : Text =
    "src-untouched=" & show (let src = copy4 [1, 2, 3, 4]
                             in let d = add-into (copy4 src) src
                             in sum4 src)

  r5 : Text =
    "aliased=" & show (let src = copy4 [1, 2, 3, 4]
                       in sum4 (add-into src src))

  r6 : Text =
    "argorder=" & show (let log = copy4 [0, 0, 0, 0]
                        in let z = pair (bump log 7) (bump log 9)
                        in list-at log 1 * 10 + list-at log 2)

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni r1
    print-line-uni r2
    print-line-uni r3
    print-line-uni r4
    print-line-uni r5
    print-line-uni r6
  end
