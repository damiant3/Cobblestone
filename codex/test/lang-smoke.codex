Chapter: LangSmoke
  cites Foreword chapter Console
  cites Foreword chapter Iterate
  cites Foreword chapter Tuple

 Combined language feature tests: booleans, comparisons, hex literals,
 let chains, for expressions, guard clauses, multi-pattern, multiline
 app, or-pattern, over-apply, partial app, tuples, text/string ops,
 lazy eval, lambdas, show, fold-indexed, eq on variants.

Section: Types

  Color = | Red | Green | Blue | Yellow | Orange

  Shape = | Circle (Integer) | Rect (Integer) (Integer)

  Opt (a) = | Some (a) | Nada

Section: Functions

  check-bool : Boolean, Boolean -> Boolean
  check-bool (a) (b) = a & (b | a)

  is-warm : Color -> Text
  is-warm (c) = when c
    is Red | Orange | Yellow -> "warm"
    is Blue | Green -> "cool"

  area-kind : Shape -> Text
  area-kind (s) = when s
    is Circle (r) when r > 10 -> "large-circle"
    is Circle (r) -> "small-circle"
    is Rect (w) (h) when w == h -> "square"
    is Rect (w) (h) -> "rectangle"

  count-letters : Text, Integer, Integer -> Integer
  count-letters (s) (i) (acc) =
    if i >= text-length s then acc
    else if is-letter (char-at s i) then count-letters s (i + 1) (acc + 1)
    else count-letters s (i + 1) acc

  make-adder : Integer, Integer -> Integer
  make-adder (x) (y) = x + y

  three-deep : Integer, Integer, Integer -> Integer
  three-deep (a) (b) (c) = a + b + c

  id : a -> a
  id (x) = x

  inc : Integer -> Integer
  inc (n) = n + 1

  opt-or : a, Opt a -> a
  opt-or (d) (m) = when m is Some (x) -> x is Nada -> d

  opt-map : (a -> b), Opt a -> Opt b
  opt-map (f) (m) = when m is Some (x) -> Some (f x) is Nada -> Nada

  swap-tup : Tup2 a b -> Tup2 b a
  swap-tup (p) = when p is (x, y) -> (y, x)

  sum3 : Tup3 Integer Integer Integer -> Integer
  sum3 (t) = when t is (a, b, c) -> a + b + c

  my-combiner : Integer, Integer, Integer -> Integer
  my-combiner (acc) (elem) (idx) = acc + elem * 10 + idx

Section: Body

  opening : [Console] Nothing = act
    print-line-uni (if check-bool True True then "bool-ok" else "BAD")
    print-line-uni (if 5 < 10 then "lt" else "nlt")
    print-line-uni (if 5 == 5 then "eq" else "neq")
    print-line-uni (show #FF)
    print-line-uni (show #DEAD_BEEF)
    let chain = let a = 1 in let b = a + 1 in let c = b + a in c + b in print-line-uni (show chain)
    print-line-uni (is-warm Red)
    print-line-uni (is-warm Blue)
    print-line-uni (area-kind (Circle 20))
    print-line-uni (area-kind (Rect 4 4))
    let doubled = for x in [1, 2, 3] -> x + x in print-line-uni (show (list-at doubled 1))
    print-line-uni (show (count-letters "hello world" 0 0))
    let partial = make-adder 10 in print-line-uni (show (partial 5))
    let p2 = three-deep 1 2 in print-line-uni (show (p2 3))
    print-line-uni (show (id 7))
    print-line-uni (show (opt-or 0 (opt-map inc (Some 41))))
    print-line-uni (show (when swap-tup (10, 20) is (x, y) -> sum3 (x, y, 99)))
    print-line-uni (show (list-fold-indexed [1, 2, 3] 0 my-combiner))
    print-line-uni (show "hello")
    print-line-uni (show (Circle 5 == Circle 5))
    print-line-uni (show (Circle 5 == Circle 7))
    print-line-uni (show (Circle 5 == Rect 3 4))
    print-line-uni (show (bit-and 12 10))
    print-line-uni (show (bit-shl 1 8))
    print-line-uni (show (int-mod 7 3))
    print-line-uni (show (abs (-42)))
    print-line-uni (substring "hello world" 0 5)
    let parts = text-split "a,b,c" "," in print-line-uni (show (list-length parts))
  end

