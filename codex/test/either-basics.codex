Chapter: EitherBasics
  cites Foreword chapter Either

Section: Checks

  double : Integer -> Integer
  double (x) = x * 2

  negate : Integer -> Integer
  negate (x) = 0 - x

  truth : Boolean -> Text
  truth (b) = if b then "True" else "False"

  lefty : Either Integer Integer
  lefty = Left 3

  righty : Either Integer Integer
  righty = Right 4

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (truth (is-left lefty) & " " & truth (is-right lefty) & " " & truth (is-left righty) & " " & truth (is-right righty))
    print-line-uni (show (from-left lefty 9) & " " & show (from-right lefty 9) & " " & show (from-left righty 9) & " " & show (from-right righty 9))
    print-line-uni (show (either double negate lefty) & " " & show (either double negate righty))
  end
