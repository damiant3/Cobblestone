Chapter: TcoDirectArgReads

 Correct is 101; reading the clobbered parameter gives 1001.

Section: Fixture

  Box = record {
   v : Integer
  }

  mk : Integer -> Box
  mk (x) = Box { v = x }

  loop4 : Integer, Box, Integer, Integer -> Integer
  loop4 (i) (s) (acc) (n) =
   if i >= n then acc
   else let s2 = mk (s.v * 10)
   in loop4 (i + 1) s2 (s.v + 1) n

Section: Entry

  opening : [Console] Nothing
  opening = act
   print-line-uni ("acc=" & show (loop4 0 (Box { v = 1 }) 0 3))
  end
