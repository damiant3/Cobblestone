Chapter: HalFlashLinear
  cites Foreword chapter Board

Section: Body
  stage : Integer, Integer -> [Flash, Device.Mmio] Integer
  stage (base) (page) = act
    b0 <- flash-open-bank base
    b1 <- flash-write-page b0 page [72, 73, 74, 75]
    b2 <- flash-write-page b1 (page + 4) [76, 77]
    flash-seal-bank b2
  end

  opening : [Console, Flash, Device.Mmio] Nothing = act
    r <- stage 536875008 536879104
    print-line-uni ("flash lifecycle ok: " & show r)
  end
