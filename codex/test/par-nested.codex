Chapter: ParNested

  cites Codex chapter Concurrency



Section: Definitions



  add-pair : Integer, Integer, Nothing -> Integer

  add-pair (a) (b) (u) = a + b



  opening : [Concurrent] Integer = act

    t1 <- fork (\u -> 10)

    t2 <- fork (\u -> 20)

    t3 <- fork (\u -> 12)

    a <- await t1

    b <- await t2

    c <- await t3

    t4 <- fork (add-pair a b)

    t5 <- fork (add-pair b c)

    d <- await t4

    e <- await t5

    d + e

  end



