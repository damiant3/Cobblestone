Chapter: GopRenderClamp
  cites Foreword chapter Console
  cites UI chapter Theme
  cites UI chapter Widget
  cites UI chapter Layout
  cites UI chapter BoxModel
  cites UI chapter PixelBuf
  cites Guios chapter GopRender
  cites Guios chapter GuiTimer

Section: Body
  buf-w : Integer = 400
  buf-h : Integer = 60

  scan-row-band : GopBuf, Integer, Integer, Integer, Integer, Integer -> Integer
  scan-row-band (gb) (y) (x) (xend) (target) (acc) =
    if x >= xend then acc
    else scan-row-band gb y (x + 1) xend target (acc + (if gop-buf-get gb x y == target then 1 else 0))

  scan-band : GopBuf, Integer, Integer, Integer, Integer, Integer -> Integer
  scan-band (gb) (y) (x0) (x1) (target) (acc) =
    if y >= buf-h then acc
    else scan-band gb (y + 1) x0 x1 target (acc + scan-row-band gb y x0 x1 target 0)

  gauge-tree : WidgetNode
  gauge-tree =
    widget-panel "root" DirRow 0 [
      widget-set-flex (widget-set-min (widget-gauge "over" 150 100) 200 40) 0,
      widget-set-flex (widget-label "pad" "") 1
    ]

  input-tree : WidgetNode
  input-tree =
    widget-panel "root" DirRow 0 [
      widget-set-flex (widget-set-min (widget-input "far" "" 60) 200 40) 0,
      widget-set-flex (widget-label "pad" "") 1
    ]

  opening : [Console] Nothing =
    act
      let th = theme-terminal
      in let pal = th.th-palette
      in let gl = widget-layout gauge-tree th (layout-rect 0 0 buf-w buf-h)
      in let g = list-at (gl.wn-children) 0
      in let gbnd = g.wn-bounds
      in let gright = gbnd.lr-x + gbnd.lr-w
      in let gbuf = gop-buf-new buf-w buf-h (pal.pal-bg)
      in let d1 = gop-render-gauge g th 150 100 gbuf
      in let il = widget-layout input-tree th (layout-rect 0 0 buf-w buf-h)
      in let inp = list-at (il.wn-children) 0
      in let ibnd = inp.wn-bounds
      in let iright = ibnd.lr-x + ibnd.lr-w
      in let ibuf = gop-buf-new buf-w buf-h (pal.pal-bg)
      in let d2 = gop-render-input inp th "" 60 ibuf mw-new
      in act
        print-line-uni ("gauge inside: " & show (if scan-band gbuf 0 (gbnd.lr-x) gright (pal.pal-primary) 0 > 0 then 1 else 0))
        print-line-uni ("gauge outside: " & show (if scan-band gbuf 0 (gright + 4) (buf-w - 8) (pal.pal-primary) 0 > 0 then 1 else 0))
        print-line-uni ("input box: " & show (if scan-band ibuf 0 (ibnd.lr-x) iright (pal.pal-muted) 0 > 0 then 1 else 0))
        print-line-uni ("input inside: " & show (if scan-band ibuf 0 (ibnd.lr-x) iright (pal.pal-fg) 0 > 0 then 1 else 0))
        print-line-uni ("input outside: " & show (if scan-band ibuf 0 (iright + 4) (buf-w - 8) (pal.pal-fg) 0 > 0 then 1 else 0))
      end
    end
