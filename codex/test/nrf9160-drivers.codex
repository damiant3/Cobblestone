Chapter: Nrf9160Drivers

  cites Boards chapter Nrf9160Board

Section: Definitions

  test-clock : [Device.Mmio] Integer
  test-clock = act
   hf <- (nrf91-clock-start-hfclk)
   1
  end

  test-gpio : [Device.Mmio] Integer
  test-gpio = act
   a <- nrf91-gpio-set-output 10
   b <- nrf91-gpio-set-input 4
   c <- nrf91-gpio-set-pull 4 1
   d <- nrf91-gpio-write 10 True
   e <- nrf91-gpio-read 10
   f <- (nrf91-gpio-toggle 10)
   1
  end

  test-uart : [Device.Mmio] Integer
  test-uart = act
   a <- nrf91-uarte-init nrf91-baud-115200
   b <- nrf91-uarte-send-byte 65
   c <- nrf91-uarte-print "hello"
   d <- (nrf91-uarte-println "world")
   1
  end

  test-spi : [Device.Mmio] Integer
  test-spi = act
   a <- nrf91-spim-init 13 11 12
   b <- (nrf91-spim-transfer #55)
   1
  end

  test-i2c : [Device.Mmio] Integer
  test-i2c = act
   a <- nrf91-twim-init 26 27
   b <- nrf91-twim-write-reg #68 #6B 0
   c <- (nrf91-twim-read-reg #68 #75)
   1
  end

  test-ipc : [Device.Mmio] Integer
  test-ipc = act
   a <- nrf91-ipc-init
   b <- nrf91-ipc-send-signal 0
   c <- nrf91-ipc-check-event 0
   d <- nrf91-ipc-clear-event 0
   e <- nrf91-ipc-write-gpmem 0 #DEADBEEF
   f <- (nrf91-ipc-read-gpmem 0)
   1
  end

  test-at-commands : Integer
  test-at-commands =
   let cfun = at-command-text (AtCfun 1)
   in let cops = at-command-text AtCops
   in let cesq = at-command-text AtCesq
   in let cgdcont = at-command-text (AtCgdcont 1 "internet")
   in let ok-cfun = if cfun == "AT+CFUN=1" then 1 else 0
   in let ok-cops = if cops == "AT+COPS?" then 1 else 0
   in let ok-cesq = if cesq == "AT+CESQ" then 1 else 0
   in let ok-cgdcont = if text-length cgdcont > 0 then 1 else 0
   in ok-cfun + ok-cops + ok-cesq + ok-cgdcont

  test-at-parse : Integer
  test-at-parse =
   let ok = at-parse-response "OK"
   in let err = at-parse-response "ERROR"
   in let cops = at-parse-response "+COPS: 0,0,\"Telia\",7"
   in let cesq = at-parse-response "+CESQ: 99,99,255,255,28,47"
   in let cgd = at-parse-response "+CGDCONT: 1,\"IP\",\"internet\""
   in let unk = at-parse-response "RING"
   in let ok-ok = when ok is AtOk -> 1 is otherwise -> 0
   in let ok-err = when err is AtError -> 1 is otherwise -> 0
   in let ok-cops = when cops is AtCopsResponse (mode) (oper) -> if oper == "Telia" then 1 else 0 is otherwise -> 0
   in let ok-cesq = when cesq is AtCesqResponse (rsrq) (rsrp) -> if rsrp == 47 then 1 else 0 is otherwise -> 0
   in let ok-cgd = when cgd is AtCgdcontResponse (cid) (apn) -> if apn == "internet" then 1 else 0 is otherwise -> 0
   in let ok-unk = when unk is AtUnknown (line) -> 1 is otherwise -> 0
   in ok-ok + ok-err + ok-cops + ok-cesq + ok-cgd + ok-unk

  test-delay : Integer
  test-delay =
   let a = nrf91-delay-ms 1
   in 1

  opening : [Device.Mmio] Integer = act
   cl <- test-clock
   g <- test-gpio
   u <- test-uart
   s <- test-spi
   i <- test-i2c
   ip <- (test-ipc)
   cl + g + u + s + i + ip + test-at-commands + test-at-parse + test-delay
  end

