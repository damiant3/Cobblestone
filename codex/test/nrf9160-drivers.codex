Chapter: Nrf9160Drivers

  cites Boards chapter Nrf9160Board

 Smoke test for nRF9160 board drivers. MMIO stubs return 0, so
 this exercises driver logic without real hardware or a live
 cellular network. AT commands are tested as string builders.

Section: Definitions

  test-clock : Integer
  test-clock =
   let hf = nrf91-clock-start-hfclk
   in 1

  test-gpio : Integer
  test-gpio =
   let a = nrf91-gpio-set-output 10
   in let b = nrf91-gpio-set-input 4
   in let c = nrf91-gpio-set-pull 4 1
   in let d = nrf91-gpio-write 10 True
   in let e = nrf91-gpio-read 10
   in let f = nrf91-gpio-toggle 10
   in 1

  test-uart : Integer
  test-uart =
   let a = nrf91-uarte-init nrf91-baud-115200
   in let b = nrf91-uarte-send-byte 65
   in let c = nrf91-uarte-print "hello"
   in let d = nrf91-uarte-println "world"
   in 1

  test-spi : Integer
  test-spi =
   let a = nrf91-spim-init 13 11 12
   in let b = nrf91-spim-transfer #55
   in 1

  test-i2c : Integer
  test-i2c =
   let a = nrf91-twim-init 26 27
   in let b = nrf91-twim-write-reg #68 #6B 0
   in let c = nrf91-twim-read-reg #68 #75
   in 1

  test-ipc : Integer
  test-ipc =
   let a = nrf91-ipc-init
   in let b = nrf91-ipc-send-signal 0
   in let c = nrf91-ipc-check-event 0
   in let d = nrf91-ipc-clear-event 0
   in let e = nrf91-ipc-write-gpmem 0 #DEADBEEF
   in let f = nrf91-ipc-read-gpmem 0
   in 1

  test-at-commands : Integer
  test-at-commands =
   let cfun = at-command-text (AtCfun 1)
   in let cops = at-command-text AtCops
   in let cesq = at-command-text AtCesq
   in let cgdcont = at-command-text (AtCgdcont 1 "internet")
   in let ok-cfun = if cfun == "AT+CFUN=1" then 1 else 0
   in let ok-cops = if cops == "AT+COPS?" then 1 else 0
   in let ok-cesq = if cesq == "AT+CESQ" then 1 else 0
   in let ok-cgdcont = if text-length cgdcont > 0 then 1 else 0
   in ok-cfun + ok-cops + ok-cesq + ok-cgdcont

  test-at-parse : Integer
  test-at-parse =
   let ok = at-parse-response "OK"
   in let err = at-parse-response "ERROR"
   in let cops = at-parse-response "+COPS: 0,0,\"Telia\",7"
   in let cesq = at-parse-response "+CESQ: 99,99,255,255,28,47"
   in let cgd = at-parse-response "+CGDCONT: 1,\"IP\",\"internet\""
   in let unk = at-parse-response "RING"
   in let ok-ok = when ok is AtOk -> 1 is otherwise -> 0
   in let ok-err = when err is AtError -> 1 is otherwise -> 0
   in let ok-cops = when cops is AtCopsResponse (mode) (oper) -> if oper == "Telia" then 1 else 0 is otherwise -> 0
   in let ok-cesq = when cesq is AtCesqResponse (rsrq) (rsrp) -> if rsrp == 47 then 1 else 0 is otherwise -> 0
   in let ok-cgd = when cgd is AtCgdcontResponse (cid) (apn) -> if apn == "internet" then 1 else 0 is otherwise -> 0
   in let ok-unk = when unk is AtUnknown (line) -> 1 is otherwise -> 0
   in ok-ok + ok-err + ok-cops + ok-cesq + ok-cgd + ok-unk

  test-delay : Integer
  test-delay =
   let a = nrf91-delay-ms 1
   in 1

  opening : Integer =
   let cl = test-clock
   in let g = test-gpio
   in let u = test-uart
   in let s = test-spi
   in let i = test-i2c
   in let ip = test-ipc
   in let at = test-at-commands
   in let ap = test-at-parse
   in let d = test-delay
   in cl + g + u + s + i + ip + at + ap + d

