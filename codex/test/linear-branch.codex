Chapter: LinearBranch
  cites Foreword chapter Linear

Section: Definitions

  consume-in-branch : linear Integer, Integer -> Integer
  consume-in-branch (n) (cond) =
    if cond > 0 then freeze n + 10 else freeze n + 20

  consume-in-match : linear Integer, Integer -> Integer
  consume-in-match (n) (tag) =
    when tag
      is 1 -> freeze n * 2
      is 2 -> freeze n * 3
      is otherwise -> freeze n

  pass-linear : linear Integer -> Integer
  pass-linear (n) =
    let result = freeze n
    in result + 1

  opening : Text =
    show (consume-in-branch 5 1) & " " &
    show (consume-in-branch 5 0) & " " &
    show (consume-in-match 10 1) & " " &
    show (consume-in-match 10 2) & " " &
    show (consume-in-match 10 0) & " " &
    show (pass-linear 99)

