Chapter: InductionAssoc

Section: List

  MyList =
   | MyNil
   | MyCons (Integer) (MyList)

  append : MyList, MyList -> MyList
  append (xs) (ys) = when xs
   is MyNil -> ys
   is MyCons (h) (t) -> MyCons h (append t ys)

Section: Proof

  claim append-assoc : for all (as : MyList), for all (bs : MyList), for all (cs : MyList), append (append as bs) cs === append as (append bs cs)
  proof append-assoc =
   induction on as
    is MyNil -> Refl
    is MyCons (h) (t) (ih) -> cong ih
   qed

Section: Main

  opening : [Console] Nothing
  opening = act
   print-line-uni "induction-assoc ok"
  end
