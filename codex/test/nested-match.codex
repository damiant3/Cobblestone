Chapter: Nested Match
  cites Codex chapter Text

Section: Types

  Color =
    | Red
    | Green
    | Blue

  Shape =
    | Circle (Integer)
    | Rect (Integer) (Integer)

  Wrapped =
    | Wrapped (Color) (Shape)

Section: Definitions

  color-name : Color -> Text
  color-name (c) =
   when c
    is Red -> "red"
    is Green -> "green"
    is Blue -> "blue"

  area : Shape -> Integer
  area (s) =
   when s
    is Circle (r) -> r * r * 3
    is Rect (w) (h) -> w * h

  describe : Wrapped -> Text
  describe (w) =
   when w
    is Wrapped (c) (s) ->
     when s
      is Circle (r) ->
       when c
        is Red -> "red circle r=" & integer-to-text r
        is Green -> "green circle r=" & integer-to-text r
        is Blue -> "blue circle r=" & integer-to-text r
      is Rect (w2) (h) ->
       color-name c & " rect " & integer-to-text w2 & "x" & integer-to-text h

  classify-area : Wrapped -> Text
  classify-area (w) =
   when w
    is Wrapped (c) (s) ->
     let a = area s
     in if a > 100 then "large"
        else if a > 20 then "medium"
        else "small"

  opening : [Console] Nothing =
   let w1 = Wrapped Red (Circle 5)
   in let w2 = Wrapped Green (Rect 3 7)
   in let w3 = Wrapped Blue (Rect 12 10)
   in act
    print-line-uni (describe w1)
    print-line-uni (describe w2)
    print-line-uni (describe w3)
    print-line-uni (classify-area w1)
    print-line-uni (classify-area w2)
    print-line-uni (classify-area w3)
   end

