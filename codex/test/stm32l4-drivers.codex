Chapter: Stm32L4Drivers

  cites Boards chapter Stm32L4Board

Section: Definitions

  test-rcc : [Device.Mmio] Integer
  test-rcc = act
   a <- (l4-rcc-set-msi-range 6)
   1
  end

  test-gpio : [Device.Mmio] Integer
  test-gpio = act
   a <- l4-rcc-enable-port l4-rcc-gpioa-en
   b <- l4-gpio-set-output l4-gpioa-base 5
   c <- l4-gpio-set-input l4-gpioa-base 4
   d <- l4-gpio-set-alternate l4-gpioa-base 2 7
   e <- l4-gpio-set-pull l4-gpioa-base 4 1
   f <- l4-gpio-write l4-gpioa-base 5 True
   g <- l4-gpio-read l4-gpioa-base 5
   h <- (l4-gpio-toggle l4-gpioa-base 5)
   1
  end

  test-led : [Device.Mmio] Integer
  test-led = act
   a <- l4-led-init
   b <- l4-led-on
   c <- (l4-led-off)
   1
  end

  test-uart : [Device.Mmio] Integer
  test-uart = act
   a <- l4-uart-init 115200
   b <- l4-uart-send-byte 65
   c <- l4-uart-print "hello"
   d <- (l4-uart-println "world")
   1
  end

  test-spi : [Device.Mmio] Integer
  test-spi = act
   a <- l4-spi-init
   b <- (l4-spi-transfer #AA)
   1
  end

  test-i2c : [Device.Mmio] Integer
  test-i2c = act
   a <- l4-i2c-init
   b <- l4-i2c-write-reg #68 #6B 0
   c <- (l4-i2c-read-reg #68 #75)
   1
  end

  test-pwr : [Device.Mmio] Integer
  test-pwr = act
   a <- l4-pwr-enable
   b <- l4-pwr-set-mode l4-pwr-cr1-lpms-stop2
   c <- (l4-pwr-get-mode)
   1
  end

  test-lptim : [Device.Mmio] Integer
  test-lptim = act
   a <- l4-lptim-init
   b <- l4-lptim-set-autoreload 32767
   c <- l4-lptim-set-compare 16384
   d <- (l4-lptim-start-single)
   1
  end

  test-sleep : [Device.Mmio] Integer
  test-sleep =
   let ok-names = if l4-sleep-mode-name SleepStop0 == "Stop0" then 1 else 0
   in let ok-stop2 = if l4-sleep-mode-name SleepStop2 == "Stop2" then 1 else 0
   in let ok-standby = if l4-sleep-mode-name SleepStandby == "Standby" then 1 else 0
   in let ok-shutdown = if l4-sleep-mode-name SleepShutdown == "Shutdown" then 1 else 0
   in act
    prep <- l4-sleep-prepare SleepStop2 32767
    restore <- (l4-sleep-restore)
    ok-names + ok-stop2 + ok-standby + ok-shutdown
   end

  test-uart-linear : [Uart, Device.Mmio] Integer
  test-uart-linear = act
   brd0 <- board-open l4-pwr-base l4-scb-base
   o <- l4-uart-open brd0 115200
   when o
    is (brd1, p0) -> act
      p1 <- l4-uart-write p0 72
      p2 <- (l4-uart-write p1 73)
      c <- (l4-uart-close p2)
      bc <- (board-close brd1)
      1
    end
  end

  test-gpio-linear : [Gpio, Device.Mmio] Integer
  test-gpio-linear = act
   en <- l4-rcc-enable-port l4-rcc-gpioa-en
   brd0 <- board-open l4-pwr-base l4-scb-base
   o <- l4-gpio-open brd0 l4-gpioa-base 5 PinOutput
   when o
    is (brd1, q0) -> act
      q1 <- l4-pin-write q0 True
      q2 <- (l4-pin-write q1 False)
      c <- (l4-pin-close q2)
      bc <- (board-close brd1)
      1
    end
  end

  test-delay : Integer
  test-delay =
   let a = l4-delay-ms 1
   in 1

  test-pin-read : [Gpio, Device.Mmio] Integer
  test-pin-read = act
   brd0 <- board-open l4-pwr-base l4-scb-base
   o <- l4-gpio-open brd0 l4-gpioa-base 5 PinInput
   when o
    is (brd1, q0) -> act
      r <- l4-pin-read q0
      when r
       is (q1, lv) -> act
         c <- (l4-pin-close q1)
         bc <- (board-close brd1)
         1
       end
    end
  end

  test-spi-txn : [Spi, Device.Mmio] Integer
  test-spi-txn = act
   brd0 <- board-open l4-pwr-base l4-scb-base
   o <- l4-spi-open brd0
   when o
    is (brd1, s0) -> act
      t0 <- l4-spi-select s0 4
      r <- l4-spi-txn-transfer t0 [#AA, #55]
      when r
       is (t1, got) -> act
         s1 <- l4-spi-deselect t1
         c <- (l4-spi-close s1)
         bc <- (board-close brd1)
         if list-length got == 2 then 1 else 0
       end
    end
  end

  test-uart-recv : [Uart, Device.Mmio] Integer
  test-uart-recv = act
   brd0 <- board-open l4-pwr-base l4-scb-base
   o <- l4-uart-open brd0 115200
   when o
    is (brd1, p0) -> act
      r <- l4-uart-recv p0 1
      when r
       is (p1, bytes) -> act
         c <- (l4-uart-close p1)
         bc <- (board-close brd1)
         if list-length bytes == 1 then 1 else 0
       end
    end
  end

  test-i2c-bus : [I2c, Device.Mmio] Integer
  test-i2c-bus = act
   brd0 <- board-open l4-pwr-base l4-scb-base
   o <- l4-i2c-open brd0
   when o
    is (brd1, b0) -> act
      w <- l4-i2c-bus-write-reg b0 #68 #6B 0
      when w
       is (b1, wr) -> act
         r <- l4-i2c-bus-read-reg b1 #68 #75
         when r
          is (b2, rv) -> act
            c <- (l4-i2c-close b2)
            bc <- (board-close brd1)
            1
          end
       end
    end
  end

  test-adc : [Device.Mmio] Integer
  test-adc = act
   a <- l4-adc1-init
   b <- (l4-adc-read 0)
   1
  end

  test-adc-unit : [Adc, Device.Mmio] Integer
  test-adc-unit = act
   brd0 <- board-open l4-pwr-base l4-scb-base
   o <- l4-adc-open brd0
   when o
    is (brd1, a0) -> act
      r <- l4-adc-unit-sample a0 0
      when r
       is (a1, v) -> act
         c <- (l4-adc-close a1)
         bc <- (board-close brd1)
         1
       end
    end
  end

  opening : [Gpio, Uart, Spi, I2c, Adc, Device.Mmio] Integer =
   let d = test-delay
   in act
    r <- test-rcc
    g <- test-gpio
    l <- test-led
    u <- test-uart
    s <- test-spi
    i <- test-i2c
    p <- test-pwr
    t <- test-lptim
    sl <- test-sleep
    ul <- test-uart-linear
    gl <- test-gpio-linear
    pr <- test-pin-read
    ib <- test-i2c-bus
    ur <- test-uart-recv
    st <- test-spi-txn
    ad <- test-adc
    au <- test-adc-unit
    r + g + l + u + s + i + p + t + sl + ul + gl + pr + ib + ur + st + ad + au + d
   end

