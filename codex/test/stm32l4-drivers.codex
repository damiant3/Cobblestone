Chapter: Stm32L4Drivers

  cites Boards chapter Stm32L4Board

 Smoke test for STM32L4 board drivers. MMIO stubs return 0.
 Exercises GPIO, UART, SPI, I2C, RCC clock config, PWR mode
 registers, and LPTIM configuration.

Section: Definitions

  test-rcc : Integer
  test-rcc =
   let a = l4-rcc-set-msi-range 6
   in 1

  test-gpio : Integer
  test-gpio =
   let a = l4-rcc-enable-port l4-rcc-gpioa-en
   in let b = l4-gpio-set-output l4-gpioa-base 5
   in let c = l4-gpio-set-input l4-gpioa-base 4
   in let d = l4-gpio-set-alternate l4-gpioa-base 2 7
   in let e = l4-gpio-set-pull l4-gpioa-base 4 1
   in let f = l4-gpio-write l4-gpioa-base 5 True
   in let g = l4-gpio-read l4-gpioa-base 5
   in let h = l4-gpio-toggle l4-gpioa-base 5
   in 1

  test-led : Integer
  test-led =
   let a = l4-led-init
   in let b = l4-led-on
   in let c = l4-led-off
   in 1

  test-uart : Integer
  test-uart =
   let a = l4-uart-init 115200
   in let b = l4-uart-send-byte 65
   in let c = l4-uart-print "hello"
   in let d = l4-uart-println "world"
   in 1

  test-spi : Integer
  test-spi =
   let a = l4-spi-init
   in let b = l4-spi-transfer #AA
   in 1

  test-i2c : Integer
  test-i2c =
   let a = l4-i2c-init
   in let b = l4-i2c-write-reg #68 #6B 0
   in let c = l4-i2c-read-reg #68 #75
   in 1

  test-pwr : Integer
  test-pwr =
   let a = l4-pwr-enable
   in let b = l4-pwr-set-mode l4-pwr-cr1-lpms-stop2
   in let c = l4-pwr-get-mode
   in 1

  test-lptim : Integer
  test-lptim =
   let a = l4-lptim-init
   in let b = l4-lptim-set-autoreload 32767
   in let c = l4-lptim-set-compare 16384
   in let d = l4-lptim-start-single
   in 1

  test-sleep : Integer
  test-sleep =
   let prep = l4-sleep-prepare SleepStop2 32767
   in let restore = l4-sleep-restore
   in let ok-names = if l4-sleep-mode-name SleepStop0 == "Stop0" then 1 else 0
   in let ok-stop2 = if l4-sleep-mode-name SleepStop2 == "Stop2" then 1 else 0
   in let ok-standby = if l4-sleep-mode-name SleepStandby == "Standby" then 1 else 0
   in let ok-shutdown = if l4-sleep-mode-name SleepShutdown == "Shutdown" then 1 else 0
   in ok-names + ok-stop2 + ok-standby + ok-shutdown

  test-delay : Integer
  test-delay =
   let a = l4-delay-ms 1
   in 1

  opening : Integer =
   let r = test-rcc
   in let g = test-gpio
   in let l = test-led
   in let u = test-uart
   in let s = test-spi
   in let i = test-i2c
   in let p = test-pwr
   in let t = test-lptim
   in let sl = test-sleep
   in let d = test-delay
   in r + g + l + u + s + i + p + t + sl + d

