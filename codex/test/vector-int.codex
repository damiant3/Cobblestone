Chapter: VectorInt
  cites Foreword chapter Console

Section: Entry
  opening : [Console] Nothing
  opening = act
    let a = vec-splat 10
    in let b = vec-splat 3
    in let sum = a + b
    in let diff = a - b
    in act
      print-line-uni ("add: " & show (vec-extract sum 0))
      print-line-uni ("sub: " & show (vec-extract diff 0))
      print-line-uni ("add1: " & show (vec-extract sum 1))
      print-line-uni ("sub1: " & show (vec-extract diff 1))
    end
  end
