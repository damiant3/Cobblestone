Chapter: UsbMscTest
  cites Kernel chapter Usb
  cites Kernel chapter Xhci
  cites Kernel chapter UsbMassStorage
  cites Foreword chapter Maybe

Section: Body

  test-cbw-encode : Text =
    let cbw = msc-build-inquiry 1
    in let bytes = msc-encode-cbw cbw
    in "cbw: len=" & show (list-length bytes) & " tag=1 xfer=36"

  test-csw-parse : Text =
    let bytes = [85, 83, 66, 83, 2, 0, 0, 0, 0, 0, 0, 0, 0]
    in let csw = msc-parse-csw bytes
    in "csw: tag=" & show (csw.csw-tag) & " residue=" & show (csw.csw-data-residue) & " status=" & show (csw.csw-status)

  test-csw-ok : Text =
    let bytes = [85, 83, 66, 83, 3, 0, 0, 0, 0, 0, 0, 0, 0]
    in let csw = msc-parse-csw bytes
    in "csw-ok=" & (if msc-csw-ok csw then "True" else "False")

  test-read-capacity-parse : Text =
    let bytes = [0, 0, 127, 255, 0, 0, 2, 0]
    in let cap = msc-parse-read-capacity bytes
    in "cap: last-lba=" & show (cap.cap-last-lba) & " block-size=" & show (cap.cap-block-size) & " total=" & show (cap.cap-total-sectors)

  test-inquiry-parse : Text =
    let bytes = [0, 128, 2, 2, 31, 0, 0, 0,
      75, 105, 110, 103, 115, 116, 111, 110,
      68, 97, 116, 97, 84, 114, 97, 118,
      101, 108, 101, 114, 32, 51, 46, 48,
      49, 46, 48, 48]
    in let inq = msc-parse-inquiry bytes
    in "inq: type=" & show (inq.inq-device-type) & " removable=" & (if inq.inq-removable then "yes" else "no") & " vlen=" & show (text-length (inq.inq-vendor)) & " plen=" & show (text-length (inq.inq-product))

  test-read-10-build : Text =
    let cbw = msc-build-read-10 5 256 1
    in "read10: tag=" & show (cbw.cbw-tag) & " xfer=" & show (cbw.cbw-transfer-length) & " lun=" & show (cbw.cbw-lun)

  test-write-10-build : Text =
    let cbw = msc-build-write-10 6 512 2
    in "write10: tag=" & show (cbw.cbw-tag) & " xfer=" & show (cbw.cbw-transfer-length) & " dir=" & show (cbw.cbw-flags)

  test-msc-not-found : Text =
    let dev = msc-not-found
    in format-msc-device dev

  test-msc-detect-wrong-class : Text =
    let iface = UsbInterface { if-number = 0, if-alt-setting = 0, if-class = 3, if-subclass = 0, if-protocol = 0, if-num-endpoints = 2 }
    in let result = msc-detect iface [] 1
    in when result
      is Just (d) -> "found"
      is None -> "none (correct)"

  test-format-csw : Text =
    let csw = MscCsw { csw-tag = 42, csw-data-residue = 0, csw-status = 0 }
    in format-msc-csw csw

  opening : [Console] Nothing = act
    print-line-uni test-cbw-encode
    print-line-uni test-csw-parse
    print-line-uni test-csw-ok
    print-line-uni test-read-capacity-parse
    print-line-uni test-inquiry-parse
    print-line-uni test-read-10-build
    print-line-uni test-write-10-build
    print-line-uni test-msc-not-found
    print-line-uni test-msc-detect-wrong-class
    print-line-uni test-format-csw
  end

