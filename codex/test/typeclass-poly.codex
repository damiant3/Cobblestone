Chapter: TypeClassPoly

class Converter where
  convert : a, b -> b

instance Converter Integer where
  convert (x) (y) = y

class Equatable a => Sortable where
  sort-key : a -> Integer

instance Sortable Integer where
  sort-key (x) = x

Section: Helpers

  test-convert : Text
  test-convert = show (convert 1 42)

  test-sort-key : Text
  test-sort-key = show (sort-key 5)

Section: Body

  opening : [Console] Nothing = act
    print-line-uni test-convert
    print-line-uni test-sort-key
  end
