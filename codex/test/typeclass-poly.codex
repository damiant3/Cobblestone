Chapter: TypeClassPoly

class Equatable where
  equals : a, a -> Boolean

instance Equatable Integer where
  equals (x) (y) = x == y

class Converter where
  convert : a, b -> b

instance Converter Integer where
  convert (x) (y) = y

class Equatable a => Sortable where
  sort-key : a -> Integer

instance Sortable Integer where
  sort-key (x) = x

Section: Helpers

  test-convert : Text
  test-convert = show (convert 1 42)

  test-sort-key : Text
  test-sort-key = show (sort-key 5)

  test-super : Text
  test-super =
   let d = Sortable-dict-Integer
   in let eq = d.__super-Equatable
   in show ((eq.equals-impl) 7 7)

Section: Body

  opening : [Console] Nothing = act
    print-line-uni test-convert
    print-line-uni test-sort-key
    print-line-uni test-super
  end
