Chapter: WaitersMixed
  cites Foreword chapter Console

Section: Body

  mixed : Integer -> Integer
  mixed (n) =
    let t = fork (\x -> n)
    in let a = fork (\x -> await t)
    in let b = fork (\x -> await-any [t])
    in let c = fork (\x -> await t)
    in await a + await b + await c

  mixed-loop : Integer, Integer -> Integer
  mixed-loop (i) (acc) =
    if i <= 0 then acc
    else mixed-loop (i - 1) (acc + mixed i)

  opening : [Console] Nothing = act
    print-line-uni ("mixed: " & show (mixed 7))
    print-line-uni ("loop: " & show (mixed-loop 300 0))
  end