Chapter: TupleSyntax
  cites Foreword chapter Console
  cites Foreword chapter Tuple

Section: Helpers

  swap : Tup2 Integer Integer -> Tup2 Integer Integer
  swap (p) = when p
    is (x, y) -> (y, x)

  sum-pair : Tup2 Integer Integer -> Integer
  sum-pair (p) = when p
    is (x, y) -> x + y

  fst3 : Tup3 Integer Integer Integer -> Integer
  fst3 (t) = when t
    is (a, b, c) -> a

  nested-sum : Tup2 (Tup2 Integer Integer) Integer -> Integer
  nested-sum (outer) = when outer
    is (inner, z) -> sum-pair inner + z

Section: Body

  opening : [Console] Nothing = act
    let p = (10, 20)
    in act
      print-line-uni (show (sum-pair p))
      let (a, b) = swap p
      in act
        print-line-uni (show a & " " & show b)
      end
    end
    print-line-uni (show (fst3 (1, 2, 3)))
    let q = ((3, 4), 5)
    in print-line-uni (show (nested-sum q))
    print-line-uni (show (sum-pair (100, 200)))
  end

