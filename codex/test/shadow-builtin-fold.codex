Chapter: ShadowBuiltinFold

Section: Entry

  text-length : Text -> Integer
  text-length (s) = 99

  abs : Integer -> Integer
  abs (n) = 77

  opening : [Console] Nothing
  opening = act
    print-line-uni ("lit " & show (text-length "abc"))
    print-line-uni ("var " & show (text-length (substring "abcde" 0 3)))
    print-line-uni ("abs " & show (abs (0 - 5)))
  end
