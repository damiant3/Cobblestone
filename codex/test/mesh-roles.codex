Chapter: MeshRolesTest
  cites Net chapter MeshRoles

Section: Entry
  mrt-node : Text, NodeRole, Integer -> RoleAssignment
  mrt-node (id) (role) (load) = __record-set (role-assignment-new id role) "ra-current-load" load

  opening : [Console] Nothing = act
    print-line-uni ("tiers " & show (nr-tier RCache) & " " & show (nr-tier ROrchestrator) & " " & show (nr-tier (RCustom "x")) & " " & nr-label (RCustom "relay"))
    print-line-uni ("empty edge: " & scale-action-label (evaluate-tier-scaling tier-edge [] 0))
    print-line-uni ("empty cache: " & scale-action-label (evaluate-tier-scaling tier-cache [] 0))
    hot <- [mrt-node "a" RService 90, mrt-node "b" RService 81]
    print-line-uni ("hot service: " & scale-action-label (evaluate-tier-scaling tier-service hot 2))
    cold <- [mrt-node "n1" RService 5, mrt-node "n2" RService 20, mrt-node "n3" RService 11]
    print-line-uni ("cold service: " & scale-action-label (evaluate-tier-scaling tier-service cold 3))
    drained <- [ra-start-drain (mrt-node "n1" RService 5), mrt-node "n2" RService 20, mrt-node "n3" RService 11]
    print-line-uni ("cold, n1 draining: " & scale-action-label (evaluate-tier-scaling tier-service drained 3))
    single <- [mrt-node "only" RService 5]
    print-line-uni ("cold at min: " & scale-action-label (evaluate-tier-scaling tier-service single 1))
    busy <- __record-set (ra-start-drain (mrt-node "c" RCache 0)) "ra-active-connections" 3
    print-line-uni ("drained " & show (ra-is-drained (ra-start-drain (mrt-node "d" RCache 0))) & " " & show (ra-is-drained busy) & " " & show (ra-is-drained (mrt-node "e" RCache 0)))
    o1 <- orch-add-assignment orchestrator-new (mrt-node "w1" RService 90)
    o2 <- orch-add-assignment o1 (ra-add-role (mrt-node "w2" RService 4) RWorker)
    o3 <- orch-add-assignment o2 (mrt-node "w3" RData 50)
    print-line-uni ("orch over " & show (orch-overloaded-count o3) & " idle " & show (orch-idle-count o3) & " workers " & show (list-length (orch-nodes-by-role o3 RWorker)))
    v1 <- orch-add-vm o3 (mvm-set-ready (managed-vm-new "vm1" RService "Service" 10) "w1" "10.0.0.1" 20)
    v2 <- orch-add-vm v1 (managed-vm-new "vm2" RData "Data" 30)
    print-line-uni ("ready vms " & show (orch-ready-vm-count v2))
  end
