Chapter: RaceFirst
  cites Foreword chapter Console

Section: Helpers

  make-thunk : Integer, Nothing -> Integer
  make-thunk (n) (x) = n * 2

  pushed-thunks : Integer, Integer, List (Nothing -> Integer) -> List (Nothing -> Integer)
  pushed-thunks (i) (n) (acc) =
    if i >= n then acc
    else pushed-thunks (i + 1) n (list-push acc (make-thunk i))

  race-loop : Integer, Integer -> Integer
  race-loop (i) (acc) =
    if i <= 0 then acc
    else let v = race [\x -> i, \x -> i + 1, \x -> i + 2]
    in race-loop (i - 1) (acc + v)

  fork-loop : Integer, Integer -> Integer
  fork-loop (i) (acc) =
    if i <= 0 then acc
    else let t = fork (\x -> i * 10)
    in let v = await t
    in fork-loop (i - 1) (acc + v)

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("one: " & show (race [\x -> 5]))
    print-line-uni ("three: " & show (race [\x -> 1, \x -> 2, \x -> 3]))
    print-line-uni ("capture: " & show (race [make-thunk 10, make-thunk 11]))
    print-line-uni ("pushed: " & show (race (pushed-thunks 0 20 [])))
    print-line-uni ("reclaim: " & show (race-loop 1000 0))
    print-line-uni ("after: " & show (fork-loop 100 0))
  end

