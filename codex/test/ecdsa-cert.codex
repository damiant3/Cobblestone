  opening : [Console] Nothing = act
    print-line-uni ("leaf parsed = " & parsed leaf & ", key = " & key-kind leaf & ", can-verify = " & usable leaf)
    print-line-uni ("inter parsed = " & parsed inter & ", key = " & key-kind inter & ", can-verify = " & usable inter)
    print-line-uni ("root parsed = " & parsed root & ", key = " & key-kind root & ", can-verify = " & usable root)
    print-line-uni ("leaf signed by inter = " & signed-by leaf inter)
    print-line-uni ("leaf signed by root = " & signed-by leaf root)
    print-line-uni ("leaf signed by leaf = " & signed-by leaf leaf)
    print-line-uni ("inter signed by root = " & signed-by inter root)
    print-line-uni ("tampered tbs signed by inter = " & signed-by leaf-bad-tbs inter)
    print-line-uni ("tampered s signed by inter = " & signed-by leaf-bad-sig inter)
    print-line-uni ("sha-256 arm on the genuine pair = " & forced leaf inter SigEcdsaSha256)
    print-line-uni ("sha-384 arm on the genuine pair = " & forced leaf inter SigEcdsaSha384)
    print-line-uni ("genuine der signature = " & rs-desc ec-rs-good)
    print-line-uni ("one trailing byte = " & rs-desc ec-rs-trailing)
    print-line-uni ("single-byte r and s = " & rs-desc ec-rs-short)
    print-line-uni ("short r lands at 31 = " & rs-at ec-rs-short 31)
    print-line-uni ("short s lands at 63 = " & rs-at ec-rs-short 63)
