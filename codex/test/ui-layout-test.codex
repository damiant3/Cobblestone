Chapter: UiLayoutTest
  cites Codex chapter General
  cites UI chapter Theme
  cites UI chapter BoxModel
  cites UI chapter Layout
  cites UI chapter Widget

Section: Body

  test-row-fixed : Text =
    let container = layout-rect 0 0 300 40
    in let items = [layout-item 100 20 0, layout-item 80 20 0, layout-item 60 20 0]
    in let result = flex-layout container DirRow 10 items 3
    in let r0 = list-at (result.lrs) 0
    in let r1 = list-at (result.lrs) 1
    in let r2 = list-at (result.lrs) 2
    in "r0=" & format-rect r0 & " r1=" & format-rect r1 & " r2=" & format-rect r2

  test-col-fixed : Text =
    let container = layout-rect 0 0 100 300
    in let items = [layout-item 40 80 0, layout-item 40 60 0]
    in let result = flex-layout container DirColumn 10 items 2
    in let r0 = list-at (result.lrs) 0
    in let r1 = list-at (result.lrs) 1
    in "r0=" & format-rect r0 & " r1=" & format-rect r1

  test-row-flex : Text =
    let container = layout-rect 0 0 300 40
    in let items = [layout-item 0 20 1, layout-item 0 20 2]
    in let result = flex-layout container DirRow 0 items 2
    in let r0 = list-at (result.lrs) 0
    in let r1 = list-at (result.lrs) 1
    in "r0=" & format-rect r0 & " r1=" & format-rect r1

  test-col-flex : Text =
    let container = layout-rect 10 10 200 120
    in let items = [layout-item 0 0 1, layout-item 0 0 1, layout-item 0 0 1]
    in let result = flex-layout container DirColumn 0 items 3
    in let r0 = list-at (result.lrs) 0
    in let r1 = list-at (result.lrs) 1
    in let r2 = list-at (result.lrs) 2
    in "r0=" & format-rect r0 & " r1=" & format-rect r1 & " r2=" & format-rect r2

  test-widget-tree : Text =
    let btn1 = widget-button "b1" "OK"
    in let btn2 = widget-button "b2" "Cancel"
    in let panel = widget-panel "root" DirRow 8 [btn1, btn2]
    in format-widget panel

  test-widget-find : Text =
    let lbl = widget-label "title" "Hello"
    in let btn = widget-button "action" "Click"
    in let panel = widget-panel "root" DirColumn 4 [lbl, btn]
    in let found = widget-find panel "action"
    in when found
      is Just (w) -> "found=" & w.wn-id & " kind=" & widget-kind-name (w.wn-kind)
      is None -> "not-found"

  test-widget-state : Text =
    let btn = widget-button "b" "Test"
    in let hovered = widget-set-state btn state-hover
    in "state=" & show (hovered.wn-state)

  test-widget-kind : Text =
    let g = widget-gauge "g1" 75 100
    in widget-kind-name (g.wn-kind)

  opening : [Console] Nothing = act
    print-line-uni test-row-fixed
    print-line-uni test-col-fixed
    print-line-uni test-row-flex
    print-line-uni test-col-flex
    print-line-uni test-widget-tree
    print-line-uni test-widget-find
    print-line-uni test-widget-state
    print-line-uni test-widget-kind
  end

