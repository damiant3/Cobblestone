Chapter: SessionTyped
  cites Foreword chapter Console

Section: Body

  ping : SChan (SSend Integer (SRecv Integer SEnd)) -> [Concurrent] SChan (SRecv Integer SEnd)
  ping (c) = act
    c1 <- s-send c 9
    c1
  end

  twice : Task Integer -> Integer
  twice (t) = 2 * await t

  opening : [Console, Concurrent] Nothing = act
    c0 <- s-new
    c1 <- ping c0
    v <- s-recv-value c1
    c2 <- s-recv c1
    closed <- s-close c2
    print-line-uni ("received: " & show v & " closed: " & show closed & " task: " & show (twice (fork (\u -> 21))))
  end

