Chapter: CodexTextRoundtrip
  cites Codex chapter Opening
  cites Emit chapter Codex Emitter (codex-emit-text-chapter)

  probe-source : Text = "Chapter: TextProbe\n  Shape =\n    | Dot\n    | Box (Integer)\n    | Pair (Integer) (Integer)\n\n  area : Shape -> Integer\n  area (s) =\n    when s\n     is Dot -> 0\n     is Box (w) -> w * w\n     is Pair (a) (b) -> a * b\n\n  pick : Integer, Boolean -> Integer\n  pick (n) (b) =\n    let m = n + 1\n    in if b then m else 0 - m\n\n  opening : Integer\n  opening = area (Pair 3 4) + pick (area (Box 2)) (2 > 1)\n"

  emit-text : Text, Text -> Text
  emit-text (src) (name) =
    let fe = compile-frontend src name compile-flags-default
    in if bag-has-errors (fe.bag) then "FAIL diagnostics"
    else compile-text fe CtCodexText

  opening : [Console] Nothing =
    let init = init-phase-allocator
    in let first = emit-text probe-source "TextProbe"
    in let second = emit-text first "TextProbe"
    in act
      print-line-uni first
      print-line-uni ("bytes " & integer-to-text (text-length first))
      print-line-uni ("round trip " & (if first == second then "identical" else "differs"))
    end
