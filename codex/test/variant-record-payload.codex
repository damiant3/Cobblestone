Chapter: VariantRecordPayload
  cites Foreword chapter Maybe

Section: Types

  Rec1 = record {
    x : Integer,
    y : Integer
  }

  Rec2 = record {
    a : Text,
    b : Integer
  }

  Rec3 = record {
    p : Integer,
    q : Text,
    r : Integer
  }

  V =
    | VarA (Rec1)
    | VarB (Rec2)
    | VarC (Rec3)

Section: Match

  extract-int : V -> Integer
  extract-int (v) =
    when v
      is VarA (r) -> r.x
      is VarB (r) -> r.b
      is VarC (r) -> r.p

  opening : [Console] Nothing = act
    let v1 = VarA (Rec1 { x = 42, y = 7 })
    in let v2 = VarB (Rec2 { a = "hello", b = 99 })
    in let v3 = VarC (Rec3 { p = 1, q = "world", r = 3 })
    in act
      print-line-uni (show (extract-int v1))
      print-line-uni (show (extract-int v2))
      print-line-uni (show (extract-int v3))
    end
  end
