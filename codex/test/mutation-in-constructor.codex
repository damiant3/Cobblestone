Chapter: MutationInConstructor

Section: Definitions

  mutable Pair = record {
   a : Integer,
   b : Integer
  }

  remake : Pair -> Pair
  remake (p) = Pair { a = (__record-set p "a" 5).a, b = p.a }

Section: Main

  pair-sum : Pair -> Integer
  pair-sum (q) = q.a + q.b

  opening : [Console] Nothing
  opening = act
   print-line-uni (show (pair-sum (remake (Pair { a = 1, b = 2 }))))
  end

