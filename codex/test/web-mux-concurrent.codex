 We say:

Section: Wire Fixtures
  srv-mac : List Integer = [82, 84, 0, 18, 52, 86]
  cli-mac : List Integer = [82, 85, 10, 0, 2, 2]
  srv-ip : List Integer = [10, 0, 2, 15]
  a-ip : List Integer = [10, 0, 2, 100]
  b-ip : List Integer = [10, 0, 2, 101]

  get-bytes : List Integer = [71, 69, 84, 32, 47, 32, 72, 84, 84, 80, 47, 49, 46, 48, 13, 10, 13, 10]

  mk-frame : Integer, List Integer, Integer, Integer, Integer, List Integer -> List Integer
  mk-frame (src-port) (src-ip) (seq) (ack) (flags) (payload) =
    let seg = tcp-build-segment src-port 80 seq ack flags 8192 payload
    in let ip = ip-build-packet src-ip srv-ip ip-proto-tcp seg
    in eth-build-frame srv-mac cli-mac eth-type-ipv4 ip

  a-syn : List Integer = mk-frame 50000 a-ip 1000 0 tcp-flag-syn []
  a-ack : List Integer = mk-frame 50000 a-ip 1001 5000 tcp-flag-ack []
  a-get : List Integer = mk-frame 50000 a-ip 1001 5000 (bit-or tcp-flag-psh tcp-flag-ack) get-bytes

  b-syn : List Integer = mk-frame 50001 b-ip 2000 0 tcp-flag-syn []
  b-ack : List Integer = mk-frame 50001 b-ip 2001 6000 tcp-flag-ack []
  b-get : List Integer = mk-frame 50001 b-ip 2001 6000 (bit-or tcp-flag-psh tcp-flag-ack) get-bytes

Section: Route
  test-route : HttpRequest -> HttpResponse
  test-route (req) = http-json "{\"ok\":true}"

Section: Observation
  conn-count : WebMux, Integer -> Integer
  conn-count (m) (i) =
    if i >= list-length (m.conns) then -1
    else let c = list-at (m.conns) i
    in (c.server).request-count

Section: Entry
  opening : [Console, Network.Read, Network.Write] Nothing = act
    let m0 = WebMux { listen = net-io-listen (fresh-listen-transport 80), conns = [], served = 0 }
    in act
      m1 <- web-mux-feed test-route m0 a-syn 80
      m2 <- web-mux-feed test-route m1 b-syn 80
      m3 <- web-mux-feed test-route m2 a-ack 80
      m4 <- web-mux-feed test-route m3 b-ack 80
      m5 <- web-mux-feed test-route m4 a-get 80
      m6 <- web-mux-feed test-route m5 b-get 80
      print-line-uni ("conns=" & show (list-length (m6.conns)))
      print-line-uni ("served=" & show (m6.served))
      print-line-uni ("A=" & show (conn-count m6 0))
      print-line-uni ("B=" & show (conn-count m6 1))
    end
  end
