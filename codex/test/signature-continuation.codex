Chapter: SignatureContinuation

Section: Entry

  add3 : Integer,
    Integer,
    Integer -> Integer
  add3 (a) (b) (c) = a + b + c

  scale : Integer, Integer ->
    Integer
  scale (k) (x) = k * x

  apply-twice : (Integer -> Integer),
      Integer ->
    Integer
  apply-twice (f) (x) = f (f x)

  flat : Integer, Integer -> Integer
  flat (a) (b) = a - b

  opening : [Console] Nothing
  opening = act
    print-line-uni (show (add3 1 2 3))
    print-line-uni (show (scale 4 5))
    print-line-uni (show (apply-twice (\n -> n * 3) 2))
    print-line-uni (show (flat 9 4))
  end
