Chapter: Factorial
  cites Foreword chapter Console
  cites Codex chapter General

 Combined basics test. Tests: literal return, arithmetic, if/else,
 function call, simple recursion, factorial, fibonacci, text concat,
 sum types (wrap/unwrap), pattern match, records, field access,
 number literals, and function-returning-sum.

Section: Arithmetic and Control Flow

  square : Integer -> Integer
  square (x) = x * x

  double : Integer -> Integer
  double (x) = x + x

  add1 : Integer -> Integer
  add1 (x) = x + 1

  countdown : Integer -> Integer
  countdown (n) = if n == 0 then 0 else countdown (n - 1)

  fact : Integer -> Integer
  fact (n) = if n == 0 then 1 else n * fact (n - 1)

  fib : Integer -> Integer
  fib (n) = if n == 0 then 0 else if n == 1 then 1 else fib (n - 1) + fib (n - 2)

Section: Text

  greeting : Text -> Text
  greeting (name) = "Hello, " & name & "!"

Section: Sum Types

  Box (a) =
    | Wrap (a)

  unwrap (b) = when b is Wrap (x) -> x

  Shape =
    | Circle (Number)
    | Rectangle (Number) (Number)

  area (s) = when s is Circle (r) -> 3.14 * r * r is Rectangle (w) (h) -> w * h

  Result (a) =
    | Success (a)
    | Failure (Text)

  safe-divide (x) (y) = if y == 0 then Failure "division by zero" else Success (x / y)

  describe (result) = when result is Success (n) -> "got " & show n is Failure (msg) -> "error: " & msg

Section: Records

  Person = record {
    name : Text,
    age : Integer
  }

  greet : Person -> Text
  greet (p) = "Hello, " & p.name & "!"

  Box2 = record { val : Integer }
  mk = Box2 { val = 7 }
  ignore-second (x) (y) = x

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("literal: " & show 42)
    print-line-uni ("mul: " & show (3 * 4))
    print-line-uni ("if: " & show (if 1 == 1 then 77 else 88))
    print-line-uni ("call: " & show (add1 9))
    print-line-uni ("rec: " & show (countdown 5))
    print-line-uni ("square: " & show (square 5))
    print-line-uni ("fact1: " & show (fact 1))
    print-line-uni ("fact2: " & show (fact 2))
    print-line-uni ("fact3: " & show (fact 3))
    print-line-uni ("fact5: " & show (fact 5))
    print-line-uni ("fact10: " & show (fact 10))
    print-line-uni ("fib20: " & show (fib 20))
    print-line-uni ("greeting: " & greeting "World")
    print-line-uni ("wrap: " & when (Wrap 7) is Wrap (x) -> "Wrap " & show x)
    print-line-uni ("unwrap: " & show (unwrap (Wrap 7)))
    print-line-uni ("area: " & show (area (Circle 5.0)))
    print-line-uni ("person: " & greet (Person { name = "Alice", age = 30 }))
    print-line-uni ("number: " & if 3.14 == 3.14 then if 1.5 == 2.5 then "FAIL" else "PASS" else "FAIL")
    print-line-uni ("safe-divide: " & describe (safe-divide 42 7))
    print-line-uni ("paren-field: " & show (ignore-second 99 (mk).val))
  end

