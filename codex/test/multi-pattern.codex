Chapter: Multi Pattern

Section: Types

  Color =
    | Red
    | Green
    | Blue
    | Yellow
    | Orange

Section: Definitions

  is-warm : Color -> Text
  is-warm (c) =
   when c
    is Red | Orange | Yellow -> "warm"
    is Blue | Green -> "cool"

  classify : Integer -> Text
  classify (n) =
   when n
    is 1 | 2 | 3 -> "small"
    is 4 | 5 -> "medium"
    is otherwise -> "large"

  opening : [Console] Nothing = act
   print-line-uni (is-warm Red)
   print-line-uni (is-warm Blue)
   print-line-uni (is-warm Yellow)
   print-line-uni (is-warm Orange)
   print-line-uni (is-warm Green)
   print-line-uni (classify 1)
   print-line-uni (classify 3)
   print-line-uni (classify 4)
   print-line-uni (classify 9)
  end

