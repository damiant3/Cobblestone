Chapter: NetIoPeerFin
  cites Net chapter NetIO
  cites Net chapter TcpTransport
  cites Net chapter NetworkStack
  cites Net chapter Tcp
  cites Net chapter Ethernet
  cites Foreword chapter Console

 A framed receive on a connection whose peer has sent its FIN is at end of
 stream. The connection is taken to CLOSE_WAIT without the wire, by the
 FIN frame itself, and nothing is pending. A loop that waits for TcpClosed
 alone polls the NIC until its fifty-million-poll fuel runs out, which is
 past the runner's wall budget, so its later lines never print.

 We say:

Section: Wire Fixtures
  srv-mac : List Integer = [82, 84, 0, 18, 52, 86]
  cli-mac : List Integer = [82, 85, 10, 0, 2, 2]
  srv-ip : List Integer = [10, 0, 2, 15]
  cli-ip : List Integer = [10, 0, 2, 100]
  gw-ip : List Integer = [10, 0, 2, 2]

  get-bytes : List Integer = [71, 69, 84, 32, 47, 32, 72, 84, 84, 80, 47, 49, 46, 49, 13, 10, 13, 10]

  psh : Integer = bit-or tcp-flag-psh tcp-flag-ack
  fin-ack : Integer = bit-or tcp-flag-fin tcp-flag-ack

  mkc : Integer, Integer, Integer, List Integer -> List Integer
  mkc (seq) (ack) (flags) (payload) =
    let seg = tcp-with-checksum (tcp-build-segment 50000 80 seq ack flags 8192 payload) cli-ip srv-ip
    in let ip = ip-build-packet cli-ip srv-ip ip-proto-tcp seg
    in eth-build-frame srv-mac cli-mac eth-type-ipv4 ip

Section: Server Session
  srv0 : NetSession = net-session-new srv-mac srv-ip gw-ip 80 0 cli-ip 5000
  established : NetSession =
    let s1 = (net-process-frame (net-listen srv0).session (mkc 1000 0 tcp-flag-syn [])).session
    in set-outbox ((net-process-frame s1 (mkc 1001 5001 psh get-bytes)).session) []
  finished : NetSession = set-outbox ((net-process-frame established (mkc 1019 5001 fin-ack [])).session) []

Section: Entry
  opening : [Console, Network.Read, Network.Write] Nothing = act
    let ts0 = transport-set-session (transport-new established) finished
    in act
      print-line-uni ("before the receive: " & tcp-state-name (((ts0.session).conn).state))
      r <- net-io-recv-loop ts0 0
      print-line-uni ("the waiting receive returned at end of stream, no message: " & (if r.has-message then "no" else "yes"))
      p <- net-io-recv-idle ts0
      print-line-uni ("the parked receive returned at end of stream, no message: " & (if p.has-message then "no" else "yes"))
    end
  end

