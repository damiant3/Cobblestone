Chapter: HalPeripheralLinear
  cites Foreword chapter Board

Section: Body
  talk : Integer -> [Uart, Device.Mmio] Integer
  talk (base) = act
    p0 <- uart-open base default-uart-config
    p1 <- uart-send p0 72
    p2 <- uart-send p1 73
    uart-close p2
  end

  opening : [Console, Uart, Device.Mmio] Nothing = act
    r <- talk 536872960
    print-line-uni ("uart lifecycle ok: " & show r)
  end
