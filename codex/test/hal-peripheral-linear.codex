Chapter: HalPeripheralLinear
  cites Foreword chapter Board

Section: Body
  talk : Integer -> [Uart, Device.Mmio] Integer
  talk (base) = act
    b0 <- board-open 0 0
    r <- uart-open b0 base default-uart-config
    when r
     is (b1, p0) -> act
       p1 <- uart-send p0 72
       p2 <- uart-send p1 73
       c <- uart-close p2
       bc <- (board-close b1)
       c
     end
  end

  opening : [Console, Uart, Device.Mmio] Nothing = act
    r <- talk 536872960
    print-line-uni ("uart lifecycle ok: " & show r)
  end
