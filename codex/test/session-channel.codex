Chapter: SessionChannel
  cites Foreword chapter Console

Section: Body

  opening : [Console, Concurrent] Nothing = act
    c0 <- s-new
    c1 <- s-send c0 7
    v <- s-recv-value c1
    c2 <- s-recv c1
    closed <- s-close c2
    print-line-uni ("received: " & show v & " closed: " & show closed)
  end

