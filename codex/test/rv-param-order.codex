Chapter: RvParamOrder
  cites Foreword chapter Console

Section: Types

  IntList =
   | INil
   | ICons (Integer) (IntList)

Section: Probes

  e-bound : Integer, IntList -> Integer
  e-bound (acc) (xs) =
   when xs
    is ICons (h) (t) -> e-bound (acc + 1) t
    is INil -> acc

  e-swap : IntList, Integer -> Integer
  e-swap (xs) (acc) =
   when xs
    is ICons (h) (t) -> e-swap t (acc + 1)
    is INil -> acc

Section: Entry

  three : IntList
  three = ICons 1 (ICons 2 (ICons 3 INil))

  opening : [Console] Nothing
  opening = act
   print-line-uni ("bound: " & show (e-bound 0 three))
   print-line-uni ("swap: " & show (e-swap three 0))
  end
