Chapter: DateTimeTickCarryTest
  cites Dev chapter DateTimeSettings

Section: Entry
  dtc-at : Integer, Integer, Integer, Integer, Integer, Integer -> DateTimeState
  dtc-at (y) (mo) (d) (h) (mi) (s) = dt-set-time (dt-set-date datetime-new y mo d) h mi s

  dtc-show : DateTimeState -> Text
  dtc-show (st) = dt-format-date st & " " & dt-pad2 st.dt-hour & ":" & dt-pad2 st.dt-minute & ":" & dt-pad2 st.dt-second

  dtc-line : Text, DateTimeState -> Text
  dtc-line (name) (st) = name & " " & dtc-show st & " -> " & dtc-show (dt-tick st)

  opening : [Console] Nothing = act
    print-line-uni (dtc-line "midday" (dtc-at 2026 5 10 13 59 59))
    print-line-uni (dtc-line "midnight" (dtc-at 2026 5 10 23 59 59))
    print-line-uni (dtc-line "april" (dtc-at 2026 4 30 23 59 59))
    print-line-uni (dtc-line "feb-common" (dtc-at 2026 2 28 23 59 59))
    print-line-uni (dtc-line "feb-leap" (dtc-at 2028 2 28 23 59 59))
    print-line-uni (dtc-line "feb-leap-end" (dtc-at 2028 2 29 23 59 59))
    print-line-uni (dtc-line "feb-1900" (dtc-at 1900 2 28 23 59 59))
    print-line-uni (dtc-line "feb-2000" (dtc-at 2000 2 28 23 59 59))
    print-line-uni (dtc-line "new-year" (dtc-at 2026 12 31 23 59 59))
  end
