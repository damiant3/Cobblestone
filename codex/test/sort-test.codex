Chapter: SortTest
  cites Foreword chapter Sort
  cites Foreword chapter Console

Section: Helpers
  int-cmp : Integer, Integer -> Integer
  int-cmp (a) (b) = a - b

  print-list : List Integer, Integer, Integer -> [Console] Nothing
  print-list (xs) (i) (len) = act
    if i >= len then print-line-uni ""
    else act
      print-line-uni (show (list-at xs i))
      print-list xs (i + 1) len
    end
  end

Section: Body
  opening : [Console] Nothing = act
    let xs = [5, 3, 8, 1, 9, 2, 7, 4, 6]
    in let sorted = sort-by xs int-cmp
    in let empty = sort-by [] int-cmp
    in let single = sort-by [42] int-cmp
    in let dupes = sort-by [3, 1, 4, 1, 5] int-cmp
    in act
      print-list sorted 0 9
      print-line-uni (show (list-length empty))
      print-line-uni (show (list-at single 0))
      print-list dupes 0 5
    end
  end

