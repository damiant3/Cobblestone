Chapter: LinearPatternOnce
  cites Foreword chapter Console

Section: Body

  Box = | MkBox (linear Integer)

  consume : linear Integer -> Integer
  consume (n) = n * 2

  twice : Box -> Integer
  twice (b) =
    when b
      is MkBox (n) -> consume n + 1

  opening : [Console] Nothing = act
    print-line-uni ("once: " & show (twice (MkBox 4)))
  end

