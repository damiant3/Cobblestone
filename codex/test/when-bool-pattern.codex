Chapter: WhenBoolPattern
  cites Foreword chapter Console

Section: Boolean Patterns

  bare-true : Integer
  bare-true =
   when True
    is True -> 1
    is otherwise -> 0

  bare-false : Integer
  bare-false =
   when False
    is False -> 1
    is otherwise -> 0

  computed : Integer
  computed =
   when ((5 + 0) == (5 + 0))
    is True -> 1
    is otherwise -> 0

  both-arms-named : Integer
  both-arms-named =
   when False
    is True -> 7
    is False -> 9

Section: Controls

  if-control : Integer
  if-control = if (5 + 0) == (5 + 0) then 1 else 0

  int-control : Integer
  int-control =
   when (5 + 0)
    is 5 -> 1
    is otherwise -> 0

  char-control : Integer
  char-control =
   when 'a'
    is 'a' -> 1
    is otherwise -> 0

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("bare-true: " & show bare-true)
    print-line-uni ("bare-false: " & show bare-false)
    print-line-uni ("computed: " & show computed)
    print-line-uni ("both-arms-named: " & show both-arms-named)
    print-line-uni ("if-control: " & show if-control)
    print-line-uni ("int-control: " & show int-control)
    print-line-uni ("char-control: " & show char-control)
  end
