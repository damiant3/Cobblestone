Chapter: DhcpRenew
  cites Net chapter DhcpIO
  cites Net chapter NetDriver
  cites Net chapter NetworkConfig
  cites Kernel chapter Hpet

Section: Waiting

  spin-until : Integer, Integer -> Integer
  spin-until (deadline) (fuel) =
    if fuel <= 0 then hpet-seconds
    else if hpet-seconds >= deadline then hpet-seconds
    else spin-until deadline (fuel - 1)

Section: Entry

  yn : Boolean -> Text
  yn (b) = if b then "yes" else "no"

  opening : [Console, Network.Read, Network.Write] Nothing = act
    let card = net-driver-bring-up
    in let mac = net-driver-mac
    in act
      cfg <- dhcp-io-configure mac "codex" 305419896 200000 hpet-seconds
      print-line-uni ("leased      : " & yn (net-is-configured cfg))
      print-line-uni ("lease time  : " & show (cfg.lease-time))
      print-line-uni ("due before  : " & yn (net-lease-due cfg hpet-seconds))
      let waited = spin-until (cfg.lease-start + cfg.lease-time / 2 + 1) 20000000
      in act
        print-line-uni ("due after   : " & yn (net-lease-due cfg waited))
        cfg2 <- dhcp-io-maybe-renew cfg 305419897 200000 waited
        print-line-uni ("renewed     : " & yn (cfg2.lease-start /= cfg.lease-start))
        print-line-uni ("address held: " & yn (net-is-configured cfg2))
      end
    end
  end

