Chapter: LazySmoke
  cites Foreword chapter Console

Section: Types

  Color = | Red | Green | Blue

  Pair = record { x : Integer, y : Integer }

Section: Helpers

  expensive : Integer -> Integer
  expensive (n) = n * n + n * 3 + 7

  pick-color : Integer -> Color
  pick-color (n) = if n > 0 then Green else Red

  sum-pair : Pair -> Integer
  sum-pair (p) = p.x + p.y

Section: Body

  opening : [Console] Nothing = act
    let a = lazy 42
    in act
      print-line-uni ("basic: " & show (a 0))
    end
    let b = lazy (3 + 4)
    in act
      print-line-uni ("arith: " & show (b 0))
    end
    let c = lazy (expensive 5)
    in act
      print-line-uni ("call: " & show (c 0))
    end
    let d = lazy (expensive 5)
    in act
      print-line-uni ("memo1: " & show (d 0))
      print-line-uni ("memo2: " & show (d 0))
    end
    let e = lazy "hello"
    in act
      print-line-uni ("text: " & e 0)
    end
    let f = lazy (pick-color 1)
    in act
      print-line-uni ("variant: " & when (f 0) is Green -> "green" is Red -> "red" is Blue -> "blue")
    end
    let g = lazy (Pair { x = 10, y = 20 })
    in act
      print-line-uni ("record: " & show (sum-pair (g 0)))
    end
    let h = lazy [1, 2, 3]
    in act
      print-line-uni ("list: " & show (list-length (h 0)))
    end
    let i = lazy (lazy 99)
    in act
      let inner = i 0
      in print-line-uni ("nested: " & show (inner 0))
    end
    let j = lazy (if 10 > 5 then 100 else 0)
    in act
      print-line-uni ("if: " & show (j 0))
    end
    let k = lazy (let x = 6 in x * 7)
    in act
      print-line-uni ("let: " & show (k 0))
    end
  end

