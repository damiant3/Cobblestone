Chapter: Poke16Width

  cites Foreword chapter Console

Section: Body

  hex-bytes : Integer, Integer, Integer, Text -> Text
  hex-bytes (b) (i) (n) (acc) =
    if i >= n then acc
    else hex-bytes b (i + 1) n (acc & " " & show (peek-byte b i))

  opening : [Console] Nothing = act
    let b = alloc-bytes 16
    in let w0 = poke-32 b 0 #11223344
    in let w1 = poke-16 b 2 #4BCD
    in let aligned = peek-32 b 0
    in let w2 = poke-32 b 4 0
    in let w3 = poke-32 b 8 0
    in let w4 = poke-16 b 5 #EEFF
    in let odd = peek-16 b 5
    in act
      print-line-uni ("neighbour " & show aligned)
      print-line-uni ("odd-bytes" & hex-bytes b 4 8 "")
      print-line-uni ("peek16-odd " & show odd)
      print-line-uni ("peek16-hi " & show (peek-16 b 2))
    end
  end
