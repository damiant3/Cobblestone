Chapter: ComplianceReportTest
  cites Foreword chapter ComplianceEvidence

 Verify the compliance evidence requirement counts match
 the actual lists in ComplianceEvidence.

Section: Body

  opening : [Console] Nothing = act
   let cra-count = list-length cra-requirements
   in let etsi-count = list-length etsi-requirements
   in let nist-count = list-length nist-requirements
   in let iec-count = list-length iec-requirements
   in let total = cra-count + etsi-count + nist-count + iec-count
   in act
    print-line-uni ("CRA: " & show cra-count & " requirements")
    print-line-uni ("ETSI: " & show etsi-count & " requirements")
    print-line-uni ("NIST: " & show nist-count & " requirements")
    print-line-uni ("IEC62443: " & show iec-count & " requirements")
    print-line-uni ("total: " & show total & " mapped")
   end
  end

