Chapter: TextProbe

Shape =
  | Dot
  | Box (Integer)
  | Pair (Integer) (Integer)

area : Shape -> Integer
area (s) =
  when s
   is Dot -> 0
   is Box (w) -> w * w
   is Pair (a) (b) -> a * b

pick : Integer, Boolean -> Integer
pick (n) (b) =
  let m = n + 1
  in if b then m
     else 0 - m

opening : Integer
opening =
  area (Pair 3 4) + pick (area (Box 2)) (2 > 1)



