Chapter: IterateZipTest
  cites Foreword chapter Iterate
  cites Foreword chapter Console

Section: Body
  opening : [Console] Nothing = act
    let xs = [1, 2, 3, 4, 5]
    in let ys = [10, 20, 30]
    in let zipped = list-zip-with-generic (\a b -> a + b) xs ys
    in let products = list-zip-with-generic (\a b -> a * b) xs ys
    in let all-true = list-all-generic (\x -> x > 0) xs
    in let any-big = list-any-generic (\x -> x > 100) xs
    in act
      print-line (show (list-length zipped))
      print-line (show (list-at zipped 0))
      print-line (show (list-at zipped 2))
      print-line (show (list-at products 1))
      print-line (show all-true)
      print-line (show any-big)
    end
  end

