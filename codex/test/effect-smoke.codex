Chapter: EffectSmoke
  cites Foreword chapter Console

Section: Effects

  effect Reader where
    ask : [Reader] Integer

  effect Writer where
    tell : Integer -> [Writer] Integer

Section: Body

  opening : [Console] Nothing =
    let r1 = with Reader ask
      ask (resume) = resume 42
    in let r2 = with Writer (tell 6)
      tell (x) (resume) = resume (x * 7)
    in let r3 = with Reader (with Writer (ask + tell 10))
      tell (x) (resume) = resume (x + 5)
      ask (resume) = resume 100
    in act
      print-line-uni ("basic=" & show r1)
      print-line-uni ("args=" & show r2)
      print-line-uni ("nested=" & show r3)
    end

