Chapter: Arithmetic
  cites Foreword chapter Console
  cites Codex chapter General

 Combined language features test. Tests: arithmetic with max/abs/clamp,
 lambda absorption, literal/wildcard match, bounded integer clamping,
 mutual recursion, comma-separated type params, list/text concat.

Section: Arithmetic

  max : Integer, Integer -> Integer
  max (x) (y) = if x > y then x else y

  abs : Integer -> Integer
  abs (x) = if x < 0 then -x else x

  clamp : Integer, Integer, Integer -> Integer
  clamp (lo) (hi) (x) =
    let clamped = if x < lo then lo else if x > hi then hi else x
    in clamped

Section: Lambda Absorption

  add5 : Integer -> Integer
  add5 = (\x -> x + 5)

Section: Pattern Matching

  classify : Integer -> Text
  classify (n) = when n
    is 0 -> "zero"
    is 1 -> "one"
    is 42 -> "answer"
    is otherwise -> "other"

Section: Bounded Integers

  Pct = record {
    p : Integer between 0 and 100 clamping
  }

Section: Mutual Recursion

  is-even : Integer -> Boolean
  is-even (n) = if n == 0 then True else is-odd (n - 1)

  is-odd : Integer -> Boolean
  is-odd (n) = if n == 0 then False else is-even (n - 1)

Section: Multi-param Types

  add : Integer, Integer -> Integer
  add (x) (y) = x + y

  apply : (Integer, Integer -> Integer), Integer, Integer -> Integer
  apply (f) (a) (b) = f a b

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("clamp: " & show (clamp 0 100 (abs (max (-42) 37))))
    print-line-uni ("absorb: " & show (add5 7))
    print-line-uni ("match: " & classify 42 & "/" & classify 1 & "/" & classify 99)
    let large-val = 150
    in print-line-uni ("clamping: " & show (Pct { p = large-val }).p)
    print-line-uni ("even: " & if is-even 10 then "yes" else "no")
    print-line-uni ("odd: " & if is-odd 7 then "yes" else "no")
    print-line-uni ("comma-params: " & show (add 10 32) & "/" & show (apply add 20 22))
    print-line-uni ("concat-text: " & "hello" & " " & "world")
    print-line-uni ("concat-bool: " & show (True & False))
    let xs = [1, 2] & [3, 4]
    in print-line-uni ("concat-list: " & show (list-length xs))
  end

