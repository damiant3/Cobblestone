Chapter: EdgeMeshBracketTest

  cites Foreword chapter Console
  cites Engine chapter EdgeMesh
  cites Mesh chapter EdgeMeshBracket

 EdgeMeshGameServers phase 3, stage 4. The arms that matter: the bye follows the
 TOP SEED rather than a position in the list, and a round cannot be advanced with
 the wrong number of results or with a name that did not play its bout. A bracket
 that takes any winner list silently drops or duplicates entrants, and a single
 run of a working tournament looks the same either way.

 The top seed sits in the MIDDLE of the entrant list on purpose: first-in-list
 and last-in-list both pass a bye test built from a sorted list.

Section: Fixtures

  seat : Integer, Text, Integer -> QueuedPlayer
  seat (id) (name) (rating) =
    QueuedPlayer {
      qp-id = id,
      qp-name = name,
      qp-rating = rating,
      qp-region-pref = 0,
      qp-latencies = [],
      qp-queue-time = 0,
      qp-game-mode = ModeTournament
    }

  five : Integer -> Bracket
  five (dummy) =
    bracket-open "codexmagic" [seat 1 "mid" 1500, seat 2 "ace" 1900, seat 3 "low" 1400, seat 4 "two" 1700, seat 5 "three" 1600]

  advanced : Bracket, List Text -> Bracket
  advanced (b) (winners) =
    when bracket-advance b winners
      is Advanced (nb) -> nb
      is AdvanceRefused (why) -> b

Section: Entry

  opening : [Console] Nothing
  opening = act
    let b1 = five 0
    in act
      print-line-uni ("round 1 of " & show (bracket-size b1) & ": " & bracket-round-label (bracket-round b1))
      print-line-uni ("too few results: " & bracket-step-label (bracket-advance b1 ["mid"]))
      print-line-uni ("a name that did not play: " & bracket-step-label (bracket-advance b1 ["mid", "nobody"]))
      print-line-uni ("advancing: " & bracket-step-label (bracket-advance b1 ["mid", "two"]))

      act
        let b2 = advanced b1 ["mid", "two"]
        in act
          print-line-uni ("round 2 of " & show (bracket-size b2) & ": " & bracket-round-label (bracket-round b2))
          act
            let b3 = advanced b2 ["two"]
            in act
              print-line-uni ("round 3 of " & show (bracket-size b3) & ": " & bracket-round-label (bracket-round b3))
              act
                let b4 = advanced b3 ["ace"]
                in print-line-uni ("champion: " & bracket-champion b4 & ", seats left " & show (bracket-size b4))
              end
            end
          end
        end
      end
    end
  end
