Chapter: BoundsProver
  cites Foreword chapter Console

 Exercise the static bounds prover. Each function stores a computed
 value into a bounded field. If the prover can prove the value fits,
 CDX4010 fires and the runtime check is elided. If not, a runtime
 bounds check is emitted (which still passes — the values are in range).

Section: Types

  Byte = record { val : Integer between 0 and 255 }
  Pct = record { val : Integer between 0 and 100 }
  Small = record { val : Integer between 0 and 1000 }

Section: Helpers

  from-literal : Byte
  from-literal = Byte { val = __narrow 42 }

  from-add : Integer, Integer -> Small
  from-add (a) (b) =
   let x = Byte { val = __narrow a }
   in let y = Byte { val = __narrow b }
   in Small { val = __narrow (x.val + y.val) }

  from-sub : Integer -> Pct
  from-sub (a) =
   let x = Pct { val = __narrow a }
   in Pct { val = __narrow (100 - x.val) }

  from-mul : Integer -> Small
  from-mul (a) =
   let x = Pct { val = __narrow a }
   in Small { val = __narrow (x.val * 10) }

  from-div : Integer -> Pct
  from-div (a) =
   let x = Small { val = __narrow a }
   in Pct { val = __narrow (x.val / 10) }

  from-mod : Integer -> Byte
  from-mod (a) = Byte { val = __narrow (int-mod a 256) }

  from-bitand : Integer -> Byte
  from-bitand (a) = Byte { val = __narrow (bit-and a 255) }

  from-if : Integer -> Byte
  from-if (a) = Byte { val = __narrow (if a > 100 then 100 else a) }

  from-negate : Integer -> Small
  from-negate (a) =
   let x = Pct { val = __narrow a }
   in Small { val = __narrow (negate (negate (x.val))) }

Section: Body

  opening : [Console] Nothing = act
    print-line-uni (show (from-literal).val)
    print-line-uni (show (from-add 100 150).val)
    print-line-uni (show (from-sub 30).val)
    print-line-uni (show (from-mul 8).val)
    print-line-uni (show (from-div 500).val)
    print-line-uni (show (from-mod 1000).val)
    print-line-uni (show (from-bitand 1000).val)
    print-line-uni (show (from-if 50).val)
    print-line-uni (show (from-negate 75).val)
  end

