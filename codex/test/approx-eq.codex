Chapter: ApproxEq
  cites Foreword chapter Console

Section: Helpers
  check : Text, Boolean -> [Console] Nothing
  check (label) (result) = act
    print-line-uni (label & ": " & if result then "PASS" else "FAIL")
  end

Section: Entry
  opening : [Console] Nothing
  opening = act
    check "approx-same" (1.0 ~ 1.0)
    check "approx-zero" (0.0 ~ 0.0)
    check "approx-far" (if 1.0 ~ 2.0 then False else True)
    check "exact-same" (1.0 ~0 1.0)
    check "exact-zero" (0.0 ~0 0.0)
    check "exact-far" (if 1.0 ~0 2.0 then False else True)
  end
