Chapter: RecordInRecord
  cites Codex chapter Text

Section: Definitions

  Point = record { x : Integer, y : Integer }

  Rect = record { origin : Point, width : Integer, height : Integer }

  area : Rect -> Integer
  area (r) = r.width * r.height

  describe : Rect -> Text
  describe (r) =
    "rect at " & integer-to-text (r.origin.x) & "," & integer-to-text (r.origin.y)
      & " size " & integer-to-text (r.width) & "x" & integer-to-text (r.height)
      & " area=" & integer-to-text (area r)

  opening : Text = describe (Rect { origin = Point { x = 10, y = 20 }, width = 7, height = 3 })

