Chapter: LruEvict
  cites Foreword chapter LruCache

Section: Checks

  truth : Boolean -> Text
  truth (b) = if b then "True" else "False"

  filled : LruCache
  filled = lru-put (lru-put (lru-new 2) 1 10) 2 20

  touched : LruGetResult
  touched = lru-get filled 1

  evicted : LruCache -> LruCache
  evicted (c) = lru-put c 3 30

  report : LruCache -> Text
  report (c) = truth (lru-contains c 1) & " " & truth (lru-contains c 2) & " " & truth (lru-contains c 3) & " count " & show (lru-count c)

  value-of : LruCache, Integer -> Text
  value-of (c) (k) =
    let r = lru-get c k
    in if r.found then show (r.value) else "absent"

  after : LruGetResult -> Text
  after (t) =
    let c3 = evicted (t.cache)
    in let c4 = lru-put c3 1 11
    in report c3 & " / " & value-of c3 3 & " " & value-of c3 2 & " / " & value-of c4 1 & " count " & show (lru-count c4)

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (show (touched.value) & " " & truth (touched.found))
    print-line-uni (after touched)
    print-line-uni (value-of (lru-new 3) 7)
  end
