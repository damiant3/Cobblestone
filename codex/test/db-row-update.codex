Chapter: DbRowUpdateTest
  cites Data chapter Row
  cites Data chapter Schema
  cites Data chapter Heap
  cites Data chapter Catalog
  cites Foreword chapter Maybe
  cites Foreword chapter Hamt

Section: Helpers

  emp-cols : List ColumnDef
  emp-cols = [col-def-not-null "id" ColInteger, col-def "name" ColText]

  int-of : ColumnValue -> Integer
  int-of (v) =
    when v
      is ValInteger (n) -> n
      is otherwise -> 0 - 1

  text-of : ColumnValue -> Text
  text-of (v) =
    when v
      is ValText (t) -> t
      is otherwise -> "?"

Section: Entry

  opening : [Console] Nothing
  opening = act
   let cat0 = catalog-new
   in let made = catalog-create-table cat0 (table-def "emp" emp-cols)
   in let schema = table-schema (table-def "emp" emp-cols)
   in let ins = catalog-insert-row (made.cat) "emp" (row-new schema [ValInteger 1, ValText "ada"])
   in let sr = catalog-scan (ins.cir-cat) "emp"
   in let rid = list-at (sr.row-ids) 0
   in let row = list-at (sr.rows) 0
   in let before-name = text-of (row-get-by-name row "name")
   in let updated = row-set-by-name row "name" (ValText "grace")
   in let upd = catalog-update-row (ins.cir-cat) "emp" rid updated
   in let after = catalog-scan (upd.cir-cat) "emp"
   in act
    print-line-uni ("created: " & show (made.cat-ok))
    print-line-uni ("rows before: " & show (sr.scan-count))
    print-line-uni ("name before: " & before-name)
    print-line-uni ("source row after set: " & text-of (row-get-by-name row "name"))
    print-line-uni ("update ok: " & show (upd.cir-ok))
    print-line-uni ("rows after: " & show (after.scan-count))
    print-line-uni ("name after: " & text-of (row-get-by-name (list-at (after.rows) 0) "name"))
    print-line-uni ("id after: " & show (int-of (row-get-by-name (list-at (after.rows) 0) "id")))
    print-line-uni ("unknown col left alone: " & text-of (row-get-by-name (row-set-by-name row "nope" (ValText "x")) "name"))
   end
  end
