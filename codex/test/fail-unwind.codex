Chapter: FailUnwind
  cites Foreword chapter Console

Section: Body

  step : [Console] Nothing
  step = act
    fail "inner"
    print-line-uni "continues-after-fail"
  end

  middle : [Console] Nothing
  middle = act
    step
    print-line-uni "middle-after-step"
  end

  opening : [Console] Nothing = act
    trying 2 times
      print-line-uni "attempt"
      middle
      print-line-uni "never"
    falling back to
      print-line-uni "fallback"
    end
    trying 1 times
      trying 1 times
        fail "inner-try"
      falling back to
        fail "fallback-fails-outward"
      end
      print-line-uni "never-outer"
    falling back to
      print-line-uni "outer-fallback"
    end
    trying 1 times
      trying 2 times
        fail "no-fallback"
      end
      print-line-uni "never-exhausted"
    falling back to
      print-line-uni "outer-caught-exhaustion"
    end
    print-line-uni "done"
  end
