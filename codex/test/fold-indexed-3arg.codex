Chapter: FoldIndexed3Arg
  cites Foreword chapter Iterate
  cites Foreword chapter Console

Section: Helpers
  my-combiner : Integer, Integer, Integer -> Integer
  my-combiner (acc) (elem) (idx) = acc + elem * 10 + idx

Section: Body
  opening : [Console] Nothing = act
    let xs = [1, 2, 3]
    in let r1 = list-fold-indexed xs 0 (\acc elem idx -> acc + elem + idx)
    in let scale = 5
    in let r2 = list-fold-indexed xs 0 (\acc elem idx -> acc + elem * scale + idx)
    in let r3 = list-fold-indexed xs 0 my-combiner
    in act
      print-line (show r1)
      print-line (show r2)
      print-line (show r3)
    end
  end

