Chapter: NvMmuRefuse
  cites Kernel chapter NvMmu

Section: Main

  opening : [Console] Nothing = act
   print-line-uni ("pte-sys-max " & show (nv-mmu-pte #FFFFFFF000 2 0 0 0 0))
   print-line-uni ("pte-peer " & show (nv-mmu-pte #1000 1 0 0 0 0))
   print-line-uni ("pte-unaligned " & show (nv-mmu-pte #1800 0 0 0 0 0))
   print-line-uni ("pte-vid-over " & show (nv-mmu-pte #2000000000 0 0 0 0 0))
   print-line-uni ("pte-sys-over " & show (nv-mmu-pte #10000000000 3 0 0 0 0))
   print-line-uni ("pte-kind-256 " & show (nv-mmu-pte #1000 0 0 256 0 0))
   print-line-uni ("pde-invalid-with-address " & show (nv-mmu-pde #1000 0 0 0 0 0 0))
   print-line-uni ("pde-size-4 " & show (nv-mmu-pde #1000 1 0 0 0 0 4))
   print-line-uni ("pdb-target-1 " & show (list-length (nv-ramin-pdb #1000 1 0 #FFF)))
   print-line-uni ("pdb-unaligned " & show (list-length (nv-ramin-pdb #1800 0 0 #FFF)))
   print-line-uni ("pdb-ok " & show (list-length (nv-ramin-pdb #1000 0 0 #FFF)))
  end
