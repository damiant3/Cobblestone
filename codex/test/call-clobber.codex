Chapter: CallClobber
  cites Foreword chapter Console

Section: Constants

  cc-mark : Integer = 3

Section: Helpers

  cc-three : Integer, Integer, Integer -> Integer
  cc-three (a) (b) (c) =
   if a > 1000 then cc-three (a - 1) b c
   else a * 100 + b * 10 + c

  cc-add : Integer, Integer -> Integer
  cc-add (a) (b) = a + b

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("args " & show (cc-three 1 cc-mark 2))
    print-line-uni ("eq " & show (cc-add 5 (5 + 11) == 15))
    print-line-uni ("eqtrue " & show (cc-add 4 (0 + 11) == 15))
  end
