Chapter: LinearMintContainer

Section: Defs

  bus-acquire : Integer -> linear Integer
  bus-acquire (n) = n

  stash-arg : Integer -> Integer
  stash-arg (n) =
   let g = bus-acquire n
   in list-length [g]

Section: Entry

  opening : [Console] Nothing
  opening = act
   print-line-uni (integer-to-text (stash-arg 7))
  end
