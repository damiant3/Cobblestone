Chapter: ResolveTypeScope
  cites Codex chapter Resolve Types
  cites Foreword chapter Console

Section: Checks
  scoped : ResolveScope = ResolveScope { types = [], vars = resolve-var-add RvEmpty 17 }

  is-var : Integer, CodexType -> Boolean
  is-var (wanted) (ty) = when ty
    is TypeVar (id) -> id == wanted
    is otherwise -> False

  is-integer : CodexType -> Boolean
  is-integer (ty) = when ty
    is IntegerTy (lo) (hi) (mode) -> True
    is otherwise -> False

  nested-binder : Boolean
  nested-binder = when resolve-ty-deep scoped (ForAllTy 99 (FunTy (TypeVar 99) empty-row (TypeVar 17)))
    is ForAllTy (id) (body) -> when body
      is FunTy (p) (row) (r) -> id == 99 & is-var 99 p & is-var 17 r
      is otherwise -> False
    is otherwise -> False

  opening : [Console] Nothing = act
    print-line-uni ("signature=" & show (is-var 17 (resolve-ty-deep scoped (TypeVar 17))))
    print-line-uni ("internal=" & show (is-integer (resolve-ty-deep scoped (TypeVar 99))))
    print-line-uni ("nested=" & show nested-binder)
    print-line-uni ("no-binder-leak=" & show (is-integer (resolve-ty-deep scoped (TypeVar 99))))
    print-line-uni ("high-id=" & show (resolve-var-has (resolve-var-add RvEmpty 4294967295) 4294967295 31))
    print-line-uni ("absent-id=" & show (resolve-var-has (resolve-var-add RvEmpty 4294967295) 2147483647 31))
  end
