Chapter: TwoAwaiters
  cites Foreword chapter Console

Section: Body

  both : Integer -> Integer
  both (n) =
    let t = fork (\x -> n)
    in let a = fork (\x -> await t)
    in let b = fork (\x -> await t)
    in await a + await b

  opening : [Console] Nothing = act
    print-line-uni ("both: " & show (both 7))
  end

