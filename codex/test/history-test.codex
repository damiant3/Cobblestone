Chapter: HistoryTest
  cites Codex chapter General
  cites Foreword chapter History
  cites Foreword chapter Maybe

Section: Body

  test-add : Text =
    let h = history-new 5
    in let h1 = history-add h "ls"
    in let h2 = history-add h1 "ps"
    in let h3 = history-add h2 "help"
    in "count=" & show (history-length h3)

  test-navigate : Text =
    let h = history-add (history-add (history-add (history-new 5) "ls") "ps") "help"
    in let h1 = history-up h
    in let c1 = history-current h1
    in let h2 = history-up h1
    in let c2 = history-current h2
    in let h3 = history-down h2
    in let c3 = history-current h3
    in when c1
      is Just (t1) -> when c2
        is Just (t2) -> when c3
          is Just (t3) -> "up1=" & t1 & " up2=" & t2 & " down=" & t3
          is None -> "c3-none"
        is None -> "c2-none"
      is None -> "c1-none"

  test-dedup : Text =
    let h = history-add (history-add (history-add (history-new 5) "ls") "ls") "ls"
    in "dedup=" & show (history-length h)

  test-search : Text =
    let h = history-add (history-add (history-add (history-new 10) "install foo") "run bar") "install baz"
    in let found = history-search h "inst"
    in when found
      is Just (t) -> "search=" & t
      is None -> "search=none"

  test-overflow : Text =
    let h = history-add (history-add (history-add (history-add (history-new 3) "a") "b") "c") "d"
    in let first = history-at h 0
    in when first
      is Just (t) -> "first=" & t & " count=" & show (history-length h)
      is None -> "first=none"

  opening : [Console] Nothing = act
    print-line-uni test-add
    print-line-uni test-navigate
    print-line-uni test-dedup
    print-line-uni test-search
    print-line-uni test-overflow
  end

