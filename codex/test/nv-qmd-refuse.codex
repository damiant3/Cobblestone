Chapter: NvQmdRefuse
  cites Kernel chapter NvQmd

Section: Main

  base : QmdLaunch
  base = QmdLaunch { program-offset = #1000, grid-x = 4, grid-y = 1, grid-z = 1, block-x = 128, block-y = 1, block-z = 1, shared-size = 0, local-size = 0, register-count = 28, barrier-count = 0, cb0-address = #200001000, cb0-size = #160 }

  with-shared : Integer -> QmdLaunch
  with-shared (v) = QmdLaunch { program-offset = #1000, grid-x = 4, grid-y = 1, grid-z = 1, block-x = 128, block-y = 1, block-z = 1, shared-size = v, local-size = 0, register-count = 28, barrier-count = 0, cb0-address = #200001000, cb0-size = #160 }

  with-regs : Integer, Integer -> QmdLaunch
  with-regs (rc) (bc) = QmdLaunch { program-offset = #1000, grid-x = 4, grid-y = 1, grid-z = 1, block-x = 128, block-y = 1, block-z = 1, shared-size = 0, local-size = 0, register-count = rc, barrier-count = bc, cb0-address = #200001000, cb0-size = #160 }

  with-cb : Integer, Integer -> QmdLaunch
  with-cb (ca) (cs) = QmdLaunch { program-offset = #1000, grid-x = 4, grid-y = 1, grid-z = 1, block-x = 128, block-y = 1, block-z = 1, shared-size = 0, local-size = 0, register-count = 28, barrier-count = 0, cb0-address = ca, cb0-size = cs }

  with-grid : Integer, Integer -> QmdLaunch
  with-grid (gx) (lm) = QmdLaunch { program-offset = #1000, grid-x = gx, grid-y = 1, grid-z = 1, block-x = 128, block-y = 1, block-z = 1, shared-size = 0, local-size = lm, register-count = 28, barrier-count = 0, cb0-address = #200001000, cb0-size = #160 }

  case : Text, QmdLaunch -> Text
  case (name) (q) = name & " " & show (list-length (nv-qmd-v0006 q))

  opening : [Console] Nothing = act
   print-line-uni (case "ok" base)
   print-line-uni (case "shared-48k" (with-shared 49152))
   print-line-uni (case "shared-over" (with-shared 49153))
   print-line-uni (case "regs-256" (with-regs 256 0))
   print-line-uni (case "barriers-32" (with-regs 28 32))
   print-line-uni (case "cb-unaligned" (with-cb #200001001 #160))
   print-line-uni (case "cb-size-over" (with-cb #200001000 65537))
   print-line-uni (case "cb-address-41bit" (with-cb #10000000000 #160))
   print-line-uni (case "grid-zero" (with-grid 0 0))
   print-line-uni (case "local-over" (with-grid 4 #1000000))
  end
