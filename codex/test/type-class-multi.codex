Chapter: TypeClassMulti
  cites Foreword chapter Console

 Two instances of one class. Direct method calls resolve to the
 instance for each argument's type via monomorphization at lowering.

class Showable where
  to-text : a -> Text

instance Showable Integer where
  to-text (x) = show x

instance Showable Boolean where
  to-text (b) = if b then "yes" else "no"

Section: Opening

  opening : [Console] Nothing
  opening = act
   print-line-uni (to-text 42)
   print-line-uni (to-text True)
  end
