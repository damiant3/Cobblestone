Chapter: VariantRecordArg
  cites Foreword chapter Maybe

 Minimal reproduction: a variant constructor whose payload is a
 record literal passed directly as the argument. Hypothesis is
 that is-record-keyword crashes when parsing a record literal
 inside a variant constructor application.

 We say:

Section: Types

  Inner = record {
    x-val : Integer,
    y-val : Integer,
    label : Text
  }

  Outer =
    | Wrapped (Inner)
    | Plain (Integer)
    | Empty

Section: Test — Direct record literal as variant arg

  make-wrapped-direct : Integer -> Outer
  make-wrapped-direct (n) =
    Wrapped (Inner { x-val = n, y-val = n * 2, label = "test" })

  make-wrapped-let : Integer -> Outer
  make-wrapped-let (n) =
    let inner = Inner { x-val = n, y-val = n * 2, label = "test" }
    in Wrapped inner

  use-wrapped : Outer -> Integer
  use-wrapped (o) =
    when o
      is Wrapped (i) -> i.x-val + i.y-val
      is Plain (n) -> n
      is Empty -> 0

  opening : [Console] Nothing = act
    let a = make-wrapped-direct 5
    in let b = make-wrapped-let 10
    in let ra = use-wrapped a
    in let rb = use-wrapped b
    in print-line-uni (show ra & " " & show rb)
  end

