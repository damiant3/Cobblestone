Section: Probe

 L-PEROBJECT: a server holds one application buffer per association, so its room is multiplied by the association
 count. Eight associations each take one 100-byte record; their rooms and the heap of the eight receives are
 reported. One more takes 20,000 bytes in two records, and its room must stay within twice what it holds.

  feed : DtlsEpStep, List (List Integer), Integer, Integer -> DtlsEpStep
  feed (st) (rs) (i) (t) =
    if i >= list-length rs then st
    else let nx = dtls-ep-recv (st.es-ep) (list-at rs i) t
    in feed (DtlsEpStep { es-ep = nx.es-ep, es-out = st.es-out & nx.es-out }) rs (i + 1) (t + 1)

  fill : Integer, List Integer -> List Integer
  fill (n) (acc) = if list-length acc >= n then acc else fill n (list-push acc 65)

  Pair = record { pr-c : DtlsEp, pr-s : DtlsEp }

  pair : Integer -> Pair
  pair (k) =
    let s0 = dtls-ep-with-cert (dtls-ep-new True s-priv s-random cookie-secret client-addr) [leaf-cert] leaf-priv leaf-pub
    in let cs1 = dtls-ep-client (dtls-ep-new False c-priv c-random [] []) k
    in let sv1 = dtls-ep-recv s0 (list-at (cs1.es-out) 0) 10
    in let cs2 = dtls-ep-recv (cs1.es-ep) (list-at (sv1.es-out) 0) 20
    in let sv2 = dtls-ep-recv (sv1.es-ep) (list-at (cs2.es-out) 0) 30
    in let cs3 = feed (DtlsEpStep { es-ep = cs2.es-ep, es-out = [] }) (sv2.es-out) 0 40
    in let sv3 = feed (DtlsEpStep { es-ep = sv2.es-ep, es-out = [] }) (cs3.es-out) 0 50
    in Pair { pr-c = cs3.es-ep, pr-s = sv3.es-ep }

  pairs : Integer, List Pair -> List Pair
  pairs (n) (acc) = if list-length acc >= n then acc else pairs n (list-push acc (pair (list-length acc)))

  sealed : List Pair, Integer, List Integer, List (List Integer) -> List (List Integer)
  sealed (ps) (i) (body) (acc) =
    if i >= list-length ps then acc
    else sealed ps (i + 1) body (list-push acc (list-at ((dtls-ep-send-app ((list-at ps i).pr-c) body).es-out) 0))

  take-all : List Pair, List (List Integer), Integer, List DtlsEp -> List DtlsEp
  take-all (ps) (rs) (i) (acc) =
    if i >= list-length ps then acc
    else take-all ps rs (i + 1) (list-push acc ((dtls-ep-recv ((list-at ps i).pr-s) (list-at rs i) 70).es-ep))

  rooms : List DtlsEp, Integer, Integer -> Integer
  rooms (eps) (i) (acc) = if i >= list-length eps then acc else rooms eps (i + 1) (acc + (list-at eps i).ep-app-room)

  ins : List DtlsEp, Integer, Integer -> Integer
  ins (eps) (i) (acc) = if i >= list-length eps then acc else ins eps (i + 1) (acc + list-length (dtls-ep-app-in (list-at eps i)))

  under : Integer, Integer, Integer -> Text
  under (cap) (a) (b) = if b - a < cap then "yes" else "no, " & show (b - a)

  opening : [Console] Nothing = act
    let ps = pairs 8 []
    in let recs = sealed ps 0 (fill 100 []) []
    in let m0 = __heap-save
    in let eps = take-all ps recs 0 []
    in let m1 = __heap-save
    in let big = pair 9
    in let b1 = dtls-ep-send-app (big.pr-c) (fill 16384 [])
    in let b2 = dtls-ep-send-app (b1.es-ep) (fill 3616 [])
    in let got = (dtls-ep-recv ((dtls-ep-recv (big.pr-s) (list-at (b1.es-out) 0) 80).es-ep) (list-at (b2.es-out) 0) 81).es-ep
    in act
      print-line-uni ("8 associations, 100 bytes each: app-in " & show (ins eps 0 0) & ", rooms " & show (rooms eps 0 0))
      print-line-uni ("8 receives; under 20000 bytes: " & under 20000 m0 m1)
      print-line-uni ("20000 bytes in 2 records: app-in " & show (list-length (dtls-ep-app-in got)) & ", room within twice: " & show (got.ep-app-room <= 2 * list-length (dtls-ep-app-in got)))
    end
  end