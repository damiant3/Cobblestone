Chapter: X25519HeapCost
  cites Foreword chapter DiffieHellman

Section: Probe

  alice : List Integer
  alice = [119, 7, 109, 10, 115, 24, 165, 125, 60, 22, 193, 114, 81, 178, 102, 69, 223, 76, 47, 135, 235, 192, 153, 42, 177, 119, 251, 165, 29, 185, 44, 42]

  bob-pub : List Integer
  bob-pub = [222, 158, 219, 125, 123, 125, 193, 180, 211, 91, 97, 194, 236, 228, 53, 55, 63, 131, 67, 200, 91, 120, 103, 77, 173, 252, 126, 20, 111, 136, 43, 79]

  opening : [Console] Nothing = act
    let m0 = __heap-save
    in let pk = x25519-public-key alice
    in let m1 = __heap-save
    in let ss = x25519-shared-secret alice bob-pub
    in let m2 = __heap-save
    in act
      print-line-uni ("public-key under 4096 bytes: " & (if m1 - m0 < 4096 then "yes" else "no, " & show (m1 - m0)) & "; shared-secret under 4096 bytes: " & (if m2 - m1 < 4096 then "yes" else "no, " & show (m2 - m1)))
      print-line-uni ("pk " & dh-format-key pk)
      print-line-uni ("ss " & dh-format-key ss)
    end
  end
