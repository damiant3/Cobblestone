Section: Probe

  cat-out : List (List Integer), Integer, List Integer -> List Integer
  cat-out (rs) (i) (acc) = if i >= list-length rs then acc else cat-out rs (i + 1) (acc & list-at rs i)

  fill : Integer, List Integer -> List Integer
  fill (n) (acc) = if list-length acc >= n then acc else fill n (list-push acc 65)

  feed : DtlsEpStep, List (List Integer), Integer, Integer -> DtlsEpStep
  feed (st) (rs) (i) (t) =
    if i >= list-length rs then st
    else let nx = dtls-ep-recv (st.es-ep) (list-at rs i) t
    in feed (DtlsEpStep { es-ep = nx.es-ep, es-out = st.es-out & nx.es-out }) rs (i + 1) (t + 1)

  chunks : Integer, List (List Integer) -> List (List Integer)
  chunks (left) (acc) =
    if left <= 0 then acc
    else let n = if left > 16384 then 16384 else left
    in chunks (left - n) (list-push acc (fill n []))

  under : Integer, Integer, Integer -> Text
  under (cap) (a) (b) = if b - a < cap then "yes" else "no, " & show (b - a)

  send-all : DtlsEp, List (List Integer), Integer, List (List Integer) -> DtlsEpStep
  send-all (ep) (cs) (i) (acc) =
    if i >= list-length cs then DtlsEpStep { es-ep = ep, es-out = acc }
    else let st = dtls-ep-send-app ep (list-at cs i)
    in send-all (st.es-ep) cs (i + 1) (acc & st.es-out)

  opening : [Console] Nothing = act
    let m0 = __heap-save
    in let s0 = dtls-ep-with-cert (dtls-ep-new True s-priv s-random cookie-secret client-addr) [leaf-cert] leaf-priv leaf-pub
    in let c0 = dtls-ep-new False c-priv c-random [] []
    in let m1 = __heap-save
    in let cs1 = dtls-ep-client c0 0
    in let m2 = __heap-save
    in let sv1 = dtls-ep-recv s0 (list-at (cs1.es-out) 0) 10
    in let m3 = __heap-save
    in let cs2 = dtls-ep-recv (cs1.es-ep) (list-at (sv1.es-out) 0) 20
    in let m4 = __heap-save
    in let sv2 = dtls-ep-recv (sv1.es-ep) (list-at (cs2.es-out) 0) 30
    in let m5 = __heap-save
    in let cs3 = feed (DtlsEpStep { es-ep = cs2.es-ep, es-out = [] }) (sv2.es-out) 0 40
    in let m6 = __heap-save
    in let sv3 = feed (DtlsEpStep { es-ep = sv2.es-ep, es-out = [] }) (cs3.es-out) 0 50
    in let m7 = __heap-save
    in let cs = chunks 200000 []
    in let m8 = __heap-save
    in let big = send-all (cs3.es-ep) cs 0 []
    in let m9 = __heap-save
    in let sv4 = feed (DtlsEpStep { es-ep = sv3.es-ep, es-out = [] }) (big.es-out) 0 60
    in let m10 = __heap-save
    in let wire = cat-out (cs1.es-out) 0 [] & cat-out (sv1.es-out) 0 [] & cat-out (cs2.es-out) 0 [] & cat-out (sv2.es-out) 0 [] & cat-out (cs3.es-out) 0 [] & cat-out (big.es-out) 0 []
    in act
      print-line-uni ("handshake total; under 1700000 bytes: " & under 1700000 m0 m7)
      print-line-uni ("server receives 200000 bytes in " & show (list-length (big.es-out)) & " records, app-in " & show (list-length (dtls-ep-app-in (sv4.es-ep))) & "; under 4500000 bytes: " & under 4500000 m9 m10)
      print-line-uni ("client sends 200000 bytes; under 2000000 bytes: " & under 2000000 m8 m9)
      print-line-uni ("done client=" & show (dtls-ep-done (cs3.es-ep)) & " server=" & show (dtls-ep-done (sv3.es-ep)))
      print-line-uni ("wire " & show (list-length wire) & " bytes sha256 " & sha256-to-hex (sha256 wire))
    end
  end