Chapter: LirTargetsTest
  cites Codex chapter LirTargets
  cites Codex chapter Lir
  cites Foreword chapter Console

Section: Checks
  shape : Text, LirTarget -> Text
  shape (n) (t) = n & " ncallee=" & show t.ncallee & " nargregs=" & show t.nargregs & " nregs=" & show t.nregs & " diva=" & show t.diva & " divb=" & show t.divb & " budget=" & show t.budget

  verdict : Text, LirTarget -> Text
  verdict (n) (t) =
    let v = lir-target-viol t n
    in if list-length v == 0 then n & ": 0 violations" else show (list-length v) & " violation: " & list-at v 0

  mk : Integer, Integer, Integer, Integer, Integer, Integer -> LirTarget
  mk (nc) (na) (nr) (da) (db) (bu) = LirTarget { ncallee = nc, nargregs = na, nregs = nr, diva = da, divb = db, budget = bu }

  opening : [Console] Nothing = act
    print-line-uni (shape "a64-shape" lir-target-a64-shape)
    print-line-uni (shape "narrow-shape" lir-target-narrow-shape)
    print-line-uni (verdict "a64-shape" lir-target-a64-shape)
    print-line-uni (verdict "narrow-shape" lir-target-narrow-shape)
    print-line-uni (verdict "narrow-budget-4" (mk 2 3 5 (0 - 1) (0 - 1) 4))
    print-line-uni (verdict "a64-diva-19" (mk 10 11 19 19 (0 - 1) 24))
    print-line-uni (verdict "a64-divb-minus-2" (mk 10 11 19 (0 - 1) (0 - 2) 24))
    print-line-uni (verdict "a64-ncallee-12" (mk 12 11 19 (0 - 1) (0 - 1) 24))
    print-line-uni (verdict "narrow-nargregs-6" (mk 2 6 5 (0 - 1) (0 - 1) 8))
    print-line-uni (verdict "empty-file" (mk 0 0 0 (0 - 1) (0 - 1) 0))
  end
