Chapter: KnxEncodeTest

  cites Encode chapter Knx

 Exercise KNX: group and individual address packing, a cEMI
 group-value-write telegram, and its KNXnet/IP routing frame. Byte
 sequences checked against the KNX layout (source 1.1.1, group 1/2/3,
 value 1 -- the canonical switch-on telegram). opening returns the
 count of passing checks.

Section: Helpers

  bytes-eq : List Integer, List Integer -> Boolean
  bytes-eq (a) (b) =
   if list-length a /= list-length b then False
   else bytes-eq-loop a b 0 (list-length a)

  bytes-eq-loop : List Integer, List Integer, Integer, Integer -> Boolean
  bytes-eq-loop (a) (b) (i) (len) =
   if i >= len then True
   else if list-at a i /= list-at b i then False
   else bytes-eq-loop a b (i + 1) len

  flag : Boolean -> Integer
  flag (b) = if b then 1 else 0

Section: Checks

  check-group-address : Integer
  check-group-address =
   flag (knx-group-address 1 2 3 == #0A03)

  check-individual-address : Integer
  check-individual-address =
   flag (knx-individual-address 1 1 1 == #1101)

  check-cemi : Integer
  check-cemi =
   flag (bytes-eq (knx-cemi-group-write #1101 #0A03 1) [17, 0, 188, 224, 17, 1, 10, 3, 1, 0, 129])

  check-routing-frame : Integer
  check-routing-frame =
   flag (bytes-eq (knx-routing-group-write #1101 #0A03 1) [6, 16, 5, 48, 0, 17, 17, 0, 188, 224, 17, 1, 10, 3, 1, 0, 129])

  opening : Integer =
   let a = check-group-address
   in let b = check-individual-address
   in let c = check-cemi
   in let d = check-routing-frame
   in a + b + c + d
