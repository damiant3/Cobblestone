Chapter: Sass89HmmaRefuse
  cites Sass chapter Sass89Hmma
  cites Foreword chapter Console

  bad-case : Integer -> Hmma89
  bad-case (j) = Hmma89 {
   k = if j == 14 then 4 else 16,
   accum-bits = if j == 15 then 64 else 32,
   dst = if j == 10 then -1 else 0,
   a = if j == 11 then 256 else 4,
   b = if j == 12 then -1 else 8,
   c = if j == 13 then 256 else 12,
   guard = if j == 7 then 8 else if j == 9 then 7 else 0,
   guard-neg = if j == 8 then 2 else if j == 9 then 1 else 0,
   control = CtrlCode {
    stall = if j == 0 then -1 else if j == 16 then 16 else 0,
    yield-bit = if j == 1 then 2 else 0,
    write-bar = if j == 2 then 6 else 7,
    read-bar = if j == 3 then 6 else 7,
    wait-mask = if j == 4 then 64 else if j == 17 then -1 else 0,
    reuse = if j == 5 then 8 else if j == 6 then -1 else 0
   }
  }

  report-bad : Integer -> [Console] Nothing
  report-bad (j) = act
   when sass89-hmma (bad-case j)
    is Sass89Refused (why) -> print-line-uni (show j & " " & why)
    is Sass89Words (lo) (hi) -> print-line-uni (show j & " ACCEPTED")
  end

  report-all : Integer -> [Console] Nothing
  report-all (j) = act
   if j >= 18 then print-text "" else act
    report-bad j
    report-all (j + 1)
   end
  end

  opening : [Console] Nothing = report-all 0
