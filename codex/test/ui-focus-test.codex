Chapter: UiFocusTest
  cites UI chapter Theme
  cites UI chapter BoxModel
  cites UI chapter Layout
  cites UI chapter Widget
  cites UI chapter Focus

Section: Body

  test-focus-new : Text =
    let fr = focus-ring ["inp1", "inp2", "btn1"]
    in format-focus fr

  test-focus-next : Text =
    let fr = focus-ring ["a", "b", "c"]
    in let fr2 = focus-next (focus-next fr)
    in "current=" & focus-current fr2

  test-focus-prev : Text =
    let fr = focus-ring ["a", "b", "c"]
    in let fr2 = focus-next fr
    in let fr3 = focus-prev fr2
    in "current=" & focus-current fr3

  test-focus-wrap : Text =
    let fr = focus-ring ["x", "y"]
    in let fr2 = focus-next (focus-next (focus-next fr))
    in "wrapped=" & focus-current fr2

  test-focus-set : Text =
    let fr = focus-ring ["a", "b", "c"]
    in let fr2 = focus-set fr "c"
    in "set=" & focus-current fr2

  test-focus-clear : Text =
    let fr = focus-next (focus-ring ["a", "b"])
    in let fr2 = focus-clear fr
    in "has=" & foc-bool (focus-has-focus fr2)

  test-focus-is : Text =
    let fr = focus-next (focus-ring ["a", "b"])
    in "a=" & foc-bool (focus-is-focused fr "a") & " b=" & foc-bool (focus-is-focused fr "b")

  test-focus-add : Text =
    let fr = focus-ring ["a"]
    in let fr2 = focus-add fr "b"
    in "count=" & show (fr2.fr-count)

  test-focus-remove : Text =
    let fr = focus-ring ["a", "b", "c"]
    in let fr2 = focus-remove fr "b"
    in "count=" & show (fr2.fr-count)

  test-focus-apply : Text =
    let btn = widget-button "btn1" "Click"
    in let inp = widget-input "inp1" "" 0
    in let panel = widget-panel "root" DirColumn 0 [btn, inp]
    in let fr = focus-set (focus-ring ["btn1", "inp1"]) "inp1"
    in let applied = focus-apply fr panel
    in let child = list-at (applied.wn-children) 1
    in "state=" & show (child.wn-state)

  foc-bool : Boolean -> Text
  foc-bool (b) = if b then "true" else "false"

  opening : [Console] Nothing = act
    print-line-uni test-focus-new
    print-line-uni test-focus-next
    print-line-uni test-focus-prev
    print-line-uni test-focus-wrap
    print-line-uni test-focus-set
    print-line-uni test-focus-clear
    print-line-uni test-focus-is
    print-line-uni test-focus-add
    print-line-uni test-focus-remove
    print-line-uni test-focus-apply
  end

