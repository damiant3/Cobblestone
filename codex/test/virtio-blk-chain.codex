Chapter: VirtioBlkChainTest
  cites Kernel chapter VirtioBlk
  cites Foreword chapter Console

 Crafted descriptor tables of eight entries; only each `next` field matters.

Section: Probe

  set-next : Integer, Integer, Integer -> Integer
  set-next (base) (idx) (nxt) = poke-16 base (idx * 16 + 14) nxt

  yn : Boolean -> Text
  yn (b) = if b then "ok" else "refused"

  report : Text, VblkChain -> Text
  report (label) (c) = label & ": " & yn (c.ok) & (if c.ok then " " & show (c.d1-idx) & " " & show (c.d2-idx) & " " & show (c.next-free) else "")

  table : Integer, Integer, Integer, Integer, Integer -> Integer
  table (n0) (n1) (n2) (n3) (n4) =
   let base = alloc-bytes 128
   in let a = set-next base 0 n0
   in let b = set-next base 1 n1
   in let c = set-next base 2 n2
   in let d = set-next base 3 n3
   in let e = set-next base 4 n4
   in base

  opening : [Console] Nothing = act
   print-line-uni (report "well-formed" (vblk-chain (table 1 2 3 4 5) 8 0))
   print-line-uni (report "index past the ring" (vblk-chain (table 9 2 3 4 5) 8 0))
   print-line-uni (report "next out of range" (vblk-chain (table 1 40000 3 4 5) 8 0))
   print-line-uni (report "two-step cycle" (vblk-chain (table 1 0 3 4 5) 8 0))
   print-line-uni (report "free aliases head" (vblk-chain (table 1 2 0 4 5) 8 0))
   print-line-uni (report "head past the ring" (vblk-chain (table 1 2 3 4 5) 8 8))
  end