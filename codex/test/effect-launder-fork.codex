Chapter: EffectLaunderFork
  cites Foreword chapter Console

Section: Definitions

  boom : Integer -> [Console] Integer
  boom (n) = act
    print-line-uni "boom"
    n
  end

  spawn-quiet : Integer -> Integer
  spawn-quiet (n) =
   let t = fork (\x -> boom 7)
   in n + 1

  opening : [Console] Nothing = act
    print-line-uni ("result " & show (spawn-quiet 41))
  end
