Chapter: ListTailEmpty

  cites Foreword chapter Console
  cites Foreword chapter ListUtils

Section: Body

  no-ints : List Integer
  no-ints = []

  opening : [Console] Nothing = act
    let empty = list-tail no-ints
    in let three = list-tail [1, 2, 3]
    in let one = list-tail [7]
    in act
      print-line-uni ("empty-len " & show (list-length empty))
      print-line-uni ("three-len " & show (list-length three))
      print-line-uni ("three-first " & show (list-at three 0))
      print-line-uni ("three-last " & show (list-at three 1))
      print-line-uni ("one-len " & show (list-length one))
    end
  end