Chapter: Ctor Field Arrow
  cites Foreword chapter Console

Section: Body

  Shape =
    | Pair (Integer) (Text)
    | Maker (Integer, Integer -> Text) (Text)
    | Boxed ((Integer, Text))

  run : Shape -> Text
  run (s) =
    when s
      is Pair (n) (t) -> t & show n
      is Maker (f) (t) -> t & f 2 3
      is Boxed (p) -> "boxed"

  opening : [Console] Nothing = act
    print-line-uni (run (Pair 7 "pair"))
    print-line-uni (run (Maker (\a b -> show (a * b)) "maker"))
  end
