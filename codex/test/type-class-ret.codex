Chapter: TypeClassRet
  cites Foreword chapter Console

 Return-type polymorphism: zero-val takes no value argument, so the
 instance is chosen by the expected result type at the use site.

class Zeroed where
  zero-val : a

instance Zeroed Integer where
  zero-val = 0

instance Zeroed Text where
  zero-val = "none"

Section: Opening

  pick-int : Integer
  pick-int = zero-val

  pick-text : Text
  pick-text = zero-val

  opening : [Console] Nothing
  opening = act
   print-line-uni (show pick-int)
   print-line-uni pick-text
  end
