Chapter: Fe310Drivers

  cites Boards chapter Fe310Board

 Smoke test for SiFive FE310 (HiFive1 Rev B) board drivers.
 MMIO stubs return 0. Exercises GPIO (with IOF select), UART,
 QSPI, PWM, and PLIC.

 The driver functions declare [Device.Mmio], so this test declares it
 too. It cannot not: a test chapter is not on the effect-exemption list,
 which means the row the drivers carry is checked right here, at the
 first caller outside the quire. Each test returns 1 when its driver
 calls all complete; the seven sum to the expected 7.

Section: Definitions

  test-gpio : [Device.Mmio] Integer
  test-gpio = act
   a <- fe310-gpio-set-output 19
   b <- fe310-gpio-set-input 4
   c <- fe310-gpio-set-pull 4 True
   d <- fe310-gpio-write 19 True
   e <- fe310-gpio-read 4
   f <- fe310-gpio-toggle 19
   g <- (fe310-gpio-set-iof 16 0)
   1
  end

  test-led : [Device.Mmio] Integer
  test-led = act
   a <- fe310-led-init
   b <- fe310-led-on fe310-led-green
   c <- (fe310-led-off fe310-led-green)
   1
  end

  test-uart : [Device.Mmio] Integer
  test-uart = act
   a <- fe310-uart-init fe310-uart0-base 115200
   b <- fe310-uart-send-byte fe310-uart0-base 65
   c <- fe310-uart-print fe310-uart0-base "hello"
   d <- (fe310-uart-println fe310-uart0-base "world")
   1
  end

  test-spi : [Device.Mmio] Integer
  test-spi = act
   a <- fe310-spi-init fe310-spi1-base
   b <- (fe310-spi-transfer fe310-spi1-base #AA)
   1
  end

  test-pwm : [Device.Mmio] Integer
  test-pwm = act
   a <- fe310-pwm-init fe310-pwm0-base 4
   b <- fe310-pwm-set-cmp fe310-pwm0-base 0 128
   c <- (fe310-pwm-set-cmp fe310-pwm0-base 1 64)
   1
  end

  test-plic : [Device.Mmio] Integer
  test-plic = act
   a <- fe310-plic-set-priority 3 5
   b <- fe310-plic-enable-irq 3
   c <- fe310-plic-set-threshold 0
   d <- fe310-plic-claim
   e <- (fe310-plic-complete 0)
   1
  end

 The delay is pure -- it spins on the CPU and touches nothing -- so it
 is bound with a plain let, not an act-bind. If someone gives it a
 register access later, this line stops compiling.

  test-delay : Integer
  test-delay =
   let a = fe310-delay-ms 1
   in 1

  opening : [Device.Mmio] Integer = act
   g <- test-gpio
   l <- test-led
   u <- test-uart
   s <- test-spi
   p <- test-pwm
   pl <- test-plic
   g + l + u + s + p + pl + test-delay
  end

