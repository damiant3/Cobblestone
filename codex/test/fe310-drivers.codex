Chapter: Fe310Drivers

  cites Boards chapter Fe310Board

Section: Definitions

  test-gpio : [Device.Mmio] Integer
  test-gpio = act
   a <- fe310-gpio-set-output 19
   b <- fe310-gpio-set-input 4
   c <- fe310-gpio-set-pull 4 True
   d <- fe310-gpio-write 19 True
   e <- fe310-gpio-read 4
   f <- fe310-gpio-toggle 19
   g <- (fe310-gpio-set-iof 16 0)
   1
  end

  test-led : [Device.Mmio] Integer
  test-led = act
   a <- fe310-led-init
   b <- fe310-led-on fe310-led-green
   c <- (fe310-led-off fe310-led-green)
   1
  end

  test-uart : [Device.Mmio] Integer
  test-uart = act
   a <- fe310-uart-init fe310-uart0-base 115200
   b <- fe310-uart-send-byte fe310-uart0-base 65
   c <- fe310-uart-print fe310-uart0-base "hello"
   d <- (fe310-uart-println fe310-uart0-base "world")
   1
  end

  test-spi : [Device.Mmio] Integer
  test-spi = act
   a <- fe310-spi-init fe310-spi1-base
   b <- (fe310-spi-transfer fe310-spi1-base #AA)
   1
  end

  test-uart-linear : [Uart, Device.Mmio] Integer
  test-uart-linear = act
   p0 <- fe310-uart-open fe310-uart0-base 115200
   p1 <- fe310-uart-write p0 72
   p2 <- (fe310-uart-write p1 73)
   c <- (fe310-uart-close p2)
   1
  end

  test-gpio-linear : [Gpio, Device.Mmio] Integer
  test-gpio-linear = act
   q0 <- fe310-gpio-open 19 PinOutput
   q1 <- fe310-pin-write q0 True
   q2 <- (fe310-pin-write q1 False)
   c <- (fe310-pin-close q2)
   1
  end

  test-pwm : [Device.Mmio] Integer
  test-pwm = act
   a <- fe310-pwm-init fe310-pwm0-base 4
   b <- fe310-pwm-set-cmp fe310-pwm0-base 0 128
   c <- (fe310-pwm-set-cmp fe310-pwm0-base 1 64)
   1
  end

  test-plic : [Device.Mmio] Integer
  test-plic = act
   a <- fe310-plic-set-priority 3 5
   b <- fe310-plic-enable-irq 3
   c <- fe310-plic-set-threshold 0
   d <- fe310-plic-claim
   e <- (fe310-plic-complete 0)
   1
  end

  test-delay : Integer
  test-delay =
   let a = fe310-delay-ms 1
   in 1

  test-pin-read : [Gpio, Device.Mmio] Integer
  test-pin-read = act
   q0 <- fe310-gpio-open 19 PinInput
   r <- fe310-pin-read q0
   when r
    is (q1, lv) -> act
      c <- (fe310-pin-close q1)
      1
    end
  end

  test-spi-txn : [Spi, Device.Mmio] Integer
  test-spi-txn = act
   s0 <- fe310-spi-open fe310-spi1-base
   t0 <- fe310-spi-select s0 9
   r <- fe310-spi-txn-transfer t0 [#AA, #55]
   when r
    is (t1, got) -> act
      s1 <- fe310-spi-deselect t1
      c <- (fe310-spi-close s1)
      if list-length got == 2 then 1 else 0
    end
  end

  test-uart-recv : [Uart, Device.Mmio] Integer
  test-uart-recv = act
   p0 <- fe310-uart-open fe310-uart0-base 115200
   r <- fe310-uart-recv p0 1
   when r
    is (p1, bytes) -> act
      c <- (fe310-uart-close p1)
      if list-length bytes == 1 then 1 else 0
    end
  end

  opening : [Gpio, Uart, Spi, Device.Mmio] Integer = act
   g <- test-gpio
   l <- test-led
   u <- test-uart
   s <- test-spi
   p <- test-pwm
   pl <- test-plic
   ul <- test-uart-linear
   gl <- test-gpio-linear
   pr <- test-pin-read
   ur <- test-uart-recv
   st <- test-spi-txn
   g + l + u + s + p + pl + ul + gl + pr + ur + st + test-delay
  end

