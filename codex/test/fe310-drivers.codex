Chapter: Fe310Drivers

  cites Boards chapter Fe310Board

 Smoke test for SiFive FE310 (HiFive1 Rev B) board drivers.
 MMIO stubs return 0. Exercises GPIO (with IOF select), UART,
 QSPI, PWM, and PLIC.

Section: Definitions

  test-gpio : Integer
  test-gpio =
   let a = fe310-gpio-set-output 19
   in let b = fe310-gpio-set-input 4
   in let c = fe310-gpio-set-pull 4 True
   in let d = fe310-gpio-write 19 True
   in let e = fe310-gpio-read 4
   in let f = fe310-gpio-toggle 19
   in let g = fe310-gpio-set-iof 16 0
   in 1

  test-led : Integer
  test-led =
   let a = fe310-led-init
   in let b = fe310-led-on fe310-led-green
   in let c = fe310-led-off fe310-led-green
   in 1

  test-uart : Integer
  test-uart =
   let a = fe310-uart-init fe310-uart0-base 115200
   in let b = fe310-uart-send-byte fe310-uart0-base 65
   in let c = fe310-uart-print fe310-uart0-base "hello"
   in let d = fe310-uart-println fe310-uart0-base "world"
   in 1

  test-spi : Integer
  test-spi =
   let a = fe310-spi-init fe310-spi1-base
   in let b = fe310-spi-transfer fe310-spi1-base #AA
   in 1

  test-pwm : Integer
  test-pwm =
   let a = fe310-pwm-init fe310-pwm0-base 4
   in let b = fe310-pwm-set-cmp fe310-pwm0-base 0 128
   in let c = fe310-pwm-set-cmp fe310-pwm0-base 1 64
   in 1

  test-plic : Integer
  test-plic =
   let a = fe310-plic-set-priority 3 5
   in let b = fe310-plic-enable-irq 3
   in let c = fe310-plic-set-threshold 0
   in let d = fe310-plic-claim
   in let e = fe310-plic-complete 0
   in 1

  test-delay : Integer
  test-delay =
   let a = fe310-delay-ms 1
   in 1

  opening : Integer =
   let g = test-gpio
   in let l = test-led
   in let u = test-uart
   in let s = test-spi
   in let p = test-pwm
   in let pl = test-plic
   in let d = test-delay
   in g + l + u + s + p + pl + d

