Chapter: KeyboardRgbHsvTest
  cites Dev chapter KeyboardRgb

Section: Entry
  krh : Text, Integer -> Text
  krh (name) (packed) = let c = rgb-packed-to-hsv packed in " " & name & " " & show c.hsv-h & "/" & show c.hsv-s & "/" & show c.hsv-v

  opening : [Console] Nothing = act
    print-line-uni ("hsv" & krh "red" #FF0000 & krh "green" #00FF00 & krh "blue" #0000FF & krh "magenta" #FF00FF & krh "orange" #FF8000)
    print-line-uni ("hsv" & krh "yellow" #FFFF00 & krh "cyan" #00FFFF & krh "grey" #808080 & krh "black" 0)
    print-line-uni (format-keyboard-rgb (kbd-rgb-set-palette keyboard-rgb-new PalOcean))
  end
