Section: Wire Fixtures
  srv-mac : List Integer = [82, 84, 0, 18, 52, 86]
  cli-mac : List Integer = [82, 85, 10, 0, 2, 2]
  srv-ip : List Integer = [10, 0, 2, 15]
  cli-ip : List Integer = [10, 0, 2, 100]
  gw-ip : List Integer = [10, 0, 2, 2]

  get-bytes : List Integer = [71, 69, 84, 32, 47, 32, 72, 84, 84, 80, 47, 49, 46, 49, 13, 10, 13, 10]

  psh : Integer = bit-or tcp-flag-psh tcp-flag-ack

  mkc : Integer, Integer, Integer, List Integer -> List Integer
  mkc (seq) (ack) (flags) (payload) =
    let seg = tcp-with-checksum (tcp-build-segment 50000 80 seq ack flags 8192 payload) cli-ip srv-ip
    in let ip = ip-build-packet cli-ip srv-ip ip-proto-tcp seg
    in eth-build-frame srv-mac cli-mac eth-type-ipv4 ip

Section: Server Session
  srv0 : NetSession = net-session-new srv-mac srv-ip gw-ip 80 0 cli-ip 5000

  established : NetSession =
    let s1 = (net-process-frame (net-listen srv0).session (mkc 1000 0 tcp-flag-syn [])).session
    in set-outbox ((net-process-frame s1 (mkc 1001 5001 psh get-bytes)).session) []

Section: The Loop Body

  ack-run : TcpTransportState, List Integer, Integer -> TcpTransportState
  ack-run (ts) (frame) (n) =
    if n <= 0 then ts
    else let r = transport-process-frame-within ts frame (list-length frame)
    in let cleared = transport-set-session (r.transport) (set-outbox ((r.transport).session) [])
    in ack-run cleared frame (n - 1)

  grown : TcpTransportState, List Integer, Integer -> Integer
  grown (ts) (frame) (n) =
    let h0 = __heap-save
    in let t = ack-run ts frame n
    in let h1 = __heap-save
    in if net-io-conn-closed t then 0 - 1 else h1 - h0

  compacted-run : TcpTransportState, List Integer, Integer, Integer -> TcpTransportState
  compacted-run (ts) (frame) (n) (mark) =
    if n <= 0 then ts
    else let r = transport-process-frame-within ts frame (list-length frame)
    in let cleared = transport-set-session (r.transport) (set-outbox ((r.transport).session) [])
    in compacted-run (transport-compact-past cleared mark) frame (n - 1) mark

  CompactedReading = record { over : Integer, cgen : Integer, alive : Boolean, rn : Integer }

  compacted : TcpTransportState, List Integer, Integer -> CompactedReading
  compacted (ts) (frame) (n) =
    let ta = transport-arenas ts
    in let mark = __heap-save
    in let t = compacted-run ta frame n mark
    in let over = __heap-save - mark
    in CompactedReading { over = over, cgen = t.gen, alive = net-io-conn-closed t == False, rn = ((t.session).conn).recv-next }

Section: Entry
  opening : [Console] Nothing = act
    let ts = transport-new-with-cap established 65536
    in let ack = mkc 1019 5001 tcp-flag-ack []
    in let one = grown ts ack 1
    in let d100 = grown ts ack 100
    in let d1000 = grown ts ack 1000
    in let c100 = compacted ts ack 100
    in let c1000 = compacted ts ack 1000
    in let bound = net-compact-bytes + one
    in act
      print-line-uni ("still established after 1100 acks: " & (if d100 >= 0 & d1000 >= 0 then "yes" else "no"))
      print-line-uni ("uncompacted, 100 acks retain heap: " & (if d100 > 0 then "yes" else "no"))
      print-line-uni ("uncompacted, 1000 acks retain nine to eleven times as much: " & (if d1000 >= 9 * d100 & d1000 <= 11 * d100 then "yes" else "no"))
      print-line-uni ("uncompacted, 1000 acks pass the compaction threshold: " & (if d1000 > net-compact-bytes then "yes" else "no"))
      print-line-uni ("compacted, 1000 acks compacted at least once: " & (if c1000.cgen > 0 then "yes" else "no"))
      print-line-uni ("compacted, heap above the mark within one arena and one frame at 100 and 1000: " & (if c100.over <= bound & c1000.over <= bound then "yes" else "no"))
      print-line-uni ("compacted, still established with the same recv-next: " & (if c1000.alive & c1000.rn == c100.rn then "yes" else "no"))
    end
  end

