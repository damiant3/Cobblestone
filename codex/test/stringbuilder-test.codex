Chapter: StringBuilder Test

  cites Foreword chapter Console
  cites Foreword chapter StringBuilder

Section: Definitions

  test-stringbuilder : Text =
    let sb = sb-append (sb-append (sb-append sb-new "hello") " ") "world"
    in sb-to-text sb & "\n" & show (sb-length sb) & "\n" & sb-join ", " ["alpha", "beta", "gamma"] & "\n" & sb-to-text (sb-append-int (sb-append sb-new "count=") 42)

  opening : [Console] Nothing = act
    print-line-uni test-stringbuilder
  end

