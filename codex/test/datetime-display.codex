Chapter: DateTimeDisplayTest
  cites Dev chapter DateTimeSettings

Section: Entry
  opening : [Console] Nothing = act
    print-line-uni ("new " & dt-format-full datetime-new)
    a <- dt-set-date (dt-set-time datetime-new 9 4 0) 2026 3 7
    print-line-uni ("24h " & dt-format-full a)
    b <- dt-toggle-format (dt-set-time a 0 5 0)
    print-line-uni ("12h midnight " & dt-format-time b)
    print-line-uni ("12h noon " & dt-format-time (dt-set-time b 12 30 0))
    print-line-uni ("12h afternoon " & dt-format-time (dt-set-time b 13 7 0))
    c <- dt-set-timezone (dt-toggle-format (dt-set-time b 10 59 59)) (dt-zone-fixed "EST" (0 - 18000) "EST")
    d <- dt-tick c
    print-line-uni ("tick " & dt-format-full d & " s=" & show d.dt-second)
  end
