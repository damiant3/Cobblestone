Chapter: DateTimeWeekday
  cites Foreword chapter DateTime
  cites Foreword chapter Console

 day-of-week answers 0 for Sunday through 6 for Saturday, before 1970 too.

Section: Body

  line : Text, Integer -> Text
  line (label) (ts) = label & " " & show (day-of-week ts) & " " & day-of-week-name (day-of-week ts)

  opening : [Console] Nothing = act
    print-line-uni (line "1970-01-01" 0)
    print-line-uni (line "1969-12-31 23:59:59" (0 - 1))
    print-line-uni (line "2000-02-29" 951782400)
    print-line-uni (line "2026-11-01" 1793491200)
  end