Chapter: BluetoothPairingTest
  cites Dev chapter Bluetooth
  cites Foreword chapter Maybe

Section: Entry
  bpt-battery : BluetoothState, Text -> Integer
  bpt-battery (st) (addr) = when bt-find-device st addr is None -> -2 is Just (d) -> d.bd-battery

  opening : [Console] Nothing = act
    a <- bt-add-device (bt-add-device (bt-add-device (bt-toggle bluetooth-new) (bt-device-new "aa" "Buds" BtAudio)) (bt-device-new "bb" "Keys" BtKeyboard)) (bt-device-new "cc" "Pad" BtGamepad)
    print-line-uni ("added " & format-bluetooth a)
    p <- bt-connect (bt-pair (bt-pair a "aa") "bb") "aa"
    print-line-uni ("paired two, connected one " & format-bluetooth p & " paired-list " & show (list-length (bt-paired-devices p)))
    u <- bt-unpair p "aa"
    print-line-uni ("unpair aa " & format-bluetooth u)
    print-line-uni ("unknown pair " & format-bluetooth (bt-pair u "zz"))
    b <- bt-update-battery u "bb" 64
    print-line-uni ("battery bb " & show (bpt-battery b "bb") & " cc " & show (bpt-battery b "cc") & " zz " & show (bpt-battery b "zz"))
  end
