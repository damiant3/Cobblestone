Chapter: KeysMods

  cites UI chapter KeyInput

 The `.keys` timeline types: Caps (58), `a`, Caps (58), `a`, Ctrl (29),
 `a`, Ctrl-up (157 = 29 | 0x80), Enter. Each collected key is followed by
 the `poll-mods` reading at that moment, so the flat list is
 key, mods, key, mods, ... The three keys must be:

   65 0   -- caps on, no shift: `A`; poll-mods 0 (caps is not in the mask)
   97 0   -- caps off: `a`; no modifiers held
   97 2   -- ctrl held: still `a` (ctrl does not case a letter), poll-mods
            = 2, which is `mod-ctrl` in UI Event

Section: Definitions

  km-collect : List Integer -> List Integer
  km-collect (acc) =
    let ch = poll-key
    in if ch == 0 then km-collect acc
    else if ch == key-enter then acc
    else km-collect (list-push (list-push acc ch) poll-mods)

  km-show : List Integer, Integer, Integer -> [Console] Integer
  km-show (xs) (i) (len) =
    if i >= len then 0
    else act
      print-line-uni (integer-to-text (list-at xs i))
      km-show xs (i + 1) len
    end

  opening : [Console] Nothing = act
    let ks = km-collect []
    in act
      km-show ks 0 (list-length ks)
      print-line-uni "mods"
    end
  end
