Chapter: TypeClassGeneric
  cites Foreword chapter Console

 A generic function constrained by a class with multiple instances.
 describe is compiled once over a type variable; the matching instance
 dictionary is supplied at each call site by the argument's type.

class Showable where
  to-text : a -> Text

instance Showable Integer where
  to-text (x) = show x

instance Showable Boolean where
  to-text (b) = if b then "yes" else "no"

Section: Opening

  describe : Showable a => a -> Text
  describe (x) = "Value: " & to-text x

  opening : [Console] Nothing
  opening = act
   print-line-uni (describe 99)
   print-line-uni (describe True)
  end
