Chapter: LeafLetIf

  cites Foreword chapter Console

Section: Body

  nd : Integer, Integer -> Integer
  nd (current) (total) = let next = current + 1 in if next >= total then 0 else next

  opening : [Console] Nothing = act
    print-line-uni ("nd 2 4 = " & show (nd 2 4))
    print-line-uni ("nd 9 4 = " & show (nd 9 4))
    print-line-uni ("nd 0 1 = " & show (nd 0 1))
  end

