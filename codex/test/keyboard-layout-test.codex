Section: Greek Tests
  test-el-name : Text =
    format-layout kbl-el

  test-el-alpha : Text =
    let l = kbl-el
    in let cce = kbl-lookup (l.kbl-base) 30
    in "el-alpha=" & show (to-unicode cce)

  test-el-sigma : Text =
