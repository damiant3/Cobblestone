Section: Registry
  test-all-layouts : Text =
    "layouts=" & show (list-length kbl-list-names)

  test-lookup-de : Text =
    let l = kbl-by-name "DE"
    in l.kbl-name

  test-lookup-fi : Text =
    let l = kbl-by-name "FI"
    in l.kbl-name

  test-lookup-unknown : Text =
    let l = kbl-by-name "XX"
    in l.kbl-name

  opening : [Console] Nothing = act
    print-line-uni test-us-name
    print-line-uni test-us-a
    print-line-uni test-us-z
    print-line-uni test-us-shift-1
    print-line-uni test-de-name
    print-line-uni test-de-z-is-y
    print-line-uni test-de-y-is-z
    print-line-uni test-de-umlaut-u
    print-line-uni test-de-umlaut-o
    print-line-uni test-de-umlaut-a
    print-line-uni test-de-eszett
    print-line-uni test-fr-name
    print-line-uni test-fr-a-is-q
    print-line-uni test-fr-e-accent
    print-line-uni test-fr-c-cedilla
    print-line-uni test-es-name
    print-line-uni test-es-enye
    print-line-uni test-es-shift-enye
    print-line-uni test-dead-acute-e
    print-line-uni test-dead-grave-a
    print-line-uni test-dead-circumflex-o
    print-line-uni test-dead-diaeresis-u
    print-line-uni test-dead-tilde-n
    print-line-uni test-dead-cedilla-c
    print-line-uni test-uk-pound
    print-line-uni test-pt-cedilla
    print-line-uni test-it-egrave
    print-line-uni test-it-ograve
    print-line-uni test-se-aring
    print-line-uni test-se-odiaeresis
    print-line-uni test-no-oslash
    print-line-uni test-no-ae
    print-line-uni test-tr-gbreve
    print-line-uni test-tr-scedilla
    print-line-uni test-ru-name
    print-line-uni test-ru-a
    print-line-uni test-ru-shift-a
    print-line-uni test-ru-ya
    print-line-uni test-el-name
    print-line-uni test-el-alpha
    print-line-uni test-el-sigma
    print-line-uni test-el-shift-alpha
    print-line-uni test-all-layouts
    print-line-uni test-lookup-de
    print-line-uni test-lookup-fi
    print-line-uni test-lookup-unknown
  end

