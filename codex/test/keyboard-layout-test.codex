Chapter: KeyboardLayoutTest
  cites Foreword chapter KeyboardLayout
  cites Foreword chapter CCE

Section: US Layout Tests
  test-us-name : Text =
    let l = kbl-us
    in format-layout l

  test-us-a : Text =
    let l = kbl-us
    in let cce = kbl-lookup (l.kbl-base) 30
    in "us-a=" & show (to-unicode cce)

  test-us-z : Text =
    let l = kbl-us
    in let cce = kbl-lookup (l.kbl-base) 44
    in "us-z=" & show (to-unicode cce)

  test-us-shift-1 : Text =
    let l = kbl-us
    in let cce = kbl-lookup (l.kbl-shift) 2
    in "us-!=" & show (to-unicode cce)

Section: German Layout Tests
  test-de-name : Text =
    let l = kbl-de
    in format-layout l

  test-de-z-is-y : Text =
    let l = kbl-de
    in let cce = kbl-lookup (l.kbl-base) 21
    in "de-sc21=" & show (to-unicode cce)

  test-de-y-is-z : Text =
    let l = kbl-de
    in let cce = kbl-lookup (l.kbl-base) 44
    in "de-sc44=" & show (to-unicode cce)

  test-de-umlaut-u : Text =
    let l = kbl-de
    in let cce = kbl-lookup (l.kbl-base) 26
    in "de-ue=" & show (to-unicode cce)

  test-de-umlaut-o : Text =
    let l = kbl-de
    in let cce = kbl-lookup (l.kbl-base) 39
    in "de-oe=" & show (to-unicode cce)

  test-de-umlaut-a : Text =
    let l = kbl-de
    in let cce = kbl-lookup (l.kbl-base) 40
    in "de-ae=" & show (to-unicode cce)

  test-de-eszett : Text =
    let l = kbl-de
    in let cce = kbl-lookup (l.kbl-base) 12
    in "de-ss=" & show (to-unicode cce)

Section: French Layout Tests
  test-fr-name : Text =
    let l = kbl-fr
    in format-layout l

  test-fr-a-is-q : Text =
    let l = kbl-fr
    in let cce = kbl-lookup (l.kbl-base) 16
    in "fr-sc16=" & show (to-unicode cce)

  test-fr-e-accent : Text =
    let l = kbl-fr
    in let cce = kbl-lookup (l.kbl-base) 3
    in "fr-sc3=" & show (to-unicode cce)

  test-fr-c-cedilla : Text =
    let l = kbl-fr
    in let cce = kbl-lookup (l.kbl-base) 10
    in "fr-sc10=" & show (to-unicode cce)

Section: Spanish Layout Tests
  test-es-name : Text =
    let l = kbl-es
    in format-layout l

  test-es-enye : Text =
    let l = kbl-es
    in let cce = kbl-lookup (l.kbl-base) 39
    in "es-enye=" & show (to-unicode cce)

  test-es-shift-enye : Text =
    let l = kbl-es
    in let cce = kbl-lookup (l.kbl-shift) 39
    in "es-Enye=" & show (to-unicode cce)

Section: Dead Key Tests
  test-dead-acute-e : Text =
    let ds = DeadState { ds-pending = 1 }
    in let result = dead-combine ds 13
    in "acute-e=" & show (to-unicode result)

  test-dead-grave-a : Text =
    let ds = DeadState { ds-pending = 2 }
    in let result = dead-combine ds 15
    in "grave-a=" & show (to-unicode result)

  test-dead-circumflex-o : Text =
    let ds = DeadState { ds-pending = 3 }
    in let result = dead-combine ds 16
    in "circ-o=" & show (to-unicode result)

  test-dead-diaeresis-u : Text =
    let ds = DeadState { ds-pending = 4 }
    in let result = dead-combine ds 25
    in "diaer-u=" & show (to-unicode result)

  test-dead-tilde-n : Text =
    let ds = DeadState { ds-pending = 5 }
    in let result = dead-combine ds 18
    in "tilde-n=" & show (to-unicode result)

  test-dead-cedilla-c : Text =
    let ds = DeadState { ds-pending = 6 }
    in let result = dead-combine ds 24
    in "cedil-c=" & show (to-unicode result)

Section: UK Tests
  test-uk-pound : Text =
    let l = kbl-uk
    in let cce = kbl-lookup (l.kbl-shift) 4
    in "uk-pound=" & show (to-unicode cce)

