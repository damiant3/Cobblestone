Chapter: MethodTemplateContractLookalike

Section: Types

  PretendContractDict a b = record {
    pretend-value-impl : a, b -> b
  }

Section: Functions

  pretend-value-Integer : Integer, Boolean -> Boolean
  pretend-value-Integer (x) (y) = not y

  PretendContract-dict-Integer : PretendContractDict Integer Boolean
  PretendContract-dict-Integer = PretendContractDict {
    pretend-value-impl = pretend-value-Integer
  }

  opening : [Console] Nothing = act
    let d = PretendContract-dict-Integer
    in print-line-uni (show ((d.pretend-value-impl) 1 True))
  end
