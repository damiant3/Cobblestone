Chapter: Arm64NetGate

Section: Entry

  opening : [Console, Network, Capability] Nothing = act
    let pid = process-get-pid
    in act
      before <- net-status
      print-line-uni ("granted " & show (before >= 0))
      print-line-uni ("hwaddr-9 " & show (net-get-hwaddr 9))
      r <- process-restrict-cap pid 8
      print-line-uni ("restrict-read " & show r)
      after <- net-status
      print-line-uni ("status-denied " & show after)
      print-line-uni ("hwaddr-denied " & show (net-get-hwaddr 0))
      print-line-uni ("recv-denied " & show (net-recv-raw 0))
      w <- process-restrict-cap pid 9
      print-line-uni ("restrict-write " & show w)
      print-line-uni ("send-denied " & show (net-send-raw 0 0))
    end
  end