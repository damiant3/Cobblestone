Chapter: GpuLinearWmma

  cites Kernel chapter GpuBridge
  cites Gpu chapter GemmPtx

   Each shape checks every output entry against a CPU x W^T + b, with M,
   N and K all leaving a partial tile. The bias is (n mod 9) - 4, so the
   sabotage arm, which launches without the bias, leaves exactly the
   columns with n mod 9 = 4 unchanged: 77 x 22 = 1694 of the first shape.

 We say:

Section: Fill

  ptx-fill : Text
  ptx-fill =
    let a = ".version 7.0\n.target sm_60\n.address_size 64\n\n.visible .entry fill(.param .u64 p_out, .param .u32 p_n, .param .u32 p_mul, .param .u32 p_mod, .param .u32 p_bias)\n{\n"
    in let b = ".reg .pred %p<2>;\n.reg .b32 %r<12>;\n.reg .b64 %rd<6>;\n.reg .f32 %f<2>;\n.reg .b16 %h<2>;\n"
    in let c = "ld.param.u64 %rd1, [p_out];\nld.param.u32 %r1, [p_n];\nld.param.u32 %r2, [p_mul];\nld.param.u32 %r3, [p_mod];\nld.param.u32 %r4, [p_bias];\n"
    in let d = "mov.u32 %r5, %ctaid.x;\nmov.u32 %r6, %ntid.x;\nmov.u32 %r7, %tid.x;\nmad.lo.s32 %r8, %r5, %r6, %r7;\nsetp.ge.u32 %p1, %r8, %r1;\n@%p1 bra DONE;\n"
    in let e = "mul.lo.u32 %r9, %r8, %r2;\nrem.u32 %r10, %r9, %r3;\nsub.s32 %r11, %r10, %r4;\ncvt.rn.f32.s32 %f1, %r11;\ncvt.rn.f16.f32 %h1, %f1;\n"
    in let f = "cvta.to.global.u64 %rd2, %rd1;\nmul.wide.u32 %rd3, %r8, 2;\nadd.s64 %rd4, %rd2, %rd3;\nst.global.b16 [%rd4], %h1;\nDONE:\nret;\n}\n"
    in a & b & c & d & e & f

  fill : Integer, Integer, Integer, Integer, Integer -> Integer
  fill (h) (count) (mul) (m) (bias) =
    let g = GpuGrid { gx = (count + 255) / 256, gy = 1, gz = 1, bx = 256, by = 1, bz = 1, shared = 0 }
    in let ps = [gpu-arg-buf h 0, gpu-arg-u32 count, gpu-arg-u32 mul, gpu-arg-u32 m, gpu-arg-u32 bias]
    in gpu-launch ptx-fill "fill" g ps

  x-at : Integer -> Integer
  x-at (i) = int-mod (i * 7) 17 - 8

  w-at : Integer -> Integer
  w-at (i) = int-mod (i * 13) 11 - 5

  b-at : Integer -> Integer
  b-at (n) = int-mod n 9 - 4

Section: Bias Upload

  scratch : Integer = #BD700000

  top-bit : Integer, Integer -> Integer
  top-bit (m) (e) = if bit-shru m (e + 1) == 0 then e else top-bit m (e + 1)

  f32-bits : Integer -> Integer
  f32-bits (v) =
    if v == 0 then 0
    else let mag = if v < 0 then 0 - v else v
    in let e = top-bit mag 0
    in let sign = if v < 0 then #80000000 else 0
    in bit-or sign (bit-or (bit-shl (127 + e) 23) (bit-and (bit-shl mag (23 - e)) #7FFFFF))

  put-bias : Integer, Integer -> Integer
  put-bias (i) (nn) =
    if i >= nn then nn
    else let p = poke-32 scratch (i * 4) (f32-bits (b-at i))
    in put-bias (i + 1) nn

Section: Reference

  ref-dot : Integer, Integer, Integer, Integer, Integer -> Integer
  ref-dot (kk) (m) (n) (k) (acc) =
    if k >= kk then acc
    else ref-dot kk m n (k + 1) (acc + x-at (m * kk + k) * w-at (n * kk + k))

  f32-int : Integer -> Integer
  f32-int (bits) =
    if bit-and bits #7FFFFFFF == 0 then 0
    else let e = bit-and (bit-shru bits 23) 255
    in let m = bit-or (bit-and bits #7FFFFF) #800000
    in let mag = if e >= 150 then bit-shl m (e - 150) else bit-shru m (150 - e)
    in if bit-and bits #80000000 /= 0 then 0 - mag else mag

  row-check : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  row-check (kk) (nn) (m) (n) (good) (sum) =
    if n >= nn then good * 1000000 + int-mod (sum + 1000000) 1000000
    else let want = ref-dot kk m n 0 (b-at n)
    in let got = f32-int (peek-32 scratch (n * 4))
    in row-check kk nn m (n + 1) (good + (if got == want then 1 else 0)) (sum + want)

  all-check : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  all-check (hy) (mm) (nn) (kk) (m) (good) (sum) =
    if m >= mm then good * 1000000 + int-mod (sum + 1000000) 1000000
    else if not (gpu-buf-read hy (m * nn * 4) (nn * 4) scratch) then 0 - 1
    else let r = row-check kk nn m 0 0 0
    in all-check hy mm nn kk (m + 1) (good + r / 1000000) (sum + int-mod r 1000000)

Section: Launch

 mode 0 is kernel-linear-wmma, 1 kernel-linear-fast, 2 kernel-linear-fast-n64.

  launch-linear : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Boolean -> Integer
  launch-linear (mode) (hx) (hw) (hb) (hy) (mm) (nn) (kk) (with-bias) =
    let poison = fill hy (mm * nn * 2) 1 1 (0 - 30000)
    in let bias = if with-bias then gpu-arg-buf hb 0 else gpu-arg-u64 0
    in let ps = [gpu-arg-buf hx 0, gpu-arg-buf hw 0, bias, gpu-arg-buf hy 0, gpu-arg-u64 mm, gpu-arg-u64 nn, gpu-arg-u64 kk, gpu-arg-u64 0]
    in let fps = [gpu-arg-buf hx 0, gpu-arg-buf hw 0, bias, gpu-arg-buf hy 0, gpu-arg-u64 mm, gpu-arg-u64 nn, gpu-arg-u64 kk, gpu-arg-u64 0, gpu-arg-u64 0]
    in if poison < 0 then 0 - 1
    else if mode == 1 then gpu-launch gemm-ptx "kernel_linear_fast" (GpuGrid { gx = (nn + 127) / 128, gy = (mm + 127) / 128, gz = 1, bx = 256, by = 1, bz = 1, shared = 40960 }) fps
    else if mode == 2 then gpu-launch gemm-ptx "kernel_linear_fast_n64" (GpuGrid { gx = (nn + 63) / 64, gy = (mm + 127) / 128, gz = 1, bx = 128, by = 1, bz = 1, shared = 30720 }) fps
    else gpu-launch gemm-ptx "kernel_linear_wmma" (GpuGrid { gx = (nn + 63) / 64, gy = (mm + 63) / 64, gz = 1, bx = 128, by = 1, bz = 1, shared = 20480 }) ps

  verdict : Integer, Integer, Integer, Integer, Integer -> Text
  verdict (hy) (mm) (nn) (kk) (launched) =
    if launched < 0 then "launch refused"
    else let t = all-check hy mm nn kk 0 0 0
    in if t < 0 then "read refused"
    else show (t / 1000000) & "/" & show (mm * nn) & ", checksum " & show (int-mod t 1000000)

  case-report : Integer, Integer, Integer, Integer, Boolean -> Text
  case-report (mode) (mm) (nn) (kk) (sabotage) =
    let hx = gpu-buf-alloc (mm * kk * 2)
    in let hw = gpu-buf-alloc (nn * kk * 2)
    in let hb = gpu-buf-alloc (nn * 4)
    in let hy = gpu-buf-alloc (mm * nn * 4)
    in if hx == 0 then "alloc refused"
    else if hw == 0 then "alloc refused"
    else if hb == 0 then "alloc refused"
    else if hy == 0 then "alloc refused"
    else if fill hx (mm * kk) 7 17 8 < 0 then "fill x refused"
    else if fill hw (nn * kk) 13 11 5 < 0 then "fill w refused"
    else if put-bias 0 nn < 0 then "bias refused"
    else if not (gpu-buf-write hb 0 (nn * 4) scratch) then "bias write refused"
    else let v = verdict hy mm nn kk (launch-linear mode hx hw hb hy mm nn kk True)
    in let sab = if sabotage then "; sabotage no bias: " & verdict hy mm nn kk (launch-linear mode hx hw hb hy mm nn kk False) else ""
    in let f1 = gpu-buf-free hx
    in let f2 = gpu-buf-free hw
    in let f3 = gpu-buf-free hb
    in let f4 = gpu-buf-free hy
    in v & sab & (if f1 & f2 & f3 & f4 then "" else "; free refused")

Section: Batched

 count products through one launch, product p's x, W and y p strides along one
 buffer each; the sabotage launches count - 1 of them.

  bref-dot : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  bref-dot (kk) (xo) (wo) (m) (n) (k) (acc) =
    if k >= kk then acc
    else bref-dot kk xo wo m n (k + 1) (acc + x-at (xo + m * kk + k) * w-at (wo + n * kk + k))

  brow-check : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  brow-check (kk) (nn) (xo) (wo) (m) (n) (good) =
    if n >= nn then good
    else let want = bref-dot kk xo wo m n 0 (b-at n)
    in brow-check kk nn xo wo m (n + 1) (good + (if f32-int (peek-32 scratch (n * 4)) == want then 1 else 0))

  bcheck : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  bcheck (hy) (mm) (nn) (kk) (p) (m) (good) =
    if m >= mm then good
    else if not (gpu-buf-read hy ((p * mm + m) * nn * 4) (nn * 4) scratch) then 0 - 1
    else bcheck hy mm nn kk p (m + 1) (good + brow-check kk nn (p * mm * kk) (p * nn * kk) m 0 0)

  bsum : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  bsum (hy) (mm) (nn) (kk) (count) (p) (acc) =
    if p >= count then acc
    else let g = bcheck hy mm nn kk p 0 0
    in if g < 0 then 0 - 1 else bsum hy mm nn kk count (p + 1) (acc + g)

  launch-batched : Boolean, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  launch-batched (fast) (hx) (hw) (hb) (hy) (mm) (nn) (kk) (count) (gz) =
    let poison = fill hy (count * mm * nn * 2) 1 1 (0 - 30000)
    in let ps = [gpu-arg-buf hx 0, gpu-arg-buf hw 0, gpu-arg-buf hb 0, gpu-arg-buf hy 0, gpu-arg-u64 mm, gpu-arg-u64 nn, gpu-arg-u64 kk, gpu-arg-u64 (mm * kk * 2), gpu-arg-u64 (nn * kk * 2), gpu-arg-u64 (mm * nn * 4)]
    in if poison < 0 then 0 - 1
    else if fast then gpu-launch gemm-ptx "kernel_linear_fast_batched" (GpuGrid { gx = (nn + 127) / 128, gy = (mm + 127) / 128, gz = gz, bx = 256, by = 1, bz = 1, shared = 40960 }) ps
    else gpu-launch gemm-ptx "kernel_linear_wmma_batched" (GpuGrid { gx = (nn + 63) / 64, gy = (mm + 63) / 64, gz = gz, bx = 128, by = 1, bz = 1, shared = 20480 }) ps

  bverdict : Integer, Integer, Integer, Integer, Integer, Integer -> Text
  bverdict (hy) (mm) (nn) (kk) (count) (launched) =
    if launched < 0 then "launch refused"
    else let g = bsum hy mm nn kk count 0 0
    in if g < 0 then "read refused" else show g & "/" & show (count * mm * nn)

  batch-report : Boolean, Integer, Integer, Integer, Integer -> Text
  batch-report (fast) (mm) (nn) (kk) (count) =
    let hx = gpu-buf-alloc (count * mm * kk * 2)
    in let hw = gpu-buf-alloc (count * nn * kk * 2)
    in let hb = gpu-buf-alloc (nn * 4)
    in let hy = gpu-buf-alloc (count * mm * nn * 4)
    in if hx == 0 | hw == 0 | hb == 0 | hy == 0 then "alloc refused"
    else if fill hx (count * mm * kk) 7 17 8 < 0 then "fill x refused"
    else if fill hw (count * nn * kk) 13 11 5 < 0 then "fill w refused"
    else if put-bias 0 nn < 0 then "bias refused"
    else if not (gpu-buf-write hb 0 (nn * 4) scratch) then "bias write refused"
    else let v = bverdict hy mm nn kk count (launch-batched fast hx hw hb hy mm nn kk count count)
    in let sab = bverdict hy mm nn kk count (launch-batched fast hx hw hb hy mm nn kk count (count - 1))
    in let f = gpu-buf-free hx & gpu-buf-free hw & gpu-buf-free hb & gpu-buf-free hy
    in v & "; sabotage " & show (count - 1) & " launched: " & sab & (if f then "" else "; free refused")

Section: Entry

  run-all : Integer -> List Text
  run-all (z) =
    let l1 = "staged 77x320 W 200x320 + b: " & case-report 0 77 200 320 True
    in let l2 = "staged 5x40 W 70x40 + b: " & case-report 0 5 70 40 False
    in let l3 = "pipelined 77x320 W 200x320 + b: " & case-report 1 77 200 320 True
    in let l4 = "pipelined 5x40 W 70x40 + b: " & case-report 1 5 70 40 False
    in let l5 = "pipelined 300x264 W 130x264 + b: " & case-report 1 300 130 264 False
    in let l6 = "batched pipelined 3 x (77x320 W 200x320 + b): " & batch-report True 77 200 320 3
    in let l7 = "batched staged 3 x (50x77 W 64x77 + b): " & batch-report False 50 64 77 3
    in let l8 = "pipelined 128x64 77x320 W 200x320 + b: " & case-report 2 77 200 320 True
    in let l9 = "pipelined 128x64 300x264 W 130x264 + b: " & case-report 2 300 130 264 False
    in [l1, l2, l3, l4, l5, l6, l7, l8, l9]

  print-all : List Text, Integer -> [Console] Nothing
  print-all (ls) (i) =
    if i >= list-length ls then act
      print-uni ""
    end
    else act
      print-line-uni (list-at ls i)
      print-all ls (i + 1)
    end

  opening : [Console] Integer
  opening = act
    print-all (run-all 0) 0
    let r = 0 in r
  end
