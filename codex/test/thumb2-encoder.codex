Chapter: Thumb2EncoderTest
  cites Foreword chapter Thumb2Encoder

Section: Helpers

  show-hex-word : Integer -> Text
  show-hex-word (w) =
    let b0 = bit-and w 255
    in let b1 = bit-and (bit-shru w 8) 255
    in let b2 = bit-and (bit-shru w 16) 255
    in let b3 = bit-and (bit-shru w 24) 255
    in hex-byte b3 & hex-byte b2 & hex-byte b1 & hex-byte b0

  show-hex-half : Integer -> Text
  show-hex-half (w) =
    let b0 = bit-and w 255
    in let b1 = bit-and (bit-shru w 8) 255
    in hex-byte b1 & hex-byte b0

  hex-byte : Integer -> Text
  hex-byte (b) = hex-nib (b / 16) & hex-nib (bit-and b 15)

  hex-nib : Integer -> Text
  hex-nib (n) =
    when n
      is 0 -> "0"
      is 1 -> "1"
      is 2 -> "2"
      is 3 -> "3"
      is 4 -> "4"
      is 5 -> "5"
      is 6 -> "6"
      is 7 -> "7"
      is 8 -> "8"
      is 9 -> "9"
      is 10 -> "A"
      is 11 -> "B"
      is 12 -> "C"
      is 13 -> "D"
      is 14 -> "E"
      is 15 -> "F"
      is otherwise -> "?"

  show-insn-16 : List Integer -> Text
  show-insn-16 (bytes) =
    let w = list-at bytes 0 + list-at bytes 1 * 256
    in show-hex-half w

  show-insn-32 : List Integer -> Text
  show-insn-32 (bytes) =
    let w = list-at bytes 0 + list-at bytes 1 * 256 + list-at bytes 2 * 65536 + list-at bytes 3 * 16777216
    in show-hex-word w

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("nop=" & show-insn-16 t2-nop)
    print-line-uni ("mov r0,r1=" & show-insn-16 (t2-mov 0 1))
    print-line-uni ("mov r0,#42=" & show-insn-16 (t2-mov-imm8 0 42))
    print-line-uni ("add r0,r1,r2=" & show-insn-16 (t2-add-lo 0 1 2))
    print-line-uni ("sub r0,r1,r2=" & show-insn-16 (t2-sub-lo 0 1 2))
    print-line-uni ("cmp r1,r2=" & show-insn-16 (t2-cmp-reg 1 2))
    print-line-uni ("and r0,r1=" & show-insn-16 (t2-and-reg 0 1))
    print-line-uni ("ldr r0,[sp,#16]=" & show-insn-16 (t2-ldr-sp 0 16))
    print-line-uni ("str r0,[sp,#16]=" & show-insn-16 (t2-str-sp 0 16))
    print-line-uni ("bx lr=" & show-insn-16 t2-ret)
    print-line-uni ("movw r0,#1234=" & show-insn-32 (t2-movw 0 #1234))
    print-line-uni ("movt r0,#5678=" & show-insn-32 (t2-movt 0 #5678))
    print-line-uni ("add.w r0,r1,r2=" & show-insn-32 (t2-add-w 0 1 2))
    print-line-uni ("sub.w r0,r1,r2=" & show-insn-32 (t2-sub-w 0 1 2))
    print-line-uni ("mul r0,r1,r2=" & show-insn-32 (t2-mul-w 0 1 2))
    print-line-uni ("sdiv r0,r1,r2=" & show-insn-32 (t2-sdiv-w 0 1 2))
    print-line-uni ("ldr.w r0,[r1,#16]=" & show-insn-32 (t2-ldr-w 0 1 16))
    print-line-uni ("str.w r0,[r1,#16]=" & show-insn-32 (t2-str-w 0 1 16))
    let li-result = t2-li 0 #12345678
    in print-line-uni ("li r0,#12345678 len=" & show (list-length li-result))
  end

