Chapter: EffectWidenArg
  cites Foreword chapter Console

Section: Probe

  writer : Text -> [Console.Write] Nothing
  writer (t) = print-line-uni t

  apply-it : (Text -> [Console] Nothing), Text -> [Console] Nothing
  apply-it (f) (t) = f t

  opening : [Console] Nothing = act
    apply-it writer "widened"
  end
