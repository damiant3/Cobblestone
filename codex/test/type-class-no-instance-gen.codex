Chapter: TypeClassNoInstanceGen
  cites Foreword chapter Console

class Showable where
  to-text : a -> Text

instance Showable Integer where
  to-text (x) = show x

instance Showable Text where
  to-text (s) = s

Section: Opening

  describe : Showable a => a -> Text
  describe (x) = "v: " & to-text x

  opening : [Console] Nothing
  opening = act
   print-line-uni (describe True)
  end
