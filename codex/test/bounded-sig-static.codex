Chapter: BoundedSigStatic

Section: Definitions

  inc-byte : Integer between 0 and 255 -> Integer
  inc-byte (n) = n + 1

  clamp-level : Integer between 0 and 15 -> Integer
  clamp-level (n) = n + 1

  opening : [Console] Nothing = act
   print-line-uni (integer-to-text (inc-byte 5))
   print-line-uni (integer-to-text (clamp-level (if True then 3 else 12)))
  end
