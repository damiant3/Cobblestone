Chapter: EnginePlaneGridTest
  cites Engine chapter Mesh
  cites Foreword chapter Console

 mesh-plane-grid must cover the same rectangle as mesh-plane with the same UV
 range and the same winding, since the renderers cull by winding. The winding
 row compares every grid triangle's y-cross sign against mesh-plane's first
 triangle; a flipped quad makes the count fall short of the total.

Section: Winding

  cross-y : Mesh, Integer -> Integer
  cross-y (m) (t) =
    let a = mesh-vertex-at m (mesh-index-at m (3 * t))
    in let b = mesh-vertex-at m (mesh-index-at m (3 * t + 1))
    in let c = mesh-vertex-at m (mesh-index-at m (3 * t + 2))
    in (b.vp-z - a.vp-z) * (c.vp-x - a.vp-x) - (b.vp-x - a.vp-x) * (c.vp-z - a.vp-z)

  sign : Integer -> Integer
  sign (x) = if x > 0 then 1 else if x < 0 then 0 - 1 else 0

  agree : Mesh, Integer, Integer, Integer, Integer -> Integer
  agree (m) (want) (t) (n) (acc) =
    if t >= n then acc
    else agree m want (t + 1) n (if sign (cross-y m t) == want then acc + 1 else acc)

  max-index : Mesh, Integer, Integer -> Integer
  max-index (m) (i) (best) =
    if i >= m.mesh-index-count then best
    else max-index m (i + 1) (if mesh-index-at m i > best then mesh-index-at m i else best)

Section: Entry

  opening : [Console] Nothing
  opening = act
    let g = mesh-plane-grid 4200 3000 8
    in let p = mesh-plane 4200 3000
    in let want = sign (cross-y p 0)
    in let first = mesh-vertex-at g 0
    in let last = mesh-vertex-at g (g.mesh-vert-count - 1)
    in act
      print-line-uni ("verts=" & show (g.mesh-vert-count) & " tris=" & show (mesh-triangle-count g) & " max-index=" & show (max-index g 0 0))
      print-line-uni ("first=(" & show (first.vp-x) & "," & show (first.vp-z) & " uv " & show (first.vu) & "," & show (first.vv) & ") last=(" & show (last.vp-x) & "," & show (last.vp-z) & " uv " & show (last.vu) & "," & show (last.vv) & ")")
      print-line-uni ("winding matches mesh-plane: " & show (agree g want 0 (mesh-triangle-count g) 0) & " of " & show (mesh-triangle-count g) & ", plane sign " & show want)
    end
  end
