Chapter: UiThemeTest
  cites UI chapter Theme
  cites UI chapter BoxModel

Section: Body

  test-palette : Text =
    let pal = palette-terminal
    in "bg=" & show (pal.pal-bg) & " fg=" & show (pal.pal-fg)

  test-edges : Text =
    let e = edges-uniform 4
    in "h=" & show (edges-h e) & " v=" & show (edges-v e)

  test-edges-xy : Text =
    let e = edges-xy 8 4
    in format-edges e

  test-border : Text =
    let b = border-uniform 2 16753920 CornerSharp
    in let side = b.bdr-top
    in "w=" & show (side.brd-width) & " c=" & show (side.brd-color)

  test-corner-round : Text =
    let b = border-uniform 1 0 (CornerRound 12)
    in when b.bdr-corner
      is CornerSharp -> "sharp"
      is CornerRound (r) -> "round=" & show r
      is CornerBevel (r) -> "bevel=" & show r

  test-widget-style : Text =
    let ws = widget-style 100 200 border-none (edges-uniform 4) (edges-uniform 2)
    in "bg=" & show (ws.ws-bg) & " fg=" & show (ws.ws-fg) & " oh-w=" & show (style-overhead-w ws) & " oh-h=" & show (style-overhead-h ws)

  test-state-resolve : Text =
    let ws-n = widget-style 10 20 border-none edges-zero edges-zero
    in let ws-h = widget-style 30 40 border-none edges-zero edges-zero
    in let ss = StateStyles { ss-normal = ws-n, ss-hover = ws-h, ss-pressed = ws-n, ss-disabled = ws-n, ss-focused = ws-n }
    in let resolved = resolve-state ss state-hover
    in "hover-bg=" & show (resolved.ws-bg)

  test-theme-name : Text =
    let th = theme-terminal
    in "name=" & th.th-name

  test-theme-lcars-name : Text =
    let th = theme-lcars
    in "name=" & th.th-name

  test-theme-minimal-name : Text =
    let th = theme-minimal
    in "name=" & th.th-name

  test-box-content : Text =
    let outer = layout-rect 10 20 200 100
    in let ws = widget-style 0 0 (border-uniform 2 0 CornerSharp) (edges-uniform 4) (edges-uniform 2)
    in let content = box-content-from-style outer ws
    in format-rect content

  test-rect-contains : Text =
    let r = layout-rect 10 10 100 50
    in let inside = rect-contains r 50 30
    in let outside = rect-contains r 200 200
    in "in=" & show-bool2 inside & " out=" & show-bool2 outside

  show-bool2 : Boolean -> Text
  show-bool2 (b) = if b then "true" else "false"

  test-rect-area : Text =
    let r = layout-rect 0 0 80 60
    in "area=" & show (rect-area r)

  opening : [Console] Nothing = act
    print-line-uni test-palette
    print-line-uni test-edges
    print-line-uni test-edges-xy
    print-line-uni test-border
    print-line-uni test-corner-round
    print-line-uni test-widget-style
    print-line-uni test-state-resolve
    print-line-uni test-theme-name
    print-line-uni test-theme-lcars-name
    print-line-uni test-theme-minimal-name
    print-line-uni test-box-content
    print-line-uni test-rect-contains
    print-line-uni test-rect-area
  end

