Chapter: NvMmuMaxwell
  cites Kernel chapter NvMmu
  cites Foreword chapter Format

 The expected output is NVIDIA's published gm107 dev_mmu.h and dev_ram.h
 field ranges packed by Mesa's drf.h, compiled by MSVC:
 build/nv-mmu-oracle.ps1.

Section: Main

  hex64 : Integer -> Text
  hex64 (v) = fmt-hex-pad (bit-and v #FFFFFFFF) 8 & " " & fmt-hex-pad (bit-shru v 32) 8

  words4 : List Integer -> Text
  words4 (ws) = fmt-hex-pad (list-at ws 0) 8 & " " & fmt-hex-pad (list-at ws 1) 8 & " " & fmt-hex-pad (list-at ws 2) 8 & " " & fmt-hex-pad (list-at ws 3) 8

  opening : [Console] Nothing = act
   print-line-uni ("PTE 0 " & hex64 (nv-mmu-pte #1000 0 0 0 0 0))
   print-line-uni ("PTE 1 " & hex64 (nv-mmu-pte #1FFFFFF000 0 1 #FE 1 1))
   print-line-uni ("PTE 2 " & hex64 (nv-mmu-pte #FFFFFFF000 2 0 #DB 0 0))
   print-line-uni ("PTE 3 " & hex64 (nv-mmu-pte #123456000 3 1 0 1 0))
   print-line-uni ("PDE 0 " & hex64 (nv-mmu-pde #2000 1 0 0 0 0 0))
   print-line-uni ("PDE 1 " & hex64 (nv-mmu-pde 0 0 #7000 2 0 1 2))
   print-line-uni ("PDE 2 " & hex64 (nv-mmu-pde #ABCDE000 1 #FFFFFFF000 3 1 1 3))
   print-line-uni ("PDE 3 " & hex64 (nv-mmu-pde #1FFFFFF000 1 #1000 1 0 0 1))
   print-line-uni ("PDB 0 " & words4 (nv-ramin-pdb #20000000 0 0 #FFFFFFFFFF))
   print-line-uni ("PDB 1 " & words4 (nv-ramin-pdb #FFFFFFF000 3 1 #1FFFFFFFFF))
   print-line-uni ("PDB 2 " & words4 (nv-ramin-pdb #ABC000 2 0 #123456789A))
  end
