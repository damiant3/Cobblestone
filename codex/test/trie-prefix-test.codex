Chapter: TriePrefixTest
  cites Foreword chapter Console
  cites Foreword chapter Trie

Section: Body
  opening : [Console] Nothing = act
   let t = trie-insert (trie-insert (trie-insert (trie-insert trie-empty "abc" 1) "abd" 2) "xyz" 3) "abcd" 4
   in let keys = trie-prefix-keys t "ab"
   in let none = trie-prefix-keys t "zz"
   in act
    print-line ("count:" & integer-to-text (list-length keys))
    print-line ("none:" & integer-to-text (list-length none))
    print-line ("k0:" & list-at keys 0)
    print-line ("k1:" & list-at keys 1)
    print-line ("k2:" & list-at keys 2)
   end
  end

