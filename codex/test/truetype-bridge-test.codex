Section: Atlas Tests
  test-atlas-create : Text =
    let font = ttf-parse test-font-bytes
    in let atlas = atlas-create font 16 32 34
    in format-atlas atlas

  test-atlas-lookup-a : Text =
    let font = ttf-parse test-font-bytes
    in let atlas = atlas-create font 16 32 34
    in let rg = atlas-glyph atlas 65
    in "A: w=" & show (rg.rg-width) & " h=" & show (rg.rg-height) & " adv=" & show (rg.rg-advance)

Section: BitmapFont Bridge
  test-bitmap-font : Text =
    let bf = ttf-load-font test-font-bytes 16 "test-16"
    in format-ttf-bitmap-font bf

  test-bitmap-glyph : Text =
    let bf = ttf-load-font test-font-bytes 16 "test-16"
    in let g = font-glyph bf 33
    in "glyph: code=" & show (g.gl-code) & " w=" & show (g.gl-width) & " h=" & show (g.gl-height)

  test-draw-to-fb : Text =
    let bf = ttf-load-font test-font-bytes 16 "test-16"
    in let fb = fb-new 64 16 0
    in let fb2 = font-draw-char fb bf 33 0 0 255 0
    in let has-pixel = fb-get fb2 4 5
    in "drawn=" & show has-pixel

  test-aa-bitmap-font : Text =
    let bf = ttf-load-font-aa test-font-bytes 16 "test-aa-16"
    in format-ttf-bitmap-font bf

  test-text-width : Text =
    let bf = ttf-load-font test-font-bytes 16 "test-16"
    in let w = font-text-width bf "A"
    in "text-w=" & show w

  opening : [Console] Nothing = act
    print-line-uni test-atlas-create
    print-line-uni test-atlas-lookup-a
    print-line-uni test-bitmap-font
    print-line-uni test-bitmap-glyph
    print-line-uni test-draw-to-fb
    print-line-uni test-aa-bitmap-font
    print-line-uni test-text-width
  end

