Chapter: UnconstrainedEmptyList
  cites Foreword chapter Console

Section: Body
  make-empty : Integer -> List a
  make-empty (n) = []

  typed-empty : a -> List a
  typed-empty (witness) = []

  identity-value : a -> a
  identity-value (value) = value

  empty-text : List Text = make-empty 2

  opening : [Console] Nothing = act
    print-line-uni (show (list-length (make-empty 0)))
    print-line-uni (show (list-length (make-empty 1)))
    print-line-uni (show (list-length (typed-empty 42)))
    print-line-uni (show (list-length (typed-empty "text")))
    print-line-uni (show (list-length empty-text))
    print-line-uni (show (identity-value 42))
    print-line-uni (identity-value "text")
  end
