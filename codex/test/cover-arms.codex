Chapter: CoverArmsTest

  CaShape =
    | CaDot
    | CaBox (Integer)

  ca-classify : Integer -> Text
  ca-classify (n) =
    if n < 0 then "negative"
    else if n == 0 then "zero"
    else "positive"

  ca-shape : CaShape -> Integer
  ca-shape (s) =
    when s
     is CaBox (v) -> v
     is CaDot -> 0 - 1

  ca-count : Integer, Integer -> Integer
  ca-count (i) (acc) = if i >= 10000000 then acc else ca-count (i + 1) (if i - i / 3 * 3 == 0 then acc + 1 else acc)

  ca-never : Integer -> Integer
  ca-never (x) = if x > 5 then 1 else 2

  opening : [Console] Nothing = act
    print-line-uni (ca-classify 5)
    print-line-uni (ca-classify 0)
    print-line-uni (show (ca-shape (CaBox 4)))
    print-line-uni (show (ca-count 0 0))
  end
