Chapter: RealTrapping
  cites Foreword chapter Console

Section: Entry
  add-trap : Real trapping, Real trapping -> Real trapping
  add-trap (a) (b) = a + b

  opening : [Console] Nothing
  opening = act
    let a = to-real-trapping 3.0
    in let b = to-real-trapping 4.0
    in let sum = add-trap a b
    in act
      print-line-uni ("sum: " & show (from-real-trapping sum))
    end
  end
