Chapter: VectorBasic
  cites Foreword chapter Console

Section: Entry
  opening : [Console] Nothing
  opening = act
    let a = vec-splat 3.0
    in let b = vec-splat 4.0
    in let sum = a + b
    in let diff = b - a
    in let prod = a * b
    in let quot = b / a
    in act
      print-line-uni ("add: " & show (vec-extract sum 0))
      print-line-uni ("sub: " & show (vec-extract diff 0))
      print-line-uni ("mul: " & show (vec-extract prod 0))
      print-line-uni ("div: " & show (vec-extract quot 0))
    end
  end
