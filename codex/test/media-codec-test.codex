Chapter: MediaCodecTest
  cites Codex chapter General
  cites Encode chapter Bmp
  cites Encode chapter Wav
  cites Encode chapter Qoi
  cites Encode chapter VideoCodec
  cites Encode chapter Midi
  cites Game chapter Color
  cites Foreword chapter Maybe

Section: Body

  test-bmp : Text =
    let pixels = [rgb 255 0 0, rgb 0 255 0, rgb 0 0 255, rgb 255 255 255]
    in let encoded = bmp-encode 2 2 pixels
    in let header-size = 54
    in let magic = list-at encoded 0
    in let decoded = bmp-decode encoded
    in "bmp: size=" & show (list-length encoded) & " magic=" & show magic & " decoded=" & show (decoded.bmp-width) & "x" & show (decoded.bmp-height)

  test-wav : Text =
    let samples = [0, 500, 1000, 500, 0, 0 - 500, 0 - 1000, 0 - 500]
    in let encoded = wav-encode-mono 8000 samples
    in let magic = list-at encoded 0
    in let size = list-length encoded
    in "wav: size=" & show size & " magic=" & show magic & " dur=" & show (wav-duration-ms 8000 8)

  test-qoi : Text =
    let pixels = [rgb 255 0 0, rgb 255 0 0, rgb 255 0 0, rgb 0 255 0, rgb 0 0 255, rgb 0 0 255]
    in let encoded = qoi-encode 3 2 pixels
    in let decoded = qoi-decode encoded
    in "qoi: enc=" & show (list-length encoded) & " dec-pixels=" & show (list-length (decoded.qoi-pixels)) & " w=" & show (decoded.qoi-width)

  test-video : Text =
    let frame1 = [1, 1, 1, 1, 2, 2, 2, 2]
    in let frame2 = [1, 1, 3, 1, 2, 2, 2, 2]
    in let vs = video-add-delta (video-add-keyframe (video-new 4 2 10) frame1) frame1 frame2
    in let f2 = video-frame-at vs 1
    in let delta-count = when f2 is Just (f) -> video-delta-count f is None -> 0 - 1
    in "video: " & format-video vs & " deltas=" & show delta-count

  test-midi : Text =
    let track = midi-set-tempo (midi-track 480) 0 120
    in let t1 = midi-note track 0 0 60 100 480
    in let t2 = midi-note t1 0 0 64 100 480
    in let encoded = midi-encode t2
    in "midi: size=" & show (list-length encoded) & " events=" & show (t2.mt-count)

  opening : [Console] Nothing = act
    print-line test-bmp
    print-line test-wav
    print-line test-qoi
    print-line test-video
    print-line test-midi
  end

