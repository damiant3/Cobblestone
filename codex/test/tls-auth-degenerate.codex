Section: Helpers

  ascii : Text -> List Integer
  ascii (s) = ascii-loop s 0 (text-length s) []

  ascii-loop : Text, Integer, Integer, List Integer -> List Integer
  ascii-loop (s) (i) (n) (acc) =
    if i >= n then acc
    else ascii-loop s (i + 1) n (list-push acc (to-unicode (char-code (char-at s i))))

  yn : Boolean -> Text
  yn (b) = if b then "True" else "False"

  zeros : Integer, List Integer -> List Integer
  zeros (n) (acc) = if list-length acc >= n then acc else zeros n (list-push acc 0)

  or-empty : Maybe (List Integer) -> List Integer
  or-empty (m) =
    when m
      is None -> []
      is Just (x) -> x

  set-at : List Integer, Integer, Integer -> List Integer
  set-at (bs) (i) (v) = list-set-at (for b in bs -> b) i v

  first-n : List Integer, Integer, Integer, List Integer -> List Integer
  first-n (bs) (n) (i) (acc) =
    if i >= n then acc
    else first-n bs n (i + 1) (list-push acc (list-at bs i))

  key-of : X509KeyAlg, List Integer -> X509Key
  key-of (alg) (bytes) = X509Key { xk-alg = alg, xk-bytes = bytes, xk-mod = [], xk-exp = [] }

  rsa-key : X509Key
  rsa-key = X509Key { xk-alg = KeyRsa, xk-bytes = [], xk-mod = rsa-mod, xk-exp = [1, 0, 1] }

  print-all : List Text, Integer -> [Console] Nothing
  print-all (ls) (i) =
    if i >= list-length ls then act
      print-uni ""
    end
    else act
      print-line-uni (list-at ls i)
      print-all ls (i + 1)
    end

Section: CertificateVerify

  leaf-pub : List Integer = ed25519-public-key leaf-priv

  ed-key : X509Key = key-of KeyEd25519 leaf-pub

  ed-body : List Integer = tls-cv-encode True leaf-priv leaf-pub th

  with-scheme : List Integer, Integer -> List Integer
  with-scheme (body) (scheme) = set-at (set-at body 0 (bit-shru scheme 8)) 1 (bit-and scheme 255)

  with-len : List Integer, Integer -> List Integer
  with-len (body) (n) = set-at (set-at body 2 (bit-shru n 8)) 3 (bit-and n 255)

  cv : Text, Boolean -> Text
  cv (label) (b) = "cv " & label & " = " & yn b

  cv-lines : List Text
  cv-lines =
    let n = list-length ed-body - 4
    in [
      cv "ed25519 server control" (tls-cv-verify True ed-key ed-body th),
      cv "ed25519 checked as the client role" (tls-cv-verify False ed-key ed-body th),
      cv "ed25519 under another transcript hash" (tls-cv-verify True ed-key ed-body (set-at th 0 99)),
      cv "ed25519 under an empty transcript hash" (tls-cv-verify True ed-key ed-body []),
      cv "empty body" (tls-cv-verify True ed-key [] th),
      cv "3-byte body" (tls-cv-verify True ed-key (first-n ed-body 3 0 []) th),
      cv "declared length one longer" (tls-cv-verify True ed-key (with-len ed-body (n + 1)) th),
      cv "declared length one shorter" (tls-cv-verify True ed-key (with-len ed-body (n - 1)) th),
      cv "body cut one byte short" (tls-cv-verify True ed-key (first-n ed-body (list-length ed-body - 1) 0 []) th),
      cv "empty signature" (tls-cv-verify True ed-key (tls-cv-wrap tls-sig-ed25519 []) th),
      cv "all-zero signature" (tls-cv-verify True ed-key (tls-cv-wrap tls-sig-ed25519 (zeros 64 [])) th),
      cv "all-zero key and signature" (tls-cv-verify True (key-of KeyEd25519 (zeros 32 [])) (tls-cv-wrap tls-sig-ed25519 (zeros 64 [])) th),
      cv "ecdsa-p256 scheme on an ed25519 key" (tls-cv-verify True ed-key (with-scheme ed-body tls-sig-ecdsa-p256-sha256) th),
      cv "ecdsa-p384 scheme on an ed25519 key" (tls-cv-verify True ed-key (with-scheme ed-body tls-sig-ecdsa-p384-sha384) th),
      cv "rsa-pss scheme on an ed25519 key" (tls-cv-verify True ed-key (with-scheme ed-body tls-sig-rsa-pss-sha256) th),
      cv "scheme 0" (tls-cv-verify True ed-key (with-scheme ed-body 0) th),
      cv "scheme 65535" (tls-cv-verify True ed-key (with-scheme ed-body 65535) th),
      cv "x25519 key with the signer's bytes" (tls-cv-verify True (key-of KeyX25519 leaf-pub) ed-body th),
      cv "unknown key with the signer's bytes" (tls-cv-verify True (key-of KeyUnknown leaf-pub) ed-body th),
      cv "rsa-pss server control" (tls-cv-verify True rsa-key (tls-cv-wrap tls-sig-rsa-pss-sha256 rsa-pss-sig) th),
      cv "rsa-pss checked as the client role" (tls-cv-verify False rsa-key (tls-cv-wrap tls-sig-rsa-pss-sha256 rsa-pss-sig) th),
      cv "pkcs1 signature under rsa_pkcs1_sha256 (1025)" (tls-cv-verify True rsa-key (tls-cv-wrap 1025 rsa-pkcs1-sig) th),
      cv "pkcs1 signature under rsa-pss" (tls-cv-verify True rsa-key (tls-cv-wrap tls-sig-rsa-pss-sha256 rsa-pkcs1-sig) th),
      cv "pss signature under rsa_pss_pss_sha256 (2057)" (tls-cv-verify True rsa-key (tls-cv-wrap 2057 rsa-pss-sig) th),
      cv "ed25519 scheme on an rsa key" (tls-cv-verify True rsa-key ed-body th)
    ]

Section: The Handshake

  mint-ca : List Integer -> List Integer
  mint-ca (priv) = or-empty (x509-ca-cert-ed25519 priv [1] (ascii "Codex Dev Root") t0 t1)

  issue : List Integer -> List Integer
  issue (ca) = or-empty (x509-issue-ed25519 ca-priv ca leaf-pub [2] (ascii "codex-dev") t0 t1 [ascii "localhost"] [loopback])

  anchors-of : List Integer -> List X509Anchor
  anchors-of (cert) =
    when x509-parse cert
      is None -> []
      is Just (c) -> [X509Anchor { xa-subject = c.xc-subject, xa-key = c.xc-key }]

  client-feed : TlsEp, List (List Integer), Integer -> TlsEp
  client-feed (ep) (msgs) (i) =
    if i >= list-length msgs then ep
    else client-feed ((tls-ep-recv ep (list-at msgs i)).tes-ep) msgs (i + 1)

  shake : Text, List (List Integer), List Integer, List X509Anchor, Text, List Integer -> Text
  shake (label) (chain) (sign-priv) (anchors) (now) (host) =
    let s0 = tls-ep-server-new s-priv s-random chain sign-priv (ed25519-public-key sign-priv)
    in let c0 = tls-ep-client-new c-priv c-random anchors (ascii now) host
    in let st1 = tls-ep-hello c0
    in let sv1 = tls-ep-recv s0 (list-at (st1.tes-out) 0)
    in let c = client-feed (st1.tes-ep) (sv1.tes-out) 0
    in "handshake " & label & ": authenticated = " & yn (tls-ep-authenticated c) & ", done = " & yn (tls-ep-done c) & ", phase = " & show (c.tep-phase)

  shake-lines : List Integer, List Integer, List Integer -> List Text
  shake-lines (ca) (rogue) (leaf) =
    let a = anchors-of ca
    in let now = "20260923000000"
    in let host = ascii "localhost"
    in [
      shake "control" [leaf, ca] leaf-priv a now host,
      shake "server signs with a key other than its certificate's" [leaf, ca] rogue-priv a now host,
      shake "client expects another host" [leaf, ca] leaf-priv a now (ascii "evil.test"),
      shake "client expects an empty host" [leaf, ca] leaf-priv a now [],
      shake "client anchors a same-name CA with another key" [leaf, ca] leaf-priv (anchors-of rogue) now host,
      shake "client clock after the leaf expires" [leaf, ca] leaf-priv a "20360101000000" host,
      shake "server sends no certificate" [] leaf-priv a now host,
      shake "server sends the CA as its leaf" [ca] ca-priv a now host,
      shake "client holds no anchor" [leaf, ca] leaf-priv [] now host
    ]

Section: Entry

  opening : [Console] Nothing = act
    let ca = mint-ca ca-priv
    in let rogue = mint-ca rogue-priv
    in let leaf = issue ca
    in act
      print-all cv-lines 0
      print-all (shake-lines ca rogue leaf) 0
    end
  end