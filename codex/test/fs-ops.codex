Chapter: FsOps
  cites Foreword chapter FileSystem

Section: Entry

  opening : [Console, FileSystem.Read "OPS", FileSystem.Write "OPS"] Nothing
  opening = act
    a <- make-dir "OPS"
    b <- make-dir "OPS"
    c <- make-dir "OPS/SUB"
    print-line-uni ("make-dir " & show a & " " & show b & " " & show c)

    d <- append-file "OPS/LOG.TXT" "one,"
    e <- append-file "OPS/LOG.TXT" "two"
    log <- read-text "OPS/LOG.TXT"
    print-line-uni ("append-file " & show d & " " & show e & " reads " & log)

    f <- make-dir "OPS/LOG.TXT"
    print-line-uni ("make-dir on a file " & show f)

    names <- list-dir "OPS"
    none <- list-dir "OPS/LOG.TXT"
    print-line-uni ("list-dir OPS: " & ops-joined names 0 "" & "; of a file: " & show (list-length none))
  end

Section: Reporting

  ops-joined : List Text, Integer, Text -> Text
  ops-joined (xs) (i) (acc) =
    if i >= list-length xs then acc
    else ops-joined xs (i + 1) (if i == 0 then list-at xs i else acc & " " & list-at xs i)
