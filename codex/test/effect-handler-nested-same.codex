Chapter: EffectHandlerNestedSame
  cites Foreword chapter Console

Section: Effects

  effect Reader where
    ask : [Reader] Integer

Section: Definitions

  inner-value : Integer
  inner-value =
   let r = with Reader ask
     ask (resume) = resume 10
   in r

  outer-value : Integer
  outer-value =
   let r = with Reader inner-value
     ask (resume) = resume 99
   in r

  opening : [Console] Nothing = act
    print-line-uni ("inner " & show inner-value)
    print-line-uni ("outer " & show outer-value)
  end
