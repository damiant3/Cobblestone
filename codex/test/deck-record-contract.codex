Chapter: DeckRecordContract
  cites Foreword chapter Console

Section: Instrument

  show-yn : Boolean -> Text
  show-yn (b) = if b then "yes" else "no"

Section: Phase Allocator

  init-phase-allocator : Integer
  init-phase-allocator =
   __heap-save

  deck-record : a -> a
  deck-record (x) =
   x

Section: Report

  opening : [Console] Nothing = act
   let base = init-phase-allocator
   in let bivy = __heap-save
   in let mark = bivy + 4096
   in let m = __deck-set mark
   in let inside = deck-record (__heap-save)
   in let after = __heap-save
   in let passed = deck-record (12345)
   in print-line-uni ("argument evaluates on the deck: " & show-yn (inside == mark))
   print-line-uni ("the extent restores the bivy : " & show-yn (after == bivy))
   print-line-uni ("the value passes through     : " & show-yn (passed == 12345))
   print-line-uni ("the two are distinguishable  : " & show-yn (mark > bivy))
  end
