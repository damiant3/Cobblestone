Chapter: TypeclassInstanceNested
  cites Foreword chapter Console

class MeasureList where
  measure-list : List a -> Text

instance MeasureList Integer where
  measure-list (xs) = show (list-length xs)

Section: Functions

  measure-from-dict : List Integer -> Text
  measure-from-dict (xs) =
   let d = MeasureList-dict-Integer
   in (d.measure-list-impl) xs

  generic-length : List a -> Text
  generic-length (xs) = show (list-length xs)

  opening : [Console] Nothing = act
    print-line-uni (measure-list [1, 2])
    print-line-uni (measure-from-dict [3, 4])
    print-line-uni (generic-length [True])
  end
