Chapter: HeapAdvanceOdd
  cites Foreword chapter Console

 An advance of 3 bytes leaves the heap pointer off an eight-byte boundary.
 A record, a list and a closure allocated inline after the advance are read
 back; a strict-alignment core faults on the first 8-byte load unless
 `__heap-advance` rounds.

Section: Main

  Pair = record { pa : Integer, pb : Integer }

  mk-pair : Integer, Integer -> Pair
  mk-pair (a) (b) = Pair { pa = a, pb = b }

  mk-list : Integer -> List Integer
  mk-list (x) = [x, x + 1, x + 2]

  adder : Integer -> (Integer -> Integer)
  adder (k) = \v -> v + k

  opening : [Console] Nothing = act
    let a = __heap-advance 3
    in let p = mk-pair 40 2
    in let xs = mk-list 7
    in let f = adder 30
    in act
      print-line-uni ("record " & integer-to-text (p.pa + p.pb))
      print-line-uni ("list " & integer-to-text (list-at xs 2))
      print-line-uni ("closure " & integer-to-text (f 12))
    end
  end
