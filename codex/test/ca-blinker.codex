Chapter: CaBlinker
  cites Game chapter CellularAutomata

Section: Checks

  blinker : CaGrid
  blinker = ca-set (ca-set (ca-set (ca-new 5 5) 1 2 1) 2 2 1) 3 2 1

  rows : CaGrid, Integer -> Text
  rows (g) (y) = if y >= g.height then "" else ca-row-text g y & (if y + 1 < g.height then "/" else "") & rows g (y + 1)

  block : CaGrid
  block = ca-set (ca-set (ca-set (ca-set (ca-new 4 4) 1 1 1) 2 1 1) 1 2 1) 2 2 1

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (rows blinker 0)
    print-line-uni (rows (ca-step blinker ca-rule-life) 0)
    print-line-uni (rows (ca-run blinker ca-rule-life 2) 0)
    print-line-uni (show (ca-count-neighbors blinker 2 1) & " " & show (ca-count-neighbors blinker 2 2) & " " & show (ca-count-neighbors blinker 0 0))
    print-line-uni (show (ca-count-alive (ca-run block ca-rule-life 3)) & " " & rows (ca-run block ca-rule-life 3) 0)
    print-line-uni (show (ca-count-alive (ca-step blinker ca-rule-caves)))
  end
