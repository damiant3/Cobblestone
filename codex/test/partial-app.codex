Section: Definitions



  add : Integer, Integer -> Integer

  add (a) (b) = a + b



  opening : [Console] Nothing = act

    add-ten <- add 10

    r1 <- add-ten 5

    r2 <- add-ten 100

    print-line-uni (integer-to-text r1)

    print-line-uni (integer-to-text r2)

  end



