Chapter: PickAlpha

Section: Alpha
  pick-helper : Integer -> Integer
  pick-helper (n) = n + 1

Chapter: PickBeta

Section: Beta
  pick-helper : Integer -> Integer
  pick-helper (n) = n + 100

Chapter: PickGamma
  cites Codex chapter PickBeta (pick-helper)

Section: Entry
  opening : [Console] Nothing
  opening = act
   print-line-uni ("pick-helper 1 = " & show (pick-helper 1))
  end
