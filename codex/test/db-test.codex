Section: Helpers

  show-val : ColumnValue -> Text
  show-val (v) =
    when v
      is ValInteger (n) -> show n
      is ValText (t) -> t
      is ValBoolean (b) -> if b then "True" else "False"
      is ValNull -> "NULL"

  show-row : RowData -> Text
  show-row (row) = show-row-loop (row.values) 0 (list-length (row.values)) ""

  show-row-loop : List ColumnValue, Integer, Integer, Text -> Text
  show-row-loop (vals) (i) (len) (acc) =
    if i >= len then acc
    else let v = list-at vals i
    in let sep = if i > 0 then " | " else ""
    in show-row-loop vals (i + 1) len (acc & sep & show-val v)

  show-qr : QueryResult -> Text
  show-qr (qr) =
    if qr.qr-ok == False then "ERROR: " & qr.qr-msg
    else show-qr-loop (qr.qr-rows) 0 (qr.qr-count) ""

  show-qr-loop : List RowData, Integer, Integer, Text -> Text
  show-qr-loop (rows) (i) (len) (acc) =
    if i >= len then acc
    else let row = list-at rows i
    in let line = show-row row
    in let sep = if i > 0 then "; " else ""
    in show-qr-loop rows (i + 1) len (acc & sep & line)

Section: Test Create Table and Insert

  test-create-insert : Text =
    let cat = catalog-new
    in let tdef = table-def-with-pk "users" [
      col-def-not-null "id" ColInteger,
      col-def-not-null "name" ColText,
      col-def "email" ColText,
      col-def "age" ColInteger
    ] ["id"]
    in let cr = catalog-create-table cat tdef
    in if cr.cat-ok == False then "FAIL: " & cr.cat-msg
    else let schema = table-schema tdef
    in let r1 = row-new schema [ValInteger 1, ValText "Alice", ValText "alice@codex.dev", ValInteger 30]
    in let r2 = row-new schema [ValInteger 2, ValText "Bob", ValText "bob@codex.dev", ValInteger 25]
    in let r3 = row-new schema [ValInteger 3, ValText "Carol", ValNull, ValInteger 35]
    in let i1 = catalog-insert-row (cr.cat) "users" r1
    in let i2 = catalog-insert-row (i1.cir-cat) "users" r2
    in let i3 = catalog-insert-row (i2.cir-cat) "users" r3
    in "create-insert: rows=" & show (catalog-table-row-count (i3.cir-cat) "users")

Section: Test Select All

  test-select-all : Catalog -> Text =
    let qr = execute cat (RelScan "users")
    in "select-all: count=" & show (qr.qr-count) & " data=" & show-qr qr

Section: Test Filter

  test-filter : Catalog -> Text =
    let qr = execute cat (RelFilter (RelScan "users") (PredColCmp "age" CmpGt (ValInteger 28)))
    in "filter(age>28): count=" & show (qr.qr-count) & " data=" & show-qr qr

Section: Test Project

  test-project : Catalog -> Text =
    let qr = execute cat (RelProject (RelScan "users") (proj-columns ["name", "age"]))
    in "project(name,age): count=" & show (qr.qr-count) & " data=" & show-qr qr

Section: Test Sort

  test-sort : Catalog -> Text =
    let qr = execute cat (RelSort (RelScan "users") [SortSpec { sort-col = "age", sort-dir = SortDesc }])
    in "sort(age desc): first=" & show-row (list-at (qr.qr-rows) 0)

Section: Test Limit

  test-limit : Catalog -> Text =
    let qr = execute cat (RelLimit (RelScan "users") 2)
    in "limit(2): count=" & show (qr.qr-count)

Section: Test Group By

  test-group : Catalog -> Text =
    let qr = execute cat (RelGroup (RelScan "users") [] [
      AggSpec { agg-func = AggCount, agg-alias = "total" },
      AggSpec { agg-func = AggSum "age", agg-alias = "sum-age" },
      AggSpec { agg-func = AggAvg "age", agg-alias = "avg-age" }
    ])
    in "group-all: " & show-qr qr

Section: Test Delete

  test-delete : Catalog -> (Catalog, Text) =
    let scan = catalog-scan cat "users"
    in if scan.scan-count < 2 then (cat, "FAIL: not enough rows to delete")
    else let rid = list-at (scan.row-ids) 1
    in let entry = hamt-get (cat.tables) "users"
    in when entry
      is None -> (cat, "FAIL: table not found")
      is Just (e) ->
        let new-heap = heap-delete (e.cat-heap) rid
        in let new-entry = CatalogTable {
          cat-table-id = e.cat-table-id,
          cat-table-name = e.cat-table-name,
          cat-table-def = e.cat-table-def,
          cat-heap = new-heap,
          cat-indexes = e.cat-indexes
        }
        in let new-cat = Catalog {
          tables = hamt-set (cat.tables) "users" new-entry,
          table-count = cat.table-count,
          next-table-id = cat.next-table-id,
          next-index-id = cat.next-index-id
        }
        in let qr = execute new-cat (RelScan "users")
        in (new-cat, "delete(row 1): remaining=" & show (qr.qr-count) & " data=" & show-qr qr)

Section: Test Drop Table

  test-drop : Catalog -> Text =
    let dr = catalog-drop-table cat "users"
    in if dr.cat-ok == False then "FAIL: " & dr.cat-msg
    else let exists = catalog-table-exists (dr.cat) "users"
    in "drop: exists-after=" & show exists & " tables=" & show ((dr.cat).table-count)

Section: Test Transactions

  test-txn : Text =
    let mgr = txn-manager-new
    in let br = txn-begin mgr Serializable
    in let txn-id = br.tbr-txn.txn-id
    in let cr = txn-commit (br.tbr-mgr) txn-id
    in if cr.tr-ok == False then "FAIL: " & cr.tr-msg
    else let br2 = txn-begin (cr.tr-mgr) Serializable
    in let ar = txn-abort (br2.tbr-mgr) (br2.tbr-txn.txn-id)
    in "txn: committed=1 aborted=1 ok=" & show (ar.tr-ok)

Section: Test Locking

  test-locks : Text =
    let lt = lock-table-new
    in let r1 = lock-acquire lt (LockTable "users") LockShared 1
    in let lt2 = when r1 is (lt2a, res) -> lt2a
    in let g1 = when r1 is (lt2a, res) -> res
    in let r2 = lock-acquire lt2 (LockTable "users") LockShared 2
    in let lt3 = when r2 is (lt3a, res) -> lt3a
    in let g2 = when r2 is (lt3a, res) -> res
    in let r3 = lock-acquire lt3 (LockTable "users") LockExclusive 3
    in let lt4 = when r3 is (lt4a, res) -> lt4a
    in let g3 = when r3 is (lt4a, res) -> res
    in let s_ok = when g1 is LockGranted -> True is otherwise -> False
    in let s2_ok = when g2 is LockGranted -> True is otherwise -> False
    in let x_wait = when g3 is LockWaiting -> True is otherwise -> False
    in "locks: S1=" & show s_ok & " S2=" & show s2_ok & " X3-waits=" & show x_wait

Section: Test Deadlock Detection

  test-deadlock : Text =
    let edges = [
      WaitEdge { we-waiter = 1, we-holder = 2 },
      WaitEdge { we-waiter = 2, we-holder = 3 },
      WaitEdge { we-waiter = 3, we-holder = 1 }
    ]
    in let wfg = wfg-build edges
    in let result = detect-deadlock wfg
    in when result
      is NoDeadlock -> "deadlock: FAIL — cycle not detected"
      is DeadlockFound (cycle) ->
        let victim = select-victim cycle
        in "deadlock: detected, victim=" & show victim

Section: Test WAL

  test-wal : Text =
    let log = wal-log-new
    in let log2 = wal-log-append log (wal-begin 1 1)
    in let log3 = wal-log-append log2 (wal-insert 2 1 1 0 0 [10, 20, 30])
    in let log4 = wal-log-append log3 (wal-commit 3 1)
    in let committed = wal-committed-txns log4
    in let is-c = wal-is-committed committed 1
    in "wal: records=" & show (wal-record-count log4) & " txn1-committed=" & show is-c

Section: Build Test Catalog

  build-test-catalog : Catalog =
    let cat = catalog-new
    in let tdef = table-def-with-pk "users" [
      col-def-not-null "id" ColInteger,
      col-def-not-null "name" ColText,
      col-def "email" ColText,
      col-def "age" ColInteger
    ] ["id"]
    in let cr = catalog-create-table cat tdef
    in let schema = table-schema tdef
    in let r1 = row-new schema [ValInteger 1, ValText "Alice", ValText "alice@codex.dev", ValInteger 30]
    in let r2 = row-new schema [ValInteger 2, ValText "Bob", ValText "bob@codex.dev", ValInteger 25]
    in let r3 = row-new schema [ValInteger 3, ValText "Carol", ValNull, ValInteger 35]
    in let i1 = catalog-insert-row (cr.cat) "users" r1
    in let i2 = catalog-insert-row (i1.cir-cat) "users" r2
    in let i3 = catalog-insert-row (i2.cir-cat) "users" r3
    in i3.cir-cat

Section: Body

  opening : [Console] Nothing = act
    print-line test-create-insert
    let cat = build-test-catalog
    in print-line (test-select-all cat)
    in print-line (test-filter cat)
    in print-line (test-project cat)
    in print-line (test-sort cat)
    in print-line (test-limit cat)
    in print-line (test-group cat)
    in let del-result = test-delete cat
    in let cat2 = when del-result is (c, msg) -> c
    in let del-msg = when del-result is (c, msg) -> msg
    in print-line del-msg
    in print-line (test-drop cat2)
    in print-line test-txn
    in print-line test-locks
    in print-line test-deadlock
    in print-line test-wal
  end

