Chapter: ColorTest
  cites Codex chapter General
  cites Game chapter Color

Section: Body

  test-pack : Text =
    let c = rgb 255 128 0
    in let packed = rgb-to-packed c
    in let back = rgb-from-packed packed
    in "packed=" & show packed & " back=" & format-rgb back

  test-lerp : Text =
    let mid = rgb-lerp rgb-black rgb-white 500
    in "mid=" & format-rgb mid

  test-blend : Text =
    let c = rgb-alpha-blend rgb-red rgb-blue 500
    in "blend=" & format-rgb c

  test-gray : Text =
    let c = rgb 200 100 50
    in let g = rgb-grayscale c
    in "gray=" & format-rgb g & " lum=" & show (rgb-luminance c)

  test-invert : Text =
    let c = rgb-invert (rgb 100 200 50)
    in "inv=" & format-rgb c

  test-hsl : Text =
    let hsl = rgb-to-hsl rgb-red
    in let back = hsl-to-rgb hsl
    in "hsl=" & format-hsl hsl & " back=" & format-rgb back

  test-gradient : Text =
    let pal = palette-gradient rgb-red rgb-blue 5
    in "grad=" & show (list-length pal) & " mid=" & format-rgb (list-at pal 2)

  test-hex : Text =
    "hex=" & format-hex-color (rgb 255 128 0)

  opening : [Console] Nothing = act
    print-line test-pack
    print-line test-lerp
    print-line test-blend
    print-line test-gray
    print-line test-invert
    print-line test-hsl
    print-line test-gradient
    print-line test-hex
  end

