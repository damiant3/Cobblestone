Chapter: AvCodecTest
  cites Codex chapter General
  cites Encode chapter Flac
  cites Encode chapter Avi
  cites Encode chapter Mp4
  cites Encode chapter Mp3
  cites Encode chapter Ogg
  cites Game chapter Color

Section: Body

  test-flac : Text =
    let samples = [0, 1000, 2000, 1000, 0, 0 - 1000, 0 - 2000, 0 - 1000]
    in let encoded = flac-encode 8000 samples
    in let magic = list-at encoded 0
    in "flac: size=" & show (list-length encoded) & " magic=" & show magic

  test-avi : Text =
    let cfg = avi-config 4 4 10
    in let frame1 = avi-test-frame 16 (rgb 255 0 0)
    in let frame2 = avi-test-frame 16 (rgb 0 255 0)
    in let encoded = avi-encode cfg [frame1, frame2]
    in let riff = list-at encoded 0
    in "avi: size=" & show (list-length encoded) & " riff=" & show riff & " dur=" & show (avi-duration-ms cfg 2)

  avi-test-frame : Integer, Rgb -> List Rgb
  avi-test-frame (n) (color) = avi-fill-frame n color []

  avi-fill-frame : Integer, Rgb, List Rgb -> List Rgb
  avi-fill-frame (n) (color) (acc) =
    if n <= 0 then acc
    else avi-fill-frame (n - 1) color (list-push acc color)

  test-mp4 : Text =
    let track = Mp4Track { mp4-track-type = mp4-video-track, mp4-width = 8, mp4-height = 8, mp4-timescale = 30, mp4-sample-count = 2, mp4-sample-size = 192 }
    in let encoded = mp4-encode track [0, 0, 0, 0]
    in let ftyp = list-at encoded 4
    in "mp4: size=" & show (list-length encoded) & " ftyp=" & show ftyp

  test-mp3 : Text =
    let cfg = mp3-44100-128k-stereo
    in let frame = mp3-encode-frame cfg []
    in "mp3: frame-size=" & show (frame.mf-size) & " hdr0=" & show (list-at (frame.mf-header) 0) & " dur=" & show (mp3-duration-ms cfg 10)

  test-ogg : Text =
    let packets = [[1, 2, 3, 4, 5], [10, 20, 30]]
    in let encoded = ogg-encode-stream 12345 packets
    in let magic = list-at encoded 0
    in "ogg: size=" & show (list-length encoded) & " magic=" & show magic

  opening : [Console] Nothing = act
    print-line-uni test-flac
    print-line-uni test-avi
    print-line-uni test-mp4
    print-line-uni test-mp3
    print-line-uni test-ogg
  end

