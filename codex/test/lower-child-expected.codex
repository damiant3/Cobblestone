Chapter: LowerChildExpected
  cites Foreword chapter Console

Section: Body

  heads : Boolean, List Integer -> List Integer
  heads (c) (rest) = (if c then 1 else 2) :: rest

  pick : Boolean -> [Console] Integer
  pick (c) = act
    if c then print-line-uni "yes" else print-line-uni "no"
    42
  end

  opening : [Console] Nothing = act
    print-line-uni (show (list-length (heads True [3, 4])))
    print-line-uni (show (pick False))
  end
