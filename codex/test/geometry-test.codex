Chapter: GeometryTest
  cites Math chapter Geometry
  cites Math chapter Quaternion

Section: Body

  test-vec2 : Text =
    let a = vec2-new 3000.0 4000.0
    in let b = vec2-new 1000.0 2000.0
    in let sum = vec2-add a b
    in let d = vec2-dot a b
    in let cr = vec2-cross a b
    in let len = vec2-length a
    in "add=" & format-vec2 sum & " dot=" & show d & " cross=" & show cr & " len=" & show len

  test-segment : Text =
    let s1 = seg2-new (vec2-new 0.0 0.0) (vec2-new 2000.0 0.0)
    in let s2 = seg2-new (vec2-new 1000.0 (0.0 - 1000.0)) (vec2-new 1000.0 1000.0)
    in let hit = seg2-intersect s1 s2
    in let dist = seg2-distance s1 (vec2-new 1000.0 500.0)
    in "hit=" & show (hit.si-hit) & " at=" & format-vec2 (hit.si-point) & " dist=" & show dist

  test-triangle : Text =
    let tri = tri2-new (vec2-new 0.0 0.0) (vec2-new 4000.0 0.0) (vec2-new 0.0 3000.0)
    in let area = tri2-area tri
    in let inside = tri2-contains tri (vec2-new 1000.0 1000.0)
    in let outside = tri2-contains tri (vec2-new 3000.0 3000.0)
    in let bary = tri2-barycentric tri (vec2-new 1000.0 1000.0)
    in "area=" & show area & " in=" & show inside & " out=" & show outside & " bary=" & format-bary bary

  test-polygon : Text =
    let sq = [vec2-new 0.0 0.0, vec2-new 2000.0 0.0, vec2-new 2000.0 2000.0, vec2-new 0.0 2000.0]
    in let area = poly-area sq
    in let perim = poly-perimeter sq
    in let inside = poly-contains sq (vec2-new 1000.0 1000.0)
    in let outside = poly-contains sq (vec2-new 3000.0 1000.0)
    in "area=" & show area & " perim=" & show perim & " in=" & show inside & " out=" & show outside

  test-hull : Text =
    let pts = [vec2-new 0.0 0.0, vec2-new 1000.0 1000.0, vec2-new 2000.0 0.0, vec2-new 1000.0 500.0, vec2-new 0.0 2000.0, vec2-new 2000.0 2000.0]
    in let hull = convex-hull pts
    in "hull=" & show (list-length hull)

  test-ray : Text =
    let ray = ray2-new (vec2-new 0.0 500.0) (vec2-new 1000.0 0.0)
    in let seg = seg2-new (vec2-new 2000.0 0.0) (vec2-new 2000.0 2000.0)
    in let hit = ray2-seg ray seg
    in "ray-seg=" & show (hit.rh-hit) & " t=" & show (hit.rh-t)

  opening : [Console] Nothing = act
    print-line-uni test-vec2
    print-line-uni test-segment
    print-line-uni test-triangle
    print-line-uni test-polygon
    print-line-uni test-hull
    print-line-uni test-ray
  end

