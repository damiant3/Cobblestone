Chapter: StringUtilsTest
  cites Foreword chapter StringUtils
  cites Foreword chapter CCE

Section: Body

  test-starts : Text =
    "sw=" & show (text-starts-with "hello" "hel") & "," & show (text-starts-with "hello" "xyz")

  test-ends : Text =
    "ew=" & show (text-ends-with "hello" "llo") & "," & show (text-ends-with "hello" "xyz")

  test-contains : Text =
    "co=" & show (text-contains "hello world" "world") & "," & show (text-contains "hello" "xyz")

  test-index : Text =
    "ix=" & show (text-index-of "hello world" "world") & "," & show (text-index-of "hello" "xyz")

  test-count : Text =
    "cnt=" & show (text-count "abcabcabc" "abc")

  test-replace : Text =
    "rep=" & text-replace "hello world" "world" "codex"

  test-reverse : Text =
    "rev=" & text-reverse "abcd"

  test-pad : Text =
    "pl=" & text-pad-left "42" 5 "0" & " pr=" & text-pad-right "hi" 5 "."

 The multi-character fill is the case that was wrong and that nothing
 asked about. These functions repeated the fill once per MISSING
 CHARACTER rather than padding to the width, which gives the same
 answer only when the fill is one character long -- and every call site
 in the tree passes one character, which is why the single-char
 assertion above held while the pair disagreed with its own prose and
 with the TextSearch pair it collided with. Padding "a" to 5 with "xy"
 returned nine characters.

  test-pad-wide : Text =
    "pl2=" & text-pad-left "a" 5 "xy" & " pr2=" & text-pad-right "a" 5 "xy"

  test-sub : Text =
    "sub=" & text-substring "hello world" 6 5

  test-join : Text =
    "join=" & text-join ", " ["a", "b", "c"]

  test-case : Text =
    "up=" & text-to-upper "hello" & " lo=" & text-to-lower "HELLO"

  opening : [Console] Nothing = act
    print-line-uni test-starts
    print-line-uni test-ends
    print-line-uni test-contains
    print-line-uni test-index
    print-line-uni test-count
    print-line-uni test-replace
    print-line-uni test-reverse
    print-line-uni test-pad
    print-line-uni test-pad-wide
    print-line-uni test-sub
    print-line-uni test-join
    print-line-uni test-case
  end

