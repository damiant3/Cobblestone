Chapter: KlondikeTest
  cites Game chapter Klondike
  cites Game chapter CardDeck
  cites Foreword chapter Maybe

Section: Body

  test-deal : Text =
    let st = klondike-new 42
    in let tab-sizes = show (pile-size (list-at (st.kl-tableau) 0)) & "," & show (pile-size (list-at (st.kl-tableau) 1)) & "," & show (pile-size (list-at (st.kl-tableau) 2)) & "," & show (pile-size (list-at (st.kl-tableau) 3)) & "," & show (pile-size (list-at (st.kl-tableau) 4)) & "," & show (pile-size (list-at (st.kl-tableau) 5)) & "," & show (pile-size (list-at (st.kl-tableau) 6))
    in "piles=" & tab-sizes & " stock=" & show (list-length (st.kl-stock))

  test-display : Text =
    let st = klondike-new 42
    in kl-format-state st

  test-tableau : Text =
    let st = klondike-new 42
    in kl-format-tableau st 0 & "\n" & kl-format-tableau st 1 & "\n" & kl-format-tableau st 6

  test-draw : Text =
    let st = klondike-new 42
    in let r = kl-draw st
    in when r
      is MoveOk (st2) -> "draw-ok waste=" & kl-format-waste st2
      is MoveErr (msg) -> "draw-err=" & msg

  test-foundation : Text =
    let st = klondike-new 42
    in "found=" & show (kl-foundation-count st) & " won=" & show (kl-is-won st)

  test-moves : Text =
    let st = klondike-new 42
    in let r1 = kl-draw st
    in when r1
      is MoveOk (st2) ->
        let r2 = kl-draw st2
        in when r2
          is MoveOk (st3) -> "after-2-draws stock=" & show (list-length (st3.kl-stock)) & " waste=" & show (list-length (st3.kl-waste))
          is MoveErr (msg) -> "err2=" & msg
      is MoveErr (msg) -> "err1=" & msg

  opening : [Console] Nothing = act
    print-line-uni test-deal
    print-line-uni test-display
    print-line-uni test-tableau
    print-line-uni test-draw
    print-line-uni test-foundation
    print-line-uni test-moves
  end

