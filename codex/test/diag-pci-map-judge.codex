Chapter: DiagPciMapJudge
  grounds Device.Port
  cites Diag chapter DiagPci

Section: Body
  judge : Text, List Integer -> Text
  judge (label) (bars) = label & "=" & pp-map-word (pp-map-judge bars)

  opening : [Console] Nothing = act
   print-line-uni (judge "rtl8168" [#C001, 0, #DF404004, 0, 0, 0])
   print-line-uni (judge "io-only" [#C001, 0, 0, 0, 0, 0])
   print-line-uni (judge "mem-low" [#81060000, 0, 0, 0, 0, 0])
   print-line-uni (judge "xhci-64" [4, #C0, 0, 0, 0, 0])
   print-line-uni (judge "ahci-b5" [0, 0, 0, 0, 0, #DF448000])
   print-line-uni (judge "io-then-low" [#C001, 0, #81060004, 0, 0, 0])
   print-line-uni (judge "none" [0, 0, 0, 0, 0, 0])
  end
