Chapter: NvFifoRefuse
  cites Kernel chapter NvFifo

Section: Main

  opening : [Console] Nothing = act
   print-line-uni ("gp-min " & show (nv-gp-entry #4 1 0 0))
   print-line-uni ("gp-unaligned " & show (nv-gp-entry #1002 1 0 0))
   print-line-uni ("gp-length-0 " & show (nv-gp-entry #1000 0 0 0))
   print-line-uni ("gp-length-over " & show (nv-gp-entry #1000 #200000 0 0))
   print-line-uni ("gp-address-over " & show (nv-gp-entry #10000000000 1 0 0))
   print-line-uni ("mh-op-2 " & show (nv-method-header 2 0 #100 1))
   print-line-uni ("mh-subc-8 " & show (nv-method-header 1 8 #100 1))
   print-line-uni ("mh-method-unaligned " & show (nv-method-header 1 0 #102 1))
   print-line-uni ("mh-method-over " & show (nv-method-header 1 0 #4000 1))
   print-line-uni ("mh-count-over " & show (nv-method-header 1 0 #100 #2000))
