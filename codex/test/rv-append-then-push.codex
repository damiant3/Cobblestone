Chapter: Rv Append Then Push
  cites Foreword chapter Console
  cites Compress chapter Deflate

Section: Body

  show-list : List Integer, Integer, Text -> Text
  show-list (xs) (i) (acc) =
    if i >= list-length xs then acc
    else show-list xs (i + 1) (acc & show (list-at xs i) & ",")

  pushed : List Integer, Integer -> List Integer
  pushed (acc) (n) = if n <= 0 then acc else pushed (list-push acc (n + 90)) (n - 1)

  opening : [Console] Nothing =
    let e = []
    in let lits = pushed [] 4
    in let a1 = e & lits
    in let a2 = [97, 98] & [97, 98]
    in act
      print-line-uni ("a1 " & show-list a1 0 "")
      print-line-uni ("c1 " & show-list (deflate-copy a1 1 4) 0 "")
      print-line-uni ("c2 " & show-list (deflate-copy a2 2 4) 0 "")
      print-line-uni ("c3 " & show-list (deflate-copy (e & lits) 0 3) 0 "")
      print-line-uni ("c4 " & show-list (deflate-copy (lits & e) 0 3) 0 "")
    end
