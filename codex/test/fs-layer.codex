Chapter: FsLayer
  cites Foreword chapter FileSystem
  cites Foreword chapter Fat16

Section: Layer

  fsl-read-vol : Fat16Volume, Text -> [Device.Block] Text
  fsl-read-vol (vol) (p) = when fat16-read-text vol p
    is Just (t) -> t
    is None -> "<absent>"

  fsl-read : Text -> [Device.Block] Text
  fsl-read (p) = act
    vol <- fat16-boot-volume
    fsl-read-vol vol p
  end

  serve-files : Integer -> [Device.Block] Text
  serve-files (x) = act
    with FileSystem (app-body x)
      read-text (p) (resume) = resume (fsl-read p)
      write-file (p) (c) (resume) = resume (fat16-write-file p c)
  end

Section: App

  app-body : Integer -> [FileSystem.Read, FileSystem.Write] Text
  app-body (x) =
    if x == 0 then
      (if write-file "NOTE.TXT" "from the layer" then read-text "NOTE.TXT" else "<write failed>")
    else read-text "NOPE.XXX"

Section: Entry

  opening : [Console, Device.Block] Nothing
  opening = act
    print-line-uni ("layer " & serve-files 0)
    print-line-uni ("absent " & serve-files 1)
  end
