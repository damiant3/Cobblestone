Chapter: NormalizeEq

Section: Terms

  Bit =
   | On
   | Off

  flip : Bit -> Bit
  flip (b) = when b
   is On -> Off
   is Off -> On

  id-bit : Bit -> Bit
  id-bit (x) = x

  claim flip-on : flip On === Off
  proof flip-on = Refl
  qed

  claim flip-off : flip Off === On
  proof flip-off = Refl
  qed

  claim id-on : id-bit On === On
  proof id-on = Refl
  qed

  claim flip-twice : flip (flip On) === On
  proof flip-twice = Refl
  qed

Section: Main

  opening : [Console] Nothing
  opening = act
   print-line-uni "normalize-eq ok"
  end
