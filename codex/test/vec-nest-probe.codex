Chapter: VecNestProbe
  cites Foreword chapter Console

Section: Producers

  ga : Integer -> Vector 2 Real
  ga (n) = if n > 100 then vec-splat 1.0 else vec-splat 3.0

  gb : Integer -> Vector 2 Real
  gb (n) = if n > 100 then vec-splat 2.0 else vec-splat 4.0

Section: Entry

  opening : [Console] Nothing
  opening = act
   print-line-uni ("flat: " & show (vec-extract (ga 1 * gb 1) 0))
   print-line-uni ("nestl: " & show (vec-extract (ga 1 * gb 1 + gb 1) 0))
   print-line-uni ("nestr: " & show (vec-extract (gb 1 + ga 1 * gb 1) 0))
   print-line-uni ("nestb: " & show (vec-extract (ga 1 * gb 1 + ga 1 * gb 1) 0))
  end
