Chapter: HandlerDotted
  cites Foreword chapter Console

Section: Effects

  effect Store where
    store-get : Integer -> [Store.Read] Integer
    store-put : Integer -> [Store.Write] Integer

Section: Body

  probe : Integer -> Integer
  probe (seed) =
    let r = with Store (store-get 5 + store-put seed)
      store-get (k) (resume) = resume (k * 2)
      store-put (v) (resume) = resume (v + 1)
    in r

  opening : [Console] Nothing =
    act
      print-line-uni ("dotted: " & show (probe 10))
    end

