Chapter: RaceNestedLoser
  cites Foreword chapter Console

Section: Helpers

  nested-loop : Integer, Integer -> Integer
  nested-loop (i) (acc) =
    if i <= 0 then acc
    else let t = fork (\x -> i)
    in let v = race [\x -> 1, \x -> race [\y -> await t, \y -> await t]]
    in let w = await t
    in nested-loop (i - 1) (acc + v + w)

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("nested: " & show (nested-loop 2000 0))
  end