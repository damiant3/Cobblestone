Chapter: Wasm Exports Root
  cites Foreword chapter Console

Section: Declared exports

  wasm-exports : Text = "|api-add|api-twice|"

  api-add : Integer, Integer -> Integer
  api-add (a) (b) = a + b

  api-twice : Integer -> Integer
  api-twice (x) = x + x

Section: Undeclared control

  api-absent : Integer -> Integer
  api-absent (x) = x + 1

Section: Entry

  opening : [Console] Nothing = print-line-uni "wasm-exports-root"
