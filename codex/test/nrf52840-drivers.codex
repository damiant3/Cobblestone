Chapter: Nrf52840Drivers

  cites Boards chapter Nrf52840Board

 Smoke test for nRF52840 board drivers. MMIO stubs return 0 on the
 hosted VM, so this exercises the driver logic and bit manipulation
 without real hardware. Task/event waits terminate immediately
 since event registers read as 0 (fuel-bounded loops).

 The driver functions declare [Device.Mmio], so the tests that call them
 declare it too. A test chapter is not on the effect-exemption list, so
 the row the drivers carry is checked right here, at the first caller
 outside the quire.

 The BLE beacon builder and the GATT attribute tables are pure -- they
 assemble bytes and never reach the radio -- so they are bound with plain
 lets. If someone gives one of them a register access later, those lines
 stop compiling.

Section: Definitions

  test-clock : [Device.Mmio] Integer
  test-clock = act
   hf <- nrf-clock-start-hfclk
   lf <- (nrf-clock-start-lfclk)
   1
  end

  test-gpio : [Device.Mmio] Integer
  test-gpio = act
   a <- nrf-gpio-set-output nrf-p0-base 13
   b <- nrf-gpio-set-input nrf-p0-base 4
   c <- nrf-gpio-set-pull nrf-p0-base 4 1
   d <- nrf-gpio-write nrf-p0-base 13 True
   e <- nrf-gpio-read nrf-p0-base 13
   f <- (nrf-gpio-toggle nrf-p0-base 13)
   1
  end

  test-led : [Device.Mmio] Integer
  test-led = act
   a <- nrf-led-init
   b <- nrf-led-on nrf-led1-pin
   c <- (nrf-led-off nrf-led1-pin)
   1
  end

  test-uart : [Device.Mmio] Integer
  test-uart = act
   a <- nrf-uarte-init nrf-uarte0-base 6 nrf-baud-115200
   b <- nrf-uarte-send-byte nrf-uarte0-base 65
   c <- nrf-uarte-print nrf-uarte0-base "hello"
   d <- (nrf-uarte-println nrf-uarte0-base "world")
   1
  end

  test-spi : [Device.Mmio] Integer
  test-spi = act
   a <- nrf-spim-init nrf-spim0-base 25 24 23
   b <- (nrf-spim-transfer nrf-spim0-base #AA)
   1
  end

  test-i2c : [Device.Mmio] Integer
  test-i2c = act
   a <- nrf-twim-init nrf-twim0-base 26 27
   b <- nrf-twim-write-reg nrf-twim0-base #68 #6B 0
   c <- (nrf-twim-read-reg nrf-twim0-base #68 #75)
   1
  end

  test-adc : [Device.Mmio] Integer
  test-adc = act
   a <- nrf-saadc-init 0
   b <- (nrf-saadc-read (nrf-sram-base + nrf-sram-size - 320))
   1
  end

  test-radio : [Device.Mmio] Integer
  test-radio = act
   a <- nrf-radio-config-ble
   b <- nrf-radio-set-channel 37
   c <- nrf-radio-set-channel 38
   d <- (nrf-radio-set-channel 39)
   1
  end

  test-ble-beacon : Integer
  test-ble-beacon =
   let pdu = ble-build-beacon "Codex"
   in let ok-type = if list-at pdu 0 == 2 then 1 else 0
   in let ok-len = if list-at pdu 1 > 6 then 1 else 0
   in let ok-addr0 = if list-at pdu 2 == #C0 then 1 else 0
   in let ok-addr5 = if list-at pdu 7 == #01 then 1 else 0
   in let ok-flags-len = if list-at pdu 8 == 2 then 1 else 0
   in let ok-flags-type = if list-at pdu 9 == 1 then 1 else 0
   in let ok-flags-val = if list-at pdu 10 == 6 then 1 else 0
   in let ok-total = if list-length pdu > 15 then 1 else 0
   in ok-type + ok-len + ok-addr0 + ok-addr5 + ok-flags-len + ok-flags-type + ok-flags-val + ok-total

  test-gatt : Integer
  test-gatt =
   let hr = gatt-heart-rate-service
   in let bat = gatt-battery-service
   in let temp = gatt-temperature-service
   in let ok-hr-uuid = if hr.svc-uuid == gatt-uuid-heart-rate-service then 1 else 0
   in let ok-hr-attrs = if gatt-service-attr-count hr == 6 then 1 else 0
   in let ok-bat-uuid = if bat.svc-uuid == gatt-uuid-battery-service then 1 else 0
   in let ok-bat-attrs = if gatt-service-attr-count bat == 3 then 1 else 0
   in let ok-temp-uuid = if temp.svc-uuid == gatt-uuid-temperature-service then 1 else 0
   in let ok-temp-attrs = if gatt-service-attr-count temp == 4 then 1 else 0
   in ok-hr-uuid + ok-hr-attrs + ok-bat-uuid + ok-bat-attrs + ok-temp-uuid + ok-temp-attrs

  test-delay : Integer
  test-delay =
   let a = nrf-delay-ms 1
   in 1

  opening : [Device.Mmio] Integer = act
   cl <- test-clock
   g <- test-gpio
   l <- test-led
   u <- test-uart
   s <- test-spi
   i <- test-i2c
   a <- test-adc
   r <- (test-radio)
   cl + g + l + u + s + i + a + r + test-ble-beacon + test-gatt + test-delay
  end

