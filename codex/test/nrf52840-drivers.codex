Chapter: Nrf52840Drivers

  cites Boards chapter Nrf52840Board

 Smoke test for nRF52840 board drivers. MMIO stubs return 0 on the
 hosted VM, so this exercises the driver logic and bit manipulation
 without real hardware. Task/event waits terminate immediately
 since event registers read as 0 (fuel-bounded loops).

Section: Definitions

  test-clock : Integer
  test-clock =
   let hf = nrf-clock-start-hfclk
   in let lf = nrf-clock-start-lfclk
   in 1

  test-gpio : Integer
  test-gpio =
   let a = nrf-gpio-set-output nrf-p0-base 13
   in let b = nrf-gpio-set-input nrf-p0-base 4
   in let c = nrf-gpio-set-pull nrf-p0-base 4 1
   in let d = nrf-gpio-write nrf-p0-base 13 True
   in let e = nrf-gpio-read nrf-p0-base 13
   in let f = nrf-gpio-toggle nrf-p0-base 13
   in 1

  test-led : Integer
  test-led =
   let a = nrf-led-init
   in let b = nrf-led-on nrf-led1-pin
   in let c = nrf-led-off nrf-led1-pin
   in 1

  test-uart : Integer
  test-uart =
   let a = nrf-uarte-init nrf-uarte0-base 6 nrf-baud-115200
   in let b = nrf-uarte-send-byte nrf-uarte0-base 65
   in let c = nrf-uarte-print nrf-uarte0-base "hello"
   in let d = nrf-uarte-println nrf-uarte0-base "world"
   in 1

  test-spi : Integer
  test-spi =
   let a = nrf-spim-init nrf-spim0-base 25 24 23
   in let b = nrf-spim-transfer nrf-spim0-base #AA
   in 1

  test-i2c : Integer
  test-i2c =
   let a = nrf-twim-init nrf-twim0-base 26 27
   in let b = nrf-twim-write-reg nrf-twim0-base #68 #6B 0
   in let c = nrf-twim-read-reg nrf-twim0-base #68 #75
   in 1

  test-adc : Integer
  test-adc =
   let a = nrf-saadc-init 0
   in let b = nrf-saadc-read (nrf-sram-base + nrf-sram-size - 320)
   in 1

  test-radio : Integer
  test-radio =
   let a = nrf-radio-config-ble
   in let b = nrf-radio-set-channel 37
   in let c = nrf-radio-set-channel 38
   in let d = nrf-radio-set-channel 39
   in 1

  test-ble-beacon : Integer
  test-ble-beacon =
   let pdu = ble-build-beacon "Codex"
   in let ok-type = if list-at pdu 0 == 2 then 1 else 0
   in let ok-len = if list-at pdu 1 > 6 then 1 else 0
   in let ok-addr0 = if list-at pdu 2 == #C0 then 1 else 0
   in let ok-addr5 = if list-at pdu 7 == #01 then 1 else 0
   in let ok-flags-len = if list-at pdu 8 == 2 then 1 else 0
   in let ok-flags-type = if list-at pdu 9 == 1 then 1 else 0
   in let ok-flags-val = if list-at pdu 10 == 6 then 1 else 0
   in let ok-total = if list-length pdu > 15 then 1 else 0
   in ok-type + ok-len + ok-addr0 + ok-addr5 + ok-flags-len + ok-flags-type + ok-flags-val + ok-total

  test-gatt : Integer
  test-gatt =
   let hr = gatt-heart-rate-service
   in let bat = gatt-battery-service
   in let temp = gatt-temperature-service
   in let ok-hr-uuid = if hr.svc-uuid == gatt-uuid-heart-rate-service then 1 else 0
   in let ok-hr-attrs = if gatt-service-attr-count hr == 6 then 1 else 0
   in let ok-bat-uuid = if bat.svc-uuid == gatt-uuid-battery-service then 1 else 0
   in let ok-bat-attrs = if gatt-service-attr-count bat == 3 then 1 else 0
   in let ok-temp-uuid = if temp.svc-uuid == gatt-uuid-temperature-service then 1 else 0
   in let ok-temp-attrs = if gatt-service-attr-count temp == 4 then 1 else 0
   in ok-hr-uuid + ok-hr-attrs + ok-bat-uuid + ok-bat-attrs + ok-temp-uuid + ok-temp-attrs

  test-delay : Integer
  test-delay =
   let a = nrf-delay-ms 1
   in 1

  opening : Integer =
   let cl = test-clock
   in let g = test-gpio
   in let l = test-led
   in let u = test-uart
   in let s = test-spi
   in let i = test-i2c
   in let a = test-adc
   in let r = test-radio
   in let b = test-ble-beacon
   in let ga = test-gatt
   in let d = test-delay
   in cl + g + l + u + s + i + a + r + b + ga + d

