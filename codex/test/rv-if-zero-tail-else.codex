Chapter: Rv If Zero Tail Else
  cites Foreword chapter Console

Section: Body

  sole : List Integer, Integer, Integer -> Integer
  sole (lens) (i) (found) =
    if i >= list-length lens then found
    else if list-at lens i == 0 then sole lens (i + 1) found
    else if found >= 0 then 0 - 1
    else sole lens (i + 1) i

  opening : [Console] Nothing = act
    print-line-uni ("none " & show (sole [0, 0, 0] 0 (0 - 1)))
    print-line-uni ("one " & show (sole [0, 2, 0] 0 (0 - 1)))
    print-line-uni ("two " & show (sole [0, 2, 0, 3] 0 (0 - 1)))
    print-line-uni ("adjacent " & show (sole [4, 5] 0 (0 - 1)))
  end
