Chapter: TypeClassSmoke
  cites Foreword chapter Console

 Combined type class tests: basic, eq, generic, genvar, manual dict,
 multi-instance, parameterized, return-type, deriving Show/Eq/Ord,
 constraints (concrete, match, ord-generic, prim, show-generic).

class Showable where
  to-text : a -> Text

instance Showable Integer where
  to-text (x) = show x

instance Showable Boolean where
  to-text (b) = if b then "yes" else "no"

instance Showable (List Integer) where
  to-text (xs) = "list of " & show (list-length xs)

class Equatable where
  is-equal : a, a -> Boolean

instance Equatable Integer where
  is-equal (x) (y) = x == y

instance Equatable Boolean where
  is-equal (a) (b) = if a then b else if b then False else True

class Zeroed where
  zero-val : a

instance Zeroed Integer where
  zero-val = 0

instance Zeroed Text where
  zero-val = "none"

Section: Types

  Color = | Red | Green | Blue  deriving Show, Eq, Ord

  Shape =
    | Circle (Integer)
    | Rect (Integer) (Integer)
    deriving Show, Ord

  Wrap = | Wrap (Integer)  deriving Eq

  Point = record { x : Integer, y : Integer }  deriving Eq

Section: Generic Functions

  describe : Showable a => a -> Text
  describe (x) = "Value: " & to-text x

  go : Integer -> Text
  go (n) = describe n

  pick-int : Integer
  pick-int = zero-val

  pick-text : Text
  pick-text = zero-val

  describe-show : Show a => a -> Text
  describe-show (x) = "[" & show x & "]"

  describe-let : Show a => a -> Text
  describe-let (x) = let n = 42 in show n & "/" & show x

  describe-match : Show a => a -> Text
  describe-match (x) = when x is otherwise -> "<" & show x & ">"

  rel : Ord a => a -> a -> Text
  rel (x) (y) = let c = compare x y in if c < 0 then "lt" else if c > 0 then "gt" else "eq"

Section: Manual Dictionary

  ShowDict = record { show-impl : Integer -> Text }
  show-dict-integer : ShowDict
  show-dict-integer = ShowDict { show-impl = \x -> show x }
  show-via : ShowDict, Integer -> Text
  show-via (dict) (x) = (dict.show-impl) x

Section: Body

  opening : [Console] Nothing = act
    print-line-uni (to-text 42)
    print-line-uni (describe 99)
    print-line-uni (describe True)
    print-line-uni (go 42)
    print-line-uni (to-text [1, 2, 3])
    print-line-uni (show (is-equal 3 3))
    print-line-uni (show (is-equal 3 4))
    print-line-uni (show (is-equal True False))
    print-line-uni (show pick-int)
    print-line-uni pick-text
    print-line-uni (show-via show-dict-integer 42)
    print-line-uni (show Green)
    print-line-uni (show (Circle 5))
    print-line-uni (show (Rect 3 4))
    print-line-uni (show (Red == Red))
    print-line-uni (show (Red == Blue))
    print-line-uni (show (Wrap 5 == Wrap 5))
    print-line-uni (show (Wrap 5 == Wrap 6))
    print-line-uni (show (Point { x = 1, y = 2 } == Point { x = 1, y = 2 }))
    print-line-uni (show (compare Red Blue))
    print-line-uni (show (compare Green Green))
    print-line-uni (describe-show (Circle 5))
    print-line-uni (describe-show 42)
    print-line-uni (describe-show True)
    print-line-uni (describe-let Blue)
    print-line-uni (describe-match 7)
    print-line-uni (rel (Circle 1) (Circle 2))
    print-line-uni (rel (Circle 5) (Circle 5))
    print-line-uni (rel 1 2)
  end

