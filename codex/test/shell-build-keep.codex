 We say:

Section: Probe

  loop-body-len : ShellCmd -> Integer
  loop-body-len (c) = when c
   is ScForLoop (name) (init) (cond) (step) (body) -> list-length body
   is otherwise -> 0 - 1

  opening : [Console] Nothing = act
    print-line-uni ("for-loop-body: " & show (loop-body-len (sh-for-loop "i" (SeInt 0) (SeInt 3) (SeInt 1) [sh-exit 0])))
    print-line-uni ("while-body: " & show (loop-body-len (sh-while (SeInt 1) [])))
  end
