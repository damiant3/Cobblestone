Chapter: ParMap
  cites Codex chapter Concurrency

Section: Definitions

  double : Integer -> Integer
  double (x) = x * 2

  opening : [Concurrent] Integer = act
    t1 <- fork (\u -> double 1)
    t2 <- fork (\u -> double 2)
    t3 <- fork (\u -> double 3)
    t4 <- fork (\u -> double 4)
    t5 <- fork (\u -> double 5)
    a <- await t1
    b <- await t2
    c <- await t3
    d <- await t4
    e <- await t5
    a + b + c + d + e
  end

