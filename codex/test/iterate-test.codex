Chapter: IterateTest
  cites Foreword chapter Iterate
  cites Foreword chapter Console

Section: Body
  opening : [Console] Nothing = act
    let xs = [10, 20, 30, 40, 50]
    in let doubled = list-map-generic (\x -> x * 2) xs
    in let evens = list-filter-generic (\x -> x > 20) xs
    in let idx = list-find-index (\x -> x == 30) xs
    in let count = list-count-where (\x -> x >= 30) xs
    in let first3 = list-take-generic xs 3
    in let last2 = list-drop-generic xs 3
    in act
      print-line-uni (show (list-length doubled))
      print-line-uni (show (list-length evens))
      print-line-uni (show idx)
      print-line-uni (show count)
      print-line-uni (show (list-length first3))
      print-line-uni (show (list-length last2))
    end
  end

