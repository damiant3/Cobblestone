Chapter: ListPattern
  cites Foreword chapter Console

 Structural Nil/Cons matching over the builtin flat List, the 2.5
 capability. Each definition exercises one shape the desugar must
 get right: Nil-first and Cons-first arm orders, a wildcard head, a
 wildcard tail, an otherwise catchall, the empty list reaching both
 kinds of arm, and structural recursion whose tails are O(1) views
 rather than copies.

Section: Functions

  sum-list : List Integer -> Integer
  sum-list (xs) =
   when xs
    is Nil -> 0
    is Cons (h) (t) -> h + sum-list t

  count-list : List Integer -> Integer
  count-list (xs) =
   when xs
    is Cons (_) (t) -> 1 + count-list t
    is Nil -> 0

  head-or : List Integer, Integer -> Integer
  head-or (xs) (d) =
   when xs
    is Cons (h) (_) -> h
    is otherwise -> d

  second-or : List Integer, Integer -> Integer
  second-or (xs) (d) =
   when xs
    is Cons (_) (t) -> head-or t d
    is Nil -> d

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("sum=" & show (sum-list [1, 2, 3, 4, 5]))
    print-line-uni ("count=" & show (count-list [7, 8, 9]))
    print-line-uni ("head=" & show (head-or [42, 1] 0))
    print-line-uni ("headE=" & show (head-or [] 0))
    print-line-uni ("second=" & show (second-or [5, 6, 7] 0))
    print-line-uni ("secondE=" & show (second-or [5] 0))
    print-line-uni ("sumE=" & show (sum-list []))
  end
