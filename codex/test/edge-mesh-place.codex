Chapter: EdgeMeshPlaceTest

  cites Foreword chapter Console
  cites Engine chapter EdgeMesh
  cites Net chapter GroupMembership
  cites Mesh chapter EdgeMeshLive
  cites Mesh chapter EdgeMeshFederate
  cites Mesh chapter EdgeMeshPlace

 EdgeMeshGameServers phase 3, stage 2. The two arms that matter pull the same
 way phase 2's did: a match must go to a node running ITS game even when a node
 running another game is lighter, and must be REFUSED when its own game has no
 healthy node, rather than falling back to the healthy one next door.

 EVERY SCENARIO BUILDS ITS OWN GROUP and only the newest name is read.
 `GroupState` operations are `__record-set` on the argument, which stores in
 place and returns the same record.

Section: Fixtures

  serving : Text, Text, Integer, Integer -> ServiceLocation
  serving (svc) (member) (load) (health) =
    ServiceLocation {
      sl-service = svc,
      sl-version = "1",
      sl-member-id = member,
      sl-address = "10.0.1." & show load,
      sl-port = 7000,
      sl-role = SrLoadBalanced,
      sl-health = health,
      sl-load = load,
      sl-registered = 0,
      sl-last-check = 0
    }

Section: Entry

  opening : [Console] Nothing
  opening = act
    let rl = default-regions
    in let east = list-at (rl.rl-regions) 0
    in let magic-svc = place-game-service "codexmagic" east
    in let chess-svc = place-game-service "chess" east
    in act
      act
        let g = gs-register-service (gs-register-service (group-new "p-a" "a") (serving magic-svc "node-a" 40 10000)) (serving chess-svc "node-b" 5 10000)
        in act
          print-line-uni ("the lighter node runs another game: " & place-label (place-for-game g rl 0 "codexmagic"))
          print-line-uni ("and its own game reaches it: " & place-label (place-for-game g rl 0 "chess"))
        end
      end

      act
        let g = gs-register-service (gs-register-service (group-new "p-b" "b") (serving magic-svc "node-c" 41 2000)) (serving chess-svc "node-d" 6 10000)
        in print-line-uni ("its own game is unhealthy, another game is not: " & place-label (place-for-game g rl 0 "codexmagic"))
      end

      act
        let g = gs-register-service (group-new "p-c" "c") (serving (mesh-region-service east) "node-e" 1 10000)
        in print-line-uni ("a phase 2 region registration is not a game's: " & place-label (place-for-game g rl 0 "codexmagic"))
      end

      act
        let g = gs-register-service (group-new "p-d" "d") (serving magic-svc "node-f" 7 10000)
        in print-line-uni ("no such region: " & place-label (place-for-game g rl 99 "codexmagic"))
      end

      act
        let q = fed-enqueue (fed-enqueue fed-new "codexmagic" (waiting-for 1 "a" 1500)) "codexmagic" (waiting-for 2 "b" 1510)
        in let g = gs-register-service (group-new "p-e" "e") (serving magic-svc "node-g" 8 10000)
        in print-line-uni ("a paired match places: " & place-label (place-for-match g rl 0 (fed-try-pair q "codexmagic" ModeRanked 0)))
      end

      act
        let q = fed-enqueue fed-new "codexmagic" (waiting-for 3 "lonely" 1500)
        in let g = gs-register-service (group-new "p-f" "f") (serving magic-svc "node-h" 9 10000)
        in print-line-uni ("an unpaired queue places nothing: " & place-label (place-for-match g rl 0 (fed-try-pair q "codexmagic" ModeRanked 0)))
      end
    end
  end

  waiting-for : Integer, Text, Integer -> QueuedPlayer
  waiting-for (id) (name) (rating) =
    QueuedPlayer {
      qp-id = id,
      qp-name = name,
      qp-rating = rating,
      qp-region-pref = 0,
      qp-latencies = [],
      qp-queue-time = 0,
      qp-game-mode = ModeRanked
    }
