Chapter: HdaCaptureStall
  cites Kernel chapter MicInput
  cites Kernel chapter HdaAudio

Section: Body

  opening : [Console, Device.Mmio, Microphone] Nothing = act
    buf <- hda-capture 4096
    print-line-uni (if buf == 0 then "capture: refused" else "capture: served")
    p <- mic-peak 4096
    print-line-uni ("peak: " & show p)
    print-line-uni (listen 10)
  end
