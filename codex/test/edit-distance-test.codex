Chapter: EditDistanceTest
  cites Codex chapter General
  cites Foreword chapter EditDistance
  cites Foreword chapter CCE

Section: Body

  test-identical : Text =
    "same=" & show (edit-distance "hello" "hello")

  test-empty : Text =
    "empty=" & show (edit-distance "" "abc") & "," & show (edit-distance "abc" "")

  test-basic : Text =
    let d1 = edit-distance "kitten" "sitting"
    in let d2 = edit-distance "saturday" "sunday"
    in "kitten-sitting=" & show d1 & " saturday-sunday=" & show d2

  test-single : Text =
    let d1 = edit-distance "cat" "hat"
    in let d2 = edit-distance "cat" "cats"
    in let d3 = edit-distance "cat" "at"
    in "sub=" & show d1 & " ins=" & show d2 & " del=" & show d3

  test-similarity : Text =
    let s1 = edit-similarity "hello" "hello"
    in let s2 = edit-similarity "hello" "hallo"
    in "sim-same=" & show s1 & " sim-close=" & show s2

  test-best-match : Text =
    let candidates = ["help", "shell", "hello", "world", "helm"]
    in let best = edit-best-match "helo" candidates
    in "best=" & format-edit-match best

  test-within : Text =
    let candidates = ["help", "shell", "hello", "world", "helm"]
    in let matches = edit-within "helo" candidates 2
    in "within-2=" & show (list-length matches)

  opening : [Console] Nothing = act
    print-line-uni test-identical
    print-line-uni test-empty
    print-line-uni test-basic
    print-line-uni test-single
    print-line-uni test-similarity
    print-line-uni test-best-match
    print-line-uni test-within
  end

