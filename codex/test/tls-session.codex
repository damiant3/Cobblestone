Section: Helpers

  tr-eq : List Integer, List Integer -> Boolean
  tr-eq (a) (b) =
    if list-length a /= list-length b then False
    else tr-eq-loop a b 0 (list-length a)

  tr-eq-loop : List Integer, List Integer, Integer, Integer -> Boolean
  tr-eq-loop (a) (b) (i) (n) =
    if i >= n then True
    else if list-at a i /= list-at b i then False
    else tr-eq-loop a b (i + 1) n

  rec-body : List Integer -> List Integer
  rec-body (rec) = dtls-take-at rec 9 (list-length rec - 9)

  groups-ext : List Integer -> List Integer
  groups-ext (ids) = tls-be16 10 & tls-be16 (list-length ids + 2) & tls-be16 (list-length ids) & ids

  p256-ks-ext : List Integer =
    let entry = tls-be16 23 & tls-be16 65 & p256-share
    in tls-be16 51 & tls-be16 (list-length entry + 2) & tls-be16 (list-length entry) & entry

  ch-body-with : List Integer -> List Integer
  ch-body-with (groups) =
    let exts = tls-ext-versions & groups-ext groups & tls-ext-sig-algs & p256-ks-ext
    in [3, 3] & c-random & [32] & c-sid & tls-be16 2 & tls-be16 tls-cipher-aes-128-gcm-sha256 & [1, 0] & tls-be16 (list-length exts) & exts

  ch-rec : List Integer -> List Integer
  ch-rec (body) = tls-encode-record tls-content-handshake (tls13-msg-transcript dtls-hs-client-hello body)

  server-ep : TlsEp = tls-ep-server-new s-priv s-random [leaf-cert] leaf-priv leaf-pub

  fresh-server : Integer -> linear Session (SRecv TsClientHello (SOffer (SSend TsHelloRetry (SRecv TsClientHello (SSend TsServerFlight (SRecv TsClientFinished (SSend TsCloseNotify SEnd))))) (SSend TsServerFlight (SRecv TsClientFinished (SSend TsCloseNotify SEnd))))) TlsEpStep
  fresh-server (n) = tls-session-server-open server-ep

  drop : linear Session p TlsEpStep, Text -> Text
  drop (x) (t) =
    let gone = session-abandon x
    in t

  tail-recs : List (List Integer), Integer -> List (List Integer)
  tail-recs (rs) (i) = if i >= list-length rs then [] else [list-at rs i] & tail-recs rs (i + 1)

  run-handshake : linear Session (SRecv TsServerHello (SRecv TsServerFlight (SSend TsClientFinished (SSend TsCloseNotify SEnd)))) TlsEpStep, (linear Session (SRecv TsClientFinished (SSend TsCloseNotify SEnd)) TlsEpStep) -> Text
  run-handshake (c1) (s1) =
    when session-peek s1
      is MkPeeked (sv) (s1b) -> run-client c1 s1b (sv.tes-out)

  run-client : linear Session (SRecv TsServerHello (SRecv TsServerFlight (SSend TsClientFinished (SSend TsCloseNotify SEnd)))) TlsEpStep, (linear Session (SRecv TsClientFinished (SSend TsCloseNotify SEnd)) TlsEpStep), List (List Integer) -> Text
  run-client (c1) (s1) (outs) =
    when session-peek (tls-session-server-flight (tls-session-server-hello c1 (list-at outs 0)) (tail-recs outs 1))
      is MkPeeked (cv) (c3) -> run-fin c3 (tls-session-client-finished s1 (list-at (cv.tes-out) 0)) (list-length outs) (tls-ep-done (cv.tes-ep))

  run-fin : linear Session (SSend TsCloseNotify SEnd) TlsEpStep, (linear Session (SSend TsCloseNotify SEnd) TlsEpStep), Integer, Boolean -> Text
  run-fin (c3) (s2) (n) (cdone) =
    when session-peek s2
      is MkPeeked (sv) (s2b) -> run-app c3 s2b n cdone (tls-ep-done (sv.tes-ep))

  run-app : linear Session (SSend TsCloseNotify SEnd) TlsEpStep, (linear Session (SSend TsCloseNotify SEnd) TlsEpStep), Integer, Boolean, Boolean -> Text
  run-app (c3) (s2) (n) (cdone) (sdone) =
    when session-peek (tls-session-send-app c3 [71, 69, 84])
      is MkPeeked (cv) (c4) -> run-close c4 (tls-session-recv-app s2 (list-at (cv.tes-out) 0)) n cdone sdone

  run-close : linear Session (SSend TsCloseNotify SEnd) TlsEpStep, (linear Session (SSend TsCloseNotify SEnd) TlsEpStep), Integer, Boolean, Boolean -> Text
  run-close (c4) (s3) (n) (cdone) (sdone) =
    when session-peek (tls-session-close-notify c4)
      is MkPeeked (cv) (c5) ->
        "server-outs=" & show n & " client-done=" & show cdone & " server-done=" & show sdone & " c2s=" & show (tr-eq (tls-ep-app-in ((tls-session-done (tls-session-close-notify (tls-session-recv-app s3 (list-at (cv.tes-out) 0)))).tes-ep)) [71, 69, 84]) & " close-outs=" & show (list-length ((tls-session-done c5).tes-out))

Section: Direct

  direct-1 : Integer -> Text
  direct-1 (n) = direct-2 (session-peek (tls-session-hello (tls-session-client-open (tls-ep-client-new c-priv c-random [] [] []))))

  direct-2 : Peeked (SRecv TsServerHello (SRecv TsServerFlight (SSend TsClientFinished (SSend TsCloseNotify SEnd)))) TlsEpStep -> Text
  direct-2 (pk) =
    when pk
      is MkPeeked (v) (c1) -> direct-after c1 (tls-session-accept (fresh-server 0) (list-at (v.tes-out) 0))

  direct-after : linear Session (SRecv TsServerHello (SRecv TsServerFlight (SSend TsClientFinished (SSend TsCloseNotify SEnd)))) TlsEpStep, Offered (SRecv TsClientHello (SSend TsServerFlight (SRecv TsClientFinished (SSend TsCloseNotify SEnd)))) (SRecv TsClientFinished (SSend TsCloseNotify SEnd)) TlsEpStep -> Text
  direct-after (c1) (o) =
    when o
      is TookRight (s1) -> run-handshake c1 s1
      is TookLeft (s1) -> drop c1 (drop s1 "retry")
      is Refused (s) -> drop c1 "refused"

  test-direct : Text = "tls direct: " & direct-1 0

Section: Retry

  ch1-body : List Integer = ch-body-with [0, 23, 0, 29]

  retry-client : List Integer -> linear Session (SRecv TsServerHello (SRecv TsServerFlight (SSend TsClientFinished (SSend TsCloseNotify SEnd)))) TlsEpStep
  retry-client (hrr-body) =
    let tr = tls13-transcript-after-hrr (tls13-msg-transcript dtls-hs-client-hello ch1-body) & tls13-msg-transcript dtls-hs-server-hello hrr-body
    in tls-session-hello (tls-session-client-open (__record-set (tls-ep-client-new c-priv c-random [] [] []) "tep-transcript" tr))

  retry-second : linear Session (SRecv TsClientHello (SSend TsServerFlight (SRecv TsClientFinished (SSend TsCloseNotify SEnd)))) TlsEpStep, List (List Integer) -> Text
  retry-second (sl) (hrr-outs) =
    when session-peek (retry-client (rec-body (list-at hrr-outs 0)))
      is MkPeeked (cv) (rc1) -> retry-answer rc1 (tls-session-accept-retry sl (list-at (cv.tes-out) 0))

  retry-answer : linear Session (SRecv TsServerHello (SRecv TsServerFlight (SSend TsClientFinished (SSend TsCloseNotify SEnd)))) TlsEpStep, Answered (SRecv TsClientFinished (SSend TsCloseNotify SEnd)) TlsEpStep -> Text
  retry-answer (rc1) (a) =
    when a
      is Accepted (s1) -> run-handshake rc1 s1
      is Rejected (s) -> drop rc1 "rejected"

  retry-again : linear Session (SRecv TsClientHello (SSend TsServerFlight (SRecv TsClientFinished (SSend TsCloseNotify SEnd)))) TlsEpStep -> Text
  retry-again (sl) =
    when tls-session-accept-retry sl (ch-rec ch1-body)
      is Accepted (s1) -> drop s1 "accepted"
      is Rejected (s) -> "rejected alert=" & show (tr-eq (list-at (s.tes-out) 0) [21, 3, 3, 0, 2, 2, 47])

  retry-after : Offered (SRecv TsClientHello (SSend TsServerFlight (SRecv TsClientFinished (SSend TsCloseNotify SEnd)))) (SRecv TsClientFinished (SSend TsCloseNotify SEnd)) TlsEpStep -> Text
  retry-after (o) =
    when o
      is TookLeft (sl) -> retry-peek (session-peek sl)
      is TookRight (s1) -> drop s1 "direct"
      is Refused (s) -> "refused"

  retry-peek : Peeked (SRecv TsClientHello (SSend TsServerFlight (SRecv TsClientFinished (SSend TsCloseNotify SEnd)))) TlsEpStep -> Text
  retry-peek (pk) =
    when pk
      is MkPeeked (v) (sl) -> "hrr-outs=" & show (list-length (v.tes-out)) & " " & retry-second sl (v.tes-out)

  test-retry : Text = "tls retry: " & retry-after (tls-session-accept (fresh-server 0) (ch-rec ch1-body))

  again-after : Offered (SRecv TsClientHello (SSend TsServerFlight (SRecv TsClientFinished (SSend TsCloseNotify SEnd)))) (SRecv TsClientFinished (SSend TsCloseNotify SEnd)) TlsEpStep -> Text
  again-after (o) =
    when o
      is TookLeft (sl) -> retry-again sl
      is TookRight (s1) -> drop s1 "direct"
      is Refused (s) -> "refused"

  test-again : Text = "tls retry-again: " & again-after (tls-session-accept (fresh-server 0) (ch-rec ch1-body))

Section: Refused

  refused-after : Offered (SRecv TsClientHello (SSend TsServerFlight (SRecv TsClientFinished (SSend TsCloseNotify SEnd)))) (SRecv TsClientFinished (SSend TsCloseNotify SEnd)) TlsEpStep -> Text
  refused-after (o) =
    when o
      is Refused (s) -> "alert=" & show (tr-eq (list-at (s.tes-out) 0) [21, 3, 3, 0, 2, 2, 40])
      is TookLeft (sl) -> drop sl "retry"
      is TookRight (s1) -> drop s1 "direct"

  test-refused : Text = "tls no-x25519: " & refused-after (tls-session-accept (fresh-server 0) (ch-rec (ch-body-with [0, 23])))
Section: Entry

  opening : [Console] Nothing = act
    print-line-uni test-direct
    print-line-uni test-retry
    print-line-uni test-again
    print-line-uni test-refused
  end

