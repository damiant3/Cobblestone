Chapter: Utf8CceBoundary
  cites Codex chapter UTF-8 To CCE
  cites Foreword chapter CCE
  cites Foreword chapter Console

Section: Mapping
  tier : Integer -> Text
  tier (u) =
    if cce-from-uni-t0 u 0 128 >= 0 then "t0"
    else if cce-from-uni-t1 u 0 >= 0 then "t1"
    else if cce-from-uni-t2 u 0 >= 0 then "t2"
    else "none"

  map-row : Integer -> Text
  map-row (u) =
    let c = cce-from-uni u
    in let back = if c >= 0 & c < 128 then " table-back=" & show (list-at cce-to-unicode-table c == u) else ""
    in "U+" & show u & " -> " & show c & " " & tier u & back

Section: Framing
  cce-round : Integer -> Text
  cce-round (cp) =
    let bs = cce-frame cp
    in let t = raw-bytes-to-text bs
    in "cce " & show cp & " len=" & show (list-length bs) & " lead-len=" & show (cce-frame-len (list-at bs 0)) & " back=" & show (cce-unframe t 0)

  utf8-round : Integer -> Text
  utf8-round (cp) =
    let bs = utf8-frame cp
    in let t = raw-bytes-to-text bs
    in "utf8 " & show cp & " len=" & show (list-length bs) & " lead-len=" & show (utf8-len (list-at bs 0)) & " back=" & show (utf8-unframe t 0)

  converted : List Integer -> Text
  converted (bs) =
    let out = utf8-to-cce (raw-bytes-to-text bs)
    in "utf8-to-cce " & show (list-length bs) & " bytes -> " & show (text-length out) & " bytes, first=" & show (char-code-at out 0) & " last=" & show (char-code-at out (text-length out - 1))

  opening : [Console] Nothing = act
    print-line-uni (map-row 65)
    print-line-uni (map-row 32)
    print-line-uni (map-row 233)
    print-line-uni (map-row 913)
    print-line-uni (map-row 1029)
    print-line-uni (map-row 19968)
    print-line-uni (map-row 20479)
    print-line-uni (map-row 20480)
    print-line-uni (map-row 12288)
    print-line-uni (map-row 44032)
    print-line-uni (map-row 127744)
    print-line-uni (map-row 1114111)
    print-line-uni (cce-round 127)
    print-line-uni (cce-round 128)
    print-line-uni (cce-round 2175)
    print-line-uni (cce-round 2176)
    print-line-uni (cce-round 67711)
    print-line-uni (cce-round 67712)
    print-line-uni (cce-round 1180000)
    print-line-uni (utf8-round 127)
    print-line-uni (utf8-round 128)
    print-line-uni (utf8-round 2047)
    print-line-uni (utf8-round 2048)
    print-line-uni (utf8-round 65535)
    print-line-uni (utf8-round 65536)
    print-line-uni (utf8-round 1114111)
    print-line-uni (converted [97, 98, 99])
    print-line-uni (converted ([97] & utf8-frame 19968 & [98]))
    print-line-uni (converted ([97] & utf8-frame 1114111 & [98]))
  end
