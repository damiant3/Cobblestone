Chapter: DbCsvRoundtrip
  cites Foreword chapter Console
  cites Data chapter Schema
  cites Data chapter Row
  cites Data chapter Catalog
  cites Data chapter Transaction
  cites Data chapter BulkLoader

Section: Body

  mk-t : TableDef
  mk-t = table-def-with-pk "t" [
    col-def-not-null "id" ColInteger,
    col-def-not-null "nm" ColText,
    col-def "qty" ColInteger
  ] ["id"]

  opening : [Console] Nothing = act
    let c0 = catalog-new
    in let c1 = (catalog-create-table c0 mk-t).cat
    in let mgr = txn-manager-new
    in let lines = ["id,nm,qty", "1,Ann,5", "2,Bob,7"]
    in let r = bulk-import-lines c1 mgr "t" lines default-import-config
    in let out = export-table (r.bi-catalog) "t" default-import-config
    in act
      print-line-uni ("imported=" & show (r.bi-rows-loaded) & " ok=" & show (r.bi-ok))
      print-line-uni ("hdr=" & list-at out 0)
      print-line-uni ("row1=" & list-at out 1)
      print-line-uni ("row2=" & list-at out 2)
    end
  end
