 Every zone's transitions from 2038-01-01 to 2100-01-01 UTC, which the
 table (through 2037) does not hold: the zone goes through its CTZ2 bytes and
 back, so the footer rules come from the encoding, and zone-cover extends it.
 The test prints the zone, its count and the SHA-256 of "T utc utoff abbr"
 lines; build/tz-oracle.ps1 -Future hashes the same from zic's footer.

Section: Listing

  tz-hex-digit : Integer -> Text
  tz-hex-digit (n) = substring "0123456789abcdef" n 1

  tz-hex : List Integer, Integer -> Text
  tz-hex (bs) (i) =
    if i >= list-length bs then ""
    else tz-hex-digit (bit-shr (list-at bs i) 4) & tz-hex-digit (bit-and (list-at bs i) 15) & tz-hex bs (i + 1)

  tz-2038 : Integer = 2145916800
  tz-2100 : Integer = 4102444800

  future-text : List TzTrans -> Text
  future-text (ts) = text-concat-list (for t in ts -> (if t.at >= tz-2038 & t.at < tz-2100 then "T " & show (t.at) & " " & show (t.kind.utoff) & " " & t.kind.abbr & "\n" else ""))

  future-count : List TzTrans, Integer, Integer -> Integer
  future-count (ts) (i) (n) = if i >= list-length ts then n else future-count ts (i + 1) (if (list-at ts i).at >= tz-2038 & (list-at ts i).at < tz-2100 then n + 1 else n)

  zone-line : TzDb, TzZone -> Text
  zone-line (db) (zz) =
    let z0 = zone-of-compiled (zz.name) (tz-compile db zz)
    in when tz-zone-of-bytes (tz-zone-to-bytes z0)
      is None -> zz.name & " BYTES BAD"
      is Just (z) ->
        let ext = zone-cover z (tz-2100 - 1)
        in zz.name & " " & show (future-count (ext.trans) 0 0) & " " & tz-hex (hash-words-to-bytes (sha256 (text-to-unicode-bytes (future-text (ext.trans))))) 0

  print-zones : TzDb, Integer -> [Console] Nothing
  print-zones (db) (i) =
    if i >= list-length (db.zones) then print-line-uni "end"
    else let m = __heap-save
    in act
      print-line-uni (zone-line db (list-at (db.zones) i))
      print-next db i m
    end

  print-next : TzDb, Integer, Integer -> [Console] Nothing
  print-next (db) (i) (m) = let r = __heap-restore m in print-zones db (i + 1)

  opening : [Console] Nothing =
    let db = tz-parse tz-sources
    in print-zones db 0
