Chapter: ScreenSaverIdleTest
  cites Dev chapter ScreenSaver

Section: Entry
  opening : [Console] Nothing = act
    st <- screen-saver-new
    print-line-uni ("clamps " & show (ss-set-delay st 5).ss-delay-seconds & " " & show (ss-set-delay st 99999).ss-delay-seconds & " display-off " & show (ss-set-display-off st 10).ss-display-off-seconds & " " & show (ss-set-display-off st 99999).ss-display-off-seconds)
    a <- ss-tick (ss-set-delay screen-saver-new 300) 299
    a1 <- a.ss-active
    b <- ss-tick a 1
    b1 <- b.ss-active
    c <- ss-tick b 500
    print-line-uni ("idle 299 active " & show a1 & " 300 " & show b1 & " ticking while active idle " & show c.ss-idle-seconds)
    d <- ss-on-input c 77
    print-line-uni ("input active " & show d.ss-active & " idle " & show d.ss-idle-seconds & " last " & show d.ss-last-input-tick)
    off <- ss-tick (ss-toggle-enabled screen-saver-new) 1000
    print-line-uni ("disabled active " & show off.ss-active & " idle " & show off.ss-idle-seconds)
    e <- ss-tick screen-saver-new 600
    print-line-uni ("idle 600 active " & show e.ss-active & " display-off " & show (ss-should-display-off e) & " at 599 " & show (ss-should-display-off (ss-tick (ss-on-input e 1) 599)))
    print-line-uni ("selected " & (ss-selected-program (ss-set-selected screen-saver-new "matrix")).sp-id & " unknown " & (ss-selected-program (ss-set-selected screen-saver-new "nope")).sp-id)
    print-line-uni ("labels " & ss-delay-label 45 & ", " & ss-delay-label 301 & ", " & ss-delay-label 3600 & ", " & ss-delay-label 7200 & ", " & ss-delay-label 14400)
    nv <- ss-tick (ss-set-delay screen-saver-new ss-delay-never) 100000
    print-line-uni ("never delay " & show nv.ss-delay-seconds & " active " & show nv.ss-active & " idle " & show nv.ss-idle-seconds & " label " & ss-delay-label nv.ss-delay-seconds)
  end
