Chapter: MicWindowBytes
  cites Kernel chapter MicInput
  cites Kernel chapter HdaAudio
  cites Foreword chapter Console

Section: Checks
  row : Integer -> Text
  row (ms) = show ms & " ms -> " & show (mic-ms-bytes ms) & " bytes"

  opening : [Console] Nothing = act
    print-line-uni ("rate " & show hda-sample-rate & ", ring " & show mic-ring-bytes & ", window " & show mic-window-bytes & ", quiet below " & show mic-quiet-threshold)
    print-line-uni (row (0 - 5))
    print-line-uni (row 0)
    print-line-uni (row 21)
    print-line-uni (row 22)
    print-line-uni (row 100)
    print-line-uni (row 1365)
    print-line-uni (row 1366)
    print-line-uni (row 5000)
  end
