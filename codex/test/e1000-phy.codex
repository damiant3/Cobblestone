Chapter: E1000Phy
  cites Foreword chapter Maybe
  cites Kernel chapter E1000e
  cites Kernel chapter Pci

Section: Fixtures

  found-dev : PciScanResult -> Maybe PciDevice
  found-dev (scan) = e1000-find scan

Section: Judges

  yn : Boolean -> Text
  yn (b) = if b then "yes" else "no"

  bar-of : PciDevice -> Integer
  bar-of (dev) =
   let enabled = pci-enable-device dev
   in (pci-parse-bar (dev.pci-bus) (dev.pci-dev) (dev.pci-func) 0).bar-base

  phy-id-nonzero : PciDevice -> Boolean
  phy-id-nonzero (dev) = e1000-phy-read (bar-of dev) e1000-phy-id1 > 0

  bad-addr-is-error : PciDevice -> Boolean
  bad-addr-is-error (dev) = e1000-phy-read-at (bar-of dev) 2 e1000-phy-id1 < 0

  aneg-before : PciDevice -> Boolean
  aneg-before (dev) =
   bit-and (e1000-phy-read (bar-of dev) e1000-phy-bmsr) e1000-bmsr-aneg-done /= 0

  aneg-after : PciDevice -> Boolean
  aneg-after (dev) =
   let mmio = bar-of dev
   in let b = e1000-phy-bring-up mmio
   in bit-and (e1000-phy-read mmio e1000-phy-bmsr) e1000-bmsr-aneg-done /= 0

  link-after-init : PciDevice -> Boolean
  link-after-init (dev) = e1000-has-link (e1000-init dev)

Section: Entry

  opening : [Console] Nothing = act
    let scan = pci-scan-bus 0
    in act
      when found-dev scan
        is Just (dev) -> act
          print-line-uni ("phy id nonzero  : " & yn (phy-id-nonzero dev))
          print-line-uni ("bad addr errors : " & yn (bad-addr-is-error dev))
          print-line-uni ("aneg before     : " & yn (aneg-before dev))
          print-line-uni ("aneg after      : " & yn (aneg-after dev))
          print-line-uni ("link under gate : " & yn (link-after-init dev))
        end
        is None -> print-line-uni ("candidate found : no")
    end
  end

