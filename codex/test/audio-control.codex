Chapter: AudioControlTest
  cites Dev chapter AudioControl

Section: Entry
  opening : [Console] Nothing = act
    st <- audio-control-new
    up <- (ac-volume-up st 50).ac-master-volume
    down <- (ac-volume-down st 130).ac-master-volume
    print-line-uni ("volume " & show up & " " & show down)
    m <- ac-set-app-volume (ac-register-app audio-control-new "music" "Music") "music" 50
    set <- ac-effective-volume m "music"
    unknown <- ac-effective-volume m "game"
    muted <- ac-effective-volume (ac-toggle-app-mute m "music") "music"
    master <- ac-effective-volume (ac-toggle-mute (ac-toggle-app-mute m "music")) "music"
    print-line-uni ("effective set " & show set & " unknown " & show unknown & " app-muted " & show muted & " master-muted " & show master)
    p <- ac-set-mic-privacy audio-control-new True
    p1 <- ac-mic-active p
    q <- ac-set-mic-privacy p False
    q1 <- ac-mic-active q
    print-line-uni ("mic privacy " & show p1 & " off " & show q1 & " disabled " & show (ac-mic-active (ac-toggle-mic q)))
    d <- ac-add-device (ac-add-device (ac-add-device audio-control-new (audio-device-new "spk" "Speakers" AdkOutput)) (audio-device-new "hs" "Headset" AdkBoth)) (audio-device-new "mic2" "Desk Mic" AdkInput)
    print-line-uni ("defaults out " & d.ac-default-output & " in " & d.ac-default-input & " outputs " & show (list-length (ac-output-devices d)) & " inputs " & show (list-length (ac-input-devices d)))
    r <- ac-remove-device d "spk"
    print-line-uni ("removed spk devices " & show r.ac-device-count & " outputs " & show (list-length (ac-output-devices r)))
    print-line-uni ("removed spk defaults out " & r.ac-default-output & " in " & r.ac-default-input)
    r2 <- ac-remove-device r "hs"
    print-line-uni ("removed hs defaults out [" & r2.ac-default-output & "] in " & r2.ac-default-input)
    v <- ac-set-device-volume r2 "mic2" 150
    v1 <- (list-at v.ac-devices 0).ad-volume
    w <- ac-set-device-volume r2 "mic2" (0 - 5)
    w1 <- (list-at w.ac-devices 0).ad-volume
    print-line-uni ("device volume 150 -> " & show v1 & " -5 -> " & show w1)
  end
