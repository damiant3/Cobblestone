Chapter: ForkReclaim
  cites Foreword chapter Console

 Combined fork test. Tests: basic fork/await, lambda fork, closure
 capture with multiple tasks, and fork-in-loop reclaim.

Section: Helpers

  compute : Nothing -> Integer
  compute (x) = 7 * 6

  make-thunk : Integer, Nothing -> Integer
  make-thunk (n) (x) = n * 2

  fork-loop : Integer, Integer -> Integer
  fork-loop (i) (acc) =
    if i <= 0 then acc
    else let t = fork (\x -> i * 10)
    in let v = await t
    in fork-loop (i - 1) (acc + v)

Section: Body

  opening : [Console] Nothing = act
    let t1 = fork compute
    in let r1 = await t1
    in print-line-uni ("basic: " & show r1)
    let t2 = fork (\x -> 6 * 7)
    in let r2 = await t2
    in print-line-uni ("lambda: " & show r2)
    let t3 = fork (make-thunk 10)
    in let t4 = fork (make-thunk 11)
    in let a = await t3
    in let b = await t4
    in print-line-uni ("capture: " & show (a + b))
    print-line-uni ("reclaim: " & show (fork-loop 100 0))
  end

