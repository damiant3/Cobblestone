Chapter: EightQueens

 Prints the first 8-queens solution as an ASCII board.

Section: Board

  n : Integer
  n = 8

  int-abs : Integer -> Integer
  int-abs (k) = if k < 0 then 0 - k else k

  copy-push : List Integer, Integer -> List Integer
  copy-push (xs) (v) = copy-push-loop xs v 0 (list-length xs) []

  copy-push-loop : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  copy-push-loop (xs) (v) (i) (len) (acc) =
   if i >= len then list-push acc v
   else copy-push-loop xs v (i + 1) len (list-push acc (list-at xs i))

Section: Search

  Answer =
   | Found (List Integer)
   | Miss

  safe : List Integer, Integer -> Boolean
  safe (qs) (col) = safe-loop qs col (list-length qs) 0

  safe-loop : List Integer, Integer, Integer, Integer -> Boolean
  safe-loop (qs) (col) (row) (i) =
   if i >= row then True
   else
    let c = list-at qs i
    in if c == col then False
    else if int-abs (c - col) == (row - i) then False
    else safe-loop qs col row (i + 1)

  place : List Integer -> Answer
  place (qs) =
   if list-length qs == n then Found qs
   else try-col qs 0

  try-col : List Integer, Integer -> Answer
  try-col (qs) (col) =
   if col >= n then Miss
   else if safe qs col == False then try-col qs (col + 1)
   else
    let ans = place (copy-push qs col)
    in when ans
     is Found (sol) -> Found sol
     is Miss -> try-col qs (col + 1)

Section: Print

  cell : List Integer, Integer, Integer -> Text
  cell (qs) (row) (col) =
   if list-at qs row == col then "Q" else "."

  row-line : List Integer, Integer, Integer -> Text
  row-line (qs) (row) (col) =
   if col >= n then ""
   else if col == 0 then cell qs row col & row-line qs row (col + 1)
   else " " & cell qs row col & row-line qs row (col + 1)

  board-text : List Integer, Integer -> Text
  board-text (qs) (row) =
   if row >= n then ""
   else if row == (n - 1) then row-line qs row 0
   else row-line qs row 0 & "\n" & board-text qs (row + 1)

  render : Answer -> Text
  render (ans) =
   when ans
    is Found (qs) -> board-text qs 0
    is Miss -> "no solution"

  opening : [Console] Nothing
  opening = act
   print-line-uni (render (place []))
  end
