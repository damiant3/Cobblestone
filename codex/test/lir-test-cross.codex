Chapter: LirTestCross
  cites Foreword chapter MathLib

 The fusion carries two guards and both are pinned here by shapes that must NOT
 fuse:

  - `lt-mod3` divides by three, which is not a power of two
  - `lt-modone` compares against one rather than zero

Section: Shapes

  lt-even : Integer -> Integer
  lt-even (n) = if math-mod n 2 == 0 then 1 else 0

  lt-odd : Integer -> Integer
  lt-odd (n) = if math-mod n 2 /= 0 then 1 else 0

  lt-mod4 : Integer -> Integer
  lt-mod4 (n) = if math-mod n 4 == 0 then 1 else 0

  lt-mod8 : Integer -> Integer
  lt-mod8 (n) = if math-mod n 8 == 0 then 100 else 200

  lt-mod3 : Integer -> Integer
  lt-mod3 (n) = if math-mod n 3 == 0 then 1 else 0

  lt-modone : Integer -> Integer
  lt-modone (n) = if math-mod n 2 == 1 then 1 else 0

Section: Entry

  opening : [Console] Nothing = act
   print-line-uni (show (lt-even 4))
   print-line-uni (show (lt-even 7))
   print-line-uni (show (lt-odd 7))
   print-line-uni (show (lt-odd 4))
   print-line-uni (show (lt-mod4 8))
   print-line-uni (show (lt-mod4 6))
   print-line-uni (show (lt-mod8 16))
   print-line-uni (show (lt-mod8 12))
   print-line-uni (show (lt-mod3 6))
   print-line-uni (show (lt-mod3 7))
   print-line-uni (show (lt-modone 7))
   print-line-uni (show (lt-modone 4))
   print-line-uni (show (lt-even (-4)))
   print-line-uni (show (lt-even (-5)))
   print-line-uni (show (lt-odd (-5)))
  end
