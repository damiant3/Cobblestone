Chapter: GuardClause
  cites Foreword chapter Console

 Guard clause test. Tests: basic guard, guard with variable binding,
 guard that falls through, multiple guarded branches, constructor guard.

Section: Types

  Shape =
    | Circle (Integer)
    | Rect (Integer) (Integer)

Section: Functions

  classify : Integer -> Text
  classify (n) = when n
    is x when x > 100 -> "big"
    is x when x > 0 -> "small"
    is otherwise -> "non-positive"

  area-kind : Shape -> Text
  area-kind (s) = when s
    is Circle (r) when r > 10 -> "large-circle"
    is Circle (r) -> "small-circle"
    is Rect (w) (h) when w == h -> "square"
    is Rect (w) (h) -> "rectangle"

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (classify 200)
    print-line-uni (classify 50)
    print-line-uni (classify 0)
    print-line-uni (classify (-5))
    print-line-uni (area-kind (Circle 20))
    print-line-uni (area-kind (Circle 5))
    print-line-uni (area-kind (Rect 4 4))
    print-line-uni (area-kind (Rect 3 7))
  end

