Chapter: TypeclassMethodLocalTwoTypes
  cites Foreword chapter Console

class IndependentMethods where
  first-method : a, b -> b
  second-method : a, b -> b

instance IndependentMethods Integer where
  first-method (x) (y) = y
  second-method (x) (y) = y

Section: Body

  opening : [Console] Nothing = act
    let d = IndependentMethods-dict-Integer
    in act
      print-line-uni (show ((d.first-method-impl) 0 42))
      print-line-uni ((d.first-method-impl) 0 "text")
    end
  end
