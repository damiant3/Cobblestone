Chapter: LinearSmoke
  cites Foreword chapter Linear

Section: Definitions

  consume : linear Integer -> Integer
  consume (n) = n * 2

  use-once : Integer
  use-once = consume 21

  finalize : linear Integer -> Integer
  finalize (n) = freeze n

  shadow-test : linear Integer -> Integer
  shadow-test (n) = let base = n + 1
   in let n = 7
   in base + n + n

  opening : Text =
   show use-once & " " & show (finalize 21) & " " & show (shadow-test 41)

