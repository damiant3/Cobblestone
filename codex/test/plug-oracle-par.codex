Chapter: PlugOraclePar
  cites Foreword chapter Console

Section: Body

  square : Integer -> Integer
  square (x) = x * x

  scale : Integer, List Integer -> List Integer
  scale (k) (xs) = par (\x -> x * k) xs

  show-all : List Integer, Integer, Text -> Text
  show-all (xs) (i) (acc) =
    if i >= list-length xs then acc
    else show-all xs (i + 1) (if i == 0 then show (list-at xs i) else acc & " " & show (list-at xs i))

  opening : [Console] Nothing = act
    print-line-uni (show-all (par square [-3, -1, 0, 2, 5]) 0 "")
    print-line-uni (show-all (scale (0 - 7) [1, -2, 3]) 0 "")
    print-line-uni (show (list-length (par square [])))
  end

