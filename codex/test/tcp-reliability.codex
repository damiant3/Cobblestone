Chapter: TcpReliability
  cites Net chapter NetworkStack
  cites Net chapter Tcp
  cites Net chapter Ethernet
  cites Foreword chapter Console

 We say:

Section: Wire Fixtures
  srv-mac : List Integer = [82, 84, 0, 18, 52, 86]
  cli-mac : List Integer = [82, 85, 10, 0, 2, 2]
  srv-ip : List Integer = [10, 0, 2, 15]
  cli-ip : List Integer = [10, 0, 2, 100]
  gw-ip : List Integer = [10, 0, 2, 2]

  get-bytes : List Integer = [71, 69, 84, 32, 47, 32, 72, 84, 84, 80, 47, 49, 46, 49, 13, 10, 13, 10]
  resp-bytes : List Integer = [72, 73]

  psh : Integer = bit-or tcp-flag-psh tcp-flag-ack
  finack : Integer = bit-or tcp-flag-fin tcp-flag-ack

  mkc : Integer, Integer, Integer, List Integer -> List Integer
  mkc (seq) (ack) (flags) (payload) =
    let seg = tcp-with-checksum (tcp-build-segment 50000 80 seq ack flags 8192 payload) cli-ip srv-ip
    in let ip = ip-build-packet cli-ip srv-ip ip-proto-tcp seg
    in eth-build-frame srv-mac cli-mac eth-type-ipv4 ip

  c-syn : List Integer = mkc 1000 0 tcp-flag-syn []
  c-getack : List Integer = mkc 1001 5001 psh get-bytes

  tick-n : NetSession, Integer -> NetSession
  tick-n (s) (n) = if n <= 0 then s else tick-n ((net-tick s).session) (n - 1)

  fill-n : NetSession, Integer -> NetSession
  fill-n (s) (n) = if n <= 0 then s else fill-n ((net-send s resp-bytes).session) (n - 1)

 A retransmit must resend the OLDEST unacked segment, so the arm reads the
 sequence number back out of the frame that actually reached the outbox
 rather than trusting the queue's own bookkeeping. Ethernet 14 plus IPv4 20
 puts the TCP header at 34, and the sequence number is the second word of it.

  frame-seq : List Integer -> Integer
  frame-seq (f) = read-be32 f 38

Section: Server Session
  srv0 : NetSession = net-session-new srv-mac srv-ip gw-ip 80 0 cli-ip 5000
  listening : NetSession = (net-listen srv0).session
  established : NetSession =
    let s1 = (net-process-frame listening c-syn).session
    in (net-process-frame s1 c-getack).session

Section: Entry
  opening : [Console] Nothing = act
    let sa0 = set-outbox ((net-send established resp-bytes).session) []
    in let sa1 = (net-tick sa0).session
    in let sa3 = (net-tick (net-tick sa1).session).session
    in act
      print-line-uni ("rexmit1=" & show (list-length (sa1.outbox)))
      print-line-uni ("rexmit3=" & show (list-length (sa3.outbox)))
      let sb0 = set-outbox ((net-process-frame ((net-send established resp-bytes).session) (mkc 1019 5003 tcp-flag-ack [])).session) []
      in let sb3 = (net-tick (net-tick (net-tick sb0).session).session).session
      in print-line-uni ("acked3=" & show (list-length (sb3.outbox)))
      let dup = net-process-frame established (mkc 1001 5001 psh [88])
      in let bw = net-process-frame established (mkc 10019 5001 psh [88])
      in let ino = net-process-frame established (mkc 1019 5001 psh [89])
      in act
        print-line-uni ("dupdata=" & show (list-length (dup.data)))
        print-line-uni ("windata=" & show (list-length (bw.data)))
        print-line-uni ("indata=" & show (list-length (ino.data)))
      end
      let bo0 = set-outbox ((net-send established resp-bytes).session) []
      in let bo3 = set-outbox (tick-n bo0 3) []
      in let bo3b = tick-n bo3 3
      in let bo6 = tick-n bo3 6
      in act
        print-line-uni ("backoff3=" & show (list-length (bo3b.outbox)))
        print-line-uni ("backoff6=" & show (list-length (bo6.outbox)))
      end
      let g140 = tick-n bo0 140
      in let g141 = tick-n bo0 141
      in act
        print-line-uni ("giveup140=" & tcp-state-name ((g140.conn).state))
        print-line-uni ("giveup141=" & tcp-state-name ((g141.conn).state))
      end
      let cli0 = net-session-new cli-mac cli-ip gw-ip 50000 80 srv-ip 1000
      in let syn0 = set-outbox ((net-connect cli0).session) []
      in let fin0 = set-outbox ((net-close established).session) []
      in act
        print-line-uni ("synrexmit=" & show (list-length ((tick-n syn0 3).outbox)))
        print-line-uni ("finrexmit=" & show (list-length ((tick-n fin0 3).outbox)))
      end
      let two = set-outbox ((net-send ((net-send established resp-bytes).session) resp-bytes).session) []
      in let two-rx = (tick-n two 3)
      in let two-acked = (net-process-frame two (mkc 1019 5003 tcp-flag-ack [])).session
      in act
        print-line-uni ("qdepth2=" & show (list-length (two.rexmit-queue)))
        print-line-uni ("qacks=" & show ((list-at (two.rexmit-queue) 0).rx-ack) & " " & show ((list-at (two.rexmit-queue) 1).rx-ack))
        print-line-uni ("qrexmit=" & show (list-length (two-rx.outbox)))
        print-line-uni ("qoldest=" & show (frame-seq (list-at (two-rx.outbox) 0)))
        print-line-uni ("qpartial=" & show (list-length (two-acked.rexmit-queue)))
        print-line-uni ("qpartialrto=" & show (two-acked.rexmit-rto))
      end
      let full = fill-n established 9
      in act
        print-line-uni ("qcap=" & show (list-length (full.rexmit-queue)))
        print-line-uni ("qrefuse=" & (net-send full resp-bytes).output)
        print-line-uni ("qfinover=" & show (list-length (((net-close full).session).rexmit-queue)))
      end
      let r-sent = (net-send established resp-bytes).session
      in let r-waited = tick-n r-sent 2
      in let r-acked = (net-process-frame r-waited (mkc 1019 5003 tcp-flag-ack [])).session
      in let r-again = (net-send r-acked resp-bytes).session
      in act
        print-line-uni ("rtt-srtt=" & show (r-acked.srtt) & " rttvar=" & show (r-acked.rttvar))
        print-line-uni ("rtt-rto=" & show (r-again.rexmit-rto))
      end
      let k-sent = (net-send established resp-bytes).session
      in let k-lost = tick-n k-sent 4
      in let k-acked = (net-process-frame k-lost (mkc 1019 5003 tcp-flag-ack [])).session
      in let k-again = (net-send k-acked resp-bytes).session
      in act
        print-line-uni ("karn-resent=" & show ((list-at (k-lost.rexmit-queue) 0).rx-resent))
        print-line-uni ("karn-srtt=" & show (k-acked.srtt))
        print-line-uni ("karn-rto=" & show (k-again.rexmit-rto))
      end
      let stw = (net-process-frame ((net-close established).session) (mkc 1019 5002 finack [])).session
      in let tw-conn = stw.conn
      in let sd4 = (net-tick (net-tick (net-tick (net-tick stw).session).session).session).session
      in let done-conn = sd4.conn
      in act
        print-line-uni ("twstate=" & tcp-state-name (tw-conn.state))
        print-line-uni ("afterwait=" & tcp-state-name (done-conn.state))
      end
    end
  end
