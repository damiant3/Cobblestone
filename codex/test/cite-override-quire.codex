Chapter: CiteOverrideAlpha

Section: Alpha
  cite-shared : Integer -> Integer
  cite-shared (n) = n + 1

Chapter: CiteOverrideBeta

Section: Beta
  cite-shared : Integer -> Integer
  cite-shared (n) = n + 100

Chapter: CiteOverrideMain
  cites Codex chapter CiteOverrideAlpha (cite-shared)

Section: Entry
  opening : [Console] Nothing
  opening = act
   print-line-uni ("cite-shared 1 = " & show (cite-shared 1))
  end
