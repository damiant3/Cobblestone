Chapter: SynthTest
  cites Signal chapter Synth
  cites Signal chapter Envelope

Section: Body

  test-oscillators : Text =
    let s1 = osc-sine 0 1000
    in let s2 = osc-sine 1571 1000
    in let sq = osc-square 500 1000
    in let sq2 = osc-square (0 - 500) 1000
    in let sw = osc-saw 0 1000
    in let tr = osc-triangle 0 1000
    in "sine0=" & show s1 & " sine90=" & show s2 & " sq+=" & show sq & " sq-=" & show sq2 & " saw0=" & show sw & " tri0=" & show tr

  test-generate : Text =
    let samples = synth-generate WaveSine 440 1000 8000 16
    in let peak = synth-peak samples
    in "count=" & show (list-length samples) & " peak=" & show peak

  test-square-wave : Text =
    let samples = synth-generate WaveSquare 1000 500 8000 8
    in let zc = synth-zero-crossings samples
    in "sq-count=" & show (list-length samples) & " zc=" & show zc

  test-filter : Text =
    let raw = synth-generate WaveSquare 500 1000 4000 16
    in let filtered = lpf-apply 200 raw
    in let raw-peak = synth-peak raw
    in let filt-peak = synth-peak filtered
    in "raw=" & show raw-peak & " filt=" & show filt-peak & " smoother=" & show (filt-peak < raw-peak)

  test-mix : Text =
    let a = synth-generate WaveSine 440 1000 8000 8
    in let b = synth-generate WaveSine 880 500 8000 8
    in let mixed = mix-signals a b 700 300
    in "mixed=" & show (list-length mixed) & " peak=" & show (synth-peak mixed)

  test-envelope-apply : Text =
    let env = adsr-new 50 50 700 100
    in let raw = synth-generate WaveSine 440 1000 4000 32
    in let shaped = synth-apply-env raw env 4000 24
    in let raw-peak = synth-peak raw
    in let shaped-peak = synth-peak shaped
    in "raw=" & show raw-peak & " shaped=" & show shaped-peak & " quieter=" & show (shaped-peak <= raw-peak)

  test-note : Text =
    let env = adsr-new 10 20 800 50
    in let n = note-new 440 0 100 WaveSine
    in let rendered = synth-render-note n 1000 4000 env
    in "note-samples=" & show (list-length rendered) & " peak=" & show (synth-peak rendered)

  opening : [Console] Nothing = act
    print-line-uni test-oscillators
    print-line-uni test-generate
    print-line-uni test-square-wave
    print-line-uni test-filter
    print-line-uni test-mix
    print-line-uni test-envelope-apply
    print-line-uni test-note
  end

