Chapter: TryFallbackFails
  cites Foreword chapter Console

Section: Body

  step : [Console] Nothing
  step = act
    fail "inner"
    print-line-uni "continues-after-fail"
  end

  opening : [Console] Nothing = act
    trying 2 times
      step
      print-line-uni "never"
    falling back to
      print-line-uni "fallback"
      fail "fb"
    on failure
      print-line-uni "on-failure"
    end
    trying 1 times
      print-line-uni "ok-body"
    falling back to
      print-line-uni "unused-fallback"
    on failure
      print-line-uni "unused-failure"
    end
  end

