Chapter: HalGpioLinear
  cites Foreword chapter Board

Section: Body
  drive : Integer -> [Gpio, Device.Mmio] Integer
  drive (base) = act
    p0 <- gpio-open base 5 PinOutput
    p1 <- gpio-write p0 True
    p2 <- gpio-write p1 False
    gpio-close p2
  end

  opening : [Console, Gpio, Device.Mmio] Nothing = act
    r <- drive 1073876992
    print-line-uni ("gpio lifecycle ok: " & show r)
  end
