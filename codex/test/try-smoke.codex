Chapter: TrySmoke
  cites Foreword chapter Console

 Combined try/resilience tests: basic try, retry with counter,
 fallback, and all three sections (body/fallback/failure).

Section: Retry State
  counter-addr : Integer = 40000

Section: Body
  opening : [Console] Nothing = act
    trying 3 times
      print-line-uni "basic-ok"
    end
    trying 1 times
      print-line-uni "fb-body"
      fail "nope"
    falling back to
      print-line-uni "fb-fallback"
    end
    poke-byte counter-addr 0 0
    trying 3 times
      let n = peek-byte counter-addr 0
      in act
        poke-byte counter-addr 0 (n + 1)
        print-line-uni ("attempt " & show (n + 1))
        if n < 2 then fail "not yet"
        else print-line-uni "retry-success"
      end
    end
    trying 2 times
      print-line-uni "all-body"
      fail "oops"
    falling back to
      print-line-uni "all-fallback"
    on failure
      print-line-uni "all-failure"
    end
  end

