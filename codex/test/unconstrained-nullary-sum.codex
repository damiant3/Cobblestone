Chapter: UnconstrainedNullarySum
  cites Foreword chapter Console

Section: Body
  Foo (a) =
    | Bar (a)
    | Baz

  inspect-foo : Foo a -> Text
  inspect-foo (ignored) = "ok"

  payload-or : Foo a, a -> a
  payload-or (value) (fallback) = when value
    is Bar (item) -> item
    is Baz -> fallback

  opening : [Console] Nothing = act
    print-line-uni (inspect-foo Baz)
    print-line-uni (inspect-foo (Bar 1))
    print-line-uni (show (payload-or Baz 42))
    print-line-uni (payload-or Baz "text")
    print-line-uni (show (payload-or (Bar 7) 0))
    print-line-uni (payload-or (Bar "kept") "fallback")
  end
