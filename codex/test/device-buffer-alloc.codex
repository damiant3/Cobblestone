Chapter: DeviceBufferAllocTest
  cites Gpu chapter DeviceBuffer
  cites Foreword chapter Console

Section: Body

  host-words : List Integer = [11, 22, 33, 44]

  opening : [Gpu.Memory, Console] Nothing = act
    buf <- device-buffer-from-host host-words
    print-line-uni ("size: " & show (buf.db-size))
    got <- device-buffer-to-host buf
    print-line-uni ("w0: " & show (list-at got 0))
    print-line-uni ("w3: " & show (list-at got 3))
    freed <- device-buffer-free buf
    print-line-uni ("freed: " & show freed)
    b2 <- device-buffer-alloc 16
    print-line-uni ("reuse: " & show (b2.db-id == buf.db-id))
  end
