Chapter: NvGspWprRefuse
  cites Kernel chapter NvGspWpr

Section: Main

  inputs : Integer, Integer -> GspWprInputs
  inputs (vr) (rs) = GspWprInputs { vram-size = vr, boot-size = #28E00, radix3-size = rs, boot-addr = 0, radix3-addr = 0, signature-addr = 0, code-offset = 0, data-offset = 0, manifest-offset = 0 }

  opening : [Console] Nothing = act
   print-line-uni ("ok " & show (list-length (nv-gsp-wpr-meta (inputs #400000000 #2B3C123))))
   print-line-uni ("vram-too-small " & show (list-length (nv-gsp-wpr-meta (inputs #9000000 #2B3C123))))
   print-line-uni ("image-too-large " & show (list-length (nv-gsp-wpr-meta (inputs #400000000 #400000000))))
   print-line-uni ("radix3-negative " & show (list-length (nv-gsp-wpr-meta (inputs #400000000 -1))))
  end
