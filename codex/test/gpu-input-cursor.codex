Chapter: GpuInputCursor
  cites Foreword chapter Console
  cites UI chapter Theme
  cites UI chapter Widget
  cites UI chapter Layout
  cites UI chapter BoxModel
  cites UI chapter GpuRender

Section: Body

  fb-base : Integer = #BF000000
  fb-w : Integer = 640
  fb-h : Integer = 480

  scan-row-band : Integer, Integer, Integer, Integer, Integer -> Integer
  scan-row-band (y) (x) (xend) (target) (acc) =
    if x >= xend then acc
    else scan-row-band y (x + 1) xend target (acc + (if peek-32 fb-base ((y * fb-w + x) * 4) == target then 1 else 0))

  scan-band : Integer, Integer, Integer, Integer, Integer -> Integer
  scan-band (y) (x0) (x1) (target) (acc) =
    if y >= fb-h then acc
    else scan-band (y + 1) x0 x1 target (acc + scan-row-band y x0 x1 target 0)

  probe-tree : WidgetNode
  probe-tree =
    widget-panel "root" DirRow 0 [
      widget-set-flex (widget-set-min (widget-input "far" "" 60) 200 40) 0,
      widget-set-flex (widget-label "pad" "") 1
    ]

  opening : [Gpu, Console] Nothing =
    act
      let th = theme-terminal
      in let pal = th.th-palette
      in let laid = widget-layout probe-tree th (layout-rect 0 0 fb-w fb-h)
      in let inp = list-at (laid.wn-children) 0
      in let b = inp.wn-bounds
      in let bright = b.lr-x + b.lr-w
      in act
        c1 <- gr-clear (pal.pal-bg)
        c2 <- gr-clear-depth
        n <- gr-flush ((gr-render-tree (gf-new 4096) laid th gr-depth-scene).gf-idx)
        print-line-uni ("box: " & show (if scan-band 0 (b.lr-x) bright (pal.pal-muted) 0 > 0 then 1 else 0))
        print-line-uni ("inside: " & show (if scan-band 0 (b.lr-x) bright (pal.pal-fg) 0 > 0 then 1 else 0))
        print-line-uni ("outside: " & show (if scan-band 0 (bright + 4) (fb-w - 8) (pal.pal-fg) 0 > 0 then 1 else 0))
      end
    end
