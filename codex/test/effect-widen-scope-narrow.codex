Chapter: EffectWidenScopeNarrow
  cites Foreword chapter Fat16

Section: Body

  deep-read : Text -> [FileSystem.Read "/config/app/", Device.Block] Boolean
  deep-read (p) = file-exists "/config/app/settings.txt"

  apply-cfg : (Text -> [FileSystem.Read "/config/", Device.Block] Boolean), Text -> [FileSystem.Read "/config/", Device.Block] Boolean
  apply-cfg (f) (p) = f p

  opening : [Console, FileSystem.Read "/config/", Device.Block] Nothing = act
    print-line-uni (if apply-cfg deep-read "/config/app/settings.txt" then "found" else "narrowed")
  end
