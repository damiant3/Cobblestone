selected: none=[] index2=[charlie] beyond=[] negative=[]
cap: options=11 max-visible=8 visible=8
visible: alpha,bravo,charlie,delta,echo,foxtrot,golf,hotel
filtered o: bravo,echo,foxtrot,golf,hotel,kilo
nav: down x3=3 down x20=7 of visible 8 up-from-zero=0
confirm: unfiltered down x3=[delta]
confirm filtered: highlight=1 chosen=[echo] index=4
confirm beyond cap: highlight=10 visible=8 kept=[kilo]
key open: enter-on-closed=yes space-on-closed=yes letter-on-closed=no
key nav: down=1 then up=0
key escape: open-after=no
key confirm: chosen=[bravo] open=no
closed: none=<-- select -- v> index2=<charlie v>
open: kids=2 filter=input() items=8 first=<alpha>
format: [dd sel=2 open=false] [dd sel=-1 open=true]
