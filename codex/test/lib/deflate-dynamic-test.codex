Chapter: DeflateDynamicTest
  cites Compress chapter Deflate

 Dynamic Huffman (BTYPE=02): compress, decompress, verify byte identity, and
 verify the output is SMALLER than both the input and the fixed-Huffman block on
 skewed data -- the whole point of shipping a data-derived code table.

 A round-trip through our own decoder cannot catch a canonical-code or bit-order
 bug the encoder and decoder share. During development the emitted streams were
 fed to .NET's DeflateStream -- an independent RFC 1951 decoder -- and decoded
 correctly for both a skewed-literal input and a periodic input that becomes
 length/distance matches, so the codes are genuine RFC 1951, not merely
 self-consistent. That check is a manual step (codex-vm has no zlib); the durable
 assertions here are the round-trips and the size comparisons.

Section: Helpers

  list-equal : List Integer, List Integer, Integer, Integer -> Boolean
  list-equal (a) (b) (i) (len) =
    if i >= len then True
    else if list-at a i == list-at b i then list-equal a b (i + 1) len
    else False

  check-roundtrip : List Integer, Text -> Text
  check-roundtrip (input) (label) =
    let c = deflate-compress-dynamic input
    in let d = deflate-decompress c
    in let ok = if list-length d == list-length input then list-equal input d 0 (list-length input) else False
    in label & "=" & if ok then "pass" else "fail"

  skew-byte : Integer -> Integer
  skew-byte (i) =
    let m = (i * 13 + 7) - ((i * 13 + 7) / 100) * 100
    in if m < 70 then 0 else if m < 85 then 1 else if m < 95 then 2 else 3

  gen-skew : Integer, Integer, List Integer -> List Integer
  gen-skew (n) (i) (acc) =
    if i >= n then acc
    else gen-skew n (i + 1) (list-push acc (skew-byte i))

  gen-cyc : Integer, Integer, Integer, List Integer -> List Integer
  gen-cyc (p) (n) (i) (acc) =
    if i >= n then acc
    else gen-cyc p n (i + 1) (list-push acc (i - (i / p) * p))

  lcg-next : Integer -> Integer
  lcg-next (s) =
    let t = s * 1103515245 + 12345
    in t - (t / 2147483648) * 2147483648

  lcg-sym : Integer -> Integer
  lcg-sym (s) =
    let r = (s / 65536) - ((s / 65536) / 256) * 256
    in if r < 200 then 200 else if r < 235 then 201 else if r < 250 then 202 else 203

  gen-lcg : Integer, Integer, Integer, List Integer -> List Integer
  gen-lcg (n) (i) (s) (acc) =
    if i >= n then acc
    else let s2 = lcg-next s
    in gen-lcg n (i + 1) s2 (list-push acc (lcg-sym s2))

Section: Body

  test-empty : List Integer = []
  test-small : List Integer = [72, 101, 108, 108, 111]
  test-skew : List Integer = gen-lcg 1000 0 12345 []
  test-cyc : List Integer = gen-cyc 5 400 0 []
  test-lit : List Integer = gen-skew 40 0 []
  test-rep : List Integer = gen-cyc 5 40 0 []

  opening : [Console] Nothing = act
    print-line-uni (check-roundtrip test-empty "dyn-empty")
    print-line-uni (check-roundtrip test-small "dyn-small")
    print-line-uni (check-roundtrip test-skew "dyn-skew")
    print-line-uni (check-roundtrip test-cyc "dyn-cyc")
    print-line-uni (check-roundtrip test-lit "dyn-lit")
    print-line-uni (check-roundtrip test-rep "dyn-rep")
    print-line-uni ("dyn-vs-fixed=" & if list-length (deflate-compress-dynamic test-skew) < list-length (deflate-compress test-skew) then "pass" else "fail")
    print-line-uni ("dyn-vs-input=" & if list-length (deflate-compress-dynamic test-skew) < list-length test-skew then "pass" else "fail")
  end
