Chapter: DeviceMathAccuracy
  cites Foreword chapter Console
  cites Gpu chapter DeviceMath

Section: Judging

 t-abs and t-max duplicate real-abs and real-max on purpose. The judge
 must not be built out of the chapter it judges: while near called
 DeviceMath's own, collapsing real-abs or real-max to a projection left
 all forty cells reading ok. Do not simplify these away.

  t-abs : Real -> Real
  t-abs (x) = if x < 0.0 then 0.0 - x else x

  t-max : Real, Real -> Real
  t-max (a) (b) = if a > b then a else b

  near : Real, Real, Real -> Text
  near (got) (want) (tol) =
    if t-abs (got - want) <= tol * t-max 1.0 (t-abs want) then "ok"
    else "BAD got " & show got & " want " & show want

  exact : Real, Real -> Text
  exact (got) (want) =
    if got ~0 want then "ok"
    else "BAD got " & show got & " want " & show want

  sq-tol : Real
  sq-tol = 0.000000001

  tr-tol : Real
  tr-tol = 0.0000001

  pythagoras : Real -> Text
  pythagoras (x) =
    let s = real-sin x
    in let c = real-cos x
    in near (s * s + c * c) 1.0 tr-tol

Section: Entry

  opening : [Console] Nothing =
    act
      print-line-uni ("sqrt 0.0      " & near (real-sqrt 0.0) 0.0 sq-tol)
      print-line-uni ("sqrt 0.25     " & near (real-sqrt 0.25) 0.5 sq-tol)
      print-line-uni ("sqrt 1.0      " & near (real-sqrt 1.0) 1.0 sq-tol)
      print-line-uni ("sqrt 2.0      " & near (real-sqrt 2.0) 1.414213562373095 sq-tol)
      print-line-uni ("sqrt 4.0      " & near (real-sqrt 4.0) 2.0 sq-tol)
      print-line-uni ("sqrt 16.0     " & near (real-sqrt 16.0) 4.0 sq-tol)
      print-line-uni ("sqrt 100.0    " & near (real-sqrt 100.0) 10.0 sq-tol)
      print-line-uni ("sqrt 1000.0   " & near (real-sqrt 1000.0) 31.62277660168379 sq-tol)
      print-line-uni ("sqrt 10000.0  " & near (real-sqrt 10000.0) 100.0 sq-tol)
      print-line-uni ("sqrt 1000000. " & near (real-sqrt 1000000.0) 1000.0 sq-tol)
      print-line-uni ("sqrt 1e-6     " & near (real-sqrt 0.000001) 0.001 sq-tol)
      print-line-uni ("sqrt 1e12     " & near (real-sqrt 1000000000000.0) 1000000.0 sq-tol)
      print-line-uni ("sqrt neg      " & near (real-sqrt (0.0 - 4.0)) 0.0 sq-tol)
      print-line-uni ("sin 0.0       " & near (real-sin 0.0) 0.0 tr-tol)
      print-line-uni ("sin 0.5       " & near (real-sin 0.5) 0.479425538604203 tr-tol)
      print-line-uni ("sin halfpi    " & near (real-sin 1.570796326794897) 1.0 tr-tol)
      print-line-uni ("sin 2.0       " & near (real-sin 2.0) 0.909297426825682 tr-tol)
      print-line-uni ("sin 3.0       " & near (real-sin 3.0) 0.141120008059867 tr-tol)
      print-line-uni ("sin pi        " & near (real-sin 3.141592653589793) 0.0 tr-tol)
      print-line-uni ("sin 4.0       " & near (real-sin 4.0) (0.0 - 0.756802495307928) tr-tol)
      print-line-uni ("sin threehalf " & near (real-sin 4.712388980384690) (0.0 - 1.0) tr-tol)
      print-line-uni ("sin 6.0       " & near (real-sin 6.0) (0.0 - 0.279415498198926) tr-tol)
      print-line-uni ("sin -1.0      " & near (real-sin (0.0 - 1.0)) (0.0 - 0.841470984807897) tr-tol)
      print-line-uni ("sin -3.0      " & near (real-sin (0.0 - 3.0)) (0.0 - 0.141120008059867) tr-tol)
      print-line-uni ("sin 100.0     " & near (real-sin 100.0) (0.0 - 0.506365641109759) tr-tol)
      print-line-uni ("cos 0.0       " & near (real-cos 0.0) 1.0 tr-tol)
      print-line-uni ("cos 1.0       " & near (real-cos 1.0) 0.540302305868140 tr-tol)
      print-line-uni ("cos 2.0       " & near (real-cos 2.0) (0.0 - 0.416146836547142) tr-tol)
      print-line-uni ("cos pi        " & near (real-cos 3.141592653589793) (0.0 - 1.0) tr-tol)
      print-line-uni ("cos 4.0       " & near (real-cos 4.0) (0.0 - 0.653643620863612) tr-tol)
      print-line-uni ("cos -2.0      " & near (real-cos (0.0 - 2.0)) (0.0 - 0.416146836547142) tr-tol)
      print-line-uni ("cos 100.0     " & near (real-cos 100.0) 0.862318872287684 tr-tol)
      print-line-uni ("pyth 0.3      " & pythagoras 0.3)
      print-line-uni ("pyth 1.7      " & pythagoras 1.7)
      print-line-uni ("pyth 3.0      " & pythagoras 3.0)
      print-line-uni ("pyth -2.4     " & pythagoras (0.0 - 2.4))
      print-line-uni ("abs -3.5      " & near (real-abs (0.0 - 3.5)) 3.5 sq-tol)
      print-line-uni ("abs 3.5       " & near (real-abs 3.5) 3.5 sq-tol)
      print-line-uni ("min 2.0 3.0   " & near (real-min 2.0 3.0) 2.0 sq-tol)
      print-line-uni ("max 2.0 3.0   " & near (real-max 2.0 3.0) 3.0 sq-tol)
      print-line-uni ("abs 0.0       " & exact (real-abs 0.0) 0.0)
      print-line-uni ("abs -0.5      " & exact (real-abs (0.0 - 0.5)) 0.5)
      print-line-uni ("min 3.0 2.0   " & exact (real-min 3.0 2.0) 2.0)
      print-line-uni ("min 2.0 2.0   " & exact (real-min 2.0 2.0) 2.0)
      print-line-uni ("min -3.0 2.0  " & exact (real-min (0.0 - 3.0) 2.0) (0.0 - 3.0))
      print-line-uni ("min 2.0 -3.0  " & exact (real-min 2.0 (0.0 - 3.0)) (0.0 - 3.0))
      print-line-uni ("max 3.0 2.0   " & exact (real-max 3.0 2.0) 3.0)
      print-line-uni ("max 2.0 2.0   " & exact (real-max 2.0 2.0) 2.0)
      print-line-uni ("max -3.0 2.0  " & exact (real-max (0.0 - 3.0) 2.0) 2.0)
      print-line-uni ("max 2.0 -3.0  " & exact (real-max 2.0 (0.0 - 3.0)) 2.0)
    end
