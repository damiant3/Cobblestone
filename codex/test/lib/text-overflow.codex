Chapter: TextOverflowTest
  cites Foreword chapter Console
  cites UI chapter TextOverflow

 The advance figures are the ones the three renderers actually use: 6 for
 the GPU 5x7 bitmap walk, 9 for the GopBuf clip walk, 10 for the SystemFont
 walk.

Section: Body

  plan : TextOverflow, Integer, Integer, Integer, Integer -> Text
  plan (m) (len) (avail) (adv) (gw) =
    "  " & text-overflow-name m & " len=" & show len & " avail=" & show avail
      & " adv=" & show adv & " gw=" & show gw
      & " -> start=" & show (text-overflow-start m len avail adv gw)
      & " count=" & show (text-overflow-count m len avail adv gw)
      & " dots=" & show (text-overflow-dots m len avail adv gw)

  all-modes : Integer, Integer, Integer, Integer -> Text
  all-modes (len) (avail) (adv) (gw) =
    plan OverflowClip len avail adv gw & "\n"
      & plan OverflowEllipsis len avail adv gw & "\n"
      & plan OverflowScroll len avail adv gw

  opening : [Console] Nothing = act
    print-line-uni "fits exactly, no overflow: every mode must agree"
    print-line-uni (all-modes 10 60 6 5)
    print-line-uni ""
    print-line-uni "shorter than the box: every mode must agree"
    print-line-uni (all-modes 4 60 6 5)
    print-line-uni ""
    print-line-uni "overflowing, adv=6 (GPU walk), 20 chars in 60px"
    print-line-uni (all-modes 20 60 6 5)
    print-line-uni ""
    print-line-uni "overflowing, adv=9 (GopBuf walk), 20 chars in 63px"
    print-line-uni (all-modes 20 63 9 8)
    print-line-uni ""
    print-line-uni "overflowing, adv=10 (SystemFont walk), 20 chars in 100px"
    print-line-uni (all-modes 20 100 10 8)
    print-line-uni ""
    print-line-uni "a box too narrow for an ellipsis falls back to clip"
    print-line-uni (all-modes 20 18 6 5)
    print-line-uni (all-modes 20 24 6 5)
    print-line-uni ""
    print-line-uni "degenerate boxes draw nothing"
    print-line-uni (all-modes 20 0 6 5)
    print-line-uni (all-modes 20 (0 - 40) 6 5)
    print-line-uni (all-modes 20 60 0 5)
    print-line-uni ""
    print-line-uni ("default mode: " & text-overflow-name text-overflow-default)
  end

