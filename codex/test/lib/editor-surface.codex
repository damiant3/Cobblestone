Chapter: EditorSurfaceTest
  cites UI chapter Editor
  cites UI chapter Widget
  cites Foreword chapter Console

 UI Editor's consumers (`apps/cvmm/Terminal`, `apps/mathbook/Notebook`,
 `apps/workflow/WorkflowHtml`) reach only `editor-with-text`, `editor-widget`
 and `ed-show-line-numbers`; this pins that surface.

  kid : WidgetNode, Integer -> WidgetNode
  kid (w) (i) = list-at (w.wn-children) i

  label-text : WidgetNode -> Text
  label-text (w) = when w.wn-kind
    is WkLabel (t) -> t
    is otherwise -> "?"

  numbered : Integer, Integer, Text -> Text
  numbered (n) (i) (acc) =
    if i >= n then acc
    else numbered n (i + 1) (if i == 0 then "l0" else acc & "\nl" & show i)

  opening : [Console] Nothing =
    let src = "alpha\nbeta\ngamma"
    in let ed = editor-with-text "e" src
    in let empty = editor-with-text "z" ""
    in let trail = editor-with-text "t" "a\n"
    in let w = editor-widget ed
    in let body = kid w 0
    in let gutter = kid body 0
    in let content = kid body 1
    in let bare = editor-widget (__record-set (editor-with-text "b" src) "ed-show-line-numbers" False)
    in let long = editor-widget (editor-with-text "n" (numbered 30 0 ""))
    in let long-gutter = kid (kid long 0) 0
    in let long-content = kid (kid long 0) 1
    in act
      print-line-uni ("format         : " & format-editor ed)
      print-line-uni ("value round    : " & show (editor-value ed == src))
      print-line-uni ("line 1         : " & ed-line-at ed 1)
      print-line-uni ("line 3 and -1  : [" & ed-line-at ed 3 & "][" & ed-line-at ed (0 - 1) & "]")
      print-line-uni ("empty          : " & format-editor empty & " value=[" & editor-value empty & "]")
      print-line-uni ("trailing nl    : " & format-editor trail & " round=" & show (editor-value trail == "a\n"))
      print-line-uni ("root           : " & w.wn-id & " kids=" & show (w.wn-child-count) & " body=" & body.wn-id & " kids=" & show (body.wn-child-count))
      print-line-uni ("gutter         : " & gutter.wn-id & " rows=" & show (gutter.wn-child-count) & " min-w=" & show (gutter.wn-min-w) & " labels=" & label-text (kid gutter 0) & "," & label-text (kid gutter 1) & "," & label-text (kid gutter 2))
      print-line-uni ("content        : " & content.wn-id & " rows=" & show (content.wn-child-count) & " flex=" & show (content.wn-flex) & " row0=" & label-text (kid content 0) & " flags=" & show ((kid content 0).wn-flags) & "," & show ((kid content 1).wn-flags))
      print-line-uni ("no numbers     : body kids=" & show ((kid bare 0).wn-child-count) & " first=" & (kid (kid bare 0) 0).wn-id)
      print-line-uni ("thirty lines   : gutter=" & show (long-gutter.wn-child-count) & " last=" & label-text (kid long-gutter 24) & " content=" & show (long-content.wn-child-count) & " row24=" & label-text (kid long-content 24))
      print-line-uni "done"
    end
