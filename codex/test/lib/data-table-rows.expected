compare (code point): a/b=-1 b/c=1 c/d=1 e/c=-1 t/a=-1
compare (prefix): ab/abc=-1 ab/b=-1 empty/a=-1 a/a=0
format: [tbl cols=3 rows=5 page=1/1]
pages: five-rows=1 empty=1 visible=5
shape: children=7 first=tbl-hdr last=tbl-footer
header: [Name] [Value] [Fixed]
cells row0: [c] [three] [-]
footer: [Page 1 of 1 | 5 rows]
footer-empty: [Page 1 of 1 | 0 rows]
sort: seeded=caebd
sort: asc=abcde toggled=edcba encoding-would-say=-1-1
sort-aliasing: input=caebd result=abcde
sort-indicator: [Name ^]
sort-fixed: order=caebd col=-1
sort-oob: below=caebd above=caebd
select 0: row0=pressed row1=hover row2=normal
select 1: row0=normal row1=pressed row2=normal
select 1 flag: selected=true index=1
key shape: rows=25 pages=2 start-row=-1
key nav: down=0 down-twice=1 up-at-top=0
key enter: after-down=true on-fresh=false
key page: pgdn=1 pgdn-then-pgup=0 pgup-at-first=0
key other: letter=-1 escape=-1
