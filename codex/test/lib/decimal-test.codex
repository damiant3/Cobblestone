Chapter: DecimalTest
  cites Foreword chapter Decimal

Section: Body

  opening : [Console] Nothing = act
    let a = dec-from-parts 12 50 2
    in let b = dec-from-parts 3 25 2
    in act
      print-line-uni ("a=" & dec-to-text a)
      print-line-uni ("b=" & dec-to-text b)
      print-line-uni ("a+b=" & dec-to-text (dec-add a b))
      print-line-uni ("a-b=" & dec-to-text (dec-sub a b))
      print-line-uni ("a*b=" & dec-to-text (dec-mul a b))
      print-line-uni ("a/b=" & dec-to-text (dec-div a b))
      print-line-uni ("neg=" & dec-to-text (dec-negate a))
      print-line-uni ("round=" & dec-to-text (dec-round (dec-from-parts 3 456 3) 1))
      print-line-uni ("floor=" & dec-to-text (dec-floor (dec-from-parts 7 99 2)))
      print-line-uni ("cmp=" & show (dec-compare a b))
      print-line-uni ("eq=" & if dec-eq a a then "true" else "false")
      print-line-uni ("lt=" & if dec-lt b a then "true" else "false")
      print-line-uni ("zero=" & if dec-is-zero dec-zero then "true" else "false")
      let parsed = dec-from-text "42.75" 2
      in print-line-uni ("parsed=" & dec-to-text parsed)
    end
  end

Page 1
