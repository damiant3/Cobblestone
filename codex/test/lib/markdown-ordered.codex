Chapter: MarkdownOrdered
  cites Foreword chapter Console
  cites Foreword chapter StringUtils
  cites UI chapter Markdown
  cites UI chapter RichText

Section: Body

  show-block : UiMdBlock -> Text
  show-block (b) = when b
    is UiMdParagraph (rt) -> "para[" & rich-text-plain-text rt & "]"
    is UiMdHeading (level) (rt) -> "head" & show level & "[" & rich-text-plain-text rt & "]"
    is UiMdCodeBlock (lang) (content) -> "code[" & content & "]"
    is UiMdBlockquote (rt) -> "quote[" & rich-text-plain-text rt & "]"
    is UiMdListItem (rt) -> "bullet[" & rich-text-plain-text rt & "]"
    is UiMdOrderedItem (num) (rt) -> "ord num=" & show num & " [" & rich-text-plain-text rt & "]"
    is UiMdHRule -> "hrule"
    is UiMdBlank -> "blank"

  dump-blocks : List UiMdBlock, Integer, Integer -> [Console] Integer
  dump-blocks (bs) (i) (n) =
    if i >= n then 0
    else act
      print-line-uni (show i & ": " & show-block (list-at bs i))
      dump-blocks bs (i + 1) n
    end

  doc-source : Text
  doc-source = "1. alpha\n2. beta\n17. seventeen\n- bullet item\nplain line"

  opening : [Console] Nothing =
    act
      print-line-uni ("digit0=" & show (char-code-at "0" 0) & " digit9=" & show (char-code-at "9" 0) & " dot=" & show (char-code-at "." 0) & " space=" & show (char-code-at " " 0))
      let doc = ui-md-parse doc-source
      in act
        print-line-uni ("blocks=" & show (doc.md-block-count))
        d <- dump-blocks (doc.md-blocks) 0 (doc.md-block-count)
        print-line-uni "--"
      end
    end
