Chapter: TextTrimTest
  cites Works chapter CodeBrowser

Section: Body

  opening : [Console] Nothing = act
    print-line ("empty=" & text-trim "")
    print-line ("spaces='" & text-trim "   " & "'")
    print-line ("leading='" & text-trim "  hello" & "'")
    print-line ("trailing='" & text-trim "hello  " & "'")
    print-line ("both='" & text-trim "  hello  " & "'")
    print-line ("none='" & text-trim "hello" & "'")
    print-line ("single-space='" & text-trim " " & "'")
    print-line ("single-char='" & text-trim "x" & "'")
  end

