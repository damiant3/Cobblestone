Chapter: TextTrimTest
  cites Works chapter CodeBrowser

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("empty=" & text-trim "")
    print-line-uni ("spaces='" & text-trim "   " & "'")
    print-line-uni ("leading='" & text-trim "  hello" & "'")
    print-line-uni ("trailing='" & text-trim "hello  " & "'")
    print-line-uni ("both='" & text-trim "  hello  " & "'")
    print-line-uni ("none='" & text-trim "hello" & "'")
    print-line-uni ("single-space='" & text-trim " " & "'")
    print-line-uni ("single-char='" & text-trim "x" & "'")
  end

