format         : e lines=3 cursor=0:0
value round    : True
line 1         : beta
line 3 and -1  : [][]
empty          : z lines=1 cursor=0:0 value=[]
trailing nl    : t lines=2 cursor=0:0 round=True
root           : e kids=1 body=e-body kids=2
gutter         : e-gutter rows=3 min-w=40 labels=1,2,3
content        : e-content rows=3 flex=1 row0=alpha flags=1,0
no numbers     : body kids=1 first=b-content
thirty lines   : gutter=25 last=25 content=25 row24=l24
done
