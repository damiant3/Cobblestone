Chapter: ProbabilityTest
  cites Foreword chapter Probability

Section: Body

  opening : [Console] Nothing = act
    let std = normal-standard
    in act
      print-line-uni ("normal-cdf-0=" & show (normal-cdf std 0))
      let cdf-pos = normal-cdf std 1000
      in print-line-uni ("normal-cdf-1=" & if cdf-pos > 700 then "above-700" else "low")
      let pdf-0 = normal-pdf std 0
      in print-line-uni ("normal-pdf-0=" & if pdf-0 > 300 then "above-300" else "low")
    let pois = poisson 3000
    in let pmf0 = poisson-pmf pois 0
    in print-line-uni ("poisson-pmf-0=" & if pmf0 > 0 then "positive" else "zero")
    let binom = binomial 10 500
    in let bm = binomial-mean binom
    in print-line-uni ("binom-mean=" & show bm)
    let bv = binomial-variance binom
    in print-line-uni ("binom-var=" & show bv)
    let expo = exponential 500
    in let em = exponential-mean expo
    in print-line-uni ("exp-mean=" & show em)
    print-line-uni ("bound=" & show (uniform-bound 10 20 37))
    print-line-uni ("choose-5-2=" & show (prob-choose 5 2))
    print-line-uni ("choose-0=" & show (prob-choose 5 0))
  end

