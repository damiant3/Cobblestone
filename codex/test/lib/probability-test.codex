Chapter: ProbabilityTest
  cites Foreword chapter Probability

 Helpers rebuild each distribution because an act block's let does
 not scope across statements.

Section: Definitions

  pb-cdf-0 : Text
  pb-cdf-0 = show (normal-cdf normal-standard 0)

  pb-cdf-1 : Text
  pb-cdf-1 = if normal-cdf normal-standard 1000 > 700 then "above-700" else "low"

  pb-pdf-0 : Text
  pb-pdf-0 = if normal-pdf normal-standard 0 > 300 then "above-300" else "low"

  pb-poisson : Text
  pb-poisson = if poisson-pmf (poisson 3000) 0 > 0 then "positive" else "zero"

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("normal-cdf-0=" & pb-cdf-0)
    print-line-uni ("normal-cdf-1=" & pb-cdf-1)
    print-line-uni ("normal-pdf-0=" & pb-pdf-0)
    print-line-uni ("poisson-pmf-0=" & pb-poisson)
    print-line-uni ("binom-mean=" & show (binomial-mean (binomial 10 500)))
    print-line-uni ("binom-var=" & show (binomial-variance (binomial 10 500)))
    print-line-uni ("exp-mean=" & show (exponential-mean (exponential 500)))
    print-line-uni ("bound=" & show (uniform-bound 10 20 37))
    print-line-uni ("choose-5-2=" & show (prob-choose 5 2))
    print-line-uni ("choose-0=" & show (prob-choose 5 0))
  end

