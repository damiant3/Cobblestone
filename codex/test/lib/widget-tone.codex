  cites Guios chapter GuiTimer

 A tone says what a widget MEANS and the theme owns which colour that is.
 The reason this is a render test and not an arithmetic one: a field that
 nothing reads looks exactly like a working one, so the assertion has to be
 that the pixels changed, not that the setter stored a number.

Section: Body
  buf-w : Integer = 240
  buf-h : Integer = 40

  count-color : GopBuf, Integer, Integer, Integer, Integer -> Integer
  count-color (gb) (y) (x) (target) (acc) =
    if y >= buf-h then acc
    else if x >= buf-w then count-color gb (y + 1) 0 target acc
    else count-color gb y (x + 1) target (acc + (if gop-buf-get gb x y == target then 1 else 0))

  painted : Integer -> Integer
  painted (tone) =
    let th = theme-terminal
    in let pal = th.th-palette
    in let tree = widget-set-tone (widget-label "l" "STATUS") tone
    in let laid = widget-layout tree th (layout-rect 0 0 buf-w buf-h)
    in let gb = gop-buf-new buf-w buf-h (pal.pal-bg)
    in let d = gop-render-label laid th "STATUS" gb mw-new
    in count-color gb 0 0 (theme-tone-fg th tone (pal.pal-fg)) 0

  row : Integer -> Text
  row (tone) =
    "  " & tone-name tone & " ink=" & show (painted tone)
      & " color=" & show (theme-tone-fg theme-terminal tone ((theme-terminal.th-palette).pal-fg))

  in-default-fg : Integer -> Integer
  in-default-fg (tone) =
    let th = theme-terminal
    in let pal = th.th-palette
    in let tree = widget-set-tone (widget-label "l" "STATUS") tone
    in let laid = widget-layout tree th (layout-rect 0 0 buf-w buf-h)
    in let gb = gop-buf-new buf-w buf-h (pal.pal-bg)
    in let d = gop-render-label laid th "STATUS" gb mw-new
    in count-color gb 0 0 (pal.pal-fg) 0

  opening : [Console] Nothing = act
    print-line-uni "the control: a toned label paints NOTHING in the untoned fg,"
    print-line-uni "so the ink below is the tone being obeyed and not a coincidence."
    print-line-uni ("  none  in default fg = " & show (in-default-fg tone-none))
    print-line-uni ("  error in default fg = " & show (in-default-fg tone-error))
    print-line-uni ""
    print-line-uni "a toned label paints in its tone's colour, not the style fg:"
    print-line-uni (row tone-none)
    print-line-uni (row tone-error)
    print-line-uni (row tone-success)
    print-line-uni (row tone-warning)
    print-line-uni ""
    print-line-uni "the tone survives the layout pass and the other decorators:"
    print-line-uni ("  set-tone then set-flex: " & show ((widget-set-flex (widget-set-tone (widget-label "a" "x") tone-error) 3).wn-tone))
    print-line-uni ("  set-flex then set-tone: " & show ((widget-set-tone (widget-set-flex (widget-label "b" "x") 3) tone-error).wn-tone))
    print-line-uni ("  default on a fresh node: " & show ((widget-label "c" "x").wn-tone))
  end

