Chapter: YamlTest
  cites Encode chapter Yaml
  cites Foreword chapter Maybe

Section: Body

  opening : [Console] Nothing = act
    let input = "name: Codex\nversion: 42\nenabled: true\n"
    in when yaml-parse input
      is Just (v) ->
        act
          print-line ("name=" & yaml-get-str v "name" "?")
          print-line ("version=" & show (yaml-get-int v "version" 0))
          let emitted = yaml-emit v
          in print-line ("emit-len=" & show (text-length emitted))
        end
      is None -> print-line "parse=fail"
    let list-input = "- alpha\n- beta\n- gamma\n"
    in when yaml-parse list-input
      is Just (v) -> when v
        is YamlList (items) -> print-line ("list-len=" & show (list-length items))
        is otherwise -> print-line "list=fail:type"
      is None -> print-line "list=fail"
    print-line ("null=" & when yaml-parse "x: null\n" is Just (v) -> yaml-get-str v "x" "null-ok" is None -> "fail")
  end

