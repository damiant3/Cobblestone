Chapter: MsgPackTest
  cites Encode chapter MessagePack
  cites Foreword chapter Maybe

Section: Helpers

  show-bool : Boolean -> Text
  show-bool (b) = if b then "true" else "false"

  mp-rt-int : Integer -> Text
  mp-rt-int (n) =
    let encoded = msgpack-encode (MpInt n)
    in when msgpack-decode encoded
      is Just (v) -> when v
        is MpInt (m) -> if m == n then "pass" else "fail:" & show m
        is otherwise -> "fail:type"
      is None -> "fail:decode"

  mp-rt-str : Text -> Text
  mp-rt-str (s) =
    let encoded = msgpack-encode (MpStr s)
    in when msgpack-decode encoded
      is Just (v) -> when v
        is MpStr (t) -> if t == s then "pass" else "fail"
        is otherwise -> "fail:type"
      is None -> "fail:decode"

  mp-rt-nil : Text
  mp-rt-nil =
    when msgpack-decode (msgpack-encode MpNil)
      is Just (v) -> when v
        is MpNil -> "pass"
        is otherwise -> "fail"
      is None -> "fail"

  mp-rt-true : Text
  mp-rt-true =
    when msgpack-decode (msgpack-encode (MpBool True))
      is Just (v) -> when v
        is MpBool (b) -> show-bool b
        is otherwise -> "fail"
      is None -> "fail"

  mp-rt-array : Text
  mp-rt-array =
    let arr = msgpack-encode (MpArray [MpInt 1, MpStr "two", MpBool False])
    in when msgpack-decode arr
      is Just (v) -> when v
        is MpArray (items) -> "array=" & show (list-length items)
        is otherwise -> "array=fail:type"
      is None -> "array=fail"

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("nil=" & mp-rt-nil)
    print-line-uni ("true=" & mp-rt-true)
    print-line-uni ("int-0=" & mp-rt-int 0)
    print-line-uni ("int-42=" & mp-rt-int 42)
    print-line-uni ("int-200=" & mp-rt-int 200)
    print-line-uni ("int-neg=" & mp-rt-int (0 - 5))
    print-line-uni ("str-hi=" & mp-rt-str "hi")
    print-line-uni ("str-empty=" & mp-rt-str "")
    print-line-uni mp-rt-array
  end

