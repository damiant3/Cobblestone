Chapter: CanvasViewport
  cites Foreword chapter Console
  cites UI chapter Canvas

Section: Body

  zoom-ladder-up : ViewPort, Integer, Integer, Text -> Text
  zoom-ladder-up (vp) (i) (n) (acc) =
    if i >= n then acc
    else let vp2 = viewport-zoom-in vp
    in zoom-ladder-up vp2 (i + 1) n (acc & " " & show (vp2.vp-zoom))

  zoom-ladder-down : ViewPort, Integer, Integer, Text -> Text
  zoom-ladder-down (vp) (i) (n) (acc) =
    if i >= n then acc
    else let vp2 = viewport-zoom-out vp
    in zoom-ladder-down vp2 (i + 1) n (acc & " " & show (vp2.vp-zoom))

  roundtrip : ViewPort, Integer -> Text
  roundtrip (vp) (wx) =
    let s = vp-world-to-screen-x vp wx
    in let w = vp-screen-to-world-x vp s
    in "w=" & show wx & " s=" & show s & " back=" & show w & (if w == wx then " ok" else " LOST")

  opening : [Console] Nothing =
    act
      let vp = viewport-new 50 30 400 200
      in let panned = viewport-pan vp 7 (0 - 3)
      in let fitted = viewport-zoom-fit (viewport-pan (viewport-zoom-in vp) 99 99)
      in act
        print-line-uni ("origin: x=" & show (vp-world-to-screen-x vp 0) & " y=" & show (vp-world-to-screen-y vp 0))
        print-line-uni ("panned: x=" & show (vp-world-to-screen-x panned 0) & " y=" & show (vp-world-to-screen-y panned 0))
        print-line-uni ("rt " & roundtrip vp 0)
        print-line-uni ("rt " & roundtrip vp 137)
        print-line-uni ("rt " & roundtrip vp (0 - 137))
        print-line-uni ("rt " & roundtrip panned 137)
        print-line-uni ("zoom in : " & zoom-ladder-up (viewport-new 0 0 100 100) 0 16 "100")
        print-line-uni ("zoom out: " & zoom-ladder-down (viewport-new 0 0 100 100) 0 10 "100")
        print-line-uni ("fit: zoom=" & show (fitted.vp-zoom) & " panx=" & show (fitted.vp-pan-x) & " w=" & show (fitted.vp-canvas-w))
        print-line-uni ("contains: 49=" & show (vp-contains vp 49 100) & " 50=" & show (vp-contains vp 50 100) & " 449=" & show (vp-contains vp 449 100) & " 450=" & show (vp-contains vp 450 100))
        print-line-uni ("snap pos: 0=" & show (vp-snap-to-grid 0 20) & " 9=" & show (vp-snap-to-grid 9 20) & " 10=" & show (vp-snap-to-grid 10 20) & " 25=" & show (vp-snap-to-grid 25 20) & " 35=" & show (vp-snap-to-grid 35 20))
        print-line-uni ("snap neg: -9=" & show (vp-snap-to-grid (0 - 9) 20) & " -10=" & show (vp-snap-to-grid (0 - 10) 20) & " -25=" & show (vp-snap-to-grid (0 - 25) 20) & " -35=" & show (vp-snap-to-grid (0 - 35) 20))
        print-line-uni ("snap g0 : 7=" & show (vp-snap-to-grid 7 0))
      end
    end
