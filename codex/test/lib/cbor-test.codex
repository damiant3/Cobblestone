Chapter: CborTest
  cites Encode chapter Cbor
  cites Foreword chapter Maybe

 RFC 8949 Appendix A test vectors — encode then decode, verify round-trip.

Section: Helpers

  show-bool : Boolean -> Text
  show-bool (b) = if b then "true" else "false"

  cbor-rt-uint : Integer -> Text
  cbor-rt-uint (n) =
    let encoded = cbor-encode (CborUint n)
    in when cbor-decode encoded
      is Just (v) -> when v
        is CborUint (m) -> if m == n then "pass" else "fail:" & show m
        is otherwise -> "fail:wrong-type"
      is None -> "fail:decode"

  cbor-rt-text : Text -> Text
  cbor-rt-text (s) =
    let encoded = cbor-encode (CborText s)
    in when cbor-decode encoded
      is Just (v) -> when v
        is CborText (t) -> if t == s then "pass" else "fail:" & t
        is otherwise -> "fail:wrong-type"
      is None -> "fail:decode"

  cbor-rt-bool : Boolean -> Text
  cbor-rt-bool (b) =
    let encoded = cbor-encode (CborBool b)
    in when cbor-decode encoded
      is Just (v) -> when v
        is CborBool (b2) -> if b == b2 then "pass" else "fail"
        is otherwise -> "fail:wrong-type"
      is None -> "fail:decode"

  cbor-rt-array : Text
  cbor-rt-array =
    let arr = cbor-encode (CborArray [CborUint 1, CborUint 2, CborUint 3])
    in when cbor-decode arr
      is Just (v) -> when v
        is CborArray (items) -> "array-len=" & show (list-length items)
        is otherwise -> "array=fail:type"
      is None -> "array=fail:decode"

  cbor-rt-null : Text
  cbor-rt-null =
    let null-enc = cbor-encode CborNull
    in when cbor-decode null-enc
      is Just (v) -> when v
        is CborNull -> "null=pass"
        is otherwise -> "null=fail:type"
      is None -> "null=fail:decode"

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("uint-0=" & cbor-rt-uint 0)
    print-line-uni ("uint-1=" & cbor-rt-uint 1)
    print-line-uni ("uint-23=" & cbor-rt-uint 23)
    print-line-uni ("uint-24=" & cbor-rt-uint 24)
    print-line-uni ("uint-255=" & cbor-rt-uint 255)
    print-line-uni ("uint-1000=" & cbor-rt-uint 1000)
    print-line-uni ("text-empty=" & cbor-rt-text "")
    print-line-uni ("text-hello=" & cbor-rt-text "hello")
    print-line-uni ("bool-true=" & cbor-rt-bool True)
    print-line-uni ("bool-false=" & cbor-rt-bool False)
    print-line-uni cbor-rt-array
    print-line-uni cbor-rt-null
  end

