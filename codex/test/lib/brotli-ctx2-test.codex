  ctx2-third : List Integer -> Integer
  ctx2-third (bs) = if list-length bs < 3 then 0 else list-at bs 2

  opening : [Console] Nothing
  opening = act
    print-line-uni ("ctx2-1 " & show (ctx2-third (brotli-decompress ctx2-in-1)))
    print-line-uni ("ctx2-2 " & show (ctx2-third (brotli-decompress ctx2-in-2)))
    print-line-uni ("ctx2-3 " & show (ctx2-third (brotli-decompress ctx2-in-3)))
