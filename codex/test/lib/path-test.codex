Chapter: PathTest
  cites Foreword chapter Path

Section: Body

  opening : [Console] Nothing = act
    print-line (path-join "codex" "Emit")
    print-line (path-join "codex/" "Emit")
    print-line (path-join "" "Emit")
    print-line (path-join "codex" "")
    print-line (path-parent "codex/Emit/X86_64.codex")
    print-line (path-filename "codex/Emit/X86_64.codex")
    print-line (path-stem "codex/Emit/X86_64.codex")
    print-line (path-extension "codex/Emit/X86_64.codex")
    print-line (path-extension "Makefile")
    print-line (path-normalize "codex/./Emit/../Emit/X86_64.codex")
    print-line (if path-is-absolute "/boot/efi" then "abs" else "rel")
    print-line (if path-is-absolute "codex/Emit" then "abs" else "rel")
    print-line (if path-has-extension "foo.codex" "codex" then "yes" else "no")
    print-line ("segs=" & show (list-length (path-segments "codex/Emit/X86_64.codex")))
  end

