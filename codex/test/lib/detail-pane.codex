Chapter: DetailPaneTest
  cites UI chapter DetailPane
  cites UI chapter StatusBadge
  cites UI chapter Dropdown
  cites UI chapter Widget
  cites UI chapter Theme

 We say:

Section: Reading

  at : WidgetNode, Integer -> WidgetNode
  at (w) (i) = list-at (w.wn-children) i

  payload : WidgetNode -> Text
  payload (w) = when w.wn-kind
    is WkLabel (t) -> "[" & t & "]"
    is WkButton (t) -> "<" & t & ">"
    is WkGauge (v) (m) -> "gauge(" & show v & "/" & show m & ")"
    is WkInput (t) (c) -> "input(" & t & ")"
    is WkSeparator -> "sep"
    is WkPanel -> "panel"
    is WkCustom (tag) -> "custom(" & tag & ")"

  kids : WidgetNode -> Text
  kids (w) = show (w.wn-child-count)

  ids : WidgetNode, Integer, Integer, Text -> Text
  ids (w) (i) (n) (acc) =
    if i >= n then acc
    else let c = at w i
    in ids w (i + 1) n (acc & (if i > 0 then " " else "") & c.wn-id)

  shape : WidgetNode -> Text
  shape (w) = ids w 0 (w.wn-child-count) ""

Section: The specs

  bare : Integer -> DetailSpec
  bare (x) = detail-spec "dp" "Fix the thing" "TRK-42"

  with-fields : Integer -> DetailSpec
  with-fields (x) =
    let s = detail-spec "dp" "Fix the thing" "TRK-42"
    in let s1 = detail-add-field s (df-text "Owner" "ada")
    in let s2 = detail-add-field s1 (df-badge "Status" "Active" #F59E0B)
    in let s3 = detail-add-field s2 (df-dropdown "Cycle" (dropdown-with-selected "cyc" ["C1", "C2"] 1))
    in detail-add-field s3 (df-widget "Progress" (widget-gauge "pg" 3 10))

Section: Which sections appear

  line-bare : Text =
    let w = detail-widget (bare 0)
    in "bare: kids=" & kids w & " shape=" & shape w

  line-fields : Text =
    let w = detail-widget (with-fields 0)
    in "fields: kids=" & kids w & " shape=" & shape w

  line-description : Text =
    let s = detail-set-description (bare 0) "A **bold** claim"
    in let w = detail-widget s
    in "description: kids=" & kids w & " shape=" & shape w

  line-activity : Text =
    let s = detail-add-activity (bare 0) "ada" "closed it" "09:41"
    in let w = detail-widget s
    in "activity: kids=" & kids w & " shape=" & shape w

  line-footer : Text =
    let s = detail-set-footer (bare 0) "3 attachments"
    in let w = detail-widget s
    in "footer: kids=" & kids w & " shape=" & shape w

Section: The header

  line-header : Text =
    let h = at (detail-widget (bare 0)) 0
    in "header: kids=" & kids h & " " & payload (at h 0) & payload (at h 1) & payload (at h 2)

Section: The four field kinds

  field-row : Integer -> WidgetNode
  field-row (i) = at (detail-widget (with-fields 0)) (i + 2)

  line-field-text : Text =
    let r = field-row 0
    in "text field: " & payload (at r 0) & payload (at r 1)

  line-field-badge : Text =
    let r = field-row 1
    in "badge field: " & payload (at r 0) & payload (at r 1)

  line-field-dropdown : Text =
    let r = field-row 2
    in "dropdown field: " & payload (at r 0) & payload (at r 1)

  line-field-widget : Text =
    let r = field-row 3
    in "widget field: " & payload (at r 0) & payload (at r 1)

  boxed : WidgetNode -> Text
  boxed (w) = payload w & "@" & show (w.wn-min-w) & "x" & show (w.wn-min-h)

  line-badge-vs-text : Text =
    let s = detail-add-field (detail-add-field (detail-spec "cmp" "t" "s") (df-text "L" "Active")) (df-badge "L" "Active" #EF4444)
    in let w = detail-widget s
    in let a = at (at w 2) 1
    in let b = at (at w 3) 1
    in "badge vs text: text=" & boxed a & " badge=" & boxed b
    & " same-payload=" & (if payload a == payload b then "yes" else "no")
    & " untoned=" & tone-name (b.wn-tone)

  line-badge-toned : Text =
    let s = detail-add-field (detail-add-field (detail-spec "cmp" "t" "s") (df-badge "P" "Active" #EF4444)) (df-badge-toned "T" "Active" #EF4444 tone-error)
    in let w = detail-widget s
    in let plain = at (at w 2) 1
    in let toned = at (at w 3) 1
    in "badge tone: plain=" & tone-name (plain.wn-tone) & " toned=" & tone-name (toned.wn-tone)
    & " same-payload=" & (if payload plain == payload toned then "yes" else "no")

Section: What StatusBadge itself renders

  line-badge-widget : Text =
    "badge-widget: urgent=" & payload (badge-widget "b1" (badge-priority 0))
    & " none=" & payload (badge-widget "b2" (badge-priority 4))
    & " same=" & (if payload (badge-widget "b1" (badge-priority 0)) == payload (badge-widget "b2" (badge-priority 4)) then "yes" else "no")

  line-badge-dots : Text =
    "badge dots: done=" & payload (badge-widget "b3" (badge-status 4))
    & " todo=" & payload (badge-widget "b4" (badge-status 1))
    & " pill-bug=" & payload (badge-widget "b5" (badge-label "bug"))
    & " pill-docs=" & payload (badge-widget "b6" (badge-label "docs"))

  line-badge-colors : Text =
    "colors differ: urgent=" & show (badge-priority-color 0)
    & " none=" & show (badge-priority-color 4)
    & " bug=" & show (badge-label-color "bug")
    & " docs=" & show (badge-label-color "docs")

Section: What a caller still holding the spec sees

  line-alias : Text =
    let s = detail-spec "al" "t" "s"
    in let added = detail-add-field s (df-text "Owner" "ada")
    in "alias: returned=" & show (list-length (added.ds-fields))
    & " original-after=" & show (list-length (s.ds-fields))

Section: Body

  report-a : Text =
    line-bare & "\n" & line-fields & "\n" & line-description & "\n"
    & line-activity & "\n" & line-footer & "\n" & line-header

  report-b : Text =
    line-field-text & "\n" & line-field-badge & "\n" & line-field-dropdown
    & "\n" & line-field-widget & "\n" & line-badge-vs-text

  report-c : Text =
    line-badge-toned & "\n" & line-badge-widget & "\n" & line-badge-dots & "\n" & line-badge-colors
    & "\n" & line-alias

  opening : [Console] Nothing = act
    print-line-uni report-a
    print-line-uni report-b
    print-line-uni report-c
  end
