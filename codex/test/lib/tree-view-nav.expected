new: tv roots=3 focused=
depths: a0 a-11 a-1-x2 a-21 b0 c0 c-11
collapsed: a0 b0 c0
a open: a0 a-11 a-21 b0 c0
a and a-1 open: a0 a-11 a-1-x2 a-21 b0 c0
a-1 opened before a: a0 a-11 a-1-x2 a-21 b0 c0
a toggled twice: a0 b0 c0
expand-all: a0 a-11 a-1-x2 a-21 b0 c0 c-11
collapse-all: a0 b0 c0
select a-1-x: selected=[a-1-x ] focused=a-1-x
then select c: selected=[c ] focused=c
alias toggle: returned=a0 a-11 a-21 b0 c0 original-after=a0 a-11 a-21 b0 c0
alias select: returned=[a-1-x ] original-after=[a-1-x ]
keys: down=[b] up=[a] right=[a]
key-right opens: a0 a-11 a-21 b0 c0
nav-down from no focus: [a] then again: [b]
nav-up from no focus: []
walk: from a -> [b] from b -> [c]
ends: down at last -> [c] up at first -> [a]
down into an open branch: [a-1]
left on an open node: a0 b0 c0 focus=a
left on a child: focus=a
left on a shut root: focus=b
parent with no focus: focus=[]
rows=3 a-row []<>>[A][Alpha] b-row [][ ][B][Bravo]
open rows=5 a-row []<v>[A][Alpha] a-1-row [  ]<>>[1][Alpha One]
states: a=normal b=pressed c=normal
format: [a A Alpha [open] *] [a-1 1 Alpha One]
