Chapter: Bencode Guard
  cites Foreword chapter Console
  cites Encode chapter Bencode

Section: Helpers

  describe : BenValue -> Text
  describe (v) = when v
    is BenInt (n) -> "int " & show n
    is BenStr (s) -> "str [" & s & "]"
    is BenList (items) -> "list " & show (list-length items)
    is BenDict (ps) -> "dict " & show (list-length ps)

  arm : Text, Text -> Text
  arm (name) (s) =
    let r = ben-decode s
    in if r.ben-ok then name & " pos=" & show (r.ben-pos) & " " & describe (r.ben-value)
    else name & " refused"

  repeat : Text, Integer, Text -> Text
  repeat (t) (n) (acc) = if n <= 0 then acc else repeat t (n - 1) (acc & t)

  nested : Integer -> Text
  nested (n) = repeat "l" n "" & repeat "e" n ""

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (arm "int" "i42e")
    print-line-uni (arm "neg" "i-7e")
    print-line-uni (arm "zero" "i0e")
    print-line-uni (arm "max" "i9223372036854775807e")
    print-line-uni (arm "str" "4:spam")
    print-line-uni (arm "empty-str" "0:")
    print-line-uni (arm "list" "l4:spami42ee")
    print-line-uni (arm "dict" "d3:bar4:spam3:fooi42ee")
    print-line-uni (arm "deep-200" (nested 200))
    print-line-uni (arm "junk-int" "i12abce")
    print-line-uni (arm "empty-int" "ie")
    print-line-uni (arm "leading-zero" "i03e")
    print-line-uni (arm "neg-zero" "i-0e")
    print-line-uni (arm "junk-len" "x:")
    print-line-uni (arm "trailing" "i1ei2e")
    print-line-uni (arm "short-str" "5:ab")
    print-line-uni (arm "big-int" "i9223372036854775808e")
    print-line-uni (arm "huge-int" "i99999999999999999999e")
    print-line-uni (arm "neg-len" "-3:abc")
    print-line-uni (arm "lz-len" "03:abc")
    print-line-uni (arm "open-list" "li1e")
    print-line-uni (arm "deep-300" (nested 300))
    print-line-uni (arm "empty" "")
  end
