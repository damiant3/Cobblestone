shape: fields=13 children=15 labelwidth=80
title: label[Generation Settings] id=sp-title sep=sp-sep0
dropdown: selected=button[cyber v] unselected=button[-- select -- v]
get-dropdown: model=[cyber] vae=[] absent=[]
slider: steps=gauge[19/49] cfg=gauge[6/19] wt=gauge[100/200] atmax=gauge[49/49]
overfill: steps=no cfg=no wt=no atmax=no
input: width=input[512] name=input[portrait] readonly=label[png]
toggle: off=button[[ ]]
error: width=label[] name=label[]
bare: sep1=sp-sep-10 heading=sp-hdr-11[label[Post-Processing]] sep2=sp-sep-12
ids: sep-collide=no row0=model-row label0=label[Model]
