Chapter: LinAlgTest
  cites Math chapter LinearAlgebra

 The matrices are rebuilt inside each helper because an act block's
 let does not scope across statements; helpers keep the act body a
 flat list of prints.

Section: Definitions

  la-a : Matrix
  la-a = mat-from-list 2 2 [2000, 1000, 0, 3000]

  la-b : Matrix
  la-b = mat-from-list 2 2 [1000, 0, 500, 2000]

  la-id : Integer, Integer -> Text
  la-id (r) (c) = show (mat-get (mat-identity 3) r c)

  la-mul : Integer, Integer -> Text
  la-mul (r) (c) = show (mat-get (mat-mul la-a la-b) r c)

  la-trans : Integer, Integer -> Text
  la-trans (r) (c) = show (mat-get (mat-transpose la-a) r c)

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("id-00=" & la-id 0 0)
    print-line-uni ("id-01=" & la-id 0 1)
    print-line-uni ("id-11=" & la-id 1 1)
    print-line-uni ("mul-00=" & la-mul 0 0)
    print-line-uni ("mul-01=" & la-mul 0 1)
    print-line-uni ("mul-10=" & la-mul 1 0)
    print-line-uni ("mul-11=" & la-mul 1 1)
    print-line-uni ("det=" & show (mat-det la-a))
    print-line-uni ("trans-01=" & la-trans 0 1)
    print-line-uni ("trans-10=" & la-trans 1 0)
    print-line-uni ("add-00=" & show (mat-get (mat-add la-a la-b) 0 0))
  end

