Chapter: LinAlgTest
  cites Math chapter LinearAlgebra

Section: Body

  opening : [Console] Nothing = act
    let id = mat-identity 3
    in print-line-uni ("id-00=" & show (mat-get id 0 0))
    print-line-uni ("id-01=" & show (mat-get id 0 1))
    print-line-uni ("id-11=" & show (mat-get id 1 1))
    let a = mat-from-list 2 2 [2000, 1000, 0, 3000]
    in let b = mat-from-list 2 2 [1000, 0, 500, 2000]
    in let ab = mat-mul a b
    in act
      print-line-uni ("mul-00=" & show (mat-get ab 0 0))
      print-line-uni ("mul-01=" & show (mat-get ab 0 1))
      print-line-uni ("mul-10=" & show (mat-get ab 1 0))
      print-line-uni ("mul-11=" & show (mat-get ab 1 1))
    let det-a = mat-det a
    in print-line-uni ("det=" & show det-a)
    let t = mat-transpose a
    in act
      print-line-uni ("trans-01=" & show (mat-get t 0 1))
      print-line-uni ("trans-10=" & show (mat-get t 1 0))
    let sum = mat-add a b
    in print-line-uni ("add-00=" & show (mat-get sum 0 0))
  end

