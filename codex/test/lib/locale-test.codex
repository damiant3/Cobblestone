Chapter: LocaleTest
  cites Foreword chapter Locale

Section: Body

  opening : [Console] Nothing = act
    let us = locale-en-us
    in let de = locale-de
    in let ja = locale-ja
    in let ar = locale-ar
    in act
      print-line-uni ("us-num=" & locale-format-number us 1234567)
      print-line-uni ("de-num=" & locale-format-number de 1234567)
      print-line-uni ("small=" & locale-format-number us 42)
      print-line-uni ("neg=" & locale-format-number us (0 - 9876))
      print-line-uni ("us-date=" & locale-format-date us 2026 5 8)
      print-line-uni ("de-date=" & locale-format-date de 2026 5 8)
      print-line-uni ("ja-date=" & locale-format-date ja 2026 5 8)
      print-line-uni ("us-dir=" & if locale-is-rtl us then "rtl" else "ltr")
      print-line-uni ("ar-dir=" & if locale-is-rtl ar then "rtl" else "ltr")
      print-line-uni ("de-sep=" & locale-decimal-sep de)
      print-line-uni ("de-thou=" & locale-thousands-sep de)
    end
  end

