Chapter: LossTest
  cites AI chapter Loss

Section: Body

  opening : [Console] Nothing = act
    let pred = [800, 600, 400, 200]
    in let target = [1000, 500, 300, 100]
    in act
      let mse = loss-mse pred target
      in print-line-uni ("mse=" & if mse > 0 then "positive" else "zero")
      let hinge = loss-hinge [500, 800] [1000, 0 - 1000]
      in print-line-uni ("hinge=" & if hinge >= 0 then "non-neg" else "negative")
      let huber = loss-huber pred target 500
      in print-line-uni ("huber=" & if huber > 0 then "positive" else "zero")
      let perfect-mse = loss-mse [500, 500] [500, 500]
      in print-line-uni ("perfect-mse=" & show perfect-mse)
    print-line-uni ("clamp-lo=" & show (loss-clamp (0 - 5) 0 100))
    print-line-uni ("clamp-hi=" & show (loss-clamp 200 0 100))
    print-line-uni ("clamp-mid=" & show (loss-clamp 50 0 100))
  end

