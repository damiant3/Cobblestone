Chapter: LossTest
  cites AI chapter Loss

 Helpers rebuild the prediction and target lists because an act
 block's let does not scope across statements.

Section: Definitions

  ls-pred : List Integer
  ls-pred = [800, 600, 400, 200]

  ls-target : List Integer
  ls-target = [1000, 500, 300, 100]

  ls-mse : Text
  ls-mse = if loss-mse ls-pred ls-target > 0 then "positive" else "zero"

  ls-hinge : Text
  ls-hinge = if loss-hinge [500, 800] [1000, 0 - 1000] >= 0 then "non-neg" else "negative"

  ls-huber : Text
  ls-huber = if loss-huber ls-pred ls-target 500 > 0 then "positive" else "zero"

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("mse=" & ls-mse)
    print-line-uni ("hinge=" & ls-hinge)
    print-line-uni ("huber=" & ls-huber)
    print-line-uni ("perfect-mse=" & show (loss-mse [500, 500] [500, 500]))
    print-line-uni ("clamp-lo=" & show (loss-clamp (0 - 5) 0 100))
    print-line-uni ("clamp-hi=" & show (loss-clamp 200 0 100))
    print-line-uni ("clamp-mid=" & show (loss-clamp 50 0 100))
  end

