Chapter: IrFidelitySummary
  cites Codex chapter Opening
  cites Codex chapter IR Fidelity (ir-fidelity-bag)

  probe-source : Text = "Chapter: FidProbe\n  double : Integer -> Integer\n  double (x) = x + x\n\n  pick : Integer, Boolean -> Integer\n  pick (n) (b) =\n    let m = double n\n    in if b then m - 1 else m + 1\n\n  opening : Integer\n  opening = pick (double 3) (3 > 2)\n"

  print-fidelity : List Diagnostic, Integer -> [Console] Nothing
  print-fidelity (ds) (i) =
    if i >= list-length ds then act
      print-uni ""
    end
    else act
      print-line-uni ((list-at ds i).message)
      print-fidelity ds (i + 1)
    end

  opening : [Console] Nothing =
    let init = init-phase-allocator
    in let flags = __record-set compile-flags-default "fidelity" True
    in let fe = compile-frontend-ir probe-source "FidProbe" flags
    in if bag-has-errors (fe.bag) then print-line-uni "FAIL diagnostics"
    else let prepared = prepare-method-ir fe flags
    in let graded = ir-fidelity-bag (fe.fid-types) (prepared.chapter)
    in let control = ir-fidelity-bag [] (prepared.chapter)
    in act
      print-line-uni ("recorded " & integer-to-text (list-length (fe.fid-types)))
      print-fidelity (graded.diagnostics) 0
      print-fidelity (control.diagnostics) 0
    end
