Chapter: Stale Sibling

Section: Definitions

  Box = record { n : Integer }

  addn : Box, Integer -> Box
  addn (b) (k) = __record-set b "n" ((b.n) + k)

  two : Box, Integer -> Integer
  two (b) (x) = (b.n) + x

  three : Box, Integer, Integer -> Integer
  three (b) (x) (y) = (b.n) + x + y

Section: Arms

  arm-sibling : Box -> Integer
  arm-sibling (ss) = two (addn ss 10) (ss.n)

  arm-sibling3 : Box -> Integer
  arm-sibling3 (s3) = three (addn s3 10) (s3.n) 5

Section: Entry

  opening : [Console] Nothing = act
    print-line (integer-to-text (arm-sibling (Box { n = 1 })))
    print-line (integer-to-text (arm-sibling3 (Box { n = 1 })))
  end

