Chapter: DateTimeRtcDecodeTest
  cites Dev chapter DateTimeSettings

Section: Entry
  drd-show : DateTimeState -> Text
  drd-show (st) = (if st.dt-rtc-read then "read " else "unread ") & dt-format-date st & " " & dt-pad2 st.dt-hour & ":" & dt-pad2 st.dt-minute & ":" & dt-pad2 st.dt-second

  drd-line : Text, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Text
  drd-line (name) (b) (s) (mi) (h) (d) (mo) (y) = name & " " & drd-show (dt-from-rtc datetime-new b s mi h d mo y)

  opening : [Console] Nothing = act
    print-line-uni (drd-line "bcd-24h" 2 9 5 20 49 16 38)
    print-line-uni (drd-line "binary-24h" 6 9 5 14 31 10 26)
    print-line-uni (drd-line "bcd-12h-2pm" 0 0 48 130 1 1 0)
    print-line-uni (drd-line "bcd-12h-midnight" 0 0 0 18 1 1 0)
    print-line-uni (drd-line "bcd-12h-noon" 0 0 0 146 1 1 0)
    print-line-uni (drd-line "bcd-12h-11am" 0 89 89 17 1 1 0)
    print-line-uni (drd-line "bad-month" 2 0 0 0 1 19 38)
    print-line-uni (drd-line "feb-29-common" 2 0 0 0 41 2 38)
    print-line-uni (drd-line "feb-29-leap" 2 0 0 0 41 2 40)
    print-line-uni (drd-line "bad-second" 6 60 0 0 1 1 26)
    print-line-uni ("new " & drd-show datetime-new)
  end
