Chapter: IrPassesRegistry
  cites Codex chapter Passes
  cites Codex chapter IR Chapter
  cites Codex chapter Name
  cites Codex chapter Source Text
  cites Foreword chapter Console

Section: Fixtures
  empty-ch : IRChapter = IRChapter { name = make-name "Empty", defs = [], effect-op-names = [], span = synthetic-span }

  join : List Text, Integer -> Text
  join (xs) (i) =
    if i >= list-length xs then ""
    else (if i > 0 then " | " else "") & list-at xs i & join xs (i + 1)

  pass-row : Text -> Text
  pass-row (n) =
    let r = run-ir-pass n empty-ch
    in n & ": defs=" & show (list-length r.chapter.defs) & " violations=" & show (list-length r.violations) & " infos=" & show (list-length r.infos)

  pipe-row : List Text -> Text
  pipe-row (names) =
    let r = run-ir-pipeline names empty-ch False
    in "infos=" & show (list-length r.infos) & " [" & join r.infos 0 & "] violations=" & show (list-length r.violations)

Section: Cases
  opening : [Console] Nothing = act
    print-line-uni ("default: " & join default-ir-pipeline 0)
    print-line-uni ("text-plug: " & join text-plug-ir-pipeline 0)
    print-line-uni ("parsed: " & show (list-length (parse-pipeline-names "fold-constants,ir-check,simplify")) & " " & join (parse-pipeline-names "fold-constants,ir-check,simplify") 0)
    print-line-uni ("names-text: " & pipeline-names-text ["a", "b", "c"] 0 3 "")
    print-line-uni ("names-text from 1: " & pipeline-names-text ["a", "b", "c"] 1 3 "")
    print-line-uni ("tagged: " & join (tag-pass-violations ["kept"] 4 ["x", "y"] 0 2) 0)
    print-line-uni ("frontier: " & pass-frontier-mark "fold-constants" 1000 1640)
    print-line-uni (pass-row "fold-constants")
    print-line-uni (pass-row "inline-leaf-calls")
    print-line-uni (pass-row "inline-single-caller")
    print-line-uni (pass-row "inline-cost-based")
    print-line-uni (pass-row "ir-check")
    print-line-uni (pass-row "occ-report")
    print-line-uni (pass-row "simplify")
    print-line-uni (pass-row "cover-arms")
    print-line-uni (pass-row "lir-dump-a64")
    print-line-uni (pass-row "no-such-pass")
    print-line-uni (pipe-row [])
    print-line-uni (pipe-row ["fold-constants", "ir-check"])
  end
