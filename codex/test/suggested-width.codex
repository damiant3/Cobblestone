Chapter: SuggestedWidth
  cites Foreword chapter Console

Section: Entry
  opening : [Console] Nothing
  opening = act
    print-line-uni ("f64: " & show (suggested-vector-width 0.0))
    print-line-uni ("f32: " & show (suggested-vector-width (to-real-approx 0.0)))
    print-line-uni ("int: " & show (suggested-vector-width 0))
  end
