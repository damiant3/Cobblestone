Chapter: TypeClassGenVar
  cites Foreword chapter Console

 A constrained generic function called with a variable argument (not a
 literal): the instance dictionary is resolved from the argument's type
 at the call site, in lower-apply.

class Showable where
  to-text : a -> Text

instance Showable Integer where
  to-text (x) = show x

instance Showable Boolean where
  to-text (b) = if b then "yes" else "no"

Section: Opening

  describe : Showable a => a -> Text
  describe (x) = "Value: " & to-text x

  go : Integer -> Text
  go (n) = describe n

  opening : [Console] Nothing
  opening = act
   print-line-uni (go 42)
   print-line-uni (describe True)
  end
