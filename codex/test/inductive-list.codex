Chapter: InductiveListTest
  cites Foreword chapter InductiveList

Section: Lemmas

  claim iappend-nil : for all (xs : IList Integer), ilist-append xs INil === xs
  proof iappend-nil =
   induction on xs
    is INil -> Refl
    is ICons (h) (t) (ih) -> cong ih
   qed

  claim iappend-assoc : for all (as : IList Integer), for all (bs : IList Integer), for all (cs : IList Integer), ilist-append (ilist-append as bs) cs === ilist-append as (ilist-append bs cs)
  proof iappend-assoc =
   induction on as
    is INil -> Refl
    is ICons (h) (t) (ih) -> cong ih
   qed

  claim ireverse-append : for all (xs : IList Integer), for all (ys : IList Integer), ilist-reverse (ilist-append xs ys) === ilist-append (ilist-reverse ys) (ilist-reverse xs)
  proof ireverse-append =
   induction on xs
    is INil -> sym (iappend-nil (ilist-reverse ys))
    is ICons (h) (t) (ih) -> trans (app-cong (cong ih)) (iappend-assoc (ilist-reverse ys) (ilist-reverse t) (ICons h INil))
   qed

Section: The Flagship, Over A Foreword Container

  claim ireverse-reverse : for all (xs : IList Integer), ilist-reverse (ilist-reverse xs) === xs
  proof ireverse-reverse =
   induction on xs
    is INil -> Refl
    is ICons (h) (t) (ih) -> trans (ireverse-append (ilist-reverse t) (ICons h INil)) (cong ih)
   qed

Section: Main

  opening : [Console] Nothing
  opening = act
   let xs = ilist-from-list [1, 2, 3]
   in let back = ilist-to-list (ilist-reverse (ilist-reverse xs))
   in print-line-uni ("inductive-list: QED len=" & show (ilist-length xs) & " roundtrip=" & show (list-at back 0) & show (list-at back 1) & show (list-at back 2))
  end
