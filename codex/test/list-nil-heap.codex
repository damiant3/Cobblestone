Chapter: ListNilHeap
  cites Foreword chapter Console

 What an empty list literal costs, and that a push onto one keeps its element
 once the heap moves on. `[]` is a capacity word and a length word, 16 bytes;
 a four-element literal is 48. A first push must grow a capacity-0 list to at
 least 4: a grow that doubles zero stores the element past its own allocation,
 where the next allocation lands, and `nil-push` reads 9 instead of 7.

Section: The Measurement

  nil-list : Integer -> List Integer
  nil-list (u) = []

  nil-cost : Integer -> Integer
  nil-cost (u) =
    let a = __heap-save
    in let l = nil-list u
    in let b = __heap-save
    in if list-length l /= 0 then 0 - 1 else b - a

  lit-cost : Integer -> Integer
  lit-cost (u) =
    let a = __heap-save
    in let l = [u, u + 1, u + 2, u + 3]
    in let b = __heap-save
    in if list-length l /= 4 then 0 - 1 else b - a

  nil-push : Integer -> Integer
  nil-push (u) =
    let l = list-push (nil-list u) 7
    in let x = [9, 9, 9, 9, 9, 9]
    in if list-length x /= 6 then 0 - 1 else list-at l 0

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("nil " & show (nil-cost 0))
    print-line-uni ("lit-4 " & show (lit-cost 1))
    print-line-uni ("nil-push " & show (nil-push 0))
  end
