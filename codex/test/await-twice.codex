Chapter: AwaitTwice
  cites Foreword chapter Console

Section: Body

  fresh : Integer -> Integer
  fresh (n) =
    let t = fork (\x -> n)
    in let a = await t
    in let u = fork (\x -> n + 4)
    in a * 100 + await u

  twice : Integer -> Integer
  twice (n) =
    let t = fork (\x -> n)
    in let a = await t
    in let u = fork (\x -> n + 4)
    in let b = await t
    in a * 100 + b + (await u) * 0

  opening : [Console] Nothing = act
    print-line-uni ("fresh: " & show (fresh 5))
    trying 1 times
      print-line-uni ("stale: " & show (twice 5))
    falling back to
      print-line-uni "stale: refused"
    end
  end