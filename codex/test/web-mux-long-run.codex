Section: Wire Fixtures
  srv-mac : List Integer = [82, 84, 0, 18, 52, 86]
  cli-mac : List Integer = [82, 85, 10, 0, 2, 2]
  srv-ip : List Integer = [10, 0, 2, 15]
  a-ip : List Integer = [10, 0, 2, 100]

  get-bytes : List Integer = [71, 69, 84, 32, 47, 32, 72, 84, 84, 80, 47, 49, 46, 49, 13, 10, 13, 10]

  psh : Integer = bit-or tcp-flag-psh tcp-flag-ack

  mk : Integer, Integer, Integer, List Integer -> List Integer
  mk (seq) (ack) (flags) (payload) =
    let seg = tcp-with-checksum (tcp-build-segment 50000 80 seq ack flags 8192 payload) a-ip srv-ip
    in let ip = ip-build-packet a-ip srv-ip ip-proto-tcp seg
    in eth-build-frame srv-mac cli-mac eth-type-ipv4 ip

Section: Route
  test-route : HttpRequest -> HttpResponse
  test-route (req) = http-json "{\"ok\":true}"

  srv-next : WebMux -> Integer
  srv-next (m) = if list-length (m.conns) == 0 then 0 else ((((list-at (m.conns) 0).transport).session).conn).send-next

Section: Requests

  cycle : WebMux, Integer, Integer -> [Network.Read, Network.Write] WebMux
  cycle (m) (seq) (n) =
    if n <= 0 then m
    else act
      m1 <- web-mux-feed test-route (\line -> 0) m (mk seq (srv-next m) psh get-bytes) 80
      m2 <- web-mux-feed test-route (\line -> 0) m1 (mk (seq + 18) (srv-next m1) tcp-flag-ack []) 80
      cycle m2 (seq + 18) (n - 1)
    end

  cycle-compacted : WebMux, Integer, Integer, Integer, Integer -> [Network.Read, Network.Write] WebMux
  cycle-compacted (m) (seq) (n) (set) (mark) =
    if n <= 0 then m
    else act
      m1 <- web-mux-feed test-route (\line -> 0) m (mk seq (srv-next m) psh get-bytes) 80
      m2 <- web-mux-feed test-route (\line -> 0) (web-mux-compact m1 set mark) (mk (seq + 18) (srv-next m1) tcp-flag-ack []) 80
      cycle-compacted (web-mux-compact m2 set mark) (seq + 18) (n - 1) set mark
    end

  opened : Integer -> [Network.Read, Network.Write] WebMux
  opened (x) = act
    let m0 = WebMux { listen = net-io-listen (fresh-listen-transport 80), conns = [], free = [], served = 0 }
    in act
      m1 <- web-mux-feed test-route (\line -> 0) m0 (mk 1000 0 tcp-flag-syn []) 80
      web-mux-feed test-route (\line -> 0) m1 (mk 1001 (srv-next m1) tcp-flag-ack []) 80
    end
  end
Section: Entry

  yn : Boolean -> Text
  yn (b) = if b then "yes" else "no"

  opening : [Console, Network.Read, Network.Write] Nothing = act
    let m0 = WebMux { listen = net-io-listen (fresh-listen-transport 80), conns = [], free = [], served = 0 }
    in act
      m1 <- web-mux-feed test-route (\line -> 0) m0 (mk 1000 0 tcp-flag-syn []) 80
      m2 <- web-mux-feed test-route (\line -> 0) m1 (mk 1001 (srv-next m1) tcp-flag-ack []) 80
      let h0 = __heap-save
      in act
        m3 <- cycle m2 1001 20
        let h1 = __heap-save
        in act
          m4 <- cycle m3 (1001 + 18 * 20) 200
          let h2 = __heap-save
          in let d20 = h1 - h0
          in let d200 = h2 - h1
          in act
            print-line-uni ("served every request: " & yn (m4.served == 220))
            print-line-uni ("one live connection: " & yn (list-length (m4.conns) == 1))
            print-line-uni ("20 requests retain heap: " & yn (d20 > 0))
            print-line-uni ("200 requests retain nine to eleven times as much: " & yn (d200 >= 9 * d20 & d200 <= 11 * d20))
            c0 <- opened 0
            let set = nc-set-acquire (nc-pool-cell process-get-pid)
            in let mark = __heap-save
            in act
              c1 <- cycle-compacted c0 1001 20 set mark
              let e20 = __heap-save - mark
              in act
                c2 <- cycle-compacted c1 (1001 + 18 * 20) 200 set mark
                let e220 = __heap-save - mark
                in act
                  print-line-uni ("compacted, served every request: " & yn (c2.served == 220 & list-length (c2.conns) == 1))
                  print-line-uni ("compacted, the mux was copied at least twice: " & yn (peek-32 set 0 >= 2))
                  print-line-uni ("compacted, heap above the mark within one arena and one request after 20 and 220: " & yn (e20 <= net-compact-bytes + d20 / 20 & e220 <= net-compact-bytes + d20 / 20))
                end
              end
            end
          end        end
      end
    end
  end

