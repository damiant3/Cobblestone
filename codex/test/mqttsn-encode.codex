Chapter: MqttSnEncodeTest

  cites Encode chapter MqttSn

 Exercise the MQTT-SN builders: CONNECT, REGISTER, PUBLISH, SUBSCRIBE,
 PINGREQ, DISCONNECT. Byte sequences checked against a hand-verified
 layout (length-prefixed, big-endian two-byte fields). opening returns
 the count of passing checks.

Section: Helpers

  bytes-eq : List Integer, List Integer -> Boolean
  bytes-eq (a) (b) =
   if list-length a /= list-length b then False
   else bytes-eq-loop a b 0 (list-length a)

  bytes-eq-loop : List Integer, List Integer, Integer, Integer -> Boolean
  bytes-eq-loop (a) (b) (i) (len) =
   if i >= len then True
   else if list-at a i /= list-at b i then False
   else bytes-eq-loop a b (i + 1) len

  flag : Boolean -> Integer
  flag (b) = if b then 1 else 0

Section: Checks

  check-connect : Integer
  check-connect =
   flag (bytes-eq (mqttsn-build-connect mqttsn-flag-clean-session 60 "codex-sn") [14, 4, 4, 1, 0, 60, 99, 111, 100, 101, 120, 45, 115, 110])

  check-register : Integer
  check-register =
   flag (bytes-eq (mqttsn-build-register 0 1 "sensors/temp") [18, 10, 0, 0, 0, 1, 115, 101, 110, 115, 111, 114, 115, 47, 116, 101, 109, 112])

  check-publish : Integer
  check-publish =
   flag (bytes-eq (mqttsn-build-publish 0 5 1 [50, 51]) [9, 12, 0, 0, 5, 0, 1, 50, 51])

  check-subscribe : Integer
  check-subscribe =
   flag (bytes-eq (mqttsn-build-subscribe 0 1 "sensors/#") [14, 18, 0, 0, 1, 115, 101, 110, 115, 111, 114, 115, 47, 35])

  check-pingreq : Integer
  check-pingreq =
   flag (bytes-eq mqttsn-build-pingreq [2, 22])

  check-disconnect : Integer
  check-disconnect =
   flag (bytes-eq mqttsn-build-disconnect [2, 24])

  opening : Integer =
   let a = check-connect
   in let b = check-register
   in let c = check-publish
   in let d = check-subscribe
   in let e = check-pingreq
   in let f = check-disconnect
   in a + b + c + d + e + f
