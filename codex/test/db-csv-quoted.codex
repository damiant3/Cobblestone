 We say:

Section: Report

 Each field is printed between brackets, so an empty field, a leading quote
 and a trailing quote are all visible. plain and mid-quote are the controls:
 an unquoted line must split exactly as before, and a quote that does not
 open a field stays a literal character.

  fields-of : Text -> Text
  fields-of (line) =
    let fs = split-delimited line 44 0 (text-length line) [] ""
    in show (list-length fs) & " " & bracket-all fs 0 (list-length fs) ""

  bracket-all : List Text, Integer, Integer, Text -> Text
  bracket-all (fs) (i) (n) (acc) =
    if i >= n then acc
    else bracket-all fs (i + 1) n (acc & "[" & list-at fs i & "]")

  int-of : Text -> Text
  int-of (field) =
    when parse-field-value field ColInteger
      is ValInteger (n) -> show n
      is ValNull -> "null"
      is otherwise -> "other"

Section: Entry
  opening : [Console] Nothing = act
    let q42 = list-at (split-delimited "\"42\",7" 44 0 6 [] "") 0
    in act
      print-line-uni ("plain " & fields-of "a,b,c")
      print-line-uni ("quoted-comma " & fields-of "\"x,y\",z")
      print-line-uni ("doubled " & fields-of "\"a\"\"b\",c")
      print-line-uni ("empty-quoted " & fields-of "\"\",x")
      print-line-uni ("mid-quote " & fields-of "ab\"c,d")
      print-line-uni ("quoted-int " & int-of q42)
    end
  end