Chapter: FailUnwindDeck
  cites Foreword chapter Console

Section: Instrument

  show-yn : Boolean -> Text
  show-yn (b) = if b then "yes" else "no"

Section: Phase Allocator

  init-phase-allocator : Integer
  init-phase-allocator =
   __heap-save

  deck-record : a -> a
  deck-record (x) =
   x

Section: Report

  boom : Integer -> Integer
  boom (n) = if n > 0 then fail "boom" else n

  probe : Integer -> [Console] Nothing
  probe (start) = act
    trying 1 times
      print-line-uni ("never " & show (deck-record (boom 1)))
    falling back to
      print-line-uni ("the unwind returns to the bivy  : " & show-yn (__heap-save == start))
    end
  end

  report : Integer, Integer -> [Console] Nothing
  report (mark) (start) =
   let inside = deck-record (__heap-save)
   in let after = __heap-save
   in act
     print-line-uni ("a later extent runs on the deck : " & show-yn (inside >= mark))
     print-line-uni ("and restores the bivy after it  : " & show-yn (after == start))
   end

  opening : [Console] Nothing = act
   let base = init-phase-allocator
   in let bivy = __heap-save
   in let m = __deck-set (bivy + 4096)
   in probe __heap-save
   report (bivy + 4096) __heap-save
  end
