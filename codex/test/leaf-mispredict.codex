Chapter: LeafMispredict

  cites Foreword chapter Console

Section: Definitions

  m-swap : Integer, Integer, Integer -> Integer
  m-swap (n) (a) (b) = if n == 0 then a else m-swap (n - 1) b a

  p-shift : Integer, Integer -> Integer
  p-shift (n) (a) = if n == 0 then a else p-shift (n - 1) (a + a - n)

  opening : [Console] Nothing = act
    print-line-uni (show (m-swap 7 111 222))
    print-line-uni (show (p-shift 5 3))
  end

