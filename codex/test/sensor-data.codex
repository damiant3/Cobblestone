Chapter: SensorDataTest
  cites Foreword chapter SensorData

 Verify sensor data types, formatting, and time-series helpers.

Section: Body

  opening : [Console] Nothing = act
   let r = make-reading Temperature (FixedValue 23 5) 1000 "dev01"
   in act
    print-line-uni (format-reading r)
    print-line-uni (sensor-kind-name Humidity)
    print-line-uni (sensor-value-to-text (IntValue 42))
    print-line-uni (sensor-value-to-text (BoolValue True))
    let over = check-alert (AboveThreshold 30) 35
    in let under = check-alert (BelowThreshold 10) 5
    in act
     print-line-uni (if over then "ALERT" else "ok")
     print-line-uni (if under then "ALERT" else "ok")
    end
   end
  end

