Chapter: Zig Tvar Names

Section: Types

  Box (d) = record {
   held : d,
   count : Integer
  }

Section: Body

  a : Integer -> Integer
  a (x) = x + 1

  b : Integer -> Integer
  b (x) = x * 2

  c : Integer -> Integer
  c (x) = x - 3

  d : Integer -> Integer
  d (x) = x * x

  quad : Integer -> Tup4 Integer Integer Integer Integer
  quad (x) = MkTup4 (a x) (b x) (c x) (d x)

  sum4 : Tup4 Integer Integer Integer Integer -> Integer
  sum4 (t) =
   when t
    is MkTup4 (w) (x) (y) (z) -> w + x + y + z

  box-total : Integer -> Integer
  box-total (n) =
   let bx = Box { held = d n, count = 2 }
   in bx.held + bx.count

  opening : [Console] Nothing = act
   print-line-uni (show (sum4 (quad 5)))
   print-line-uni (show (box-total 7))
  end