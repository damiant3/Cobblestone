Chapter: HandlerSmoke
  cites Foreword chapter Console
  cites Codex chapter Concurrency

 Combined handler tests: basic, args, multi-op, nested, cross-fn, concurrent.

Section: Effects

  effect Counter where
    tick : [Counter] Integer

  effect Transform where
    apply-op : Integer -> [Transform] Integer

  effect Calc where
    add-val : Integer -> [Calc] Integer
    mul-val : Integer -> [Calc] Integer

  effect Config where
    get-value : [Config] Integer

  effect A where
    get-a : [A] Integer

  effect B where
    get-b : [B] Integer

Section: Helpers

  invoke-config : [Config] Integer
  invoke-config = get-value

  scaled : Integer, Integer, Nothing -> Integer
  scaled (x) (s) (u) = x * s

Section: Body

  opening : [Console] Nothing =
    let r1 = with Counter tick
      tick (resume) = resume 42
    in let r2 = with Transform (apply-op 6)
      apply-op (x) (resume) = resume (x * 7)
    in let r3 = with Calc (add-val 3 + mul-val 5)
      add-val (x) (resume) = resume (x + 10)
      mul-val (x) (resume) = resume (x * 2)
    in let r4 = with Config (invoke-config * 6)
      get-value (resume) = resume 7
    in let r5 = with A (with B (get-a + get-b))
      get-b (resume) = resume 20
      get-a (resume) = resume 22
    in act
      print-line-uni ("basic: " & show r1)
      print-line-uni ("args: " & show r2)
      print-line-uni ("multi-op: " & show r3)
      print-line-uni ("crossfn: " & show r4)
      print-line-uni ("nested: " & show r5)
    end

