Chapter: HalSpiLinear
  cites Foreword chapter Board

Section: Body
  bus : Integer -> [Spi, Device.Mmio] Integer
  bus (base) = act
    s0 <- spi-open base default-spi-config
    spi-close s0
  end

  opening : [Console, Spi, Device.Mmio] Nothing = act
    r <- bus 536872960
    print-line-uni ("spi lifecycle ok: " & show r)
  end
