Chapter: WhenJumpTable

  cites Foreword chapter Console

Section: Definitions

  dense : Text, Integer -> Integer
  dense (tag) (n) =
    when n
      is 0 -> 10
      is 1 -> 11
      is 2 -> 12
      is 3 -> 13
      is 5 -> 15
      is 6 -> 16
      is otherwise -> 0 - text-length tag

  signed : Text, Integer -> Integer
  signed (tag) (n) =
    when n
      is #FFFFFFFFFFFFFFFD -> 30
      is #FFFFFFFFFFFFFFFE -> 20
      is #FFFFFFFFFFFFFFFF -> 10
      is 0 -> 0
      is 1 -> 1
      is 3 -> 3
      is k -> k * 100 + text-length tag

  dup : Text, Integer -> Integer
  dup (tag) (n) =
    when n
      is 4 -> 40
      is 5 -> 50
      is 4 -> 99
      is 6 -> 60
      is 7 -> 70
      is otherwise -> text-length tag

  sparse : Text, Integer -> Integer
  sparse (tag) (n) =
    when n
      is 1 -> 1
      is 100 -> 2
      is 10000 -> 3
      is 1000000 -> 4
      is otherwise -> text-length tag

  nested : Text, Integer, Integer -> Integer
  nested (tag) (a) (b) =
    when a
      is 0 -> dense tag b
      is 1 -> (when b
        is 0 -> 100
        is 1 -> 101
        is 2 -> 102
        is 3 -> 103
        is otherwise -> 199 + text-length tag)
      is 2 -> 2000 + b
      is 3 -> 3000 + b
      is otherwise -> 9 + text-length tag

  steps : Text, Integer, Integer -> Integer
  steps (tag) (n) (acc) =
    when n
      is 0 -> acc + text-length tag
      is 1 -> steps tag 0 (acc + 1)
      is 2 -> steps tag 1 (acc + 20)
      is 3 -> steps tag 2 (acc + 300)
      is otherwise -> steps tag (n - 4) (acc + 4000)

  octet : Text, Integer between 0 and 255 -> Integer
  octet (tag) (b) =
    when b
      is 250 -> 1
      is 251 -> 2
      is 252 -> 3
      is 253 -> 4
      is 255 -> 5
      is otherwise -> 6 + text-length tag

  wide : Integer -> Integer
  wide (n) =
    when n
      is 0 -> 1
      is 1 -> 2
      is 2 -> 3
      is 3 -> 5
      is 4 -> 7
      is 5 -> 11
      is 6 -> 13
      is 7 -> 17
      is 8 -> 19
      is 9 -> 23
      is 10 -> 29
      is 11 -> 31
      is 12 -> 37
      is 13 -> 41
      is 14 -> 43
      is 15 -> 47
      is 16 -> 53
      is 17 -> 59
      is 18 -> 61
      is 19 -> 67
      is 20 -> 71
      is 21 -> 73
      is 22 -> 79
      is 23 -> 83
      is 24 -> 89
      is 25 -> 97
      is 26 -> 101
      is 27 -> 103
      is 28 -> 107
      is 29 -> 109
      is 30 -> 113
      is 31 -> 127
      is 32 -> 131
      is 33 -> 137
      is 34 -> 139
      is 35 -> 149
      is 36 -> 151
      is 37 -> 157
      is 38 -> 163
      is 39 -> 167
      is otherwise -> 0

  lsigned : Integer -> Integer
  lsigned (n) =
    when n
      is #FFFFFFFFFFFFFFFD -> 30
      is #FFFFFFFFFFFFFFFE -> 20
      is #FFFFFFFFFFFFFFFF -> 10
      is 0 -> 0
      is 1 -> 1
      is 3 -> 3
      is 1000 -> 7
      is k -> k * 100

  ldup : Integer -> Integer
  ldup (n) =
    when n
      is 9 -> 90
      is 4 -> 40
      is 5 -> 50
      is 4 -> 99
      is 6 -> 60
      is 7 -> 70
      is otherwise -> 1

  lsteps : Integer, Integer -> Integer
  lsteps (n) (acc) =
    when n
      is 0 -> acc
      is 1 -> lsteps 0 (acc + 1)
      is 2 -> lsteps 1 (acc + 20)
      is 3 -> lsteps 2 (acc + 300)
      is 4 -> lsteps 3 (acc + 5000)
      is otherwise -> lsteps (n - 5) (acc + 60000)

  row : (Integer -> Integer), Integer, Integer, Text -> Text
  row (f) (i) (stop) (acc) =
    if i > stop then acc
    else row f (i + 1) stop (acc & " " & show (f i))

  opening : [Console] Nothing = act
    print-line-uni ("dense" & row (dense "t") -3 9 "")
    print-line-uni ("signed" & row (signed "t") -6 6 "")
    print-line-uni ("dup" & row (dup "t") 2 9 "")
    print-line-uni ("sparse" & row (sparse "t") 0 2 "" & " " & show (sparse "t" 100) & " " & show (sparse "t" 10000) & " " & show (sparse "t" 1000000))
    print-line-uni ("nested" & row (nested "t" 0) -1 4 "" & row (nested "t" 1) -1 4 "" & row (nested "t" 2) 0 1 "" & row (nested "t" 7) 0 0 "")
    print-line-uni ("steps " & show (steps "t" 3 0) & " " & show (steps "t" 11 0) & " " & show (steps "t" 40000001 0))
    print-line-uni ("octet " & show (octet "t" 249) & " " & show (octet "t" 250) & " " & show (octet "t" 253) & " " & show (octet "t" 254) & " " & show (octet "t" 255) & " " & show (octet "t" 0))
    print-line-uni ("wide" & row wide -2 41 "")
    print-line-uni ("argpos " & show (7 + dense "t" 2 * 3 + signed "t" 9 - wide 39))
    print-line-uni ("lsigned" & row lsigned -6 6 "" & " " & show (lsigned 999) & " " & show (lsigned 1000) & " " & show (lsigned 1001))
    print-line-uni ("ldup" & row ldup 2 10 "")
    print-line-uni ("lsteps " & show (lsteps 4 0) & " " & show (lsteps 13 0) & " " & show (lsteps 50000004 0))
  end

