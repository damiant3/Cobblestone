Chapter: QemuVirtBoardTest

  cites Boards chapter QemuVirtBoard

 Exercise the QEMU virt board module: address constants and
 UART helper functions. MMIO stubs return 0 on the hosted VM,
 so this exercises the logic without real hardware.

Section: Definitions

  test-a64-uart-base : Integer
  test-a64-uart-base =
    if qemu-a64-pl011-base == #09000000 then 1 else 0

  test-rv-uart-base : Integer
  test-rv-uart-base =
    if qemu-rv-uart-base == #10000000 then 1 else 0

  test-a64-ram-base : Integer
  test-a64-ram-base =
    if qemu-a64-ram-base == #40000000 then 1 else 0

  test-rv-ram-base : Integer
  test-rv-ram-base =
    if qemu-rv-ram-base == #80000000 then 1 else 0

  test-a64-uart-putc : Integer
  test-a64-uart-putc =
    let w = qemu-a64-uart-putc 65
    in 1

  test-rv-uart-putc : Integer
  test-rv-uart-putc =
    let w = qemu-rv-uart-putc 65
    in 1

  opening : Integer =
    let a = test-a64-uart-base
    in let r = test-rv-uart-base
    in let ar = test-a64-ram-base
    in let rr = test-rv-ram-base
    in let ap = test-a64-uart-putc
    in let rp = test-rv-uart-putc
    in a + r + ar + rr + ap + rp

