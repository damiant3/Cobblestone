Chapter: QemuVirtBoardTest

  cites Boards chapter QemuVirtBoard

Section: Definitions

  test-a64-uart-base : Integer
  test-a64-uart-base =
    if qemu-a64-pl011-base == #09000000 then 1 else 0

  test-rv-uart-base : Integer
  test-rv-uart-base =
    if qemu-rv-uart-base == #10000000 then 1 else 0

  test-a64-ram-base : Integer
  test-a64-ram-base =
    if qemu-a64-ram-base == #40000000 then 1 else 0

  test-rv-ram-base : Integer
  test-rv-ram-base =
    if qemu-rv-ram-base == #80000000 then 1 else 0

  test-a64-uart-putc : [Device.Mmio] Integer
  test-a64-uart-putc = act
    w <- (qemu-a64-uart-putc 65)
    1
  end

  test-rv-uart-putc : [Device.Mmio] Integer
  test-rv-uart-putc = act
    w <- (qemu-rv-uart-putc 65)
    1
  end

  test-a64-uart-linear : [Uart, Device.Mmio] Integer
  test-a64-uart-linear = act
    p0 <- qemu-uart-open qemu-a64-pl011-dr
    p1 <- qemu-uart-write p0 72
    p2 <- (qemu-uart-write p1 73)
    c <- (qemu-uart-close p2)
    1
  end

  test-rv-uart-linear : [Uart, Device.Mmio] Integer
  test-rv-uart-linear = act
    p0 <- qemu-uart-open qemu-rv-uart-thr
    p1 <- qemu-uart-write p0 72
    p2 <- (qemu-uart-write p1 73)
    c <- (qemu-uart-close p2)
    1
  end

  opening : [Uart, Device.Mmio] Integer = act
    ap <- test-a64-uart-putc
    rp <- test-rv-uart-putc
    al <- test-a64-uart-linear
    rl <- test-rv-uart-linear
    test-a64-uart-base + test-rv-uart-base + test-a64-ram-base + test-rv-ram-base + ap + rp + al + rl
  end

