Chapter: Arm64EncoderTest
  cites Foreword chapter Arm64Encoder

Section: Helpers

  show-hex-word : Integer -> Text
  show-hex-word (w) =
    let b0 = bit-and w 255
    in let b1 = bit-and (bit-shru w 8) 255
    in let b2 = bit-and (bit-shru w 16) 255
    in let b3 = bit-and (bit-shru w 24) 255
    in hex-byte b3 & hex-byte b2 & hex-byte b1 & hex-byte b0

  hex-byte : Integer -> Text
  hex-byte (b) = hex-nib (b / 16) & hex-nib (bit-and b 15)

  hex-nib : Integer -> Text
  hex-nib (n) =
    when n
      is 0 -> "0"
      is 1 -> "1"
      is 2 -> "2"
      is 3 -> "3"
      is 4 -> "4"
      is 5 -> "5"
      is 6 -> "6"
      is 7 -> "7"
      is 8 -> "8"
      is 9 -> "9"
      is 10 -> "A"
      is 11 -> "B"
      is 12 -> "C"
      is 13 -> "D"
      is 14 -> "E"
      is 15 -> "F"
      is otherwise -> "?"

  show-insn : List Integer -> Text
  show-insn (bytes) =
    let w = list-at bytes 0 + list-at bytes 1 * 256 + list-at bytes 2 * 65536 + list-at bytes 3 * 16777216
    in show-hex-word w

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("add x0,x1,x2=" & show-insn (arm64-add 0 1 2))
    print-line-uni ("sub x3,x4,x5=" & show-insn (arm64-sub 3 4 5))
    print-line-uni ("mul x6,x7,x8=" & show-insn (arm64-mul 6 7 8))
    print-line-uni ("sdiv x9,x10,x11=" & show-insn (arm64-sdiv 9 10 11))
    print-line-uni ("and x0,x1,x2=" & show-insn (arm64-and 0 1 2))
    print-line-uni ("or x3,x4,x5=" & show-insn (arm64-or 3 4 5))
    print-line-uni ("xor x6,x7,x8=" & show-insn (arm64-xor 6 7 8))
    print-line-uni ("cmp x1,x2=" & show-insn (arm64-cmp 1 2))
    print-line-uni ("add-imm x0,x1,42=" & show-insn (arm64-add-imm 0 1 42))
    print-line-uni ("sub-imm x3,x4,100=" & show-insn (arm64-sub-imm 3 4 100))
    print-line-uni ("movz x5,1234,0=" & show-insn (arm64-movz 5 1234 0))
    print-line-uni ("movk x5,5678,16=" & show-insn (arm64-movk 5 5678 16))
    print-line-uni ("ldr x0,[x1,16]=" & show-insn (arm64-ldr 0 1 16))
    print-line-uni ("str x2,[x3,24]=" & show-insn (arm64-str 2 3 24))
    print-line-uni ("stp x29,x30,[sp,0]=" & show-insn (arm64-stp 29 30 31 0))
    print-line-uni ("ldp x29,x30,[sp,0]=" & show-insn (arm64-ldp 29 30 31 0))
    print-line-uni ("b +100=" & show-insn (arm64-b 100))
    print-line-uni ("bl +200=" & show-insn (arm64-bl 200))
    print-line-uni ("cbz x0,+40=" & show-insn (arm64-cbz 0 40))
    print-line-uni ("cbnz x1,+80=" & show-insn (arm64-cbnz 1 80))
    print-line-uni ("ret=" & show-insn arm64-ret)
    print-line-uni ("nop=" & show-insn arm64-nop)
    print-line-uni ("mov x0,x1=" & show-insn (arm64-mov 0 1))
    print-line-uni ("neg x2,x3=" & show-insn (arm64-neg 2 3))
    let li-result = arm64-li 9 #12345678
    in print-line-uni ("li x9,#12345678 len=" & show (list-length li-result / 4))
  end

