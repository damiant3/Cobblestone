Chapter: GpuSaveDevice

  cites Kernel chapter GpuBridge
  cites AI chapter GpuProxy

Section: Arms

 Win32 opens a reserved device name (NUL, COM1) in any directory, so a save
 named for one writes to the host device rather than under -gpu-out.

  refusal : Integer -> Text
  refusal (v) = if v < 0 then "refused" else "SERVED " & show v

  run-all : Integer -> List Text
  run-all (z) =
    let h = gpu-buf-alloc 64
    in let l1 = "save to NUL: " & refusal (gpu-buf-save h 0 16 "NUL")
    in let l2 = "save to nested/nul: " & refusal (gpu-buf-save h 0 16 "nested/nul")
    in let l3 = "save to COM1: " & refusal (gpu-buf-save h 0 16 "COM1")
    in let l4 = "free: " & (if gpu-buf-free h then "ok" else "refused")
    in [l1, l2, l3, l4]

  print-all : List Text, Integer -> [Console] Nothing
  print-all (ls) (i) =
    if i >= list-length ls then act
      print-uni ""
    end
    else act
      print-line-uni (list-at ls i)
      print-all ls (i + 1)
    end

  opening : [Console] Integer
  opening = act
    print-all (run-all 0) 0
    let r = 0 in r
  end
