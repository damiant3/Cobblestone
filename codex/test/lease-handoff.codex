Chapter: LeaseHandoffTest
  cites Trust chapter LeaseManager
  cites Trust chapter AgentProtocol
  cites Foreword chapter Maybe

Section: Identities

  alice : AgentIdentity
  alice = AgentIdentity { public-key = [1, 1, 1] }

  mallory : AgentIdentity
  mallory = AgentIdentity { public-key = [9, 9, 9] }

  bob : AgentIdentity
  bob = AgentIdentity { public-key = [2, 2, 2] }

Section: What Alice Holds

  alice-cap : Capability
  alice-cap = Capability { name = "Files", direction = 0, scope = "/config/" }

  alice-scope : Scope
  alice-scope = Scope { direction = 0, path = "/config/", duration = 400 }

  alice-grant : GrantMsg
  alice-grant = GrantMsg { id = [1], proposal = [], from = alice, capability = alice-cap, scope = alice-scope, expires = 500, conditions = [], signature = [] }

  seeded : LeaseStore
  seeded = lease-grant lease-store-empty alice-grant 100

Section: Probes

  handoff-of : AgentIdentity, Capability, Scope, Integer -> HandoffMsg
  handoff-of (who) (cap) (sc) (expires) =
    HandoffMsg { id = [7], from = who, to = bob, capability = cap, scope = sc, expires = expires, revoke-from = False, audit-required = False, signature = [] }

  probe-no-lease : HandoffMsg
  probe-no-lease = handoff-of mallory alice-cap alice-scope 400

  probe-widen-dir : HandoffMsg
  probe-widen-dir = handoff-of alice (Capability { name = "Files", direction = 1, scope = "/config/" }) alice-scope 400

  probe-widen-scope : HandoffMsg
  probe-widen-scope = handoff-of alice (Capability { name = "Files", direction = 0, scope = "" }) alice-scope 400

  probe-widen-path : HandoffMsg
  probe-widen-path = handoff-of alice alice-cap (Scope { direction = 0, path = "/", duration = 400 }) 400

  probe-outlive : HandoffMsg
  probe-outlive = handoff-of alice alice-cap alice-scope 9000

  probe-legit : HandoffMsg
  probe-legit = handoff-of alice alice-cap alice-scope 400

Section: Reporting

  verdict : HandoffDecision -> Text
  verdict (d) =
    when d
      is HandoffAccepted (s) -> "accepted count=" & show (lease-count s)
      is HandoffRefused (why) -> "refused: " & why

  try-handoff : HandoffMsg -> Text
  try-handoff (h) = verdict (lease-handoff seeded h 200)

Section: Body

  opening : [Console] Nothing =
    act
      print-line-uni (try-handoff probe-no-lease)
      print-line-uni (try-handoff probe-widen-dir)
      print-line-uni (try-handoff probe-widen-scope)
      print-line-uni (try-handoff probe-widen-path)
      print-line-uni (try-handoff probe-outlive)
      print-line-uni (try-handoff probe-legit)
    end
