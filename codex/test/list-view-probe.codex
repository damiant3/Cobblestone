Chapter: ListViewProbe
  cites Foreword chapter Console

 Probes every list-memory reader against a tail view. The views come
 from the __list-tail intrinsic; each report line pins one patched
 path: the inline list-at, the head read, cons, both append operands,
 snoc's copy path, insert-at's copy path, set-at's write-through (and
 the aliasing it implies for the backing and every sibling view),
 text-concat-list, unicode-bytes-to-text, the empty-tail clamp, tail
 of tail, and a structural head/tail recursion deep enough to prove
 the tail is O(1) allocation rather than a copy per step.

Section: Helpers

  build-range : Integer, Integer, List Integer -> List Integer
  build-range (i) (n) (acc) =
   if i > n then acc
   else build-range (i + 1) n (list-push acc i)

  sum-structural : List Integer -> Integer
  sum-structural (xs) =
   if __list-len xs == 0 then 0
   else __list-head xs + sum-structural (__list-tail xs)

  report : Text
  report =
   let xs = [10, 20, 30, 40]
   in let t = __list-tail xs
   in let t2 = __list-tail t
   in let consed = 5 :: t
   in let appended = t & [7]
   in let appended2 = [7] & t
   in let pushed = list-push t 9
   in let ins = list-insert-at t 1 99
   in let wrote = list-set-at t2 0 77
   in let tt = __list-tail ["a", "bc", "d"]
   in let e = __list-tail []
   in let deep = __list-tail (__list-tail (__list-tail [1, 2, 3]))
   in text-concat-list [
    "len=" & show (list-length t) & "\n",
    "head=" & show (__list-head t) & "\n",
    "at0=" & show (list-at t 0) & "\n",
    "at2=" & show (list-at t 2) & "\n",
    "t2at1=" & show (list-at t2 1) & "\n",
    "cons=" & show (list-at consed 0) & "," & show (list-at consed 1) & "," & show (list-length consed) & "\n",
    "app=" & show (list-at appended 3) & "," & show (list-length appended) & "\n",
    "app2=" & show (list-at appended2 1) & "," & show (list-length appended2) & "\n",
    "push=" & show (list-at pushed 3) & "," & show (list-length pushed) & "," & show (list-length xs) & "\n",
    "ins=" & show (list-at ins 1) & "," & show (list-at ins 2) & "," & show (list-length ins) & "\n",
    "set=" & show (list-at wrote 0) & "," & show (list-at xs 2) & "," & show (list-at t 1) & "\n",
    "cat=" & text-concat-list tt & "\n",
    "uni=" & unicode-bytes-to-text (__list-tail [72, 104, 105]) & "\n",
    "empty=" & show (list-length e) & "\n",
    "deep=" & show (list-length deep) & "\n",
    "sum=" & show (sum-structural (build-range 1 200 []))]

Section: Body

  opening : [Console] Nothing = act
    print-line-uni report
  end
