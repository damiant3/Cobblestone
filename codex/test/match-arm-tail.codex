Chapter: MatchArmTail

  cites Foreword chapter Console
  cites Foreword chapter Result

Section: Body

  step : Integer -> [Console] Result Integer Text
  step (n) = if n < 0 then Err "neg" else Ok n

  act-err-first : Integer -> [Console] Integer
  act-err-first (n) = if n == 0 then 7 else act
    x <- step n
    when x
     is Err (e) -> 0 - 1
     is Ok (_) -> act-err-first (n - 1)
  end

  act-ok-first : Integer -> [Console] Integer
  act-ok-first (n) = if n == 0 then 8 else act
    x <- step n
    when x
     is Ok (_) -> act-ok-first (n - 1)
     is Err (e) -> 0 - 1
  end

  plain-err-first : Integer -> [Console] Integer
  plain-err-first (n) = if n == 0 then 9 else
    when step n
     is Err (e) -> 0 - 1
     is Ok (_) -> plain-err-first (n - 1)

  opening : [Console] Nothing = act
    print-line-uni ("act-err-first " & show (act-err-first 10000000))
    print-line-uni ("act-ok-first " & show (act-ok-first 10000000))
    print-line-uni ("plain-err-first " & show (plain-err-first 10000000))
  end
