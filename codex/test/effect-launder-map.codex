Chapter: EffectLaunderMap
  cites Foreword chapter Console
  cites Foreword chapter ListUtils

Section: Definitions

  shout : Integer -> [Console] Integer
  shout (n) = act
    print-line-uni ("shout " & show n)
    n * 2
  end

  launder : List Integer -> List Integer
  launder (xs) = list-map shout xs

  opening : [Console] Nothing = act
    print-line-uni ("len " & show (list-length (launder [1, 2, 3])))
  end
