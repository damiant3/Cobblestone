Chapter: GenericEq

  cites Foreword chapter Console
  cites Foreword chapter Maybe

Section: Types

  Point = record {
    px : Integer,
    py : Text
  }

  Shade = | Red | Tint (Integer)

  Tree a = | Leaf | Node (Tree a) (a) (Tree a)

  Tagged a = | Tag (a) (Integer)

Section: Generic

  same : Eq a => a, a -> Boolean
  same (x) (y) = x == y

  differ : Eq a => a, a -> Boolean
  differ (x) (y) = x /= y

  both-ways : Eq a => a, a -> Boolean
  both-ways (x) (y) = same x y & same y x

  count : Eq a => List a, a -> Integer
  count (xs) (y) = count-from xs y 0 0

  count-from : Eq a => List a, a, Integer, Integer -> Integer
  count-from (xs) (y) (i) (acc) =
   if i >= list-length xs then acc
   else count-from xs y (i + 1) (if list-at xs i == y then acc + 1 else acc)

  same-list : Eq a => List a, List a -> Boolean
  same-list (xs) (ys) = xs == ys

  same-maybe : Eq a => Maybe a, Maybe a -> Boolean
  same-maybe (x) (y) = x == y

  wrap-same : Eq a => a, a -> Boolean
  wrap-same (x) (y) = same (Just x) (Just y)

  same-tree : Eq a => Tree a, Tree a -> Boolean
  same-tree (x) (y) = x == y

  same-tagged : Eq a => Tagged a, Tagged a -> Boolean
  same-tagged (x) (y) = if x /= y then False else True

  same-nested : Eq a => List (List a), List (List a) -> Boolean
  same-nested (xs) (ys) = xs == ys

Section: Oracles

  count-int : List Integer, Integer, Integer, Integer -> Integer
  count-int (xs) (y) (i) (acc) =
   if i >= list-length xs then acc
   else count-int xs y (i + 1) (if list-at xs i == y then acc + 1 else acc)

  glue : Text -> Text
  glue (s) = s & "b"

  yn : Boolean -> Text
  yn (b) = if b then "yes" else "no"

  row : Text, Boolean, Boolean -> Text
  row (label) (generic) (direct) = label & yn generic & " direct " & yn direct

Section: Body

  opening : [Console] Nothing = act
    print-line-uni (row "integer eq  " (same 7 (3 + 4)) (7 == 3 + 4))
    print-line-uni (row "integer ne  " (same 7 8) (7 == 8))
    print-line-uni (row "text eq     " (same (glue "a") (glue "a")) (glue "a" == glue "a"))
    print-line-uni (row "text ne     " (same (glue "a") (glue "c")) (glue "a" == glue "c"))
    print-line-uni (row "list eq     " (same [1, 2, 3] [1, 2, 1 + 2]) ([1, 2, 3] == [1, 2, 1 + 2]))
    print-line-uni (row "list ne     " (same [1, 2, 3] [1, 2]) ([1, 2, 3] == [1, 2]))
    print-line-uni (row "record eq   " (same (Point { px = 1, py = glue "a" }) (Point { px = 1, py = glue "a" })) (Point { px = 1, py = glue "a" } == Point { px = 1, py = glue "a" }))
    print-line-uni (row "record ne   " (same (Point { px = 1, py = glue "a" }) (Point { px = 2, py = glue "a" })) (Point { px = 1, py = glue "a" } == Point { px = 2, py = glue "a" }))
    print-line-uni (row "sum eq      " (same (Tint 3) (Tint (1 + 2))) (Tint 3 == Tint (1 + 2)))
    print-line-uni (row "sum ne      " (same Red (Tint 0)) (Red == Tint 0))
    print-line-uni (row "maybe eq    " (same (Just (glue "a")) (Just (glue "a"))) (Just (glue "a") == Just (glue "a")))
    print-line-uni (row "maybe ne    " (same (Just (glue "a")) None) (Just (glue "a") == None))
    print-line-uni (row "differ eq   " (differ (glue "a") (glue "a")) (glue "a" /= glue "a"))
    print-line-uni (row "differ ne   " (differ [4] [5]) ([4] /= [5]))
    print-line-uni (row "passed on   " (both-ways (glue "a") (glue "a")) (glue "a" == glue "a"))
    print-line-uni (row "passed ne   " (both-ways 4 5) (4 == 5))
    print-line-uni ("count int   " & integer-to-text (count [1, 2, 1, 3, 1] 1) & " direct " & integer-to-text (count-int [1, 2, 1, 3, 1] 1 0 0))
    print-line-uni ("count text  " & integer-to-text (count ["ab", glue "a", "b"] (glue "a")) & " direct 2")
    print-line-uni (row "eqd list eq " (same-list [glue "a", "x"] [glue "a", "x"]) ([glue "a", "x"] == [glue "a", "x"]))
    print-line-uni (row "eqd list ne " (same-list [glue "a"] [glue "c"]) ([glue "a"] == [glue "c"]))
    print-line-uni (row "eqd maybe eq " (same-maybe (Just (glue "a")) (Just (glue "a"))) (Just (glue "a") == Just (glue "a")))
    print-line-uni (row "eqd maybe ne " (same-maybe (Just (glue "a")) None) (Just (glue "a") == None))
    print-line-uni (row "via same eq " (wrap-same (glue "a") (glue "a")) (Just (glue "a") == Just (glue "a")))
    print-line-uni (row "via same ne " (wrap-same (glue "a") (glue "c")) (Just (glue "a") == Just (glue "c")))
    print-line-uni (row "tree eq     " (same-tree (Node Leaf (glue "a") (Node Leaf "q" Leaf)) (Node Leaf (glue "a") (Node Leaf "q" Leaf))) (Node Leaf (glue "a") (Node Leaf "q" Leaf) == Node Leaf (glue "a") (Node Leaf "q" Leaf)))
    print-line-uni (row "tree ne     " (same-tree (Node Leaf (glue "a") Leaf) (Node Leaf (glue "a") (Node Leaf "q" Leaf))) (Node Leaf (glue "a") Leaf == Node Leaf (glue "a") (Node Leaf "q" Leaf)))
    print-line-uni (row "tagged eq   " (same-tagged (Tag (glue "a") 3) (Tag (glue "a") 3)) (Tag (glue "a") 3 == Tag (glue "a") 3))
    print-line-uni (row "tagged ne   " (same-tagged (Tag (glue "a") 3) (Tag (glue "a") 4)) (Tag (glue "a") 3 == Tag (glue "a") 4))
    print-line-uni (row "nested eq   " (same-nested [[glue "a"], []] [[glue "a"], []]) ([[glue "a"], []] == [[glue "a"], []]))
    print-line-uni (row "nested ne   " (same-nested [[glue "a"]] [[glue "c"]]) ([[glue "a"]] == [[glue "c"]]))
  end

