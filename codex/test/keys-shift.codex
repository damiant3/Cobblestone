Chapter: KeysShift

  cites UI chapter KeyInput

 The `.keys` timeline types, in order: LShift down (make 42), `a` (make
 30), LShift up (break 170), `a` again, LShift down, `1` (make 2), LShift
 up, then Enter (make 28) to stop. The break code is the make code with bit
 7 set -- 42 | 0x80 = 170 -- and `uefi-read-key` preserves it, which is the
 whole reason release is observable at all.

Section: Definitions

  ksh-collect : List Integer -> List Integer
  ksh-collect (acc) =
    let ch = poll-key
    in if ch == 0 then ksh-collect acc
    else if ch == key-enter then acc
    else ksh-collect (list-push acc ch)

  ksh-show : List Integer, Integer, Integer -> [Console] Integer
  ksh-show (xs) (i) (len) =
    if i >= len then 0
    else act
      print-line-uni (integer-to-text (list-at xs i))
      ksh-show xs (i + 1) len
    end

  opening : [Console] Nothing = act
    let ks = ksh-collect []
    in act
      ksh-show ks 0 (list-length ks)
      print-line-uni "shifted"
    end
  end
