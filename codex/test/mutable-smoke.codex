Chapter: MutableSmoke
  cites Codex chapter General
  cites Foreword chapter Console

 Combined mutable record tests: def-seq (multi-statement body),
 fn-field (function-typed field + mutation), seq (let-chain assigns),
 thread (single-owner read + pass).

Section: Types

  mutable Box = record {
    n : Integer,
    m : Integer
  }

  mutable Thunk = record {
   forced : Integer,
   cached : Integer,
   compute : Integer -> Integer
  }

Section: Helpers

  double : Integer -> Integer
  double (x) = x * 2

  triple : Integer -> Integer
  triple (x) = x * 3

  force : Thunk -> Integer
  force (t) =
   if t.forced == 1 then t.cached
   else t.compute (t.cached)

  bump-both : mutable Box -> mutable Box
  bump-both (b) =
    b.n = b.n + 1
    b.m = b.m + 10
    b

  show-box : mutable Box -> Text
  show-box (b) = "n=" & show (b.n) & " m=" & show (b.m)

  tally : mutable Box -> Text
  tally (b) =
    let x = b
    in x.n = x.n + 5
    in x.m = x.m + x.n
    in "n=" & show (x.n) & " m=" & show (x.m)

  mutable SmallBox = record { n : Integer }

  step : SmallBox -> SmallBox
  step (b) = b

  run-thread : SmallBox -> Integer
  run-thread (b) = b.n + (step b).n

Section: Body

  opening : [Console] Nothing = act
    print-line-uni (show-box (bump-both (Box { n = 0, m = 0 })))
    let t = Thunk { forced = 0, cached = 5, compute = double }
    in act
      print-line-uni ("force: " & show (force t))
      t.forced = 1
      t.cached = 10
      print-line-uni ("cached: " & show (force t))
      t.compute = triple
      t.forced = 0
      print-line-uni ("recompute: " & show (force t))
    end
    print-line-uni (tally (Box { n = 0, m = 1 }))
    print-line-uni (show (run-thread (SmallBox { n = 7 })))
  end

