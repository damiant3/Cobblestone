Chapter: NestedSpawn

Section: Body
  grandchild-body : Integer -> Integer
  grandchild-body (x) = poke-byte 28000 0 7

  child-body : Integer -> [Concurrent] Integer
  child-body (x) = process-wait (process-spawn (\y -> grandchild-body y))

  finish : Integer -> Text
  finish (pid) =
    let wt = process-wait pid
    in "val: " & show (peek-byte 28000 0)

  run-nested : Integer -> [Concurrent] Text
  run-nested (x) = finish (process-spawn (\y -> child-body y))

  opening : [Console, Concurrent] Nothing = act
    print-line-uni (run-nested 0)
  end
