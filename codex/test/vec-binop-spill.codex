Chapter: Vec Binop Spill
  cites Foreword chapter Console

Section: Body

  opening : [Console] Nothing =
    let a = vec-splat 1.5
    in let b = vec-splat 2.25
    in let k1 = 1 * 3
    in let k2 = 2 * 3
    in let k3 = 3 * 3
    in let k4 = 4 * 3
    in let k5 = 5 * 3
    in let k6 = 6 * 3
    in let k7 = 7 * 3
    in let k8 = 8 * 3
    in let k9 = 9 * 3
    in let k10 = 10 * 3
    in let k11 = 11 * 3
    in let k12 = 12 * 3
    in let k13 = 13 * 3
    in let k14 = 14 * 3
    in let k15 = 15 * 3
    in let k16 = 16 * 3
    in let k17 = 17 * 3
    in let k18 = 18 * 3
    in let c = vec-add a b
    in let d = vec-sub c a
    in act
      print-line-uni ("c " & show (vec-extract c 0) & " " & show (vec-extract c 1))
      print-line-uni ("d " & show (vec-extract d 0) & " " & show (vec-extract d 1))
      print-line-uni ("k " & show (k1 + k2 + k3 + k4 + k5 + k6 + k7 + k8 + k9 + k10 + k11 + k12 + k13 + k14 + k15 + k16 + k17 + k18))
    end
