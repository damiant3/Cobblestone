Chapter: UiSurfaceTest
  cites Codex chapter General
  cites UI chapter Theme
  cites UI chapter BoxModel
  cites UI chapter Widget
  cites UI chapter Render
  cites UI chapter Surface
  cites Game chapter Rasterizer
  cites Game chapter Color
  cites Game chapter Bresenham
  cites Math chapter Geometry
  cites Math chapter Quaternion

Section: Body

  test-compositor-new : Text =
    let comp = compositor-new 320 240 0
    in format-compositor comp

  test-add-surface : Text =
    let comp = compositor-new 320 240 0
    in let sf = surface-new "win1" 10 10 100 80 1052688
    in let comp2 = compositor-add comp sf
    in "count=" & show (comp2.comp-count)

  test-find-surface : Text =
    let comp = compositor-new 320 240 0
    in let sf = surface-new "panel" 0 0 50 50 0
    in let comp2 = compositor-add comp sf
    in let found = compositor-find comp2 "panel"
    in when found
      is Just (s) -> "found=" & s.sf-id
      is None -> "not-found"

  test-compositor-render : Text =
    let comp = compositor-new 16 8 0
    in let sf = surface-new "fg" 2 2 4 4 16711680
    in let comp2 = compositor-add comp sf
    in let fb = compositor-render comp2
    in let bg-pixel = fb-get fb 0 0
    in let fg-pixel = fb-get fb 3 3
    in "bg=" & show bg-pixel & " fg=" & show fg-pixel

  test-z-order : Text =
    let comp = compositor-new 16 8 0
    in let sf1 = surface-new-z "back" 0 0 5 16 8 255
    in let sf2 = surface-new-z "front" 0 0 10 16 8 16711680
    in let comp2 = compositor-add (compositor-add comp sf1) sf2
    in let fb = compositor-render comp2
    in let pixel = fb-get fb 4 4
    in "top=" & show pixel

  test-toggle : Text =
    let comp = compositor-new 16 8 0
    in let sf = surface-new "win" 0 0 16 8 65280
    in let comp2 = compositor-add comp sf
    in let comp3 = compositor-toggle comp2 "win"
    in let fb = compositor-render comp3
    in let pixel = fb-get fb 4 4
    in "hidden=" & show pixel

  test-move : Text =
    let comp = compositor-new 16 8 0
    in let sf = surface-new "win" 0 0 4 4 999
    in let comp2 = compositor-add comp sf
    in let comp3 = compositor-move comp2 "win" 8 4
    in let found = compositor-find comp3 "win"
    in when found
      is Just (s) -> "x=" & show (s.sf-x) & " y=" & show (s.sf-y)
      is None -> "not-found"

  test-remove : Text =
    let comp = compositor-new 320 240 0
    in let sf1 = surface-new "a" 0 0 10 10 0
    in let sf2 = surface-new "b" 0 0 10 10 0
    in let comp2 = compositor-add (compositor-add comp sf1) sf2
    in let comp3 = compositor-remove comp2 "a"
    in "count=" & show (comp3.comp-count)

  test-hit : Text =
    let comp = compositor-new 320 240 0
    in let sf = surface-new "clickable" 50 50 100 80 0
    in let comp2 = compositor-add comp sf
    in let hit = compositor-hit comp2 75 75
    in let miss = compositor-hit comp2 0 0
    in let h = when hit is Just (s) -> s.sf-id is None -> "none"
    in let m = when miss is Just (s) -> s.sf-id is None -> "none"
    in "hit=" & h & " miss=" & m

  opening : [Console] Nothing = act
    print-line-uni test-compositor-new
    print-line-uni test-add-surface
    print-line-uni test-find-surface
    print-line-uni test-compositor-render
    print-line-uni test-z-order
    print-line-uni test-toggle
    print-line-uni test-move
    print-line-uni test-remove
    print-line-uni test-hit
  end

