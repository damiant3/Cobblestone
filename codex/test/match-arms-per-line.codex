Chapter: MatchArmsPerLine
  cites Foreword chapter Console

Section: Arms

  one-line : Integer -> Text
  one-line (n) =
    when n
      is 1 -> "one" is 2 -> "two" is 3 -> "three"
      is otherwise -> "other"

  many-per-line : Integer -> Text
  many-per-line (n) =
    when n
      is 1 -> "one" is 2 -> "two"
      is 3 -> "three" is 4 -> "four"
      is 5 -> "five" is 6 -> "six"
      is otherwise -> "other"

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("one-line: " & one-line 1 & one-line 2 & one-line 3 & one-line 9)
    print-line-uni ("many-1: " & many-per-line 1)
    print-line-uni ("many-2: " & many-per-line 2)
    print-line-uni ("many-3: " & many-per-line 3)
    print-line-uni ("many-4: " & many-per-line 4)
    print-line-uni ("many-5: " & many-per-line 5)
    print-line-uni ("many-6: " & many-per-line 6)
    print-line-uni ("many-9: " & many-per-line 9)
  end
