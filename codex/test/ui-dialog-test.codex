Chapter: UiDialogTest
  cites Codex chapter General
  cites UI chapter Theme
  cites UI chapter BoxModel
  cites UI chapter Layout
  cites UI chapter Widget
  cites UI chapter Surface
  cites UI chapter Overlay
  cites UI chapter Dialog

Section: Body

  test-alert : Text =
    let cfg = dialog-config "Error" "Something went wrong" 300 150
    in let ov = dialog-alert cfg
    in "kind=" & overlay-kind-name (ov.ov-kind) & " modal=" & dlg-bool (ov.ov-modal)

  test-confirm : Text =
    let cfg = dialog-config-centered "Confirm" "Are you sure?" 280 120 800 600
    in let ov = dialog-confirm cfg
    in "x=" & show (ov.ov-x) & " y=" & show (ov.ov-y)

  test-prompt : Text =
    let cfg = dialog-config "Input" "Enter name:" 300 180
    in let ov = dialog-prompt cfg "type here"
    in let body = ov.ov-widget
    in "children=" & show (body.wn-child-count)

  test-custom : Text =
    let content = widget-panel "custom" DirColumn 4 [widget-label "l" "Custom dialog"]
    in let ov = dialog-custom "my-dlg" 100 100 200 150 content
    in "id=" & ov.ov-id & " modal=" & dlg-bool (ov.ov-modal)

  test-result-names : Text =
    let ok = dialog-result-name DlgOk
    in let cancel = dialog-result-name DlgCancel
    in let pending = dialog-result-name DlgPending
    in ok & " " & cancel & " " & pending

  dlg-bool : Boolean -> Text
  dlg-bool (b) = if b then "true" else "false"

  opening : [Console] Nothing = act
    print-line-uni test-alert
    print-line-uni test-confirm
    print-line-uni test-prompt
    print-line-uni test-custom
    print-line-uni test-result-names
  end

