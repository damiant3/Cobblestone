Chapter: Param Shadows Def

Section: Body

  inc : Integer -> Integer
  inc (x) = x + 1

  add : Integer, Integer -> Integer
  add (a) (b) = a + b

  shadow : (Integer -> Integer), Integer -> Integer
  shadow (inc) (x) = inc x

  shadow-plus : (Integer -> Integer), Integer -> Integer
  shadow-plus (inc) (x) = 1 + inc x

  opening : [Console] Nothing = act
   print-line-uni (show (shadow (add 5) 2))
   print-line-uni (show (shadow-plus (add 5) 2))
   print-line-uni (show (inc 2))
  end
