Chapter: DefaultAppsTest
  cites Dev chapter DefaultApps

Section: Entry
  opening : [Console] Nothing = act
    st <- default-apps-new
    print-line-uni ("roles browser=" & da-get-role-app st RoleBrowser & " editor=" & da-get-role-app st RoleEditor)
    vim <- da-set-role st RoleEditor "vim" "Vim"
    print-line-uni ("set editor=" & da-get-role-app vim RoleEditor & " mail=" & da-get-role-app vim RoleMail & " calculator=" & da-get-role-app vim RoleCalculator)
    print-line-uni ("ext .png=" & da-lookup-ext vim ".png" & " .PNG=[" & da-lookup-ext vim ".PNG" & "] .exe=[" & da-lookup-ext vim ".exe" & "]")
    md <- da-set-assoc vim ".md" "md-viewer"
    print-line-uni ("set .md=" & da-lookup-ext md ".md" & " .txt=" & da-lookup-ext md ".txt" & " .html=" & da-lookup-ext md ".html")
    print-line-uni ("proto https=" & da-lookup-protocol md "https" & " mailto=" & da-lookup-protocol md "mailto" & " gopher=[" & da-lookup-protocol md "gopher" & "]")
  end
