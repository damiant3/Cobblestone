Chapter: ActLetScope
  cites Foreword chapter Console

Section: Definitions

  bump : Integer -> Integer
  bump (n) = n + 1

  arm-local : Integer -> Integer
  arm-local (n) =
   let v = n
   in let w = if n > 0 then let v = n * 10 in v + 1 else v
   in w + v

Section: Entry

  opening : [Console] Nothing = act
   let a = bump 1
   in print-line-uni ("a: " & integer-to-text a)
   print-line-uni ("a-after: " & integer-to-text a)

   let b = bump a
   in let c = bump b
   in let d = bump c
   in print-line-uni ("chain-in-body: " & integer-to-text d)
   print-line-uni ("chain-b: " & integer-to-text b)
   print-line-uni ("chain-c: " & integer-to-text c)
   print-line-uni ("chain-d: " & integer-to-text d)
   print-line-uni ("chain-sum: " & integer-to-text (a + b + c + d))

   let a = 100
   in print-line-uni ("shadowed: " & integer-to-text a)
   print-line-uni ("shadowed-after: " & integer-to-text a)

   print-line-uni ("arm-local: " & integer-to-text (arm-local 2))
  end
