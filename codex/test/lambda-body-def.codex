Chapter: LambdaBodyDef

  cites Foreword chapter Console

Section: Definitions

  make-adder : Integer, Integer -> Integer
  make-adder (x) (y) = x + y

  make-adder-lambda : Integer -> Integer -> Integer
  make-adder-lambda (x) = \y -> x + y

  helper : Integer
  helper = 5

  opening : [Console] Nothing = act
    let r = (make-adder-lambda 10) 3
    in let h = helper + r
    in print-line-uni (integer-to-text h)
  end
