Chapter: MathLib
  cites Foreword chapter Console

Section: Definitions

  square : Integer -> Integer
  square (x) = x * x

  cube : Integer -> Integer
  cube (x) = x * x * x

  helper : Integer -> Integer
  helper (x) = x + 1

Section: Entry Point
  opening : [Console] Nothing = act
    print-line-uni (show (square 7))
    print-line-uni (show (cube 3))
    print-line-uni (show (helper 99))
  end

