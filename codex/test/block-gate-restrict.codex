Chapter: BlockGateRestrict
  cites Foreword chapter VirtioBlk

Section: Entry

  opening : [Console, Capability, Device.Block] Nothing
  opening = act
    print-line-uni ("count-before " & show block-sector-count)
    dropped <- process-restrict-cap (process-get-pid) 10
    print-line-uni ("restrict " & show dropped)
    print-line-uni ("count-after " & show block-sector-count)
  end
