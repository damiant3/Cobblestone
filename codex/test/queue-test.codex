Chapter: Queue Test

  cites Foreword chapter Console
  cites Foreword chapter Queue
  cites Foreword chapter Maybe

Section: Definitions

  show-dequeue : Maybe (DequeueResult Integer) -> Text
  show-dequeue (r) = when r
    is Just (dr) -> show (dr.value)
    is None -> "empty"

  test-queue : Text =
    let q0 = queue-empty
    in let q1 = queue-enqueue (queue-enqueue (queue-enqueue q0 10) 20) 30
    in show (queue-is-empty q0) & "\n" & show (queue-size q1)

  opening : [Console] Nothing = act
    print-line test-queue
  end

