Chapter: Pi4Drivers

  cites Boards chapter Pi4Board

 Smoke test for Raspberry Pi 4 board drivers. MMIO stubs return 0
 on the hosted VM, so this exercises the driver logic and bit
 manipulation without real hardware.

Section: Definitions

  test-gpio : Integer
  test-gpio =
    let a = pi4-gpio-set-output 21
    in let b = pi4-gpio-set 21
    in let c = pi4-gpio-clear 21
    in let d = pi4-gpio-set-input 4
    in let e = pi4-gpio-read 4
    in let f = pi4-gpio-toggle 21
    in let g = pi4-gpio-set-alternate 14 0
    in let h = pi4-gpio-set-pull 4 1
    in 1

  test-led : Integer
  test-led =
    let a = pi4-led-init
    in let b = pi4-led-on
    in let c = pi4-led-off
    in 1

  test-uart : Integer
  test-uart =
    let a = pi4-uart-init 115200
    in let b = pi4-uart-send-byte 65
    in let c = pi4-uart-print "hello"
    in let d = pi4-uart-println "world"
    in 1

  test-spi : Integer
  test-spi =
    let a = pi4-spi-init
    in let b = pi4-spi-transfer #55
    in 1

  test-i2c : Integer
  test-i2c =
    let a = pi4-i2c-init
    in let b = pi4-i2c-write-reg #68 #6B 0
    in let c = pi4-i2c-read-reg #68 #75
    in 1

  test-delay : Integer
  test-delay =
    let a = pi4-delay-ms 1
    in 1

  opening : Integer =
    let g = test-gpio
    in let l = test-led
    in let u = test-uart
    in let s = test-spi
    in let i = test-i2c
    in let d = test-delay
    in g + l + u + s + i + d

