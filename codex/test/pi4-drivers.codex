Chapter: Pi4Drivers

  cites Boards chapter Pi4Board

Section: Definitions

  test-gpio : [Device.Mmio] Integer
  test-gpio = act
    a <- pi4-gpio-set-output 21
    b <- pi4-gpio-set 21
    c <- pi4-gpio-clear 21
    d <- pi4-gpio-set-input 4
    e <- pi4-gpio-read 4
    f <- pi4-gpio-toggle 21
    g <- pi4-gpio-set-alternate 14 0
    h <- (pi4-gpio-set-pull 4 1)
    1
  end

  test-led : [Device.Mmio] Integer
  test-led = act
    a <- pi4-led-init
    b <- pi4-led-on
    c <- pi4-led-off
    1
  end

  test-uart : [Device.Mmio] Integer
  test-uart = act
    a <- pi4-uart-init 115200
    b <- pi4-uart-send-byte 65
    c <- pi4-uart-print "hello"
    d <- (pi4-uart-println "world")
    1
  end

  test-spi : [Device.Mmio] Integer
  test-spi = act
    a <- pi4-spi-init
    b <- (pi4-spi-transfer #55)
    1
  end

  test-i2c : [Device.Mmio] Integer
  test-i2c = act
    a <- pi4-i2c-init
    b <- pi4-i2c-write-reg #68 #6B 0
    c <- (pi4-i2c-read-reg #68 #75)
    1
  end

  test-delay : Integer
  test-delay =
    let a = pi4-delay-ms 1
    in 1

  opening : [Device.Mmio] Integer = act
    g <- test-gpio
    l <- test-led
    u <- test-uart
    s <- test-spi
    i <- test-i2c
    g + l + u + s + i + test-delay
  end

