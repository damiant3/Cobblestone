Chapter: Pi4Drivers

  cites Boards chapter Pi4Board

Section: Definitions

  test-gpio : [Device.Mmio] Integer
  test-gpio = act
    a <- pi4-gpio-set-output 21
    b <- pi4-gpio-set 21
    c <- pi4-gpio-clear 21
    d <- pi4-gpio-set-input 4
    e <- pi4-gpio-read 4
    f <- pi4-gpio-toggle 21
    g <- pi4-gpio-set-alternate 14 0
    h <- (pi4-gpio-set-pull 4 1)
    1
  end

  test-led : [Device.Mmio] Integer
  test-led = act
    a <- pi4-led-init
    b <- pi4-led-on
    c <- pi4-led-off
    1
  end

  test-uart : [Device.Mmio] Integer
  test-uart = act
    a <- pi4-uart-init 115200
    b <- pi4-uart-send-byte 65
    c <- pi4-uart-print "hello"
    d <- (pi4-uart-println "world")
    1
  end

  test-spi : [Device.Mmio] Integer
  test-spi = act
    a <- pi4-spi-init
    b <- (pi4-spi-transfer #55)
    1
  end

  test-i2c : [Device.Mmio] Integer
  test-i2c = act
    a <- pi4-i2c-init
    b <- pi4-i2c-write-reg #68 #6B 0
    c <- (pi4-i2c-read-reg #68 #75)
    1
  end

  test-uart-linear : [Uart, Device.Mmio] Integer
  test-uart-linear = act
    brd0 <- board-open 0 0
    o <- pi4-uart-open brd0 115200
    when o
     is (brd1, p0) -> act
       p1 <- pi4-uart-write p0 72
       p2 <- (pi4-uart-write p1 73)
       c <- (pi4-uart-close p2)
       bc <- (board-close brd1)
       1
     end
  end

  test-gpio-linear : [Gpio, Device.Mmio] Integer
  test-gpio-linear = act
    brd0 <- board-open 0 0
    o <- pi4-gpio-open brd0 21 PinOutput
    when o
     is (brd1, q0) -> act
       q1 <- pi4-pin-write q0 True
       q2 <- (pi4-pin-write q1 False)
       c <- (pi4-pin-close q2)
       bc <- (board-close brd1)
       1
     end
  end

  test-delay : Integer
  test-delay =
    let a = pi4-delay-ms 1
    in 1

  test-pin-read : [Gpio, Device.Mmio] Integer
  test-pin-read = act
    brd0 <- board-open 0 0
    o <- pi4-gpio-open brd0 21 PinInput
    when o
     is (brd1, q0) -> act
       r <- pi4-pin-read q0
       when r
        is (q1, lv) -> act
          c <- (pi4-pin-close q1)
          bc <- (board-close brd1)
          1
        end
     end
  end

  test-uart-recv : [Uart, Device.Mmio] Integer
  test-uart-recv = act
    brd0 <- board-open 0 0
    o <- pi4-uart-open brd0 115200
    when o
     is (brd1, p0) -> act
       r <- pi4-uart-recv p0 1
       when r
        is (p1, bytes) -> act
          c <- (pi4-uart-close p1)
          bc <- (board-close brd1)
          if list-length bytes == 1 then 1 else 0
        end
     end
  end

  test-spi-txn : [Spi, Device.Mmio] Integer
  test-spi-txn = act
    brd0 <- board-open 0 0
    o <- pi4-spi-open brd0
    when o
     is (brd1, s0) -> act
       t0 <- pi4-spi-select s0 25
       r <- pi4-spi-txn-transfer t0 [#AA, #55]
       when r
        is (t1, got) -> act
          s1 <- pi4-spi-deselect t1
          c <- (pi4-spi-close s1)
          bc <- (board-close brd1)
          if list-length got == 2 then 1 else 0
        end
     end
  end

  test-i2c-bus : [I2c, Device.Mmio] Integer
  test-i2c-bus = act
    brd0 <- board-open 0 0
    o <- pi4-i2c-open brd0
    when o
     is (brd1, b0) -> act
       w <- pi4-i2c-bus-write-reg b0 #68 #6B 0
       when w
        is (b1, wr) -> act
          r <- pi4-i2c-bus-read-reg b1 #68 #75
          when r
           is (b2, rv) -> act
             c <- (pi4-i2c-close b2)
             bc <- (board-close brd1)
             1
           end
        end
     end
  end

  opening : [Gpio, Uart, Spi, I2c, Device.Mmio] Integer = act
    g <- test-gpio
    l <- test-led
    u <- test-uart
    s <- test-spi
    i <- test-i2c
    ul <- test-uart-linear
    gl <- test-gpio-linear
    pr <- test-pin-read
    ib <- test-i2c-bus
    st <- test-spi-txn
    ur <- test-uart-recv
    g + l + u + s + i + ul + gl + pr + ib + st + ur + test-delay
  end

