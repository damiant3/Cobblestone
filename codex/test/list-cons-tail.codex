Chapter: ListConsTail

 A cons in the tail argument of a self-recursive loop, checked by CONTENT
 and not only by length. A length-only check passes against a cons that
 stores the wrong operand, which is exactly the defect this guards: the
 riscv helper read the list out of the first argument and the element out
 of the second, while every emitter and both other lanes pass the element
 first.

Section: Types

  Step =
   | Go
   | Stop

Section: Helpers

  step-of : Integer -> Step
  step-of (n) = if n <= 0 then Stop else Go

  build-down : Integer, List Integer -> List Integer
  build-down (n) (acc) =
    when step-of n
     is Stop -> acc
     is Go -> build-down (n - 1) (n :: acc)

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni "01 start"
    let xs = build-down 5 []
    in act
      print-line-uni ("02 length " & show (list-length xs))
      print-line-uni ("03 head " & show (list-at xs 0))
      print-line-uni ("04 last " & show (list-at xs 4))
      print-line-uni ("05 third " & show (list-at xs 2))
    end
    print-line-uni "06 done"
  end
