Chapter: TcpListenReclaim
  cites Net chapter NetworkStack
  cites Net chapter Tcp

Section: Fixture

  local-mac : List Integer = [0, 1, 2, 3, 4, 5]
  local-ip : List Integer = [10, 0, 2, 15]
  gateway-ip : List Integer = [10, 0, 2, 2]
  peer-ip : List Integer = [127, 0, 0, 1]

  server-port : Integer = 9301
  caller-a-port : Integer = 49152
  caller-b-port : Integer = 49153

  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

  syn-from : Integer -> TcpSegment
  syn-from (src) =
    TcpSegment { src-port = __narrow src, dst-port = __narrow server-port, seq-num = 7000, ack-num = 0, flags = __narrow tcp-flag-syn, window = 8192, payload = [] }

  ack-from : Integer -> TcpSegment
  ack-from (src) =
    TcpSegment { src-port = __narrow src, dst-port = __narrow server-port, seq-num = 7001, ack-num = 1, flags = __narrow tcp-flag-ack, window = 8192, payload = [] }

  fresh-listener : NetSession =
    let sess = net-session-new local-mac local-ip gateway-ip server-port 0 peer-ip 1000
    in (net-listen sess).session

  after-one-caller : NetSession =
    let claimed = net-receive-segment fresh-listener (syn-from caller-a-port)
    in let closed = net-close (claimed.session)
    in (net-listen (closed.session)).session

 The arm above closes from SYN_RECEIVED, where EvClose reached CLOSED and a
 re-listen out of CLOSED always worked. A SERVER NEVER CLOSES FROM THERE: it
 completes the handshake, answers, and closes from ESTABLISHED, which lands
 in FIN_WAIT_1. Everything below drives that path, and the whole file passed
 without it while the ARM64 web server served exactly one request per boot.

  established-session : NetSession =
    let claimed = net-receive-segment fresh-listener (syn-from caller-a-port)
    in (net-receive-segment (claimed.session) (ack-from caller-a-port)).session

  after-established-close : NetSession =
    let closed = net-close established-session
    in (net-listen (closed.session)).session

 The serve loop's accept gives up on a poll budget and can return with the
 handshake half open, and the loop then re-listens. `net-listen` calls
 `tcp-fresh-listener` whatever the current state, so that re-listen destroys
 the half-open. The two arms below deliver the SAME client ACK to the two
 sessions that differ only in whether the re-listen happened.

  half-open : NetSession =
    (net-receive-segment fresh-listener (syn-from caller-a-port)).session

  half-open-relistened : NetSession =
    (net-listen half-open).session

Section: Tests

  test-fresh-takes-any : Text =
    "fresh-listener-admits=" & show-bool (net-session-owns-segment fresh-listener (syn-from caller-a-port))

  test-claimed-port : Text =
    let claimed = net-receive-segment fresh-listener (syn-from caller-a-port)
    in "claimed-remote-port=" & show ((claimed.session).conn.remote-port)

  test-claimed-rejects-stranger : Text =
    let claimed = net-receive-segment fresh-listener (syn-from caller-a-port)
    in "claimed-admits-stranger=" & show-bool (net-session-owns-segment (claimed.session) (ack-from caller-b-port))

  test-relisten-state : Text =
    "relisten-state=" & tcp-state-name (after-one-caller.conn.state)

  test-relisten-port : Text =
    "relisten-remote-port=" & show (after-one-caller.conn.remote-port)

  test-second-caller-admitted : Text =
    "second-caller-admitted=" & show-bool (net-session-owns-segment after-one-caller (syn-from caller-b-port))

  test-second-caller-claims : Text =
    let taken = net-receive-segment after-one-caller (syn-from caller-b-port)
    in "second-caller-claims=" & show ((taken.session).conn.remote-port)

  test-established-reached : Text =
    "established-state=" & tcp-state-name (established-session.conn.state)

  test-closing-state : Text =
    "closing-state=" & tcp-state-name ((net-close established-session).session.conn.state)

  test-relisten-after-established : Text =
    "relisten-after-established=" & tcp-state-name (after-established-close.conn.state)

  test-relisten-after-established-port : Text =
    "relisten-after-established-port=" & show (after-established-close.conn.remote-port)

  test-third-caller-admitted : Text =
    "third-caller-admitted=" & show-bool (net-session-owns-segment after-established-close (syn-from caller-b-port))

  test-third-caller-claims : Text =
    let taken = net-receive-segment after-established-close (syn-from caller-b-port)
    in "third-caller-claims=" & show ((taken.session).conn.remote-port)

  test-rexmit-retired : Text =
    "rexmit-after-relisten=" & show (list-length (after-established-close.rexmit-queue))

  test-half-open-state : Text =
    "half-open-state=" & tcp-state-name (half-open.conn.state)

  test-half-open-ack-completes : Text =
    let done = net-receive-segment half-open (ack-from caller-a-port)
    in "half-open-ack-state=" & tcp-state-name ((done.session).conn.state)

  test-relistened-half-open-state : Text =
    "relistened-half-open-state=" & tcp-state-name (half-open-relistened.conn.state)

  test-relistened-forgets-peer : Text =
    "relistened-remote-port=" & show (half-open-relistened.conn.remote-port)

  test-relistened-ack-lost : Text =
    let done = net-receive-segment half-open-relistened (ack-from caller-a-port)
    in "relistened-ack-state=" & tcp-state-name ((done.session).conn.state)

  test-relistened-ack-output : Text =
    let done = net-receive-segment half-open-relistened (ack-from caller-a-port)
    in "relistened-ack-output=" & (done.output)

  test-half-open-ack-clears-budget : Text =
    let done = net-receive-segment half-open-relistened (ack-from caller-a-port)
    in "established-close-timer=" & show ((done.session).close-timer)

  relisten-times : NetSession, Integer -> NetSession
  relisten-times (sess) (n) =
    if n <= 0 then sess
    else relisten-times ((net-listen sess).session) (n - 1)

  abandoned-caller : NetSession = relisten-times half-open 9

  test-abandoned-caller-retired : Text =
    "abandoned-caller-state=" & tcp-state-name (abandoned-caller.conn.state)

  test-abandoned-caller-forgets-peer : Text =
    "abandoned-caller-port=" & show (abandoned-caller.conn.remote-port)

  test-abandoned-admits-next : Text =
    "abandoned-admits-next=" & show-bool (net-session-owns-segment abandoned-caller (syn-from caller-b-port))

  test-budget-survives-eight : Text =
    "eight-relistens-state=" & tcp-state-name ((relisten-times half-open 8).conn.state)

  opening : [Console] Nothing = act
    print-line-uni test-fresh-takes-any
    print-line-uni test-claimed-port
    print-line-uni test-claimed-rejects-stranger
    print-line-uni test-relisten-state
    print-line-uni test-relisten-port
    print-line-uni test-second-caller-admitted
    print-line-uni test-second-caller-claims
    print-line-uni test-established-reached
    print-line-uni test-closing-state
    print-line-uni test-relisten-after-established
    print-line-uni test-relisten-after-established-port
    print-line-uni test-third-caller-admitted
    print-line-uni test-third-caller-claims
    print-line-uni test-rexmit-retired
    print-line-uni test-half-open-state
    print-line-uni test-half-open-ack-completes
    print-line-uni test-relistened-half-open-state
    print-line-uni test-relistened-forgets-peer
    print-line-uni test-relistened-ack-lost
    print-line-uni test-relistened-ack-output
    print-line-uni test-half-open-ack-clears-budget
    print-line-uni test-budget-survives-eight
    print-line-uni test-abandoned-caller-retired
    print-line-uni test-abandoned-caller-forgets-peer
    print-line-uni test-abandoned-admits-next
  end
