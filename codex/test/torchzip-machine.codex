  tzm-label : Integer -> Text
  tzm-label (i) = if i == 0 then "valid" else if i == 1 then "global os.system" else if i == 2 then "OrderedDict with an argument" else if i == 3 then "STACK_GLOBAL" else if i == 4 then "persistent id tagged evil" else if i == 5 then "strided tensor" else ""

  tzm-bytes : Integer -> List Integer
  tzm-bytes (i) = if i == 0 then tzm-case-0 else if i == 1 then tzm-case-1 else if i == 2 then tzm-case-2 else if i == 3 then tzm-case-3 else if i == 4 then tzm-case-4 else if i == 5 then tzm-case-5 else []

  tzm-line : Integer -> Text
  tzm-line (i) =
    let r = if i == 6 then torch-zip-read (tzm-bytes 0) [] [] else torch-zip-read (tzm-bytes i) ["archive/data/0"] [1000]
    in let label = if i == 6 then "missing storage" else tzm-label i
    in if r.tzf-why /= "" then label & ": refused: " & r.tzf-why
    else tzm-label i & ": " & tzm-tensor (list-at ((r.tzf-file).st-tensors) 0) & ", " & show ((r.tzf-file).st-tensor-count) & " tensor"

  tzm-tensor : StTensorMeta -> Text
  tzm-tensor (m) = m.stm-name & " dtype " & show (m.stm-dtype) & " shape " & show (list-at (m.stm-shape) 0) & "x" & show (list-at (m.stm-shape) 1) & " bytes " & show (m.stm-offset-start) & ".." & show (m.stm-offset-end)

Section: Body

  tzm-print : Integer -> [Console] Nothing
  tzm-print (i) =
    if i >= 7 then act
      print-uni ""
    end
    else act
      print-line-uni (tzm-line i)
      tzm-print (i + 1)
    end

  opening : [Console] Nothing
  opening = tzm-print 0
