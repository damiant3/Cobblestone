Chapter: ModProbe
  cites Foreword chapter Console

 int-mod and division at every sign combination.

Section: Body

  mline : Text, Integer, Integer -> Text
  mline (tag) (x) (y) =
   tag & " " & integer-to-text x & "," & integer-to-text y
     & " div=" & integer-to-text (x / y)
     & " mod=" & integer-to-text (int-mod x y)

  opening : [Console] Nothing = act
    print-line-uni (mline "pp" 7 3)
    print-line-uni (mline "np" (0 - 7) 3)
    print-line-uni (mline "pn" 7 (0 - 3))
    print-line-uni (mline "nn" (0 - 7) (0 - 3))
    print-line-uni (mline "pp2" 8 4)
    print-line-uni (mline "np2" (0 - 8) 4)
    print-line-uni (mline "np3" (0 - 1) 8)
    print-line-uni (mline "pn3" 1 (0 - 8))
  end

