Chapter: GopPaddedStride
  cites Foreword chapter Console
  cites Engine chapter Renderer3D
  cites Game chapter Color

 A real panel pads its scanlines. The ASUS TUF sitting on 2026-07-29
 reported 1920x1080 with a PixelsPerScanLine of 2048, so a row is 128
 pixels wider in memory than anything the eye can see. Every bed we
 owned had stride equal to width, which means a renderer stepping rows
 by the visible width produced byte-identical output to a correct one
 and no test in the tree could tell them apart.

 We say:

Section: Geometry

 Published by codex-vm at boot. The stride sits at 0x7E0, the offset
 PixelsPerScanLine occupies in a UEFI mode-info block, so the UEFI and
 bare `-gop` paths agree on where it lives.

  fb-base : Integer = 3204448256
  cell-width : Integer = 1988
  cell-height : Integer = 1992
  cell-stride : Integer = 2016

  sentinel : Integer = 12648430
  probe : Integer = 16711935

  sky : Integer
  sky = rgb-to-packed (rgb 20 20 30)

Section: Counting

  fill-fb : Integer, Integer, Integer -> Integer
  fill-fb (base) (i) (n) =
    if i >= n then 0
    else let d = poke-32 base (i * 4) sentinel
    in fill-fb base (i + 1) n

  pad-cols : Integer, Integer, Integer, Integer, Integer -> Integer
  pad-cols (base) (stride) (y) (x) (acc) =
    if x >= stride then acc
    else if peek-32 base ((y * stride + x) * 4) == sentinel then pad-cols base stride y (x + 1) (acc + 1)
    else pad-cols base stride y (x + 1) acc

  pad-rows : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  pad-rows (base) (stride) (w) (h) (y) (acc) =
    if y >= h then acc
    else pad-rows base stride w h (y + 1) (pad-cols base stride y w acc)

  row-painted : Integer, Integer, Integer, Integer, Integer -> Integer
  row-painted (base) (stride) (w) (y) (x) =
    if x >= w then 0
    else if peek-32 base ((y * stride + x) * 4) == sentinel then row-painted base stride w y (x + 1)
    else 1

  yn : Boolean -> Text
  yn (b) = if b then "yes" else "no"

Section: Entry

  opening : [Console] Nothing = act
    let w = peek-32 cell-width 0
    in let h = peek-32 cell-height 0
    in let stride = peek-32 cell-stride 0
    in let pad = (stride - w) * h
    in let f = fill-fb fb-base 0 (stride * h)
    in let tgt = r3d-target-at fb-base stride w h sky
    in let plotted = r3d-plot tgt (w - 1) (h - 1) 1 probe
    in let corner = peek-32 fb-base (((h - 1) * stride + w - 1) * 4)
    in let pad-kept = pad-rows fb-base stride w h 0 0
    in let bottom = row-painted fb-base stride w (h - 1) 0
    in act
      print-line-uni ("stride exceeds width   : " & yn (stride > w))
      print-line-uni ("invisible pad untouched: " & yn (pad-kept == pad))
      print-line-uni ("bottom row painted     : " & yn (bottom == 1))
      print-line-uni ("plot lands at stride   : " & yn (corner == probe))
    end
  end

