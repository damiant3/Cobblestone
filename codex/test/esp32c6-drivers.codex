Chapter: Esp32C6Drivers

  cites Boards chapter Esp32C6Board

 Smoke test for ESP32-C6 board drivers. MMIO stubs return 0 on the
 hosted VM, so this exercises the driver logic and bit manipulation
 without real hardware. All fuel-bounded loops terminate immediately
 since the status registers read as 0.

Section: Definitions

  test-gpio : Integer
  test-gpio =
    let a = esp32c6-gpio-set-output 8
    in let b = esp32c6-gpio-set 8
    in let c = esp32c6-gpio-clear 8
    in let d = esp32c6-gpio-set-input 4
    in let e = esp32c6-gpio-read 4
    in let f = esp32c6-gpio-toggle 8
    in let g = esp32c6-gpio-set-pull 4 1
    in 1

  test-led : Integer
  test-led =
    let a = esp32c6-led-init
    in let b = esp32c6-led-on
    in let c = esp32c6-led-off
    in 1

  test-uart : Integer
  test-uart =
    let a = esp32c6-uart-init 115200
    in let b = esp32c6-uart-send-byte esp32c6-uart0-base 65
    in let c = esp32c6-uart-print esp32c6-uart0-base "hello"
    in let d = esp32c6-uart-println esp32c6-uart0-base "world"
    in 1

  test-spi : Integer
  test-spi =
    let a = esp32c6-spi-init
    in let b = esp32c6-spi-transfer esp32c6-spi2-base #AA
    in 1

  test-i2c : Integer
  test-i2c =
    let a = esp32c6-i2c-init
    in let b = esp32c6-i2c-write-reg #68 #6B 0
    in let c = esp32c6-i2c-read-reg #68 #75
    in 1

  test-delay : Integer
  test-delay =
    let a = esp32c6-delay-ms 1
    in 1

  opening : Integer =
    let g = test-gpio
    in let l = test-led
    in let u = test-uart
    in let s = test-spi
    in let i = test-i2c
    in let d = test-delay
    in g + l + u + s + i + d

