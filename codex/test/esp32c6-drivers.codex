Chapter: Esp32C6Drivers

  cites Boards chapter Esp32C6Board

Section: Definitions

  test-gpio : [Device.Mmio] Integer
  test-gpio = act
    a <- esp32c6-gpio-set-output 8
    b <- esp32c6-gpio-set 8
    c <- esp32c6-gpio-clear 8
    d <- esp32c6-gpio-set-input 4
    e <- esp32c6-gpio-read 4
    f <- esp32c6-gpio-toggle 8
    g <- (esp32c6-gpio-set-pull 4 1)
    1
  end

  test-led : [Device.Mmio] Integer
  test-led = act
    a <- esp32c6-led-init
    b <- esp32c6-led-on
    c <- esp32c6-led-off
    1
  end

  test-uart : [Device.Mmio] Integer
  test-uart = act
    a <- esp32c6-uart-init 115200
    b <- esp32c6-uart-send-byte esp32c6-uart0-base 65
    c <- esp32c6-uart-print esp32c6-uart0-base "hello"
    d <- (esp32c6-uart-println esp32c6-uart0-base "world")
    1
  end

  test-spi : [Device.Mmio] Integer
  test-spi = act
    a <- esp32c6-spi-init
    b <- (esp32c6-spi-transfer esp32c6-spi2-base #AA)
    1
  end

  test-i2c : [Device.Mmio] Integer
  test-i2c = act
    a <- esp32c6-i2c-init
    b <- esp32c6-i2c-write-reg #68 #6B 0
    c <- (esp32c6-i2c-read-reg #68 #75)
    1
  end

  test-uart-linear : [Uart, Device.Mmio] Integer
  test-uart-linear = act
    p0 <- esp32c6-uart-open 115200
    p1 <- esp32c6-uart-write p0 72
    p2 <- (esp32c6-uart-write p1 73)
    c <- (esp32c6-uart-close p2)
    1
  end

  test-gpio-linear : [Gpio, Device.Mmio] Integer
  test-gpio-linear = act
    q0 <- esp32c6-gpio-open 8 PinOutput
    q1 <- esp32c6-pin-write q0 True
    q2 <- (esp32c6-pin-write q1 False)
    c <- (esp32c6-pin-close q2)
    1
  end

  test-delay : Integer
  test-delay =
    let a = esp32c6-delay-ms 1
    in 1

  test-pin-read : [Gpio, Device.Mmio] Integer
  test-pin-read = act
    q0 <- esp32c6-gpio-open 8 PinInput
    r <- esp32c6-pin-read q0
    when r
     is (q1, lv) -> act
       c <- (esp32c6-pin-close q1)
       1
     end
  end

  test-uart-recv : [Uart, Device.Mmio] Integer
  test-uart-recv = act
    p0 <- esp32c6-uart-open 115200
    r <- esp32c6-uart-recv p0 1
    when r
     is (p1, bytes) -> act
       c <- (esp32c6-uart-close p1)
       if list-length bytes == 1 then 1 else 0
     end
  end

  test-spi-txn : [Spi, Device.Mmio] Integer
  test-spi-txn = act
    s0 <- esp32c6-spi-open
    t0 <- esp32c6-spi-select s0 10
    r <- esp32c6-spi-txn-transfer t0 [#AA, #55]
    when r
     is (t1, got) -> act
       s1 <- esp32c6-spi-deselect t1
       c <- (esp32c6-spi-close s1)
       if list-length got == 2 then 1 else 0
     end
  end

  test-i2c-bus : [I2c, Device.Mmio] Integer
  test-i2c-bus = act
    b0 <- esp32c6-i2c-open
    w <- esp32c6-i2c-bus-write-reg b0 #68 #6B 0
    when w
     is (b1, wr) -> act
       r <- esp32c6-i2c-bus-read-reg b1 #68 #75
       when r
        is (b2, rv) -> act
          c <- (esp32c6-i2c-close b2)
          1
        end
     end
  end

  opening : [Gpio, Uart, Spi, I2c, Device.Mmio] Integer = act
    g <- test-gpio
    l <- test-led
    u <- test-uart
    s <- test-spi
    i <- test-i2c
    ul <- test-uart-linear
    gl <- test-gpio-linear
    pr <- test-pin-read
    ib <- test-i2c-bus
    st <- test-spi-txn
    ur <- test-uart-recv
    g + l + u + s + i + ul + gl + pr + ib + st + ur + test-delay
  end

