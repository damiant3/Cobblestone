Chapter: RealSaturating
  cites Foreword chapter Console

Section: Entry
  add-sat : Real saturating, Real saturating -> Real saturating
  add-sat (a) (b) = a + b

  div-sat : Real saturating, Real saturating -> Real saturating
  div-sat (a) (b) = a / b

  opening : [Console] Nothing
  opening = act
    let a = to-real-saturating 3.0
    in let b = to-real-saturating 4.0
    in let sum = add-sat a b
    in act
      print-line-uni ("sum: " & show (from-real-saturating sum))
    end
    let zero = to-real-saturating 0.0
    in let nan-result = div-sat zero zero
    in let recovered = add-sat nan-result (to-real-saturating 1.0)
    in act
      print-line-uni ("nan-safe: " & show (from-real-saturating recovered))
    end
  end
