Chapter: WcetExceeded
  cites Foreword chapter Console

Section: Punctual Functions

  punctual 4 classify-tight : Integer -> Integer
  classify-tight (n) =
    if n > 100 then 3
    else if n > 10 then 2
    else if n > 0 then 1
    else 0

Section: Entry

  opening : [Console] Nothing
  opening = act
    print-line-uni ("c1: " & show (classify-tight 500))
    print-line-uni ("c2: " & show (classify-tight 50))
    print-line-uni ("c3: " & show (classify-tight 5))
    print-line-uni ("c4: " & show (classify-tight (-5)))
  end
