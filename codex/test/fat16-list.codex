Chapter: Fat16List
  cites Foreword chapter Fat16

 We say:

Section: Reporting

  show-list : Text, List Text, Integer, Integer -> [Console] Nothing
  show-list (label) (xs) (i) (n) =
    if i >= n then act print-line-uni (label & " end") end
    else act
      print-line-uni (label & " " & list-at xs i)
      show-list label xs (i + 1) n
    end

Section: Entry

  opening : [Console, Device.Block] Nothing
  opening = act
    hit <- file-exists "CODEX.CDX"
    print-line-uni ("exists-present " & show hit)
    miss <- file-exists "NOPE.XXX"
    print-line-uni ("exists-absent " & show miss)
    dirs <- list-directories ""
    show-list "rootdir" dirs 0 (list-length dirs)
    files <- list-files "" ""
    show-list "rootfile" files 0 (list-length files)
    boot <- list-files "EFI/BOOT" ""
    show-list "bootfile" boot 0 (list-length boot)
    cdx <- list-files "" ".CDX"
    show-list "extfilter" cdx 0 (list-length cdx)
    nope <- list-files "" ".ZZZ"
    show-list "extnomatch" nope 0 (list-length nope)
  end
