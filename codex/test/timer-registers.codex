Chapter: TimerRegisters
  cites Foreword chapter Board
  grounds Device.Mmio, Device.Port

 All three were free-running register files that told the guest nothing.
 The HPET's main counter returned the raw host performance counter while
 its capability register advertised a 14.318 MHz period, so elapsed-time
 arithmetic was wrong by whatever ratio the host's counter happened to
 run at; its comparator was stored and never compared against anything;
 the PIT discarded the divisor a guest programmed and answered 0 to every
 counter read; and the local APIC's Current Count returned the Initial
 Count verbatim, so it never fell.

 Each of those failures has the same shape, and it is the shape a test
 cannot see by accident: a register that always answers the same thing
 looks exactly like one that works. So every assertion below demands a
 value that CHANGES, or a magnitude that the broken version could not
 have produced -- never merely that a read succeeded.

 We say:

Section: Register Addresses

 Register addresses are written in hex, the way the manuals write them.
 They were decimal here once and one of them was arithmetic done by hand
 and got wrong -- the fault address that came back was off by exactly the
 error, which is a slow way to learn what the notation is for.

  hpet-config : Integer = #FED00010
  hpet-status : Integer = #FED00020
  hpet-counter-lo : Integer = #FED000F0
  hpet-counter-hi : Integer = #FED000F4
  hpet-t0-config : Integer = #FED00100
  hpet-t0-cmp-lo : Integer = #FED00108

  lapic-lvt-timer : Integer = #FEE00320
  lapic-init-count : Integer = #FEE00380
  lapic-cur-count : Integer = #FEE00390
  lapic-div-cfg : Integer = #FEE003E0

  pit-ch0 : Integer = #40
  pit-cmd : Integer = #43

Section: Spin

  spin : Integer -> [Device.Mmio] Integer
  spin (n) =
    if n <= 0 then 0
    else let v = mmio-read-32 hpet-counter-lo
    in v + spin (n - 1)

Section: HPET counter

  hpet-counter-report : Text
  hpet-counter-report = act
    e <- mmio-write-32 hpet-config 1
    hi <- mmio-read-32 hpet-counter-hi
    first <- mmio-read-32 hpet-counter-lo
    s <- spin 2000
    second <- mmio-read-32 hpet-counter-lo
    hpet-counter-verdict hi first second
  end

  hpet-counter-verdict : Integer, Integer, Integer -> Text
  hpet-counter-verdict (hi) (first) (second) =
    if hi /= 0 then "hpet counter: not rebased, high=" & show hi
    else if second <= first then "hpet counter: frozen at " & show first
    else "hpet counter: rebased and advancing"

Section: HPET enable bit

  hpet-halt-report : Text
  hpet-halt-report = act
    e <- mmio-write-32 hpet-config 1
    d <- mmio-write-32 hpet-config 0
    first <- mmio-read-32 hpet-counter-lo
    s <- spin 2000
    second <- mmio-read-32 hpet-counter-lo
    r <- mmio-write-32 hpet-config 1
    hpet-halt-verdict first second
  end

  hpet-halt-verdict : Integer, Integer -> Text
  hpet-halt-verdict (first) (second) =
    if first /= second then "hpet halt: counter ran while disabled"
    else "hpet halt: counter held while disabled"

Section: HPET comparator

  hpet-comparator-report : Text
  hpet-comparator-report = act
    e <- mmio-write-32 hpet-config 1
    c <- mmio-write-32 hpet-t0-config 4
    now <- mmio-read-32 hpet-counter-lo
    t <- mmio-write-32 hpet-t0-cmp-lo (now + 1000)
    s <- spin 2000
    status <- mmio-read-32 hpet-status
    hpet-comparator-verdict status
  end

  hpet-comparator-verdict : Integer -> Text
  hpet-comparator-verdict (status) =
    if bit-and status 1 > 0 then "hpet comparator: matched"
    else "hpet comparator: never matched"

Section: LAPIC current count

  lapic-report : Text
  lapic-report = act
    d <- mmio-write-32 lapic-div-cfg 3
    v <- mmio-write-32 lapic-lvt-timer #20030
    i <- mmio-write-32 lapic-init-count 1000000
    armed <- mmio-read-32 lapic-cur-count
    s <- spin 3000
    later <- mmio-read-32 lapic-cur-count
    lapic-verdict armed later
  end

  lapic-verdict : Integer, Integer -> Text
  lapic-verdict (armed) (later) =
    if armed == 0 then "lapic current count: zero after arming"
    else if later >= armed then "lapic current count: stuck at " & show armed
    else "lapic current count: decrementing"

Section: LAPIC period derives from the count

  arm-and-drop : Integer -> [Device.Mmio] Integer
  arm-and-drop (count) = act
    d <- mmio-write-32 lapic-div-cfg 3
    v <- mmio-write-32 lapic-lvt-timer #20030
    i <- mmio-write-32 lapic-init-count count
    before <- mmio-read-32 lapic-cur-count
    s <- spin 8000
    after <- mmio-read-32 lapic-cur-count
    before - after
  end

  lapic-period-report : Text
  lapic-period-report = act
    d1 <- arm-and-drop 1000000
    d2 <- arm-and-drop 2000000
    lapic-period-verdict d1 d2
  end

  lapic-period-verdict : Integer, Integer -> Text
  lapic-period-verdict (d1) (d2) =
    if d1 <= 0 then "lapic period: no drop to measure"
    else if d2 * 2 > d1 * 3 then "lapic period: scales with the count, drops "
      & show d1 & " then " & show d2
    else "lapic period: derived from the count"

Section: PIT counter

  pit-report : Text
  pit-report = act
    c <- port-out-byte pit-cmd 54
    l <- port-out-byte pit-ch0 255
    h <- port-out-byte pit-ch0 255
    a0 <- port-in-byte pit-ch0
    b0 <- port-in-byte pit-ch0
    s <- spin 500
    a1 <- port-in-byte pit-ch0
    b1 <- port-in-byte pit-ch0
    pit-verdict (a0 + bit-shl b0 8) (a1 + bit-shl b1 8)
  end

  pit-verdict : Integer, Integer -> Text
  pit-verdict (first) (second) =
    if first == 0 & second == 0 then "pit counter: dead at zero"
    else if first == second then "pit counter: stuck at " & show first
    else "pit counter: running"

Section: Entry

  opening : [Console] Integer
  opening = act
    print-line-uni hpet-counter-report
    print-line-uni hpet-halt-report
    print-line-uni hpet-comparator-report
    print-line-uni lapic-report
    print-line-uni lapic-period-report
    print-line-uni pit-report
    let r = 0 in r
  end
