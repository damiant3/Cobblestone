Chapter: PipeUniqueTest
  cites Foreword chapter Pipeline
  cites Foreword chapter Console

Section: Body
  opening : [Console] Nothing = act
    let xs = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5]
    in let unique = pipe-unique xs
    in let count = list-length unique
    in act
      print-line-uni (show count)
      print-line-uni (show (pipe-contains unique 1))
      print-line-uni (show (pipe-contains unique 9))
      print-line-uni (show (pipe-contains unique 7))
    end
  end

