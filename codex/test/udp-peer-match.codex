Chapter: UdpPeerMatch
  cites Net chapter UdpIO
  cites Net chapter Udp
  cites Net chapter Ethernet
  cites Foreword chapter Console

Section: Wire Fixtures

  my-mac : List Integer = [82, 84, 0, 18, 52, 86]
  peer-mac : List Integer = [82, 85, 10, 0, 2, 2]
  my-ip : List Integer = [10, 0, 2, 15]
  server-ip : List Integer = [10, 0, 2, 2]
  other-ip : List Integer = [10, 0, 2, 9]

  client : UdpSocket = udp-io-open my-mac my-ip 40000 server-ip 5683
  dhcp : UdpSocket = udp-io-open my-mac my-ip 68 [255, 255, 255, 255] 67
  server : UdpSocket = udp-io-open my-mac my-ip 5683 server-ip 0

  from : List Integer, Integer, Integer -> List Integer
  from (src-ip) (src-port) (dst-port) = udp-build-frame my-mac peer-mac src-ip my-ip src-port dst-port [1, 2, 3, 4]

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("client from-server=" & show (udp-io-mine client (from server-ip 5683 40000)))
    print-line-uni ("client wrong-dst-port=" & show (udp-io-mine client (from server-ip 5683 40001)))
    print-line-uni ("client other-host=" & show (udp-io-mine client (from other-ip 5683 40000)))
    print-line-uni ("client other-port=" & show (udp-io-mine client (from server-ip 9999 40000)))
    print-line-uni ("dhcp from-server-port=" & show (udp-io-mine dhcp (from server-ip 67 68)))
    print-line-uni ("dhcp from-other-port=" & show (udp-io-mine dhcp (from server-ip 68 68)))
    print-line-uni ("server any-host=" & show (udp-io-mine server (from other-ip 51234 5683)))
  end
