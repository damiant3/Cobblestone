Chapter: OauthIsland
  cites Net chapter OAuthClient
  cites Net chapter OAuthProvider
  cites Trust chapter ExternalAuthBridge

Section: Entry

  opening : [Console] Nothing
  opening = act
    print-line-uni ("nonce " & (oauth-state-new "abc" "verifier" 1).os-state-nonce)
    print-line-uni ("issuer " & google-issuer)
    print-line-uni ("provider " & (provider-trust-google).pt-provider)
  end
