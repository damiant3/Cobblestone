Chapter: PciBridgeScan
  grounds Device.Port
  cites Kernel chapter Pci

Section: Body
  count-bus1 : List PciDevice, Integer, Integer, Integer -> Integer
  count-bus1 (devs) (i) (n) (acc) =
   if i >= n then acc
   else if (list-at devs i).pci-bus == 1 then count-bus1 devs (i + 1) n (acc + 1)
   else count-bus1 devs (i + 1) n acc

  opening : [Console] Nothing = act
   let scan = pci-scan-all
   in let n = scan.count
   in let b1 = count-bus1 (scan.devices) 0 n 0
   in print-line-uni ("scan count=" & show n & " bus1=" & show b1)
  end
