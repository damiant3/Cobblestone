Chapter: UiScrollTest
  cites UI chapter Theme
  cites UI chapter BoxModel
  cites UI chapter Scroll
  cites UI chapter Widget

Section: Body

  test-scroll-new : Text =
    let s = scroll-new 200 100 400 300
    in format-scroll s

  test-scroll-by : Text =
    let s = scroll-new 200 100 400 300
    in let s2 = scroll-by s 50 25
    in "x=" & show (s2.scr-offset-x) & " y=" & show (s2.scr-offset-y)

  test-scroll-clamp : Text =
    let s = scroll-new 200 100 400 300
    in let s2 = scroll-by s 999 999
    in "x=" & show (s2.scr-offset-x) & " y=" & show (s2.scr-offset-y)

  test-scroll-negative : Text =
    let s = scroll-new 200 100 400 300
    in let s2 = scroll-by s (0 - 50) (0 - 50)
    in "x=" & show (s2.scr-offset-x) & " y=" & show (s2.scr-offset-y)

  test-thumb : Text =
    let s = scroll-new 200 100 400 300
    in let s2 = scroll-by s 100 100
    in "ty=" & show (scroll-thumb-y s2) & " th=" & show (scroll-thumb-h s2)

  test-pct : Text =
    let s = scroll-new 200 100 400 300
    in let s2 = scroll-to s 100 100
    in "px=" & show (scroll-pct-x s2) & " py=" & show (scroll-pct-y s2)

  test-page : Text =
    let s = scroll-new 200 100 400 300
    in let s2 = scroll-page-down (scroll-page-down s)
    in "y=" & show (s2.scr-offset-y)

  test-no-scroll : Text =
    let s = scroll-new 400 300 200 100
    in let sv = s.scr-scroll-v
    in let sh = s.scr-scroll-h
    in "h=" & scr-bool sh & " v=" & scr-bool sv

  scr-bool : Boolean -> Text
  scr-bool (b) = if b then "true" else "false"

 The rows half. A row height of 10 keeps the arithmetic readable: the viewport
 is 100 tall so ten rows fit, and the content is 300 so there are thirty.

  test-rows : Text =
    let s = scroll-new 200 100 400 300
    in let s2 = scroll-to s 0 50
    in "vis=" & show (scroll-rows-visible s 10) & " first=" & show (scroll-row-first s 10) & " first2=" & show (scroll-row-first s2 10)

  test-follow : Text =
    let s = scroll-new 200 100 400 300
    in let far = scroll-follow-row s 25 10
    in let near = scroll-follow-row s 3 10
    in "far=" & show (far.scr-offset-y) & " near=" & show (near.scr-offset-y)

  scr-rows : Integer, Integer, List WidgetNode -> List WidgetNode
  scr-rows (i) (n) (acc) =
    if i >= n then acc
    else scr-rows (i + 1) n (list-push acc (widget-label ("r" & show i) ""))

  test-slice : Text =
    let s = scroll-new 200 100 400 300
    in let s2 = scroll-to s 0 50
    in let all = scr-rows 0 30 []
    in let got = scroll-slice all s2 10
    in let first = if list-length got == 0 then "none" else (list-at got 0).wn-id
    in "n=" & show (list-length got) & " first=" & first

 A slice of a list SHORTER than the window must not answer the window's
 length, which is the failure a fixed-size take would have.

  test-slice-short : Text =
    let s = scroll-new 200 100 400 300
    in let got = scroll-slice (scr-rows 0 4 []) s 10
    in "n=" & show (list-length got)

  test-label : Text =
    let s = scroll-new 200 100 400 300
    in let s2 = scroll-to s 0 50
    in scroll-label s2 10

  test-fits : Text =
    let big = scroll-new 400 300 200 100
    in let small = scroll-new 200 100 400 300
    in "big=" & scr-bool (scroll-fits big) & " small=" & scr-bool (scroll-fits small)

 The bar is three nodes and the thumb is the middle one. Asserting the flexes
 is asserting the geometry: the layout engine turns them into the pixels, so a
 thumb that is the right FRACTION is a thumb in the right place.

  test-bar : Text =
    let s = scroll-new 200 100 400 300
    in let s2 = scroll-to s 0 150
    in let bar = scroll-bar "b" s2
    in let kids = bar.wn-children
    in "n=" & show (list-length kids) & " lead=" & show ((list-at kids 0).wn-flex) & " thumb=" & show ((list-at kids 1).wn-flex) & " id=" & (list-at kids 1).wn-id

  test-bar-gap : Text =
    let fits = scroll-new 400 300 200 100
    in let g = scroll-bar-or-gap "b" fits
    in "kids=" & show (list-length (g.wn-children)) & " flex=" & show (g.wn-flex) & " minw=" & show (g.wn-min-w)

  opening : [Console] Nothing = act
    print-line-uni test-scroll-new
    print-line-uni test-scroll-by
    print-line-uni test-scroll-clamp
    print-line-uni test-scroll-negative
    print-line-uni test-thumb
    print-line-uni test-pct
    print-line-uni test-page
    print-line-uni test-no-scroll
    print-line-uni test-rows
    print-line-uni test-follow
    print-line-uni test-slice
    print-line-uni test-slice-short
    print-line-uni test-label
    print-line-uni test-fits
    print-line-uni test-bar
    print-line-uni test-bar-gap
  end

