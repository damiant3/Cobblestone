Chapter: UiScrollTest
  cites UI chapter Theme
  cites UI chapter BoxModel
  cites UI chapter Scroll

Section: Body

  test-scroll-new : Text =
    let s = scroll-new 200 100 400 300
    in format-scroll s

  test-scroll-by : Text =
    let s = scroll-new 200 100 400 300
    in let s2 = scroll-by s 50 25
    in "x=" & show (s2.scr-offset-x) & " y=" & show (s2.scr-offset-y)

  test-scroll-clamp : Text =
    let s = scroll-new 200 100 400 300
    in let s2 = scroll-by s 999 999
    in "x=" & show (s2.scr-offset-x) & " y=" & show (s2.scr-offset-y)

  test-scroll-negative : Text =
    let s = scroll-new 200 100 400 300
    in let s2 = scroll-by s (0 - 50) (0 - 50)
    in "x=" & show (s2.scr-offset-x) & " y=" & show (s2.scr-offset-y)

  test-thumb : Text =
    let s = scroll-new 200 100 400 300
    in let s2 = scroll-by s 100 100
    in "ty=" & show (scroll-thumb-y s2) & " th=" & show (scroll-thumb-h s2)

  test-pct : Text =
    let s = scroll-new 200 100 400 300
    in let s2 = scroll-to s 100 100
    in "px=" & show (scroll-pct-x s2) & " py=" & show (scroll-pct-y s2)

  test-page : Text =
    let s = scroll-new 200 100 400 300
    in let s2 = scroll-page-down (scroll-page-down s)
    in "y=" & show (s2.scr-offset-y)

  test-no-scroll : Text =
    let s = scroll-new 400 300 200 100
    in let sv = s.scr-scroll-v
    in let sh = s.scr-scroll-h
    in "h=" & scr-bool sh & " v=" & scr-bool sv

  scr-bool : Boolean -> Text
  scr-bool (b) = if b then "true" else "false"

  opening : [Console] Nothing = act
    print-line-uni test-scroll-new
    print-line-uni test-scroll-by
    print-line-uni test-scroll-clamp
    print-line-uni test-scroll-negative
    print-line-uni test-thumb
    print-line-uni test-pct
    print-line-uni test-page
    print-line-uni test-no-scroll
  end

