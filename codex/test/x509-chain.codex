Section: Times

 The certificate is valid from 2016-08-01 to 2040-12-31.

  t-2020 : List Integer =
    [50, 48, 50, 48, 48, 49, 48, 49, 48, 48, 48, 48, 48, 48]

  t-2015 : List Integer =
    [50, 48, 49, 53, 48, 49, 48, 49, 48, 48, 48, 48, 48, 48]

  t-2041 : List Integer =
    [50, 48, 52, 49, 48, 49, 48, 49, 48, 48, 48, 48, 48, 48]

Section: The Chain

  the-cert : Maybe X509Cert = x509-parse c-cert

  the-tampered : Maybe X509Cert = x509-parse c-cert-tampered

  anchor-key : Maybe X509Key = x509-mk-key KeyEd25519 c-capub

  anchor-key-wrong : Maybe X509Key = x509-mk-key KeyEd25519 c-capub-wrong

 An anchor is a name and a key. It is not a certificate: it is trusted
 because the operator put it there.

  mk-anchor : List Integer, Maybe X509Key -> List X509Anchor
  mk-anchor (nm) (k) =
    when k
      is None -> []
      is Just (kk) -> [X509Anchor { xa-subject = nm, xa-key = kk }]

  good-anchors : List X509Anchor = mk-anchor c-name anchor-key
  wrong-key-anchors : List X509Anchor = mk-anchor c-name anchor-key-wrong
  wrong-name-anchors : List X509Anchor = mk-anchor c-name-other anchor-key

  chain-of : Maybe X509Cert -> List X509Cert
  chain-of (m) = when m is None -> [] is Just (c) -> [c]

Section: Reporting

  verdict-name : X509Verdict -> Text
  verdict-name (v) =
    when v
      is ChainOk -> "Ok"
      is ChainEmpty -> "Empty"
      is ChainNotYetValid -> "NotYetValid"
      is ChainExpired -> "Expired"
      is ChainBadTime -> "BadTime"
      is ChainBadSignature -> "BadSignature"
      is ChainBrokenIssuer -> "BrokenIssuer"
      is ChainIssuerNotCa -> "IssuerNotCa"
      is ChainIssuerCannotSign -> "IssuerCannotSign"
      is ChainNoAnchor -> "NoAnchor"
      is ChainTooLong -> "TooLong"
      is ChainWrongIdentity -> "WrongIdentity"

  run : List X509Cert, List X509Anchor, List Integer -> Text
  run (chain) (anchors) (now) = verdict-name (x509-chain-verify chain anchors now)

Section: Cases

 The published chain, at a time inside its validity window. This is the
 only line here that should say Ok.

  r-ok : Text = "chain published=" & run (chain-of the-cert) good-anchors t-2020

 Before the certificate was issued, and after it expired. Told apart,
 because a certificate that is not valid yet is usually a wrong clock and
 one that has expired is usually an expired certificate.

  r-early : Text = "chain before-notbefore=" & run (chain-of the-cert) good-anchors t-2015
  r-late : Text = "chain after-notafter=" & run (chain-of the-cert) good-anchors t-2041

 One bit flipped inside the signed body. The signature no longer covers
 what is there.

  r-tampered : Text = "chain tampered-body=" & run (chain-of the-tampered) good-anchors t-2020

 The right name, the wrong key. This is the anchor substitution an active
 attacker wants: he cannot forge the signature, so he wants us to check it
 against a key he chose.

  r-wrong-key : Text = "chain anchor-wrong-key=" & run (chain-of the-cert) wrong-key-anchors t-2020

 The right key, under a name that does not match the issuer. A chain that
 reaches no anchor is refused; there is no lenient ending.

  r-wrong-name : Text = "chain anchor-wrong-name=" & run (chain-of the-cert) wrong-name-anchors t-2020

  r-no-anchors : Text = "chain no-anchors=" & run (chain-of the-cert) [] t-2020

  r-empty : Text = "chain empty=" & run [] good-anchors t-2020

 The certificate is not a CA, so it may not issue anything -- checked
 directly, because we have no second certificate to try to issue.

  r-not-ca : Text =
    "chain leaf-may-issue=" & (when the-cert is None -> "none" is Just (c) -> verdict-name (x509-issuer-ok c))

Section: Time Normalisation

 RFC 5280 4.1.2.5.1: a two-digit year of 50 or more is 19xx, and less than
 50 is 20xx. Backwards, a certificate from 1996 looks like one that expires
 in 2096.

  n-16 : List Integer =
    [49, 54, 48, 56, 48, 49, 49, 50, 49, 57, 50, 52, 90]

  n-96 : List Integer =
    [57, 54, 48, 56, 48, 49, 49, 50, 49, 57, 50, 52, 90]

  n-bad : List Integer =
    [49, 54, 48, 56, 48, 49, 49, 50, 49, 57, 50, 88, 52]

  norm-text : Maybe (List Integer) -> Text
  norm-text (m) =
    when m
      is None -> "rejected"
      is Just (bs) -> digits-text bs 0 (list-length bs) ""

  digits-text : List Integer, Integer, Integer, Text -> Text
  digits-text (bs) (i) (n) (acc) =
    if i >= n then acc
    else digits-text bs (i + 1) n (acc & digit-of (list-at bs i))

  digit-of : Integer -> Text
  digit-of (b) =
    when b - 48
      is 0 -> "0"
      is 1 -> "1"
      is 2 -> "2"
      is 3 -> "3"
      is 4 -> "4"
      is 5 -> "5"
      is 6 -> "6"
      is 7 -> "7"
      is 8 -> "8"
      is 9 -> "9"
      is otherwise -> "?"

  r-n16 : Text = "time utc-16=" & norm-text (x509-time-norm n-16)
  r-n96 : Text = "time utc-96=" & norm-text (x509-time-norm n-96)
  r-nbad : Text = "time non-digit=" & norm-text (x509-time-norm n-bad)

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni r-ok
    print-line-uni r-early
    print-line-uni r-late
    print-line-uni r-tampered
    print-line-uni r-wrong-key
    print-line-uni r-wrong-name
    print-line-uni r-no-anchors
    print-line-uni r-empty
    print-line-uni r-not-ca
    print-line-uni r-n16
    print-line-uni r-n96
    print-line-uni r-nbad
  end
