Chapter: VariantRecordArg2
  cites Foreword chapter Maybe

 Escalation: multiple distinct record types as payloads for
 different arms of the same variant, with many fields. Testing
 whether the compiler crashes on variant types with heterogeneous
 record payloads.

 We say:

Section: Multiple Record Types

  SmallRec = record {
    a-field : Integer,
    b-field : Integer
  }

  MediumRec = record {
    name : Text,
    value : Integer,
    score : Integer,
    active : Boolean
  }

  BigRec = record {
    id-num : Integer,
    label : Text,
    x-pos : Integer,
    y-pos : Integer,
    width : Integer,
    height : Integer,
    visible : Boolean,
    layer : Integer
  }

Section: Variant with different record payloads

  Shape =
    | ShapePoint (SmallRec)
    | ShapeBox (MediumRec)
    | ShapeFrame (BigRec)
    | ShapeNone

Section: Direct construction in when arms

  describe-shape : Shape -> Text
  describe-shape (s) =
    when s
      is ShapePoint (r) -> "Point: " & show (r.a-field) & "," & show (r.b-field)
      is ShapeBox (r) -> "Box: " & r.name & " val=" & show (r.value)
      is ShapeFrame (r) -> "Frame: " & r.label & " at " & show (r.x-pos) & "," & show (r.y-pos)
      is ShapeNone -> "None"

Section: Construct directly inside if/else

  make-shape : Integer -> Shape
  make-shape (kind) =
    if kind == 0 then ShapePoint (SmallRec { a-field = 1, b-field = 2 })
    else if kind == 1 then ShapeBox (MediumRec { name = "box", value = 42, score = 100, active = True })
    else if kind == 2 then ShapeFrame (BigRec { id-num = 7, label = "frame", x-pos = 10, y-pos = 20, width = 100, height = 50, visible = True, layer = 3 })
    else ShapeNone

Section: Nested — variant inside record inside variant

  Container = record {
    contents : Shape,
    count : Integer
  }

  Wrapper =
    | WrapSingle (Container)
    | WrapDouble (Container, Container)
    | WrapEmpty

  make-nested : Integer -> Wrapper
  make-nested (n) =
    let shape = make-shape n
    in let container = Container { contents = shape, count = 1 }
    in WrapSingle container

  make-nested-direct : Integer -> Wrapper
  make-nested-direct (n) =
    WrapSingle (Container { contents = make-shape n, count = 1 })

  opening : [Console] Nothing = act
    let s1 = make-shape 0
    in let s2 = make-shape 1
    in let s3 = make-shape 2
    in let d1 = describe-shape s1
    in let d2 = describe-shape s2
    in let d3 = describe-shape s3
    in let w = make-nested-direct 1
    in print-line-uni (d1 & " | " & d2 & " | " & d3)
  end

