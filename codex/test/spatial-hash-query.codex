Chapter: SpatialHashQuery
  cites Sim chapter SpatialHash

Section: Checks

  ids : List SpatialEntry, Integer, Integer -> Text
  ids (es) (i) (n) =
    if i >= n then ""
    else (if i == 0 then "" else " ") & show ((list-at es i).she-id) & ids es (i + 1) n

  found : SpatialHash, Integer, Integer -> Text
  found (sh) (x) (y) =
    let es = spatial-hash-query sh x y
    in "[" & ids es 0 (list-length es) & "]"

  filled : SpatialHash
  filled = spatial-hash-insert-all (spatial-hash-new 10) [
    SpatialEntry { she-id = 1, she-x = 5, she-y = 5 },
    SpatialEntry { she-id = 2, she-x = 15, she-y = 5 },
    SpatialEntry { she-id = 3, she-x = 95, she-y = 95 },
    SpatialEntry { she-id = 4, she-x = 6, she-y = 7 },
    SpatialEntry { she-id = 6, she-x = 25, she-y = 5 }
  ]

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (found filled 5 5)
    print-line-uni (found filled 95 95)
    print-line-uni (found filled 55 55)
    print-line-uni (found filled 35 5)
    print-line-uni (show (filled.sh-cell-count))
    print-line-uni (found (spatial-hash-clear filled) 5 5)
  end
