Chapter: OtaUpdateTest
  cites Foreword chapter OtaUpdate

Section: Body

  opening : [Console] Nothing = act
   let v1 = OtaVersion { sequence = 1, hash = [], timestamp = 1000 }
   in let v2 = OtaVersion { sequence = 2, hash = [], timestamp = 2000 }
   in let manifest = OtaManifest { firmware-uri = "https://ota.codex.dev/fw.cdx", firmware-size = 65536, firmware-hash = [], version = v2, min-battery = 20, requires-reboot = True }
   in let progress = OtaProgress { bytes-received = 32768, bytes-total = 65536, blocks-verified = 8 }
   in let boot = BootConfig { active-slot = SlotA, slot-a-version = v1, slot-b-version = v2, slot-a-verified = True, slot-b-verified = True }
   in act
    print-line-uni ("newer=" & if ota-version-is-newer v2 v1 then "yes" else "no")
    print-line-uni ("progress=" & format-ota-progress progress)
    print-line-uni ("inactive=" & boot-slot-name (ota-inactive-slot boot))
    print-line-uni ("can-activate=" & if ota-can-activate boot SlotB then "yes" else "no")
    print-line-uni ("gate-a=" & when gate-a-check-magic [67, 68, 88, 0] is GateAPass -> "pass" is otherwise -> "fail")
    print-line-uni (ota-state-name OtaIdle)
    print-line-uni (ota-state-name (OtaFailed "timeout"))
   end
  end

