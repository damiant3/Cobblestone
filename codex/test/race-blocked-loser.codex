Chapter: RaceBlockedLoser
  cites Foreword chapter Console

Section: Helpers

  blocked-loop : Integer, Integer -> Integer
  blocked-loop (i) (acc) =
    if i <= 0 then acc
    else let t = fork (\x -> i)
    in let v = race [\x -> 1, \x -> await t]
    in let w = await t
    in blocked-loop (i - 1) (acc + v + w)

  fork-loop : Integer, Integer -> Integer
  fork-loop (i) (acc) =
    if i <= 0 then acc
    else let t = fork (\x -> i * 10)
    in let v = await t
    in fork-loop (i - 1) (acc + v)

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("blocked: " & show (blocked-loop 2000 0))
    print-line-uni ("after: " & show (fork-loop 100 0))
  end

