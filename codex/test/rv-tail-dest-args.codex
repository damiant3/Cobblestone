Chapter: Rv Tail Dest Args
  cites Foreword chapter Console

Section: Body

  join4 : Integer, Integer, Integer, Text -> Text
  join4 (a) (b) (c) (acc) = acc & show a & show b & show c & ";"

  loop : Integer, Text -> Text
  loop (k) (acc) =
    if k >= 3 then acc
    else loop (k + 1) (join4 0 (int-mod k 4) (list-at [5, 6, 7] k) acc)

  opening : [Console] Nothing = act
    print-line-uni (loop 0 "")
  end