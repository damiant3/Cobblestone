Chapter: NvGspWprTest
  cites Kernel chapter NvGspWpr
  cites Foreword chapter Format

 The expected output is tinygrad's own init_wpr_meta, run by Python:
 build/nv-gsp-wpr-oracle.ps1.

Section: Main

  hex-bytes : List Integer, Integer, Text -> Text
  hex-bytes (bs) (i) (acc) = if i >= list-length bs then acc else hex-bytes bs (i + 1) (acc & fmt-hex-pad (list-at bs i) 2)

  inputs : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> GspWprInputs
  inputs (vr) (bs) (rs) (ba) (ra) (sa) (co) (dof) (mo) = GspWprInputs { vram-size = vr, boot-size = bs, radix3-size = rs, boot-addr = ba, radix3-addr = ra, signature-addr = sa, code-offset = co, data-offset = dof, manifest-offset = mo }

  line : Integer, GspWprInputs -> Text
  line (k) (w) =
    let bs = nv-gsp-wpr-meta w
    in "W " & show k & " " & show (list-length bs) & " " & hex-bytes bs 0 ""

  opening : [Console] Nothing = act
   print-line-uni (line 0 (inputs #400000000 #28E00 #2B3C123 #100000000 #200000000 #300000000 #100 #2800 #28000))
   print-line-uni (line 1 (inputs #200000000 #1234 #10 #1000 #2000 #3000 0 0 0))
   print-line-uni (line 2 (inputs #2FFF00000 #FFFFF #7FFFFFF #ABCDEF000 #123456000 #FEDCBA000 #40 #80 #C0))
  end
