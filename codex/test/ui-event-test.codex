Chapter: UiEventTest
  cites Codex chapter General
  cites UI chapter Theme
  cites UI chapter BoxModel
  cites UI chapter Layout
  cites UI chapter Widget
  cites UI chapter Event

Section: Body

  test-event-kind : Text =
    let ev = event-key-down 65 0 100
    in event-kind-name (ev.ev-kind)

  test-mouse-event : Text =
    let ev = event-mouse-down 50 30 0 200
    in let name = event-kind-name (ev.ev-kind)
    in let is-m = event-is-mouse (ev.ev-kind)
    in let is-k = event-is-keyboard (ev.ev-kind)
    in "kind=" & name & " mouse=" & ev-bool is-m & " kb=" & ev-bool is-k

  test-stop : Text =
    let ev = event-key-down 13 0 300
    in let stopped = event-stop ev
    in "stopped=" & ev-bool (stopped.ev-stopped)

  test-retarget : Text =
    let ev = event-mouse-down 10 10 0 400
    in let targeted = event-retarget ev "btn1"
    in "target=" & targeted.ev-target

  test-handler-table : Text =
    let ht = handler-table-new
    in let ht2 = handler-table-add ht "btn1" "mousedown" 42
    in let found = handler-table-lookup ht2 "btn1" "mousedown"
    in let missing = handler-table-lookup ht2 "btn1" "keydown"
    in let f = when found is Just (h) -> show (h.eh-action) is None -> "none"
    in let m = when missing is Just (h) -> show (h.eh-action) is None -> "none"
    in "found=" & f & " missing=" & m

  test-hit-widget : Text =
    let btn = widget-set-bounds (widget-button "b1" "Click") (layout-rect 10 10 80 30)
    in let panel = widget-panel "root" DirRow 0 [btn]
    in let panel2 = widget-set-bounds panel (layout-rect 0 0 200 100)
    in let target = event-target-from-mouse panel2 25 20
    in "target=" & target

  test-event-path : Text =
    let lbl = widget-set-bounds (widget-label "title" "Hi") (layout-rect 0 0 50 20)
    in let btn = widget-set-bounds (widget-button "ok" "OK") (layout-rect 0 20 50 30)
    in let panel = widget-set-bounds (widget-panel "root" DirColumn 0 [lbl, btn]) (layout-rect 0 0 200 100)
    in let path = event-path-to panel "ok"
    in "len=" & show (path.ep-count)

  test-format : Text =
    let ev = event-custom "update" 99 500
    in format-event ev

  ev-bool : Boolean -> Text
  ev-bool (b) = if b then "true" else "false"

  opening : [Console] Nothing = act
    print-line-uni test-event-kind
    print-line-uni test-mouse-event
    print-line-uni test-stop
    print-line-uni test-retarget
    print-line-uni test-handler-table
    print-line-uni test-hit-widget
    print-line-uni test-event-path
    print-line-uni test-format
  end

