Chapter: AndGuardsIndex
  cites Foreword chapter Console

Section: Entry

  next-is : Text, Integer, Integer -> Boolean
  next-is (s) (i) (c) = i + 1 < text-length s & char-code (char-at s (i + 1)) == c

  past-or : List Integer, Integer -> Boolean
  past-or (xs) (i) = i >= list-length xs | list-at xs i == 0

  opening : [Console] Nothing = act
    print-line-uni ("and-last=" & (if next-is "ab" 1 7 then "yes" else "no"))
    print-line-uni ("and-mid=" & (if next-is "ab" 0 (char-code (char-at "b" 0)) then "yes" else "no"))
    print-line-uni ("or-end=" & (if past-or [1, 2, 3] 3 then "yes" else "no"))
    print-line-uni ("or-mid=" & (if past-or [1, 0, 3] 1 then "yes" else "no"))
  end

