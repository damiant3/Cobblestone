Chapter: AtomicSmokeTest
  cites Foreword chapter Console

Section: Body

  test-fence : Text =
    let x = memory-fence 0
    in "fence=ok"

  test-atomic-ops : Text =
    let addr = address-of 0
    in let s = atomic-store addr 42
    in let v = atomic-load addr
    in "load-after-store=" & show v

  test-cas : Text =
    let addr = address-of 0
    in let s = atomic-store addr 50
    in let ok = atomic-cas addr 50 60
    in "cas=" & show ok

  test-xchg : Text =
    let addr = address-of 0
    in let s = atomic-store addr 77
    in let old = atomic-exchange addr 88
    in "xchg=" & show old

  test-xadd : Text =
    let addr = address-of 0
    in let s = atomic-store addr 100
    in let old = atomic-add addr 5
    in "xadd=" & show old

  opening : [Console] Nothing = act
    print-line-uni test-fence
    print-line-uni test-atomic-ops
    print-line-uni test-cas
    print-line-uni test-xchg
    print-line-uni test-xadd
  end
