Chapter: HandlerZeroArgFn
  cites Foreword chapter Console

Section: Effects

  effect Dev where
    dfn : [Dev] (Integer -> Integer)
    dput : Integer -> [Dev] Integer

Section: Body

  bound : Integer -> [Dev] Integer
  bound (n) = act
    f <- dfn
    f n
  end

  direct : Integer -> [Dev] Integer
  direct (n) = dfn n

  unary : Integer -> [Dev] Integer
  unary (n) = dput n

  run : Integer, Integer -> [Console] Integer
  run (which) (n) = act
    with Dev (if which == 0 then bound n else if which == 1 then direct n else unary n)
      dfn (resume) = act
        print-line-uni "clause dfn"
        resume (\x -> x * 3)
      end
      dput (v) (resume) = resume (v * 2)
  end

  opening : [Console] Nothing = act
    print-line-uni ("bound " & show (run 0 5))
    print-line-uni ("direct " & show (run 1 7))
    print-line-uni ("unary " & show (run 2 4))
  end
