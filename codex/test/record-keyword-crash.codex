Chapter: RecordKeywordCrash
  cites Foreword chapter Maybe

 Escalation: a record with 'effect' as a field name, wrapped in
 a variant, with many other fields. Trying to reproduce the GPF
 in is-record-keyword.

 We say:

Section: Big record with keyword field

  BigSession = record {
    session-id : Integer,
    parent-game : Integer,
    parent-match : Integer,
    subgame-id : Integer,
    player-a : Integer,
    player-b : Integer,
    status : Integer,
    result : Integer,
    effect : Integer,
    created-at : Integer,
    resolved-at : Integer
  }

  SessionHolder =
    | ActiveSession (BigSession)
    | NoSession

  make-session : Integer, Integer -> SessionHolder
  make-session (id) (eff) =
    ActiveSession (BigSession { session-id = id, parent-game = 1, parent-match = 2, subgame-id = 3, player-a = 10, player-b = 20, status = 0, result = 0, effect = eff, created-at = 100, resolved-at = 0 })

  get-effect : SessionHolder -> Integer
  get-effect (holder) =
    when holder
      is ActiveSession (s) -> s.effect
      is NoSession -> 0

  update-session : BigSession -> BigSession
  update-session (s) =
    BigSession { session-id = s.session-id, parent-game = s.parent-game, parent-match = s.parent-match, subgame-id = s.subgame-id, player-a = s.player-a, player-b = s.player-b, status = 1, result = s.result, effect = s.effect, created-at = s.created-at, resolved-at = 999 }

  opening : [Console] Nothing = act
    let holder = make-session 1 42
    in let eff = get-effect holder
    in print-line-uni (show eff)
  end

