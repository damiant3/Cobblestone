Chapter: ProbeTvarInDeclared
  cites Foreword chapter Console

Section: Types

  Pair (a) = record { fst : a, snd : a }

Section: Functions

  pair-swap : Pair a -> Pair a
  pair-swap (p) = Pair { fst = p.snd, snd = p.fst }

Section: Entry

  opening : [Console] Nothing
  opening = act
   let q = pair-swap (Pair { fst = 3, snd = 7 })
   in print-line-uni (show (q.fst * 10 + q.snd))
  end
