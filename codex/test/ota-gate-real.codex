Chapter: OtaGateReal
  cites Foreword chapter OtaUpdate
  cites Foreword chapter Console

 Test OTA Gate A against the real CDX magic bytes (CDX1 = 67 68 88 49)
 and verify rejection of non-CDX payloads.

Section: Body

  opening : [Console] Nothing = act
   let real-cdx = [67, 68, 88, 49, 0, 0, 0, 0]
   in let elf-magic = [127, 69, 76, 70]
   in let pe-magic = [77, 90, 0, 0]
   in let truncated = [67, 68]
   in let empty = []
   in let gate-cdx = gate-a-check-magic real-cdx
   in let gate-elf = gate-a-check-magic elf-magic
   in let gate-pe = gate-a-check-magic pe-magic
   in let gate-short = gate-a-check-magic truncated
   in let gate-empty = gate-a-check-magic empty
   in act
    print-line-uni ("CDX1: " & when gate-cdx is GateAPass -> "pass" is otherwise -> "fail")
    print-line-uni ("ELF: " & when gate-elf is GateAPass -> "pass" is GateAFailMagic -> "reject-magic" is otherwise -> "other")
    print-line-uni ("PE: " & when gate-pe is GateAPass -> "pass" is GateAFailMagic -> "reject-magic" is otherwise -> "other")
    print-line-uni ("truncated: " & when gate-short is GateAFailTruncated -> "reject-truncated" is otherwise -> "other")
    print-line-uni ("empty: " & when gate-empty is GateAFailTruncated -> "reject-truncated" is otherwise -> "other")
   end
  end

