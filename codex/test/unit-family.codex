Chapter: UnitFamily
  cites Foreword chapter Console

Section: Types

  Length = unit family Millimeter
    Millimeter = 1
    Centimeter = 10
    Meter = 1000
    Kilometer = 1000000

Section: Functions

  perimeter : Length, Length -> Length
  perimeter (w) (h) = (w + h) * 2

  double-length : Length -> Length
  double-length (x) = x * 2

Section: Body

  opening : [Console] Nothing = act
    let w = Centimeter 20
    in let h = Meter 1
    in let p = perimeter w h
    in act
      print-line-uni (show p)
      print-line-uni (show (Length-to-Centimeter p))
      print-line-uni (show (Length-to-Meter p))
      print-line-uni (show (double-length (Millimeter 50)))
    end
  end

