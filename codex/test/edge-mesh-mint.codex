Chapter: EdgeMeshMintTest

  cites Foreword chapter Console
  cites Engine chapter EdgeMesh
  cites Mesh chapter EdgeMeshRewards
  cites Mesh chapter EdgeMeshMint
  cites CodexMagic chapter ChainCore
  cites CodexMagic chapter TransactionValidator

 EdgeMeshGameServers phase 4, stage 4. Every refusal arm asserts the BALANCE as
 well as the answer, because a guard that credits and then rolls back on a
 refusal answers exactly the same words and leaves a different ledger.

 This arm is also the first thing in the tree ever to RUN `ChainCore`.

 EVERY SCENARIO BUILDS ITS OWN LEDGER (L-ALIAS).

Section: Fixtures

  platform : Integer = 42

  two-planes : Integer -> Ledger
  two-planes (dummy) = ledger-open (ledger-open ledger-new "codexmagic") "chess"

  prize : Integer -> MatchReward
  prize (dummy) = compute-reward 1600 1500 True

  good-tx : Integer -> ChainTx
  good-tx (dummy) = mesh-reward-tx platform 7 65 1 100 0

Section: Entry

  opening : [Console] Nothing
  opening = act
    let chain = chain-new 0
    in act
      act
        let o = guarded-settle chain platform (two-planes 0) 1 "codexmagic" "chess" (prize 0) (good-tx 0)
        in print-line-uni ("a signed reward from the platform key: " & mint-label o & ", codexmagic " & show (ledger-balance (mint-ledger o) "codexmagic"))
      end

      act
        let o = guarded-settle chain platform (two-planes 0) 2 "codexmagic" "chess" (prize 0) (mesh-reward-tx platform 7 20000 1 100 0)
        in print-line-uni ("a reward above the bound: " & mint-label o & ", codexmagic " & show (ledger-balance (mint-ledger o) "codexmagic"))
      end

      act
        let o = guarded-settle chain platform (two-planes 0) 3 "codexmagic" "chess" (prize 0) (mesh-reward-tx 99 7 65 1 100 0)
        in print-line-uni ("a reward from another key: " & mint-label o & ", codexmagic " & show (ledger-balance (mint-ledger o) "codexmagic"))
      end

      act
        let o = guarded-settle chain platform (two-planes 0) 4 "codexmagic" "chess" (prize 0) (mesh-reward-tx platform 7 65 1 100 7)
        in print-line-uni ("a badly signed reward: " & mint-label o & ", codexmagic " & show (ledger-balance (mint-ledger o) "codexmagic"))
      end

      act
        let o = guarded-settle chain platform (two-planes 0) 5 "codexmagik" "chess" (prize 0) (good-tx 0)
        in print-line-uni ("a valid reward for a plane with no wallet: " & mint-label o & ", codexmagic " & show (ledger-balance (mint-ledger o) "codexmagic"))
      end

      act
        let first = guarded-settle chain platform (two-planes 0) 6 "codexmagic" "chess" (prize 0) (good-tx 0)
        in let again = guarded-settle chain platform (mint-ledger first) 6 "codexmagic" "chess" (prize 0) (good-tx 0)
        in print-line-uni ("the same match behind the guard twice: " & mint-label again & ", codexmagic " & show (ledger-balance (mint-ledger again) "codexmagic"))
      end
    end
  end
