Chapter: PropArith

Section: Claims

  claim lit-control : 2 === 2
  proof lit-control = Refl
  qed

  claim add : 1 + 1 === 2
  proof add = Refl
  qed

  claim sub : 5 - 3 === 2
  proof sub = Refl
  qed

  claim mul : 2 * 3 === 6
  proof mul = Refl
  qed

  claim divide : 8 / 4 === 2
  proof divide = Refl
  qed

  claim nested : 1 + 2 + 3 === 6
  proof nested = Refl
  qed

  claim precedence : 1 + 2 * 3 === 7
  proof precedence = Refl
  qed

Section: Signed Literals

  claim bare-neg : -2 === -2
  proof bare-neg = Refl
  qed

  claim sub-neg : 1 - 3 === -2
  proof sub-neg = Refl
  qed

  claim zero-sub : 0 - 5 === -5
  proof zero-sub = Refl
  qed

  claim neg-operand : -2 + 5 === 3
  proof neg-operand = Refl
  qed

  claim neg-mul : -2 * 3 === -6
  proof neg-mul = Refl
  qed

Section: Main

  opening : [Console] Nothing
  opening = act
   print-line-uni "prop-arith ok"
  end
