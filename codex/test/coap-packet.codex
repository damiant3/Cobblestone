Chapter: CoapPacketTest
  cites Encode chapter Coap

 Verify CoAP packet builders produce correct wire lengths.

Section: Body

  opening : [Console] Nothing = act
   let get = coap-get 1 [#AA] "temperature"
   in let post = coap-post 2 [#BB] "actuator" [1, 2, 3]
   in let ack = coap-ack 1
   in act
    print-line-uni ("GET len=" & show (list-length get))
    print-line-uni ("POST len=" & show (list-length post))
    print-line-uni ("ACK len=" & show (list-length ack))
   end
  end

