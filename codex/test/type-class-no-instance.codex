Chapter: TypeClassNoInstance
  cites Foreword chapter Console

class Showable where
  to-text : a -> Text

instance Showable Integer where
  to-text (x) = show x

instance Showable Text where
  to-text (s) = s

Section: Opening

  opening : [Console] Nothing
  opening = act
   print-line-uni (to-text True)
  end
