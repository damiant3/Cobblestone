Chapter: CheckEmptyFidelityLifetime
  cites Codex chapter Opening

  probe-source : Text = "Chapter: MeasureSimple\n  opening : Integer\n  opening = 7\n"

  opening : [Console] Nothing =
    let init = init-phase-allocator
    in let trace-flags = __record-set compile-flags-default "phase-trace" True
    in let flags = __record-set trace-flags "escape-check" True
    in let checked = compile-checked probe-source "MeasureSimple" flags
    in if bag-has-errors (checked.bag) then print-line-uni "FAIL diagnostics"
       else if list-length (checked.ust.fid-types) /= 0 then print-line-uni "FAIL fidelity list"
       else print-line-uni "PASS retained empty fidelity list"
