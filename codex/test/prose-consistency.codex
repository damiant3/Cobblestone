Chapter: ProseConsistency
  cites Foreword chapter Console

 Tests for CPL prose features: template classification, transition
 markers, bracket notation, banned-word enforcement, and
 prose-notation consistency checking.

 An Account is a record containing:
 - balance : Integer
 - name : Text

Section: Types

  Account = record {
    balance : Integer,
    name : Text
  }

  Status = | Active | Closed

 To make-account (name) (amount) gives an Account:

Section: Functions

  make-account : Text, Integer -> Account
  make-account (name) (amount) = Account { balance = amount, name = name }

 such that the balance is always the given amount.

 To show-account (acct) gives a Text:

  show-account : Account -> Text
  show-account (acct) = acct.name & ":" & show (acct.balance)

 For every Account, the name is a non-empty text.

  show-status : Status -> Text
  show-status (s) = when s
    is Active -> "active"
    is Closed -> "closed"

 [layout] A memory map for the account structure:
 [0] balance   i64
 [8] name      ptr

  account-size : Integer
  account-size = 16

  sum-balances : List Account, Integer, Integer -> Integer
  sum-balances (accounts) (i) (acc) =
    if i >= list-length accounts then acc
    else sum-balances accounts (i + 1) (acc + (list-at accounts i).balance)

Section: Body

  opening : [Console] Nothing = act
    let a1 = make-account "Alice" 100
    in let a2 = make-account "Bob" 250
    in act
      print-line-uni (show-account a1)
      print-line-uni (show-account a2)
      print-line-uni ("size=" & show account-size)
      print-line-uni ("status=" & show-status Active)
      print-line-uni ("total=" & show (sum-balances [a1, a2] 0 0))
    end
  end

