Chapter: WcetBudgetUnchecked
  cites Foreword chapter Console

Section: Punctual Functions

  punctual 2 budget-absorbed : Integer -> Integer
  budget-absorbed (n) = n + 1

  punctual no-budget-absorbed : Integer -> Integer
  no-budget-absorbed (n) = n + 2

  punctual 64 budget-survives : Integer -> Integer
  budget-survives (n) =
    let a = bit-and n 255
    in let b = bit-or a 16
    in min (b + 3) 200

Section: Entry

  opening : [Console] Nothing
  opening = act
    print-line-uni ("absorbed: " & show (budget-absorbed 41))
    print-line-uni ("nobudget: " & show (no-budget-absorbed 41))
    print-line-uni ("survives: " & show (budget-survives 41))
  end
