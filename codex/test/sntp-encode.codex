Chapter: SntpEncodeTest

  cites Encode chapter Sntp

 Exercise SNTP: client request layout (48 bytes, client mode/version),
 transmit-timestamp placement and round-trip, and the NTP/Unix epoch
 conversion. opening returns the count of passing checks.

Section: Helpers

  bytes-eq : List Integer, List Integer -> Boolean
  bytes-eq (a) (b) =
   if list-length a /= list-length b then False
   else bytes-eq-loop a b 0 (list-length a)

  bytes-eq-loop : List Integer, List Integer, Integer, Integer -> Boolean
  bytes-eq-loop (a) (b) (i) (len) =
   if i >= len then True
   else if list-at a i /= list-at b i then False
   else bytes-eq-loop a b (i + 1) len

  flag : Boolean -> Integer
  flag (b) = if b then 1 else 0

Section: Checks

  check-length-flag : Integer
  check-length-flag =
   let req = sntp-build-request #E1E2E3E4
   in flag (if list-length req == 48 then list-at req 0 == 35 else False)

  check-transmit-field : Integer
  check-transmit-field =
   let req = sntp-build-request #E1E2E3E4
   in flag (bytes-eq [list-at req 40, list-at req 41, list-at req 42, list-at req 43] [225, 226, 227, 228])

  check-roundtrip : Integer
  check-roundtrip =
   flag (sntp-transmit-seconds (sntp-build-request #E1E2E3E4) == #E1E2E3E4)

  check-mode-version : Integer
  check-mode-version =
   let req = sntp-build-request 0
   in flag (if sntp-mode req == 3 then sntp-version req == 4 else False)

  check-epoch : Integer
  check-epoch =
   flag (if sntp-ntp-to-unix 2208988800 == 0 then sntp-unix-to-ntp 0 == 2208988800 else False)

  opening : Integer =
   let a = check-length-flag
   in let b = check-transmit-field
   in let c = check-roundtrip
   in let d = check-mode-version
   in let e = check-epoch
   in a + b + c + d + e
