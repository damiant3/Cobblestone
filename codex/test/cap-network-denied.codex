Chapter: CapNetworkDenied

Section: Body

  proc0-cap-addr : Integer = 20536

  strip-grant : Integer -> Integer
  strip-grant (x) =
    let lo = poke-32 proc0-cap-addr 0 0
    in let hi = poke-32 proc0-cap-addr 4 0
    in 0

  opening : [Console, Network.Read] Nothing = act
    before <- net-status
    print-line-uni ("granted: " & show before)
    print-line-uni ("stripped: " & show (strip-grant 0))
    after <- net-status
    print-line-uni ("denied: " & show after)
  end
