Chapter: Over Apply Closure

  cites Codex chapter Text



Section: Definitions



  make-adder : Integer, Integer -> Integer

  make-adder (x) (y) = x + y



  make-scaler : Integer, Integer -> Integer

  make-scaler (factor) (x) = factor * x



  chain : Integer -> Integer

  chain (n) =

   let double = make-scaler 2

   in let triple = make-scaler 3

   in triple (double n)



  over-apply-curried : Integer

  over-apply-curried =

   let f = make-adder 10

   in f 5



  three-deep : Integer, Integer, Integer -> Integer

  three-deep (a) (b) (c) = a + b + c



  over-two : Integer

  over-two =

   let partial = three-deep 1 2

   in partial 3



  over-one : Integer

  over-one =

   let partial = three-deep 1

   in partial 2 3



  opening : [Console] Nothing =

   let r1 = chain 4

   in let r2 = over-apply-curried

   in let r3 = over-two

   in let r4 = over-one

   in act

    print-line-uni (integer-to-text r1)

    print-line-uni (integer-to-text r2)

    print-line-uni (integer-to-text r3)

    print-line-uni (integer-to-text r4)

   end



