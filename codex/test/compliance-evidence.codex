Chapter: ComplianceEvidenceTest

  cites Foreword chapter ComplianceEvidence

Section: Definitions

  test-class-names : Integer
  test-class-names =
    let a = evidence-class-name ByConstruction
    in let b = evidence-class-name Mechanism
    in let c = evidence-class-name Deployment
    in let d = evidence-class-name Organizational
    in let ok-a = if a == "BY-CONSTRUCTION" then 1 else 0
    in let ok-b = if b == "MECHANISM" then 1 else 0
    in let ok-c = if c == "DEPLOYMENT" then 1 else 0
    in let ok-d = if d == "ORGANIZATIONAL" then 1 else 0
    in ok-a + ok-b + ok-c + ok-d

  test-format-requirement : Integer
  test-format-requirement =
    let r = Requirement { regulation = "CRA", section = "1.1", title = "Test", class = ByConstruction, mechanism = "linear types", artifact = "compile-log" }
    in let formatted = format-requirement r
    in if text-length formatted > 0 then 1 else 0

  test-count-by-class : Integer
  test-count-by-class =
    let bc = count-by-class cra-requirements ByConstruction 0 0
    in let mech = count-by-class cra-requirements Mechanism 0 0
    in let ok-bc = if bc > 0 then 1 else 0
    in let ok-mech = if mech > 0 then 1 else 0
    in ok-bc + ok-mech

  test-report : Integer
  test-report =
    let report = generate-evidence-report
    in if text-length report > 0 then 1 else 0

  opening : Integer =
    let cn = test-class-names
    in let fr = test-format-requirement
    in let cc = test-count-by-class
    in let rp = test-report
    in cn + fr + cc + rp

