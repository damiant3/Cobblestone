Chapter: QmkViaPacketsTest
  cites Dev chapter QmkProtocol
  cites Dev chapter KeyboardRgb

Section: Entry
  qv-bytes : List Integer, Integer, Integer -> Text
  qv-bytes (xs) (i) (n) =
    if i >= n then ""
    else (if i == 0 then "" else " ") & show (list-at xs i) & qv-bytes xs (i + 1) n

  qv : Text, List Integer, Integer -> Text
  qv (name) (pkt) (n) = name & " " & qv-bytes pkt 0 n & " len " & show (list-length pkt)

  opening : [Console] Nothing = act
    print-line-uni (qv "protocol" via-cmd-protocol-version 4)
    print-line-uni (qv "get-mode" via-cmd-rgb-get-mode 4)
    print-line-uni (qv "get-color" via-cmd-rgb-get-color 4)
    print-line-uni (qv "get-speed" via-cmd-rgb-get-speed 4)
    print-line-uni (qv "get-brightness" via-cmd-rgb-get-brightness 4)
    print-line-uni (qv "set-mode-solid" (via-cmd-rgb-set-mode rgb-effect-solid) 5)
    print-line-uni (qv "set-mode-off" (via-cmd-rgb-set-mode rgb-effect-off) 5)
    print-line-uni (qv "set-mode-board-23" (via-cmd-rgb-set-mode 23) 5)
    print-line-uni (qv "set-color-180" (via-cmd-rgb-set-color 180 255) 6)
    print-line-uni (qv "set-color-359" (via-cmd-rgb-set-color 359 10) 6)
    print-line-uni (qv "set-color-360" (via-cmd-rgb-set-color 360 0) 6)
    print-line-uni (qv "set-speed" (via-cmd-rgb-set-speed 64) 5)
    print-line-uni (qv "set-brightness" (via-cmd-rgb-set-brightness 200) 5)
    print-line-uni (qv "save" via-cmd-rgb-save 4)
    print-line-uni (qv "ocean-color" (kbd-rgb-color-cmd (kbd-rgb-set-palette keyboard-rgb-new PalOcean)) 6)
    print-line-uni ("version " & show (via-parse-protocol-version [1, 0, 13]) & " " & show (via-parse-protocol-version [1, 1, 2]) & " " & show (via-parse-protocol-version [255, 0, 13]) & " " & show (via-parse-protocol-version [1, 0]))
    print-line-uni ("mode " & rgb-effect-label (via-parse-rgb-mode [8, 3, 2, 1]) & " / " & rgb-effect-label (via-parse-rgb-mode [255, 3, 2, 1]) & " / " & rgb-effect-label (via-parse-rgb-mode [8, 3, 2, 23]))
    print-line-uni ("color " & format-rgb-state (via-parse-rgb-color qmk-rgb-default [8, 3, 4, 128, 100]))
    print-line-uni ("color-unhandled " & format-rgb-state (via-parse-rgb-color qmk-rgb-default [255, 3, 4, 128, 100]))
    print-line-uni ("speed " & show (via-parse-rgb-speed [8, 3, 3, 77]) & " " & show (via-parse-rgb-speed [8]) & " brightness " & show (via-parse-rgb-brightness [8, 3, 1, 99]))
    print-line-uni (format-firmware-info (qmk-firmware-info 11 1234 5678))
    print-line-uni (format-firmware-info (qmk-firmware-info 10 1234 5678))
    lb <- keyboard-rgb-connect keyboard-rgb-new (hid-device-new 0 0 0) (qmk-firmware-info-on 11 1 2 (via-channel-from-lighting "qmk_rgblight"))
    print-line-uni (qv "rgblight-mode" (kbd-rgb-mode-cmd lb) 5)
    print-line-uni (qv "rgblight-color" (kbd-rgb-color-cmd lb) 6)
    print-line-uni (qv "rgblight-speed" (kbd-rgb-speed-cmd lb) 5)
    print-line-uni (qv "rgblight-brightness" (kbd-rgb-brightness-cmd lb) 5)
    print-line-uni (qv "rgblight-save" (kbd-rgb-save-cmd lb) 4)
    print-line-uni (qv "rgblight-get-mode" (via-light-get via-channel-rgblight via-value-effect) 4)
    print-line-uni (qv "matrix-save" (kbd-rgb-save-cmd keyboard-rgb-new) 4)
    print-line-uni ("channels " & show (via-channel-from-lighting "qmk_rgblight") & " " & show (via-channel-from-lighting "qmk_rgb_matrix") & " " & show (via-channel-from-lighting "qmk_backlight"))
    print-line-uni (format-firmware-info (qmk-firmware-info-on 11 1 2 (via-channel-from-lighting "qmk_backlight")))
  end
