Chapter: Proofs
  cites Foreword chapter Console

Section: Simple Proofs

  claim id-nil : Nil === Nil
  proof id-nil = Refl

  claim id-sym : Nil === Nil
  proof id-sym = sym Refl

  claim chain : 5 === 5
  proof chain = trans Refl Refl

Section: Typed Proofs — verified by unifier

  nil-eq : Nil === Nil
  nil-eq = Refl

  wrap-proof : Proof
  wrap-proof = assume

  field-proof : Integer -> Proof
  field-proof (x) = assume

Section: Parametric Proofs

  claim wrap-nil : List Nil === List Nil
  proof wrap-nil = assume

  claim list-id (xs) : xs === xs
  proof list-id (xs) = assume

  claim rev-nil : reverse (reverse Nil) === Nil
  proof rev-nil = assume

  claim rev-cons (head) (tail) : reverse (reverse (Cons head tail)) === Cons head tail
  proof rev-cons (head) (tail) = assume

  claim rev-rev (xs) : reverse (reverse xs) === xs
  proof rev-rev (xs) = assume

  claim plus-identity (n) : (n + 0) === n
  proof plus-identity (n) = assume

Section: Entry Point
  opening : [Console] Nothing = act
    print-line-uni "proofs-ok"
  end

