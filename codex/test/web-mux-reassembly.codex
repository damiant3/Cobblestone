 We say:

Section: Wire Fixtures
  srv-mac : List Integer = [82, 84, 0, 18, 52, 86]
  cli-mac : List Integer = [82, 85, 10, 0, 2, 2]
  srv-ip : List Integer = [10, 0, 2, 15]
  a-ip : List Integer = [10, 0, 2, 100]
  b-ip : List Integer = [10, 0, 2, 101]

  get-partial : List Integer = [71, 69, 84, 32, 47, 32, 72, 84, 84, 80, 47, 49, 46, 49, 13, 10, 72, 111, 115, 116, 58, 32, 120, 13, 10]
  get-rest : List Integer = [13, 10]
  post-hdr : List Integer = [80, 79, 83, 84, 32, 47, 120, 32, 72, 84, 84, 80, 47, 49, 46, 49, 13, 10, 67, 111, 110, 116, 101, 110, 116, 45, 76, 101, 110, 103, 116, 104, 58, 32, 53, 13, 10, 13, 10]
  post-body : List Integer = [104, 101, 108, 108, 111]

  psh : Integer = bit-or tcp-flag-psh tcp-flag-ack

  mk : Integer, List Integer, Integer, Integer, List Integer -> List Integer
  mk (src-port) (src-ip) (seq) (flags) (payload) = mk-acking src-port src-ip seq 5000 flags payload

  mk-acking : Integer, List Integer, Integer, Integer, Integer, List Integer -> List Integer
  mk-acking (src-port) (src-ip) (seq) (ack) (flags) (payload) =
    let seg = tcp-with-checksum (tcp-build-segment src-port 80 seq ack flags 8192 payload) src-ip srv-ip
    in let ip = ip-build-packet src-ip srv-ip ip-proto-tcp seg
    in eth-build-frame srv-mac cli-mac eth-type-ipv4 ip

  server-next : WebMux -> Integer
  server-next (m) = ((((list-at (m.conns) (list-length (m.conns) - 1)).transport).session).conn).send-next

  a-syn : List Integer = mk 50000 a-ip 1000 tcp-flag-syn []
  a-rest : List Integer = mk 50000 a-ip 1026 psh get-rest

  b-syn : List Integer = mk 50001 b-ip 2000 tcp-flag-syn []
  b-body : List Integer = mk 50001 b-ip 2040 psh post-body

Section: Route
  test-route : HttpRequest -> HttpResponse
  test-route (req) = http-json "{\"ok\":true}"

Section: Entry
  opening : [Console, Network.Read, Network.Write] Nothing = act
    let m0 = WebMux { listen = net-io-listen (fresh-listen-transport 80), conns = [], served = 0 }
    in act
      m1 <- web-mux-feed test-route (\line -> 0) m0 a-syn 80
      m2 <- web-mux-feed test-route (\line -> 0) m1 (mk-acking 50000 a-ip 1001 (server-next m1) psh get-partial) 80
      print-line-uni ("afterPartial=" & show (m2.served))
      m3 <- web-mux-feed test-route (\line -> 0) m2 a-rest 80
      print-line-uni ("afterRest=" & show (m3.served))
      m4 <- web-mux-feed test-route (\line -> 0) m3 b-syn 80
      m5 <- web-mux-feed test-route (\line -> 0) m4 (mk-acking 50001 b-ip 2001 (server-next m4) psh post-hdr) 80
      print-line-uni ("afterPostHdr=" & show (m5.served))
      m6 <- web-mux-feed test-route (\line -> 0) m5 b-body 80
      print-line-uni ("afterBody=" & show (m6.served))
      print-line-uni ("conns=" & show (list-length (m6.conns)))
    end
  end
