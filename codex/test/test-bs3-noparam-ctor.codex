Chapter: TestNoParam

Section: Types
  Thing = record {
   name : Text,
   body : Text
  }

  Holder =
   | Plain (Thing)

Section: Defs
  extract : Holder -> Text
  extract (m) =
   when m
    is Plain (t) -> t.name

  opening : [Console] Nothing = act
   let sample = Plain (Thing { name = "hi", body = "b" })
   in print-line-uni (extract sample)
  end
