Chapter: AudioDiffusionTest
  cites Signal chapter AudioAnalysis
  cites AI chapter DiffusionScheduler

Section: Body

  test-peak-rms : Text =
    let samples = [500, 0 - 800, 300, 0 - 200, 1000, 0 - 600]
    in "peak=" & show (audio-peak samples) & " rms=" & show (audio-rms samples)

  test-envelope : Text =
    let samples = [500, 500, 500, 500, 100, 100, 100, 100]
    in let env = audio-envelope samples 4
    in "env=" & show (list-length env) & " e0=" & show (list-at env 0) & " e1=" & show (list-at env 1)

  test-analyze : Text =
    let samples = [0, 500, 1000, 500, 0, 0 - 500, 0 - 1000, 0 - 500, 0, 500, 1000, 500, 0, 0 - 500, 0 - 1000, 0 - 500]
    in let features = audio-analyze samples 8000
    in "analyze: " & format-audio-features features

  test-linear-schedule : Text =
    let sched = linear-schedule 10 1 20
    in "linear: " & format-schedule sched

  test-cosine-schedule : Text =
    let sched = cosine-schedule 10
    in "cosine: " & format-schedule sched

  test-add-noise : Text =
    let sched = linear-schedule 20 10 200
    in let x0 = [1000, 500, 0 - 500]
    in let noise = [100, 0 - 200, 300]
    in let noisy = diffusion-add-noise x0 noise 10 sched
    in "noisy: len=" & show (list-length noisy)

  test-snr : Text =
    let sched = linear-schedule 100 1 20
    in let snr-early = schedule-snr sched 5
    in let snr-late = schedule-snr sched 90
    in "snr: early=" & show snr-early & " late=" & show snr-late & " decreasing=" & show (snr-early > snr-late)

  opening : [Console] Nothing = act
    print-line-uni test-peak-rms
    print-line-uni test-envelope
    print-line-uni test-analyze
    print-line-uni test-linear-schedule
    print-line-uni test-cosine-schedule
    print-line-uni test-add-noise
    print-line-uni test-snr
  end

