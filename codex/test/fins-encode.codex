Chapter: FinsEncodeTest

  cites Encode chapter Fins

Section: Helpers

  bytes-eq : List Integer, List Integer -> Boolean
  bytes-eq (a) (b) =
   if list-length a /= list-length b then False
   else bytes-eq-loop a b 0 (list-length a)

  bytes-eq-loop : List Integer, List Integer, Integer, Integer -> Boolean
  bytes-eq-loop (a) (b) (i) (len) =
   if i >= len then True
   else if list-at a i /= list-at b i then False
   else bytes-eq-loop a b (i + 1) len

  flag : Boolean -> Integer
  flag (b) = if b then 1 else 0

Section: Checks

  check-header : Integer
  check-header =
   flag (bytes-eq (fins-header 1 0 0) [128, 0, 2, 0, 1, 0, 0, 0, 0, 0])

  check-read-dm : Integer
  check-read-dm =
   flag (bytes-eq (fins-mem-read 1 0 0 fins-area-dm 100 10)
     [128, 0, 2, 0, 1, 0, 0, 0, 0, 0, 1, 1, 130, 0, 100, 0, 0, 10])

  check-read-cio : Integer
  check-read-cio =
   flag (bytes-eq (fins-mem-read 1 0 0 fins-area-cio 0 1)
     [128, 0, 2, 0, 1, 0, 0, 0, 0, 0, 1, 1, 176, 0, 0, 0, 0, 1])

  check-write-dm : Integer
  check-write-dm =
   let expect = [128, 0, 2, 0, 1, 0, 0, 0, 0, 0, 1, 2, 130, 0, 200, 0, 0, 2, 18, 52, 86, 120]
   in flag (bytes-eq (fins-mem-write 1 0 0 fins-area-dm 200 [#1234, #5678]) expect)

  opening : Integer =
   let a = check-header
   in let b = check-read-dm
   in let c = check-read-cio
   in let d = check-write-dm
   in a + b + c + d
