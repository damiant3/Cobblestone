Chapter: LetChain

Section: Definitions

  opening : Integer =
    let a = 1
    in let b = a + 1
    in let c = b + a
    in let d = c + b
    in let e = d + c
    in let f = e + d
    in let g = f + e
    in let h = g + f
    in let i = h + g
    in let j = i + h
    in j

