Chapter: SubstringOverRead
  cites Foreword chapter Console

Section: Probe

  mk : Text -> Text
  mk (t) = t & ""

Section: Entry

  opening : [Console] Nothing = act
    let a = mk "abcde"
    in let secret = mk "PASSWORD-1234567890"
    in print-line-uni ("over-read = [" & substring a 0 40 & "]")
  end

