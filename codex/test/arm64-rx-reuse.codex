Chapter: Arm64RxReuse
  cites Kernel chapter Arm64Pci
  cites Kernel chapter VirtioPci
  cites Kernel chapter VirtioNet

Section: A Ring Written By Hand

 No device: the used ring and the receive buffers are written in RAM, so both
 paths read the same twenty frames from the same starting state. #48000000 is
 128 MB above the RAM base, clear of the ELF and heap at #40100000 and of the
 boot stack 1 GB up; the ring sits 1 MB above the buffers.

  floor : Integer = #48000000
  ring : Integer = #48100000
  frames : Integer = 20
  frame-len : Integer = 64

  dead-pci : Arm64PciDevice = Arm64PciDevice { pci-bus = 0, pci-dev = 0, pci-func = 0, pci-vendor = 0, pci-device-id = 0, pci-class = 0, pci-subclass = 0, pci-header-type = 0 }
  dead-dev : VirtioDevice = VirtioDevice { pci-dev = dead-pci, common-base = 0, notify-base = 0, notify-off-multiplier = 0, isr-base = 0, device-cfg-base = 0 }

  fill-frame : Integer, Integer, Integer, Integer -> Integer
  fill-frame (base) (seed) (i) (n) =
   if i >= n then 0
   else let w = poke-byte base (vnet-hdr-size + i) (bit-and (seed + i) 255)
   in fill-frame base seed (i + 1) n

  fill-ring : Integer, Integer -> Integer
  fill-ring (i) (n) =
   if i >= n then poke-16 ring 2 n
   else let buf = floor + i * vnet-max-frame
   in let h = virtio-zero-mem buf vnet-hdr-size
   in let b = fill-frame buf (i * 7) 0 frame-len
   in let e0 = poke-32 (ring + 4 + i * 8) 0 i
   in let e1 = poke-32 (ring + 4 + i * 8) 4 (vnet-hdr-size + frame-len)
   in fill-ring (i + 1) n

  fresh : VirtioNetState
  fresh =
   let q = VirtqueueState { desc-base = ring + 1024, avail-base = ring + 2048, used-base = ring, queue-size = 32, free-head = 0, avail-idx = 0, last-used-idx = 0, notify-addr = ring + 3072 }
   in VirtioNetState { device = dead-dev, rx-queue = q, tx-queue = q, mac = [82, 84, 0, 18, 52, 86] }

  sum-bytes : List Integer, Integer, Integer, Integer -> Integer
  sum-bytes (l) (i) (n) (acc) =
    if i >= n then acc else sum-bytes l (i + 1) n (acc + list-at l i)

  yn : Boolean -> Text
  yn (b) = if b then "yes" else "no"

 The per-frame figures differ by backend (arm64 1,276 against 202, x86-64 727
 against 198, 2026-09-24), so the arm asserts the bounds both sides of the
 64-byte frame's own list cost rather than either backend's numbers.

  frame-buffer : List Integer, Integer -> List Integer
  frame-buffer (xs) (n) = if list-length xs >= n then xs else frame-buffer (list-push xs 0) n

Section: The Two Paths

 Each drain answers count * 1000000 + byte sum, so it returns one Integer and
 any heap it moves is the receive path's.

  drain-list : VirtioNetState, Integer, Integer -> Integer
  drain-list (v) (count) (bytes) =
    let r = virtio-net-poll-frame v
    in if r.has-frame == False then count * 1000000 + bytes
       else drain-list (r.state) (count + 1) (bytes + sum-bytes (r.frame) 0 (list-length (r.frame)) 0)

  drain-into : VirtioNetState, List Integer, Integer, Integer -> Integer
  drain-into (v) (rx) (count) (bytes) =
    let r = virtio-net-poll-into v rx
    in if r.vi-has == False then count * 1000000 + bytes
       else drain-into (r.vi-state) rx (count + 1) (bytes + sum-bytes rx 0 (r.vi-len) 0)

Section: Entry

  opening : [Console, Device.Mmio] Nothing = act
    let f = poke-32 vnet-dma-floor-cell 0 floor
    in let z = virtio-zero-mem ring 4096
    in let filled = fill-ring 0 frames
    in let h0 = __heap-save
    in let old = drain-list fresh 0 0
    in let h1 = __heap-save
    in let rx = frame-buffer (__list-with-capacity 1522) 1522
    in let h2 = __heap-save
    in let new = drain-into fresh rx 0 0
    in let h3 = __heap-save
    in act
      print-line-uni ("list frames    : " & show (old / 1000000))
      print-line-uni ("list bytes     : " & show (old - (old / 1000000) * 1000000))
      print-line-uni ("list per frame over 512  : " & yn ((h1 - h0) / frames > 512))
      print-line-uni ("into frames    : " & show (new / 1000000))
      print-line-uni ("into bytes     : " & show (new - (new / 1000000) * 1000000))
      print-line-uni ("into per frame under 256 : " & yn ((h3 - h2) / frames < 256))
      print-line-uni ("buffer length  : " & show (list-length rx))
    end
  end

