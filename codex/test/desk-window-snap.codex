Chapter: DeskWindowSnapTest
  cites Works chapter GopDesk
  cites Dev chapter WindowSnap

Section: Main

  dws-line : Text, Integer, Integer, Integer, Integer, Integer, Integer -> Text
  dws-line (label) (cx) (cy) (cw) (ch) (mx) (my) =
    let r = dk-snap-target cx cy cw ch mx my
    in label & " " & show (r.sr-x) & " " & show (r.sr-y) & " " & show (r.sr-w) & " " & show (r.sr-h)

  opening : [Console] Nothing = act
    print-line-uni (dws-line "middle" 0 48 1600 852 800 450)
    print-line-uni (dws-line "left" 0 48 1600 852 5 400)
    print-line-uni (dws-line "right" 0 48 1600 852 1598 400)
    print-line-uni (dws-line "top" 0 48 1600 852 800 50)
    print-line-uni (dws-line "bottom" 0 48 1600 852 800 898)
    print-line-uni (dws-line "top-left" 0 48 1600 852 3 50)
    print-line-uni (dws-line "bottom-right" 0 48 1600 852 1599 899)
    print-line-uni (dws-line "left margin 15" 40 48 1560 852 55 400)
    print-line-uni (dws-line "left margin 16" 40 48 1560 852 56 400)
    print-line-uni (dws-line "strip left" 40 48 1560 852 20 400)
  end
