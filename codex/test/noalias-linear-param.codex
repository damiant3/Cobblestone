Chapter: NoAliasLinearParam

Section: Types

  Point = record {
   x : Integer,
   y : Integer
  }

Section: Use

  point-x : linear Point -> Integer
  point-x (p) = p.x

Section: Entry

  opening : [Console] Nothing
  opening = act
   print-line-uni (integer-to-text (point-x (Point { x = 7, y = 9 })))
  end
