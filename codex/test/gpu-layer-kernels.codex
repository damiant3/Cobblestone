    let x = make 192 19
    in let g = make 8 23
    in let b = make 8 31
    in let hx = upload x
    in let hg = upload g
    in let hb = upload b
    in let ho = fresh 192
    in let hs = fresh 192
    in let good = norm-apply "kernel_group_norm" hx 24 8 0.00001 [arg-buf hg, arg-buf hb, arg-buf ho, arg-int 8, arg-int 12, arg-int 4, arg-int 192] ho 192
    in let bad = norm-apply "kernel_group_norm" hx 24 8 0.00001 [arg-buf hg, arg-buf hb, arg-buf hs, arg-int 8, arg-int 12, arg-int 2, arg-int 192] hs 192
    in grade "group-norm" good bad (ref-group-norm x g b 8 12 4 0.00001 0 [])

  launch-rows : Text, Integer, List GpuParam -> Integer
  launch-rows (name) (rows) (ps) =
    gpu-launch layer-kernels-ptx name (GpuGrid { gx = rows, gy = 1, gz = 1, bx = 128, by = 1, bz = 1, shared = 0 }) ps

  norm-apply-wide : Text, Integer, Integer, Integer, Real, List GpuParam, Integer, Integer -> List Real
  norm-apply-wide (name) (hx) (len) (rows) (eps) (tail) (ho) (n) =
    let hst = fresh (rows * 2)
    in let hp = fresh (rows * 128)
    in if launch-rows "kernel_row_stats_wide" rows [arg-buf hx, arg-buf hst, arg-buf hp, arg-int len, arg-real eps, arg-int rows] < 0 then []
    else run name n ([arg-buf hx, arg-buf hst] & tail) ho n

  arm-norms-wide : Integer -> List Text
  arm-norms-wide (z) =
    let x = make 512 3
    in let g = make 64 7
    in let b = make 64 13
    in let hx = upload x
    in let hg = upload g
    in let hb = upload b
    in let lo = fresh 512
    in let ls = fresh 512
    in let lgood = norm-apply-wide "kernel_layer_norm" hx 64 8 0.00001 [arg-buf hg, arg-buf hb, arg-buf lo, arg-int 64, arg-int 512] lo 512
    in let lbad = norm-apply-wide "kernel_layer_norm" hx 64 8 1.0 [arg-buf hg, arg-buf hb, arg-buf ls, arg-int 64, arg-int 512] ls 512
    in let x3 = make 900 5
    in let g3 = make 300 11
    in let b3 = make 300 17
    in let hx3 = upload x3
    in let hg3 = upload g3
    in let hb3 = upload b3
    in let wo = fresh 900
    in let ws = fresh 900
    in let wgood = norm-apply-wide "kernel_layer_norm" hx3 300 3 0.00001 [arg-buf hg3, arg-buf hb3, arg-buf wo, arg-int 300, arg-int 900] wo 900
    in let wbad = norm-apply-wide "kernel_layer_norm" hx3 300 3 1.0 [arg-buf hg3, arg-buf hb3, arg-buf ws, arg-int 300, arg-int 900] ws 900
    in let xg = make 192 19
    in let gg = make 8 23
    in let bg = make 8 31
    in let hxg = upload xg
    in let hgg = upload gg
    in let hbg = upload bg
    in let go = fresh 192
    in let gs = fresh 192
    in let ggood = norm-apply-wide "kernel_group_norm" hxg 24 8 0.00001 [arg-buf hgg, arg-buf hbg, arg-buf go, arg-int 8, arg-int 12, arg-int 4, arg-int 192] go 192
    in let gbad = norm-apply-wide "kernel_group_norm" hxg 24 8 0.00001 [arg-buf hgg, arg-buf hbg, arg-buf gs, arg-int 8, arg-int 12, arg-int 2, arg-int 192] gs 192
    in let l1 = grade "layer-norm, a block per row" lgood lbad (ref-layer-norm x g b 64 0.00001 0 [])
    in let l2 = grade "layer-norm, a block per row, 300 wide" wgood wbad (ref-layer-norm x3 g3 b3 300 0.00001 0 [])
    in [l1, l2, grade "group-norm, a block per row" ggood gbad (ref-group-norm xg gg bg 8 12 4 0.00001 0 [])]

  softmax-wide : List Real, Integer, Integer, Integer -> List Real
  softmax-wide (s) (cols) (rows) (n) =
    let h = upload s
    in let hp = fresh (rows * 128)
    in if launch-rows "kernel_softmax_rows_wide" rows [arg-buf h, arg-buf hp, arg-int cols, arg-int rows] < 0 then []
    else download h n

  pow2 : Integer -> Real
  pow2 (k) = if k == 0 then 1.0 else if k > 0 then 2.0 * pow2 (k - 1) else 0.5 * pow2 (k + 1)

  f16-real : Integer -> Real
  f16-real (h) =
    let e = bit-and (bit-shru h 10) 31
    in let m = bit-and h 1023
    in let v = if e == 0 then real-from-int m * pow2 (0 - 24) else real-from-int (1024 + m) * pow2 (e - 25)
    in if bit-and (bit-shru h 15) 1 == 1 then 0.0 - v else v

  take-halves : Integer, Integer, List Real -> List Real
  take-halves (i) (n) (acc) =
    if i >= n then acc
    else let w = bit-and (peek-32 scratch (i / 2 * 4)) #FFFFFFFF
    in take-halves (i + 1) n (list-push acc (f16-real (if i - i / 2 * 2 == 0 then bit-and w #FFFF else bit-shru w 16)))

  download16 : Integer, Integer -> List Real
  download16 (h) (n) =
    if gpu-buf-read h 0 (n * 2) scratch then take-halves 0 n []
    else []

 f16 holds 11 significant bits, a relative step of 4.9e-4.

  within16 : Real, Real -> Boolean
  within16 (got) (want) =
    let d = if got > want then got - want else want - got
    in let m = if want < 0.0 then 0.0 - want else want
    in d <= 0.001 * (1.0 + m)

  count-within16 : List Real, List Real, Integer, Integer -> Integer
  count-within16 (got) (want) (i) (acc) =
    if i >= list-length want then acc
    else if i >= list-length got then acc
    else count-within16 got want (i + 1) (if within16 (list-at got i) (list-at want i) then acc + 1 else acc)

  grade16 : Text, List Real, List Real, List Real -> Text
  grade16 (name) (got) (sabotaged) (want) =
    let n = list-length want
    in let good = count-within16 got want 0 0
    in let bad = count-within16 sabotaged want 0 0
    in name & ": " & show good & "/" & show n & (if list-length sabotaged == 0 then ", SABOTAGE REFUSED" else if bad < n then ", sabotage caught" else ", SABOTAGE MISSED")

  softmax-wide-f16 : List Real, Integer, Integer, Integer -> List Real
  softmax-wide-f16 (s) (cols) (rows) (n) =
    let h = upload s
    in let hp = fresh (rows * 128)
    in let p = fresh n
    in if launch-rows "kernel_softmax_rows_wide_f16" rows [arg-buf h, arg-buf p, arg-buf hp, arg-int cols, arg-int rows] < 0 then []
    else download16 p n

  split-f16 : Integer, Integer, Integer, Integer, Integer -> List Real
  split-f16 (hx) (s) (heads) (d) (t) =
    let ho = fresh 60
    in if launch "kernel_split_heads_f16" 60 [arg-buf hx, arg-buf ho, arg-int s, arg-int heads, arg-int d, arg-int t, arg-int 60] < 0 then []
    else download16 ho 60

  arm-f16 : Integer -> List Text
  arm-f16 (z) =
    let q = make 40 41
    in let k = make 56 43
    in let sc = ref-scores q k 2 5 7 4 0.5 0 []
    in let s3 = make 900 29
    in let x = make 60 89
    in let hx = upload x
    in let a = grade16 "softmax to f16, a block per row" (softmax-wide-f16 sc 7 10 70) (softmax-wide-f16 sc 6 10 70) (ref-softmax sc 7 0 [])
    in let b = grade16 "softmax to f16, a block per row, 300 wide" (softmax-wide-f16 s3 300 3 900) (softmax-wide-f16 s3 299 3 900) (ref-softmax s3 300 0 [])
    in let c = grade16 "split heads to f16" (split-f16 hx 5 3 4 0) (split-f16 hx 6 2 5 0) (ref-split x 5 3 4 0 0 [])
    in [a, b, c, grade16 "split heads to f16, transposed" (split-f16 hx 5 3 4 1) (split-f16 hx 6 2 5 1) (ref-split x 5 3 4 1 0 [])]

  arm-softmax-wide : Integer -> List Text
  arm-softmax-wide (z) =
    let q = make 40 41
    in let k = make 56 43
    in let sc = ref-scores q k 2 5 7 4 0.5 0 []
    in let s3 = make 900 29
    in let s1 = grade "softmax, a block per row" (softmax-wide sc 7 10 70) (softmax-wide sc 6 10 70) (ref-softmax sc 7 0 [])
    in [s1, grade "softmax, a block per row, 300 wide" (softmax-wide s3 300 3 900) (softmax-wide s3 299 3 900) (ref-softmax s3 300 0 [])]

  attend : Integer, Integer, Integer, Real, Integer -> List Real
  attend (hq) (hk) (hv) (scale) (ho) =
    let hsc = fresh 70
    in if launch "kernel_attn_scores" 70 [arg-buf hq, arg-buf hk, arg-buf hsc, arg-int 2, arg-int 5, arg-int 7, arg-int 4, arg-real scale, arg-int 70] < 0 then []
    else if launch "kernel_softmax_rows" 10 [arg-buf hsc, arg-int 7, arg-int 10] < 0 then []
    else run "kernel_attn_values" 40 [arg-buf hsc, arg-buf hv, arg-buf ho, arg-int 2, arg-int 5, arg-int 7, arg-int 4, arg-int 40] ho 40

  probs : Integer, Integer, Real -> List Real
  probs (hq) (hk) (scale) =
    let hsc = fresh 70
    in if launch "kernel_attn_scores" 70 [arg-buf hq, arg-buf hk, arg-buf hsc, arg-int 2, arg-int 5, arg-int 7, arg-int 4, arg-real scale, arg-int 70] < 0 then []
    else run "kernel_softmax_rows" 10 [arg-buf hsc, arg-int 7, arg-int 10] hsc 70

  arm-attention : Integer -> List Text
  arm-attention (z) =
    let q = make 40 41
    in let k = make 56 43
    in let v = make 56 47
    in let hq = upload q
    in let hk = upload k
    in let hv = upload v
    in let p = ref-softmax (ref-scores q k 2 5 7 4 0.5 0 []) 7 0 []
    in let sm = grade "softmax" (probs hq hk 0.5) (probs hq hk 1.0) p
    in let at = grade "attention" (attend hq hk hv 0.5 (fresh 40)) (attend hq hk hv 1.0 (fresh 40)) (ref-values p v 2 5 7 4 0 [])
    in [sm, at]

  causal-softmax : Integer, Boolean -> Integer
  causal-softmax (hsc) (causal) =
    if causal then launch "kernel_softmax_causal" 12 [arg-buf hsc, arg-int 6, arg-int 6, arg-int 12]
    else launch "kernel_softmax_rows" 12 [arg-buf hsc, arg-int 6, arg-int 12]

  causal-scores : Integer, Integer -> Integer
  causal-scores (hq) (hk) =
    let hsc = fresh 72
    in if launch "kernel_attn_scores" 72 [arg-buf hq, arg-buf hk, arg-buf hsc, arg-int 2, arg-int 6, arg-int 6, arg-int 4, arg-real 0.5, arg-int 72] < 0 then 0
    else hsc

  causal-probs : Integer, Integer, Boolean -> List Real
  causal-probs (hq) (hk) (causal) =
    let hsc = causal-scores hq hk
    in if hsc == 0 then []
    else if causal-softmax hsc causal < 0 then []
    else download hsc 72

  causal-attend : Integer, Integer, Integer, Boolean -> List Real
  causal-attend (hq) (hk) (hv) (causal) =
    let hsc = causal-scores hq hk
    in let ho = fresh 48
    in if hsc == 0 then []
    else if causal-softmax hsc causal < 0 then []
    else run "kernel_attn_values" 48 [arg-buf hsc, arg-buf hv, arg-buf ho, arg-int 2, arg-int 6, arg-int 6, arg-int 4, arg-int 48] ho 48

  arm-causal : Integer -> List Text
  arm-causal (z) =
    let q = make 48 67
    in let k = make 48 71
    in let v = make 48 73
    in let hq = upload q
    in let hk = upload k
    in let hv = upload v
    in let p = ref-softmax-causal (ref-scores q k 2 6 6 4 0.5 0 []) 6 6 0 []
    in let sm = grade "causal softmax" (causal-probs hq hk True) (causal-probs hq hk False) p
    in let at = grade "causal attention" (causal-attend hq hk hv True) (causal-attend hq hk hv False) (ref-values p v 2 6 6 4 0 [])
    in [sm, at]

