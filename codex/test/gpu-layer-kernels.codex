Section: Entry

  run-all : Integer -> List Text
  run-all (z) =
    let head = [arm-add 0, arm-add-channel 0, arm-silu 0, arm-gelu 0, arm-quick-gelu 0, arm-layer-norm 0, arm-group-norm 0]
    in let mid = arm-attention 0
    in let causal = arm-causal 0
    in head & mid & causal & arm-norms-wide 0 & arm-softmax-wide 0 & arm-f16 0 & [arm-concat 0, arm-upsample 0, arm-timestep 0, arm-geglu 0, arm-transpose 0, arm-split 0, arm-split 1, arm-merge 0]

  print-all : List Text, Integer -> [Console] Nothing
  print-all (ls) (i) =
    if i >= list-length ls then act
      print-uni ""
    end
    else act
      print-line-uni (list-at ls i)
      print-all ls (i + 1)
    end

  opening : [Console] Integer
  opening = act
    print-all (run-all 0) 0
    let r = 0 in r
  end
