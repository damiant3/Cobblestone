Chapter: OccurrenceCheck

Section: Shapes

  occ-dead : Integer -> Integer
  occ-dead (n) = let u = n + 4 in n

  occ-once : Integer -> Integer
  occ-once (n) = let y = n + 2 in y + 5

  occ-many : Integer -> Integer
  occ-many (n) = let z = n + 3 in z + z

  occ-arm : Integer -> Integer
  occ-arm (n) = let x = n + 1 in if n == 0 then x else x + 6

  occ-shadow : Integer -> Integer
  occ-shadow (n) = let x = n + 7 in let x = n + 1 in x + x

  occ-act : Integer -> [Device.Port] Integer
  occ-act (n) = act
   a <- port-in-byte n
   b <- port-in-byte (a + 1)
   a + b
  end

Section: Entry

  opening : [Console] Nothing = act
   print-line-uni "ok"
  end

