Chapter: KleeneTriBool

Section: Three-valued logic

  Tri =
   | TFalse
   | TUnknown
   | TTrue

  tnot : Tri -> Tri
  tnot (t) = when t
   is TFalse -> TTrue
   is TUnknown -> TUnknown
   is TTrue -> TFalse

  tor-unknown : Tri -> Tri
  tor-unknown (b) = when b
   is TFalse -> TUnknown
   is TUnknown -> TUnknown
   is TTrue -> TTrue

  tor : Tri, Tri -> Tri
  tor (a) (b) = when a
   is TFalse -> b
   is TUnknown -> tor-unknown b
   is TTrue -> TTrue

Section: Ground claims

  claim not-unknown : tnot TUnknown === TUnknown
  proof not-unknown = Refl
  qed

  claim or-unknown-unknown : tor TUnknown TUnknown === TUnknown
  proof or-unknown-unknown = Refl
  qed

Section: The involution

  claim tnot-tnot : for all (t : Tri), tnot (tnot t) === t
  proof tnot-tnot =
   induction on t
    is TFalse -> Refl
    is TUnknown -> Refl
    is TTrue -> Refl
   qed

  claim tor-true : for all (t : Tri), tor t TTrue === TTrue
  proof tor-true =
   induction on t
    is TFalse -> Refl
    is TUnknown -> Refl
    is TTrue -> Refl
   qed

Section: Main

  opening : [Console] Nothing
  opening = act
   print-line-uni "kleene-tribool: QED"
  end
