Chapter: Rv Direct Args Call
  cites Foreword chapter Console

Section: Callees

  with-text : Integer, Integer, Text -> Text
  with-text (a) (b) (c) = show a & "," & show b & "," & c

  with-count : Integer, Integer, List Integer -> Text
  with-count (a) (b) (c) = show a & "," & show b & "," & show (list-length c)

  with-flag : Integer, Integer, Boolean -> Text
  with-flag (a) (b) (c) = show a & "," & show b & "," & (if c then "yes" else "no")

Section: Entry

  opening : [Console] Nothing =
    let x = 7
    in let y = 9
    in let p = "ab"
    in let q = "cd"
    in let xs = [1, 2]
    in let ys = [3, 4, 5]
    in act
      print-line-uni ("concat " & with-text x y (p & q))
      print-line-uni ("append " & with-count x y (xs & ys))
      print-line-uni ("text-eq " & with-flag x y (p == q))
    end
