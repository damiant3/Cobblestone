Section: Parse

  c-parsed : Maybe X509Cert = x509-parse c-cert

  c-key-ed : Maybe X509Key = x509-spki c-spki-ed 0

Section: Helpers

  yn : Boolean -> Text
  yn (b) = if b then "True" else "False"

  bytes-eq : List Integer, List Integer -> Boolean
  bytes-eq (a) (b) =
    if list-length a /= list-length b then False
    else be-loop a b 0 (list-length a)

  be-loop : List Integer, List Integer, Integer, Integer -> Boolean
  be-loop (a) (b) (i) (n) =
    if i >= n then True
    else if list-at a i /= list-at b i then False
    else be-loop a b (i + 1) n

  alg-name : X509KeyAlg -> Text
  alg-name (a) =
    when a
      is KeyEd25519 -> "Ed25519"
      is KeyX25519 -> "X25519"
      is KeyRsa -> "RSA"
      is KeyEcdsaP256 -> "ECDSA-P256"
      is KeyEcdsaP384 -> "ECDSA-P384"
      is KeyEcdsaOther -> "ECDSA-other"
      is KeyUnknown -> "Unknown"

Section: Reports

 Every line reaches into the parsed certificate through a when, so a
 failed parse reports itself rather than defaulting to something that
 looks like a pass.

  r-parsed : Text = "x509 parsed=" & yn (when c-parsed is None -> False is Just (c) -> True)

  r-version : Text = "x509 version=" & show (when c-parsed is None -> 0 - 1 is Just (c) -> c.xc-version)

  r-serial-len : Text = "x509 serial-len=" & show (when c-parsed is None -> 0 - 1 is Just (c) -> list-length (c.xc-serial))

 The 10.2 certificate is self-issued: its issuer and its subject are the
 same Name. Compared as raw DER bytes, which is the only comparison that
 is safe.

  r-self-issued : Text =
    "x509 self-issued=" & yn (when c-parsed is None -> False is Just (c) -> bytes-eq (c.xc-issuer) (c.xc-subject))

  r-key-alg : Text = "x509 subject-key=" & (when c-parsed is None -> "none" is Just (c) -> alg-name ((c.xc-key).xk-alg))

  r-key-len : Text = "x509 subject-key-len=" & show (when c-parsed is None -> 0 - 1 is Just (c) -> list-length ((c.xc-key).xk-bytes))

  r-can-verify : Text =
    "x509 can-verify-x25519=" & yn (when c-parsed is None -> True is Just (c) -> x509-can-verify (c.xc-key))

  r-is-ca : Text = "x509 is-ca=" & yn (when c-parsed is None -> True is Just (c) -> c.xc-is-ca)

  r-notbefore : Text =
    "x509 notbefore-ok=" & yn (when c-parsed is None -> False is Just (c) -> bytes-eq (c.xc-not-before) c-notbefore)

  r-verify : Text =
    "x509 verify-tbs=" & yn (when c-parsed is None -> False is Just (c) -> ed25519-verify c-capub (c.xc-tbs) (c.xc-sig))

  r-ed-alg : Text = "x509 spki-alg=" & (when c-key-ed is None -> "none" is Just (k) -> alg-name (k.xk-alg))

  r-ed-key : Text =
    "x509 spki-key-matches=" & yn (when c-key-ed is None -> False is Just (k) -> bytes-eq (k.xk-bytes) c-capub)

  r-ed-can : Text =
    "x509 spki-can-verify=" & yn (when c-key-ed is None -> False is Just (k) -> x509-can-verify k)

 A truncated certificate must not parse. It must not parse PARTIALLY
 either -- there is no such thing as most of a certificate.

  r-trunc : Text =
    "x509 rej-truncated=" & yn (when x509-parse c-trunc is None -> True is Just (c) -> False)

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni r-parsed
    print-line-uni r-version
    print-line-uni r-serial-len
    print-line-uni r-self-issued
    print-line-uni r-key-alg
    print-line-uni r-key-len
    print-line-uni r-can-verify
    print-line-uni r-is-ca
    print-line-uni r-notbefore
    print-line-uni r-verify
    print-line-uni r-ed-alg
    print-line-uni r-ed-key
    print-line-uni r-ed-can
    print-line-uni r-trunc
  end
