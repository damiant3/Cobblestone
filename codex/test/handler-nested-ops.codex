Chapter: HandlerNestedOps
  cites Foreword chapter Console

Section: Effects

  effect A where
    get-a : [A] Integer

  effect B where
    get-b : [B] Integer

Section: Body

  opening : [Console] Nothing =
    let n1 = with A (with B (get-a + get-b))
      get-b (resume) = resume 20
      get-a (resume) = resume 22
    in let n2 = with A (with B (get-a + get-b))
      get-a (resume) = resume 22
      get-b (resume) = resume 20
    in let n3 = with A (with B (get-a * 100 + get-b))
      get-b (resume) = resume 20
      get-a (resume) = resume 22
    in let n4 = with A (with B (get-b * 100 + get-a))
      get-b (resume) = resume 20
      get-a (resume) = resume 22
    in act
      print-line-uni ("n1: " & show n1)
      print-line-uni ("n2: " & show n2)
      print-line-uni ("n3: " & show n3)
      print-line-uni ("n4: " & show n4)
    end

