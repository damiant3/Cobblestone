  bl-byte : Integer -> Integer
  bl-byte (i) =
    let v = i * 37 + (i / 13) * 7
    in 32 + v - (v / 90) * 90

  gen-long : Integer, Integer, List Integer -> List Integer
  gen-long (n) (i) (acc) =
    if i >= n then acc
    else gen-long n (i + 1) (list-push acc (bl-byte i))

  copy-span : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  copy-span (src) (from) (count) (i) (acc) =
    if i >= count then acc
    else copy-span src from count (i + 1) (list-push acc (list-at src (from + i)))

  show-bytes : List Integer, Integer, Integer, Text -> Text
  show-bytes (xs) (i) (n) (acc) =
    if i >= n then acc
    else show-bytes xs (i + 1) n (acc & " " & show (list-at xs i))

  emit-line : Text, List Integer -> Text
  emit-line (label) (xs) = label & ":" & show-bytes xs 0 (list-length xs) ""

  opening : [Console] Nothing = act
    let ascii = gen-cyc 540 0 []
    in let cyclic = gen-cyc 1500 0 []
    in let high = gen-hi 900 0 []
    in let runs = run-of 67 400 0 []
    in let mixed = gen-cyc 200 0 [] & run-of 70 300 0 [] & gen-hi 200 0 []
    in let random = gen-rnd 600 0 []
    in let small = [72, 101, 108, 108, 111]
    in let pat = gen-pat 100 0 []
    in let groups = gen-junk 150 0 12345 [] & pat & pat & gen-junk 150 0 777 [] & pat & pat
    in let text = gen-text 8000 4242 []
    in let utf8 = gen-utf8 8000 909 []
    in let lbase = gen-long 70000 0 []
    in let far = copy-span lbase 45000 8000 0 lbase
    in act
      print-line-uni (emit-line "ascii-orig" ascii)
      print-line-uni (emit-line "ascii-comp" (brotli-compress ascii))
      print-line-uni (emit-line "cyclic-orig" cyclic)
      print-line-uni (emit-line "cyclic-comp" (brotli-compress cyclic))
      print-line-uni (emit-line "high-orig" high)
      print-line-uni (emit-line "high-comp" (brotli-compress high))
      print-line-uni (emit-line "runs-orig" runs)
      print-line-uni (emit-line "runs-comp" (brotli-compress runs))
      print-line-uni (emit-line "mixed-orig" mixed)
      print-line-uni (emit-line "mixed-comp" (brotli-compress mixed))
      print-line-uni (emit-line "random-orig" random)
      print-line-uni (emit-line "random-comp" (brotli-compress random))
      print-line-uni (emit-line "small-orig" small)
      print-line-uni (emit-line "small-comp" (brotli-compress small))
      print-line-uni (emit-line "groups-orig" groups)
      print-line-uni (emit-line "groups-comp" (brotli-compress groups))
      print-line-uni (emit-line "text-orig" text)
      print-line-uni (emit-line "text-comp" (brotli-compress text))
      print-line-uni (emit-line "utf8-orig" utf8)
      print-line-uni (emit-line "utf8-comp" (brotli-compress utf8))
      print-line-uni (emit-line "ctx8-orig" ctx8-words)
      print-line-uni (emit-line "ctx8-comp" (brotli-compress ctx8-words))
      print-line-uni (emit-line "xform-orig" xform-words)
      print-line-uni (emit-line "xform-comp" (brotli-compress xform-words))
      print-line-uni (emit-line "dict-orig" dict-words)
      print-line-uni (emit-line "dict-comp" (brotli-compress dict-words))
      print-line-uni (emit-line "far-comp" (brotli-compress far))
    end
  end
