Chapter: TypeClassEq
  cites Foreword chapter Console

 Multi-argument, multi-instance method. is-equal takes two arguments;
 the instance is selected from the first argument's type, and the
 second argument flows through the curried application.

class Equatable where
  is-equal : a, a -> Boolean

instance Equatable Integer where
  is-equal (x) (y) = x == y

instance Equatable Boolean where
  is-equal (a) (b) = if a then b else if b then False else True

Section: Opening

  opening : [Console] Nothing
  opening = act
   print-line-uni (show (is-equal 3 3))
   print-line-uni (show (is-equal 3 4))
   print-line-uni (show (is-equal True False))
  end
