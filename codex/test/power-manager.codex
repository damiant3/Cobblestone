Chapter: PowerManagerTest
  cites Dev chapter PowerManager

Section: Entry
  pmt-night : PowerManagerState, Integer -> Text
  pmt-night (st) (hour) = show ((pm-check-night-schedule st hour).pm-night-light).nl-active

  opening : [Console] Nothing = act
    st <- power-manager-new
    up <- (pm-brightness-up st 50).pm-brightness
    down <- (pm-brightness-down st 130).pm-brightness
    print-line-uni ("brightness " & show up & " " & show down)
    print-line-uni ("night 22-6 at 23 " & pmt-night st 23 & " 3 " & pmt-night st 3 & " 6 " & pmt-night st 6 & " 12 " & pmt-night st 12)
    day <- __record-set st "pm-night-light" (__record-set (__record-set st.pm-night-light "nl-start-hour" 8) "nl-end-hour" 17)
    print-line-uni ("night 8-17 at 8 " & pmt-night day 8 & " 16 " & pmt-night day 16 & " 17 " & pmt-night day 17 & " 7 " & pmt-night day 7)
    print-line-uni ("charging at 15 " & power-plan-label (pm-update-battery day 15 True).pm-plan & " " & pm-battery-icon day)
    print-line-uni ("draining at 21 " & power-plan-label (pm-update-battery day 21 False).pm-plan & " at 20 " & power-plan-label (pm-update-battery day 20 False).pm-plan & " icon at 8 " & pm-battery-icon (pm-update-battery day 8 False))
    idle <- pm-tick (pm-apply-plan-defaults (pm-set-plan day PlanBalanced)) 1799
    print-line-uni ("idle 1799 sleep " & show (pm-should-sleep idle) & " display-off " & show (pm-should-display-off idle) & " then 1800 " & show (pm-should-sleep (pm-tick idle 1)) & " input " & show (pm-should-sleep (pm-on-input idle)))
    never <- pm-tick (pm-apply-plan-defaults (pm-set-plan idle PlanPerformance)) 100000
    print-line-uni ("performance sleep " & show (pm-should-sleep never) & " brightness " & show never.pm-brightness)
    print-line-uni ("labels " & pm-timer-label 0 & ", " & pm-timer-label 45 & ", " & pm-timer-label 600 & ", " & pm-timer-label 7200)
  end
