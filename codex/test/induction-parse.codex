Chapter: InductionParse

Section: Nat

  Nat =
   | Zero
   | Succ (Nat)

  add : Nat, Nat -> Nat
  add (a) (b) = when a
   is Zero -> b
   is Succ (n) -> Succ (add n b)

Section: Proof

  claim add-zero : for all (n : Nat), add n Zero === n
  proof add-zero =
   induction on n
    is Zero -> Refl
    is Succ (k) (ih) -> cong ih
   qed

Section: Main

  opening : [Console] Nothing
  opening = act
   print-line-uni "induction-parse ok"
  end
