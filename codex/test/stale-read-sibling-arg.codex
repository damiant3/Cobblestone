Chapter: StaleReadSiblingArg

Section: T
  St = record {
   len : Integer,
   tag : Integer
  }

  bump : St, Integer -> St
  bump (s) (v) = __record-set s "len" (s.len + v)

  pair : St, Integer -> Integer
  pair (s) (n) = s.tag + n

  target : St -> Integer
  target (s) = pair (bump s 4) (s.len)

  opening : Integer
  opening = target (St { len = 1, tag = 2 })
