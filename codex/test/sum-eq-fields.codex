Chapter: SumEqFields
  cites Foreword chapter Console

Section: Types
  Shape =
    | Circle (Integer)
    | Rectangle (Integer) (Integer)
    | Point

Section: Body
  opening : [Console] Nothing = act
    print-line-uni (show (Circle 5 == Circle 5))
    print-line-uni (show (Circle 5 == Circle 7))
    print-line-uni (show (Rectangle 3 4 == Rectangle 3 4))
    print-line-uni (show (Rectangle 3 4 == Rectangle 3 9))
    print-line-uni (show (Point == Point))
    print-line-uni (show (Circle 5 == Point))
    print-line-uni (show (Circle 5 /= Circle 7))
    print-line-uni (show (Rectangle 3 4 /= Rectangle 3 4))
  end

