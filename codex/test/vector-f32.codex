Chapter: VectorF32
  cites Foreword chapter Console

Section: Entry
  opening : [Console] Nothing
  opening = act
    let a = vec4-splat (to-real-approx 3.0)
    in let b = vec4-splat (to-real-approx 4.0)
    in let sum = a + b
    in let prod = a * b
    in act
      print-line-uni ("add0: " & show (from-real-approx (vec4-extract sum 0)))
      print-line-uni ("add3: " & show (from-real-approx (vec4-extract sum 3)))
      print-line-uni ("mul0: " & show (from-real-approx (vec4-extract prod 0)))
    end
  end
