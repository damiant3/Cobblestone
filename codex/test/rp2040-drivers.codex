Chapter: Rp2040Drivers

  cites Boards chapter Rp2040Board

Section: Definitions

  test-gpio : [Device.Mmio] Integer
  test-gpio = act
   a <- rp-gpio-set-output 25
   b <- rp-gpio-set-input 4
   c <- rp-gpio-set 25
   d <- rp-gpio-clear 25
   e <- rp-gpio-toggle 25
   f <- rp-gpio-read 4
   g <- (rp-gpio-write 25 True)
   1
  end

  test-led : [Device.Mmio] Integer
  test-led = act
   a <- rp-led-init
   b <- rp-led-on
   c <- (rp-led-off)
   1
  end

  test-uart : [Device.Mmio] Integer
  test-uart = act
   a <- rp-uart-init rp-uart0-base 115200
   b <- rp-uart-send-byte rp-uart0-base 65
   c <- rp-uart-print rp-uart0-base "hello"
   d <- (rp-uart-println rp-uart0-base "world")
   1
  end

  test-spi : [Device.Mmio] Integer
  test-spi = act
   a <- rp-spi-init rp-spi0-base
   b <- (rp-spi-transfer rp-spi0-base #AA)
   1
  end

  test-i2c : [Device.Mmio] Integer
  test-i2c = act
   a <- rp-i2c-init rp-i2c0-base
   b <- rp-i2c-write-reg rp-i2c0-base #68 #6B 0
   c <- (rp-i2c-read-reg rp-i2c0-base #68 #75)
   1
  end

  test-adc : [Device.Mmio] Integer
  test-adc = act
   a <- rp-adc-init
   b <- (rp-adc-read 0)
   1
  end

  test-pio : [Device.Mmio] Integer
  test-pio = act
   a <- rp-pio-write-instr rp-pio0-base 0 #E081
   b <- rp-pio-sm-set-clkdiv rp-pio0-base 0 125
   c <- rp-pio-sm-set-pinctrl rp-pio0-base 0 25 1
   d <- (rp-pio-sm-enable rp-pio0-base 0)
   1
  end

  test-ws2812 : [Device.Mmio] Integer
  test-ws2812 =
   let red = ws2812-grb-pack 255 0 0
   in let green = ws2812-grb-pack 0 255 0
   in let blue = ws2812-grb-pack 0 0 255
   in let ok-red = if red == #00FF0000 then 1 else 0
   in let ok-green = if green == #FF000000 then 1 else 0
   in let ok-blue = if blue == #0000FF00 then 1 else 0
   in act
    init <- ws2812-init rp-pio0-base 0 16
    w1 <- ws2812-put-pixel rp-pio0-base 0 red
    w2 <- ws2812-put-pixel rp-pio0-base 0 green
    w3 <- ws2812-put-pixel rp-pio0-base 0 blue
    strip <- (ws2812-send-strip rp-pio0-base 0 [red, green, blue] 0 3)
    ok-red + ok-green + ok-blue
   end

  test-ws2812-program : Integer
  test-ws2812-program =
   let prog = ws2812-pio-program
   in let ok-len = if list-length prog == 4 then 1 else 0
   in let ok-i0 = if list-at prog 0 == #6021 then 1 else 0
   in let ok-i1 = if list-at prog 1 == #1123 then 1 else 0
   in ok-len + ok-i0 + ok-i1

  test-usb-descriptors : Integer
  test-usb-descriptors =
   let dev = usb-build-device-descriptor #CAFE #4001 UsbClassCdc 64
   in let cfg = usb-build-config-descriptor 48 2 250
   in let iface = usb-build-interface-descriptor 0 2 UsbClassCdc 0
   in let ep = usb-build-endpoint-descriptor 1 UsbIn UsbBulk 64
   in let ok-dev-len = if list-length dev == usb-device-descriptor-length then 1 else 0
   in let ok-dev-type = if list-at dev 1 == 1 then 1 else 0
   in let ok-dev-class = if list-at dev 4 == 2 then 1 else 0
   in let ok-vid-lo = if list-at dev 8 == #FE then 1 else 0
   in let ok-cfg-len = if list-length cfg == usb-config-descriptor-length then 1 else 0
   in let ok-cfg-type = if list-at cfg 1 == 2 then 1 else 0
   in let ok-iface-len = if list-length iface == usb-interface-descriptor-length then 1 else 0
   in let ok-ep-len = if list-length ep == usb-endpoint-descriptor-length then 1 else 0
   in let ok-ep-dir = if list-at ep 2 == #81 then 1 else 0
   in let cdc = usb-cdc-acm-descriptors #CAFE #4001
   in let ok-cdc = if list-length cdc == 18 then 1 else 0
   in ok-dev-len + ok-dev-type + ok-dev-class + ok-vid-lo + ok-cfg-len + ok-cfg-type + ok-iface-len + ok-ep-len + ok-ep-dir + ok-cdc

  test-delay : Integer
  test-delay =
   let a = rp-delay-ms 1
   in 1

  opening : [Device.Mmio] Integer =
   let wp = test-ws2812-program
   in let usb = test-usb-descriptors
   in let d = test-delay
   in act
    g <- test-gpio
    l <- test-led
    u <- test-uart
    s <- test-spi
    i <- test-i2c
    a <- test-adc
    p <- test-pio
    w <- test-ws2812
    g + l + u + s + i + a + p + w + wp + usb + d
   end

