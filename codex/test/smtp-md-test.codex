Chapter: SmtpMdTest
  cites Encode chapter Smtp
  cites Encode chapter Markdown
  cites Foreword chapter CCE
  cites Foreword chapter Maybe

Section: Body

  test-smtp : Text =
    let email = email-new "alice@codex.os" "bob@codex.os" "Hello" "Hi Bob"
    in let session = smtp-build-session "codex.os" email
    in "smtp: cmds=" & show (list-length session) & " " & format-smtp-email email

  test-smtp-response : Text =
    let r = smtp-parse-response "250 OK"
    in "resp: code=" & show (r.smtp-code) & " ok=" & show (smtp-is-success r) & " msg=" & r.smtp-message

  test-smtp-multi : Text =
    let email = email-add-recipient (email-new "me@x.com" "a@b.com" "Test" "body") "c@d.com"
    in "multi: to=" & show (list-length (email.smtp-to))

  test-markdown : Text =
    let doc = md-parse "# Hello\n\nSome text\n\n- item one\n- item two\n\n---"
    in "md: blocks=" & show (md-block-count doc) & " headings=" & show (md-count-headings doc)

  test-md-render : Text =
    let doc = md-parse "## Title\n\nParagraph here"
    in "render: " & md-render doc

  opening : [Console] Nothing = act
    print-line-uni test-smtp
    print-line-uni test-smtp-response
    print-line-uni test-smtp-multi
    print-line-uni test-markdown
    print-line-uni test-md-render
  end

