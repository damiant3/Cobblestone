Chapter: Builtin Value Names
  cites Foreword chapter Console

Section: Body

  Shape =
    | Dot
    | Box (Integer)
    | Pair (Integer) (Integer)

  kind-now : Integer = hosted-kind

  self-defs-count : Integer = list-length __self-type-defs

  opening : [Console] Nothing = act
    print-line-uni (show (variant-tag (Box 5)))
    print-line-uni (show (variant-tag (Pair 1 2)))
    print-line-uni (show kind-now)
    print-line-uni (show (if self-defs-count >= 0 then 1 else 0))
  end
