Chapter: NvQmdMaxwell
  cites Kernel chapter NvQmd
  cites Foreword chapter Format

 The expected output is NVIDIA's cla0c0qmd.h field macros packed by Mesa's
 drf.h, compiled by MSVC: build/nv-qmd-oracle.ps1.

Section: Vectors

  launch : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> QmdLaunch
  launch (po) (gx) (gy) (gz) (bx) (by) (bz) (sm) (lm) (rc) (bc) (ca) (cs) = QmdLaunch { program-offset = po, grid-x = gx, grid-y = gy, grid-z = gz, block-x = bx, block-y = by, block-z = bz, shared-size = sm, local-size = lm, register-count = rc, barrier-count = bc, cb0-address = ca, cb0-size = cs }

  vectors : List QmdLaunch
  vectors = [
   launch #1000 4 1 1 128 1 1 0 0 28 0 #200001000 #160,
   launch #12345678 70000 3 2 32 8 4 20000 100 255 1 #FFFFFFFF00 65536,
   launch 0 #FFFFFFFF 65535 65535 65535 1 1 40000 #FFFFF0 64 31 0 0,
   launch #40 1 1 1 1 1 1 16384 16 8 0 #100 256,
   launch #80 2 2 2 2 2 2 16385 17 9 2 #200 4,
   launch #C0 3 1 1 3 1 1 32768 0 10 3 #300 8,
   launch #100 5 1 1 5 1 1 32769 0 11 4 #400 12
  ]

Section: Main

  words-line : List Integer, Integer -> Text
  words-line (ws) (k) =
    fmt-hex-pad (list-at ws k) 8 & " " & fmt-hex-pad (list-at ws (k + 1)) 8 & " " & fmt-hex-pad (list-at ws (k + 2)) 8 & " " & fmt-hex-pad (list-at ws (k + 3)) 8 & " " & fmt-hex-pad (list-at ws (k + 4)) 8 & " " & fmt-hex-pad (list-at ws (k + 5)) 8 & " " & fmt-hex-pad (list-at ws (k + 6)) 8 & " " & fmt-hex-pad (list-at ws (k + 7)) 8

  print-words : List Integer, Integer -> [Console] Nothing
  print-words (ws) (k) = act
   if k >= 64 then print-text "" else act
    print-line-uni (words-line ws k)
    print-words ws (k + 8)
   end
  end

  print-from : Integer -> [Console] Nothing
  print-from (j) = act
   if j >= list-length vectors then print-text "" else act
    print-line-uni ("Q " & show j)
    print-words (nv-qmd-v0006 (list-at vectors j)) 0
    print-from (j + 1)
   end
  end

  opening : [Console] Nothing = act
   print-from 0
  end
