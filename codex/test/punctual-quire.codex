Chapter: PunctualQuire
  cites Foreword chapter Console
  cites Punctual chapter IntOps
  cites Punctual chapter BitOps
  cites Punctual chapter Saturate
  cites Punctual chapter FastMath
  cites Punctual chapter Trig
  cites Punctual chapter ColorOps
  cites Punctual chapter Kinematic
  cites Punctual chapter Endian

Section: Entry
  opening : [Console] Nothing
  opening = act
    print-line-uni ("int-abs -42: " & show (int-abs (0 - 42)))
    print-line-uni ("int-sign -7: " & show (int-sign (0 - 7)))
    print-line-uni ("int-min 3 5: " & show (int-min 3 5))
    print-line-uni ("int-max 3 5: " & show (int-max 3 5))
    print-line-uni ("int-clamp 0 10 15: " & show (int-clamp 0 10 15))
    print-line-uni ("is-even 4: " & show (is-even 4))
    print-line-uni ("is-odd 7: " & show (is-odd 7))
    print-line-uni ("bit-popcount 255: " & show (bit-popcount 255))
    print-line-uni ("bit-ctz 8: " & show (bit-ctz 8))
    print-line-uni ("is-power-of-two 16: " & show (is-power-of-two 16))
    print-line-uni ("next-power-of-two 5: " & show (next-power-of-two 5))
    print-line-uni ("byte-swap-32 #01020304: " & show (byte-swap-32 16909060))
    print-line-uni ("extract-byte #AABB 0: " & show (extract-byte 43707 0))
    print-line-uni ("sat-add-u8 200 100: " & show (sat-add-u8 200 100))
    print-line-uni ("sat-sub-u8 10 20: " & show (sat-sub-u8 10 20))
    print-line-uni ("lerp 0 100 1 2: " & show (lerp 0 100 1 2))
    print-line-uni ("step 5 3: " & show (step 5 3))
    print-line-uni ("step 5 7: " & show (step 5 7))
    print-line-uni ("int-sqrt 144: " & show (int-sqrt 144))
    print-line-uni ("int-pow 2 10: " & show (int-pow 2 10))
    print-line-uni ("int-log2 256: " & show (int-log2 256))
    print-line-uni ("fast-sin 0: " & show (fast-sin 0))
    print-line-uni ("fast-sin 90000: " & show (fast-sin 90000))
    print-line-uni ("fast-cos 0: " & show (fast-cos 0))
    print-line-uni ("rgba-r (rgba-pack 128 64 32 255): " & show (rgba-r (rgba-pack 128 64 32 255)))
    print-line-uni ("rgba-g (rgba-pack 128 64 32 255): " & show (rgba-g (rgba-pack 128 64 32 255)))
    print-line-uni ("rgba-b (rgba-pack 128 64 32 255): " & show (rgba-b (rgba-pack 128 64 32 255)))
    print-line-uni ("rgb-brightness white: " & show (rgb-brightness (rgba-pack 255 255 255 255)))
    print-line-uni ("dot-2d 3 4 3 4: " & show (dot-2d 3 4 3 4))
    print-line-uni ("cross-2d 1 0 0 1: " & show (cross-2d 1 0 0 1))
    print-line-uni ("distance-sq-2d 0 0 3 4: " & show (distance-sq-2d 0 0 3 4))
    print-line-uni ("manhattan-2d 0 0 3 4: " & show (manhattan-2d 0 0 3 4))
    print-line-uni ("to-big-endian-16 #0102: " & show (to-big-endian-16 258))
    print-line-uni ("from-big-endian-16 #0201: " & show (from-big-endian-16 513))
  end

Page 1
