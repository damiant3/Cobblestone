Section: Checks
  row : Integer, Integer -> Text
  row (base) (text-size) = show base & " + " & show text-size & " -> " & show (compute-data-vaddr-at base text-size)

  opening : [Console] Nothing = act
    print-line-uni (row 1048576 0)
    print-line-uni (row 1048576 1)
    print-line-uni (row 1048576 8)
    print-line-uni (row 1048576 13)
    print-line-uni (row 1048576 16)
    print-line-uni (row 1048576 17)
    print-line-uni (row 4194304 9)
  end
