Chapter: MbusEncodeTest

  cites Encode chapter Mbus

 Exercise M-Bus: the sum checksum, the acknowledgement and short frames,
 and a long data frame. Byte sequences checked against the EN 13757
 layout. opening returns the count of passing checks.

Section: Helpers

  bytes-eq : List Integer, List Integer -> Boolean
  bytes-eq (a) (b) =
   if list-length a /= list-length b then False
   else bytes-eq-loop a b 0 (list-length a)

  bytes-eq-loop : List Integer, List Integer, Integer, Integer -> Boolean
  bytes-eq-loop (a) (b) (i) (len) =
   if i >= len then True
   else if list-at a i /= list-at b i then False
   else bytes-eq-loop a b (i + 1) len

  flag : Boolean -> Integer
  flag (b) = if b then 1 else 0

Section: Checks

  check-checksum : Integer
  check-checksum =
   flag (mbus-checksum [83, 1, 81, 1, 2] == 168)

  check-ack : Integer
  check-ack =
   flag (bytes-eq mbus-ack-frame [229])

  check-short : Integer
  check-short =
   flag (bytes-eq (mbus-short-frame mbus-c-snd-nke 1) [16, 64, 1, 65, 22])

  check-long : Integer
  check-long =
   flag (bytes-eq (mbus-long-frame mbus-c-snd-ud 1 mbus-ci-data-send [1, 2]) [104, 5, 5, 104, 83, 1, 81, 1, 2, 168, 22])

  opening : Integer =
   let a = check-checksum
   in let b = check-ack
   in let c = check-short
   in let d = check-long
   in a + b + c + d
