Chapter: WaDemoSchemaTest
  cites WaDemo chapter WaSchema
  cites Data chapter Schema
  cites Data chapter Catalog
  cites Data chapter Row
  cites Foreword chapter Maybe
  cites Foreword chapter Hamt

Section: Helpers

  col-count-of : Catalog, Text -> Integer
  col-count-of (cat) (name) =
    when (catalog-get-table cat name)
      is None -> 0 - 1
      is Just (e) -> e.cat-table-def.col-count

  index-count-of : Catalog, Text -> Integer
  index-count-of (cat) (name) =
    when (catalog-get-table cat name)
      is None -> 0 - 1
      is Just (e) -> list-length (e.cat-indexes)

  pk-of : Catalog, Text -> Text
  pk-of (cat) (name) =
    when (catalog-get-table cat name)
      is None -> "no table"
      is Just (e) -> pk-text (e.cat-table-def.constraints) 0

  pk-text : List ConstraintDef, Integer -> Text
  pk-text (cs) (i) =
    if i >= list-length cs then "none"
    else when (list-at cs i).kind
      is PrimaryKey (cols) -> join-cols cols 0 ""
      is otherwise -> pk-text cs (i + 1)

  join-cols : List Text, Integer, Text -> Text
  join-cols (cols) (i) (acc) =
    if i >= list-length cols then acc
    else join-cols cols (i + 1) (acc & (if i > 0 then "," else "") & list-at cols i)

Section: Entry

  opening : [Console] Nothing
  opening = act
   let r = wa-create-schema catalog-new
   in let cat = r.wcr-cat
   in act
    print-line-uni ("create: " & show (r.wcr-ok) & " " & r.wcr-msg)
    print-line-uni ("tables: " & show (cat.table-count))
    print-line-uni ("fact cols: " & show (col-count-of cat wa-t-population))
    print-line-uni ("fact pk: " & pk-of cat wa-t-population)
    print-line-uni ("fact indexes: " & show (index-count-of cat wa-t-population))
    print-line-uni ("band pk: " & pk-of cat wa-t-band)
    print-line-uni ("band indexes: " & show (index-count-of cat wa-t-band))
    print-line-uni ("age cols: " & show (col-count-of cat wa-t-age))
    print-line-uni ("cohort cols: " & show (col-count-of cat wa-t-cohort))
    print-line-uni ("cohort pk: " & pk-of cat wa-t-cohort)
    print-line-uni ("missing table: " & show (col-count-of cat "nope"))
   end
  end
