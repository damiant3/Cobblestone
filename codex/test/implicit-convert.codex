Chapter: ImplicitConvert
  cites Foreword chapter Console
  cites Foreword chapter Units

Section: Functions

  describe-temp : Kelvin -> Text
  describe-temp (k) =
   if k > 373 then "hot"
   else if k > 273 then "warm"
   else "cold"

Section: Body
  opening : [Console] Nothing = act
    print-line-uni (describe-temp (Celsius 100))
    print-line-uni (describe-temp (Celsius 20))
    print-line-uni (describe-temp (Celsius 0))
    print-line-uni (describe-temp (Kelvin 500))
  end

