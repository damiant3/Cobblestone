Chapter: HandlerCapture
  cites Foreword chapter Console

Section: Effects

  effect Reader where
    ask : [Reader] Integer

  effect Scale where
    scale : Integer -> [Scale] Integer

Section: Body

  offset-by : Integer -> Integer
  offset-by (n) =
    let r = with Reader ask
      ask (resume) = resume (n + 1)
    in r

  times-by : Integer -> Integer
  times-by (k) =
    let r = with Scale (scale 6)
      scale (x) (resume) = resume (x * k)
    in r

  opening : [Console] Nothing = act
    print-line-uni ("offset " & show (offset-by 41))
    print-line-uni ("times " & show (times-by 7))
  end
