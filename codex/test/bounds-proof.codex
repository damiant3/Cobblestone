Chapter: Bounds Proof
  cites Foreword chapter Console

Section: Types
  Byte = record {
   val : Integer between 0 and 255
  }

  Wide = record {
   val : Integer between 0 and 65535
  }

Section: Helpers
  byte0 : Byte = Byte { val = 0 }

  wide0 : Wide = Wide { val = 0 }

Section: Literal proof -- [42,42] in [0,255]
  test-literal : Integer =
   let b = __record-set byte0 "val" (__narrow 42)
   in b.val

Section: Field access proof -- [0,255] in [0,65535]
  test-field : Integer =
   let a = Byte { val = __narrow 100 }
   in let w = __record-set wide0 "val" (__narrow a.val)
   in w.val

Section: Addition proof -- [0,510] in [0,65535]
  test-add : Integer =
   let a = Byte { val = __narrow 100 }
   in let b = Byte { val = __narrow 200 }
   in let w = __record-set wide0 "val" (__narrow (a.val + b.val))
   in w.val

Section: Division proof -- [0,255] in [0,255]
  test-div : Integer =
   let w = Wide { val = __narrow 4660 }
   in let b = __record-set byte0 "val" (__narrow (w.val / 256))
   in b.val

Section: Modulo proof -- [0,255] in [0,255]
  test-mod : Integer =
   let w = Wide { val = __narrow 4660 }
   in let b = __record-set byte0 "val" (__narrow (int-mod (w.val) 256))
   in b.val

Section: Multiplication proof -- [0,510] in [0,65535]
  test-mul : Integer =
   let b = Byte { val = __narrow 120 }
   in let w = __record-set wide0 "val" (__narrow (b.val * 2))
   in w.val

Section: Bit-and proof -- [0,255] in [0,255]
  test-bitand : Integer =
   let w = Wide { val = __narrow 1000 }
   in let b = __record-set byte0 "val" (__narrow (bit-and (w.val) 255))
   in b.val

Section: Shift-right proof -- [0,255] in [0,255]
  test-shru : Integer =
   let w = Wide { val = __narrow 4660 }
   in let b = __record-set byte0 "val" (__narrow (bit-shru (w.val) 8))
   in b.val

Section: If/else union -- result from either branch
  test-if : Integer =
   let x = 7
   in let r = if x > 5 then 10 else 20
   in r

Section: Subtraction proof -- [-255,255] but stored unproven
  test-sub : Integer =
   let a = Byte { val = __narrow 200 }
   in let b = Byte { val = __narrow 50 }
   in a.val - b.val

Section: Entry Point
  opening : [Console] Nothing = act
   print-line-uni (integer-to-text test-literal)
   print-line-uni (integer-to-text test-field)
   print-line-uni (integer-to-text test-add)
   print-line-uni (integer-to-text test-div)
   print-line-uni (integer-to-text test-mod)
   print-line-uni (integer-to-text test-mul)
   print-line-uni (integer-to-text test-bitand)
   print-line-uni (integer-to-text test-shru)
   print-line-uni (integer-to-text test-if)
   print-line-uni (integer-to-text test-sub)
  end

