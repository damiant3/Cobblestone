Chapter: LetElseScope

  cites Foreword chapter Console

Section: Definitions

  pick : Integer, Integer -> Integer
  pick (n) (m) =
    let base = m * 1000
    in let reuse = n - 1
    in if reuse >= 0 then
      let s = reuse + 10 in s + reuse + base
    else let loc = n + 2
    in let s = loc + 100
    in s + loc + base

  opening : [Console] Nothing = act
    print-line-uni (show (pick 5 7))
    print-line-uni (show (pick (-3) 7))
  end

