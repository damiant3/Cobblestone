Chapter: EffectPositive
  cites Foreword chapter Console

Section: Definitions

  apply-pure : (Integer -> Integer), Integer -> Integer
  apply-pure (f) (x) = f x

  double : Integer -> Integer
  double (n) = n * 2

  run-console : (Integer -> [Console] Nothing), Integer -> [Console] Nothing
  run-console (act-fn) (n) = act-fn n

  shout : Integer -> [Console] Nothing
  shout (n) = act
    print-line-uni ("shout " & show n)
  end

  report : Integer -> [Console] Nothing
  report (n) = act
    print-line-uni "step one"
    print-line-uni ("value " & show (apply-pure double n))
  end

  opening : [Console] Nothing = act
    report 21
    run-console shout 7
  end
