Chapter: ParseTest
  cites Foreword chapter Parse
  cites Foreword chapter Console

Section: Body
  opening : [Console] Nothing = act
    print-line (show (parse-decimal-full "123"))
    print-line (show (parse-decimal-full "-42"))
    print-line (show (parse-hex-full "0xFF"))
    print-line (show (parse-hex-full "1A"))
    print-line (show (parse-decimal "abc123def" 3))
  end

