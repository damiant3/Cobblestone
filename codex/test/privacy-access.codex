Chapter: PrivacyAccessTest
  cites Dev chapter PrivacySettings
  cites Foreword chapter Maybe

Section: Entry
  pat-uses : PrivacyState, Text, PermissionKind -> Integer
  pat-uses (st) (app) (kind) = when ps-find-grant st app kind is None -> -1 is Just (g) -> g.pg-use-count

  opening : [Console] Nothing = act
    st <- privacy-new
    print-line-uni ("default " & show (ps-is-allowed st "cam-app" PermCamera))
    g <- ps-grant st "cam-app" PermCamera 5
    print-line-uni ("granted " & show (ps-is-allowed g "cam-app" PermCamera) & " other-app " & show (ps-is-allowed g "spy" PermCamera) & " other-kind " & show (ps-is-allowed g "cam-app" PermMicrophone))
    off <- ps-toggle-camera g
    o1 <- ps-is-allowed off "cam-app" PermCamera
    on <- ps-toggle-camera off
    print-line-uni ("camera-off " & show o1 & " back-on " & show (ps-is-allowed on "cam-app" PermCamera))
    r <- ps-revoke on "cam-app" PermCamera 9
    print-line-uni ("revoked " & show (ps-is-allowed r "cam-app" PermCamera) & " count " & show r.ps-grant-count)
    c <- ps-grant r "cam-app" PermClipboard 11
    print-line-uni ("clipboard " & show (ps-is-allowed c "cam-app" PermClipboard))
    u <- ps-record-use (ps-record-use c "cam-app" PermClipboard 12) "cam-app" PermClipboard 13
    print-line-uni ("uses " & show (pat-uses u "cam-app" PermClipboard))
    n <- ps-revoke u "new-app" PermLocation 14
    print-line-uni ("revoke-new " & show (ps-is-allowed n "new-app" PermLocation) & " count " & show n.ps-grant-count)
  end
