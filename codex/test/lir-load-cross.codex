Chapter: LirLoadCross

Section: The eight-byte shapes

  Shape =
   | Circle (Integer)
   | Rect (Integer) (Integer)
   | Dot

  sh-area : Shape -> Integer
  sh-area (s) =
   when s
    is Circle (r) -> r * r * 3
    is Rect (w) (h) -> w * h
    is Dot -> 0

  sh-first : Shape -> Integer
  sh-first (s) =
   when s
    is Circle (r) -> r
    is Rect (w) (h) -> w
    is Dot -> 0

  sh-second : Shape -> Integer
  sh-second (s) =
   when s
    is Rect (w) (h) -> h
    is otherwise -> 0

  sh-twice : Shape -> Integer
  sh-twice (s) =
   when s
    is Circle (r) -> r + r
    is otherwise -> 1

  sh-both : Shape -> Integer
  sh-both (s) =
   when s
    is Rect (w) (h) -> w * 100 + h
    is otherwise -> 2

Section: The narrow shapes, which must decline

 They discriminate because the two bytes are ADJACENT. Fields pack widest
 first, so `Bytes`' two one-byte fields land at offsets 8 and 9. An eight-byte
 load at offset 8 would answer `a + b * 256`, and one at offset 9 would answer
 the same thing again, because `arm64-ldr`'s unsigned form scales its immediate
 by eight and 9/8 is 1. So a gate that let these through changes both answers,
 and `pk-lo 7 3` would read 775 instead of 7.

  Packed =
   | Bytes (Integer between 0 and 255) (Integer between 0 and 255)
   | Big (Integer)

  pk-lo : Packed -> Integer
  pk-lo (p) =
   when p
    is Bytes (a) (b) -> a
    is Big (n) -> n

  pk-hi : Packed -> Integer
  pk-hi (p) =
   when p
    is Bytes (a) (b) -> b
    is Big (n) -> n

Section: Entry

  opening : [Console] Nothing = act
   print-line-uni (show (sh-area (Circle 5)))
   print-line-uni (show (sh-area (Rect 6 7)))
   print-line-uni (show (sh-area Dot))
   print-line-uni (show (sh-first (Circle 5)))
   print-line-uni (show (sh-first (Rect 6 7)))
   print-line-uni (show (sh-first Dot))
   print-line-uni (show (sh-second (Rect 6 7)))
   print-line-uni (show (sh-second (Circle 5)))
   print-line-uni (show (sh-twice (Circle 5)))
   print-line-uni (show (sh-twice (Rect 6 7)))
   print-line-uni (show (sh-both (Rect 6 7)))
   print-line-uni (show (sh-both (Circle 5)))
   print-line-uni (show (pk-lo (Bytes 7 3)))
   print-line-uni (show (pk-hi (Bytes 7 3)))
   print-line-uni (show (pk-lo (Big 41)))
  end
