Chapter: X25519DegenerateTest
  cites Foreword chapter DiffieHellman
  cites Foreword chapter Tls
  cites Foreword chapter Console

 RFC 7748 section 6.1 (Alice's private key, Bob's public key, their shared secret) and the
 seven canonical low-order u-coordinates of Curve25519 (0, 1, the two points of order 8, p - 1, p,
 p + 1; the libsodium blocklist), every one of which a clamped scalar sends to the all-zero secret.

Section: Vectors

  xd-alice-priv : List Integer =
    [119, 7, 109, 10, 115, 24, 165, 125, 60, 22, 193, 114, 81, 178, 102, 69, 223, 76, 47, 135, 235, 192, 153, 42, 177, 119, 251, 165, 29, 185, 44, 42]

  xd-bob-pub : List Integer =
    [222, 158, 219, 125, 123, 125, 193, 180, 211, 91, 97, 194, 236, 228, 53, 55, 63, 131, 67, 200, 91, 120, 103, 77, 173, 252, 126, 20, 111, 136, 43, 79]

  xd-shared : List Integer =
    [74, 93, 157, 91, 164, 206, 45, 225, 114, 142, 59, 244, 128, 53, 15, 37, 224, 126, 33, 201, 71, 209, 158, 51, 118, 240, 155, 60, 30, 22, 23, 66]

  xd-u-order8-a : List Integer =
    [224, 235, 122, 124, 59, 65, 184, 174, 22, 86, 227, 250, 241, 159, 196, 106, 218, 9, 141, 235, 156, 50, 177, 253, 134, 98, 5, 22, 95, 73, 184, 0]

  xd-u-order8-b : List Integer =
    [95, 156, 149, 188, 163, 80, 140, 36, 177, 208, 177, 85, 156, 131, 239, 91, 4, 68, 92, 196, 88, 28, 142, 134, 216, 34, 78, 221, 208, 159, 17, 87]

  xd-u-p-minus-1 : List Integer =
    [236, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 127]

  xd-u-p : List Integer =
    [237, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 127]

  xd-u-p-plus-1 : List Integer =
    [238, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 127]

  xd-zero : List Integer = list-zeros 32

  xd-one : List Integer = list-set-at (list-zeros 32) 0 1

  xd-refused : List Integer -> Boolean
  xd-refused (u) = list-length (x25519-shared-secret xd-alice-priv u) == 0

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("control: rfc 7748 agreement matches = " & show (x25519-shared-secret xd-alice-priv xd-bob-pub == xd-shared))
    print-line-uni ("raw ladder on order-8 point a is all zero = " & show (x25519-scalar-mult xd-alice-priv xd-u-order8-a == xd-zero))
    print-line-uni ("u = 0 refused = " & show (xd-refused xd-zero))
    print-line-uni ("u = 1 refused = " & show (xd-refused xd-one))
    print-line-uni ("order-8 point a refused = " & show (xd-refused xd-u-order8-a))
    print-line-uni ("order-8 point b refused = " & show (xd-refused xd-u-order8-b))
    print-line-uni ("u = p - 1 refused = " & show (xd-refused xd-u-p-minus-1))
    print-line-uni ("u = p refused = " & show (xd-refused xd-u-p))
    print-line-uni ("u = p + 1 refused = " & show (xd-refused xd-u-p-plus-1))
    print-line-uni ("short peer key refused = " & show (xd-refused (list-zeros 31)))
    print-line-uni ("empty peer key refused = " & show (xd-refused []))
    print-line-uni ("tls client connects on an all-zero server share = " & show ((tls-complete-handshake (tls-init-client xd-alice-priv) xd-zero).tls-connected))
    print-line-uni ("tls client connects on bob's share = " & show ((tls-complete-handshake (tls-init-client xd-alice-priv) xd-bob-pub).tls-connected))
  end

