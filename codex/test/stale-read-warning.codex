Chapter: StaleReadWarning

Section: T
  St = record {
   flag-c : Integer,
   val : Integer
  }

  do-ror : St, Integer -> St
  do-ror (s) (v) = __record-set s "flag-c" (bit-and v 1)

  handler : St, Integer -> St
  handler (s) (v) =
   let r = do-ror s v
   in __record-set r "val" (bit-or (bit-shru v 1) (bit-shl s.flag-c 7))

  opening : Integer
  opening = (handler (St { flag-c = 1, val = 0 }) 184).val
