Chapter: TextScanTest
  cites Foreword chapter TextScan
  cites Foreword chapter StringUtils
  cites Foreword chapter Console

Section: Body
  opening : [Console] Nothing = act
    let parts = ["hello", "world", "codex"]
    in let joined = text-join ", " parts
    in let repeated = text-repeat "ab" 3
    in let found = text-find-char "hello" (\c -> char-code c == 23)
    in let matched = text-match-at "hello world" "world" 6
    in let no-match = text-match-at "hello world" "world" 3
    in act
      print-line-uni joined
      print-line-uni repeated
      print-line-uni (show found)
      print-line-uni (show matched)
      print-line-uni (show no-match)
    end
  end

