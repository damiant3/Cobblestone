Chapter: FnParamApply
  cites Foreword chapter Console

Section: Body

  twice : (Integer -> Integer), Integer -> Integer
  twice (f) (x) = f (f x)

  combine : (Integer, Integer -> Integer), Integer, Integer -> Integer
  combine (g) (a) (b) = g a b

  inc : Integer -> Integer
  inc (n) = n + 1

  add : Integer, Integer -> Integer
  add (a) (b) = a + b

  shadow : (Integer -> Integer), Integer -> Integer
  shadow (inc) (x) = inc x

  sum-list : List Integer, Integer, Integer -> Integer
  sum-list (xs) (i) (acc) = if i >= list-length xs then acc else sum-list xs (i + 1) (acc + list-at xs i)

  opening : [Console] Nothing = act
    print-line-uni (show (twice inc 5))
    print-line-uni (show (twice (\n -> n * 3) 2))
    print-line-uni (show (combine add 4 9))
    print-line-uni (show (shadow (\n -> n * 10) 4))
    print-line-uni (show (sum-list (for x in [1, 2, 3, 4] -> x * x) 0 0))
  end
