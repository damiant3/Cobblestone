Chapter: NestedVariant
  cites Codex chapter General

Section: Definitions

  Color =
    | Red
    | Green
    | Blue

  Shape =
    | Circle (Color) (Integer)
    | Square (Color) (Integer)

  color-name : Color -> Text
  color-name (c) = when c
    is Red -> "red"
    is Green -> "green"
    is Blue -> "blue"

  describe : Shape -> Text
  describe (s) = when s
    is Circle (c) (r) -> "circle-" & color-name c & "-r" & show r
    is Square (c) (side) -> "square-" & color-name c & "-s" & show side

  opening : Text = describe (Circle Green 5)

