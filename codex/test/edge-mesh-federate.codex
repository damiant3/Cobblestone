Chapter: EdgeMeshFederateTest

  cites Foreword chapter Console
  cites Engine chapter EdgeMesh
  cites Mesh chapter EdgeMeshFederate

 EdgeMeshGameServers phase 3, stage 1. The two arms that matter are the last
 two: at a wait long enough to widen the rating window from 200 to 1000, a pair
 1000 apart inside one lane MUST pair, and two players in different games MUST
 NOT, at that same wait. An implementation that partitions after the widening
 rather than in front of it passes the first and fails the second.

 The unfederated control is the first arm, and without it the rest measures
 nothing: it shows the plain queue pairing a Chess player with a CodexMagic one.

Section: Fixtures

  waiting-since : Integer, Text, Integer, Integer, GameMode -> QueuedPlayer
  waiting-since (id) (name) (rating) (since) (mode) =
    QueuedPlayer {
      qp-id = id,
      qp-name = name,
      qp-rating = rating,
      qp-region-pref = 0,
      qp-latencies = [],
      qp-queue-time = since,
      qp-game-mode = mode
    }

Section: Entry

  opening : [Console] Nothing
  opening = act
    let magic-a = waiting-since 1 "magic-a" 1500 0 ModeRanked
    in let magic-b = waiting-since 2 "magic-b" 1520 0 ModeRanked
    in let chess-a = waiting-since 3 "chess-a" 1500 0 ModeRanked
    in let magic-casual = waiting-since 4 "magic-casual" 1510 0 ModeCasual
    in let low = waiting-since 5 "low" 1000 0 ModeRanked
    in let high = waiting-since 6 "high" 2000 0 ModeRanked
    in let chess-low = waiting-since 7 "chess-low" 1000 0 ModeRanked
    in act
      act
        let flat = mq-enqueue (mq-enqueue mq-new magic-a) chess-a
        in when mq-try-pair flat 0
          is None -> print-line-uni ("unfederated control: no pair")
          is Just (mp) -> print-line-uni ("unfederated control: " & (mp.mp-player-a).qp-name & " vs " & (mp.mp-player-b).qp-name)
      end

      act
        let q = fed-enqueue (fed-enqueue fed-new "codexmagic" magic-a) "codexmagic" magic-b
        in print-line-uni ("same game and mode: " & fed-match-label (fed-try-pair q "codexmagic" ModeRanked 0))
      end

      act
        let q = fed-enqueue (fed-enqueue fed-new "codexmagic" magic-a) "chess" chess-a
        in act
          print-line-uni ("two games, one rating, lanes=" & show (fed-lane-count q) & ": " & fed-match-label (fed-try-pair q "codexmagic" ModeRanked 0))
          print-line-uni ("and the other lane: " & fed-match-label (fed-try-pair q "chess" ModeRanked 0))
        end
      end

      act
        let q = fed-enqueue (fed-enqueue fed-new "codexmagic" magic-a) "codexmagic" magic-casual
        in print-line-uni ("one game, two modes, waiting=" & show (fed-waiting q "codexmagic") & ": " & fed-match-label (fed-try-pair q "codexmagic" ModeRanked 0))
      end

      act
        let q = fed-enqueue (fed-enqueue fed-new "codexmagic" low) "codexmagic" high
        in print-line-uni ("1000 apart inside one lane, window widened by the wait: " & fed-match-label (fed-try-pair q "codexmagic" ModeRanked 240000))
      end

      act
        let q = fed-enqueue (fed-enqueue fed-new "codexmagic" low) "chess" chess-low
        in print-line-uni ("the same wait across two games: " & fed-match-label (fed-try-pair q "codexmagic" ModeRanked 240000))
      end

      act
        print-line-uni ("a game with no lane: " & fed-match-label (fed-try-pair fed-new "chess" ModeRanked 0))
      end
    end
  end
