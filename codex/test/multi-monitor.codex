Chapter: MultiMonitorTest
  cites Dev chapter MultiMonitor

Section: Entry
  mmt-canvas : MultiMonitorState -> Text
  mmt-canvas (st) = show (st.mm-canvas).vc-x & "," & show (st.mm-canvas).vc-y & " " & show (st.mm-canvas).vc-width & "x" & show (st.mm-canvas).vc-height

  opening : [Console] Nothing = act
    two <- mm-add-monitor (mm-add-monitor multi-monitor-new "A" 1920 1080) "B" 2560 1440
    print-line-uni ("B at x " & show (mm-find-layout two "B").ml-pos-x & " primary " & (mm-find-primary two).ml-id & " canvas " & mmt-canvas two)
    print-line-uni ("hit 2000,100 [" & mm-monitor-at-point two 2000 100 & "] 100,1200 [" & mm-monitor-at-point two 100 1200 & "]")
    c <- mm-move-cursor two 10000 (0 - 5)
    print-line-uni ("cursor " & show c.mm-cursor-x & "," & show c.mm-cursor-y & " on " & c.mm-cursor-monitor)
    print-line-uni ("mirror " & mmt-canvas (mm-set-arrange two ArrangeMirror) & " single B " & mmt-canvas (mm-set-arrange two (ArrangeSingle "B")))
    w <- mm-add-workspace two "Second"
    n1 <- (mm-next-workspace w).mm-active-workspace
    n2 <- (mm-next-workspace w).mm-active-workspace
    p1 <- (mm-prev-workspace w).mm-active-workspace
    print-line-uni ("workspaces next " & show n1 & " " & show n2 & " prev " & show p1)
  end
