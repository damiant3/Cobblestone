default: fold-constants | inline-leaf-calls | inline-single-caller
text-plug: fold-constants
parsed: 3 fold-constants | ir-check | simplify
names-text: a,b,c
names-text from 1: b,c
tagged: kept | pass 4: x | pass 4: y
frontier: PASS fold-constants frontier +640 abs 1640
fold-constants: defs=0 violations=0 infos=0
inline-leaf-calls: defs=0 violations=0 infos=0
inline-single-caller: defs=0 violations=0 infos=0
inline-cost-based: defs=0 violations=0 infos=0
ir-check: defs=0 violations=0 infos=0
occ-report: defs=0 violations=0 infos=0
simplify: defs=0 violations=0 infos=1
cover-arms: defs=0 violations=0 infos=0
lir-dump-a64: defs=0 violations=0 infos=0
no-such-pass: defs=0 violations=1 infos=0
infos=1 [PIPELINE (empty)] violations=0
infos=1 [PIPELINE fold-constants,ir-check] violations=0
