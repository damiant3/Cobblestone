Chapter: VmSerialTest
  cites Kernel chapter VmSerial

Section: Entry
  opening : [Console] Nothing = act
    p <- vm-serial-new vm-com1-base
    print-line-uni ("owns " & show (vm-serial-owns-port p 1016) & " " & show (vm-serial-owns-port p 1023) & " " & show (vm-serial-owns-port p 1024))
    a <- vm-serial-handle-out (vm-serial-handle-out p 1016 72) 1016 105
    print-line-uni ("out [" & vm-serial-get-output a & "] len " & show (vm-serial-output-length a))
    d <- vm-serial-handle-out (vm-serial-handle-out a 1019 128) 1016 33
    print-line-uni ("dlab write len " & show (vm-serial-output-length d))
    e <- vm-serial-handle-out d 1019 3
    print-line-uni ("lsr empty " & show (vm-serial-handle-in e 1021).sir-value)
    i <- vm-serial-with-input e [65, 66]
    r1 <- vm-serial-handle-in i 1021
    b1 <- vm-serial-handle-in i 1016
    b2 <- vm-serial-handle-in b1.sir-port 1016
    b3 <- vm-serial-handle-in b2.sir-port 1016
    print-line-uni ("lsr data " & show r1.sir-value & " read " & show b1.sir-value & " " & show b2.sir-value & " " & show b3.sir-value & " lsr after " & show (vm-serial-handle-in b3.sir-port 1021).sir-value)
  end
