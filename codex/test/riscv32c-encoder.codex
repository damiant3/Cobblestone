Chapter: RiscV32CEncoderTest
  cites Foreword chapter RiscV32CEncoder

Section: Helpers

  show-hex-word : Integer -> Text
  show-hex-word (w) =
    let b0 = bit-and w 255
    in let b1 = bit-and (bit-shru w 8) 255
    in let b2 = bit-and (bit-shru w 16) 255
    in let b3 = bit-and (bit-shru w 24) 255
    in hex-byte b3 & hex-byte b2 & hex-byte b1 & hex-byte b0

  show-hex-half : Integer -> Text
  show-hex-half (w) =
    let b0 = bit-and w 255
    in let b1 = bit-and (bit-shru w 8) 255
    in hex-byte b1 & hex-byte b0

  hex-byte : Integer -> Text
  hex-byte (b) = hex-nib (b / 16) & hex-nib (bit-and b 15)

  hex-nib : Integer -> Text
  hex-nib (n) =
    when n
      is 0 -> "0"
      is 1 -> "1"
      is 2 -> "2"
      is 3 -> "3"
      is 4 -> "4"
      is 5 -> "5"
      is 6 -> "6"
      is 7 -> "7"
      is 8 -> "8"
      is 9 -> "9"
      is 10 -> "A"
      is 11 -> "B"
      is 12 -> "C"
      is 13 -> "D"
      is 14 -> "E"
      is 15 -> "F"
      is otherwise -> "?"

  show-insn-16 : List Integer -> Text
  show-insn-16 (bytes) =
    let w = list-at bytes 0 + list-at bytes 1 * 256
    in show-hex-half w

  show-insn-32 : List Integer -> Text
  show-insn-32 (bytes) =
    let w = list-at bytes 0 + list-at bytes 1 * 256 + list-at bytes 2 * 65536 + list-at bytes 3 * 16777216
    in show-hex-word w

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("c.nop=" & show-insn-16 rv-c-nop)
    print-line-uni ("c.li a0,42=" & show-insn-16 (rv-c-li 10 42))
    print-line-uni ("c.mv a0,a1=" & show-insn-16 (rv-c-mv 10 11))
    print-line-uni ("c.add a0,a1=" & show-insn-16 (rv-c-add 10 11))
    print-line-uni ("c.jr ra=" & show-insn-16 (rv-c-jr 1))
    print-line-uni ("c.jalr ra=" & show-insn-16 (rv-c-jalr 1))
    print-line-uni ("c.ret=" & show-insn-16 rv-c-ret)
    print-line-uni ("c.addi a0,5=" & show-insn-16 (rv-c-addi 10 5))
    print-line-uni ("c.j +100=" & show-insn-16 (rv-c-j 100))
    print-line-uni ("li32 a0,#12345=" & show (list-length (rv-li-32 10 #12345) / 4) & " insns")
    print-line-uni ("li32 a0,42=" & show (list-length (rv-li-32 10 42) / 4) & " insns")
  end

