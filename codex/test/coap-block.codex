Chapter: CoapBlockTest

  cites Encode chapter Coap

 Exercise CoAP block-wise transfer and Observe: the block value packing,
 minimal unsigned encoding, and the full option encoding (delta + length
 + value) via coap-encode-option. Byte sequences checked against a
 hand-verified RFC 7959 / 7641 layout. opening returns the count of
 passing checks.

Section: Helpers

  bytes-eq : List Integer, List Integer -> Boolean
  bytes-eq (a) (b) =
   if list-length a /= list-length b then False
   else bytes-eq-loop a b 0 (list-length a)

  bytes-eq-loop : List Integer, List Integer, Integer, Integer -> Boolean
  bytes-eq-loop (a) (b) (i) (len) =
   if i >= len then True
   else if list-at a i /= list-at b i then False
   else bytes-eq-loop a b (i + 1) len

  flag : Boolean -> Integer
  flag (b) = if b then 1 else 0

Section: Checks

  check-block-value : Integer
  check-block-value =
   flag (coap-block-value 2 1 6 == 46)

  check-uint-bytes : Integer
  check-uint-bytes =
   flag (if bytes-eq (coap-uint-bytes 0) [] then if bytes-eq (coap-uint-bytes 46) [46] then bytes-eq (coap-uint-bytes 300) [1, 44] else False else False)

  check-block-option : Integer
  check-block-option =
   flag (bytes-eq (coap-encode-option 0 (coap-block-option coap-opt-block2 2 1 6)) [209, 10, 46])

  check-observe-option : Integer
  check-observe-option =
   flag (bytes-eq (coap-encode-option 0 (coap-observe-option 0)) [96])

  opening : Integer =
   let a = check-block-value
   in let b = check-uint-bytes
   in let c = check-block-option
   in let d = check-observe-option
   in a + b + c + d
