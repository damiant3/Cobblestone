Chapter: RealBitcast
  cites Foreword chapter Console

Section: Checks

 IEEE-754 bit-pattern intrinsics: real-to-bits / bits-to-real (f64) and
 real-approx-to-bits / bits-to-real-approx (f32). Ground-truth patterns
 are the known encodings for 0.0, 1.0, -2.0, 0.5, 42.5.

  b2i : Boolean -> Integer
  b2i (x) = if x then 1 else 0

  opening : [Console] Nothing
  opening = act
    let f64ok = b2i (real-to-bits 0.0 == #0) + b2i (real-to-bits 1.0 == #3FF0000000000000) + b2i (real-to-bits (-2.0) == #C000000000000000) + b2i (real-to-bits 0.5 == #3FE0000000000000) + b2i (real-to-bits 42.5 == #4045400000000000)
    in let f32ok = b2i (real-approx-to-bits (to-real-approx 0.0) == #0) + b2i (real-approx-to-bits (to-real-approx 1.0) == #3F800000) + b2i (real-approx-to-bits (to-real-approx (-2.0)) == #C0000000) + b2i (real-approx-to-bits (to-real-approx 0.5) == #3F000000) + b2i (real-approx-to-bits (to-real-approx 42.5) == #422A0000)
    in let rt64 = b2i (real-to-bits (bits-to-real #3FF0000000000000) == #3FF0000000000000) + b2i (real-to-bits (bits-to-real #4045400000000000) == #4045400000000000)
    in let rt32 = b2i (real-approx-to-bits (bits-to-real-approx #3F800000) == #3F800000) + b2i (real-approx-to-bits (bits-to-real-approx #422A0000) == #422A0000)
    in act
      print-line-uni ("f64-bits: " & show f64ok & "/5")
      print-line-uni ("f32-bits: " & show f32ok & "/5")
      print-line-uni ("roundtrip-f64: " & show rt64 & "/2")
      print-line-uni ("roundtrip-f32: " & show rt32 & "/2")
    end
  end
