Chapter: BootPaintRtcHour
  cites Foreword chapter Console
  cites Codex chapter BootPaint

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("bcd 24h 0x13 : " & show (bp-hour 2 19))
    print-line-uni ("bcd 12h 1 pm : " & show (bp-hour 0 129))
    print-line-uni ("bcd 12h 12am : " & show (bp-hour 0 18))
    print-line-uni ("bcd 12h 12pm : " & show (bp-hour 0 146))
    print-line-uni ("bin 12h 1 pm : " & show (bp-hour 4 129))
    print-line-uni ("bin 12h 11pm : " & show (bp-hour 4 139))
    print-line-uni ("bin 24h 23   : " & show (bp-hour 6 23))
  end
