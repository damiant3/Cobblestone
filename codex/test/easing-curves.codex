Chapter: EasingCurves
  cites Game chapter Easing

Section: Checks

  at : (Integer -> Integer), List Integer, Integer, Integer -> Text
  at (f) (ts) (i) (n) =
    if i >= n then ""
    else (if i == 0 then "" else " ") & show (f (list-at ts i)) & at f ts (i + 1) n

  curve : (Integer -> Integer), List Integer -> Text
  curve (f) (ts) = at f ts 0 (list-length ts)

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (curve ease-out-bounce [0, 200, 363, 364, 500, 800, 1000])
    print-line-uni (curve ease-in-bounce [500, 0, 1000])
    print-line-uni (curve ease-in-quad [500] & " " & curve ease-out-quad [500] & " " & curve ease-in-out-quad [250, 750, 1000])
    print-line-uni (curve ease-in-cubic [500] & " " & curve ease-out-cubic [500] & " " & curve ease-in-out-cubic [250, 750])
    print-line-uni (curve ease-in-back [500] & " " & curve ease-out-back [500])
    print-line-uni (show (ease-lerp 100 300 250) & " " & curve ease-linear [333])
    print-line-uni ("in-sine " & curve ease-in-sine [0, 500, 1000] & ", out-sine " & curve ease-out-sine [0, 500, 1000])
    print-line-uni ("out-elastic " & curve ease-out-elastic [0, 100, 250, 500, 1000])
  end
