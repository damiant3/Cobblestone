# The probe paints at a fixed 640x480 and writes the framebuffer directly,
# so the test states the mode rather than inheriting the harness default.
# Recorded at 1024x768 the frame smears: the probe's stride is 640 and every
# row lands 384 pixels off, which is what a hardcoded geometry looks like
# when the machine disagrees.
vmargs -gop-width 640 -gop-height 480
boot 3000
settle 2000
