Chapter: LocationSensorsStub
  cites Foreword chapter LocationStub
  cites Foreword chapter SensorsStub

Section: Entry

  opening : [Console, Location, Sensors] Nothing = act
    lfx <- location-is-fixed
    fix <- locate
    alt <- altitude
    sfx <- sensors-are-fixed
    acc <- accelerometer
    gyr <- gyroscope
    bar <- barometer
    lux <- light-level
    print-line-uni ("location fixed " & show lfx)
    print-line-uni ("locate " & show (fix.lf-latitude) & " " & show (fix.lf-longitude))
    print-line-uni ("altitude " & show alt)
    print-line-uni ("sensors fixed " & show sfx)
    print-line-uni ("accel " & show (acc.sx-x) & " " & show (acc.sx-y) & " " & show (acc.sx-z))
    print-line-uni ("gyro " & show (gyr.sx-x) & " " & show (gyr.sx-y) & " " & show (gyr.sx-z))
    print-line-uni ("barometer " & show bar)
    print-line-uni ("light " & show lux)
  end
