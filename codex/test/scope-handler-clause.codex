Chapter: ScopeHandlerClause
  cites Foreword chapter Console

Section: Effects

  effect Counter where
    tick : [Counter] Integer

Section: Definitions

  resume : Text
  resume = "GLOBAL"

Section: Entry

  opening : [Console] Nothing =
    let r1 = with Counter tick
      tick (resume) = resume 42
    in act
      print-line-uni ("counter: " & show r1)
      print-line-uni ("after: " & resume)
    end
