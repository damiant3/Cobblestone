Chapter: Stm32F4Drivers

  cites Boards chapter Stm32F4Board

 Smoke test for STM32F4 board drivers. Every register access is a real
 aligned load or store; under codex-vm the STM32's peripheral window
 falls inside guest RAM, so a write is read back. That exercises the
 address arithmetic, the access width, and the read-modify-write logic.
 It is not peripheral behaviour -- no silicon has been in the loop.

Section: Definitions

  test-gpio : [Device.Mmio] Integer
  test-gpio = act
    a <- stm32-gpio-enable-port stm32-rcc-gpiod-en
    b <- stm32-gpio-set-output stm32-gpiod-base 12
    c <- stm32-gpio-set-input stm32-gpioa-base 0
    d <- stm32-gpio-set-alternate stm32-gpioa-base 2 7
    e <- stm32-gpio-set-pull stm32-gpioa-base 3 1
    f <- stm32-gpio-set-speed stm32-gpiod-base 12 2
    g <- stm32-gpio-write stm32-gpiod-base 12 True
    h <- stm32-gpio-read stm32-gpiod-base 12
    i <- (stm32-gpio-toggle stm32-gpiod-base 12)
    1
  end

  test-led : [Device.Mmio] Integer
  test-led = act
    a <- stm32-led-init
    b <- stm32-led-on stm32-led-green-pin
    c <- (stm32-led-off stm32-led-green-pin)
    1
  end

  test-uart : [Device.Mmio] Integer
  test-uart = act
    a <- stm32-uart2-init 115200
    b <- stm32-uart-send-byte stm32-usart2-base 65
    c <- stm32-uart-print stm32-usart2-base "hello"
    d <- (stm32-uart-println stm32-usart2-base "world")
    1
  end

  test-spi : [Device.Mmio] Integer
  test-spi = act
    a <- stm32-spi1-init
    b <- (stm32-spi-transfer stm32-spi1-base #AA)
    1
  end

  test-i2c : [Device.Mmio] Integer
  test-i2c = act
    a <- stm32-i2c1-init
    b <- stm32-i2c-write-reg stm32-i2c1-base #68 #6B 0
    c <- (stm32-i2c-read-reg stm32-i2c1-base #68 #75)
    1
  end

  test-uart-linear : [Uart, Device.Mmio] Integer
  test-uart-linear = act
    brd0 <- board-open 0 0
    o <- stm32-uart-open brd0 115200
    when o
     is (brd1, p0) -> act
       p1 <- stm32-uart-write p0 72
       p2 <- (stm32-uart-write p1 73)
       c <- (stm32-uart-close p2)
       bc <- (board-close brd1)
       1
     end
  end

  test-gpio-linear : [Gpio, Device.Mmio] Integer
  test-gpio-linear = act
    en <- stm32-gpio-enable-port stm32-rcc-gpiod-en
    brd0 <- board-open 0 0
    o <- stm32-gpio-open brd0 stm32-gpiod-base 12 PinOutput
    when o
     is (brd1, q0) -> act
       q1 <- stm32-pin-write q0 True
       q2 <- (stm32-pin-write q1 False)
       c <- (stm32-pin-close q2)
       bc <- (board-close brd1)
       1
     end
  end

  test-delay : Integer
  test-delay =
    let a = stm32-delay-ms 1
    in 1

  test-pin-read : [Gpio, Device.Mmio] Integer
  test-pin-read = act
    brd0 <- board-open 0 0
    o <- stm32-gpio-open brd0 stm32-gpiod-base 12 PinInput
    when o
     is (brd1, q0) -> act
       r <- stm32-pin-read q0
       when r
        is (q1, lv) -> act
          c <- (stm32-pin-close q1)
          bc <- (board-close brd1)
          1
        end
     end
  end

  test-uart-recv : [Uart, Device.Mmio] Integer
  test-uart-recv = act
    brd0 <- board-open 0 0
    o <- stm32-uart-open brd0 115200
    when o
     is (brd1, p0) -> act
       r <- stm32-uart-recv p0 1
       when r
        is (p1, bytes) -> act
          c <- (stm32-uart-close p1)
          bc <- (board-close brd1)
          if list-length bytes == 1 then 1 else 0
        end
     end
  end

  test-spi-txn : [Spi, Device.Mmio] Integer
  test-spi-txn = act
    brd0 <- board-open 0 0
    o <- stm32-spi-open brd0
    when o
     is (brd1, s0) -> act
       t0 <- stm32-spi-select s0 4
       r <- stm32-spi-txn-transfer t0 [#AA, #55]
       when r
        is (t1, got) -> act
          s1 <- stm32-spi-deselect t1
          c <- (stm32-spi-close s1)
          bc <- (board-close brd1)
          if list-length got == 2 then 1 else 0
        end
     end
  end

  test-i2c-bus : [I2c, Device.Mmio] Integer
  test-i2c-bus = act
    brd0 <- board-open 0 0
    o <- stm32-i2c-open brd0
    when o
     is (brd1, b0) -> act
       w <- stm32-i2c-bus-write-reg b0 #68 #6B 0
       when w
        is (b1, wr) -> act
          r <- stm32-i2c-bus-read-reg b1 #68 #75
          when r
           is (b2, rv) -> act
             c <- (stm32-i2c-close b2)
             bc <- (board-close brd1)
             1
           end
        end
     end
  end

  test-adc : [Device.Mmio] Integer
  test-adc = act
    a <- stm32-adc1-init
    b <- (stm32-adc-read 0)
    1
  end

  test-adc-unit : [Adc, Device.Mmio] Integer
  test-adc-unit = act
    brd0 <- board-open 0 0
    o <- stm32-adc-open brd0
    when o
     is (brd1, a0) -> act
       r <- stm32-adc-unit-sample a0 0
       when r
        is (a1, v) -> act
          c <- (stm32-adc-close a1)
          bc <- (board-close brd1)
          1
        end
     end
  end

  opening : [Gpio, Uart, Spi, I2c, Adc, Device.Mmio] Integer = act
    g <- test-gpio
    l <- test-led
    u <- test-uart
    s <- test-spi
    i <- test-i2c
    ul <- test-uart-linear
    gl <- test-gpio-linear
    pr <- test-pin-read
    ib <- test-i2c-bus
    st <- test-spi-txn
    ur <- test-uart-recv
    ad <- test-adc
    au <- test-adc-unit
    g + l + u + s + i + ul + gl + pr + ib + st + ur + ad + au + test-delay
  end

