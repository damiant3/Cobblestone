Chapter: Stm32F4Drivers

  cites Boards chapter Stm32F4Board

 Smoke test for STM32F4 board drivers. MMIO stubs return 0 on the
 hosted VM, so this exercises the driver logic and bit manipulation
 without real hardware.

Section: Definitions

  test-gpio : Integer
  test-gpio =
    let a = stm32-gpio-enable-port stm32-rcc-gpiod-en
    in let b = stm32-gpio-set-output stm32-gpiod-base 12
    in let c = stm32-gpio-set-input stm32-gpioa-base 0
    in let d = stm32-gpio-set-alternate stm32-gpioa-base 2 7
    in let e = stm32-gpio-set-pull stm32-gpioa-base 3 1
    in let f = stm32-gpio-set-speed stm32-gpiod-base 12 2
    in let g = stm32-gpio-write stm32-gpiod-base 12 True
    in let h = stm32-gpio-read stm32-gpiod-base 12
    in let i = stm32-gpio-toggle stm32-gpiod-base 12
    in 1

  test-led : Integer
  test-led =
    let a = stm32-led-init
    in let b = stm32-led-on stm32-led-green-pin
    in let c = stm32-led-off stm32-led-green-pin
    in 1

  test-uart : Integer
  test-uart =
    let a = stm32-uart2-init 115200
    in let b = stm32-uart-send-byte stm32-usart2-base 65
    in let c = stm32-uart-print stm32-usart2-base "hello"
    in let d = stm32-uart-println stm32-usart2-base "world"
    in 1

  test-spi : Integer
  test-spi =
    let a = stm32-spi1-init
    in let b = stm32-spi-transfer stm32-spi1-base #AA
    in 1

  test-i2c : Integer
  test-i2c =
    let a = stm32-i2c1-init
    in let b = stm32-i2c-write-reg stm32-i2c1-base #68 #6B 0
    in let c = stm32-i2c-read-reg stm32-i2c1-base #68 #75
    in 1

  test-delay : Integer
  test-delay =
    let a = stm32-delay-ms 1
    in 1

  opening : Integer =
    let g = test-gpio
    in let l = test-led
    in let u = test-uart
    in let s = test-spi
    in let i = test-i2c
    in let d = test-delay
    in g + l + u + s + i + d

