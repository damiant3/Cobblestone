Chapter: LazyEval
  cites Foreword chapter Console

 Test lazy evaluation with memoization and force builtin.
 The thunk body should execute only once; subsequent forces return cached value.

Section: Types

  mutable Counter = record {
   value : Integer
  }

Section: Helpers

  expensive : Counter, Integer -> Integer
  expensive (ctr) (x) =
   let prev = ctr.value
   in let dummy = __record-set ctr "value" (prev + 1)
   in x * 10 + 7

Section: Opening

  opening : [Console] Nothing
  opening = act
   let ctr = Counter { value = 0 }
   in let thunk = lazy (expensive ctr 3)
   in act
    print-line-uni ("before force")
    let r1 = force thunk
    in act
     print-line-uni ("first: " & show r1)
     let r2 = force thunk
     in act
      print-line-uni ("second: " & show r2)
      print-line-uni ("evals: " & show (ctr.value))
     end
    end
   end
  end
