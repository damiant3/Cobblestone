Chapter: MaskOps
  cites Foreword chapter Console

Section: Entry
  opening : [Console] Nothing
  opening = act
    let a = vec-splat 3.0
    in let b = vec-splat 7.0
    in let m1 = a < b
    in act
      print-line-uni ("any-lt: " & show (mask-any m1))
      print-line-uni ("all-lt: " & show (mask-all m1))
      print-line-uni ("none-lt: " & show (mask-none m1))
      print-line-uni ("count-lt: " & show (mask-count m1))
    end
    let c = vec-splat 10.0
    in let d = vec-splat 2.0
    in let m2 = c < d
    in act
      print-line-uni ("any-gt: " & show (mask-any m2))
      print-line-uni ("all-gt: " & show (mask-all m2))
      print-line-uni ("none-gt: " & show (mask-none m2))
      print-line-uni ("count-gt: " & show (mask-count m2))
    end
  end
