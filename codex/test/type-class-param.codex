Chapter: TypeClassParam
  cites Foreword chapter Console

 An instance over a parameterized type. Dispatch on a List argument
 selects the List instance; dispatch on an Integer selects that one.

class Showable where
  to-text : a -> Text

instance Showable Integer where
  to-text (x) = show x

instance Showable (List Integer) where
  to-text (xs) = "list of " & show (list-length xs)

Section: Opening

  opening : [Console] Nothing
  opening = act
   print-line-uni (to-text 7)
   print-line-uni (to-text [1, 2, 3])
  end
