Chapter: HandlerUnusedCall
  cites Foreword chapter FileSystem

Section: Body

  pure-body : Integer -> Text
  pure-body (x) = if x == 0 then "zero" else "other"

  served : Integer -> Text
  served (x) = act
    with FileSystem (pure-body x)
      read-text (p) (resume) = resume "never"
      write-file (p) (c) (resume) = resume False
  end

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("handler-unused-call " & served 0)
  end