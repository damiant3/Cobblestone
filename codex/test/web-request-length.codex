Chapter: WebRequestLength
  cites Net chapter WebServer
  cites Works chapter Http
  cites Foreword chapter Console

  crlf : List Integer = [13, 10]

  req : List Integer, List Integer -> List Integer
  req (headers) (body) = http-text-to-ascii "POST /x HTTP/1.1" & crlf & headers & crlf & body

  hdr : Text -> List Integer
  hdr (t) = http-text-to-ascii t & crlf

  report : Text, List Integer -> [Console] Nothing
  report (name) (bs) =
    let total = wb-request-total bs (list-length bs)
    in print-line-uni (name & " total=" & show total & " of " & show (list-length bs))

  opening : [Console] Nothing = act
    report "content-length 3       " (req (hdr "Content-Length: 3") [97, 98, 99])
    report "no content-length      " (req (hdr "Host: a") [])
    report "ows around the value   " (req (http-text-to-ascii "Content-Length:" & [32, 9] & http-text-to-ascii "3" & [32] & crlf) [97, 98, 99])
    report "duplicates agree       " (req (hdr "Content-Length: 3" & hdr "Content-Length: 3") [97, 98, 99])
    report "no digits              " (req (hdr "Content-Length: abc") [97, 98, 99])
    report "trailing junk          " (req (hdr "Content-Length: 3abc") [97, 98, 99])
    report "duplicates disagree    " (req (hdr "Content-Length: 3" & hdr "Content-Length: 0") [97, 98, 99])
    report "prefixed name only     " (req (hdr "X-Content-Length: 3") [97, 98, 99])
    report "length and chunked     " (req (hdr "Content-Length: 3" & hdr "Transfer-Encoding: chunked") [97, 98, 99])
    report "chunked alone          " (req (hdr "Transfer-Encoding: chunked") [48, 13, 10, 13, 10])
    report "past the cap           " (req (hdr "Content-Length: 99999999999") [97])
    print-line-uni "done"
  end

