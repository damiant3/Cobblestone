Chapter: HandleConcurrent

  cites Codex chapter General

  cites Codex chapter Concurrency



Section: Effect

  effect Config where

    get-scale : [Config] Integer



Section: Body

  scaled : Integer, Integer, Nothing -> Integer

  scaled (x) (s) (u) = x * s



  opening : [Concurrent] Integer = with Config (let s = get-scale in let t = fork (scaled 7 s) in await t)

    get-scale (resume) = resume 6

