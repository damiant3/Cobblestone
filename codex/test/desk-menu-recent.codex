Chapter: DeskMenuRecentTest
  cites Works chapter GopPrograms
  cites Works chapter GopAhci

Section: Main

  dmr-labels : List Integer, Integer, Text -> Text
  dmr-labels (ms) (i) (acc) =
    if i >= list-length ms then acc
    else dmr-labels ms (i + 1) (acc & (if i == 0 then "" else ",") & (gpr-at (list-at ms i)).ge-label)

  dmr-launch : Integer, List Integer, Integer -> Integer
  dmr-launch (ps) (scs) (i) =
    if i >= list-length scs then 0
    else let k = gpr-launched ps (list-at scs i)
    in dmr-launch ps scs (i + 1)

  dmr-recent : Integer, Text -> Text
  dmr-recent (ps) (label) = label & ": recent [" & dmr-labels (gpr-mru ps) 0 "" & "]"

  opening : [Console] Nothing =
    let ps = alloc-zeroed 64 64
    in let e0 = gpr-ensure ps
    in let l0 = dmr-recent ps "fresh" & " opens at " & (gpr-at (gpr-sel ps)).ge-label
    in let a = dmr-launch ps [33, 46, 33] 0
    in let l1 = dmr-recent ps "Files, Calculator, Files"
    in let e1 = gpr-ensure ps
    in let l2 = "menu opens at " & (gpr-at (gpr-sel ps)).ge-label
    in let k = gpr-key ps 46
    in let l3 = "search c: " & dmr-labels (gpr-matches ps) 0 "" & "; sel " & (gpr-at (gpr-sel ps)).ge-label
    in let e2 = gpr-ensure ps
    in let b = dmr-launch ps [37, 38, 16, 18, 20, 19] 0
    in let l4 = dmr-recent ps "six more"
    in let c = dmr-launch ps [1000005] 0
    in let l5 = dmr-recent ps "a code that names no entry"
    in act
      print-line-uni l0
      print-line-uni l1
      print-line-uni l2
      print-line-uni l3
      print-line-uni l4
      print-line-uni l5
    end
