Chapter: EffectLaunderRecord
  cites Foreword chapter Console

Section: Definitions

  boom : Integer -> [Console] Integer
  boom (n) = act
    print-line-uni "field boom"
    n
  end

  Holder = record {
   fn : Integer -> Integer
  }

  quiet : Integer -> Integer
  quiet (n) =
   let h = Holder { fn = boom }
   in (h.fn) n

  opening : [Console] Nothing = act
    print-line-uni ("result " & show (quiet 41))
  end
