Chapter: CceForeignByte
  cites Foreword chapter CCE

 Bytes a, CR, LF, b, TAB, c, BEL, DEL through the helper: CR, BEL and DEL are
 dropped, TAB becomes a space, LF stays. The raw path writes unit 255 for each
 unmapped byte, which is the defect the helper closes.

  bytes-text : List Integer, Integer, Text -> Text
  bytes-text (bs) (i) (acc) =
    if i >= list-length bs then acc else bytes-text bs (i + 1) (acc & cce-foreign-byte-text (list-at bs i))

  raw-text : List Integer, Integer, Text -> Text
  raw-text (bs) (i) (acc) =
    if i >= list-length bs then acc else raw-text bs (i + 1) (acc & char-encode (code-to-char (from-unicode (list-at bs i))))

  yn : Boolean -> Text
  yn (b) = if b then "yes" else "no"

  opening : [Console] Nothing = act
    let bs = [97, 13, 10, 98, 9, 99, 7, 127]
    in let t = bytes-text bs 0 ""
    in let r = raw-text bs 0 ""
    in act
      print-line-uni ("helper length : " & show (text-length t))
      print-line-uni ("helper text   : " & yn (t == "a\nb c"))
      print-line-uni ("raw length    : " & show (text-length r))
    end
  end
