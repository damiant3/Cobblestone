Chapter: Vec256CrossRefused
  cites Foreword chapter Console

Section: Subjects

  eight : Vector 8 (Real approximate)
  eight = vec8-splat (to-real-approx 1.5) + vec8-splat (to-real-approx 2.5)

  four : Vector 4 Real
  four = vec4d-splat 1.5

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (show (from-real-approx (vec8-extract eight 7)))
    print-line-uni (show (mask8-any (eight < eight)))
    print-line-uni (show (vec4d-reduce-add four))
  end

