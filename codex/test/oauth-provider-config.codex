Chapter: OauthProviderConfig
  cites Net chapter OAuthClient
  cites Net chapter OAuthProvider
  cites Foreword chapter Console

Section: Checks
  words : Text -> Integer
  words (t) = list-length (text-split t " ")

  row : Text, OAuthConfig -> Text
  row (n) (c) = n & ": " & c.oc-provider & " scopes=" & show (words c.oc-scopes) & " auth=" & c.oc-auth-url & " token=" & c.oc-token-url

  who : Text -> Text
  who (issuer) = "[" & issuer & "] -> " & oauth-provider-name issuer

  opening : [Console] Nothing = act
    print-line-uni (row "google-login" (google-oauth-config "id1" "http://localhost/cb"))
    print-line-uni (row "google-mail" (google-oauth-mail "id1" "http://localhost/cb"))
    print-line-uni (row "google-full" (google-oauth-full "id1" "http://localhost/cb"))
    print-line-uni (row "ms-login" (microsoft-oauth-config "id2" "contoso" "http://localhost/cb"))
    print-line-uni (row "ms-mail" (microsoft-oauth-mail "id2" "common" "http://localhost/cb"))
    print-line-uni (row "ms-full" (microsoft-oauth-full "id2" "organizations" "http://localhost/cb"))
    print-line-uni ("client and redirect kept: " & (google-oauth-config "id1" "http://localhost/cb").oc-client-id & " " & (microsoft-oauth-config "id2" "t" "http://x/y").oc-redirect-uri)
    print-line-uni ("ms issuer: " & microsoft-issuer "contoso")
    print-line-uni (format-provider (microsoft-oauth-mail "id2" "common" "http://localhost/cb"))
    print-line-uni (who google-issuer)
    print-line-uni (who (microsoft-issuer "contoso"))
    print-line-uni (who "https://example.org")
    print-line-uni (who "")
    print-line-uni (who "https://evil.example/google")
    print-line-uni (who "https://login.microsoftonline.com.evil.example/")
    print-line-uni (who "accounts.google.com")
    print-line-uni (who "https://accounts.google.com.evil.example")
    print-line-uni (who "https://evil.example/https://accounts.google.com")
    print-line-uni (who "http://accounts.google.com")
    print-line-uni (who "https://login.microsoftonline.com/contoso/v2.0/evil")
    print-line-uni (who "https://login.microsoftonline.com//v2.0")
    print-line-uni (who "https://login.microsoftonline.com/a/b/v2.0")
    print-line-uni (who "http://login.microsoftonline.com/contoso/v2.0")
    print-line-uni (who "https://login.microsoftonline.com/contoso/v1.0")
  end
