Chapter: MutableFnField
  cites Foreword chapter Console

 Mutable record with a function-typed field.
 Verifies: construction, integer field read, function field call,
 function field mutation via field assignment.

Section: Types

  mutable Thunk = record {
   forced : Integer,
   cached : Integer,
   compute : Integer -> Integer
  }

Section: Helpers

  double : Integer -> Integer
  double (x) = x * 2

  triple : Integer -> Integer
  triple (x) = x * 3

  force : Thunk -> Integer
  force (t) =
   if t.forced == 1 then t.cached
   else t.compute (t.cached)

Section: Opening

  opening : [Console] Nothing
  opening = act
   let t = Thunk { forced = 0, cached = 5, compute = double }
   in act
    print-line-uni ("force: " & show (force t))
    t.forced = 1
    t.cached = 10
    print-line-uni ("cached: " & show (force t))
    t.compute = triple
    t.forced = 0
    print-line-uni ("recompute: " & show (force t))
   end
  end
