Chapter: UnitSmoke
  cites Foreword chapter Console

Section: Types
  Second = unit Integer
  Meter = unit Integer
  Minute = unit Integer

  1 Minute = 60 Second

Section: Conversion
  minute-to-second : Minute -> Second
  minute-to-second (m) = Second (m * 60)

Section: Construction
  make-duration : Integer -> Second
  make-duration (n) = Second n

Section: Body
  opening : [Console] Nothing = act
    let t1 = Second 42
    in let t2 = Second 8
    in let d = Meter 100
    in let sum = t1 + t2
    in let scaled = t1 * 3
    in let m = Minute 2
    in let s = minute-to-second m
    in let built = make-duration 99
    in act
      print-line-uni (show t1)
      print-line-uni (show d)
      print-line-uni (show sum)
      print-line-uni (show scaled)
      print-line-uni (show (t1 > t2))
      print-line-uni (show s)
      print-line-uni (show built)
    end
  end

