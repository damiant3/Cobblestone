Chapter: ZigFailRaise
  cites Foreword chapter Console

Section: Body

  risky : Integer -> Integer
  risky (n) = if n > 5 then fail "too big" else n

  opening : [Console] Nothing = act
    print-line-uni (show (risky 3))
    trying 1 times
      print-line-uni (show (risky 9))
    falling back to
      print-line-uni "fallback"
    on failure
      print-line-uni "on-failure"
    end
  end
