Chapter: NetIoClock
  cites Net chapter NetIO
  cites Net chapter TcpTransport
  cites Net chapter NetworkStack
  cites Net chapter Tcp
  cites Net chapter Ethernet
  cites Foreword chapter Console

 We say:

Section: Wire Fixtures
  srv-mac : List Integer = [82, 84, 0, 18, 52, 86]
  cli-mac : List Integer = [82, 85, 10, 0, 2, 2]
  srv-ip : List Integer = [10, 0, 2, 15]
  cli-ip : List Integer = [10, 0, 2, 100]
  gw-ip : List Integer = [10, 0, 2, 2]

  get-bytes : List Integer = [71, 69, 84, 32, 47, 32, 72, 84, 84, 80, 47, 49, 46, 49, 13, 10, 13, 10]
  resp-bytes : List Integer = [72, 73]

  psh : Integer = bit-or tcp-flag-psh tcp-flag-ack

  mkc : Integer, Integer, Integer, List Integer -> List Integer
  mkc (seq) (ack) (flags) (payload) =
    let seg = tcp-build-segment 50000 80 seq ack flags 8192 payload
    in let ip = ip-build-packet cli-ip srv-ip ip-proto-tcp seg
    in eth-build-frame srv-mac cli-mac eth-type-ipv4 ip

  c-syn : List Integer = mkc 1000 0 tcp-flag-syn []
  c-getack : List Integer = mkc 1001 5001 psh get-bytes

Section: Server Session
  srv0 : NetSession = net-session-new srv-mac srv-ip gw-ip 80 0 cli-ip 5000
  listening : NetSession = (net-listen srv0).session
  established : NetSession =
    let s1 = (net-process-frame listening c-syn).session
    in (net-process-frame s1 c-getack).session

Section: Ticks To Give Up

 The ladder is counted rather than asserted at 141 and 288, because the
 arm exists to catch net-rto-max-tries, the backoff or either NetIO
 constant moving apart from the others.

  session-closed : NetSession -> Boolean
  session-closed (s) = when ((s.conn).state)
    is TcpClosed -> True
    is otherwise -> False

  ticks-to-close : NetSession, Integer, Integer -> Integer
  ticks-to-close (s) (n) (fuel) =
    if session-closed s then n
    else if fuel <= 0 then 0 - 1
    else ticks-to-close ((net-tick s).session) (n + 1) (fuel - 1)

Section: The Loop Itself

 The arm above is arithmetic and would still pass if no loop ever turned
 the clock, which is the state this whole change was written about. This
 one runs a real poll loop against a peer that does not exist, with the
 session pre-aged to one tick short of give-up so the arm costs one
 tick-interval of polling instead of the 141 the unmeasured ladder takes
 (measured 2026-08-09 at 263 s under codex-vm, far past the harness wall
 budget).

 CLOSED with an empty queue is the tick reaching net-tick and the give-up
 firing. ESTABLISHED is the loop running to its fuel cap with the session
 never aged, which is what every caller but WebServer did until now.

  primed : NetSession =
    let sent = (net-send established resp-bytes).session
    in set-rexmit sent (sent.rexmit-queue) 1 net-rto-max-tries

Section: Entry
  opening : [Console, Network.Read, Network.Write] Nothing = act
    let quick = (net-send established resp-bytes).session
    in let slow = (net-send (set-rtt established (48 * 8) 0) resp-bytes).session
    in let q-ticks = ticks-to-close quick 0 1000
    in let s-ticks = ticks-to-close slow 0 1000
    in let worst = if s-ticks > q-ticks then s-ticks else q-ticks
    in let polls = worst * net-io-tick-interval
    in act
      print-line-uni ("unmeasured-ladder=" & show q-ticks)
      print-line-uni ("clamped-ladder=" & show s-ticks)
      print-line-uni ("polls-to-giveup=" & show polls)
      print-line-uni ("fits-in-fuel=" & (if polls <= net-io-max-polls then "yes" else "NO"))
      print-line-uni ("idle-before-tick=" & show net-io-tick-interval)
      let ts0 = transport-set-session (transport-new established) primed
      in act
        print-line-uni ("live-start=" & tcp-state-name (((ts0.session).conn).state) & " queued=" & show (list-length ((ts0.session).rexmit-queue)))
        r <- net-io-recv-raw ts0 0
        let ts1 = r.transport
        in print-line-uni ("live-end=" & tcp-state-name (((ts1.session).conn).state) & " queued=" & show (list-length ((ts1.session).rexmit-queue)) & " ticks=" & show ((ts1.session).now-ticks))
      end
    end
  end
