Chapter: Sass89HmmaTuringas
  cites Sass chapter Sass89Hmma
  cites Foreword chapter Format

  bar-at : Integer -> Integer
  bar-at (n) = if int-mod n 7 == 0 then 7 else int-mod n 7 - 1

  case-at : Integer -> Hmma89
  case-at (j) =
    if j >= 64 then isolated-case j
    else let p = int-mod j 8
    in Hmma89 {
     k = if int-mod j 2 == 0 then 8 else 16,
     accum-bits = if int-mod (j / 2) 2 == 0 then 16 else 32,
     dst = int-mod (j * 17) 256,
     a = int-mod (j * 31 + 2) 256,
     b = int-mod (j * 43 + 4) 256,
     c = if int-mod j 7 == 0 then 255 else int-mod (j * 61 + 6) 256,
     guard = p,
     guard-neg = if p == 7 then 0 else int-mod (j / 8) 2,
     control = CtrlCode {
      stall = int-mod j 16,
      yield-bit = int-mod j 2,
      write-bar = bar-at j,
      read-bar = bar-at (j * 3),
      wait-mask = j,
      reuse = int-mod j 8
     }
    }

  isolated-case : Integer -> Hmma89
  isolated-case (j) = Hmma89 {
   k = if j == 122 then 8 else 16,
   accum-bits = if j == 123 then 16 else 32,
   dst = if j == 124 then 255 else 0,
   a = if j == 125 then 255 else 4,
   b = if j == 126 then 255 else 8,
   c = if j == 127 then 255 else 12,
   guard = if j >= 88 & j <= 95 then j - 88 else if j >= 96 & j <= 102 then j - 96 else 7,
   guard-neg = if j >= 96 & j <= 102 then 1 else 0,
   control = CtrlCode {
    stall = if j >= 64 & j <= 79 then j - 64 else 0,
    yield-bit = if j == 121 then 1 else 0,
    write-bar = if j >= 103 & j <= 108 then j - 103 else 7,
    read-bar = if j >= 109 & j <= 114 then j - 109 else 7,
    wait-mask = if j >= 115 & j <= 120 then bit-shl 1 (j - 115) else 0,
    reuse = if j >= 80 & j <= 87 then j - 80 else 0
   }
  }

  print-case : Integer -> [Console] Nothing
  print-case (j) = act
    when sass89-hmma (case-at j)
     is Sass89Words (lo) (hi) -> print-line-uni (show j & " " & fmt-hex-pad lo 16 & " " & fmt-hex-pad hi 16)
     is Sass89Refused (why) -> print-line-uni ("REFUSED " & show j & " " & why)
  end

  print-cases : Integer -> [Console] Nothing
  print-cases (j) = act
   if j >= 128 then print-text "" else act
    print-case j
    print-cases (j + 1)
   end
  end

  opening : [Console] Nothing = print-cases 0
