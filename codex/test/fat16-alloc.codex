Chapter: Fat16Alloc

  cites Foreword chapter Fat16

 We say:

Section: Entry

  opening : [Console, Device.Block] Nothing
  opening = act
    vol <- fat16-init 2048
    print-line-uni ("usable " & show (fat16-vol-is-usable vol))
    print-line-uni ("fats " & show (vol.vol-num-fats))
    print-line-uni ("clusters " & show (vol.vol-cluster-count))

    free1 <- fat16-find-free-cluster vol
    print-line-uni ("free-found " & show (free1 > 0))

    before0 <- fat16-read-fat-entry vol 0 free1
    before1 <- fat16-read-fat-entry vol 1 free1
    print-line-uni ("before-copy0 " & show before0)
    print-line-uni ("before-copy1 " & show before1)

    got <- fat16-alloc-cluster vol
    print-line-uni ("claimed-what-it-found " & show (got == free1))

    after0 <- fat16-read-fat-entry vol 0 got
    after1 <- fat16-read-fat-entry vol 1 got
    print-line-uni ("after-copy0 " & show after0)
    print-line-uni ("after-copy1 " & show after1)
    print-line-uni ("copies-agree " & show (after0 == after1))
    print-line-uni ("is-end " & show (fat16-is-end after0))

    free2 <- fat16-find-free-cluster vol
    print-line-uni ("second-differs " & show (free2 /= free1))
  end
