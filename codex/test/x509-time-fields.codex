  cal-now : List Integer = [50, 48, 50, 53, 48, 49, 48, 49, 48, 48, 48, 48, 48, 48]

  ca-parsed : Maybe X509Cert = x509-parse ca-cert

  anchors : List X509Anchor =
    when ca-parsed is None -> [] is Just (c) -> [X509Anchor { xa-subject = c.xc-subject, xa-key = c.xc-key }]

Section: Helpers

  copy-bytes : List Integer -> List Integer
  copy-bytes (bs) = cb-loop bs 0 (list-length bs) []

  cb-loop : List Integer, Integer, Integer, List Integer -> List Integer
  cb-loop (bs) (i) (n) (acc) =
    if i >= n then acc else cb-loop bs (i + 1) n (list-push acc (list-at bs i))

  set-at : List Integer, Integer, Integer -> List Integer
  set-at (bs) (i) (v) = list-set-at (copy-bytes bs) i v

  find-seq : List Integer, List Integer, Integer -> Integer
  find-seq (bs) (pat) (i) =
    if i + list-length pat > list-length bs then -1
    else if seq-eq bs i pat 0 then i
    else find-seq bs pat (i + 1)

  seq-eq : List Integer, Integer, List Integer, Integer -> Boolean
  seq-eq (bs) (off) (pat) (j) =
    if j >= list-length pat then True
    else if list-at bs (off + j) /= list-at pat j then False
    else seq-eq bs off pat (j + 1)

 The leaf's serial is a 20-byte INTEGER whose first content byte, 0x47, is record byte 15. Its notBefore is UTCTime "200101000000Z": tag 23, length 13, then the digits, so the month sits at +4 and +5.

  nb : Integer = find-seq leaf-cert [23, 13, 50, 48, 48, 49, 48, 49] 0

 The issuer Name starts at record byte 42; the subject is the SEQUENCE of 28 bytes; the extensions block is the [3] of 127 bytes. The certificate length is bytes 2-3 (373) and the TBS length bytes 6-7 (295), so an insertion of n bytes adds n to bytes 3 and 7.

  subj : Integer = find-seq leaf-cert [48, 28, 49, 26] 0
  dns1 : Integer = find-seq leaf-cert [130, 17, 100, 101, 118] 0 + 2
  ext3 : Integer = find-seq leaf-cert [163, 127, 48, 125] 0

  insert-at : List Integer, Integer, List Integer -> List Integer
  insert-at (bs) (at) (extra) = ins-loop bs at extra 0 []

  ins-loop : List Integer, Integer, List Integer, Integer, List Integer -> List Integer
  ins-loop (bs) (at) (extra) (i) (acc) =
    if i >= list-length bs then acc
    else if i == at then ins-loop bs at extra (i + 1) (list-push (cb-loop extra 0 (list-length extra) acc) (list-at bs i))
    else ins-loop bs at extra (i + 1) (list-push acc (list-at bs i))

 In each of the leaf's extensions the extnID tag is at +2 and the next tag at +7: basicConstraints' critical BOOLEAN, subjectAltName's extnValue OCTET STRING. The [3] runs 129 bytes to the signature algorithm, so with-ext3 rebuilds the certificate around a new [3] with DER lengths.

  bc-ext : Integer = find-seq leaf-cert [48, 12, 6, 3, 85, 29, 19] 0
  san-ext : Integer = find-seq leaf-cert [48, 45, 6, 3, 85, 29, 17] 0
  ski-ext : Integer = find-seq leaf-cert [48, 29, 6, 3, 85, 29, 14] 0

  slice : List Integer, Integer, Integer -> List Integer
  slice (bs) (from) (to) = sl-loop bs from to []

  sl-loop : List Integer, Integer, Integer, List Integer -> List Integer
  sl-loop (bs) (i) (to) (acc) =
    if i >= to then acc else sl-loop bs (i + 1) to (list-push acc (list-at bs i))

  der-len : Integer -> List Integer
  der-len (n) =
    if n < 128 then [n]
    else if n < 256 then [129, n]
    else [130, 1, n - 256]

  der-wrap : Integer, List Integer -> List Integer
  der-wrap (tag) (body) = [tag] & der-len (list-length body) & body

  with-ext3 : List Integer -> List Integer
  with-ext3 (ext) =
    der-wrap 48 (der-wrap 48 (slice leaf-cert 8 ext3 & ext) & slice leaf-cert (ext3 + 129) (list-length leaf-cert))

  with-tail : List Integer -> List Integer
  with-tail (extra) =
    let n = list-length extra
    in set-at (set-at (insert-at leaf-cert ext3 extra) 3 (117 + n)) 7 (39 + n)

  verdict : List Integer -> Text
  verdict (der) =
    when x509-parse der
      is None -> "unparsed"
      is Just (c) -> vtext (x509-chain-verify [c] anchors cal-now)

  vtext : X509Verdict -> Text
  vtext (v) =
    when v
      is ChainOk -> "ok"
      is ChainBadTime -> "bad-time"
      is ChainBadSignature -> "bad-signature"
      is otherwise -> "refused"

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("leaf " & verdict leaf-cert)
    print-line-uni ("notBefore tagged GeneralizedTime " & verdict (set-at leaf-cert nb 24))
    print-line-uni ("notBefore tagged OCTET STRING " & verdict (set-at leaf-cert nb 4))
    print-line-uni ("notBefore month 13 " & verdict (set-at (set-at leaf-cert (nb + 4) 49) (nb + 5) 51))
    print-line-uni ("notBefore month 00 " & verdict (set-at leaf-cert (nb + 5) 48))
    print-line-uni ("notBefore day 32 " & verdict (set-at (set-at leaf-cert (nb + 6) 51) (nb + 7) 50))
    print-line-uni ("notBefore hour 24 " & verdict (set-at (set-at leaf-cert (nb + 8) 50) (nb + 9) 52))
    print-line-uni ("notBefore second 60 " & verdict (set-at leaf-cert (nb + 12) 54))
    print-line-uni ("notBefore day 02 " & verdict (set-at leaf-cert (nb + 7) 50))
    print-line-uni ("serial negative " & verdict (set-at leaf-cert 15 200))
    print-line-uni ("serial positive changed " & verdict (set-at leaf-cert 15 72))
    print-line-uni ("issuer tagged SET " & verdict (set-at leaf-cert 42 49))
    print-line-uni ("subject tagged SET " & verdict (set-at leaf-cert subj 49))
    print-line-uni ("extensions tagged [4] " & verdict (set-at leaf-cert ext3 164))
    print-line-uni ("issuerUniqueID before extensions " & verdict (with-tail [129, 1, 0]))
    print-line-uni ("subjectUniqueID before issuerUniqueID " & verdict (with-tail [130, 1, 0, 129, 1, 0]))
    print-line-uni ("issuerUniqueID twice " & verdict (with-tail [129, 1, 0, 129, 1, 0]))
    print-line-uni ("SEQUENCE after spki " & verdict (with-tail [48, 0]))
    print-line-uni ("extensions rebuilt " & verdict (with-ext3 (slice leaf-cert ext3 (ext3 + 129))))
    print-line-uni ("extensions empty " & verdict (with-ext3 [163, 2, 48, 0]))
    print-line-uni ("extensions then a second element " & verdict (with-ext3 ([163, 129, 129] & slice leaf-cert (ext3 + 2) (ext3 + 129) & [48, 0])))
    print-line-uni ("extensions tagged OCTET STRING " & verdict (set-at leaf-cert (ext3 + 2) 4))
    print-line-uni ("extension tagged SET " & verdict (set-at leaf-cert ski-ext 49))
    print-line-uni ("extnID tagged OCTET STRING " & verdict (set-at leaf-cert (san-ext + 2) 4))
    print-line-uni ("extnValue tagged SEQUENCE " & verdict (set-at leaf-cert (san-ext + 7) 48))
    print-line-uni ("critical tagged INTEGER " & verdict (set-at leaf-cert (bc-ext + 7) 2))
    print-line-uni ("dNSName with a NUL " & verdict (set-at leaf-cert dns1 0))
    print-line-uni ("dNSName with a space " & verdict (set-at leaf-cert dns1 32))
    print-line-uni ("dNSName with byte 200 " & verdict (set-at leaf-cert dns1 200))
    print-line-uni ("dNSName with another letter " & verdict (set-at leaf-cert dns1 120))
  end
