Chapter: XhciEnumTest
  cites Kernel chapter Usb
  cites Kernel chapter Xhci
  cites Kernel chapter Pci
  cites Foreword chapter Maybe

Section: Body

  test-trb-enable-slot : Text =
    let trb = trb-enable-slot-cmd
    in let encoded = trb-encode trb
    in "enable-slot: len=" & show (list-length encoded) & " type=" & show (bit-and (bit-shru (trb.trb-control) 10) 63)

  test-trb-noop : Text =
    let trb = trb-noop
    in "noop: type=" & show (bit-and (bit-shru (trb.trb-control) 10) 63)

  test-trb-setup-stage : Text =
    let pkt = usb-setup-get-descriptor usb-desc-device 0 18
    in let trb = trb-setup-stage pkt
    in "setup: idt=" & show (bit-and (trb.trb-control) 64) & " type=" & show (bit-and (bit-shru (trb.trb-control) 10) 63)

  test-trb-data-stage : Text =
    let trb = trb-data-stage 4096 256 1
    in "data: addr=" & show (trb.trb-param-lo) & " len=" & show (trb.trb-status) & " ioc=" & show (bit-and (trb.trb-control) 32)

  test-trb-status-stage : Text =
    let trb = trb-status-stage 1
    in "status: dir=" & show (bit-and (bit-shru (trb.trb-control) 16) 1) & " type=" & show (bit-and (bit-shru (trb.trb-control) 10) 63)

  test-trb-normal : Text =
    let trb = trb-normal-data 8192 512
    in "normal: addr=" & show (trb.trb-param-lo) & " len=" & show (trb.trb-status) & " type=" & show (bit-and (bit-shru (trb.trb-control) 10) 63)

  test-trb-set-cycle : Text =
    let trb = trb-noop
    in let c1 = xhci-set-cycle trb 1
    in let c0 = xhci-set-cycle trb 0
    in "cycle1=" & show (bit-and (c1.trb-control) 1) & " cycle0=" & show (bit-and (c0.trb-control) 1)

  test-event-helpers : Text =
    let trb = Trb { trb-param-lo = 0, trb-param-hi = 0, trb-status = bit-shl 1 24, trb-control = bit-or (bit-shl trb-command-completion 10) (bit-shl 5 24) }
    in "evt-type=" & show (xhci-event-trb-type trb) & " slot=" & show (xhci-event-slot-id trb) & " cc=" & show (xhci-event-completion-code trb)

  test-speed-names : Text =
    xhci-speed-name 1 & "|" & xhci-speed-name 3 & "|" & xhci-speed-name 4

  test-slot-new : Text =
    let slot = xhci-slot-new 3 2
    in "slot: id=" & show (slot.xs-slot-id) & " port=" & show (slot.xs-port) & " configured=" & (if slot.xs-configured then "yes" else "no")

  test-controller-empty : Text =
    let xc = xhci-controller-empty
    in "empty: found=" & (if xc.xc-found then "yes" else "no") & " init=" & (if xc.xc-initialized then "yes" else "no")

  opening : [Console] Nothing = act
    print-line-uni test-trb-enable-slot
    print-line-uni test-trb-noop
    print-line-uni test-trb-setup-stage
    print-line-uni test-trb-data-stage
    print-line-uni test-trb-status-stage
    print-line-uni test-trb-normal
    print-line-uni test-trb-set-cycle
    print-line-uni test-event-helpers
    print-line-uni test-speed-names
    print-line-uni test-slot-new
    print-line-uni test-controller-empty
  end

