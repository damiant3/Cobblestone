Chapter: NegRealRepro

Section: Body

  Vec = record {
   vx : Real,
   vy : Real,
   vz : Real
  }

  vdot : Vec, Vec -> Real
  vdot (a) (b) = a.vx * b.vx + a.vy * b.vy + a.vz * b.vz

  neg-call : Vec, Vec -> Real
  neg-call (a) (b) = -(vdot a b)

  neg-field : Vec -> Real
  neg-field (v) = -v.vx

  opening : Real =
   let a = Vec { vx = 1.0, vy = 2.0, vz = 3.0 }
   in neg-call a a + neg-field a
