      is None -> []
      is Just (k) -> [X509Anchor { xa-subject = xc-root-name, xa-key = k }]

  xc-chain : List (List Integer) -> List X509Cert
  xc-chain (ders) = xc-chain-loop ders 0 []

  xc-chain-loop : List (List Integer), Integer, List X509Cert -> List X509Cert
  xc-chain-loop (ders) (i) (acc) =
    if i >= list-length ders then acc
    else when x509-parse (list-at ders i)
      is None -> acc
      is Just (c) -> xc-chain-loop ders (i + 1) (list-push acc c)

 A chain any of whose certificates fails to parse is shorter than its input and is reported as such.

  xc-accepted : List (List Integer) -> Text
  xc-accepted (ders) =
    let chain = xc-chain ders
    in if list-length chain /= list-length ders then "False (a certificate is refused at parse)"
    else when x509-chain-verify chain xc-anchors xc-2030
      is ChainOk -> "True"
      is otherwise -> "False"

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("anchor key parses = " & show (list-length xc-anchors == 1))
    print-line-uni ("A control: leaf under a plain intermediate accepted = " & xc-accepted [xc-l1, xc-i1])
    print-line-uni ("B: a CA under a pathLenConstraint 0 issuer accepted = " & xc-accepted [xc-l2, xc-i2, xc-i0])
    print-line-uni ("B: the pathLen 0 issuer's own direct leaf chain [i2, i0] accepted = " & xc-accepted [xc-i2, xc-i0])
    print-line-uni ("C: issuer without keyCertSign accepted = " & xc-accepted [xc-l3, xc-i3])
    print-line-uni ("D: evil.test under a critical nameConstraints for ok.test accepted = " & xc-accepted [xc-l4, xc-i4])
    print-line-uni ("E: leaf with an unknown critical extension accepted = " & xc-accepted [xc-l5, xc-i1])
  end

