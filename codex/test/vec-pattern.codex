Chapter: VecPattern
  cites Foreword chapter Console

Section: Entry
  classify : Vector 2 Integer -> Text
  classify (v) =
   when v
    is Vector [0, 0] -> "zero"
    is Vector [1, 1] -> "one"
    is otherwise -> "other"

  opening : [Console] Nothing
  opening = act
    let z = vec-splat 0
    in let o = vec-splat 1
    in let t = vec-splat 5
    in act
      print-line-uni (classify z)
      print-line-uni (classify o)
      print-line-uni (classify t)
    end
  end
