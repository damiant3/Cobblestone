Chapter: Match Large Variant

 Tests when-match on a variant with many constructors carrying fields.
 Exercises the compiler's emit-pattern path with 12 explicit ctor arms.

Section: Types
  BigExpr =
   | BeLit (Integer) (Integer)
   | BeAdd (Integer) (Integer)
   | BeSub (Integer) (Integer)
   | BeMul (Integer) (Integer)
   | BeDiv (Integer) (Integer)
   | BeNeg (Integer)
   | BeIf (Integer) (Integer) (Integer)
   | BeLet (Integer) (Integer)
   | BeApp (Integer) (Integer)
   | BeLam (Integer) (Integer)
   | BeList (Integer) (Integer)
   | BeMatch (Integer) (Integer)
   | BeAct (Integer)
   | BeRec (Integer) (Integer)
   | BeField (Integer) (Integer)

Section: Dispatch
  eval-tag : BigExpr -> Integer
  eval-tag (e) =
   when e
    is BeLit (a) (b) -> 1
    is BeAdd (a) (b) -> 2
    is BeSub (a) (b) -> 3
    is BeMul (a) (b) -> 4
    is BeDiv (a) (b) -> 5
    is BeNeg (a) -> 6
    is BeIf (a) (b) (c) -> 7
    is BeLet (a) (b) -> 8
    is BeApp (a) (b) -> 9
    is BeLam (a) (b) -> 10
    is BeList (a) (b) -> 11
    is BeMatch (a) (b) -> 12
    is otherwise -> 0

Section: Body
  opening : [Console] Nothing = act
   let r1 = eval-tag (BeLit 1 2)
   in let r2 = eval-tag (BeMul 3 4)
   in let r3 = eval-tag (BeMatch 5 6)
   in let r4 = eval-tag (BeAct 7)
   in print-line-uni (show (r1 + r2 + r3 + r4))
  end

