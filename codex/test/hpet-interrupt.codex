Chapter: HpetInterrupt
  cites Foreword chapter Board
  grounds Device.Mmio

 We say:

Section: Register Addresses

  hpet-config : Integer = #FED00010
  hpet-counter-lo : Integer = #FED000F0
  hpet-t0-config : Integer = #FED00100
  hpet-t0-cmp-lo : Integer = #FED00108

  ioapic-index : Integer = #FEC00000
  ioapic-data : Integer = #FEC00010

  devint-count-cell : Integer = 36240
  devint-last-vec-cell : Integer = 36248

Section: Routing

 Bit 2 of the timer configuration enables its interrupt and bits 9
 through 13 carry the line. Redirection entry 2 is the pair of selectors
 0x14 and 0x15; the low half takes the vector with delivery mode fixed
 and the mask clear.

  hpet-t0-route-2-enabled : Integer = #404
  ioapic-redir2-lo : Integer = #14
  ioapic-redir2-hi : Integer = #15
  probe-vector : Integer = 80

  route-timer : Integer -> [Device.Mmio] Integer
  route-timer (x) = act
    s0 <- mmio-write-32 ioapic-index ioapic-redir2-lo
    d0 <- mmio-write-32 ioapic-data probe-vector
    s1 <- mmio-write-32 ioapic-index ioapic-redir2-hi
    d1 <- mmio-write-32 ioapic-data 0
    e <- mmio-write-32 hpet-config 1
    c <- mmio-write-32 hpet-t0-config hpet-t0-route-2-enabled
    x
  end

Section: Spin

  spin : Integer -> [Device.Mmio] Integer
  spin (n) =
    if n <= 0 then 0
    else let v = mmio-read-32 hpet-counter-lo
    in v + spin (n - 1)

Section: Probe

  probe : Text
  probe = act
    r <- route-timer 0
    now <- mmio-read-32 hpet-counter-lo
    t <- mmio-write-32 hpet-t0-cmp-lo (now + 1000)
    before <- peek-qword devint-count-cell 0
    s <- spin 20000
    after <- peek-qword devint-count-cell 0
    vec <- peek-qword devint-last-vec-cell 0
    verdict before after vec
  end

  verdict : Integer, Integer, Integer -> Text
  verdict (before) (after) (vec) =
    if after <= before then "hpet interrupt: never delivered"
    else if vec /= probe-vector then "hpet interrupt: wrong vector " & show vec
    else "hpet interrupt: delivered on vector 80"

Section: Entry

  opening : [Console] Integer
  opening = act
    print-line-uni probe
    let r = 0 in r
  end
