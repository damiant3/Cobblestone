Chapter: UnitFamilyMixed
  cites Foreword chapter Console

Section: Types

  Length = unit family Millimeter
    Millimeter = 1
    Centimeter = 10
    Meter = 1000
    Kilometer = 1000000
    Inch = 25
    Foot = 305
    Yard = 914
    Mile = 1609344

Section: Functions

  area : Length, Length -> Length
  area (w) (h) = w * (h / w)

  perimeter : Length, Length -> Length
  perimeter (w) (h) = (w + h) * 2

  total-fence : Length, Length, Length, Length -> Length
  total-fence (a) (b) (c) (d) = a + b + c + d

Section: Body

  opening : [Console] Nothing = act
    let w = Millimeter 500
    in let h = Yard 1
    in let p = perimeter w h
    in let fence = total-fence (Meter 3) (Foot 10) (Inch 24) (Yard 2)
    in act
      print-line-uni ("perimeter mm+yard: " & show p & "mm")
      print-line-uni ("  in cm: " & show (Length-to-Centimeter p))
      print-line-uni ("  in inches: " & show (Length-to-Inch p))
      print-line-uni ("fence: " & show fence & "mm")
      print-line-uni ("  in meters: " & show (Length-to-Meter fence))
      print-line-uni ("  in feet: " & show (Length-to-Foot fence))
    end
  end

