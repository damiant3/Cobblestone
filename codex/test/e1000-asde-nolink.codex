Chapter: E1000AsdeNoLink
  cites Foreword chapter Maybe
  cites Kernel chapter E1000e
  cites Kernel chapter Pci
  cites Dev chapter NicAsde

Section: Judges

  yn : Boolean -> Text
  yn (b) = if b then "yes" else "no"

  arms-give-nolink : PciDevice -> Boolean
  arms-give-nolink (dev) =
   let mmio = na-mmio-of dev
   in let on = na-bring-up mmio (dev.pci-device-id) True
   in let off = na-bring-up mmio (dev.pci-device-id) False
   in if (on.na-gave) /= na-gave-nolink then False
   else (off.na-gave) == na-gave-nolink

  phy-still-reached : PciDevice -> Boolean
  phy-still-reached (dev) =
   let mmio = na-mmio-of dev
   in (na-bring-up mmio (dev.pci-device-id) True).na-phy == 1

  row-still-paints : PciDevice -> Boolean
  row-still-paints (dev) =
   let mmio = na-mmio-of dev
   in text-length (na-line "ASDE=1" (na-bring-up mmio (dev.pci-device-id) True)) > 20

Section: Entry

  opening : [Console] Nothing = act
    let scan = pci-scan-bus 0
    in act
      when e1000-find scan
        is Just (dev) -> act
          print-line-uni ("arms say nolink : " & yn (arms-give-nolink dev))
          print-line-uni ("phy reached     : " & yn (phy-still-reached dev))
          print-line-uni ("row paints      : " & yn (row-still-paints dev))
        end
        is None -> print-line-uni ("candidate found : no")
    end
  end

