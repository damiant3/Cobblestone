Chapter: WorkflowParseIntTest
  cites Wflow chapter ProcessEngine (parse-int)

Section: Entry
  opening : [Console] Nothing
  opening = act
   print-line-uni ("parse 42 = " & show (parse-int "42"))
   print-line-uni ("parse 0 = " & show (parse-int "0"))
   print-line-uni ("parse 1009 = " & show (parse-int "1009"))
   print-line-uni ("parse empty = " & show (parse-int ""))
   print-line-uni ("parse 7x = " & show (parse-int "7x"))
  end
