Chapter: Builtin Named Local Value

Section: Entry

  Box = | Pair (Integer) (Integer)

  val-param : Integer -> Integer
  val-param (now) = now + 1

  val-let : Integer -> Integer
  val-let (x) = let max = x * 2 in max + 1

  val-pat : Box -> Integer
  val-pat (b) = when b is Pair (min) (max) -> max - min

  opening : [Console] Nothing
  opening = act
    print-line-uni ("val-param " & show (val-param 41))
    print-line-uni ("val-let " & show (val-let 20))
    print-line-uni ("val-pat " & show (val-pat (Pair 3 10)))
  end