Chapter: LazyBasic
  cites Foreword chapter Console

 Mutable record field assignment test - the foundation for lazy thunks.

Section: Cell

  mutable Cell = record {
   value : Integer
  }

Section: Opening

  opening : [Console] Nothing
  opening = act
   let c = Cell { value = 10 }
   in act
    print-line-uni ("before: " & show (c.value))
    c.value = 42
    print-line-uni ("after: " & show (c.value))
   end
  end
