Chapter: UnitsForeword
  cites Foreword chapter Console
  cites Foreword chapter Units

 Tests unit families: duration, length, mass, astro distances,
 data sizes, temperature, energy, speed, angle.

Section: Body
  opening : [Console] Nothing = act
    let t1 = Second 2
    in let t2 = Millisecond 500
    in let dur = t1 + t2
    in let km = Kilometer 42
    in let mi = Mile 26
    in let total-len = km + mi
    in let astro = AU 1
    in let ly = LightYear 4
    in let star-dist = astro + ly
    in let data = Gigabyte 2
    in let boiling = Celsius 100
    in let bk = Celsius-to-Kelvin boiling
    in let bf = Celsius-to-Fahrenheit boiling
    in let fc = Fahrenheit-to-Celsius (Fahrenheit 32)
    in let angle = Degree 90
    in let speed = KmPerHour 100
    in let energy = Kilocalorie 2000
    in let force = Newton 9
    in let power = Horsepower 1
    in act
      print-line-uni ("dur: " & show (Duration-to-Millisecond dur) & "ms")
      print-line-uni ("len: " & show (Length-to-Kilometer total-len) & "km")
      print-line-uni ("astro: " & show (AstroDistance-to-AstroKm star-dist) & "km")
      print-line-uni ("data: " & show (DataSize-to-Megabyte data) & "MB")
      print-line-uni ("temp-k: " & show bk)
      print-line-uni ("temp-f: " & show bf)
      print-line-uni ("temp-c: " & show fc)
      print-line-uni ("angle-arcmin: " & show (Angle-to-Arcminute angle))
      print-line-uni ("speed-m/s: " & show (Speed-to-MeterPerSec speed))
      print-line-uni ("energy-j: " & show (Energy-to-Joule energy))
      print-line-uni ("force-mn: " & show (Force-to-Millinewton force))
      print-line-uni ("power-w: " & show (Power-to-Watt power))
    end
  end

