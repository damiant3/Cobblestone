Chapter: MethodTemplateContractDemands

class DemandContract where
  demand-left : a, b -> b
  demand-right : a, b -> Integer

instance DemandContract Integer where
  demand-left (x) (y) = y
  demand-right (x) (y) = x + 1

Section: Body

  opening : [Console] Nothing = act
    print-line-uni (show (demand-left 1 True))
    print-line-uni (show (demand-left 2 False))
    print-line-uni (demand-left 3 "left")
    print-line-uni (show (demand-right 4 True))
    print-line-uni (show (demand-right 5 "right"))
    print-line-uni (show (demand-right 6 99))
  end
