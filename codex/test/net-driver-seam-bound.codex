Chapter: NetDriverSeamBound
  cites Net chapter NetDriver

 The two addresses in play differ in three of six bytes, which is what
 makes this test able to fail. The emulated card serves RAL/RAH as
 52:54:00:ab:cd:ef; the NE2000 constant the seam falls back to is
 52:54:00:12:34:56, the address codex-vm's NAT expects. A seam that
 ignored the bound card would answer the second and read as healthy,
 because the NAT accepts any source address the guest puts in a frame.

Section: Judges

  t-ne2k-mac : List Integer = [82, 84, 0, 18, 52, 86]

  yn : Boolean -> Text
  yn (b) = if b then "yes" else "no"

  bytes-of : List Integer, Integer, Integer, Text -> Text
  bytes-of (l) (i) (n) (acc) =
    if i >= n then acc
    else bytes-of l (i + 1) n (acc & " " & show (list-at l i))

  mac-same : List Integer, List Integer, Integer -> Boolean
  mac-same (a) (b) (i) =
    if i >= 6 then True
    else if list-at a i /= list-at b i then False
    else mac-same a b (i + 1)

Section: Entry

  opening : [Console, Network.Read] Nothing = act
    card <- net-driver-bring-up
    let mac = net-driver-mac
    in let len = list-length mac
    in act
      print-line-uni ("bound card  : " & net-driver-card-name card)
      print-line-uni ("mac length  : " & show len)
      print-line-uni ("seam mac    :" & bytes-of mac 0 len "")
      print-line-uni ("is ne2k mac : " & yn (len == 6 & mac-same mac t-ne2k-mac 0))
    end
  end

