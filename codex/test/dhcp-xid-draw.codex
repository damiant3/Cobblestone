Chapter: DhcpXidDraw
  cites Net chapter DhcpIO
  cites Foreword chapter Console

  in-range : Integer -> Boolean
  in-range (x) = x >= 0 & x <= #FFFFFFFF

  xid-or : Maybe Integer -> Integer
  xid-or (m) = when m is None -> (0 - 1) is Just (x) -> x

  refused : Maybe Integer -> Text
  refused (m) = when m is None -> "refused" is Just (x) -> "drawn"

  opening : [Console] Nothing =
    let a = dhcp-io-draw-xid 12345
    in let b = dhcp-io-draw-xid 12346
    in let live-a = xid-or (dhcp-io-fresh-xid 0)
    in let live-b = xid-or (dhcp-io-fresh-xid 0)
    in act
      print-line-uni ("draw 12345     : " & show a & " in range " & show (in-range a))
      print-line-uni ("draw 12346     : " & show b & " in range " & show (in-range b))
      print-line-uni ("two live draws : differ " & show (live-a /= live-b) & ", in range " & show (in-range live-a & in-range live-b))
      print-line-uni ("no hardware word: word 0 " & refused (dhcp-io-fresh-xid-from 0 0) & ", word -1 " & refused (dhcp-io-fresh-xid-from (0 - 1) 0) & ", word 12345 " & refused (dhcp-io-fresh-xid-from 12345 0))
      print-line-uni "done"
    end

