Chapter: ScopeAllow

  cites Foreword chapter Fat16

Section: Body
  opening : [Console, FileSystem.Read "/config/", Device.Block] Nothing = act
    print-line-uni (if file-exists "/config/app.toml" then "top in scope" else "top absent")
    print-line-uni (if file-exists "/config/sub/deep.toml" then "deep in scope" else "deep absent")
  end
