Chapter: WasmFnIdCollide

Section: Entry

  wasm-exports : Text = "|text-eq|twice|"

  text-eq : Integer -> Integer
  text-eq (n) = n + 1

  twice : (Integer -> Integer), Integer -> Integer
  twice (f) (x) = f (f x)

  opening : [Console] Nothing
  opening = act
    print-line-uni (show (twice text-eq 40))
    print-line-uni (show (text-eq 1))
  end