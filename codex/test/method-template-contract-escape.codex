Chapter: MethodTemplateContractEscape

class EscapeContract where
  escape-value : a, b -> b

instance EscapeContract Integer where
  escape-value (x) (y) = y

Section: Functions

  capture-value : EscapeContractDict Integer -> (Boolean -> Boolean)
  capture-value (d) = \y -> (d.escape-value-impl) 7 y

  opening : [Console] Nothing = act
    let escaped = capture-value EscapeContract-dict-Integer
    in print-line-uni (show (escaped True))
  end
