Section: Helpers

  yn : Boolean -> Text
  yn (b) = if b then "True" else "False"

  bytes-eq : List Integer, List Integer -> Boolean
  bytes-eq (a) (b) =
    if list-length a /= list-length b then False
    else be-loop a b 0 (list-length a)

  be-loop : List Integer, List Integer, Integer, Integer -> Boolean
  be-loop (a) (b) (i) (n) =
    if i >= n then True
    else if list-at a i /= list-at b i then False
    else be-loop a b (i + 1) n

Section: Reports

 FIPS 180-4: SHA-512 of "abc" begins ddaf35a1, and of the empty
 message begins cf83e135. Only the first eight bytes are compared,
 which is enough to tell a working compressor from a broken one.

  r-sha-abc : Text =
    "sha512-abc=" & bytes-to-hex (ed-list-take (sha512-words-to-byte-list (sha512 v-abc)) 8)

  r-sha-empty : Text =
    "sha512-empty=" & bytes-to-hex (ed-list-take (sha512-words-to-byte-list (sha512 v-empty)) 8)

 RFC 8032 TEST 1: the seed above derives exactly the public key above.
 This is base-point scalar multiplication and point encoding, and it
 does not touch verification at all.

  r-pub : Text =
    "ed-pubkey=" & yn (bytes-eq (ed25519-public-key v-seed) v-pub)

  r-pub-hex : Text =
    "ed-pubkey-first8=" & bytes-to-hex (ed-list-take (ed25519-public-key v-seed) 8)

  r-sign : Text =
    "sig-matches-published=" & yn (bytes-eq (ed25519-sign v-seed v-pub v-empty) v-sig)

  r-verify : Text =
    "ed-verify-empty=" & yn (ed25519-verify v-pub v-empty v-sig)

  r2-verify : Text =
    "ed2-verify=" & yn (ed25519-verify v2-pub v2-msg v2-sig)

  r2-verify-bad : Text =
    "ed2-verify-tampered=" & yn (ed25519-verify v2-pub v2-msg (ed-list-set-at v2-sig 0 145))

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni r-sha-abc
    print-line-uni r-sha-empty
    print-line-uni r-pub
    print-line-uni r-pub-hex
    print-line-uni r-sign
    print-line-uni r-verify
    print-line-uni r2-verify
    print-line-uni r2-verify-bad
  end
