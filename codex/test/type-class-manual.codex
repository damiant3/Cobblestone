Chapter: TypeClassManual
  cites Foreword chapter Console

 Manual desugaring of type classes to dictionary-passing records.
 This is the target form that the compiler will generate automatically.

Section: Dictionary Types

  ShowDict = record {
   show-impl : Integer -> Text
  }

  EqDict = record {
   eq-impl : Integer, Integer -> Boolean
  }

Section: Instances

  show-dict-integer : ShowDict
  show-dict-integer = ShowDict { show-impl = \x -> show x }

  eq-dict-integer : EqDict
  eq-dict-integer = EqDict { eq-impl = \x y -> x == y }

Section: Dispatch

  show-via : ShowDict, Integer -> Text
  show-via (dict) (x) = (dict.show-impl) x

  eq-via : EqDict, Integer, Integer -> Boolean
  eq-via (dict) (x) (y) = (dict.eq-impl) x y

Section: Opening

  opening : [Console] Nothing
  opening = act
   print-line-uni ("show 42: " & show-via show-dict-integer 42)
   print-line-uni ("eq 3 3: " & show (eq-via eq-dict-integer 3 3))
   print-line-uni ("eq 3 4: " & show (eq-via eq-dict-integer 3 4))
  end
