Chapter: RealApprox
  cites Foreword chapter Console

Section: Entry
  add-f32 : Real approximate, Real approximate -> Real approximate
  add-f32 (a) (b) = a + b

  mul-f32 : Real approximate, Real approximate -> Real approximate
  mul-f32 (a) (b) = a * b

  opening : [Console] Nothing
  opening = act
    let a = to-real-approx 3.0
    in let b = to-real-approx 4.0
    in let sum = add-f32 a b
    in let prod = mul-f32 a b
    in act
      print-line-uni ("sum: " & show (from-real-approx sum))
      print-line-uni ("prod: " & show (from-real-approx prod))
      print-line-uni ("show-f32: " & show sum)
    end
  end
