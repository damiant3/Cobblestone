Chapter: AwaitAnyStale
  cites Foreword chapter Console

Section: Body

  stale : Integer -> Integer
  stale (n) =
    let t = fork (\x -> n)
    in let a = await t
    in let u = fork (\x -> n + 4)
    in a + await-any [t] + (await u) * 0

  opening : [Console] Nothing = act
    print-line-uni "before"
    print-line-uni ("after " & show (stale 5))
  end