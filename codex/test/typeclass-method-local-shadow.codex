Chapter: TypeclassMethodLocalShadow
  cites Foreword chapter Console

class Converter where
  convert : a, b -> b

instance Converter Integer where
  convert (x) (y) = y

Section: Body

  opening : [Console] Nothing = act
    let d = Converter-dict-Integer
    in act
      print-line-uni (show ((d.convert-impl) 0 42))
      print-line-uni ((\d -> (d.convert-impl) 0 "lambda") d)
    end
  end