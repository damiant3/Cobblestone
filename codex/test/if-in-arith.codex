Chapter: IfInArith

  cites Foreword chapter Console

Section: Definitions

  perm : Boolean, Boolean -> Integer
  perm (w) (r) = 64 + (if w then 8 else 0) + (if r then 4 else 0)

  opening : [Console] Nothing = act
    print-line-uni (show (perm True False))
    print-line-uni (show (perm False True))
    print-line-uni (show (perm True True))
  end

