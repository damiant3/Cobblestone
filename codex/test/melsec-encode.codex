Chapter: MelsecEncodeTest

  cites Encode chapter Melsec

 Exercise the MELSEC MC 3E binary builders: a device specification, a
 batch word read for data registers and internal relays, and a batch
 word write carrying two words. Every byte sequence is checked against
 an independent reference computed by melsec_truth.py. opening returns
 the count of passing checks.

Section: Helpers

  bytes-eq : List Integer, List Integer -> Boolean
  bytes-eq (a) (b) =
   if list-length a /= list-length b then False
   else bytes-eq-loop a b 0 (list-length a)

  bytes-eq-loop : List Integer, List Integer, Integer, Integer -> Boolean
  bytes-eq-loop (a) (b) (i) (len) =
   if i >= len then True
   else if list-at a i /= list-at b i then False
   else bytes-eq-loop a b (i + 1) len

  flag : Boolean -> Integer
  flag (b) = if b then 1 else 0

Section: Checks

  check-device : Integer
  check-device =
   flag (bytes-eq (melsec-device melsec-dev-d 100 5) [100, 0, 0, 168, 5, 0])

  check-read-d : Integer
  check-read-d =
   flag (bytes-eq (melsec-batch-read-words melsec-dev-d 100 5)
     [80, 0, 0, 255, 255, 3, 0, 12, 0, 16, 0, 1, 4, 0, 0, 100, 0, 0, 168, 5, 0])

  check-read-m : Integer
  check-read-m =
   flag (bytes-eq (melsec-batch-read-words melsec-dev-m 0 16)
     [80, 0, 0, 255, 255, 3, 0, 12, 0, 16, 0, 1, 4, 0, 0, 0, 0, 0, 144, 16, 0])

  check-write-d : Integer
  check-write-d =
   let expect = [80, 0, 0, 255, 255, 3, 0, 16, 0, 16, 0, 1, 20, 0, 0, 200, 0, 0, 168, 2, 0, 52, 18, 5, 0]
   in flag (bytes-eq (melsec-batch-write-words melsec-dev-d 200 [#1234, #0005]) expect)

  opening : Integer =
   let a = check-device
   in let b = check-read-d
   in let c = check-read-m
   in let d = check-write-d
   in a + b + c + d
