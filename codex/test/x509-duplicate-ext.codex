 basicConstraints with cA TRUE, keyUsage with digitalSignature and keyEncipherment, and a critical extension under
 OID 1.2.3.4, which no verifier processes.

  ext-ca-true : List Integer = [48, 15, 6, 3, 85, 29, 19, 1, 1, 255, 4, 5, 48, 3, 1, 1, 255]
  ext-key-usage : List Integer = [48, 11, 6, 3, 85, 29, 15, 4, 4, 3, 2, 5, 160]
  ext-critical-unknown : List Integer = [48, 10, 6, 3, 42, 3, 4, 1, 1, 255, 4, 0]

Section: The Pieces

  outer-kids : List Asn1Tlv =
    when asn1-read-tag leaf-cert 0 asn1-sequence is None -> [] is Just (t) -> asn1-children leaf-cert t

  tbs-kids : List Asn1Tlv = asn1-children leaf-cert (list-at outer-kids 0)

  pre : List Integer = raw-range tbs-kids 0 7 []

  tail-raw : List Integer = asn1-raw leaf-cert (list-at outer-kids 1) & asn1-raw leaf-cert (list-at outer-kids 2)

  exts : List (List Integer) =
    when asn1-nth (asn1-children leaf-cert (list-at tbs-kids 7)) 0
      is None -> []
      is Just (s) -> raw-each (asn1-children leaf-cert s) 0 []

  ext-bc : List Integer = list-at exts 0
  ext-san : List Integer = list-at exts 1

Section: Helpers

  raw-range : List Asn1Tlv, Integer, Integer, List Integer -> List Integer
  raw-range (ts) (i) (n) (acc) =
    if i >= n then acc else raw-range ts (i + 1) n (acc & asn1-raw leaf-cert (list-at ts i))

  raw-each : List Asn1Tlv, Integer, List (List Integer) -> List (List Integer)
  raw-each (ts) (i) (acc) =
    if i >= list-length ts then acc else raw-each ts (i + 1) (acc & [asn1-raw leaf-cert (list-at ts i)])

  cat-all : List (List Integer), Integer, List Integer -> List Integer
  cat-all (xs) (i) (acc) =
    if i >= list-length xs then acc else cat-all xs (i + 1) (acc & list-at xs i)

  ext-block : List (List Integer) -> List Integer
  ext-block (es) = der-ctx3 (der-sequence (cat-all es 0 []))

  cert-of : List Integer -> List Integer
  cert-of (blocks) = der-sequence (der-sequence (pre & blocks) & tail-raw)

  with-exts : List (List Integer) -> List Integer
  with-exts (es) = cert-of (ext-block es)

  bytes-eq : List Integer, List Integer -> Boolean
  bytes-eq (a) (b) = if list-length a /= list-length b then False else bytes-eq-loop a b 0

  bytes-eq-loop : List Integer, List Integer, Integer -> Boolean
  bytes-eq-loop (a) (b) (i) =
    if i >= list-length a then True
    else if list-at a i /= list-at b i then False
    else bytes-eq-loop a b (i + 1)

  verdict : List Integer -> Text
  verdict (der) =
    when x509-parse der
      is None -> "refused"
      is Just (c) -> "parsed ca=" & show (c.xc-is-ca) & " dns=" & show (list-length (c.xc-dns-names))

Section: Results

  test-original : Text = "original " & verdict leaf-cert
  test-rebuilt : Text = "rebuilt " & verdict (with-exts exts) & " same-bytes=" & show (bytes-eq (with-exts exts) leaf-cert)
  test-one-ku : Text = "one key-usage " & verdict (with-exts (exts & [ext-key-usage]))
  test-crit-first : Text = "critical-unknown in first block " & verdict (with-exts (exts & [ext-critical-unknown]))
  test-two-bc : Text = "two basic-constraints " & verdict (with-exts ([ext-ca-true] & exts))
  test-two-san : Text = "two subject-alt-names " & verdict (with-exts (exts & [ext-san]))
  test-two-ku : Text = "two key-usages " & verdict (with-exts (exts & [ext-key-usage, ext-key-usage]))
  test-two-blocks : Text = "critical-unknown in second block " & verdict (cert-of (ext-block exts & ext-block [ext-critical-unknown]))

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni test-original
    print-line-uni test-rebuilt
    print-line-uni test-one-ku
    print-line-uni test-crit-first
    print-line-uni test-two-bc
    print-line-uni test-two-san
    print-line-uni test-two-ku
    print-line-uni test-two-blocks
  end
