Chapter: NvGspMsgTest
  cites Kernel chapter NvGspMsg
  cites Foreword chapter Format

 The expected output is tinygrad's own _send_rpc_record and _checksum over
 its r570 structures, run by Python: build/nv-gsp-msg-oracle.ps1.

Section: Main

  payload : Integer, Integer, Integer, Integer, List Integer -> List Integer
  payload (n) (mul) (add) (i) (acc) = if i >= n then acc else payload n mul add (i + 1) (acc & [int-mod (i * mul + add) 256])

  hex-bytes : List Integer, Integer, Text -> Text
  hex-bytes (bs) (i) (acc) = if i >= list-length bs then acc else hex-bytes bs (i + 1) (acc & fmt-hex-pad (list-at bs i) 2)

  record-line : Integer, Integer, List Integer, Integer, Integer -> Text
  record-line (k) (func) (pl) (seq) (slot) =
    let r = nv-gsp-record func pl seq slot
    in "R " & show k & " " & show (list-length r) & " " & hex-bytes r 0 ""

  opening : [Console] Nothing = act
   print-line-uni (record-line 0 #10 [] 0 128)
   print-line-uni (record-line 1 #49 [1, 2, 3, 4, 5] 7 128)
   print-line-uni (record-line 2 #2C (payload 100 37 0 0 []) 123456 64)
   print-line-uni (record-line 3 1 (payload 300 13 7 0 []) 2 128)
   print-line-uni (record-line 4 #41 (payload 16 0 255 0 []) 1 4096)
   print-line-uni (record-line 5 7 (payload 48 5 3 0 []) 9 128)
  end
