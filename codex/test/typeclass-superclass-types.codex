Chapter: TypeclassSuperclassTypes
  cites Foreword chapter Console

class SameValue where
  same-value : a, a -> Boolean

instance SameValue Integer where
  same-value (x) (y) = x == y

instance SameValue Boolean where
  same-value (x) (y) = x == y

class SameValue a => RankedValue where
  rank-value : a -> Integer

instance RankedValue Integer where
  rank-value (x) = x

instance RankedValue Boolean where
  rank-value (x) = if x then 1 else 0

Section: Functions

  integer-super : Integer, Integer -> Boolean
  integer-super (x) (y) =
   let d = RankedValue-dict-Integer
   in let s = d.__super-SameValue
   in (s.same-value-impl) x y

  boolean-super : Boolean, Boolean -> Boolean
  boolean-super (x) (y) =
   let d = RankedValue-dict-Boolean
   in let s = d.__super-SameValue
   in (s.same-value-impl) x y

  opening : [Console] Nothing = act
    print-line-uni (show (integer-super 7 7))
    print-line-uni (show (integer-super 7 8))
    print-line-uni (show (boolean-super True True))
    print-line-uni (show (boolean-super True False))
  end
