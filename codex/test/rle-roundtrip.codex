Chapter: RleRoundtrip
  cites Compress chapter Rle

Section: Checks

  list-text : List Integer, Integer, Integer -> Text
  list-text (xs) (i) (n) =
    if i >= n then ""
    else (if i == 0 then "" else ",") & show (list-at xs i) & list-text xs (i + 1) n

  shown : List Integer -> Text
  shown (xs) = "[" & list-text xs 0 (list-length xs) & "]"

  fours : Integer, List Integer -> List Integer
  fours (n) (acc) = if n <= 0 then acc else fours (n - 1) (acc & [4])

  sum-from : List Integer, Integer, Integer -> Integer
  sum-from (xs) (i) (acc) = if i >= list-length xs then acc else sum-from xs (i + 1) (acc + list-at xs i)

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (shown (rle-encode [5, 5, 5, 7, 9, 9]))
    print-line-uni (shown (rle-decode (rle-encode [5, 5, 5, 7, 9, 9])))
    print-line-uni (shown (rle-encode (fours 300 [])))
    print-line-uni (show (list-length (rle-decode (rle-encode (fours 300 [])))))
    print-line-uni (show (sum-from (rle-decode (rle-encode (fours 300 []))) 0 0))
    print-line-uni (rle-compression-ratio (fours 300 []) (rle-encode (fours 300 [])))
    print-line-uni (shown (rle-encode []))
    print-line-uni (show (list-length (rle-decode-capped [1000000000, 7] 100)))
  end
