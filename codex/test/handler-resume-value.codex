Chapter: HandlerResumeValue
  cites Foreword chapter Console

Section: Effects

  effect Reader where
    ask : [Reader] Integer

Section: Body

  opening : [Console] Nothing =
    let never = with Reader (ask + 1)
      ask (resume) = 7
    in let inner = with Reader (ask * 10)
      ask (resume) = resume 5 + 1
    in act
      print-line-uni ("never resumes: " & show never)
      print-line-uni ("resume inside: " & show inner)
    end
