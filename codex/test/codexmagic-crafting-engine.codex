 We say:

Section: Probe

  combat-at : Integer -> RPGCombatState
  combat-at (slot) = RPGCombatState { combatants = [], initiative-order = [0, 1], current-turn = slot, round = 3, active = True }

  opening : [Console] Nothing
  opening =
    let g = advance-turn (game-new [] general-warlord general-warlord)
    in let last = rpg-advance-turn (combat-at 1)
    in let first = rpg-advance-turn (combat-at 0)
    in act
      print-line-uni ("card game: turn " & show g.turn-number & ", active player " & show g.active-player)
      print-line-uni ("combat from the last slot: slot " & show last.current-turn & ", round " & show last.round)
      print-line-uni ("combat from slot 0: slot " & show first.current-turn & ", round " & show first.round)
    end

