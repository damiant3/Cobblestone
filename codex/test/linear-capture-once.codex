Chapter: LinearCaptureOnce
  cites Foreword chapter Linear

Section: Definitions

  use-closure : linear Integer -> Integer
  use-closure (n) = let f = (\x -> n + x)
   in f 1

  take2 : linear Integer, Integer -> Integer
  take2 (n) (x) = freeze n + x

  use-partial : linear Integer -> Integer
  use-partial (n) = let g = take2 n
   in g 5

  opening : Text = show (use-closure 41) & " " & show (use-partial 37)

