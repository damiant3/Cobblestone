Chapter: FwdComplianceBuildTest
  cites Foreword chapter ComplianceBuild

Section: Fixtures

  cbt-newlines : Text, Integer, Integer -> Integer
  cbt-newlines (s) (i) (acc) =
    if i >= text-length s then acc
    else cbt-newlines s (i + 1) (acc + (if char-code (char-at s i) == char-code (char-at "\n" 0) then 1 else 0))

  cbt-sums : RegulationCoverage -> Text
  cbt-sums (c) =
    let parts = c.by-construction + c.mechanism + c.deployment + c.organizational
    in c.regulation & " classes sum to total: " & (if parts == c.total then "yes" else "no") & (if c.total > 0 then ", nonempty" else ", empty")

  cbt-ev : Boolean, Boolean -> BuildEvidence
  cbt-ev (effects) (caps) = build-evidence [0, 171, 15] [255, 1] 3 4 effects caps

Section: Entry

  opening : [Console] Nothing =
    let ev = cbt-ev False False
    in let covs = ev.regulation-coverage
    in act
      print-line-uni ("hash " & format-hash [0, 171, 15] & ", " & format-hash [255, 1] & ", empty [" & format-hash [] & "]")
      print-line-uni ("coverage rows: " & show (list-length covs))
      print-line-uni (cbt-sums (list-at covs 0))
      print-line-uni (cbt-sums (list-at covs 1))
      print-line-uni (cbt-sums (list-at covs 2))
      print-line-uni (cbt-sums (list-at covs 3))
      print-line-uni ("report newlines: effects off caps off " & show (cbt-newlines (format-build-evidence ev) 0 0) & ", effects off caps on " & show (cbt-newlines (format-build-evidence (cbt-ev False True)) 0 0) & ", effects on " & show (cbt-newlines (format-build-evidence (cbt-ev True True)) 0 0))
    end
