Chapter: FwdTerrainTest
  cites Engine chapter Terrain

Section: Fixtures

  trt-cfg : TerrainConfig
  trt-cfg = TerrainConfig { tc-grid-size = 3, tc-spacing = 100, tc-height-scale = 10, tc-lod-distances = [5000] }

Section: Entry

  opening : [Console] Nothing =
    let tp = terrain-from-heightmap [1, 2, 3, 4, 5, 6, 7, 8, 9] 3 trt-cfg
    in let flat = terrain-from-heightmap [5, 5, 5, 5, 5, 5, 5, 5, 5] 3 trt-cfg
    in let ramp = terrain-from-heightmap [0, 0, 0, 10, 10, 10, 20, 20, 20] 3 trt-cfg
    in act
      print-line-uni ("height at 0,0 -150,-150 1000,1000 -1000,0: " & show (terrain-height-at tp 0 0) & " " & show (terrain-height-at tp (0 - 150) (0 - 150)) & " " & show (terrain-height-at tp 1000 1000) & " " & show (terrain-height-at tp (0 - 1000) 0))
      print-line-uni ("slope flat " & show (terrain-slope flat 1 1) & ", ramp " & show (terrain-slope ramp 1 1) & ", ramp edge " & show (terrain-slope ramp 0 0))
      print-line-uni (format-terrain tp & ", clamp -3 5 9 in 0..4: " & show (terr-clamp (0 - 3) 0 4) & " " & show (terr-clamp 5 0 4) & " " & show (terr-clamp 9 0 10))
    end
