Chapter: FwdKNearestNeighborTest
  cites AI chapter KNearestNeighbor

Section: Fixtures

  knt-pt : Integer, Integer, Integer, Integer -> KnnPoint
  knt-pt (id) (x) (y) (label) = KnnPoint { knn-id = id, knn-features = [x, y], knn-label = label }

  knt-data : List KnnPoint
  knt-data = [knt-pt 0 0 0 1, knt-pt 1 1 0 1, knt-pt 2 10 10 2, knt-pt 3 11 10 2, knt-pt 4 10 11 2, knt-pt 5 0 1 1]

  knt-dists : List Integer, Integer, Text -> Text
  knt-dists (xs) (i) (acc) =
    if i >= list-length xs then acc
    else knt-dists xs (i + 1) (acc & (if i == 0 then "" else " ") & show (list-at xs i))

  knt-id-sum : List KnnPoint, Integer, Integer -> Integer
  knt-id-sum (ps) (i) (acc) =
    if i >= list-length ps then acc
    else knt-id-sum ps (i + 1) (acc + (list-at ps i).knn-id)

  knt-line : Text, KnnResult -> Text
  knt-line (tag) (r) =
    tag & ": " & format-knn-result r & " dists " & knt-dists (r.knn-distances) 0 "" & " id-sum " & show (knt-id-sum (r.knn-neighbors) 0 0)

Section: Entry

  opening : [Console] Nothing =
    let near-origin = knn-search knt-data [1, 1] 3
    in let near-far = knn-search knt-data [10, 10] 3
    in let all = knn-search knt-data [5, 5] 10
    in let none = knn-search knt-data [5, 5] 0
    in let wide = knn-search [knt-pt 0 0 0 300] [0, 0] 1
    in act
      print-line-uni ("euclidean-sq " & show (knn-euclidean-sq [1, 2, 3] [4, 0, 3]) & ", manhattan " & show (knn-manhattan [1, 2, 3] [4, 0, 3]))
      print-line-uni (knt-line "query 1,1 k3" near-origin)
      print-line-uni (knt-line "query 10,10 k3" near-far)
      print-line-uni ("k10 over 6 points: count " & show (all.knn-count) & ", tie class " & show (knn-classify all))
      print-line-uni ("k0: count " & show (none.knn-count) & ", class " & show (knn-classify none))
      print-line-uni ("label 300 alone classifies as " & show (knn-classify wide))
    end
