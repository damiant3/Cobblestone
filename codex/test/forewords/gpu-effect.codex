Chapter: FwdGpuEffectTest
  cites Gpu chapter GpuEffect

Section: Body

  stage : Integer -> [Gpu] Integer
  stage (n) = act
    gpu-init
    buf <- gpu-alloc (n * 4)
    gpu-copy-to buf [n, n + 1, n + 2]
    out <- gpu-copy-from buf 3
    gpu-sync
    list-at out 0 + list-at out 1 + list-at out 2 + buf
  end

  on-host : Integer -> [Console] Integer
  on-host (n) = act
    with Gpu (stage n)
      gpu-init (resume) = act
        print-line-uni "init"
        resume 1
      end
      gpu-load-ptx (t) (resume) = resume 0
      gpu-alloc (bytes) (resume) = resume (bytes + 1000)
      gpu-free (b) (resume) = print-line-uni "free"
      gpu-copy-to (b) (xs) (resume) = print-line-uni ("copy-to " & show b & " " & show (list-length xs))
      gpu-copy-from (b) (k) (resume) = resume [b, k, 7]
      gpu-launch (name) (g) (bl) (args) (resume) = resume 0
      gpu-sync (resume) = print-line-uni "sync"
      gpu-available (resume) = resume 1
      gpu-error (resume) = resume ""
      kernel-launch (kd) (lc) (args) (resume) = print-line-uni "launch"
  end

Section: Entry
  opening : [Console] Nothing = act
    print-line-uni ("gpu " & show (on-host 5))
  end
