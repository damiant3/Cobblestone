Chapter: FwdPromptParserTest
  cites AI chapter PromptParser

Section: Fixtures

  ppt-toks : List PromptToken, Integer, Text -> Text
  ppt-toks (ts) (i) (acc) =
    if i >= list-length ts then acc
    else ppt-toks ts (i + 1) (acc & (if i == 0 then "" else " ") & (list-at ts i).pt-text & ":" & show ((list-at ts i).pt-weight))

  ppt-line : Text -> Text
  ppt-line (s) =
    let p = parse-prompt s
    in "[" & s & "] " & format-parsed-prompt p & " -> " & ppt-segs (p.pp-segments) 0 ""

  ppt-segs : List PromptSegment, Integer, Text -> Text
  ppt-segs (ss) (i) (acc) =
    if i >= list-length ss then acc
    else ppt-segs ss (i + 1) (acc & (if i == 0 then "" else " | ") & ppt-toks ((list-at ss i).ps-tokens) 0 "")

  pp-test-join : List Integer, Integer, Text -> Text
  pp-test-join (xs) (i) (acc) = if i >= list-length xs then acc else pp-test-join xs (i + 1) (acc & (if i == 0 then "" else " ") & show (list-at xs i))

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (ppt-line "a (beautiful:1.5) landscape")
    print-line-uni (ppt-line "(dark:0.5) forest")
    print-line-uni (ppt-line "((emphasis))")
    print-line-uni (ppt-line "mountain BREAK ocean")
    print-line-uni (ppt-line "eat BREAKFAST")
    print-line-uni (ppt-line "(x:2) (y:1.25) (z:1.2555)")
    print-line-uni (ppt-line "(w:99999999999999999999) (v:1.99999999999999999999)")
    print-line-uni ("apply weights to a 3-token prompt, dim 2, embeddings of 100: " & pp-test-join (prompt-apply-weights (parse-prompt "a (b:2) c") [100, 100, 100, 100, 100, 100] 2) 0 "" & "; BREAK alone and at the end: " & show ((parse-prompt "a BREAK").pp-segment-count) & " " & show ((parse-prompt "BREAKS x").pp-segment-count))
  end
