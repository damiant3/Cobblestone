Chapter: FwdOptimizerTest
  cites AI chapter Optimizer
  cites Foreword chapter List

Section: Body

 Fixed point at scale 1000. Adam at lr 0.01, epsilon 0.001: real Adam's first
 step moves a weight by lr g / (|g| + eps), 0.0099 for g 0.1, 0.00999 for g 1.0,
 0.00909 for g 0.01, so 1000 lands at 990.1, 990.01 and 990.9; the fixed point
 truncates each update toward zero.

  adam-one : Integer -> Integer
  adam-one (g) =
    let r = adam-step (adam-config 10) (adam-init 1) [1000] [g]
    in list-at (r.adamr-params) 0

  adam-two : Integer -> Integer
  adam-two (g) =
    let cfg = adam-config 10
    in let r1 = adam-step cfg (adam-init 1) [1000] [g]
    in let r2 = adam-step cfg (r1.adamr-state) (r1.adamr-params) [g]
    in list-at (r2.adamr-params) 0

  adamw-one : Integer -> Integer
  adamw-one (g) =
    let cfg = AdamConfig { adam-lr = 10, adam-beta1 = 900, adam-beta2 = 999, adam-epsilon = 1, adam-weight-decay = 100 }
    in let r = adamw-step cfg (adam-init 1) [1000] [g]
    in list-at (r.adamr-params) 0

  sgd-two : Integer -> Integer
  sgd-two (i) =
    let cfg = sgd-config 100 900
    in let r1 = sgd-step cfg (sgd-init 2) [1000, 2000] [500, 250]
    in let r2 = sgd-step cfg (r1.sgdr-state) (r1.sgdr-params) [500, 250]
    in list-at (r2.sgdr-params) i

Section: Entry
  opening : [Console] Nothing = act
    print-line-uni ("sgd two steps " & show (sgd-two 0) & " " & show (sgd-two 1))
    print-line-uni ("adam g 0.1 " & show (adam-one 100))
    print-line-uni ("adam g 1.0 " & show (adam-one 1000))
    print-line-uni ("adam g 0.01 " & show (adam-one 10))
    print-line-uni ("adam g -0.1 " & show (adam-one -100))
    print-line-uni ("adam two steps g 0.1 " & show (adam-two 100))
    print-line-uni ("adamw g 0.1 decay 0.1 " & show (adamw-one 100))
  end
