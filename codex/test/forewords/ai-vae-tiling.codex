Chapter: FwdVaeTilingTest
  cites AI chapter VaeTiling

Section: Fixtures

  vtt-join : List Integer, Integer, Integer, Text -> Text
  vtt-join (xs) (i) (n) (acc) =
    if i >= n then acc
    else vtt-join xs (i + 1) n (acc & (if i == 0 then "" else " ") & show (list-at xs i))

  vtt-white : Integer, List Rgb -> List Rgb
  vtt-white (n) (acc) =
    if n <= 0 then acc
    else vtt-white (n - 1) (list-push acc (rgb 255 255 255))

  vtt-seq : Integer, Integer, List Integer -> List Integer
  vtt-seq (i) (n) (acc) =
    if i >= n then acc
    else vtt-seq (i + 1) n (list-push acc i)

  vtt-red-row : List Integer, Integer, Integer, Text -> Text
  vtt-red-row (img) (row) (x) (acc) =
    if x >= 4 then acc
    else vtt-red-row img row (x + 1) (acc & (if x == 0 then "" else " ") & show (list-at img (row * 4 + x)))

  vtt-render : List Integer -> List Integer
  vtt-render (bw) =
    let canvas = vt-splat-tile (vt-blank-canvas 4 4) 4 (vtt-white 16 []) 4 4 0 0 bw
    in let weights = vt-splat-weights (vt-blank-weights 4 4) 4 4 4 0 0 bw
    in vt-normalize-canvas canvas weights 4 4

Section: Entry

  opening : [Console] Nothing =
    let tiles = vt-compute-tiles 300 200 tile-default
    in let t2 = list-at tiles 2
    in let small = list-at (vt-compute-tiles 100 100 tile-default) 0
    in let bw = vt-compute-blend-weights 4 4 2 True True True True BlendLinear
    in let solo = vt-compute-blend-weights 4 4 2 False False False False BlendLinear
    in let img = vtt-render bw
    in let solo-img = vtt-render solo
    in act
      print-line-uni (format-tile-grid 64 64 tile-default & "; " & format-tile-grid 300 200 tile-default & "; tile 2 at x " & show (t2.ts-x) & " w " & show (t2.ts-w) & "; 100x100 tile x " & show (small.ts-x) & " w " & show (small.ts-w) & " y " & show (small.ts-y) & " h " & show (small.ts-h))
      print-line-uni ("edge weights, 4 wide, overlap 2: " & show (vt-edge-weight 0 4 2 True True BlendLinear) & " " & show (vt-edge-weight 1 4 2 True True BlendLinear) & " " & show (vt-edge-weight 2 4 2 True True BlendLinear) & " " & show (vt-edge-weight 3 4 2 True True BlendLinear) & "; low edge only: " & show (vt-edge-weight 0 4 2 True False BlendLinear) & " " & show (vt-edge-weight 1 4 2 True False BlendLinear) & " " & show (vt-edge-weight 2 4 2 True False BlendLinear) & " " & show (vt-edge-weight 3 4 2 True False BlendLinear) & "; cosine at 1: " & show (vt-edge-weight 1 4 2 True True BlendCosine))
      print-line-uni ("blend rows 0 and 1, every edge shared: " & vtt-join bw 0 4 "" & " /" & vtt-join bw 4 8 "" & "; no edge shared: " & vtt-join solo 0 4 "" & " /" & vtt-join solo 4 8 "")
      print-line-uni ("white tile, every edge shared, red rows 0 and 1: " & vtt-red-row img 0 0 "" & " / " & vtt-red-row img 1 0 "")
      print-line-uni ("white tile, no edge shared, red rows 0 and 1: " & vtt-red-row solo-img 0 0 "" & " / " & vtt-red-row solo-img 1 0 "")
      print-line-uni ("extract 2x2 at 1,1 of 0..15: " & vtt-join (vt-extract-tile (vtt-seq 0 16 []) 1 4 4 (TileSpec { ts-x = 1, ts-y = 1, ts-w = 2, ts-h = 2, ts-src-x = 1, ts-src-y = 1 })) 0 4 "")
      print-line-uni (format-tile-config tile-small)
    end
