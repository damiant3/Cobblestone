Chapter: FwdTimeOfDayTest
  cites Engine chapter TimeOfDay

Section: Fixtures

  tdt-line : Integer -> Text
  tdt-line (h) =
    let a = tod-sample tod-default-cycle h
    in "hour " & show h & ": " & format-atmosphere a & " sun-y " & show (a.atm-sun-dir-y) & " sky " & show (a.atm-sky-color.cr) & "," & show (a.atm-sky-color.cg) & "," & show (a.atm-sky-color.cb)

Section: Entry

  opening : [Console] Nothing =
    let one = tod-add-key tod-new (TodKeyframe { tk-hour = 7000, tk-params = tod-default-noon })
    in act
      print-line-uni (tdt-line 12000)
      print-line-uni (tdt-line 9000)
      print-line-uni (tdt-line 21000)
      print-line-uni (tdt-line 3000)
      print-line-uni ("empty cycle: " & format-atmosphere (tod-sample tod-new 5000) & ", one key: " & format-atmosphere (tod-sample one 20000))
      print-line-uni ("span 18000 to 0: " & show (tod-hour-span 18000 0) & ", 6000 to 9000: " & show (tod-hour-span 6000 9000))
    end
