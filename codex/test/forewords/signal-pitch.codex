Chapter: FwdPitchTest
  cites Signal chapter Pitch

Section: Fixtures

  pit-square : Integer, Integer, List Integer -> List Integer
  pit-square (i) (n) (acc) =
    if i >= n then acc
    else pit-square (i + 1) n (list-push acc (if i - (i / 8) * 8 < 4 then 1000 else -1000))

  pit-zeros : Integer, Integer, List Integer -> List Integer
  pit-zeros (i) (n) (acc) =
    if i >= n then acc
    else pit-zeros (i + 1) n (list-push acc 0)

Section: Entry

  opening : [Console] Nothing =
    let sq = pit-square 0 64 []
    in let r = pitch-detect sq (Hertz 8000)
    in let quiet = pitch-detect (pit-zeros 0 64 []) (Hertz 8000)
    in act
      print-line-uni ("square period 8 at 8000: frequency " & show (r.pr-frequency) & ", period " & show (r.pr-period) & ", peak " & show (r.pr-confidence))
      print-line-uni ("confidence at period 8: " & show (pitch-confidence sq 64 8))
      print-line-uni ("silence: frequency " & show (quiet.pr-frequency) & ", period " & show (quiet.pr-period))
      print-line-uni ("note freq 69 " & show (pitch-note-freq 69) & ", 70 " & show (pitch-note-freq 70) & ", 68 " & show (pitch-note-freq 68) & ", 81 " & show (pitch-note-freq 81) & ", 60 " & show (pitch-note-freq 60))
      print-line-uni ("midi of 440000: " & show (pitch-midi-note 440000) & " " & pitch-note-name (pitch-midi-note 440000) & "; of 0: " & show (pitch-midi-note 0))
      print-line-uni ("nearest of 452000 453500 1 20000000: " & show (pitch-midi-note 452000) & " " & show (pitch-midi-note 453500) & " " & show (pitch-midi-note 1) & " " & show (pitch-midi-note 20000000))
      print-line-uni ("names 60 " & pitch-note-name 60 & ", 69 " & pitch-note-name 69 & ", 71 " & pitch-note-name 71)
    end
