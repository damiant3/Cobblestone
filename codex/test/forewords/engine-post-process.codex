Chapter: FwdPostProcessTest
  cites Engine chapter PostProcess

Section: Fixtures

  ppt-row : Framebuf, Integer, Integer, Text -> Text
  ppt-row (fb) (x) (n) (acc) =
    if x >= n then acc
    else ppt-row fb (x + 1) n (acc & (if x == 0 then "" else " ") & show (fb-get fb x 0))

  ppt-dot : Framebuf
  ppt-dot = fb-set (fb-new 5 1 0) 2 0 16777215

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("luminance white " & show (pp-luminance 16777215) & ", red " & show (pp-luminance 16711680) & "; pack 300,-5,128 " & show (pp-pack 300 (0 - 5) 128))
    print-line-uni ("aces channel 0 128 255: " & show (pp-aces-channel 0) & " " & show (pp-aces-channel 128) & " " & show (pp-aces-channel 255))
    print-line-uni ("bloom on one white pixel: " & ppt-row (pp-bloom ppt-dot (BloomConfig { bloom-threshold = 200, bloom-intensity = 400, bloom-radius = 1 })) 0 5 "")
    print-line-uni ("bright pass 200 keeps white, drops red: " & show (fb-get (pp-bright-pass (fb-set (fb-new 2 1 16711680) 0 0 16777215) 200) 0 0) & " " & show (fb-get (pp-bright-pass (fb-set (fb-new 2 1 16711680) 0 0 16777215) 200) 1 0))
    print-line-uni ("fxaa on all-white 3x3: white pixels " & show (fb-count-color (pp-fxaa (fb-new 3 3 16777215)) 16777215) & " of 9")
  end
