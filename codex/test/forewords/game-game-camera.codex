Chapter: FwdGameCameraTest
  cites Game chapter GameCamera

Section: Fixtures

  gct-cam : GameCam
  gct-cam = camera-new 0 0 800 600

  gct-s : CamScreenPos -> Text
  gct-s (p) = "(" & show (p.csp-x) & "," & show (p.csp-y) & ")"

  gct-w : CamWorldPos -> Text
  gct-w (p) = "(" & show (p.cwp-x) & "," & show (p.cwp-y) & ")"

  gct-r : CamRect -> Text
  gct-r (r) = "(" & show (r.cr-x) & "," & show (r.cr-y) & "," & show (r.cr-w) & "," & show (r.cr-h) & ")"

  gct-b : Boolean -> Text
  gct-b (b) = if b then "T" else "F"

Section: Entry

  opening : [Console] Nothing =
    let z2 = camera-set-zoom gct-cam 2000
    in let f1 = camera-follow gct-cam 1000 500 250
    in let f1-x = f1.gc-x
    in let f1-y = f1.gc-y
    in let f2 = camera-follow (camera-follow gct-cam 1000 500 250) 1000 500 250
    in let s1 = camera-update-shake (camera-shake gct-cam 100 (0 - 50))
    in let s1-x = s1.gc-shake-x
    in let s1-y = s1.gc-shake-y
    in let s2 = camera-update-shake (camera-update-shake (camera-shake gct-cam 100 (0 - 50)))
    in let tiny = camera-update-shake (camera-shake gct-cam 1 1)
    in act
      print-line-uni ("world 100,50 to screen: " & gct-s (camera-world-to-screen gct-cam 100 50) & ", zoom 2000: " & gct-s (camera-world-to-screen z2 100 50) & ", back: " & gct-w (camera-screen-to-world z2 600 400))
      print-line-uni ("follow 1000,500 at 250: (" & show f1-x & "," & show f1-y & ") then (" & show (f2.gc-x) & "," & show (f2.gc-y) & ")")
      print-line-uni ("shake 100,-50 decays: (" & show s1-x & "," & show s1-y & ") then (" & show (s2.gc-shake-x) & "," & show (s2.gc-shake-y) & "), shake 1 to " & show (tiny.gc-shake-x))
      print-line-uni ("visible rect " & gct-r (camera-visible-rect gct-cam) & ", zoom 2000 " & gct-r (camera-visible-rect z2))
      print-line-uni ("visible 400,300 " & gct-b (camera-is-visible gct-cam 400 300) & ", 401,0 " & gct-b (camera-is-visible gct-cam 401 0) & ", 0,-301 " & gct-b (camera-is-visible gct-cam 0 (0 - 301)))
      let turned = camera-set-rotation (camera-new 0 0 800 600) 1571
      in print-line-uni ("rotation 1571 mrad: world 100,50 to " & gct-s (camera-world-to-screen turned 100 50) & ", back " & gct-w (camera-screen-to-world turned 450 200) & ", visible rect " & gct-r (camera-visible-rect turned))
    end
