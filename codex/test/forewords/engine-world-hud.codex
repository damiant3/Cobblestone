Chapter: FwdWorldHUDTest
  cites Engine chapter WorldHUD

Section: Fixtures

  wht-cam : Camera3D
  wht-cam = camera3d-new (vec3-new 0.0 0.0 1000.0) (vec3-new 0.0 0.0 0.0) 1.0

  wht-anchor : Integer, Integer, Integer -> HudAnchor
  wht-anchor (x) (y) (z) = HudAnchor { ha-world-x = x, ha-world-y = y, ha-world-z = z, ha-offset-y = 0 }

  wht-proj : Integer, Integer, Integer -> HudProjected
  wht-proj (x) (y) (z) = hud-project (HudNameplate (wht-anchor x y z) "n") wht-cam 160 120

  wht-b : Boolean -> Text
  wht-b (b) = if b then "T" else "F"

Section: Entry

  opening : [Console] Nothing =
    let centre = wht-proj 0 0 0
    in let up = wht-proj 0 100 0
    in let right = wht-proj 100 0 0
    in let behind = wht-proj 0 0 2000
    in let bar = hud-draw-health-bar (fb-new 100 100 0) 50 50 50 100
    in let low = hud-draw-health-bar (fb-new 100 100 0) 50 50 20 100
    in act
      print-line-uni ("target: screen " & show (centre.hp-sx) & "," & show (centre.hp-sy) & " visible " & wht-b (centre.hp-visible))
      print-line-uni ("above target: higher " & wht-b (up.hp-sy < 120) & ", same column " & wht-b (up.hp-sx == 160) & "; right of target: further right " & wht-b (right.hp-sx > 160) & ", same row " & wht-b (right.hp-sy == 120))
      print-line-uni ("behind the eye: visible " & wht-b (behind.hp-visible) & ", depth " & show (behind.hp-depth))
      print-line-uni ("health 50 of 100: yellow " & show (fb-count-color bar 13421568) & ", grey " & show (fb-count-color bar 3355443) & "; 20 of 100: red " & show (fb-count-color low 13369344) & ", grey " & show (fb-count-color low 3355443))
      print-line-uni ("damage 7 age 50 at 50,50: red " & show (fb-count-color (hud-draw-damage (fb-new 100 100 0) 50 50 7 50) 16729156) & " at row 45 " & show (fb-get (hud-draw-damage (fb-new 100 100 0) 50 50 7 50) 50 45))
    end
