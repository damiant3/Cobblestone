Chapter: FwdChartsTest
  cites UI chapter Charts

Section: Fixtures

  cht-cmd : DrawCmd -> Text
  cht-cmd (c) =
    when c
      is DrawLine (x1) (y1) (x2) (y2) (col) -> "line " & show x1 & "," & show y1 & "-" & show x2 & "," & show y2
      is DrawRect (x) (y) (w) (h) (col) (fill) -> "rect " & show x & "," & show y & "," & show w & "," & show h
      is DrawText (x) (y) (t) (col) -> "text " & t
      is DrawCircle (x) (y) (r) (col) -> "circle " & show x & "," & show y & " r" & show r

  cht-all : List DrawCmd, Integer, Text -> Text
  cht-all (cs) (i) (acc) =
    if i >= list-length cs then acc
    else cht-all cs (i + 1) (acc & (if i == 0 then "" else "; ") & cht-cmd (list-at cs i))

  cht-pts : List DataPoint
  cht-pts = [data-point 0 0, data-point 10 50, data-point 20 100]

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("bar 10 20 40: " & cht-all (chart-render (chart-bar "B" [data-point 0 10, data-point 1 20, data-point 2 40] 255)) 0 "")
    print-line-uni ("line: " & cht-all (chart-render (chart-line "L" cht-pts 255)) 0 "")
    print-line-uni ("scatter: " & cht-all (chart-render (chart-scatter "S" cht-pts 255)) 0 "")
    print-line-uni ("pie of 3 slices: " & cht-all (chart-render (chart-pie "P" [data-point-labeled 0 50 "a", data-point-labeled 0 30 "b", data-point-labeled 0 20 "c"])) 0 "")
    print-line-uni ("empty bar: " & cht-all (chart-render (chart-bar "E" [] 1)) 0 "" & "; one-point line: " & cht-all (chart-render (chart-line "O" [data-point 1 1] 1)) 0 "")
    print-line-uni ("line -50 to 50: " & cht-all (chart-render (chart-line "M" [data-point 0 (0 - 50), data-point 10 50] 1)) 0 "")
    print-line-uni ("bar -10 20: " & cht-all (chart-render (chart-bar "N" [data-point 0 (0 - 10), data-point 1 20] 1)) 0 "")
  end
