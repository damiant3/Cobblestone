Chapter: FwdAccessibilityTest
  cites UI chapter Accessibility
  cites Foreword chapter Maybe
  cites Foreword chapter Console

 This chapter is cited by nothing in the tree, so nothing has ever run it.
 The arm is a CENSUS rather than a spot check for one reason:
 `a11y-is-interactive` answers False through an `otherwise` catch-all, and a
 role that drifts into that arm looks exactly like a role that was always
 inert. Naming all sixteen constructors and asking each one is what can tell
 those apart.

 `e` is bound BEFORE the builders run and printed after them, which is
 deliberate: `__record-set` stores in place, so if `a11y-empty` were one
 shared record rather than a recipe every builder would be mutating the
 defaults out from under the next caller, and this row would show it.

Section: Body

  yn : Boolean -> Text
  yn (b) = if b then "y" else "n"

  mb : Maybe Boolean -> Text
  mb (m) = when m
    is Just (b) -> if b then "Just True" else "Just False"
    is None -> "None"

  live-name : A11yLive -> Text
  live-name (l) = when l
    is LiveOff -> "off"
    is LivePolite -> "polite"
    is LiveAssertive -> "assertive"

  head-level : A11yRole -> Integer
  head-level (r) = when r
    is RoleHeading (n) -> n
    is otherwise -> 0 - 1

  cell : A11yRole -> Text
  cell (r) = a11y-role-name r & "/" & yn (a11y-is-interactive r)

  all-roles : List A11yRole
  all-roles = [RoleButton, RoleTextbox, RoleCheckbox, RoleRadio, RoleSlider, RoleMenu, RoleMenuItem, RoleDialog, RoleAlert, RoleStatus, (RoleHeading 2), RoleList, RoleListItem, RoleLink, RoleImage, RoleNone]

  census : List A11yRole, Integer, Text -> Text
  census (rs) (i) (acc) =
    if i >= list-length rs then acc
    else census rs (i + 1) (acc & " " & cell (list-at rs i))

Section: Entry

  opening : [Console] Nothing = act
    let e = a11y-empty
    in let btn = a11y-button "Save"
    in let bare = a11y-role a11y-empty RoleButton
    in let chk = a11y-checkbox "Sounds" True
    in let sld = a11y-slider "Volume" 40 0 100
    in let hd = a11y-heading "Appearance" 2
    in let al = a11y-alert "disk full"
    in let st = a11y-status "saved"
    in let hid = a11y-focus-order (a11y-hidden (a11y-button "Close")) 7
    in act
      print-line-uni ("roles    :" & census all-roles 0 "")
      print-line-uni ("empty    : " & a11y-role-name (e.ai-role) & " " & live-name (e.ai-live) & " tab " & show (e.ai-tab-index) & " hidden " & yn (e.ai-hidden) & " " & mb (e.ai-expanded) & " " & mb (e.ai-checked) & " " & show (e.ai-value-now) & " " & show (e.ai-value-min) & " " & show (e.ai-value-max))
      print-line-uni ("announce : " & a11y-announce btn & " | " & a11y-announce bare)
      print-line-uni ("checkbox : " & mb (chk.ai-checked) & " " & a11y-announce chk)
      print-line-uni ("slider   : " & show (sld.ai-value-now) & " of " & show (sld.ai-value-min) & ".." & show (sld.ai-value-max))
      print-line-uni ("heading  : " & a11y-role-name (hd.ai-role) & " level " & show (head-level (hd.ai-role)))
      print-line-uni ("alert    : " & live-name (al.ai-live) & " " & a11y-role-name (al.ai-role))
      print-line-uni ("status   : " & live-name (st.ai-live) & " " & a11y-role-name (st.ai-role))
      print-line-uni ("hidden   : " & yn (hid.ai-hidden) & " tab " & show (hid.ai-tab-index) & " " & a11y-announce hid)
    end
  end

