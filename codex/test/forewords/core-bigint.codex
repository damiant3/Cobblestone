Chapter: FwdBigIntTest
  cites Foreword chapter BigInt

Section: Helpers
  test-from-int : Text
  test-from-int =
    let a = bigint-from-integer 12345
    in bigint-to-text a

  test-add : Text
  test-add =
    let a = bigint-from-integer 9999
    in let b = bigint-from-integer 1
    in bigint-to-text (bigint-add a b)

  test-mul : Text
  test-mul =
    let a = bigint-from-integer 9999
    in let b = bigint-from-integer 9999
    in bigint-to-text (bigint-mul a b)

  test-negate : Text
  test-negate =
    let a = bigint-from-integer 42
    in bigint-to-text (bigint-negate a)

  test-factorial : Text
  test-factorial = bigint-to-text (bigint-factorial 10)

  test-compare : Text
  test-compare =
    let a = bigint-from-integer 100
    in let b = bigint-from-integer 200
    in show (bigint-compare a b)

Section: Entry
  opening : [Console] Nothing = act
    print-line-uni test-from-int
    print-line-uni test-add
    print-line-uni test-mul
    print-line-uni test-negate
    print-line-uni test-factorial
    print-line-uni test-compare
  end
