Chapter: FwdShakeTest
  cites Foreword chapter Shake

Section: Fixtures

  skt-parts : List ShakePart
  skt-parts = [ShakePart { name = "a", frags = [ShakeLit "A(", ShakeUse "b", ShakeLit ")"] }, ShakePart { name = "b", frags = [ShakeLit "B", ShakeUse "c"] }, ShakePart { name = "c", frags = [ShakeLit "C"] }, ShakePart { name = "d", frags = [ShakeLit "D", ShakeUse "a"] }, ShakePart { name = "e", frags = [ShakeUse "e", ShakeLit "E"] }]

  skt-names : List ShakePart, Integer, Text -> Text
  skt-names (ps) (i) (acc) =
    if i >= list-length ps then acc
    else skt-names ps (i + 1) (acc & (if i == 0 then "" else " ") & (list-at ps i).name)

  skt-join : List Text, Integer, Text -> Text
  skt-join (xs) (i) (acc) =
    if i >= list-length xs then acc
    else skt-join xs (i + 1) (acc & (if i == 0 then "" else " ") & list-at xs i)

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("root a: kept " & show (list-length (shake-kept skt-parts ["a"])) & " [" & skt-names (shake-kept skt-parts ["a"]) 0 "" & "] text [" & shake-text skt-parts ["a"] & "]")
    print-line-uni ("roots d zz: kept " & show (list-length (shake-kept skt-parts ["d", "zz"])) & " [" & skt-names (shake-kept skt-parts ["d", "zz"]) 0 "" & "] unmatched [" & skt-join (shake-unmatched skt-parts ["d", "zz"]) 0 "" & "]")
    print-line-uni ("root e (self use): kept [" & skt-names (shake-kept skt-parts ["e"]) 0 "" & "] text [" & shake-text skt-parts ["e"] & "]")
    print-line-uni ("uses of x: [" & skt-join (shake-frag-uses "x" [ShakeUse "y", ShakeUse "y", ShakeUse "x", ShakeLit "q", ShakeUse "z"]) 0 "" & "]")
    print-line-uni ("no roots: kept " & show (list-length (shake-kept skt-parts [])) & " [" & skt-names (shake-kept skt-parts []) 0 "" & "]")
  end
