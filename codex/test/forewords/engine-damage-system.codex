Chapter: FwdDamageSystemTest
  cites Engine chapter DamageSystem

Section: Fixtures

  dmt-hit : DamageState, BodyPart, DamageType, Integer -> DamageState
  dmt-hit (ds) (part) (kind) (amount) = ds-apply-damage ds part kind amount 0 0 0

  dmt-b : Boolean -> Text
  dmt-b (b) = if b then "T" else "F"

Section: Entry

  opening : [Console] Nothing =
    let cut = dmt-hit ds-new PartLeftArm DmgSlash 300
    in let cut-hp = ds-limb-hp cut PartLeftArm
    in let cut-blood = (ds-bleed-tick cut 1000).ds-total-blood-loss
    in let bruised = dmt-hit (dmt-hit ds-new PartLeftArm DmgSlash 300) PartLeftArm DmgBlunt 100
    in let bruised-hp = ds-limb-hp bruised PartLeftArm
    in let bruised-blood = (ds-bleed-tick bruised 1000).ds-total-blood-loss
    in let off = dmt-hit (dmt-hit ds-new PartLeftArm DmgSlash 300) PartLeftArm DmgPierce 500
    in let off-sev = ds-is-severed off PartLeftArm
    in let off-wounds = off.ds-wound-count
    in let again = (dmt-hit off PartLeftArm DmgSlash 100).ds-wound-count
    in let drained = ds-bleed-tick (dmt-hit ds-new PartLeftArm DmgPierce 700) 101000
    in act
      print-line-uni ("slash 300 on left arm: hp " & show cut-hp & ", one second bleeds " & show cut-blood)
      print-line-uni ("then blunt 100: hp " & show bruised-hp & ", one second bleeds " & show bruised-blood)
      print-line-uni ("then pierce 500: severed " & dmt-b off-sev & ", wounds " & show off-wounds & ", hit on the stump adds wounds to " & show again)
      print-line-uni ("severed arm, 101 s: " & format-damage-state drained)
      print-line-uni ("explosion 700 on head: " & format-damage-state (dmt-hit ds-new PartHead DmgExplosion 700))
      print-line-uni ("slash 2000 on torso: " & format-damage-state (dmt-hit ds-new PartTorso DmgSlash 2000))
      print-line-uni ("armor on 1000: blunt " & show (ds-apply-armor 1000 DmgBlunt) & ", pierce " & show (ds-apply-armor 1000 DmgPierce) & ", poison " & show (ds-apply-armor 1000 DmgPoison) & ", frost " & show (ds-apply-armor 1000 DmgFrost))
    end
