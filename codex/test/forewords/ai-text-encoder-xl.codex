Chapter: FwdTextEncoderXLTest
  cites AI chapter TextEncoderXL

Section: Fixtures

  txt-join : List Integer, Integer, Integer, Text -> Text
  txt-join (xs) (i) (w) (acc) =
    if i >= list-length xs then acc
    else txt-join xs (i + 1) w (acc & (if i == 0 then "" else if i - (i / w) * w == 0 then " / " else " ") & show (list-at xs i))

Section: Entry

  opening : [Console] Nothing =
    let h1 = [1, 2, 3, 4]
    in let h2 = [10, 20, 30, 40, 50, 60]
    in let out = DualEncoderOutput { deo-context = dual-concat-hidden h1 h2 2 2 3, deo-pooled = dual-extract-pooled h2 [49406, 49407] 3, deo-seq-len = 2, deo-dim = 5 }
    in act
      print-line-uni ("concat dims 2 and 3 over 2 positions: " & txt-join (out.deo-context) 0 5 "")
      print-line-uni ("pooled at the first EOS of bos eos: " & txt-join (out.deo-pooled) 0 3 "" & "; " & format-dual-output out & "; of bos a eos pad over 5 6 7 8: " & txt-join (dual-extract-pooled [5, 6, 7, 8] [49406, 320, 49407, 49407] 1) 0 1 "")
      print-line-uni ("encoder 1: d " & show (sdxl-encoder1-config.te-d-model) & " layers " & show (sdxl-encoder1-config.te-num-layers) & "; encoder 2: d " & show (sdxl-encoder2-config.te-d-model) & " layers " & show (sdxl-encoder2-config.te-num-layers) & " heads " & show (sdxl-encoder2-config.te-num-heads) & "; context dim " & show (sdxl-encoder1-config.te-d-model + sdxl-encoder2-config.te-d-model))
      print-line-uni ("extract 2 from 3 of 7 8 9 10 11: " & txt-join (dual-extract-vec [7, 8, 9, 10, 11] 3 2 0 []) 0 9 "")
    end
