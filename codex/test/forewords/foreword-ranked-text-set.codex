Chapter: FwdRankedTextSetTest
  cites Foreword chapter RankedTextSet

 THE ORDER IS NOT ALPHABETICAL, AND THAT IS CORRECT. This set is
 ordered by text-compare, which compares CCE code points, and CCE
 orders letters by FREQUENCY -- so d precedes c, and "damson" really
 does sort before "cherry". The test prints the codes it is sorting by
 rather than asserting the word "sorted", because a reader who assumes
 ASCII here will read a green test as a broken one. Five insertions of
 four distinct values give size 4: the duplicate "apple" is a no-op.

Section: Entry

  fruit : RankedTextSet
  fruit = ranked-text-from-list ["pear", "apple", "cherry", "apple", "damson"]

  show-list : List Text -> Text
  show-list (xs) = show-list-loop xs 0 (list-length xs) ""

  show-list-loop : List Text, Integer, Integer, Text -> Text
  show-list-loop (xs) (i) (len) (acc) =
   if i == len then acc
   else show-list-loop xs (i + 1) len (if i == 0 then list-at xs i else acc & "," & list-at xs i)

  opening : [Console] Nothing = act
    print-line-uni ("size " & show (ranked-text-size fruit))
    print-line-uni ("cce-order " & show-list (ranked-text-to-list fruit))
    print-line-uni ("cce a c d p " & show (char-code (char-at "a" 0)) & " " & show (char-code (char-at "c" 0)) & " " & show (char-code (char-at "d" 0)) & " " & show (char-code (char-at "p" 0)))
    print-line-uni ("has cherry " & show (ranked-text-has fruit "cherry"))
    print-line-uni ("has fig " & show (ranked-text-has fruit "fig"))
    print-line-uni ("at 0 " & ranked-text-at fruit 0)
    print-line-uni ("at 3 " & ranked-text-at fruit 3)
    print-line-uni ("rank damson " & show (ranked-text-rank-of fruit "damson"))
    print-line-uni ("union " & show-list (ranked-text-to-list (ranked-text-union fruit (ranked-text-from-list ["fig", "apple"]))))
  end
