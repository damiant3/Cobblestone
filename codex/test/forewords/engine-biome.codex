Chapter: FwdBiomeTest
  cites Engine chapter Biome

Section: Fixtures

  bit-c : Integer, Integer, Integer -> Text
  bit-c (t) (m) (a) = biome-name (biome-classify t m a)

  bit-clim : Integer, Integer, Integer -> Climate
  bit-clim (t) (m) (a) = Climate { clim-temperature = t, clim-moisture = m, clim-altitude = a, clim-wind-x = 0, clim-wind-z = 0, clim-wind-speed = 0, clim-cloud-cover = 0, clim-precipitation = 0 }

  bit-names : List BiomeType, Integer, Text -> Text
  bit-names (bs) (i) (acc) =
    if i >= list-length bs then acc
    else bit-names bs (i + 1) (acc & (if i == 0 then "" else " ") & biome-name (list-at bs i))

Section: Entry

  opening : [Console] Nothing =
    let r1 = ws-tick (ws-rain 400 100) 60
    in let r2 = ws-tick (ws-tick (ws-rain 400 100) 60) 60
    in act
      print-line-uni ("classify: " & bit-c 0 600 0 & " " & bit-c (0 - 100) 900 0 & " " & bit-c 100 700 0 & " " & bit-c 100 300 0 & " " & bit-c 300 800 0 & " " & bit-c 300 500 0 & " " & bit-c 300 100 0 & " " & bit-c 400 900 0 & " " & bit-c 0 0 4000 & " " & bit-c 0 0 (0 - 600))
      print-line-uni ("summer rain on default: " & format-microclimate (mc-compute clim-default (ws-rain 400 100) SeaSummer))
      print-line-uni ("winter snow on default: " & format-microclimate (mc-compute clim-default (ws-snow 400 100) SeaWinter))
      print-line-uni ("growth at 350 351 700, moisture 1000: " & show (mc-growth-rate 350 1000) & " " & show (mc-growth-rate 351 1000) & " " & show (mc-growth-rate 700 1000) & "; at 350, moisture 50: " & show (mc-growth-rate 350 50))
      print-line-uni ("rain 100 ticked 60: " & format-weather r1 & " elapsed " & show (r1.ws-elapsed) & "; again: " & format-weather r2 & "; " & format-weather (ws-storm 5))
      print-line-uni ("map of three: " & bit-names (bm-classify-all [bit-clim 0 600 0, bit-clim 300 100 0, bit-clim 0 0 4000] 0 3) 0 "" & "; " & format-climate clim-default)
    end
