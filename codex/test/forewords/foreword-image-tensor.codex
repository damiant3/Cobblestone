Chapter: ImageTensorConversion
  cites Foreword chapter Console
  cites Game chapter Color
  cites AI chapter ImageTensor

Section: Round Trip

  rt-signed-wrong : Integer, Integer -> Integer
  rt-signed-wrong (v) (acc) =
   if v > 255 then acc
   else let back = tensor-to-image (image-to-tensor (image-new 1 1 [rgb v v v])) 1 1
   in rt-signed-wrong (v + 1) (if (list-at (back.img-pixels) 0).cr == v then acc else acc + 1)

  rt-signed-bias : Integer, Integer -> Integer
  rt-signed-bias (v) (acc) =
   if v > 255 then acc
   else let back = tensor-to-image (image-to-tensor (image-new 1 1 [rgb v v v])) 1 1
   in rt-signed-bias (v + 1) (acc + (list-at (back.img-pixels) 0).cr - v)

  rt-unit-wrong : Integer, Integer -> Integer
  rt-unit-wrong (v) (acc) =
   if v > 255 then acc
   else let back = tensor-to-image-unit (image-to-tensor-unit (image-new 1 1 [rgb v v v])) 1 1
   in rt-unit-wrong (v + 1) (if (list-at (back.img-pixels) 0).cr == v then acc else acc + 1)

  rt-unit-bias : Integer, Integer -> Integer
  rt-unit-bias (v) (acc) =
   if v > 255 then acc
   else let back = tensor-to-image-unit (image-to-tensor-unit (image-new 1 1 [rgb v v v])) 1 1
   in rt-unit-bias (v + 1) (acc + (list-at (back.img-pixels) 0).cr - v)

Section: Rendering

  show-ints : List Integer, Integer, Integer, Text -> Text
  show-ints (xs) (i) (n) (acc) =
   if i >= n then acc
   else show-ints xs (i + 1) n (if i == 0 then show (list-at xs i) else acc & "," & show (list-at xs i))

  show-px : List Rgb, Integer, Integer, Text -> Text
  show-px (xs) (i) (n) (acc) =
   if i >= n then acc
   else let p = list-at xs i
   in show-px xs (i + 1) n (acc & " (" & show (p.cr) & "," & show (p.cg) & "," & show (p.cb) & ")")

  first-channel : ImageData -> Integer
  first-channel (img) = (list-at (img.img-pixels) 0).cr

Section: Entry

  opening : [Console] Nothing =
    act
      let two = image-new 2 1 [rgb 10 20 30, rgb 40 50 60]
      in let up = image-resize (image-new 2 2 [rgb 1 1 1, rgb 2 2 2, rgb 3 3 3, rgb 4 4 4]) 4 4
      in let down = image-resize (image-new 4 1 [rgb 1 1 1, rgb 2 2 2, rgb 3 3 3, rgb 4 4 4]) 2 1
      in let gray = image-to-grayscale (image-new 4 1 [rgb 255 255 255, rgb 0 0 0, rgb 255 0 0, rgb 0 255 0])
      in let n1 = img-noise-tensor 1 2 2 7
      in let n2 = img-noise-tensor 1 2 2 7
      in let n3 = img-noise-tensor 1 2 2 8
      in act
        print-line-uni ("nchw unit " & show-ints (image-to-tensor-unit two) 0 6 "")
        print-line-uni ("nchw signed " & show-ints (image-to-tensor two) 0 6 "")
        print-line-uni ("endpoints signed " & show (list-at (image-to-tensor (image-new 1 1 [rgb 0 0 0])) 0) & " " & show (list-at (image-to-tensor (image-new 1 1 [rgb 255 255 255])) 0))
        print-line-uni ("endpoints unit " & show (list-at (image-to-tensor-unit (image-new 1 1 [rgb 0 0 0])) 0) & " " & show (list-at (image-to-tensor-unit (image-new 1 1 [rgb 255 255 255])) 0))
        print-line-uni ("signed round trip wrong " & show (rt-signed-wrong 0 0) & " of 256, net bias " & show (rt-signed-bias 0 0))
        print-line-uni ("unit round trip wrong " & show (rt-unit-wrong 0 0) & " of 256, net bias " & show (rt-unit-bias 0 0))
        print-line-uni ("clamp signed " & show (first-channel (tensor-to-image [0 - 5000, 0 - 5000, 0 - 5000] 1 1)) & " " & show (first-channel (tensor-to-image [5000, 5000, 5000] 1 1)))
        print-line-uni ("clamp unit " & show (first-channel (tensor-to-image-unit [0 - 5000, 0 - 5000, 0 - 5000] 1 1)) & " " & show (first-channel (tensor-to-image-unit [5000, 5000, 5000] 1 1)))
        print-line-uni ("resize up " & show (up.img-width) & "x" & show (up.img-height) & show-px (up.img-pixels) 0 16 "")
        print-line-uni ("resize down" & show-px (down.img-pixels) 0 2 "")
        print-line-uni ("grayscale " & show-ints gray 0 4 "")
        print-line-uni ("noise repeatable " & show (show-ints n1 0 4 "" == show-ints n2 0 4 "") & " seed matters " & show (show-ints n1 0 4 "" /= show-ints n3 0 4 "") & " " & show-ints n1 0 4 "")
        print-line-uni ("format " & format-image (image-new 7 5 []))
      end
    end
