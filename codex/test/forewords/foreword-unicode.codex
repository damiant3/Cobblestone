Chapter: FwdUnicodeTest
  cites Foreword chapter Unicode

Section: Fixtures

  unt-join : List Integer, Integer, Text -> Text
  unt-join (xs) (i) (acc) =
    if i >= list-length xs then acc
    else unt-join xs (i + 1) (acc & (if i == 0 then "" else " ") & show (list-at xs i))

  unt-b : Boolean -> Text
  unt-b (b) = if b then "T" else "F"

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("upper [" & unicode-to-upper "Hello, World 42" & "] lower [" & unicode-to-lower "Hello, World 42" & "]")
    print-line-uni ("eq-ci ABC abc " & unt-b (unicode-eq-ci "ABC" "abc") & ", ABC abd " & unt-b (unicode-eq-ci "ABC" "abd") & ", compare-ci MiXeD mixed " & show (unicode-compare-ci "MiXeD" "mixed"))
    print-line-uni ("letter 65 91 97 123 48: " & unt-b (uni-is-letter 65) & unt-b (uni-is-letter 91) & unt-b (uni-is-letter 97) & unt-b (uni-is-letter 123) & unt-b (uni-is-letter 48))
    print-line-uni ("digit 47 48 57 58: " & unt-b (uni-is-digit 47) & unt-b (uni-is-digit 48) & unt-b (uni-is-digit 57) & unt-b (uni-is-digit 58) & ", space 32 9 11 12: " & unt-b (uni-is-whitespace 32) & unt-b (uni-is-whitespace 9) & unt-b (uni-is-whitespace 11) & unt-b (uni-is-whitespace 12))
    print-line-uni ("words of [  hi there, x1!]: " & unt-join (unicode-word-boundaries "  hi there, x1!") 0 "")
    print-line-uni ("words of [abc]: " & unt-join (unicode-word-boundaries "abc") 0 "")
    print-line-uni ("grapheme count 5, at 1 [" & unicode-grapheme-at "hello" 1 & "] at 9 [" & unicode-grapheme-at "hello" 9 & "] at -1 [" & unicode-grapheme-at "hello" (0 - 1) & "] count " & show (unicode-grapheme-count "hello"))
  end
