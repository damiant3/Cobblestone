Chapter: FwdFilterTest
  cites Signal chapter Filter

Section: Fixtures

  flt-join : List Integer, Integer, Text -> Text
  flt-join (xs) (i) (acc) =
    if i >= list-length xs then acc
    else flt-join xs (i + 1) (acc & (if i == 0 then "" else " ") & show (list-at xs i))

Section: Entry

  opening : [Console] Nothing =
    let ident = BiquadFilter { b0 = 1000, b1 = 0, b2 = 0, a1 = 0, a2 = 0 }
    in let pole = BiquadFilter { b0 = 500, b1 = 0, b2 = 0, a1 = 0 - 500, a2 = 0 }
    in let lp = lpf-design (Hertz 1000) (Hertz 8000) 1
    in let hp = hpf-design (Hertz 1000) (Hertz 8000) 1
    in act
      print-line-uni ("fir [500 500] over 1000 1000 1000 0: " & flt-join (fir-apply (fir-new [500, 500]) [1000, 1000, 1000, 0]) 0 "")
      print-line-uni ("fir [1000] over 7 -3 9: " & flt-join (fir-apply (fir-new [1000]) [7, 0 - 3, 9]) 0 "")
      print-line-uni ("iir identity: " & flt-join (iir-apply ident [5, 0 - 3, 7]) 0 "")
      print-line-uni ("iir one pole: " & flt-join (iir-apply pole [1000, 0, 0]) 0 "")
      print-line-uni ("lpf order 1 at 1000/8000: " & flt-join (lp.coeffs) 0 "" & ", hpf " & flt-join (hp.coeffs) 0 "")
      print-line-uni ("sinc 0: " & show (filter-sinc 0) & ", hamming n 1: " & show (hamming-window 0 1))
    end
