Chapter: FwdClipboardTest
  cites UI chapter Clipboard
  cites Foreword chapter Maybe

Section: Body

  text-of : Clipboard -> Text
  text-of (cb) = when clipboard-get-text cb
    is Just (t) -> "text " & t
    is None -> "no text"

  bytes-of : Clipboard -> Text
  bytes-of (cb) = when clipboard-get-bytes cb
    is Just (d) -> "bytes " & show (list-length d) & " sum " & show (list-at d 0 + list-at d 1 + list-at d 2)
    is None -> "no bytes"

  flags : Clipboard -> Text
  flags (cb) =
    (if clipboard-is-empty cb then "E" else "e") & (if clipboard-has-text cb then "T" else "t") & (if clipboard-has-bytes cb then "B" else "b")

  line : Text, Clipboard -> Text
  line (name) (cb) =
    name & ": seq " & show (clipboard-sequence cb) & " " & flags cb & " mime [" & clipboard-mime-type cb & "] " & text-of cb & ", " & bytes-of cb

  report : Text
  report =
    let c0 = clipboard-empty
    in let c1 = clipboard-set-text c0 "hello"
    in let c2 = clipboard-set-bytes c1 [7, 11, 13] "image/png"
    in let c3 = clipboard-clear c2
    in let c4 = clipboard-set-text c3 "again"
    in line "c0" c0 & "\n" & line "c1" c1 & "\n" & line "c2" c2 & "\n" & line "c3" c3 & "\n" & line "c4" c4 & "\n" & line "c1 after" c1

Section: Entry
  opening : [Console] Nothing = act
    print-line-uni report
  end
