Chapter: FwdFaceRestoreTest
  cites AI chapter FaceRestore

Section: Fixtures

  frt-fill : Integer, Rgb, List Rgb -> List Rgb
  frt-fill (n) (c) (acc) =
    if n <= 0 then acc
    else frt-fill (n - 1) c (list-push acc c)

  frt-img : Integer, Integer, Integer -> ImageData
  frt-img (w) (h) (v) = image-new w h (frt-fill (w * h) (rgb v v v) [])

  frt-face : ImageData
  frt-face = image-new 64 64 (list-set-at (list-set-at (frt-fill 4096 (rgb 200 120 90) []) (16 * 64 + 16) (rgb 20 20 20)) (16 * 64 + 48) (rgb 20 20 20))

Section: Entry

  opening : [Console] Nothing =
    let grey = frt-img 128 128 128
    in let black = frt-img 128 128 0
    in let face = frt-face
    in let found = fr-detect-faces face 4
    in act
      print-line-uni ("skin tone of 200,120,90 / 128 grey / 50 grey: " & show (fr-is-skin-tone (rgb 200 120 90)) & " " & show (fr-is-skin-tone (rgb 128 128 128)) & " " & show (fr-is-skin-tone (rgb 50 50 50)))
      print-line-uni ("face score of a flat 64 window: grey " & show (fr-face-score grey 0 0 64) & ", black " & show (fr-face-score black 0 0 64) & ", flat skin " & show (fr-face-score (image-new 64 64 (frt-fill 4096 (rgb 200 120 90) [])) 0 0 64) & ", skin with eyes " & show (fr-face-score face 0 0 64))
      print-line-uni ("flat grey 128x128: candidates " & show (list-length (fr-scan-regions grey 0 [])) & ", detected " & show (list-length (fr-detect-faces grey 4)) & "; flat black detected " & show (list-length (fr-detect-faces black 4)) & "; skin 64x64 with two eyes: detected " & show (list-length found) & ", first " & format-face-box (list-at found 0))
      print-line-uni ("edge distance 0,0 and 5,5 in 10x10: " & show (fr-edge-dist 0 0 10 10) & " " & show (fr-edge-dist 5 5 10 10) & "; alpha at 0 4 8: " & show (fr-blend-alpha 0 700) & " " & show (fr-blend-alpha 4 700) & " " & show (fr-blend-alpha 8 700))
      print-line-uni ("blend black and 200 at 500: " & show ((fr-blend-pixel (rgb 0 0 0) (rgb 200 200 200) 500).cr) & "; crop of a 64 face at 0,0 to 8: " & show ((fr-crop-face face (list-at found 0) 8).img-width) & "; " & format-face-config face-restore-default)
    end
