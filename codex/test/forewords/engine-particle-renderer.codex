Chapter: FwdParticleRendererTest
  cites Engine chapter ParticleRenderer

Section: Fixtures

  prt-bb : Integer, Integer, Integer, Integer -> Billboard
  prt-bb (x) (y) (half) (depth) = Billboard { bb-x = x, bb-y = y, bb-hw = half, bb-hh = half, bb-depth = depth, bb-color = 16777215, bb-alpha = 1000 }

  prt-depths : List Billboard, Integer, Text -> Text
  prt-depths (bs) (i) (acc) =
    if i >= list-length bs then acc
    else prt-depths bs (i + 1) (acc & (if i == 0 then "" else " ") & show ((list-at bs i).bb-depth))

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("blend white over black at 500: " & show (pr-alpha-blend 0 16777215 500) & ", at 1000: " & show (pr-alpha-blend 0 16777215 1000) & ", at 0: " & show (pr-alpha-blend 255 16777215 0))
    print-line-uni ("depth sort 10 30 20: " & prt-depths (pr-sort-depth [prt-bb 0 0 1 10, prt-bb 0 0 1 30, prt-bb 0 0 1 20] 3) 0 "")
    print-line-uni ("billboard at 2,2 half 1 on 5x5: " & show (fb-count-color (pr-draw-billboard (prt-bb 2 2 1 0) (fb-new 5 5 0)) 16777215) & " pixels; at 0,0: " & show (fb-count-color (pr-draw-billboard (prt-bb 0 0 1 0) (fb-new 5 5 0)) 16777215))
    print-line-uni (format-billboard (prt-bb 2 2 1 0))
  end
