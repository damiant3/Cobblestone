Chapter: AiActivationRange
  cites Foreword chapter Console
  cites AI chapter Activation

 The chapter is fixed point at scale 1000, so every "true" figure below is
 the real value times 1000, to three figures: sigmoid(2)=0.881, tanh(2)=0.964,
 exp(-3)=0.0498, and so on.

 `ai-activation` already exists and its entire expected output is
 "AI/Activation OK". It names no activation function and calls none, so it
 could not distinguish a working sigmoid from one that answers a negative
 number. This asks the chapter for its answers.

 Every function here was a Taylor series with no range reduction and a guard
 far outside the radius where the series holds. What that produces is not a
 loss of precision but a change of SHAPE: the sigmoid polynomial's derivative
 is 1/4 - z^2/16, zero at z=2, so it turned over and descended through zero,
 and the exponential's is 1 + z, zero at z=-1, so it turned and rose. The
 rows chosen are past those turning points, where a correct answer and the
 old one disagree in DIRECTION and not merely in magnitude.

Section: Body

  r : Text, Integer, Integer, Text -> Text
  r (what) (x) (got) (want) =
    "  " & what & " " & show x & " = " & show got & "  true " & want

  mono : Integer, Integer, Integer, Integer -> Integer
  mono (i) (n) (prev) (acc) =
    if i > n then acc
    else let v = act-sigmoid-val (i * 1000)
    in mono (i + 1) n v (if v >= prev then acc + 1 else acc)

  mono-exp : Integer, Integer, Integer, Integer -> Integer
  mono-exp (i) (n) (prev) (acc) =
    if i > n then acc
    else let v = act-exp-approx (i * 1000)
    in mono-exp (i + 1) n v (if v >= prev then acc + 1 else acc)

Section: Report

  opening : [Console] Nothing = act
    print-line-uni "sigmoid, which must rise and stay inside (0, 1000):"
    print-line-uni (r "sigmoid" 0 (act-sigmoid-val 0) "500 exact, and the control: no error can move it")
    print-line-uni (r "sigmoid" 2000 (act-sigmoid-val 2000) "881")
    print-line-uni (r "sigmoid" 3000 (act-sigmoid-val 3000) "953")
    print-line-uni (r "sigmoid" 5000 (act-sigmoid-val 5000) "993")
    print-line-uni (r "sigmoid" (0 - 3000) (act-sigmoid-val (0 - 3000)) "47")
    print-line-uni ""
    print-line-uni "no cliff where the old guard sat, at 6000:"
    print-line-uni (r "sigmoid" 5999 (act-sigmoid-val 5999) "998")
    print-line-uni (r "sigmoid" 6001 (act-sigmoid-val 6001) "998")
    print-line-uni ""
    print-line-uni "tanh, which must rise and stay inside (-1000, 1000):"
    print-line-uni (r "tanh" 1000 (act-tanh-val 1000) "762")
    print-line-uni (r "tanh" 2000 (act-tanh-val 2000) "964")
    print-line-uni (r "tanh" 3000 (act-tanh-val 3000) "995")
    print-line-uni (r "tanh" (0 - 2000) (act-tanh-val (0 - 2000)) "-964")
    print-line-uni ""
    print-line-uni "exp on NEGATIVE arguments, which is the only side softmax ever"
    print-line-uni "asks for, because it shifts by the maximum first:"
    print-line-uni (r "exp" 0 (act-exp-approx 0) "1000 exact, the control")
    print-line-uni (r "exp" (0 - 1000) (act-exp-approx (0 - 1000)) "368")
    print-line-uni (r "exp" (0 - 2000) (act-exp-approx (0 - 2000)) "135")
    print-line-uni (r "exp" (0 - 3000) (act-exp-approx (0 - 3000)) "50")
    print-line-uni ""
    print-line-uni "gelu, which asks the sigmoid for 1.702x and so reaches the old"
    print-line-uni "broken region sooner than the sigmoid itself did:"
    print-line-uni (r "gelu" 2000 (act-gelu-val 2000) "1955")
    print-line-uni (r "gelu" 3000 (act-gelu-val 3000) "2996")
    print-line-uni ""
    print-line-uni "monotonicity, counted rather than eyeballed. Both were false"
    print-line-uni "before: the sigmoid turned over at z=2 and exp at z=-1."
    print-line-uni ("  sigmoid non-decreasing over z=0..12: " & show (mono 0 12 (0 - 1) 0) & " of 13")
    print-line-uni ("  exp non-decreasing over z=0..12:     " & show (mono-exp 0 12 (0 - 1) 0) & " of 13")
  end

