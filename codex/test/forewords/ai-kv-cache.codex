Chapter: FwdKvCacheTest
  cites AI chapter KvCache

Section: Fixtures

  kvt-join : List Integer, Integer, Text -> Text
  kvt-join (xs) (i) (acc) =
    if i >= list-length xs then acc
    else kvt-join xs (i + 1) (acc & (if i == 0 then "" else " ") & show (list-at xs i))

  kvt-show : KvCache -> Text
  kvt-show (c) =
    "len " & show (kv-cache-length c) & " keys [" & kvt-join (kv-cache-keys c) 0 "" & "] values [" & kvt-join (kv-cache-values c) 0 "" & "] full " & (if kv-cache-is-full c then "yes" else "no")

Section: Entry

  opening : [Console] Nothing =
    let c0 = kv-cache-new 2 2
    in let c1 = kv-cache-append-one c0 [1, 2] [10, 20]
    in let c2 = kv-cache-append-one c1 [3, 4] [30, 40]
    in let c3 = kv-cache-append-one c2 [5, 6] [50, 60]
    in let l0 = kv-cache-layer-new 3 2 4
    in let l1 = kv-cache-layer-set l0 1 c1
    in let set-len = kv-cache-length (kv-cache-layer-get l1 1)
    in let l2 = kv-cache-layer-clear l1
    in act
      print-line-uni ("new: " & kvt-show c0 & ", dim " & show (kv-cache-dim c0))
      print-line-uni ("one: " & kvt-show c1)
      print-line-uni ("two: " & kvt-show c2)
      print-line-uni ("evict: " & kvt-show c3)
      print-line-uni ("cleared: " & kvt-show (kv-cache-clear c3))
      print-line-uni ("layers " & show (l1.kvcl-num-layers) & ": layer 1 len after set " & show set-len & ", layer 0 len " & show (kv-cache-length (kv-cache-layer-get l1 0)))
      print-line-uni ("layer clear: layer 1 len " & show (kv-cache-length (kv-cache-layer-get l2 1)) & "; the set layer read again " & show (kv-cache-length (kv-cache-layer-get l1 1)) & "; the new layer read again " & show (kv-cache-length (kv-cache-layer-get l0 1)))
    end
