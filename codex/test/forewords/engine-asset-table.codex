Chapter: FwdAssetTableTest
  cites Engine chapter AssetTable

Section: Fixtures

  att-tbl : AssetTable
  att-tbl = at-add-material (at-add-texture (at-add-mesh (at-add-mesh at-new "cube" (mesh-new [] [])) "ball" (mesh-new [] [])) "brick" (etx-new 4 2 7)) "stone" emat-default

  att-found : Maybe AssetEntry -> Text
  att-found (m) =
    when m
      is None -> "none"
      is Just (e) -> att-kind (e.ae-kind) & " " & show (e.ae-id)

  att-kind : AssetKind -> Text
  att-kind (k) = when k
    is AssetMesh -> "mesh"
    is AssetTexture -> "texture"
    is AssetMaterial -> "material"
    is AssetSound -> "sound"

  att-some : Boolean -> Text
  att-some (b) = if b then "some" else "none"

Section: Entry

  opening : [Console] Nothing =
    let t = att-tbl
    in act
      print-line-uni (format-asset-table t & ", total " & show (at-total-count t) & ", entries " & show (list-length (t.at-entries)))
      print-line-uni ("find cube " & att-found (at-find-by-name t "cube") & ", ball " & att-found (at-find-by-name t "ball") & ", brick " & att-found (at-find-by-name t "brick") & ", stone " & att-found (at-find-by-name t "stone") & ", nope " & att-found (at-find-by-name t "nope"))
      print-line-uni ("mesh 1 " & att-some (when at-get-mesh t 1
        is Just (m) -> True
        is None -> False) & ", mesh 2 " & att-some (when at-get-mesh t 2
        is Just (m) -> True
        is None -> False) & ", material -1 " & att-some (when at-get-material t (0 - 1)
        is Just (m) -> True
        is None -> False))
      print-line-uni ("texture 0 width " & (when at-get-texture t 0
        is Just (x) -> show (x.etx-width)
        is None -> "none") & ", " & format-asset-table at-new)
    end
