Chapter: FwdWaterTest
  cites Engine chapter Water

Section: Fixtures

  wtt-one : WaterConfig
  wtt-one = WaterConfig { wc-grid-size = 3, wc-spacing = 200, wc-base-y = 100, wc-shallow-color = rgb 100 180 220, wc-deep-color = rgb 20 60 100, wc-depth-range = 3000, wc-waves = [WaveParams { wv-amplitude = 1000, wv-frequency = 1000, wv-speed = 0, wv-dir-x = 1000, wv-dir-z = 0 }], wc-wave-count = 1, wc-spec-power = 32 }

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("sin approx at 0 1570 3141 4712 6283: " & show (water-sin-approx 0) & " " & show (water-sin-approx 1570) & " " & show (water-sin-approx 3141) & " " & show (water-sin-approx 4712) & " " & show (water-sin-approx 6283))
    print-line-uni ("imod -1 6283: " & show (water-imod (0 - 1) 6283) & ", by 0: " & show (water-imod 5 0))
    print-line-uni ("one wave base 100 at x 0 1570 3141: " & show (water-height wtt-one 0 0 0) & " " & show (water-height wtt-one 1570 0 0) & " " & show (water-height wtt-one 3141 0 0))
    print-line-uni ("color at depth 0 1500 3000 9000: " & show (water-color-at-depth wc-default 0) & " " & show (water-color-at-depth wc-default 1500) & " " & show (water-color-at-depth wc-default 3000) & " " & show (water-color-at-depth wc-default 9000))
    print-line-uni (format-water wc-default)
  end
