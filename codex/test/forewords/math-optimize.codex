Chapter: FwdOptimizeTest
  cites Math chapter Optimize

Section: Fixtures

  otq-quad : Integer -> Integer
  otq-quad (x) = (x - 3000) * (x - 3000) / 1000

  otq-bowl : List Integer -> Integer
  otq-bowl (p) = (list-at p 0 - 1000) * (list-at p 0 - 1000) / 1000 + (list-at p 1 - 2000) * (list-at p 1 - 2000) / 1000

  otq-within : Integer, Integer, Integer -> Text
  otq-within (v) (target) (tol) = if opt-abs (v - target) <= tol then "yes" else "no"

  otq-start : List Integer
  otq-start = [5000, 0 - 3000]

Section: Entry

  opening : [Console] Nothing =
    let gd = opt-gradient-descent otq-quad 0 100 200
    in let gs = opt-golden-section otq-quad 0 10000 100
    in let mv = opt-gradient-descent-mv otq-bowl otq-start 100 200
    in let nm = opt-nelder-mead otq-bowl (NmSimplex { nm-p0 = [0, 0], nm-p1 = [500, 0], nm-p2 = [0, 500] }) 200
    in act
      print-line-uni ("numerical grad of quad at 0: " & show (opt-numerical-grad otq-quad 0) & ", at 3000: " & show (opt-numerical-grad otq-quad 3000))
      print-line-uni ("gradient descent from 0 within 250 of 3000: " & otq-within gd 3000 250)
      print-line-uni ("golden section on 0..10000 within 50 of 3000: " & otq-within gs 3000 50)
      print-line-uni ("bowl gradient at 5000,-3000: " & show (list-at (opt-mv-grad otq-bowl otq-start) 0) & " " & show (list-at (opt-mv-grad otq-bowl otq-start) 1))
      print-line-uni ("mv descent from 5000,-3000 ends at " & show (list-at mv 0) & "," & show (list-at mv 1))
      print-line-uni ("nelder-mead within 100 of 1000,2000: " & otq-within (list-at nm 0) 1000 100 & " " & otq-within (list-at nm 1) 2000 100)
      print-line-uni ("centroid " & show (list-at (nm-centroid [0, 10] [4, 20]) 0) & "," & show (list-at (nm-centroid [0, 10] [4, 20]) 1) & ", reflect " & show (list-at (nm-reflect [2, 15] [0, 0]) 0) & "," & show (list-at (nm-reflect [2, 15] [0, 0]) 1))
    end
