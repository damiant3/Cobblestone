Chapter: FwdResampleTest
  cites Signal chapter Resample

Section: Fixtures

  rst-join : List Integer, Integer, Text -> Text
  rst-join (xs) (i) (acc) =
    if i >= list-length xs then acc
    else rst-join xs (i + 1) (acc & (if i == 0 then "" else " ") & show (list-at xs i))

  rst-abs : Integer -> Integer
  rst-abs (x) = if x < 0 then 0 - x else x

  rst-max-err : List Integer, List Integer, Integer, Integer -> Integer
  rst-max-err (a) (b) (i) (acc) =
    if i >= list-length a then acc
    else let e = rst-abs (list-at a i - list-at b i)
    in rst-max-err a b (i + 1) (if e > acc then e else acc)

  rst-wave : List Integer
  rst-wave = [0, 500, 1000, 500, 0, -500, -1000, -500, 0, 500, 1000, 500]

Section: Entry

  opening : [Console] Nothing =
    let up = resample-linear [0, 100, 200, 300] (Hertz 8000) (Hertz 16000)
    in let down = resample-linear [0, 100, 200, 300, 400, 500] (Kilohertz 16) (Kilohertz 8)
    in let same = resample-sinc rst-wave (Hertz 1000) (Hertz 1000) 4
    in act
      print-line-uni ("linear up: " & rst-join up 0 "")
      print-line-uni ("linear down: " & rst-join down 0 "")
      print-line-uni ("ratio 441 at 44100 -> 48000: " & show (resample-ratio 441 44100 48000))
      print-line-uni ("sinc 1:1 length " & show (list-length same) & ", max error within 20: " & (if rst-max-err rst-wave same 0 0 <= 20 then "yes" else "no"))
    end
