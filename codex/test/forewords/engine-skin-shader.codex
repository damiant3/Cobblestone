Chapter: FwdSkinShaderTest
  cites Engine chapter SkinShader

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("diffuse at 1000 0 -500: " & show (skin-diffuse 1000 0 skm-default) & " " & show (skin-diffuse 0 0 skm-default) & " " & show (skin-diffuse (0 - 500) 0 skm-default))
    print-line-uni ("diffuse curvature 0 and 900 at 0: " & show (skin-diffuse 0 0 skm-default) & " " & show (skin-diffuse 0 900 skm-default))
    print-line-uni ("diffuse at 0 for curvature 0 500 1000: " & show (skin-diffuse 0 0 skm-default) & " " & show (skin-diffuse 0 500 skm-default) & " " & show (skin-diffuse 0 1000 skm-default))
    print-line-uni ("diffuse at 1000 for curvature 0 and 1000: " & show (skin-diffuse 1000 0 skm-default) & " " & show (skin-diffuse 1000 1000 skm-default))
    print-line-uni ("diffuse at -500 for curvature 0 and 1000: " & show (skin-diffuse (0 - 500) 0 skm-default) & " " & show (skin-diffuse (0 - 500) 1000 skm-default))
    print-line-uni ("fresnel at 1000 500 0: " & show (skin-fresnel 1000) & " " & show (skin-fresnel 500) & " " & show (skin-fresnel 0))
    print-line-uni ("specular h 1000 l 1000: " & show (skin-specular 1000 1000 skm-default) & ", h 900: " & show (skin-specular 900 1000 skm-default) & ", l 0: " & show (skin-specular 1000 0 skm-default))
    print-line-uni ("wetness: dry " & show (skin-wetness-boost 500 99 skm-default) & ", wet " & show (skin-wetness-boost 500 99 skm-wet) & ", wet clamps " & show (skin-wetness-boost 900 1000 skm-wet))
    print-line-uni ("shade full light: " & show (skin-shade 1000 1000 1000 0 skm-default))
    print-line-uni ("pow 900^0 " & show (skin-pow-approx 900 0) & ", 900^2 " & show (skin-pow-approx 900 2) & "; " & format-skin-material skm-default)
  end
