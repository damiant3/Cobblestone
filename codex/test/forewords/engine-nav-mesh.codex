Chapter: FwdNavMeshTest
  cites Engine chapter NavMesh

Section: Fixtures

  nvt-mesh : NavMeshData
  nvt-mesh = nm-add-poly (nm-add-poly (nm-add-poly (nm-add-poly (nm-add-poly nm-new 0 0 0 1 [1, 2]) 1000 0 0 100 [0, 3]) 0 0 5000 1 [0, 3]) 2000 0 0 1 [1, 2]) 9000 0 0 1 []

  nvt-nodes : NavPath -> Text
  nvt-nodes (p) = nvt-join (p.nav-nodes) 0 ""

  nvt-join : List Integer, Integer, Text -> Text
  nvt-join (xs) (i) (acc) =
    if i >= list-length xs then acc
    else nvt-join xs (i + 1) (acc & (if i == 0 then "" else " ") & show (list-at xs i))

Section: Entry

  opening : [Console] Nothing =
    let m = nvt-mesh
    in let p03 = nm-find-path m 0 3
    in act
      print-line-uni (format-nav-mesh m & ", closest to 1900,0,100: " & show (nm-closest-poly m 1900 0 100) & ", on an empty mesh: " & show (nm-closest-poly nm-new 0 0 0))
      print-line-uni ("0 to 3 (poly 1 costs 100, poly 2 costs 1): " & format-nav-path p03 & " [" & nvt-nodes p03 & "]")
      print-line-uni ("0 to isolated 4: " & format-nav-path (nm-find-path m 0 4) & "; 2 to 2: " & format-nav-path (nm-find-path m 2 2) & "; from -1: " & format-nav-path (nm-find-path m (0 - 1) 3))
      print-line-uni ("heuristic 1 to 3: " & show (nav-heuristic (nm-poly-at m 1) (nm-poly-at m 3)) & ", 2 to 3: " & show (nav-heuristic (nm-poly-at m 2) (nm-poly-at m 3)))
    end
