Chapter: CceTier2Test
  cites Foreword chapter CCE

Section: Helpers
  test-cjk-roundtrip : Text
  test-cjk-roundtrip =
    let u-cjk = 20013
    in let cce = from-unicode u-cjk
    in let back = to-unicode cce
    in if back == u-cjk then "CJK-roundtrip OK" else "CJK-roundtrip FAIL"

  test-hangul-roundtrip : Text
  test-hangul-roundtrip =
    let u-hangul = 44032
    in let cce = from-unicode u-hangul
    in let back = to-unicode cce
    in if back == u-hangul then "Hangul-roundtrip OK" else "Hangul-roundtrip FAIL"

  test-kana-roundtrip : Text
  test-kana-roundtrip =
    let u-hira = 12354
    in let cce = from-unicode u-hira
    in let back = to-unicode cce
    in if back == u-hira then "Kana-roundtrip OK" else "Kana-roundtrip FAIL"

  test-emoji-roundtrip : Text
  test-emoji-roundtrip =
    let u-emoji = 128512
    in let cce = from-unicode u-emoji
    in let back = to-unicode cce
    in if back == u-emoji then "Emoji-roundtrip OK" else "Emoji-roundtrip FAIL"

 43276 is 2176 plus the 41060 codes of the ten earlier tier-2 blocks plus
 0x28: the Dingbats block is appended, so no earlier code moves.

  test-dingbats : Text
  test-dingbats =
    let cce = from-unicode 10024
    in let last = from-unicode 10175
    in let past = from-unicode 10176
    in if cce /= 43276 then "dingbats FAIL code " & show cce
    else if to-unicode cce /= 10024 then "dingbats FAIL roundtrip"
    else if to-unicode last /= 10175 then "dingbats FAIL last"
    else if past >= 0 then "dingbats FAIL past"
    else "dingbats OK"

  test-encode-len : Text
  test-encode-len =
    let u-cjk = 20013
    in let cce = from-unicode u-cjk
    in let enc-len = cce-encode-length (__narrow cce)
    in if enc-len == 2 then "encode-len OK" else "encode-len FAIL"

  test-classify-cjk : Text
  test-classify-cjk =
    let cce = from-unicode 20013
    in if cce-is-cjk cce then "is-CJK OK" else "is-CJK FAIL"

  test-unmapped : Text
  test-unmapped =
    let cce = from-unicode 1114111
    in if cce < 0 then "unmapped OK" else "unmapped FAIL"

Section: Entry
  opening : [Console] Nothing = act
    print-line-uni test-cjk-roundtrip
    print-line-uni test-hangul-roundtrip
    print-line-uni test-kana-roundtrip
    print-line-uni test-emoji-roundtrip
    print-line-uni test-dingbats
    print-line-uni test-encode-len
    print-line-uni test-classify-cjk
    print-line-uni test-unmapped
  end
