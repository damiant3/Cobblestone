Chapter: FwdDebugDrawTest
  cites Engine chapter DebugDraw

Section: Fixtures

  ddt-p : DbgVert -> Text
  ddt-p (v) = "(" & show (v.dbv-x) & "," & show (v.dbv-y) & ")"

  ddt-box : MeshBounds
  ddt-box = MeshBounds { mb-min-x = 0 - 1, mb-min-y = 0 - 1, mb-min-z = 0, mb-max-x = 1, mb-max-y = 1, mb-max-z = 1 }

Section: Entry

  opening : [Console] Nothing =
    let axes = dbg-draw-axes (fb-new 21 21 0) mat4-identity 10 10 1
    in let box = dbg-draw-aabb (fb-new 21 21 0) ddt-box mat4-identity 10 10 7
    in act
      print-line-uni ("project 0,0,0 " & ddt-p (dbg-project-vert (vertex-pos 0 0 0) mat4-identity 10 10) & ", 1,1,0 " & ddt-p (dbg-project-vert (vertex-pos 1 1 0) mat4-identity 10 10) & ", -1,0,0 " & ddt-p (dbg-project-vert (vertex-pos (0 - 1) 0 0) mat4-identity 10 10))
      print-line-uni ("axes: red " & show (fb-count-color axes 16711680) & ", green " & show (fb-count-color axes 65280) & ", blue " & show (fb-count-color axes 26367))
      print-line-uni ("box corners " & show (list-length (dbg-aabb-corners ddt-box)) & ", box pixels " & show (fb-count-color box 7))
      print-line-uni (format-stats est-zero)
    end
