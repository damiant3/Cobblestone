Chapter: FwdStateTest
  cites Foreword chapter State

Section: Body

  bump : Integer -> [State] Integer
  bump (k) = act
    state-set (state-get * 10 + k)
    state-get * 2 + k
  end

  run-with : Integer, Integer -> [Console] Integer
  run-with (seed) (k) = act
    with State (bump k)
      state-get (resume) = resume seed
      state-set (v) (resume) = print-line-uni ("set " & show v)
  end

Section: Entry
  opening : [Console] Nothing = act
    print-line-uni ("state " & show (run-with 20 2))
    print-line-uni ("state " & show (run-with 7 5))
  end
