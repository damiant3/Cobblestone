Chapter: FwdConv2dTest
  cites AI chapter Conv2d

Section: Entry
  opening : [Console] Nothing = act
    let p = conv2d-params 3 8 3 1 1
    in let c = gpu-cmd-conv2d 100 50 8 16
    in let s = gpu-cmd-silu 32
    in act
      print-line-uni (format-conv2d p)
      print-line-uni ("conv2d rows=" & show (c.gpu-rows-a) & " cols=" & show (c.gpu-cols-a) & " out=" & show (c.gpu-offset-out))
      print-line-uni ("silu op=" & show (s.gpu-op) & " out=" & show (s.gpu-offset-out))
    end
  end
