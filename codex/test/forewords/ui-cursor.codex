Chapter: FwdCursorTest
  cites UI chapter Cursor

Section: Fixtures

  cut-drawn : CursorState -> Integer
  cut-drawn (c) = fb-count-color (cursor-render (fb-new 20 20 0) c 9) 9

Section: Entry

  opening : [Console] Nothing =
    let arrow = cursor-at 2 2
    in let hand = cursor-set-style (cursor-at 10 10) CsHand
    in let cross = cursor-set-style (cursor-at 10 10) CsCrosshair
    in act
      print-line-uni ("arrow at 2,2: " & show (cut-drawn arrow) & " pixels; hidden: " & show (cut-drawn (cursor-hide arrow)) & "; shown again: " & show (cut-drawn (cursor-show (cursor-hide arrow))))
      print-line-uni ("hand at 10,10: hotspot " & show (hand.cur-hot-x) & "," & show (hand.cur-hot-y) & ", " & show (cut-drawn hand) & " pixels")
      print-line-uni ("crosshair at 10,10: " & show (cut-drawn cross) & " pixels, centre " & show (fb-get (cursor-render (fb-new 20 20 0) cross 9) 10 10))
      print-line-uni ("style none: visible " & (if (cursor-set-style arrow CsNone).cur-visible then "T" else "F") & ", " & show (cut-drawn (cursor-set-style arrow CsNone)) & " pixels")
    print-line-uni ("style none then arrow: " & show (cut-drawn (cursor-set-style (cursor-set-style arrow CsNone) CsArrow)) & " pixels; hidden then none then arrow: " & show (cut-drawn (cursor-set-style (cursor-set-style (cursor-hide arrow) CsNone) CsArrow)) & " pixels")
      print-line-uni (format-cursor (cursor-move (cursor-set-style cursor-new CsHand) 3 4) & ", " & cursor-style-name CsResizeV)
    end
