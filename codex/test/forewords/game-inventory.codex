Chapter: FwdInventoryTest
  cites Game chapter Inventory

Section: Fixtures

  ivt-b : Boolean -> Text
  ivt-b (b) = if b then "T" else "F"

Section: Entry

  opening : [Console] Nothing =
    let over = inv-add (inv-add (inv-new 4) 1 30 40) 1 20 40
    in let over-count = inv-count over 1
    in let over-used = inv-used-slots over
    in let two = inv-add (inv-add (inv-new 4) 1 40 40) 1 5 40
    in let two-count = inv-count two 1
    in let two-used = inv-used-slots two
    in let taken = inv-remove two 1 42
    in let big = inv-add (inv-new 4) 7 50 40
    in let full = inv-add (inv-add (inv-new 1) 1 10 10) 2 5 10
    in let gear = inv-equip (inv-equip (inv-equip (inv-new 4) SlotHead 100) SlotHead 101) SlotRing 5
    in let gear-count = gear.inv-equip-count
    in let gear-len = list-length (gear.inv-equipped)
    in let bare = inv-unequip (inv-equip (inv-new 4) SlotHead 100) SlotHead
    in act
      print-line-uni ("30 then 20 of max 40: count " & show over-count & ", slots " & show over-used)
      print-line-uni ("40 then 5 of max 40: count " & show two-count & ", slots " & show two-used & "; remove 42: count " & show (inv-count taken 1) & ", slots " & show (inv-used-slots taken))
      print-line-uni ("50 into an empty slot of max 40: count " & show (inv-count big 7))
      print-line-uni ("capacity 1, second item: has 2 " & ivt-b (inv-has full 2) & ", slots " & show (inv-used-slots full) & "; remove absent: count 1 " & show (inv-count (inv-remove full 9 1) 1))
      print-line-uni ("equip head twice and ring: count " & show gear-count & ", entries " & show gear-len & "; equip head then unequip it: " & show (bare.inv-equip-count))
    end
