Chapter: FwdTimeTest
  cites Foreword chapter Time

Section: Body

  elapsed : Integer -> [Time] Integer
  elapsed (start) = now - start

  at-clock : Integer, Integer -> Integer
  at-clock (clock) (start) = act
    with Time (elapsed start)
      now (resume) = resume clock
  end

Section: Entry
  opening : [Console] Nothing = act
    print-line-uni ("elapsed " & show (at-clock 1500 1000))
    print-line-uni ("elapsed " & show (at-clock 42 50))
  end
