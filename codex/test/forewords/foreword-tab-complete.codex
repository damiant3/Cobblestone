Chapter: FwdTabCompleteTest
  cites Foreword chapter TabComplete

Section: Fixtures

  tct-cands : List Text
  tct-cands = ["help", "hello", "history", "exit"]

  tct-line : Text -> Text
  tct-line (p) =
    let c = tab-complete p tct-cands
    in "[" & p & "] count " & show (c.comp-count) & " prefix [" & c.comp-prefix & "] shown [" & format-completion c & "]"

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (tct-line "he")
    print-line-uni (tct-line "h")
    print-line-uni (tct-line "hi")
    print-line-uni (tct-line "zz")
    print-line-uni (tct-line "")
    print-line-uni ("lcp flights: [" & tab-common-prefix ["flight", "flame", "flask"] & "]")
    print-line-uni ("lcp one: [" & tab-common-prefix ["solo"] & "] none: [" & tab-common-prefix [] & "]")
  end
