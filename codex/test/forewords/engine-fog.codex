Chapter: FwdFogTest
  cites Engine chapter Fog

Section: Entry

  opening : [Console] Nothing =
    let blue = rgb 0 0 255
    in let lin = fog-linear 100 500 blue
    in let ex = fog-exp 1000 blue
    in let ex2 = fog-exp 2000 blue
    in let sq = FogConfig { fog-mode = FogExponentialSq 1000, fog-color = blue, fog-enabled = True }
    in let hi = fog-height 800 0 100 blue
    in act
      print-line-uni ("linear 100..500 at 50 300 600: " & show (fog-factor lin 50 0) & " " & show (fog-factor lin 300 0) & " " & show (fog-factor lin 600 0))
      print-line-uni ("exp density 1000 at 100 500: " & show (fog-factor ex 100 0) & " " & show (fog-factor ex 500 0) & "; density 2000 at 250 500: " & show (fog-factor ex2 250 0) & " " & show (fog-factor ex2 500 0))
      print-line-uni ("exp-sq density 1000 at 500: " & show (fog-factor sq 500 0))
      print-line-uni ("exp density 1000 past one unit at 3000 7000 20000: " & show (fog-factor ex 3000 0) & " " & show (fog-factor ex 7000 0) & " " & show (fog-factor ex 20000 0))
      print-line-uni ("height 800 floor 0 ceiling 100 at y 150 25 -5: " & show (fog-factor hi 0 150) & " " & show (fog-factor hi 0 25) & " " & show (fog-factor hi 0 (0 - 5)))
      print-line-uni ("disabled: " & show (fog-factor fog-none 999999 0) & " " & format-fog fog-none & ", enabled " & format-fog lin)
      print-line-uni ("blend red with blue at 500: " & show (fog-blend 16711680 blue 500) & ", at 0: " & show (fog-blend 16711680 blue 0) & ", at 1000: " & show (fog-blend 16711680 blue 1000))
    end
