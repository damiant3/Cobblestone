Chapter: FwdSplinePathTest
  cites Engine chapter SplinePath

Section: Fixtures

  spt-line : Boolean -> Spline3D
  spt-line (closed) = spline-add (spline-add (spline-add (spline-add (spline-new closed) (spl-point-new 0 0 0)) (spl-point-new 1000 0 0)) (spl-point-new 2000 0 0)) (spl-point-new 3000 0 0)

  spt-p : SplinePoint -> Text
  spt-p (p) = "(" & show (p.sp-x) & "," & show (p.sp-y) & "," & show (p.sp-z) & ")"

  spt-ticks : SplineWalker, Integer -> SplineWalker
  spt-ticks (w) (n) =
    if n <= 0 then w
    else spt-ticks (walker-tick w 1000) (n - 1)

Section: Entry

  opening : [Console] Nothing =
    let open = spt-line False
    in let w5 = spt-ticks (walker-new (spt-line False) 250) 5
    in let c5 = spt-ticks (walker-new (spt-line True) 250) 5
    in act
      print-line-uni (format-spline open & ", " & format-spline (spt-line True))
      print-line-uni ("eval at 0 500 1000: " & spt-p (spl-eval open 0) & " " & spt-p (spl-eval open 500) & " " & spt-p (spl-eval open 1000))
      print-line-uni ("open ends at 100 and 900: " & spt-p (spl-eval open 100) & " " & spt-p (spl-eval open 900) & "; closed at 100: " & spt-p (spl-eval (spt-line True) 100))
      print-line-uni ("catmull-rom 0 1000 2000 3000 at 500: " & spt-p (spl-catmull-rom (spl-point-new 0 0 0) (spl-point-new 1000 0 0) (spl-point-new 2000 0 0) (spl-point-new 3000 0 0) 500))
      print-line-uni ("arc length over 10 steps: " & show (spline-arc-length open 10))
      print-line-uni ("one point: " & spt-p (spl-eval (spline-add (spline-new False) (spl-point-new 7 8 9)) 600) & ", none: " & spt-p (spl-eval (spline-new False) 600))
      print-line-uni ("open walker 5 ticks: t " & show (w5.sw-t) & (if w5.sw-active then " active" else " stopped") & "; closed: t " & show (c5.sw-t) & (if c5.sw-active then " active" else " stopped"))
      print-line-uni ("wrap -1 in 4: " & show (spl-wrap (0 - 1) 4) & ", 5 in 4: " & show (spl-wrap 5 4))
    end
