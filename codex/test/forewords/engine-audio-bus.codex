Chapter: FwdAudioBusTest
  cites Engine chapter AudioBus

Section: Fixtures

  abt-area : AudioArea
  abt-area = AudioArea { aa-bus-idx = 2, aa-min-x = 0, aa-min-y = 0, aa-min-z = 0, aa-max-x = 10, aa-max-y = 10, aa-max-z = 10, aa-reverb = 300, aa-priority = 1 }

Section: Entry

  opening : [Console] Nothing =
    let base = bus-default-layout
    in let quiet = bus-set-volume bus-default-layout 0 500
    in let hushed = bus-mute bus-default-layout 0 True
    in let fx = bus-add-fx (bus-add-fx bus-default-layout 1 (FxReverb 500 300)) 1 (FxDelay 250 400)
    in let self-parent = bus-add bus-default-layout "Self" 500 (base.bl-count)
    in let later-parent = bus-add bus-default-layout "Later" 500 (base.bl-count + 3)
    in let child = bus-add bus-default-layout "Child" 500 2
    in act
      print-line-uni (format-bus-layout base & ": music " & show (bus-effective-volume base 2) & ", ambient " & show (bus-effective-volume base 4) & ", master " & show (bus-effective-volume base 0))
      print-line-uni ("master at 500: music " & show (bus-effective-volume quiet 2) & ", voice " & show (bus-effective-volume quiet 3))
      print-line-uni ("master muted: sfx " & show (bus-effective-volume hushed 1) & ", " & format-bus (list-at (hushed.bl-buses) 0))
      print-line-uni ("find Voice " & show (bus-find-by-name base "Voice") & ", Nope " & show (bus-find-by-name base "Nope") & ", volume of bus 9: " & show (bus-effective-volume base 9) & ", set bus 9 count " & show ((bus-set-volume base 9 1).bl-count))
      print-line-uni ("parent not yet a bus: self count " & show (self-parent.bl-count) & " volume " & show (bus-effective-volume self-parent (base.bl-count)) & ", later count " & show (later-parent.bl-count) & "; existing parent: count " & show (child.bl-count) & " volume " & show (bus-effective-volume child (base.bl-count)))
      print-line-uni ("sfx effects: " & show (list-length ((list-at (fx.bl-buses) 1).ab-effects)))
      print-line-uni ("area at 5,5,5 bus " & show (area-resolve-bus [abt-area] 5 5 5 0 1) & ", at 11,5,5 " & show (area-resolve-bus [abt-area] 11 5 5 0 1) & ", at 10,0,10 " & show (area-resolve-bus [abt-area] 10 0 10 0 1))
    end
