Chapter: E1000ResetWedged
  cites Foreword chapter Maybe
  cites Kernel chapter E1000e
  cites Kernel chapter Pci

Section: Fixtures

  found-dev : PciScanResult -> Maybe PciDevice
  found-dev (scan) = e1000-find scan

Section: Judges

  yn : Boolean -> Text
  yn (b) = if b then "yes" else "no"

  InitSeen = record { present : Boolean, cost : Integer }

  init-seen : PciDevice -> InitSeen
  init-seen (dev) =
    let before = alloc-bytes 0
    in let d = e1000-init dev
    in let after = alloc-bytes 0
    in InitSeen { present = d.e-present, cost = after - before }

Section: Entry

  opening : [Console] Nothing = act
    let scan = pci-scan-bus 0
    in act
      when found-dev scan
        is Just (dev) -> act
          print-line-uni ("candidate found : yes")
          let seen = init-seen dev
          in act
            print-line-uni ("present         : " & yn (seen.present))
            print-line-uni ("refusal under 1K: " & yn (seen.cost < 1024))
          end
        end
        is None -> print-line-uni ("candidate found : no")
    end
  end

