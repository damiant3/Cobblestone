  opening : [Console] Nothing = act
   print-line-uni (show (far-cmp 1) & " " & show (far-cmp 9))
   print-line-uni (show (far-zero 0) & " " & show (far-zero 5))
   print-line-uni (show (far-val 7) & " " & show (far-val 1))
  end
