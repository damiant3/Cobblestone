Section: Parse Tests
  test-parse-font : Text =
    let font = ttf-parse test-font-bytes
    in format-ttf-font font

  test-num-glyphs : Text =
    let font = ttf-parse test-font-bytes
    in "glyphs=" & show (font.tf-num-glyphs)

  test-upem : Text =
    let font = ttf-parse test-font-bytes
    in "upem=" & show (font.tf-head.th-units-per-em)

Section: Cmap Tests
  test-cmap-space : Text =
    let font = ttf-parse test-font-bytes
    in "space=" & show (ttf-cmap-lookup (font.tf-cmap) 32)

  test-cmap-a : Text =
    let font = ttf-parse test-font-bytes
    in "A=" & show (ttf-cmap-lookup (font.tf-cmap) 65)

  test-cmap-missing : Text =
    let font = ttf-parse test-font-bytes
    in "missing=" & show (ttf-cmap-lookup (font.tf-cmap) 90)

Section: Glyph Tests
  test-glyph-a : Text =
    let font = ttf-parse test-font-bytes
    in let g = ttf-glyph-for-char font 65
    in format-ttf-glyph g

  test-glyph-contours : Text =
    let font = ttf-parse test-font-bytes
    in let g = ttf-glyph-for-char font 65
    in let c = list-at (g.tg-contours) 0
    in "points=" & show (list-length (c.tc-points))

  test-glyph-point0 : Text =
    let font = ttf-parse test-font-bytes
    in let g = ttf-glyph-for-char font 65
    in let c = list-at (g.tg-contours) 0
    in let p = list-at (c.tc-points) 0
    in "p0=" & show (p.tp-x) & "," & show (p.tp-y) & " on=" & show (p.tp-on-curve)

  test-glyph-advance : Text =
    let font = ttf-parse test-font-bytes
    in let g = ttf-glyph-for-char font 65
    in "advance=" & show (g.tg-advance)

Section: Rasterizer Tests
  test-render-a : Text =
    let font = ttf-parse test-font-bytes
    in let rg = gr-render-glyph font 65 16
    in "w=" & show (rg.rg-width) & " h=" & show (rg.rg-height)

  test-render-has-pixels : Text =
    let font = ttf-parse test-font-bytes
    in let rg = gr-render-glyph font 65 16
    in let total = rg.rg-width * rg.rg-height
    in let filled = count-nonzero (rg.rg-pixels) 0 0
    in "total=" & show total & " filled=" & show filled

  count-nonzero : List Integer, Integer, Integer -> Integer
  count-nonzero (xs) (i) (acc) =
    if i >= list-length xs then acc
    else if list-at xs i > 0 then count-nonzero xs (i + 1) (acc + 1)
    else count-nonzero xs (i + 1) acc

  test-render-space : Text =
    let font = ttf-parse test-font-bytes
    in let rg = gr-render-glyph font 32 16
    in let filled = count-nonzero (rg.rg-pixels) 0 0
    in "space-filled=" & show filled

Section: Anti-Aliased Tests
  test-render-aa : Text =
    let font = ttf-parse test-font-bytes
    in let rg = gr-render-glyph-aa font 65 16
    in "aa-w=" & show (rg.rg-width) & " aa-h=" & show (rg.rg-height)

  test-aa-has-gray : Text =
    let font = ttf-parse test-font-bytes
    in let rg = gr-render-glyph-aa font 65 16
    in let grays = count-gray (rg.rg-pixels) 0 0
    in "gray-pixels=" & show grays

  count-gray : List Integer, Integer, Integer -> Integer
  count-gray (xs) (i) (acc) =
    if i >= list-length xs then acc
    else let v = list-at xs i
    in if v > 0 then
      if v < 255 then count-gray xs (i + 1) (acc + 1)
      else count-gray xs (i + 1) acc
    else count-gray xs (i + 1) acc

Section: The Cell Is The Box, Not The Em

 `fb-render-glyph` rasterizes into a cell sized from `head.yMax - head.yMin`,
 which for a real face can EXCEED `unitsPerEm`: cmunss is upem 2048 with the
 box running -725 to 1866, so a 32 pixel em needs 41 rows. Until 2026-08-20
 the cell was clamped to `ppem + ppem / 4` and then trimmed back to `ppem`,
 and both cuts came off the bottom of the box, where the descenders are.

 The face embedded above cannot see that, and its inability is the reason
 this section patches it. Its box is 0 to 700 against upem 1024, so the box
 is SMALLER than the em, `full-h` lands under `ppem`, and the clamp and the
 trim are both dead on it: the old code and the new agree. An arm built on
 it would have passed either way.

 So the head is rewritten in the buffer to a box of -300 to 1000, which is
 1300 against an em of 1024, and at ppem 32 that is 41 rows. The old code
 answered 32 there and the new answers 41. `head` sits at byte 228 of this
 face, so `yMin` is at 266 and `yMax` at 270, each big-endian.

  ttf-head-ymin-hi : Integer = 266

  ttf-head-ymax-hi : Integer = 270

  test-tall-box : Text =
    let bytes = test-font-bytes
    in let n = list-length bytes
    in let buf = alloc-bytes n
    in let w = fl-list-to-buf bytes buf 0 n
    in let a = poke-byte buf ttf-head-ymin-hi 254
    in let b = poke-byte buf (ttf-head-ymin-hi + 1) 212
    in let c = poke-byte buf ttf-head-ymax-hi 3
    in let d = poke-byte buf (ttf-head-ymax-hi + 1) 232
    in let font = fb-parse-ttf buf n
    in let g = fb-render-glyph buf font 65 32
    in let rows = if g.rg-width > 0 then list-length (g.rg-pixels) / g.rg-width else 0
    in "tall upem=" & show (font.tf-head.th-units-per-em) & " ymin=" & show (font.tf-head.th-y-min) & " ymax=" & show (font.tf-head.th-y-max) & " height=" & show (g.rg-height) & " rows=" & show rows

 The control the defect cannot move: the face UNPATCHED, whose box fits
 inside its em. `full-h` is 22 at ppem 32, below the em, so the cell floors
 at `ppem` and reads 32 both before this change and after. A row that stays
 still is what proves the arm above is measuring the clamp rather than
 measuring every face.

  test-short-box : Text =
    let bytes = test-font-bytes
    in let n = list-length bytes
    in let buf = alloc-bytes n
    in let w = fl-list-to-buf bytes buf 0 n
    in let font = fb-parse-ttf buf n
    in let g = fb-render-glyph buf font 65 32
    in let rows = if g.rg-width > 0 then list-length (g.rg-pixels) / g.rg-width else 0
    in "short ymax=" & show (font.tf-head.th-y-max) & " height=" & show (g.rg-height) & " rows=" & show rows

 `fl-cap-rows` measures the cap band off the 'H' outline. This face's cmap
 covers 32 to 65, so it has no 'H' at all, which makes this arm a test of
 the FALLBACK and of nothing else: with no 'H' the cap must come back equal
 to the ascent rather than as zero, since a zero would collapse every
 centred band to the top of its box.

 **This arm cannot see the cap path itself**, and no arm here can, because
 the embedded face has no capital to measure. That path is verified against
 the real face instead: parsing `fonts/cc0/cmunss.ttf` on the host gives
 upem 2048, yMax 1866 and an 'H' yMax of 1421, so at ppem 32 the cell is 41
 rows, the baseline is 29 and the cap is 22, and the running desk's Monitor
 pane prints `cell 41   baseline 29   cap 22` from the font handle. Two
 instruments, one answer.

  test-cap-fallback : Text =
    let bytes = test-font-bytes
    in let n = list-length bytes
    in let buf = alloc-bytes n
    in let w = fl-list-to-buf bytes buf 0 n
    in let a = poke-byte buf ttf-head-ymin-hi 254
    in let b = poke-byte buf (ttf-head-ymin-hi + 1) 212
    in let c = poke-byte buf ttf-head-ymax-hi 3
    in let d = poke-byte buf (ttf-head-ymax-hi + 1) 232
    in let font = fb-parse-ttf buf n
    in let cap = fl-cap-rows buf font 32
    in let asc = font.tf-head.th-y-max * 32 / (font.tf-head.th-units-per-em)
    in "cap=" & show cap & " asc=" & show asc & " fell-back=" & (if cap == asc then "yes" else "no")

  opening : [Console] Nothing = act
    print-line-uni test-tall-box
    print-line-uni test-cap-fallback
    print-line-uni test-short-box
    print-line-uni test-parse-font
    print-line-uni test-num-glyphs
    print-line-uni test-upem
    print-line-uni test-cmap-space
    print-line-uni test-cmap-a
    print-line-uni test-cmap-missing
    print-line-uni test-glyph-a
    print-line-uni test-glyph-contours
    print-line-uni test-glyph-point0
    print-line-uni test-glyph-advance
    print-line-uni test-render-a
    print-line-uni test-render-has-pixels
    print-line-uni test-render-space
    print-line-uni test-render-aa
    print-line-uni test-aa-has-gray
  end

