Chapter: ExplicitConstructorReturn
  cites Foreword chapter Console

  Annotated =
    | AnnEmpty : Annotated
    | AnnValue (Integer) : Annotated

  accept : Annotated, Integer -> Integer
  accept (a) (n) = n

  opening : [Console] Nothing = act
    print-line-uni (show (accept AnnEmpty 0))
    print-line-uni (show (accept (AnnValue 7) 7))
  end
