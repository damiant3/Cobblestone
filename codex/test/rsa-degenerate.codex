Section: Helpers

  rd-fill : Integer, Integer -> List Integer
  rd-fill (n) (v) = if n <= 0 then [] else list-push (rd-fill (n - 1) v) v

  rd-one : Integer -> List Integer
  rd-one (n) = list-push (rd-fill (n - 1) 0) 1

  rd-n-minus-1 : List Integer = list-set-at (for b in r-mod -> b) 255 (list-at r-mod 255 - 1)

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("control: openssl 2048-bit signature verifies = " & show (rsa-verify-pkcs1-sha256 r-mod r-exp r-msg r-sig))
    print-line-uni ("signature zero = " & show (rsa-verify-pkcs1-sha256 r-mod r-exp r-msg (rd-fill 256 0)))
    print-line-uni ("signature one = " & show (rsa-verify-pkcs1-sha256 r-mod r-exp r-msg (rd-one 256)))
    print-line-uni ("signature n - 1 = " & show (rsa-verify-pkcs1-sha256 r-mod r-exp r-msg rd-n-minus-1))
    print-line-uni ("signature equal to n = " & show (rsa-verify-pkcs1-sha256 r-mod r-exp r-msg r-mod))
    print-line-uni ("signature all ones (above n) = " & show (rsa-verify-pkcs1-sha256 r-mod r-exp r-msg (rd-fill 256 255)))
    print-line-uni ("exponent zero = " & show (rsa-verify-pkcs1-sha256 r-mod [0] r-msg r-sig))
    print-line-uni ("exponent two = " & show (rsa-verify-pkcs1-sha256 r-mod [2] r-msg r-sig))
    print-line-uni ("modulus all zero = " & show (rsa-verify-pkcs1-sha256 (rd-fill 256 0) r-exp r-msg (rd-fill 256 0)))
    print-line-uni ("modulus one = " & show (rsa-verify-pkcs1-sha256 (rd-one 256) r-exp r-msg (rd-fill 256 0)))
    print-line-uni ("pss: signature zero = " & show (rsa-verify-pss-sha256 r-mod r-exp r-msg (rd-fill 256 0)))
    print-line-uni ("pss: signature one = " & show (rsa-verify-pss-sha256 r-mod r-exp r-msg (rd-one 256)))
    print-line-uni ("pss: signature n - 1 = " & show (rsa-verify-pss-sha256 r-mod r-exp r-msg rd-n-minus-1))
    print-line-uni ("512-bit key, its genuine pkcs1 signature = " & show (rsa-verify-pkcs1-sha256 w512-mod r-exp s-msg w512-sig))
    print-line-uni ("1024-bit key, its genuine pkcs1 signature = " & show (rsa-verify-pkcs1-sha256 w1024-mod r-exp s-msg w1024-sig))
    print-line-uni ("1024-bit key, its genuine pss signature = " & show (rsa-verify-pss-sha256 w1024-mod r-exp s-msg w1024-pss))
  end

