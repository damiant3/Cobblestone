Chapter: BS3Smoke

Section: Types
  Maybe2 (a) = | Just2 (a) | None2

  Def = record { name : Text, body : Text }

  Thing = record { th-name : Text, th-body : Text }
  Holder = | Plain (Thing)

  Box2 (a) = | Box2 (a)

Section: Functions
  extract-name : Maybe2 Def -> Text
  extract-name (m) = when m is Just2 (d) -> d.name is None2 -> "none"

  extract-holder : Holder -> Text
  extract-holder (m) = when m is Plain (t) -> t.th-name

  extract-box : Box2 Thing -> Text
  extract-box (m) = when m is Box2 (t) -> t.th-name

Section: Body
  opening : [Console] Nothing = act
    print-line-uni (extract-name (Just2 (Def { name = "hello", body = "world" })))
    print-line-uni (extract-holder (Plain (Thing { th-name = "hi", th-body = "b" })))
    print-line-uni (extract-box (Box2 (Thing { th-name = "bye", th-body = "c" })))
  end

