Chapter: E1000TxWrap

 The e1000 model's BAR is 0xFE400000; TDBAL, TDBAH, TDLEN, TDH and TDT sit at
 0x3800, 0x3804, 0x3808, 0x3810 and 0x3818. A transmit descriptor whose buffer
 address is 2^64 - 16 with length 64 wraps past the end of guest RAM.

Section: Entry

  e1000-bar : Integer = #FE400000

  opening : [Console] Nothing = act
    let raw = alloc-bytes 64
    in let ring = bit-and (raw + 15) (0 - 16)
    in let d0 = poke-qword ring 0 (0 - 16)
    in let d1 = poke-qword ring 8 64
    in let d2 = poke-qword ring 16 0
    in let d3 = poke-qword ring 24 0
    in let r0 = poke-32 (e1000-bar + #3800) 0 (bit-and ring #FFFFFFFF)
    in let r1 = poke-32 (e1000-bar + #3804) 0 (bit-shru ring 32)
    in let r2 = poke-32 (e1000-bar + #3808) 0 32
    in let r3 = poke-32 (e1000-bar + #3810) 0 0
    in let r4 = poke-32 (e1000-bar + #3818) 0 1
    in act
      print-line-uni "survived"
    end
  end
