Chapter: Mini Bootstrap Test

 Minimal type checker test.

Section: Types

  Color =
    | Red
    | Green
    | Blue (Integer)

  Point = record {
    x : Integer,
    y : Integer
  }

Section: Functions

  show-color : Color -> Text
  show-color (c) =
    when c
      is Red -> "red"
      is Green -> "green"
      is Blue (n) -> "blue"

  get-x : Point -> Integer
  get-x (p) = p.x

  add-points : Point, Point -> Point
  add-points (a) (b) = Point { x = a.x + b.x, y = a.y + b.y }

  use-map : List Point -> List Integer
  use-map (pts) = map-list get-x pts

  opening : [Console] Nothing = act
    print-line-uni "mini-bootstrap works"
  end

