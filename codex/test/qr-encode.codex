Chapter: QrEncodeTest
  cites Works chapter GopQr

 We say:

Section: Hex

  qp-nib : Integer -> Text
  qp-nib (n) =
    if n == 0 then "0" else if n == 1 then "1" else if n == 2 then "2"
    else if n == 3 then "3" else if n == 4 then "4" else if n == 5 then "5"
    else if n == 6 then "6" else if n == 7 then "7" else if n == 8 then "8"
    else if n == 9 then "9" else if n == 10 then "a" else if n == 11 then "b"
    else if n == 12 then "c" else if n == 13 then "d" else if n == 14 then "e"
    else "f"

  qp-h8 : Integer -> Text
  qp-h8 (v) = qp-nib (bit-and (bit-shru v 4) 15) & qp-nib (bit-and v 15)

  qp-ecc-text : Integer, Integer, Text -> Text
  qp-ecc-text (cw) (i) (acc) =
    if i >= 134 then acc
    else qp-ecc-text cw (i + 1) (acc & qp-h8 (peek-byte cw i))

Section: Probe

  qp-payload : Text
  qp-payload = "KBDDIAG v8 qr telemetry test 0123456789 the quick brown fox"

  qp-print-rows : Integer, Integer -> [Console] Integer
  qp-print-rows (m) (r) = act
    if r >= qr-size then 0
    else act
      print-line-uni (qr-row-text m r 0 "")
      qp-print-rows m (r + 1)
    end
  end

  opening : [Console] Integer
  opening = act
    let cw = qr5-ecc-of qp-payload
    in let m = qr5-encode qp-payload
    in act
      print-line-uni ("ECC " & qp-ecc-text cw 108 "")
      pr <- qp-print-rows m 0
      print-line-uni "qr-probe ok"
      let r = 0 in r
    end
  end
