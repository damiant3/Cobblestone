Chapter: EventBusTest
  cites Foreword chapter EventBus
  cites Foreword chapter Maybe

Section: Body

  test-log : Text =
    let log = event-log-new 10
    in let log1 = event-log-add log (event-new "boot" "started" 100)
    in let log2 = event-log-add log1 (event-new "net" "connected" 200)
    in let log3 = event-log-add log2 (event-new "boot" "ready" 300)
    in format-event-log log3

  test-filter : Text =
    let log = event-log-add (event-log-add (event-log-add (event-log-new 10) (event-new "boot" "started" 100)) (event-new "net" "up" 200)) (event-new "boot" "ready" 300)
    in let boots = event-log-filter log "boot"
    in "boot-events=" & show (list-length boots)

  test-last : Text =
    let log = event-log-add (event-log-add (event-log-new 10) (event-new "a" "1" 10)) (event-new "b" "2" 20)
    in let last = event-log-last log
    in when last
      is Just (e) -> "last=" & format-event e
      is None -> "last=none"

  test-since : Text =
    let log = event-log-add (event-log-add (event-log-add (event-log-new 10) (event-new "a" "1" 100)) (event-new "b" "2" 200)) (event-new "c" "3" 300)
    in let recent = event-log-since log 200
    in "since-200=" & show (list-length recent)

  test-overflow : Text =
    let log = event-log-add (event-log-add (event-log-add (event-log-add (event-log-new 3) (event-new "a" "1" 1)) (event-new "b" "2" 2)) (event-new "c" "3" 3)) (event-new "d" "4" 4)
    in "overflow=" & format-event-log log

  opening : [Console] Nothing = act
    print-line-uni test-log
    print-line-uni test-filter
    print-line-uni test-last
    print-line-uni test-since
    print-line-uni test-overflow
  end

