Chapter: Peek32Sign

  cites Foreword chapter Console

Section: Body

  opening : [Console] Nothing = act
    let b = alloc-bytes 16
    in let w0 = poke-32 b 0 #ABCD3344
    in let w1 = poke-32 b 4 #7FFFFFFF
    in let w2 = poke-32 b 8 #80000000
    in act
      print-line-uni ("bit31-set " & show (peek-32 b 0))
      print-line-uni ("bit31-clear " & show (peek-32 b 4))
      print-line-uni ("bit31-only " & show (peek-32 b 8))
      print-line-uni ("hi-word " & show (peek-32 b 0 / 65536))
    end
  end