Chapter: RecordKeywordMulti
  cites Foreword chapter Maybe

 Multiple record literals containing the keyword 'effect' as a
 field — testing whether error recovery in the parser crashes
 when it encounters the keyword in field position repeatedly
 across many record construction sites.

 We say:

Section: Record with keyword field

  Session = record {
    id : Integer,
    name : Text,
    effect : Integer,
    status : Integer,
    player : Integer
  }

  make-a : Integer -> Session
  make-a (n) = Session { id = n, name = "a", effect = 1, status = 0, player = 10 }

  make-b : Integer -> Session
  make-b (n) = Session { id = n, name = "b", effect = 2, status = 1, player = 20 }

  make-c : Integer -> Session
  make-c (n) = Session { id = n, name = "c", effect = 3, status = 2, player = 30 }

  make-d : Integer -> Session
  make-d (n) = Session { id = n, name = "d", effect = 4, status = 3, player = 40 }

  make-e : Integer -> Session
  make-e (n) = Session { id = n, name = "e", effect = 5, status = 4, player = 50 }

  make-f : Integer -> Session
  make-f (n) = Session { id = n, name = "f", effect = 6, status = 5, player = 60 }

  make-g : Integer -> Session
  make-g (n) = Session { id = n, name = "g", effect = 7, status = 6, player = 70 }

  make-h : Integer -> Session
  make-h (n) = Session { id = n, name = "h", effect = 8, status = 7, player = 80 }

  update-all : Session -> Session
  update-all (s) = Session { id = s.id, name = s.name, effect = s.effect + 1, status = s.status + 1, player = s.player }

  update-all-2 : Session -> Session
  update-all-2 (s) = Session { id = s.id, name = s.name, effect = s.effect * 2, status = s.status, player = s.player + 1 }

  opening : [Console] Nothing = act
    let a = make-a 1
    in let b = make-b 2
    in let c = update-all a
    in print-line-uni (show (c.effect))
  end

