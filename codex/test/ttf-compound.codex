Section: Glyf Fixture

  sample-bytes : List Integer = [
    0, 1, 0, 0, 0, 0, 0, 100, 0, 100, 0, 3, 0, 0, 1, 1, 1, 1, 0, 0, 0, 100, 0, 0,
    255, 156, 0, 0, 0, 0, 0, 100, 0, 0, 255, 255, 0, 10, 0, 20, 0, 110, 0, 120, 0, 3, 0, 1,
    0, 10, 0, 20, 255, 255, 0, 0, 0, 0, 0, 50, 0, 50, 0, 11, 0, 1, 0, 0, 0, 0, 32, 0,
    255, 255, 0, 5, 0, 10, 0, 55, 0, 60, 0, 11, 0, 2, 0, 0, 0, 0, 32, 0, 255, 255, 0, 0,
    0, 0, 0, 200, 0, 100, 2, 35, 0, 1, 0, 0, 0, 0, 0, 1, 0, 1, 0, 1, 0, 0, 255, 255,
    0, 0, 0, 0, 0, 150, 0, 100, 0, 131, 0, 1, 0, 0, 0, 0, 64, 0, 0, 0, 32, 0, 64, 0,
    255, 255, 0, 0, 0, 0, 0, 100, 0, 100, 0, 3, 0, 7, 0, 0, 0, 0, 255, 255, 0, 0, 0, 0,
    0, 100, 0, 100, 0, 3, 0, 1, 0, 0, 0
  ]

  sample-font : TtfFont = TtfFont {
    tf-buf = sample-bytes,
    tf-dir = TtfDir { td-num-tables = 0, td-tables = [] },
    tf-head = TtfHead { th-units-per-em = 1000, th-index-to-loc = 1, th-x-min = 0, th-y-min = 0, th-x-max = 200, th-y-max = 120 },
    tf-num-glyphs = 9, tf-num-hmetrics = 9,
    tf-hmetrics = [TtfHMetric { hm-advance = 200, hm-lsb = 0 }, TtfHMetric { hm-advance = 120, hm-lsb = 0 }, TtfHMetric { hm-advance = 200, hm-lsb = 0 }, TtfHMetric { hm-advance = 200, hm-lsb = 0 }, TtfHMetric { hm-advance = 200, hm-lsb = 0 }, TtfHMetric { hm-advance = 200, hm-lsb = 0 }, TtfHMetric { hm-advance = 200, hm-lsb = 0 }, TtfHMetric { hm-advance = 200, hm-lsb = 0 }, TtfHMetric { hm-advance = 200, hm-lsb = 0 }],
    tf-cmap = TtfCmap { cm-seg-count = 0, cm-end-codes = [], cm-start-codes = [], cm-id-deltas = [], cm-id-range-offsets = [], cm-glyph-ids = [], cm-range-off-base = 0 },
    tf-loca = [0, 0, 34, 52, 72, 92, 118, 144, 162, 179], tf-glyf-off = 0
  }

Section: Checks

  point-text : TtfGlyph, Integer -> Text
  point-text (g) (i) =
    let p = (ttf-outline-point g.tg-contours i 0).tpr-point
    in show p.tp-x & "," & show p.tp-y

  glyph-line : Text, Integer, Integer -> Text
  glyph-line (name) (idx) (point) =
    let r = ttf-resolve-glyph sample-font idx 0 64
    in name & " ok=" & show r.tr-ok & " contours=" & show (list-length r.tr-glyph.tg-contours) & " point=" & point-text r.tr-glyph point & " advance=" & show r.tr-glyph.tg-advance

  opening : [Console] Nothing = act
    print-line-uni (glyph-line "simple" 1 2)
    print-line-uni (glyph-line "translated" 2 2)
    print-line-uni (glyph-line "scaled" 3 2)
    print-line-uni (glyph-line "nested" 4 2)
    print-line-uni (glyph-line "attached" 5 6)
    print-line-uni (glyph-line "matrix" 6 2)
    print-line-uni ("cycle=" & show (ttf-resolve-glyph sample-font 7 0 64).tr-ok)
    print-line-uni ("truncated=" & show (ttf-resolve-glyph sample-font 8 0 64).tr-ok)
    print-line-uni ("budget=" & show (ttf-resolve-glyph sample-font 2 0 1).tr-ok)
    print-line-uni ("invalid-id=" & show (ttf-resolve-glyph sample-font 9 0 64).tr-ok)
  end

