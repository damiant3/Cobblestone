Chapter: SassCtrlRefuse
  cites Sass chapter SassCtrl

Section: Main

  ok : CtrlCode
  ok = CtrlCode { stall = 15, yield-bit = 1, write-bar = 7, read-bar = 7, wait-mask = 63, reuse = 15 }

  with-field : Integer, Integer -> CtrlCode
  with-field (k) (v) =
    CtrlCode { stall = if k == 0 then v else 15, yield-bit = if k == 1 then v else 1, write-bar = if k == 2 then v else 7, read-bar = if k == 3 then v else 7, wait-mask = if k == 4 then v else 63, reuse = if k == 5 then v else 15 }

  pack-line : Text, CtrlCode -> Text
  pack-line (name) (c) = name & " " & show (sass-ctrl-pack c) & " " & show (sass-ctrl-word ok c ok)

  opening : [Console] Nothing = act
   print-line-uni (pack-line "max" ok)
   print-line-uni (pack-line "stall16" (with-field 0 16))
   print-line-uni (pack-line "yield2" (with-field 1 2))
   print-line-uni (pack-line "write8" (with-field 2 8))
   print-line-uni (pack-line "read-neg" (with-field 3 -1))
   print-line-uni (pack-line "wait64" (with-field 4 64))
   print-line-uni (pack-line "reuse16" (with-field 5 16))
  end
