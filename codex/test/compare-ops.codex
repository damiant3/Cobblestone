Chapter: CompareOps
  cites Codex chapter Console

Section: Definitions

  opening : [Console] Nothing = act
    print-line-uni (if 5 < 10 then "lt" else "nlt")
    print-line-uni (if 5 <= 5 then "le" else "nle")
    print-line-uni (if 5 > 0 then "gt" else "ngt")
    print-line-uni (if 10 >= 10 then "ge" else "nge")
    print-line-uni (if 5 == 5 then "eq" else "neq")
    print-line-uni (if 5 /= 6 then "ne" else "nne")
  end

