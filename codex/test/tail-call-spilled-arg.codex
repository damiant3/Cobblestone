Chapter: TailCallSpilledArg
  cites Foreword chapter Console

Section: Body

  has : Integer -> Boolean
  has (i) = i == 0 | i == 5

  dist : Integer -> Integer
  dist (i) = if i == 0 then 90 else if i == 5 then 10 else 50

  loop8 : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  loop8 (a) (b) (c) (home) (n) (i) (best) (bd) =
    if i >= n then best
    else if i == home then loop8 a b c home n (i + 1) best bd
    else let d = dist i
    in let take = has i & (best < 0 | d < bd)
    in if take then loop8 a b c home n (i + 1) i d
    else loop8 a b c home n (i + 1) best bd

  opening : [Console] Nothing = act
    print-line-uni ("loop8 " & show (loop8 0 0 0 4 6 0 (0 - 1) 0))
  end
