Chapter: ZigFailClosure
  cites Foreword chapter Console

Section: Body

  risky : Integer -> Integer
  risky (n) = if n > 5 then fail "too big" else n

  sum-risky : Integer, Integer -> Integer
  sum-risky (a) (b) = if a + b > 10 then fail "sum too big" else a + b

  apply-to : (Integer -> Integer), Integer -> Integer
  apply-to (f) (x) = f x

  pick-fn : Integer -> (Integer -> Integer)
  pick-fn (n) = if n > 5 then fail "pick too big" else risky

  opening : [Console] Nothing = act
    print-line-uni (show (apply-to risky 3))
    print-line-uni (show (apply-to (sum-risky 4) 5))
    trying 1 times
      print-line-uni (show (apply-to risky 9))
    falling back to
      print-line-uni "closure-fallback"
    on failure
      print-line-uni "closure-failure"
    end
    trying 1 times
      print-line-uni (show (apply-to (sum-risky 4) 9))
    falling back to
      print-line-uni "partial-fallback"
    on failure
      print-line-uni "partial-failure"
    end
    trying 1 times
      print-line-uni (show (apply-to (\x -> risky x) 7))
    falling back to
      print-line-uni "lambda-fallback"
    on failure
      print-line-uni "lambda-failure"
    end
    print-line-uni (show (pick-fn 1 4))
    trying 1 times
      print-line-uni (show (pick-fn 9 4))
    falling back to
      print-line-uni "over-head-fallback"
    on failure
      print-line-uni "over-head-failure"
    end
    trying 1 times
      print-line-uni (show (pick-fn 1 8))
    falling back to
      print-line-uni "over-tail-fallback"
    on failure
      print-line-uni "over-tail-failure"
    end
  end
