Chapter: TextAccumOwner
  cites Foreword chapter Console

Section: Body

  grow : Integer, Text -> Text
  grow (n) (acc) = if n <= 0 then acc else grow (n - 1) (acc & "xy")

  make-base : Integer -> Text
  make-base (k) = "ab" & show k

  kept : Integer -> Text
  kept (k) =
   let base = make-base k
   in let r = grow 3 base
   in base & "|" & r

  reused : Integer -> Text
  reused (k) =
   let s = grow k "q"
   in let r = grow k s
   in r & "/" & s

  opening : [Console] Nothing
  opening = act
    print-line-uni (kept 7)
    print-line-uni (reused 2)
    print-line-uni (show (text-length (grow 1000 "")))
  end
