Chapter: VmProfileLookup
  cites Codex chapter VM Profile
  cites Foreword chapter Console

Section: Checks
  probe : Text -> Text
  probe (asked) =
    let p = lookup-vm-profile asked
    in "[" & asked & "] -> " & p.name & " skip-ata=" & show p.skip-ata-bring-up

  skip-count : List Text, Integer -> Integer
  skip-count (names) (i) =
    if i >= list-length names then 0
    else
      let p = lookup-vm-profile (list-at names i)
      in (if p.skip-ata-bring-up then 1 else 0) + skip-count names (i + 1)

  opening : [Console] Nothing = act
    print-line-uni (probe "QEMU-11.0.0")
    print-line-uni (probe "qemu-11.0.0")
    print-line-uni (probe "QEMU-11.0.1")
    print-line-uni (probe "")
    print-line-uni (probe "spec")
    print-line-uni ("skipping ATA: " & show (skip-count ["QEMU-11.0.0", "qemu-11.0.0", "QEMU-11.0.1", "", "spec", "QEMU-11.0.0"] 0) & " of 6")
  end
