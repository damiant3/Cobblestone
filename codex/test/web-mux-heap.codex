Chapter: WebMuxHeapTest
  cites Net chapter WebServer
  cites Net chapter TcpTransport
  cites Foreword chapter Console

 What `web-mux-accept` allocates per connection, measured by `__heap-save`
 deltas. The listen transport, and with it the one receive buffer, is built
 before the first mark, so the figure is what an accept adds.

Section: The Measurement

  base-mux : Integer -> WebMux
  base-mux (u) = WebMux { listen = fresh-listen-transport 8080, conns = [], served = 0 }

  build : WebMux, Integer, List TcpTransportState -> List TcpTransportState
  build (m) (n) (acc) =
    if n <= 0 then acc
    else build m (n - 1) (list-push acc (web-mux-next-listen m 8080))

  per-conn : Integer -> Integer
  per-conn (n) =
    let m = base-mux 0
    in let a = __heap-save
    in let l = build m n []
    in let b = __heap-save
    in if list-length l < n then 0 - 1 else (b - a) / n

  shared : Integer -> Integer
  shared (n) =
    let m = base-mux 0
    in let l = build m n []
    in count-shared l (m.listen).recv-base 0 0

  count-shared : List TcpTransportState, Integer, Integer, Integer -> Integer
  count-shared (l) (base) (i) (acc) =
    if i >= list-length l then acc
    else count-shared l base (i + 1) (if (list-at l i).recv-base == base then acc + 1 else acc)

 The control: the same construction inside a `__heap-save` /
 `__heap-restore` window must answer 0, or the instrument cannot read a
 reclaimed heap (L-FALSIF).

  per-conn-restored : Integer -> Integer
  per-conn-restored (n) =
    let m = base-mux 0
    in let a = __heap-save
    in let l = build m n []
    in let k = list-length l
    in let r = __heap-restore a
    in let b = __heap-save
    in if k < n then 0 - 1 else (b - a) / n

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("web-mux-heap per-conn n=1 " & show (per-conn 1))
    print-line-uni ("web-mux-heap per-conn n=16 " & show (per-conn 16))
    print-line-uni ("web-mux-heap shared buffer n=16 " & show (shared 16))
    print-line-uni ("web-mux-heap restored n=16 " & show (per-conn-restored 16))
  end

