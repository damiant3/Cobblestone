Chapter: Effects Demo
  cites Foreword chapter Console

 Combined Console effect test. Tests: print from helper function,
 nested act blocks, multiple print calls.

Section: Definitions

  greet : Text -> [Console] Nothing
  greet (name) = print-line ("Hello, " & name & "!")

  announce : Text -> [Console] Nothing
  announce (msg) = act
    print-line msg
  end

Section: Body
  opening : [Console] Nothing = act
    greet "Alice"
    greet "Bob"
    announce "direction-test"
    print-line "Done!"
  end
