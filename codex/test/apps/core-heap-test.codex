Chapter: CoreHeapTest
  cites Sched chapter CoreHeap
  cites Foreword chapter Maybe

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Body
  opening : [Console] Nothing =
    let single = compute-heap-layout 1 8589934592
    in act
      print-line-uni (format-layout single)
      let a0 = when arena-for-core single 0
        is Just (a) -> a
        is None -> HeapArena { core-id = 0, base = 0, top = 0, hwm = 0, active = False }
      in act
        print-line-uni (show (a0.base))
        print-line-uni (show (arena-size a0))
        let quad = compute-heap-layout 4 8589934592
        in act
          print-line-uni (format-layout quad)
          print-line-uni (show (quad.core-count))
          let q0 = when arena-for-core quad 0
            is Just (a) -> a
            is None -> HeapArena { core-id = 0, base = 0, top = 0, hwm = 0, active = False }
          in let q1 = when arena-for-core quad 1
            is Just (a) -> a
            is None -> HeapArena { core-id = 0, base = 0, top = 0, hwm = 0, active = False }
          in let q3 = when arena-for-core quad 3
            is Just (a) -> a
            is None -> HeapArena { core-id = 0, base = 0, top = 0, hwm = 0, active = False }
          in act
            print-line-uni (show (q0.base))
            print-line-uni (show (q1.base))
            print-line-uni (show-bool (q0.base < q1.base))
            print-line-uni (show (q3.top))
            print-line-uni (show (arena-size q0))
            print-line-uni (show (arena-size q0 == arena-size q1))
            let quad1 = layout-update-hwm quad 0 (q0.base + 1000000)
            in act
              print-line-uni (show (layout-total-used quad1))
              print-line-uni (show (layout-total-free quad1))
              let none = arena-for-core quad 5
              in act
                print-line-uni (when none is Just (a) -> "found" is None -> "none")
              end
            end
          end
        end
      end
    end

