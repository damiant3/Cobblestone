Chapter: ArpOpRefused
  cites Net chapter NetworkStack
  cites Net chapter Ethernet
  cites Foreword chapter Console

Section: Fixtures
  srv-mac : List Integer = [82, 84, 0, 18, 52, 86]
  srv-ip : List Integer = [10, 0, 2, 15]
  peer-mac : List Integer = [2, 0, 0, 0, 0, 7]
  peer-ip : List Integer = [10, 0, 2, 7]

  srv0 : NetSession = net-session-new srv-mac srv-ip [10, 0, 2, 2] 80 0 [10, 0, 2, 100] 5000

  request : List Integer = arp-build-request peer-mac peer-ip srv-ip

  with-op : Integer -> List Integer
  with-op (op) = list-set-at (list-set-at (arp-build-request peer-mac peer-ip srv-ip) 20 (bit-shru op 8)) 21 (bit-and op 255)

  short : List Integer = eth-payload-loop request 0 30 []

  wrong-hlen : List Integer = list-set-at (arp-build-request peer-mac peer-ip srv-ip) 18 8

  report : Text, List Integer -> [Console] Nothing
  report (name) (frame) =
    let r = net-process-frame srv0 frame
    in print-line-uni (name & " " & r.output & " queued=" & show (list-length ((r.session).outbox)))

Section: Entry
  opening : [Console] Nothing = act
    report "op-0" (with-op 0)
    report "op-3" (with-op 3)
    report "op-65535" (with-op 65535)
    report "short" short
    report "hlen-8" wrong-hlen
    report "request" request
  end
