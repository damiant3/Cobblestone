Chapter: NameRecordBindingTest
  cites Browser chapter ContentAddress
  cites Foreword chapter Ed25519
  cites Foreword chapter Console

 The publisher key is RFC 8032 section 7.1, TEST 1.

Section: Helpers

  sk : List Integer = [157, 97, 177, 157, 239, 253, 90, 96, 186, 132, 74, 244, 146, 236, 44, 196, 68, 73, 197, 105, 123, 50, 105, 25, 112, 59, 172, 3, 28, 174, 127, 96]

  yn : Boolean -> Text
  yn (b) = if b then "yes" else "no"

  signed : NameRecord
  signed = name-record-sign (name-record-create "site.codex" (content-hash CodecCodexSource [1, 2, 3]) 5 3600 (ed25519-public-key sk)) sk

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("name record control verifies: " & yn (name-record-verify signed))
    print-line-uni ("sequence raised verifies: " & yn (name-record-verify (__record-set signed "nr-sequence" 99)))
    print-line-uni ("ttl changed verifies: " & yn (name-record-verify (__record-set signed "nr-ttl" 1)))
    print-line-uni ("name changed verifies: " & yn (name-record-verify (__record-set signed "nr-name" "evil.codex")))
  end