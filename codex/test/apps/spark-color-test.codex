Chapter: SparkColorTest
  cites Spark chapter ColorPicker

Section: Body

  hue-case : Text, Integer, Real -> Text
  hue-case (label) (want) (h) =
    let got = hsv-to-rgb (hsv-new h 1.0 1.0)
    in label & " " & show got & (if got == want then " ok" else " WRONG want " & show want)

  hsv-case : Text, Integer, Real, Real, Real -> Text
  hsv-case (label) (want) (h) (s) (v) =
    let got = hsv-to-rgb (hsv-new h s v)
    in label & " " & show got & (if got == want then " ok" else " WRONG want " & show want)

  comp-case : Text, Integer, Integer -> Text
  comp-case (label) (want) (rgb) =
    let got = color-complement rgb
    in label & " " & show got & (if got == want then " ok" else " WRONG want " & show want)

  opening : [Console] Nothing = act
    print-line-uni (hue-case "hue-000-red    " 16711680 0.0)
    print-line-uni (hue-case "hue-030-orange " 16744192 30.0)
    print-line-uni (hue-case "hue-060-yellow " 16776960 60.0)
    print-line-uni (hue-case "hue-090-chartre" 8388352 90.0)
    print-line-uni (hue-case "hue-120-green  " 65280 120.0)
    print-line-uni (hue-case "hue-150-spring " 65407 150.0)
    print-line-uni (hue-case "hue-180-cyan   " 65535 180.0)
    print-line-uni (hue-case "hue-210-azure  " 32767 210.0)
    print-line-uni (hue-case "hue-240-blue   " 255 240.0)
    print-line-uni (hue-case "hue-270-violet " 8323327 270.0)
    print-line-uni (hue-case "hue-300-magenta" 16711935 300.0)
    print-line-uni (hue-case "hue-330-rose   " 16711807 330.0)
    print-line-uni (hsv-case "black          " 0 0.0 0.0 0.0)
    print-line-uni (hsv-case "white          " 16777215 0.0 0.0 1.0)
    print-line-uni (hsv-case "grey-half      " 8355711 0.0 0.0 0.5)
    print-line-uni (hsv-case "red-half-sat   " 16744319 0.0 0.5 1.0)
    print-line-uni (comp-case "complement-red " 65535 16711680)
    print-line-uni (comp-case "complement-grn " 16711935 65280)
    print-line-uni "colors ok"
  end
