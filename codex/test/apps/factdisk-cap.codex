 Booted by build/factdisk-cap-test.ps1 on the image
 build/mint-factlog-fixture.ps1 -Big mints, about 8.4 MB, because
 fd-max-content-len is only reachable on a medium past 4 MB.

 We say:

Section: Reading a fact back

  show-fact : Maybe Fact -> Text
  show-fact (m) =
    when m
     is None -> "absent"
     is Just (f) -> show (text-length (f.content)) & "/" & f.author & "/" & show (f.timestamp)

Section: Body

  opening : [Console, Device.Block] Nothing = act
    b <- store-read-bundle bundle-empty
    print-line-uni ("count=" & show (fact-count (b.facts)))
    print-line-uni ("at-cap=" & show-fact (fact-load (b.facts) "cap000"))
    print-line-uni ("past-cap=" & show-fact (fact-load (b.facts) "pst001"))
    print-line-uni ("tail=" & show-fact (fact-load (b.facts) "fed789"))
  end
