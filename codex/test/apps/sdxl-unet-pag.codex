Chapter: SdxlUnetPag

  cites Kernel chapter GpuBridge
  cites Diffusion chapter UNet
  cites Diffusion chapter UNetGraph
  cites Diffusion chapter UNetPagReference

 The step of sdxl-unet-step with every self-attention in the middle block
 answering v, graded against build/sdxl-unet-oracle.py --pag, which keys
 sd_forge_perturbed_attention's patch with Forge's own
 set_model_options_patch_replace. The sabotage is the same step unpatched,
 whose middle the reference places 1 of 64 within 1%.

 We say:

Section: Inputs

  latent-at : Integer -> Real
  latent-at (i) = real-from-int (int-mod (i * 37 + 11) 257 - 128) / 128.0

  label-at : Integer -> Real
  label-at (i) = real-from-int (int-mod (i * 29 + 3) 241 - 120) / 256.0

  context-at : Integer -> Real
  context-at (i) = real-from-int (int-mod (i * 13 + 5) 251 - 125) / 256.0

  build : Integer, Integer, Integer, List Real -> List Real
  build (which) (i) (n) (acc) =
    if i >= n then acc
    else build which (i + 1) n (list-push acc (if which == 0 then latent-at i else if which == 1 then label-at i else context-at i))

Section: Grading

  abs : Real -> Real
  abs (x) = if x < 0.0 then 0.0 - x else x

  count-near : List Real, UNetPagRefBlock, Real, Integer, Integer -> Integer
  count-near (got) (ref) (tol) (j) (acc) =
    if j >= unet-pag-ref-samples then acc
    else let n = list-length got
    in let v = list-at got (int-mod (j * unet-pag-ref-stride + unet-pag-ref-offset) n)
    in count-near got ref tol (j + 1) (if abs (v - list-at (ref.upb-samples) j) <= tol * ref.upb-rms then acc + 1 else acc)

  sum-sq : List Real, Integer, Real -> Real
  sum-sq (xs) (i) (acc) =
    if i >= list-length xs then acc
    else sum-sq xs (i + 1) (acc + list-at xs i * list-at xs i)

  rms-near : List Real, UNetPagRefBlock -> Boolean
  rms-near (got) (ref) =
    let n = list-length got
    in let ms = if n == 0 then 0.0 else sum-sq got 0 0.0 / real-from-int n
    in abs (ms - ref.upb-rms * ref.upb-rms) <= 0.02 * ref.upb-rms * ref.upb-rms

  grade : Integer, Integer -> Text
  grade (h) (k) =
    let ref = list-at unet-pag-ref-blocks k
    in let n = ref.upb-c * ref.upb-h * ref.upb-w
    in let got = if h == 0 then [] else un-download h n
    in if list-length got /= n then ref.upb-name & ": NO OUTPUT"
    else ref.upb-name & ": " & show (count-near got ref 0.01 0 0) & "/" & show unet-pag-ref-samples & " within 1% of rms, rms " & (if rms-near got ref then "near" else "FAR")

  grade-all : List Integer, Integer, List Text -> List Text
  grade-all (hs) (k) (acc) = if k >= list-length unet-pag-ref-blocks then acc else grade-all hs (k + 1) (list-push acc (grade (if k < list-length hs then list-at hs k else 0) k))

  free-all : List Integer, Integer -> Integer
  free-all (hs) (i) = if i >= list-length hs then 0 else let z = un-free 0 (list-at hs i) in free-all hs (i + 1)

Section: Entry

  run-all : Integer -> List Text
  run-all (z) =
    let u = unet-open "dreamshaperXL_lightningDPMSDE.safetensors"
    in if (u.uf-file).st-valid == False then ["SKIP: no dreamshaperXL_lightningDPMSDE.safetensors under the model root build-output/diffusion-models"]
    else run-step (unet-load u)

  run-step : UNetFile -> List Text
  run-step (u) =
    let y = un-upload (build 1 0 2816 [])
    in let ctx = un-upload (build 2 0 157696 [])
    in let emb = unet-embedding u unet-pag-ref-t y
    in let embs = un-silu emb 1280
    in let x = un-upload (build 0 0 1024 [])
    in let ops = unet-ops-with (\x s cx cs hh ww -> True) (\p -> text-starts-with p "middle_block.") (\p -> False) (\s hd r -> True)
    in let blocks = unet-forward-with ops u x embs ctx 16 16
    in let lines = grade-all blocks 0 []
    in let f = free-all blocks 0
    in let x2 = un-upload (build 0 0 1024 [])
    in let plain = unet-forward u x2 embs ctx 16 16
    in lines & ["sabotage, no patch: " & grade (list-at plain 9) 9]

  print-all : List Text, Integer -> [Console] Nothing
  print-all (ls) (i) =
    if i >= list-length ls then act
      print-uni ""
    end
    else act
      print-line-uni (list-at ls i)
      print-all ls (i + 1)
    end

  opening : [Console] Integer
  opening = act
    print-all (run-all 0) 0
    let r = 0 in r
  end
