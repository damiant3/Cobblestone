Section: Body

  read-all-lines : List Text -> [Console] List Text
  read-all-lines (acc) = act
    m <- read-line
    when m
      is Just (l) -> read-all-lines (list-push acc l)
      is None -> acc
  end

  bar-at : Text, Integer -> Integer
  bar-at (t) (i) = if i >= text-length t | substring t i 1 == "|" then i else bar-at t (i + 1)

  both : Text -> Text
  both (line) =
    let b = bar-at line 0
    in let ir = substring line (b + 1) (text-length line - b - 1)
    in let rules = ["Network.Read -> Console.Write"]
    in let second = afc-check rules ir
    in let first = first-verdict (afi-json (afi-analyse rules ir))
    in let same = (second == first) | (first == "path" & substring second 0 5 == "path:")
    in substring line 0 b & ": " & (if same then "agree " & first else "DISAGREE second " & second & ", first " & first)

  first-verdict : Text -> Text
  first-verdict (j) =
    let key = "{\"verdict\":\""
    in if text-length j < text-length key | substring j 0 (text-length key) /= key then "unreadable: " & j
    else substring j (text-length key) (quote-at j (text-length key) - text-length key)

  quote-at : Text, Integer -> Integer
  quote-at (t) (i) = if i >= text-length t | substring t i 1 == "\"" then i else quote-at t (i + 1)

  print-all : List Text, Integer -> [Console] Nothing
  print-all (xs) (i) = act
    if i >= list-length xs then print-line-uni ("programs: " & show (list-length xs))
    else act
      print-line-uni (both (list-at xs i))
      print-all xs (i + 1)
    end
  end

  opening : [Console] Nothing = act
    lines <- read-all-lines []
    print-all lines 0
  end

