Chapter: OtaBootRollback
  cites Foreword chapter OtaBoot
  cites Foreword chapter OtaUpdate
  cites Foreword chapter Board
  cites Foreword chapter Sha256
  cites Foreword chapter Hkdf
  cites Foreword chapter Maybe
  cites Foreword chapter Console

 We say:

Section: Fixtures

  bank-base : Integer = 536875008
  rec-addr : Integer = 536883200
  slot-a-addr : Integer = 536887296
  slot-b-addr : Integer = 536891392

  image-a : List Integer = [67, 68, 88, 49, 1, 1, 1, 1]
  image-b : List Integer = [67, 68, 88, 49, 2, 2, 2, 2]

  digest-of : List Integer -> List Integer
  digest-of (xs) = hkdf-words-to-bytes (sha256 xs)

  show-slot : BootSlot -> Text
  show-slot (s) =
   when s
    is SlotA -> "A"
    is SlotB -> "B"

  show-cand : Maybe BootSlot -> Text
  show-cand (m) =
   when m
    is None -> "none"
    is Just (s) -> show-slot s

Section: Staging

  stage-image : Integer, List Integer -> [Flash, Device.Mmio] Integer
  stage-image (addr) (img) = act
   b0 <- flash-open-bank bank-base
   b1 <- flash-write-page b0 addr img
   flash-seal-bank b1
  end

  wipe-record : Integer -> [Flash, Device.Mmio] Integer
  wipe-record (x) = act
   b0 <- flash-open-bank bank-base
   b1 <- flash-write-word b0 rec-addr 0
   flash-seal-bank b1
  end

Section: The Runs

  run-commit : Integer -> [Flash, Device.Mmio] Text
  run-commit (x) = act
   w <- wipe-record 0
   s1 <- stage-image slot-a-addr image-a
   s2 <- stage-image slot-b-addr image-b
   m <- boot-mark bank-base rec-addr boot-factory-record SlotB (digest-of image-b) (list-length image-b)
   first <- boot-run bank-base rec-addr slot-a-addr slot-b-addr
   c <- boot-commit bank-base rec-addr
   second <- boot-run bank-base rec-addr slot-a-addr slot-b-addr
   let r = boot-load rec-addr
   in "boot1=" & show-slot first & " commit -> boot2=" & show-slot second & " primary=" & show-slot (r.br-primary) & " cand=" & show-cand (r.br-candidate)
  end

  run-no-commit : Integer -> [Flash, Device.Mmio] Text
  run-no-commit (x) = act
   w <- wipe-record 0
   s1 <- stage-image slot-a-addr image-a
   s2 <- stage-image slot-b-addr image-b
   m <- boot-mark bank-base rec-addr boot-factory-record SlotB (digest-of image-b) (list-length image-b)
   b1 <- boot-run bank-base rec-addr slot-a-addr slot-b-addr
   b2 <- boot-run bank-base rec-addr slot-a-addr slot-b-addr
   b3 <- boot-run bank-base rec-addr slot-a-addr slot-b-addr
   b4 <- boot-run bank-base rec-addr slot-a-addr slot-b-addr
   b5 <- boot-run bank-base rec-addr slot-a-addr slot-b-addr
   let r = boot-load rec-addr
   in show-slot b1 & show-slot b2 & show-slot b3 & show-slot b4 & show-slot b5 & " primary=" & show-slot (r.br-primary) & " cand=" & show-cand (r.br-candidate)
  end

  run-corrupt : Integer -> [Flash, Device.Mmio] Text
  run-corrupt (x) = act
   w <- wipe-record 0
   s1 <- stage-image slot-a-addr image-a
   s2 <- stage-image slot-b-addr image-b
   m <- boot-mark bank-base rec-addr boot-factory-record SlotB (digest-of image-b) (list-length image-b)
   bad <- stage-image slot-b-addr [67, 68, 88, 49, 2, 2, 2, 9]
   first <- boot-run bank-base rec-addr slot-a-addr slot-b-addr
   let r = boot-load rec-addr
   in "boot=" & show-slot first & " primary=" & show-slot (r.br-primary) & " cand=" & show-cand (r.br-candidate)
  end

  run-no-flag : Integer -> [Flash, Device.Mmio] Text
  run-no-flag (x) = act
   w <- wipe-record 0
   s1 <- stage-image slot-a-addr image-a
   first <- boot-run bank-base rec-addr slot-a-addr slot-b-addr
   let r = boot-load rec-addr
   in "boot=" & show-slot first & " cand=" & show-cand (r.br-candidate)
  end

Section: Body

  opening : [Console, Flash, Device.Mmio] Nothing = act
   a <- run-commit 0
   print-line-uni ("commit: " & a)
   b <- run-no-commit 0
   print-line-uni ("no-commit: " & b)
   c <- run-corrupt 0
   print-line-uni ("corrupt: " & c)
   d <- run-no-flag 0
   print-line-uni ("no-flag: " & d)
  end
