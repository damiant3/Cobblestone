Chapter: IpcChannelKernTest
  cites Foreword chapter Channel
  cites Foreword chapter Maybe

Section: Tests
  opening : [Console] Nothing = act
    let ch = chan-create 8 0
    in let idx = 0
    in let s1-r = chan-try-send ch 42
    in let s1 = if s1-r.sent then 0 else 0 - 1
    in let s2-r = chan-try-send (s1-r.chan) 99
    in let r1 = chan-try-recv (s2-r.chan)
    in let v1 = when r1.value is Just (v) -> v is None -> 0 - 1
    in let r2 = chan-try-recv (r1.chan)
    in let v2 = when r2.value is Just (v) -> v is None -> 0 - 1
    in let r3 = chan-try-recv (r2.chan)
    in let v3 = when r3.value is Just (v) -> v is None -> 0 - 1
    in let s3-r = chan-try-send (chan-close (r3.chan)) 1
    in let s3 = if s3-r.sent then 0 else 0 - 1
    in act
      print-line-uni ("ch=" & show idx)
      print-line-uni ("s1=" & show s1)
      print-line-uni ("v1=" & show v1)
      print-line-uni ("v2=" & show v2)
      print-line-uni ("v3=" & show v3)
      print-line-uni ("s3=" & show s3)
    end
  end
