Chapter: ServiceRegistryTest
  cites OS chapter ServiceRegistry
  cites Foreword chapter Maybe
  cites Foreword chapter Hamt

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-empty : Text =
    "count=" & show (service-count service-registry-empty)

  test-register : Text =
    let r0 = service-registry-empty
    in let r1 = service-register r0 "shell" 1 255
    in let r2 = service-register r1 "net" 5 192
    in "count=" & show (service-count r2) & " has-shell=" & show-bool (service-exists r2 "shell") & " has-foo=" & show-bool (service-exists r2 "foo")

  test-lookup : Text =
    let r0 = service-register (service-register service-registry-empty "shell" 1 255) "net" 5 192
    in let found = service-lookup r0 "net"
    in when found
      is Just (entry) -> format-service entry
      is None -> "not found"

  test-unregister : Text =
    let r0 = service-register (service-register service-registry-empty "shell" 1 255) "net" 5 192
    in let r1 = service-unregister (service-unregister r0 "shell") "net"
    in "count=" & show (service-count r1) & " exists=" & show-bool (service-exists r1 "shell")

  test-restart : Text =
    let r0 = service-register service-registry-empty "net" 5 192
    in let r1 = service-mark-restarted r0 "net" 7
    in let found = service-lookup r1 "net"
    in when found
      is Just (entry) -> "pid=" & show (entry.pid) & " state=" & format-service-state (entry.state) & " restarts=" & show (entry.restarts)
      is None -> "not found"

  test-caps : Text =
    let r0 = service-register service-registry-empty "net" 5 192
    in let found = service-lookup r0 "net"
    in when found
      is Just (entry) -> "cap6=" & show-bool (service-has-cap entry 6) & " cap7=" & show-bool (service-has-cap entry 7) & " cap3=" & show-bool (service-has-cap entry 3)
      is None -> "not found"

  test-duplicate : Text =
    let r0 = service-register service-registry-empty "shell" 1 255
    in let r1 = service-register r0 "shell" 99 0
    in let found = service-lookup r1 "shell"
    in when found
      is Just (entry) -> "count=" & show (service-count r1) & " pid=" & show (entry.pid)
      is None -> "not found"

  opening : [Console] Nothing = act
    print-line-uni test-empty
    print-line-uni test-register
    print-line-uni test-lookup
    print-line-uni test-unregister
    print-line-uni test-restart
    print-line-uni test-caps
    print-line-uni test-duplicate
  end
