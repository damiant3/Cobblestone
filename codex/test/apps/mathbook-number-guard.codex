Chapter: MathbookNumberGuard
  cites Mathbook chapter Expr
  cites Mathbook chapter Parser

 A literal past i64 max must refuse rather than trap. A fraction scales the
 integer part by 1000 before adding up to 999, so its bound sits lower.

Section: Body

  mn-say : Text -> Text
  mn-say (src) =
    let p = parse-expr src
    in if p.po-ok == False then "REFUSED: " & p.po-error
    else when p.po-expr
      is ExInt (n) -> "int " & show n
      is ExFloat (n) -> "float " & show n
      is otherwise -> "other"

  mn-line : Text -> [Console] Nothing
  mn-line (src) = act
    print-line-uni (src & " => " & mn-say src)
  end

  opening : [Console] Nothing = act
    mn-line "1.5"
    mn-line "9223372036854775807"
    mn-line "9223372036854775808"
    mn-line "99999999999999999999"
    mn-line "9223372036854774.807"
    mn-line "9223372036854775.0"
  end
