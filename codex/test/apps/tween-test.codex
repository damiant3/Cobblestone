Chapter: TweenTest
  cites Game chapter Tween

Section: Tests
  test-linear-start : Text =
    "start=" & show (tw-linear 0 1000 0)

  test-linear-end : Text =
    "end=" & show (tw-linear 0 1000 1000)

  test-linear-mid : Text =
    "mid=" & show (tw-linear 0 1000 500)

  test-ease-in : Text =
    "ease-in-250=" & show (tw-ease-in-quad 0 1000 250) & " ease-in-500=" & show (tw-ease-in-quad 0 1000 500)

  test-ease-out : Text =
    "ease-out-500=" & show (tw-ease-out-quad 0 1000 500) & " ease-out-750=" & show (tw-ease-out-quad 0 1000 750)

  opening : [Console] Nothing = act
    print-line-uni test-linear-start
    print-line-uni test-linear-end
    print-line-uni test-linear-mid
    print-line-uni test-ease-in
    print-line-uni test-ease-out
  end
