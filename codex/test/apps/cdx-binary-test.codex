Chapter: CdxBinaryTest
  cites Foreword chapter Console
  cites Verify chapter CdxBinary

Section: Entry

  opening : [Console] Nothing =
    let inv = bit-and (bit-not cdx-flag-needs-heap) 255
    in let valid1 = cdx-verify-magic (cdx-magic & cdx-zero-bytes 20)
    in let valid2 = cdx-verify-magic (cdx-magic & [1, 0, 0, 0])
    in let invalid = cdx-verify-magic [0, 0, 0, 0]
    in let flags = bit-or cdx-flag-bare-metal cdx-flag-needs-heap
    in let has-bm = bit-and flags cdx-flag-bare-metal > 0
    in let has-sg = bit-and flags cdx-flag-needs-stack-guard > 0
    in act
      print-line-uni (show inv)
      print-line-uni (show valid1)
      print-line-uni (show valid2)
      print-line-uni (show invalid)
      print-line-uni (show has-bm)
      print-line-uni (show has-sg)
    end

