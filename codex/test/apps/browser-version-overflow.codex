Chapter: BrowserVersionOverflowTest
  cites Browser chapter PageFetcher
  cites Foreword chapter Parse
  cites Foreword chapter Console

Section: Helpers

  head-with : Text -> List Text
  head-with (v) = ["HTTP/1.1 200 OK", "Content-Type: application/codex", "X-Codex-Version: " & v]

  mshow : Maybe Integer -> Text
  mshow (m) = when m is None -> "None" is Just (n) -> show n

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("version 3 -> " & show (parse-ver (head-with "3")))
    print-line-uni ("no version -> " & show (parse-ver ["HTTP/1.1 200 OK", "Content-Type: application/codex"]))
    print-line-uni ("version 9223372036854775807 -> " & show (parse-ver (head-with "9223372036854775807")))
    print-line-uni ("decimal 9223372036854775808 -> " & mshow (parse-decimal-full-maybe "9223372036854775808"))
    print-line-uni ("hex 8000000000000000 -> " & mshow (parse-hex-full-maybe "8000000000000000"))
    print-line-uni ("version of 20 digits -> " & show (parse-ver (head-with "99999999999999999999")))
    print-line-uni ("version 9223372036854775808 -> " & show (parse-ver (head-with "9223372036854775808")))
  end
