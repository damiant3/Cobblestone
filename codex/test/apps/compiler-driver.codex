Chapter: CompilerDriverTest
  cites Works chapter CompilerDriver
  cites Works chapter SweepHarness
  cites Foreword chapter Console

  state : Boolean, SweepSummary, Boolean -> RebuildState
  state (fp) (sweep) (ok) = RebuildState { step = StepComplete, cdx-hash = "ab", fixed-point = fp, sweep-summary = sweep, verified = ok }

  result : Boolean -> CompileResult
  result (ok) = CompileResult { success = ok, output-path = "a.cdx", output-size = 3, error-count = 0, log = "" }

  opening : [Console] Nothing =
    let one-pass = tally-result empty-sweep-summary PassVerified
    in let one-fail = tally-result one-pass FailOutput
    in act
      print-line-uni ("modes       : " & compile-mode-string ModeCdx & " " & compile-mode-string ModeElf & " " & compile-mode-string ModeEfi & " " & compile-mode-string ModeImg)
      print-line-uni ("succeeded   : " & show (compile-succeeded (result True)) & " " & show (compile-succeeded (result False)))
      print-line-uni ("failed      : " & show (compile-failed (result True)) & " " & show (compile-failed (result False)))
      print-line-uni ("same hash   : " & format-fixed-point (check-fixed-point "c0ffee" "c0ffee"))
      print-line-uni ("diverged    : " & format-fixed-point (check-fixed-point "c0ffee" "decade"))
      print-line-uni ("initial     : " & show (rebuild-is-green rebuild-initial))
      print-line-uni ("none swept  : " & show (rebuild-is-green (state True empty-sweep-summary True)))
      print-line-uni ("one passed  : " & show (rebuild-is-green (state True one-pass True)))
      print-line-uni ("one failed  : " & show (rebuild-is-green (state True one-fail True)))
      print-line-uni ("no fixpoint : " & show (rebuild-is-green (state False one-pass True)))
      print-line-uni ("unverified  : " & show (rebuild-is-green (state True one-pass False)))
      print-line-uni "done"
    end

