Chapter: SparkPrefJsonTest
  cites Spark chapter SparkPreferences

 Reads the WPF original project's own Concept/preferences.json and prints
 every weight and both totals, then prints them again after writing the state
 back out and reading it in. The expected output is the original's
 PreferenceTracker loading the same file, printed twice.

Section: Output

  spj-file : Text
  spj-file = "{\n  \"weights\": {\n    \"anime\": 31,\n    \"cinematic\": 16,\n    \"wide\": 31,\n    \"bright\": 2.5,\n    \"warm\": 6,\n    \"purple\": 30,\n    \"motion\": 20,\n    \"amber\": 16,\n    \"copper\": 3,\n    \"still\": 19.5,\n    \"scale contrast\": 0,\n    \"geometric\": 14.5,\n    \"easley\": 17.5,\n    \"poster\": 4.5,\n    \"portrait\": 4.5,\n    \"bold\": 5.5,\n    \"crowds\": 2.5,\n    \"hard\": -4.5,\n    \"paperback\": 2,\n    \"16:9\": 6,\n    \"kubrick\": 7,\n    \"dark\": 3.5,\n    \"moebius\": 3,\n    \"studio khara\": 3,\n    \"concept art\": 3,\n    \"painterly\": 3,\n    \"cool\": 3,\n    \"detailed\": 0.5,\n    \"soft\": 0.5,\n    \"landscape\": 0.5\n  },\n  \"totalPositive\": 36,\n  \"totalNegative\": 30\n}"

  spj-weights : List PrefWeight, Integer, Text -> Text
  spj-weights (ws) (i) (acc) = if i >= list-length ws then acc else spj-weights ws (i + 1) (acc & "W " & (list-at ws i).pw-key & " " & json-emit (spark-pref-number ((list-at ws i).pw-quarters)) & "\n")

  spj-show : PrefState -> Text
  spj-show (s) = spj-weights (s.ps-weights) 0 "" & "T " & show (s.ps-positive) & " " & show (s.ps-negative) & "\n"

  opening : [Console] Nothing = act
    print-line (spj-show (spark-pref-parse spj-file) & spj-show (spark-pref-parse (spark-pref-json (spark-pref-parse spj-file))))
  end