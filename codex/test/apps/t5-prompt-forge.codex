  t5p-refs : List (List Integer) = [t5p-ref-0, t5p-ref-1, t5p-ref-2, t5p-ref-3, t5p-ref-4, t5p-ref-5, t5p-ref-6, t5p-ref-7]

Section: Grading

  tf-load : Integer, Integer -> [Device.Block] Integer
  tf-load (start) (len) =
    let secs = (len + 511) / 512
    in let buf = alloc-bytes (secs * 512)
    in act
      l <- fd-load-sectors start secs buf 0
      buf
    end

  ours-flat : List T5Chunk, Boolean -> List Integer
  ours-flat (cs) (ones) =
    let n = if list-length cs == 0 then 0 else list-length ((list-at cs 0).t5c-ids)
    in [list-length cs, n] & flat-ids cs 0 [] & flat-mults cs ones 0 []

  flat-ids : List T5Chunk, Integer, List Integer -> List Integer
  flat-ids (cs) (i) (acc) = if i >= list-length cs then acc else flat-ids cs (i + 1) (acc & (list-at cs i).t5c-ids)

  flat-mults : List T5Chunk, Boolean, Integer, List Integer -> List Integer
  flat-mults (cs) (ones) (i) (acc) = if i >= list-length cs then acc else flat-mults cs ones (i + 1) (acc & bits-of ((list-at cs i).t5c-mults) ones 0 [])

  bits-of : List Real, Boolean, Integer, List Integer -> List Integer
  bits-of (ms) (ones) (i) (acc) = if i >= list-length ms then acc else bits-of ms ones (i + 1) (list-push acc (real-to-bits (if ones then 1.0 else list-at ms i)))

  first-diff : List Integer, List Integer, Integer, Integer -> Integer
  first-diff (a) (b) (i) (stop) = if i >= stop then 0 - 1 else if list-at a i /= list-at b i then i else first-diff a b (i + 1) stop

  grade : Text, List Integer, List Integer -> Text
  grade (label) (got) (want) =
    let head = label & ": " & show (list-at want 0) & " chunks of " & show (list-at want 1)
    in if list-length got /= list-length want | list-at got 0 /= list-at want 0 | list-at got 1 /= list-at want 1 then head & ", SHAPE DIFFERS (ours " & show (list-at got 0) & " of " & show (list-at got 1) & ")"
    else let idn = list-at want 0 * list-at want 1
    in let di = first-diff got want 2 (2 + idn)
    in let dw = first-diff got want (2 + idn) (list-length want)
    in head & ", ids " & (if di < 0 then "match" else "DIFFER at " & show (di - 2)) & ", weights " & (if dw < 0 then "match" else "DIFFER at " & show (dw - 2 - idn))

  lines : T5Tok, Integer, List Text -> List Text
  lines (t) (k) (acc) =
    if k >= list-length t5p-prompts then acc
    else lines t (k + 1) (list-push acc (grade ("prompt " & show k) (ours-flat (t5-prompt-chunks t (list-at t5p-prompts k)) False) (list-at t5p-refs k)))

  print-all : List Text, Integer -> [Console] Nothing
  print-all (ls) (i) =
    if i >= list-length ls then act
      print-uni ""
    end
    else act
      print-line-uni (list-at ls i)
      print-all ls (i + 1)
    end

  go : Integer, Integer -> [Console, Device.Block] Nothing
  go (start) (len) =
    act
      j <- tf-load start len
      let tt = t5-json-tables j len
      in let t = t5-tok-load (tt.tt-vocab) (tt.tt-charsmap)
      in print-all (lines t 0 [] & [grade "control, prompt 1 at weight 1.0" (ours-flat (t5-prompt-chunks t (list-at t5p-prompts 1)) True) (list-at t5p-refs 1)]) 0
    end

  opening : [Console, Device.Block] Nothing
  opening = act
    h <- block-read-sector 0
    go (peek-32 h (12 + 8 * 4)) (peek-32 h (16 + 8 * 4))
  end