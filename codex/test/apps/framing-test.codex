Chapter: FramingTest
  cites Net chapter MessageFraming

Section: Tests
  test-frame-length : Text =
    let text-part = frame-encode-text "hello"
    in let bytes-part = frame-encode-bytes [1, 2, 3, 4, 5, 6, 7, 8]
    in let body = text-part & bytes-part
    in let msg = frame-encode tag-propose body
    in show (frame-decode-length msg)

  test-tag : Text =
    let text-part = frame-encode-text "hello"
    in let bytes-part = frame-encode-bytes [1, 2, 3, 4, 5, 6, 7, 8]
    in let body = text-part & bytes-part
    in let msg = frame-encode tag-propose body
    in show (frame-decode-tag msg)

  test-text-decode : Text =
    let text-part = frame-encode-text "hello"
    in let bytes-part = frame-encode-bytes [1, 2, 3, 4, 5, 6, 7, 8]
    in let body = text-part & bytes-part
    in let msg = frame-encode tag-propose body
    in let decoded-body = frame-decode-body msg
    in let tr = frame-decode-text decoded-body 0
    in tr.value

  test-le64-roundtrip : Text =
    let data = frame-le64 64
    in show (frame-read-le64 data 0)

  opening : [Console] Nothing = act
    print-line-uni test-frame-length
    print-line-uni test-tag
    print-line-uni test-text-decode
    print-line-uni test-le64-roundtrip
  end
