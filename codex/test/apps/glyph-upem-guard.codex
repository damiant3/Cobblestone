  with-upem : Integer -> List Integer
  with-upem (v) = list-set-at (list-set-at test-font-bytes 246 (bit-shru v 8)) 247 (bit-and v 255)

  row : Text, Integer -> Text
  row (label) (v) = label & " " & format-ttf-bitmap-font (ttf-load-font (with-upem v) 16 "f")

  row-aa : Text, Integer -> Text
  row-aa (label) (v) = label & " " & format-ttf-bitmap-font (ttf-load-font-aa (with-upem v) 16 "f")

Section: Body

  opening : [Console] Nothing = act
    print-line-uni (row "1-control-1024" 1024)
    print-line-uni (row-aa "2-control-aa-1024" 1024)
    print-line-uni (row "3-upem-0" 0)
    print-line-uni (row "4-upem-1" 1)
    print-line-uni (row-aa "5-upem-0-aa" 0)
    print-line-uni (row-aa "6-upem-1-aa" 1)
    print-line-uni (row "7-upem-2048" 2048)
  end

