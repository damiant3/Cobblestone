Chapter: ClipLoraTags
  cites Diffusion chapter ClipPrompt
  cites Foreword chapter Console

 The .expected is build/lora-tag-oracle.py's output for the same five
 prompts: Forge's own extra_networks.parse_prompt and the lora extension's
 weight reading. A weight prints as the signed integer of its f64 bits, so
 agreement is exact. The prompts cover weights positional and named, a tag
 with no weight, a kind other than lora, an uppercase LORA, a negative
 weight, dyn, and four things that look like tags and are not.

 We say:

Section: Arms

  clt-lines : PromptNets -> List Text
  clt-lines (n) =
    let head = if n.xn-status == 0 then ["prompt: " & n.xn-prompt] else ["prompt: " & n.xn-prompt, "status " & show (n.xn-status)]
    in head & clt-loras (n.xn-loras) 0 [] & clt-others (n.xn-other) 0 []

  clt-loras : List LoraTag, Integer, List Text -> List Text
  clt-loras (ls) (i) (acc) =
    if i >= list-length ls then acc
    else let l = list-at ls i
    in clt-loras ls (i + 1) (acc & ["lora: " & l.xl-name & " te " & show (real-to-bits (l.xl-te)) & " unet " & show (real-to-bits (l.xl-unet))])

  clt-others : List Text, Integer, List Text -> List Text
  clt-others (ks) (i) (acc) =
    if i >= list-length ks then acc
    else clt-others ks (i + 1) (acc & ["other: " & list-at ks i & " x1"])

  clt-all : List Text, Integer, List Text -> List Text
  clt-all (ps) (i) (acc) =
    if i >= list-length ps then acc
    else clt-all ps (i + 1) (acc & clt-lines (clip-prompt-nets (list-at ps i)))

  clt-prompts : List Text
  clt-prompts = [
    "a castle, <lora:detailTweaker:0.8> sunset",
    "<lora:styleA:1.2:0.6> portrait <lora:styleB> of a knight",
    "<lora:x:te=0.5:unet=1.5> forest <hypernet:hn:1> river",
    "no tags here (red:1.2) <not a tag> <lora:> <:x> a<b",
    "<lora:name with space:-.25><LORA:Upper:0.3> end <lora:z:2:dyn=4>"]

Section: Body
  clt-print : List Text, Integer -> [Console] Nothing
  clt-print (ls) (i) =
    if i >= list-length ls then act
      print-uni ""
    end
    else act
      print-line-uni (list-at ls i)
      clt-print ls (i + 1)
    end

  opening : [Console] Integer
  opening = act
    clt-print (clt-all clt-prompts 0 []) 0
    let r = 0 in r
  end
