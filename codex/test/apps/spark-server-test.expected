route /: matched spark-html
route /api/scene: matched spark-scene
route /api/health: matched health
route /missing: no match
route /api/unknown: matched spark-api
route-count: 5
handler /: html-ok
handler /api/scene: scene-json
handler /nope: 404 /nope
mime html: text/html
mime wasm: application/wasm
mime css: text/css
http status: 200 OK
http type: text/html
404 status: 404 Not Found
binary status: 200 OK
binary type: application/wasm
binary length: 4
encoded length: 93
bin404 status: 404 Not Found
spark-server ok
