Chapter: Sntp Guard
  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Encode chapter Sntp

Section: Helpers

  arm : Text, List Integer -> Text
  arm (name) (bs) =
    when sntp-reply-checked bs
      is Just (p) -> name & " ok mode=" & show (sntp-mode p) & " version=" & show (sntp-version p) & " stratum=" & show (sntp-stratum p) & " t=" & show (sntp-transmit-seconds p)
      is None -> name & " refused len=" & show (list-length bs)

  reply : Integer, Integer, Integer -> List Integer
  reply (mode) (stratum) (t) =
    [sntp-flags 0 4 mode, stratum] & sntp-zeros 38 [] & sntp-u32-be t & sntp-zeros 4 []

  take : List Integer, Integer -> List Integer
  take (bs) (k) = take-loop bs 0 k []

  take-loop : List Integer, Integer, Integer, List Integer -> List Integer
  take-loop (bs) (i) (k) (acc) =
    if i >= k then acc
    else take-loop bs (i + 1) k (list-push acc (list-at bs i))

  set-at : List Integer, Integer, Integer -> List Integer
  set-at (bs) (k) (v) = copy-set bs k v 0 (list-length bs) []

  copy-set : List Integer, Integer, Integer, Integer, Integer, List Integer -> List Integer
  copy-set (bs) (k) (v) (i) (n) (acc) =
    if i >= n then acc
    else copy-set bs k v (i + 1) n (list-push acc (if i == k then v else list-at bs i))

Section: Entry

  opening : [Console] Nothing =
    let good = reply 4 2 #E1E2E3E4
    in act
      print-line-uni (arm "server" good)
      print-line-uni (arm "trailing-mac" (good & [9]))
      print-line-uni (arm "client-mode" (sntp-build-request #E1E2E3E4))
      print-line-uni (arm "broadcast-mode" (reply 5 2 #E1E2E3E4))
      print-line-uni (arm "short-47" (take good 47))
      print-line-uni (arm "short-44" (take good 44))
      print-line-uni (arm "empty" [])
      print-line-uni (arm "not-a-byte" (set-at good 20 256))
      print-line-uni (arm "negative" (set-at good 20 (0 - 1)))
    end
