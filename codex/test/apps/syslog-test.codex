Chapter: SyslogTest
  cites Net chapter Syslog
  cites Net chapter Udp
  cites Net chapter Ethernet
  cites Foreword chapter CCE

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-priority : Text =
    let ke = syslog-priority syslog-facility-kern syslog-severity-emergency
    in let di = syslog-priority syslog-facility-daemon syslog-severity-info
    in let ld = syslog-priority syslog-facility-local0 syslog-severity-debug
    in "kern-emerg=" & show ke & " daemon-info=" & show di & " local0-debug=" & show ld

  test-parse : Text =
    let m = syslog-info "codex-node" "shell" "boot complete"
    in let bytes = syslog-build-message m
    in let parsed = syslog-parse bytes
    in "valid=" & show-bool (parsed.valid) & " pri=" & show (parsed.priority) & " body=" & parsed.body

  test-format : Text =
    let m1 = syslog-error "node1" "verifier" "check failed"
    in let m2 = syslog-warning "node1" "sched" "high load"
    in format-syslog m1 & " | " & format-syslog m2

  test-kern : Text =
    let m = syslog-kern-info "codex" "network initialized"
    in format-syslog m

  test-auth-pri : Text =
    let m = syslog-auth-warning "codex" "sshd" "fails"
    in "pri=" & show (syslog-priority (m.facility) (m.severity))

  test-udp : Text =
    let m = syslog-auth-warning "codex" "sshd" "fails"
    in let pkt = syslog-send-udp [10, 0, 0, 1] [10, 0, 0, 2] 1024 m
    in let proto = list-at pkt 9
    in let pktlen = list-at pkt 2 * 256 + list-at pkt 3
    in "proto=" & show proto & " pktlen=" & show pktlen

  test-severity-names : Text =
    syslog-severity-name 0 & " " & syslog-severity-name 3 & " " & syslog-severity-name 6 & " " & syslog-severity-name 7

  opening : [Console] Nothing = act
    print-line-uni test-priority
    print-line-uni test-parse
    print-line-uni test-format
    print-line-uni test-kern
    print-line-uni test-auth-pri
    print-line-uni test-udp
    print-line-uni test-severity-names
  end
