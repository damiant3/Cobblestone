Chapter: GpuLaunchPtxTest
  cites AI chapter GpuProxy
  cites Gpu chapter LaunchConfig
  cites Gpu chapter DeviceBuffer

 End-to-end test for PTX kernel launch through the GPU proxy.

Section: Helpers
  test-ptx-cmd : Text
  test-ptx-cmd =
    let cmd = gpu-cmd-launch-ptx "vecadd" 1024 256 89
    in cmd.ptx-kernel-name & " " & show (cmd.ptx-grid-x) & " " & show (cmd.ptx-block-x) & " " & show (cmd.ptx-sm-target)

  test-launch-config : Text
  test-launch-config =
    let cfg = launch-config-for-num-elems 2048
    in show (cfg.lc-grid-x) & " " & show (cfg.lc-block-x)

  test-device-buffer : Text
  test-device-buffer =
    let buf = DeviceBuffer { db-id = 1, db-size = 4096 }
    in show (buf.db-size)

Section: Entry
  opening : [Console] Nothing = act
    print-line-uni test-ptx-cmd
    print-line-uni test-launch-config
    print-line-uni test-device-buffer
  end
