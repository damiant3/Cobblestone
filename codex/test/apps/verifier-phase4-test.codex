Chapter: VerifierPhase4Test
  cites Verify chapter CdxVerifier
  cites Verify chapter CdxBinary
  cites Trust chapter TrustLattice
  cites Trust chapter PolicyEngine
  cites Foreword chapter Ed25519
  cites Foreword chapter Sha256
  cites Foreword chapter Sha512
  cites Foreword chapter Maybe
  cites Foreword chapter Hamt

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

  test-sk : List Integer = [157, 97, 177, 157, 239, 253, 90, 96, 186, 132, 74, 244, 146, 236, 44, 196, 68, 73, 197, 105, 123, 50, 105, 25, 112, 59, 172, 3, 28, 174, 127, 96]

  phase-name : VerifyPhase -> Text
  phase-name (p) = when p
    is PhaseIntegrity -> "integrity"
    is PhaseAuthor -> "author"
    is PhaseCapabilities -> "capabilities"
    is PhaseEffects -> "effects"
    is PhaseProofs -> "proofs"

Section: Body
  opening : [Console] Nothing =
    let good-bin = cdx-encode-signed (CdxBinaryParts {
      flags = cdx-flag-bare-metal,
      capabilities = [
        CdxCapability { cap-id = cdx-cap-console, direction = cdx-dir-write, scope = "/", max-duration = 0 }
      ],
      effects = ["Console"],
      text-bytes = [144, 195],
      rodata-bytes = [],
      entry-offset = 0,
      stack-size = 65536,
      heap-size = 65536,
      trust-threshold = 0
    }) test-sk
    in let bad-eff-bin = cdx-encode-signed (CdxBinaryParts {
      flags = cdx-flag-bare-metal,
      capabilities = [
        CdxCapability { cap-id = cdx-cap-console, direction = cdx-dir-write, scope = "/", max-duration = 0 }
      ],
      effects = ["Console", "Network"],
      text-bytes = [144, 195],
      rodata-bytes = [],
      entry-offset = 0,
      stack-size = 65536,
      heap-size = 65536,
      trust-threshold = 0
    }) test-sk
    in let no-eff-bin = cdx-encode-signed (CdxBinaryParts {
      flags = cdx-flag-bare-metal,
      capabilities = [],
      effects = [],
      text-bytes = [144, 195],
      rodata-bytes = [],
      entry-offset = 0,
      stack-size = 65536,
      heap-size = 65536,
      trust-threshold = 0
    }) test-sk
    in let r-good = verify-effects good-bin
    in let r-bad = verify-effects bad-eff-bin
    in let r-none = verify-effects no-eff-bin
    in act
      print-line-uni ("good: " & show-bool (r-good.accepted) & " " & phase-name (r-good.phase))
      print-line-uni ("bad-effects: " & show-bool (r-bad.accepted) & " " & phase-name (r-bad.phase) & " " & r-bad.reason)
      print-line-uni ("no-effects: " & show-bool (r-none.accepted) & " " & phase-name (r-none.phase))
    end

