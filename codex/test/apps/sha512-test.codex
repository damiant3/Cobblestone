Chapter: SHA-512 Test

  cites Foreword chapter Console
  cites Foreword chapter Sha512

Section: Definitions

  h : List Integer -> Text
  h (msg) = sha512-to-hex (sha512 msg)

  range-list : Integer, Integer, List Integer -> List Integer
  range-list (i) (n) (acc) =
    if i == n then acc
    else range-list (i + 1) n (list-push acc i)

  opening : [Console] Nothing = act
    print-line-uni (h [])
    print-line-uni (h [171])
    print-line-uni (h [97, 98, 99])
    print-line-uni (h (range-list 0 111 []))
    print-line-uni (h (range-list 0 112 []))
    print-line-uni (h (range-list 0 128 []))
  end

