Chapter: VerdictPublishTest

  cites Foreword chapter Console
  cites Works chapter RepoProtocol

Section: Body

  opening : [Console] Nothing =
    let repo = repo-empty
    in let ob = integer-to-text (outbox-size repo)
    in act
      print-line-uni ("outbox=" & ob)
      print-line-uni "ok"
    end
