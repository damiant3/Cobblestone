Chapter: RepoTombstone
  cites Works chapter RepoProtocolPersist
  cites Works chapter KeyManager
  cites Foreword chapter FactStore
  cites Foreword chapter Hamt
  cites Foreword chapter Maybe
  cites Foreword chapter Sha256
  cites Kernel chapter DiskFacts
  cites Kernel chapter AppPersist
  cites Foreword chapter Console

 Removal, proven: a path is stored, retired with a tombstone, and stored
 again, and the checked-out tree follows the last word for the path each
 time. Superseding was never deleting and neither is this -- every edition
 is still in the store, addressable by its hash; what changes is only which
 paths the current tree carries.

Section: Helpers

  press : Keypair
  press = generate-keypair (sha256 (text-to-bytes "repo-tombstone"))

  def-of : Text, Text -> SourceDefinition
  def-of (path) (body) =
    SourceDefinition {
      sd-hash = "", sd-path = path, sd-quire = "Q", sd-chapter = "C",
      sd-signer = "", sd-signature = [], sd-author = "", sd-timestamp = 0,
      sd-content = body
    }

  checkout-of : DiskFactStore -> Text
  checkout-of (store) = repo-checkout (repo-index-from-disk store)

Section: Entry

  opening : [Device.Block, Console.Write] Nothing = act
    let s0 = disk-init
    in let s1 = repo-persist-save-definition s0 (sign-definition press (def-of "a.codex" "AAA") 1) 1
    in let s2 = repo-persist-save-definition s1 (sign-definition press (def-of "b.codex" "BBB") 2) 2
    in let after-store = checkout-of s2
    in let s3 = repo-persist-save-tombstone s2 "a.codex" 3
    in let after-tomb = checkout-of s3
    in let s4 = repo-persist-save-definition s3 (sign-definition press (def-of "a.codex" "AAA2") 4) 4
    in let after-restore = checkout-of s4
    in print-line-uni ("store=[" & after-store & "] tomb=[" & after-tomb & "] restore=[" & after-restore & "]")
  end

