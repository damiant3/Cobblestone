Chapter: CvmmDriveTable
  cites Cvmm chapter DriveManager
  cites Cvmm chapter CvmmTypes
  cites Foreword chapter Gpt
  cites Foreword chapter Maybe
  cites Foreword chapter Console

 The two drives are gpt-core-read.disk (64 KiB, GPT with a protective MBR) as master and
 disk-write.disk (16 KiB, no GPT) as slave, so the view is right only if it
 was read from them.

Section: Report

  disk-line : PhysicalDisk -> Text
  disk-line (d) = d.pd-id & " " & show ((d.pd-capacity).bs-bytes) & " bytes " & show (d.pd-partition-count) & " partitions"

  part-line : Partition -> Text
  part-line (p) = p.pt-id & " on " & p.pt-disk-id & " " & show ((p.pt-capacity).bs-bytes) & " bytes"

  print-disks : List PhysicalDisk, Integer -> [Console] Nothing
  print-disks (ds) (i) =
    if i >= list-length ds then act
      print-line-uni "end disks"
    end
    else act
      print-line-uni (disk-line (list-at ds i))
      print-disks ds (i + 1)
    end

  print-parts : List Partition, Integer -> [Console] Nothing
  print-parts (ps) (i) =
    if i >= list-length ps then act
      print-line-uni "end partitions"
    end
    else act
      print-line-uni (part-line (list-at ps i))
      print-parts ps (i + 1)
    end

Section: Entry

  opening : [Console, Device.Block] Nothing = act
    st <- dm-read-block-devices
    print-line-uni ("disks " & show (st.dm-disk-count) & " partitions " & show (st.dm-partition-count))
    print-disks (st.dm-disks) 0
    print-parts (st.dm-partitions) 0
  end

