Chapter: SparkShapesTest
  cites Math chapter Quaternion
  cites Math chapter Geometry
  cites Game chapter Rasterizer
  cites Spark chapter Mesh
  cites Spark chapter ShapeBuilder

Section: Body

  opening : [Console] Nothing = act
    let p = path-add (path-add (path-add path-new 0 0) 1000 0) 500 1000
    in let closed = path-close p
    in print-line-uni ("path: " & path-info closed)

    let cfg = extrude-default
    in let extruded = shape-extrude closed cfg
    in print-line-uni ("extrude verts: " & show (extruded.tm-vert-count))
    print-line-uni ("extrude faces: " & show (extruded.tm-face-count))

    let rect = path-rect 0 0 1000 500
    in print-line-uni ("rect: " & path-info rect)

    let circle = path-circle-approx 0 0 1000 8
    in print-line-uni ("circle: " & path-info circle)

    let lathe-cfg = lathe-default
    in let profile = path-add (path-add path-new 500 (0 - 500)) 500 500
    in let lathed = shape-lathe profile lathe-cfg
    in print-line-uni ("lathe verts: " & show (lathed.tm-vert-count))
    print-line-uni ("lathe faces: " & show (lathed.tm-face-count))

    print-line-uni "shapes ok"
  end
