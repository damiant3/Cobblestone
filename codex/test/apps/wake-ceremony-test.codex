Chapter: WakeCeremonyTest
  cites Verify chapter WakeCeremony
  cites Verify chapter CdxBinary
  cites Foreword chapter Ed25519
  cites Foreword chapter Sha256
  cites Foreword chapter Sha512
  cites Foreword chapter Maybe

Section: The Capsule

  test-sk : List Integer = [157, 97, 177, 157, 239, 253, 90, 96, 186, 132, 74, 244, 146, 236, 44, 196, 68, 73, 197, 105, 123, 50, 105, 25, 112, 59, 172, 3, 28, 174, 127, 96]

  capsule-parts : CdxBinaryParts
  capsule-parts = CdxBinaryParts { flags = cdx-flag-bare-metal, capabilities = [], effects = [], text-bytes = [144, 195], rodata-bytes = [], entry-offset = 0, stack-size = 65536, heap-size = 65536, trust-threshold = 0 }

  capsule-bin : List Integer
  capsule-bin = cdx-encode-signed capsule-parts test-sk

  tampered-bin : List Integer
  tampered-bin = list-set-at (cdx-encode-signed capsule-parts test-sk) 224 7

Section: Test

  opening : [Console] Nothing = act
    print-line-uni (wake-ceremony capsule-bin)
    print-line-uni "---"
    print-line-uni (wake-ceremony tampered-bin)
  end
