Chapter: WizardZonePick
  cites Foreword chapter Console
  cites Works chapter GopWizard
  cites Works chapter GopZone
  cites Works chapter GopZones

Section: Entry

  opening : [Console] Nothing =
    let u = zone-find "UTC"
    in let last = zone-count
    in let k = zone-find "Asia/Kolkata"
    in let r = wz-zone-rec k
    in act
      print-line-uni ("default row: " & (zone-row-of u).zr-name & " " & (zone-row-of u).zr-city)
      print-line-uni ("up from the last row: " & show (wz-zone-step last 1))
      print-line-uni ("down from the first row: " & show (wz-zone-step 1 (0 - 1)) & " of " & show last)
      print-line-uni ("up from default: " & (zone-row-of (wz-zone-step u 1)).zr-name)
      print-line-uni ("kolkata record: " & show (r.zc-minutes) & " " & show (r.zc-id == k) & " " & show (r.zc-band))
      print-line-uni ("buenos aires is iana: " & show (zone-find "America/Argentina/Buenos_Aires" > 0))
    end
