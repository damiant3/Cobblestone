 We say:

Section: Fixtures

  bare-console : UefiConsoleState
  bare-console = UefiConsoleState {
    sys-table = 0,
    con-out = 0,
    con-in = 0,
    rows = 25,
    cols = 80,
    cursor-row = 0,
    cursor-col = 0
  }

  bare-disk : DiskFactStore
  bare-disk = DiskFactStore { superblock = empty-superblock, mem = fact-store-empty, base = 0, limit = 0 }

  bare-keys : Keypair
  bare-keys = generate-keypair (sha256 (text-to-bytes "codex-agent-manager-test"))

Section: Reporting

  mode-name : ConsoleMode -> Text
  mode-name (m) = when m
    is ModeMainMenu -> "main"
    is ModeAgent -> "agent"
    is otherwise -> "other"

  report : Text, DevConsoleState -> [Console] Nothing
  report (label) (s) = act
    print-line-uni (label & ": " & s.status)
  end

  report-where : Text, DevConsoleState -> [Console] Nothing
  report-where (label) (s) = act
    print-line-uni (label & ": mode=" & mode-name (s.mode) & " menu=" & s.menu.title)
  end

Section: Entry

  opening : [Console, Device.Port, Device.Block] Nothing = act
    let s0 = dev-console-init bare-console bare-disk bare-keys
    in let s1 = dispatch-main-menu "agent" s0
    in act
      report-where "entered" s1

      empty <- handle-console-input s1 "list"
      report "list-empty" empty

      rolemenu0 <- handle-console-input s1 "role"
      no-agent <- handle-console-input rolemenu0 "review"
      report "role-no-agent" no-agent

      loaded <- handle-console-input s1 "load"
      report "load" loaded

      listed <- handle-console-input loaded "list"
      report "list-loaded" listed

      inspected <- handle-console-input listed "status"
      report "status" inspected

      rolemenu <- handle-console-input listed "role"
      report-where "role-menu" rolemenu

      swapped <- handle-console-input rolemenu "review"
      report "swap" swapped
      report-where "after-swap" swapped

      relisted <- handle-console-input swapped "list"
      report "list-swapped" relisted

      let held = relisted.status
      in act
        stray <- handle-console-input relisted "nonsense"
        print-line-uni ("stray-untouched: " & show (stray.status == held))
      end

      probed <- handle-console-input relisted "gpu"
      report "gpu" probed

      out <- handle-console-input relisted "back"
      report-where "back" out
    end
  end
