Chapter: JsonTest
  cites Encode chapter Json

Section: Tests
  test-null : Text =
    json-emit json-null

  test-bool : Text =
    json-emit (json-bool True) & " " & json-emit (json-bool False)

  test-int : Text =
    json-emit (json-int 42)

  test-text : Text =
    json-emit (json-str "hello")

  test-array : Text =
    json-emit (json-array [json-int 1, json-int 2, json-int 3])

  test-object : Text =
    json-emit (json-object [JsonPair { key = "name", value = json-str "alice" }])

  opening : [Console] Nothing = act
    print-line-uni test-null
    print-line-uni test-bool
    print-line-uni test-int
    print-line-uni test-text
    print-line-uni test-array
    print-line-uni test-object
  end
