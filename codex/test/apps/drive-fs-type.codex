Chapter: DriveFsTypeTest
  cites Kernel chapter DriveManager

Section: Entry
  dft-buffer : List Integer -> Integer
  dft-buffer (name) =
    let buf = alloc-bytes 512
    in let a = dft-poke buf name 0
    in buf

  dft-poke : Integer, List Integer, Integer -> Integer
  dft-poke (buf) (name) (i) =
    if i >= list-length name then 0
    else let p = poke-byte buf (82 + i) (list-at name i)
    in dft-poke buf name (i + 1)

  dft-line : Integer -> Text
  dft-line (buf) =
    "fs-type [" & dm-read-oem buf & "] fat32=" & (if dm-read-oem buf == "FAT32   " then "yes" else "no")

  opening : [Console] Nothing = act
    print-line-uni (dft-line (dft-buffer [70, 65, 84, 51, 50, 32, 32, 32]))
    print-line-uni (dft-line (dft-buffer [70, 65, 84, 49, 54, 32, 32, 32]))
  end
