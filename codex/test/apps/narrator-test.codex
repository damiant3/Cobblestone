Chapter: NarratorTest

  cites Foreword chapter Console
  cites Works chapter Annotation

Section: Body

  opening : [Console] Nothing =
    let t = make-target "Narrator" "tell-story"
    in let a = create-annotation t Rationale "narrator" "prose drives the code" 100
    in let tk = target-key t
    in let k = annotation-kind-name (a.kind)
    in act
      print-line-uni ("narrator target=" & tk)
      print-line-uni ("kind=" & k & " ok")
    end
