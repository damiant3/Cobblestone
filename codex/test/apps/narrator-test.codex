Chapter: NarratorTest

  cites Foreword chapter Console
  cites Works chapter Annotation
  cites Works chapter Narrator

Section: Fixtures

  nt-target : AnnotationTarget
  nt-target = make-target "Narrator" "tell-story"

  nt-ann : AnnotationKind, Text -> Annotation
  nt-ann (k) (body) = create-annotation nt-target k "fester" body 100

  nt-annotations : List Annotation
  nt-annotations = [
    nt-ann Rationale "because the prose is load-bearing",
    nt-ann Discovery "the fold turned out to be selective",
    nt-ann Doctrine "narration is not documentation",
    nt-ann Invariant "the balance is never negative",
    nt-ann Warning "this sits on a hot path",
    nt-ann Todo "revisit after the migration"
  ]

Section: Helpers

  nt-has : Text, Text -> Text
  nt-has (haystack) (needle) =
    if text-contains haystack needle then "yes" else "no"

Section: Body

  opening : [Console] Nothing =
    let anns = nt-annotations
    in let block = fold-narration anns 0 (list-length anns) (empty-narration nt-target)
    in let out = format-narration block
    in act
      print-line-uni ("target=" & target-key nt-target)
      print-line-uni ("lines=" & show (block.line-count))
      print-line-uni ("rationale=" & nt-has out "load-bearing")
      print-line-uni ("discovery=" & nt-has out "selective")
      print-line-uni ("doctrine=" & nt-has out "not documentation")
      print-line-uni ("invariant=" & nt-has out "never negative")
      print-line-uni ("warning=" & nt-has out "hot path")
      print-line-uni ("todo=" & nt-has out "after the migration")
    end
