Chapter: TrustTransportTest
  cites Trust chapter TrustTransport
  cites Trust chapter AgentProtocol
  cites Trust chapter TrustLattice
  cites Net chapter TcpTransport
  cites Net chapter NetworkStack
  cites Net chapter Tcp
  cites Net chapter Ethernet
  cites Net chapter MessageFraming
  cites Foreword chapter Sha256
  cites Foreword chapter Maybe

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Body
  opening : [Console] Nothing =
    let propose-tag = encode-agent-msg (MsgPropose (ProposeMsg { id = [1], from = AgentIdentity { public-key = [1] }, to = AgentIdentity { public-key = [2] }, capability = Capability { name = "test", direction = 1, scope = "/" }, context = [], expires = 5000000000, signature = [] }))
    in let deny-tag = encode-agent-msg (MsgDeny (DenyMsg { id = [], proposal = [], from = AgentIdentity { public-key = [] }, reason = InsufficientTrust, evidence = [], signature = [] }))
    in let interrupt-tag = encode-agent-msg (MsgInterrupt (InterruptMsg { id = [], from = AgentIdentity { public-key = [] }, to = AgentIdentity { public-key = [] }, reason = Emergency, action = Pause, authority = [], signature = [] }))
    in let sess = net-session-new [0, 0, 0, 0, 0, 1] [10, 0, 0, 1] [10, 0, 0, 254] 5000 80 [10, 0, 0, 2] 1000
    in let ts = transport-new sess
    in let trust-sess = trust-session-new ts
    in act
      print-line-uni ("tag=" & show propose-tag & " type=Propose id0=1 expires=5000000000")
      print-line-uni ("tag=" & show deny-tag & " type=Deny")
      print-line-uni ("tag=" & show interrupt-tag & " type=Interrupt")
      print-line-uni ("auth=" & show-bool (trust-is-authenticated trust-sess) & " score=" & show (trust-peer-score trust-sess))
    end

