Chapter: ShellParseNat
  cites Works chapter ShellParser

 A shell number is a digit run; one past 18 digits does not fit an Integer.

Section: Body

  spn-show : Maybe Integer -> Text
  spn-show (m) = when m
    is Just (v) -> show v
    is None -> "refused"

  opening : [Console] Nothing = act
    print-line-uni ("42: " & spn-show (parse-nat "42"))
    print-line-uni ("18 nines: " & spn-show (parse-nat "999999999999999999"))
    print-line-uni ("25 digits: " & spn-show (parse-nat "9999999999999999999999999"))
    print-line-uni ("empty: " & spn-show (parse-nat ""))
  end
