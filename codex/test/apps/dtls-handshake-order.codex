    [100, 101, 118, 105, 99, 101, 46, 99, 111, 100, 101, 120, 46, 116, 101, 115, 116]

Section: Helpers

  copy-bytes : List Integer -> List Integer
  copy-bytes (bs) = cb-loop bs 0 (list-length bs) []

  cb-loop : List Integer, Integer, Integer, List Integer -> List Integer
  cb-loop (bs) (i) (n) (acc) =
    if i >= n then acc else cb-loop bs (i + 1) n (list-push acc (list-at bs i))

 A DTLSPlaintext header is 13 bytes, so the handshake message type is byte 13.

  retype : List Integer, Integer -> List Integer
  retype (rec) (t) = list-set-at (copy-bytes rec) 13 t

  recontent : List Integer, Integer -> List Integer
  recontent (rec) (ct) = list-set-at (copy-bytes rec) 0 ct

  state : DtlsEpStep -> Text
  state (st) =
    "outs=" & show (list-length (st.es-out)) & " done=" & show (dtls-ep-done (st.es-ep)) & " authenticated=" & show (dtls-ep-authenticated (st.es-ep))

Section: The Handshake

  s0 : DtlsEp = dtls-ep-with-cert (dtls-ep-new True s-priv s-random cookie-secret client-addr) [leaf-cert] leaf-priv leaf-pub
  c0 : DtlsEp = dtls-ep-with-anchors (dtls-ep-new False c-priv c-random [] []) anchors cal-now peer-name

  st1 : DtlsEpStep = dtls-ep-client c0 0
  d1 : List Integer = list-at (st1.es-out) 0
  st2 : DtlsEpStep = dtls-ep-recv s0 d1 10
  d2 : List Integer = list-at (st2.es-out) 0
  st3 : DtlsEpStep = dtls-ep-recv (st1.es-ep) d2 20
  d3 : List Integer = list-at (st3.es-out) 0
  st4 : DtlsEpStep = dtls-ep-recv (st2.es-ep) d3 30
  d-sh : List Integer = list-at (st4.es-out) 0
  d-ee : List Integer = list-at (st4.es-out) 1
  d-cert : List Integer = list-at (st4.es-out) 2
  d-cv : List Integer = list-at (st4.es-out) 3
  d-fin : List Integer = list-at (st4.es-out) 4

  with-ee : DtlsEpStep -> DtlsEpStep
  with-ee (st) = dtls-ep-recv (st.es-ep) d-ee 41

  st5 : DtlsEpStep = dtls-ep-recv (st3.es-ep) d-sh 40
  st6 : DtlsEpStep = dtls-ep-recv ((with-ee st5).es-ep) d-cert 41
  st7 : DtlsEpStep = dtls-ep-recv (st6.es-ep) d-cv 42
  st8 : DtlsEpStep = dtls-ep-recv (st7.es-ep) d-fin 43
  d-cfin : List Integer = list-at (st8.es-out) 0
  st9 : DtlsEpStep = dtls-ep-recv (st4.es-ep) d-cfin 50

Section: A ServerHello From Another Key

  m0 : DtlsEp = dtls-ep-with-cert (dtls-ep-new True m-priv s-random cookie-secret client-addr) [leaf-cert] leaf-priv leaf-pub
  m-sh : List Integer = list-at ((dtls-ep-recv m0 d3 30).es-out) 0

Section: After Completion

  srv-late : DtlsEpStep = dtls-ep-recv (st9.es-ep) d3 60
  cli-late : DtlsEpStep = dtls-ep-recv (st8.es-ep) d-sh 60

Section: A Mistyped ServerHello

  mt5 : DtlsEpStep = dtls-ep-recv (st3.es-ep) (retype d-sh 11) 40
  mt6 : DtlsEpStep = dtls-ep-recv ((with-ee mt5).es-ep) d-cert 41
  mt7 : DtlsEpStep = dtls-ep-recv (mt6.es-ep) d-cv 42
  mt8 : DtlsEpStep = dtls-ep-recv (mt7.es-ep) d-fin 43

Section: A ServerHello In An Alert Record

  ca5 : DtlsEpStep = dtls-ep-recv (st3.es-ep) (recontent d-sh 21) 40
  ca6 : DtlsEpStep = dtls-ep-recv ((with-ee ca5).es-ep) d-cert 41
  ca7 : DtlsEpStep = dtls-ep-recv (ca6.es-ep) d-cv 42
  ca8 : DtlsEpStep = dtls-ep-recv (ca7.es-ep) d-fin 43

Section: Plaintext After The Keys

 A retransmitted ServerHello, a ServerHello under another key, and a plaintext Certificate, each landing after the
 genuine ServerHello and before the protected flight.

  rt6 : DtlsEpStep = dtls-ep-recv ((with-ee (dtls-ep-recv (st5.es-ep) d-sh 40)).es-ep) d-cert 41
  rt7 : DtlsEpStep = dtls-ep-recv (rt6.es-ep) d-cv 42
  rt8 : DtlsEpStep = dtls-ep-recv (rt7.es-ep) d-fin 43

  sk6 : DtlsEpStep = dtls-ep-recv ((with-ee (dtls-ep-recv (st5.es-ep) m-sh 40)).es-ep) d-cert 41
  sk7 : DtlsEpStep = dtls-ep-recv (sk6.es-ep) d-cv 42
  sk8 : DtlsEpStep = dtls-ep-recv (sk7.es-ep) d-fin 43

  pc-rec : List Integer = list-at (dtls-ep-wrap-into (st5.es-ep) [] dtls-hs-certificate 1 [0, 0, 0, 0]) 0
  pc6 : DtlsEpStep = dtls-ep-recv ((with-ee (dtls-ep-recv (st5.es-ep) pc-rec 40)).es-ep) d-cert 41
  pc7 : DtlsEpStep = dtls-ep-recv (pc6.es-ep) d-cv 42
  pc8 : DtlsEpStep = dtls-ep-recv (pc7.es-ep) d-fin 43

Section: A Protected Record Before The Keys

  srv-early : DtlsEpStep = dtls-ep-recv s0 d-cert 10
  cli-early : DtlsEpStep = dtls-ep-recv (st3.es-ep) d-cert 41

Section: ServerHello Fields

 A DTLSPlaintext header is 13 bytes and a DTLS handshake header 12, so the ServerHello body starts at record byte 25:
 the cipher suite at body 35 and the compression method at 37 behind an empty session id echo. Each altered
 ServerHello lands first, then the genuine flight.

  set-at : List Integer, Integer, Integer -> List Integer
  set-at (bs) (i) (v) = list-set-at (copy-bytes bs) i v

  find-seq : List Integer, List Integer, Integer -> Integer
  find-seq (bs) (pat) (i) =
    if i + list-length pat > list-length bs then -1
    else if seq-eq bs i pat 0 then i
    else find-seq bs pat (i + 1)

  seq-eq : List Integer, Integer, List Integer, Integer -> Boolean
  seq-eq (bs) (off) (pat) (j) =
    if j >= list-length pat then True
    else if list-at bs (off + j) /= list-at pat j then False
    else seq-eq bs off pat (j + 1)

  then-flight : List Integer -> DtlsEpStep
  then-flight (bad) =
    let a = dtls-ep-recv (st3.es-ep) bad 40
    in let b = dtls-ep-recv (a.es-ep) d-sh 40
    in let c = dtls-ep-recv ((with-ee b).es-ep) d-cert 41
    in let d = dtls-ep-recv (c.es-ep) d-cv 42
    in dtls-ep-recv (d.es-ep) d-fin 43

 dsh-plus rebuilds the genuine ServerHello's body (record byte 25 on) with one more extension and wraps it as the
 server wraps its own; dsh-keys reports the client's handshake key length after that ServerHello alone (0 when it
 is discarded).

  dsh-body : List Integer = seq-at d-sh 25 (list-length d-sh - 25)

  seq-at : List Integer, Integer, Integer -> List Integer
  seq-at (bs) (off) (n) = cb-loop (dsh-slice bs off n 0 []) 0 n []

  dsh-slice : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  dsh-slice (bs) (off) (n) (i) (acc) = if i >= n then acc else dsh-slice bs off n (i + 1) (list-push acc (list-at bs (off + i)))

  dsh-plus : List Integer -> List Integer
  dsh-plus (extra) =
    let exts = seq-at dsh-body 40 (list-length dsh-body - 40) & extra
    in let n = list-length exts
    in list-at (dtls-ep-wrap-into (st4.es-ep) [] dtls-hs-server-hello 0 (seq-at dsh-body 0 38 & [n / 256, n - (n / 256) * 256] & exts)) 0

  dsh-keys : List Integer -> Text
  dsh-keys (rec) = show (list-length (((dtls-ep-recv (st3.es-ep) rec 40).es-ep).ep-c-hs))

  sh-cipher : DtlsEpStep = then-flight (set-at d-sh 61 2)
  sh-compression : DtlsEpStep = then-flight (set-at d-sh 62 1)
  sh-version : DtlsEpStep = then-flight (set-at d-sh (find-seq d-sh [0, 43, 0, 2] 0 + 5) 3)
  sh-group : DtlsEpStep = then-flight (set-at d-sh (find-seq d-sh [0, 51, 0, 36, 0, 29] 0 + 5) 23)
  sh-legacy : DtlsEpStep = then-flight (set-at d-sh 25 3)
  srv-legacy : DtlsEpStep = dtls-ep-recv s0 (set-at d1 25 3) 10

 The ClientHello body starts at record byte 25 too: legacy_cookie's length at body 35, the one suite at 38 and 39,
 the compression list's length at 40 and its method at 41.

  srv-cookie-field : DtlsEpStep = dtls-ep-recv s0 (set-at d1 60 1) 10
  srv-suite : DtlsEpStep = dtls-ep-recv s0 (set-at d1 64 2) 10
  srv-compression : DtlsEpStep = dtls-ep-recv s0 (set-at d1 66 1) 10

 A HelloRetryRequest has the ServerHello's layout: its suite at record bytes 60 and 61, compression at 62.

  hrr-bad : DtlsEpStep = dtls-ep-recv (st1.es-ep) (set-at d2 61 2) 20
  hrr-then : DtlsEpStep = dtls-ep-recv (hrr-bad.es-ep) d2 20
  hrr-comp : DtlsEpStep = dtls-ep-recv (st1.es-ep) (set-at d2 62 1) 20

 A second HelloRetryRequest after the client's ClientHello2: the same one again, and one whose cookie's last byte
 differs. Each lands first, then the genuine flight.

  hrr-dup : DtlsEpStep = dtls-ep-recv (st3.es-ep) d2 25
  hrr-other : DtlsEpStep = dtls-ep-recv (st3.es-ep) (set-at d2 (list-length d2 - 1) (255 - list-at d2 (list-length d2 - 1))) 25

 dhrr-plus rebuilds the genuine HelloRetryRequest's body (record byte 25 on) with one more extension, as dsh-plus
 does the ServerHello's; dhrr-outs is the client's answer to it alone after its ClientHello1 (1 is a ClientHello2).

  dhrr-body : List Integer = seq-at d2 25 (list-length d2 - 25)

  dhrr-wrap : List Integer -> List Integer
  dhrr-wrap (body) = list-at (dtls-ep-wrap-into (st2.es-ep) [] dtls-hs-server-hello 0 body) 0

  dhrr-plus : List Integer -> List Integer
  dhrr-plus (extra) =
    let exts = seq-at dhrr-body 40 (list-length dhrr-body - 40) & extra
    in let n = list-length exts
    in dhrr-wrap (seq-at dhrr-body 0 38 & [n / 256, n - (n / 256) * 256] & exts)

  dhrr-outs : List Integer -> Text
  dhrr-outs (rec) = show (list-length ((dtls-ep-recv (st1.es-ep) rec 20).es-out))

 dch-plus rebuilds ClientHello1's body (record byte 25 on) with one more extension and an extensions length slack
 bytes past it, wrapped as the client wraps its own; dch-outs is the stateless server's answer (1 is a
 HelloRetryRequest).

  dch-body : List Integer = seq-at d1 25 (list-length d1 - 25)

  dch-plus : List Integer, Integer -> List Integer
  dch-plus (extra) (slack) =
    let eo = dtls13-ch-ext-offset dch-body
    in let exts = seq-at dch-body eo (list-length dch-body - eo) & extra
    in let n = list-length exts + slack
    in list-at (dtls-ep-wrap-into (st1.es-ep) [] dtls-hs-client-hello 0 (seq-at dch-body 0 (eo - 2) & [n / 256, n - (n / 256) * 256] & exts)) 0

 dch-sid33 gives ClientHello1's body a 33-byte legacy_session_id; dch-suites-odd adds one byte to its cipher_suites.

  dch-wrap : List Integer -> List Integer
  dch-wrap (body) = list-at (dtls-ep-wrap-into (st1.es-ep) [] dtls-hs-client-hello 0 body) 0

  dch-sid33 : List Integer =
    let s = list-at dch-body 34
    in seq-at dch-body 0 34 & [33] & fill-a 33 [] & seq-at dch-body (35 + s) (list-length dch-body - 35 - s)

  dch-suites-odd : List Integer =
    let o0 = 35 + list-at dch-body 34
    in let o = o0 + 1 + list-at dch-body o0
    in let cs = list-at dch-body o * 256 + list-at dch-body (o + 1)
    in seq-at dch-body 0 o & [(cs + 1) / 256, (cs + 1) - ((cs + 1) / 256) * 256] & seq-at dch-body (o + 2) cs & [19] & seq-at dch-body (o + 2 + cs) (list-length dch-body - o - 2 - cs)

  dch-shares-len : Integer -> List Integer
  dch-shares-len (d) =
    let i = find-seq dch-body [0, 29, 0, 32] 0
    in set-at dch-body (i - 1) (list-at dch-body (i - 1) + d)

  dch-vec-past : Integer, Integer, Integer -> List Integer
  dch-vec-past (t) (k) (d) =
    let i = find-seq dch-body [0, t, 0] (dtls13-ch-ext-offset dch-body)
    in set-at dch-body (i + 4 + k) (list-at dch-body (i + 4 + k) + d)

  dch-outs : List Integer -> Text
  dch-outs (rec) = show (list-length ((dtls-ep-recv s0 rec 10).es-out))

 Several records in one datagram (RFC 9147 section 4.3): the server's whole flight, ServerHello through Finished;
 and the ServerHello followed by three bytes that are no record, then the rest of the flight one record each.

  one-dgram : DtlsEpStep = dtls-ep-recv (st3.es-ep) (d-sh & d-ee & d-cert & d-cv & d-fin) 40
  junk-tail : DtlsEpStep = hrr-flight-from (dtls-ep-recv (st3.es-ep) (d-sh & [0, 0, 0]) 40)

  hrr-flight-from : DtlsEpStep -> DtlsEpStep
  hrr-flight-from (st) =
    let c = dtls-ep-recv ((with-ee st).es-ep) d-cert 41
    in let d = dtls-ep-recv (c.es-ep) d-cv 42
    in dtls-ep-recv (d.es-ep) d-fin 43

  hrr-flight : DtlsEpStep -> DtlsEpStep
  hrr-flight (st) =
    let b = dtls-ep-recv (st.es-ep) d-sh 40
    in let c = dtls-ep-recv ((with-ee b).es-ep) d-cert 41
    in let d = dtls-ep-recv (c.es-ep) d-cv 42
    in dtls-ep-recv (d.es-ep) d-fin 43

Section: EncryptedExtensions

 The genuine flight is ServerHello, EncryptedExtensions, Certificate, CertificateVerify, Finished. ne skips the
 EncryptedExtensions, its Certificate numbered 1 as a server sending none would number it; ee-seal seals one under the server's handshake key at a record number of its own (0 replaces
 the genuine one, 9 comes after it).

  cert-first : List Integer = list-at (dtls-ep-seal-into (dtls-ep-keys ((st4.es-ep).ep-s-hs)) [] 9 dtls-hs-certificate 1 (tls-cert-encode [leaf-cert])) 0

  ne6 : DtlsEpStep = dtls-ep-recv (st5.es-ep) cert-first 41
  ne8 : DtlsEpStep = dtls-ep-recv (dtls-ep-recv (ne6.es-ep) d-cv 42).es-ep d-fin 43

  ee-seal : Integer, List Integer -> List Integer
  ee-seal (rec-seq) (body) = list-at (dtls-ep-seal-into (dtls-ep-keys ((st4.es-ep).ep-s-hs)) [] rec-seq dtls-hs-encrypted-ext 1 body) 0

  kb : DtlsEpStep = dtls-ep-recv (st5.es-ep) (ee-seal 0 [0, 4, 0, 51, 0, 0]) 41

  dup-flight : DtlsEpStep -> DtlsEpStep
  dup-flight (e) =
    let a = dtls-ep-recv (e.es-ep) (ee-seal 9 [0, 0]) 41
    in let b = dtls-ep-recv (a.es-ep) d-cert 41
    in let c = dtls-ep-recv (b.es-ep) d-cv 42
    in dtls-ep-recv (c.es-ep) d-fin 43

 A Certificate resent under its own message_seq (2) at a fresh record number, after the genuine one and before the
 CertificateVerify, as a peer retransmitting its flight sends it.

  cert-again : List Integer = list-at (dtls-ep-seal-into (dtls-ep-keys ((st4.es-ep).ep-s-hs)) [] 9 dtls-hs-certificate 2 (tls-cert-encode [leaf-cert])) 0

  rc8 : DtlsEpStep =
    let a = dtls-ep-recv (st6.es-ep) cert-again 41
    in let b = dtls-ep-recv (a.es-ep) d-cv 42
    in dtls-ep-recv (b.es-ep) d-fin 43

 Alerts to the client: after its handshake an alert sealed under the server's application key at record 0 and one
 data byte at 1 (close_notify, fatal handshake_failure, user_canceled); in its handshake epoch a fatal alert at
 record 9; and a plaintext fatal alert after the ServerHello, when a plaintext alert is unauthenticated.

  app-seal : Integer, Integer, List Integer -> List Integer
  app-seal (seq) (ct) (data) = dtls-seal (dtls-ep-keys ((st9.es-ep).ep-s-ap)) dtls-ep-app-epoch seq data ct

 An authentic record past the length ceiling: a fresh pair, each built inside the call so no row shares an
 endpoint record (L-ALIAS), then one application record of n bytes sealed under the server's key; big-in is what
 the client received.

  FreshPair = record { fp-c : DtlsEp, fp-s : DtlsEp }

  fresh-feed : DtlsEp, List (List Integer), Integer, Integer -> DtlsEpStep
  fresh-feed (ep) (recs) (i) (t) =
    let st = dtls-ep-recv ep (list-at recs i) t
    in if i + 1 >= list-length recs then st else fresh-feed (st.es-ep) recs (i + 1) (t + 1)

  fresh-pair : Integer -> FreshPair
  fresh-pair (k) =
    let sv = dtls-ep-with-cert (dtls-ep-new True s-priv s-random cookie-secret client-addr) [leaf-cert] leaf-priv leaf-pub
    in let a1 = dtls-ep-client (dtls-ep-with-anchors (dtls-ep-new False c-priv c-random [] []) anchors cal-now peer-name) k
    in let a2 = dtls-ep-recv sv (list-at (a1.es-out) 0) 10
    in let a3 = dtls-ep-recv (a1.es-ep) (list-at (a2.es-out) 0) 20
    in let a4 = dtls-ep-recv (a2.es-ep) (list-at (a3.es-out) 0) 30
    in let a8 = fresh-feed (a3.es-ep) (a4.es-out) 0 40
    in let a9 = dtls-ep-recv (a4.es-ep) (list-at (a8.es-out) 0) 50
    in FreshPair { fp-c = a8.es-ep, fp-s = a9.es-ep }

  fill-a : Integer, List Integer -> List Integer
  fill-a (n) (acc) = if list-length acc >= n then acc else fill-a n (list-push acc 65)

  big-in : Integer -> Text
  big-in (n) =
    let p = fresh-pair 0
    in let rec = dtls-seal (dtls-ep-keys ((p.fp-s).ep-s-ap)) dtls-ep-app-epoch 0 (fill-a n []) 23
    in show (list-length (dtls-ep-app-in ((dtls-ep-recv (p.fp-c) rec 60).es-ep)))

 A record number past 16 bits (RFC 9147 4.2.2): a fresh pair whose client has accepted application records up to
 right, then one data byte at record seq under the server's key; near-in is what the client received.

  near-in : Integer, Integer -> Text
  near-in (right) (seq) =
    let p = fresh-pair 0
    in let c = __record-set (p.fp-c) "ep-app-window" (DtlsWindow { dw-right = right, dw-bits = 1 })
    in let rec = dtls-seal (dtls-ep-keys ((p.fp-s).ep-s-ap)) dtls-ep-app-epoch seq [65] 23
    in show (list-length (dtls-ep-app-in ((dtls-ep-recv c rec 60).es-ep)))

 AES-GCM's usage limit (RFC 9147 4.5.3): a fresh client whose application write sequence is set to seq sends one
 byte, twice when twice; limit-outs is the records each send produced.

  limit-outs : Integer, Boolean -> Text
  limit-outs (seq) (twice) =
    let p = fresh-pair 0
    in let c = __record-set (p.fp-c) "ep-app-write-seq" seq
    in let a = dtls-ep-send-app c [65]
    in if twice then show (list-length (a.es-out)) & "," & show (list-length ((dtls-ep-send-app (a.es-ep) [66]).es-out))
    else show (list-length (a.es-out))

  alert-then-data : List Integer -> DtlsEpStep
  alert-then-data (alert) =
    let a = dtls-ep-recv (st8.es-ep) (app-seal 0 21 alert) 60
    in dtls-ep-recv (a.es-ep) (app-seal 1 23 [65]) 61

  hs-alert : DtlsEpStep = dtls-ep-recv (st5.es-ep) (dtls-seal (dtls-ep-keys ((st4.es-ep).ep-s-hs)) dtls-ep-hs-epoch 9 [2, 40] 21) 41
  plain-alert : DtlsEpStep = dtls-ep-recv (st5.es-ep) (dtls-plain-encode 21 0 5 [2, 40]) 41

 Record types to the client: after its handshake one record of type 99 then a data byte, and one ack (26) then a
 data byte; in its handshake epoch one application_data record at record 9, then the flight.

  type-then-data : Integer -> DtlsEpStep
  type-then-data (ct) =
    let a = dtls-ep-recv (st8.es-ep) (app-seal 0 ct [0, 0]) 60
    in dtls-ep-recv (a.es-ep) (app-seal 1 23 [65]) 61

  hs-app : DtlsEpStep = dtls-ep-recv (st5.es-ep) (dtls-seal (dtls-ep-keys ((st4.es-ep).ep-s-hs)) dtls-ep-hs-epoch 9 [65] 23) 41

 A Finished sealed under the right key with 32 zero bytes of verify_data: the server's to the client after its
 CertificateVerify, and the client's to the server after its flight.

  zeros : Integer, List Integer -> List Integer
  zeros (n) (acc) = if n <= 0 then acc else zeros (n - 1) (list-push acc 0)

  bad-sfin : DtlsEpStep = dtls-ep-recv (st7.es-ep) (list-at (dtls-ep-seal-into (dtls-ep-keys ((st4.es-ep).ep-s-hs)) [] 9 dtls-hs-finished 4 (zeros 32 [])) 0) 43
  bad-cfin : DtlsEpStep = dtls-ep-recv (st4.es-ep) (list-at (dtls-ep-seal-into (dtls-ep-keys ((st8.es-ep).ep-c-hs)) [] 0 dtls-hs-finished 2 (zeros 32 [])) 0) 50

 A handshake message of a type the receiver's flight does not hold, sealed under the sender's handshake key at
 record 9: to the server a ClientHello (ClientHello2's body) and a Certificate, then the genuine client Finished; to
 the client a ServerHello (the genuine one's body) and a CertificateRequest after EncryptedExtensions, then the rest
 of the genuine flight.

 The server's protected flight opened and resealed several messages to a record (RFC 9147 permits it): all four in
 record 9; and EncryptedExtensions, Certificate and CertificateVerify in record 9, then Finished followed by the
 EncryptedExtensions again in record 10.

  open-hs : List Integer -> List Integer
  open-hs (rec) =
    when dtls-open (dtls-ep-keys ((st4.es-ep).ep-s-hs)) 0 rec
      is None -> []
      is Just (p) -> p.dp-content

  s-pack : Integer, List Integer -> List Integer
  s-pack (seq) (msgs) = dtls-ep-seal-hs (dtls-ep-keys ((st4.es-ep).ep-s-hs)) seq msgs

  packed-all : DtlsEpStep = dtls-ep-recv (st5.es-ep) (s-pack 9 (open-hs d-ee & open-hs d-cert & open-hs d-cv & open-hs d-fin)) 41
  packed-three : DtlsEpStep = dtls-ep-recv (st5.es-ep) (s-pack 9 (open-hs d-ee & open-hs d-cert & open-hs d-cv)) 41
  packed-fin-more : DtlsEpStep = dtls-ep-recv (packed-three.es-ep) (s-pack 10 (open-hs d-fin & open-hs d-ee)) 42

 The genuine CertificateVerify body with one byte past its signature, or its scheme set to 0x0401 (not offered),
 sealed at record 9 as message 3 after the genuine EncryptedExtensions and Certificate.

  cvb : List Integer = seq-at (open-hs d-cv) 12 (list-length (open-hs d-cv) - 12)

  cv-row : List Integer -> Text
  cv-row (body) =
    let a = dtls-ep-recv ((dtls-ep-recv ((with-ee st5).es-ep) d-cert 41).es-ep) (list-at (dtls-ep-seal-into (dtls-ep-keys ((st4.es-ep).ep-s-hs)) [] 9 dtls-hs-cert-verify 3 body) 0) 42
    in "outs=" & show (list-length (a.es-out)) & " alert=" & alert-of a

  c-seal : Integer, List Integer -> List Integer
  c-seal (t) (body) = list-at (dtls-ep-seal-into (dtls-ep-keys ((st8.es-ep).ep-c-hs)) [] 9 t 2 body) 0

  s-seal : Integer, List Integer -> List Integer
  s-seal (t) (body) = list-at (dtls-ep-seal-into (dtls-ep-keys ((st4.es-ep).ep-s-hs)) [] 9 t 2 body) 0

  srv-sealed : List Integer -> DtlsEpStep
  srv-sealed (rec) = dtls-ep-recv (st4.es-ep) rec 45

  cli-sealed : List Integer -> DtlsEpStep
  cli-sealed (rec) = dtls-ep-recv ((with-ee st5).es-ep) rec 41

  cli-rest : DtlsEpStep -> DtlsEpStep
  cli-rest (st) = dtls-ep-recv ((dtls-ep-recv ((dtls-ep-recv (st.es-ep) d-cert 41).es-ep) d-cv 42).es-ep) d-fin 43

  sealed-row : DtlsEpStep, DtlsEpStep -> Text
  sealed-row (st) (after) = "outs=" & show (list-length (st.es-out)) & " alert=" & alert-of st & " then " & state after

  srv-sealed-row : List Integer -> Text
  srv-sealed-row (rec) = sealed-row (srv-sealed rec) (dtls-ep-recv ((srv-sealed rec).es-ep) d-cfin 50)

  cli-sealed-row : List Integer -> Text
  cli-sealed-row (rec) = sealed-row (cli-sealed rec) (cli-rest (cli-sealed rec))

 A KeyUpdate to the client after its handshake: a handshake record under the server's application key (epoch 3,
 record 0) holding one whole message, type 24, length 1, message_seq 5. ku-row hands it over, then one data byte
 under the server's NEXT secret (HKDF-Expand-Label "traffic upd", RFC 8446 7.2) as epoch 4, record 0, and reports
 the client's answer: one ACK, opened under the client's application key, naming record (3, 0) (RFC 9147 7, 8).

  ku-msg : Integer, List Integer -> List Integer
  ku-msg (len) (body) = [24, 0, 0, len, 0, 5, 0, 0, 0, 0, 0, len] & body

  ku-row : List Integer -> Text
  ku-row (msg) =
    let a = dtls-ep-recv (st8.es-ep) (app-seal 0 22 msg) 60
    in let b = dtls-ep-recv (a.es-ep) (dtls-seal (dtls-ep-keys (tep-next-secret ((st9.es-ep).ep-s-ap))) 4 0 [65] 23) 61
    in "outs=" & show (list-length (a.es-out)) & " ack-ok=" & show (ku-ack-ok a) & " alert=" & (if ku-ack-ok a then "none" else alert-of a) & " then " & app-state b

 kur-row: a KeyUpdate asking for one back, then both ends in loopback: the client's ACK and its own KeyUpdate go to
 the server, the server's ACK of that comes back, and one byte the client then sends must open at the server, which
 it can only if both moved the client's sending secret and epoch together. The server is set as having sent that
 KeyUpdate and had it acknowledged (its sending secret moved, epoch 4, sequence 0), which no endpoint call starts.

  kur-row : Integer -> Text
  kur-row (x) =
    let a = dtls-ep-recv (st8.es-ep) (app-seal 0 22 (ku-msg 1 [1])) 60
    in let srv = __record-set (__record-set (__record-set (st9.es-ep) "ep-s-ap" (tep-next-secret ((st9.es-ep).ep-s-ap))) "ep-write-epoch" 4) "ep-app-write-seq" 0
    in let s1 = dtls-ep-recv srv (list-at (a.es-out) 0) 61
    in let s2 = dtls-ep-recv (s1.es-ep) (if list-length (a.es-out) < 2 then [] else list-at (a.es-out) 1) 62
    in let c2 = dtls-ep-recv (a.es-ep) (if list-length (s2.es-out) < 1 then [] else list-at (s2.es-out) 0) 63
    in let cs = dtls-ep-send-app (c2.es-ep) [66]
    in let s3 = dtls-ep-recv (s2.es-ep) (list-at (cs.es-out) 0) 64
    in "client outs=" & show (list-length (a.es-out)) & " server outs=" & show (list-length (s2.es-out)) & " client epoch=" & show ((c2.es-ep).ep-write-epoch) & " server app-in=" & show (list-length ((s3.es-ep).ep-app-in))

 A NewSessionTicket to the client (lifetime 60, a 1-byte ticket, no extension) at application record 0, then one
 data byte at record 1 under the same key.

  nst-msg : List Integer = [4, 0, 0, 14, 0, 5, 0, 0, 0, 0, 0, 14, 0, 0, 0, 60, 0, 0, 0, 0, 0, 0, 1, 7, 0, 0]

  nst-row : Text =
    let a = dtls-ep-recv (st8.es-ep) (app-seal 0 22 nst-msg) 60
    in let b = dtls-ep-recv (a.es-ep) (app-seal 1 23 [65]) 61
    in "outs=" & show (list-length (a.es-out)) & " ack-ok=" & show (ku-ack-ok a) & " then " & app-state b

 A fresh client takes a KeyUpdate at epoch 3 record 1, then one byte at epoch 4 record 0, then these, each counted as
 the client's app-in after it: late, epoch 3 record 0 sent before the update; replay, the same record again; then a
 retransmission of the KeyUpdate at epoch 3 record 2, whose answer must be one ACK naming (3, 2) under the client's
 key; after, epoch 4 record 1, which opens only if the retransmission did not move the key; then a second KeyUpdate
 at epoch 4 record 2, after which epoch 3 record 3 (two-back) is dropped and epoch 4 record 3 (prev-moved) is taken.

  old-epoch-row : Text =
    let p = fresh-pair 0
    in let k3 = dtls-ep-keys ((p.fp-s).ep-s-ap)
    in let k4 = dtls-ep-keys (tep-next-secret ((p.fp-s).ep-s-ap))
    in let a = dtls-ep-recv (p.fp-c) (dtls-seal k3 3 1 (ku-msg 1 [0]) 22) 60
    in let b = dtls-ep-recv (a.es-ep) (dtls-seal k4 4 0 [65] 23) 61
    in let late = dtls-ep-recv (b.es-ep) (dtls-seal k3 3 0 [66] 23) 62
    in let n-late = list-length ((late.es-ep).ep-app-in)
    in let replay = dtls-ep-recv (late.es-ep) (dtls-seal k3 3 0 [66] 23) 63
    in let n-replay = list-length ((replay.es-ep).ep-app-in)
    in let retx = dtls-ep-recv (replay.es-ep) (dtls-seal k3 3 2 (ku-msg 1 [0]) 22) 64
    in let ack-ok = old-ack-ok retx ((p.fp-c).ep-c-ap)
    in let after = dtls-ep-recv (retx.es-ep) (dtls-seal k4 4 1 [67] 23) 65
    in let n-after = list-length ((after.es-ep).ep-app-in)
    in let ku2 = dtls-ep-recv (after.es-ep) (dtls-seal k4 4 2 (ku-msg 1 [0]) 22) 66
    in let two-back = dtls-ep-recv (ku2.es-ep) (dtls-seal k3 3 3 [68] 23) 67
    in let n-two = list-length ((two-back.es-ep).ep-app-in)
    in let moved = dtls-ep-recv (two-back.es-ep) (dtls-seal k4 4 3 [69] 23) 68
    in "late=" & show n-late & " replay=" & show n-replay & " retx outs=" & show (list-length (retx.es-out)) & " ack=" & show ack-ok & " after=" & show n-after & " two-back=" & show n-two & " prev-moved=" & show (list-length ((moved.es-ep).ep-app-in))

 RFC 9147 section 5.2: each handshake message a side sends takes its next message_seq. no-hrr: a client answered
 at once by a ServerHello (no HelloRetryRequest; the server's flight built by hand from the client's ClientHello1)
 sends ClientHello1 (0) then Finished (1); with-hrr is the main handshake's, ClientHello1, ClientHello2, Finished
 (2). ku1 and ku2: the client's own two KeyUpdates (its write sequence set to the usage limit, the first acknowledged
 by the server between them) take 3 and 4.

  fin-seq : List Integer, List Integer -> Integer
  fin-seq (c-hs) (rec) =
    when dtls-open (dtls-ep-keys c-hs) 0 rec
      is None -> 0 - 1
      is Just (p) -> if p.dp-type /= dtls-content-handshake then 0 - 2 else list-at (p.dp-content) 4 * 256 + list-at (p.dp-content) 5

  no-hrr-fin : Text =
    let cl = dtls-ep-client (dtls-ep-with-anchors (dtls-ep-new False c-priv c-random [] []) anchors cal-now peer-name) 0
    in let c1 = cl.es-ep
    in let sv = dtls-ep-with-cert (dtls-ep-new True s-priv s-random cookie-secret client-addr) [leaf-cert] leaf-priv leaf-pub
    in let shb = dtls13-server-hello-body (dtls-ep-random sv) [] (sv.ep-pub)
    in let hs = tls13-handshake-secret (x25519-shared-secret s-priv (c1.ep-pub))
    in let tr = (c1.ep-ch1) & tls13-msg-transcript dtls-hs-server-hello shb
    in let th = tls13-transcript-hash tr
    in let c-hs = tls13-client-hs-traffic hs th
    in let tr-ee = tr & tls13-msg-transcript dtls-hs-encrypted-ext dtls-ep-ee-body
    in let fl = dtls-ep-server-emit-auth sv (c1.ep-pub) hs tr-ee c-hs (tls13-server-hs-traffic hs th) shb
    in let fed = fresh-feed c1 (fl.es-out) 0 40
    in "no-hrr done=" & show (dtls-ep-done (fed.es-ep)) & " fin=" & show (if list-length (fed.es-out) < 1 then 0 - 3 else fin-seq c-hs (list-at (fed.es-out) 0)) & " with-hrr fin=" & show (fin-seq ((st8.es-ep).ep-c-hs) d-cfin)

  ku-step : DtlsEp -> DtlsEpStep
  ku-step (ep) = dtls-ep-send-app (__record-set ep "ep-app-write-seq" dtls-ep-ku-at) [65]

  ku-ms : DtlsEpStep, List Integer -> Integer
  ku-ms (st) (own) =
    if list-length (st.es-out) < 1 then 0 - 3
    else when dtls-open (dtls-ep-keys own) dtls-ep-ku-at (list-at (st.es-out) 0)
      is None -> 0 - 1
      is Just (p) -> list-at (p.dp-content) 4 * 256 + list-at (p.dp-content) 5

  two-ku : Text =
    let p = fresh-pair 0
    in let c-ap0 = (p.fp-c).ep-c-ap
    in let s-ap0 = (p.fp-s).ep-s-ap
    in let s1 = ku-step (p.fp-c)
    in let k1 = ku-ms s1 c-ap0
    in let acked = dtls-ep-recv (s1.es-ep) (dtls-seal (dtls-ep-keys s-ap0) 3 0 (dtls-ack-encode [DtlsRecordNum { rn-epoch = 3, rn-seq = dtls-ep-ku-at }]) dtls-content-ack) 70
    in let s2 = ku-step (acked.es-ep)
    in "ku1=" & show k1 & " epoch=" & show ((acked.es-ep).ep-write-epoch) & " ku2=" & show (ku-ms s2 (tep-next-secret c-ap0))

  old-ack-ok : DtlsEpStep, List Integer -> Boolean
  old-ack-ok (st) (c-ap) =
    if list-length (st.es-out) /= 1 then False
    else when dtls-open (dtls-ep-keys c-ap) 0 (list-at (st.es-out) 0)
      is None -> False
      is Just (p) -> p.dp-type == 26 & dsh-same (p.dp-content) (dtls-ack-encode [DtlsRecordNum { rn-epoch = 3, rn-seq = 2 }])

  ku-ack-ok : DtlsEpStep -> Boolean
  ku-ack-ok (st) =
    if list-length (st.es-out) /= 1 then False
    else when dtls-open (dtls-ep-keys ((st8.es-ep).ep-c-ap)) 0 (list-at (st.es-out) 0)
      is None -> False
      is Just (p) -> p.dp-type == 26 & dsh-same (p.dp-content) (dtls-ack-encode [DtlsRecordNum { rn-epoch = 3, rn-seq = 0 }])

  dsh-same : List Integer, List Integer -> Boolean
  dsh-same (a) (b) = if list-length a /= list-length b then False else dsh-same-loop a b 0

  dsh-same-loop : List Integer, List Integer, Integer -> Boolean
  dsh-same-loop (a) (b) (i) = if i >= list-length a then True else if list-at a i /= list-at b i then False else dsh-same-loop a b (i + 1)

  app-state : DtlsEpStep -> Text
  app-state (st) = state st & " app-in=" & show (list-length ((st.es-ep).ep-app-in))

  alert-of : DtlsEpStep -> Text
  alert-of (st) = if list-length (st.es-out) < 1 then "none" else show (list-at (list-at (st.es-out) 0) (list-length (list-at (st.es-out) 0) - 1))

Section: Results
  test-sh-cipher : Text = "client sh cipher-not-offered then " & state sh-cipher
  test-sh-compression : Text = "client sh compression-1 then " & state sh-compression
  test-sh-version : Text = "client sh supported-version-altered then " & state sh-version
  test-sh-group : Text = "client sh key-share-group-23 then " & state sh-group
  test-sh-legacy : Text = "client sh legacy-not-fefd then " & state sh-legacy
  test-srv-legacy : Text = "server ch legacy-not-fefd " & state srv-legacy & " control-outs=" & show (list-length (st2.es-out))
  test-srv-fields : Text = "server ch legacy-cookie-1 outs=" & show (list-length (srv-cookie-field.es-out)) & " suite-1302 outs=" & show (list-length (srv-suite.es-out)) & " compression-1 outs=" & show (list-length (srv-compression.es-out)) & " control-outs=" & show (list-length (st2.es-out))
  test-hrr-fields : Text = "client hrr suite-1302 outs=" & show (list-length (hrr-bad.es-out)) & " then-genuine outs=" & show (list-length (hrr-then.es-out)) & " compression-1 outs=" & show (list-length (hrr-comp.es-out)) & " control-outs=" & show (list-length (st3.es-out))
  test-hrr-again : Text = "client hrr again same outs=" & show (list-length (hrr-dup.es-out)) & " then " & state (hrr-flight hrr-dup) & " other outs=" & show (list-length (hrr-other.es-out)) & " alert=" & alert-of hrr-other & " then " & state (hrr-flight hrr-other)
  test-hrr-exts : Text = "client hrr outs: rebuilt-unchanged=" & dhrr-outs (dhrr-plus []) & " server-name=" & dhrr-outs (dhrr-plus [0, 0, 0, 0]) & " key-share-x25519=" & dhrr-outs (dhrr-plus [0, 51, 0, 2, 0, 29]) & " cookie-twice=" & dhrr-outs (dhrr-plus [0, 44, 0, 3, 0, 1, 9]) & " empty-cookie=" & dhrr-outs (dhrr-wrap (dtls13-hrr-body [] []))
  test-srv-sealed : Text = "server sealed client-hello " & srv-sealed-row (c-seal dtls-hs-client-hello (seq-at d3 25 (list-length d3 - 25))) & " certificate " & srv-sealed-row (c-seal dtls-hs-certificate [0, 0, 0, 0])
  test-cli-sealed : Text = "client sealed server-hello " & cli-sealed-row (s-seal dtls-hs-server-hello dsh-body) & " certificate-request " & cli-sealed-row (s-seal 13 [0, 0, 0])
  test-packed : Text = "client packed flight " & state packed-all & " three then " & state (dtls-ep-recv (packed-three.es-ep) d-fin 43) & " finished-then-more " & state packed-fin-more & " alert=" & alert-of packed-fin-more
  test-nst : Text = "client new-session-ticket " & nst-row
  test-dchf : Text = "server ch outs: session-id-33=" & dch-outs (dch-wrap dch-sid33) & " suites-odd=" & dch-outs (dch-wrap dch-suites-odd)
  test-dchks : Text = "server ch outs: client-shares-length-plus-1=" & dch-outs (dch-wrap (dch-shares-len 1)) & " minus-1=" & dch-outs (dch-wrap (dch-shares-len (0 - 1)))
  test-dchvec : Text = "server ch outs: versions-vector-past=" & dch-outs (dch-wrap (dch-vec-past 43 0 1)) & " sigalgs-vector-past=" & dch-outs (dch-wrap (dch-vec-past 13 1 2))
 The client's Finished resealed at message_seq s, to a fresh server that has sent its flight (built from the same
 two ClientHello records, so its keys are st4's and no row shares its record).

  fresh-flight : Integer -> DtlsEp
  fresh-flight (k) =
    let sv = dtls-ep-with-cert (dtls-ep-new True s-priv s-random cookie-secret client-addr) [leaf-cert] leaf-priv leaf-pub
    in (dtls-ep-recv ((dtls-ep-recv sv d1 10).es-ep) d3 30).es-ep

  cfin-seq : Integer -> List Integer
  cfin-seq (s) =
    let body = seq-at (open-c d-cfin) 12 (list-length (open-c d-cfin) - 12)
    in list-at (dtls-ep-seal-into (dtls-ep-keys ((st8.es-ep).ep-c-hs)) [] 9 dtls-hs-finished s body) 0

  open-c : List Integer -> List Integer
  open-c (rec) =
    when dtls-open (dtls-ep-keys ((st8.es-ep).ep-c-hs)) 0 rec
      is None -> []
      is Just (p) -> p.dp-content

  test-cfin-seq : Text = "server client-finished seq-3 done=" & show (dtls-ep-done ((dtls-ep-recv (fresh-flight 0) (cfin-seq 3) 50).es-ep)) & " seq-2 done=" & show (dtls-ep-done ((dtls-ep-recv (fresh-flight 0) (cfin-seq 2) 50).es-ep))
  test-plain-epoch : Text = "server plaintext ch outs: epoch-0=" & dch-outs d1 & " epoch-1=" & dch-outs (set-at d1 4 1)
  test-limit : Text = "client send outs at 16777215=" & limit-outs 16777215 False & " 16777216=" & limit-outs 16777216 False & " 16777216-twice=" & limit-outs 16777216 True & " 23726566=" & limit-outs 23726566 False
  test-near : Text = "client app-in after record 65535 at 65534=" & near-in 65534 65535 & " 65536 at 65535=" & near-in 65535 65536 & " 131072 at 131071=" & near-in 131071 131072
  test-big-rec : Text = "client app-in after one record of 16384=" & big-in 16384 & " 16385=" & big-in 16385
  test-one-dgram : Text = "client flight in one datagram " & state one-dgram & " server-hello then junk then flight " & state junk-tail
  test-dchx : Text = "server ch outs: rebuilt-unchanged=" & dch-outs (dch-plus [] 0) & " versions-twice=" & dch-outs (dch-plus [0, 43, 0, 3, 2, 254, 252] 0) & " extensions-length-past-body=" & dch-outs (dch-plus [] 1)
  test-cv-bad : Text = "client certificate-verify byte-past-signature " & cv-row (cvb & [0]) & " scheme-0401 " & cv-row (set-at (set-at cvb 0 4) 1 1)
  test-cert-bad : Text = "client certificate empty " & cli-sealed-row (s-seal dtls-hs-certificate [0, 0, 0, 0]) & " entry-past-message " & cli-sealed-row (s-seal dtls-hs-certificate [0, 0, 0, 3, 0, 0, 9])
  test-control : Text = "control client " & state st8 & " server-done=" & show (dtls-ep-done (st9.es-ep))
  test-srv-late : Text = "server late-hello " & state srv-late
  test-cli-late : Text = "client late-hello " & state cli-late
  test-mistyped : Text = "client mistyped-hello then " & state mt8
  test-alert-type : Text = "client hello-in-alert then " & state ca8
  test-resent : Text = "client resent-hello then " & state rt8
  test-other-key : Text = "client other-key-hello then " & state sk8
  test-plain-cert : Text = "client plaintext-certificate then " & state pc8
  test-srv-early : Text = "server record-before-keys " & state srv-early
  test-cli-early : Text = "client record-before-keys " & state cli-early
  test-flight-len : Text = "server flight records=" & show (list-length (st4.es-out))
  test-no-ee : Text = "client certificate-before-ee " & state ne6 & " alert=" & alert-of ne6 & " then " & state ne8
  test-ee-key-share : Text = "client ee key-share " & state kb & " alert=" & alert-of kb
  test-ee-twice : Text = "client ee resent then " & state (dup-flight (with-ee st5))
  test-cert-again : Text = "client certificate resent then " & state rc8
  test-al-close : Text = "client close_notify then data " & app-state (alert-then-data [1, 0])
  test-al-fatal : Text = "client fatal alert then data " & app-state (alert-then-data [2, 40])
  test-al-cancel : Text = "client user_canceled then data " & app-state (alert-then-data [1, 90])
  test-al-hs : Text = "client hs-epoch fatal alert then " & state (dtls-ep-recv (dtls-ep-recv ((with-ee hs-alert).es-ep) d-cert 41).es-ep d-cv 42)
  test-ty-99 : Text = "client record type-99 then data " & app-state (type-then-data 99) & " alert=" & alert-of (dtls-ep-recv (st8.es-ep) (app-seal 0 99 [0, 0]) 60)
  test-ty-ack : Text = "client record ack then data " & app-state (type-then-data 26)
  test-ty-hs-app : Text = "client hs-epoch application-data alert=" & alert-of hs-app & " then " & state (dtls-ep-recv (dtls-ep-recv ((with-ee hs-app).es-ep) d-cert 41).es-ep d-cv 42)
  test-dshx : Text = "client sh keys: rebuilt-unchanged=" & dsh-keys (dsh-plus []) & " server-name=" & dsh-keys (dsh-plus [0, 0, 0, 0]) & " alpn=" & dsh-keys (dsh-plus [0, 16, 0, 0]) & " versions-twice=" & dsh-keys (dsh-plus [0, 43, 0, 2, 254, 252])
  test-ku : Text = "client key-update " & ku-row (ku-msg 1 [0])
  test-ku-value : Text = "client key-update value-2 " & ku-row (ku-msg 1 [2])
  test-ku-len : Text = "client key-update length-2 " & ku-row (ku-msg 2 [0, 0])
  test-ku-req : Text = "key-update requested loopback " & kur-row 0
  test-ku-old : Text = "client key-update old epoch " & old-epoch-row
  test-msg-seq : Text = "client message_seq " & no-hrr-fin & " " & two-ku
  test-bad-sfin : Text = "client zero server-finished " & state bad-sfin & " alert=" & alert-of bad-sfin
  test-bad-cfin : Text = "server zero client-finished " & state bad-cfin & " alert=" & alert-of bad-cfin
  test-al-plain-early : Text = "client plaintext fatal alert before keys then server hello keys=" & show (list-length (((dtls-ep-recv ((dtls-ep-recv (st3.es-ep) (dtls-plain-encode 21 0 5 [2, 40]) 35).es-ep) d-sh 40).es-ep).ep-c-hs))
  test-al-plain : Text = "client plaintext fatal alert after server hello then " & state (dtls-ep-recv (dtls-ep-recv ((with-ee plain-alert).es-ep) d-cert 41).es-ep d-cv 42)

