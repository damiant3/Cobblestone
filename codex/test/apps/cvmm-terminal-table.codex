 The banner follows the views: with nothing found each device line says none,
 and with a NIC, one USB device and a 1024x768 mode each line reports it.

Section: Report

 The composers' lines, then the same lines rendered through the terminal and
 read back: every e and the digit 5 must survive the cell writer (CVMM-3).

  tt-show : Text, NetworkManagerState, UsbManagerState, DisplayManagerState -> [Console] Nothing
  tt-show (tag) (nm) (um) (dm) = act
    print-line-uni (tag & ": " & tl-nic-line nm)
    print-line-uni (tag & ": " & tl-usb-line um)
    print-line-uni (tag & ": " & tl-display-line dm)
  end

Section: Entry
  opening : [Console] Nothing = act
    let nm = nm-add-nic net-manager-new (nic-new "eth0" "e1000" NicEthernet "52:54:00:ab:cd:ef")
    in let um = __record-set (um-add-device usb-manager-new (usb-device-new "kbd0" "USB Keyboard" UcHid SpeedFull)) "um-host-controllers" 1
    in let full = term-from-views nm um (dm-from-mode 1024 768)
    in act
      tt-show "empty" net-manager-new usb-manager-new (dm-from-mode 0 0)
      tt-show "found" nm um (dm-from-mode 1024 768)
      print-line-uni ("banner rows " & show (list-length (full.term-lines)))
      print-line-uni ("rendered 1: " & text-trim (term-line-to-text (list-at (full.term-lines) 1)))
      print-line-uni ("rendered 2: " & text-trim (term-line-to-text (list-at (full.term-lines) 2)))
      print-line-uni ("rendered 3: " & text-trim (term-line-to-text (list-at (full.term-lines) 3)))
      print-line-uni ("rendered e5: " & text-trim (term-line-to-text (list-at ((term-writeln (terminal-new 3 20) "e5 e").term-lines) 0)))
    end
  end