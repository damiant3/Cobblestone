  prefix : Integer -> List Integer
  prefix (n) = prefix-loop n 0 []

  prefix-loop : Integer, Integer, List Integer -> List Integer
  prefix-loop (n) (i) (acc) =
    if i >= n then acc
    else if i >= list-length test-font-bytes then acc
    else prefix-loop n (i + 1) (list-push acc (list-at test-font-bytes i))

  row : Text, Integer -> Text
  row (label) (n) =
    let bytes = prefix n
    in let f = ttf-parse bytes
    in label & " bytes=" & show (list-length bytes) & " upem=" & show (f.tf-head.th-units-per-em) & " glyphs=" & show (f.tf-num-glyphs) & " render=" & format-ttf-bitmap-font (ttf-to-bitmap-font f 16 "t")

