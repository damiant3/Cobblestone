  prefix : Integer -> List Integer
  prefix (n) = prefix-loop n 0 []

  prefix-loop : Integer, Integer, List Integer -> List Integer
  prefix-loop (n) (i) (acc) =
    if i >= n then acc
    else if i >= list-length test-font-bytes then acc
    else prefix-loop n (i + 1) (list-push acc (list-at test-font-bytes i))

  row : Text, Integer -> Text
  row (label) (n) =
    let bytes = prefix n
    in let f = ttf-parse bytes
    in label & " bytes=" & show (list-length bytes) & " upem=" & show (f.tf-head.th-units-per-em) & " glyphs=" & show (f.tf-num-glyphs) & " render=" & format-ttf-bitmap-font (ttf-to-bitmap-font f 16 "t")

 A seeded single-byte mutation sweep over the valid font, run through
 ttf-parse (the table directory and head parse, the length-parsing core).
 ttf-byte-at answers 0 past the end, so every read is in bounds; the sweep
 completing confirms no parser escapes that accessor and traps. The render
 path is exercised by the truncation arms above.

  tt-mutate : List Integer, Integer, Integer, Integer, Integer, List Integer -> List Integer
  tt-mutate (xs) (pos) (v) (i) (n) (acc) =
    if i >= n then acc
    else tt-mutate xs pos v (i + 1) n (list-push acc (if i == pos then bit-xor (list-at xs i) v else list-at xs i))

  tt-sweep : Integer, Integer, Integer -> Integer
  tt-sweep (pos) (n) (acc) =
    if pos >= n then acc
    else let f = ttf-parse (tt-mutate test-font-bytes pos (1 + (pos * 37 - (pos * 37 / 255) * 255)) 0 n [])
    in tt-sweep (pos + 1) n (acc + f.tf-num-glyphs + f.tf-head.th-units-per-em)

