    print-line-uni (row "04-eleven" 11)
    print-line-uni (row "05-offset-table" 12)
    print-line-uni (row "06-thirty" 30)
    print-line-uni (row "07-sixty" 60)
    print-line-uni (row "08-in-head" 240)
    print-line-uni (row "09-one-short" 355)
    print-line-uni ("10-upem-intact " & show ((ttf-parse test-font-bytes).tf-head.th-units-per-em))
    print-line-uni ("11-parse-sweep completed=" & (if tt-sweep 0 (list-length test-font-bytes) 0 >= 0 then "True" else "False"))
  end

