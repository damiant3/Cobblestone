Chapter: SparkNoiseTest

Section: Noise Hash

  test-noise-hash : Integer, Integer, Integer -> Integer
  test-noise-hash (x) (y) (seed) =
    let h1 = x * 374761393 + y * 668265263 + seed * 1274126177
    in let h2 = h1 * h1 / 1000 + h1
    in int-mod h2 1000

Section: Body

  opening : [Console] Nothing = act
    let h1 = test-noise-hash 10 20 42
    in let h2 = test-noise-hash 10 20 42
    in let h3 = test-noise-hash 11 20 42
    in print-line-uni ("hash deterministic: " & if h1 == h2 then "yes" else "no")
    print-line-uni ("hash varies: " & if h1 == h3 then "no" else "yes")
    print-line-uni ("hash non-zero: " & if h1 == 0 then "no" else "yes")

    let h4 = test-noise-hash 0 0 0
    in let h5 = test-noise-hash 100 100 100
    in print-line-uni ("range check: " & if h4 >= 0 then "ok" else "fail")
    print-line-uni ("different seeds: " & if h4 == h5 then "no" else "yes")

    print-line-uni "noise ok"
  end
