Chapter: IdentityMutualAuth

 Two children are labelled by the parent through identity-set-proc,
 then each is read back by pid. Labelling another process needs both
 Identity and Capability; spawning needs Concurrent.

Section: Body
  alice-body : Integer -> Integer
  alice-body (x) = poke-byte 28000 0 (process-get-pid)

  bob-body : Integer -> Integer
  bob-body (x) = poke-byte 28008 0 (process-get-pid)

  verdict : Integer, Integer -> [Identity] Text
  verdict (alice) (bob) =
    let wa = process-wait alice
    in let wb = process-wait bob
    in if identity-get-proc (peek-byte 28000 0) 0 /= 111 then "FAIL: alice identity wrong"
    else if identity-get-proc (peek-byte 28008 0) 0 /= 222 then "FAIL: bob identity wrong"
    else "PASS: mutual authentication"

  opening : [Console, Concurrent, Identity, Capability] Nothing = act
    alice <- process-spawn (\x -> alice-body x)
    sa <- identity-set-proc alice 0 111
    bob <- process-spawn (\x -> bob-body x)
    sb <- identity-set-proc bob 0 222
    print-line-uni (verdict alice bob)
  end
