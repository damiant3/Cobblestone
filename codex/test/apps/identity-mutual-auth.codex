Chapter: IdentityMutualAuth

Section: Body
  opening : [Console] Nothing = act
    let alice-key = 111
    in let bob-key = 222
    in let alice = process-spawn (\x ->
      poke-byte 28000 0 (process-get-pid))
    in let sa = identity-set-proc alice 0 alice-key
    in let bob = process-spawn (\x ->
      poke-byte 28008 0 (process-get-pid))
    in let sb = identity-set-proc bob 0 bob-key
    in let wa = process-wait alice
    in let wb = process-wait bob
    in let alice-pid = peek-byte 28000 0
    in let bob-pid = peek-byte 28008 0
    in let alice-id = identity-get-proc alice-pid 0
    in let bob-id = identity-get-proc bob-pid 0
    in if alice-id == alice-key then if bob-id == bob-key then
      print-line "PASS: mutual authentication"
    else print-line "FAIL: bob identity wrong"
    else print-line "FAIL: alice identity wrong"
  end
