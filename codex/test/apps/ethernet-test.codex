Chapter: EthernetTest
  cites Foreword chapter Console
  cites Net chapter Ethernet

Section: Helpers

  show-list-items : List Integer, Integer, Integer, Text -> Text
  show-list-items (xs) (i) (n) (acc) =
    if i >= n then acc
    else let sep = if i == 0 then "" else " "
    in show-list-items xs (i + 1) n (acc & sep & show (list-at xs i))

Section: Entry

  opening : [Console] Nothing =
    let dst = mac-bytes 1 2 3 4 5 6
    in let src = mac-bytes 10 20 30 40 50 60
    in let payload = [1, 2, 3]
    in let frame = eth-build-frame dst src eth-type-ipv4 payload
    in let parsed-dst = eth-dst-mac frame
    in let parsed-src = eth-src-mac frame
    in let parsed-et = eth-ethertype frame
    in let parsed-pl = eth-payload frame
    in let l1 = "dst=" & show (mac-equal parsed-dst dst)
    in let l2 = "src=" & show (mac-equal parsed-src src)
    in let l3 = "ethertype=" & show parsed-et
    in let l4 = "payload=" & show (list-length parsed-pl) & " " & show-list-items parsed-pl 0 (list-length parsed-pl) ""
    in let src-ip = ip-bytes 192 168 1 10
    in let tgt-ip = ip-bytes 10 0 0 1
    in let arp-frame = arp-build-request src src-ip tgt-ip
    in let arp-et = eth-ethertype arp-frame
    in let arp-payload = eth-payload arp-frame
    in let arp-pkt = arp-parse arp-payload
    in let l5 = "arp-ethertype=" & show arp-et
    in let l6 = "arp-op=" & show (arp-pkt.op)
    in let l7 = "arp-sender-ip=" & show (ip-equal (arp-pkt.sender-ip) src-ip)
    in let l8 = "arp-target-ip=" & show (ip-equal (arp-pkt.target-ip) tgt-ip)
    in let ip-pkt = ip-build-packet src-ip tgt-ip ip-proto-tcp [99, 100]
    in let l9 = "ip-proto=" & show (ip-proto ip-pkt)
    in let l10 = "ip-src=" & show (ip-equal (ip-src ip-pkt) src-ip)
    in let l11 = "ip-dst=" & show (ip-equal (ip-dst ip-pkt) tgt-ip)
    in let ip-pl = ip-payload ip-pkt
    in let l12 = "ip-payload-len=" & show (list-length ip-pl)
    in let l13 = "ip-total=" & show (ip-total-length ip-pkt)
    in act
      print-line-uni l1
      print-line-uni l2
      print-line-uni l3
      print-line-uni l4
      print-line-uni l5
      print-line-uni l6
      print-line-uni l7
      print-line-uni l8
      print-line-uni l9
      print-line-uni l10
      print-line-uni l11
      print-line-uni l12
      print-line-uni l13
    end

