empty: (no macros defined)
define: True defined look (3 commands) count=1
list: look: mem ; perf ; idt.counts
split: mem | perf | idt.counts
split-empties: mem | perf
split-count: 2
find: mem ; perf ; idt.counts
find-absent: none
redefine: True redefined look (1 commands) count=1
no-name: False refused: a macro needs a name count=0
no-commands: False refused: no commands in body count=0
too-many-commands: False refused: 17 commands, over the 16 limit count=0
filled: 16
table-full: False refused: macro table full (16) count=16
replace-when-full: True redefined m3 (1 commands) count=16
replaced-body: idt.irq
cleared: 0
repeat-ok: ok 3 [mem]
repeat-spaces: ok 2 [disk.sb]
repeat-no-cmd: refused: expected a count and a command, as in 3 mem
repeat-not-number: refused: count is not a number: x
repeat-zero: refused: count must be positive, got 0
repeat-over: refused: count 65 is over the 64 limit
repeat-limit: ok 64 [mem]
