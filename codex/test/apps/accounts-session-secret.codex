Chapter: AccountsSessionSecretTest
  cites Net chapter Accounts
  cites Net chapter WebServer
  cites Foreword chapter Maybe

 SignatureSlippage part E. A session token must not be computable from the
 handle and the login count, which is all `digest (handle | nonce)` was, and a
 server with no secret must refuse to issue one rather than issue that.

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

  ass-state : Text -> AuthState
  ass-state (secret) = AuthState {
    accounts = [Account { acc-id = 1, handle = "ann", display = "Ann", pwhash = hash-pw (salt-for 1) "pw" }],
    sessions = [], next-id = 2, nonce = 1, secret = secret }

  ass-token : Text -> Text
  ass-token (resp) = let parts = text-split resp "\"" in if list-length parts < 4 then "" else list-at parts 3

  ass-known : AuthState, Text -> Boolean
  ass-known (s) (tok) = when whoami s tok is None -> False is Just (a) -> a.acc-id == 1

Section: Body
  opening : [Console] Nothing =
    let bare = auth-login (ass-state "") "ann" "pw"
    in let a = auth-login (auth-keyed (ass-state "") [1, 2, 3, 4]) "ann" "pw"
    in let b = auth-login (auth-keyed (ass-state "") [5, 6, 7, 8]) "ann" "pw"
    in let wrong = auth-login (auth-keyed (ass-state "") [1, 2, 3, 4]) "ann" "nope"
    in let ta = ass-token (a.resp)
    in let tb = ass-token (b.resp)
    in let guessed = digest ("ann|1")
    in act
      print-line-uni ("no secret: " & bare.resp)
      print-line-uni ("wrong password: " & wrong.resp)
      print-line-uni ("keyed login: token of " & show (text-length ta) & " hex, known=" & show-bool (ass-known (a.astate) ta))
      print-line-uni ("handle-and-count token known=" & show-bool (ass-known (a.astate) guessed))
      print-line-uni ("two seeds give two tokens=" & show-bool (ta /= tb))
      print-line-uni ("logout forgets the token=" & show-bool (ass-known ((auth-logout (a.astate) ta).astate) ta == False))
    end
