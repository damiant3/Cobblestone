Chapter: StateMachineTest
  cites Game chapter StateMachine

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-new : Text =
    let sm = sm-new 0
    in "current=" & show (sm-current sm) & " states=" & show (sm.num-states)

  test-add-states : Text =
    let sm = sm-add-state (sm-add-state (sm-new 0) 0 "idle" 0 0) 1 "run" 0 0
    in "states=" & show (sm.num-states) & " name=" & sm-current-name sm

  test-transition : Text =
    let sm0 = sm-new 0
    in let sm1 = sm-add-state sm0 0 "idle" 0 0
    in let sm2 = sm-add-state sm1 1 "run" 0 0
    in let sm3 = sm-add-transition sm2 0 1 1 0
    in let r = sm-fire sm3 1
    in "after=" & show (sm-current (r.machine)) & " moved=" & show-bool (r.transitioned)

  test-no-match : Text =
    let sm = sm-add-transition (sm-add-state (sm-new 0) 0 "idle" 0 0) 0 1 0 0
    in let r = sm-fire sm 99
    in "stays=" & show (sm-current (r.machine)) & " moved=" & show-bool (r.transitioned)

  opening : [Console] Nothing = act
    print-line-uni test-new
    print-line-uni test-add-states
    print-line-uni test-transition
    print-line-uni test-no-match
  end
