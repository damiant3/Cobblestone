Chapter: UefiConsoleTest

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites UI chapter Event
  cites UI chapter KeyInput
  cites Works chapter UefiConsole

 The rework is worth stating because the test has to encode it. **This
 chapter is named for UEFI and has not read a UEFI key in a long time.**
 After ExitBootServices there is no system table, so a UefiKey is filled
 from `poll-key`, which speaks `UI chapter KeyInput`: a character is its
 CCE code point and an editing key is a named constant at or above
 `key-named-base` (1048576). The predicates used to compare against
 UEFI's own scan numbering and its left/right shift-state pairs, and
 poll-key has never produced either, so they were dead code that read
 exactly like working code.

 So the old fixtures were not merely misnamed, they were all wrong:
 `enter` was 13, `escape` was a UEFI scan code, and Ctrl+C was ASCII 3.
 Not one of them can satisfy the predicate it was named for now.

Section: Key Fixtures

  uct-key : Integer, Integer -> UefiKey
  uct-key (raw) (mods) =
    UefiKey {
      scan-code = raw,
      char-code = raw,
      shift-state = bit-or mods uefi-shift-valid
    }

  uct-key-unvalidated : Integer, Integer -> UefiKey
  uct-key-unvalidated (raw) (mods) =
    UefiKey { scan-code = raw, char-code = raw, shift-state = mods }

  uct-none : Integer = 0

Section: Predicate Reporting

  uct-flag : Boolean, Text -> Text
  uct-flag (b) (name) = if b then name & " " else ""

  uct-describe : UefiKey -> Text
  uct-describe (k) =
    uct-flag (uefi-key-is-char k) "char"
    & uct-flag (uefi-key-is-enter k) "enter"
    & uct-flag (uefi-key-is-backspace k) "backspace"
    & uct-flag (uefi-key-is-tab k) "tab"
    & uct-flag (uefi-key-is-escape k) "escape"
    & uct-flag (uefi-key-is-arrow-up k) "up"
    & uct-flag (uefi-key-is-arrow-down k) "down"
    & uct-flag (uefi-key-is-arrow-left k) "left"
    & uct-flag (uefi-key-is-arrow-right k) "right"
    & uct-flag (uefi-key-is-home k) "home"
    & uct-flag (uefi-key-is-end k) "end"
    & uct-flag (uefi-key-is-insert k) "insert"
    & uct-flag (uefi-key-is-delete k) "delete"
    & uct-flag (uefi-key-is-page-up k) "pgup"
    & uct-flag (uefi-key-is-page-down k) "pgdn"
    & uct-flag (uefi-key-has-shift k) "+shift"
    & uct-flag (uefi-key-has-ctrl k) "+ctrl"
    & uct-flag (uefi-key-has-alt k) "+alt"
    & uct-flag (uefi-key-is-ctrl-c k) "ctrl-c"
    & uct-flag (uefi-key-is-ctrl-s k) "ctrl-s"
    & uct-flag (uefi-key-is-ctrl-alt-del k) "ctrl-alt-del"

  uct-report : Text, UefiKey -> [Console] Nothing
  uct-report (label) (k) = print-line-uni (label & "=" & uct-describe k)

Section: Body

  opening : [Console] Nothing =
    act
      uct-report "letter-a" (uct-key (char-code 'a') uct-none)
      uct-report "letter-Z" (uct-key (char-code 'Z') uct-none)
      uct-report "digit-7" (uct-key (char-code '7') uct-none)
      uct-report "enter" (uct-key key-enter uct-none)
      uct-report "backspace" (uct-key key-backspace uct-none)
      uct-report "tab" (uct-key key-tab uct-none)
      uct-report "escape" (uct-key key-escape uct-none)
      uct-report "up" (uct-key key-up uct-none)
      uct-report "down" (uct-key key-down uct-none)
      uct-report "left" (uct-key key-left uct-none)
      uct-report "right" (uct-key key-right uct-none)
      uct-report "home" (uct-key key-home uct-none)
      uct-report "end" (uct-key key-end uct-none)
      uct-report "delete" (uct-key key-delete uct-none)
      uct-report "pgup" (uct-key key-pgup uct-none)
      uct-report "pgdn" (uct-key key-pgdn uct-none)
      uct-report "insert-has-no-key" (uct-key 1048582 uct-none)

 The modifier bits are poll-mods bits (shift 1, ctrl 2, alt 4), not
 UEFI's left/right pairs. The old test passed `uefi-left-shift` (2) for
 a shift, which is `mod-ctrl` in this numbering -- so the fixture that
 was meant to say shift said ctrl.

      uct-report "shift-A" (uct-key (char-code 'A') mod-shift)
      uct-report "alt-a" (uct-key (char-code 'a') mod-alt)
      uct-report "ctrl-alt-a" (uct-key (char-code 'a') (bit-or mod-ctrl mod-alt))

      uct-report "ctrl-c-lower" (uct-key (char-code 'c') mod-ctrl)
      uct-report "ctrl-c-upper" (uct-key (char-code 'C') mod-ctrl)
      uct-report "ctrl-s" (uct-key (char-code 's') mod-ctrl)
      uct-report "plain-c-no-ctrl" (uct-key (char-code 'c') uct-none)
      uct-report "ctrl-x-is-neither" (uct-key (char-code 'x') mod-ctrl)

      uct-report "cad-valid" (uct-key key-delete (bit-or mod-ctrl mod-alt))
      uct-report "cad-unvalidated" (uct-key-unvalidated key-delete (bit-or mod-ctrl mod-alt))
      uct-report "cad-no-alt" (uct-key key-delete mod-ctrl)

 `uefi-key-is-char` is now "not a named key, and not zero". The old
 boundaries here were 31/32/126/127, an ASCII printable-range check on a
 value that is no longer ASCII -- in CCE that band is a slice through
 punctuation and accented letters and excludes every ASCII letter. The
 boundaries that mean something now are zero, an ordinary code point,
 and the named-key base.

      print-line-uni ("char-of-zero=" & show (uefi-key-is-char (uct-key 0 uct-none)))
      print-line-uni ("char-of-letter=" & show (uefi-key-is-char (uct-key (char-code 'a') uct-none)))
      print-line-uni ("char-below-named-base=" & show (uefi-key-is-char (uct-key 1048575 uct-none)))
      print-line-uni ("char-at-named-base=" & show (uefi-key-is-char (uct-key key-named-base uct-none)))
      print-line-uni ("char-of-enter=" & show (uefi-key-is-char (uct-key key-enter uct-none)))
      print-line-uni ("attr-yellow-on-blue=" & show (uefi-attr UefiYellow UefiBlue))
      print-line-uni ("attr-black-on-black=" & show (uefi-attr UefiBlack UefiBlack))
      print-line-uni ("attr-white-on-white=" & show (uefi-attr UefiWhite UefiWhite))
      print-line-uni ("pixel=" & show (uefi-pixel-pack (uefi-pixel 255 128 64)))
      print-line-uni ("pixel-black=" & show (uefi-pixel-pack (uefi-pixel 0 0 0)))
    end
