Chapter: UefiConsoleTest
  cites UI chapter Widget
  cites UI chapter Layout

Section: Body
  opening : [Console] Nothing =
    let items = ["Boot Codex OS", "Boot Recovery", "Boot Diagnostics", "Firmware Setup", "Network Boot", "USB Boot", "Shell", "Power Off", "Restart", "Boot Manager", "Secure Boot", "UEFI Drivers", "About"]
    in let menu = widget-menu "uefi-menu" items
    in let count = menu.wn-child-count
    in let tabs = widget-tabs "boot-tabs" ["General", "Advanced", "Security"] 0
    in let sel-idx = 0
    in act
      print-line-uni ("menu-items=" & show count)
      print-line-uni ("selected=" & show sel-idx)
      print-line-uni "uefi-console:done"
    end

