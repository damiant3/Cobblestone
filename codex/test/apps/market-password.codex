Chapter: MarketPassword
  cites Market chapter MarketTypes
  cites Market chapter MarketDb
  cites Market chapter MarketAuth
  cites Foreword chapter Hmac
  cites Foreword chapter Sha256
  cites Foreword chapter Maybe

  report : Text, Boolean -> [Console] Nothing
  report (label) (ok) = print-line-uni (label & "=" & (if ok then "yes" else "no"))

  merchant : Text = default-store-config.store-merchant-id

  registered : List User
  registered =
    let st = market-init default-store-config
    in let (st2, alice) = register-user st "alice@codex.dev" "Alice" "hunter2" 100
    in let (st3, bob) = register-user st2 "bob@codex.dev" "Bob" "hunter2" 100
    in [alice, bob]

  legacy : Text = hmac-sha256-hex (text-to-bytes merchant) (text-to-bytes "hunter2")

  flip-last : Text -> Text
  flip-last (s) =
    let n = text-length s
    in substring s 0 (n - 1) & (if substring s (n - 1) 1 == "0" then "1" else "0")

  flip-first-hash : Text -> Text
  flip-first-hash (s) =
    let n = text-length s
    in substring s 0 (n - 64) & (if substring s (n - 64) 1 == "0" then "1" else "0") & substring s (n - 63) 63

  drop-two : Text -> Text
  drop-two (s) = substring s 0 (text-length s - 2)

  weakened : Text -> Text
  weakened (s) = "pbkdf2-sha256$1$" & substring s 20 (text-length s - 20)

  run-pair : List User -> [Console] Nothing
  run-pair (us) = run (list-at us 0) (list-at us 1)

  run : User, User -> [Console] Nothing
  run (alice) (bob) = act
    report "right-password" (verify-password "hunter2" merchant (alice.user-pass-hash))
    report "wrong-password-refused" (verify-password "hunter3" merchant (alice.user-pass-hash) == False)
    report "per-user-salt" (alice.user-pass-hash /= bob.user-pass-hash)
    report "work-factor-scheme" (text-starts-with (alice.user-pass-hash) "pbkdf2-sha256$20000$")
    report "last-byte-refused" (verify-password "hunter2" merchant (flip-last (alice.user-pass-hash)) == False)
    report "first-byte-refused" (verify-password "hunter2" merchant (flip-first-hash (alice.user-pass-hash)) == False)
    report "truncated-refused" (verify-password "hunter2" merchant (drop-two (alice.user-pass-hash)) == False)
    report "low-iterations-refused" (verify-password "hunter2" merchant (weakened (alice.user-pass-hash)) == False)
    report "placeholder-refused" (verify-password "hunter2" merchant "sha256:placeholder" == False)
    report "empty-refused" (verify-password "" merchant "" == False)
    report "legacy-right" (verify-password "hunter2" merchant legacy)
    report "legacy-wrong-refused" (verify-password "hunter3" merchant legacy == False)
    report "legacy-other-store-refused" (verify-password "hunter2" "other-merchant" legacy == False)
    report "legacy-last-byte-refused" (verify-password "hunter2" merchant (flip-last legacy) == False)
    migration alice
  end

  carol : User = User { user-id = "usr-9", user-email = "carol@codex.dev", user-name = "Carol", user-pass-hash = legacy, user-role = RoleCustomer, user-created = 1, user-last-login = 1 }

  migrated-ok : Maybe User -> Boolean
  migrated-ok (moved) = when moved
    is Just (u) -> text-starts-with (u.user-pass-hash) "pbkdf2-sha256$" & verify-password "hunter2" merchant (u.user-pass-hash) & u.user-last-login == 200
    is None -> False

  migration : User -> [Console] Nothing
  migration (alice) = act
    report "migrated" (migrated-ok (migrate-password-hash carol "hunter2" merchant 200))
    report "migrate-wrong-refused" (is-none (migrate-password-hash carol "hunter3" merchant 200))
    report "migrate-current-skipped" (is-none (migrate-password-hash alice "hunter2" merchant 200))
  end

  opening : [Console] Nothing
  opening = run-pair registered