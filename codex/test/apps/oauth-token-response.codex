Chapter: OAuthTokenResponse
  cites Net chapter OAuthClient
  cites Foreword chapter Console

 RFC 6749 section 5.1: a successful token response carries access_token and
 token_type, and token_type is case-insensitive; section 7.1: a client does not
 use a token whose type it does not understand, and this client sends only
 Bearer. Section 5.2: an error response carries error.

Section: Helpers

  q : Text = char-to-text (code-to-char (from-unicode 34))

  field : Text, Text -> Text
  field (k) (v) = q & k & q & ":" & q & v & q

  obj2 : Text, Text -> Text
  obj2 (a) (b) = "{" & a & "," & b & "}"

  report : Text, Text -> Text
  report (name) (body) =
    when oauth-parse-tokens body
      is OAuthSuccess (t) -> name & " ok access=" & t.ot-access-token & " type=" & t.ot-token-type
      is OAuthError (e) (d) -> name & " error=" & e

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (report "bearer       " (obj2 (field "access_token" "abc") (field "token_type" "Bearer")))
    print-line-uni (report "bearer-lower " (obj2 (field "access_token" "abc") (field "token_type" "bearer")))
    print-line-uni (report "no-access    " (obj2 (field "refresh_token" "r") (field "token_type" "Bearer")))
    print-line-uni (report "empty-access " (obj2 (field "access_token" "") (field "token_type" "Bearer")))
    print-line-uni (report "no-type      " (obj2 (field "access_token" "abc") (field "scope" "openid")))
    print-line-uni (report "mac-type     " (obj2 (field "access_token" "abc") (field "token_type" "mac")))
    print-line-uni (report "error        " (obj2 (field "error" "invalid_grant") (field "token_type" "Bearer")))
    print-line-uni (report "not-json     " "nope")
  end

