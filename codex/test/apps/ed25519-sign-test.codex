Chapter: Ed25519 Sign Test
  cites Foreword chapter Console
  cites Foreword chapter Ed25519
  cites Foreword chapter Sha512

 RFC 8032 section 7.1 test vectors 1 through 3. Ed25519 signing is
 deterministic, therefore each signature must equal the published
 bytes exactly. Verification must accept each genuine signature and
 must reject both a wrong message and a wrong public key. The negative
 cases never mutate a signature in place, because list-set-at aliases
 its source on the bump allocator.

Section: Vectors

  t1-sk : List Integer = [157, 97, 177, 157, 239, 253, 90, 96, 186, 132, 74, 244, 146, 236, 44, 196, 68, 73, 197, 105, 123, 50, 105, 25, 112, 59, 172, 3, 28, 174, 127, 96]

  t2-sk : List Integer = [76, 205, 8, 155, 40, 255, 150, 218, 157, 182, 195, 70, 236, 17, 78, 15, 91, 138, 49, 159, 53, 171, 166, 36, 218, 140, 246, 237, 79, 184, 166, 251]

  t3-sk : List Integer = [197, 170, 141, 244, 63, 159, 131, 123, 237, 183, 68, 47, 49, 220, 183, 177, 102, 211, 133, 53, 7, 111, 9, 75, 133, 206, 58, 46, 11, 68, 88, 247]

Section: Entry

  opening : [Console] Nothing = act
    let pk1 = ed25519-public-key t1-sk
    in let sig1 = ed25519-sign t1-sk pk1 []
    in let pk2 = ed25519-public-key t2-sk
    in let sig2 = ed25519-sign t2-sk pk2 [114]
    in let pk3 = ed25519-public-key t3-sk
    in let sig3 = ed25519-sign t3-sk pk3 [175, 130]
    in let v-good = if ed25519-verify pk1 [] sig1 then "verify-good=pass" else "verify-good=fail"
    in let v-wrong-msg = if ed25519-verify pk1 [114] sig1 then "verify-wrong-msg=fail" else "verify-wrong-msg=pass"
    in let v-wrong-key = if ed25519-verify pk2 [] sig1 then "verify-wrong-key=fail" else "verify-wrong-key=pass"
    in act
      print-line-uni (bytes-to-hex sig1)
      print-line-uni (bytes-to-hex sig2)
      print-line-uni (bytes-to-hex sig3)
      print-line-uni v-good
      print-line-uni v-wrong-msg
      print-line-uni v-wrong-key
    end
  end

