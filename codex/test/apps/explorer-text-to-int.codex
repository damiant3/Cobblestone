Chapter: ExplorerTextToInt
  cites Explorer chapter ExplorerTheme
  cites Foreword chapter Parse

Section: Entry
  opening : [Console] Nothing
  opening = act
   print-line-uni ("42 -> " & show (text-to-int "42"))
   print-line-uni ("7 -> " & show (text-to-int "7"))
   print-line-uni ("-15 -> " & show (text-to-int "-15"))
  end
