Chapter: Csv Guard
  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Encode chapter Csv

Section: Helpers

  row-text : List Text, Integer, Text -> Text
  row-text (fs) (i) (acc) =
    if i >= list-length fs then acc
    else row-text fs (i + 1) (if i == 0 then list-at fs i else acc & "/" & list-at fs i)

  rows-text : List (List Text), Integer, Text -> Text
  rows-text (rs) (i) (acc) =
    if i >= list-length rs then acc
    else rows-text rs (i + 1) (if i == 0 then row-text (list-at rs i) 0 "" else acc & " ; " & row-text (list-at rs i) 0 "")

  arm : Text, Text -> Text
  arm (name) (s) =
    let raw = "raw=[" & rows-text (csv-parse s) 0 "" & "]"
    in when csv-parse-checked s
      is Just (rows) -> name & " ok [" & rows-text rows 0 "" & "] " & raw
      is None -> name & " refused " & raw

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (arm "simple" "a,b\nc,d")
    print-line-uni (arm "quoted-comma" "\"c,d\",e")
    print-line-uni (arm "doubled" "\"x\"\"y\"")
    print-line-uni (arm "trailing-comma" "a,")
    print-line-uni (arm "empty" "")
    print-line-uni (arm "quote-then-comma" "\"ab\",cd")
    print-line-uni (arm "unterminated" "\"abc")
    print-line-uni (arm "after-quote" "\"ab\"cd")
    print-line-uni (arm "quote-in-field" "a\"b")
  end
