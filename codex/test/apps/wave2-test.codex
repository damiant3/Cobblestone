Chapter: Wave2Test
  cites Foreword chapter Tuple
  cites Foreword chapter Deque
  cites Foreword chapter Rope
  cites Game chapter FloodFill
  cites Game chapter Voronoi
  cites Math chapter Complex
  cites AI chapter DecisionTree
  cites Encode chapter Bencode
  cites Foreword chapter Maybe
  cites Foreword chapter Hamt
  cites Foreword chapter CCE

Section: Body

  test-deque : Text =
    let dq = deque-push-front (deque-push-back (deque-push-back (deque-new 8) 10) 20) 5
    in let (val1, dq1, ok1) = deque-pop-front dq
    in let (val2, dq2, ok2) = deque-pop-back dq1
    in "front=" & show val1 & " back=" & show val2 & " remain=" & show (deque-count dq2)

  test-rope : Text =
    let a = rope-from "Hello"
    in let b = rope-from " World"
    in let c = rope-concat a b
    in "len=" & show (rope-length c) & " text=" & rope-flatten c

  test-flood-fill : Text =
    let g = ff-set (ff-set (ff-new 5 5 0) 2 2 1) 2 3 1
    in let g2 = flood-fill g 0 0 9
    in "filled=" & show (ff-count-value g2 9) & " unfilled=" & show (ff-count-value g2 0)

  test-voronoi : Text =
    let seeds = [VoronoiSeed { vs-x = 1, vs-y = 1, vs-id = 0 }, VoronoiSeed { vs-x = 8, vs-y = 8, vs-id = 1 }]
    in let vm = voronoi-generate 10 10 seeds
    in "r0=" & show (voronoi-region-count vm 0) & " r1=" & show (voronoi-region-count vm 1) & " at(0,0)=" & show (voronoi-get vm 0 0) & " at(9,9)=" & show (voronoi-get vm 9 9)

  test-complex : Text =
    let a = cx-new 3000 4000
    in let b = cx-new 1000 2000
    in let prod = cx-mul a b
    in let mag = cx-magnitude a
    in "mul=" & format-complex prod & " |a|=" & show mag

  test-mandelbrot : Text =
    let inside = cx-mandelbrot-escape (cx-new 0 0) 100
    in let outside = cx-mandelbrot-escape (cx-new 2000 0) 100
    in "origin=" & show inside & " edge=" & show outside

  test-decision-tree : Text =
    let tree = dt-new [dt-split 0 500 1 2, dt-leaf 0, dt-split 1 300 3 4, dt-leaf 1, dt-leaf 2]
    in let c1 = dt-predict tree [200, 0]
    in let c2 = dt-predict tree [700, 100]
    in let c3 = dt-predict tree [700, 500]
    in "c1=" & show c1 & " c2=" & show c2 & " c3=" & show c3 & " depth=" & show (dt-depth tree) & " leaves=" & show (dt-leaf-count tree)

  test-bencode : Text =
    let v = BenDict [BenPair { ben-key = "name", ben-val = BenStr "codex" }, BenPair { ben-key = "ver", ben-val = BenInt 1 }]
    in let encoded = ben-encode v
    in let decoded = ben-decode encoded
    in "enc=" & encoded & " ok=" & show (decoded.ben-ok)

  opening : [Console] Nothing = act
    print-line-uni test-deque
    print-line-uni test-rope
    print-line-uni test-flood-fill
    print-line-uni test-voronoi
    print-line-uni test-complex
    print-line-uni test-mandelbrot
    print-line-uni test-decision-tree
    print-line-uni test-bencode
  end
