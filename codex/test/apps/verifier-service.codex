Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

  test-sk : List Integer = [157, 97, 177, 157, 239, 253, 90, 96, 186, 132, 74, 244, 146, 236, 44, 196, 68, 73, 197, 105, 123, 50, 105, 25, 112, 59, 172, 3, 28, 174, 127, 96]

  phase-name : VerifyPhase -> Text
  phase-name (p) = when p
    is PhaseIntegrity -> "integrity"
    is PhaseAuthor -> "author"
    is PhaseCapabilities -> "capabilities"
    is PhaseEffects -> "effects"
    is PhaseProofs -> "proofs"

Section: Body
  opening : [Console] Nothing =
    let good-bin = cdx-encode-signed (CdxBinaryParts {
      flags = cdx-flag-bare-metal,
      capabilities = [
        CdxCapability { cap-id = cdx-cap-console, direction = cdx-dir-write, scope = "/", max-duration = 0 }
      ],
      effects = ["Console"],
      text-bytes = [144, 195],
      rodata-bytes = [],
      entry-offset = 0,
      stack-size = 65536,
      heap-size = 65536,
      trust-threshold = 5000
    }) test-sk
    in let author-key = read-author-key good-bin
    in let lat = lattice-add-direct lattice-empty author-key 8000
    in let policy = policy-add-rule (policy-empty "test") (rule-allow "allow-console" (CapabilityMatch "Console" 2))
    in let r-good = verify-cdx good-bin lat policy 0
    in let r-bad = verify-integrity [1, 2, 3]
    in let pass = if r-good.accepted & r-bad.accepted == False then "PASS" else "FAIL"
    in act
      print-line-uni ("GOOD: " & show-bool (r-good.accepted) & " at " & phase-name (r-good.phase))
      print-line-uni ("BAD: " & show-bool (r-bad.accepted) & " at " & phase-name (r-bad.phase) & " - " & r-bad.reason)
      print-line-uni pass
    end

