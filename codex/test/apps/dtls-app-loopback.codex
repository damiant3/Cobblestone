  cal-now : List Integer = [50, 48, 50, 53, 48, 49, 48, 49, 48, 48, 48, 48, 48, 48]

  ca-parsed : Maybe X509Cert = x509-parse ca-cert

  anchors : List X509Anchor =
    when ca-parsed is None -> [] is Just (c) -> [X509Anchor { xa-subject = c.xc-subject, xa-key = c.xc-key }]

  s0 : DtlsEp = dtls-ep-with-cert (dtls-ep-new True s-priv s-random cookie-secret client-addr) [leaf-cert] leaf-priv leaf-pub
  peer-name : List Integer =
    [100, 101, 118, 105, 99, 101, 46, 99, 111, 100, 101, 120, 46, 116, 101, 115, 116]

  c0 : DtlsEp = dtls-ep-with-anchors (dtls-ep-new False c-priv c-random [] []) anchors cal-now peer-name

  c-msg : List Integer = [104, 105]
  s-msg : List Integer = [79, 75]

  copy-bytes : List Integer -> List Integer
  copy-bytes (bs) = cb-loop bs 0 (list-length bs) []
  cb-loop : List Integer, Integer, Integer, List Integer -> List Integer
  cb-loop (bs) (i) (n) (acc) =
    if i >= n then acc else cb-loop bs (i + 1) n (list-push acc (list-at bs i))

Section: Entry

 The handshake shuttles datagrams between the two endpoints exactly as the
 authenticated loopback does; d-sh is the plaintext ServerHello and
 d-cert/d-cv/d-fin are the epoch-2 protected server flight. After both sides
 are done, a payload goes each way at epoch 3, and a tampered copy of the
 client's record is refused.

  opening : [Console] Nothing =
    let st1 = dtls-ep-client c0 0
    in let d1 = list-at (st1.es-out) 0
    in let st2 = dtls-ep-recv s0 d1 10
    in let d2 = list-at (st2.es-out) 0
    in let st3 = dtls-ep-recv (st1.es-ep) d2 20
    in let d3 = list-at (st3.es-out) 0
    in let st4 = dtls-ep-recv (st2.es-ep) d3 30
    in let d-sh = list-at (st4.es-out) 0
    in let d-cert = list-at (st4.es-out) 1
    in let d-cv = list-at (st4.es-out) 2
    in let d-fin = list-at (st4.es-out) 3
    in let st5 = dtls-ep-recv (st3.es-ep) d-sh 40
    in let st6 = dtls-ep-recv (st5.es-ep) d-cert 41
    in let st7 = dtls-ep-recv (st6.es-ep) d-cv 42
    in let st8 = dtls-ep-recv (st7.es-ep) d-fin 43
    in let d-cfin = list-at (st8.es-out) 0
    in let st9 = dtls-ep-recv (st4.es-ep) d-cfin 50
    in let cs = dtls-ep-send-app (st8.es-ep) c-msg
    in let creq = list-at (cs.es-out) 0
    in let creq-bad = list-set-at (copy-bytes creq) 6 (bit-xor (list-at creq 6) 1)
    in let svb = dtls-ep-recv (st9.es-ep) creq-bad 60
    in let tamper-len = list-length (dtls-ep-app-in (svb.es-ep))
    in let sv = dtls-ep-recv (st9.es-ep) creq 60
    in let server-in = dtls-ep-app-in (sv.es-ep)
    in let c2s-len = list-length server-in
    in let c2s-b0 = list-at server-in 0
    in let c2s-b1 = list-at server-in 1
    in let ss = dtls-ep-send-app (sv.es-ep) s-msg
    in let sresp = list-at (ss.es-out) 0
    in let cc = dtls-ep-recv (cs.es-ep) sresp 61
    in let client-in = dtls-ep-app-in (cc.es-ep)
    in act
      print-line-uni ("app c2s len=" & show c2s-len & " b0=" & show c2s-b0 & " b1=" & show c2s-b1)
      print-line-uni ("app s2c len=" & show (list-length client-in) & " b0=" & show (list-at client-in 0) & " b1=" & show (list-at client-in 1))
      print-line-uni ("app encrypted=" & show (dtls-is-record (list-at creq 0)))
      print-line-uni ("app hs-encrypted=" & show (dtls-is-record (list-at d-cert 0)) & " sh-plain=" & show (dtls-is-record (list-at d-sh 0) == False))
      print-line-uni ("app tamper len=" & show tamper-len)
    end
