Chapter: ChannelTest
  cites Codex chapter General
  cites Foreword chapter Channel
  cites Foreword chapter Maybe

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-new : Text =
    let ch = chan-create 4 0
    in "empty=" & show-bool (chan-is-empty ch) & " full=" & show-bool (chan-is-full ch)

  test-send-recv : Text =
    let ch = chan-create 4 0
    in let sr = chan-try-send ch 42
    in let rr = chan-try-recv (sr.chan)
    in when (rr.value)
      is Just (v) -> "val=" & show v & " empty-after=" & show-bool (chan-is-empty (rr.chan))
      is None -> "no-value"

  test-size : Text =
    let sr1 = chan-try-send (chan-create 4 0) 1
    in let sr2 = chan-try-send (sr1.chan) 2
    in "size=" & show (chan-size (sr2.chan))

  opening : [Console] Nothing = act
    print-line-uni test-new
    print-line-uni test-send-recv
    print-line-uni test-size
  end
