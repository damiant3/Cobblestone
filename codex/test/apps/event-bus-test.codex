Chapter: EventBusTest
  cites Foreword chapter Console
  cites Observe chapter EventBus

Section: Entry

  opening : [Console] Nothing =
    let b0 = bus-empty
    in let l1 = bus-stats b0
    in let b1 = bus-subscribe b0 "logger" "msg"
    in let b2 = bus-subscribe b1 "logger" "err"
    in let b3 = bus-subscribe b2 "monitor" "err"
    in let b4 = bus-publish b3 "writer" "msg" "hello world"
    in let b5 = bus-publish b4 "writer" "err" "disk full"
    in let b6 = bus-publish b5 "system" "msg" "heartbeat"
    in let l2 = bus-stats b6
    in let logger-evts = bus-events-for b6 "logger"
    in let monitor-evts = bus-events-for b6 "monitor"
    in let l3 = "logger=" & show (list-length logger-evts) & " monitor=" & show (list-length monitor-evts)
    in let since1 = bus-events-since b6 1
    in let since2 = bus-events-since b6 2
    in let l4 = "since1=" & show (list-length since1) & " since2=" & show (list-length since2)
    in let b7 = bus-unsubscribe b6 "logger" "msg"
    in let b8 = bus-unsubscribe b7 "logger" "err"
    in let b9 = bus-publish b8 "x" "err" "test"
    in let l5 = "subs=" & show (bus-sub-count b9) & " events=" & show (list-length (bus-events-for b9 "monitor"))
    in let b10 = bus-publish bus-empty "a" "t" "p1"
    in let b11 = bus-publish b10 "a" "t" "p2"
    in let l6a = "before=" & show (bus-event-count b11)
    in let b12 = bus-drain b11
    in let l6 = l6a & " after=" & show (bus-event-count b12) & " seq=" & show (b12.next-seq)
    in let ev0 = list-at (bus-events-for b6 "logger") 0
    in let l7 = "topic=" & ev0.topic & " src=" & ev0.source & " payload=" & ev0.payload & " seq=" & show (ev0.sequence)
    in act
      print-line-uni l1
      print-line-uni l2
      print-line-uni l3
      print-line-uni l4
      print-line-uni l5
      print-line-uni l6
      print-line-uni l7
    end

