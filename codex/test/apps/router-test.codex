Chapter: RouterTest
  cites Net chapter Router
  cites Foreword chapter Maybe

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-empty : Text =
    "routes=" & show (router-count router-empty)

  test-add : Text =
    let r1 = router-get router-empty "/" "home-svc"
    in let r2 = router-get r1 "/status" "status-svc"
    in let r3 = router-post r2 "/submit" "submit-svc"
    in "routes=" & show (router-count r3)

  test-match : Text =
    let r1 = router-get router-empty "/" "home"
    in let r2 = router-get r1 "/status" "status"
    in let m1 = router-match r2 "GET" "/"
    in let m2 = router-match r2 "GET" "/status"
    in "m1=" & m1.handler.service & " m2=" & m2.handler.service

  test-no-match : Text =
    let r = router-get router-empty "/" "home"
    in let m = router-match r "GET" "/missing"
    in "matched=" & show-bool (m.matched)

  test-method : Text =
    let r1 = router-get router-empty "/data" "get-svc"
    in let r2 = router-post r1 "/data" "post-svc"
    in let mg = router-match r2 "GET" "/data"
    in let mp = router-match r2 "POST" "/data"
    in "get=" & mg.handler.service & " post=" & mp.handler.service

  test-wildcard : Text =
    let r = router-add router-empty "GET" "*" "catch-all"
    in let m = router-match r "GET" "/anything"
    in "matched=" & show-bool (m.matched) & " svc=" & m.handler.service

  test-prefix : Text =
    let r = router-get router-empty "/api/*" "api-svc"
    in let m1 = router-match r "GET" "/api/users"
    in let m2 = router-match r "GET" "/other"
    in "api=" & show-bool (m1.matched) & " other=" & show-bool (m2.matched)

  test-format : Text =
    let h = RouteHandler { path = "/status", method = "GET", service = "status-svc" }
    in format-route h

  opening : [Console] Nothing = act
    print-line-uni test-empty
    print-line-uni test-add
    print-line-uni test-match
    print-line-uni test-no-match
    print-line-uni test-method
    print-line-uni test-wildcard
    print-line-uni test-prefix
    print-line-uni test-format
  end
