Chapter: JsonEmitStrings
  cites Foreword chapter Console
  cites Foreword chapter CCE
  cites Encode chapter Json
  cites Works chapter WebRoute

  js-fixture : Text
  js-fixture = "quote\" slash\\ line\nnull" & char-to-text (code-to-char 0) & " café À Ω 中"

  opening : [Console] Nothing = act
    print-line-uni (json-quote js-fixture)
    print-line-uni (jstr js-fixture)
    print-line-uni (json-emit (json-object [json-pair js-fixture (json-str js-fixture)]))
    print-line-uni (web-not-found js-fixture)
    print-line-uni (json-quote "")
    print-line-uni (json-quote "\"\\\n\"\\")
  end

