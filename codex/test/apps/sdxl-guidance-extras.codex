  cites Diffusion chapter SdxlGuidanceReference

 One guided SDXL denoiser call (ti-den at CFG 5, sigma 3, a 16 x 16 latent)
 without extras, with FreeU (SDXL preset), SAG (Forge's defaults), PAG (scale
 3), all three, dynamic thresholding (mimic 2) and all four (percentile
 0.95), each graded against build/sdxl-guidance-oracle.py, which runs Forge's
 sampling_function_inner with the extensions' own code: L2 error within 1.5%
 of the reference's. Measured 2026-09-30: 0.57% without extras, 0.60 to
 0.79% with one, 0.89% with all three (CFG 5 and PAG 3 multiply the UNet's
 own differences); PAG answering v at SAG's key as well gives 8.4%. The
 sabotages are no extras against all three (61%) and all three without
 dynamic thresholding against all four (5.4% between the references).

 We say:

Section: Inputs

  latent-at : Integer -> Real
  latent-at (i) = real-from-int (int-mod (i * 37 + 11) 257 - 128) / 128.0

  value-at : Integer, Integer -> Real
  value-at (which) (i) = if which == 0 then latent-at i else if which == 1 then real-from-int (int-mod (i * 13 + 5) 251 - 125) / 256.0 else if which == 2 then real-from-int (int-mod (i * 29 + 3) 241 - 120) / 256.0 else if which == 3 then real-from-int (int-mod (i * 17 + 3) 239 - 119) / 256.0 else real-from-int (int-mod (i * 23 + 7) 233 - 116) / 256.0

  build : Integer, Integer, Integer, List Real -> List Real
  build (which) (i) (n) (acc) = if i >= n then acc else build which (i + 1) n (list-push acc (value-at which i))

Section: Grading

  abs : Real -> Real
  abs (x) = if x < 0.0 then 0.0 - x else x

  sum-sq : List Real, Integer, Real -> Real
  sum-sq (xs) (i) (acc) = if i >= list-length xs then acc else sum-sq xs (i + 1) (acc + list-at xs i * list-at xs i)

  diff-sq : List Real, List Real, Integer, Real -> Real
  diff-sq (a) (b) (i) (acc) = if i >= list-length b then acc else diff-sq a b (i + 1) (acc + (list-at a i - list-at b i) * (list-at a i - list-at b i))

  grade : List Real, List Real -> Text
  grade (got) (ref) =
    let rr = sum-sq ref 0 0.0 / real-from-int (list-length ref)
    in let rg = if list-length got == 0 then 0.0 else sum-sq got 0 0.0 / real-from-int (list-length got)
    in if list-length got /= list-length ref then "NO OUTPUT"
    else "L2 error " & (if diff-sq got ref 0 0.0 <= 0.000225 * sum-sq ref 0 0.0 then "within 1.5%" else "PAST 1.5%") & ", rms " & (if abs (rg - rr) <= 0.02 * rr then "near" else "FAR")

  arm : UNetFile, List Real, Integer, Integer, Integer, Integer, TiExtras, List Real, Text -> Text
  arm (u) (tab) (yc) (cc) (yu) (cu) (ex) (ref) (what) =
    let x = un-upload (build 0 0 1024 [])
    in let c = TiCfg { tc-unet = u, tc-tab = tab, tc-yc = yc, tc-cc = cc, tc-yu = yu, tc-cu = cu, tc-h = 16, tc-w = 16, tc-cfg = 5.0, tc-sd15 = False, tc-extras = ex, tc-kc = 77, tc-ku = 77 }
    in let d = ti-den c x 3.0
    in let got = if d == 0 then [] else un-download d 1024
    in let f = un-free (un-free 0 d) x
    in what & ": " & grade got ref

  arm3 : UNetFile, List Real, Integer, Integer, Integer, Integer, TiExtras, List Real, Text -> Text
  arm3 (u) (tab) (yc) (cc) (yu) (cu) (ex) (ref) (what) =
    let x = un-upload (build 0 0 1024 [])
    in let ub = gpu-buf-alloc (1024 * 4)
    in let c = TiCfg { tc-unet = u, tc-tab = tab, tc-yc = yc, tc-cc = cc, tc-yu = yu, tc-cu = cu, tc-h = 16, tc-w = 16, tc-cfg = 5.0, tc-sd15 = False, tc-extras = ex, tc-kc = 77, tc-ku = 77 }
    in let d = ti-den3 c x 3.0 ub
    in let got = if d == 0 then [] else un-download d 1024
    in let f = un-free (un-free (un-free 0 d) x) ub
    in what & ": " & grade got ref

Section: Entry

  run-all : Integer -> List Text
  run-all (z) =
    let u = unet-open "dreamshaperXL_lightningDPMSDE.safetensors"
    in if (u.uf-file).st-valid == False then ["SKIP: no dreamshaperXL_lightningDPMSDE.safetensors under the model root build-output/diffusion-models"]
    else run-arms (unet-load u)

  run-arms : UNetFile -> List Text
  run-arms (u) =
    let tab = unet-log-sigmas 0
    in let cc = un-upload (build 1 0 157696 [])
    in let yc = un-upload (build 2 0 2816 [])
    in let cu = un-upload (build 3 0 157696 [])
    in let yu = un-upload (build 4 0 2816 [])
    in let fu = [1.3, 1.4, 0.9, 0.2]
    in let sg = [0.5, 2.0, 1.0]
    in let a0 = arm u tab yc cc yu cu ti-no-extras sgr-plain "no extras"
    in let a1 = arm u tab yc cc yu cu (TiExtras { tx-freeu = fu, tx-pag = 0.0, tx-sag = [], tx-dt = [], tx-step = [] }) sgr-freeu "FreeU"
    in let a2 = arm u tab yc cc yu cu (TiExtras { tx-freeu = [], tx-pag = 0.0, tx-sag = sg, tx-dt = [], tx-step = [] }) sgr-sag "SAG"
    in let a3 = arm u tab yc cc yu cu (TiExtras { tx-freeu = [], tx-pag = 3.0, tx-sag = [], tx-dt = [], tx-step = [] }) sgr-pag "PAG"
    in let a4 = arm u tab yc cc yu cu (TiExtras { tx-freeu = fu, tx-pag = 3.0, tx-sag = sg, tx-dt = [], tx-step = [] }) sgr-all "FreeU, SAG and PAG"
    in let a5 = arm u tab yc cc yu cu ti-no-extras sgr-all "sabotage, no extras against all three"
    in let d1 = DtSet { dt-mimic = 2.0, dt-pct = 1.0, dt-mimic-mode = 0, dt-mimic-min = 0.0, dt-cfg-mode = 0, dt-cfg-min = 0.0, dt-sched = 1.0, dt-sep = True, dt-zero = False, dt-std = False, dt-phi = 1.0 }
    in let d2 = DtSet { dt-mimic = 2.0, dt-pct = 0.95, dt-mimic-mode = 0, dt-mimic-min = 0.0, dt-cfg-mode = 0, dt-cfg-min = 0.0, dt-sched = 1.0, dt-sep = True, dt-zero = False, dt-std = False, dt-phi = 1.0 }
    in let a6 = arm u tab yc cc yu cu (TiExtras { tx-freeu = [], tx-pag = 0.0, tx-sag = [], tx-dt = [d1], tx-step = [] }) sgr-dt "dynamic thresholding"
    in let a7 = arm u tab yc cc yu cu (TiExtras { tx-freeu = fu, tx-pag = 3.0, tx-sag = sg, tx-dt = [d2], tx-step = [] }) sgr-dtall "all four"
    in let a8 = arm u tab yc cc yu cu (TiExtras { tx-freeu = fu, tx-pag = 3.0, tx-sag = sg, tx-dt = [], tx-step = [] }) sgr-dtall "sabotage, all three without dynamic thresholding against all four"
    in let a9 = arm3 u tab yc cc yu cu (TiExtras { tx-freeu = fu, tx-pag = 3.0, tx-sag = sg, tx-dt = [d2], tx-step = [] }) sgr-dtall "all four through the DDIM CFG++ denoiser"
    in let a10 = arm u tab yc cc yu cu (gated 0.3 0.7) sgr-plain "FreeU gated off at Euler's first call, start 0.3, against no extras"
    in let a11 = arm u tab yc cc yu cu (gated 0.0 1.0) sgr-freeu "FreeU gated on at Euler's first call, start 0, against FreeU"
    in let a12 = arm u tab yc cc yu cu (gated 0.3 0.7) sgr-freeu "control, FreeU gated off against FreeU"
    in [a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12]

 FreeU with its step window, launched as Euler over 11 steps (ti-launch).

  gated : Real, Real -> TiExtras
  gated (a) (b) =
    let ex = TiExtras { tx-freeu = [1.3, 1.4, 0.9, 0.2, a, b], tx-pag = 0.0, tx-sag = [], tx-dt = [], tx-step = [0, 0, 0, 1] }
    in let l = ti-launch ex ti-euler 11
    in ex

  print-all : List Text, Integer -> [Console] Nothing
  print-all (ls) (i) =
    if i >= list-length ls then act
      print-uni ""
    end
    else act
      print-line-uni (list-at ls i)
      print-all ls (i + 1)
    end

  opening : [Console] Integer
  opening = act
    print-all (run-all 0) 0
    let r = 0 in r
  end
