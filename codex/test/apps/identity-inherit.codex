Chapter: IdentityInherit

Section: Body
  opening : [Console] Nothing = act
    let s0 = identity-set 0 42
    in let s1 = identity-set 1 99
    in let pid = process-spawn (\x ->
      let w0 = identity-whoami 0
      in let w1 = identity-whoami 1
      in if w0 == 42 then if w1 == 99 then poke-byte 28000 0 1
        else poke-byte 28000 0 2
      else poke-byte 28000 0 3)
    in let wt = process-wait pid
    in let result = peek-byte 28000 0
    in if result == 1 then print-line "PASS: child inherited identity"
    else print-line "FAIL: child did not inherit"
  end
