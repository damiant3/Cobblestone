Chapter: HMAC Test

  cites Foreword chapter Console
  cites Foreword chapter Hmac
  cites Foreword chapter Sha256

Section: Definitions

  make-key : Integer, Integer, List Integer -> List Integer
  make-key (val) (n) (acc) =
    if n <= 0 then acc
    else make-key val (n - 1) (list-push acc val)

  opening : [Console] Nothing = act
    print-line-uni (hmac-sha256-hex (make-key 11 20 []) [72, 105, 32, 84, 104, 101, 114, 101])
    print-line-uni (hmac-sha256-hex [74, 101, 102, 101] [119, 104, 97, 116, 32, 100, 111, 32, 121, 97, 32, 119, 97, 110, 116, 32, 102, 111, 114, 32, 110, 111, 116, 104, 105, 110, 103, 63])
    print-line-uni (hmac-sha256-hex (make-key 170 131 []) [84, 101, 115, 116, 32, 85, 115, 105, 110, 103, 32, 76, 97, 114, 103, 101, 114, 32, 84, 104, 97, 110, 32, 66, 108, 111, 99, 107, 45, 83, 105, 122, 101, 32, 75, 101, 121, 32, 45, 32, 72, 97, 115, 104, 32, 75, 101, 121, 32, 70, 105, 114, 115, 116])
    print-line-uni (hmac-sha256-hex (make-key 1 32 []) [])
  end

