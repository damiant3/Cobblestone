Chapter: AnnotationQueryTest
  cites Works chapter Annotation
  cites Works chapter AnnotationsQuery
  cites Works chapter AnnotationsSidecar
  cites Foreword chapter Console

Section: Fixture

  aqt-json : Text
  aqt-json = "[{\"target\": \"function:pe-uefi-stub\", \"kind\": \"rationale\", \"author\": \"cam\", \"date\": \"2026-05-06\", \"body\": \"Stub is self-measuring.\", \"thread\": null}, {\"target\": \"function:pe-scan-hlt\", \"kind\": \"warning\", \"author\": \"cam\", \"date\": \"2026-05-06\", \"body\": \"Pattern breaks silently if the tick address moves.\", \"thread\": null}]"

Section: Entry

  opening : [Console] Nothing = act
    let xs = annq-parse "Emit/PeWriter" aqt-json
    in let warns = annq-by-kind xs "warning"
    in let byt = annq-by-target xs "function:pe-uefi-stub"
    in act
      print-line-uni ("parsed=" & show (annq-count xs))
      print-line-uni ("warning=" & show (annq-count-of-kind xs "warning"))
      print-line-uni ("rationale=" & show (annq-count-of-kind xs "rationale"))
      print-line-uni ("bytarget=" & show (list-length byt))
      print-line-uni ("path=" & sidecar-path-for "codex" "Emit/PeWriter")
      print-line-uni (annq-render warns)
    end
  end

