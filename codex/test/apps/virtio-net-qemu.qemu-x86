# One QEMU boot per arm, in order.
modern -netdev user,id=n0 -device virtio-net-pci,disable-legacy=on,netdev=n0,mac=52:54:00:12:34:56
transitional -netdev user,id=n0 -device virtio-net-pci,disable-legacy=off,disable-modern=off,netdev=n0,mac=52:54:00:12:34:56
legacy -netdev user,id=n0 -device virtio-net-pci,disable-modern=on,netdev=n0,mac=52:54:00:12:34:56
absent -net none
