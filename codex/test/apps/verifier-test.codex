Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

  test-sk : List Integer = [157, 97, 177, 157, 239, 253, 90, 96, 186, 132, 74, 244, 146, 236, 44, 196, 68, 73, 197, 105, 123, 50, 105, 25, 112, 59, 172, 3, 28, 174, 127, 96]

Section: Body
  opening : [Console] Nothing =
    let binary = cdx-encode-signed (CdxBinaryParts {
      flags = cdx-flag-bare-metal,
      capabilities = [
        CdxCapability { cap-id = cdx-cap-console, direction = cdx-dir-write, scope = "/", max-duration = 0 }
      ],
      effects = ["Console"],
      text-bytes = [144, 195],
      rodata-bytes = [],
      entry-offset = 0,
      stack-size = 65536,
      heap-size = 65536,
      trust-threshold = 5000
    }) test-sk
    in let magic-ok = cdx-verify-magic binary
    in let hash-ok = cdx-verify-content-hash binary
    in let author-key = read-author-key binary
    in let lattice = lattice-add-direct lattice-empty author-key 8000
    in let policy = policy-add-rule (policy-empty "test") (rule-allow "allow-console" (CapabilityMatch "Console" 2))
    in let p2 = verify-author binary lattice 5000
    in let p3 = verify-capabilities binary policy lattice 0
    in act
      print-line-uni ("magic=" & show-bool magic-ok & " hash=" & show-bool hash-ok & " author=" & show-bool (p2.accepted) & " caps=" & show-bool (p3.accepted))
    end

