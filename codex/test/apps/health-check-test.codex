Chapter: HealthCheckTest
  cites Observe chapter HealthCheck
  cites Foreword chapter Maybe

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-all-healthy : Text =
    let r = HealthReport { checks = [], check-count = 4, healthy-count = 4, degraded-count = 0, critical-count = 0 }
    in format-health-report r & " system-ok=" & show-bool (is-system-healthy r)

  test-degraded : Text =
    let r = HealthReport { checks = [], check-count = 4, healthy-count = 3, degraded-count = 1, critical-count = 0 }
    in format-health-report r

  test-critical : Text =
    let r = HealthReport { checks = [], check-count = 4, healthy-count = 3, degraded-count = 0, critical-count = 1 }
    in format-health-report r & " system-ok=" & show-bool (is-system-healthy r)

  test-format-status : Text =
    format-status Healthy & " | " & format-status (Degraded "low fuel: 5")

  opening : [Console] Nothing = act
    print-line-uni test-all-healthy
    print-line-uni test-degraded
    print-line-uni test-critical
    print-line-uni test-format-status
  end
