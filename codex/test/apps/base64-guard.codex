Chapter: Base64 Guard
  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Encode chapter Base64

Section: Helpers

  dec-list : List Integer -> Text
  dec-list (bs) = dl bs 0 (list-length bs) ""

  dl : List Integer, Integer, Integer, Text -> Text
  dl (bs) (i) (n) (acc) =
    if i >= n then acc
    else let sep = if i == 0 then "" else " "
    in dl bs (i + 1) n (acc & sep & show (list-at bs i))

  arm : Text, Text -> Text
  arm (name) (s) =
    let raw = "raw=[" & dec-list (base64-decode s) & "]"
    in when base64-decode-checked s
      is Just (bs) -> name & " ok [" & dec-list bs & "] " & raw
      is None -> name & " refused " & raw

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (arm "hello" "aGVsbG8=")
    print-line-uni (arm "two-pad" "aA==")
    print-line-uni (arm "no-pad" "aGVs")
    print-line-uni (arm "empty" "")
    print-line-uni (arm "bad-char" "aG!s")
    print-line-uni (arm "after-pad" "aGk=aGk=")
    print-line-uni (arm "short" "aGk")
    print-line-uni (arm "lone-pad" "a===")
  end
