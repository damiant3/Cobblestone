  ca-parsed : Maybe X509Cert = x509-parse ca-cert

  anchors : List X509Anchor =
    when ca-parsed is None -> [] is Just (c) -> [X509Anchor { xa-subject = c.xc-subject, xa-key = c.xc-key }]

  peer-name : List Integer =
    [100, 101, 118, 105, 99, 101, 46, 99, 111, 100, 101, 120, 46, 116, 101, 115, 116]

Section: Helpers

  tr-eq : List Integer, List Integer -> Boolean
  tr-eq (a) (b) =
    if list-length a /= list-length b then False
    else tr-eq-loop a b 0 (list-length a)

  tr-eq-loop : List Integer, List Integer, Integer, Integer -> Boolean
  tr-eq-loop (a) (b) (i) (n) =
    if i >= n then True
    else if list-at a i /= list-at b i then False
    else tr-eq-loop a b (i + 1) n

  rec-body : List Integer -> List Integer
  rec-body (rec) = dtls-take-at rec 9 (list-length rec - 9)

  ed-only-sigalgs : List Integer = [0, 13, 0, 4, 0, 2, 8, 7]

  ch-ed-only : List Integer -> List Integer
  ch-ed-only (random) =
    let exts = tls-ext-versions & tls-ext-groups & ed-only-sigalgs & tls-ext-key-share-client (x25519-public-key c-priv)
    in [3, 3] & random & [0] & tls-be16 2 & tls-be16 tls-cipher-aes-128-gcm-sha256 & [1, 0] & tls-be16 (list-length exts) & exts

Section: The Server

  s0 : TlsEp = tls-ep-server-new s-priv s-random [leaf-p256-cert] leaf-p256-priv leaf-p256-pub

Section: An Authenticating Client

  c0 : TlsEp = tls-ep-client-new c-priv c-random anchors cal-now peer-name
  cs1 : TlsEpStep = tls-ep-hello c0
  sv1 : TlsEpStep = tls-ep-recv s0 (list-at (cs1.tes-out) 0)

  cv-rec-body : List Integer = list-at (sv1.tes-out) 3

  c1 : TlsEpStep = tls-ep-recv (cs1.tes-ep) (list-at (sv1.tes-out) 0)
  c2 : TlsEpStep = tls-ep-recv (c1.tes-ep) (list-at (sv1.tes-out) 1)
  c3 : TlsEpStep = tls-ep-recv (c2.tes-ep) (list-at (sv1.tes-out) 2)
  c4 : TlsEpStep = tls-ep-recv (c3.tes-ep) (list-at (sv1.tes-out) 3)
  c5 : TlsEpStep = tls-ep-recv (c4.tes-ep) (list-at (sv1.tes-out) 4)
  sv2 : TlsEpStep = tls-ep-recv (sv1.tes-ep) (list-at (c5.tes-out) 0)

  cs2 : TlsEpStep = tls-ep-send-app (c5.tes-ep) [71, 69, 84]
  sv3 : TlsEpStep = tls-ep-recv (sv2.tes-ep) (list-at (cs2.tes-out) 0)

Section: Refusal

  ed-only : TlsEpStep = tls-ep-recv s0 (tls-encode-record tls-content-handshake (tls13-msg-transcript dtls-hs-client-hello (ch-ed-only c-random)))

  ed-server : TlsEp = tls-ep-server-new s-priv s-random [leaf-p256-cert] c-priv (x25519-public-key c-priv)
  ed-accepts : TlsEpStep = tls-ep-recv ed-server (tls-encode-record tls-content-handshake (tls13-msg-transcript dtls-hs-client-hello (ch-ed-only c-random)))

Section: Results

  test-flight : Text = "p256 flight outs=" & show (list-length (sv1.tes-out))
  test-auth : Text = "p256 client-done=" & show (tls-ep-done (c5.tes-ep)) & " authenticated=" & show (tls-ep-authenticated (c5.tes-ep))
  test-server : Text = "p256 server-done=" & show (tls-ep-done (sv2.tes-ep)) & " c2s=" & show (tr-eq (tls-ep-app-in (sv3.tes-ep)) [71, 69, 84])
  test-ed-only : Text = "ed25519-only client outs=" & show (list-length (ed-only.tes-out)) & " alert=" & show (tr-eq (list-at (ed-only.tes-out) 0) [21, 3, 3, 0, 2, 2, 40])
  test-ed-server : Text = "ed25519 server to ed25519-only client outs=" & show (list-length (ed-accepts.tes-out))

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni test-flight
    print-line-uni test-auth
    print-line-uni test-server
    print-line-uni test-ed-only
    print-line-uni test-ed-server
  end
