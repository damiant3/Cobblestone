Section: Report
  cbf-ids : List Integer, Integer, List Text -> Text
  cbf-ids (ids) (i) (acc) =
    if i >= list-length ids then text-concat-list acc
    else if i == 0 then cbf-ids ids (i + 1) (list-push acc (show (list-at ids i)))
    else cbf-ids ids (i + 1) (list-push (list-push acc " ") (show (list-at ids i)))

  cbf-print-all : ClipBpe, List Text, Integer -> [Console] Nothing
  cbf-print-all (t) (prompts) (i) =
    if i >= list-length prompts then act
      print-line-uni ("prompts " & show i)
    end
    else act
      print-line-uni (cbf-ids (clip-bpe-tokenize t (list-at prompts i)) 0 [])
      cbf-print-all t prompts (i + 1)
    end

  cbf-report : ClipBpe -> [Console] Nothing
  cbf-report (t) = act
    print-line-uni ("status " & show (clip-bpe-status t) & " vocab " & show (clip-bpe-vocab-count t) & " merges " & show (clip-bpe-merge-count t))
    print-line-uni (cbf-ids (clip-bpe-with-specials (clip-bpe-tokenize t "a photo of a cat")) 0 [])
    cbf-print-all t cbf-prompts 0
  end

Section: Body
  cbf-run : Integer, Integer -> [Console, Device.Block] Nothing
  cbf-run (vlen) (mlen) =
    let vsec = (vlen + 511) / 512
    in let msec = (mlen + 511) / 512
    in let vbuf = alloc-bytes (vsec * 512)
    in let mbuf = alloc-bytes (msec * 512)
    in act
      v <- fd-load-sectors 1 vsec vbuf 0
      m <- fd-load-sectors (1 + vsec) msec mbuf 0
      cbf-report (clip-bpe-load vbuf vlen mbuf mlen)
    end

  opening : [Console, Device.Block] Nothing
  opening = act
    header <- block-read-sector 0
    cbf-run (peek-32 header 0) (peek-32 header 4)
  end
