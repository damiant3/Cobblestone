Chapter: DeskWindowRestoreSizeTest
  cites Works chapter GopDraw
  cites Works chapter GopDesk
  cites Works chapter GopFont
  cites Foreword chapter Console

 A pane that opens full screen has a normal size SMALLER than maximised, so
 restore has somewhere to go. The Monitor pane is one of the five that open
 maximised; its first open must leave the state maximised and the block
 holding the three-quarter rect, and a second open must not reset either.

 The sabotage: place the full-screen panes at the content box with the state
 left normal, as they were before 2026-09-07, and "normal is smaller" turns no
 while "opens maximised" turns no with it.

Section: Body

  rs-yn : Boolean -> Text
  rs-yn (v) = if v then "yes" else "no"

  rs-row : Integer, Integer, Integer, Integer -> Text
  rs-row (w) (h) (ds) (blk) =
    let st = dk-wnd-st blk
    in let nw = dk-wnd-rw blk w dk-wnd-st-normal ds
    in let nh = dk-wnd-rh blk w h dk-wnd-st-normal ds
    in let mw = dk-wnd-rw blk w dk-wnd-st-max ds
    in let mh = dk-wnd-rh blk w h dk-wnd-st-max ds
    in "w " & integer-to-text w
       & "  opens maximised " & rs-yn (st == dk-wnd-st-max)
       & "  placed " & rs-yn (dk-wnd-placed blk)
       & "  normal is smaller " & rs-yn (nw < mw & nh < mh)
       & "  normal " & integer-to-text nw & "x" & integer-to-text nh
       & "  max " & integer-to-text mw & "x" & integer-to-text mh

  rs-reopen-row : Integer, Integer, Integer, Integer -> Text
  rs-reopen-row (w) (h) (ds) (blk) =
    let restored = poke-32 blk dk-wnd-st-cell dk-wnd-st-normal
    in let again = desk-wnd-open desk-focus-mon w h ds
    in "w " & integer-to-text w
       & "  restore survives a reopen " & rs-yn (dk-wnd-st blk == dk-wnd-st-normal)
       & "  rect kept " & rs-yn (dk-wnd-rw blk w dk-wnd-st-normal ds == dk-cbox-w w ds * 3 / 4)

Section: Entry

  opening : [Console] Nothing =
    let ds = alloc-zeroed dk-ds-bytes 64
    in let ws = alloc-zeroed 64 64
    in let mon = alloc-zeroed 64 64
    in let a = poke-32 ds dk-wr-cell ws
    in let b = poke-32 ds dk-mon-cell mon
    in let o = desk-wnd-open desk-focus-mon 1600 900 ds
    in act
      print-line-uni (rs-row 1600 900 ds mon)
      print-line-uni (rs-reopen-row 1600 900 ds mon)
    end
