Chapter: AnnotationMigrateTest

  cites Foreword chapter Console
  cites Works chapter Annotation

Section: Body

  opening : [Console] Nothing =
    let t = make-target "OldModule" "old-fn"
    in let a = create-annotation t Todo "eve" "migrate to new API" 6000
    in let t2 = make-target "NewModule" "new-fn"
    in let a2 = create-annotation t2 Doctrine "eve" "canonical pattern" 7000
    in let k1 = annotation-kind-name (a.kind)
    in let k2 = annotation-kind-name (a2.kind)
    in act
      print-line-uni ("old=" & target-key t)
      print-line-uni ("new=" & target-key t2)
      print-line-uni ("kinds=" & k1 & "+" & k2)
    end
