Chapter: PolicyProseCheckedTest
  cites Trust chapter PolicyProse

Section: Helpers

  read : Text, Text -> [Console] Nothing
  read (label) (src) =
    let r = compile-policy-checked src
    in print-line-uni (label & ": " & (if r.ok then "read, " & show (list-length r.policy.grants) & " grant(s), " & show (list-length r.policy.denials) & " denial(s), " & show (list-length r.policy.commentary) & " commentary"
      else "refused at line " & show r.line & ", word [" & r.word & "], " & r.reason))

  rule : Text, Text -> [Console] Nothing
  rule (label) (line) = read label ("We say:\n" & line)

  reflect : Text -> Text
  reflect (src) =
    let r = compile-policy-checked src
    in if r.ok then clarifier-reflect r.policy else "refused"

Section: Entry

  opening : [Console] Nothing = act
    rule "row 1, comma then more words" "Jake is permitted to use the chat app, but not after dinner"
    rule "row 2, except" "Jake is never permitted to use the console except on weekends"
    rule "row 3, pronoun" "Jake is permitted to use it on weekends"
    rule "row 4 as written" "Jake may use the chat app for no more than an hour a day"
    rule "row 4, verb rewritten" "Jake is permitted to use \"chat app\" for no more than an hour a day"
    rule "row 4, quota rewritten" "Jake is permitted to use \"chat app\" for no more than 1 hour per day."
    rule "row 5, can" "Jake can use the chat app"
    read "no rule block" "Jake is permitted to use Email.Send."
    read "lower-case marker" "we say:\nJake is permitted to use Email.Send."
    read "commentary before the block" "We love you, buddy.\nWe say:\nJake is permitted to use Email.Send."
    read "commentary inside the block" "We say:\nJake is permitted to use Email.Send.\nWe love you, buddy."
    read "empty block" "We love you, buddy.\nWe say:"
    read "second line refuses the whole" "We say:\nJake is permitted to use Email.Send.\nJake is permitted to use it."
    rule "old grant verb" "Jake may use Email.Send."
    rule "old denial verb" "Jake may never use Email.Send."
    rule "allowed" "Jake is allowed to use Email.Send"
    rule "no to" "Jake is permitted use Email.Send"
    rule "no subject" "is permitted to use Email.Send"
    rule "subject alone" "Jake"
    rule "no capability" "Jake is permitted to use"
    rule "the, then nothing" "Jake is permitted to use the"
    rule "free-text capability" "Jake is permitted to use the flight simulator"
    rule "quoted subject" "\"Jake's agent\" is permitted to use Email.Send."
    rule "unquoted two-word subject" "Jake's agent is permitted to use Email.Send."
    rule "denial" "Jake is never permitted to use Console.Write."
    rule "denial, any circumstances" "Jake is never permitted to use \"real flight controls\" under any circumstances."
    rule "denial with days" "Jake is never permitted to use Console.Write on weekends"
    rule "denial, never without permitted" "Jake is never allowed to use Console.Write"
    rule "omitted slots" "Jake is permitted to use Email.Send."
    rule "always" "Jake is permitted to use Email.Send always."
    rule "always then quota" "Jake is permitted to use Email.Send always, for no more than 1 hour per day."
    rule "always then window" "Jake is permitted to use Email.Send always between 08:00 and 17:00"
    rule "always then days" "Jake is permitted to use Email.Send always on weekends"
    rule "on every day" "Jake is permitted to use Email.Send on every day at any time with no limit."
    rule "on weekdays" "Jake is permitted to use Email.Send on weekdays."
    rule "on weekends" "Jake is permitted to use Email.Send on weekends."
    rule "on one day" "Jake is permitted to use Email.Send on Monday."
    rule "on two days" "Jake is permitted to use Email.Send on Mondays and Fridays."
    rule "on three days" "Jake is permitted to use Email.Send on Monday, Wednesday and Friday."
    rule "Saturdays and Sundays" "Jake is permitted to use Email.Send on Saturdays and Sundays."
    rule "day list, comma, window" "Jake is permitted to use Email.Send on Monday, between 08:00 and 12:00."
    rule "day named twice" "Jake is permitted to use Email.Send on Monday and Monday"
    rule "day list ends at and" "Jake is permitted to use Email.Send on Monday and"
    rule "on alone" "Jake is permitted to use Email.Send on"
    rule "day word" "Jake is permitted to use Email.Send on holidays"
    rule "oxford comma" "Jake is permitted to use Email.Send on Monday, Wednesday, and Friday"
    rule "at any time" "Jake is permitted to use Email.Send at any time."
    rule "window" "Jake is permitted to use Email.Send between 08:00 and 19:00."
    rule "reversed window" "Jake is permitted to use Email.Send between 17:00 and 09:00"
    rule "hour 25" "Jake is permitted to use Email.Send between 25:00 and 26:00"
    rule "with no limit" "Jake is permitted to use Email.Send with no limit."
    rule "quota per session" "Jake is permitted to use Email.Send for no more than 30 minutes per session."
    rule "quota per week" "Jake is permitted to use Email.Send for no more than 2 hours per week"
    rule "quota unit" "Jake is permitted to use Email.Send for no more than 2 days per session"
    rule "approval clause" "Jake is permitted to use Email.Send with approval from Damian when marked urgent."
    rule "approval clause unread" "Jake is permitted to use Email.Send with approval from Damian when sometimes"
    rule "trailing word" "Jake is permitted to use Email.Send on weekends please"
    rule "banned while" "Jake is permitted to use Email.Send while at home"
    print-line-uni (reflect "We say:\nJake is permitted to use \"chat app\" on Friday and Monday between 08:00 and 19:00.")
    print-line-uni (reflect "Commentary for the reader.\nWe say:\n\"Jake's agent\" is permitted to use Email.Send always, for no more than 2 hours per session.\nJake is never permitted to use Console.Write under any circumstances.")
  end

