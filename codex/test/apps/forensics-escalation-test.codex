Chapter: ForensicsEscalationTest
  cites Trust chapter Forensics

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Body
  opening : [Console] Nothing =
    let c = chain-empty "test-agent" 1000
    in let c1 = chain-add-percept c "camera" 90
    in let c2 = chain-add-belief c1 "object detected" 85 [1]
    in let c3 = chain-add-policy c2 "allow-capture" True "image/*"
    in let c4 = chain-add-action c3 "capture" "camera/0" "ok"
    in act
      print-line-uni (show (chain-min-confidence c4))
      print-line-uni (show-bool (chain-below-threshold c4 80))
      print-line-uni (escalation-name (assess-chain c4 80))
      print-line-uni (show-bool (should-escalate (assess-chain c4 80)))
      let low = chain-empty "low-conf" 2000
      in let low1 = chain-add-percept low "sensor" 30
      in let low2 = chain-add-belief low1 "uncertain" 25 [1]
      in act
        print-line-uni (show (chain-min-confidence low2))
        print-line-uni (escalation-name (assess-chain low2 80))
        print-line-uni (show-bool (should-escalate (assess-chain low2 80)))
        let anom = chain-add-anomaly low2 "stop sign" "t-shirt" "visual ambiguity"
        in act
          print-line-uni (escalation-name (assess-chain anom 80))
          print-line-uni (show-bool (should-enter-safe-mode (assess-chain anom 80)))
          print-line-uni (show (chain-anomaly-count anom))
          print-line-uni (show (chain-percept-count anom))
        end
      end
    end

