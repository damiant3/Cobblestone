Chapter: GameQueryCapTest
  cites Games chapter GameQuery
  cites Foreword chapter Console

 The game servers refuse a request whose numeric parameter would trap
 `parse-int-loop`; this pins which request lines that refusal fires on.

  ask : Text, Text -> Text
  ask (label) (line) = label & " " & show (query-overflows line)

  opening : [Console] Nothing = act
    print-line-uni (ask "plain seed      " "GET /api/go/new?seed=42 HTTP/1.1")
    print-line-uni (ask "parse limit     " "GET /api/go/new?seed=9223372036854775759 HTTP/1.1")
    print-line-uni (ask "limit + 1       " "GET /api/go/new?seed=9223372036854775760 HTTP/1.1")
    print-line-uni (ask "i64 max         " "GET /api/go/new?seed=9223372036854775807 HTTP/1.1")
    print-line-uni (ask "19 digits low   " "GET /api/go/new?seed=1000000000000000000 HTTP/1.1")
    print-line-uni (ask "19 nines        " "GET /api/go/new?seed=9999999999999999999 HTTP/1.1")
    print-line-uni (ask "20 digits       " "GET /api/go/new?seed=10000000000000000000 HTTP/1.1")
    print-line-uni (ask "zeros then 1    " "GET /api/go/new?seed=0000000000000000000000001 HTTP/1.1")
    print-line-uni (ask "second param    " "GET /api/backgammon/move?seed=1&roll=12345678901234567890 HTTP/1.1")
    print-line-uni (ask "letter first    " "GET /api/go/new?seed=a1234567890123456789 HTTP/1.1")
    print-line-uni (ask "digits after    " "GET /api/go/new?seed=7x1234567890123456789 HTTP/1.1")
    print-line-uni (ask "max then letter " "GET /api/go/new?seed=9223372036854775808x HTTP/1.1")
    print-line-uni (ask "empty value     " "GET /api/go/new?seed= HTTP/1.1")
    print-line-uni (ask "no query        " "GET /api/status HTTP/1.1")
    print-line-uni (ask "path digits     " "GET /api/1234567890123456789012/new HTTP/1.1")
    print-line-uni (ask "no request line " "")
    print-line-uni "done"
  end
