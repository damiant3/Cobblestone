Chapter: ChatServerSession
  cites Chat chapter ChatServer
  cites Works chapter Http
  cites Foreword chapter Console

Section: Session

  chat-get : Text -> HttpRequest
  chat-get (path) = HttpRequest { method = "GET", path = path, body = "", valid = True }

  host-at : Text, Text -> ChatHost
  host-at (time) (tok) = ChatHost { ch-time = time, ch-token = tok }

  opening : [Console] Nothing
  opening =
    let s0 = chat-state-new
    in let (s1, r1) = chat-route s0 (host-at "09:00" "tok-alice") (chat-get "/api/chat/register?name=alice")
    in let (s2, r2) = chat-route s1 (host-at "09:00" "tok-bob") (chat-get "/api/chat/register?name=bob")
    in let (s3, r3) = chat-route s2 (host-at "09:01" "tok-thief") (chat-get "/api/chat/register?name=alice")
    in let (s4, r4) = chat-route s3 (host-at "09:01" "tok-x") (chat-get "/api/chat/register?name=")
    in let (s5, r5) = chat-route s4 (host-at "09:02" "tok-x") (chat-get "/api/chat/me?t=tok-alice")
    in let (s6, r6) = chat-route s5 (host-at "09:02" "tok-x") (chat-get "/api/chat/me?t=tok-thief")
    in let (s7, r7) = chat-route s6 (host-at "09:03" "tok-x") (chat-get "/api/chat/start?t=tok-alice&with=bob")
    in let (s8, r8) = chat-route s7 (host-at "09:03" "tok-x") (chat-get "/api/chat/start?t=tok-alice&with=bob")
    in let (s9, r9) = chat-route s8 (host-at "09:05" "tok-x") (chat-get "/api/chat/send?t=tok-alice&to=c1&body=hi+bob%21")
    in let (s10, r10) = chat-route s9 (host-at "09:06" "tok-x") (chat-get "/api/chat/send?t=tok-bob&to=c1&body=hello+%22alice%22")
    in let (s11, r11) = chat-route s10 (host-at "09:07" "tok-x") (chat-get "/api/chat/messages?t=tok-bob&conv=c1")
    in let (s12, r12) = chat-route s11 (host-at "09:07" "tok-x") (chat-get "/api/chat/conversations?t=tok-alice")
    in let (s13, r13) = chat-route s12 (host-at "09:08" "tok-x") (chat-get "/api/chat/start?t=tok-alice&with=carol")
    in let (s14, r14) = chat-route s13 (host-at "09:09" "tok-x") (chat-get "/api/chat/group?t=tok-alice&name=team&members=bob,+carol+,alice,,bob")
    in let (s15, r15) = chat-route s14 (host-at "09:10" "tok-x") (chat-get "/api/chat/conversations?t=tok-bob")
    in let (s16, r16) = chat-route s15 (host-at "09:10" "tok-x") (chat-get "/api/chat/messages?t=tok-alice&conv=c9")
    in let (s17, r17) = chat-route s16 (host-at "09:11" "tok-x") (chat-get "/api/chat/send?t=tok-alice&to=c1&body=")
    in let (s18, r18) = chat-route s17 (host-at "09:11" "tok-x") (chat-get "/api/chat/send?t=tok-alice&to=c9&body=lost")
    in let (s19, r19) = chat-route s18 (host-at "09:12" "tok-x") (chat-get "/api/chat/contacts?t=tok-alice")
    in let (s20, r20) = chat-route s19 (host-at "09:12" "tok-x") (chat-get "/api/chat/nope")
    in let (s21, r21) = chat-route s20 (host-at "09:13" "tok-carol") (chat-get "/api/chat/register?name=carol")
    in act
      print-line-uni (r1.body)
      print-line-uni (r2.body)
      print-line-uni (r3.body)
      print-line-uni (r4.body)
      print-line-uni (r5.body)
      print-line-uni (r6.body)
      print-line-uni (r7.body)
      print-line-uni (r8.body)
      print-line-uni (r9.body)
      print-line-uni (r10.body)
      print-line-uni (r11.body)
      print-line-uni (r12.body)
      print-line-uni (r13.body)
      print-line-uni (r14.body)
      print-line-uni (r15.body)
      print-line-uni (r16.body)
      print-line-uni (r17.body)
      print-line-uni (r18.body)
      print-line-uni (r19.body)
      print-line-uni (r20.body)
      print-line-uni (r21.body)
    end
