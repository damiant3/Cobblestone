Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

  base-shell : ShellState
  base-shell = shell-init (policy-empty "codex-os") 100

Section: Tests

  test-initial : Text =
    let os = os-state-new base-shell
    in os-stats os

  test-tick-one-task : Text =
    let os = os-state-new base-shell
    in let os1 = os-submit-task os "svc-a" TaskNormal
    in let tr = os-tick-bsp os1
    in "dispatched=" & show (tr.dispatched) & " " & os-stats (tr.state)

  test-tick-two-tasks : Text =
    let os = os-state-new base-shell
    in let os1 = os-submit-task os "svc-a" TaskNormal
    in let os2 = os-submit-task os1 "svc-b" TaskHigh
    in let tr1 = os-tick-bsp os2
    in let tr2 = os-tick-bsp (tr1.state)
    in "t1-dispatched=" & show (tr1.dispatched) & " t2-dispatched=" & show (tr2.dispatched) & " services=" & show (os-service-count (tr2.state))

  test-tick-empty : Text =
    let os = os-state-new base-shell
    in let tr = os-tick-bsp os
    in "dispatched=" & show (tr.dispatched) & " health=" & show-bool (tr.health-ok)

  test-health : Text =
    let os = os-state-new base-shell
    in let health = run-health-check (os.shell) (os.services)
    in "health=" & show-bool (is-system-healthy health)

  opening : [Console] Nothing = act
    print-line-uni test-initial
    print-line-uni test-tick-one-task
    print-line-uni test-tick-two-tasks
    print-line-uni test-tick-empty
    print-line-uni test-health
  end
