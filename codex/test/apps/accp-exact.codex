Chapter: AccpExactTest
  cites Accp chapter AccpExact
  cites Foreword chapter Console

Section: Entry

  row : Text, ExactResult -> [Console] Nothing
  row (label) (r) = print-line-uni (label & " " & exact-format r)

  dec : Text, DecimalResult -> [Console] Nothing
  dec (label) (r) = print-line-uni (label & " " & exact-dec-format r)

  big : Text -> ExactResult
  big (s) = exact s

  d : Text -> DecimalResult
  d (s) = exact-decimal s

  opening : [Console] Nothing = act
    row "2^256" (exact-pow (exact-integer 2) 256)
    row "30!" (exact-factorial 30)
    row "10^30 / 7" (exact-div (exact-pow (exact-integer 10) 30) (exact-integer 7))
    row "10^30 rem 7" (exact-rem (exact-pow (exact-integer 10) 30) (exact-integer 7))
    row "-17 / 5" (exact-div (exact-integer (0 - 17)) (exact-integer 5))
    row "-17 rem 5" (exact-rem (exact-integer (0 - 17)) (exact-integer 5))
    row "17 / -5" (exact-div (exact-integer 17) (exact-integer (0 - 5)))
    row "17 rem -5" (exact-rem (exact-integer 17) (exact-integer (0 - 5)))
    row "big product" (exact-mul (big "123456789012345678901234567890") (big "987654321098765432109876543210"))
    row "big quotient" (exact-div (big "121932631137021795226185032733622923332237463801111263526900") (big "987654321098765432109876543210"))
    row "big remainder" (exact-rem (big "121932631137021795226185032733622923332237463801111263526901") (big "987654321098765432109876543210"))
    row "1 - 10^40" (exact-sub (exact-integer 1) (exact-pow (exact-integer 10) 40))
    row "gcd" (exact-gcd (big "340282366920938463463374607431768211456") (big "-1208925819614629174706176"))
    row "-0" (big "-0000")
    row "bad digit" (big "12a")
    row "empty" (big "")
    row "sign only" (big "-")
    row "divide by zero" (exact-div (exact-integer 1) (exact-integer 0))
    row "negative exponent" (exact-pow (exact-integer 2) (0 - 1))
    row "too large power" (exact-pow (exact-integer 10) 30000)
    row "error propagates" (exact-add (big "x") (exact-integer 1))
    dec "0.1 + 0.2" (exact-dec-add (d "0.1") (d "0.2"))
    dec "19.99 * 3" (exact-dec-mul (d "19.99") (d "3"))
    dec "100.00 - 0.01" (exact-dec-sub (d "100.00") (d "0.01"))
    dec "1 / 3 at 10" (exact-dec-div (d "1") (d "3") 10)
    dec "2 / 3 at 4" (exact-dec-div (d "2") (d "3") 4)
    dec "-2 / 3 at 4" (exact-dec-div (d "-2") (d "3") 4)
    dec "1 / 8 at 2" (exact-dec-div (d "1") (d "8") 2)
    dec "3 / 8 at 2" (exact-dec-div (d "3") (d "8") 2)
    dec "round 2.5" (exact-dec-round (d "2.5") 0)
    dec "round 3.5" (exact-dec-round (d "3.5") 0)
    dec "round -2.5" (exact-dec-round (d "-2.5") 0)
    dec "round 1.005 to 2" (exact-dec-round (d "1.005") 2)
    dec "round 1.015 to 2" (exact-dec-round (d "1.015") 2)
    dec "round 1.0051 to 2" (exact-dec-round (d "1.0051") 2)
    dec "-0.5" (d "-0.5")
    dec "1 / 0" (exact-dec-div (d "1") (d "0") 2)
    dec "1." (d "1.")
  end
