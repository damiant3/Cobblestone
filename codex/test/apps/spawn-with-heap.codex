Chapter: SpawnWithHeap

Section: Helpers
  build-list : Integer, Integer, List Integer -> List Integer
  build-list (i) (n) (acc) =
    if i >= n then acc
    else build-list (i + 1) n (list-push acc i)

Section: Body
  opening : [Console, Concurrent] Nothing = act
    pid <- process-spawn-with-heap (\x -> let big = build-list 0 50000 [] in poke-byte 28000 0 (if list-length big == 50000 then 1 else 0)) 4194304
    let wt = process-wait pid
    in let result = peek-byte 28000 0
    in if result == 1 then print-line-uni "PASS: child used 4MB heap"
    else print-line-uni "FAIL"
  end
