Chapter: StoreQuotedWork
  cites Works chapter RepoProtocolPersist
  cites Foreword chapter FactStore
  cites Foreword chapter Maybe
  cites Encode chapter Hex
  cites Kernel chapter DiskFacts
  cites Kernel chapter AppPersist
  cites Foreword chapter Console

Section: The Known Work

  work-body : Text
  work-body =
    "Chapter: Sorted\n"
    & "\n"
    & "Section: Body\n"
    & "\n"
    & "  sort-ascending : Integer -> Integer\n"
    & "  sort-ascending (n) = n + 100\n"

  work-hash : Text = "71f85b21050759c45724ab3a7eebe9eb36453b16b5c3878c6fdea78732bce71b"
  work-signer : Text = "fcfbf1f0f3f0f3ff"
  work-sig : Text = "843470545a005eb732306490c4a0ebe31f478b5cd1fa80f6fe1a19f4ca48207180ca5024f10f8d5cba6d6517b9154f71577d982a7e577af546af710aab2d1f06"

  known-def : SourceDefinition
  known-def =
    SourceDefinition {
      sd-hash = work-hash, sd-path = "sorted.codex", sd-quire = "Sorted", sd-chapter = "Sorted",
      sd-signer = work-signer, sd-signature = hex-decode work-sig,
      sd-author = "alice", sd-timestamp = 1000, sd-content = work-body
    }

Section: Entry

  opening : [Device.Block, Console.Write] Nothing = act
    let s0 = disk-init
    in let s1 = repo-persist-save-definition s0 known-def 1000
    in print-line-uni "stored"
  end

