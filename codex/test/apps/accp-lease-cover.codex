Chapter: AccpLeaseCover
  cites Accp chapter AccpLease
  cites Foreword chapter Console

Section: Entry

  yn : Boolean -> Text
  yn (b) = if b then "yes" else "no"

  line : Text, Boolean -> Text
  line (label) (b) = label & " " & yn b

  opening : [Console] Nothing = act
    print-line-uni (line "family covers member" (al-covers "FileSystem" 2 "/jake/homework/" "FileSystem.Write" "/jake/homework/"))
    print-line-uni (line "member covers family" (al-covers "FileSystem.Write" 2 "/" "FileSystem" "/"))
    print-line-uni (line "exact label" (al-covers "FileSystem.Write" 1 "/jake" "FileSystem.Write" "/jake"))
    print-line-uni (line "path beneath" (al-covers "FileSystem" 2 "/jake" "FileSystem.Write" "/jake/x"))
    print-line-uni (line "path sibling prefix" (al-covers "FileSystem" 2 "/jake" "FileSystem.Write" "/jakeB"))
    print-line-uni (line "path wider than lease" (al-covers "FileSystem" 2 "/jake/homework/" "FileSystem.Write" "/"))
    print-line-uni (line "dotdot in row" (al-covers "FileSystem" 2 "/jake/" "FileSystem.Write" "/jake/../etc"))
    print-line-uni (line "dot in row" (al-covers "FileSystem" 2 "/jake/" "FileSystem.Write" "/jake/./x"))
    print-line-uni (line "empty segment in row" (al-covers "FileSystem" 2 "/jake/" "FileSystem.Write" "/jake//x"))
    print-line-uni (line "dotdot in lease" (al-covers "FileSystem" 2 "/jake/../" "FileSystem.Write" "/jake/../x"))
    print-line-uni (line "unscoped row under scoped lease" (al-covers "FileSystem" 2 "/jake" "FileSystem.Write" ""))
    print-line-uni (line "portless row under ported lease" (al-covers "Network" 2 "api.example.com:443" "Network.Connect" "api.example.com"))
    print-line-uni (line "ported row under portless lease" (al-covers "Network" 2 "api.example.com" "Network.Connect" "api.example.com:443"))
    print-line-uni (line "same port" (al-covers "Network" 2 "api.example.com:443" "Network.Connect" "api.example.com:443"))
    print-line-uni (line "other port" (al-covers "Network" 2 "api.example.com:443" "Network.Connect" "api.example.com:4433"))
    print-line-uni (line "host suffix" (al-covers "Network" 2 "api.example.com" "Network.Connect" "api.example.com.evil.net"))
    print-line-uni (line "channel equal" (al-covers "Console" 2 "stderr" "Console.Write" "stderr"))
    print-line-uni (line "channel other" (al-covers "Console" 2 "stderr" "Console.Write" "stdout"))
    print-line-uni (line "read lease, write label" (al-covers "FileSystem" 0 "/" "FileSystem.Write" "/x"))
    print-line-uni (line "write lease, read label" (al-covers "FileSystem" 1 "/" "FileSystem.Read" "/x"))
    print-line-uni (line "read lease, read label" (al-covers "FileSystem" 0 "/" "FileSystem.Read" "/x"))
    print-line-uni (line "read lease, suffixless label" (al-covers "Network" 0 "api.example.com" "Network.Connect" "api.example.com"))
    print-line-uni (line "unknown direction" (al-covers "FileSystem" 3 "/" "FileSystem.Read" "/x"))
    print-line-uni (line "current at not_before" (al-current 100 200 100))
    print-line-uni (line "current at expires" (al-current 100 200 200))
    print-line-uni (line "current before not_before" (al-current 100 200 99))
    print-line-uni (line "bounded at the maximum" (al-bounded 100 1000 900))
    print-line-uni (line "bounded past the maximum" (al-bounded 100 1001 900))
    print-line-uni (line "bounded empty window" (al-bounded 100 100 900))
  end

