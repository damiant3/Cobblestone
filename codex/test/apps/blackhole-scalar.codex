Chapter: BlackHoleScalarTest
  cites Globe chapter BlackHole
  cites Foreword chapter Console

Section: Helpers

  lit : List Integer, Integer, Integer, Integer -> Integer
  lit (xs) (i) (n) (acc) =
    if i >= n then acc
    else lit xs (i + 1) n (if list-at xs i /= 0 then acc + 1 else acc)

  sum-list : List Integer, Integer, Integer, Integer -> Integer
  sum-list (xs) (i) (n) (acc) =
    if i >= n then acc
    else sum-list xs (i + 1) n (acc + list-at xs i)

Section: Entry

  opening : [Console] Nothing
  opening = act
    let frame = bh-render-frame 16 9 bh-camera-default 0.0
    in act
      print-line-uni ("frame values: " & show (list-length frame))
      print-line-uni ("frame lit: " & show (lit frame 0 (list-length frame) 0))
      print-line-uni ("frame sum: " & show (sum-list frame 0 (list-length frame) 0))
    end
  end

