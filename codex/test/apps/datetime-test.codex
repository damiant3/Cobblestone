Chapter: DateTimeTest
  cites Foreword chapter DateTime

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-epoch : Text =
    let dt = unix-to-datetime 0
    in "year=" & show (dt.year) & " month=" & show (dt.month) & " day=" & show (dt.day)

  test-known-date : Text =
    let dt = unix-to-datetime 1000000000
    in "year=" & show (dt.year) & " month=" & show (dt.month) & " day=" & show (dt.day)

  test-leap : Text =
    "2000=" & show-bool (is-leap-year 2000) & " 1900=" & show-bool (is-leap-year 1900) & " 2024=" & show-bool (is-leap-year 2024) & " 2023=" & show-bool (is-leap-year 2023)

  test-days-in-month : Text =
    "jan=" & show (days-in-month 2024 1) & " feb=" & show (days-in-month 2024 2) & " feb-non=" & show (days-in-month 2023 2)

  test-roundtrip : Text =
    let ts = 1700000000
    in let dt = unix-to-datetime ts
    in let back = datetime-to-unix dt
    in "roundtrip=" & show-bool (back == ts)

  opening : [Console] Nothing = act
    print-line-uni test-epoch
    print-line-uni test-known-date
    print-line-uni test-leap
    print-line-uni test-days-in-month
    print-line-uni test-roundtrip
  end
