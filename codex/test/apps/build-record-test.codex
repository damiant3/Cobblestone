Chapter: BuildRecordTest

  cites Foreword chapter Console
  cites Works chapter BuildRecord

Section: Body

  opening : [Console] Nothing =
    let br = create-build-record "seed-aaa" "src-bbb" "out-ccc" 2100000 100 99 "damian" 1700000
    in let hl = integer-to-text (text-length (br.hash))
    in let fp0 = if br.fixed-point then "yes" else "no"
    in let br2 = build-record-set-fixed-point br True
    in let fp1 = if br2.fixed-point then "yes" else "no"
    in let g1 = gate-pass "text-roundtrip"
    in let g2 = gate-fail "pingpong" "mismatch at byte 42"
    in let br3 = build-record-set-gates br2 [g1, g2]
    in let gc = integer-to-text (list-length (br3.gates))
    in let g1s = gate-status-name (g1.status)
    in let g2s = gate-status-name (g2.status)
    in let br4 = build-record-set-elapsed br3 120
    in let el = integer-to-text (br4.elapsed-seconds)
    in act
      print-line-uni ("hash-len=" & hl)
      print-line-uni ("fixed-point-initial=" & fp0)
      print-line-uni ("fixed-point-set=" & fp1)
      print-line-uni ("gate-count=" & gc)
      print-line-uni ("gate1=" & g1s & " gate2=" & g2s)
      print-line-uni ("elapsed=" & el)
      print-line-uni ("author=" & br4.author)
      print-line-uni ("cl=" & integer-to-text (br4.cl-number))
    end
