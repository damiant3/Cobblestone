Chapter: HexTest
  cites Encode chapter Hex

Section: Tests
  test-encode : Text =
    hex-encode [0, 255, 16, 171]

  test-encode-upper : Text =
    hex-encode-upper [0, 255, 16, 171]

  test-decode : Text =
    let bs = hex-decode "00ff10ab"
    in show (list-at bs 0) & " " & show (list-at bs 1) & " " & show (list-at bs 2) & " " & show (list-at bs 3)

  test-roundtrip : Text =
    let orig = [72, 101, 108, 108, 111]
    in let encoded = hex-encode orig
    in let decoded = hex-decode encoded
    in if list-length decoded == list-length orig then "roundtrip=ok" else "roundtrip=fail"

  test-empty : Text =
    "empty=" & hex-encode []

  opening : [Console] Nothing = act
    print-line-uni test-encode
    print-line-uni test-encode-upper
    print-line-uni test-decode
    print-line-uni test-roundtrip
    print-line-uni test-empty
  end
