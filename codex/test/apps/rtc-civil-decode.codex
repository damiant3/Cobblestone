Chapter: RtcCivilDecode
  cites Foreword chapter Console
  cites Works chapter GopRtc

Section: Modes

  mode-bcd-12 : Integer = 0
  mode-bcd-24 : Integer = 2
  mode-bin-12 : Integer = 4
  mode-bin-24 : Integer = 6

Section: Rendering

  pad2 : Integer -> Text
  pad2 (v) = if v < 10 then "0" & show v else show v

  civil-text : RtcCivil -> Text
  civil-text (c) =
    let ok = if c.rc-ok then "ok " else "bad "
    in ok & show (c.rc-year) & "-" & pad2 (c.rc-month) & "-" & pad2 (c.rc-day) & " " & pad2 (c.rc-hour) & ":" & pad2 (c.rc-minute) & ":" & pad2 (c.rc-second)

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("bcd 24h 01h    : " & civil-text (rtc-civil-of mode-bcd-24 69 48 1 1 17 38))
    print-line-uni ("bcd 24h 23h    : " & civil-text (rtc-civil-of mode-bcd-24 0 89 35 49 18 38))
    print-line-uni ("bcd 12h 1 pm   : " & civil-text (rtc-civil-of mode-bcd-12 69 48 129 1 17 38))
    print-line-uni ("bcd 12h 12 am  : " & civil-text (rtc-civil-of mode-bcd-12 0 0 18 1 1 38))
    print-line-uni ("bcd 12h 12 pm  : " & civil-text (rtc-civil-of mode-bcd-12 0 0 146 1 1 38))
    print-line-uni ("bin 24h 13h    : " & civil-text (rtc-civil-of mode-bin-24 45 30 13 1 11 26))
    print-line-uni ("bin 12h 1 pm   : " & civil-text (rtc-civil-of mode-bin-12 45 30 129 1 11 26))
    print-line-uni ("bin 12h 11 pm  : " & civil-text (rtc-civil-of mode-bin-12 59 59 139 31 12 99))
    print-line-uni ("month 13       : " & civil-text (rtc-civil-of mode-bin-24 0 0 0 1 13 26))
    print-line-uni ("day 0          : " & civil-text (rtc-civil-of mode-bin-24 0 0 0 0 1 26))
    print-line-uni ("bcd as binary  : " & civil-text (rtc-civil-of mode-bin-24 69 48 1 1 17 38))
  end
