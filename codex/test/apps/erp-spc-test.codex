Chapter: ErpSpcTest
  cites ERP chapter ErpTypes
  cites ERP chapter QmQuality

 Known-answer test for statistical process control limits. Readings
 10, 12, 14, 16, 18: mean 14, sample variance 10, integer sigma 3,
 control limits 14 plus or minus 9. A second series with a spike
 checks out-of-control detection.

Section: Tests

  test-limits : Text =
    let chart = calc-spc-limits [10, 12, 14, 16, 18] 1
    in let head = "limits: mean=" & show (chart.spc-mean) & " ucl=" & show (chart.spc-ucl) & " lcl=" & show (chart.spc-lcl)
    in head & " ooc=" & show (list-length (chart.spc-out-of-control))

  test-spike : Text =
    let chart = calc-spc-limits [100, 100, 100, 100, 100, 100, 100, 100, 100, 200] 2
    in let head = "spike: mean=" & show (chart.spc-mean) & " ucl=" & show (chart.spc-ucl)
    in head & " ooc=" & show (list-length (chart.spc-out-of-control))

  test-isqrt : Text =
    "isqrt: of10=" & show (isqrt 10) & " of320=" & show (isqrt 320) & " of10000=" & show (isqrt 10000)

Section: Body

  opening : [Console] Nothing = act
    print-line-uni test-limits
    print-line-uni test-spike
    print-line-uni test-isqrt
  end
