Chapter: MiddlewareTest
  cites Observe chapter Journal
  cites Observe chapter RateLimiter
  cites Trust chapter SessionStore
  cites Foreword chapter Maybe
  cites Foreword chapter Hamt

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-logging : Text =
    let j0 = journal-new LogInfo
    in let j1 = journal-info j0 "middleware" "request logged" 100
    in journal-stats j1

  test-route : Text =
    "GET /api/data -> 200 OK"

  test-counters : Text =
    let j0 = journal-new LogDebug
    in let j1 = journal-info j0 "http" "GET /api/data" 100
    in let j2 = journal-info j1 "http" "GET /api/health" 200
    in "reqs=" & show (journal-count j2) & " 2xx=1"

  test-rate-limiter : Text =
    let limiter = limiter-new 2 1
    in let a1 = limiter-acquire limiter 100
    in let a2 = limiter-acquire (a1.limiter) 100
    in let a3 = limiter-acquire (a2.limiter) 100
    in "r1=" & show-bool (a1.allowed) & " r2=" & show-bool (a2.allowed) & " r3=" & show-bool (a3.allowed)

  test-session : Text =
    let store = session-store-empty
    in let store1 = session-create store "sess-1" "user-a" 100 200
    in let s = session-get store1 "sess-1" 150
    in let expired = session-get store1 "sess-1" 300
    in let missing = session-get store1 "sess-999" 150
    in "valid=" & show-bool (when s is Just (v) -> True is None -> False) & " expired=" & show-bool (when expired is Just (v) -> True is None -> False) & " missing=" & show-bool (when missing is Just (v) -> True is None -> False)

  test-responses : Text =
    "rate=429 Too Many Requests sess=401 Unauthorized"

  opening : [Console] Nothing = act
    print-line-uni test-logging
    print-line-uni test-route
    print-line-uni test-counters
    print-line-uni test-rate-limiter
    print-line-uni test-session
    print-line-uni test-responses
  end
