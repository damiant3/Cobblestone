Chapter: DeviceSeed

Section: Body
  opening : [Console] Nothing = act
    let s0 = device-seed 0
    in let s1 = device-seed 1
    in let s2 = device-seed 2
    in let s3 = device-seed 3
    in let bad = device-seed 4
    in if bad == (0 - 1) then
      if s0 == 0 then if s1 == 0 then if s2 == 0 then if s3 == 0 then
        print-line "FAIL: all zeros — RDRAND not working"
      else print-line "PASS"
      else print-line "PASS"
      else print-line "PASS"
      else print-line "PASS"
    else print-line "FAIL: out-of-range not -1"
  end
