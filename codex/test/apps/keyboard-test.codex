Chapter: KeyboardTest
  cites Kernel chapter Keyboard
  cites Foreword chapter CCE

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  st0 : KbState = kb-state-new

  test-cce-values : Text =
    let a-cce = from-unicode 97
    in let z-cce = from-unicode 122
    in let sp-cce = from-unicode 32
    in let enter-cce = from-unicode 10
    in let zero-cce = from-unicode 48
    in "a=" & show a-cce & " z=" & show z-cce & " space=" & show sp-cce & " enter=" & show enter-cce & " 0=" & show zero-cce

  test-shift-mapping : Text =
    let a-cce = from-unicode 97
    in let big-a = shift-cce a-cce
    in "a-cce=" & show a-cce & " A-cce=" & show big-a & " diff=" & show (big-a - a-cce)

  test-press-a : Text =
    let ev = kb-process-scancode st0 30
    in "cce=" & show (ev.ascii) & " pressed=" & show-bool (ev.pressed) & " shift=" & show-bool ((ev.state).shift)

  test-shift-a : Text =
    let ev1 = kb-process-scancode st0 42
    in let ev2 = kb-process-scancode (ev1.state) 30
    in "shift-down=" & show-bool ((ev1.state).shift) & " A-cce=" & show (ev2.ascii)

  test-release : Text =
    let ev = kb-process-scancode st0 170
    in "released=" & show-bool (if ev.pressed then False else True) & " shift=" & show-bool ((ev.state).shift)

  test-char : Text =
    let a-cce = from-unicode 97
    in "char=" & char-to-text (code-to-char a-cce)

  opening : [Console] Nothing = act
    print-line-uni test-cce-values
    print-line-uni test-shift-mapping
    print-line-uni test-press-a
    print-line-uni test-shift-a
    print-line-uni test-release
    print-line-uni test-char
  end
