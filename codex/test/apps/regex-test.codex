Chapter: RegexTest
  cites Foreword chapter Regex

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-literal-match : Text =
    let pat = rx-literal "hello"
    in "matches=" & show-bool (rx-matches pat "hello world")

  test-literal-no-match : Text =
    let pat = rx-literal "xyz"
    in "matches=" & show-bool (rx-matches pat "hello")

  test-contains : Text =
    let pat = rx-literal "ell"
    in "contains=" & show-bool (rx-contains pat "hello")

  test-search-pos : Text =
    let pat = rx-literal "world"
    in let m = rx-search pat "hello world"
    in "start=" & show (m.start) & " len=" & show (m.length)

  test-dot-star : Text =
    let pat = rx-dot-star
    in "matches=" & show-bool (rx-matches pat "anything")

  opening : [Console] Nothing = act
    print-line-uni test-literal-match
    print-line-uni test-literal-no-match
    print-line-uni test-contains
    print-line-uni test-search-pos
    print-line-uni test-dot-star
  end
