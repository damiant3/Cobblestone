Section: Helpers

  tr-eq : List Integer, List Integer -> Boolean
  tr-eq (a) (b) =
    if list-length a /= list-length b then False
    else tr-eq-loop a b 0 (list-length a)

  tr-eq-loop : List Integer, List Integer, Integer, Integer -> Boolean
  tr-eq-loop (a) (b) (i) (n) =
    if i >= n then True
    else if list-at a i /= list-at b i then False
    else tr-eq-loop a b (i + 1) n

  first-out : TlsEpStep -> List Integer
  first-out (st) = if list-length (st.tes-out) < 1 then [] else list-at (st.tes-out) 0

  copy-bytes : List Integer -> List Integer
  copy-bytes (bs) = cb-loop bs 0 (list-length bs) []

  cb-loop : List Integer, Integer, Integer, List Integer -> List Integer
  cb-loop (bs) (i) (n) (acc) =
    if i >= n then acc else cb-loop bs (i + 1) n (list-push acc (list-at bs i))

  retype : List Integer, Integer -> List Integer
  retype (rec) (t) = list-set-at (copy-bytes rec) 5 t

  refused : TlsEpStep -> Text
  refused (st) =
    "outs=" & show (list-length (st.tes-out)) & " alert=" & show (tr-eq (first-out st) alert-unexpected)

Section: The Handshake

  s0 : TlsEp = tls-ep-server-new s-priv s-random [leaf-cert] leaf-priv leaf-pub
  c0 : TlsEp = tls-ep-client-new c-priv c-random [] [] []

  cs1 : TlsEpStep = tls-ep-hello c0
  ch : List Integer = list-at (cs1.tes-out) 0

  sv1 : TlsEpStep = tls-ep-recv s0 ch
  sh : List Integer = list-at (sv1.tes-out) 0

  c1 : TlsEpStep = tls-ep-recv (cs1.tes-ep) sh
  c2 : TlsEpStep = tls-ep-recv (c1.tes-ep) (list-at (sv1.tes-out) 1)
  c3 : TlsEpStep = tls-ep-recv (c2.tes-ep) (list-at (sv1.tes-out) 2)
  c4 : TlsEpStep = tls-ep-recv (c3.tes-ep) (list-at (sv1.tes-out) 3)
  c5 : TlsEpStep = tls-ep-recv (c4.tes-ep) (list-at (sv1.tes-out) 4)

  sv2 : TlsEpStep = tls-ep-recv (sv1.tes-ep) (first-out c5)

  cs2 : TlsEpStep = tls-ep-send-app (c5.tes-ep) [71, 69, 84]
  sv3 : TlsEpStep = tls-ep-recv (sv2.tes-ep) (first-out cs2)

Section: A Long Send

  fill : Integer, List Integer -> List Integer
  fill (n) (acc) = if list-length acc >= n then acc else fill n (list-push acc 65)

  big : TlsEpStep = tls-ep-send-app (c5.tes-ep) (fill 20000 [])
  big1 : TlsEpStep = tls-ep-recv (sv2.tes-ep) (list-at (big.tes-out) 0)
  big2 : TlsEpStep = tls-ep-recv (big1.tes-ep) (if list-length (big.tes-out) < 2 then [] else list-at (big.tes-out) 1)

Section: A ServerHello From Another Key

  m0 : TlsEp = tls-ep-server-new m-priv s-random [leaf-cert] leaf-priv leaf-pub
  msh : List Integer = list-at ((tls-ep-recv m0 ch).tes-out) 0

Section: Out Of Order

  srv-repeat : TlsEpStep = tls-ep-recv (sv1.tes-ep) ch
  srv-late : TlsEpStep = tls-ep-recv (sv3.tes-ep) ch
  srv-mistyped : TlsEpStep = tls-ep-recv s0 (retype ch 2)

  cli-unasked : TlsEpStep = tls-ep-recv c0 sh
  cli-second : TlsEpStep = tls-ep-recv (c1.tes-ep) msh
  cli-late : TlsEpStep = tls-ep-recv (c5.tes-ep) sh

  cli-mistyped : TlsEpStep = tls-ep-recv (cs1.tes-ep) (retype sh 11)
  mt2 : TlsEpStep = tls-ep-recv (cli-mistyped.tes-ep) (list-at (sv1.tes-out) 1)
  mt3 : TlsEpStep = tls-ep-recv (mt2.tes-ep) (list-at (sv1.tes-out) 2)
  mt4 : TlsEpStep = tls-ep-recv (mt3.tes-ep) (list-at (sv1.tes-out) 3)
  mt5 : TlsEpStep = tls-ep-recv (mt4.tes-ep) (list-at (sv1.tes-out) 4)

Section: ServerHello Fields

 The ServerHello body starts at record byte 9 (5 of record header, 4 of handshake header): legacy_version at body 0,
 the cipher suite at 35 and the compression method at 37 behind an empty session id echo.

  set-at : List Integer, Integer, Integer -> List Integer
  set-at (bs) (i) (v) = list-set-at (copy-bytes bs) i v

  find-seq : List Integer, List Integer, Integer -> Integer
  find-seq (bs) (pat) (i) =
    if i + list-length pat > list-length bs then -1
    else if tr-eq (seq-at bs i (list-length pat) 0 []) pat then i
    else find-seq bs pat (i + 1)

  seq-at : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  seq-at (bs) (off) (n) (i) (acc) =
    if i >= n then acc else seq-at bs off n (i + 1) (list-push acc (list-at bs (off + i)))

  alert-is : TlsEpStep, Integer -> Text
  alert-is (st) (code) = "outs=" & show (list-length (st.tes-out)) & " alert=" & show (tr-eq (first-out st) [21, 3, 3, 0, 2, 2, code])

 sh-plus rebuilds the genuine ServerHello with one more extension after its own, every length re-encoded; sh-short
 declares one byte more extensions than it carries.

  sh-body : List Integer = tep-msg-body (tep-rec-payload sh)

  sh-rebuilt : List Integer, Integer -> List Integer
  sh-rebuilt (extra) (slack) =
    let exts = seq-at sh-body 40 (list-length sh-body - 40) 0 [] & extra
    in let n = list-length exts + slack
    in tls-encode-record tls-content-handshake (tls13-msg-transcript dtls-hs-server-hello (seq-at sh-body 0 38 0 [] & [n / 256, n - (n / 256) * 256] & exts))

 ch-rebuilt does the same for the client's ClientHello, its first extension at dtls-ch-ext-offset behind the 2-byte
 length; each goes to a fresh
 server, as a receive writes the endpoint it is handed in place (L-ALIAS).

  ch-body : List Integer = seq-at ch 9 (list-length ch - 9) 0 []

  ch-rebuilt : List Integer, Integer -> List Integer
  ch-rebuilt (extra) (slack) =
    let eo = dtls-ch-ext-offset ch-body
    in let exts = seq-at ch-body eo (list-length ch-body - eo) 0 [] & extra
    in let n = list-length exts + slack
    in tls-encode-record tls-content-handshake (tls13-msg-transcript dtls-hs-client-hello (seq-at ch-body 0 (eo - 2) 0 [] & [n / 256, n - (n / 256) * 256] & exts))

 ch-sid33 gives the genuine ClientHello body a 33-byte legacy_session_id; ch-suites-odd adds one byte to its
 cipher_suites, an odd length.

  ch-wrap : List Integer -> List Integer
  ch-wrap (body) = tls-encode-record tls-content-handshake (tls13-msg-transcript dtls-hs-client-hello body)

  ch-sid33 : List Integer =
    let s = list-at ch-body 34
    in seq-at ch-body 0 34 0 [] & [33] & fill 33 [] & seq-at ch-body (35 + s) (list-length ch-body - 35 - s) 0 []

  ch-suites-odd : List Integer =
    let o = 35 + list-at ch-body 34
    in let cs = list-at ch-body o * 256 + list-at ch-body (o + 1)
    in seq-at ch-body 0 o 0 [] & [(cs + 1) / 256, (cs + 1) - ((cs + 1) / 256) * 256] & seq-at ch-body (o + 2) cs 0 [] & [19] & seq-at ch-body (o + 2 + cs) (list-length ch-body - o - 2 - cs) 0 []

 ch-shares-len moves the low byte of the genuine hello's client_shares length (2 bytes before its X25519 entry)
 by d.

  ch-shares-len : Integer -> List Integer
  ch-shares-len (d) =
    let i = find-seq ch-body [0, 29, 0, 32] 0
    in set-at ch-body (i - 1) (list-at ch-body (i - 1) + d)

 ch-vec-past moves a list extension's own vector length (at offset k into the extension's data) by d, leaving the
 extension's length as it was: supported_versions (43, a 1-byte length) and signature_algorithms (13, a 2-byte one).

  ch-vec-past : Integer, Integer, Integer -> List Integer
  ch-vec-past (t) (k) (d) =
    let i = find-seq ch-body [0, t, 0] (dtls-ch-ext-offset ch-body)
    in set-at ch-body (i + 4 + k) (list-at ch-body (i + 4 + k) + d)

 A HelloRetryRequest to a fresh client after its ClientHello: one with a cookie, the same again after the client's
 answer, one naming a group, one with no cookie and one with an empty cookie.

  fresh-hello : Integer -> TlsEpStep
  fresh-hello (k) = tls-ep-hello (tls-ep-client-new c-priv c-random [] [] [])

  hrr-rec : List Integer -> List Integer
  hrr-rec (body) = tls-encode-record tls-content-handshake (tls13-msg-transcript dtls-hs-server-hello body)

  hrr-no-cookie : List Integer = dtls-legacy-version & dtls-hrr-random & [0, 19, 1, 0, 0, 6] & dtls-ext-versions-server

  chrr-row : Text =
    let c1 = tls-ep-recv ((fresh-hello 0).tes-ep) (hrr-rec (dtls-hrr-body [] [9, 9, 9]))
    in let n1 = list-length (c1.tes-out)
    in let echoed = find-seq (first-out c1) [0, 44, 0, 5, 0, 3, 9, 9, 9] 0 >= 0
    in let again = tls-ep-recv (c1.tes-ep) (hrr-rec (dtls-hrr-body [] [9, 9, 9]))
    in "client hrr cookie outs=" & show n1 & " cookie-echoed=" & show echoed & " second " & alert-is again 10
      & " key-share " & alert-is (tls-ep-recv ((fresh-hello 0).tes-ep) (hrr-rec (dtls-hrr-group-body [] 29))) 47
      & " no-cookie " & alert-is (tls-ep-recv ((fresh-hello 0).tes-ep) (hrr-rec hrr-no-cookie)) 47
      & " empty-cookie " & alert-is (tls-ep-recv ((fresh-hello 0).tes-ep) (hrr-rec (dtls-hrr-body [] []))) 50

 chrr-done runs a handshake through the cookie HelloRetryRequest: a fresh server is set as having sent it (its
 transcript message_hash(ClientHello1) then the HRR, phase 1, as its own HRR path leaves it), takes ClientHello2,
 and the two run to done.

  chrr-done : Text =
    let h = fresh-hello 0
    in let hrr = dtls-hrr-body [] [9, 9, 9]
    in let ch1 = seq-at (first-out h) 5 (list-length (first-out h) - 5) 0 []
    in let c1 = tls-ep-recv (h.tes-ep) (hrr-rec hrr)
    in let s0c = tls-ep-server-new s-priv s-random [leaf-cert] leaf-priv leaf-pub
    in let s1 = __record-set (__record-set s0c "tep-transcript" (tls13-transcript-after-hrr ch1 & tls13-msg-transcript dtls-hs-server-hello hrr)) "tep-phase" 1
    in let sv = tls-ep-recv s1 (first-out c1)
    in let cl = feed c1 (sv.tes-out) 0
    in let sv2 = tls-ep-recv (sv.tes-ep) (first-out cl)
    in "client hrr cookie then handshake server-flight=" & show (list-length (sv.tes-out)) & " client-done=" & show (tls-ep-done (cl.tes-ep)) & " server-done=" & show (tls-ep-done (sv2.tes-ep))

  ch-to-fresh : List Integer -> TlsEpStep
  ch-to-fresh (rec) = tls-ep-recv (tls-ep-server-new s-priv s-random [leaf-cert] leaf-priv leaf-pub) rec

  sh-plus : List Integer -> TlsEpStep
  sh-plus (extra) = tls-ep-recv (cs1.tes-ep) (sh-rebuilt extra 0)

  sh-cipher : TlsEpStep = tls-ep-recv (cs1.tes-ep) (set-at sh 45 2)
  sh-compression : TlsEpStep = tls-ep-recv (cs1.tes-ep) (set-at sh 46 1)
  sh-legacy : TlsEpStep = tls-ep-recv (cs1.tes-ep) (set-at sh 10 2)
  sh-version : TlsEpStep = tls-ep-recv (cs1.tes-ep) (set-at sh (find-seq sh [0, 43, 0, 2, 3, 4] 0 + 5) 3)
  sh-group : TlsEpStep = tls-ep-recv (cs1.tes-ep) (set-at sh (find-seq sh [0, 51, 0, 36, 0, 29] 0 + 5) 23)

 The ClientHello body also starts at record byte 9: its one cipher suite at body 37 and 38, the compression list's
 length at 39 and its one method at 40.

  ch-suite : TlsEpStep = tls-ep-recv s0 (set-at ch 47 2)
  ch-compression : TlsEpStep = tls-ep-recv s0 (set-at ch 49 1)
  ch-version : TlsEpStep = tls-ep-recv s0 (set-at ch (find-seq ch [0, 43, 0, 3, 2, 3, 4] 0 + 6) 3)

Section: Rows On One Handshake

 Each row below runs exactly one handshake: hs-row passes the server's step after the ClientHello (sv, its flight in
 sv.tes-out) and the client's step after the ServerHello (cc) as arguments, because a top-level value is evaluated at
 every use and the chain c1 .. c5 re-runs sv1 at each step.
 ee-seal seals an EncryptedExtensions body as the server does (its handshake key, sequence 0). open-msg k sv i opens
 the server's i-th sealed record (0 EncryptedExtensions, 1 Certificate, 2 CertificateVerify, 3 Finished); play seals
 the given messages at sequence 0, 1, ... and then a server Finished over the transcript they make, as a server that
 sent that flight would. cfin-of opens the client's Finished, changes it by kind (0 none, 1 type 11, 2 a KeyUpdate
 after it, 3 length 33) and seals it back for the server.

  hs-row : Integer -> Text
  hs-row (n) = hs-row-hello n (tls-ep-hello c0)

  hs-row-hello : Integer, TlsEpStep -> Text
  hs-row-hello (n) (cs) = hs-row-server n cs (tls-ep-recv s0 (first-out cs))

  hs-row-server : Integer, TlsEpStep, TlsEpStep -> Text
  hs-row-server (n) (cs) (sv) =
    if n == 31 then plain-alert-row (tls-ep-recv (cs.tes-ep) [21, 3, 3, 0, 2, 2, 40])
    else hs-row-of n sv (tls-ep-recv (cs.tes-ep) (first-out sv))

  hs-row-of : Integer, TlsEpStep, TlsEpStep -> Text
  hs-row-of (n) (sv) (cc) =
    let k = (sv.tes-ep).tep-s-hs
    in if n == 0 then "sealed-like-server=" & show (tr-eq (ee-seal k [0, 0]) (list-at (sv.tes-out) 1))
    else if n <= 9 then alert-is (tls-ep-recv (cc.tes-ep) (ee-seal k (ee-body n))) (ee-code n)
    else if n == 10 then hs-genuine (tr-eq (fin-for k cc (msgs k sv [0, 1, 2])) (open-msg k sv 3)) k sv cc
    else if n <= 14 then flight (play k cc (msgs k sv (fl-order n)))
    else if n == 15 then refused (tls-ep-recv (cc.tes-ep) (tep-enc k 0 tls-content-handshake (cat-all (msgs k sv [0, 2, 2]) 0 [])))
    else if n <= 19 then cfin-of (n - 16) (sv.tes-ep) (feed cc (sv.tes-out) 1)
    else if n <= 27 then inner-row n sv cc
    else if n <= 33 then alert-row n sv cc
    else if n == 40 then fin-row (flight-with-fin k cc (msgs k sv [0, 1, 2]))
    else if n == 41 then cfin-of 4 (sv.tes-ep) (feed cc (sv.tes-out) 1)
    else if n == 54 then ku-limit-row 16777215 (sv.tes-ep) (feed cc (sv.tes-out) 1)
    else if n == 55 then ku-limit-row 16777216 (sv.tes-ep) (feed cc (sv.tes-out) 1)
    else if n == 50 then alert-is (tls-ep-recv (cc.tes-ep) [20, 3, 3, 0, 1, 1]) 10
    else if n == 51 then alert-is (tls-ep-recv (cc.tes-ep) [20, 3, 3, 0, 1, 2]) 10
    else if n == 52 then alert-is (ch-to-fresh [20, 3, 3, 0, 1, 1]) 10
    else if n == 53 then alert-is (tls-ep-recv ((feed cc (sv.tes-out) 1).tes-ep) [20, 3, 3, 0, 1, 1]) 10
    else if n == 48 then span-row k sv cc
    else if n == 49 then alert-is (tls-ep-recv (cc.tes-ep) (tep-enc k 0 tls-content-handshake (open-msg k sv 0 & [11, 3, 13, 64] & fill 100 []))) 47
    else if n == 56 then alert-is (tls-ep-recv (cc.tes-ep) (tep-enc ((sv.tes-ep).tep-s-hs) 0 0 [0, 0, 0])) 10
    else if n == 57 then alert-is (tls-ep-recv (sv.tes-ep) (tep-enc ((cc.tes-ep).tep-c-hs) 0 0 [0, 0, 0])) 10
    else if n == 58 then alert-is (tls-ep-recv ((feed cc (sv.tes-out) 1).tes-ep) (tep-enc ((sv.tes-ep).tep-s-ap) 0 0 [0, 0, 0])) 10
    else if n == 46 then alert-is (tls-ep-recv ((feed cc (sv.tes-out) 1).tes-ep) (big-rec 23 16641)) 22
    else if n == 47 then alert-is (ch-to-fresh (big-rec 22 16385)) 22
    else if n >= 44 then cv-row n k sv cc
    else if n >= 42 then cert-row n k sv cc
    else ku-row n (sv.tes-ep) (feed cc (sv.tes-out) 1)

 cert-row seals the genuine EncryptedExtensions at handshake sequence 0, then a Certificate at 1: row 42 with no
 entry, row 43 with one entry declaring 9 bytes and carrying none.

 cv-row seals the genuine EncryptedExtensions and Certificate at handshake sequence 0 and 1, then at 2 the genuine
 CertificateVerify body with one byte past its signature (row 44) or with its scheme set to 0x0401, which the
 ClientHello does not offer (row 45).

 big-rec is a record of content type ct declaring and carrying n bytes: row 46 hands one of 16641 (2^14 + 256 + 1)
 to the client after its handshake, row 47 a plaintext handshake record of 16385 (2^14 + 1) to a fresh server.

 span-row reseals the genuine flight (EncryptedExtensions, Certificate, CertificateVerify, Finished) as two
 records cut 10 bytes into the Certificate; row 49 hands the client EncryptedExtensions and a Certificate header
 declaring 200000 bytes.

 ku-limit-row runs both ends to done, sets the client's application write sequence and the server's read sequence
 to seq, as if seq records had passed, then sends one byte: the client's records and what the server received.

  ku-limit-row : Integer, TlsEp, TlsEpStep -> Text
  ku-limit-row (seq) (s) (c) =
    let s2 = tls-ep-recv s (first-out c)
    in let c1 = __record-set (c.tes-ep) "tep-app-write-seq" seq
    in let s3 = __record-set (s2.tes-ep) "tep-app-read-seq" seq
    in let sent = tls-ep-send-app c1 [65]
    in "outs=" & show (list-length (sent.tes-out)) & " server app-in=" & show (list-length (tls-ep-app-in ((feed (TlsEpStep { tes-ep = s3, tes-out = [] }) (sent.tes-out) 0).tes-ep)))

  span-row : List Integer, TlsEpStep, TlsEpStep -> Text
  span-row (k) (sv) (cc) =
    let ms = open-msg k sv 0 & open-msg k sv 1 & open-msg k sv 2 & open-msg k sv 3
    in let h = list-length (open-msg k sv 0) + 10
    in let a = tls-ep-recv (cc.tes-ep) (tep-enc k 0 tls-content-handshake (seq-at ms 0 h 0 []))
    in let b = tls-ep-recv (a.tes-ep) (tep-enc k 1 tls-content-handshake (seq-at ms h (list-length ms - h) 0 []))
    in "first outs=" & show (list-length (a.tes-out)) & " then done=" & show (tls-ep-done (b.tes-ep)) & " outs=" & show (list-length (b.tes-out))
  big-rec : Integer, Integer -> List Integer
  big-rec (ct) (n) = [ct, 3, 3, n / 256, n - (n / 256) * 256] & fill n []

  cv-row : Integer, List Integer, TlsEpStep, TlsEpStep -> Text
  cv-row (n) (k) (sv) (cc) =
    let cv = open-msg k sv 2
    in let body = seq-at cv 4 (list-length cv - 4) 0 []
    in let bad = if n == 44 then body & [0] else set-at (set-at body 0 4) 1 1
    in let c1 = tls-ep-recv (cc.tes-ep) (tep-enc k 0 tls-content-handshake (open-msg k sv 0))
    in let c2 = tls-ep-recv (c1.tes-ep) (tep-enc k 1 tls-content-handshake (open-msg k sv 1))
    in alert-is (tls-ep-recv (c2.tes-ep) (tep-enc k 2 tls-content-handshake (tls13-msg-transcript dtls-hs-cert-verify bad))) (if n == 44 then 50 else 47)

  cert-row : Integer, List Integer, TlsEpStep, TlsEpStep -> Text
  cert-row (n) (k) (sv) (cc) =
    let c1 = tls-ep-recv (cc.tes-ep) (tep-enc k 0 tls-content-handshake (open-msg k sv 0))
    in alert-is (tls-ep-recv (c1.tes-ep) (tep-enc k 1 tls-content-handshake (tls13-msg-transcript dtls-hs-certificate (if n == 42 then [0, 0, 0, 0] else [0, 0, 0, 3, 0, 0, 9])))) 50

 ku-row runs both ends to done (the client's own Finished handed to the server), then seals a post-handshake
 handshake record to the client under the server's application key at sequence 0: row 34 a KeyUpdate not asking
 for one back, then a data byte under the next server secret (HKDF-Expand-Label "traffic upd", RFC 8446 7.2); row
 35 a KeyUpdate asking for one, then the client's answer and one data byte of its own handed to the server; rows 36
 to 39 a KeyUpdate of length 2, one of value 2, a CertificateRequest, and a KeyUpdate followed by a NewSessionTicket
 in the same record.

  ku-row : Integer, TlsEp, TlsEpStep -> Text
  ku-row (n) (s) (c) = ku-row-done n (tls-ep-recv s (first-out c)) c

  ku-row-done : Integer, TlsEpStep, TlsEpStep -> Text
  ku-row-done (n) (s2) (c) =
    let key = (s2.tes-ep).tep-s-ap
    in if n == 34 then ep-state (tls-ep-recv ((tls-ep-recv (c.tes-ep) (tep-enc key 0 22 [24, 0, 0, 1, 0])).tes-ep) (tep-enc (tls13-expand-label key "traffic upd" [] 32) 0 23 [65]))
    else if n == 35 then ku-answer s2 (tls-ep-recv (c.tes-ep) (tep-enc key 0 22 [24, 0, 0, 1, 1]))
    else alert-is (tls-ep-recv (c.tes-ep) (tep-enc key 0 22 (ku-bad n))) (ku-code n)

  ku-answer : TlsEpStep, TlsEpStep -> Text
  ku-answer (s2) (c1) =
    let outs = c1.tes-out
    in let sent = tls-ep-send-app (c1.tes-ep) [66]
    in "client outs=" & show (list-length outs) & " server " & ep-state (feed s2 (outs & sent.tes-out) 0)

  ku-bad : Integer -> List Integer
  ku-bad (n) =
    if n == 36 then [24, 0, 0, 2, 0, 0]
    else if n == 37 then [24, 0, 0, 1, 2]
    else if n == 38 then [13, 0, 0, 0]
    else [24, 0, 0, 1, 0, 4, 0, 0, 0]

  ku-code : Integer -> Integer
  ku-code (n) = if n == 36 then 50 else if n == 37 then 47 else 10

 alert-row: rows 28, 29 and 32 seal an alert (close_notify, fatal handshake_failure, user_canceled) to the client
 after its handshake at application sequence 0 and one application_data byte at 1; row 30 seals a fatal alert to the
 client in its handshake epoch. plain-alert-row hands a plaintext fatal alert to a client that has only sent its
 ClientHello (row 31); row 33 hands the same to the client after its ServerHello, when a plaintext alert is
 unauthenticated. Each reports the client's phase, done and received bytes.

  alert-row : Integer, TlsEpStep, TlsEpStep -> Text
  alert-row (n) (sv) (cc) =
    if n == 30 then ep-state (tls-ep-recv (cc.tes-ep) (tep-enc ((sv.tes-ep).tep-s-hs) 0 21 [2, 40]))
    else if n == 33 then ep-state (tls-ep-recv (cc.tes-ep) [21, 3, 3, 0, 2, 2, 40])
    else alert-then-data ((sv.tes-ep).tep-s-ap) (feed cc (sv.tes-out) 1) (if n == 28 then [1, 0] else if n == 29 then [2, 40] else [1, 90])

  alert-then-data : List Integer, TlsEpStep, List Integer -> Text
  alert-then-data (key) (c) (alert) =
    let s1 = tls-ep-recv (c.tes-ep) (tep-enc key 0 21 alert)
    in ep-state (tls-ep-recv (s1.tes-ep) (tep-enc key 1 23 [65]))

  plain-alert-row : TlsEpStep -> Text
  plain-alert-row (st) = ep-state st

  ep-state : TlsEpStep -> Text
  ep-state (st) =
    "phase=" & show ((st.tes-ep).tep-phase) & " done=" & show (tls-ep-done (st.tes-ep)) & " outs=" & show (list-length (st.tes-out)) & " app-in=" & show (list-length (tls-ep-app-in (st.tes-ep)))

 inner-row seals one record of inner content type inner-type n: rows 20 to 22 to the client in its handshake epoch
 (the server's handshake key, sequence 0), 23 and 24 to the server in its (the client's handshake key), 25 to 27 to
 the client after its handshake completes (the server's application key, sequence 0).

  inner-row : Integer, TlsEpStep, TlsEpStep -> Text
  inner-row (n) (sv) (cc) =
    if n <= 22 then alert-is (tls-ep-recv (cc.tes-ep) (tep-enc ((sv.tes-ep).tep-s-hs) 0 (inner-type n) (inner-data n))) 10
    else if n <= 24 then alert-is (tls-ep-recv (sv.tes-ep) (tep-enc ((cc.tes-ep).tep-c-hs) 0 (inner-type n) (inner-data n))) 10
    else app-row n ((sv.tes-ep).tep-s-ap) (feed cc (sv.tes-out) 1)

  app-row : Integer, List Integer, TlsEpStep -> Text
  app-row (n) (key) (c) =
    let st = tls-ep-recv (c.tes-ep) (tep-enc key 0 (inner-type n) (inner-data n))
    in alert-is st 10 & " app-in=" & show (list-length (tls-ep-app-in (st.tes-ep)))

  inner-type : Integer -> Integer
  inner-type (n) =
    if n == 20 then 23 else if n == 22 then 21 else if n == 23 then 23 else if n == 26 then 22 else if n == 27 then 23 else 99

  inner-data : Integer -> List Integer
  inner-data (n) = if n == 22 then [1, 0] else if n == 26 then [4, 0, 0, 0] else [65]

 tls-ep-recv sets fields of the TlsEp it is handed in place (L-ALIAS), so the Finished comparison is taken before
 play moves cc's transcript, and every other row hands cc to exactly one receive.

  hs-genuine : Boolean, List Integer, TlsEpStep, TlsEpStep -> Text
  hs-genuine (equal) (k) (sv) (cc) = flight (play k cc (msgs k sv [0, 1, 2])) & " fin-equal=" & show equal

  ee-seal : List Integer, List Integer -> List Integer
  ee-seal (k) (body) = tep-enc k 0 tls-content-handshake (tls13-msg-transcript dtls-hs-encrypted-ext body)

  ee-body : Integer -> List Integer
  ee-body (n) =
    if n == 1 then [0, 4, 0, 0, 0, 0]
    else if n == 2 then [0, 10, 0, 10, 0, 6, 0, 4, 0, 29, 0, 23]
    else if n == 3 then [0, 4, 0, 51, 0, 0]
    else if n == 4 then [0, 6, 0, 43, 0, 2, 3, 4]
    else if n == 5 then [0, 8, 0, 13, 0, 4, 0, 2, 8, 7]
    else if n == 6 then [0, 4, 0, 16, 0, 0]
    else if n == 7 then [0, 5, 0, 0, 0, 1, 7]
    else if n == 8 then [0, 5, 0, 0, 0, 0]
    else [0, 8, 0, 0, 0, 0, 0, 0, 0, 0]

  ee-code : Integer -> Integer
  ee-code (n) = if n == 6 then 110 else if n == 7 then 50 else if n == 8 then 50 else 47

  fl-order : Integer -> List Integer
  fl-order (n) =
    if n == 11 then [1, 2]
    else if n == 12 then [0, 0, 1, 2]
    else if n == 13 then [0, 2, 1]
    else [0, 1, 1, 2]

  open-msg : List Integer, TlsEpStep, Integer -> List Integer
  open-msg (k) (sv) (i) =
    when tep-dec k i (list-at (sv.tes-out) (i + 1))
      is None -> []
      is Just (inner) -> inner.ti-data

  msgs : List Integer, TlsEpStep, List Integer -> List (List Integer)
  msgs (k) (sv) (idx) = msgs-loop k sv idx 0 []

  msgs-loop : List Integer, TlsEpStep, List Integer, Integer, List (List Integer) -> List (List Integer)
  msgs-loop (k) (sv) (idx) (i) (acc) =
    if i >= list-length idx then acc
    else msgs-loop k sv idx (i + 1) (acc & [open-msg k sv (list-at idx i)])

  cat-all : List (List Integer), Integer, List Integer -> List Integer
  cat-all (ms) (i) (acc) = if i >= list-length ms then acc else cat-all ms (i + 1) (acc & list-at ms i)

  fin-for : List Integer, TlsEpStep, List (List Integer) -> List Integer
  fin-for (k) (cc) (ms) =
    let th = tls13-transcript-hash ((cc.tes-ep).tep-transcript & cat-all ms 0 [])
    in tls13-msg-transcript dtls-hs-finished (tls13-verify-data k th)

  play-loop : List Integer, TlsEpStep, List (List Integer), Integer -> TlsEpStep
  play-loop (k) (st) (ms) (i) =
    if i >= list-length ms then st
    else let s2 = tls-ep-recv (st.tes-ep) (tep-enc k i tls-content-handshake (list-at ms i))
    in play-loop k (TlsEpStep { tes-ep = s2.tes-ep, tes-out = (st.tes-out) & (s2.tes-out) }) ms (i + 1)

  play : List Integer, TlsEpStep, List (List Integer) -> TlsEpStep
  play (k) (cc) (ms) = play-loop k (TlsEpStep { tes-ep = cc.tes-ep, tes-out = [] }) (ms & [fin-for k cc ms]) 0

  feed : TlsEpStep, List (List Integer), Integer -> TlsEpStep
  feed (st) (recs) (i) =
    if i >= list-length recs then st
    else feed (tls-ep-recv (st.tes-ep) (list-at recs i)) recs (i + 1)

  cfin-of : Integer, TlsEp, TlsEpStep -> Text
  cfin-of (kind) (s) (c) =
    let key = (c.tes-ep).tep-c-hs
    in when tep-dec key 0 (first-out c)
      is None -> "no client Finished"
      is Just (inner) -> cfin-verdict kind (tls-ep-recv s (tep-enc key 0 tls-content-handshake (cfin-change kind (inner.ti-data))))

  cfin-verdict : Integer, TlsEpStep -> Text
  cfin-verdict (kind) (st) = "done=" & show (tls-ep-done (st.tes-ep)) & " " & alert-is st (if kind == 3 then 50 else if kind == 4 then 51 else 10)

 Row 40 plays the genuine flight with the last verify_data byte of the server Finished flipped; row 41 (kind 4) flips
 the first verify_data byte of the client Finished.

  flight-with-fin : List Integer, TlsEpStep, List (List Integer) -> TlsEpStep
  flight-with-fin (k) (cc) (ms) =
    let fin = fin-for k cc ms
    in play-loop k (TlsEpStep { tes-ep = cc.tes-ep, tes-out = [] }) (ms & [set-at fin (list-length fin - 1) (bit-xor (list-at fin (list-length fin - 1)) 1)]) 0

  fin-row : TlsEpStep -> Text
  fin-row (st) = "done=" & show (tls-ep-done (st.tes-ep)) & " " & alert-is st 51

  cfin-change : Integer, List Integer -> List Integer
  cfin-change (kind) (m) =
    if kind == 4 then set-at m 4 (bit-xor (list-at m 4) 1)
    else if kind == 1 then set-at m 0 11
    else if kind == 2 then m & [24, 0, 0, 1, 0]
    else if kind == 3 then set-at m 3 33
    else m

  flight : TlsEpStep -> Text
  flight (st) = "done=" & show (tls-ep-done (st.tes-ep)) & " " & refused st

Section: Results
  test-control : Text =
    "control client-done=" & show (tls-ep-done (c5.tes-ep)) & " server-done=" & show (tls-ep-done (sv2.tes-ep)) & " c2s=" & show (tr-eq (tls-ep-app-in (sv3.tes-ep)) [71, 69, 84])
  test-srv-repeat : Text = "server repeated-hello " & refused srv-repeat
  test-srv-late : Text = "server late-hello " & refused srv-late & " done=" & show (tls-ep-done (srv-late.tes-ep))
  test-srv-mistyped : Text = "server mistyped-hello " & refused srv-mistyped
  test-cli-unasked : Text = "client unasked-hello " & refused cli-unasked
  test-cli-second : Text = "client second-hello " & refused cli-second
  test-cli-late : Text = "client late-hello " & refused cli-late & " done=" & show (tls-ep-done (cli-late.tes-ep))
  test-sh-cipher : Text = "client sh cipher-not-offered " & alert-is sh-cipher 47
  test-sh-compression : Text = "client sh compression-1 " & alert-is sh-compression 47
  test-sh-legacy : Text = "client sh legacy-version-0302 " & alert-is sh-legacy 47
  test-sh-version : Text = "client sh supported-version-0303 " & alert-is sh-version 70
  test-sh-group : Text = "client sh key-share-group-23 " & alert-is sh-group 47
  test-ch-suite : Text = "server ch suite-not-1301 " & alert-is ch-suite 40
  test-ch-compression : Text = "server ch compression-1 " & alert-is ch-compression 47
  test-ch-version : Text = "server ch supported-version-0303 " & alert-is ch-version 70
  test-hs-0 : Text = "client ee " & hs-row 0
  test-hs-1 : Text = "client ee server-name-ack " & hs-row 1
  test-hs-2 : Text = "client ee supported-groups " & hs-row 2
  test-hs-3 : Text = "client ee key-share " & hs-row 3
  test-hs-4 : Text = "client ee supported-versions " & hs-row 4
  test-hs-5 : Text = "client ee signature-algorithms " & hs-row 5
  test-hs-6 : Text = "client ee alpn-not-offered " & hs-row 6
  test-hs-7 : Text = "client ee server-name-with-data " & hs-row 7
  test-hs-8 : Text = "client ee length-past-body " & hs-row 8
  test-hs-9 : Text = "client ee server-name-twice " & hs-row 9
  test-hs-10 : Text = "client flight genuine-replayed " & hs-row 10
  test-hs-11 : Text = "client flight without-ee " & hs-row 11
  test-hs-12 : Text = "client flight ee-twice " & hs-row 12
  test-hs-13 : Text = "client flight cv-before-cert " & hs-row 13
  test-hs-14 : Text = "client flight cert-twice " & hs-row 14
  test-hs-15 : Text = "client flight one-record ee-cv-cv " & hs-row 15
  test-hs-16 : Text = "server cfin genuine-resealed " & hs-row 16
  test-hs-17 : Text = "server cfin typed-11 " & hs-row 17
  test-hs-18 : Text = "server cfin then-key-update " & hs-row 18
  test-hs-19 : Text = "server cfin length-33 " & hs-row 19
  test-hs-20 : Text = "client hs-epoch inner application-data " & hs-row 20
  test-hs-21 : Text = "client hs-epoch inner type-99 " & hs-row 21
  test-hs-22 : Text = "client hs-epoch inner alert " & hs-row 22
  test-hs-23 : Text = "server hs-epoch inner application-data " & hs-row 23
  test-hs-24 : Text = "server hs-epoch inner type-99 " & hs-row 24
  test-hs-25 : Text = "client app-epoch inner type-99 " & hs-row 25
  test-hs-26 : Text = "client app-epoch inner handshake " & hs-row 26
  test-hs-27 : Text = "client app-epoch inner application-data " & hs-row 27
  test-hs-28 : Text = "client app-epoch close_notify then data " & hs-row 28
  test-hs-29 : Text = "client app-epoch fatal alert then data " & hs-row 29
  test-hs-30 : Text = "client hs-epoch fatal alert " & hs-row 30
  test-hs-31 : Text = "client plaintext fatal alert after hello " & hs-row 31
  test-hs-32 : Text = "client app-epoch user_canceled then data " & hs-row 32
  test-hs-33 : Text = "client plaintext fatal alert after server hello " & hs-row 33
  test-hs-34 : Text = "client key-update then data under the next key " & hs-row 34
  test-hs-35 : Text = "client key-update requested, answer and data to server " & hs-row 35
  test-hs-36 : Text = "client key-update length-2 " & hs-row 36
  test-hs-37 : Text = "client key-update value-2 " & hs-row 37
  test-hs-38 : Text = "client post-handshake certificate-request " & hs-row 38
  test-hs-39 : Text = "client key-update then ticket in one record " & hs-row 39
  test-hs-40 : Text = "client server-finished one byte flipped " & hs-row 40
  test-hs-41 : Text = "server client-finished one byte flipped " & hs-row 41
  test-chx : Text = "server ch rebuilt-unchanged outs=" & show (list-length ((ch-to-fresh (ch-rebuilt [] 0)).tes-out)) & " versions-twice " & alert-is (ch-to-fresh (ch-rebuilt [0, 43, 0, 3, 2, 3, 4] 0)) 47 & " extensions-length-past-body " & alert-is (ch-to-fresh (ch-rebuilt [] 1)) 50
  test-chf : Text = "server ch session-id-33 " & alert-is (ch-to-fresh (ch-wrap ch-sid33)) 50 & " suites-odd " & alert-is (ch-to-fresh (ch-wrap ch-suites-odd)) 50
  test-chks : Text = "server ch client-shares-length-plus-1 " & alert-is (ch-to-fresh (ch-wrap (ch-shares-len 1))) 50 & " minus-1 " & alert-is (ch-to-fresh (ch-wrap (ch-shares-len (0 - 1)))) 50
  test-chvec : Text = "server ch versions-vector-past " & alert-is (ch-to-fresh (ch-wrap (ch-vec-past 43 0 1))) 50 & " sigalgs-vector-past " & alert-is (ch-to-fresh (ch-wrap (ch-vec-past 13 1 2))) 50
  test-hs-54 : Text = "client send at record 16777215 " & hs-row 54
  test-hs-55 : Text = "client send at record 16777216 " & hs-row 55
  test-hs-56 : Text = "client hs-epoch inner all-zero " & hs-row 56
  test-hs-57 : Text = "server hs-epoch inner all-zero " & hs-row 57
  test-hs-58 : Text = "client app-epoch inner all-zero " & hs-row 58
  test-hs-50 : Text = "client change-cipher-spec 01 after server hello " & hs-row 50
  test-hs-51 : Text = "client change-cipher-spec 02 after server hello " & hs-row 51
  test-hs-52 : Text = "server change-cipher-spec before client hello " & hs-row 52
  test-hs-53 : Text = "client change-cipher-spec 01 after handshake " & hs-row 53
  test-hs-48 : Text = "client certificate split across two records " & hs-row 48
  test-hs-49 : Text = "client certificate declaring 200000 bytes " & hs-row 49
  test-hs-46 : Text = "client record 16641 after handshake " & hs-row 46
  test-hs-47 : Text = "server plaintext record 16385 " & hs-row 47
  test-hs-42 : Text = "client certificate empty " & hs-row 42
  test-hs-43 : Text = "client certificate entry past its message " & hs-row 43
  test-hs-44 : Text = "client certificate-verify byte past its signature " & hs-row 44
  test-hs-45 : Text = "client certificate-verify scheme not offered " & hs-row 45
  test-shx-control : Text = "client sh rebuilt-unchanged same-bytes=" & show (tr-eq (sh-rebuilt [] 0) sh) & " " & alert-is (sh-plus []) 47
  test-shx-sni : Text = "client sh server-name " & alert-is (sh-plus [0, 0, 0, 0]) 47
  test-shx-alpn : Text = "client sh alpn-not-offered " & alert-is (sh-plus [0, 16, 0, 0]) 110
  test-shx-twice : Text = "client sh supported-versions-twice " & alert-is (sh-plus [0, 43, 0, 2, 3, 4]) 47
  test-shx-short : Text = "client sh extensions-length-past-body " & alert-is (tls-ep-recv (cs1.tes-ep) (sh-rebuilt [] 1)) 50
  test-big : Text = "send 20000 records=" & show (list-length (big.tes-out)) & " received=" & show (list-length (tls-ep-app-in (big2.tes-ep)))
  test-cli-mistyped : Text = "client mistyped-hello " & refused cli-mistyped & " then-done=" & show (tls-ep-done (mt5.tes-ep))

