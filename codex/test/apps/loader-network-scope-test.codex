Chapter: LoaderNetworkScopeTest
  cites Verify chapter ProcessCaps
  cites Verify chapter VerifiedLoader
  cites Verify chapter CdxVerifier
  cites Verify chapter CdxBinary
  cites Trust chapter TrustLattice
  cites Trust chapter PolicyEngine
  cites Foreword chapter Ed25519
  cites Foreword chapter Sha256
  cites Foreword chapter Sha512
  cites Foreword chapter Maybe
  cites Foreword chapter Hamt
  cites Foreword chapter FactStore

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

  test-sk : List Integer = [157, 97, 177, 157, 239, 253, 90, 96, 186, 132, 74, 244, 146, 236, 44, 196, 68, 73, 197, 105, 123, 50, 105, 25, 112, 59, 172, 3, 28, 174, 127, 96]

  scoped-binary : List Integer
  scoped-binary = cdx-encode-signed (CdxBinaryParts {
    flags = cdx-flag-bare-metal,
    capabilities = [
      CdxCapability { cap-id = cdx-cap-network, direction = cdx-dir-write, scope = "api.example.com", max-duration = 0 }
    ],
    effects = ["Network"],
    text-bytes = [144, 195],
    rodata-bytes = [],
    entry-offset = 0,
    stack-size = 65536,
    heap-size = 65536,
    trust-threshold = 5000
  }) test-sk

  open-binary : List Integer
  open-binary = cdx-encode-signed (CdxBinaryParts {
    flags = cdx-flag-bare-metal,
    capabilities = [
      CdxCapability { cap-id = cdx-cap-network, direction = cdx-dir-write, scope = "", max-duration = 0 }
    ],
    effects = ["Network"],
    text-bytes = [144, 195],
    rodata-bytes = [],
    entry-offset = 0,
    stack-size = 65536,
    heap-size = 65536,
    trust-threshold = 5000
  }) test-sk

Section: Body
  opening : [Console, Capability] Nothing =
    let lat = lattice-add-direct lattice-empty (read-author-key scoped-binary) 8000
    in let policy = policy-add-rule (policy-empty "test") (rule-allow "allow-all" AlwaysTrue)
    in let scoped = evaluate-load scoped-binary lat policy 0 fact-store-empty 100
    in let opened = evaluate-load open-binary lat policy 0 fact-store-empty 100
    in let denied = evaluate-load scoped-binary lattice-empty policy 0 fact-store-empty 100
    in act
      w1 <- apply-load-decision 5 scoped
      print-line-uni ("scoped approved=" & show-bool (load-approved scoped) & " net-scope=[" & read-process-network-scope 5 & "]")

      w2 <- apply-load-decision 6 opened
      print-line-uni ("open   approved=" & show-bool (load-approved opened) & " net-scope=[" & read-process-network-scope 6 & "]")

      w3 <- apply-load-decision 8 denied
      print-line-uni ("denied wired=" & show-bool w3 & " bits=" & show (read-process-grant 8) & " net-scope=[" & read-process-network-scope 8 & "]")
    end
