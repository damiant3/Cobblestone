Chapter: ErpPricingTest
  cites Codex chapter General
  cites ERP chapter ErpTypes
  cites ERP chapter ErpConfig
  cites ERP chapter SdSales

 Known-answer test for the condition pricing engine. Base 10000 at
 quantity 5 gives line base 50000. A 10 percent customer discount
 takes 5000; a volume discount of 5 percent over minimum quantity 10
 does not apply at quantity 5; surcharge 500 and freight 1000 add
 flat; 8 percent tax applies to the running net. Also pins
 convert-currency round-half-up.

Section: Setup

  conditions : List PricingCondition =
    [
      PricingCondition { prc-type = CustomerDiscount, prc-amount = 1000, prc-currency = "USD", prc-per-unit = False, prc-from-date = 0, prc-to-date = 99999999 },
      PricingCondition { prc-type = VolumeDiscount (10) (5), prc-amount = 0, prc-currency = "USD", prc-per-unit = False, prc-from-date = 0, prc-to-date = 99999999 },
      PricingCondition { prc-type = Surcharge, prc-amount = 500, prc-currency = "USD", prc-per-unit = False, prc-from-date = 0, prc-to-date = 99999999 },
      PricingCondition { prc-type = Freight, prc-amount = 1000, prc-currency = "USD", prc-per-unit = False, prc-from-date = 0, prc-to-date = 99999999 },
      PricingCondition { prc-type = Tax, prc-amount = 800, prc-currency = "USD", prc-per-unit = False, prc-from-date = 0, prc-to-date = 99999999 }
    ]

Section: Tests

  test-pricing : Text =
    let r = calc-pricing 10000 5 conditions
    in let head = "pricing: base=" & show (r.prr-base) & " disc=" & show (r.prr-discounts) & " sur=" & show (r.prr-surcharges)
    in head & " freight=" & show (r.prr-freight) & " tax=" & show (r.prr-tax) & " net=" & show (r.prr-net)

  test-volume-applies : Text =
    let r = calc-pricing 10000 12 [PricingCondition { prc-type = VolumeDiscount (10) (5), prc-amount = 0, prc-currency = "USD", prc-per-unit = False, prc-from-date = 0, prc-to-date = 99999999 }]
    in "volume: base=" & show (r.prr-base) & " disc=" & show (r.prr-discounts) & " net=" & show (r.prr-net)

  test-currency : Text =
    let rate = ExchangeRate { xr-from = "EUR", xr-to = "USD", xr-rate-x10000 = 10750, xr-date = 0 }
    in "currency: converted=" & show (convert-currency 12345 rate)

Section: Body

  opening : [Console] Nothing = act
    print-line-uni test-pricing
    print-line-uni test-volume-applies
    print-line-uni test-currency
  end
