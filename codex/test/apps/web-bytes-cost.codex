Chapter: WebBytesCost
  cites Net chapter WebServer
  cites Foreword chapter Console

 We say:

Section: Fixtures

  bytes-of : Integer -> List Integer
  bytes-of (n) = fill n 0 (__list-with-capacity (n + 1))

  fill : Integer, Integer, List Integer -> List Integer
  fill (n) (i) (acc) =
    if i >= n then acc
    else fill n (i + 1) (list-push acc 97)

Section: Measurement

 The 256-byte chunking hides the outer append below about 64 KB, so the two
 sizes are 64 KB and 256 KB.

  retained : List Integer -> Integer
  retained (bs) =
    let b = __heap-save
    in let len = text-length (bytes-to-text bs 0 (list-length bs) "")
    in let a = __heap-save
    in (a - b) + len - len

  verdict : Integer, Integer -> Text
  verdict (at-n) (at-4n) =
    if at-n <= 0 then "unmeasured"
    else if at-4n < at-n * 8 then "linear" else "quadratic"

Section: Entry

  opening : [Console] Nothing = act
    let small = bytes-of 65536
    in let large = bytes-of 262144
    in let big = bytes-of 2097152
    in act
      print-line-uni ("text=" & bytes-to-text [71, 69, 84, 32, 47] 0 5 "" & " tail=" & bytes-to-text [120, 97, 98] 1 3 "pre")
      print-line-uni ("growth=" & verdict (retained small) (retained large))
      print-line-uni ("big-len=" & show (text-length (bytes-to-text big 0 2097152 "")))
    end
  end
