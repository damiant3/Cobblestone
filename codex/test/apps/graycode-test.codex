Chapter: GrayCodeTest
  cites Codex chapter General
  cites Encode chapter GrayCode

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-encode-zero : Text =
    "g0=" & show (gray-encode 0)

  test-encode-values : Text =
    "g1=" & show (gray-encode 1) & " g2=" & show (gray-encode 2) & " g3=" & show (gray-encode 3) & " g7=" & show (gray-encode 7)

  test-roundtrip : Text =
    "rt5=" & show (gray-decode (gray-encode 5)) & " rt13=" & show (gray-decode (gray-encode 13))

  test-adjacent : Text =
    "adj01=" & show-bool (gray-adjacent 0 1) & " adj12=" & show-bool (gray-adjacent 1 2) & " adj02=" & show-bool (gray-adjacent 0 2)

  test-sequence : Text =
    let seq = gray-sequence 3
    in "len=" & show (list-length seq) & " g0=" & show (list-at seq 0) & " g7=" & show (list-at seq 7)

  opening : [Console] Nothing = act
    print-line-uni test-encode-zero
    print-line-uni test-encode-values
    print-line-uni test-roundtrip
    print-line-uni test-adjacent
    print-line-uni test-sequence
  end
