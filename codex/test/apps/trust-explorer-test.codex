Chapter: TrustExplorerTest

  cites Foreword chapter Console
  cites Works chapter Annotation

Section: Body

  opening : [Console] Nothing =
    let store = annotation-store-empty
    in let c0 = integer-to-text (annotation-count store)
    in let t = make-target "Trust" "verify"
    in let a = create-annotation t Invariant "auditor" "chain must be acyclic" 500
    in let store2 = annotation-store-add store a
    in let c1 = integer-to-text (annotation-count store2)
    in act
      print-line-uni ("empty=" & c0)
      print-line-uni ("after-add=" & c1)
    end
