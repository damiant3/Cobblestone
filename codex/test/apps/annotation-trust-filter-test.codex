Chapter: AnnotationTrustFilterTest

  cites Foreword chapter Console
  cites Works chapter Annotation

Section: Body

  opening : [Console] Nothing =
    let t = make-target "Security" "validate-input"
    in let a1 = create-annotation t Warning "trusted-dev" "SQL injection risk" 8000
    in let a2 = create-annotation t Rationale "new-dev" "looks fine to me" 9000
    in let h1 = integer-to-text (text-length (a1.hash))
    in let h2 = integer-to-text (text-length (a2.hash))
    in let same = if target-key (a1.target) == target-key (a2.target) then "yes" else "no"
    in act
      print-line-uni ("a1-author=" & a1.author & " hash-len=" & h1)
      print-line-uni ("a2-author=" & a2.author & " hash-len=" & h2)
      print-line-uni ("same-target=" & same)
    end
