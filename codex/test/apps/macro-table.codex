Chapter: MacroTableTest
  cites Dev chapter Macro
  cites Foreword chapter Maybe

 The macro table and the splitter, with no console and no machine.

 EVERY REFUSAL IS EXERCISED, not just the accepting path. Each cap in the
 chapter is a branch that only fires on input an operator gets wrong, so
 an untested cap is a cap that has never run; and the failure mode of a
 broken cap is silent truncation, which looks exactly like a macro that
 worked. The table is filled to its limit here so the full-table refusal
 is a measurement rather than a reading of the source.

 REPLACEMENT IS CHECKED BY COUNT AS WELL AS BY BODY. A redefine that
 appended instead of replacing would still answer the new body from
 `macro-find` if the new entry happened to be found first, so the body
 alone does not discriminate; the count does.

 THE SIXTEENTH REDEFINE IS THE INTERESTING CASE. With the table full, a
 replacement must still succeed, because it does not grow the table --
 checking the cap before checking whether the name exists would refuse an
 operator's correction on the grounds that they have made sixteen macros.

 We say:

Section: Joining

  joined : List Text, Integer, Text -> Text
  joined (xs) (i) (acc) =
    if i >= list-length xs then acc
    else if text-length acc == 0 then joined xs (i + 1) (list-at xs i)
    else joined xs (i + 1) (acc & " | " & list-at xs i)

Section: Filling

  fill : MacroTable, Integer, Integer -> MacroTable
  fill (tbl) (i) (n) =
    if i >= n then tbl
    else fill ((macro-define tbl ("m" & show i) "perf").md-table) (i + 1) n

Section: Showing A Definition

  shown : MacroDefine -> Text
  shown (d) = show (d.md-ok) & " " & d.md-message & " count=" & show (macro-count (d.md-table))

Section: Showing A Repeat

  shown-repeat : MacroRepeat -> Text
  shown-repeat (r) =
    if r.mr-ok then "ok " & show (r.mr-count) & " [" & r.mr-command & "]"
    else r.mr-message

Section: Body

  opening : [Console] Nothing = act
    let t0 = macro-table-new
    in let d1 = macro-define t0 "look" "mem ; perf ; idt.counts"
    in let t1 = d1.md-table
    in act
      print-line-uni ("empty: " & joined (macro-list-lines t0) 0 "")
      print-line-uni ("define: " & shown d1)
      print-line-uni ("list: " & joined (macro-list-lines t1) 0 "")

      print-line-uni ("split: " & joined (macro-split "mem ; perf ; idt.counts") 0 "")
      print-line-uni ("split-empties: " & joined (macro-split " mem ;; ; perf ; ") 0 "")
      print-line-uni ("split-count: " & show (list-length (macro-split " mem ;; ; perf ; ")))

      print-line-uni ("find: " & when macro-body-of t1 "look" is None -> "MISSING" is Just (b) -> b)
      print-line-uni ("find-absent: " & when macro-body-of t1 "nope" is None -> "none" is Just (b) -> "FOUND " & b)

      let d2 = macro-define t1 "look" "perf"
      in print-line-uni ("redefine: " & shown d2)

      let d3 = macro-define t0 "" "perf"
      in print-line-uni ("no-name: " & shown d3)

      let d4 = macro-define t0 "empty" "  ;  ; "
      in print-line-uni ("no-commands: " & shown d4)

      let d5 = macro-define t0 "toomany" "a;b;c;d;e;f;g;h;i;j;k;l;m;n;o;p;q"
      in print-line-uni ("too-many-commands: " & shown d5)

      let full = fill t0 0 16
      in act
        print-line-uni ("filled: " & show (macro-count full))
        let d6 = macro-define full "one-more" "perf"
        in print-line-uni ("table-full: " & shown d6)
        let d7 = macro-define full "m3" "idt.irq"
        in print-line-uni ("replace-when-full: " & shown d7)
        print-line-uni ("replaced-body: " & when macro-body-of (d7.md-table) "m3" is None -> "MISSING" is Just (b) -> b)
        print-line-uni ("cleared: " & show (macro-count (macro-clear full)))
      end

      print-line-uni ("repeat-ok: " & shown-repeat (macro-parse-repeat "3 mem"))
      print-line-uni ("repeat-spaces: " & shown-repeat (macro-parse-repeat "  2   disk.sb  "))
      print-line-uni ("repeat-no-cmd: " & shown-repeat (macro-parse-repeat "5"))
      print-line-uni ("repeat-not-number: " & shown-repeat (macro-parse-repeat "x mem"))
      print-line-uni ("repeat-zero: " & shown-repeat (macro-parse-repeat "0 mem"))
      print-line-uni ("repeat-over: " & shown-repeat (macro-parse-repeat "65 mem"))
      print-line-uni ("repeat-limit: " & shown-repeat (macro-parse-repeat "64 mem"))
    end
  end
