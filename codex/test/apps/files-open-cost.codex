Chapter: FilesOpenCostTest
  cites Works chapter GopDesk
  cites Works chapter GopFiles
  cites Works chapter GopFat16
  cites Foreword chapter Fat16
  cites Foreword chapter Console

 What the Files pane's `-open` allocates, which is D.5's `want` for that pane.

 The open counts the directory and builds a `FilesState` around the count;
 the rows are read a screenful at a time by each paint. The count walk reads
 every sector inside a heap bracket, so the want is expected to be the same
 at the root and in a subdirectory, whose listing walks a FAT chain the root
 does not.

 The second and third lines are the D.5 sizing: the GPT lookup, which
 `desk-files-open` brackets at the frontier because its cost follows the
 medium's partition array, and the part the open runs inside its hole
 (`desk-files-mount`, `desk-files-build`), which `desk-files-want` must
 exceed by at least a page.

 THE FIRST LINE IS THE CONTROL. `alloc-bytes 0` answers the frontier without
 advancing it, so two reads with nothing between must differ by zero, or every
 number below is the probe's own footprint (L-FALSIF).

 THE WHOLE-DIRECTORY LISTING IS THE SECOND CONTROL. `gfl-list-cur` is what the
 open used to keep, and its cost differs between the two directories. An arm
 that reads the same number for the new open and a different one for the old
 listing is one that can see the difference it claims is gone.

 The navigation path (`fs-clusters`) is built before each reading: it grows
 with depth by design, as a directory change the step keeps, and it is not the
 listing.

Section: Body

  foc-yn : Boolean -> Text
  foc-yn (v) = if v then "PASS" else "FAIL"

  foc-names : List Fat16DirEntry, Integer, Text -> Text
  foc-names (es) (i) (acc) =
    if i >= list-length es then acc
    else foc-names es (i + 1) (acc & (if i == 0 then "" else ",") & (list-at es i).de-name)

Section: Entry

  opening : [Console, Device.Port] Nothing = act
    let c0 = alloc-bytes 0
    in let c1 = alloc-bytes 0
    in act
      print-line-uni ("CONTROL, the probe allocates nothing: " & foc-yn (c1 - c0 == 0))
      let g0 = alloc-bytes 0
      in act
      start <- gpt-esp-start
      let g1 = alloc-bytes 0
      in let r = __heap-restore g0
      in let o0 = alloc-bytes 0
      in act
      m <- desk-files-mount start
      sto <- desk-files-build (gapp-fallback (CbfFont { cbf-base = 0 })) m
      let o1 = alloc-bytes 0
      in act
      print-line-uni ("CONTROL, the GPT lookup the bracket drops costs: " & integer-to-text (g1 - g0))
      print-line-uni ("the open in the hole costs " & integer-to-text (o1 - o0) & ", want " & integer-to-text desk-files-want & ", a page to spare: " & foc-yn (desk-files-want - (o1 - o0) >= 4096 & sto.fs-count == 2))
      if m.gm-ok == False then print-line-uni "mount FAILED"
      else act
        let fonts = gapp-fallback (CbfFont { cbf-base = 0 })
        in let flag = if gfat-is32 (m.gm-vol) then (m.gm-vol).vol-root-start else 0 - 1
        in let clusters = [flag]
        in let a0 = alloc-bytes 0
        in act
          n <- gfl-count-cur (m.gm-vol) clusters
          let st = FilesState { fs-fonts = fonts, fs-vol = m.gm-vol, fs-count = n, fs-clusters = clusters, fs-names = [], fs-sel = 0, fs-top = 0, fs-ptr = 0, fs-mode = 0 }
          in let a1 = alloc-bytes 0
          in act
            ents <- gfl-list-cur (m.gm-vol) clusters
            let a2 = alloc-bytes 0
            in act
              w0 <- gfl-window-cur (m.gm-vol) clusters 0 20
              w1 <- gfl-window-cur (m.gm-vol) clusters 1 20
              d <- gfat-resolve (m.gm-vol) "EFI"
              when d
                is None -> print-line-uni "EFI not found"
                is Just (de) -> act
                  let cl2 = [flag, de.de-cluster]
                  in let b0 = alloc-bytes 0
                  in act
                    n2 <- gfl-count-cur (m.gm-vol) cl2
                    let st2 = FilesState { fs-fonts = fonts, fs-vol = m.gm-vol, fs-count = n2, fs-clusters = cl2, fs-names = [], fs-sel = 0, fs-top = 0, fs-ptr = 0, fs-mode = 0 }
                    in let b1 = alloc-bytes 0
                    in act
                      e2 <- gfl-list-cur (m.gm-vol) cl2
                      let b2 = alloc-bytes 0
                      in act
                        v0 <- gfl-window-cur (m.gm-vol) cl2 0 20
                        print-line-uni ("want at the root: " & integer-to-text (a1 - a0))
                        print-line-uni ("want in a subdirectory: " & integer-to-text (b1 - b0))
                        print-line-uni ("want is the same in both: " & foc-yn (b1 - b0 == a1 - a0))
                        print-line-uni ("CONTROL, the whole listing: root " & integer-to-text (a2 - a1) & ", subdirectory " & integer-to-text (b2 - b1))
                        print-line-uni ("CONTROL, the whole listing differs: " & foc-yn (b2 - b1 /= a2 - a1))
                        print-line-uni ("counts " & integer-to-text (st.fs-count) & " and " & integer-to-text (st2.fs-count) & " match the listings: " & foc-yn (st.fs-count == list-length ents & st2.fs-count == list-length e2))
                        print-line-uni ("root window " & foc-names w0 0 "" & ": " & foc-yn (foc-names w0 0 "" == foc-names ents 0 ""))
                        print-line-uni ("root window from 1 " & foc-names w1 0 "" & ": " & foc-yn (list-length w1 == list-length ents - 1 & foc-names w1 0 "" == (list-at ents 1).de-name))
                        print-line-uni ("subdirectory window " & foc-names v0 0 "" & ": " & foc-yn (foc-names v0 0 "" == foc-names e2 0 ""))
                      end
                    end
                  end
                end
            end
          end
        end
      end
      end
      end
      end
    end
  end
