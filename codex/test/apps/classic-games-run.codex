Section: Engines With No Other Caller

  unreached-engines : [Console] Nothing
  unreached-engines =
    let battleship = run-battleship-game
    in let blackjack = run-blackjack-session 42 10
    in let dots = run-dots-game
    in let g2048 = run-2048-game
    in let hex = run-hex-game
    in let liars = run-liars-dice 77 4
    in let life = run-life-sim 21 30
    in let mastermind = run-mastermind-game 55
    in let minesweeper = run-minesweeper-game
    in let othello = run-othello-game
    in let ur = run-ur-game 99
    in let rps = run-rps-series 13 20
    in let sudoku = run-sudoku-solve
    in let war = run-war-game 34
    in let yahtzee = run-yahtzee-game 89
    in act
      print-line-uni (format-battleship-result battleship)
      print-line-uni (format-blackjack-result blackjack)
      print-line-uni (format-dots-result dots)
      print-line-uni (format-2048-result g2048)
      print-line-uni (format-hex-result hex)
      print-line-uni (format-liars-result liars)
      print-line-uni (format-life-result life)
      print-line-uni (format-mastermind-result mastermind)
      print-line-uni (format-minesweeper-result minesweeper)
      print-line-uni (format-othello-result othello)
      print-line-uni (format-ur-result ur)
      print-line-uni (format-rps-result rps)
      print-line-uni (format-sudoku-result sudoku)
      print-line-uni (format-war-result war)
      print-line-uni (format-yahtzee-result yahtzee)
    end

Section: Engines The Demo Reaches

  demo-engines : [Console] Nothing
  demo-engines =
    let ttt = run-ttt-perfect
    in let connect4 = run-connect4-game
    in let checkers = run-checkers-game 99 4
    in let go-result = run-go-game
    in let mancala = run-mancala-game 42 4
    in let backgammon = run-backgammon-game 21
    in let set-count = run-set-game 137
    in let poker = run-poker-session 7 10
    in let stud7 = run-poker-variant SevenCardStud 123 4
    in let pinochle = run-pinochle-hand 55
    in let bridge = run-bridge-hand 77
    in let eights = run-crazy-eights 99 3
    in let gofish = run-go-fish 42 3
    in let mahjong = run-mahjong-game 101
    in let spider = run-spider-game 42
    in let monopoly = run-monopoly-game 77 4
    in let risk = run-risk-game 33 3
    in act
      print-line-uni (format-ttt-perfect ttt)
      print-line-uni (format-connect4-result connect4)
      print-line-uni (format-checker-result checkers)
      print-line-uni (format-go-result go-result)
      print-line-uni ("Mancala: " & (if mancala.winner == 0 then "South" else if mancala.winner == 1 then "North" else "Draw") & " wins " & show (mancala.south-score) & "-" & show (mancala.north-score))
      print-line-uni (format-backgammon-result backgammon)
      print-line-uni (format-set-result set-count 12)
      print-line-uni (format-poker-result poker)
      print-line-uni (format-poker-variant stud7)
      print-line-uni (format-pinochle-result pinochle)
      print-line-uni (format-bridge-result bridge)
      print-line-uni (format-crazy-eights eights)
      print-line-uni (format-go-fish gofish 3)
      print-line-uni (format-mahjong-result mahjong)
      print-line-uni (format-spider-result spider)
      print-line-uni (format-monopoly-result monopoly)
      print-line-uni (format-risk-result risk)
    end

Section: Entry

  opening : [Console] Nothing
  opening = act
    unreached-engines
    demo-engines
  end

