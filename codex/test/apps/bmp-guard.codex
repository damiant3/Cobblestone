Chapter: Bmp Guard
  cites Foreword chapter Console
  cites Game chapter Color
  cites Foreword chapter MathLib (int-widen)
  cites Encode chapter Bmp

Section: Helpers

  px-text : Rgb -> Text
  px-text (p) = show (int-widen (p.cr)) & "," & show (int-widen (p.cg)) & "," & show (int-widen (p.cb))

  px-list : List Rgb, Integer, Text -> Text
  px-list (ps) (i) (acc) =
    if i >= list-length ps then acc
    else px-list ps (i + 1) (acc & " " & px-text (list-at ps i))

  set-at : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  set-at (bs) (at) (v) (i) (acc) =
    if i >= list-length bs then acc
    else set-at bs at v (i + 1) (list-push acc (if i == at then v else list-at bs i))

  take : List Integer, Integer, Integer, List Integer -> List Integer
  take (bs) (n) (i) (acc) =
    if i >= n then acc else take bs n (i + 1) (list-push acc (list-at bs i))

  arm : Text, List Integer -> Text
  arm (name) (bs) =
    let img = bmp-decode bs
    in if img.bmp-ok then name & " " & show (img.bmp-width) & "x" & show (img.bmp-height) & px-list (img.bmp-pixels) 0 ""
    else name & " refused"

  two : List Integer = bmp-encode 2 2 [rgb 255 0 0, rgb 0 255 0, rgb 0 0 255, rgb 255 255 255]

  top-down : List Integer =
    set-at (set-at (set-at (set-at two 22 254 0 []) 23 255 0 []) 24 255 0 []) 25 255 0 []

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (arm "good-2x2" two)
    print-line-uni (arm "top-down" top-down)
    print-line-uni (arm "width-3" (bmp-encode 3 1 [rgb 1 2 3, rgb 4 5 6, rgb 7 8 9]))
    print-line-uni (arm "runt" (take two 20 0 []))
    print-line-uni (arm "cut-pixels" (take two 66 0 []))
    print-line-uni (arm "bad-magic" (set-at two 0 0 0 []))
    print-line-uni (arm "bpp-32" (set-at two 28 32 0 []))
    print-line-uni (arm "compressed" (set-at two 30 1 0 []))
    print-line-uni (arm "zero-width" (set-at two 18 0 0 []))
    print-line-uni (arm "huge-height" (set-at (set-at (set-at (set-at two 22 255 0 []) 23 255 0 []) 24 255 0 []) 25 127 0 []))
    print-line-uni (arm "offset-past-end" (set-at (set-at two 10 232 0 []) 11 3 0 []))
    print-line-uni (arm "offset-in-header" (set-at two 10 0 0 []))
    print-line-uni (arm "empty" [])
  end
