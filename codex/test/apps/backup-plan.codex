Chapter: BackupPlanTest
  cites Dev chapter BackupRestore
  cites Foreword chapter Console

Section: Lines

  bpt-line : Text, BackupPlan -> Text
  bpt-line (label) (p) =
    if p.bp-refused /= "" then label & " refused: " & p.bp-refused
    else label & " copies " & show (list-length (p.bp-copies)) & ": " & bpt-join (p.bp-copies) 0 ""

  bpt-join : List Text, Integer, Text -> Text
  bpt-join (xs) (i) (acc) =
    if i >= list-length xs then acc
    else bpt-join xs (i + 1) (if i == 0 then list-at xs i else acc & ", " & list-at xs i)

Section: Entry

  opening : [Console] Nothing =
    let stamp = "20261031-215216"
    in let a = bk-plan "D:\\bk" stamp ["D:\\shard\\next\\world.disk", "D:\\shard\\live\\world.disk"] []
    in let b = bk-plan "D:\\bk" stamp ["D:\\x\\live\\world.disk", "D:\\y\\live\\world.disk"] []
    in let c = bk-plan "D:\\bk" stamp ["D:\\shard\\next\\world.disk"] ["d:\\BK\\next-world-20261031-215216.disk"]
    in let h = bk-record-plan backup-new a 1761947536 0
    in act
      print-line-uni (bpt-line "A" a)
      print-line-uni (bpt-line "B" b)
      print-line-uni (bpt-line "C" c)
      print-line-uni ("history " & show (h.bk-history-count) & " last " & h.bk-destination)
    end

