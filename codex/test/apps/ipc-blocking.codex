Chapter: IpcBlockingTest
  cites Foreword chapter Channel
  cites Foreword chapter Maybe

Section: Tests
  opening : [Console] Nothing = act
    let ch0 = chan-create 4 0
    in let s1 = chan-try-send ch0 10
    in let s2 = chan-try-send (s1.chan) 20
    in let s3 = chan-try-send (s2.chan) 30
    in let r1 = chan-try-recv (s3.chan)
    in let r2 = chan-try-recv (r1.chan)
    in let r3 = chan-try-recv (r2.chan)
    in act
      print-line-uni ("v1=" & when r1.value is Just (v) -> show v is None -> "none")
      print-line-uni ("v2=" & when r2.value is Just (v) -> show v is None -> "none")
      print-line-uni ("v3=" & when r3.value is Just (v) -> show v is None -> "none")
    end
  end
