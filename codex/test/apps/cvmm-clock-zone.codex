Chapter: CvmmClockZone
  cites Cvmm chapter Clock
  cites Foreword chapter TzRules
  cites Foreword chapter TzSource
  cites Foreword chapter TzCompile
  cites Foreword chapter TimeZone
  cites Foreword chapter Console

 The clock's time of day in a zone: London one second either side of the
 2026-10-25 fall-back, Kathmandu at +5:45, and a whole-hour offset before
 1970 (which used to give negative fields).

Section: Body

  tod : Zone, Integer -> Text
  tod (z) (t) = format-time (epoch-to-tod-in z t)

  state : Zone, Integer -> Text
  state (z) (t) = let st = __record-set (clk-set-zone clock-new z) "clk-epoch" t in clk-format-current st & " " & clk-zone-label st

  opening : [Console] Nothing =
    let db = tz-parse tz-sources
    in when zone-from-db db "Europe/London"
      is None -> print-line-uni "london missing"
      is Just (london) ->
        (when zone-from-db db "Asia/Kathmandu"
          is None -> print-line-uni "kathmandu missing"
          is Just (ktm) -> print-line-uni ("london " & tod london 1792889999 & " then " & tod london 1792890000
            & "; kathmandu " & tod ktm 1793491200 & "; utc-1h at -1 " & format-time (epoch-to-tod (0 - 1) (0 - 1)) & "; state " & state london 1792889999 & " then " & state london 1792890000 & "; new " & clk-format-current clock-new & " " & clk-zone-label clock-new))