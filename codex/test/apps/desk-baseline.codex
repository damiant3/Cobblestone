Chapter: DeskBaselineTest
  cites Works chapter GopDesk
  cites Works chapter GopComposite
  cites Works chapter GopFont
  cites UI chapter Layout
  cites UI chapter Widget
  cites Foreword chapter Console

 A label and a button in one row share a text baseline on the desk, because
 the desk draws in one face, every edge of its themes is symmetric top to
 bottom, and `comp-text-top` centres the cap band in each content box. This
 pins that, through the function `comp-text` draws with, under the palette
 theme at scales 1 and 2, with a synthetic face (ascent 15, cap 11) and with
 the bitmap font. An asymmetric edge in a theme, or a second face size, is
 what would break it, and that is when baseline alignment is worth building.

 THE CONTROL IS THE START-ALIGNED ROW: a label 16 tall and a button 24 tall
 at the top of a taller line do not share a baseline, so the arm can see a
 difference when one exists.

Section: Body

  db-yn : Boolean -> Text
  db-yn (v) = if v then "PASS" else "FAIL"

  db-face : GopFont
  db-face = GopFont { gf-ok = True, gf-base = 0, gf-gw = 10, gf-gh = 20, gf-asc = 15, gf-cap = 11 }

  db-row : Integer -> WidgetNode
  db-row (a) = widget-stack "row" DirRow 4 [widget-set-align (widget-label "l" "Name") a, widget-set-align (widget-button "b" "OK") a]

  db-top : WidgetNode, Theme, GopFont, Integer, Integer -> Integer
  db-top (laid) (th) (tf) (s) (i) =
    let kid = list-at laid.wn-children i
    in comp-text-top tf (comp-mul-rect (box-content-from-style (kid.wn-bounds) (widget-resolve-style kid th)) s) s

  db-pair : WidgetNode, Theme, GopFont, Integer -> Text
  db-pair (laid) (th) (tf) (s) = integer-to-text (db-top laid th tf s 0) & "/" & integer-to-text (db-top laid th tf s 1)

  db-same : WidgetNode, Theme -> Boolean
  db-same (laid) (th) =
    db-top laid th db-face 1 0 == db-top laid th db-face 1 1
    & db-top laid th db-face 2 0 == db-top laid th db-face 2 1
    & db-top laid th gfont-none 1 0 == db-top laid th gfont-none 1 1
    & db-top laid th gfont-none 2 0 == db-top laid th gfont-none 2 1

Section: Main

  opening : [Console] Nothing =
    let th = dk-theme-palette 0 0
    in let stretch = widget-layout (db-row align-stretch) th (layout-rect 0 0 300 40)
    in let centre = widget-layout (db-row align-center) th (layout-rect 0 0 300 60)
    in let start = widget-layout (db-row align-start) th (layout-rect 0 0 300 60)
    in act
    print-line-uni ("stretch row, face tops " & db-pair stretch th db-face 1 & ": " & db-yn (db-same stretch th))
    print-line-uni ("centred row, face tops " & db-pair centre th db-face 1 & ": " & db-yn (db-same centre th))
    print-line-uni ("CONTROL, start row, face tops " & db-pair start th db-face 1 & " differ: " & db-yn (db-top start th db-face 1 0 /= db-top start th db-face 1 1))
  end
