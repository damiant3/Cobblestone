Chapter: DiamondSquareTest
  cites Codex chapter General
  cites Game chapter DiamondSquare

Section: Tests
  test-clamp : Text =
    "low=" & show (ds-clamp (0 - 10)) & " mid=" & show (ds-clamp 128) & " high=" & show (ds-clamp 300)

  test-heightmap : Text =
    let hm = ds-generate 3 100 100 100 100 50
    in let c = hm-get hm 0 0
    in "size=" & show (hm.size) & " corner=" & show c

  test-deterministic : Text =
    let a = ds-generate 3 100 100 100 100 50
    in let b = ds-generate 3 100 100 100 100 50
    in "same=" & if hm-get a 2 2 == hm-get b 2 2 then "True" else "False"

  opening : [Console] Nothing = act
    print-line-uni test-clamp
    print-line-uni test-heightmap
    print-line-uni test-deterministic
  end
