Chapter: SparkLightColorTest
  cites Spark chapter SceneLight
  cites Spark chapter Pipeline3D
  cites Math chapter Quaternion
  cites Foreword chapter Console

 A lit face takes the light's colour. A white face under a warm directional
 light at full incidence reads the light's own colour; under a blue ambient
 the same; under two lights the channels add and clamp at 255 apiece. The
 white light is the control: the colour road and the scalar road agree on
 it exactly, which is what says the change is the colour and not the level.
 The face colour is asked of `pipe-face-color`, the function the mesh loop
 calls, so a renderer that went back to the scalar road turns the first
 three rows grey.

Section: Body

  lc-hex : Integer -> Text
  lc-hex (c) = show (c / 65536) & "," & show (c / 256 - c / 65536 * 256) & "," & show (c - c / 256 * 256)

  lc-up : Vec3 = vec3-new 0.0 0.0 1.0
  lc-origin : Vec3 = vec3-new 0.0 0.0 0.0

  lc-white : Integer = 16777215
  lc-warm : Integer = 16767392
  lc-blue : Integer = 5798088

  opening : [Console] Nothing =
    let warm = light-directional lc-up lc-warm 1.0
    in let blue = light-ambient lc-blue 1.0
    in let white = light-directional lc-up lc-white 1.0
    in let half = light-directional lc-up lc-white 0.5
    in let c1 = pipe-face-color [warm] lc-origin lc-up lc-white
    in let c2 = pipe-face-color [blue] lc-origin lc-up lc-white
    in let c3 = pipe-face-color [warm, blue] lc-origin lc-up lc-white
    in let c4 = pipe-face-color [half] lc-origin lc-up lc-white
    in let grey = light-apply-color lc-white 0.5
    in act
      print-line-uni ("warm directional " & lc-hex c1 & "  blue ambient " & lc-hex c2 & "  both " & lc-hex c3)
      print-line-uni ("white at half " & lc-hex c4 & "  scalar road " & lc-hex grey & "  agree " & (if c4 == grey then "yes" else "no"))
    end
