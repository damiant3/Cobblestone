Chapter: GpuVecaddE2E
  cites AI chapter GpuProxy
  cites Gpu chapter DeviceBuffer
  cites Gpu chapter LaunchConfig
  cites Gpu chapter DeviceEffect
  cites Gpu chapter Thread

Section: Helpers
  test-vecadd-cmd : Text
  test-vecadd-cmd =
    let cmd = gpu-cmd-launch-ptx "kernel_vecadd" 1024 256 89
    in cmd.ptx-kernel-name & " grid=" & show (cmd.ptx-grid-x) & " block=" & show (cmd.ptx-block-x)

  test-thread-index : Text
  test-thread-index =
    let idx = make-thread-index 511
    in "tid=" & show (thread-index-get idx)

  test-launch-config : Text
  test-launch-config =
    let cfg = launch-config-for-num-elems 4096
    in "grid=" & show (cfg.lc-grid-x) & " block=" & show (cfg.lc-block-x)

Section: Entry
  opening : [Console] Nothing = act
    print-line-uni test-vecadd-cmd
    print-line-uni test-thread-index
    print-line-uni test-launch-config
  end
