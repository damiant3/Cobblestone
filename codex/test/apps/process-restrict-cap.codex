Chapter: ProcessRestrictCap
  cites Codex chapter General

Section: Body
  opening : Integer =
    let child-pid = process-spawn (\x ->
      let r = process-spawn (\y -> 0)
      in poke-byte 28000 0 r)
    in let rc = process-restrict-cap child-pid 12
    in let w = process-wait child-pid
    in peek-byte 28000 0
