Chapter: ProcessRestrictCap

Section: Body
  child-work : Integer -> [Concurrent] Integer
  child-work (x) = act
    r <- process-spawn (\y -> 0)
    let p = poke-byte 28000 0 r
    in p
  end

  opening : [Concurrent, Capability] Integer = act
    child-pid <- process-spawn (\x -> child-work x)
    rc <- process-restrict-cap child-pid 12
    let w = process-wait child-pid
    in peek-byte 28000 0
  end
