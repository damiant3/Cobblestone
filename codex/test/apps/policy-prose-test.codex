Chapter: PolicyProseTest
  cites Trust chapter PolicyProse
  cites Trust chapter PolicyEngine

Section: The Policy

  jake-policy-text : Text
  jake-policy-text = "Jake may use the flight simulator on weekends between 10:00 and 17:00, for no more than 2 hours per session\nJake may use the chat app on weekdays between 15:00 and 17:30, for no more than 30 minutes per day\nJake may never use real flight controls under any circumstances.\nWe love you, buddy."

Section: Test

  jake-pp : ProsePolicy
  jake-pp = compile-policy jake-policy-text

  jake-lowered : Policy
  jake-lowered = lower-policy jake-pp "jake-effective"

  opening : [Console] Nothing = act
    print-line-uni (clarifier-reflect jake-pp)
    print-line-uni (simulate-ask jake-lowered "jake" "flight simulator" 5 840)
    print-line-uni (simulate-ask jake-lowered "jake" "flight simulator" 0 840)
    print-line-uni (simulate-ask jake-lowered "jake" "flight simulator" 5 1080)
    print-line-uni (simulate-ask jake-lowered "jake" "chat app" 2 960)
    print-line-uni (simulate-ask jake-lowered "jake" "real flight controls" 5 840)
  end
