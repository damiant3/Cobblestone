  ca-parsed : Maybe X509Cert = x509-parse ca-cert

  anchors : List X509Anchor =
    when ca-parsed is None -> [] is Just (c) -> [X509Anchor { xa-subject = c.xc-subject, xa-key = c.xc-key }]

  peer-name : List Integer =
    [100, 101, 118, 105, 99, 101, 46, 99, 111, 100, 101, 120, 46, 116, 101, 115, 116]

  s0 : DtlsEp = dtls-ep-with-cert (dtls-ep-new True s-priv s-random cookie-secret client-addr) [leaf-cert] leaf-priv leaf-pub
  c0 : DtlsEp = dtls-ep-with-anchors (dtls-ep-new False c-priv c-random [] []) anchors cal-now peer-name

  body : List Integer = [50, 51]

Section: Helpers

  copy-bytes : List Integer -> List Integer
  copy-bytes (bs) = cb-loop bs 0 (list-length bs) []
  cb-loop : List Integer, Integer, Integer, List Integer -> List Integer
  cb-loop (bs) (i) (n) (acc) =
    if i >= n then acc else cb-loop bs (i + 1) n (list-push acc (list-at bs i))

  take-from : List Integer, Integer, Integer -> List Integer
  take-from (bs) (i) (n) = tf-loop bs i n []
  tf-loop : List Integer, Integer, Integer, List Integer -> List Integer
  tf-loop (bs) (i) (n) (acc) =
    if i >= n then acc else tf-loop bs (i + 1) n (list-push acc (list-at bs i))

  bytes-eq : List Integer, List Integer -> Boolean
  bytes-eq (a) (b) =
    if list-length a /= list-length b then False else be-loop a b 0 (list-length a)
  be-loop : List Integer, List Integer, Integer, Integer -> Boolean
  be-loop (a) (b) (i) (n) =
    if i >= n then True
    else if list-at a i /= list-at b i then False
    else be-loop a b (i + 1) n

  msg-id : List Integer -> Integer
  msg-id (d) = when coap-parse d is None -> (-1) is Just (m) -> m.cm-msg-id

  msg-token : List Integer -> List Integer
  msg-token (d) = when coap-parse d is None -> [] is Just (m) -> m.cm-token

Section: Entry

  opening : [Console] Nothing =
    let st1 = dtls-ep-client c0 0
    in let d1 = list-at (st1.es-out) 0
    in let st2 = dtls-ep-recv s0 d1 10
    in let d2 = list-at (st2.es-out) 0
    in let st3 = dtls-ep-recv (st1.es-ep) d2 20
    in let d3 = list-at (st3.es-out) 0
    in let st4 = dtls-ep-recv (st2.es-ep) d3 30
    in let d-sh = list-at (st4.es-out) 0
    in let d-cert = list-at (st4.es-out) 1
    in let d-cv = list-at (st4.es-out) 2
    in let d-fin = list-at (st4.es-out) 3
    in let st5 = dtls-ep-recv (st3.es-ep) d-sh 40
    in let st6 = dtls-ep-recv (st5.es-ep) d-cert 41
    in let st7 = dtls-ep-recv (st6.es-ep) d-cv 42
    in let st8 = dtls-ep-recv (st7.es-ep) d-fin 43
    in let d-cfin = list-at (st8.es-out) 0
    in let st9 = dtls-ep-recv (st4.es-ep) d-cfin 50

    in let cl0 = coaps-ep-new coap-ep-new (st8.es-ep)
    in let g1 = coaps-ep-get cl0 "temp" 0
    in let rec1 = list-at (g1.xs-out) 0

    in let sv1 = dtls-ep-recv-app (st9.es-ep) rec1
    in let sbuf1 = dtls-ep-app-in (sv1.es-ep)
    in let n1 = list-length sbuf1
    in let req1 = take-from sbuf1 0 n1
    in let req-mid = msg-id req1
    in let req-tok = msg-token req1
    in let wire-is-record = dtls-is-record (list-at rec1 0)
    in let wire-not-plain = bytes-eq rec1 req1 == False

    in let resp = coap-build-response CoapAcknowledgement coap-205-content req-mid req-tok [] body
    in let ss = dtls-ep-send-app (sv1.es-ep) resp
    in let rrec = list-at (ss.es-out) 0

    in let rbad = list-set-at (copy-bytes rrec) 6 (bit-xor (list-at rrec 6) 1)
    in let cbad = coaps-ep-recv (g1.xs-ep) rbad 10
    in let tamper-open = coaps-ep-done (cbad.xs-ep) == False
    in let tamper-out = list-length (cbad.xs-out)

    in let t1 = coaps-ep-tick (cbad.xs-ep) 2000
    in let retx-out = list-length (t1.xs-out)
    in let rec2 = list-at (t1.xs-out) 0
    in let retx-differs = bytes-eq rec1 rec2 == False
    in let sv2 = dtls-ep-recv-app (ss.es-ep) rec2
    in let sbuf2 = dtls-ep-app-in (sv2.es-ep)
    in let req2 = take-from sbuf2 n1 (list-length sbuf2)
    in let retx-same-mid = msg-id req2 == req-mid

    in let c1 = coaps-ep-recv (t1.xs-ep) rrec 10
    in let one-done = coaps-ep-done (c1.xs-ep)
    in let one-code = coaps-ep-response-code (c1.xs-ep)
    in let one-plen = list-length (coaps-ep-response-payload (c1.xs-ep))
    in let one-auth = coaps-ep-authenticated (c1.xs-ep)

    in act
      print-line-uni ("coaps roundtrip done=" & show one-done & " code=" & show one-code & " plen=" & show one-plen)
      print-line-uni ("coaps wire record=" & show wire-is-record & " not-plain=" & show wire-not-plain)
      print-line-uni ("coaps retransmit out=" & show retx-out & " fresh-record=" & show retx-differs & " same-mid=" & show retx-same-mid)
      print-line-uni ("coaps tamper open=" & show tamper-open & " out=" & show tamper-out)
      print-line-uni ("coaps authenticated=" & show one-auth)
    end
