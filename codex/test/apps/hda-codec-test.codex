Chapter: HdaCodecTest
  cites Codex chapter General
  cites Kernel chapter UsbAudio
  cites Kernel chapter Usb

Section: Tests
  test-not-found : Text = format-usb-audio usb-audio-not-found

  test-cd-format : Text = format-audio-format audio-format-cd

  test-48k-format : Text = format-audio-format audio-format-48k

  test-hires-format : Text = format-audio-format audio-format-hires

  test-bytes-per-sec : Text =
    "cd=" & show (usb-audio-bytes-per-second audio-format-cd) & " 48k=" & show (usb-audio-bytes-per-second audio-format-48k)

  test-latency : Text =
    "cd-10ms=" & show (usb-audio-latency-ms audio-format-cd 441) & " 48k-10ms=" & show (usb-audio-latency-ms audio-format-48k 480)

  test-volume : Text =
    let vol100 = usb-audio-set-volume 100
    in let vol50 = usb-audio-set-volume 50
    in let vol0 = usb-audio-set-volume 0
    in "v100-len=" & show (list-length vol100) & " v50-len=" & show (list-length vol50) & " v0-len=" & show (list-length vol0)

  test-pcm-bytes : Text =
    let b16 = uaf-pcm-bytes 1000 16
    in "16bit-len=" & show (list-length b16) & " lo=" & show (list-at b16 0) & " hi=" & show (list-at b16 1)

  opening : [Console] Nothing = act
    print-line-uni test-not-found
    print-line-uni test-cd-format
    print-line-uni test-48k-format
    print-line-uni test-hires-format
    print-line-uni test-bytes-per-sec
    print-line-uni test-latency
    print-line-uni test-volume
    print-line-uni test-pcm-bytes
  end
