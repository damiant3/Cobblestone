Chapter: InstallToDriveTest
  cites Kernel chapter DriveManager
  cites Foreword chapter Gpt
  cites Foreword chapter Fat32
  cites Foreword chapter Sha256

 We say:

Section: Body

  digest-of : List Integer -> Text
  digest-of (bs) = sha256-to-hex (sha256 bs)

  report-file : Text, Maybe (List Integer) -> [Console] Nothing
  report-file (tag) (got) =
    when got
      is None -> print-line-uni (tag & ": MISSING")
      is Just (data) ->
        print-line-uni (tag & ": " & show (list-length data) & " " & digest-of data)

  report-source : Text -> [Console, Device.Block] Nothing
  report-source (path) = act
    got <- dm-read-source-file 0 path
    report-file ("source " & path) got
  end

  report-target : Text -> [Console, Device.Block] Nothing
  report-target (path) = act
    w <- block-select 1
    gpt <- gpt-read
    when gpt
      is None -> print-line-uni ("target " & path & ": NO GPT")
      is Just (disk) -> report-target-esp disk path
  end

  report-target-esp : GptDisk, Text -> [Console, Device.Block] Nothing
  report-target-esp (disk) (path) =
    when dm-find-esp disk
      is None -> print-line-uni ("target " & path & ": NO ESP")
      is Just (esp) -> act
        vol <- fat32-init (esp.gp-start-lba)
        got <- fat32-read-bytes vol path
        report-file ("target " & path) got
      end

  opening : [Console, Device.Block] Nothing
  opening = act
    report-source dm-boot-image-path
    report-source dm-seed-path
    report-source dm-source-path
    code <- dm-install-to-drive 1 0
    print-line-uni ("install: " & dm-install-status-text code)
    report-target dm-boot-image-path
    report-target dm-seed-path
    report-target dm-source-path
  end
