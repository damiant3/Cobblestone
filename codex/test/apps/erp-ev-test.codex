Chapter: ErpEvTest
  cites ERP chapter ErpTypes
  cites ERP chapter PsProject

 Known-answer test for earned value analysis. Budget 1000000, planned
 value 500000, earned value 450000, actual cost 500000: schedule and
 cost variance are both -50000, both indices 90, estimate at
 completion 1111111.

Section: Tests

  test-ev : Text =
    let m = calc-earned-value "P1" 1000000 500000 450000 500000
    in let head = "ev: sv=" & show (m.ev-sv) & " cv=" & show (m.ev-cv) & " spi=" & show (m.ev-spi-x100) & " cpi=" & show (m.ev-cpi-x100)
    in head & " eac=" & show (m.ev-eac) & " etc=" & show (m.ev-etc) & " vac=" & show (m.ev-vac)

  test-health : Text =
    let on-plan = calc-earned-value "P2" 1000000 500000 500000 500000
    in let sched = if ev-on-schedule on-plan then "True" else "False"
    in let budget = if ev-on-budget on-plan then "True" else "False"
    in "health: on-schedule=" & sched & " on-budget=" & budget

Section: Body

  opening : [Console] Nothing = act
    print-line-uni test-ev
    print-line-uni test-health
  end
