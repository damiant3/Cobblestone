Chapter: DiffusionSeedSequence
  cites Diffusion chapter SeedSequence
  cites Foreword chapter Console

 The expected lines are build/seedsequence-oracle.py's, numpy's own
 SeedSequence, and then this test's control: without the zero padding a
 spawn key brings (numpy before 1.19), the words differ.

 We say:

Section: Cases

  join : List Integer, Integer, Text, Text -> Text
  join (xs) (i) (sep) (acc) =
    if i >= list-length xs then acc
    else join xs (i + 1) sep (if i == 0 then show (list-at xs i) else acc & sep & show (list-at xs i))

  case : Integer, List Integer, Integer, Integer -> Text
  case (entropy) (key) (pool) (n) =
    let s = seed-sequence-state (seed-sequence entropy key pool) n
    in "entropy " & show entropy & " key [" & join key 0 ", " "" & "] pool " & show pool & ": " & join s 0 " " ""

 The mixed pool from entropy words taken as given, unpadded.

  unpadded : Integer, List Integer, Integer -> List Integer
  unpadded (entropy) (key) (pool) =
    let e = ss-append (ss-int-words entropy) (ss-key-words key 0 []) 0
    in let hc = [#43B0D7E5]
    in let p = ss-fill (ss-zeros pool []) e hc 0
    in ss-rest (ss-cross p hc 0 0) e hc pool 0

  control : Integer -> Text
  control (z) =
    let a = seed-sequence-state (seed-sequence 20260929 [0, 1] 8) 4
    in let b = seed-sequence-state (unpadded 20260929 [0, 1] 8) 4
    in "control, key [0, 1] without the padding: " & (if join a 0 " " "" == join b 0 " " "" then "the same words" else "different words")

  opening : [Console] Integer
  opening = act
    print-line-uni (case 0 [] 4 4)
    print-line-uni (case 1 [] 4 4)
    print-line-uni (case 12345 [] 8 8)
    print-line-uni (case 4294967301 [] 8 4)
    print-line-uni (case 20260929 [0, 1] 8 4)
    print-line-uni (case 20260929 [1, 1] 8 4)
    print-line-uni (case 20260929 [5, 3] 8 4)
    print-line-uni (case 4294967295 [123456, 20] 8 4)
    print-line-uni (case 7 [2, 1, 9] 4 6)
    print-line-uni (case 9223372036854775807 [3, 2] 8 4)
    print-line-uni (control 0)
    let r = 0 in r
  end
