Chapter: BitSetTest
  cites Codex chapter General
  cites Foreword chapter BitSet

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-empty : Text =
    "empty-count=" & show (bitset-count bitset-empty)

  test-set-test : Text =
    let bs = bitset-set bitset-empty 3
    in "has3=" & show-bool (bitset-test bs 3) & " has0=" & show-bool (bitset-test bs 0)

  test-count : Text =
    let bs = bitset-set (bitset-set (bitset-set bitset-empty 0) 5) 10
    in "count=" & show (bitset-count bs)

  test-clear : Text =
    let bs = bitset-set (bitset-set bitset-empty 1) 2
    in let cleared = bitset-clear bs 1
    in "has1=" & show-bool (bitset-test cleared 1) & " has2=" & show-bool (bitset-test cleared 2)

  test-union : Text =
    let a = bitset-set bitset-empty 0
    in let b = bitset-set bitset-empty 1
    in let u = bitset-union a b
    in "u0=" & show-bool (bitset-test u 0) & " u1=" & show-bool (bitset-test u 1)

  test-intersect : Text =
    let a = bitset-set (bitset-set bitset-empty 0) 1
    in let b = bitset-set (bitset-set bitset-empty 1) 2
    in let x = bitset-intersect a b
    in "x0=" & show-bool (bitset-test x 0) & " x1=" & show-bool (bitset-test x 1) & " x2=" & show-bool (bitset-test x 2)

  opening : [Console] Nothing = act
    print-line-uni test-empty
    print-line-uni test-set-test
    print-line-uni test-count
    print-line-uni test-clear
    print-line-uni test-union
    print-line-uni test-intersect
  end
