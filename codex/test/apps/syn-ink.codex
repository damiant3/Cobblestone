Chapter: SynInkTest
  cites Works chapter SyntaxHighlight
  cites UI chapter Theme
  cites Foreword chapter CCE

 Every syntax class must clear the luma floor on the ground it is
 painted on. The minimal and lcars pane grounds are the failing arms: the raw
 hues sit 2 and 23 luma from them. The black ground is the control that pins
 the default desk: every class already clears the floor there, therefore
 every ink must equal its raw hue.

Section: Fixtures

  classes : List SynClass
  classes = [SynPlain, SynProse, SynHeader, SynDirective, SynKeyword, SynType, SynName, SynNumber, SynString, SynOperator]

  gap : Integer, Integer -> Integer
  gap (a) (b) =
    let d = theme-luma a - theme-luma b
    in if d < 0 then 0 - d else d

Section: Reporting

  raw-min : Integer, List SynClass, Integer, Integer -> Integer
  raw-min (ground) (ks) (i) (m) =
    if i >= list-length ks then m
    else let d = gap (syn-colour (list-at ks i)) ground
    in raw-min ground ks (i + 1) (if d < m then d else m)

  ink-min : Integer, List SynClass, Integer, Integer -> Integer
  ink-min (ground) (ks) (i) (m) =
    if i >= list-length ks then m
    else let d = gap (syn-ink ground (list-at ks i)) ground
    in ink-min ground ks (i + 1) (if d < m then d else m)

  moved : Integer, List SynClass, Integer, Integer -> Integer
  moved (ground) (ks) (i) (n) =
    if i >= list-length ks then n
    else let k = list-at ks i
    in moved ground ks (i + 1) (if syn-ink ground k == syn-colour k then n else n + 1)

  report : Text, Integer -> [Console] Nothing
  report (name) (ground) = act
    let ks = classes
    in print-line-uni (name & ": ground luma " & show (theme-luma ground) & ", raw min gap " & show (raw-min ground ks 0 999) & ", ink min gap " & show (ink-min ground ks 0 999) & ", moved " & show (moved ground ks 0 0) & " of " & show (list-length ks))
  end

Section: Entry

  opening : [Console] Nothing
  opening = act
    report "black" 0
    report "white" 16777215
    report "terminal pane" (palette-terminal.pal-muted)
    report "lcars pane" (palette-lcars.pal-muted)
    report "minimal pane" (palette-minimal.pal-muted)
    report "minimal band" (palette-minimal.pal-border)
  end
