Chapter: RepoIndexSnapshot
  cites Works chapter RepoProtocolPersist
  cites Works chapter KeyManager
  cites Foreword chapter FactStore
  cites Foreword chapter Maybe
  cites Foreword chapter Sha256
  cites Kernel chapter DiskFacts
  cites Kernel chapter AppPersist
  cites Foreword chapter Console

 Persisting the index, proven. Three editions go into the store: a.codex
 twice (the second supersedes the first) and b.codex once. The whole
 materialized index is snapshotted as a kind-40 fact, then c.codex is added
 AFTER the snapshot. A fast rebuild -- load the snapshot, replay only the tail
 -- must produce the same checkout as a full replay of the whole log; the
 snapshot on its own must check out the tree as of the moment it was taken
 (a2, b1, no c); and the superseded first edition of a.codex must still be
 addressable by its hash, because a snapshot carries the history, not just the
 tree.

Section: Helpers

  press : Keypair
  press = generate-keypair (sha256 (text-to-bytes "repo-index-snapshot"))

  def-of : Text, Text -> SourceDefinition
  def-of (path) (body) =
    SourceDefinition {
      sd-hash = "", sd-path = path, sd-quire = "Q", sd-chapter = "C",
      sd-signer = "", sd-signature = [], sd-author = "", sd-timestamp = 0,
      sd-content = body
    }

  save : DiskFactStore, Text, Text, Integer -> DiskFactStore
  save (s) (p) (b) (t) = repo-persist-save-definition s (sign-definition press (def-of p b) t) t

Section: Entry

  opening : [Device.Block, Console.Write] Nothing = act
    let s0 = disk-init
    in let s1 = save s0 "a.codex" "A1" 1
    in let s2 = save s1 "a.codex" "A2" 2
    in let s3 = save s2 "b.codex" "B1" 3
    in let full-at-snap = repo-index-from-disk s3
    in let s4 = repo-snapshot-save s3 full-at-snap 4
    in let s5 = save s4 "c.codex" "C1" 5
    in let fast = repo-index-build s5
    in let full = repo-index-from-disk s5
    in let co-fast = repo-checkout fast
    in let co-full = repo-checkout full
    in let snaptext = when app-scan-last s5 persist-kind-index-snapshot is Just (t) -> t is None -> ""
    in let co-snap = repo-checkout ((snap-to-index snaptext).si-index)
    in let hist = when work-by-hash fast (fact-content-hash "A1") is Just (d) -> d.sd-content is None -> "MISS"
    in let cur-a = when work-current fast "a.codex" is Just (d) -> d.sd-content is None -> "?"
    in print-line-uni ("match=" & (if co-fast == co-full then "yes" else "no") & " co=[" & co-fast & "] snap=[" & co-snap & "] hist=" & hist & " cur-a=" & cur-a)
  end

