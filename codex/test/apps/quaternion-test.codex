Chapter: QuaternionTest
  cites Math chapter Quaternion

Section: Tests
  test-identity : Text =
    let q = quat-identity
    in "w=" & show (q.w) & " x=" & show (q.x) & " y=" & show (q.y) & " z=" & show (q.z)

  test-add : Text =
    let a = Quat { w = 1.0, x = 0.1, y = 0.2, z = 0.3 }
    in let b = Quat { w = 0.5, x = 0.05, y = 0.1, z = 0.15 }
    in let r = quat-add a b
    in "w=" & show (r.w) & " x=" & show (r.x)

  test-conjugate : Text =
    let q = Quat { w = 1.0, x = 0.1, y = 0.2, z = 0.3 }
    in let c = quat-conjugate q
    in "w=" & show (c.w) & " x=" & show (c.x) & " y=" & show (c.y) & " z=" & show (c.z)

  test-norm-sq : Text =
    let q = quat-identity
    in "norm-sq=" & show (quat-norm-squared q)

  opening : [Console] Nothing = act
    print-line-uni test-identity
    print-line-uni test-add
    print-line-uni test-conjugate
    print-line-uni test-norm-sq
  end
