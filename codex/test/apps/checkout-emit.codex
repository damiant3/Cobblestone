Chapter: CheckoutEmit
  cites Works chapter RepoProtocolPersist
  cites Works chapter KeyManager
  cites Foreword chapter FactStore
  cites Foreword chapter Hamt
  cites Foreword chapter Maybe
  cites Foreword chapter Sha256
  cites Kernel chapter DiskFacts
  cites Kernel chapter AppPersist
  cites Foreword chapter Console

Section: The Program We Are Going To Store

  program-v1 : Text
  program-v1 =
    "Chapter: Stored\n"
    & "  cites Foreword chapter Console\n"
    & "\n"
    & "Section: Body\n"
    & "\n"
    & "  opening : [Console.Write] Nothing = act\n"
    & "    print-line-uni \"THE SUPERSEDED EDITION -- checkout is broken\"\n"
    & "  end\n"
    & "\n"
    & "Page 1\n"

  program-v2 : Text
  program-v2 =
    "Chapter: Stored\n"
    & "  cites Foreword chapter Console\n"
    & "\n"
    & "Section: Body\n"
    & "\n"
    & "  greeting : Text\n"
    & "  greeting = \"I was compiled out of the fact store.\"\n"
    & "\n"
    & "  opening : [Console.Write] Nothing = act\n"
    & "    print-line-uni greeting\n"
    & "  end\n"
    & "\n"
    & "Page 1\n"

Section: Helpers

  press : Keypair
  press = generate-keypair (sha256 (text-to-bytes "checkout-emit"))

  def-of : Text, Text -> SourceDefinition
  def-of (path) (body) =
    SourceDefinition {
      sd-hash = "", sd-path = path, sd-quire = "Stored", sd-chapter = "Stored",
      sd-signer = "", sd-signature = [], sd-author = "", sd-timestamp = 0,
      sd-content = body
    }

Section: Entry

  opening : [Device.Block, Console.Write] Nothing = act
    let s0 = disk-init
    in let s1 = repo-persist-save-definition s0 (sign-definition press (def-of "stored.codex" program-v1) 1) 1
    in let s2 = repo-persist-save-definition s1 (sign-definition press (def-of "stored.codex" program-v2) 2) 2
    in let ix = repo-index-from-disk disk-load
    in print-uni (repo-checkout ix)
  end

Page 1
