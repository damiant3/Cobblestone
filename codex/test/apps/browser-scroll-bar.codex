Chapter: BrowserScrollBarTest
  cites Browser chapter Browser
  cites Browser chapter Tab
  cites Browser chapter BrowserTheme
  cites Browser chapter Display
  cites UI chapter Widget
  cites UI chapter Layout
  cites UI chapter Scroll
  cites Foreword chapter Maybe
  cites Foreword chapter Console

 BROWSER-8. `browser-scroll-wire` proves the page moves under the clip, and a
 page that moves correctly under a bar that was never built looks exactly the
 same to it. So the arms here are the ones that go red when the indicator is
 absent rather than wrong: the thumb is a node that only `scroll-bar` builds,
 `scroll-bar-or-gap` answering the fits branch has no child by that name, and
 the lead panel above the thumb is what carries the position.

  bsb-w : Integer = 200

  bsb-h : Integer = 300

  bsb-yn : Boolean -> Text
  bsb-yn (v) = if v then "yes" else "no"

  bsb-has : WidgetNode, Text -> Boolean
  bsb-has (laid) (id) =
    when widget-find laid id
      is Just (w) -> True
      is None -> False

  bsb-rect : WidgetNode, Text -> LayoutRect
  bsb-rect (laid) (id) =
    when widget-find laid id
      is Just (w) -> w.wn-bounds
      is None -> layout-rect 0 0 0 0

  bsb-page-w : WidgetNode -> Integer
  bsb-page-w (laid) = browser-viewport-width laid

  opening : [Console] Nothing =
    let st = browser-init bsb-w bsb-h browser-theme-default display-init-text-fallback
    in let fit = browser-scroll-fit st bsb-w bsb-h
    in let th = fit.bs-theme
    in let pane = layout-rect 0 0 bsb-w bsb-h

    in let laid0 = widget-layout (browser-render fit) th pane
    in let bar0 = bsb-rect laid0 "page-scroll"
    in let thumb0 = bsb-rect laid0 "page-scroll-thumb"
    in let lead0 = bsb-rect laid0 "page-scroll-above"
    in let pagew = bsb-page-w laid0

    in let off0 = browser-scroll-offset fit
    in let moved = browser-scroll-page fit 4
    in let off1 = browser-scroll-offset moved
    in let laid1 = widget-layout (browser-render moved) th pane
    in let thumb1 = bsb-rect laid1 "page-scroll-thumb"
    in let lead1 = bsb-rect laid1 "page-scroll-above"

    in act
      print-line-uni ("bar column exists           : " & bsb-yn (bsb-has laid0 "page-scroll"))
      print-line-uni ("thumb exists, so not a gap  : " & bsb-yn (bsb-has laid0 "page-scroll-thumb"))
      print-line-uni ("pane width                  : " & integer-to-text bsb-w)
      print-line-uni ("visible page column width   : " & integer-to-text pagew)
      print-line-uni ("bar column x/w              : " & integer-to-text (bar0.lr-x) & " " & integer-to-text (bar0.lr-w))
      print-line-uni ("page plus bar within pane   : " & bsb-yn (pagew + bar0.lr-w <= bsb-w))
      print-line-uni ("offset before / after       : " & integer-to-text off0 & " / " & integer-to-text off1)
      print-line-uni ("lead h before / after       : " & integer-to-text (lead0.lr-h) & " / " & integer-to-text (lead1.lr-h))
      print-line-uni ("thumb y before / after      : " & integer-to-text (thumb0.lr-y) & " / " & integer-to-text (thumb1.lr-y))
      print-line-uni ("thumb h before / after      : " & integer-to-text (thumb0.lr-h) & " / " & integer-to-text (thumb1.lr-h))
    end
