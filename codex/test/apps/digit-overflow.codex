Chapter: DigitOverflowTest
  cites Data chapter FullText (ft-text-to-int)
  cites Wademo chapter NhgisCodebook (nc-int)
  cites Works chapter VmCompile (vm-parse-int-from-bytes)
  cites Works chapter ShellParser (parse-nat-loop)
  cites Works chapter ShellPersistence (parse-nat-loop-sp)
  cites Foreword chapter Schedule (sched-atoi)
  cites Kernel chapter DiagnosticShell (diag-atoi, diag-parse-hex)
  cites Foreword chapter Console

Section: Entry

  nines : List Integer = [57, 57, 57, 57, 57, 57, 57, 57, 57, 57, 57, 57, 57, 57, 57, 57, 57, 57, 57, 57]

  opening : [Console] Nothing = act
    print-line-uni ("nhgis 42 " & show (nc-int "42") & " 20 digits " & show (nc-int "99999999999999999999"))
    print-line-uni ("vmcompile 42 " & show (vm-parse-int-from-bytes [52, 50] 0 2 0) & " 20 digits " & show (vm-parse-int-from-bytes nines 0 20 0))
    print-line-uni ("shell 42 " & show (parse-nat-loop "42" 0 2 0) & " 20 digits " & show (parse-nat-loop "99999999999999999999" 0 20 0))
    print-line-uni ("shell-persist 42 " & show (parse-nat-loop-sp "42" 0 2 0) & " 20 digits " & show (parse-nat-loop-sp "99999999999999999999" 0 20 0))
    print-line-uni ("schedule 42 " & show (sched-atoi "42" 0 2 0) & " 20 digits " & show (sched-atoi "99999999999999999999" 0 20 0))
    print-line-uni ("diag 42 " & show (diag-atoi "42" 0 2 0) & " 20 digits " & show (diag-atoi "99999999999999999999" 0 20 0))
    print-line-uni ("fulltext 42 " & show (ft-text-to-int "42") & " 20 digits " & show (ft-text-to-int "99999999999999999999"))
    print-line-uni ("diag hex ff " & show (diag-parse-hex "ff" 0 2 0) & " FF " & show (diag-parse-hex "FF" 0 2 0) & " 1a " & show (diag-parse-hex "1a" 0 2 0) & " 17 digits " & show (diag-parse-hex "fffffffffffffffff" 0 17 0))
  end
