Chapter: AccessControlTest
  cites Foreword chapter Console
  cites Trust chapter AccessControl

Section: Entry

  opening : [Console] Nothing =
    let t0 = acl-empty
    in let l1 = "count=" & show (acl-count t0)
    in let t1 = acl-grant t0 "shell" "/disk" PermRead
    in let t2 = acl-grant t1 "shell" "/disk" PermWrite
    in let r = acl-check t2 "shell" "/disk" PermRead
    in let w = acl-check t2 "shell" "/disk" PermWrite
    in let x = acl-check t2 "shell" "/disk" PermExecute
    in let l2 = "read=" & show r & " write=" & show w & " exec=" & show x & " count=" & show (acl-count t2)
    in let t3 = acl-grant t2 "bob" "/disk" PermWrite
    in let aw = acl-check t3 "alice" "/disk" PermWrite
    in let bw = acl-check t3 "bob" "/disk" PermWrite
    in let l3 = "alice-write=" & show aw & " bob-write=" & show bw
    in let t4 = acl-revoke t3 "shell" "/disk" PermRead
    in let r2 = acl-check t4 "shell" "/disk" PermRead
    in let w2 = acl-check t4 "shell" "/disk" PermWrite
    in let l4 = "read=" & show r2 & " write=" & show w2 & " count=" & show (acl-count t4)
    in let t5 = acl-revoke t4 "shell" "/disk" PermWrite
    in let t6 = acl-revoke t5 "bob" "/disk" PermWrite
    in let l5 = "count=" & show (acl-count t6) & " check=" & show (acl-check t6 "shell" "/disk" PermRead)
    in let t7 = acl-grant acl-empty "daemon" "/net" PermAdmin
    in let perms = acl-permissions-for t7 "daemon" "/net"
    in let l6 = "perms=" & show (list-length perms)
    in let t8 = acl-grant (acl-grant acl-empty "shell" "/disk" PermRead) "shell" "/disk" PermWrite
    in let entry = list-at (t8.entries) 0
    in let l7 = format-acl-entry entry
    in act
      print-line-uni l1
      print-line-uni l2
      print-line-uni l3
      print-line-uni l4
      print-line-uni l5
      print-line-uni l6
      print-line-uni l7
    end

