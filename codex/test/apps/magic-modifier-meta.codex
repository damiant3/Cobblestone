 We say:

Section: Decks

  copies : Integer, Integer, List Integer -> List Integer
  copies (id) (k) (acc) = if k <= 0 then acc else copies id (k - 1) (acc & [id])

  four-each : List Integer, Integer, Integer, List Integer -> List Integer
  four-each (ids) (i) (n) (acc) =
    if i >= n | i >= list-length ids then acc
    else four-each ids (i + 1) n (copies (list-at ids i) 4 acc)

  deck-of : List Integer -> Decklist
  deck-of (main) = Decklist { main = main, sideboard = [], main-count = list-length main, sideboard-count = 0 }

  mm-templates : List CardTemplate
  mm-templates = with-basics old-school-cards

  white-deck : Decklist
  white-deck =
    let n = list-length old-school-cards
    in deck-of (copies 128 4 (copies 25 4 (four-each (pick-creatures mm-templates White) 0 8 (copies (basic-land-id n White) 20 []))))

  black-deck : Decklist
  black-deck =
    let n = list-length old-school-cards
    in deck-of (copies 74 4 (four-each (pick-creatures mm-templates Black) 0 8 (copies (basic-land-id n Black) 24 [])))

Section: Games

  game-line : Integer -> Text
  game-line (seed) =
    let pre = run-pre-game white-deck black-deck mm-templates seed ChoosePlay
    in let r = run-sim-game (sim-new (pre.game) (personality-aggro "Crusaders") (personality-midrange "Bad Moon"))
    in "seed " & show seed & ": winner " & show (r.winner) & " turns " & show (r.turns) & " life " & show (r.final-life-a) & "/" & show (r.final-life-b)

  opening : [Console] Nothing = act
    print-line-uni ("white " & show (white-deck.main-count) & " black " & show (black-deck.main-count))
    print-line-uni (game-line 1)
    print-line-uni (game-line 2)
    print-line-uni (game-line 3)
    print-line-uni (game-line 4)
    print-line-uni (game-line 5)
    print-line-uni (game-line 6)
    print-line-uni (game-line 7)
    print-line-uni (game-line 8)
  end
