Chapter: VmxEptTable
  cites Works chapter DevHypervisor

Section: Body

  opening : [Console] Nothing = act
   let base = vmx-alloc-zeroed (3 * vmx-page-size) vmx-page-size
   in let host-base = 1073741824
   in let eptp = vm-build-ept base host-base (64 * vmx-bytes-per-mb)
   in let pd = base + 2 * vmx-page-size
   in let leaf0 = peek-32 pd 0
   in let leaf5 = peek-32 pd 40
   in let pml4e = peek-32 base 0
   in let low = vmx-alloc-raw (2 * guest-low-init-bytes) vmx-page-size
   in let li = vm-init-guest-low low (256 * vmx-bytes-per-mb)
   in act
    print-line-uni ("leaf-bits=" & show (bit-and leaf0 255))
    print-line-uni ("table-bits=" & show (bit-and pml4e 255))
    print-line-uni ("eptp-bits=" & show (bit-and eptp 255))
    print-line-uni ("frame0=" & show (leaf0 - 183))
    print-line-uni ("leaf-stride=" & show (leaf5 - leaf0))
    print-line-uni ("leaves-64mb=" & show (vm-ept-leaf-count (64 * vmx-bytes-per-mb)))
    print-line-uni ("leaves-capped=" & show (vm-ept-leaf-count (4096 * vmx-bytes-per-mb)))
    print-line-uni ("guest-ramsize=" & show (peek-32 low ram-size-addr))
    print-line-uni ("small=" & (vm-guest-sizing 4).vg-reason)
    print-line-uni ("large=" & (vm-guest-sizing 2048).vg-reason)
   end
  end

