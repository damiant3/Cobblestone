    183, 139, 108, 187, 50, 126, 105, 185, 100, 159, 20, 115,
    63, 224, 12, 60, 245, 179, 231, 224, 193, 236, 120, 50,
    212, 162, 138, 196, 180, 119, 197, 125, 75, 16, 85, 249,
    55, 45, 131, 173, 13, 218, 64, 187, 29, 222, 3, 95,
    24
    ]

  rounded : Integer -> Integer
  rounded (raw) =
    let bits = bit-and raw #FFFFFFFF
    in let neg = bit-and bits #80000000 /= 0
    in let e = bit-and (bit-shru bits 23) 255
    in if e == 255 then 0
    else if e >= 128 then (if neg then 0 else 255)
    else let m = bit-or (bit-and bits #7FFFFF) #800000
    in let fx = if e == 0 then 0 else if e >= 126 then bit-shl m (e - 126) else bit-shru m (126 - e)
    in let v = if neg then 0 - fx else fx
    in if v <= 0 - 16777216 then 0
    else if v >= 16777216 then 255
    else ((v + 16777216) * 255 + 16777216) / 33554432

  agree : (Integer -> Integer), Integer, Integer -> Integer
  agree (f) (i) (acc) = if i >= list-length inputs then acc else agree f (i + 1) (acc + (if f (list-at inputs i) == list-at forge i then 1 else 0))

  opening : [Console] Integer
  opening = act
    print-line-uni ("truncated as Forge: " & show (agree io-pixel 0 0) & "/" & show (list-length inputs))
    print-line-uni ("control, rounded: " & show (agree rounded 0 0) & "/" & show (list-length inputs))
    let r = 0 in r
  end