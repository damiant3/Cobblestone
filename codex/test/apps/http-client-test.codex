Chapter: HttpClientTest
  cites Net chapter HttpClient
  cites Foreword chapter CCE

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Test Data
  ok-response : List Integer =
    [72, 84, 84, 80, 47, 49, 46, 48, 32, 50, 48, 48, 32, 79, 75, 13, 10,
     13, 10,
     104, 101, 108, 108, 111]

  not-found-response : List Integer =
    [72, 84, 84, 80, 47, 49, 46, 48, 32, 52, 48, 52, 32, 78, 111, 116, 32, 70, 111, 117, 110, 100, 13, 10,
     13, 10]

Section: Tests
  test-serialize-get : Text =
    let bs = http-serialize-request (http-get-request "example.com" "/index")
    in "len=" & show (list-length bs) & " b0=" & show (list-at bs 0) & " b1=" & show (list-at bs 1) & " b2=" & show (list-at bs 2)

  test-serialize-post : Text =
    let req = http-post-request "example.com" "/api" "data"
    in let bs = http-serialize-request req
    in "len=" & show (list-length bs) & " has-body=" & show-bool (text-length ((req).body) > 0)

  test-add-header : Text =
    let req = http-add-header (http-get-request "example.com" "/") "Accept: text/html"
    in let bs = http-serialize-request req
    in "len=" & show (list-length bs)

  test-parse-ok : Text =
    let r = http-parse-response ok-response
    in "code=" & show (r.status-code) & " body=" & r.body & " ok=" & show-bool (response-ok r)

  test-parse-404 : Text =
    let r = http-parse-response not-found-response
    in "code=" & show (r.status-code) & " ok=" & show-bool (response-ok r)

  test-format : Text =
    let r = http-parse-response ok-response
    in format-response r

  opening : [Console] Nothing = act
    print-line-uni test-serialize-get
    print-line-uni test-serialize-post
    print-line-uni test-add-header
    print-line-uni test-parse-ok
    print-line-uni test-parse-404
    print-line-uni test-format
  end
