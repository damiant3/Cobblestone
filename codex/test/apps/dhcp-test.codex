Chapter: DhcpTest
  cites Foreword chapter Console
  cites Net chapter Dhcp
  cites Net chapter Ethernet
  cites Net chapter Udp

Section: Build Offer

  build-fake-offer : Integer, List Integer -> List Integer
  build-fake-offer (xid) (client-mac) =
    let header = [2, 1, 6, 0]
    in let xid-bytes = dhcp-write-be32 xid
    in let secs-flags = [0, 0, 0, 0]
    in let ci = [0, 0, 0, 0]
    in let yi = [192, 168, 1, 100]
    in let si = [0, 0, 0, 0]
    in let gi = [0, 0, 0, 0]
    in let chaddr = dhcp-pad-mac client-mac
    in let sname = dhcp-zeros 64
    in let file = dhcp-zeros 128
    in let opts = [99, 130, 83, 99, 53, 1, 2, 1, 4, 255, 255, 255, 0, 3, 4, 192, 168, 1, 1, 6, 4, 8, 8, 8, 8, 51, 4, 0, 0, 14, 16, 255]
    in header & xid-bytes & secs-flags & ci & yi & si & gi & chaddr & sname & file & opts

Section: Entry

  opening : [Console] Nothing =
    let mac = [0, 17, 34, 51, 68, 85]
    in let disc = dhcp-build-discover 42 mac
    in let l1 = "op=" & show (list-at disc 0) & " htype=" & show (list-at disc 1) & " len=" & show (list-length disc)
    in let req = dhcp-build-request 42 mac [192, 168, 1, 100] [192, 168, 1, 1]
    in let l2 = "op=" & show (list-at req 0) & " len=" & show (list-length req)
    in let offer-data = build-fake-offer 42 mac
    in let lease = dhcp-parse-response offer-data
    in let l3 = "offer=" & show (dhcp-is-offer lease) & " " & format-dhcp-lease lease
    in let bad-data = [1, 2, 3, 4]
    in let bad-lease = dhcp-parse-response bad-data
    in let l4 = "valid=" & show (bad-lease.valid)
    in let udp-disc = dhcp-discover-udp mac 42
    in let l5 = "udplen=" & show (list-length udp-disc)
    in let frame = dhcp-discover-frame mac 42
    in let l6 = "framelen=" & show (list-length frame)
    in act
      print-line-uni l1
      print-line-uni l2
      print-line-uni l3
      print-line-uni l4
      print-line-uni l5
      print-line-uni l6
    end

