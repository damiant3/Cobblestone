Chapter: NetSendRecvTest
  cites Net chapter Tcp
  cites Net chapter Ethernet

Section: Helpers
  make-payload : Integer, Integer, List Integer -> List Integer
  make-payload (n) (i) (acc) =
    if i >= n then acc
    else make-payload n (i + 1) (list-push acc 0)

Section: Tests
  test-send-recv : Text =
    let conn = tcp-new-connection 5000 [10, 0, 0, 1] 80 [10, 0, 0, 2] 1000
    in let recv-before = conn.recv-next
    in let conn1 = set-state conn TcpEstablished
    in let payload = make-payload 40 0 []
    in let step = tcp-step conn1 (EvSend payload)
    in let sent-len = when (step.action)
      is ActSend (seg) -> list-length seg
      is ActDataAck (d) (ack) -> 0
      is ActNone -> 0
      is ActEstablished -> 0
      is ActData (d) -> 0
      is ActClosed -> 0
      is ActError (m) -> 0
    in "PASS: sent=" & show sent-len & " recv-before=" & show recv-before

  opening : [Console] Nothing = act
    print-line-uni test-send-recv
  end
