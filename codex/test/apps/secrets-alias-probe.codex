Chapter: SecretsAliasProbe
  cites Foreword chapter Maybe
  cites Foreword chapter ListUtils
  cites Secrets chapter SecretEntry
  cites Secrets chapter AuditLog

Section: Probe

  check : Boolean, Integer -> Integer
  check (ok) (bit) = if ok then bit else 0

  opening : [Console] Nothing = act
    let se = secret-new 1 SecretPassword "n" "u" "url" 100
    in let t = secret-touch se 999
    in let a1 = check (t.se-accessed == 999) 1
    in let a2 = check (t.se-access-count == 1) 2
    in let log0 = audit-log-new
    in let genesis-w0 = list-at log0.al-last-hash 0
    in let r = audit-record log0 AuditLogin 5 "name" "vid" "user" "detail" 100
    in let a3 = check (list-length r.al-entries == 1) 4
    in let a4 = check ((list-at r.al-last-hash 0) /= genesis-w0) 8
    in let a5 = check (r.al-count == 1) 16
    in print-line-uni ("alias-probe: " & show (a1 + a2 + a3 + a4 + a5))
  end
