simple ok [a/b ; c/d] raw=[a/b ; c/d]
quoted-comma ok [c,d/e] raw=[c,d/e]
doubled ok [x"y] raw=[x"y]
trailing-comma ok [a/] raw=[a/]
empty ok [] raw=[]
quote-then-comma ok [ab/cd] raw=[ab/cd]
unterminated refused raw=[abc]
after-quote refused raw=[ab/cd]
quote-in-field refused raw=[a"b]
multibyte ok [é,ü/ñ] raw=[é,ü/ñ]
two-byte same
emit-row a,"b,c","d""e",,é
emit-table a,b
c
|
parse-field linear
parse-quoted linear
escape linear
emit-fields linear
emit-table linear
