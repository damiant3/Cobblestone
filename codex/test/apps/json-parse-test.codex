Chapter: JsonParseTest

  cites Foreword chapter Console
  cites Encode chapter Json

Section: Body

  opening : [Console] Nothing = act
    print-line-uni (json-emit json-null)
    print-line-uni (json-emit (json-bool True))
    print-line-uni (json-emit (json-int 42))
    print-line-uni (json-emit (json-array [json-int 1, json-int 2, json-int 3]))
    print-line-uni (json-emit (json-object [json-pair "x" (json-int 10), json-pair "name" (json-str "test")]))
  end
