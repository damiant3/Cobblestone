Chapter: KeyManagerTest

  cites Foreword chapter Console
  cites Works chapter KeyManager

Section: Body

  opening : [Console] Nothing =
    let kp = generate-keypair [10, 20, 30, 40, 50, 60, 70, 80]
    in let kr = keyring-empty
    in let kr2 = keyring-add kr "alice" (kp.public-key) 9000
    in let count = integer-to-text (kr2.count)
    in let fp = kp.fingerprint
    in let sig = sign-content kp "hello world"
    in let valid = if verify-signature (kp.public-key) "hello world" sig then "yes" else "no"
    in let bad = if verify-signature (kp.public-key) "wrong content" sig then "yes" else "no"
    in let kr3 = keyring-revoke kr2 fp
    in let after-revoke = integer-to-text (kr3.count)
    in let fmt = format-keypair kp
    in let has-fmt = if text-length fmt > 0 then "yes" else "no"
    in act
      print-line-uni ("count=" & count)
      print-line-uni ("valid=" & valid)
      print-line-uni ("bad=" & bad)
      print-line-uni ("after-revoke=" & after-revoke)
      print-line-uni ("has-fmt=" & has-fmt)
    end
