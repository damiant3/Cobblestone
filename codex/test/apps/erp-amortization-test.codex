Chapter: ErpAmortizationTest
  cites Codex chapter General
  cites Foreword chapter Tuple
  cites ERP chapter ErpTypes
  cites ERP chapter IsBanking

 Known-answer test for the loan engine. A 12 percent loan accrues
 one percent monthly: interest on 100000 outstanding is exactly 1000.
 The annuity payment is pinned to the x10000 fixed-point arithmetic,
 which understates the exact value (106618 for this loan) by the
 documented truncation in power-inv.

Section: Tests

  test-amortize : Text =
    when amortize 100000 1200 8885
      is (principal, interest) -> "amortize: principal=" & show principal & " interest=" & show interest

  test-payment : Text =
    let p0 = monthly-payment 1200000 0 12
    in let p1 = monthly-payment 1200000 1200 12
    in "payment: zero-rate=" & show p0 & " twelve-pct=" & show p1

  test-deposit : Text =
    "deposit: daily=" & show (daily-interest (DepositAccount { da-id = "D1", da-customer-id = "C1", da-type = SavingsDeposit, da-balance = 3650000, da-currency = "USD", da-rate-bps = 100, da-opened = 0, da-maturity = 0, da-status = "open", da-branch = "", da-tier = "" }))

Section: Body

  opening : [Console] Nothing = act
    print-line-uni test-amortize
    print-line-uni test-payment
    print-line-uni test-deposit
  end
