Chapter: DataFrameZeroLen
  cites Data chapter Protocol
  cites Foreword chapter MathLib (int-widen)
  cites Foreword chapter Console

 We say:

Section: Fixtures

 good is the positive control: total-len 3, the type byte and two payload
 bytes, seven bytes consumed. zero-then-good is a zero-length header followed
 by good; the decoder must skip exactly the five header bytes so good decodes
 whole from offset 5. partial is good cut short and must read as incomplete,
 consumed 0, so it stays distinct from the zero-length refusal.

  good : List Integer = [0, 0, 0, 3, 16, 65, 66]
  zero-then-good : List Integer = [0, 0, 0, 0, 9, 0, 0, 0, 3, 16, 65, 66]
  partial : List Integer = [0, 0, 0, 3, 16, 65]

Section: Report

  describe : Text, FrameDecodeResult -> Text
  describe (name) (d) =
    let f = when (d.fdr-frame)
      is Just (fr) -> "frame type=" & show (int-widen (fr.frame-type)) & " payload=" & show (list-length (fr.frame-payload))
      is None -> "none"
    in name & ": " & f & " consumed=" & show (d.fdr-consumed)

Section: Entry
  opening : [Console] Nothing = act
    let z = frame-decode zero-then-good
    in let rest = proto-take-bytes zero-then-good (z.fdr-consumed) (list-length zero-then-good - z.fdr-consumed) []
    in act
      print-line-uni (describe "good" (frame-decode good))
      print-line-uni (describe "zero" z)
      print-line-uni (describe "after-zero" (frame-decode rest))
      print-line-uni (describe "partial" (frame-decode partial))
    end
  end
