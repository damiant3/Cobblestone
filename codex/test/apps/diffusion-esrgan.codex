 The fixture is build/esrgan-oracle.py's: spandrel's RealESRGAN x4plus on
 the CUDA device over a 3 x 32 x 32 tile, in f32 and in f16 as Forge runs
 it. A value agrees within 2^-8, under one step of an 8-bit picture.

 We say:

Section: Arms

  n-in : Integer = 3072

  n-out : Integer = 49152

  ours : Integer = #BD700000

  theirs : Integer = #BD800000

  f32-real : Integer -> Real
  f32-real (raw) =
    let b = bit-and raw #FFFFFFFF
    in let e = bit-and (bit-shru b 23) 255
    in if e == 0 then 0.0
    else bits-to-real (bit-or (bit-shl (bit-shru b 31) 63) (bit-or (bit-shl (e + 896) 52) (bit-shl (bit-and b #7FFFFF) 29)))

  tile-fill : Integer, Integer -> Integer
  tile-fill (a) (i) =
    if i >= n-in then a
    else let c = i / 1024
    in let y = (i - c * 1024) / 32
    in let x = i - c * 1024 - y * 32
    in let v = real-from-int ((97 * c + 31 * y + 17 * x) - (97 * c + 31 * y + 17 * x) / 256 * 256) / 255.0
    in let p = poke-32 a (i * 4) (nz-f32-bits v)
    in tile-fill a (i + 1)

  near : Integer, Integer -> Integer
  near (i) (acc) =
    if i >= n-out then acc
    else let d = f32-real (peek-32 ours (i * 4)) - f32-real (peek-32 theirs (i * 4))
    in near (i + 1) (acc + (if d <= 0.00390625 & d >= 0.0 - 0.00390625 then 1 else 0))

  against : Integer, Integer -> Integer
  against (h) (which) =
    let u = gpu-buf-upload h 0 "esrgan-tile.bin" (which * n-out * 4) n-out gpu-dt-f32 gpu-dt-f32
    in if gpu-buf-read h 0 (n-out * 4) theirs then near 0 0 else 0 - 1

  run : Text, Integer -> Integer
  run (path) (h) =
    let f = pth-open path
    in let w = esr-load f
    in let img = gpu-buf-alloc (n-in * 4)
    in let staged = gpu-buf-write img 0 (n-in * 4) (tile-fill (alloc-bytes (n-in * 4)) 0)
    in let out = esr-forward w (vd-act img 3 32 32 staged) (esr-blocks f 0)
    in let ok = out.ah /= 0 & out.ac == 3 & out.ahh == 128 & out.aww == 128 & gpu-buf-read (out.ah) 0 (n-out * 4) ours
    in let fr = vd-free out & gpu-buf-free img
    in if ok then esr-blocks f 0 else 0 - 1

  line : Text, Integer, Integer -> Text
  line (what) (blocks) (h) =
    if blocks < 0 then what & ": the network did not run"
    else what & " (" & show blocks & " RRDBs): " & show (against h 0) & " of 49152 within 2^-8 of Forge's f32, " & show (against h 1) & " of its f16"

 The whole picture: 256 x 192 through Forge's tiling, against Forge's own
 Extras upscale of it (build/esrgan-picture-oracle.py).

  pic-bytes : Integer = 2359296

  PicTally = record {
    pt-equal : Integer,
    pt-one : Integer,
    pt-max : Integer
  }

  pic-cmp : Integer, Integer, Integer, PicTally -> PicTally
  pic-cmp (a) (b) (i) (t) =
    if i >= pic-bytes then t
    else let d0 = peek-byte a i - peek-byte b i
    in let d = if d0 < 0 then 0 - d0 else d0
    in pic-cmp a b (i + 1) (PicTally { pt-equal = t.pt-equal + (if d == 0 then 1 else 0), pt-one = t.pt-one + (if d <= 1 then 1 else 0), pt-max = if d > t.pt-max then d else t.pt-max })

  pic-line : Text, Integer, Integer -> Text
  pic-line (what) (ours-rgb) (fx) =
    if ours-rgb == 0 then what & ": the upscale did not run"
    else let t = pic-cmp ours-rgb (fx + 147456) 0 (PicTally { pt-equal = 0, pt-one = 0, pt-max = 0 })
    in what & ": " & show (t.pt-equal) & " of 2359296 bytes equal to Forge's, " & show (t.pt-one) & " within 1, the largest difference " & show (t.pt-max)

  picture : Integer -> [Console] Nothing
  picture (fx) = act
    print-line-uni (pic-line "picture 256 x 192 by 4, tile 192 overlap 8" (esr-upscale (esr-load (pth-open "RealESRGAN_x4plus.pth")) 23 fx 256 192 192 8) fx)
    print-line-uni (pic-line "control, the same without the overlap's blend" (esr-upscale (esr-load (pth-open "RealESRGAN_x4plus.pth")) 23 fx 256 192 192 0) fx)
  end
  report : Integer -> [Console] Nothing
  report (h) = act
    print-line-uni (line "RealESRGAN x4plus" (run "RealESRGAN_x4plus.pth" h) h)
    print-line-uni (line "sabotage, the anime 6B's weights" (run "RealESRGAN_x4plus_anime_6B.pth" h) h)
    picture (pth-read "esrgan-picture.bin" 0 2506752)
  end

  start : Integer -> [Console] Nothing
  start (h) = if pth-has "RealESRGAN_x4plus.pth" 0 == False then act print-line-uni "SKIP: no RealESRGAN_x4plus.pth under the upscaler root build-output/diffusion-upscalers" end
    else report h

  opening : [Console] Integer
  opening = act
    start (gpu-buf-alloc (n-out * 4))
    let r = 0 in r
  end
