Chapter: CardDeckTest
  cites Game chapter CardDeck

Section: Helpers

  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

  top3-str : List Integer -> Text
  top3-str (cards) =
    format-card (list-at cards 0) & " " & format-card (list-at cards 1) & " " & format-card (list-at cards 2)

Section: Tests

  test-new-deck : Text =
    let d = deck-new
    in "size=" & show (list-length d) & " first=" & format-card (list-at d 0) & " last=" & format-card (list-at d 51)

  test-format-long : Text =
    format-card-long (list-at deck-new 0) & " | " & format-card-long (list-at deck-new 51)

  test-shuffle : Text =
    let d = deck-shuffle deck-new 42
    in "size=" & show (list-length d) & " top3=" & top3-str d

  test-same-seed : Text =
    let d1 = deck-shuffle deck-new 42
    in let d2 = deck-shuffle deck-new 42
    in "same=" & show-bool (list-at d1 0 == list-at d2 0)

  test-diff-seed : Text =
    let d1 = deck-shuffle deck-new 42
    in let d3 = deck-shuffle deck-new 99
    in "different=" & show-bool (list-at d1 0 /= list-at d3 0)

  test-deal : Text =
    let d = deck-new
    in let r = deck-deal d 5
    in "hand=" & show (list-length (r.hand)) & " remaining=" & show (list-length (r.remaining))

  test-blackjack : Text =
    let ace = card-make 0 0
    in let king = card-make 3 12
    in let five = card-make 1 4
    in let hand = [ace, king, five]
    in "ace=" & show (blackjack-value ace) & " king=" & show (blackjack-value king) & " five=" & show (blackjack-value five) & " hand=" & show (hand-total hand)

  test-contains : Text =
    let d = deck-new
    in "has-0=" & show-bool (deck-contains d 0) & " has-51=" & show-bool (deck-contains d 51) & " has-52=" & show-bool (deck-contains d 52)

  opening : [Console] Nothing = act
    print-line-uni test-new-deck
    print-line-uni test-format-long
    print-line-uni test-shuffle
    print-line-uni test-same-seed
    print-line-uni test-diff-seed
    print-line-uni test-deal
    print-line-uni test-blackjack
    print-line-uni test-contains
  end
