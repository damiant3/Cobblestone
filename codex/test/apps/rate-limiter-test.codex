Chapter: RateLimiterTest
  cites Foreword chapter RateLimiter

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-new : Text =
    let tb = tb-new 10 1
    in "tokens=" & show (tb.tb-tokens) & " cap=" & show (tb.tb-capacity)

  test-consume : Text =
    let tb = tb-new 10 1
    in let tb2 = tb-try-consume tb 3 0
    in "after=" & show (tb2.tb-tokens)

  test-can-consume : Text =
    let tb = tb-new 5 1
    in "can5=" & show-bool (tb-can-consume tb 5 0) & " can6=" & show-bool (tb-can-consume tb 6 0)

  test-sliding-window : Text =
    let sw = sw-new 5 1000 0
    in "limited=" & show-bool (sw-is-limited sw)

  opening : [Console] Nothing = act
    print-line-uni test-new
    print-line-uni test-consume
    print-line-uni test-can-consume
    print-line-uni test-sliding-window
  end
