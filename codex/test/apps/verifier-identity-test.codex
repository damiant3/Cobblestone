Chapter: VerifierIdentityTest
  cites Verify chapter CdxVerifier
  cites Verify chapter CdxBinary
  cites Trust chapter TrustLattice
  cites Trust chapter PolicyEngine
  cites Foreword chapter Ed25519
  cites Foreword chapter Sha256
  cites Foreword chapter Sha512
  cites Foreword chapter Maybe
  cites Foreword chapter Hamt

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

  test-sk : List Integer = [157, 97, 177, 157, 239, 253, 90, 96, 186, 132, 74, 244, 146, 236, 44, 196, 68, 73, 197, 105, 123, 50, 105, 25, 112, 59, 172, 3, 28, 174, 127, 96]

  phase-name : VerifyPhase -> Text
  phase-name (p) = when p
    is PhaseIntegrity -> "integrity"
    is PhaseAuthor -> "author"
    is PhaseCapabilities -> "capabilities"
    is PhaseEffects -> "effects"
    is PhaseProofs -> "proofs"

Section: Body
  opening : [Console] Nothing =
    let binary = cdx-encode-signed (CdxBinaryParts {
      flags = cdx-flag-bare-metal,
      capabilities = [
        CdxCapability { cap-id = cdx-cap-console, direction = cdx-dir-write, scope = "/", max-duration = 0 }
      ],
      effects = ["Console"],
      text-bytes = [144, 195],
      rodata-bytes = [],
      entry-offset = 0,
      stack-size = 65536,
      heap-size = 65536,
      trust-threshold = 5000
    }) test-sk
    in let author-key = read-author-key binary
    in let trusted-lat = lattice-add-direct lattice-empty author-key 8000
    in let untrusted-lat = lattice-empty
    in let policy = policy-add-rule (policy-empty "test") (rule-allow "allow-console" (CapabilityMatch "Console" 2))
    in let r-good = verify-cdx binary trusted-lat policy 0
    in let r-untrusted = verify-author binary untrusted-lat 5000
    in act
      print-line-uni ("verified=" & show-bool (r-good.accepted) & " phase=" & phase-name (r-good.phase) & " untrusted=" & show-bool (r-untrusted.accepted) & " reject-phase=" & phase-name (r-untrusted.phase) & " reject-reason=" & r-untrusted.reason)
    end

