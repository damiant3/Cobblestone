Chapter: MagicOracleCensus
  cites Foreword chapter Console
  cites Magic chapter CoverageReport

 We say:

Section: Body

  read-all-lines : List Text -> [Console] List Text
  read-all-lines (acc) = act
    m <- read-line
    when m
      is Just (l) -> read-all-lines (list-push acc l)
      is None -> acc
  end

  opening : [Console] Nothing = act
    lines <- read-all-lines []
    print-line-uni (export-coverage lines)
    print-line-uni (export-census lines)
  end