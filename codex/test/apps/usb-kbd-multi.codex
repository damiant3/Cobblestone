Chapter: UsbKbdMulti
  cites Works chapter GopUsb
  cites Works chapter GopUsbKbd
  cites Works chapter GopXhci
  cites Works chapter GopRtc
  cites Foreword chapter Maybe

Section: Test

  peers-line : UsbKbd -> Text
  peers-line (k) =
    "kbd: ok=" & (if k.uk-ok then "1" else "0")
      & " peers=" & show (kbd-peers k)
      & " peer0-route=" & (if kbd-peers k > 0 then show (((kbd-peer k 0).uk-dev).ud-route) else "-")

  ukm-wait : UsbKbd, Integer, Integer, Integer -> [Device.Port] Integer
  ukm-wait (k) (want) (prev) (secs) = act
    sc <- kbd-take k
    now <- rtc-seconds 0
    if sc == want then sc
    else if secs <= 0 then 0
    else if now < 0 then ukm-wait k want prev secs
    else if now == prev then ukm-wait k want prev secs
    else ukm-wait k want now (secs - 1)
  end

  yn : Integer -> Text
  yn (n) = if n > 0 then "Y" else "0"

  opening : [Console, Device.Port, Device.Mmio] Nothing = act
    att <- usb-attach
    let k = att.ua-kbd
    in act
      print-line-uni (peers-line k)
      s0 <- rtc-seconds 0
      got <- ukm-wait k 30 s0 8
      print-line-uni ("got=" & show got)
      print-line-uni ("primary-live=" & yn (kbd-live k) & " peer-live=" & (if kbd-peers k > 0 then yn (kbd-live (kbd-peer k 0)) else "-"))
    end
  end
