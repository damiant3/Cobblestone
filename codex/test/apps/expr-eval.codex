Chapter: ExprEvalTest
  cites Dev chapter ExprEval

 THE HEX CASES ARE HERE BECAUSE THEY CAUGHT A REAL BUG. `0xff` came back
 as 391 on the first run: the letter-to-value step did `10 + c - 'a'`,
 which is meaningless in CCE, where letters are ordered by English
 frequency and `f` is 28 while `a` is 15. `0xF0 & 0x3C` is the same bug
 seen through an operator, and it answered 64 instead of 48. Both stay,
 in both cases, because a hex scanner that is right for `0x10` and wrong
 for `0xff` passes any test that only uses the first ten digits.

 We say:

Section: Reporting

  probe : Text -> [Console] Nothing
  probe (s) = act
    print-line-uni (s & " => " & expr-show (expr-eval s 4096))
  end

  probe-at : Text, Integer -> [Console] Nothing
  probe-at (s) (last) = act
    print-line-uni (s & " @ " & show last & " => " & expr-show (expr-eval s last))
  end

Section: Body

  opening : [Console] Nothing = act

    probe "42"
    probe "0x10"
    probe "0xff"
    probe "0xFF"

    probe "heap-base"
    probe "gop-fb"

    probe "heap-base + 0x100"
    probe "0x10 - 1"
    probe "1 + 2 * 3"
    probe "1 | 2 + 3"
    probe "2 * 3 * 4"
    probe "0xF0 & 0x3C"
    probe "1 << 8"
    probe "0x100 >> 4"
    probe "7 ^ 1"

    probe "$"
    probe "$ + 16"

    probe "heap-base-1"

    probe ""
    probe "0x"
    probe "nosuch"
    probe "1 +"
    probe "1 2"
    probe "0x10 )"
    probe "8 / 0"

    probe "9223372036854775807"
    probe "9223372036854775808"
    probe "99999999999999999999"
    probe "0x7fffffffffffffff"
    probe "0x8000000000000000"
    probe "0xFFFF800000000000"
    probe "0x7ffffffffffffffe + 1"
    probe "0x7fffffffffffffff + 1"
    probe "0x3fffffffffffffff * 2"
    probe "0x4000000000000000 * 2"
    probe "3074457345618258602 * 3"
    probe "3074457345618258603 * 3"

    probe-at "$ + 1" (0 - 9223372036854775807 - 1)
    probe-at "$ - 1" (0 - 9223372036854775807 - 1)
    probe-at "0 - $" (0 - 9223372036854775807 - 1)
    probe-at "$ * 2 + 1" (0 - 4611686018427387904)
    probe-at "$ * 2" (0 - 4611686018427387905)
    probe-at "$ * $" (0 - 3037000499)
    probe-at "$ * $" (0 - 3037000500)
    probe-at "$ * 0x7fffffffffffffff" (0 - 1)
    probe-at "5 * $" (0 - 1844674407370955161)
    probe-at "5 * $" (0 - 1844674407370955162)

  end
