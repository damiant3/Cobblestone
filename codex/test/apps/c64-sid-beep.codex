Chapter: C64SidBeep
  cites Foreword chapter Console
  cites C64 chapter Sid
  cites Kernel chapter HdaAudio

 The C64's classic SID tone test, made audible. It pokes the register
 sequence every C64 manual prints --

   POKE 54296,15 : POKE 54277,9 : POKE 54273,28 : POKE 54272,49 : POKE 54276,17

 -- which is master volume 15, voice 1 attack 0 / decay 9, frequency 7217
 (424 Hz), sustain 0, and control #11 (triangle waveform, gate on). With
 sustain 0 the note is a plucked triangle that decays to silence over the
 decay time, so half a second of PCM captures the whole pluck. sid-render
 synthesises it and hda-play-pcm hands it to codex-vm's HDA output.

   build/compile.ps1 -Src codex/test/apps/c64-sid-beep.codex -Out b.cdx -Log b.log
   tools/codex-vm.exe -kernel b.cdx -mem 3072

Section: Body

  opening : [Console, Audio] Nothing = act
    let regs = alloc-bytes 32
    in let d0 = poke-byte regs 0 49
    in let d1 = poke-byte regs 1 28
    in let d4 = poke-byte regs 4 #11
    in let d5 = poke-byte regs 5 9
    in let d6 = poke-byte regs 6 0
    in let d24 = poke-byte regs 24 15
    in let n = 24000
    in let buf = alloc-bytes (n * 4)
    in let r = sid-render regs buf n
    in act
      print-line-uni "c64 sid: the classic tone"
      p <- hda-play-pcm buf (n * 4)
      print-line-uni "done"
    end
  end
