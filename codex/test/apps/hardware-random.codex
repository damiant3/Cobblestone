Chapter: HardwareRandom
  cites Foreword chapter Random

Section: Body
  verdict : Maybe (List Integer) -> Text
  verdict (m) = when m
    is None -> "FAIL: refused"
    is Just (ws) -> if list-at ws 0 == list-at ws 1 then "FAIL: identical" else "PASS: two distinct values"

  opening : [Console] Nothing = print-line-uni (verdict (hardware-random-words 2))
