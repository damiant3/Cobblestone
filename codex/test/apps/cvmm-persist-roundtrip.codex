Chapter: CvmmPersistRoundtrip
  cites Cvmm chapter CvmmPersist
  cites Cvmm chapter Garden
  cites Cvmm chapter HomeProjects
  cites Encode chapter Json
  cites Foreword chapter Maybe
  cites Foreword chapter Console

Section: Fixtures

  log-entry : GardenLogEntry = GardenLogEntry { gl-id = 7, gl-plant-id = 3, gl-date = 20260924, gl-action = GaPrune, gl-notes = "trim" }

  mat-a : Material = Material { mat-id = 11, mat-name = "grout", mat-quantity = "2 bags", mat-cost-cents = 1299, mat-purchased = True, mat-store = "hw" }

  mat-b : Material = Material { mat-id = 12, mat-name = "tile", mat-quantity = "40", mat-cost-cents = 8000, mat-purchased = False, mat-store = "hw" }

  project : HomeProject = HomeProject { hp-id = 5, hp-title = "bath", hp-description = "retile", hp-room = "bath", hp-category = PjRenovation, hp-status = PjInProgress, hp-priority = 2, hp-budget-cents = 50000, hp-spent-cents = 9299, hp-start-date = 1, hp-end-date = 2, hp-materials = [mat-a, mat-b], hp-material-count = 2, hp-created = 3 }

  reparse : JsonValue -> JsonValue
  reparse (jv) = when json-parse (json-emit jv)
    is Just (v) -> v
    is None -> json-str "unparsed"

Section: Entry

  opening : [Console] Nothing =
    let g = garden-log-from-jv (reparse (garden-log-to-jv log-entry))
    in let p = project-from-jv (reparse (project-to-jv project))
    in let m0 = list-at (p.hp-materials) 0
    in let m1 = list-at (p.hp-materials) 1
    in act
      print-line-uni ("log id " & show (g.gl-id) & " plant " & show (g.gl-plant-id) & " action " & ga-label (g.gl-action) & " notes " & g.gl-notes)
      print-line-uni ("project materials " & show (p.hp-material-count) & " purchased " & show (hp-materials-purchased p))
      print-line-uni ("mat ids " & show (m0.mat-id) & " " & show (m1.mat-id) & " qty " & m0.mat-quantity & " / " & m1.mat-quantity)
    end

