Chapter: DigestComputeTest
  cites Works chapter DigestCompute
  cites Foreword chapter Console

  opening : [Console] Nothing =
    let empty = compute-digest "empty.bin" []
    in let abc = compute-digest "abc.bin" [97, 98, 99]
    in let abd = compute-digest "abd.bin" [97, 98, 100]
    in let abc-elsewhere = compute-digest "copy/abc.bin" [97, 98, 99]
    in act
      print-line-uni ("empty size  : " & show (empty.size))
      print-line-uni ("empty sha   : " & empty.sha256)
      print-line-uni ("abc size    : " & show (abc.size))
      print-line-uni ("abc sha     : " & abc.sha256)
      print-line-uni ("same bytes  : " & show (digests-match abc abc-elsewhere))
      print-line-uni ("one byte off: " & show (digests-match abc abd))
      print-line-uni ("fixed       : " & verify-fixed-point abc abc-elsewhere)
      print-line-uni ("diverged    : " & verify-fixed-point abc abd)
      print-line-uni ("table 0 len : " & show (text-length (format-digest-table [])))
      print-line-uni (format-digest-table [abc])
      print-line-uni (format-digest-table [empty, abd])
      print-line-uni "done"
    end

