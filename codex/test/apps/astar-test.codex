Chapter: AStarTest
  cites Codex chapter General
  cites Game chapter AStar

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-grid-new : Text =
    let g = astar-grid-new 5 5
    in "w=" & show (g.width) & " h=" & show (g.height)

  test-block : Text =
    let g = astar-block (astar-grid-new 5 5) 2 2
    in "blocked=" & show-bool (astar-is-blocked g 2 2) & " free=" & show-bool (astar-is-blocked g 0 0)

  test-manhattan : Text =
    "dist=" & show (astar-manhattan 0 0 3 4)

  opening : [Console] Nothing = act
    print-line-uni test-grid-new
    print-line-uni test-block
    print-line-uni test-manhattan
  end
