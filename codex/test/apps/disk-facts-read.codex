Chapter: DiskFactsRead
  cites Codex chapter General
  cites Kernel chapter DiskFacts
  cites Foreword chapter FactStore
  cites Foreword chapter Hamt
  cites Foreword chapter Maybe
  cites Foreword chapter Sha256

Section: Body
  opening : Text =
    let store = disk-load
    in let hash = fact-content-hash "hello"
    in let maybe-fact = disk-read-fact store hash
    in when maybe-fact
      is Just (f) -> f.content
      is None -> "not-found"
