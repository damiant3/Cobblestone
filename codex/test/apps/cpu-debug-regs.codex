Chapter: CpuDebugRegsTest

 THE ASSERTIONS ARE ARCHITECTURAL INVARIANTS (Intel SDM vol. 3B 18.2), not
 captured values. DR0-DR3 hold whatever linear address is written. DR7 bit
 10 always reads 1, and with every L/G enable bit clear a pattern in the
 RW/LEN fields arms nothing and reads back as written. DR6 bits 4-11 always
 read 1. All four address registers are written before any is read, so a
 helper that encodes the wrong register number reads back a neighbour.

 We say:

Section: Body

  opening : [Console] Nothing = act
    let w0 = cpu-write-dr0 4096
    in let w1 = cpu-write-dr1 8192
    in let w2 = cpu-write-dr2 12288
    in let w3 = cpu-write-dr3 140737488351232
    in let r0 = cpu-read-dr0
    in let r1 = cpu-read-dr1
    in let r2 = cpu-read-dr2
    in let r3 = cpu-read-dr3
    in let z7 = cpu-write-dr7 0
    in let d7a = cpu-read-dr7
    in let p7 = cpu-write-dr7 983040
    in let d7b = cpu-read-dr7
    in let c7 = cpu-write-dr7 0
    in let z6 = cpu-write-dr6 0
    in let d6 = cpu-read-dr6
    in act
      print-line-uni ("dr0-3 round-trip: " & show (r0 == 4096 & r1 == 8192 & r2 == 12288 & r3 == 140737488351232))
      print-line-uni ("writes answer 0: " & show (w0 + w1 + w2 + w3 + z7 + p7 + c7 + z6 == 0))
      print-line-uni ("dr7 bit 10 after 0: " & show (bit-and d7a 1024 == 1024))
      print-line-uni ("dr7 rw-len pattern: " & show (d7b == 984064))
      print-line-uni ("dr6 bits 4-11 set: " & show (bit-and d6 4080 == 4080))
    end
  end

