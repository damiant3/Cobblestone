Chapter: ShaOctetRefusalTest
  cites Foreword chapter Sha256
  cites Foreword chapter Sha512
  cites Foreword chapter Sha1
  cites Foreword chapter Maybe

Section: Helpers

  verdict : Maybe (List Integer) -> Text
  verdict (r) =
    when r
      is Just (_) -> "accepted"
      is None -> "refused"

  zeros : Integer, List Integer -> List Integer
  zeros (n) (acc) = if n <= 0 then acc else zeros (n - 1) (acc & [0])

  block-tail-bad : List Integer
  block-tail-bad = zeros 63 [] & [256]

  rows : Text, (List Integer -> Maybe (List Integer)) -> List Text
  rows (name) (f) = [
    name & " [0, 0, 0, 256]: " & verdict (f [0, 0, 0, 256]),
    name & " [0, 0, 1, 0]: " & verdict (f [0, 0, 1, 0]),
    name & " [0, 0, 0, -1]: " & verdict (f [0, 0, 0, 0 - 1]),
    name & " [4294967296]: " & verdict (f [4294967296]),
    name & " [97, 1000, 99]: " & verdict (f [97, 1000, 99]),
    name & " 63 zeros then 256: " & verdict (f block-tail-bad),
    name & " [255]: " & verdict (f [255]),
    name & " []: " & verdict (f [])
  ]

  join-lines : List Text, Integer, Text -> Text
  join-lines (xs) (i) (acc) =
    if i >= list-length xs then acc
    else join-lines xs (i + 1) (if i == 0 then list-at xs i else acc & "\n" & list-at xs i)

  hex256 : Maybe (List Integer) -> Text
  hex256 (r) = when r
    is Just (d) -> sha256-to-hex d
    is None -> "refused"

  hex512 : Maybe (List Integer) -> Text
  hex512 (r) = when r
    is Just (d) -> sha512-to-hex d
    is None -> "refused"

  hex1 : Maybe (List Integer) -> Text
  hex1 (r) = when r
    is Just (d) -> sha1-to-hex d
    is None -> "refused"

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("sha256 abc: " & hex256 (sha256-checked [97, 98, 99]))
    print-line-uni ("sha256 empty: " & hex256 (sha256-checked []))
    print-line-uni ("sha512 abc: " & hex512 (sha512-checked [97, 98, 99]))
    print-line-uni ("sha384 abc: " & hex512 (sha384-checked [97, 98, 99]))
    print-line-uni ("sha1 abc: " & hex1 (sha1-checked [97, 98, 99]))
    print-line-uni ("sha256 plain equals checked on abc: " & (if sha256-to-hex (sha256 [97, 98, 99]) == hex256 (sha256-checked [97, 98, 99]) then "yes" else "no"))
    print-line-uni (join-lines (rows "sha256" sha256-checked) 0 "")
    print-line-uni (join-lines (rows "sha512" sha512-checked) 0 "")
    print-line-uni (join-lines (rows "sha384" sha384-checked) 0 "")
    print-line-uni (join-lines (rows "sha1" sha1-checked) 0 "")
  end

