Section: Helpers

  fmt-bytes : List Integer, Integer, Integer, Text -> Text
  fmt-bytes (bs) (i) (n) (acc) =
    if i >= n then acc
    else let sep = if i == 0 then "" else ","
    in fmt-bytes bs (i + 1) n (acc & sep & show (list-at bs i))

Section: Entry

  opening : [Console] Nothing =
    let name1 = dns-encode-name "www.example.com"
    in let l1 = "len=" & show (list-length name1) & " first=" & show (list-at name1 0) & " last=" & show (list-at name1 (list-length name1 - 1))
    in let name2 = dns-encode-name "a.b"
    in let l2 = show (list-length name2) & ":" & fmt-bytes name2 0 (list-length name2) ""
    in let query = dns-build-a-query 1234 "test.local"
    in let l3 = "qlen=" & show (list-length query) & " id=" & show (read-be16 query 0) & " qdcount=" & show (read-be16 query 4)
    in let resp-bytes = [4, 210, 129, 128, 0, 1, 0, 1, 0, 0, 0, 0, 4, 116, 101, 115, 116, 5, 108, 111, 99, 97, 108, 0, 0, 1, 0, 1, 192, 12, 0, 1, 0, 1, 0, 0, 0, 60, 0, 4, 10, 0, 0, 1]
    in let resp = dns-parse-response resp-bytes
    in let l4 = "valid=" & show (resp.valid) & " id=" & show (resp.tx-id) & " answers=" & show (resp.answer-count)
    in let a-rec = dns-first-a-record resp
    in let a-ttl = dns-first-a-ttl resp
    in let l5 = (when a-rec is Just (ip) -> format-ip ip is None -> "none") & " ttl=" & show a-ttl
    in let bad-resp = dns-parse-response [1, 2, 3]
    in let l6 = "valid=" & show (bad-resp.valid)
    in let udp-query = dns-build-udp-query [192, 168, 1, 10] [8, 8, 8, 8] 1234 "host.test"
    in let l7 = "proto=" & show (ip-proto udp-query) & " pktlen=" & show (list-length udp-query)
    in let ht = host-table-add host-table-empty "localhost" [127, 0, 0, 1]
    in let r = resolver-new ht
    in let r2 = resolver-cache-result r "cached" [10, 0, 0, 42] 100 1000
    in let r3 = resolver-cache-result r2 "expired" [1, 2, 3, 4] 10 500
    in let local-ip = resolve r3 "localhost" 1100
    in let cached-ip = resolve r3 "cached" 1050
    in let expired-ip = resolve r3 "expired" 1100
    in let missing-ip = resolve r3 "unknown" 1100
    in let fmt-maybe-ip = maybe-format-ip
    in let l8 = "local=" & fmt-maybe-ip local-ip & " cached=" & fmt-maybe-ip cached-ip & " expired=" & fmt-maybe-ip expired-ip & " missing=" & fmt-maybe-ip missing-ip
    in act
      print-line-uni l1
      print-line-uni l2
      print-line-uni l3
      print-line-uni l4
      print-line-uni l5
      print-line-uni l6
      print-line-uni l7
      print-line-uni l8
    end

  maybe-format-ip : Maybe (List Integer) -> Text
  maybe-format-ip (m) = when m is Just (ip) -> format-ip ip is None -> "none"

