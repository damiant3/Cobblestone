Chapter: WizardUsbProofTest
  cites Works chapter GopWizard
  cites Works chapter GopUsbKbd
  cites Works chapter GopXhci
  cites Works chapter GopAhci
  cites Foreword chapter Console

  wup-kbd : Integer -> UsbKbd
  wup-kbd (state) = UsbKbd { uk-ok = True, uk-host = xhci-no-host, uk-dev = xhci-no-dev, uk-dci = 0, uk-ring = 0, uk-report = 0, uk-prev = 0, uk-state = state, uk-raw = False, uk-peers = [] }

  opening : [Console] Nothing =
    let primary-state = alloc-zeroed 64 64
    in let peer-state = alloc-zeroed 64 64
    in let primary = wup-kbd primary-state
    in let peer = wup-kbd peer-state
    in let absent = wz-usb-proven kbd-no-kbd == False
    in let silent = wz-usb-proven primary == False
    in let events = poke-32 primary-state uk-cell-events 100
    in let transfer-only = wz-usb-proven primary == False
    in let input = poke-32 primary-state uk-cell-scans 1
    in let proven = wz-usb-proven primary
    in let clear = poke-32 primary-state uk-cell-scans 0
    in let composite = kbd-adopt primary peer
    in let peer-silent = wz-usb-proven composite == False
    in let peer-input = poke-32 peer-state uk-cell-scans 1
    in let peer-proven = wz-usb-proven composite
    in let mark = __heap-save
    in let repeat = wz-usb-proven composite
    in let kept = __heap-save == mark
    in act
      print-line-uni ("absent and silent remain eligible: " & show (absent & silent & peer-silent))
      print-line-uni ("empty completions are not key proof: " & show transfer-only)
      print-line-uni ("primary decoded input preserves USB: " & show proven)
      print-line-uni ("peer decoded input preserves USB: " & show (peer-proven & repeat))
      print-line-uni ("check allocates nothing: " & show kept)
    end
