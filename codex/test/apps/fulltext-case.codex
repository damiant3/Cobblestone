Chapter: FullTextCaseTest
  cites Data chapter FullText (ft-lowercase)
  cites Foreword chapter Console

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("Hello World -> " & ft-lowercase "Hello World")
    print-line-uni ("ABC xyz 42 -> " & ft-lowercase "ABC xyz 42")
    print-line-uni ("already lower -> " & ft-lowercase "already lower")
    print-line-uni ("punctuation ,.;:!?-()[] -> " & ft-lowercase ",.;:!?-()[]")
    print-line-uni ("same key -> " & show (ft-lowercase "Codex" == ft-lowercase "codex"))
  end
