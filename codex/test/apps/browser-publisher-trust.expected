page digest bytes are octets = True
publisher header decodes to the key = True
signature header decodes to the signature = True
malformed publisher header refused = True
signature verifies under the page's key = True
page with no publisher and no signature = refused: Publisher signature verification failed
granted publisher, signature missing = refused: Publisher signature verification failed
signed page, publisher unknown to the trust store = refused: publisher not trusted
signed page, publisher granted in the trust store = past trust
signed page, publisher is the browser's own key = past trust
no publisher is trusted = False
an empty key against an empty own key is trusted = False
