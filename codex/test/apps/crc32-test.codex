Chapter: Crc32Test
  cites Encode chapter Crc32

Section: Tests
  test-empty : Text =
    "empty=" & show (crc32 [])

  test-hello : Text =
    "hello=" & show (crc32-of-text "hello")

  test-bytes : Text =
    "bytes=" & show (crc32 [104, 101, 108, 108, 111])

  test-verify : Text =
    let cs = crc32-of-text "hello"
    in "verify=" & if crc32-verify [104, 101, 108, 108, 111] cs then "True" else "False"

  test-different : Text =
    let a = crc32-of-text "hello"
    in let b = crc32-of-text "world"
    in "different=" & if a /= b then "True" else "False"

  opening : [Console] Nothing = act
    print-line-uni test-empty
    print-line-uni test-hello
    print-line-uni test-bytes
    print-line-uni test-verify
    print-line-uni test-different
  end
