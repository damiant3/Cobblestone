Chapter: SupervisorPattern

Section: Body
  worker : Integer, Integer -> [Concurrent] Integer
  worker (ch) (value) = act
    s <- chan-kern-send ch (value * value)
    let r = 0
    in r
  end

  opening : [Concurrent] Integer = act
    ch <- chan-kern-create 8
    w1 <- process-spawn (\x -> worker ch 3)
    w2 <- process-spawn (\x -> worker ch 5)
    w3 <- process-spawn (\x -> worker ch 7)
    let p1 = process-wait w1
    in let p2 = process-wait w2
    in let p3 = process-wait w3
    in act
      v1 <- chan-kern-recv ch
      v2 <- chan-kern-recv ch
      v3 <- chan-kern-recv ch
      cl <- chan-kern-close ch
      let r = v1 + v2 + v3
      in r
    end
  end
