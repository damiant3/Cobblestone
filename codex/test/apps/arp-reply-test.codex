Chapter: ArpReplyTest
  cites Foreword chapter Console
  cites Net chapter Ethernet
  cites Net chapter NetworkStack

Section: Entry

  opening : [Console] Nothing =
    let local-mac = mac-bytes 82 84 0 18 52 86
    in let local-ip = ip-bytes 10 0 2 15
    in let gw-ip = ip-bytes 10 0 2 2
    in let host-ip = ip-bytes 127 0 0 1
    in let peer-mac = mac-bytes 1 2 3 4 5 6
    in let peer-ip = ip-bytes 10 0 2 2
    in let other-ip = ip-bytes 10 0 2 99
    in let sess = net-session-new local-mac local-ip gw-ip 49152 9123 host-ip 1000
    in let asked-us = eth-payload (arp-build-request peer-mac peer-ip local-ip)
    in let asked-other = eth-payload (arp-build-request peer-mac peer-ip other-ip)
    in let r1 = net-process-arp sess asked-us
    in let r2 = net-process-arp sess asked-other
    in let out1 = (r1.session).outbox
    in let reply = arp-parse (eth-payload (list-at out1 0))
    in act
      print-line-uni ("asked-us-output=" & r1.output)
      print-line-uni ("asked-us-queued=" & show (list-length out1))
      print-line-uni ("reply-op=" & show (reply.op))
      print-line-uni ("reply-sender-is-us=" & show (ip-equal (reply.sender-ip) local-ip))
      print-line-uni ("reply-target-is-peer=" & show (ip-equal (reply.target-ip) peer-ip))
      print-line-uni ("reply-frame-to-peer=" & show (mac-equal (eth-dst-mac (list-at out1 0)) peer-mac))
      print-line-uni ("asked-other-output=" & r2.output)
      print-line-uni ("asked-other-queued=" & show (list-length ((r2.session).outbox)))
    end

