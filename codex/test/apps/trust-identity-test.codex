Chapter: TrustIdentityTest
  cites Trust chapter TrustLattice
  cites Foreword chapter Hamt
  cites Foreword chapter Maybe

Section: Body
  opening : [Console] Nothing =
    let lat = lattice-empty
    in let lat1 = lattice-add-direct lat "device-root" trust-max
    in let lat2 = lattice-add-direct lat1 "user-alice" 8000
    in let d-score = lattice-trust-score lat2 "device-root"
    in let u-score = lattice-trust-score lat2 "user-alice"
    in let unknown = lattice-trust-score lat2 "unknown-agent"
    in let pass = if d-score == 10000 & u-score == 8000 & unknown == 0 then "PASS" else "FAIL"
    in act
      print-line-uni ("DEVICE-SCORE: " & show d-score)
      print-line-uni ("USER-SCORE: " & show u-score)
      print-line-uni ("UNKNOWN-SCORE: " & show unknown)
      print-line-uni pass
    end

