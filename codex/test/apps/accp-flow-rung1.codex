Chapter: AccpFlowRung1
  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Accp chapter AccpFlowIr

Section: Body

  read-all-lines : List Text -> [Console] List Text
  read-all-lines (acc) = act
    m <- read-line
    when m
      is Just (l) -> read-all-lines (list-push acc l)
      is None -> acc
  end

  bar-at : Text, Integer -> Integer
  bar-at (t) (i) = if i >= text-length t | substring t i 1 == "|" then i else bar-at t (i + 1)

  verdict : Text -> Text
  verdict (line) =
    let b = bar-at line 0
    in let a = afi-analyse ["Network.Read -> Console.Write"] (substring line (b + 1) (text-length line - b - 1))
    in substring line 0 b & ": " & afi-json a

  print-all : List Text, Integer -> [Console] Nothing
  print-all (xs) (i) = act
    if i >= list-length xs then print-line-uni ("programs: " & show (list-length xs))
    else act
      print-line-uni (verdict (list-at xs i))
      print-all xs (i + 1)
    end
  end

  opening : [Console] Nothing = act
    lines <- read-all-lines []
    print-all lines 0
  end
