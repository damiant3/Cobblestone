Chapter: NeuralTest
  cites AI chapter NeuralNet
  cites AI chapter Tensor
  cites AI chapter Activation
  cites Foreword chapter ListUtils

Section: Helpers
  show-tensor-data : Tensor, Integer, Integer, Text -> Text
  show-tensor-data (t) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else " "
    in show-tensor-data t (i + 1) len (acc & sep & show (list-at (t.data) i))

  show-vals : Tensor -> Text
  show-vals (t) = show-vals-loop (t.data) 0 (list-length (t.data)) ""

  show-vals-loop : List Integer, Integer, Integer, Text -> Text
  show-vals-loop (data) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ","
    in show-vals-loop data (i + 1) len (acc & sep & show (list-at data i))

Section: Tests
  test-matmul-shape : Text =
    let w = tensor-from 2 1 [1400, 3200]
    in "shape=" & tensor-shape w & " vals=" & show-vals w

  test-relu : Text =
    let t = tensor-from 4 1 [0 - 500, 0, 500, 1000]
    in let r = act-relu t
    in show-tensor-data r 0 4 ""

  test-sigmoid : Text =
    let t = tensor-from 3 1 [0, 1000, 0 - 1000]
    in let r = act-sigmoid t
    in show-tensor-data r 0 3 ""

  test-softmax : Text =
    let t = tensor-from 2 1 [0, 0]
    in let r = act-softmax t
    in "sum=" & show (tensor-sum r) & " argmax=" & show (tensor-argmax r)

  test-forward : Text =
    let w = tensor-from 3 2 [1000, 0, 0, 1000, 500, 500]
    in let b = tensor-from 3 1 [0, 0, 0]
    in let net = nn-add-layer nn-new w b nn-act-none
    in let input = tensor-vector [1000, 0]
    in let result = nn-forward net input
    in "output=" & show (tensor-get result 0 0) & " params=" & show (nn-param-count net)

  test-predict : Text =
    let w = tensor-from 3 2 [1000, 0, 0, 1000, 500, 500]
    in let b = tensor-from 3 1 [0, 0, 0]
    in let net = nn-add-layer nn-new w b nn-act-none
    in "class=" & show (nn-predict net [1000, 0])

  test-summary : Text =
    let w1 = tensor-from 4 3 [1000, 0, 0, 0, 1000, 0, 0, 0, 1000, 500, 500, 500]
    in let b1 = tensor-from 4 1 [0, 0, 0, 0]
    in let w2 = tensor-from 2 4 [1000, 0, 0, 0, 0, 1000, 0, 0]
    in let b2 = tensor-from 2 1 [0, 0]
    in let net = nn-add-layer (nn-add-layer nn-new w1 b1 nn-act-relu) w2 b2 nn-act-none
    in nn-summary net & " params=" & show (nn-param-count net)

  test-gelu : Text =
    let t = tensor-from 3 1 [0 - 1000, 0, 1000]
    in let r = act-gelu t
    in show-tensor-data r 0 3 ""

  opening : [Console] Nothing = act
    print-line-uni test-matmul-shape
    print-line-uni test-relu
    print-line-uni test-sigmoid
    print-line-uni test-softmax
    print-line-uni test-forward
    print-line-uni test-predict
    print-line-uni test-summary
    print-line-uni test-gelu
  end
