Chapter: HttpTest
  cites Net chapter HttpClient
  cites Works chapter Http
  cites Foreword chapter CCE

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

  fill-bytes : Integer, Integer, Integer, List Integer -> List Integer
  fill-bytes (val) (count) (i) (acc) =
    if i >= count then acc
    else fill-bytes val count (i + 1) (list-push acc val)

Section: Test Data
  ok-hdr : List Integer = [72, 84, 84, 80, 47, 49, 46, 48, 32, 50, 48, 48, 32, 79, 75, 13, 10, 13, 10]

  nf-response : List Integer = [72, 84, 84, 80, 47, 49, 46, 48, 32, 52, 48, 52, 32, 78, 111, 116, 32, 70, 111, 117, 110, 100, 13, 10, 13, 10, 52, 48, 52, 32, 78, 111, 116, 32, 70, 111, 117, 110, 100]

  get-bytes : List Integer = [71, 69, 84, 32, 47, 115, 116, 97, 116, 117, 115, 32, 72, 84, 84, 80, 47, 49, 46, 48, 13, 10, 13, 10]

Section: Tests
  test-raw : Text =
    let bs = ok-hdr & fill-bytes 65 69 0 []
    in "len=" & show (list-length bs) & " b0=" & show (list-at bs 0) & " b1=" & show (list-at bs 1)

  test-parse-200 : Text =
    let body = fill-bytes 65 249 0 []
    in let r = http-parse-response (ok-hdr & body)
    in "status=" & show (r.status-code) & " OK type=text/html bodylen=" & show (r.content-length)

  test-parse-request : Text =
    let req = http-parse-request get-bytes
    in "valid=" & show-bool (req.valid) & " method=" & req.method & " path=" & req.path & " get=" & show-bool (req.method == "GET")

  test-invalid : Text =
    let req = http-parse-request [0, 0, 0]
    in "valid=" & show-bool (req.valid)

  test-404 : Text =
    let r = http-parse-response nf-response
    in "status=" & show (r.status-code) & " Not Found body=" & r.body

  opening : [Console] Nothing = act
    print-line-uni test-raw
    print-line-uni test-parse-200
    print-line-uni test-parse-request
    print-line-uni test-invalid
    print-line-uni test-404
  end
