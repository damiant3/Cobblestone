Chapter: DnsExtractShort
  cites Net chapter HttpFetch
  cites Net chapter Ethernet
  cites Net chapter Udp
  cites Foreword chapter Console

Section: Fixtures
  mac-a : List Integer = [82, 84, 0, 18, 52, 86]
  mac-b : List Integer = [82, 85, 10, 0, 2, 3]
  ip-a : List Integer = [10, 0, 2, 15]
  ip-b : List Integer = [10, 0, 2, 3]

  whole : List Integer = udp-build-frame mac-a mac-b ip-b ip-a 53 40000 [0, 0, 0, 0]

  header-only : List Integer = eth-payload-loop whole 0 24 []

  cut : List Integer = eth-payload-loop whole 0 (list-length whole - 6) []

  report : Text, List Integer -> [Console] Nothing
  report (name) (frame) = print-line-uni (name & " len=" & show (list-length (http-dns-extract frame (http-dns-draw 1) "example.com")))

Section: Entry
  opening : [Console] Nothing = act
    report "ip-shorter-than-header" header-only
    report "ip-shorter-than-claimed" cut
    report "whole" whole
  end
