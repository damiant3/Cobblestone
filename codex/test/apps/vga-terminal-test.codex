Chapter: VgaTerminalTest
  cites Kernel chapter Keyboard
  cites Kernel chapter Console
  cites Kernel chapter Vga
  cites Foreword chapter CCE
  cites Foreword chapter Maybe

Section: Simulated Input
  feed-scancodes : ConsoleState, KbState, List Integer, Integer, Integer -> ConsoleState
  feed-scancodes (con) (kb) (codes) (i) (len) =
    if i >= len then con
    else let sc = list-at codes i
    in if sc == 14 then feed-scancodes (console-feed-backspace con) kb codes (i + 1) len
    else let ev = kb-process-scancode kb (__narrow sc)
    in if ev.ascii == 0 then feed-scancodes con (ev.state) codes (i + 1) len
    else if ev.ascii == 1 then feed-scancodes (console-feed-char con 1) (ev.state) codes (i + 1) len
    else feed-scancodes (console-feed-char con (ev.ascii)) (ev.state) codes (i + 1) len

  test-type-hello : Text =
    let con = console-new (vga-attr vga-light-gray vga-black)
    in let kb = kb-state-new
    in let codes = [35, 18, 38, 38, 24]
    in let con1 = feed-scancodes con kb codes 0 5
    in "buf=" & console-get-line con1 & " ready=" & show (console-has-line con1)

  test-type-enter : Text =
    let con = console-new (vga-attr vga-light-gray vga-black)
    in let kb = kb-state-new
    in let codes = [35, 23, 28]
    in let con1 = feed-scancodes con kb codes 0 3
    in "buf=" & console-get-line con1 & " ready=" & show (console-has-line con1)

  test-type-shifted : Text =
    let con = console-new (vga-attr vga-light-gray vga-black)
    in let kb = kb-state-new
    in let codes = [42, 35, 170, 23]
    in let con1 = feed-scancodes con kb codes 0 4
    in "buf=" & console-get-line con1

  test-backspace : Text =
    let con = console-new (vga-attr vga-light-gray vga-black)
    in let kb = kb-state-new
    in let codes = [30, 48, 46, 14]
    in let con1 = feed-scancodes con kb codes 0 4
    in "buf=" & console-get-line con1

  test-take-line : Text =
    let con = console-new (vga-attr vga-light-gray vga-black)
    in let kb = kb-state-new
    in let codes = [24, 37, 28]
    in let con1 = feed-scancodes con kb codes 0 3
    in let line = console-get-line con1
    in let con2 = console-take-line con1
    in "line=" & line & " after=" & console-get-line con2 & " ready=" & show (console-has-line con2)

  test-vga-echo : Text =
    let con = console-new (vga-attr vga-light-gray vga-black)
    in let kb = kb-state-new
    in let codes = [30, 48, 46]
    in let con1 = feed-scancodes con kb codes 0 3
    in let ch0 = vga-get-char 0 0
    in let ch1 = vga-get-char 0 1
    in let ch2 = vga-get-char 0 2
    in "vga=" & show ch0 & "," & show ch1 & "," & show ch2

  opening : [Console] Nothing = act
    print-line-uni test-type-hello
    print-line-uni test-type-enter
    print-line-uni test-type-shifted
    print-line-uni test-backspace
    print-line-uni test-take-line
    print-line-uni test-vga-echo
  end

