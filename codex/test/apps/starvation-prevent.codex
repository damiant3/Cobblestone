Chapter: StarvationPrevent
  cites Codex chapter General

Section: Body
  opening : Integer =
    let bg = process-spawn-priority (\x ->
      poke-byte 28000 0 77) 3 0
    in let sys = process-spawn-priority (\x ->
      spin-until (get-ticks + 10000)) 1 0
    in let w = process-wait bg
    in peek-byte 28000 0

  spin-until : Integer -> Integer
  spin-until (deadline) =
    if get-ticks >= deadline then 0
    else spin-until deadline
