Chapter: HwWatchTest
  cites Foreword chapter Console
  cites Dev chapter HwWatch

 Two cells in one aligned word and a third in the next: a write to either
 half of the watched word is a hit, the neighbouring word is not, and
 nothing counts once the watch is cleared.

 We say:

Section: Body

  opening : [Console] Nothing = act
    let block = alloc-bytes 32
    in let base = block - (bit-and block 7) + 8
    in let aligned = hw-watch-arm (base + 3)
    in let h0 = hw-watch-hits
    in let w1 = poke-32 base 0 5
    in let w2 = poke-32 base 4 6
    in let h1 = hw-watch-hits
    in let w3 = poke-32 base 8 7
    in let h2 = hw-watch-hits
    in let off = hw-watch-clear
    in let w4 = poke-32 base 0 8
    in let h3 = hw-watch-hits
    in act
      print-line-uni ("arming rounds down to the word: " & show (aligned == base))
      print-line-uni ("armed, nothing counted yet: " & show (h0.hh-armed & h0.hh-count == 0))
      print-line-uni ("both halves of the word are hits: " & show (h1.hh-count == 2))
      print-line-uni ("dr6 names breakpoint 0: " & show (bit-and (h1.hh-dr6) 1 == 1))
      print-line-uni ("the next word is no hit: " & show (h2.hh-count == 2))
      print-line-uni ("cleared, a write is no hit: " & show (h3.hh-armed == False & h3.hh-count == 2))
    end
  end

