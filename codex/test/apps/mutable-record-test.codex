Chapter: MutableRecordTest

Section: Records

  mutable Counter = record {
    value : Integer
  }

  mutable Point = record {
    x : Integer,
    y : Integer
  }

  mutable GameState = record {
    turn : Integer,
    score : Integer,
    lives : Integer
  }

Section: Single Field Assign

  test-increment : Text =
    let c = Counter { value = 0 }
    in c.value = c.value + 1
    in "value=" & show (c.value)

  test-set-to-constant : Text =
    let c = Counter { value = 99 }
    in c.value = 42
    in "value=" & show (c.value)

Section: Multiple Field Assigns

  test-two-fields : Text =
    let p = Point { x = 0, y = 0 }
    in p.x = 10
    in p.y = 20
    in "x=" & show (p.x) & " y=" & show (p.y)

  test-swap-fields : Text =
    let p = Point { x = 3, y = 7 }
    in let old-x = p.x
    in p.x = p.y
    in p.y = old-x
    in "x=" & show (p.x) & " y=" & show (p.y)

Section: Multi-Field Record

  test-game-state : Text =
    let gs = GameState { turn = 0, score = 0, lives = 3 }
    in gs.turn = gs.turn + 1
    in gs.score = gs.score + 100
    in gs.lives = gs.lives - 1
    in "turn=" & show (gs.turn) & " score=" & show (gs.score) & " lives=" & show (gs.lives)

Section: Function Returning Mutated Record

  increment : mutable Counter -> mutable Counter
  increment (c) =
    c.value = c.value + 1
    c

  test-function : Text =
    let c = Counter { value = 5 }
    in let c2 = increment c
    in "value=" & show (c2.value)

  add-score : mutable GameState, Integer -> mutable GameState
  add-score (gs) (points) =
    gs.score = gs.score + points
    gs.turn = gs.turn + 1
    gs

  test-multi-call : Text =
    let gs = GameState { turn = 0, score = 0, lives = 3 }
    in let gs2 = add-score gs 100
    in let gs3 = add-score gs2 250
    in "turn=" & show (gs3.turn) & " score=" & show (gs3.score)

Section: Body

  opening : [Console] Nothing = act
    print-line-uni test-increment
    print-line-uni test-set-to-constant
    print-line-uni test-two-fields
    print-line-uni test-swap-fields
    print-line-uni test-game-state
    print-line-uni test-function
    print-line-uni test-multi-call
  end
