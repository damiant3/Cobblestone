  ca-parsed : Maybe X509Cert = x509-parse ca-cert

  anchors : List X509Anchor =
    when ca-parsed is None -> [] is Just (c) -> [X509Anchor { xa-subject = c.xc-subject, xa-key = c.xc-key }]

Section: Helpers

  tr-eq : List Integer, List Integer -> Boolean
  tr-eq (a) (b) =
    if list-length a /= list-length b then False
    else tr-eq-loop a b 0 (list-length a)

  tr-eq-loop : List Integer, List Integer, Integer, Integer -> Boolean
  tr-eq-loop (a) (b) (i) (n) =
    if i >= n then True
    else if list-at a i /= list-at b i then False
    else tr-eq-loop a b (i + 1) n

  copy-bytes : List Integer -> List Integer
  copy-bytes (bs) = cb-loop bs 0 (list-length bs) []

  cb-loop : List Integer, Integer, Integer, List Integer -> List Integer
  cb-loop (bs) (i) (n) (acc) =
    if i >= n then acc else cb-loop bs (i + 1) n (list-push acc (list-at bs i))

  flip-late : List Integer -> List Integer
  flip-late (bs) = list-set-at (copy-bytes bs) (list-length bs - 6) (bit-xor (list-at bs (list-length bs - 6)) 1)

Section: The Server

  s0 : TlsEp = tls-ep-server-new s-priv s-random [leaf-cert] leaf-priv leaf-pub

Section: A Client With No Anchors

  n0 : TlsEp = tls-ep-client-new c-priv c-random [] cal-now []

  ns1 : TlsEpStep = tls-ep-hello n0
  nch : List Integer = list-at (ns1.tes-out) 0

  nsv1 : TlsEpStep = tls-ep-recv s0 nch
  nsh : List Integer = list-at (nsv1.tes-out) 0
  nee : List Integer = list-at (nsv1.tes-out) 1
  ncert : List Integer = list-at (nsv1.tes-out) 2
  ncv : List Integer = list-at (nsv1.tes-out) 3
  nfin : List Integer = list-at (nsv1.tes-out) 4

  n1 : TlsEpStep = tls-ep-recv (ns1.tes-ep) nsh
  n2 : TlsEpStep = tls-ep-recv (n1.tes-ep) nee
  n3 : TlsEpStep = tls-ep-recv (n2.tes-ep) ncert
  n4 : TlsEpStep = tls-ep-recv (n3.tes-ep) ncv
  n5 : TlsEpStep = tls-ep-recv (n4.tes-ep) nfin
  nfin-out : List Integer = list-at (n5.tes-out) 0

  nsv2 : TlsEpStep = tls-ep-recv (nsv1.tes-ep) nfin-out

  ncs1 : TlsEpStep = tls-ep-send-app (n5.tes-ep) [71, 69, 84]
  nreq : List Integer = list-at (ncs1.tes-out) 0
  nsv3 : TlsEpStep = tls-ep-recv (nsv2.tes-ep) nreq

  nss1 : TlsEpStep = tls-ep-send-app (nsv3.tes-ep) [79, 75]
  nresp : List Integer = list-at (nss1.tes-out) 0
  n6 : TlsEpStep = tls-ep-recv (ncs1.tes-ep) nresp

Section: A Client That Asked For Authentication And Was Cheated

  peer-name : List Integer =
    [100, 101, 118, 105, 99, 101, 46, 99, 111, 100, 101, 120, 46, 116, 101, 115, 116]

  t0 : TlsEp = tls-ep-client-new c-priv c-random anchors cal-now peer-name

  ts1 : TlsEpStep = tls-ep-hello t0
  tch : List Integer = list-at (ts1.tes-out) 0

  tsv1 : TlsEpStep = tls-ep-recv s0 tch
  tsh : List Integer = list-at (tsv1.tes-out) 0
  tee : List Integer = list-at (tsv1.tes-out) 1
  tcert : List Integer = list-at (tsv1.tes-out) 2
  tcv : List Integer = list-at (tsv1.tes-out) 3
  tfin : List Integer = list-at (tsv1.tes-out) 4

  tcert-bad : List Integer = flip-late tcert

  t1 : TlsEpStep = tls-ep-recv (ts1.tes-ep) tsh
  t2 : TlsEpStep = tls-ep-recv (t1.tes-ep) tee
  t3 : TlsEpStep = tls-ep-recv (t2.tes-ep) tcert-bad
  t4 : TlsEpStep = tls-ep-recv (t3.tes-ep) tcv
  t5 : TlsEpStep = tls-ep-recv (t4.tes-ep) tfin

Section: Results

  test-noauth-done : Text = "noauth done=" & show (tls-ep-done (n5.tes-ep))
  test-noauth-server : Text = "noauth server-done=" & show (tls-ep-done (nsv2.tes-ep))
  test-noauth-auth : Text = "noauth authenticated=" & show (tls-ep-authenticated (n5.tes-ep))
  test-noauth-c2s : Text = "noauth c2s=" & show (tr-eq (tls-ep-app-in (nsv3.tes-ep)) [71, 69, 84])
  test-noauth-s2c : Text = "noauth s2c=" & show (tr-eq (tls-ep-app-in (n6.tes-ep)) [79, 75])
  test-tampered : Text = "tampered done=" & show (tls-ep-done (t5.tes-ep)) & " authenticated=" & show (tls-ep-authenticated (t5.tes-ep))

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni test-noauth-done
    print-line-uni test-noauth-server
    print-line-uni test-noauth-auth
    print-line-uni test-noauth-c2s
    print-line-uni test-noauth-s2c
    print-line-uni test-tampered
  end
