Chapter: Map1LookupTest
  cites Works chapter DevDebugger
  cites Foreword chapter Maybe

 AN ENTRY'S `code-offset` IS RELATIVE TO THE LOAD ADDRESS, not an
 absolute address, which is why nothing here compares one against
 0x100000. `resolve-addr` subtracts the load address before it looks up
 a RIP; a test that fed `map1-lookup` an absolute address would get None
 for every symbol in the map and read as a broken lookup.

 We say:

Section: The Body Of The Report

  report-body : Map1Info -> Text
  report-body (m) =
    let e0 = map1-read-entry (m.base) 0
    in let name = map1-read-name m (e0.name-offset)
    in let a = "count-positive: " & show (m.count > 0)
    in let b = "name-nonempty: " & show (text-length name > 0)
    in let c = "code-size-positive: " & show (e0.code-size > 0)
    in let d = by-addr-line m e0 name
    in let e = by-name-line m e0 name
    in let f = miss-line m
    in a & "\n" & b & "\n" & c & "\n" & d & "\n" & e & "\n" & f

  by-addr-line : Map1Info, Map1Entry, Text -> Text
  by-addr-line (m) (e0) (name) =
    when map1-lookup m (e0.code-offset)
      is None -> "by-addr: NOT FOUND"
      is Just (e) -> "by-addr-name-matches: " & show (map1-read-name m (e.name-offset) == name)

  by-name-line : Map1Info, Map1Entry, Text -> Text
  by-name-line (m) (e0) (name) =
    when map1-find-by-name m name
      is None -> "by-name: NOT FOUND"
      is Just (e) -> "by-name-offset-matches: " & show (e.code-offset == e0.code-offset)

  miss-line : Map1Info -> Text
  miss-line (m) =
    when map1-find-by-name m "zzz-no-such-symbol"
      is None -> "miss-refused: True"
      is Just (e) -> "miss-refused: False"

Section: Body

  report-text : Text
  report-text =
    when map1-find
      is None -> "map1: NOT FOUND"
      is Just (m) -> "map1: FOUND\n" & report-body m

  opening : [Console] Nothing = act
    print-line-uni report-text
  end

