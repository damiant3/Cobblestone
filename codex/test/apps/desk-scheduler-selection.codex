Chapter: DeskSchedulerSelection
  cites Kernel chapter Hpet
  cites Works chapter GopAhci
  cites Foreword chapter Console

  selection-case : Integer = 4
  selection-timer : Integer = 1
  selection-sabotage : Integer = 0
  selection-verbose : Integer = 0

  SelectionRun = record {
    sr-cells : Integer,
    sr-tick : Integer,
    sr-clock : Integer,
    sr-until : Integer,
    sr-rate : Integer,
    sr-window : Integer,
    sr-channel : Integer
  }

  sel-starve : Boolean = selection-case == 3 | selection-case == 5

  sel-seed : Integer -> Integer
  sel-seed (dummy) =
    let z = zero-dwords 30008 0 8
    in let s = poke-32 30008 8 (if selection-timer == 1 then 6 else 0)
    in let normal = if selection-timer == 1 & (selection-sabotage == 0 | sel-starve | selection-case == 2) then 3 else 0
    in let n = poke-32 30008 16 normal
    in let b = poke-32 30008 24 (if selection-timer == 1 then 1 else 0)
    in poke-32 30048 0 0

  sel-tick : SelectionRun -> Integer
  sel-tick (run) = peek-32 28672 0 - run.sr-tick

  sel-us : SelectionRun -> Integer
  sel-us (run) = if run.sr-rate <= 0 then 0 else (hpet-ticks - run.sr-clock) * 1000000 / run.sr-rate

  sel-row : SelectionRun, Integer -> Integer
  sel-row (run) (id) = run.sr-cells + id * 32

  sel-sample : SelectionRun, Integer, Integer -> Integer
  sel-sample (run) (id) (tick) =
    let row = sel-row run id
    in let work = poke-32 row 20 (peek-32 row 20 + 1)
    in let count = peek-32 row 0
    in let last = peek-32 row 8
    in if count > 0 & last == tick then 0
    else let first = if count == 0 then poke-32 row 4 tick else 0
    in let gap = if count == 0 then tick else tick - last
    in let largest = peek-32 row 12
    in let updated = if gap > largest then poke-32 row 12 gap else 0
    in let latest = poke-32 row 8 tick
    in poke-32 row 0 (count + 1)

  sel-send : SelectionRun, Integer, Integer -> [Concurrent] Integer
  sel-send (run) (id) (tick) = act
    if selection-case /= 2 | id /= 2 | tick < 10 then 0
    else if peek-32 (run.sr-cells) 0 > 0 then
      if selection-sabotage == 1 & peek-32 (run.sr-cells) 0 == 1 & tick >= peek-32 (run.sr-cells) 8 + 8
      then let eligible = poke-32 (20480 + 256) 16 0
      in poke-32 (run.sr-cells) 0 2 else 0
    else let blocked = peek-32 (20480 + 256) 0
    in let setup = poke-32 (run.sr-cells) 4 blocked
    in let at = poke-32 (run.sr-cells) 8 tick
    in let time = poke-32 (run.sr-cells) 12 (sel-us run)
    in let sent = poke-32 (run.sr-cells) 0 1
    in let hold = if selection-sabotage == 1 then zero-dwords (20480 + 256 + 16) 0 2 else 0
    in let unavailable = if selection-sabotage == 1 then poke-32 (20480 + 256) 16 1 else 0
    in chan-kern-send-block (run.sr-channel) 77
  end

  sel-worker : SelectionRun, Integer, Integer -> [Concurrent] Integer
  sel-worker (run) (id) (fuel) = act
    let tick = sel-tick run
    in if tick >= run.sr-window | hpet-ticks >= run.sr-until | fuel <= 0 then
      poke-32 (sel-row run id) 24 (if tick >= run.sr-window then 1 else 2)
    else let sample = sel-sample run id tick
    in let suppress = if sel-starve & selection-timer == 1 & selection-sabotage == 1 & id <= 2
      then poke-32 30048 0 0 else 0
    in act
      sent <- sel-send run id tick
      let mark = __heap-save
      in act
        yielded <- if selection-timer == 0 & (selection-sabotage == 0 | selection-case == 2)
          then process-yield else 0
        let restored = __heap-restore mark
        in sel-worker run id (fuel - 1)
      end
    end
  end

  sel-receiver : SelectionRun -> [Concurrent] Integer
  sel-receiver (run) = act
    value <- chan-kern-recv-block (run.sr-channel)
    let tick = poke-32 (run.sr-cells) 16 (sel-tick run)
    in let time = poke-32 (run.sr-cells) 20 (sel-us run)
    in poke-32 (run.sr-cells) 28 value
  end

  sel-gap : SelectionRun, Integer -> Integer
  sel-gap (run) (id) =
    let row = sel-row run id
    in let largest = peek-32 row 12
    in let tail = run.sr-window - peek-32 row 8
    in if tail > largest then tail else largest

  sel-served : SelectionRun, Integer, Integer -> Boolean
  sel-served (run) (id) (limit) =
    peek-32 (sel-row run id) 0 >= 2 & sel-gap run id <= limit

  sel-balanced : SelectionRun, Integer, Integer -> Boolean
  sel-balanced (run) (left) (right) =
    let a = peek-32 (sel-row run left) 20
    in let b = peek-32 (sel-row run right) 20
    in a > 0 & b > 0 & a <= b * 2 & b <= a * 2

  sel-report : SelectionRun, Integer, Integer -> [Console] Integer
  sel-report (run) (id) (count) = act
    if id > count then 0
    else let row = sel-row run id
    in act
      print-line-uni ("worker=" & show id & " samples=" & show (peek-32 row 0)
        & " first=" & show (peek-32 row 4) & " last=" & show (peek-32 row 8)
        & " max-gap=" & show (sel-gap run id) & " work=" & show (peek-32 row 20) & " stop=" & show (peek-32 row 24))
      sel-report run (id + 1) count
    end
  end

  opening : [Console, Concurrent, Capability, Device.Port] Nothing = act
    initialized <- runtime-init 0
    let seeded = sel-seed 0
    in let started = hpet-start
    in let rate = hpet-ticks-per-second
    in let cells = alloc-zeroed 192 64
    in let window = if sel-starve & selection-timer == 1 then (if selection-case == 5 then 2500 else 1250) else 80
    in let clock = hpet-ticks
    in act
      channel <- chan-kern-create 1
      let run = SelectionRun {
        sr-cells = cells,
        sr-tick = peek-32 28672 0,
        sr-clock = clock,
        sr-until = clock + rate * (if window > 1250 then 32 else if window > 80 then 16 else 3),
        sr-rate = rate,
        sr-window = window,
        sr-channel = channel
      }
      in let priority = if sel-starve | selection-case == 2 then 1 else 2
      in let count = if selection-case == 1 then 2 else if selection-case == 5 then 4 else 3
      in act
        p1 <- process-spawn-priority (\ignored ->
          if selection-case == 2 then sel-receiver run else sel-worker run 1 100000000) priority 0
        p2 <- process-spawn-priority (\ignored -> sel-worker run 2 100000000) (if sel-starve then 1 else 2) 0
        p3 <- if count >= 3 then process-spawn-priority (\ignored -> sel-worker run 3 100000000) (if sel-starve then 3 else 2) 0 else 0
        p4 <- if count >= 4 then process-spawn-priority (\ignored -> sel-worker run 4 100000000) 3 0 else 0
        let pids = p1 == 1 & p2 == 2 & (count < 3 | p3 == 3) & (count < 4 | p4 == 4)
        in act
          waited <- process-wait (if selection-case == 2 then p2 else p1)
          stopped1 <- process-kill p1
          stopped2 <- process-kill p2
          stopped3 <- if p3 > 0 then process-kill p3 else 0
          stopped4 <- if p4 > 0 then process-kill p4 else 0
          port-out-byte 33 255
          port-out-byte 161 255
          let complete = peek-32 (sel-row run (if selection-case == 2 then 2 else 1)) 24 == 1
          in let limit = if sel-starve & selection-timer == 1 then (if selection-case == 5 then 1206 else 606) else 12
          in let ready = peek-32 cells 4 == 3 & peek-32 cells 0 >= 1
          in let wake = ready & peek-32 cells 28 == 77
            & peek-32 cells 16 - peek-32 cells 8 <= 4
            & peek-32 cells 16 >= peek-32 cells 8
            & peek-32 cells 20 - peek-32 cells 12 <= 50000
            & peek-32 cells 20 >= peek-32 cells 12
          in let progress = if sel-starve then sel-served run 3 limit
            & (count < 4 | sel-served run 4 limit)
            else sel-served run 1 limit & sel-served run 2 limit
              & sel-balanced run 1 2
              & (count < 3 | (sel-served run 3 limit & sel-balanced run 1 3 & sel-balanced run 2 3))
          in let accepted = pids & complete & rate > 0 & (if selection-case == 2 then wake else progress)
          in if selection-verbose == 0 then print-line-uni ("timer rotation: " & show accepted)
          else act
            print-line-uni ("case=" & show selection-case & " timer=" & show selection-timer
              & " sabotage=" & show selection-sabotage & " window=" & show window)
            print-line-uni ("setup=" & show pids & " complete=" & show complete & " rate=" & show rate)
            report <- sel-report run 1 count
            print-line-uni ("wake-ready=" & show ready & " value=" & show (peek-32 cells 28)
              & " tick-gap=" & show (peek-32 cells 16 - peek-32 cells 8)
              & " us-gap=" & show (peek-32 cells 20 - peek-32 cells 12))
            print-line-uni ("accepted=" & show accepted)
            print-line-uni "scheduler-selection-end"
          end
        end
      end
    end
  end
