Chapter: BuildManifestTest
  cites Works chapter BuildManifest
  cites Works chapter DigestCompute
  cites Foreword chapter Console

  sweep-of : BuildManifest -> Text
  sweep-of (m) = show (m.sweep-pass) & "/" & show (m.sweep-fail) & "/" & show (m.sweep-skip) & "/" & show (m.sweep-total)

  opening : [Console] Nothing =
    let cdx = compute-digest "Codex.cdx" [1, 2, 3, 4]
    in let img = compute-digest "Codex.img" [97, 98, 99]
    in let src = compute-digest "Codex.codex" []
    in let m0 = create-manifest 51611 51600 cdx img src 4 "val" "2026-10-31"
    in let before = sweep-of m0
    in let m1 = manifest-set-sweep m0 7 2 1 10
    in act
      print-line-uni ("fresh sweep : " & before)
      print-line-uni ("set sweep   : " & sweep-of m1)
      print-line-uni ("original    : " & sweep-of m0)
      print-line-uni ("kept fields : " & show (m1.cl-number) & " " & show (m1.prior-cl) & " " & show (m1.fixed-point-size) & " " & m1.author & " " & m1.date)
      print-line-uni ("commit      : " & format-manifest-commit-message m1)
      print-line-uni ("readme row  : " & format-readme-digest-row "IMG" img)
      print-line-uni (format-manifest m1)
      print-line-uni "done"
    end

