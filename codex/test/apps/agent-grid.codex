Chapter: AgentGrid

Section: Configuration

  AgentConfig = record {
   name : Text,
   work-dir : Text,
   color : Text
  }

  agent-configs : List AgentConfig
  agent-configs = [
   AgentConfig { name = "blu", work-dir = "D:\\Projects\\NewRepository-blu", color = "#264F78" },
   AgentConfig { name = "fester", work-dir = "D:\\Projects\\NewRepository-fester", color = "#4B3621" },
