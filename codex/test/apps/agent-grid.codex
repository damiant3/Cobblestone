   AgentConfig { name = "val", work-dir = "D:\\Projects\\NewRepository-val", color = "#4A2545" }
  ]

  claude-model : Text
  claude-model = "claude-opus-4-6[1m]"

  make-launch-args : Text
  make-launch-args = "--dangerously-skip-permissions --model " & claude-model

  make-resume-args : Text
  make-resume-args = "--dangerously-skip-permissions --model " & claude-model & " -r"

