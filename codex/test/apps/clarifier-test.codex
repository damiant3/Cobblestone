Chapter: ClarifierTest
  cites Foreword chapter Console
  cites OS chapter Clarifier

Section: Helpers

  format-questions : List Text, Integer, Integer, Text -> Text
  format-questions (qs) (i) (n) (acc) =
    if i >= n then acc
    else let sep = if i == 0 then "" else "\n"
    in format-questions qs (i + 1) n (acc & sep & "  q" & show i & ": " & list-at qs i)

Section: Entry

  opening : [Console] Nothing =
    let s1 = SolidNode { label = "cat", description = "feline" }
    in let s2 = SolidNode { label = "mat", description = "floor cover" }
    in let s3 = SolidNode { label = "sat", description = "past tense of sit" }
    in let u1 = UnresolvedNode { kind = ReferentQuestion, label = "the thing", ambiguity = "object unresolved" }
    in let u2 = UnresolvedNode { kind = ReferentQuestion, label = "he", ambiguity = "person unresolved" }
    in let u3 = UnresolvedNode { kind = CardinalityQuestion, label = "always", ambiguity = "frequency unspecified" }
    in let u4 = UnresolvedNode { kind = ThresholdQuestion, label = "better", ambiguity = "baseline missing" }
    in let utt1 = Utterance { solid = [s1, s2, s3], unresolved = [u1, u2, u3, u4] }
    in let r1 = clarify utt1 Child
    in let l1 = "child: " & show (r1.solid-count) & " solid, " & show (r1.unresolved-count) & " unresolved"
    in let l2 = "  ask: " & r1.next-question
    in let r2 = clarify utt1 Formal
    in let l3 = "formal: " & r2.next-question
    in let pu1 = UnresolvedNode { kind = ReferentQuestion, label = "management", ambiguity = "which authority level" }
    in let pu2 = UnresolvedNode { kind = DomainQuestion, label = "some cases", ambiguity = "exception domain undeclared" }
    in let pu3 = UnresolvedNode { kind = CardinalityQuestion, label = "most employees", ambiguity = "threshold unspecified" }
    in let utt2 = Utterance { solid = [], unresolved = [pu1, pu2, pu3] }
    in let r3 = clarify utt2 Technical
    in let l4 = "policy: " & show (r3.unresolved-count) & " unresolved"
    in let l5 = "  ask: " & r3.next-question
    in let empty-utt = Utterance { solid = [s1], unresolved = [] }
    in let r4 = clarify empty-utt Child
    in let l6 = "resolved: " & show (r4.fully-resolved)
    in let child-qs = clarify-all-questions utt1 Child
    in let policy-qs = clarify-all-questions utt2 Formal
    in act
      print-line-uni l1
      print-line-uni l2
      print-line-uni l3
      print-line-uni l4
      print-line-uni l5
      print-line-uni l6
      print-line-uni ("child-q-count: " & show (list-length child-qs))
      print-line-uni (format-questions child-qs 0 (list-length child-qs) "")
      print-line-uni ("policy-q-count: " & show (list-length policy-qs))
      print-line-uni (format-questions policy-qs 0 (list-length policy-qs) "")
    end

