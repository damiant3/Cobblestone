Chapter: Lz4Hostile
  cites Compress chapter Lz4

Section: Helpers

  list-equal : List Integer, List Integer, Integer, Integer -> Boolean
  list-equal (a) (b) (i) (len) =
    if i >= len then True
    else if list-at a i == list-at b i then list-equal a b (i + 1) len
    else False

  check-rt : List Integer, Text -> Text
  check-rt (input) (label) =
    let compressed = lz4-compress input
    in let decompressed = lz4-decompress compressed
    in let ok = if list-length decompressed == list-length input then list-equal input decompressed 0 (list-length input) else False
    in label & "=" & if ok then "pass" else "fail"

  make-repeated : Integer, Integer, Integer, List Integer -> List Integer
  make-repeated (val) (n) (i) (acc) =
    if i >= n then acc
    else make-repeated val n (i + 1) (list-push acc val)

  show-decode : List Integer, Text -> Text
  show-decode (input) (label) =
    let out = lz4-decompress input
    in label & " len=" & show (list-length out) & " first=" & (if list-length out == 0 then "none" else show (list-at out 0))

 Rows 9 and 10 are the output-cap layer. Row 9 is a seeded single-byte mutation
 sweep over a stream this encoder wrote: every byte position is flipped in turn
 and decoded under a cap, and every decode must stop bounded. Row 10 decodes a
 stream under a cap far below its output and requires the cap to have limited it;
 one Lz4 match with a long extra-length run would otherwise replicate far more
 output than its input.

  mutate-copy : List Integer, Integer, Integer, Integer, Integer, List Integer -> List Integer
  mutate-copy (xs) (pos) (val) (i) (n) (acc) =
    if i >= n then acc
    else mutate-copy xs pos val (i + 1) n (list-push acc (if i == pos then bit-xor (list-at xs i) val else list-at xs i))

  sweep-mut : List Integer, Integer, Integer, Integer, Integer -> Integer
  sweep-mut (base) (n) (pos) (cap) (bad) =
    if pos >= n then bad
    else let m = mutate-copy base pos (1 + (pos * 37 - (pos * 37 / 255) * 255)) 0 n []
    in let d = lz4-decompress-capped m cap
    in let ok = list-length d < 100000
    in sweep-mut base n (pos + 1) cap (if ok then bad else bad + 1)

  show-sweep : List Integer, Text -> Text
  show-sweep (base) (label) =
    label & " all-bounded=" & (if sweep-mut base (list-length base) 0 2000 0 == 0 then "True" else "False")

  show-cap : List Integer, Integer, Text -> Text
  show-cap (input) (cap) (label) =
    label & " capped=" & (if list-length (lz4-decompress-capped input cap) < list-length (lz4-decompress input) then "True" else "False")

Section: Hostile Streams

 Row 5. Token F0 asks for a 15+ byte literal run and the extra-length byte
 says 20, so the run is 35 bytes long against a 2-byte stream.

  lit-past-end : List Integer = [240, 20]

 Row 6. The offset is a two-byte field.

  offset-straddles-end : List Integer = [16, 65, 0]

 Row 7. A back-reference with offset 0.

  offset-zero : List Integer = [16, 65, 0, 0]

 Row 8. A back-reference reaching 5 bytes behind a 1-byte output.

  offset-before-start : List Integer = [16, 65, 5, 0]

Section: Body

  opening : [Console] Nothing = act
    print-line-uni (check-rt [] "1-empty")
    print-line-uni (check-rt [1, 2, 3] "2-tiny")
    print-line-uni (check-rt [65, 66, 67, 68, 65, 66, 67, 68, 65, 66, 67, 68] "3-repeating")
    print-line-uni (check-rt (make-repeated 42 100 0 []) "4-uniform-100")
    print-line-uni (show-decode lit-past-end "5-lit-past-end")
    print-line-uni (show-decode offset-straddles-end "6-offset-straddles-end")
    print-line-uni (show-decode offset-zero "7-offset-zero")
    print-line-uni (show-decode offset-before-start "8-offset-before-start")
    print-line-uni (show-sweep (lz4-compress (make-repeated 42 100 0 [])) "9-mutation-sweep")
    print-line-uni (show-cap (lz4-compress (make-repeated 42 2000 0 [])) 50 "10-output-cap")
  end

