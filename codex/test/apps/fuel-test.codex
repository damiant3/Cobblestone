Chapter: FuelTest
  cites Foreword chapter Fuel

Section: Helpers
  show-fuel : FuelResult Integer -> Text
  show-fuel (r) = when r
    is FuelOk (v) -> "ok:" & show v
    is FuelExhausted -> "exhausted"

Section: Tests
  opening : [Console] Nothing = act
    print-line-uni (show-fuel (fuel-check 5) & " " & show-fuel (fuel-check 0) & " " & show-fuel (fuel-check 1))
  end
