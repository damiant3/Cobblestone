=== lens dashboard test: query results to one html page ===
<!DOCTYPE html>
<html>
<head>
<title>Sales Overview</title>
<style>
body{font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;margin:24px;background:#f7f7f5;color:#222222}
h1{font-size:22px}
.lens-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(660px,1fr));gap:16px}
.lens-tile{background:#ffffff;border:1px solid #dddddd;border-radius:8px;padding:12px 16px}
.lens-tile h2{font-size:16px;margin:0 0 8px 0}
.lens-tile svg{max-width:100%;height:auto}
.lens-error{color:#b00020;background:#fdecea;padding:8px;border-radius:4px}
.lens-empty{color:#777777}
.lens-legend{display:flex;gap:16px;font-size:13px}
.lens-key{display:inline-flex;align-items:center;gap:6px}
.lens-chip{display:inline-block;width:12px;height:12px;border-radius:2px}
.lens-table{border-collapse:collapse;font-size:14px}
.lens-table th,.lens-table td{border:1px solid #dddddd;padding:4px 10px;text-align:left}
.lens-table th{background:#f0f0ee}
</style>
</head>
<body>
<h1>Sales Overview</h1>
<main class="lens-grid">
<section class="lens-tile">
<h2>Revenue by City</h2>
<svg viewBox="0 0 640 320" width="640" height="320">
<line x1="60" y1="280" x2="620" y2="280" stroke="#dddddd"/>
<text x="54" y="284" text-anchor="end" font-size="12" fill="#444444">0</text>
<line x1="60" y1="215" x2="620" y2="215" stroke="#dddddd"/>
<text x="54" y="219" text-anchor="end" font-size="12" fill="#444444">5000</text>
<line x1="60" y1="150" x2="620" y2="150" stroke="#dddddd"/>
<text x="54" y="154" text-anchor="end" font-size="12" fill="#444444">10000</text>
<line x1="60" y1="85" x2="620" y2="85" stroke="#dddddd"/>
<text x="54" y="89" text-anchor="end" font-size="12" fill="#444444">15000</text>
<line x1="60" y1="20" x2="620" y2="20" stroke="#dddddd"/>
<text x="54" y="24" text-anchor="end" font-size="12" fill="#444444">20000</text>
<line x1="60" y1="20" x2="60" y2="280" stroke="#333333"/>
<line x1="60" y1="280" x2="620" y2="280" stroke="#333333"/>
<rect x="97" y="186" width="111" height="94" fill="#4e79a7"/>
<text x="152" y="180" text-anchor="middle" font-size="12" fill="#444444">7300</text>
<text x="152" y="296" text-anchor="middle" font-size="12" fill="#444444">Shelbyville</text>
<rect x="283" y="71" width="111" height="209" fill="#4e79a7"/>
<text x="338" y="65" text-anchor="middle" font-size="12" fill="#444444">16100</text>
<text x="338" y="296" text-anchor="middle" font-size="12" fill="#444444">Springfield</text>
<rect x="469" y="196" width="111" height="84" fill="#4e79a7"/>
<text x="524" y="190" text-anchor="middle" font-size="12" fill="#444444">6500</text>
<text x="524" y="296" text-anchor="middle" font-size="12" fill="#444444">Capital City</text>
</svg>
</section>
<section class="lens-tile">
<h2>Credit &lt;b&gt;&amp; Revenue by City</h2>
<svg viewBox="0 0 640 320" width="640" height="320">
<line x1="60" y1="280" x2="620" y2="280" stroke="#dddddd"/>
<text x="54" y="284" text-anchor="end" font-size="12" fill="#444444">0</text>
<line x1="60" y1="215" x2="620" y2="215" stroke="#dddddd"/>
<text x="54" y="219" text-anchor="end" font-size="12" fill="#444444">20000</text>
<line x1="60" y1="150" x2="620" y2="150" stroke="#dddddd"/>
<text x="54" y="154" text-anchor="end" font-size="12" fill="#444444">40000</text>
<line x1="60" y1="85" x2="620" y2="85" stroke="#dddddd"/>
<text x="54" y="89" text-anchor="end" font-size="12" fill="#444444">60000</text>
<line x1="60" y1="20" x2="620" y2="20" stroke="#dddddd"/>
<text x="54" y="24" text-anchor="end" font-size="12" fill="#444444">80000</text>
<line x1="60" y1="20" x2="60" y2="280" stroke="#333333"/>
<line x1="60" y1="280" x2="620" y2="280" stroke="#333333"/>
<rect x="97" y="215" width="111" height="65" fill="#4e79a7"/>
<rect x="97" y="192" width="111" height="23" fill="#f28e2b"/>
<text x="152" y="296" text-anchor="middle" font-size="12" fill="#444444">Shelbyville</text>
<rect x="283" y="150" width="111" height="130" fill="#4e79a7"/>
<rect x="283" y="98" width="111" height="52" fill="#f28e2b"/>
<text x="338" y="296" text-anchor="middle" font-size="12" fill="#444444">Springfield</text>
<rect x="469" y="150" width="111" height="130" fill="#4e79a7"/>
<rect x="469" y="129" width="111" height="21" fill="#f28e2b"/>
<text x="524" y="296" text-anchor="middle" font-size="12" fill="#444444">Capital City</text>
</svg>
<div class="lens-legend"><span class="lens-key"><span class="lens-chip" style="background:#4e79a7"></span>total-credit</span><span class="lens-key"><span class="lens-chip" style="background:#f28e2b"></span>revenue</span></div>
</section>
<section class="lens-tile">
<h2>Credit and Revenue by User</h2>
<table class="lens-table">
<tr><th>city</th><th>uname</th><th>total-credit</th><th>revenue</th></tr>
<tr><td>Shelbyville</td><td>Bob</td><td>20000</td><td>7300</td></tr>
<tr><td>Springfield</td><td>Alice</td><td>10000</td><td>8800</td></tr>
<tr><td>Springfield</td><td>Carol</td><td>30000</td><td>7300</td></tr>
<tr><td>Capital City</td><td>Dave</td><td>40000</td><td>6500</td></tr>
</table>
</section>
<section class="lens-tile">
<h2>Profit by City</h2>
<p class="lens-error">lens-plan: diag 22: unknown measure profit</p>
</section>
</main>
</body>
</html>
-- assertions
y-axis step for max 16100: 5000
y-axis step for max 56100: 20000
springfield bar height 16100*260/20000: 209
springfield bar rect pinned: True
springfield stacked revenue segment pinned: True
top gridline label 20000 pinned: True
escaped tile title present: True
raw markup from title absent: True
failed tile renders its diag: True
svg open of close: 2 of 2
section open of close: 4 of 4
table open of close: 1 of 1
tr open of close: 5 of 5
rect count: 9
external references absent: True
lens-dashboard-test: done
