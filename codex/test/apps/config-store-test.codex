Chapter: ConfigStoreTest
  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Observe chapter ConfigStore

Section: Entry

  opening : [Console] Nothing =
    let s0 = config-empty
    in let l1 = "count=" & show (config-count s0) & " has-x=" & show (config-has s0 "x")
    in let s1 = config-set-text s0 "host" "codex-node-1"
    in let s2 = config-set-int s1 "port" 8080
    in let s3 = config-set-bool s2 "debug" True
    in let l2 = "host=" & config-get-text s3 "host" "" & " port=" & show (config-get-int s3 "port" 0) & " debug=" & show (config-get-bool s3 "debug" False) & " count=" & show (config-count s3)
    in let l3 = "text=" & config-get-text s3 "missing" "fallback" & " int=" & show (config-get-int s3 "nope" 42) & " bool=" & show (config-get-bool s3 "nope" True)
    in let s4 = config-set-int config-empty "val" 20
    in let l4 = "val=" & show (config-get-int s4 "val" 0) & " count=" & show (config-count s4)
    in let s5 = config-set-int s4 "as-int" 99
    in let s6 = config-set-text s5 "as-text" "hello"
    in let l5 = "as-int=" & show (config-get-int s6 "as-int" 0) & " as-text=" & config-get-text s6 "as-text" ""
    in let s7 = config-remove s6 "val"
    in let s8 = config-remove s7 "as-int"
    in let l6 = "count=" & show (config-count s8) & " has-a=" & show (config-has s8 "as-int") & " has-b=" & show (config-has s8 "as-text")
    in let v1 = config-get s8 "as-text"
    in let v2-store = config-set-int config-empty "n" 42
    in let v2 = config-get v2-store "n"
    in let v3-store = config-set-bool config-empty "b" False
    in let v3 = config-get v3-store "b"
    in let fmt1 = when v1 is Just (v) -> format-config-value v is None -> "none"
    in let fmt2 = when v2 is Just (v) -> format-config-value v is None -> "none"
    in let fmt3 = when v3 is Just (v) -> format-config-value v is None -> "none"
    in let l7 = fmt1 & " " & fmt2 & " " & fmt3
    in act
      print-line-uni l1
      print-line-uni l2
      print-line-uni l3
      print-line-uni l4
      print-line-uni l5
      print-line-uni l6
      print-line-uni l7
    end

