Chapter: AccpMathTest
  cites Accp chapter AccpMath
  cites Foreword chapter Console

Section: Fixtures

  square : Real -> Real
  square (x) = x * x

  two-less : Real -> Real
  two-less (x) = x * x - 2.0

  growth : Real, Real -> Real
  growth (t) (y) = y

Section: Entry

  row : Text, MathResult -> [Console] Nothing
  row (label) (r) = print-line-uni (label & " " & math-format r)

  opening : [Console] Nothing = act
    row "sqrt 2" (math-sqrt 2.0)
    row "sqrt -1" (math-sqrt (0.0 - 1.0))
    row "pow 2 10" (math-pow 2.0 10)
    row "pow 2 -2" (math-pow 2.0 (0 - 2))
    row "exp 1" (math-exp 1.0)
    row "log e" (math-log 2.718281828459045)
    row "log 0" (math-log 0.0)
    row "sin pi/2" (math-sin (math-pi / 2.0))
    row "cos 0" (math-cos 0.0)
    row "atan2 1 1" (math-atan2 1.0 1.0)
    row "d/dx x^2 at 3" (math-derivative square 3.0 0.001)
    row "int x^2 0..1" (math-integral square 0.0 1.0 100)
    row "root x^2-2" (math-root two-less 0.0 2.0 0.000000001 200)
    row "root no sign change" (math-root square 1.0 2.0 0.000000001 200)
    row "ode y'=y 0..1" (math-ode growth 0.0 1.0 1.0 100)
  end
