Chapter: BlackHoleSimdTest
  cites Globe chapter BlackHoleSimd
  cites Foreword chapter Console

Section: Helpers

  milli : Real -> Integer
  milli (x) = real-to-int (x * 1000.0)

  lit : List Integer, Integer, Integer, Integer -> Integer
  lit (xs) (i) (n) (acc) =
    if i >= n then acc
    else lit xs (i + 1) n (if list-at xs i /= 0 then acc + 1 else acc)

  sum-list : List Integer, Integer, Integer, Integer -> Integer
  sum-list (xs) (i) (n) (acc) =
    if i >= n then acc
    else sum-list xs (i + 1) n (acc + list-at xs i)

Section: Entry

  opening : [Console] Nothing
  opening = act
    let a = v4f-xyz 1.0 2.0 3.0
    in let b = v4f-xyz 4.0 5.0 6.0
    in let c = v4f-cross (v4f-xyz 1.0 0.0 0.0) (v4f-xyz 0.0 1.0 0.0)
    in let frame = bh-render-frame-s 16 9 bh-camera-default 0.0
    in act
      print-line-uni ("dot: " & show (milli (v4f-dot a b)))
      print-line-uni ("cross: " & show (milli (v4f-x c)) & " " & show (milli (v4f-y c)) & " " & show (milli (v4f-z c)))
      print-line-uni ("length: " & show (milli (v4f-length (v4f-xyz 3.0 4.0 0.0))))
      print-line-uni ("frame values: " & show (list-length frame))
      print-line-uni ("frame lit: " & show (lit frame 0 (list-length frame) 0))
      print-line-uni ("frame sum: " & show (sum-list frame 0 (list-length frame) 0))
    end
  end

