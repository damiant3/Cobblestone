Chapter: IrProbeTest

Section: Helpers
  sum-list : List Integer, Integer, Integer, Integer -> Integer
  sum-list (xs) (i) (len) (acc) =
    if i >= len then acc
    else sum-list xs (i + 1) len (acc + list-at xs i)

Section: Tests
  opening : [Console] Nothing = act
    let vals = [1, 2, 3, 4, 5, 6, 10]
    in let s = sum-list vals 0 (list-length vals) 0
    in print-line-uni ("hello Codex sum=" & show s)
  end
