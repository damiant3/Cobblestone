Chapter: SignalBusTest
  cites Sched chapter SignalBus
  cites Foreword chapter Maybe

Section: Helpers
  show-peek : Maybe SignalEntry -> Text
  show-peek (m) = when m
    is Just (e) -> format-signal (e.signal)
    is None -> "none"

Section: Tests
  test-empty : Text =
    let q = signal-queue-empty
    in signal-queue-stats q

  test-send-peek-consume : Text =
    let q0 = signal-queue-empty
    in let q1 = signal-send q0 1 5 SigTerm 100
    in let q2 = signal-send q1 2 7 SigHup 200
    in let peek5 = signal-peek q2 5
    in let peek9 = signal-peek q2 9
    in let q3 = signal-consume q2 5
    in "pending=" & show (signal-pending-count q2) & " peek5=" & show-peek peek5 & " peek9=" & show-peek peek9 & " after-consume=" & show (signal-pending-count q3) & " delivered=" & show (signal-delivered-count q3)

  test-broadcast : Text =
    let q0 = signal-queue-empty
    in let q1 = signal-broadcast q0 [2, 5, 7, 3] SigKill 1 300
    in "pending=" & show (signal-pending-count q1) & " for-2=" & show (signal-pending-for q1 2) & " for-9=" & show (signal-pending-for q1 9)

  test-format-entry : Text =
    let e = SignalEntry { target-pid = 1, signal = SigChild 5, from-pid = 5, timestamp = 400 }
    in format-signal-entry e

  test-multi-pending : Text =
    let q0 = signal-queue-empty
    in let q1 = signal-send q0 1 7 SigUsr1 100
    in let q2 = signal-send q1 2 7 SigUsr2 200
    in let q3 = signal-send q2 3 7 (SigAlarm 60) 300
    in "for-7=" & show (signal-pending-for q3 7)

  test-consume-order : Text =
    let q0 = signal-queue-empty
    in let q1 = signal-send q0 1 3 SigUsr1 100
    in let q2 = signal-send q1 2 3 SigUsr2 200
    in let q3 = signal-consume q2 3
    in let next = signal-peek q3 3
    in "remaining=" & show (signal-pending-count q3) & " next=" & show-peek next

  opening : [Console] Nothing = act
    print-line-uni test-empty
    print-line-uni test-send-peek-consume
    print-line-uni test-broadcast
    print-line-uni test-format-entry
    print-line-uni test-multi-pending
    print-line-uni test-consume-order
  end
