Chapter: EditReuseTest
  cites Works chapter GopDesk
  cites Works chapter GopEdit
  cites Works chapter GopFiles
  cites Works chapter GopFat16
  cites Foreword chapter Fat16
  cites Foreword chapter Console

 A buried Editor's dead span is a hole the next Editor fits, which is the
 stranding item's acceptance for this pane. Each arm opens Edit on a fresh
 mark the way `desk-edit-open` does when no hole exists, pushes a second
 pane's mark above it, kills the Editor's entry and asks for `desk-edit-want`.

 THE CONTROL is the same sequence without `desk-hole-pad`: the span is then
 only what the open allocated, less than the want, and no span is picked. An
 arm whose padded line passes and whose control also passes is one that can
 see the difference the pad makes.

Section: Body

  er-yn : Boolean -> Text
  er-yn (v) = if v then "PASS" else "FAIL"

Section: Main

  opening : [Console, Device.Port] Nothing =
    let msa = alloc-zeroed 128 64
    in let msb = alloc-zeroed 128 64
    in let esa = alloc-zeroed 192 16
    in let esb = alloc-zeroed 192 16
    in let g0 = __heap-save
    in act
    start <- gpt-esp-start
    let r = __heap-restore g0
    in let a0 = __heap-save
    in let pa = desk-marks-push msa desk-focus-edit a0
    in act
    sta <- ged-build start esa
    let fill = desk-hole-pad a0 desk-edit-want
    in let fa = desk-marks-push msa desk-focus-files __heap-save
    in let ka = desk-marks-kill msa desk-focus-edit
    in let pick-a = desk-span-pick msa __heap-save 0 desk-edit-want 0
    in let ext-a = desk-marks-extent msa 0 __heap-save
    in let b0 = __heap-save
    in let pb = desk-marks-push msb desk-focus-edit b0
    in act
    stb <- ged-build start esb
    let fb = desk-marks-push msb desk-focus-files __heap-save
    in let kb = desk-marks-kill msb desk-focus-edit
    in let pick-b = desk-span-pick msb __heap-save 0 desk-edit-want 0
    in let ext-b = desk-marks-extent msb 0 __heap-save
    in act
    print-line-uni ("padded: the buried Editor's span is " & show ext-a & ", want " & show desk-edit-want & ", picked " & show pick-a & ": " & er-yn (pick-a == 0 & ext-a >= desk-edit-want))
    print-line-uni ("CONTROL, unpadded: the span is " & show ext-b & ", picked " & show pick-b & ": " & er-yn (pick-b < 0 & ext-b < desk-edit-want))
    print-line-uni ("both opens listed the root: " & er-yn (sta.ed-mode == ged-mode-list & stb.ed-mode == ged-mode-list))
    end
    end
    end
    end