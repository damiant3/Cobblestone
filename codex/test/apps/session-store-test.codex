Chapter: SessionStoreTest
  cites Trust chapter SessionStore
  cites Foreword chapter Maybe
  cites Foreword chapter Hamt

Section: Helpers
  show-maybe-text : Maybe Text -> Text
  show-maybe-text (m) = when m
    is Just (t) -> t
    is None -> "none"

Section: Tests
  test-empty : Text =
    session-store-stats session-store-empty

  test-create : Text =
    let s0 = session-store-empty
    in let s1 = session-create s0 "sess-001" "alice" 1000 300
    in let found = session-get s1 "sess-001" 1000
    in when found
      is Just (sess) -> format-session sess
      is None -> "not found"

  test-expired : Text =
    let s0 = session-create session-store-empty "sess-001" "alice" 1000 300
    in let found = session-get s0 "sess-001" 1500
    in when found
      is Just (sess) -> format-session sess
      is None -> "expired"

  test-data : Text =
    let s0 = session-create session-store-empty "sess-001" "alice" 1000 300
    in let s1 = session-set-data s0 "sess-001" "role" "admin"
    in let s2 = session-set-data s1 "sess-001" "theme" "dark"
    in let role = session-get-data s2 "sess-001" "role" 1000
    in let theme = session-get-data s2 "sess-001" "theme" 1000
    in let missing = session-get-data s2 "sess-001" "nope" 1000
    in "role=" & show-maybe-text role & " theme=" & show-maybe-text theme & " missing=" & show-maybe-text missing

  test-destroy : Text =
    let s0 = session-create session-store-empty "sess-001" "alice" 1000 300
    in let s1 = session-destroy s0 "sess-001"
    in let found = session-get s1 "sess-001" 1000
    in let label = when found
      is Just (sess) -> "found"
      is None -> "gone"
    in "count=" & show (session-count s1) & " get=" & label

  test-multiple : Text =
    let s0 = session-store-empty
    in let s1 = session-create s0 "a" "alice" 100 500
    in let s2 = session-create s1 "b" "bob" 200 500
    in let s3 = session-create s2 "c" "carol" 300 500
    in "count=" & show (session-count s3)

  opening : [Console] Nothing = act
    print-line-uni test-empty
    print-line-uni test-create
    print-line-uni test-expired
    print-line-uni test-data
    print-line-uni test-destroy
    print-line-uni test-multiple
  end
