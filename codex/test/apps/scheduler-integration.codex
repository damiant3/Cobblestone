Chapter: SchedulerIntegration

Section: Body
  opening : [Concurrent] Integer = act
    p1 <- process-spawn (\x -> poke-byte 28000 0 10)
    p2 <- process-spawn (\x -> poke-byte 28008 0 20)
    p3 <- process-spawn (\x -> poke-byte 28016 0 30)
    let w1 = process-wait p1
    in let w2 = process-wait p2
    in let w3 = process-wait p3
    in let v1 = peek-byte 28000 0
    in let v2 = peek-byte 28008 0
    in let v3 = peek-byte 28016 0
    in v1 + v2 + v3
  end
