Chapter: CdxNameCost
  cites Verify chapter CdxVerifier
  cites Verify chapter CdxBinary
  cites Foreword chapter Console

 We say:

Section: Fixtures

  bytes-of : Integer -> List Integer
  bytes-of (n) = fill n 0 (__list-with-capacity (n + 1))

  fill : Integer, Integer, List Integer -> List Integer
  fill (n) (i) (acc) =
    if i >= n then acc
    else fill n (i + 1) (list-push acc 15)

Section: Measurement

  cap-retained : List Integer -> Integer
  cap-retained (bs) =
    let b = __heap-save
    in let len = text-length (bytes-to-cap-text bs 0 (list-length bs))
    in let a = __heap-save
    in (a - b) + len - len

  scope-retained : List Integer -> Integer
  scope-retained (bs) =
    let b = __heap-save
    in let len = text-length (verify-bytes-to-text bs 0 (list-length bs))
    in let a = __heap-save
    in (a - b) + len - len

  verdict : Integer, Integer -> Text
  verdict (at-n) (at-4n) =
    if at-n <= 0 then "unmeasured"
    else if at-4n < at-n * 8 then "linear" else "quadratic"

Section: Entry

  opening : [Console] Nothing = act
    let small = bytes-of 1024
    in let large = bytes-of 4096
    in let widest = bytes-of 65535
    in act
      print-line-uni ("cap=" & bytes-to-cap-text [0, 15, 13, 15, 0] 1 3 & " scope=" & verify-bytes-to-text [15, 13] 0 2)
      print-line-uni ("cap-growth=" & verdict (cap-retained small) (cap-retained large))
      print-line-uni ("scope-growth=" & verdict (scope-retained small) (scope-retained large))
      print-line-uni ("widest-cap=" & show (text-length (bytes-to-cap-text widest 0 65535)) & " widest-scope=" & show (text-length (verify-bytes-to-text widest 0 65535)))
    end
  end
