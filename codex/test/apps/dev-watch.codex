Chapter: DevWatchTest
  cites Dev chapter DevState

 THE BUFFER IS ZEROED FIRST AND THAT IS NOT CEREMONY. `alloc-bytes` does
 not zero what it returns; it hands back the heap pointer and bumps it, so
 a fresh buffer holds whatever the last allocation left. The checksums
 would still be self-consistent, but the test would be reading residue,
 and a case that pokes a byte which happened to already hold that value
 would report unchanged for a reason nobody could see.

 We say:

Section: Fixtures

  buf-len : Integer = 64

  zero-fill : Integer, Integer, Integer -> Integer
  zero-fill (buf) (i) (n) =
   if i >= n then 0
   else let w = poke-byte buf i 0
   in zero-fill buf (i + 1) n

Section: Reporting

  say-add : Text, WatchAdd -> [Console] Nothing
  say-add (label) (r) = act
    print-line-uni (label & ": ok=" & show (r.wa-ok) & " " & r.wa-message)
  end

 A successful `wa-message` carries the absolute heap address (6291456 on bare
 metal, other values elsewhere), so grading that text pins this oracle to one
 backend. Do not put it back.

  say-add-ok : Text, WatchAdd -> [Console] Nothing
  say-add-ok (label) (r) = act
    print-line-uni (label & ": ok=" & show (r.wa-ok))
  end

  say-check : Text, WatchCheck -> [Console] Nothing
  say-check (label) (c) = act
    print-line-uni (label & ": changed=" & show (c.wc-changed) & " [" & c.wc-report & "]")
  end

Section: Filling The Table

  fill-watches : DevState, Integer, Integer, Integer -> DevState
  fill-watches (st) (addr) (i) (n) =
   if i >= n then st
   else let r = dev-watch-add st ("w" & show i) addr 4
   in fill-watches (r.wa-state) addr (i + 1) n

Section: Body

  opening : [Console] Nothing = act
    let a = alloc-bytes buf-len
    in let za = zero-fill a 0 buf-len
    in let b = alloc-bytes buf-len
    in let zb = zero-fill b 0 buf-len

    in let s0 = dev-state-new
    in act
      print-line-uni ("empty: " & show (dev-watch-count s0))
      say-check "check-empty" (dev-watch-check s0)

      let r1 = dev-watch-add s0 "alpha" a 16
      in act
        say-add-ok "add-alpha" r1

        let r2 = dev-watch-add (r1.wa-state) "beta" b 16
        in act
          say-add-ok "add-beta" r2
          print-line-uni ("beta-minus-alpha: " & show (b - a))
          print-line-uni ("count: " & show (dev-watch-count (r2.wa-state)))
          print-line-uni ("origin-untouched: " & show (dev-watch-count s0))

          let c1 = dev-watch-check (r2.wa-state)
          in act
            say-check "before-any-poke" c1

            let p = poke-byte a 3 77
            in let c2 = dev-watch-check (c1.wc-state)
            in act
              say-check "after-poke-alpha" c2
              say-check "again-no-poke" (dev-watch-check (c2.wc-state))
            end
          end
        end
      end

      say-add "too-long" (dev-watch-add s0 "big" a 70000)
      say-add "zero-len" (dev-watch-add s0 "empty" a 0)

      let full = fill-watches s0 a 0 32
      in act
        print-line-uni ("filled: " & show (dev-watch-count full))
        say-add "thirty-third" (dev-watch-add full "over" a 4)
        print-line-uni ("cleared: " & show (dev-watch-count (dev-watch-clear full)))
        print-line-uni ("full-after-clear: " & show (dev-watch-count full))
      end
    end
  end
