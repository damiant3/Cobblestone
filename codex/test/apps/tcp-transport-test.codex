Chapter: TcpTransportTest
  cites Net chapter TcpTransport
  cites Net chapter NetworkStack
  cites Net chapter Tcp
  cites Net chapter Ethernet
  cites Net chapter MessageFraming
  cites Foreword chapter Sha256

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Body
  opening : [Console] Nothing =
    let sess = net-session-new [0, 0, 0, 0, 0, 1] [10, 0, 0, 1] [10, 0, 0, 254] 5000 80 [10, 0, 0, 2] 1000
    in let ts = transport-new sess
    in let sr = transport-send-message ts 1 [72, 101, 108, 108, 111, 32, 87, 111, 114, 108]
    in let ts1 = sr.transport
    in let framed = frame-encode 2 [79, 75]
    in let ts2 = transport-feed-data ts1 framed
    in let rr = transport-try-recv ts2
    in act
      print-line-uni ("send: sent 10 bytes ok=" & show-bool (sr.success))
      print-line-uni ("recv: has=" & show-bool (rr.has-message) & " tag=" & show (rr.tag))
      print-line-uni ("body=" & show (list-length (rr.body)) & " " & show (list-at (rr.body) 0) & " " & show (list-at (rr.body) 1))
      print-line-uni (transport-stats (rr.transport))
    end

