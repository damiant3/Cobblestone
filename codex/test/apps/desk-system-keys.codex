Chapter: DeskSystemKeysTest
  cites Works chapter GopHid
  cites Works chapter GopDeskKeys
  cites Foreword chapter Console

  sk-chord : Integer, Integer -> Boolean
  sk-chord (s) (tick) =
    let release = dkey-step s 211 tick
    in dkey-step s 83 tick

  sk-arm : Integer -> Integer
  sk-arm (s) =
    let z = __memset s 0 40
    in let c = dkey-step s 29 0
    in let a = dkey-step s 56 0
    in 0

  opening : [Console] Nothing =
    let prev = alloc-bytes 8
    in let cur = alloc-bytes 8
    in let s = alloc-bytes 40
    in let z0 = __memset prev 0 8
    in let z1 = __memset cur 0 8
    in let left = poke-byte cur 0 8
    in let lm = hid-step prev cur
    in let hold = hid-step prev cur
    in let up = poke-byte cur 0 0
    in let lb = hid-step prev cur
    in let right = poke-byte cur 0 128
    in let rm = hid-step prev cur
    in let ru = poke-byte cur 0 0
    in let rb = hid-step prev cur
    in let del = poke-byte cur 2 76
    in let dm = hid-step prev cur
    in let du = poke-byte cur 2 0
    in let db = hid-step prev cur
    in let arm = sk-arm s
    in let first = sk-chord s 10
    in let held = dkey-step s 83 11
    in let second = sk-chord s 20
    in let third = sk-chord s 30
    in let again = dkey-step s 83 31
    in let arm2 = sk-arm s
    in let t1 = sk-chord s 10
    in let t2 = sk-chord s 20
    in let late = sk-chord s 521
    in let arm3 = sk-arm s
    in let k1 = sk-chord s 10
    in let k2 = sk-chord s 20
    in let other = dkey-step s 30 21
    in let interrupted = sk-chord s 22
    in let arm4 = sk-arm s
    in let release = dkey-step s 157 1
    in let noctrl1 = sk-chord s 10
    in let noctrl2 = sk-chord s 20
    in let noctrl3 = sk-chord s 30
    in let arm5 = sk-arm s
    in let another = dkey-step s 29 1
    in let one-up = dkey-step s 157 2
    in let both1 = sk-chord s 10
    in let both2 = sk-chord s 20
    in let both3 = sk-chord s 30
    in act
      print-line-uni ("GUI make/break: " & show (lm == 91 & lb == 219 & rm == 92 & rb == 220 & hold == 0 & dkey-menu lm & dkey-menu rm & dkey-menu lb == False))
      print-line-uni ("Delete and navigation usages: " & show (dm == 83 & db == 211 & hid-nav-sc 73 == 82 & hid-nav-sc 74 == 71 & hid-nav-sc 75 == 73 & hid-nav-sc 77 == 79 & hid-nav-sc 78 == 81))
      print-line-uni ("three edges only: " & show (first == False & held == False & second == False & third & again == False))
      print-line-uni ("timeout resets sequence: " & show (late == False & t1 == False & t2 == False))
      print-line-uni ("other key resets sequence: " & show (interrupted == False & other == False & k1 == False & k2 == False))
      print-line-uni ("missing modifier refuses: " & show (noctrl1 == False & noctrl2 == False & noctrl3 == False))
      print-line-uni ("second control remains held: " & show (both1 == False & both2 == False & both3))
    end
