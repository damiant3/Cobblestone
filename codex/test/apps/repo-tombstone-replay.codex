Chapter: RepoTombstoneReplay
  cites Works chapter RepoProtocolPersist
  cites Works chapter KeyManager
  cites Foreword chapter ImportGate
  cites Foreword chapter FactStore
  cites Foreword chapter Maybe
  cites Foreword chapter Sha256
  cites Kernel chapter DiskFacts
  cites Kernel chapter AppPersist
  cites Foreword chapter Console

 Replay, defeated. Every assertion here is validly signed by the owner -- the
 attack is not forgery, it is copying an old signature forward in the log to
 override a newer one. a.codex is retired at t2 and re-added at t3; the old t2
 tombstone is then replayed at the end of the log, and must NOT retire the
 re-added file, because t2 is older than t3. b.codex is retired at t2; its
 original t1 definition is then replayed at the end of the log, and must NOT
 resurrect it, because t1 is older than t2. The verified index resolves each
 path by the signed timestamp, so neither replay lands. A genuinely newer
 tombstone (t9) still retires a.codex, so removal itself is not broken.

Section: Helpers

  owner : Keypair
  owner = generate-keypair (sha256 (text-to-bytes "tombstone-replay-owner"))

  def-of : Text, Text -> SourceDefinition
  def-of (path) (body) =
    SourceDefinition {
      sd-hash = "", sd-path = path, sd-quire = "Q", sd-chapter = "C",
      sd-signer = "", sd-signature = [], sd-author = "", sd-timestamp = 0,
      sd-content = body
    }

  save : DiskFactStore, Text, Text, Integer -> DiskFactStore
  save (s) (p) (b) (t) = repo-persist-save-definition s (sign-definition owner (def-of p b) t) t

  write-raw : DiskFactStore, Integer, Text, Integer -> DiskFactStore
  write-raw (s) (kind) (txt) (t) = app-write-and-checkpoint s kind txt t

Section: Entry

  opening : [Device.Block, Console.Write] Nothing = act
    let manifest = manifest-add manifest-empty (owner.fingerprint) (owner.public-key) 10000
    in let tomb-a2 = tombstone-to-text (sign-tombstone owner "a.codex" 2)
    in let def-b1 = source-def-to-text (sign-definition owner (def-of "b.codex" "B1") 1)
    in let s0 = disk-init
    in let s1 = save s0 "a.codex" "A1" 1
    in let s2 = save s1 "b.codex" "B1" 1
    in let s3 = write-raw s2 persist-kind-tombstone tomb-a2 2
    in let s4 = repo-persist-save-tombstone-signed s3 owner "b.codex" 2
    in let s5 = save s4 "a.codex" "A3" 3
    in let s6 = write-raw s5 persist-kind-tombstone tomb-a2 2
    in let s7 = write-raw s6 persist-kind-definition def-b1 1
    in let v1 = repo-index-verified s7 manifest 5000
    in let a-after = when work-current v1 "a.codex" is Just (d) -> d.sd-content is None -> "GONE"
    in let b-after = when work-current v1 "b.codex" is Just (d) -> d.sd-content is None -> "GONE"
    in let s8 = repo-persist-save-tombstone-signed s7 owner "a.codex" 9
    in let v2 = repo-index-verified s8 manifest 5000
    in let a-newer = when work-current v2 "a.codex" is None -> "GONE" is Just (d) -> d.sd-content
    in print-line-uni ("a-after-replay=" & a-after & " b-after-replay=" & b-after & " a-after-newer-tomb=" & a-newer)
  end

