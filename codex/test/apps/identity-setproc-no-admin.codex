Chapter: IdentitySetprocNoAdmin

Section: Body
  opening : [Console] Nothing = act
    let child = process-spawn (\x ->
      let r = process-restrict-cap (process-get-pid) 14
      in let target = process-spawn (\y -> 0)
      in let set-result = identity-set-proc target 0 888
      in poke-byte 28000 0 (if set-result == (0 - 1) then 1 else 0))
    in let wt = process-wait child
    in let ok = peek-byte 28000 0
    in if ok == 1 then print-line-uni "PASS: identity-set-proc denied without cap-admin"
    else print-line-uni "FAIL"
  end
