Chapter: DnsResolverTest
  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Net chapter DnsResolver

Section: Helpers

  fmt-maybe-ip : Maybe (List Integer) -> Text
  fmt-maybe-ip (m) = when m is Just (ip) -> format-ip ip is None -> "none"

Section: Entry

  opening : [Console] Nothing =
    let ht = host-table-add (host-table-add host-table-empty "localhost" [127, 0, 0, 1]) "gateway" [192, 168, 1, 1]
    in let r0 = resolver-new ht
    in let local = resolve r0 "localhost" 0
    in let unknown = resolve r0 "unknown" 0
    in let l1 = "localhost=" & fmt-maybe-ip local & " unknown=" & fmt-maybe-ip unknown
    in let r1 = resolver-cache-result r0 "server" [10, 0, 2, 15] 300 100
    in let resolved = resolve r1 "server" 200
    in let l2 = "resolved=" & fmt-maybe-ip resolved
    in let c0 = dns-cache-empty
    in let c1 = dns-cache-put c0 "example.com" (DnsA [93, 184, 216, 34]) 60 1000
    in let fresh = dns-cache-lookup c1 "example.com" 1050
    in let expired = dns-cache-lookup c1 "example.com" 1100
    in let l3 = "fresh=" & (when fresh is Just (rec) -> format-dns-record rec is None -> "miss") & " expired=" & (when expired is Just (rec) -> format-dns-record rec is None -> "miss")
    in let gw = host-table-lookup ht "gateway"
    in let l4 = "ip=" & (when gw is Just (ip) -> format-ip ip is None -> "none")
    in let c2 = dns-cache-put c1 "ns1.test" (DnsA [8, 8, 8, 8]) 120 1000
    in let c3 = dns-cache-put c2 "alias.test" (DnsCname "www.example.com") 300 1000
    in let l5 = "count=" & show (dns-cache-count c3)
    in let r1-val = dns-cache-lookup c3 "ns1.test" 1050
    in let r2-val = dns-cache-lookup c3 "alias.test" 1050
    in let l6 = (when r1-val is Just (rec) -> format-dns-record rec is None -> "none") & " | " & (when r2-val is Just (rec) -> format-dns-record rec is None -> "none")
    in act
      print-line-uni l1
      print-line-uni l2
      print-line-uni l3
      print-line-uni l4
      print-line-uni l5
      print-line-uni l6
    end

