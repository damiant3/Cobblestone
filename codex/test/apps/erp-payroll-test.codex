Chapter: ErpPayrollTest
  cites ERP chapter ErpTypes
  cites ERP chapter ErpConfig
  cites ERP chapter HrCore

 Known-answer test for the payroll engine, hand-computed: federal
 bracket math at the boundaries, withholding allowances, and full
 stubs for an exempt monthly employee and an hourly employee with
 overtime.

Section: Setup

  base-emp : Employee =
    Employee {
      emp-id = "E1", emp-first-name = "Pat", emp-last-name = "Lee",
      emp-email = "", emp-phone = "", emp-ssn = "", emp-dob = 0,
      emp-hire-date = 0, emp-termination-date = 0, emp-company = "DEMO",
      emp-department = "", emp-cost-center = "", emp-manager-id = "",
      emp-title = "", emp-status = EmpActive, emp-type = FullTime,
      emp-pay-frequency = Monthly, emp-annual-salary = 1200000,
      emp-hourly-rate = 0, emp-is-exempt = True, emp-address = "",
      emp-emergency-contact = "", emp-emergency-phone = "",
      emp-bank-routing = "", emp-bank-account = "", emp-w4-filing = "",
      emp-w4-allowances = 0
    }

  hourly-emp : Employee =
    let e = __record-set base-emp "emp-is-exempt" False
    in let e2 = __record-set e "emp-annual-salary" 0
    in __record-set e2 "emp-hourly-rate" 2500

Section: Tests

  test-brackets : Text =
    let b1 = calc-federal-tax 100000 0
    in let b2 = calc-federal-tax 400000 0
    in let b3 = calc-federal-tax 500000 0
    in "fed: at100k=" & show b1 & " at400k=" & show b2 & " at500k=" & show b3

  test-allowances : Text =
    "allowances: two=" & show (calc-federal-tax 100000 2)

  test-exempt-stub : Text =
    let s = calc-pay-stub base-emp 0 0 0
    in let head = "exempt: gross=" & show (s.ps-gross-pay) & " fed=" & show (s.ps-federal-tax) & " state=" & show (s.ps-state-tax)
    in head & " ss=" & show (s.ps-social-security) & " medicare=" & show (s.ps-medicare) & " net=" & show (s.ps-net-pay)

  test-hourly-stub : Text =
    let s = calc-pay-stub hourly-emp 80 10 0
    in let head = "hourly: gross=" & show (s.ps-gross-pay) & " fed=" & show (s.ps-federal-tax)
    in head & " taxes=" & show (ps-total-taxes s) & " deds=" & show (ps-total-deductions s) & " net=" & show (s.ps-net-pay)

Section: Body

  opening : [Console] Nothing = act
    print-line-uni test-brackets
    print-line-uni test-allowances
    print-line-uni test-exempt-stub
    print-line-uni test-hourly-stub
  end
