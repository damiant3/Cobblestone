Chapter: FuelEdgeTest
  cites Foreword chapter Fuel

Section: Helpers
  show-fuel : FuelResult Integer -> Text
  show-fuel (r) = when r
    is FuelOk (v) -> "ok:" & show v
    is FuelExhausted -> "exhausted"

Section: Tests
  opening : [Console] Nothing = act
    let r1 = show-fuel (fuel-check 0)
    in let r2 = show-fuel (fuel-check (0 - 1))
    in let r3 = show-fuel (fuel-check 1)
    in let r4 = show-fuel (fuel-bind (fuel-check 1) (\x -> fuel-check (x + 1)))
    in let r5 = show-fuel (fuel-map (\x -> x + 1) FuelExhausted)
    in print-line-uni (r1 & " " & r2 & " " & r3 & " " & r4 & " " & r5)
  end
