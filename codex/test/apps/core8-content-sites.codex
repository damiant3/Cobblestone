  cites Foreword chapter CCE

Section: Probes

 Each line prints the decoded text's length and its CCE units, so a stray unit
 255 is visible rather than rendered as a letter.

  units : Text, Integer, Text -> Text
  units (t) (i) (acc) =
    if i >= text-length t then acc
    else units t (i + 1) (acc & " " & show (char-code (char-at t i)))

  probe : Text, Text -> Text
  probe (label) (t) = label & ": len " & show (text-length t) & " units" & units t 0 ""

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (probe "json tab" (aj-decode "\"a\\tb\""))
    print-line-uni (probe "json cr" (aj-decode "\"a\\rb\""))
    print-line-uni (probe "json backspace formfeed" (aj-decode "\"a\\bb\\fc\""))
    print-line-uni (probe "json newline" (aj-decode "\"a\\nb\""))
    print-line-uni (probe "json u00e9" (aj-decode "\"\\u00e9\""))
    print-line-uni (probe "json u0001 refused" (aj-decode "\"a\\u0001b\""))
    print-line-uni (probe "url tab" (url-decode "a%09b"))
    print-line-uni (probe "url control dropped" (url-decode "a%01b"))
    print-line-uni (probe "url e9" (url-decode "%E9"))
  end

