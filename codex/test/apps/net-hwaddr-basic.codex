Chapter: NetHwaddrBasicTest
  cites Net chapter Ethernet

Section: Tests
  test-hwaddr : Text =
    let m1 = mac-bytes 82 84 0 18 52 86
    in let m2 = mac-bytes 82 84 0 18 52 86
    in let m3 = mac-bytes 1 2 3 4 5 6
    in if mac-equal m1 m2 & mac-equal m1 m3 == False & mac-equal mac-broadcast [255, 255, 255, 255, 255, 255] then "PASS" else "FAIL"

  opening : [Console] Nothing = act
    print-line-uni test-hwaddr
  end
