Chapter: RepoProtocolTest

  cites Foreword chapter Console
  cites Works chapter RepoProtocol
  cites Works chapter Annotation
  cites Works chapter KeyManager

Section: Body

  opening : [Console] Nothing =
    let repo = repo-empty
    in let kp = generate-keypair [1, 2, 3, 4, 5, 6, 7, 8]
    in let target = make-target "MyChapter" "my-func"
    in let proposal = create-proposal kp target "fix bug" "it was broken" ["my-func"] 1000
    in let repo2 = repo-submit-proposal repo proposal
    in let v = create-verdict kp (proposal.id) Accept "looks good" 2000
    in let repo3 = repo-submit-verdict repo2 v
    in let accepted = if proposal-is-accepted repo3 (proposal.id) then "yes" else "no"
    in let repo4 = record-supersession repo3 "old-hash" "new-hash"
    in let sup = if is-superseded repo4 "old-hash" then "yes" else "no"
    in let not-sup = if is-superseded repo4 "other" then "yes" else "no"
    in let ob = integer-to-text (outbox-size repo4)
    in act
      print-line-uni ("status=" & proposal-status-name (proposal.status))
      print-line-uni ("accepted=" & accepted)
      print-line-uni ("superseded=" & sup)
      print-line-uni ("not-superseded=" & not-sup)
      print-line-uni ("outbox=" & ob)
      print-line-uni ("verdict-kind=" & verdict-kind-name (v.kind))
    end
