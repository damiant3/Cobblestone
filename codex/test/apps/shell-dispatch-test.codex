Section: Test Data
  test-sk : List Integer = [157, 97, 177, 157, 239, 253, 90, 96, 186, 132, 74, 244, 146, 236, 44, 196, 68, 73, 197, 105, 123, 50, 105, 25, 112, 59, 172, 3, 28, 174, 127, 96]

  hello-binary : List Integer
  hello-binary =
    cdx-encode-signed (CdxBinaryParts {
      flags = cdx-flag-bare-metal,
      capabilities = [
        CdxCapability { cap-id = cdx-cap-console, direction = cdx-dir-write, scope = "/", max-duration = 0 }
      ],
      effects = ["Console"],
      text-bytes = [144, 195],
      rodata-bytes = [],
      entry-offset = 0,
      stack-size = 65536,
      heap-size = 65536,
      trust-threshold = 5000
    }) test-sk

  author-key : Text = read-author-key hello-binary

Section: Setup
  test-store : BinaryStore
  test-store = binary-store-add binary-store-empty "hello" hello-binary

  test-state : ShellState
  test-state =
    let s0 = shell-init (policy-empty "codex-os") 100
    in let r1 = execute-cmd (CmdAddRule "allow-console" "Console" 2) s0
    in let r2 = execute-cmd (CmdTrust author-key 10000) (r1.new-state)
    in r2.new-state

Section: Helpers
  check-parse : Text -> Text
  check-parse (line) =
    let result = parse-command line
    in when result
      is ParseOk (cmd) -> "ok"
      is ParseError (msg) -> "err: " & msg

 The info command reads the system identity, so dispatch carries the
 Identity effect and its results are act-bound. The projections out of
 DispatchResult stay pure.

  dr-output : DispatchResult -> Text
  dr-output (dr) = dr.output

  dr-state : DispatchResult -> ShellState
  dr-state (dr) = dr.new-state

  dispatch-output : ShellInput, ShellState -> [Identity] Text
  dispatch-output (input) (state) = dr-output (dispatch input state test-store)

  installed-state : Integer -> [Identity] ShellState
  installed-state (x) = dr-state (dispatch (InputInstall "hello") test-state test-store)

Section: Tests
  opening : [Console, Identity] Nothing = act
    print-line-uni (check-parse "install hello")
    print-line-uni (check-parse "run hello")
    print-line-uni (check-parse "revoke hello 5")
    print-line-uni (check-parse "status hello")
    print-line-uni (check-parse "list")
    print-line-uni (check-parse "trust alice 9000")
    print-line-uni (check-parse "untrust alice")
    print-line-uni (check-parse "rule allow-fs FileSystem 1")
    print-line-uni (check-parse "help")
    print-line-uni (check-parse "exit")
    print-line-uni (check-parse "")
    print-line-uni (check-parse "bogus")
    print-line-uni (check-parse "hlp")
    print-line-uni (check-parse "instal")
    print-line-uni (check-parse "revoke hello abc")
    print-line-uni "---"
    inst <- installed-state 0
    print-line-uni (dispatch-output (InputInstall "hello") test-state)
    print-line-uni (dispatch-output (InputStatus "hello") inst)
    print-line-uni (dispatch-output (InputRun "hello") inst)
    print-line-uni (dispatch-output InputList test-state)
    print-line-uni (dispatch-output (InputRun "missing") test-state)
    print-line-uni (dispatch-output (InputInstall "ghost") test-state)
    print-line-uni (dispatch-output InputHelp test-state)
    print-line-uni (dispatch-output InputExit test-state)
    print-line-uni "---"
    print-line-uni (check-parse "verify hello")
    print-line-uni (check-parse "save")
    print-line-uni (dispatch-output (InputVerify "hello") inst)
    print-line-uni (dispatch-output (InputVerify "ghost") inst)
    print-line-uni (dispatch-output InputSave test-state)
    print-line-uni (check-parse "info")
    print-line-uni (dispatch-output InputInfo test-state)
  end
