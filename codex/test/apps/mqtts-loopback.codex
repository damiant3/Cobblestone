  ca-parsed : Maybe X509Cert = x509-parse ca-cert

  anchors : List X509Anchor =
    when ca-parsed is None -> [] is Just (c) -> [X509Anchor { xa-subject = c.xc-subject, xa-key = c.xc-key }]

Section: Broker Side

  connack : Integer -> List Integer
  connack (reason) = [32, 3, 0, reason, 0]

  suback : Integer, Integer -> List Integer
  suback (pid) (granted) = [144, 4, bit-and (bit-shru pid 8) 255, bit-and pid 255, 0, granted]

Section: Helpers

  bytes-eq : List Integer, List Integer -> Boolean
  bytes-eq (a) (b) =
    if list-length a /= list-length b then False else be-loop a b 0 (list-length a)
  be-loop : List Integer, List Integer, Integer, Integer -> Boolean
  be-loop (a) (b) (i) (n) =
    if i >= n then True
    else if list-at a i /= list-at b i then False
    else be-loop a b (i + 1) n

  take-from : List Integer, Integer, Integer -> List Integer
  take-from (bs) (i) (n) = tf-loop bs i n []
  tf-loop : List Integer, Integer, Integer, List Integer -> List Integer
  tf-loop (bs) (i) (n) (acc) =
    if i >= n then acc else tf-loop bs (i + 1) n (list-push acc (list-at bs i))

Section: Entry

  opening : [Console] Nothing =
    let sv0 = tls-ep-server-new s-priv s-random [leaf-cert] leaf-priv leaf-pub
    in let cl-tls = tls-ep-client-new c-priv c-random anchors cal-now peer-name
    in let h1 = tls-ep-hello cl-tls
    in let ch = list-at (h1.tes-out) 0
    in let sv1 = tls-ep-recv sv0 ch
    in let r-sh = list-at (sv1.tes-out) 0
    in let r-ee = list-at (sv1.tes-out) 1
    in let r-cert = list-at (sv1.tes-out) 2
    in let r-cv = list-at (sv1.tes-out) 3
    in let r-fin = list-at (sv1.tes-out) 4
    in let k1 = tls-ep-recv (h1.tes-ep) r-sh
    in let k2 = tls-ep-recv (k1.tes-ep) r-ee
    in let k3 = tls-ep-recv (k2.tes-ep) r-cert
    in let k4 = tls-ep-recv (k3.tes-ep) r-cv
    in let k5 = tls-ep-recv (k4.tes-ep) r-fin
    in let c-fin = list-at (k5.tes-out) 0
    in let sv2 = tls-ep-recv (sv1.tes-ep) c-fin

    in let plain = mqtt-ep-connect mqtt-ep-new default-mqtt-connect
    in let plain-connect = list-at (plain.ms-out) 0

    in let cl0 = mqtts-ep-new mqtt-ep-new (k5.tes-ep)
    in let cn = mqtts-ep-connect cl0 default-mqtt-connect
    in let wire = list-at (cn.xms-out) 0
    in let sv3 = tls-ep-recv (sv2.tes-ep) wire
    in let broker-in = tls-ep-app-in (sv3.tes-ep)
    in let n-connect = list-length broker-in
    in let wire-is-record = bytes-eq wire plain-connect == False
    in let broker-got = bytes-eq (take-from broker-in 0 n-connect) plain-connect

    in let ack = tls-ep-send-app (sv3.tes-ep) (connack 0)
    in let cn2 = mqtts-ep-recv (cn.xms-ep) (list-at (ack.tes-out) 0) 0
    in let one-ready = mqtts-ep-ready (cn2.xms-ep)
    in let one-reason = mqtts-ep-connack (cn2.xms-ep)

    in let sub = mqtts-ep-subscribe (cn2.xms-ep) "sensor/#" QosAtLeastOnce
    in let sub-wire = list-at (sub.xms-out) 0
    in let sv4 = tls-ep-recv (ack.tes-ep) sub-wire
    in let sb = suback 1 1
    in let sb-a = take-from sb 0 3
    in let sb-b = take-from sb 3 6
    in let ra = tls-ep-send-app (sv4.tes-ep) sb-a
    in let ca = mqtts-ep-recv (sub.xms-ep) (list-at (ra.tes-out) 0) 0
    in let split-half = mqtts-ep-suback (ca.xms-ep)
    in let rb = tls-ep-send-app (ra.tes-ep) sb-b
    in let cb = mqtts-ep-recv (ca.xms-ep) (list-at (rb.tes-out) 0) 0
    in let split-whole = mqtts-ep-suback (cb.xms-ep)
    in let one-auth = mqtts-ep-authenticated (cb.xms-ep)

    in act
      print-line-uni ("mqtts connect ready=" & show one-ready & " reason=" & show one-reason)
      print-line-uni ("mqtts wire not-plain=" & show wire-is-record & " broker-recovered=" & show broker-got)
      print-line-uni ("mqtts split half=" & show split-half & " whole=" & show split-whole)
      print-line-uni ("mqtts authenticated=" & show one-auth)
    end
