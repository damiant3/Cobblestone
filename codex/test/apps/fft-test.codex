Chapter: FftTest
  cites Signal chapter FFT

Section: Tests
  test-signal-new : Text =
    let sig = fft-signal-new [1000, 0, 0 - 1000, 0]
    in "n=" & show (sig.length)

  test-dc : Text =
    let sig = fft-signal-new [1000, 1000, 1000, 1000]
    in let ft = fft-forward sig
    in "dc=" & show (fft-dc ft)

  test-magnitude : Text =
    let sig = fft-signal-new [1000, 0, 0 - 1000, 0]
    in let ft = fft-forward sig
    in "mag0=" & show (fft-magnitude ft 0) & " mag1=" & show (fft-magnitude ft 1)

  opening : [Console] Nothing = act
    print-line-uni test-signal-new
    print-line-uni test-dc
    print-line-uni test-magnitude
  end
