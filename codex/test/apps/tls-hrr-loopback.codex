Section: Helpers

  tr-eq : List Integer, List Integer -> Boolean
  tr-eq (a) (b) =
    if list-length a /= list-length b then False
    else tr-eq-loop a b 0 (list-length a)

  tr-eq-loop : List Integer, List Integer, Integer, Integer -> Boolean
  tr-eq-loop (a) (b) (i) (n) =
    if i >= n then True
    else if list-at a i /= list-at b i then False
    else tr-eq-loop a b (i + 1) n

  rec-body : List Integer -> List Integer
  rec-body (rec) = dtls-take-at rec 9 (list-length rec - 9)

  groups-ext : List Integer -> List Integer
  groups-ext (ids) = tls-be16 10 & tls-be16 (list-length ids + 2) & tls-be16 (list-length ids) & ids

  p256-ks-ext : List Integer =
    let entry = tls-be16 23 & tls-be16 65 & p256-share
    in tls-be16 51 & tls-be16 (list-length entry + 2) & tls-be16 (list-length entry) & entry

  ch-body-with : List Integer -> List Integer
  ch-body-with (groups) =
    let exts = tls-ext-versions & groups-ext groups & tls-ext-sig-algs & p256-ks-ext
    in [3, 3] & c-random & [32] & c-sid & tls-be16 2 & tls-be16 tls-cipher-aes-128-gcm-sha256 & [1, 0] & tls-be16 (list-length exts) & exts

  ch-rec : List Integer -> List Integer
  ch-rec (body) = tls-encode-record tls-content-handshake (tls13-msg-transcript dtls-hs-client-hello body)

Section: The Retry

  ch1-body : List Integer = ch-body-with [0, 23, 0, 29]

  s0 : TlsEp = tls-ep-server-new s-priv s-random [leaf-cert] leaf-priv leaf-pub

  sv1 : TlsEpStep = tls-ep-recv s0 (ch-rec ch1-body)
  hrr-rec : List Integer = list-at (sv1.tes-out) 0
  hrr-body : List Integer = rec-body hrr-rec

  hrr-group : Text =
    when dtls-sh-find-ext hrr-body 51
      is None -> "NONE"
      is Just (e) -> show (list-length e) & ":" & show (list-at e 0 * 256 + list-at e 1)

Section: The Second ClientHello

  c-tr : List Integer =
    tls13-transcript-after-hrr (tls13-msg-transcript dtls-hs-client-hello ch1-body) & tls13-msg-transcript dtls-hs-server-hello hrr-body

  c0 : TlsEp = __record-set (tls-ep-client-new c-priv c-random [] [] []) "tep-transcript" c-tr

  cs1 : TlsEpStep = tls-ep-hello c0
  sv2 : TlsEpStep = tls-ep-recv (sv1.tes-ep) (list-at (cs1.tes-out) 0)

  c1 : TlsEpStep = tls-ep-recv (cs1.tes-ep) (list-at (sv2.tes-out) 0)
  c2 : TlsEpStep = tls-ep-recv (c1.tes-ep) (list-at (sv2.tes-out) 1)
  c3 : TlsEpStep = tls-ep-recv (c2.tes-ep) (list-at (sv2.tes-out) 2)
  c4 : TlsEpStep = tls-ep-recv (c3.tes-ep) (list-at (sv2.tes-out) 3)
  c5 : TlsEpStep = tls-ep-recv (c4.tes-ep) (list-at (sv2.tes-out) 4)

  sv3 : TlsEpStep = tls-ep-recv (sv2.tes-ep) (list-at (c5.tes-out) 0)

  cs2 : TlsEpStep = tls-ep-send-app (c5.tes-ep) [71, 69, 84]
  sv4 : TlsEpStep = tls-ep-recv (sv3.tes-ep) (list-at (cs2.tes-out) 0)

Section: Sabotage, ClientHello1 Kept Whole

  k-tr : List Integer =
    tls13-msg-transcript dtls-hs-client-hello ch1-body & tls13-msg-transcript dtls-hs-server-hello hrr-body

  k0 : TlsEp = __record-set (tls-ep-client-new c-priv c-random [] [] []) "tep-transcript" k-tr
  ks1 : TlsEpStep = tls-ep-hello k0
  ksv2 : TlsEpStep = tls-ep-recv (sv1.tes-ep) (list-at (ks1.tes-out) 0)
  k1 : TlsEpStep = tls-ep-recv (ks1.tes-ep) (list-at (ksv2.tes-out) 0)
  k2 : TlsEpStep = tls-ep-recv (k1.tes-ep) (list-at (ksv2.tes-out) 1)
  k3 : TlsEpStep = tls-ep-recv (k2.tes-ep) (list-at (ksv2.tes-out) 2)
  k4 : TlsEpStep = tls-ep-recv (k3.tes-ep) (list-at (ksv2.tes-out) 3)
  k5 : TlsEpStep = tls-ep-recv (k4.tes-ep) (list-at (ksv2.tes-out) 4)

Section: Refusals

  again : TlsEpStep = tls-ep-recv (sv1.tes-ep) (ch-rec ch1-body)

  no-x25519 : TlsEpStep = tls-ep-recv s0 (ch-rec (ch-body-with [0, 23]))

Section: Results

  test-hrr : Text =
    "hrr outs=" & show (list-length (sv1.tes-out)) & " is-hrr=" & show (dtls-is-hrr hrr-body) & " group=" & hrr-group & " sid-echo=" & show (tr-eq (dtls-take-at hrr-body 35 32) c-sid)
  test-flight : Text = "retry flight outs=" & show (list-length (sv2.tes-out))
  test-done : Text = "retry client-done=" & show (tls-ep-done (c5.tes-ep)) & " server-done=" & show (tls-ep-done (sv3.tes-ep))
  test-app : Text = "retry c2s=" & show (tr-eq (tls-ep-app-in (sv4.tes-ep)) [71, 69, 84])
  test-kept : Text = "ch1-kept client-done=" & show (tls-ep-done (k5.tes-ep))
  test-again : Text = "second no-share outs=" & show (list-length (again.tes-out)) & " alert=" & show (tr-eq (list-at (again.tes-out) 0) [21, 3, 3, 0, 2, 2, 47])
  test-no-x25519 : Text = "no-x25519 outs=" & show (list-length (no-x25519.tes-out)) & " alert=" & show (tr-eq (list-at (no-x25519.tes-out) 0) [21, 3, 3, 0, 2, 2, 40]) & " done=" & show (tls-ep-done (no-x25519.tes-ep))

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni test-hrr
    print-line-uni test-flight
    print-line-uni test-done
    print-line-uni test-app
    print-line-uni test-kept
    print-line-uni test-again
    print-line-uni test-no-x25519
  end
