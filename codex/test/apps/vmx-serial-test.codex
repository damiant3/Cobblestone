Chapter: VmxSerialTest
  cites Codex chapter General
  cites Works chapter DevHypervisor

Section: Body

  opening : [Console] Nothing = act
   let guest-code = [
     186, 248, 3,
     176, 72,
     238,
     176, 105,
     238,
     244
   ]
   in let cfg = GuestConfig { entry-point = guest-entry-point, memory-mb = 4 }
   in let result = vm-setup-and-run-with-serial cfg vmx-read-revision-id guest-code []
   in let output = vm-serial-get-output (result.vfr-devices.vd-com1)
   in act
    print-line ("status=" & when (result.vfr-status) is VmHalted -> "halted" is VmIoExit (i) -> "io" is VmCrashed (i) -> "crashed")
    print-line ("output=" & output)
   end
  end

