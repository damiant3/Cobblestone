Chapter: IpiTest
  cites Sched chapter IPI
  cites Foreword chapter Maybe

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Body
  opening : [Console] Nothing =
    let state = ipi-state-new 4
    in act
      print-line-uni (ipi-stats state)
      let s1 = ipi-wake-core state 0 2 1000
      in act
        print-line-uni (ipi-stats s1)
        print-line-uni (show (ipi-pending-count s1 2))
        print-line-uni (show-bool (ipi-has-pending s1 2))
        print-line-uni (show-bool (ipi-has-pending s1 0))
        let r = ipi-recv s1 2
        in act
          print-line-uni (show-bool (r.has-message))
          print-line-uni (format-ipi-kind (r.message).kind)
          print-line-uni (show (ipi-pending-count (r.state) 2))
          print-line-uni (show (ipi-total-delivered (r.state) 2))
          let s2 = ipi-tlb-shootdown (r.state) 1 4096 2000
          in act
            print-line-uni (show (ipi-pending-count s2 0))
            print-line-uni (show (ipi-pending-count s2 1))
            print-line-uni (show (ipi-pending-count s2 2))
            print-line-uni (show (ipi-pending-count s2 3))
            let s3 = ipi-panic s2 0 "fault" 3000
            in act
              print-line-uni (ipi-stats s3)
              print-line-uni (show (ipi-pending-count s3 0))
              print-line-uni (show (ipi-pending-count s3 3))
            end
          end
        end
      end
    end

