Chapter: DiskFactsMultiLoad
  cites Foreword chapter Console
  cites Foreword chapter FactStore
  cites Foreword chapter Maybe

Section: Entry

  opening : [Console] Nothing =
    let fs0 = fact-store-empty
    in let f1 = fact-create DefinitionFact "alpha" "sys" 1
    in let f2 = fact-create DefinitionFact "beta" "sys" 2
    in let f3 = fact-create DefinitionFact "gamma" "sys" 3
    in let fs1 = fact-store fs0 f1
    in let fs2 = fact-store fs1 f2
    in let fs3 = fact-store fs2 f3
    in let r1 = fact-load fs3 (f1.hash)
    in let r2 = fact-load fs3 (f2.hash)
    in let r3 = fact-load fs3 (f3.hash)
    in let c1 = when r1 is Just (f) -> f.content is None -> "?"
    in let c2 = when r2 is Just (f) -> f.content is None -> "?"
    in let c3 = when r3 is Just (f) -> f.content is None -> "?"
    in act
      print-line-uni (show (fact-count fs3) & " " & c1 & " " & c2 & " " & c3)
    end

