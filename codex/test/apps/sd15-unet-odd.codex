 We say:

Section: Inputs

 The formulas build/sd15-unet-oracle.py --odd fed Forge's UNet, at a 15 x 11 latent.

  latent-at : Integer -> Real
  latent-at (i) = real-from-int (int-mod (i * 37 + 11) 257 - 128) / 128.0

  context-at : Integer -> Real
  context-at (i) = real-from-int (int-mod (i * 13 + 5) 251 - 125) / 256.0

  build : Integer, Integer, Integer, List Real -> List Real
  build (which) (i) (n) (acc) =
    if i >= n then acc
    else build which (i + 1) n (list-push acc (if which == 0 then latent-at i else if which == 2 then context-at i else 0.0))

Section: Grading

  abs : Real -> Real
  abs (x) = if x < 0.0 then 0.0 - x else x

  count-near : List Real, UNetRefBlock, Real, Integer, Integer -> Integer
  count-near (got) (ref) (tol) (j) (acc) =
    if j >= unet-ref-samples then acc
    else let n = list-length got
    in let v = list-at got (int-mod (j * unet-ref-stride + unet-ref-offset) n)
    in count-near got ref tol (j + 1) (if abs (v - list-at (ref.urb-samples) j) <= tol * ref.urb-rms then acc + 1 else acc)

  sum-sq : List Real, Integer, Real -> Real
  sum-sq (xs) (i) (acc) =
    if i >= list-length xs then acc
    else sum-sq xs (i + 1) (acc + list-at xs i * list-at xs i)

  rms-near : List Real, UNetRefBlock -> Boolean
  rms-near (got) (ref) =
    let n = list-length got
    in let ms = if n == 0 then 0.0 else sum-sq got 0 0.0 / real-from-int n
    in abs (ms - ref.urb-rms * ref.urb-rms) <= 0.02 * ref.urb-rms * ref.urb-rms

  grade : Integer, Integer, Real -> Text
  grade (h) (k) (tol) =
    let ref = list-at unet15-odd-ref-blocks k
    in let n = ref.urb-c * ref.urb-h * ref.urb-w
    in let got = if h == 0 then [] else un-download h n
    in if list-length got /= n then ref.urb-name & ": NO OUTPUT"
    else ref.urb-name & ": " & show (count-near got ref tol 0 0) & "/" & show unet-ref-samples & " within " & show (real-to-int (tol * 100.0)) & "% of rms, rms " & (if rms-near got ref then "near" else "FAR")

Section: Entry

  run-all : Integer -> List Text
  run-all (z) =
    let u = unet-open "realisticVisionV60B1_v20Novae.safetensors"
    in if (u.uf-file).st-valid == False then ["SKIP: no realisticVisionV60B1_v20Novae.safetensors under the model root build-output/diffusion-models"]
    else run-step (unet-load u)

  run-step : UNetFile -> List Text
  run-step (u) =
    let x = un-upload (build 0 0 660 [])
    in let ctx = un-upload (build 2 0 59136 [])
    in let emb = unet15-embedding u unet15-odd-ref-t
    in let embs = un-silu emb 1280
    in let blocks = unet15-forward u x embs ctx 15 11
    in let lines = grade-all blocks 0 []
    in let far = unet15-embedding u 900.0
    in let fars = un-silu far 1280
    in let s1 = u15-stage u (list-at blocks 0) fars ctx 320 320 15 11 "input_blocks.1." True
    in let ls = grade s1 1 0.01
    in let ctx0 = un-upload (build 3 0 59136 [])
    in let z1 = u15-stage u (list-at blocks 0) embs ctx0 320 320 15 11 "input_blocks.1." True
    in let lz = grade z1 1 0.01
    in lines & ["sabotage, input 1 at t = 900: " & ls, "sabotage, input 1 with a zero context: " & lz]

  grade-all : List Integer, Integer, List Text -> List Text
  grade-all (hs) (k) (acc) =
    if k >= list-length unet15-odd-ref-blocks then acc
    else grade-all hs (k + 1) (list-push acc (grade (if k < list-length hs then list-at hs k else 0) k 0.01))

  print-all : List Text, Integer -> [Console] Nothing
  print-all (ls) (i) =
    if i >= list-length ls then act
      print-uni ""
    end
    else act
      print-line-uni (list-at ls i)
      print-all ls (i + 1)
    end

  opening : [Console] Integer
  opening = act
    print-all (run-all 0) 0
    let r = 0 in r
  end
