Chapter: AnnotationTransportTest
  cites Foreword chapter Console
  cites Foreword chapter FactStore
  cites Foreword chapter Maybe
  cites Works chapter Annotation

Section: Entry

  opening : [Console] Nothing =
    let t = make-target "Module" "function-a"
    in let ann = create-annotation t Warning "dev-1" "possible overflow" 7000
    in let ver = create-annotation t Rationale "dev-2" "reviewed and safe" 8000
    in let fs0 = fact-store-empty
    in let f1 = fact-create DefinitionFact (ann.hash) "transport" 100
    in let fs1 = fact-store fs0 f1
    in let ann-rt = fact-has fs1 (f1.hash)
    in let l1 = "ann-roundtrip=" & if ann-rt then "yes" else "no"
    in let f2 = fact-create DefinitionFact (ver.hash) "transport" 200
    in let fs2 = fact-store fs1 f2
    in let ver-rt = fact-has fs2 (f2.hash)
    in let l2 = "ver-roundtrip=" & if ver-rt then "yes" else "no"
    in let ann-land = fact-load fs2 (f1.hash)
    in let l3 = "ann-landed=" & (when ann-land is Just (f) -> "yes" is None -> "no")
    in let ver-land = fact-load fs2 (f2.hash)
    in let l4 = "ver-landed=" & (when ver-land is Just (f) -> "yes" is None -> "no")
    in let f3 = fact-create DefinitionFact "notify:annotation-arrived" "bus" 300
    in let fs3 = fact-store fs2 f3
    in let notif = fact-has fs3 (f3.hash)
    in let l5 = "notif-enqueued=" & if notif then "yes" else "no"
    in let tamper-hash = fact-content-hash "tampered-data"
    in let tamper-found = fact-has fs3 tamper-hash
    in let l6 = "tamper-rejected=" & if tamper-found then "no" else "yes"
    in act
      print-line-uni l1
      print-line-uni l2
      print-line-uni l3
      print-line-uni l4
      print-line-uni l5
      print-line-uni l6
      print-line-uni "annotation-transport:done"
    end
