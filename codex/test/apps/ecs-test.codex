Chapter: EcsTest
  cites Codex chapter General
  cites Game chapter ECS

Section: Tests
  test-new : Text =
    let em = ecs-new
    in "count=" & show (em.count)

  test-spawn : Text =
    let em = ecs-spawn (ecs-spawn ecs-new)
    in "count=" & show (em.count)

  test-spawn-id : Text =
    let em0 = ecs-new
    in let em1 = ecs-spawn em0
    in let em2 = ecs-spawn em1
    in "count=" & show (em2.count)

  opening : [Console] Nothing = act
    print-line-uni test-new
    print-line-uni test-spawn
    print-line-uni test-spawn-id
  end
