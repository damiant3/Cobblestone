Chapter: FactstoreVerify
  cites Foreword chapter Console
  cites Foreword chapter FactStore
  cites Foreword chapter Maybe

Section: Entry

  opening : [Console] Nothing =
    let fs0 = fact-store-empty
    in let f1 = fact-create DefinitionFact "hello world" "author-a" 100
    in let fs1 = fact-store fs0 f1
    in let f2 = fact-create ProofFact "proof-data-1" "author-b" 200
    in let fs2 = fact-store fs1 f2
    in let count = fact-count fs2
    in let has1 = fact-has fs2 (f1.hash)
    in let has2 = fact-has fs2 (f2.hash)
    in let loaded = fact-load fs2 (f1.hash)
    in let verified = when loaded is Just (f) -> f.content == "hello world" is None -> False
    in if count == 2 then
      if has1 then
        if has2 then
          if verified then act print-line-uni ("PASS: " & show count & " facts stored and verified") end
          else act print-line-uni "FAIL: content mismatch" end
        else act print-line-uni "FAIL: f2 missing" end
      else act print-line-uni "FAIL: f1 missing" end
    else act print-line-uni ("FAIL: count=" & show count) end

