Chapter: IdentityGetProcTest

Section: Body
  opening : [Console] Nothing = act
    let s0 = identity-set 0 12345
    in let s1 = identity-set 1 67890
    in let pid = process-spawn (\x ->
      let parent-w0 = identity-get-proc 0 0
      in let parent-w1 = identity-get-proc 0 1
      in let own-w0 = identity-whoami 0
      in if parent-w0 == 12345 then
        if parent-w1 == 67890 then
          if own-w0 == 12345 then poke-byte 28000 0 1
          else poke-byte 28000 0 2
        else poke-byte 28000 0 3
      else poke-byte 28000 0 4)
    in let wt = process-wait pid
    in let result = peek-byte 28000 0
    in let bad = identity-get-proc 99 0
    in if result == 1 then if bad == (0 - 1) then print-line "PASS"
    else print-line "FAIL: out-of-range pid not -1"
    else print-line "FAIL: child could not read parent identity"
  end
