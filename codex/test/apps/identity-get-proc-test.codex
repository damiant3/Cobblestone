Chapter: IdentityGetProcTest

 identity-get-proc reads another process's identity word, which is an
 Identity effect just as writing one is. The parent's two sets carry
 Identity, the spawn carries Concurrent, and the child names Identity
 for the two reads it makes of its parent's label.

Section: Body
  child-body : Integer -> [Identity] Integer
  child-body (x) =
    if identity-get-proc 0 0 == 12345 then
      if identity-get-proc 0 1 == 67890 then
        if identity-whoami 0 == 12345 then poke-byte 28000 0 1
        else poke-byte 28000 0 2
      else poke-byte 28000 0 3
    else poke-byte 28000 0 4

  finish : Integer -> [Identity] Text
  finish (pid) =
    let wt = process-wait pid
    in if peek-byte 28000 0 /= 1 then "FAIL: child could not read parent identity"
    else if identity-get-proc 99 0 /= (0 - 1) then "FAIL: out-of-range pid not -1"
    else "PASS"

  step-b : Integer -> [Concurrent, Identity] Text
  step-b (s1) = finish (process-spawn (\y -> child-body y))

  step-a : Integer -> [Identity, Concurrent] Text
  step-a (s0) = step-b (identity-set 1 67890)

  run-get-proc : Integer -> [Identity, Concurrent] Text
  run-get-proc (x) = step-a (identity-set 0 12345)

  opening : [Console, Identity, Concurrent] Nothing = act
    print-line-uni (run-get-proc 0)
  end
