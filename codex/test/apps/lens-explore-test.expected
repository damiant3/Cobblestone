=== lens explore test: the query builder page ===
-- bare form page
<!DOCTYPE html>
<html>
<head>
<title>Explore sales</title>
<style>
body{font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;margin:24px;background:#f7f7f5;color:#222222}
h1{font-size:22px}
.lens-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(660px,1fr));gap:16px}
.lens-tile{background:#ffffff;border:1px solid #dddddd;border-radius:8px;padding:12px 16px}
.lens-tile h2{font-size:16px;margin:0 0 8px 0}
.lens-tile svg{max-width:100%;height:auto}
.lens-error{color:#b00020;background:#fdecea;padding:8px;border-radius:4px}
.lens-empty{color:#777777}
.lens-legend{display:flex;gap:16px;font-size:13px}
.lens-key{display:inline-flex;align-items:center;gap:6px}
.lens-chip{display:inline-block;width:12px;height:12px;border-radius:2px}
.lens-table{border-collapse:collapse;font-size:14px}
.lens-table th,.lens-table td{border:1px solid #dddddd;padding:4px 10px;text-align:left}
.lens-table th{background:#f0f0ee}
.lens-form fieldset{background:#ffffff;border:1px solid #dddddd;border-radius:8px;margin:0 0 12px 0;padding:8px 16px}
.lens-form legend{font-size:14px;font-weight:bold;padding:0 6px}
.lens-choice{display:block;font-size:14px;margin:4px 0}
.lens-desc{color:#777777;font-size:13px}
.lens-results{margin-top:16px}
.lens-results h3{font-size:14px;margin:12px 0 4px 0}
.lens-sql{background:#f0f0ee;padding:8px;border-radius:4px;font-size:13px;white-space:pre-wrap}
</style>
</head>
<body>
<h1>Explore sales</h1>
<form class="lens-form" method="post" action="/explore">
<fieldset>
<legend>Dimensions</legend>
<label class="lens-choice"><input type="checkbox" name="dim" value="city"> city</label>
<label class="lens-choice"><input type="checkbox" name="dim" value="user-name"> user-name</label>
</fieldset>
<fieldset>
<legend>Measures</legend>
<label class="lens-choice"><input type="checkbox" name="meas" value="revenue"> revenue <span class="lens-desc">Sum of order amounts in cents.</span></label>
<label class="lens-choice"><input type="checkbox" name="meas" value="total-credit"> total-credit <span class="lens-desc">Sum of user credit limits in cents. User grain.</span></label>
</fieldset>
<p><label>Limit <input type="number" name="limit" value="0"></label> <button type="submit">Run query</button></p>
</form>
</body>
</html>
-- form parser
  [dim=city&dim=user-name&meas=revenue&meas=total-credit&limit=5] -> dims=[city, user-name] meas=[revenue, total-credit] limit=5
  [dim=order%2Dmonth&meas=a+b%20c] -> dims=[order-month] meas=[a b c] limit=0
  [meas=revenue] -> dims=[] meas=[revenue] limit=0
  [meas=revenue&limit=ten] -> dims=[] meas=[revenue] limit=0
  [limit=3&meas=revenue&limit=7] -> dims=[] meas=[revenue] limit=7
  [dim=&meas=revenue] -> dims=[] meas=[revenue] limit=0
  [revenue&meas=revenue] -> dims=[] meas=[revenue] limit=0
  [dim=a%zzb] -> dims=[a%zzb] meas=[] limit=0
  [meas=1%2B2] -> dims=[] meas=[1+2] limit=0
  [] -> dims=[] meas=[] limit=0
-- result page for city and revenue
<!DOCTYPE html>
<html>
<head>
<title>Explore sales</title>
<style>
body{font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;margin:24px;background:#f7f7f5;color:#222222}
h1{font-size:22px}
.lens-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(660px,1fr));gap:16px}
.lens-tile{background:#ffffff;border:1px solid #dddddd;border-radius:8px;padding:12px 16px}
.lens-tile h2{font-size:16px;margin:0 0 8px 0}
.lens-tile svg{max-width:100%;height:auto}
.lens-error{color:#b00020;background:#fdecea;padding:8px;border-radius:4px}
.lens-empty{color:#777777}
.lens-legend{display:flex;gap:16px;font-size:13px}
.lens-key{display:inline-flex;align-items:center;gap:6px}
.lens-chip{display:inline-block;width:12px;height:12px;border-radius:2px}
.lens-table{border-collapse:collapse;font-size:14px}
.lens-table th,.lens-table td{border:1px solid #dddddd;padding:4px 10px;text-align:left}
.lens-table th{background:#f0f0ee}
.lens-form fieldset{background:#ffffff;border:1px solid #dddddd;border-radius:8px;margin:0 0 12px 0;padding:8px 16px}
.lens-form legend{font-size:14px;font-weight:bold;padding:0 6px}
.lens-choice{display:block;font-size:14px;margin:4px 0}
.lens-desc{color:#777777;font-size:13px}
.lens-results{margin-top:16px}
.lens-results h3{font-size:14px;margin:12px 0 4px 0}
.lens-sql{background:#f0f0ee;padding:8px;border-radius:4px;font-size:13px;white-space:pre-wrap}
</style>
</head>
<body>
<h1>Explore sales</h1>
<form class="lens-form" method="post" action="/explore">
<fieldset>
<legend>Dimensions</legend>
<label class="lens-choice"><input type="checkbox" name="dim" value="city" checked> city</label>
<label class="lens-choice"><input type="checkbox" name="dim" value="user-name"> user-name</label>
</fieldset>
<fieldset>
<legend>Measures</legend>
<label class="lens-choice"><input type="checkbox" name="meas" value="revenue" checked> revenue <span class="lens-desc">Sum of order amounts in cents.</span></label>
<label class="lens-choice"><input type="checkbox" name="meas" value="total-credit"> total-credit <span class="lens-desc">Sum of user credit limits in cents. User grain.</span></label>
</fieldset>
<p><label>Limit <input type="number" name="limit" value="0"></label> <button type="submit">Run query</button></p>
</form>
<section class="lens-tile lens-results">
<h2>Results</h2>
<table class="lens-table">
<tr><th>city</th><th>revenue</th></tr>
<tr><td>Shelbyville</td><td>7300</td></tr>
<tr><td>Springfield</td><td>16100</td></tr>
<tr><td>Capital City</td><td>6500</td></tr>
</table>
<svg viewBox="0 0 640 320" width="640" height="320">
<line x1="60" y1="280" x2="620" y2="280" stroke="#dddddd"/>
<text x="54" y="284" text-anchor="end" font-size="12" fill="#444444">0</text>
<line x1="60" y1="215" x2="620" y2="215" stroke="#dddddd"/>
<text x="54" y="219" text-anchor="end" font-size="12" fill="#444444">5000</text>
<line x1="60" y1="150" x2="620" y2="150" stroke="#dddddd"/>
<text x="54" y="154" text-anchor="end" font-size="12" fill="#444444">10000</text>
<line x1="60" y1="85" x2="620" y2="85" stroke="#dddddd"/>
<text x="54" y="89" text-anchor="end" font-size="12" fill="#444444">15000</text>
<line x1="60" y1="20" x2="620" y2="20" stroke="#dddddd"/>
<text x="54" y="24" text-anchor="end" font-size="12" fill="#444444">20000</text>
<line x1="60" y1="20" x2="60" y2="280" stroke="#333333"/>
<line x1="60" y1="280" x2="620" y2="280" stroke="#333333"/>
<rect x="97" y="186" width="111" height="94" fill="#4e79a7"/>
<text x="152" y="180" text-anchor="middle" font-size="12" fill="#444444">7300</text>
<text x="152" y="296" text-anchor="middle" font-size="12" fill="#444444">Shelbyville</text>
<rect x="283" y="71" width="111" height="209" fill="#4e79a7"/>
<text x="338" y="65" text-anchor="middle" font-size="12" fill="#444444">16100</text>
<text x="338" y="296" text-anchor="middle" font-size="12" fill="#444444">Springfield</text>
<rect x="469" y="196" width="111" height="84" fill="#4e79a7"/>
<text x="524" y="190" text-anchor="middle" font-size="12" fill="#444444">6500</text>
<text x="524" y="296" text-anchor="middle" font-size="12" fill="#444444">Capital City</text>
</svg>
<h3>Executed SQL</h3>
<pre class="lens-sql">SELECT [q3].[city], [q3].[revenue] FROM (SELECT [city], SUM([q1].[revenue]) AS [revenue] FROM (SELECT [user-id], SUM([amount]) AS [revenue] FROM [orders] AS [q0] GROUP BY [user-id]) AS [q1] INNER JOIN [users] AS [q2] ON [q1].[user-id] = [q2].[user-id] GROUP BY [city]) AS [q3] ORDER BY [city] ASC</pre>
</section>
</body>
</html>
