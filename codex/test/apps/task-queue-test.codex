Chapter: TaskQueueTest
  cites Sched chapter TaskQueue
  cites Foreword chapter Maybe

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Body
  opening : [Console] Nothing =
    let q0 = task-queue-empty
    in let stats0 = task-queue-stats q0
    in let q1 = task-enqueue q0 "alert" TaskCritical
    in let q2 = task-enqueue q1 "log" TaskNormal
    in let q3 = task-enqueue q2 "serve" TaskHigh
    in let q4 = task-enqueue q3 "backup" TaskLow
    in let dr = task-dequeue q4
    in let dr2 = task-dequeue (dr.queue)
    in let dr3 = task-dequeue (dr2.queue)
    in let dr4 = task-dequeue (dr3.queue)
    in let names = (dr.task).name & "," & (dr2.task).name & "," & (dr3.task).name & "," & (dr4.task).name
    in let dr5 = task-dequeue task-queue-empty
    in let q5 = task-enqueue task-queue-empty "job" TaskNormal
    in let q6 = task-mark-complete q5 0 0
    in let q7 = task-enqueue q6 "x" TaskNormal
    in let q8 = task-mark-failed q7 1 "timeout"
    in let q9 = task-enqueue q8 "y" TaskNormal
    in act
      print-line-uni stats0
      print-line-uni names
      print-line-uni ("has=" & show-bool (dr5.has-task))
      print-line-uni (format-task (list-at (q6.tasks) 0))
      print-line-uni (format-task-status (TaskFailed "timeout"))
      print-line-uni (task-queue-stats q9)
    end

