Chapter: AnnotationDriverTest

  cites Foreword chapter Console
  cites Works chapter Annotation

Section: Body

  opening : [Console] Nothing =
    let t = make-target "Lexer" "scan-token"
    in let a = create-annotation t Discovery "dave" "CCE byte 13 is e" 5000
    in let k = annotation-kind-name (a.kind)
    in let ch = (a.target).chapter
    in let p = (a.target).path
    in act
      print-line-uni ("kind=" & k)
      print-line-uni ("chapter=" & ch & " path=" & p)
    end
