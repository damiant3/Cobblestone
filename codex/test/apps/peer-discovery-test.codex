Chapter: PeerDiscoveryTest
  cites Trust chapter PeerDiscovery
  cites Trust chapter TrustLattice
  cites Foreword chapter Maybe

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Body
  opening : [Console] Nothing =
    let table = discovery-empty
    in let addr1 = PeerAddress { agent-key = [1, 2, 3], transport = TransportTcp, address = "192.168.1.10", port = 9000 }
    in let addr2 = PeerAddress { agent-key = [4, 5, 6], transport = TransportSerial, address = "/dev/tty0", port = 0 }
    in let table1 = discovery-add-direct table addr1 1000
    in let table2 = discovery-add-direct table1 addr2 1000
    in act
      print-line-uni (show (discovery-count table))
      print-line-uni (show (discovery-count table2))
      print-line-uni (show-bool (discovery-has table2 [1, 2, 3]))
      print-line-uni (show-bool (discovery-has table2 [9, 9, 9]))
      print-line-uni (format-peer-address addr1)
      print-line-uni (format-peer-address addr2)
      let found = discovery-lookup table2 [1, 2, 3]
      in act
        print-line-uni (when found is Just (v) -> show (v.vouch-score) is None -> "not found")
        let table3 = discovery-remove table2 [1, 2, 3]
        in act
          print-line-uni (show (discovery-count table3))
          print-line-uni (show-bool (discovery-has table3 [1, 2, 3]))
          let lat = lattice-add-direct lattice-empty "040506" 8000
          in let table4 = discovery-add-vouch table3 addr1 [4, 5, 6] 7000 lat 2000
          in act
            print-line-uni (show (discovery-count table4))
            print-line-uni (show-bool (discovery-has table4 [1, 2, 3]))
            let lat2 = lattice-empty
            in let table5 = discovery-add-vouch table3 addr1 [9, 9, 9] 7000 lat2 2000
            in act
              print-line-uni (show (discovery-count table5))
            end
          end
        end
      end
    end

