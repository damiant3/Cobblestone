Chapter: HistorianTest

  cites Foreword chapter Console
  cites Works chapter Historian

Section: Body

  opening : [Console] Nothing =
    let h = empty-history "abc123"
    in let sc = integer-to-text (h.step-count)
    in act
      print-line-uni ("initial=" & h.initial-hash & " steps=" & sc & " term=" & h.terminated-at)
    end
