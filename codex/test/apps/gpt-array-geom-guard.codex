 The .disk sidecar is the valid gop-fat16
 image with ONE change: NumberOfPartitionEntries at header offset 80 is 100000.

Section: Main

  show-esp : [Device.Port] Text
  show-esp = act
    s <- gpt-esp-start
    "esp-start=" & show s & " stage=" & show (xdiag-get gfat-cell-stage)
  end

  opening : [Console, Device.Port] Nothing = act
    a <- show-esp
    print-line-uni a
  end