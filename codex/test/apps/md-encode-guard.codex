Chapter: Md Encode Guard
  cites Foreword chapter Console
  cites Encode chapter Markdown

Section: Helpers

  rep : Text, Integer, Integer, Text -> Text
  rep (s) (i) (n) (acc) = if i >= n then acc else rep s (i + 1) n (acc & s)

  arm : Text, Text -> Text
  arm (name) (src) = name & " [" & md-render (md-parse src) & "]"

  cost : Integer -> Integer
  cost (n) =
    let blocks = md-parse (rep "# h\n" 0 n "")
    in let b = __heap-save
    in let t = md-render blocks
    in let a = __heap-save
    in (a - b) + text-length t - text-length t

  scaling : Text, Integer, Integer -> Text
  scaling (name) (small) (large) =
    if large <= 5 * small then name & " linear"
    else name & " superlinear " & show small & " " & show large

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (arm "heading" "# Title")
    print-line-uni (arm "hash-only" "#")
    print-line-uni (arm "six-only" "######")
    print-line-uni (arm "seven" "#######")
    print-line-uni (arm "no-space" "#hello")
    print-line-uni (arm "quote-tight" ">x")
    print-line-uni (arm "quote-spaced" "> y")
    print-line-uni (arm "quote-bare" ">")
    print-line-uni (scaling "render" (cost 256) (cost 1024))
  end
