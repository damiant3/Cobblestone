Chapter: DistributedConfigTest
  cites Net chapter DistributedConfig
  cites Foreword chapter Maybe
  cites Foreword chapter Console

Section: Fixtures

  dct-meta : ConfigStore, Text -> Text
  dct-meta (st) (key) = when cs-get st key
    is Just (e) -> e.ce-value & "@v" & show (e.ce-version)
    is None -> "absent"

Section: Entry

  opening : [Console] Nothing = act
    let s1 = cs-set config-store-new "net.port" "80" 1
    in let s2 = cs-set s1 "net.port" "81" 2
    in print-line-uni ("set keeps the caller's store: old " & dct-meta s1 "net.port" & " value " & cs-get-value s1 "net.port" "none" & ", new " & dct-meta s2 "net.port" & " value " & cs-get-value s2 "net.port" "none")
    let s3 = cs-set config-store-new "net.port" "80" 1
    in let s4 = cs-set s3 "net.host" "a" 2
    in print-line-uni ("a new key keeps the caller's list: old " & show (s3.cs-meta-count) & "/" & show (list-length (s3.cs-meta)) & ", new " & show (s4.cs-meta-count) & "/" & show (list-length (s4.cs-meta)))
    let s5 = cs-set config-store-new "net.port" "80" 1
    in let s6 = cs-add-watch s5 "net." "reload"
    in print-line-uni ("a watch keeps the caller's store: old " & show (s5.cs-watch-count) & "/" & show (list-length (s5.cs-watches)) & ", new " & show (s6.cs-watch-count))
  end
