Chapter: IdentityOps
  cites Foreword chapter Identity

Section: Body

  before-set : Integer -> [Identity] Text
  before-set (x) =
    if current-user /= "" then "FAIL: user before set"
    else if authenticate /= "" then "FAIL: auth before set"
    else "PASS-before"

  after-set : Integer -> [Identity] Text
  after-set (s0) =
    if s0 /= 0 then "FAIL: set returned error"
    else if current-user /= "id:42" then "FAIL: user after set"
    else if authenticate /= "" then "FAIL: auth still locked"
    else "PASS"

  run-ops : Integer -> [Identity] Text
  run-ops (x) =
    if before-set 0 /= "PASS-before" then "FAIL: before-set"
    else after-set (identity-set 0 42)

  opening : [Console, Identity] Nothing = act
    print-line-uni (run-ops 0)
  end
