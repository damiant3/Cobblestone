Chapter: SparkBooleanTest
  cites Math chapter Quaternion
  cites Math chapter Geometry
  cites Spark chapter Mesh
  cites Spark chapter MeshPrimitives
  cites Spark chapter MeshBoolean
  cites Spark chapter MeshOps

Section: Body

  opening : [Console] Nothing = act
    let a = mesh-cube 1.0
    in let u = mesh-union a a
    in let d = mesh-difference a a
    in let i = mesh-intersect a a
    in let b = mesh-translate a (vec3-new 1.0 0.0 0.0)
    in let tu = mesh-union a b
    in let ti = mesh-intersect a b
    in let td = mesh-difference a b
    in act
      print-line-uni ("self-union verts: " & show (u.tm-vert-count))
      print-line-uni ("self-diff verts: " & show (d.tm-vert-count))
      print-line-uni ("self-intersect verts: " & show (i.tm-vert-count))
      print-line-uni ("touch-union verts: " & show (tu.tm-vert-count))
      print-line-uni ("touch-intersect verts: " & show (ti.tm-vert-count))
      print-line-uni ("touch-diff verts: " & show (td.tm-vert-count))
      print-line-uni ("csg-info union: " & csg-info CsgUnion)
      print-line-uni ("csg-info intersect: " & csg-info CsgIntersect)
      print-line-uni ("csg-info difference: " & csg-info CsgDifference)
      print-line-uni "booleans ok"
    end
  end
