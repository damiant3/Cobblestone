Chapter: SparkBooleanTest
  cites Math chapter Quaternion
  cites Math chapter Geometry
  cites Spark chapter Mesh
  cites Spark chapter MeshPrimitives
  cites Spark chapter MeshBoolean

 Tests CSG boolean operations on simple meshes.

Section: Body

  opening : [Console] Nothing = act
    let a = mesh-cube 1000

    let u = mesh-union a a
    in print-line-uni ("self-union verts: " & show (u.tm-vert-count))

    let d = mesh-difference a a
    in print-line-uni ("self-diff verts: " & show (d.tm-vert-count))

    print-line-uni ("csg-info: " & csg-info CsgUnion)
    print-line-uni ("csg-info: " & csg-info CsgIntersect)
    print-line-uni ("csg-info: " & csg-info CsgDifference)
    print-line-uni "booleans ok"
  end
