Chapter: ConsoleTest
  cites Foreword chapter Console
  cites Kernel chapter Console

Section: Entry

  opening : [Console] Nothing =
    let c0 = console-new 7
    in let l1 = "row=" & show (console-row c0) & " col=" & show (console-col c0) & " ready=" & show (console-has-line c0)
    in let c1 = console-write-text c0 "hello"
    in let l2 = "col=" & show (console-col c1)
    in let c2 = console-write-line c1 ""
    in let l3 = "row=" & show (console-row c2) & " col=" & show (console-col c2)
    in let c3 = console-feed-char c2 97
    in let c4 = console-feed-char c3 105
    in let c5 = console-feed-char c4 110
    in let l4 = "buf=" & console-get-line c5 & " col=" & show (console-col c5) & " ready=" & show (console-has-line c5)
    in let c6 = console-feed-backspace c5
    in let c7 = console-feed-char c6 1
    in let l5 = "ready=" & show (console-has-line c7) & " line=" & console-get-line c7
    in let c8 = console-take-line c7
    in let c9 = console-feed-char c8 97
    in let c10 = console-feed-char c9 98
    in let c11 = console-feed-char c10 99
    in let c12 = console-feed-char c11 1
    in let abc-line = console-get-line c12
    in let c13 = console-take-line c12
    in let l6 = "line=" & abc-line & " after=" & console-get-line c13 & " ready=" & show (console-has-line c13)
    in let c14 = console-feed-char c13 97
    in let c15 = console-feed-char c14 105
    in let l7 = "buf=" & console-get-line c15 & " col=" & show (console-col c15)
    in act
      print-line-uni l1
      print-line-uni l2
      print-line-uni l3
      print-line-uni l4
      print-line-uni l5
      print-line-uni l6
      print-line-uni l7
    end

