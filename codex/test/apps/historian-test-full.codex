Chapter: HistorianTestFull
  cites Foreword chapter Console
  cites Works chapter Historian
  cites Works chapter RepoProtocol
  cites Works chapter Annotation

Section: Helpers

  make-signed : Annotation -> SignedAnnotation
  make-signed (ann) = SignedAnnotation { annotation = ann, signature = [], signer-fingerprint = "", verified = False }

Section: Body

  opening : [Console] Nothing = act
    let target = make-target "Core" "eval"
    in let ann1 = create-annotation target Rationale "alice" "initial design" 1000
    in let ann2 = create-annotation target Rationale "bob" "revised design" 2000
    in let r1 = repo-add-annotation repo-empty (make-signed ann1)
    in let r2 = repo-add-annotation r1 (make-signed ann2)
    in let repo = record-supersession r2 (ann1.hash) (ann2.hash)
    in let h = empty-history "hash-a"
    in let history = walk-history repo (ann1.hash)
    in let cyclic = record-supersession repo (ann2.hash) (ann1.hash)
    in let looped = walk-history cyclic (ann1.hash)
    in act
      print-line-uni ("empty-steps=" & show (h.step-count))
      print-line-uni ("walk-steps=" & show (history.step-count))
      print-line-uni ("tip-author=" & history-tip-author history)
      print-line-uni ("author-count=" & show (list-length (history-author-list history)))
      print-line-uni ("cycle-steps=" & show (looped.step-count))
    end
  end
