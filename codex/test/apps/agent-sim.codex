Chapter: AgentSim
  cites Foreword chapter Console
  cites Foreword chapter FactStore
  cites Trust chapter TrustLattice
  cites Trust chapter PolicyEngine
  cites Trust chapter Forensics

Section: Entry

  opening : [Console] Nothing =
    let lat0 = lattice-empty
    in let lat1 = lattice-add-direct lat0 "phone" 6000
    in let lat2 = lattice-add-direct lat1 "captain" 8000
    in let phone-score = lattice-trust-score lat2 "phone"
    in let l1 = "phone trust: " & show phone-score
    in let pol = policy-add-rule (policy-empty "flight-policy") (rule-allow "trusted-autopilot" (TrustAbove 5000))
    in let ctx-phone = PolicyContext { capability = "flight-control", direction = 0, trust-score = phone-score, current-time = 1000, agent-id = "phone" }
    in let dec-phone = eval-policy pol ctx-phone
    in let l2 = "phone flight-control: " & show (dec-phone.allowed) & " via " & dec-phone.matched-rule
    in let captain-score = lattice-trust-score lat2 "captain"
    in let ctx-captain = PolicyContext { capability = "flight-control", direction = 0, trust-score = captain-score, current-time = 1000, agent-id = "captain" }
    in let dec-captain = eval-policy pol ctx-captain
    in let l3 = "captain flight-control: " & show (dec-captain.allowed) & " via " & dec-captain.matched-rule
    in let unknown-score = lattice-trust-score lat2 "unknown"
    in let ctx-unknown = PolicyContext { capability = "flight-control", direction = 0, trust-score = unknown-score, current-time = 1000, agent-id = "unknown" }
    in let dec-unknown = eval-policy pol ctx-unknown
    in let l4 = "unknown flight-control: " & show (dec-unknown.allowed) & " (insufficient authorization)"
    in let c0 = chain-empty "captain" 2000
    in let c1 = chain-add-percept c0 "altimeter" 95
    in let c2 = chain-add-belief c1 "altitude-safe" 90 [0]
    in let c3 = chain-add-policy c2 "autopilot-ok" True "flight-deck"
    in let c4 = chain-add-action c3 "engage" "autopilot" "success"
    in let c5 = chain-set-summary c4 "Altitude verified, autopilot engaged by captain-agent."
    in let l5 = render-chain c5
    in let fs0 = fact-store-empty
    in let f1 = fact-create DefinitionFact "altitude=35000ft" "captain" 2000
    in let fs1 = fact-store fs0 f1
    in let f2 = fact-create DefinitionFact "autopilot=engaged" "captain" 2001
    in let fs2 = fact-store fs1 f2
    in let l6 = "facts stored: " & show (fact-count fs2)
    in act
      print-line-uni l1
      print-line-uni l2
      print-line-uni l3
      print-line-uni l4
      print-line-uni l5
      print-line-uni l6
    end

