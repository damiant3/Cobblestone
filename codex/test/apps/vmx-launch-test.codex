Chapter: VmxLaunchTest
  cites Codex chapter General
  cites Works chapter DevHypervisor

Section: Body

  opening : [Console] Nothing = act
   let hlt-code = [244]
   in let cfg = GuestConfig { entry-point = guest-entry-point, memory-mb = 4 }
   in let result = vm-setup-and-launch cfg vmx-read-revision-id hlt-code
   in act
    print-line (when result
      is VmHalted -> "guest:halted"
      is VmIoExit (info) -> "guest:io port=" & show (vm-exit-io-port info)
      is VmCrashed (info) -> "guest:crashed " & format-exit-info info)
   end
  end

