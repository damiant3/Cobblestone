Chapter: AppDigitParse
  cites Cvmm chapter Calculator (text-to-int)
  cites Workflow chapter WorkflowEngine (parse-int-loop)
  cites Market chapter MarketCatalog (text-to-slug)

Section: Entry
  opening : [Console] Nothing
  opening = act
   print-line-uni ("calculator -42 -> " & show (text-to-int "-42"))
   print-line-uni ("workflow 123 -> " & show (parse-int-loop "123" 0 3 0))
   print-line-uni ("market slug -> " & text-to-slug "Red Dice 42")
  end
