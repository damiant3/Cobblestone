Chapter: CpuDebugWatchTest

 DR7 = L0 (bit 0) | RW0 = 01, break on write (bits 16-17) | LEN0 = 11,
 four bytes (bits 18-19): 1 + 65536 + 786432 = 851969 (Intel SDM vol. 3B
 18.2.4). The #DB handler counts a hit at 36360 and records DR6 at 36368
 and the RIP at 36376. The count is read as a DELTA because nothing zeroes
 the cell for a test.

 We say:

Section: Body

  opening : [Console] Nothing = act
    let watched = alloc-bytes 16
    in let other = alloc-bytes 16
    in let c0 = peek-32 36360 0
    in let a = cpu-write-dr0 watched
    in let b = cpu-write-dr6 0
    in let c = cpu-write-dr7 851969
    in let w1 = poke-32 watched 0 7
    in let c1 = peek-32 36360 0
    in let dr6-seen = peek-32 36368 0
    in let rip-seen = peek-32 36376 0
    in let w2 = poke-32 other 0 9
    in let c2 = peek-32 36360 0
    in let off = cpu-write-dr7 0
    in let w3 = poke-32 watched 0 11
    in let c3 = peek-32 36360 0
    in let v = peek-32 watched 0
    in act
      print-line-uni ("a write to the watched cell is one hit: " & show (c1 - c0 == 1))
      print-line-uni ("dr6 names breakpoint 0: " & show (bit-and dr6-seen 1 == 1))
      print-line-uni ("a hit records a code address: " & show (rip-seen > 0))
      print-line-uni ("a write elsewhere is no hit: " & show (c2 == c1))
      print-line-uni ("disarmed, the watched cell is no hit: " & show (c3 == c2))
      print-line-uni ("the program resumed and the writes landed: " & show (v == 11))
    end
  end

