Chapter: PriorityQueueTest
  cites Codex chapter General
  cites Foreword chapter PriorityQueue

Section: Tests
  test-empty : Text =
    "count=" & show (pq-count pq-empty)

  test-insert-count : Text =
    let q = pq-insert (pq-insert (pq-insert pq-empty 3 300) 1 100) 2 200
    in "count=" & show (pq-count q)

  test-pop-min : Text =
    let q = pq-insert (pq-insert (pq-insert pq-empty 3 300) 1 100) 2 200
    in let r = pq-pop q
    in "pri=" & show (r.entry.priority) & " val=" & show (r.entry.value) & " remaining=" & show (pq-count (r.queue))

  test-pop-order : Text =
    let q = pq-insert (pq-insert (pq-insert pq-empty 5 50) 2 20) 8 80
    in let r1 = pq-pop q
    in let r2 = pq-pop (r1.queue)
    in let r3 = pq-pop (r2.queue)
    in "order=" & show (r1.entry.priority) & " " & show (r2.entry.priority) & " " & show (r3.entry.priority)

  opening : [Console] Nothing = act
    print-line-uni test-empty
    print-line-uni test-insert-count
    print-line-uni test-pop-min
    print-line-uni test-pop-order
  end
