Chapter: ShellClarifierTest
  cites Works chapter ShellClarifier
  cites OS chapter ShellCore
  cites OS chapter ProgramRegistry
  cites OS chapter Clarifier
  cites Trust chapter TrustLattice
  cites Trust chapter PolicyEngine
  cites Foreword chapter FactStore
  cites Foreword chapter Sha256
  cites Foreword chapter Maybe
  cites Foreword chapter Hamt

Section: Tests
  test-trust-fail-child : Text =
    let result = CmdResult { output = "denied: trust score 0 below threshold 5000", new-state = shell-init (policy-empty "test") 100, success = False }
    in "trust-fail-child: " & clarify-cmd-result result Child

  test-trust-fail-formal : Text =
    let result = CmdResult { output = "denied: trust score 0 below threshold 5000", new-state = shell-init (policy-empty "test") 100, success = False }
    in "trust-fail-formal: " & clarify-cmd-result result Formal

  test-not-found-child : Text =
    let result = CmdResult { output = "not found: missing", new-state = shell-init (policy-empty "test") 100, success = False }
    in "not-found-child: " & clarify-cmd-result result Child

  test-not-found-formal : Text =
    let result = CmdResult { output = "not found: missing", new-state = shell-init (policy-empty "test") 100, success = False }
    in "not-found-formal: " & clarify-cmd-result result Formal

  test-bad-binary-child : Text =
    let result = CmdResult { output = "denied: bad binary format", new-state = shell-init (policy-empty "test") 100, success = False }
    in "bad-binary-child: " & clarify-cmd-result result Child

  opening : [Console] Nothing = act
    print-line-uni test-trust-fail-child
    print-line-uni test-trust-fail-formal
    print-line-uni test-not-found-child
    print-line-uni test-not-found-formal
    print-line-uni test-bad-binary-child
  end
