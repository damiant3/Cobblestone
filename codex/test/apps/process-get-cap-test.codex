Chapter: ProcessGetCapTest
  cites Codex chapter General

Section: Body
  check-cap : Integer, Integer -> Integer
  check-cap (caps) (bit) =
    bit-and caps (bit-shl 1 bit)

  opening : Integer =
    let pid = process-get-pid
    in let caps-before = process-get-cap pid
    in let has-block = check-cap caps-before 10
    in let r1 = process-restrict-cap pid 10
    in let caps-after = process-get-cap pid
    in let lost-block = check-cap caps-after 10
    in let bad = process-get-cap 99
    in if has-block > 0 then (if lost-block == 0 then (if bad == (0 - 1) then 1 else 0) else 0) else 0
