Chapter: CapabilityAuditTest
  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Trust chapter CapabilityAudit

Section: Entry

  opening : [Console] Nothing =
    let a0 = audit-empty
    in let l1 = "count=" & show (audit-count a0)
    in let a1 = audit-grant a0 "foo" 1 100
    in let a2 = audit-install a1 "foo" 7 200
    in let a3 = audit-grant a2 "foo" 4 300
    in let l2 = "count=" & show (audit-count a3) & " grants=" & show (audit-grants-for a3 "foo")
    in let a4 = audit-revoke a3 "foo" 1 400
    in let a5 = audit-revoke a4 "foo" 4 500
    in let l3 = "revokes=" & show (audit-revokes-for a5 "foo") & " grants=" & show (audit-grants-for a5 "bar")
    in let a6 = audit-revoke a5 "foo" 2 600
    in let last-entry = audit-last a6
    in let l4 = when last-entry is Just (e) -> format-entry e is None -> "none"
    in let b0 = audit-grant audit-empty "alpha" 1 10
    in let b1 = audit-grant b0 "alpha" 2 20
    in let b2 = audit-grant b1 "beta" 3 30
    in let b3 = audit-revoke b2 "beta" 3 40
    in let l5 = "alpha-grants=" & show (audit-grants-for b3 "alpha") & " beta-grants=" & show (audit-grants-for b3 "beta") & " beta-revokes=" & show (audit-revokes-for b3 "beta")
    in let c0 = audit-grant audit-empty "x" 1 10
    in let c1 = audit-revoke c0 "x" 1 20
    in let l6 = format-audit-summary c1
    in act
      print-line-uni l1
      print-line-uni l2
      print-line-uni l3
      print-line-uni l4
      print-line-uni l5
      print-line-uni l6
    end

