Chapter: CvmmScheduleZoned
  cites Cvmm chapter TaskScheduler
  cites Foreword chapter TzRules
  cites Foreword chapter TzSource
  cites Foreword chapter TzCompile
  cites Foreword chapter TimeZone
  cites Foreword chapter Console

 A daily 01:30 in Europe/London from noon UTC the day before each of the
 two 2026-27 transitions, under each choice, and a weekly Sunday 01:30; the
 same daily schedule over UTC, which used to answer now + 86400 whatever its
 hour.

Section: Body

  runs : Zone, Integer, Text -> Text
  runs (z) (now) (label) =
    label & " after-gap " & show (sched-next-run-in z AfterGap (SchedDaily 1 30) now)
      & " earlier " & show (sched-next-run-in z Earlier (SchedDaily 1 30) now)
      & " later " & show (sched-next-run-in z Later (SchedDaily 1 30) now)
      & " refuse " & show (sched-next-run-in z Refuse (SchedDaily 1 30) now)

  opening : [Console] Nothing =
    let db = tz-parse tz-sources
    in when zone-from-db db "Europe/London"
      is None -> print-line-uni "london missing"
      is Just (z) -> act
        print-line-uni (runs z 1792843200 "fall-back")
        print-line-uni (runs z 1806148800 "spring-forward")
        print-line-uni ("weekly sunday " & show (sched-next-run-in z AfterGap (SchedWeekly 0 1 30) 1792584000))
        print-line-uni ("utc daily 01:30 from 2026-10-24 12:00 " & show (sched-next-run (SchedDaily 1 30) 1792843200))
      end