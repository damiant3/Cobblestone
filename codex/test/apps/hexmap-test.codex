Chapter: HexMapTest
  cites Game chapter HexMap

Section: Tests
  test-distance : Text =
    let a = hex-coord 0 0
    in let b = hex-coord 2 1
    in "dist=" & show (hex-distance a b)

  test-neighbors : Text =
    let ns = hex-neighbors (hex-coord 0 0)
    in "count=" & show (list-length ns) & " " & format-hex-list ns

  test-ring1 : Text =
    let r = hex-ring (hex-coord 0 0) 1
    in "ring1=" & show (list-length r)

  test-ring2 : Text =
    let r = hex-ring (hex-coord 0 0) 2
    in "ring2=" & show (list-length r)

  test-line : Text =
    let pts = hex-line (hex-coord 0 0) (hex-coord 3 0)
    in "line=" & show (list-length pts) & " " & format-hex-list pts

  test-spiral : Text =
    let s = hex-spiral (hex-coord 0 0) 1
    in "spiral=" & show (list-length s)

  test-grid : Text =
    let g0 = hex-grid-new 5 0
    in let g1 = hex-grid-set g0 (hex-coord 1 0) 42
    in let g2 = hex-grid-set g1 (hex-coord 0 (0 - 1)) 99
    in let v1 = hex-grid-get g2 (hex-coord 1 0)
    in let v2 = hex-grid-get g2 (hex-coord 0 (0 - 1))
    in let empty = hex-grid-get g2 (hex-coord 3 3)
    in "val1=" & show v1 & " val2=" & show v2 & " empty=" & show empty

  test-s : Text =
    "s=" & show (hex-s (hex-coord 2 (0 - 1)))

  opening : [Console] Nothing = act
    print-line-uni test-distance
    print-line-uni test-neighbors
    print-line-uni test-ring1
    print-line-uni test-ring2
    print-line-uni test-line
    print-line-uni test-spiral
    print-line-uni test-grid
    print-line-uni test-s
  end
