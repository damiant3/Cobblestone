Chapter: FactStoreTest
  cites Codex chapter General
  cites Foreword chapter FactStore
  cites Foreword chapter Maybe

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Setup
  f1 : Fact = fact-create DefinitionFact "x = 42" "alice" 1000
  f2 : Fact = fact-create VouchFact "trust bob" "alice" 2000
  s0 : BareFactStore = fact-store-empty
  s1 : BareFactStore = fact-store s0 f1
  s2 : BareFactStore = fact-store s1 f2
  s3 : BareFactStore = fact-store s2 f1

Section: Tests
  test-count-empty : Text = show (fact-count s0)
  test-count-one : Text = show (fact-count s1)
  test-count-two : Text = show (fact-count s2)
  test-count-dup : Text = show (fact-count s3)
  test-has-yes : Text = show-bool (fact-has s2 (f1.hash))
  test-has-no : Text = show-bool (fact-has s2 "nonexistent")
  test-load : Text =
    let loaded = fact-load s2 (f1.hash)
    in when loaded
      is Just (f) -> f.content
      is None -> "missing"
  test-replay : Text = show-bool ((fact-store-if-new s2 f1).was-new)
  test-new : Text =
    let f3 = fact-create DefinitionFact "y = 99" "bob" 3000
    in show-bool ((fact-store-if-new s2 f3).was-new)
  test-kind-def : Text = fact-kind-name DefinitionFact
  test-kind-vouch : Text = fact-kind-name VouchFact

  opening : [Console] Nothing = act
    print-line-uni test-count-empty
    print-line-uni test-count-one
    print-line-uni test-count-two
    print-line-uni test-count-dup
    print-line-uni test-has-yes
    print-line-uni test-has-no
    print-line-uni test-load
    print-line-uni test-replay
    print-line-uni test-new
    print-line-uni test-kind-def
    print-line-uni test-kind-vouch
  end
