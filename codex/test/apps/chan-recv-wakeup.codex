Chapter: ChanRecvWakeup

Section: Body

  consumer : Integer -> [Console, Concurrent] Integer
  consumer (ch) = act
    x <- (chan-kern-recv-block ch)
    x
  end

  producer : Integer -> [Console, Concurrent] Integer
  producer (ch) = act
    a <- (chan-kern-send-block ch 42)
    a
  end

  opening : [Console, Concurrent] Nothing = act
    ch <- chan-kern-create 1
    c <- process-spawn (\z -> consumer ch)
    p <- process-spawn (\z -> producer ch)
    wc <- (process-wait c)
    wp <- (process-wait p)
    print-line-uni "rdone"
  end
