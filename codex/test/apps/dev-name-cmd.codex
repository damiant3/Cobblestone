Chapter: DevNameCmdTest
  cites Works chapter DevConsole
  cites Works chapter DevConsoleBoot
  cites Works chapter DevConsoleMenu
  cites Works chapter UefiConsole
  cites Works chapter KeyManager
  cites Kernel chapter DiskFacts
  cites Foreword chapter FactStore
  cites Foreword chapter Sha256

 WHY NO BREAKPOINT IS EVER SUCCESSFULLY SET HERE. `bp-add-symbolic` finds
 the symbol in the embedded MAP1 and then calls `bp-add`, which writes
 0xCC over the first byte of that function. In a test that is not a
 breakpoint, it is self-corruption: the program under test would patch its
 own running code to prove a menu item works.

 We say:

Section: Fixtures

  bare-console : UefiConsoleState
  bare-console = UefiConsoleState {
    sys-table = 0,
    con-out = 0,
    con-in = 0,
    rows = 25,
    cols = 80,
    cursor-row = 0,
    cursor-col = 0
  }

  bare-disk : DiskFactStore
  bare-disk = DiskFactStore { superblock = empty-superblock, mem = fact-store-empty, base = 0, limit = 0 }

  bare-keys : Keypair
  bare-keys = generate-keypair (sha256 (text-to-bytes "codex-dev-name-cmd-test"))

Section: Reporting

  report : Text, DevConsoleState -> [Console] Nothing
  report (label) (s) = act
    print-line-uni (label & ": " & s.status)
  end

Section: Body

  opening : [Console, Device.Port, Device.Block] Nothing = act
    let raw = dev-console-init bare-console bare-disk bare-keys
    in let s0 = __record-set raw "source-index" index-full-dev-surface
    in let d0 = dispatch-main-menu "debug" s0
    in act

      at <- handle-console-input d0 "heap-base + 0x40"
      report "cursor-set" at

      s1 <- handle-console-input at "sym"
      report "sym-armed" s1

      s2 <- handle-console-input s1 "parse"
      report "sym-found" s2

      s3 <- handle-console-input s2 "$"
      report "cursor-after-sym" s3

      s4 <- handle-console-input s3 "sym"
      report "sym-armed-again" s4

      s5 <- handle-console-input s4 "zzz-no-such-symbol"
      report "sym-not-found" s5

      b0 <- handle-console-input s5 "bp-add"
      report "bp-armed" b0

      b1 <- handle-console-input b0 "zzz-no-such-function"
      report "bp-name-reached-lookup" b1

      b2 <- handle-console-input b1 "$"
      report "cursor-after-bp" b2

      e0 <- handle-console-input b2 "$ + 1"
      report "expressions-work-again" e0
    end
  end
