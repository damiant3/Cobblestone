-- mirror off --
quiet: Perf counters
-- turning it on --
cmd: serial.on
status: serial mirror ON
armed: serial mirror ON
flag-after-on: True
-- mirror on --
cmd: idt.counts
status: interrupt counters
mirrored: interrupt counters
-- turning it off --
cmd: serial.off
status: serial mirror off
disarmed: serial mirror off
flag-after-off: False
-- mirror off again --
quiet-again: Perf counters
assembled: [mem] matches-literal: True
control-dropped: [mem] matches-literal: True
remote-default-off: False
