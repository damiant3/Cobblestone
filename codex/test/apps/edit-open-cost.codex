Chapter: EditOpenCostTest
  cites Works chapter GopDesk
  cites Works chapter GopEdit
  cites Works chapter GopFiles
  cites Works chapter GopFat16
  cites Foreword chapter Fat16
  cites Foreword chapter Console

 What the Edit pane's `-open` allocates, part by part, which is what a D.5
 hole for Edit would have to hold.

 `ged-init`'s five blocks are fixed: `alloc-zeroed` advances by the size plus
 the alignment, so the sum is a constant the arm holds the reading to rather
 than a recorded number. The list mode keeps a count (`gfl-count-cur`), whose
 cost must be the same at the root and in a subdirectory; the whole listing it
 replaced is the data-dependent control.

 THE FIRST LINE IS THE CONTROL. `alloc-bytes 0` answers the frontier without
 advancing it, so two reads with nothing between must differ by zero (L-FALSIF).
 THE SECOND CONTROL is the listing at two directories: an arm that cannot read
 a difference there cannot call the rest constant.

Section: Body

  eoc-yn : Boolean -> Text
  eoc-yn (v) = if v then "PASS" else "FAIL"

  eoc-init-bytes : Integer =
    ged-cap + 64 + ged-max-lines * 4 + 64 + ged-undo-cap * ged-undo-rec + 64 + ged-marks-bytes + 64 + (ged-chap-max + 1) * 4 + 64

Section: Entry

  opening : [Console, Device.Port] Nothing = act
    let c0 = alloc-bytes 0
    in let c1 = alloc-bytes 0
    in let es = alloc-zeroed 192 16
    in act
      print-line-uni ("CONTROL, the probe allocates nothing: " & eoc-yn (c1 - c0 == 0))
      let g0 = alloc-bytes 0
      in act
      start <- gpt-esp-start
      let g1 = alloc-bytes 0
      in let r = __heap-restore g0
      in let m0 = alloc-bytes 0
      in act
      m <- gfat-mount-at start
      let m1 = alloc-bytes 0
      in let i0 = alloc-bytes 0
      in let a = ged-ensure es
      in let i1 = alloc-bytes 0
      in let again = ged-ensure es
      in let i2 = alloc-bytes 0
      in act
      print-line-uni ("the GPT lookup costs " & integer-to-text (g1 - g0))
      print-line-uni ("the mount after it costs " & integer-to-text (m1 - m0))
      print-line-uni ("ged-init costs " & integer-to-text (i1 - i0) & ", the fixed sum " & integer-to-text eoc-init-bytes & ": " & eoc-yn (i1 - i0 == eoc-init-bytes))
      print-line-uni ("a second ged-ensure allocates nothing: " & eoc-yn (i2 - i1 == 0))
      let es2 = alloc-zeroed 192 16
      in let o0 = alloc-bytes 0
      in act
      sb <- ged-build start es2
      let o1 = alloc-bytes 0
      in act
      print-line-uni ("the open in the hole costs " & integer-to-text (o1 - o0) & ", want " & integer-to-text desk-edit-want & ", a page to spare: " & eoc-yn (desk-edit-want - (o1 - o0) >= 4096 & sb.ed-mode == ged-mode-list & ged-init-bytes == eoc-init-bytes))
      if m.gm-ok == False then print-line-uni "mount FAILED"
      else act
        let vol = m.gm-vol
        in let flag = if gfat-is32 vol then vol.vol-root-start else 0 - 1
        in let clusters = [flag]
        in let a0 = alloc-bytes 0
        in act
          ents <- gfl-list-cur vol clusters
          let a1 = alloc-bytes 0
          in let k0 = alloc-bytes 0
          in act
          n0 <- gfl-count-cur vol clusters
          let k1 = alloc-bytes 0
          in let st = EditState { ed-vol = vol, ed-count = n0, ed-clusters = clusters, ed-names = [], ed-path = "", ed-sel = 0, ed-top = 0, ed-mode = ged-mode-list, ed-etop = 0, ed-cur = 0, ed-col = 0, ed-mods = 0, ed-ptr = 0 }
          in let a2 = alloc-bytes 0
          in act
            d <- gfat-resolve vol "EFI"
            when d
              is None -> print-line-uni "EFI not found"
              is Just (de) -> act
                let cl2 = [flag, de.de-cluster]
                in let b0 = alloc-bytes 0
                in act
                  e2 <- gfl-list-cur vol cl2
                  let b1 = alloc-bytes 0
                  in let q0 = alloc-bytes 0
                  in act
                  n1 <- gfl-count-cur vol cl2
                  let q1 = alloc-bytes 0
                  in act
                    print-line-uni ("the EditState record costs " & integer-to-text (a2 - k1))
                    print-line-uni ("the listing at the root: " & integer-to-text (a1 - a0) & " for " & integer-to-text (list-length ents) & " entries")
                    print-line-uni ("the listing in a subdirectory: " & integer-to-text (b1 - b0) & " for " & integer-to-text (list-length e2) & " entries")
                    print-line-uni ("the count at the root: " & integer-to-text (k1 - k0) & ", in a subdirectory: " & integer-to-text (q1 - q0) & ", the same: " & eoc-yn (k1 - k0 == q1 - q0) & ", matching the listings: " & eoc-yn (n0 == list-length ents & n1 == list-length e2))
                    print-line-uni ("CONTROL, the listing differs by directory: " & eoc-yn (b1 - b0 /= a1 - a0 & st.ed-mode == ged-mode-list))
                  end
                  end
                end
            end
          end
          end
        end
      end
      end
      end
      end
      end
      end
    end
  end
