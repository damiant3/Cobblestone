Chapter: PerlinTest
  cites Codex chapter General
  cites Signal chapter Perlin

Section: Tests
  test-hash : Text =
    "h0=" & show (perlin-hash 0) & " h1=" & show (perlin-hash 1) & " h42=" & show (perlin-hash 42)

  test-hash-deterministic : Text =
    let a = perlin-hash 100
    in let b = perlin-hash 100
    in "same=" & if a == b then "True" else "False"

  test-hash2 : Text =
    "h00=" & show (perlin-hash2 0 0) & " h10=" & show (perlin-hash2 1 0) & " h01=" & show (perlin-hash2 0 1)

  test-noise-range : Text =
    let v = perlin-noise2 500 500
    in "in-range=" & if v >= (0 - 1500) then if v <= 1500 then "True" else "False" else "False"

  opening : [Console] Nothing = act
    print-line-uni test-hash
    print-line-uni test-hash-deterministic
    print-line-uni test-hash2
    print-line-uni test-noise-range
  end
