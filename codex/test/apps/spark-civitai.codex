Section: Output

  cvt-row : LoraResult -> Text
  cvt-row (r) = "R " & r.lr-name & "|" & r.lr-base & "|" & show (r.lr-downloads) & "|" & show (r.lr-rating-tenths) & "|" & r.lr-tags & "|" & r.lr-trigger & "|" & r.lr-thumb & "|" & r.lr-download & "|" & r.lr-file & "|" & (if r.lr-sdxl then "1" else "0") & "|" & r.lr-page & "\n"

  cvt-rows : List LoraResult, Integer, Text -> Text
  cvt-rows (rs) (i) (acc) = if i >= list-length rs then acc else cvt-rows rs (i + 1) (acc & cvt-row (list-at rs i))

  cvt-paths : List Text, Integer, Text -> Text
  cvt-paths (qs) (i) (acc) = if i >= list-length qs then acc else cvt-paths qs (i + 1) (acc & "U " & civitai-search-path (list-at qs i) False & "\nU " & civitai-search-path (list-at qs i) True & "\n")

  cvt-searches : List Text, Integer, Text -> Text
  cvt-searches (ss) (i) (acc) =
    if i >= list-length ss then acc
    else let rs = civitai-search-results (list-at ss i)
    in cvt-searches ss (i + 1) (acc & "S " & show (i + 1) & " " & show (list-length rs) & "\n" & cvt-rows rs 0 "")

  cvt-hashes : List Text, Integer, Text -> Text
  cvt-hashes (hs) (i) (acc) = if i >= list-length hs then acc else cvt-hashes hs (i + 1) (acc & "H " & show (i + 1) & " " & civitai-trigger-words (list-at hs i) & "\n")

  opening : [Console] Nothing = act
    print-line (cvt-paths [civ-query-0, civ-query-1, civ-query-2, civ-query-3, civ-query-4, civ-query-5, civ-query-6] 0 "" & "U " & civitai-hash-path "0A1B2C3D4E" & "\n" & cvt-searches [civ-search-1, civ-search-2, civ-search-3, civ-search-4, civ-search-5, civ-search-6, civ-search-7, civ-search-8] 0 "" & cvt-hashes [civ-hash-1, civ-hash-2, civ-hash-3, civ-hash-4, civ-hash-5, civ-hash-6, civ-hash-7] 0 "")
  end
