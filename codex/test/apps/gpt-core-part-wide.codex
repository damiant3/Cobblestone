Chapter: GptCorePartWide
  cites Foreword chapter Gpt
  cites Foreword chapter Maybe

 Entry 0's EndingLBA 2^63-1, both CRCs recomputed. A partition ending past the
 medium is refused with the table, so no consumer adds to that end. Fixture from
 build/mint-gpt-core-fixtures.ps1.

 We say:

Section: Body

  esp-of : GptDisk -> Text
  esp-of (d) =
    when gpt-find-by-type d gpt-esp-type-guid
      is None -> "none"
      is Just (p) -> show (p.gp-start-lba)

  describe : Maybe GptDisk -> Text
  describe (g) =
    when g
      is None -> "gpt none"
      is Just (d) -> "gpt parts=" & show (d.gd-partition-count) & " esp=" & esp-of d

  opening : [Console, Device.Block] Nothing
  opening = act
    g <- gpt-read
    print-line-uni (describe g)
  end