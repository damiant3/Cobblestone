Chapter: SafeTensorsFp8
  cites AI chapter SafeTensors
  cites Foreword chapter Console

Section: Arms

  e4 : Text, Integer -> Text
  e4 (label) (b) = "e4m3 " & label & " " & show (st-f8e4m3-to-fixed b)

  e5 : Text, Integer -> Text
  e5 (label) (b) = "e5m2 " & label & " " & show (st-f8e5m2-to-fixed b)

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("dtype " & show (st-parse-dtype "F8_E4M3") & " " & show (st-parse-dtype "F8_E5M2") & " " & show (st-parse-dtype "F8_E3M4"))
    print-line-uni (e4 "zero" 0)
    print-line-uni (e4 "sub-min" 1)
    print-line-uni (e4 "sub-max" 7)
    print-line-uni (e4 "norm-min" 8)
    print-line-uni (e4 "one" 56)
    print-line-uni (e4 "one-half" 60)
    print-line-uni (e4 "minus-one" 184)
    print-line-uni (e4 "max" 126)
    print-line-uni (e4 "minus-max" 254)
    print-line-uni (e4 "nan" 127)
    print-line-uni (e4 "minus-nan" 255)
    print-line-uni (e5 "one" 60)
    print-line-uni (e5 "one-half" 62)
    print-line-uni (e5 "max" 123)
    print-line-uni (e5 "inf" 124)
    print-line-uni (e5 "minus-inf" 252)
    print-line-uni (e5 "nan" 125)
    print-line-uni (e5 "sub" 3)
  end