Chapter: SystemInfoTest
  cites Observe chapter SystemInfo
  cites OS chapter ShellCore
  cites OS chapter ProgramRegistry
  cites Trust chapter TrustLattice
  cites Trust chapter PolicyEngine
  cites Foreword chapter FactStore
  cites Foreword chapter Sha256
  cites Foreword chapter Maybe
  cites Foreword chapter Hamt

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Body
  opening : [Console] Nothing =
    let policy0 = policy-empty "test-os"
    in let state0 = shell-init policy0 200
    in let r0 = gather-report state0
    in let line1 = format-report r0
    in let policy1 = policy-add-rule (policy-empty "codex-os") (rule-allow "allow-all" AlwaysTrue)
    in let reg1 = ProgramRegistry { programs = hamt-set hamt-empty "test" (ProgramEntry { name = "test", content-hash = "abc", author-key = "k", cap-bitmask = 0, cap-count = 0 }), count = 1 }
    in let state1 = ShellState { registry = reg1, lattice = lattice-empty, policy = policy1, store = fact-store-empty, fuel = 200 }
    in let r1 = gather-report state1
    in let lines = format-report-lines r1
    in act
      print-line-uni line1
      print-line-uni ("programs=" & show (report-program-count r1) & " healthy=" & show-bool (report-is-healthy r1) & " identity=" & show-bool (report-has-identity r1))
      print-line-uni ("lines=" & show (list-length lines) & " l0=" & list-at lines 0 & " l4=" & list-at lines 4)
    end

