Chapter: SystemInfoTest
  cites Observe chapter SystemInfo
  cites OS chapter ShellCore
  cites OS chapter ProgramRegistry
  cites Trust chapter TrustLattice
  cites Trust chapter PolicyEngine
  cites Foreword chapter FactStore
  cites Foreword chapter Sha256
  cites Foreword chapter Maybe
  cites Foreword chapter Hamt

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Body

  state-empty : ShellState
  state-empty = shell-init (policy-empty "test-os") 200

  state-installed : ShellState
  state-installed =
    let policy1 = policy-add-rule (policy-empty "codex-os") (rule-allow "allow-all" AlwaysTrue)
    in let reg1 = ProgramRegistry { programs = hamt-set hamt-empty "test" (ProgramEntry { name = "test", content-hash = "abc", author-key = "k", cap-bitmask = 0, cap-count = 0 }), count = 1 }
    in ShellState { registry = reg1, lattice = lattice-empty, policy = policy1, store = fact-store-empty, fuel = 200 }

  summary-line : SystemReport -> Text
  summary-line (r) =
    "programs=" & show (report-program-count r) & " healthy=" & show-bool (report-is-healthy r) & " identity=" & show-bool (report-has-identity r)

  lines-line : SystemReport -> Text
  lines-line (r) =
    let lines = format-report-lines r
    in "lines=" & show (list-length lines) & " l0=" & list-at lines 0 & " l4=" & list-at lines 4

  opening : [Console, Identity] Nothing = act
    r0 <- gather-report state-empty
    r1 <- gather-report state-installed
    print-line-uni (format-report r0)
    print-line-uni (summary-line r1)
    print-line-uni (lines-line r1)
  end

