Chapter: SourceConcatTest
  cites Works chapter SourceConcat
  cites Foreword chapter Console

  nl : Text
  nl = "\n"

  join-all : List Text, Integer, Text -> Text
  join-all (xs) (i) (acc) =
    if i >= list-length xs then acc
    else join-all xs (i + 1) (if i == 0 then list-at xs i else acc & "," & list-at xs i)

  opening : [Console] Nothing =
    let src = "Chapter: Lexer" & nl & "  cites Foreword chapter Maybe" & nl & "  f = 1"
    in let cited = "Chapter: X" & nl & "  cites Foreword chapter CCE (cce-to-unicode-table)" & nl & "  cites Works chapter VmCompile" & nl & "  cites Foreword chapter Sha256" & nl & "  cites Foreword chapter Fat_16-b2." & nl & "  cites Foreword chapter " & nl & "  The Foreword chapter Console and its friends."
    in act
      print-line-uni ("no quire    : " & show (rename-chapter-header src "" == src))
      print-line-uni ("renamed     : " & join-all (text-split (rename-chapter-header src "Works") nl) 0 "")
      print-line-uni ("join        : [" & join-lines ["a", "b", "c"] 0 3 "" & "] [" & join-lines [] 0 0 "" & "]")
      print-line-uni ("cites       : " & join-all (extract-foreword-cites cited) 0 "")
      print-line-uni ("no cites    : " & show (list-length (extract-foreword-cites "Chapter: Y")))
      print-line-uni ("identifier  : [" & take-identifier "Ab-9_z rest" 0 11 "" & "] [" & take-identifier " x" 0 2 "" & "]")
      print-line-uni ("has         : " & show (list-has-text ["a", "b"] "b" 0 2) & " " & show (list-has-text ["a", "b"] "c" 0 2) & " " & show (list-has-text [] "a" 0 0))
      print-line-uni ("merge       : " & join-all (merge-unique ["a"] ["b", "a", "c", "b"] 0 4) 0 "")
      print-line-uni "done"
    end

