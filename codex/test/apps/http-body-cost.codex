Chapter: HttpBodyCost
  cites Net chapter HttpClient
  cites Foreword chapter Console

 We say:

Section: Fixtures

  head : List Integer = [72, 84, 84, 80, 47, 49, 46, 49, 32, 50, 48, 48, 32, 79, 75, 13, 10, 13, 10]

  response-of : Integer -> List Integer
  response-of (n) = head & fill n 0 (__list-with-capacity (n + 1))

  fill : Integer, Integer, List Integer -> List Integer
  fill (n) (i) (acc) =
    if i >= n then acc
    else fill n (i + 1) (list-push acc 97)

Section: Measurement

  retained : List Integer -> Integer
  retained (bs) =
    let b = __heap-save
    in let len = (http-parse-response bs).content-length
    in let a = __heap-save
    in (a - b) + len - len

  verdict : Integer, Integer -> Text
  verdict (at-n) (at-4n) =
    if at-n <= 0 then "unmeasured"
    else if at-4n < at-n * 8 then "linear" else "quadratic"

Section: Entry

  opening : [Console] Nothing = act
    let small = response-of 1024
    in let large = response-of 4096
    in let big = response-of 262144
    in let r = http-parse-response (head & [104, 105, 9, 33])
    in act
      print-line-uni ("status=" & show (r.status-code) & " body=" & r.body & " len=" & show (r.content-length))
      print-line-uni ("growth=" & verdict (retained small) (retained large))
      print-line-uni ("big-len=" & show ((http-parse-response big).content-length))
    end
  end
