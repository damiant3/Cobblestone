Chapter: Lz77Hostile
  cites Compress chapter Lz77

Section: Helpers

  list-equal : List Integer, List Integer, Integer, Integer -> Boolean
  list-equal (a) (b) (i) (len) =
    if i >= len then True
    else if list-at a i == list-at b i then list-equal a b (i + 1) len
    else False

  check-rt : List Integer, Text -> Text
  check-rt (input) (label) =
    let compressed = lz77-compress input
    in let decompressed = lz77-decompress compressed
    in let ok = if list-length decompressed == list-length input then list-equal input decompressed 0 (list-length input) else False
    in label & "=" & if ok then "pass" else "fail"

  make-repeated : Integer, Integer, Integer, List Integer -> List Integer
  make-repeated (val) (n) (i) (acc) =
    if i >= n then acc
    else make-repeated val n (i + 1) (list-push acc val)

  show-decode : List Integer, Text -> Text
  show-decode (tokens) (label) =
    let out = lz77-decompress tokens
    in label & " len=" & show (list-length out) & " first=" & (if list-length out == 0 then "none" else show (list-at out 0))

 Rows 8 and 9 are the output-cap layer. Row 8 is a seeded single-byte mutation
 sweep over a token stream this encoder wrote, each position flipped and decoded
 under a cap, every decode required to stop bounded. Row 9 decodes under a cap far
 below the output and requires the cap to have limited it.

  mutate-copy : List Integer, Integer, Integer, Integer, Integer, List Integer -> List Integer
  mutate-copy (xs) (pos) (val) (i) (n) (acc) =
    if i >= n then acc
    else mutate-copy xs pos val (i + 1) n (list-push acc (if i == pos then bit-xor (list-at xs i) val else list-at xs i))

  sweep-mut : List Integer, Integer, Integer, Integer, Integer -> Integer
  sweep-mut (base) (n) (pos) (cap) (bad) =
    if pos >= n then bad
    else let m = mutate-copy base pos (1 + (pos * 37 - (pos * 37 / 255) * 255)) 0 n []
    in let d = lz77-decompress-capped m cap
    in let ok = list-length d < 100000
    in sweep-mut base n (pos + 1) cap (if ok then bad else bad + 1)

  show-sweep : List Integer, Text -> Text
  show-sweep (base) (label) =
    label & " all-bounded=" & (if sweep-mut base (list-length base) 0 2000 0 == 0 then "True" else "False")

  show-cap : List Integer, Integer, Text -> Text
  show-cap (input) (cap) (label) =
    label & " capped=" & (if list-length (lz77-decompress-capped input cap) < list-length (lz77-decompress input) then "True" else "False")

Section: Hostile Token Lists

 Row 5. A back-reference of distance 5 against an empty output.

  off-past-start : List Integer = [1, 5, 3]

 Row 6. A distance of 0 after one literal.

  off-zero : List Integer = [0, 65, 1, 0, 3]

 Row 7. A match length of 100000 from a single token.

  mlen-past-max : List Integer = [0, 65, 1, 1, 100000]

Section: Body

  opening : [Console] Nothing = act
    print-line-uni (check-rt [] "1-empty")
    print-line-uni (check-rt [1, 2, 3] "2-tiny")
    print-line-uni (check-rt [65, 66, 67, 68, 65, 66, 67, 68, 65, 66, 67, 68] "3-repeating")
    print-line-uni (check-rt (make-repeated 42 100 0 []) "4-uniform-100")
    print-line-uni (show-decode off-past-start "5-off-past-start")
    print-line-uni (show-decode off-zero "6-off-zero")
    print-line-uni (show-decode mlen-past-max "7-mlen-past-max")
    print-line-uni (show-sweep (lz77-compress (make-repeated 42 400 0 [])) "8-mutation-sweep")
    print-line-uni (show-cap (lz77-compress (make-repeated 42 2000 0 [])) 50 "9-output-cap")
  end

