Chapter: GpuProxyTest
  cites AI chapter GpuProxy
  cites AI chapter Tensor
  cites Kernel chapter Pci

Section: Tests
  test-matmul-cmd : Text =
    format-gpu-cmd (gpu-cmd-matmul 4 3 2)

  test-relu-cmd : Text =
    format-gpu-cmd (gpu-cmd-relu 8 1)

  test-serialize : Text =
    let cmd = gpu-cmd-matmul 4 3 2
    in let buf = gpu-serialize-cmd cmd
    in "len=" & show (list-length buf) & " status=" & show (gpu-read-u32 buf 0) & " op=" & show (gpu-read-u32 buf 4)

  test-roundtrip : Text =
    let bytes = gpu-fixed-to-f32 1500
    in let raw = gpu-read-u32 bytes 0
    in let back = gpu-f32-raw-to-fixed raw
    in "orig=1500 back=" & show back

  test-tensor-bytes : Text =
    let t = tensor-from 2 2 [1000, 1000, 1000, 1000]
    in "bytes=" & show (list-length (gpu-tensor-to-f32-bytes t))

  test-build-buffer : Text =
    let a = tensor-from 1 3 [1000, 1000, 1000]
    in let b = tensor-from 3 1 [1000, 1000, 1000]
    in let buf = gpu-build-matmul-buffer a b
    in let result = gpu-parse-result buf
    in "buflen=" & show (list-length buf) & " status=" & show (result.gpu-result-status)

  test-addr : Text =
    let buf = [0, 16, 0, 128]
    in "addr=" & show (gpu-read-u32 buf 0)

  test-pci : Text =
    let dev = PciDevice { pci-bus = 0, pci-dev = 2, pci-func = 0, pci-vendor = 4318, pci-device-id = 10243, pci-class = 3, pci-subclass = 0, pci-header-type = 0 }
    in format-pci-device dev

  opening : [Console] Nothing = act
    print-line-uni test-matmul-cmd
    print-line-uni test-relu-cmd
    print-line-uni test-serialize
    print-line-uni test-roundtrip
    print-line-uni test-tensor-bytes
    print-line-uni test-build-buffer
    print-line-uni test-addr
    print-line-uni test-pci
  end
