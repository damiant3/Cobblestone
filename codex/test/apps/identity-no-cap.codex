Chapter: IdentityNoCap

Section: Body
  opening : [Console] Nothing = act
    let child = process-spawn (\x ->
      let r = process-restrict-cap (process-get-pid) 15
      in let set-result = identity-set 0 999
      in poke-byte 28000 0 (if set-result == (0 - 1) then 1 else 0))
    in let wt = process-wait child
    in let ok = peek-byte 28000 0
    in if ok == 1 then print-line-uni "PASS: identity-set denied without cap-identity"
    else print-line-uni "FAIL: identity-set succeeded without cap"
  end
