Chapter: ForensicsTest
  cites Foreword chapter Console
  cites Trust chapter Forensics

Section: Entry

  opening : [Console] Nothing =
    let c0 = chain-empty "captain-agent" 1000
    in let c1 = chain-add-percept c0 "altimeter" 95
    in let c2 = chain-add-belief c1 "altitude-ok" 90 [0]
    in let c3 = chain-add-policy c2 "autopilot-allowed" True "flight-deck"
    in let c4 = chain-add-action c3 "engage" "autopilot" "success"
    in let c5 = chain-set-summary c4 "Altitude check passed, autopilot engaged."
    in let l1 = render-chain c5
    in let l2 = show (chain-has-anomaly c5)
    in let c6 = chain-add-anomaly c5 "speed=500" "speed=200" "unexpected deceleration"
    in let l3 = show (chain-has-anomaly c6)
    in let l4 = show (chain-length c6)
    in act
      print-line-uni l1
      print-line-uni l2
      print-line-uni l3
      print-line-uni l4
    end

