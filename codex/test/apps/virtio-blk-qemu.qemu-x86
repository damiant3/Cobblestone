# One QEMU boot per arm, in order, all on one copy of the minted disk.
write -net none -drive if=none,id=vblk,format=raw,file={disk} -device virtio-blk-pci,disable-legacy=on,drive=vblk
reboot -net none -drive if=none,id=vblk,format=raw,file={disk} -device virtio-blk-pci,disable-legacy=on,drive=vblk
readonly -net none -drive if=none,id=vblk,format=raw,file={disk},readonly=on -device virtio-blk-pci,disable-legacy=on,drive=vblk
absent -net none
legacy -net none -drive if=none,id=vblk,format=raw,file={disk} -device virtio-blk-pci,disable-modern=on,drive=vblk
