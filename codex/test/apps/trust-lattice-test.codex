Chapter: TrustLatticeTest
  cites Trust chapter TrustLattice
  cites Foreword chapter Hamt
  cites Foreword chapter Maybe

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Body
  opening : [Console] Nothing =
    let lat = lattice-empty
    in let lat1 = lattice-add-direct lat "alice" trust-max
    in let lat2 = lattice-add-direct lat1 "bob" 8000
    in let lat3 = lattice-add-vouch lat2 "bob" "carol" 9000
    in let alice-score = lattice-trust-score lat3 "alice"
    in let bob-score = lattice-trust-score lat3 "bob"
    in let carol-score = lattice-trust-score lat3 "carol"
    in let unknown-score = lattice-trust-score lat3 "unknown"
    in let alice-trusted = lattice-is-trusted lat3 "alice"
    in let bob-trusted = lattice-is-trusted lat3 "bob"
    in let unknown-trusted = lattice-is-trusted lat3 "unknown"
    in let carol-meets = lattice-meets-threshold lat3 "carol" 5000
    in let empty-score = lattice-trust-score lattice-empty "nobody"
    in act
      print-line-uni (show alice-score)
      print-line-uni (show bob-score)
      print-line-uni (show carol-score)
      print-line-uni (show unknown-score)
      print-line-uni (show-bool alice-trusted)
      print-line-uni (show-bool bob-trusted)
      print-line-uni (show-bool unknown-trusted)
      print-line-uni (show-bool carol-meets)
      print-line-uni (show empty-score)
    end

