Chapter: CceAsciiMisreads
  cites Prism chapter PrismRoutes (prism-quote)
  cites Cvmm chapter Notes (note-count-words)
  cites UI chapter Selection (sel-is-word-char)

Section: Entry
  opening : [Console] Nothing
  opening = act
   print-line-uni ("prism-quote: " & prism-quote "a\"b\\c")
   print-line-uni ("words: " & show (note-count-words "two words\nthree" 0 15 0 False))
   print-line-uni ("word-char a: " & (if sel-is-word-char "a b" 0 then "yes" else "no"))
   print-line-uni ("word-char space: " & (if sel-is-word-char "a b" 1 then "yes" else "no"))
  end
