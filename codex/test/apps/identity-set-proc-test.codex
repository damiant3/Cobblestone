Chapter: IdentitySetProcTest

Section: Body
  opening : [Console] Nothing = act
    let pid = process-spawn (\x ->
      let w = identity-whoami 0
      in poke-byte 28000 0 (if w == 777 then 1 else 0))
    in let s = identity-set-proc pid 0 777
    in let wt = process-wait pid
    in let result = peek-byte 28000 0
    in if s == 0 then if result == 1 then print-line-uni "PASS"
    else print-line-uni "FAIL: child did not see new identity"
    else print-line-uni "FAIL: identity-set-proc returned error"
  end
