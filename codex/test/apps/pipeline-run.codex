Chapter: PipelineRunTest

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes
  cites Shell chapter Pipeline
  cites Workflow chapter WorkflowTypes
  cites Workflow chapter PipelineRun

 THE SUBJECT PIPELINE IS BUILT HERE RATHER THAN TAKEN FROM A GENERATOR, and that is
 forced rather than chosen: a generator chapter declares `opening`, and a chapter
 that declares an entry point can be cited by NOTHING (CDX3001). So the stages and
 the verdicts below are COPIED from `codex/build/applyannotationsScript.codex`, whose
 shipped script exits 2 when the report is absent and 0 when every chapter is
 processed. Those two codes are the ones `build/apply-annotations.ps1` actually
 spells, which is what makes this a proof and not a demonstration.

 Bodies are empty because the runner never emits shell. It reads the declarations.

Section: The subject

  s01 : PipeStage = PipeStage {
    ps-name = "preamble",
    ps-why = "resolve the report and zero the counters",
    ps-in = ["Report"],
    ps-out = [],
    ps-needs = [],
    ps-verdict = [PoExit 2 "the report named by -Report is not on disk"],
    ps-body = []
  }

  s02 : PipeStage = PipeStage {
    ps-name = "apply",
    ps-why = "cut the prose and write the sidecars",
    ps-in = [],
    ps-out = [],
    ps-needs = [],
    ps-verdict = [PoExit 0 "every chapter in the report was processed"],
    ps-body = []
  }

  subject : Pipeline = Pipeline {
    pl-name = "apply-annotations",
    pl-doc = "Apply an audited annotation-extraction report",
    pl-params = [],
    pl-stages = [PsStage s01, PsStage s02]
  }

Section: Entry

  opening : [Console] Nothing =
    let pd = pipeline-to-process subject
    in let steps = "steps=" & show (list-length (pd.pd-steps)) & " edges=" & show (list-length (pd.pd-transitions)) & " start=" & (pd.pd-start-step)

    in let green0 = pipe-start pd 100
    in let green1 = pipe-passed pd green0 101
    in let green2 = pipe-exited pd green1 0 102
    in let greenLine = "GREEN " & pipe-status-text (green2.pi-status) & " at=" & (green2.pi-current-step)

    in let red0 = pipe-start pd 200
    in let red1 = pipe-exited pd red0 2 201
    in let redLine = "REFUSED " & pipe-status-text (red1.pi-status) & " at=" & (red1.pi-current-step)

    in let odd0 = pipe-start pd 300
    in let odd1 = pipe-exited pd odd0 9 301
    in let oddLine = "UNDECLARED " & pipe-status-text (odd1.pi-status)

    in act
      print-line-uni steps
      print-line-uni greenLine
      print-line-uni redLine
      print-line-uni oddLine
      print-line-uni "-- green history --"
      print-line-uni (pipe-log-text (green2.pi-history) 0 "")
      print-line-uni "-- refused history --"
      print-line-uni (pipe-log-text (red1.pi-history) 0 "")
    end

