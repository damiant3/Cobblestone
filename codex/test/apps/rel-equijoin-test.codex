Chapter: RelEquiJoinTest
  cites Data chapter Catalog
  cites Data chapter Schema
  cites Data chapter Row
  cites Data chapter RelAlgebra
  cites Data chapter Executor
  cites Data chapter Optimizer

 Known-answer test for the RelEquiJoin plan node. Three tiny tables:
 owners is the dimension with two rows, pets is the fact with four
 rows, care holds one feeding entry per owner-and-pet pair. One pet
 names an owner that does not exist, therefore the inner join drops
 that pet and three rows survive. The left child is the probe side of
 the hash join, therefore output rows preserve pet insertion order:
 Rex with Ann, Tom with Ben, Sky with Ann. The plan runs through the
 optimizer first and prints its explain rendering, so the optimizer's
 equi-join arms are exercised alongside the executor's.

 The second plan joins on a composite key: pets to care on owner-id
 and pname together. The care table carries a decoy row for owner 2
 with pet name Rex. A join on owner-id alone would pair that row
 with Tom and answer wrong; the two-column join drops the decoy
 because no pet has owner 2 and name Rex at once. Three rows survive
 in pet insertion order: Rex eats kibble, Tom eats bones, Sky eats
 fish, and Zed matches nothing.

Section: Tables

  owners-table : TableDef
  owners-table = table-def-with-pk "owners" [
    col-def-not-null "owner-id" ColInteger,
    col-def-not-null "oname" ColText
  ] ["owner-id"]

  pets-table : TableDef
  pets-table = table-def-with-pk "pets" [
    col-def-not-null "pet-id" ColInteger,
    col-def-not-null "owner-id" ColInteger,
    col-def-not-null "pname" ColText
  ] ["pet-id"]

  care-table : TableDef
  care-table = table-def-with-pk "care" [
    col-def-not-null "care-id" ColInteger,
    col-def-not-null "owner-id" ColInteger,
    col-def-not-null "pname" ColText,
    col-def-not-null "food" ColText
  ] ["care-id"]

Section: Seed Data

  insert-all : Catalog, Text, List RowData, Integer, Integer -> Catalog
  insert-all (cat) (table) (rows) (i) (len) =
    if i >= len then cat
    else let r = catalog-insert-row cat table (list-at rows i)
    in insert-all (r.cir-cat) table rows (i + 1) len

  seed-owners : Catalog -> Catalog
  seed-owners (cat) =
    let s = table-schema owners-table
    in let rows = [
      row-new s [ValInteger 1, ValText "Ann"],
      row-new s [ValInteger 2, ValText "Ben"]
    ]
    in insert-all cat "owners" rows 0 (list-length rows)

  seed-pets : Catalog -> Catalog
  seed-pets (cat) =
    let s = table-schema pets-table
    in let rows = [
      row-new s [ValInteger 1, ValInteger 1, ValText "Rex"],
      row-new s [ValInteger 2, ValInteger 2, ValText "Tom"],
      row-new s [ValInteger 3, ValInteger 1, ValText "Sky"],
      row-new s [ValInteger 4, ValInteger 9, ValText "Zed"]
    ]
    in insert-all cat "pets" rows 0 (list-length rows)

  seed-care : Catalog -> Catalog
  seed-care (cat) =
    let s = table-schema care-table
    in let rows = [
      row-new s [ValInteger 1, ValInteger 1, ValText "Rex", ValText "kibble"],
      row-new s [ValInteger 2, ValInteger 1, ValText "Sky", ValText "fish"],
      row-new s [ValInteger 3, ValInteger 2, ValText "Tom", ValText "bones"],
      row-new s [ValInteger 4, ValInteger 2, ValText "Rex", ValText "treats"]
    ]
    in insert-all cat "care" rows 0 (list-length rows)

  build-db : Catalog
  build-db =
    let c1 = catalog-create-table catalog-new owners-table
    in let c2 = catalog-create-table (c1.cat) pets-table
    in let c3 = catalog-create-table (c2.cat) care-table
    in seed-care (seed-pets (seed-owners (c3.cat)))

Section: Plans

 Join pets to owners on the shared owner-id column, then project to
 the pet name and the owner name so the duplicate join column drops
 out immediately, in the manner the equi-join contract requires. The
 composite plan joins pets to care on owner-id and pname together and
 projects the pet name and the food.

  join-plan : RelOp
  join-plan = RelProject (RelEquiJoin (RelScan "pets") (RelScan "owners") ["owner-id"] ["owner-id"]) (proj-columns ["pname", "oname"])

  care-plan : RelOp
  care-plan = RelProject (RelEquiJoin (RelScan "pets") (RelScan "care") ["owner-id", "pname"] ["owner-id", "pname"]) (proj-columns ["pname", "food"])

Section: Display

  fmt-val : ColumnValue -> Text
  fmt-val (v) =
    when v
      is ValInteger (n) -> show n
      is ValText (t) -> t
      is ValBoolean (b) -> if b then "True" else "False"
      is ValNull -> "NULL"

  fmt-vals : List ColumnValue, Integer, Integer, Text -> Text
  fmt-vals (vals) (i) (len) (acc) =
    if i >= len then acc
    else let v = list-at vals i
    in let sep = if i > 0 then " | " else ""
    in fmt-vals vals (i + 1) len (acc & sep & fmt-val v)

  fmt-rows : List RowData, Integer, Integer, Text -> Text
  fmt-rows (rows) (i) (len) (acc) =
    if i >= len then acc
    else let row = list-at rows i
    in let line = "  " & fmt-vals (row.values) 0 (list-length (row.values)) ""
    in let sep = if i > 0 then "\n" else ""
    in fmt-rows rows (i + 1) len (acc & sep & line)

  fmt-qr : QueryResult -> Text
  fmt-qr (qr) =
    if qr.qr-ok == False then "ERROR: " & qr.qr-msg
    else fmt-rows (qr.qr-rows) 0 (qr.qr-count) ""

Section: Body

  opening : [Console] Nothing = act
    print-line-uni "=== rel-equijoin test ==="
    let cat = build-db
    in let plan = optimize join-plan
    in let plan2 = optimize care-plan
    in act
      print-line-uni (explain plan 0)
      let qr = query cat plan
      in act
        print-line-uni ("rows (" & show (qr.qr-count) & "):")
        print-line-uni (fmt-qr qr)
        print-line-uni "-- composite key: pets to care on owner-id and pname"
        print-line-uni (explain plan2 0)
        let qr2 = query cat plan2
        in act
          print-line-uni ("rows (" & show (qr2.qr-count) & "):")
          print-line-uni (fmt-qr qr2)
          print-line-uni "rel-equijoin-test: done"
        end
      end
    end
  end

