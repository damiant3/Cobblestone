Chapter: ChanLostWakeup

Section: Body

  producer : Integer -> [Concurrent] Integer
  producer (ch) = act
    a <- (chan-kern-send-block ch 10)
    b <- (chan-kern-send-block ch 20)
    b
  end

  consumer : Integer -> [Concurrent] Integer
  consumer (ch) = act
    x <- (chan-kern-recv-block ch)
    y <- (chan-kern-recv-block ch)
    y
  end

  opening : [Console, Concurrent] Nothing = act
    ch <- chan-kern-create 1
    p <- process-spawn (\z -> producer ch)
    c <- process-spawn (\z -> consumer ch)
    wp <- process-wait p
    wc <- process-wait c
    print-line-uni "done"
  end
