Chapter: DiscussionTest

  cites Foreword chapter Console
  cites Works chapter Discussion
  cites Works chapter Annotation

Section: Body

  opening : [Console] Nothing =
    let target = make-target "Core" "parse"
    in let store = discussion-store-empty
    in let store2 = discussion-open store target
    in let count-after-open = integer-to-text (discussion-count store2)
    in let thread-maybe = discussion-for-target store2 target
    in let tid = when thread-maybe
         is Just (t) -> t.thread-id
         is None -> "none"
    in let pc0 = when thread-maybe
         is Just (t) -> integer-to-text (t.post-count)
         is None -> "none"
    in let store3 = when thread-maybe
         is Just (t) -> discussion-post store2 (t.thread-id) "alice" "I think this is correct" 1000
         is None -> store2
    in let store4 = when thread-maybe
         is Just (t) -> discussion-post store3 (t.thread-id) "bob" "I disagree" 2000
         is None -> store3
    in let thread2 = discussion-for-target store4 target
    in let pc2 = when thread2
         is Just (t) -> integer-to-text (t.post-count)
         is None -> "none"
    in let no-thread = discussion-for-target store4 (make-target "Other" "func")
    in let no-result = when no-thread
         is Just (t) -> "found"
         is None -> "none"
    in act
      print-line-uni ("count=" & count-after-open)
      print-line-uni ("posts-initial=" & pc0)
      print-line-uni ("posts-after=" & pc2)
      print-line-uni ("missing=" & no-result)
    end
