Chapter: HuffmanTest
  cites Compress chapter Huffman

Section: Tests
  test-freq : Text =
    let freq = huff-count-freq [65, 65, 66, 65, 67]
    in "a=" & show (list-at freq 65) & " b=" & show (list-at freq 66) & " c=" & show (list-at freq 67)

  test-build-tree : Text =
    let freq = huff-count-freq [65, 65, 66, 65, 67]
    in let tree = huff-build-tree freq
    in "count=" & show (tree.count)

  test-build-codes : Text =
    let freq = huff-count-freq [65, 65, 66, 65, 67]
    in let tree = huff-build-tree freq
    in let codes = huff-build-codes tree
    in "codes=" & show (list-length codes)

  opening : [Console] Nothing = act
    print-line-uni test-freq
    print-line-uni test-build-tree
    print-line-uni test-build-codes
  end
