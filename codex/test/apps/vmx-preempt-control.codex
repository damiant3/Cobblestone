Chapter: VmxPreemptControl
  cites Works chapter DevHypervisor

 A synthetic IA32_VMX_PINBASED_CTLS: must-be-1 bits 1, 2 and 4 (0x16), and an
 allowed-1 half with and without bit 6.

Section: Body

  with-timer : Integer = 127 * 4294967296 + 22
  without-timer : Integer = 63 * 4294967296 + 22

  opening : [Console] Nothing = act
   let on = vmx-adjust-raw with-timer vmx-pin-preempt-timer
   in let off = vmx-adjust-raw without-timer vmx-pin-preempt-timer
   in act
    print-line-uni ("pin-offered=" & show on & " armed=" & show (vmx-preempt-armed on))
    print-line-uni ("pin-absent=" & show off & " armed=" & show (vmx-preempt-armed off))
    print-line-uni ("reason52=" & format-exit-reason 52)
    print-line-uni ("reason52-high=" & format-exit-reason (bit-or 52 2147483648))
    print-line-uni ("bed-offered=" & show vmx-preempt-offered)
   end
  end

