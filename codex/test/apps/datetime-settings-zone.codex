 The settings clock holds UTC and shows local time in its zone: London one
 second either side of the 2026-10-25 fall-back (01:59:59 BST, then 01:00:00
 GMT), and Kathmandu, where a UTC evening is the next local morning.

Section: Body

  at : DateTimeState, Zone, Integer, Integer, Integer, Integer, Integer, Integer -> DateTimeState
  at (st) (z) (y) (mo) (d) (h) (mi) (s) = dt-set-timezone (dt-set-time (dt-set-date st y mo d) h mi s) z

  opening : [Console] Nothing =
    let db = tz-parse tz-sources
    in when zone-from-db db "Europe/London"
      is None -> print-line-uni "london missing"
      is Just (london) ->
        (when zone-from-db db "Asia/Kathmandu"
          is None -> print-line-uni "kathmandu missing"
          is Just (ktm) ->
            let before = at datetime-new london 2026 10 25 0 59 59
            in print-line-uni ("london " & dt-format-full before & " then " & dt-format-full (dt-tick before)
              & "; kathmandu " & dt-format-full (at datetime-new ktm 2026 3 7 23 30 0)
              & "; utc " & dt-format-full (at datetime-new dt-zone-utc 2026 3 7 23 30 0)
              & "; label " & format-datetime-settings (at datetime-new london 2026 10 25 0 59 59)))

