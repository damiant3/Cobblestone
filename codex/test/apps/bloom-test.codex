Chapter: BloomTest
  cites Codex chapter General
  cites Foreword chapter BloomFilter

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-empty : Text =
    let bf = bloom-new 64 3
    in "contains-5=" & show-bool (bloom-contains bf 5)

  test-add-contains : Text =
    let bf = bloom-add (bloom-new 256 3) 42
    in "has-42=" & show-bool (bloom-contains bf 42)

  test-text : Text =
    let bf = bloom-add-text (bloom-new 256 3) "hello"
    in "has-hello=" & show-bool (bloom-contains-text bf "hello")

  test-multiple : Text =
    let bf0 = bloom-new 256 3
    in let bf1 = bloom-add bf0 10
    in let bf2 = bloom-add bf1 20
    in let bf3 = bloom-add bf2 30
    in "h10=" & show-bool (bloom-contains bf3 10) & " h20=" & show-bool (bloom-contains bf3 20) & " h30=" & show-bool (bloom-contains bf3 30)

  opening : [Console] Nothing = act
    print-line-uni test-empty
    print-line-uni test-add-contains
    print-line-uni test-text
    print-line-uni test-multiple
  end
