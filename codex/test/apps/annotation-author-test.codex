Chapter: AnnotationAuthorTest

  cites Foreword chapter Console
  cites Works chapter Annotation

Section: Body

  opening : [Console] Nothing =
    let t = make-target "MyChapter" "my-function"
    in let a = create-annotation t Rationale "alice" "explains the design" 1000
    in let tk = target-key t
    in let ts = integer-to-text (a.timestamp)
    in let hl = integer-to-text (text-length (a.hash))
    in act
      print-line-uni ("author=" & a.author & " target=" & tk)
      print-line-uni ("body=" & a.body & " ts=" & ts)
      print-line-uni ("hash-len=" & hl)
    end
