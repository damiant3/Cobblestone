Chapter: ChessMoveGen
  cites Games chapter Chess

 Square indices used below: d4 = 35, a1 = 56, a2 = 48, d2 = 51, d3 = 43,
 c5 = 26, e5 = 28. Perft values 20, 400 and 8902 are the published node
 counts for the start position at depths 1, 2 and 3, which are the depths
 reachable before a check or a pin can arise.

 We say:

Section: Scenario Boards

  one-piece : Integer, Integer, Integer -> ChessBoard
  one-piece (sq) (piece) (side) =
    let placed = chess-place chess-blank sq piece
    in chess-to-move placed side

  two-piece : Integer, Integer, Integer, Integer, Integer -> ChessBoard
  two-piece (sq-a) (piece-a) (sq-b) (piece-b) (side) =
    let first = chess-place chess-blank sq-a piece-a
    in let second = chess-place first sq-b piece-b
    in chess-to-move second side

Section: Counting

  moves-from : ChessBoard, Integer -> Integer
  moves-from (b) (sq) =
    let moves = chess-moves b
    in chess-count-from moves sq

  captures-in : ChessBoard -> Integer
  captures-in (b) =
    let moves = chess-moves b
    in chess-count-captures moves

Section: Piece Census On An Empty Board

  census-lines : [Console] Nothing
  census-lines =
    let knight-d4 = moves-from (one-piece 35 2 0) 35
    in let knight-a1 = moves-from (one-piece 56 2 0) 56
    in let bishop-d4 = moves-from (one-piece 35 3 0) 35
    in let bishop-a1 = moves-from (one-piece 56 3 0) 56
    in let rook-d4 = moves-from (one-piece 35 4 0) 35
    in let rook-a1 = moves-from (one-piece 56 4 0) 56
    in let queen-d4 = moves-from (one-piece 35 5 0) 35
    in let king-d4 = moves-from (one-piece 35 6 0) 35
    in let king-a1 = moves-from (one-piece 56 6 0) 56
    in act
      print-line-uni ("knight d4 " & show (knight-d4))
      print-line-uni ("knight a1 " & show (knight-a1))
      print-line-uni ("bishop d4 " & show (bishop-d4))
      print-line-uni ("bishop a1 " & show (bishop-a1))
      print-line-uni ("rook d4 " & show (rook-d4))
      print-line-uni ("rook a1 " & show (rook-a1))
      print-line-uni ("queen d4 " & show (queen-d4))
      print-line-uni ("king d4 " & show (king-d4))
      print-line-uni ("king a1 " & show (king-a1))
    end

Section: Blocking And Capture

  blocking-lines : [Console] Nothing
  blocking-lines =
    let rook-own = moves-from (two-piece 56 4 48 1 0) 56
    in let rook-enemy = moves-from (two-piece 56 4 48 7 0) 56
    in let rook-enemy-caps = captures-in (two-piece 56 4 48 7 0)
    in let bishop-own = moves-from (two-piece 35 3 26 1 0) 35
    in let bishop-enemy = moves-from (two-piece 35 3 26 7 0) 35
    in act
      print-line-uni ("rook a1 own pawn a2 " & show (rook-own))
      print-line-uni ("rook a1 enemy pawn a2 " & show (rook-enemy))
      print-line-uni ("rook a1 enemy pawn a2 captures " & show (rook-enemy-caps))
      print-line-uni ("bishop d4 own pawn c5 " & show (bishop-own))
      print-line-uni ("bishop d4 enemy pawn c5 " & show (bishop-enemy))
    end

Section: Pawns

  pawn-lines : [Console] Nothing
  pawn-lines =
    let home = moves-from (one-piece 51 1 0) 51
    in let away = moves-from (one-piece 35 1 0) 35
    in let blocked = moves-from (two-piece 51 1 43 1 0) 51
    in let double-blocked = moves-from (two-piece 51 1 35 1 0) 51
    in let takes-board = two-piece 26 7 28 7 0
    in let with-pawn = chess-place takes-board 35 1
    in let takes = moves-from with-pawn 35
    in let takes-caps = chess-count-captures (chess-moves with-pawn)
    in let black-home = moves-from (one-piece 11 7 1) 11
    in act
      print-line-uni ("white pawn d2 " & show (home))
      print-line-uni ("white pawn d4 " & show (away))
      print-line-uni ("white pawn d2 blocked d3 " & show (blocked))
      print-line-uni ("white pawn d2 blocked d4 " & show (double-blocked))
      print-line-uni ("white pawn d4 two targets " & show (takes))
      print-line-uni ("white pawn d4 two targets captures " & show (takes-caps))
      print-line-uni ("black pawn d7 " & show (black-home))
    end

Section: Side To Move

  side-lines : [Console] Nothing
  side-lines =
    let white-knight-white-turn = moves-from (one-piece 35 2 0) 35
    in let white-knight-black-turn = moves-from (one-piece 35 2 1) 35
    in let black-knight-black-turn = moves-from (one-piece 35 8 1) 35
    in let black-knight-white-turn = moves-from (one-piece 35 8 0) 35
    in act
      print-line-uni ("white knight white to move " & show (white-knight-white-turn))
      print-line-uni ("white knight black to move " & show (white-knight-black-turn))
      print-line-uni ("black knight black to move " & show (black-knight-black-turn))
      print-line-uni ("black knight white to move " & show (black-knight-white-turn))
    end

Section: Perft

  perft-lines : [Console] Nothing
  perft-lines =
    let start = chess-new
    in let p1 = chess-perft start 1
    in let p2 = chess-perft start 2
    in let p3 = chess-perft start 3
    in act
      print-line-uni ("perft 1 " & show (p1))
      print-line-uni ("perft 2 " & show (p2))
      print-line-uni ("perft 3 " & show (p3))
      print-line-uni ("start board " & format-chess-board start)
    end

Section: Entry

  opening : [Console] Nothing
  opening = act
    census-lines
    blocking-lines
    pawn-lines
    side-lines
    perft-lines
  end

