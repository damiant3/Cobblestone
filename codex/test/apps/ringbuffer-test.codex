Chapter: RingBufferTest
  cites Codex chapter General
  cites Foreword chapter RingBuffer
  cites Foreword chapter Maybe

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-new : Text =
    let r = ring-new 4
    in "count=" & show (ring-count r) & " full=" & show-bool (ring-is-full r)

  test-push-count : Text =
    let r = ring-push (ring-push (ring-push (ring-new 4) 10) 20) 30
    in "count=" & show (ring-count r)

  test-pop : Text =
    let r = ring-push (ring-push (ring-new 4) 10) 20
    in let result = ring-pop r
    in "val=" & show (result.value) & " remaining=" & show (ring-count (result.buffer))

  test-wrap : Text =
    let r0 = ring-new 3
    in let r1 = ring-push (ring-push (ring-push r0 1) 2) 3
    in let r2 = ring-push r1 4
    in "count=" & show (ring-count r2)

  opening : [Console] Nothing = act
    print-line-uni test-new
    print-line-uni test-push-count
    print-line-uni test-pop
    print-line-uni test-wrap
  end
