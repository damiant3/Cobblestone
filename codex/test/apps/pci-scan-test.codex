Chapter: PciScanTest
  cites Kernel chapter Pci

Section: Tests
  test-device-format : Text =
    let d = PciDevice { pci-bus = 0, pci-dev = 1, pci-func = 0, pci-vendor = 4660, pci-device-id = 4369, pci-class = 3, pci-subclass = 0, pci-header-type = 0 }
    in format-pci-device d

  test-bar-record : Text =
    let bar = PciBar { bar-index = 0, bar-base = 65536, bar-is-io = False, bar-is-64bit = True }
    in "idx=" & show (bar.bar-index) & " base=" & show (bar.bar-base) & " io=" & (if bar.bar-is-io then "T" else "F") & " 64=" & (if bar.bar-is-64bit then "T" else "F")

  test-find-class : Text =
    let d1 = PciDevice { pci-bus = 0, pci-dev = 0, pci-func = 0, pci-vendor = 4660, pci-device-id = 4369, pci-class = 3, pci-subclass = 0, pci-header-type = 0 }
    in let d2 = PciDevice { pci-bus = 0, pci-dev = 1, pci-func = 0, pci-vendor = 4147, pci-device-id = 404, pci-class = 12, pci-subclass = 3, pci-header-type = 0 }
    in let scan = PciScanResult { devices = [d1, d2], count = 2 }
    in when pci-find-class scan 12 3
      is Just (dev) -> "found at " & show (dev.pci-dev) & " vendor=" & show (dev.pci-vendor)
      is None -> "not found"

  test-find-device : Text =
    let d = PciDevice { pci-bus = 0, pci-dev = 2, pci-func = 0, pci-vendor = 32902, pci-device-id = 9832, pci-class = 4, pci-subclass = 3, pci-header-type = 0 }
    in let scan = PciScanResult { devices = [d], count = 1 }
    in when pci-find-device scan 32902 9832
      is Just (dev) -> "hda at " & show (dev.pci-dev)
      is None -> "not found"

  opening : [Console] Nothing = act
    print-line-uni test-device-format
    print-line-uni test-bar-record
    print-line-uni test-find-class
    print-line-uni test-find-device
  end
