Chapter: VmSweepTest
  cites Works chapter VmSweep
  cites Works chapter VmRunner
  cites Works chapter SweepHarness
  cites Foreword chapter Console

  verdict-name : SampleResult -> Text
  verdict-name (v) = when v
    is PassVerified -> "PassVerified"
    is PassFailing -> "PassFailing"
    is PassUnverified -> "PassUnverified"
    is FailCompile -> "FailCompile"
    is FailOutput -> "FailOutput"
    is FailCrashed -> "FailCrashed"
    is FailExpectedButCompiled -> "FailExpectedButCompiled"
    is FailWrongDiagnostic -> "FailWrongDiagnostic"
    is SkippedResult -> "SkippedResult"

  run : Text, Boolean -> VmRunOutput
  run (t) (h) = VmRunOutput { vro-text = t, vro-halted = h, vro-exit-count = 0 }

  opening : [Console] Nothing =
    let line = "hi" & "\n"
    in let other = "ho" & "\n"
    in let sweep = VmSweepResult { vsr-pass = 7, vsr-fail = 2, vsr-skip = 1, vsr-total = 10, vsr-results = [] }
    in act
      print-line-uni ("halted same     : " & verdict-name (vm-grade-run (run line True) line))
      print-line-uni ("halted differs  : " & verdict-name (vm-grade-run (run other True) line))
      print-line-uni ("halted empty    : " & verdict-name (vm-grade-run (run "" True) ""))
      print-line-uni ("not halted same : " & verdict-name (vm-grade-run (run line False) line))
      print-line-uni ("not halted diff : " & verdict-name (vm-grade-run (run other False) line))
      print-line-uni ("summary         : " & format-sweep-result sweep)
      print-line-uni "done"
    end

