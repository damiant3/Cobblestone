Chapter: PbkdfStoredGuard
  cites Foreword chapter Pbkdf

  report : Text, Boolean -> [Console] Nothing
  report (label) (ok) = print-line-uni (label & "=" & (if ok then "yes" else "no"))

  params : Integer, Integer -> PbkdfParams
  params (iterations) (length) = PbkdfParams { pb-iterations = iterations, pb-hash-length = length }

  password : List Integer = [112, 97, 115, 115, 119, 111, 114, 100]
  salt : List Integer = [115, 97, 108, 116]
  genuine : PbkdfResult = pbkdf-hash password salt (params 2 32)

  refused : Integer, Integer -> Boolean
  refused (iterations) (length) =
    let stored = pbkdf-hash password salt (params iterations length)
    in list-length (stored.pbr-hash) == 0 & pbkdf-verify password stored == False & pbkdf-verify [1] stored == False

  value-refused : List Integer, List Integer -> Boolean
  value-refused (pw) (s) =
    let stored = pbkdf-hash pw s (params 2 32)
    in list-length (stored.pbr-hash) == 0 & pbkdf-verify pw stored == False

  dump : List Integer, Integer, Text -> Text
  dump (xs) (i) (acc) = if i >= list-length xs then acc else dump xs (i + 1) (acc & " " & show (list-at xs i))

  opening : [Console] Nothing = act
    report "right-password" (pbkdf-verify password genuine)
    report "wrong-password-refused" (pbkdf-verify [1] genuine == False)
    report "doubled-refused" (pbkdf-verify password (PbkdfResult { pbr-hash = (genuine.pbr-hash) & (genuine.pbr-hash), pbr-salt = salt, pbr-params = params 2 32 }) == False)
    report "truncated-refused" (pbkdf-verify password (PbkdfResult { pbr-hash = [1], pbr-salt = salt, pbr-params = params 2 32 }) == False)
    report "zero-iterations" (refused 0 32)
    report "negative-iterations" (refused (0 - 1) 32)
    report "zero-length" (refused 2 0)
    report "negative-length" (refused 2 (0 - 1))
    report "over-rfc-length" (refused 2 137438953441)
    report "short-tag" (pbkdf-verify password (pbkdf-hash password salt (params 2 16)))
    report "long-tag" (pbkdf-verify password (pbkdf-hash password salt (params 2 65)))
    report "negative-password-byte" (value-refused [0 - 1] salt)
    report "wide-password-byte" (value-refused [256] salt)
    report "negative-salt-byte" (value-refused password [0 - 1])
    report "wide-salt-byte" (value-refused password [256])
    report "old-collision-refused" (pbkdf-verify [1] (pbkdf-hash [0] [1, 2, 3, 4, 5, 6, 7, 8] (params 1 32)) == False)
    print-line-uni ("case0=" & dump ((pbkdf-hash [] [] (PbkdfParams { pb-iterations = 1, pb-hash-length = 32 })).pbr-hash) 0 "")
    print-line-uni ("case1=" & dump ((pbkdf-hash [112, 97, 115, 115, 119, 111, 114, 100] [115, 97, 108, 116] (PbkdfParams { pb-iterations = 1, pb-hash-length = 32 })).pbr-hash) 0 "")
    print-line-uni ("case2=" & dump ((pbkdf-hash [112, 97, 115, 115, 119, 111, 114, 100] [115, 97, 108, 116] (PbkdfParams { pb-iterations = 2, pb-hash-length = 32 })).pbr-hash) 0 "")
    print-line-uni ("case3=" & dump ((pbkdf-hash [112, 97, 115, 115, 119, 111, 114, 100] [115, 97, 108, 116] (PbkdfParams { pb-iterations = 4096, pb-hash-length = 32 })).pbr-hash) 0 "")
    print-line-uni ("case4=" & dump ((pbkdf-hash [0, 1, 0, 255] [0, 255, 0] (PbkdfParams { pb-iterations = 3, pb-hash-length = 65 })).pbr-hash) 0 "")
