Chapter: IpcProducerConsumer

Section: Body
  produce : Integer, Integer, Integer -> [Concurrent] Integer
  produce (ch) (i) (n) =
    if i >= n then 0
    else act
      s <- chan-kern-send-block ch (i * i)
      produce ch (i + 1) n
    end

  consume : Integer, Integer, Integer -> [Concurrent] Integer
  consume (ch) (n) (acc) =
    if n <= 0 then acc
    else act
      v <- chan-kern-recv-block ch
      consume ch (n - 1) (acc + v)
    end

  opening : [Concurrent] Integer = act
    ch <- chan-kern-create 2
    prod <- process-spawn (\x -> produce ch 1 6)
    total <- consume ch 5 0
    cl <- chan-kern-close ch
    let w = process-wait prod
    in total
  end
