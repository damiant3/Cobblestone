Chapter: IpcProducerConsumer

Section: Body
  produce : Integer, Integer, Integer -> Integer
  produce (ch) (i) (n) =
    if i >= n then 0
    else let s = chan-kern-send-block ch (i * i)
    in produce ch (i + 1) n

  consume : Integer, Integer, Integer -> Integer
  consume (ch) (n) (acc) =
    if n <= 0 then acc
    else let v = chan-kern-recv-block ch
    in consume ch (n - 1) (acc + v)

  opening : Integer =
    let ch = chan-kern-create 2
    in let prod = process-spawn (\x -> produce ch 1 6)
    in let total = consume ch 5 0
    in let w = process-wait prod
    in let cl = chan-kern-close ch
    in total
