Chapter: AccpPhysicsTest
  cites Accp chapter AccpPhysics
  cites Foreword chapter Console

Section: Entry

  row : Text, MathResult -> [Console] Nothing
  row (label) (r) = print-line-uni (label & " " & math-format r)

  opening : [Console] Nothing = act
    row "position 0 2 3 2" (physics-position 0.0 2.0 3.0 2.0)
    row "force 2 9.81" (physics-force 2.0 9.81)
    row "kinetic 2 3" (physics-kinetic-energy 2.0 3.0)
    row "gravity 1 2 3 2" (physics-gravity-force 1.0 2.0 3.0 2.0)
    row "orbital 4 1" (physics-orbital-speed 4.0 1.0)
    row "range 20 pi/4 9.81" (physics-projectile-range 20.0 (math-pi / 4.0) 9.81)
    row "spring 1 4" (physics-spring-period 1.0 4.0)
    row "spring 1 0" (physics-spring-period 1.0 0.0)
    row "wave 2 3" (physics-wave-speed 2.0 3.0)
    row "ohm 12 4" (physics-ohm-current 12.0 4.0)
    row "ohm 12 0" (physics-ohm-current 12.0 0.0)
    row "heat 2 4186 10" (physics-heat 2.0 4186.0 10.0)
  end
