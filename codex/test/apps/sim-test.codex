Chapter: SimTest
  cites Sim chapter Physics
  cites Sim chapter Collision
  cites Sim chapter Steering
  cites Sim chapter ParticleSystem
  cites Sim chapter Kinematics
  cites Math chapter Quaternion
  cites Math chapter Cordic
  cites Foreword chapter Units (Mass, Speed, Force, Angle, Length)

Section: Helpers
  count-nearby : Circle2D, Circle2D, Circle2D, Circle2D -> Integer
  count-nearby (target) (a) (b) (c) =
    (if col-circle-circle target a then 1 else 0) + (if col-circle-circle target b then 1 else 0) + (if col-circle-circle target c then 1 else 0)

Section: Tests
  test-body : Text =
    let b = phys-body 0 1000 0 1000
    in "pos=" & format-phys b & " speed=" & show (phys-speed b)

  test-step : Text =
    let b0 = phys-body-with-velocity 0 0 0 10 0 0 1000
    in let b1 = phys-apply-force b0 8 0 0
    in let b2 = phys-step b1 1000
    in "x=" & show (b2.px)

  test-floor : Text =
    let b = phys-body 0 (0 - 500) 0 1000
    in let c = phys-constrain-floor b 0
    in "y=" & show (c.py)

  test-aabb : Text =
    let a1 = aabb-new 0 0 0 100 100 100
    in let b1 = aabb-new 150 0 0 100 100 100
    in let c1 = col-aabb-aabb a1 b1
    in let a2 = aabb-new 0 0 0 100 100 100
    in let b2 = aabb-new 300 0 0 100 100 100
    in let c2 = col-aabb-aabb a2 b2
    in format-collision c1 & " | " & format-collision c2

  test-sphere : Text =
    let s1 = sphere-new 0 0 0 100
    in let s2 = sphere-new 150 0 0 100
    in let c = col-sphere-sphere s1 s2
    in format-collision c

  test-particles : Text =
    let em = emitter-new 0 0 0 0 0 0 0 100 255
    in let sys = psys-emit (psys-new 100) em 5 42
    in "count=" & show (psys-count sys)

  test-steer : Text =
    let a = steer-agent 0 0 5 5
    in let f = steer-seek a 1000 0
    in "x=" & show (a.sa-x) & " vx=" & show (f.sf-x)

  test-nearby : Text =
    let target = Circle2D { cx = 0, cy = 0, cr = 50 }
    in let c1 = Circle2D { cx = 30, cy = 0, cr = 50 }
    in let c2 = Circle2D { cx = 40, cy = 0, cr = 50 }
    in let c3 = Circle2D { cx = 200, cy = 0, cr = 50 }
    in let n = count-nearby target c1 c2 c3
    in "count=3 near=" & show n

  test-chain : Text =
    let j1 = joint-new 100 0
    in let j2 = joint-new 100 0
    in let j3 = joint-new 100 0
    in let chain = chain-new 0 0 [j1, j2, j3]
    in "k=" & show (chain.kc-count) & " class=0"

  opening : [Console] Nothing = act
    print-line-uni test-body
    print-line-uni test-step
    print-line-uni test-floor
    print-line-uni test-aabb
    print-line-uni test-sphere
    print-line-uni test-particles
    print-line-uni test-steer
    print-line-uni test-nearby
    print-line-uni test-chain
  end
