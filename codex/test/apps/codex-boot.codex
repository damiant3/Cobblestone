Chapter: CodexBoot
  cites Foreword chapter CCE
  cites Foreword chapter Maybe
  cites Kernel chapter Vga
  cites Kernel chapter Keyboard
  cites Kernel chapter DiagnosticShell

Section: Boot Gate
  boot-check-key : Integer -> Boolean
  boot-check-key (tries) =
    if tries <= 0 then False
    else if kb-has-key then True
    else boot-check-key (tries - 1)

Section: Welcome Screen

  ws-bg : Integer = vga-attr vga-light-gray vga-black
  ws-hdr : Integer = vga-attr vga-white vga-blue
  ws-title : Integer = vga-attr vga-white vga-black
  ws-ok : Integer = vga-attr vga-light-green vga-black
  ws-info : Integer = vga-attr vga-cyan vga-black
  ws-dim : Integer = vga-attr vga-dark-gray vga-black
  ws-accent : Integer = vga-attr vga-light-cyan vga-black

  ws-header : Integer
  ws-header =
    let clr = vga-clear-row 0 ws-hdr
    in let w1 = vga-put-text 0 2 "Codex" ws-hdr
    in vga-put-text 0 68 "bare-metal" ws-hdr

  ws-logo : Integer
  ws-logo =
    let w1 = vga-put-text 3 30 "___________" ws-accent
    in let w2 = vga-put-text 4 28 "/           \\" ws-accent
    in let w3 = vga-put-text 5 27 "|    CODEX    |" ws-accent
    in let w4 = vga-put-text 6 28 "\\___________/" ws-accent
    in w1 + w2 + w3 + w4

  ws-status : Integer
  ws-status =
    let w1 = vga-put-text 9 26 "[" ws-bg
    in let w2 = vga-put-text 9 27 "OK" ws-ok
    in let w3 = vga-put-text 9 29 "]" ws-bg
    in let w4 = vga-put-text 9 31 "Compiler fixed point" ws-bg
    in let w5 = vga-put-text 10 26 "[" ws-bg
    in let w6 = vga-put-text 10 27 "OK" ws-ok
    in let w7 = vga-put-text 10 29 "]" ws-bg
    in let w8 = vga-put-text 10 31 "Trust lattice" ws-bg
    in let w9 = vga-put-text 11 26 "[" ws-bg
    in let w10 = vga-put-text 11 27 "OK" ws-ok
    in let w11 = vga-put-text 11 29 "]" ws-bg
    in let w12 = vga-put-text 11 31 "Verifier online" ws-bg
    in let w13 = vga-put-text 12 26 "[" ws-bg
    in let w14 = vga-put-text 12 27 "OK" ws-ok
    in let w15 = vga-put-text 12 29 "]" ws-bg
    in vga-put-text 12 31 "Scheduler ready" ws-bg

  ws-sep : Integer -> Integer
  ws-sep (row) = ws-sep-loop row 0

  ws-sep-loop : Integer, Integer -> Integer
  ws-sep-loop (row) (col) =
    if col >= vga-cols then 0
    else let w = vga-put-raw row col 196 ws-dim
    in ws-sep-loop row (col + 1)

  ws-footer : Integer
  ws-footer =
    let s = ws-sep 14
    in let w1 = vga-put-text 16 2 "codex" (vga-attr vga-light-green vga-black)
    in let w2 = vga-put-text 16 7 ">" ws-title
    in let w3 = vga-put-text 16 9 "ready" ws-bg
    in let w4 = vga-put-text 22 2 "Hold any key during boot for diagnostic shell" ws-dim
    in w1 + w2 + w3 + w4

  ws-draw : Integer
  ws-draw =
    let c = vga-clear ws-bg
    in let h = ws-header
    in let l = ws-logo
    in let s = ws-status
    in let f = ws-footer
    in c + h + l + s + f

Section: Entry
  opening : [Console] Nothing = act
    let diag = boot-check-key 50000
    in if diag then diag-repl
    else act
      let drawn = ws-draw
      in act
        print-line-uni "Codex OS ready"
      end
    end
  end

