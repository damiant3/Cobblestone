Chapter: XhciDiscoverTest
  cites Codex chapter General
  cites Kernel chapter Xhci
  cites Kernel chapter Pci

Section: Tests
  test-controller-empty : Text =
    format-xhci xhci-controller-empty

  test-controller-record : Text =
    let xc = XhciController { xc-bar = 4270694400, xc-cap-length = 32, xc-op-base = 4270694432, xc-rt-base = 4270695424, xc-db-base = 4270696448, xc-max-slots = 32, xc-max-ports = 4, xc-found = True, xc-initialized = False }
    in format-xhci xc

  test-port-status : Text =
    let p = XhciPort { xp-number = 0, xp-connected = True, xp-enabled = True, xp-speed = 4 }
    in format-xhci-port p

  test-speed-names : Text =
    xhci-speed-name 1 & " | " & xhci-speed-name 2 & " | " & xhci-speed-name 3 & " | " & xhci-speed-name 4 & " | " & xhci-speed-name 5

  test-slot-record : Text =
    let s = xhci-slot-new 1 0
    in "slot=" & show (s.xs-slot-id) & " port=" & show (s.xs-port) & " configured=" & (if s.xs-configured then "T" else "F")

  test-trb-enable-slot : Text =
    let trb = trb-enable-slot-cmd
    in "type=" & show (bit-and (bit-shru (trb.trb-control) 10) 63)

  opening : [Console] Nothing = act
    print-line-uni test-controller-empty
    print-line-uni test-controller-record
    print-line-uni test-port-status
    print-line-uni test-speed-names
    print-line-uni test-slot-record
    print-line-uni test-trb-enable-slot
  end
