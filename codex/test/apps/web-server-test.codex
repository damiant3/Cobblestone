Section: Setup
  my-mac : List Integer = mac-bytes 82 84 0 18 52 86
  my-ip : List Integer = ip-bytes 10 0 2 15
  gw-ip : List Integer = ip-bytes 10 0 2 2
  gw-mac : List Integer = mac-bytes 82 84 0 0 0 1
  client-ip : List Integer = ip-bytes 10 0 2 100

  make-transport : TcpTransportState
  make-transport =
    let sess = net-session-new my-mac my-ip gw-ip 80 49152 client-ip 4096
    in let sess1 = set-arp sess (arp-cache-add (sess.arp) gw-ip gw-mac)
    in let r = net-connect sess1
    in let syn-ack = tcp-build-segment 49152 80 3000 1001 (bit-or tcp-flag-syn tcp-flag-ack) 16384 []
    in let syn-ack-ip = ip-build-packet client-ip my-ip ip-proto-tcp syn-ack
    in let syn-ack-frame = eth-build-frame my-mac gw-mac eth-type-ipv4 syn-ack-ip
    in let r2 = net-process-frame (r.session) syn-ack-frame
    in transport-new (r2.session)

  test-router : Router
  test-router =
    let r0 = router-empty
    in let r1 = router-get r0 "/" "status"
    in let r2 = router-get r1 "/health" "health"
    in let r3 = router-get r2 "/info" "info"
    in r3

  test-state : ShellState
  test-state = shell-init (policy-empty "web-test") 50

Section: Tests

  show-status-type : WebResponse -> Text
  show-status-type (wr) = "status=" & (wr.response).status & " type=" & (wr.response).content-type

  show-status-body-len : WebResponse -> Text
  show-status-body-len (wr) = "status=" & (wr.response).status & " body-len=" & show (text-length ((wr.response).body))

  show-status : WebResponse -> Text
  show-status (wr) = "status=" & (wr.response).status

  req-root : List Integer
  req-root = [71, 69, 84, 32, 47, 32, 72, 84, 84, 80, 47, 49, 46, 48, 13, 10]

  req-health : List Integer
  req-health = [71, 69, 84, 32, 47, 104, 101, 97, 108, 116, 104, 32, 72, 84, 84, 80, 47, 49, 46, 48, 13, 10]

  req-missing : List Integer
  req-missing = [71, 69, 84, 32, 47, 120, 32, 72, 84, 84, 80, 47, 49, 46, 48, 13, 10]

  get-status : Integer -> [Identity] WebResponse
  get-status (x) = web-server-handle (web-server-new test-router make-transport) req-root test-state

  get-health : Integer -> [Identity] WebResponse
  get-health (x) = web-server-handle (web-server-new test-router make-transport) req-health test-state

  get-404 : Integer -> [Identity] WebResponse
  get-404 (x) = web-server-handle (web-server-new test-router make-transport) req-missing test-state

  get-again : WebResponse -> [Identity] WebResponse
  get-again (wr1) = web-server-handle (wr1.server) req-root test-state

  stats-of : WebResponse -> Text
  stats-of (wr2) = web-server-stats (wr2.server)

  test-parse-body : Text =
    let req = http-parse-request [80, 79, 83, 84, 32, 47, 120, 32, 72, 84, 84, 80, 47, 49, 46, 48, 13, 10, 13, 10, 104, 105]
    in "method=" & req.method & " body=" & req.body

  test-parse-no-body : Text =
    let req = http-parse-request [71, 69, 84, 32, 47, 32, 72, 84, 84, 80, 47, 49, 46, 48, 13, 10]
    in "no-body-len=" & show (text-length (req.body))

  opening : [Console, Identity] Nothing = act
    st <- get-status 0
    he <- get-health 0
    nf <- get-404 0
    s1 <- get-status 0
    s2 <- get-again s1
    print-line-uni (show-status-type st)
    print-line-uni (show-status-body-len he)
    print-line-uni (show-status nf)
    print-line-uni (stats-of s2)
    print-line-uni test-parse-body
    print-line-uni test-parse-no-body
  end
