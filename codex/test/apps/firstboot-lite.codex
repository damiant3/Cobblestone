Chapter: FirstBootLite
  cites Foreword chapter Console
  cites Foreword chapter Maybe

Section: Welcome
  welcome-lines : List Text
  welcome-lines = [
    "",
    "  ================================================================",
    "                      Welcome to Codex",
    "  ================================================================",
    "",
    "  A self-sustaining operating system, compiler, and development",
    "  environment. Everything on this device was compiled by itself.",
    "",
    "  Press Enter to begin.",
    ""
  ]

  spin : Integer -> Integer
  spin (x) = spin x

Section: Body
  opening : [Console] Nothing = act
    let lines = welcome-lines
    in print-lines lines 0 (list-length lines)
    print-line (show (spin 0))
  end

  print-lines : List Text, Integer, Integer -> [Console] Nothing
  print-lines (lines) (i) (len) = act
    if i < len then act
      print-line (list-at lines i)
      print-lines lines (i + 1) len
    end
    else act
      print-line ""
    end
  end

