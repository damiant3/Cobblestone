Chapter: HandshakeTest
  cites Trust chapter Handshake

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-completed : Text =
    show-bool (hs-is-completed (HsCompleted 7500))

  test-not-failed : Text =
    show-bool (hs-is-failed (HsCompleted 7500))

  test-failed : Text =
    show-bool (hs-is-failed (HsFailed "test"))

  test-score : Text =
    show (hs-trust-score (HsCompleted 7500))

  opening : [Console] Nothing = act
    print-line-uni test-completed
    print-line-uni test-not-failed
    print-line-uni test-failed
    print-line-uni test-score
  end
