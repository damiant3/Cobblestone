Chapter: NicPing

 Test NIC: send an ARP request via NE2000 register I/O, check for reply.

Section: NE2000 Ports
  ne2k-cr : Integer = 768
  ne2k-bnry : Integer = 771
  ne2k-tpsr : Integer = 772
  ne2k-tbcr0 : Integer = 773
  ne2k-tbcr1 : Integer = 774
  ne2k-isr : Integer = 775
  ne2k-rsar0 : Integer = 776
  ne2k-rsar1 : Integer = 777
  ne2k-rbcr0 : Integer = 778
  ne2k-rbcr1 : Integer = 779
  ne2k-data : Integer = 784
  ne2k-tx-page : Integer = 64

Section: Helpers

 Every one of these drives the NE2000 through raw port I/O, so every
 one of them says so. They used to be typed pure while doing exactly
 this, which is what made the chapter's [Console] signature a lie the
 compiler could not see.

  setup-dma-write : Integer, Integer -> [Device.Port] Integer
  setup-dma-write (page) (count) = act
    a <- port-out-byte ne2k-rsar0 0
    b <- port-out-byte ne2k-rsar1 page
    c <- port-out-byte ne2k-rbcr0 (bit-and count 255)
    d <- port-out-byte ne2k-rbcr1 (bit-shr count 8)
    port-out-byte ne2k-cr 18
  end

  setup-dma-read : Integer, Integer, Integer -> [Device.Port] Integer
  setup-dma-read (lo) (hi) (count) = act
    a <- port-out-byte ne2k-rsar0 lo
    b <- port-out-byte ne2k-rsar1 hi
    c <- port-out-byte ne2k-rbcr0 (bit-and count 255)
    d <- port-out-byte ne2k-rbcr1 (bit-shr count 8)
    port-out-byte ne2k-cr 10
  end

  w : Integer -> [Device.Port] Integer
  w (byte) = port-out-byte ne2k-data byte

  r : [Device.Port] Integer
  r = port-in-byte ne2k-data

  transmit : Integer -> [Device.Port] Integer
  transmit (count) = act
    a <- port-out-byte ne2k-tpsr ne2k-tx-page
    b <- port-out-byte ne2k-tbcr0 (bit-and count 255)
    c <- port-out-byte ne2k-tbcr1 (bit-shr count 8)
    port-out-byte ne2k-cr 38
  end

  check-rx : [Device.Port] Integer
  check-rx = act
    a <- port-out-byte ne2k-cr 98
    curr <- port-in-byte (768 + 7)
    b <- port-out-byte ne2k-cr 34
    bnry <- port-in-byte ne2k-bnry
    if curr == bnry then 0 else 1
  end

Section: Body

 net-status and net-get-hwaddr read the NIC, so this chapter declares
 Network.Read and earns cap-network-read. Nothing here sends through
 net-send-raw -- the frame goes out by hand over the data port -- so
 there is no Network.Write to declare.

  opening : [Console, Network.Read, Device.Port] Nothing = act
    status <- net-status
    if status == 0 then print-line-uni "FAIL:no-nic"
    else act
      m0 <- net-get-hwaddr 0
      m1 <- net-get-hwaddr 1
      m2 <- net-get-hwaddr 2
      m3 <- net-get-hwaddr 3
      m4 <- net-get-hwaddr 4
      m5 <- net-get-hwaddr 5
      dma <- setup-dma-write ne2k-tx-page 42
      d0 <- w 255
      d1 <- w 255
      d2 <- w 255
      d3 <- w 255
      d4 <- w 255
      d5 <- w 255
      s0 <- w m0
      s1 <- w m1
      s2 <- w m2
      s3 <- w m3
      s4 <- w m4
      s5 <- w m5
      et0 <- w 8
      et1 <- w 6
      hw0 <- w 0
      hw1 <- w 1
      pt0 <- w 8
      pt1 <- w 0
      hl <- w 6
      pl <- w 4
      op0 <- w 0
      op1 <- w 1
      sm0 <- w m0
      sm1 <- w m1
      sm2 <- w m2
      sm3 <- w m3
      sm4 <- w m4
      sm5 <- w m5
      si0 <- w 10
      si1 <- w 0
      si2 <- w 2
      si3 <- w 15
      tm0 <- w 0
      tm1 <- w 0
      tm2 <- w 0
      tm3 <- w 0
      tm4 <- w 0
      tm5 <- w 0
      ti0 <- w 10
      ti1 <- w 0
      ti2 <- w 2
      ti3 <- w 2
      tx <- transmit 42
      isr <- port-in-byte ne2k-isr
      print-line-uni ("tx isr=" & show isr)
      has-rx <- check-rx
      print-line-uni ("rx=" & show has-rx)
      if has-rx == 1 then act
        rd <- setup-dma-read 0 70 42
        rxb0 <- r
        rxb1 <- r
        rxb2 <- r
        rxb3 <- r
        print-line-uni ("hdr: " & show rxb0 & " " & show rxb1 & " " & show rxb2 & " " & show rxb3)
        print-line-uni "PASS"
      end
      else print-line-uni "FAIL:no-reply"
    end
  end

