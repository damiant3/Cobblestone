   sector 2  kind 0   a five-character record that is NOT a definition
   sector 3  kind 30  an unsigned definition, hash abc123
   sector 4  kind 30  a signed definition, hash def456, signature aabb

 We say:

Section: Reading a fact back

  show-fact : Maybe Fact -> Text
  show-fact (m) =
    when m
     is None -> "absent"
     is Just (f) -> f.content & "/" & f.author & "/" & show (f.timestamp)

  show-signed : Maybe SignedFact -> Text
  show-signed (m) =
    when m
     is None -> "unpublished"
     is Just (s) -> s.signer-fingerprint & "/" & show (list-length (s.signature))

Section: A bundle that already holds something

  prior : Fact
  prior = Fact {
    hash = "zzz999",
    kind = DefinitionFact,
    content = "from the blob",
    author = "base",
    timestamp = 1
  }

Section: Body

  opening : [Console, Device.Block] Nothing = act
    fresh <- store-read-bundle bundle-empty
    print-line-uni ("count=" & show (fact-count (fresh.facts)))
    print-line-uni ("unsigned=" & show-fact (fact-load (fresh.facts) "abc123"))
    print-line-uni ("signed=" & show-fact (fact-load (fresh.facts) "def456"))
    print-line-uni ("published=" & show-signed (hamt-get (fresh.signed) "def456"))
    print-line-uni ("offered-not-published=" & show-signed (hamt-get (fresh.signed) "abc123"))
    supplemented <- store-read-bundle (bundle-offer bundle-empty prior)
    print-line-uni ("supplemented-count=" & show (fact-count (supplemented.facts)))
    print-line-uni ("prior-survives=" & show-fact (fact-load (supplemented.facts) "zzz999"))
  end
