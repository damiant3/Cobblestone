  ca-parsed : Maybe X509Cert = x509-parse ca-cert

  anchors : List X509Anchor =
    when ca-parsed is None -> [] is Just (c) -> [X509Anchor { xa-subject = c.xc-subject, xa-key = c.xc-key }]

Section: The Device

  resources : List Lwm2mRes = [
    lwm2m-res lwm2m-obj-device 0 lwm2m-res-manufacturer [67, 111, 100, 101, 120],
    lwm2m-res lwm2m-obj-device 0 lwm2m-res-model [66, 108, 117]
  ]

  reg : Lwm2mRegistration = Lwm2mRegistration {
    endpoint = "blu-probe", lifetime = 8, binding = "U",
    objects = [lwm2m-obj-device]
  }

Section: Helpers

  bytes-eq : List Integer, List Integer -> Boolean
  bytes-eq (a) (b) =
    if list-length a /= list-length b then False else be-loop a b 0 (list-length a)
  be-loop : List Integer, List Integer, Integer, Integer -> Boolean
  be-loop (a) (b) (i) (n) =
    if i >= n then True
    else if list-at a i /= list-at b i then False
    else be-loop a b (i + 1) n

  take-from : List Integer, Integer, Integer -> List Integer
  take-from (bs) (i) (n) = tf-loop bs i n []
  tf-loop : List Integer, Integer, Integer, List Integer -> List Integer
  tf-loop (bs) (i) (n) (acc) =
    if i >= n then acc else tf-loop bs (i + 1) n (list-push acc (list-at bs i))

  mid-of : List Integer -> Integer
  mid-of (d) = when coap-parse d is None -> (0 - 1) is Just (m) -> m.cm-msg-id

  path-head : List Integer -> List Integer
  path-head (d) =
    when coap-parse d
      is None -> []
      is Just (m) ->
        let ps = coap-find-options (m.cm-options) coap-opt-uri-path
        in if list-length ps == 0 then [] else list-at ps 0

Section: Entry

  opening : [Console] Nothing =
    let st1 = dtls-ep-client (dtls-ep-with-anchors (dtls-ep-new False c-priv c-random [] []) anchors cal-now peer-name) 0
    in let d1 = list-at (st1.es-out) 0
    in let sv0 = dtls-ep-with-cert (dtls-ep-new True s-priv s-random cookie-secret client-addr) [leaf-cert] leaf-priv leaf-pub
    in let st2 = dtls-ep-recv sv0 d1 10
    in let d2 = list-at (st2.es-out) 0
    in let st3 = dtls-ep-recv (st1.es-ep) d2 20
    in let d3 = list-at (st3.es-out) 0
    in let st4 = dtls-ep-recv (st2.es-ep) d3 30
    in let d-sh = list-at (st4.es-out) 0
    in let d-cert = list-at (st4.es-out) 1
    in let d-cv = list-at (st4.es-out) 2
    in let d-fin = list-at (st4.es-out) 3
    in let st5 = dtls-ep-recv (st3.es-ep) d-sh 40
    in let st6 = dtls-ep-recv (st5.es-ep) d-cert 41
    in let st7 = dtls-ep-recv (st6.es-ep) d-cv 42
    in let st8 = dtls-ep-recv (st7.es-ep) d-fin 43
    in let d-cfin = list-at (st8.es-out) 0
    in let st9 = dtls-ep-recv (st4.es-ep) d-cfin 50

    in let ep0 = lwm2m-coaps-new (lwm2m-client-new reg resources) (st8.es-ep)
    in let rg = lwm2m-coaps-register ep0
    in let reg-rec = list-at (rg.xls-out) 0

    in let sv1 = dtls-ep-recv-app (st9.es-ep) reg-rec
    in let sb1 = dtls-ep-app-in (sv1.es-ep)
    in let n1 = list-length sb1
    in let reg-dgram = take-from sb1 0 n1
    in let seq1 = dtls-ep-app-right (sv1.es-ep)
    in let reg-not-plain = bytes-eq reg-rec reg-dgram == False
    in let reg-to-rd = bytes-eq (path-head reg-dgram) (coap-text-to-bytes "rd")

    in let loc-opts = [CoapOption { number = coap-opt-location-path, value = [114, 100] },
                       CoapOption { number = coap-opt-location-path, value = [55, 52] }]
    in let created = coap-build-response CoapAcknowledgement coap-201-created (mid-of reg-dgram) [] loc-opts []
    in let ss1 = dtls-ep-send-app (sv1.es-ep) created
    in let cl1 = lwm2m-coaps-recv (rg.xls-ep) (list-at (ss1.es-out) 0)
    in let registered = lwm2m-coaps-registered (cl1.xls-ep)

    in let up = lwm2m-coaps-update (cl1.xls-ep)
    in let up-out = list-length (up.xls-out)
    in let sv2 = dtls-ep-recv-app (ss1.es-ep) (list-at (up.xls-out) 0)
    in let seq2 = dtls-ep-app-right (sv2.es-ep)
    in let n2 = list-length (dtls-ep-app-in (sv2.es-ep))
    in let up-seg = bytes-eq (path-head (take-from (dtls-ep-app-in (sv2.es-ep)) n1 n2)) (coap-text-to-bytes "rd")
    in let still-registered = lwm2m-coaps-registered (up.xls-ep)

    in let dr = lwm2m-coaps-deregister (up.xls-ep)
    in let dr-out = list-length (dr.xls-out)
    in let sv3 = dtls-ep-recv-app (sv2.es-ep) (list-at (dr.xls-out) 0)
    in let seq3 = dtls-ep-app-right (sv3.es-ep)
    in let n3 = list-length (dtls-ep-app-in (sv3.es-ep))
    in let dr-seg = bytes-eq (path-head (take-from (dtls-ep-app-in (sv3.es-ep)) n2 n3)) (coap-text-to-bytes "rd")
    in let gone = lwm2m-coaps-registered (dr.xls-ep) == False
    in let auth = lwm2m-coaps-authenticated (dr.xls-ep)

    in act
      print-line-uni ("lwm2m-coaps register not-plain=" & show reg-not-plain & " to-rd=" & show reg-to-rd)
      print-line-uni ("lwm2m-coaps registered=" & show registered)
      print-line-uni ("lwm2m-coaps update out=" & show up-out & " to-rd=" & show up-seg & " still=" & show still-registered)
      print-line-uni ("lwm2m-coaps deregister out=" & show dr-out & " to-rd=" & show dr-seg & " gone=" & show gone)
      print-line-uni ("lwm2m-coaps seq reg=" & show seq1 & " upd=" & show seq2 & " dereg=" & show seq3)
      print-line-uni ("lwm2m-coaps authenticated=" & show auth)
    end
