Chapter: MetricStoreTest
  cites Observe chapter MetricStore
  cites Foreword chapter Hamt
  cites Foreword chapter Maybe

Section: Tests
  test-empty : Text =
    "count=" & show (metric-count metric-store-empty)

  test-counter : Text =
    let s0 = metric-register metric-store-empty "hits" Counter
    in let s1 = metric-add s0 "hits" 3
    in "val=" & show (metric-value s1 "hits")

  test-gauge : Text =
    let s0 = metric-register metric-store-empty "mem" Gauge
    in let s1 = metric-set s0 "mem" 1536
    in let m = metric-get s1 "mem"
    in when m
      is Just (v) -> "val=" & show (v.value) & " max=" & show (v.max-val)
      is None -> "none"

  test-gauge-minmax : Text =
    let s0 = metric-register metric-store-empty "cpu" Gauge
    in let s1 = metric-set s0 "cpu" 3
    in let s2 = metric-set s1 "cpu" 8
    in let m = metric-get s2 "cpu"
    in when m
      is Just (v) -> "val=" & show (v.value) & " min=" & show (v.min-val) & " max=" & show (v.max-val)
      is None -> "none"

  test-histogram : Text =
    let s0 = metric-register metric-store-empty "latency" Histogram
    in let s1 = metric-observe s0 "latency" 10
    in let s2 = metric-observe s1 "latency" 20
    in let s3 = metric-observe s2 "latency" 30
    in let m = metric-get s3 "latency"
    in when m
      is Just (v) -> "total=" & show (v.value) & " min=" & show (v.min-val) & " max=" & show (v.max-val) & " avg=" & show (metric-average v) & " samples=" & show (v.sample-count)
      is None -> "none"

  test-counter-add : Text =
    let s0 = metric-register metric-store-empty "reqs" Counter
    in let s1 = metric-add s0 "reqs" 42
    in let m = metric-get s1 "reqs"
    in when m
      is Just (v) -> "reqs=" & show (v.value) & " min=" & show (v.min-val) & " max=" & show (v.max-val) & " samples=" & show (v.sample-count)
      is None -> "none"

  test-missing : Text =
    "val=" & show (metric-value metric-store-empty "nope")

  opening : [Console] Nothing = act
    print-line-uni test-empty
    print-line-uni test-counter
    print-line-uni test-gauge
    print-line-uni test-gauge-minmax
    print-line-uni test-histogram
    print-line-uni test-counter-add
    print-line-uni test-missing
  end
