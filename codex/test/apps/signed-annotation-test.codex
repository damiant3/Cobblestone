Chapter: SignedAnnotationTest

  cites Foreword chapter Console
  cites Works chapter SignedAnnotation
  cites Works chapter Annotation
  cites Works chapter KeyManager
  cites Trust chapter TrustLattice

Section: Body

  opening : [Console] Nothing =
    let kp = generate-keypair [5, 10, 15, 20, 25, 30, 35, 40]
    in let target = make-target "Security" "validate"
    in let ann = create-annotation target Warning "alice" "SQL risk" 5000
    in let sa = sign-annotation kp ann
    in let kr = keyring-add keyring-empty "alice" (kp.public-key) 8000
    in let verified-sa = verify-annotation kr sa
    in let is-verified = if verified-sa.verified then "yes" else "no"
    in let lat = lattice-add-direct lattice-empty "alice" 8000
    in let aw = compute-annotation-weight lat verified-sa
    in let trust = integer-to-text (aw.trust-score)
    in let weight = integer-to-text (aw.effective-weight)
    in let auth = authority-label (classify-authority aw)
    in let kind-w = integer-to-text (annotation-kind-weight Warning)
    in act
      print-line-uni ("verified=" & is-verified)
      print-line-uni ("trust=" & trust)
      print-line-uni ("weight=" & weight)
      print-line-uni ("authority=" & auth)
      print-line-uni ("kind-weight=" & kind-w)
    end
