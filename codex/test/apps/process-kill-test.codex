Chapter: ProcessKillTest

Section: Body
  spin-until : Integer -> Integer
  spin-until (deadline) =
    if get-ticks >= deadline then 0
    else spin-until deadline

  opening : [Concurrent, Capability] Integer = act
    child <- process-spawn-priority (\x -> spin-until (get-ticks + 10000)) 2 0
    k <- process-kill child
    let w = process-wait child
    in act
      self-kill <- process-kill (process-get-pid)
      let r = k * 10 + self-kill
      in r
    end
  end
