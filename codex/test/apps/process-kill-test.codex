Chapter: ProcessKillTest
  cites Codex chapter General

Section: Body
  opening : Integer =
    let child = process-spawn-priority (\x ->
      spin-until (get-ticks + 10000)) 2 0
    in let k = process-kill child
    in let w = process-wait child
    in let self-kill = process-kill (process-get-pid)
    in k * 10 + self-kill

  spin-until : Integer -> Integer
  spin-until (deadline) =
    if get-ticks >= deadline then 0
    else spin-until deadline
