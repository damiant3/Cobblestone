Chapter: UsbMscDetectTest
  cites Codex chapter General
  cites Kernel chapter UsbMassStorage
  cites Kernel chapter Usb
  cites Kernel chapter Xhci
  cites Kernel chapter Pci

Section: Tests
  test-not-found : Text =
    let dev = msc-not-found
    in "found=" & (if dev.msc-found then "T" else "F") & " slot=" & show (dev.msc-slot)

  test-cbw-signature : Text =
    "cbw-sig=" & show msc-cbw-signature & " csw-sig=" & show msc-csw-signature

  test-scsi-commands : Text =
    "inquiry=" & show scsi-inquiry & " read-cap=" & show scsi-read-capacity-10 & " read10=" & show scsi-read-10

  test-device-format : Text =
    let dev = MscDevice {
      msc-slot = 1, msc-bulk-in-ep = 1, msc-bulk-out-ep = 2,
      msc-max-packet-in = 1024, msc-max-packet-out = 1024,
      msc-max-lun = 0, msc-sector-count = 16384, msc-sector-size = 512,
      msc-tag = 1, msc-vendor = "Codex", msc-product = "Virtual Disk",
      msc-found = True
    }
    in "slot=" & show (dev.msc-slot) & " sectors=" & show (dev.msc-sector-count) & " vendor=" & dev.msc-vendor

  test-usb-classes : Text =
    "hid=" & show usb-class-hid & " msc=" & show usb-class-mass-storage & " video=" & show usb-class-video

  opening : [Console] Nothing = act
    print-line-uni test-not-found
    print-line-uni test-cbw-signature
    print-line-uni test-scsi-commands
    print-line-uni test-device-format
    print-line-uni test-usb-classes
  end
