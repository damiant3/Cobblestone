Chapter: PageNumberOverflowTest
  cites Browser chapter PageCompiler
  cites Foreword chapter Console

 A page number too large for an Integer tokenizes as `TkBadNum`, which
 `compile-page` refuses, instead of trapping the tokenizer.

  toks-of : Text -> List PageTok
  toks-of (s) = page-tokenize s 0 (text-length s) []

  first-num : List PageTok, Integer -> Text
  first-num (toks) (i) =
    if i >= list-length toks then "none"
    else when list-at toks i
      is TkNum (n) -> show n
      is TkBadNum -> "bad"
      is otherwise -> first-num toks (i + 1)

  ask : Text, Text -> Text
  ask (label) (s) =
    let t = toks-of s
    in label & " first=" & first-num t 0 & " refused=" & show (toks-have-bad-number t 0) & " count=" & show (list-length t)

  opening : [Console] Nothing = act
    print-line-uni (ask "small     " "label 42 x")
    print-line-uni (ask "i64 max   " "label 9223372036854775807 x")
    print-line-uni (ask "max + 1   " "label 9223372036854775808 x")
    print-line-uni (ask "20 digits " "label 99999999999999999999 x")
    print-line-uni (ask "at end    " "label 99999999999999999999")
    print-line-uni "done"
  end
