Chapter: SheetLookupTest
  cites Sheets chapter CellEval
  cites Sheets chapter CellGraph
  cites Sheets chapter CellStore
  cites Foreword chapter CCE

 LOOKUP is NAMED rather than positional, and the line that holds the
 whole ruling is the INSERTED COLUMN: the same lookup, over a table
 with a new column pushed in front of the answer column, answers the
 same thing. A positional lookup answers the inserted column instead,
 and nothing in the sheet says so. The two tables are built separately
 and both are printed, because a claim about what does not change needs
 two things to compare.

 The three refusals each name what a person can act on: no column
 carries that header, no row carries that key, more than one row does.
 The duplicate line is the one other spreadsheets answer instead of
 refusing; taking the first row is a near match wearing an exact
 match's clothes, and the arm holds the refusal rather than a value.

 The sabotage: index the answer column by POSITION and the
 inserted-column line moves from 250 to Blue while every other line
 stands; take the first row on a duplicate key and the duplicate line
 answers 3 rather than refusing.

Section: Body

  sl-say : Program, Integer, Integer -> Text
  sl-say (pg) (r) (c) = eval-cell pg (eval-run pg) r c

Section: Entry

 The first table is Item, Qty, Cost across columns A, B and C. The
 second is the same table with a Colour column inserted between Qty and
 Cost, which moves Cost from column C to column D.

  opening : [Console] Nothing =
    let dq = utf8-bytes-to-text [34]

    in let s1 = sheet-new 5 5 512
    in let h1 = sheet-set-text s1 0 0 "Item"
    in let h2 = sheet-set-text s1 0 1 "Qty"
    in let h3 = sheet-set-text s1 0 2 "Cost"
    in let r1a = sheet-set-text s1 1 0 "Widget"
    in let r1b = sheet-set s1 1 1 3
    in let r1c = sheet-set s1 1 2 250
    in let r2a = sheet-set-text s1 2 0 "Gadget"
    in let r2b = sheet-set s1 2 1 2
    in let r2c = sheet-set s1 2 2 400
    in let p1 = graph-put (graph-new s1) 4 0 ("=LOOKUP(A1:C3," & dq & "Widget" & dq & "," & dq & "Cost" & dq & ")")

    in let s2 = sheet-new 5 5 512
    in let i1 = sheet-set-text s2 0 0 "Item"
    in let i2 = sheet-set-text s2 0 1 "Qty"
    in let i3 = sheet-set-text s2 0 2 "Colour"
    in let i4 = sheet-set-text s2 0 3 "Cost"
    in let j1a = sheet-set-text s2 1 0 "Widget"
    in let j1b = sheet-set s2 1 1 3
    in let j1c = sheet-set-text s2 1 2 "Blue"
    in let j1d = sheet-set s2 1 3 250
    in let j2a = sheet-set-text s2 2 0 "Gadget"
    in let j2b = sheet-set s2 2 1 2
    in let j2c = sheet-set-text s2 2 2 "Red"
    in let j2d = sheet-set s2 2 3 400
    in let p2 = graph-put (graph-new s2) 4 0 ("=LOOKUP(A1:D3," & dq & "Widget" & dq & "," & dq & "Cost" & dq & ")")

    in let p1b = graph-put p1 4 1 ("=LOOKUP(A1:C3," & dq & "Widget" & dq & "," & dq & "Qty" & dq & ")")
    in let p1c = graph-put p1b 4 2 ("=LOOKUP(A1:C3," & dq & "Sprocket" & dq & "," & dq & "Cost" & dq & ")")
    in let p1d = graph-put p1c 4 3 ("=LOOKUP(A1:C3," & dq & "Widget" & dq & "," & dq & "Weight" & dq & ")")

    in let s3 = sheet-new 5 5 512
    in let k1 = sheet-set-text s3 0 0 "Item"
    in let k2 = sheet-set-text s3 0 1 "Qty"
    in let k3a = sheet-set-text s3 1 0 "Widget"
    in let k3b = sheet-set s3 1 1 3
    in let k4a = sheet-set-text s3 2 0 "Widget"
    in let k4b = sheet-set s3 2 1 9
    in let p3 = graph-put (graph-new s3) 4 0 ("=LOOKUP(A1:B3," & dq & "Widget" & dq & "," & dq & "Qty" & dq & ")")

    in act
      print-line-uni ("Cost of Widget, table Item Qty Cost: " & sl-say p1d 4 0)
      print-line-uni ("the SAME lookup after a Colour column is inserted before Cost: " & sl-say p2 4 0)
      print-line-uni ("a second column by name: Qty of Widget is " & sl-say p1d 4 1)
      print-line-uni ("no row carries that key: " & sl-say p1d 4 2)
      print-line-uni ("no column carries that header: " & sl-say p1d 4 3)
      print-line-uni ("the key is not unique: " & sl-say p3 4 0)
    end
