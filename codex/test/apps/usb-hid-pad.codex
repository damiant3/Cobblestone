Section: Test

  uhp-wait : UsbPad, Integer, Integer, Integer -> [Device.Port] Integer
  uhp-wait (p) (want) (prev) (secs) = act
    let r = pad-pump p
    in act
      now <- rtc-seconds 0
      if pad-buttons-now p == want then 1
      else if secs <= 0 then 0
      else if now < 0 then uhp-wait p want prev secs
      else if now == prev then uhp-wait p want prev secs
      else uhp-wait p want now (secs - 1)
    end
  end

  opening : [Console, Device.Port, Device.Mmio] Nothing = act
    att <- usb-attach
    let k = att.ua-kbd
    in let p = att.ua-pad
    in act
      print-line-uni ("kbd: ok=" & (if k.uk-ok then "1" else "0") & " pad: ok=" & (if p.upad-ok then "1" else "0") & " same-dev=" & (if (k.uk-dev).ud-slot == (p.upad-dev).ud-slot then "1" else "0") & " layout buttons=" & show (list-length ((p.upad-layout).pl-buttons)) & " axes=" & show (list-length ((p.upad-layout).pl-axes)))
      s0 <- rtc-seconds 0
      hit <- uhp-wait p 5 s0 8
      print-line-uni ("buttons=" & show (pad-buttons-now p) & " x=" & show (pad-axis-now p 0) & " y=" & show (pad-axis-now p 1) & " z=" & show (pad-axis-now p 2) & " rz=" & show (pad-axis-now p 3) & " hat=" & show (pad-hat-now p) & " hit=" & show hit)
    end
  end

