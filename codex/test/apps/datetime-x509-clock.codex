Chapter: DateTimeX509Clock
  cites Dev chapter DateTimeSettings
  cites Encode chapter X509Chain
  cites Foreword chapter Console

 The certificate clock: RTC registers in BCD, 24-hour mode (status B 2), read
 as 2026-11-01 12:34:56 UTC, become the digits X509Chain compares, and the
 validity verdict is the chain's own (x509-window) over a window of
 2025-01-01 00:00:00 to 2030-12-31 23:59:59.

Section: Body

  ascii : List Integer -> Text
  ascii (bs) = ascii-loop bs 0 ""

  ascii-loop : List Integer, Integer, Text -> Text
  ascii-loop (bs) (i) (acc) = if i >= list-length bs then acc else ascii-loop bs (i + 1) (acc & show (list-at bs i - 48))

  verdict : X509Verdict -> Text
  verdict (v) = when v
    is ChainOk -> "ok"
    is ChainExpired -> "expired"
    is ChainNotYetValid -> "not yet valid"
    is otherwise -> "other"

  not-before : List Integer = [50, 48, 50, 53, 48, 49, 48, 49, 48, 48, 48, 48, 48, 48]

  not-after : List Integer = [50, 48, 51, 48, 49, 50, 51, 49, 50, 51, 53, 57, 53, 57]

  rtc : Integer, Integer, Integer -> DateTimeState
  rtc (year) (month) (day) = dt-from-rtc datetime-new 2 86 52 18 day month year

  at : DateTimeState -> Text
  at (st) = ascii (dt-x509-now st) & " " & verdict (x509-window not-before not-after (dt-x509-now st))

  opening : [Console] Nothing = act
    print-line-uni ("inside " & at (rtc 38 17 1))
    print-line-uni ("after " & at (rtc 49 1 1))
    print-line-uni ("before " & at (rtc 36 1 1))
    print-line-uni ("unread [" & ascii (dt-x509-now datetime-new) & "] " & verdict (x509-window not-before not-after (dt-x509-now datetime-new)))
  end

