Chapter: ChachaPolySizeGuard
  cites Foreword chapter Aes
  cites Foreword chapter Maybe
  cites Foreword chapter ChaCha20Poly1305


Section: Vector

  k32 : List Integer =
    [128, 129, 130, 131, 132, 133, 134, 135, 136, 137, 138, 139, 140, 141, 142, 143,
     144, 145, 146, 147, 148, 149, 150, 151, 152, 153, 154, 155, 156, 157, 158, 159]

  k64 : List Integer = k32 & k32

  n12 : List Integer = [7, 0, 0, 0, 64, 65, 66, 67, 68, 69, 70, 71]

  n12b : List Integer = [9, 0, 0, 0, 64, 65, 66, 67, 68, 69, 70, 71]

  n16 : List Integer = n12 & [1, 2, 3, 4]

  n11 : List Integer = [7, 0, 0, 0, 64, 65, 66, 67, 68, 69, 70]

  plain : List Integer = [1, 2, 3, 4, 5, 6, 7, 8]

  aad : List Integer = [80, 81, 82, 83]

Section: Helpers

  hex : List Integer -> Text
  hex (bs) = hex-loop bs 0 (list-length bs) ""

  hex-loop : List Integer, Integer, Integer, Text -> Text
  hex-loop (bs) (i) (n) (acc) =
    if i >= n then acc
    else hex-loop bs (i + 1) n (acc & aes-hex-byte (list-at bs i))

  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

  enc-row : Text, List Integer, List Integer -> Text
  enc-row (label) (key) (nonce) =
    let r = chacha20poly1305-encrypt key nonce plain aad
    in label & " valid=" & show-bool (r.cp-valid) & " ct=" & hex (r.cp-ciphertext)

  dec-row : Text, List Integer, List Integer -> Text
  dec-row (label) (key) (nonce) =
    let good = chacha20poly1305-encrypt k32 n12 plain aad
    in let d = chacha20poly1305-decrypt key nonce (good.cp-ciphertext) aad (good.cp-tag)
    in when d
      is Just (p) -> label & " decrypt=" & hex p
      is None -> label & " decrypt=REJECTED"

Section: Body

  zeros : Integer, List Integer -> List Integer
  zeros (n) (acc) = if n <= 0 then acc else zeros (n - 1) (list-push acc 0)

  raw-row : Text, List Integer -> [Console] Nothing
  raw-row (label) (result) = print-line-uni (label & " length=" & show (list-length result))

  opening : [Console] Nothing = act
    print-line-uni (enc-row "1-key32-nonce12" k32 n12)
    print-line-uni (enc-row "2-key32-nonce12b" k32 n12b)
    print-line-uni (dec-row "3-roundtrip" k32 n12)
    print-line-uni (dec-row "4-wrong-nonce" k32 n12b)
    print-line-uni (enc-row "5-nonce16" k32 n16)
    print-line-uni (enc-row "6-key64-nonce12" k64 n12)
    print-line-uni (enc-row "7-key64-nonce12b" k64 n12b)
    print-line-uni (enc-row "8-nonce11" k32 n11)
    print-line-uni (dec-row "9-decrypt-nonce11" k32 n11)
    raw-row "raw-key31" (chacha20-encrypt (zeros 31 []) n12 plain 1)
    raw-row "raw-key33" (chacha20-encrypt (k32 & [0]) n12 plain 1)
    raw-row "raw-nonce11" (chacha20-encrypt k32 n11 plain 1)
    raw-row "raw-nonce13" (chacha20-encrypt k32 (n12 & [0]) plain 1)
    raw-row "raw-negative-counter" (chacha20-encrypt k32 n12 plain (0 - 1))
    raw-row "raw-wide-counter" (chacha20-encrypt k32 n12 plain 4294967296)
    raw-row "last-counter64" (chacha20-encrypt k32 n12 (zeros 64 []) 4294967295)
    raw-row "last-counter65" (chacha20-encrypt k32 n12 (zeros 65 []) 4294967295)
    raw-row "penultimate128" (chacha20-encrypt k32 n12 (zeros 128 []) 4294967294)
    raw-row "penultimate129" (chacha20-encrypt k32 n12 (zeros 129 []) 4294967294)
    raw-row "raw-wide-byte" (chacha20-encrypt k32 n12 [256] 1)
    raw-row "raw-negative-byte" (chacha20-encrypt k32 n12 [0 - 1] 1)
    raw-row "block-key31" (chacha-block (zeros 31 []) 0 n12)
    raw-row "block-negative-counter" (chacha-block k32 (0 - 1) n12)
    raw-row "keygen-key31" (chacha-poly-keygen (zeros 31 []) n12)
    raw-row "poly-key31" (poly1305-mac (zeros 31 []) plain)
    raw-row "poly-key33" (poly1305-mac (k32 & [0]) plain)
    raw-row "poly-wide-byte" (poly1305-mac k32 [256])
    raw-row "poly-negative-key" (poly1305-mac ([0 - 1] & zeros 31 []) plain)
    print-line-uni ("poly-empty-tag=" & show-bool (poly1305-verify [] [] []))
    print-line-uni ("aead-wide-plaintext=" & show-bool ((chacha20poly1305-encrypt k32 n12 [256] []).cp-valid))
    print-line-uni ("aead-wide-aad=" & show-bool ((chacha20poly1305-encrypt k32 n12 [] [256]).cp-valid))
    print-line-uni ("aead-negative-key=" & show-bool ((chacha20poly1305-encrypt ([0 - 1] & zeros 31 []) n12 plain []).cp-valid))
  end

