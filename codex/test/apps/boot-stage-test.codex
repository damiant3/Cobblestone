Chapter: BootStageTest

Section: Body
  opening : [Device.Block, Concurrent, Capability] Integer = act
    sectors <- block-sector-count
    let has-disk = if sectors > 0 then 1 else 0
    in let my-pid = process-get-pid
    in act
      drop1 <- process-restrict-cap my-pid 10
      child <- process-spawn (\x ->
        poke-byte 28000 0 42)
      let w = process-wait child
      in let child-ok = peek-byte 28000 0
      in act
        drop2 <- process-restrict-cap my-pid 12
        bad-spawn <- process-spawn (\x -> 0)
        has-disk * 1000 + child-ok * 10 + bad-spawn
      end
    end
