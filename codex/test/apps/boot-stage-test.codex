Chapter: BootStageTest

Section: Body
  opening : Integer =
    let sectors = block-sector-count
    in let has-disk = if sectors > 0 then 1 else 0
    in let my-pid = process-get-pid
    in let drop1 = process-restrict-cap my-pid 10
    in let child = process-spawn (\x ->
      poke-byte 28000 0 42)
    in let w = process-wait child
    in let child-ok = peek-byte 28000 0
    in let drop2 = process-restrict-cap my-pid 12
    in let bad-spawn = process-spawn (\x -> 0)
    in has-disk * 1000 + child-ok * 10 + bad-spawn
