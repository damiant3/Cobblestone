Chapter: ProcessKillBounds

 The x86 process table starts at 20480 with 256-byte slots. PID -1
 aliases the qword at 20224. Restore the observed neighbor before output;
 the arm runs in one disposable guest with no spawned child.

  opening : [Console, Concurrent, Capability] Nothing =
    let left = peek-qword 20224 -8
    in let original = peek-qword 20224 0
    in let right = peek-qword 20224 8
    in let canary = poke-qword 20224 0 #1122334455667788
    in act
      negative <- process-kill -1
      let observed = peek-qword 20224 0
      in let unchanged = observed == #1122334455667788
      in let neighbors = peek-qword 20224 -8 == left & peek-qword 20224 8 == right
      in let restore = poke-qword 20224 0 original
      in act
        upper <- process-kill 16
        self <- process-kill (process-get-pid)
        print-line-uni ("negative-result=" & show negative)
        print-line-uni ("negative-memory-preserved=" & show unchanged)
        print-line-uni ("adjacent-memory-preserved=" & show neighbors)
        print-line-uni ("upper-result=" & show upper)
        print-line-uni ("self-result=" & show self)
      end
    end
