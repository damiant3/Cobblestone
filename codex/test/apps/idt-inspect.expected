sel0: #0008
attr0: interrupt dpl 0 ist 0 present
attr8: interrupt dpl 0 ist 1 present
attr32: interrupt dpl 0 ist 0 present
stride1: 12
stride32: 384
present-count: 256
absent255: type 0 dpl 0 ist 0 NOT PRESENT
restored255: interrupt dpl 0 ist 0 present
low: refused: vector -1 is not in 0..255
high: refused: vector 256 is not in 0..255
key: last scancode none -- the keyboard ISR has not run
fault: no stall sample since boot -- the watchdog has not fired
master-imr: master imr #ec 2 3 5 6 7
slave-imr: slave  imr #ff 0 1 2 3 4 5 6 7
