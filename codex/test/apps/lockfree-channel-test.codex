Chapter: LockFreeChannelTest
  cites Sched chapter LockFreeChannel
  cites Foreword chapter Maybe

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Body
  opening : [Console] Nothing =
    let ch = lf-chan-create 4 0 0
    in act
      print-line-uni (show-bool (lf-chan-is-empty ch))
      print-line-uni (show (lf-chan-size ch))
      let r1 = lf-chan-send ch 10
      in let r2 = lf-chan-send (r1.chan) 20
      in let r3 = lf-chan-send (r2.chan) 30
      in act
        print-line-uni (show-bool (r1.sent))
        print-line-uni (show (lf-chan-size (r3.chan)))
        print-line-uni (show-bool (lf-chan-is-full (r3.chan)))
        let r4 = lf-chan-send (r3.chan) 40
        in act
          print-line-uni (show-bool (r4.sent))
          let v1 = lf-chan-recv (r3.chan)
          in act
            print-line-uni (when (v1.value) is Just (x) -> show x is None -> "none")
            let v2 = lf-chan-recv (v1.chan)
            in act
              print-line-uni (when (v2.value) is Just (x) -> show x is None -> "none")
              let v3 = lf-chan-recv (v2.chan)
              in act
                print-line-uni (when (v3.value) is Just (x) -> show x is None -> "none")
                let v4 = lf-chan-recv (v3.chan)
                in act
                  print-line-uni (when (v4.value) is Just (x) -> show x is None -> "none")
                  print-line-uni (show-bool (lf-chan-is-empty (v4.chan)))
                  print-line-uni (lf-chan-stats (v3.chan))
                  let closed = lf-chan-close (v3.chan)
                  in let r5 = lf-chan-send closed 50
                  in act
                    print-line-uni (show-bool (r5.sent))
                    print-line-uni (show-bool (lf-chan-is-closed closed))
                  end
                end
              end
            end
          end
        end
      end
    end

