  ca-parsed : Maybe X509Cert = x509-parse ca-cert

  anchors : List X509Anchor =
    when ca-parsed is None -> [] is Just (c) -> [X509Anchor { xa-subject = c.xc-subject, xa-key = c.xc-key }]

  peer-name : List Integer =
    [100, 101, 118, 105, 99, 101, 46, 99, 111, 100, 101, 120, 46, 116, 101, 115, 116]

  s0 : DtlsEp = dtls-ep-with-cert (dtls-ep-new True s-priv s-random cookie-secret client-addr) [leaf-cert] leaf-priv leaf-pub
  c0 : DtlsEp = dtls-ep-with-anchors (dtls-ep-new False c-priv c-random [] []) anchors cal-now peer-name

  body : List Integer = [50, 51]


Section: One Long Session

 L-PEROBJECT: one CoAPS session carries 300 GET exchanges, each answered with 1000 bytes, more in total than the
 DTLS application buffer's cap (262,144 entries). Every exchange must complete, and the client's buffer room must
 stay the size of one message rather than of everything the session has carried.

  payload : List Integer = fill 1000 []

  fill : Integer, List Integer -> List Integer
  fill (n) (acc) = if list-length acc >= n then acc else fill n (list-push acc 66)

  take-from : List Integer, Integer, Integer, List Integer -> List Integer
  take-from (bs) (i) (n) (acc) = if i >= n then acc else take-from bs (i + 1) n (list-push acc (list-at bs i))

  msg-id : List Integer -> Integer
  msg-id (d) = when coap-parse d is None -> (-1) is Just (m) -> m.cm-msg-id

  msg-token : List Integer -> List Integer
  msg-token (d) = when coap-parse d is None -> [] is Just (m) -> m.cm-token

  feed : DtlsEp, List (List Integer), Integer, Integer -> DtlsEpStep
  feed (ep) (recs) (i) (t) =
    let st = dtls-ep-recv ep (list-at recs i) t
    in if i + 1 >= list-length recs then st else feed (st.es-ep) recs (i + 1) (t + 1)

  Sess = record { se-c : CoapsEp, se-s : DtlsEp, se-sread : Integer, se-ok : Integer }

  session : Sess =
    let a1 = dtls-ep-client c0 0
    in let a2 = dtls-ep-recv s0 (list-at (a1.es-out) 0) 10
    in let a3 = dtls-ep-recv (a1.es-ep) (list-at (a2.es-out) 0) 20
    in let a4 = dtls-ep-recv (a2.es-ep) (list-at (a3.es-out) 0) 30
    in let a8 = feed (a3.es-ep) (a4.es-out) 0 40
    in let a9 = dtls-ep-recv (a4.es-ep) (list-at (a8.es-out) 0) 50
    in Sess { se-c = coaps-ep-new coap-ep-new (a8.es-ep), se-s = a9.es-ep, se-sread = 0, se-ok = 0 }

  exchange : Sess, Integer -> Sess
  exchange (s) (i) =
    let g = coaps-ep-get (s.se-c) "temp" i
    in if list-length (g.xs-out) == 0 then s
    else exchange-sent s g i

 A client whose last exchange never completed sends nothing more; the session has stopped, and the count says so.

  exchange-sent : Sess, CoapsStep, Integer -> Sess
  exchange-sent (s) (g) (i) =
    let sv = dtls-ep-recv-app (s.se-s) (list-at (g.xs-out) 0)
    in let sbuf = dtls-ep-app-in (sv.es-ep)
    in let req = take-from sbuf (s.se-sread) (list-length sbuf) []
    in let ss = dtls-ep-send-app (sv.es-ep) (coap-build-response CoapAcknowledgement coap-205-content (msg-id req) (msg-token req) [] payload)
    in let c = coaps-ep-recv (g.xs-ep) (list-at (ss.es-out) 0) i
    in Sess { se-c = c.xs-ep, se-s = ss.es-ep, se-sread = list-length sbuf, se-ok = s.se-ok + (if coaps-ep-done (c.xs-ep) then 1 else 0) }

  run : Sess, Integer, Integer -> Sess
  run (s) (i) (k) = if i >= k then s else run (exchange s i) (i + 1) k

  opening : [Console] Nothing =
    let s1 = run session 0 250
    in let m0 = __heap-save
    in let s2 = run s1 250 300
    in let m1 = __heap-save
    in let room = ((s2.se-c).xe-dtls).ep-app-room
    in act
      print-line-uni ("300 exchanges over one coaps session: answered " & show (s2.se-ok))
      print-line-uni ("client room after 300: " & show room & ", within one message: " & show (room <= 2048))
      print-line-uni ("last 50 exchanges; under 2500000 bytes: " & (if m1 - m0 < 2500000 then "yes" else "no, " & show (m1 - m0)))
    end