Chapter: MagicAuthSecretTest
  cites CodexMagic chapter MagicServer
  cites CodexMagic chapter Auth
  cites Foreword chapter TextSearch

 SignatureSlippage part E, the codexmagic server. Session tokens were
 "s" & next-nonce and the counter never moved, so the first account (the admin)
 held s1000; passwords were kept and compared in plain text; the challenge
 verify accepted a hash of public values. Each step's response is read before
 the next, because the handlers write into the store they are handed (L-ALIAS).

Section: Helpers
  mas-token : Text -> Text
  mas-token (resp) = let parts = text-split resp "\"" in if list-length parts < 4 then "" else list-at parts 3

  mas-req : MagicStore, Text -> MagicStep
  mas-req (store) (path) = dispatch-request store ("GET " & path & " HTTP/1.0")

Section: Body
  opening : [Console] Nothing =
    let bare = mas-req magic-store-new "/api/magic/auth/register?u=al&d=Al&p=secret1"
    in let line0 = "no secret, register: " & bare.resp
    in let keyed = magic-store-keyed magic-store-new [11, 22, 33, 44]
    in let r1 = mas-req keyed "/api/magic/auth/register?u=al&d=Al&p=secret1"
    in let t1 = mas-token (r1.resp)
    in let line1 = "keyed register: token is s1000=" & (if t1 == "s1000" then "True" else "False") & " length=" & show (text-length t1)
    in let g = mas-req (r1.store) "/api/magic/auth/me?t=s1000"
    in let line2 = "guessed s1000: " & g.resp
    in let m = mas-req (g.store) ("/api/magic/auth/me?t=" & t1)
    in let line3 = "issued token: " & m.resp
    in let w = mas-req (m.store) "/api/magic/auth/login?u=al&p=wrong"
    in let line4 = "wrong password: " & w.resp
    in let l = mas-req (w.store) "/api/magic/auth/login?u=al&p=secret1"
    in let t2 = mas-token (l.resp)
    in let line5 = "right password: new token differs=" & (if t2 /= t1 & text-length t2 > 1 then "True" else "False")
    in let d = mas-req (l.store) "/api/magic/state-dump"
    in let line6 = "state dump holds the password=" & (if text-contains (d.resp) "secret1" then "True" else "False")
    in let forged = hash-mix (5 * 31 + 0) 2654435761
    in let v = mas-req (d.store) ("/api/magic/auth/verify?id=0&nonce=5&sig-high=" & show forged & "&sig-low=0")
    in let line7 = "forged challenge verify: " & v.resp
    in act
      print-line-uni line0
      print-line-uni line1
      print-line-uni line2
      print-line-uni line3
      print-line-uni line4
      print-line-uni line5
      print-line-uni line6
      print-line-uni line7
    end
