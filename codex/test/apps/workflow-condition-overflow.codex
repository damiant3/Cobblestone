Chapter: WorkflowConditionOverflowTest
  cites Workflow chapter WorkflowEngine
  cites Workflow chapter WorkflowTypes
  cites Foreword chapter Console

 A workflow amount too large for an Integer fails both comparisons instead of
 trapping the engine.

  with-amount : Text -> List DataEntry
  with-amount (v) = [data-entry "amount" v "s1" "u" 0]

  ask : Text, ConditionOp, Text -> Text
  ask (label) (cond) (v) = label & " " & show (eval-condition cond (with-amount v))

  opening : [Console] Nothing = act
    print-line-uni (ask "500 > 100        " (GreaterThan "amount" 100) "500")
    print-line-uni (ask "500 < 100        " (LessThan "amount" 100) "500")
    print-line-uni (ask "limit > 100      " (GreaterThan "amount" 100) "9223372036854775759")
    print-line-uni (ask "limit + 1 > 100  " (GreaterThan "amount" 100) "9223372036854775760")
    print-line-uni (ask "huge > 100       " (GreaterThan "amount" 100) "99999999999999999999")
    print-line-uni (ask "huge < 100       " (LessThan "amount" 100) "99999999999999999999")
    print-line-uni (ask "not (huge > 100) " (Not (GreaterThan "amount" 100)) "99999999999999999999")
    print-line-uni ("loop huge        " & show (parse-int-loop "99999999999999999999" 0 20 0))
    print-line-uni ("loop limit       " & show (parse-int-loop "9223372036854775759" 0 19 0))
    print-line-uni "done"
  end
