Chapter: AccpExperimentTest
  cites Accp chapter AccpExperiment
  cites Foreword chapter Console

Section: Models

  decay : Real, List Real -> List Real
  decay (t) (y) = [0.0 - list-at y 0]

  root-of : Real -> MathResult
  root-of (x) = math-sqrt x

Section: Entry

  svg-line : ExperimentPlot -> Text
  svg-line (p) = when p
    is PlotSvg (s) -> "svg " & show (text-length s) & " " & substring s 0 4
    is PlotError (e) -> "plot error: " & e

  opening : [Console] Nothing = act
    print-line-uni (experiment-json (experiment-quantity (quantity-add (quantity 3.0 "ft") (quantity 1.0 "m")) "m" ["linear length conversion"]))
    print-line-uni (experiment-json (experiment-quantity (quantity 1.0 "furlong") "m" []))
    print-line-uni (experiment-json (experiment-quantity (quantity-add (quantity 1.0 "m") (quantity 1.0 "s")) "m" []))
    print-line-uni (experiment-json (experiment-scalar (math-sqrt 2.0) "1" "math-sqrt" ["exact input"]))
    let sweep = experiment-sweep root-of [0.0, 1.0, 4.0, 9.0] "1" "1" ["perfect squares"]
    in act
      print-line-uni (experiment-json sweep)
      print-line-uni (svg-line (experiment-svg sweep 0))
    end
    let bad = experiment-sweep root-of [4.0, 0.0 - 1.0] "1" "1" []
    in act
      print-line-uni (experiment-json bad)
      print-line-uni (svg-line (experiment-svg bad 0))
    end
    print-line-uni (experiment-json (experiment-ode decay 0.0 [1.0] 1.0 64 16 ["y"] ["1"] [0.000001] ["dy/dt = -y"]))
  end
