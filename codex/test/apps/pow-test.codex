Chapter: PowTest
  cites Foreword chapter ProofOfWork
  cites Foreword chapter Sha256

Section: Helpers
  verdict : Boolean -> Text
  verdict (b) = if b then "accepted" else "refused"

Section: Tests

  pow-zeros-nonce : List Integer = [0, 0, 0, 0, 0, 0, 0, 0]

  opening : [Console] Nothing =
    let challenge = [10, 20, 30, 40]
    in let nonce = pow-solve challenge 1 1000
    in let other = pow-solve [5, 10, 15] 1 10000
    in act
      print-line-uni ("difficulty 1, solved nonce: " & verdict (pow-check challenge nonce 1))
      print-line-uni ("difficulty 1, second challenge, 8-byte nonce: " & verdict (pow-check [5, 10, 15] other 1 & list-length other == 8))
      print-line-uni ("difficulty 0: " & verdict (pow-check [1, 2, 3] pow-zeros-nonce 0))
      print-line-uni ("difficulty -1: " & verdict (pow-check [1, 2, 3] pow-zeros-nonce (0 - 1)))
      print-line-uni ("difficulty 0, empty challenge and nonce: " & verdict (pow-check [] [] 0))
      print-line-uni ("difficulty 256, unsolved nonce: " & verdict (pow-check challenge nonce 256))
      print-line-uni ("difficulty 257: " & verdict (pow-check challenge nonce 257))
      print-line-uni ("difficulty 4294967295: " & verdict (pow-check challenge nonce 4294967295))
      print-line-uni ("solver at difficulty 0 finds nothing: " & verdict (list-length (pow-solve challenge 0 16) == 0))
    end

