Chapter: PowTest
  cites Foreword chapter ProofOfWork
  cites Foreword chapter Sha256

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests

  test-check-zero-difficulty : Text =
    show-bool (pow-check [1, 2, 3] [0, 0, 0, 0, 0, 0, 0, 0] 0)

  test-solve-and-check : Text =
    let challenge = [10, 20, 30, 40]
    in let nonce = pow-solve challenge 1 1000
    in show-bool (pow-check challenge nonce 1)

  test-nonce-to-bytes-roundtrip : Text =
    let challenge = [5, 10, 15]
    in let nonce = pow-solve challenge 1 10000
    in let valid = pow-check challenge nonce 1
    in show-bool (valid & (list-length nonce == 8))

  opening : [Console] Nothing = act
    print-line-uni test-check-zero-difficulty
    print-line-uni test-solve-and-check
    print-line-uni test-nonce-to-bytes-roundtrip
  end
