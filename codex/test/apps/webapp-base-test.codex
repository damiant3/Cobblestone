Chapter: WebAppBaseTest
  cites UI chapter Theme
  cites UI chapter Widget
  cites WebApp chapter WebRuntime
  cites WebApp chapter WebTheme
  cites WebApp chapter WebWidgets

 Conformance battery for the WebApp base quire. Every browser app
 shares these definitions, therefore proving them here proves them for
 all consumers. Only pure logic is checked; the runtime stubs are
 no-ops outside the browser, and the stub smoke line proves they
 compile, link, and return their documented defaults.

Section: Checks

  check-id-nums : Integer -> Text
  check-id-nums (x) =
    show (id-num "p7") & " " & show (id-num "a12") & " " & show (id-num "note123") & " " & show (id-num "tab-fav") & " " & show (id-num "d0")

  check-edges : Integer -> Text
  check-edges (x) =
    let e = eu 5
    in let xy = exy 3 4
    in show e.edge-top & " " & show e.edge-bottom & " " & show xy.edge-top & " " & show xy.edge-right & " " & show xy.edge-bottom & " " & show xy.edge-left

  check-border : Integer -> Text
  check-border (x) =
    let b = bdr 2 99 (CornerRound 6)
    in let top = b.bdr-top
    in let bot = b.bdr-bottom
    in show top.brd-width & " " & show top.brd-color & " " & show bot.brd-width

  check-style : Integer -> Text
  check-style (x) =
    let s = ws 11 22 bn ez (eu 1)
    in let f = ss-flat s
    in let n = f.ss-normal
    in let h = f.ss-hover
    in show n.ws-bg & " " & show n.ws-fg & " " & show h.ws-bg & " " & show h.ws-fg

  custom-tag : WidgetNode -> Text
  custom-tag (n) =
    when n.wn-kind
      is WkCustom (t) -> t
      is otherwise -> "?"

  check-box : Integer -> Text
  check-box (x) =
    let b = widget-box "root" "cls" [widget-label "l1" "a", widget-label "l2" "b", widget-label "l3" "c"]
    in b.wn-id & " " & custom-tag b & " " & show b.wn-child-count

  check-boxc : Integer -> Text
  check-boxc (x) =
    let b = widget-box-click "item3" "row" [widget-label "l" "x"]
    in b.wn-id & " " & custom-tag b & " " & show b.wn-child-count & " " & show (id-num (b.wn-id))

  check-stubs : Integer -> Text
  check-stubs (x) =
    show (state-set "k" 7) & " " & show (state-get "k") & " " & show (no-pick "g" 1) & " " & show (play-tone 440 100 0) & " [" & state-get-text "k" & "]"

Section: Entry

  opening : [Console] Nothing
  opening = act
    print-line-uni (check-id-nums 0)
    print-line-uni (check-edges 0)
    print-line-uni (check-border 0)
    print-line-uni (check-style 0)
    print-line-uni (check-box 0)
    print-line-uni (check-boxc 0)
    print-line-uni (check-stubs 0)
  end

