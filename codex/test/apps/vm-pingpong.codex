Chapter: VmPingpongTest
  cites Works chapter VmPingpong
  cites Foreword chapter Console
  cites Foreword chapter CCE

  result : Boolean, Boolean -> PingpongResult
  result (cdx) (txt) = PingpongResult { pp-cdx-fixed-point = cdx, pp-text-fixed-point = txt, pp-sut-size = 1, pp-stage1-hash = "", pp-stage2-hash = "" }

  opening : [Console] Nothing =
    let ascii = "Chapter: X" & "\n" & "  f = 1"
    in let wide = utf8-bytes-to-text [195, 169, 226, 130, 172]
    in let ascii-back = vm-bytes-to-text (text-to-utf8-bytes ascii)
    in let wide-back = vm-bytes-to-text (text-to-utf8-bytes wide)
    in act
      print-line-uni ("passed      : " & show (pingpong-passed (result True True)) & " " & show (pingpong-passed (result True False)) & " " & show (pingpong-passed (result False True)) & " " & show (pingpong-passed (result False False)))
      print-line-uni ("sha256 abc  : " & bytes-to-sha256 [97, 98, 99])
      print-line-uni ("identical   : " & show (lists-byte-identical [1, 2, 3] [1, 2, 3]) & " " & show (lists-byte-identical [] []))
      print-line-uni ("last differs: " & show (lists-byte-identical [1, 2, 3] [1, 2, 4]))
      print-line-uni ("prefix      : " & show (lists-byte-identical [1, 2] [1, 2, 3]) & " " & show (lists-byte-identical [1, 2, 3] [1, 2]))
      print-line-uni ("ascii back  : " & show (ascii-back == ascii) & " length " & show (text-length ascii-back) & " of " & show (text-length ascii))
      print-line-uni ("wide back   : " & show (wide-back == wide) & " length " & show (text-length wide-back) & " of " & show (text-length wide))
      print-line-uni "done"
    end

