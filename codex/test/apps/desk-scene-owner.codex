Chapter: DeskSceneOwnerTest
  cites Works chapter GopDesk
  cites Foreword chapter Console

  owner-case : Integer, Integer -> Boolean
  owner-case (old) (fresh) =
    let ds = alloc-zeroed dk-ds-bytes 64
    in let marks = alloc-zeroed 128 64
    in let windows = alloc-zeroed 64 64
    in let table = pp-new 0
    in let a = poke-32 ds desk-marks-cell marks
    in let b = poke-32 ds dk-wr-cell windows
    in let c = poke-32 ds dk-policy-cell table
    in let m0 = desk-marks-push marks old __heap-save
    in let m1 = desk-marks-push marks desk-focus-edit __heap-save
    in let w0 = dk-wr-open windows old
    in let w1 = dk-wr-open windows desk-focus-edit
    in let p0 = pp-declare table old pp-budget 100 50 pp-late 0
    in let p1 = pp-declare table desk-focus-edit pp-rate 100 0 pp-late 0
    in let heap = __heap-save
    in let replaced = desk-scene-evict ds fresh
    in let allocation = __heap-save == heap
    in let gone = dk-wr-find windows old 0 < 0 & desk-marks-find marks old (desk-marks-depth marks - 1) < 0 & pp-find table old 0 == 0
    in let kept = dk-wr-top windows == desk-focus-edit & desk-marks-find marks desk-focus-edit (desk-marks-depth marks - 1) >= 0 & pp-find table desk-focus-edit 0 == p1
    in let opened = dk-wr-open windows fresh
    in let closed = dk-wr-close windows fresh
    in allocation & gone & kept & closed == desk-focus-edit & dk-wr-count windows == 1

  opening : [Console] Nothing = act
    print-line ("fish to scene " & show (owner-case desk-focus-fish desk-focus-scene))
    print-line ("scene to fish " & show (owner-case desk-focus-scene desk-focus-fish))
  end

