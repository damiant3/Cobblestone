Chapter: CoreStateTest
  cites Sched chapter CoreState
  cites Sched chapter TaskQueue

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Body
  opening : [Console] Nothing =
    let table = core-table-new 4
    in let t1 = core-activate table 0 0 65536
    in let t2 = core-activate t1 1 65536 131072
    in let t3 = core-activate t2 2 131072 196608
    in act
      print-line-uni (core-table-stats t3)
      let t4 = core-enqueue-task t3 0 "compile" TaskNormal
      in let t5 = core-enqueue-task t4 0 "link" TaskHigh
      in let t6 = core-enqueue-task t5 0 "test" TaskLow
      in let t7 = core-enqueue-task t6 1 "sweep" TaskNormal
      in act
        print-line-uni (show (core-total-pending t7))
        print-line-uni (format-core-info (core-get t7 0))
        print-line-uni (format-core-info (core-get t7 1))
        print-line-uni (format-core-info (core-get t7 2))
        let dr = core-dequeue t7 0
        in act
          print-line-uni (show-bool (dr.has-task))
          print-line-uni (dr.task.name)
          print-line-uni (show (core-total-pending (dr.table)))
          let sr = core-schedule (dr.table) 2
          in act
            print-line-uni (show-bool (sr.has-task))
            print-line-uni (show-bool (sr.stolen))
            print-line-uni (sr.task.name)
            print-line-uni (show (core-total-pending (sr.table)))
            let sr2 = core-schedule (sr.table) 2
            in act
              print-line-uni (show-bool (sr2.has-task))
              print-line-uni (show-bool (sr2.stolen))
              let sr3 = core-schedule (sr2.table) 2
              in act
                print-line-uni (show-bool (sr3.has-task))
                print-line-uni (show ((core-get (sr3.table) 2).idle-ticks))
              end
            end
          end
        end
      end
    end

