Chapter: VgaTest
  cites Kernel chapter Vga
  cites Foreword chapter CCE

Section: Body
  opening : [Console] Nothing = act
    let clr = vga-clear (vga-attr vga-light-gray vga-black)
    in let w1 = vga-put-text 0 0 "Codex OS" (vga-attr vga-white vga-blue)
    in let w2 = vga-put-text 1 0 "VGA text mode active" (vga-attr vga-light-green vga-black)
    in let w3 = vga-put-char 2 0 62 (vga-attr vga-yellow vga-black)
    in act
      let r1 = vga-get-char 0 0
      in let r2 = vga-get-char 0 1
      in let r3 = vga-get-attr 0 0
      in act
        print-line-uni ("char[0,0]=" & show r1)
        print-line-uni ("char[0,1]=" & show r2)
        print-line-uni ("attr[0,0]=" & show r3)
        let cur = vga-cursor-new (vga-attr vga-light-gray vga-black)
        in let cur1 = vga-cursor-write-line (VgaCursor { row = 4, col = 0, attr = __narrow (vga-attr vga-cyan vga-black) }) "Hello from Codex"
        in act
          print-line-uni ("cursor-row=" & show (cur1.row) & " col=" & show (cur1.col))
          let v1 = vga-get-char 4 0
          in let v2 = vga-get-char 4 4
          in act
            print-line-uni ("vga[4,0]=" & show v1)
            print-line-uni ("vga[4,4]=" & show v2)
          end
        end
      end
    end
  end

