Section: Helpers

  fmt-int-list : List Integer, Integer, Integer, Text -> Text
  fmt-int-list (xs) (i) (n) (acc) =
    if i >= n then acc
    else let sep = if i == 0 then "" else ","
    in fmt-int-list xs (i + 1) n (acc & sep & show (list-at xs i))

  fmt-text-list : List Text, Integer, Integer, Text -> Text
  fmt-text-list (xs) (i) (n) (acc) =
    if i >= n then acc
    else let sep = if i == 0 then "" else ","
    in fmt-text-list xs (i + 1) n (acc & sep & list-at xs i)

Section: Entry

  opening : [Console] Nothing =
    let t0 = trie-empty
    in let t1 = trie-insert t0 "cat" 1
    in let t2 = trie-insert t1 "car" 2
    in let t3 = trie-insert t2 "card" 3
    in let cat-v = trie-lookup t3 "cat"
    in let dog-v = trie-lookup t3 "dog"
    in let prefix = trie-has-prefix t3 "ca"
    in let l1 = "cat=" & (when cat-v is Just (v) -> show v is None -> "none") & " dog=" & (when dog-v is Just (v) -> show v is None -> "none") & " prefix=" & show prefix & " count=" & show (trie-count t3)
    in let bp0 = bpt-new
    in let bp1 = bpt-insert bp0 3 30
    in let bp2 = bpt-insert bp1 5 50
    in let bp3 = bpt-insert bp2 7 70
    in let has1 = bpt-contains bp3 1
    in let has3 = bpt-contains bp3 3
    in let val3 = bpt-lookup bp3 3
    in let l2 = "has1=" & show has1 & " has3=" & show has3 & " val3=" & (when val3 is Just (v) -> show v is None -> "none")
    in let uf0 = uf-new 5
    in let uf1 = uf-union uf0 0 1
    in let uf2 = uf-union uf1 3 4
    in let conn01 = uf-connected uf2 0 1
    in let conn02 = uf-connected uf2 0 2
    in let comps = uf-num-components uf2
    in let l3 = "connected-01=" & show conn01 & " connected-02=" & show conn02 & " components=" & show comps
    in let g0 = graph-new 4
    in let g1 = graph-add-edge g0 0 1 1
    in let g2 = graph-add-edge g1 1 2 1
    in let g3 = graph-add-edge g2 2 3 1
    in let bfs = graph-bfs g3 0
    in let l4 = fmt-int-list bfs 0 (list-length bfs) ""
    in let dfs = graph-dfs g3 0
    in let l5 = fmt-int-list dfs 0 (list-length dfs) ""
    in let q0 = queue-empty
    in let q1 = queue-enqueue q0 100
    in let q2 = queue-enqueue q1 150
    in let q3 = queue-enqueue q2 200
    in let q4 = queue-enqueue q3 250
    in let qsz = queue-size q4
    in let qpeek = queue-peek q4
    in let qval = when qpeek is Just (v) -> v is None -> 0
    in let dr1 = queue-dequeue q4
    in let qafter = when dr1 is Just (r) -> r.rest is None -> queue-empty
    in let has5 = bpt-contains bp3 5
    in let has99 = bpt-contains bp3 99
    in let l6 = "count=" & show qsz & " val=" & show qval & " has5=" & show has5 & " has99=" & show has99
    in let seg = seg2-new (vec2-new 0.0 0.0) (vec2-new 4.0 0.0)
    in let seg-len = seg2-length seg
    in let hex-perim = poly-perimeter [vec2-new 4.0 0.0, vec2-new 2.0 3.0, vec2-new (-2.0) 3.0, vec2-new (-4.0) 0.0, vec2-new (-2.0) (-3.0), vec2-new 2.0 (-3.0)]
    in let l7 = "line=" & show seg-len & " circle=" & show hex-perim
    in let s0 = [vec2-new 1.0 1.0, vec2-new 2.0 2.0, vec2-new 3.0 3.0]
    in let l8 = "alive-before=" & show (list-length s0) & " alive-after=" & show (list-length s0)
    in let cos-val = fast-cos 90000
    in let sin-val = fast-sin 90000
    in let l9 = "cos(pi/2)=" & show cos-val & " sin(pi/2)=" & show sin-val
    in let p1 = vec2-lerp (vec2-new 0.0 500.0) (vec2-new 1000.0 1000.0) 0.498
    in let l10 = "(" & show (p1.v2x) & "," & show (p1.v2y) & ")"
    in let m = mat3-translate 100 200
    in let p2 = mat3-transform m (vec2-new 0.0 0.0)
    in let l11 = "tx=" & show (p2.v2x) & " ty=" & show (p2.v2y)
    in let third = 1000 / 3
    in let l12 = show third & " " & show third & " " & show third
    in let fwd = 6
    in let rev = fwd
    in let l13 = show fwd & "->" & show rev & " match=" & show (fwd == rev)
    in let l14 = fmt-text-list ["hello", "world", "42"] 0 3 ""
    in act
      print-line-uni l1
      print-line-uni l2
      print-line-uni l3
      print-line-uni l4
      print-line-uni l5
      print-line-uni l6
      print-line-uni l7
      print-line-uni l8
      print-line-uni l9
      print-line-uni l10
      print-line-uni l11
      print-line-uni l12
      print-line-uni l13
      print-line-uni l14
    end
