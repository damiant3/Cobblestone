Chapter: ChessDraws
  cites Games chapter Chess

 Square indices used below: g1 = 62, f3 = 45, g8 = 6, f6 = 21, e2 = 52,
 e4 = 36, e5 = 28.

 The repetition sequence is the knights going out and back: 1 Nf3 Nf6 2 Ng1
 Ng8 returns the start position, and playing it twice makes the start
 position the third occurrence. Knights are used because they touch neither
 the castling rights nor the en passant square, so the only thing that
 changes between the three occurrences is the halfmove clock, which is
 exactly what a FIDE repetition must ignore.

 We say:

Section: The Halfmove Clock

  clock-lines : [Console] Nothing
  clock-lines =
    let start = chess-new
    in let after-n = chess-play start 62 45
    in let after-nn = chess-play after-n 6 21
    in let after-pawn = chess-play start 52 36
    in let taking = chess-set-halfmove (chess-to-move (chess-place (chess-place chess-blank 45 2) 28 7) 0) 7
    in let after-take = chess-play taking 45 28
    in let after-quiet = chess-play taking 45 62
    in act
      print-line-uni ("start clock " & show (start.halfmove))
      print-line-uni ("after Nf3 " & show (after-n.halfmove))
      print-line-uni ("after Nf3 Nf6 " & show (after-nn.halfmove))
      print-line-uni ("after a pawn move " & show (after-pawn.halfmove))
      print-line-uni ("before a capture " & show (taking.halfmove))
      print-line-uni ("after the capture " & show (after-take.halfmove))
      print-line-uni ("after a quiet move from the same board " & show (after-quiet.halfmove))
    end

  fifty-lines : [Console] Nothing
  fifty-lines =
    let b = chess-new
    in let at99 = chess-set-halfmove b 99
    in let at100 = chess-set-halfmove b 100
    in let at101 = chess-set-halfmove b 101
    in act
      print-line-uni ("fifty at 99 " & (if chess-fifty at99 then "yes" else "no"))
      print-line-uni ("fifty at 100 " & (if chess-fifty at100 then "yes" else "no"))
      print-line-uni ("fifty at 101 " & (if chess-fifty at101 then "yes" else "no"))
    end

Section: Repetition

 The history holds every position including the one in hand, so the count is
 the number of OCCURRENCES rather than the number of earlier ones.

  rep-lines : [Console] Nothing
  rep-lines =
    let b0 = chess-new
    in let b1 = chess-play b0 62 45
    in let b2 = chess-play b1 6 21
    in let b3 = chess-play b2 45 62
    in let b4 = chess-play b3 21 6
    in let b5 = chess-play b4 62 45
    in let b6 = chess-play b5 6 21
    in let b7 = chess-play b6 45 62
    in let b8 = chess-play b7 21 6
    in let hist4 = list-push (list-push (list-push (list-push (list-push [] b0) b1) b2) b3) b4
    in let hist8 = list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push (list-push [] b0) b1) b2) b3) b4) b5) b6) b7) b8
    in act
      print-line-uni ("b4 is the start position " & (if chess-same-position b0 b4 then "yes" else "no"))
      print-line-uni ("b8 is the start position " & (if chess-same-position b0 b8 then "yes" else "no"))
      print-line-uni ("b1 is the start position " & (if chess-same-position b0 b1 then "yes" else "no"))
      print-line-uni ("clocks differ: b0 " & show (b0.halfmove) & " b4 " & show (b4.halfmove) & " b8 " & show (b8.halfmove))
      print-line-uni ("occurrences after four plies " & show (chess-repetitions hist4 b4))
      print-line-uni ("threefold after four plies " & (if chess-threefold hist4 b4 then "yes" else "no"))
      print-line-uni ("occurrences after eight plies " & show (chess-repetitions hist8 b8))
      print-line-uni ("threefold after eight plies " & (if chess-threefold hist8 b8 then "yes" else "no"))
      print-line-uni ("occurrences of b1 after eight plies " & show (chess-repetitions hist8 b1))
    end

Section: Entry

  opening : [Console] Nothing = act
    clock-lines
    fifty-lines
    rep-lines
  end

