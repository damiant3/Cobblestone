Chapter: JournalTest
  cites Observe chapter Journal
  cites Foreword chapter Maybe

Section: Tests
  test-empty : Text =
    let j = journal-new LogDebug
    in journal-stats j

  test-populated : Text =
    let j0 = journal-new LogDebug
    in let j1 = journal-info j0 "boot" "started" 5
    in let j2 = journal-warn j1 "net" "timeout" 10
    in let j3 = journal-error j2 "kernel" "oops" 60
    in let j4 = journal-info j3 "boot" "ready" 100
    in journal-stats j4

  test-since-50 : Text =
    let j0 = journal-new LogDebug
    in let j1 = journal-info j0 "boot" "started" 5
    in let j2 = journal-warn j1 "net" "timeout" 10
    in let j3 = journal-error j2 "kernel" "oops" 60
    in let j4 = journal-info j3 "boot" "ready" 100
    in let since = journal-entries-since j4 50
    in "count=" & show (list-length since)

  test-format-error : Text =
    let j0 = journal-new LogDebug
    in let j1 = journal-info j0 "boot" "started" 5
    in let j2 = journal-warn j1 "net" "timeout" 10
    in let j3 = journal-error j2 "kernel" "oops" 60
    in let j4 = journal-info j3 "boot" "ready" 100
    in let since = journal-entries-since j4 50
    in format-log-entry (list-at since 0)

  test-since-20 : Text =
    let j0 = journal-new LogDebug
    in let j1 = journal-info j0 "boot" "started" 5
    in let j2 = journal-warn j1 "net" "timeout" 10
    in let j3 = journal-error j2 "kernel" "oops" 60
    in let j4 = journal-info j3 "boot" "ready" 100
    in let since = journal-entries-since j4 20
    in "since-20=" & show (list-length since)

  test-last : Text =
    let j0 = journal-new LogDebug
    in let j1 = journal-info j0 "boot" "started" 5
    in let j2 = journal-warn j1 "net" "timeout" 10
    in let j3 = journal-error j2 "kernel" "oops" 60
    in let j4 = journal-info j3 "boot" "ready" 100
    in let j5 = journal-error j4 "watchdog" "service crashed" 1234
    in when journal-last j5
      is Just (e) -> format-log-entry e
      is None -> "none"

  opening : [Console] Nothing = act
    print-line-uni test-empty
    print-line-uni test-populated
    print-line-uni test-since-50
    print-line-uni test-format-error
    print-line-uni test-since-20
    print-line-uni test-last
  end
