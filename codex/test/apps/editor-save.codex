Chapter: EditorSave
  cites Works chapter ConsoleEditor
  cites Foreword chapter FileSystem

 We say:

Section: Fixture

  seeded : EditorState
  seeded = EditorState {
    file-path = "SAVE.TXT",
    lines = ["hello editor"],
    line-count = 1,
    cursor-line = 0,
    cursor-col = 0,
    scroll-top = 0,
    visible-rows = 20,
    dirty = True,
    status = "modified"
  }

  subdir : EditorState
  subdir = __record-set seeded "file-path" "SUB/NOTE.TXT"

  orphan : EditorState
  orphan = __record-set seeded "file-path" "NOPE/X.TXT"

Section: Entry

  opening : [Console, FileSystem.Read, FileSystem.Write] Nothing
  opening = act
    saved <- editor-save seeded
    print-line-uni ("status " & saved.status)
    print-line-uni ("dirty " & show (saved.dirty))

    back <- read-text "SAVE.TXT"
    print-line-uni ("readback " & back)

    sub <- editor-save subdir
    print-line-uni ("subdir-status " & sub.status)
    print-line-uni ("subdir-dirty " & show (sub.dirty))

    subback <- read-text "SUB/NOTE.TXT"
    print-line-uni ("subdir-readback " & subback)

    orph <- editor-save orphan
    print-line-uni ("orphan-status " & orph.status)
    print-line-uni ("orphan-dirty " & show (orph.dirty))
  end
