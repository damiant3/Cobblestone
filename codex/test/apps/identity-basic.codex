Chapter: IdentityBasic

Section: Body
  opening : [Console] Nothing = act
    let r0 = identity-whoami 0
    in let r1 = identity-whoami 1
    in let r2 = identity-whoami 2
    in let r3 = identity-whoami 3
    in let bad = identity-whoami 4
    in if r0 == 0 then if r1 == 0 then if r2 == 0 then if r3 == 0 then
      if bad == (0 - 1) then act
        let s0 = identity-set 0 42
        in let s1 = identity-set 1 99
        in if s0 == 0 then if s1 == 0 then
          if identity-whoami 0 == 42 then if identity-whoami 1 == 99 then act
            print-line-uni "PASS"
          end
          else print-line-uni "FAIL: word 1 not set"
        else print-line-uni "FAIL: word 0 not set"
        else print-line-uni "FAIL: set1 returned error"
        else print-line-uni "FAIL: set0 returned error"
      end
      else print-line-uni "FAIL: out-of-range not -1"
    else print-line-uni "FAIL: word 3 not zero"
    else print-line-uni "FAIL: word 2 not zero"
    else print-line-uni "FAIL: word 1 not zero"
    else print-line-uni "FAIL: word 0 not zero"
  end
