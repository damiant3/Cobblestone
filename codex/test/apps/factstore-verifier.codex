Chapter: FactstoreVerifier
  cites Foreword chapter Console
  cites Foreword chapter FactStore
  cites Foreword chapter Maybe
  cites Verify chapter CdxBinary

Section: Entry

  opening : [Console] Nothing =
    let valid-cdx = cdx-magic & cdx-zero-bytes 220
    in let cdx-ok = cdx-verify-magic valid-cdx
    in let fs0 = fact-store-empty
    in let f1 = fact-create ProofFact "termination-proof" "verifier" 100
    in let fs1 = fact-store fs0 f1
    in let f2 = fact-create ProofFact "memory-safety-proof" "verifier" 200
    in let fs2 = fact-store fs1 f2
    in let count = fact-count fs2
    in let proof-found = fact-has fs2 (f1.hash)
    in act
      print-line-uni ("CDX-VERIFIED: " & show cdx-ok)
      print-line-uni ("FACTS: " & show count)
      print-line-uni ("PROOF-FOUND: " & show proof-found)
      print-line-uni (if cdx-ok then if count == 2 then if proof-found then "PASS" else "FAIL" else "FAIL" else "FAIL")
    end

