Chapter: SparkCatalogTest
  cites Spark chapter SparkCatalog

 Parses the catalog below, written in the WPF original's catalog.json form,
 and prints every record with its project-relative path (SparkStudio.md
 section 6). The expected output is a separate reading of the same JSON, by
 PowerShell's own parser and the rule written again.

Section: Output

  sct-json : Text
  sct-json = "[\n  {\"id\": \"a1\", \"promptNumber\": 1, \"title\": \"First Light\", \"series\": \"THE FRONTIER\", \"filePath\": \"D:\\\\Projects\\\\Spark\\\\Spark\\\\Concept\\\\1344x768_s20\\\\prompt_01_first_light.png\", \"settingsTag\": \"1344x768_s20\", \"seen\": true, \"saved\": false, \"rating\": 4, \"deletedUtc\": null, \"legacyDeleted\": false},\n  {\"id\": \"b2\", \"promptNumber\": 2, \"title\": \"Caf\\u00e9 \\u2014 Night\", \"series\": \"THE FRONTIER\", \"filePath\": \"Concept/1024x1024_s25/prompt_02_caf_night.png\", \"settingsTag\": \"1024x1024_s25\", \"seen\": false, \"saved\": true, \"rating\": 0, \"deletedUtc\": \"2026-09-29T10:00:00Z\"},\n  {\"id\": \"c3\", \"promptNumber\": 3, \"title\": \"Elsewhere\", \"series\": \"\", \"filePath\": \"E:\\\\Art\\\\Other\\\\prompt_03_elsewhere.png\", \"settingsTag\": \"\", \"seen\": false, \"saved\": false},\n  {\"id\": \"d4\", \"promptNumber\": 12, \"title\": \"Old\", \"series\": \"THE DEEP DARK\", \"filePath\": \"C:\\\\Users\\\\x\\\\MyConcepts\\\\Concept\\\\512x512\\\\prompt_12_old.png\", \"settingsTag\": \"512x512\", \"seen\": true, \"saved\": true, \"rating\": 2, \"legacyDeleted\": true}\n]"

  sct-yn : Boolean -> Text
  sct-yn (b) = if b then "yes" else "no"

  sct-one : SparkImage -> Text
  sct-one (r) =
    let a = "I " & r.si-id & " | " & show (r.si-prompt) & " | " & r.si-title & " | " & r.si-series & " | " & r.si-settings
    in a & " | " & r.si-path & " | " & sct-yn (r.si-missing) & " | " & sct-yn (r.si-seen) & " | " & sct-yn (r.si-saved) & " | " & show (r.si-rating) & " | " & sct-yn (r.si-deleted)

  sct-render : List SparkImage, Integer, Text -> Text
  sct-render (rs) (i) (acc) =
    if i >= list-length rs then acc
    else sct-render rs (i + 1) (acc & "\n" & sct-one (list-at rs i))

  opening : [Console] Nothing = act
    let rs = spark-catalog-parse sct-json
    in print-line (sct-render rs 0 ("records " & show (list-length rs)))
  end
