Chapter: UriTest
  cites Encode chapter Uri

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Tests
  test-full-uri : Text =
    let u = uri-parse "http://example.com:8080/path?q=1"
    in "scheme=" & u.scheme & " host=" & u.host & " port=" & show (u.port) & " path=" & u.path & " query=" & u.query

  test-default-port : Text =
    let u = uri-parse "https://example.com/index"
    in "port=" & show (u.port)

  test-relative : Text =
    let u = uri-parse "/api/data?key=val"
    in "path=" & u.path & " query=" & u.query

  test-valid : Text =
    let u = uri-parse "http://host/"
    in "valid=" & show-bool (u.valid)

  opening : [Console] Nothing = act
    print-line-uni test-full-uri
    print-line-uni test-default-port
    print-line-uni test-relative
    print-line-uni test-valid
  end
