Chapter: RelDeriveTest
  cites Data chapter Catalog
  cites Data chapter Schema
  cites Data chapter Row
  cites Data chapter RelAlgebra
  cites Data chapter Executor
  cites Data chapter Optimizer

 Known-answer test for the RelDerive plan node. One table of five
 events, each carrying a Unix-seconds timestamp, derived into all
 four calendar buckets at once. Every expected bucket is hand
 computed from the calendar. Timestamp 0 is the epoch, the first of
 January 1970, so its buckets are 1970, 19701, 197001, and 19700101.
 Timestamp 1783555200 is the ninth of July 2026: fifty-six years of
 which fourteen are leap put the first of January 2026 at
 1767225600, June ends 181 days later at 1782864000, and eight more
 days land on the ninth, so the buckets are 2026, 20263, 202607, and
 20260709. Timestamp 1709164800 is the leap day, the twenty-ninth of
 February 2024: fifty-four years of which thirteen are leap put the
 first of January 2024 at 1704067200 and fifty-nine days reach
 February's end, so the buckets are 2024, 20241, 202402, and
 20240229. Timestamp 978307199 is the last second of the year 2000:
 thirty years of which seven are leap put the first of January 2000
 at 946684800, and 365 days plus 86399 seconds reach one second
 before midnight on the thirty-first of December, so the buckets are
 2000, 20004, 200012, and 20001231. Timestamp 1775001600 is the
 first of April 2026, ninety days past the year's start, opening the
 second quarter: 2026, 20262, 202604, and 20260401.

 The plan runs through the optimizer first and prints its explain
 rendering, so the optimizer's derive arms are exercised alongside
 the executor's, and the projection keeps the source timestamp out
 of the output so the pinned rows read as event then buckets.

Section: Table

  events-table : TableDef
  events-table = table-def-with-pk "events" [
    col-def-not-null "event-id" ColInteger,
    col-def-not-null "ts" ColInteger
  ] ["event-id"]

Section: Seed Data

  insert-all : Catalog, Text, List RowData, Integer, Integer -> Catalog
  insert-all (cat) (table) (rows) (i) (len) =
    if i >= len then cat
    else let r = catalog-insert-row cat table (list-at rows i)
    in insert-all (r.cir-cat) table rows (i + 1) len

  seed-events : Catalog -> Catalog
  seed-events (cat) =
    let s = table-schema events-table
    in let rows = [
      row-new s [ValInteger 1, ValInteger 0],
      row-new s [ValInteger 2, ValInteger 1783555200],
      row-new s [ValInteger 3, ValInteger 1709164800],
      row-new s [ValInteger 4, ValInteger 978307199],
      row-new s [ValInteger 5, ValInteger 1775001600]
    ]
    in insert-all cat "events" rows 0 (list-length rows)

  build-db : Catalog
  build-db =
    let c1 = catalog-create-table catalog-new events-table
    in seed-events (c1.cat)

Section: Plan

  all-buckets : List DeriveSpec
  all-buckets = [
    DeriveSpec { der-alias = "ts__year", der-col = "ts", der-fn = DerYear },
    DeriveSpec { der-alias = "ts__quarter", der-col = "ts", der-fn = DerQuarter },
    DeriveSpec { der-alias = "ts__month", der-col = "ts", der-fn = DerMonth },
    DeriveSpec { der-alias = "ts__day", der-col = "ts", der-fn = DerDay }
  ]

  derive-plan : RelOp
  derive-plan = RelProject (RelDerive (RelScan "events") all-buckets) (proj-columns ["event-id", "ts__year", "ts__quarter", "ts__month", "ts__day"])

Section: Display

  fmt-val : ColumnValue -> Text
  fmt-val (v) =
    when v
      is ValInteger (n) -> show n
      is ValText (t) -> t
      is ValBoolean (b) -> if b then "True" else "False"
      is ValNull -> "NULL"

  fmt-vals : List ColumnValue, Integer, Integer, Text -> Text
  fmt-vals (vals) (i) (len) (acc) =
    if i >= len then acc
    else let v = list-at vals i
    in let sep = if i > 0 then " | " else ""
    in fmt-vals vals (i + 1) len (acc & sep & fmt-val v)

  fmt-rows : List RowData, Integer, Integer, Text -> Text
  fmt-rows (rows) (i) (len) (acc) =
    if i >= len then acc
    else let row = list-at rows i
    in let line = "  " & fmt-vals (row.values) 0 (list-length (row.values)) ""
    in let sep = if i > 0 then "\n" else ""
    in fmt-rows rows (i + 1) len (acc & sep & line)

  fmt-qr : QueryResult -> Text
  fmt-qr (qr) =
    if qr.qr-ok == False then "ERROR: " & qr.qr-msg
    else fmt-rows (qr.qr-rows) 0 (qr.qr-count) ""

Section: Body

  opening : [Console] Nothing = act
    print-line-uni "=== rel-derive test ==="
    let cat = build-db
    in let plan = optimize derive-plan
    in act
      print-line-uni (explain plan 0)
      let qr = query cat plan
      in act
        print-line-uni ("rows (" & show (qr.qr-count) & "):")
        print-line-uni (fmt-qr qr)
        print-line-uni "rel-derive-test: done"
      end
    end
  end
