Chapter: IdentityKeygen
  cites Foreword chapter Sha512
  cites Foreword chapter Ed25519

 The device identity is derived from the device seed: the seed words
 become an Ed25519 public key, and its four packed words are written
 into the identity table. The crypto is pure. Reading the seed,
 writing a label, and reading it back are all Identity, so every
 helper that touches one names the effect and the public key is
 computed once and passed along.

Section: Helpers
  seed-to-list : Integer, Integer, List Integer -> List Integer
  seed-to-list (word) (byte-idx) (acc) =
    if byte-idx >= 8 then acc
    else let b = bit-and (bit-shru word (byte-idx * 8)) 255
    in seed-to-list word (byte-idx + 1) (list-push acc b)

  words-to-bytes : List Integer -> List Integer
  words-to-bytes (words) =
    let b0 = seed-to-list (list-at words 0) 0 []
    in let b1 = seed-to-list (list-at words 1) 0 b0
    in let b2 = seed-to-list (list-at words 2) 0 b1
    in seed-to-list (list-at words 3) 0 b2

  pack-word : List Integer, Integer -> Integer
  pack-word (bs) (start) =
    list-at bs start
    + list-at bs (start + 1) * 256
    + list-at bs (start + 2) * 65536
    + list-at bs (start + 3) * 16777216
    + list-at bs (start + 4) * 4294967296
    + list-at bs (start + 5) * 1099511627776
    + list-at bs (start + 6) * 281474976710656
    + list-at bs (start + 7) * 72057594037927936

  pubkey-bytes : Integer -> [Identity] List Integer
  pubkey-bytes (x) =
    ed25519-public-key (words-to-bytes [device-seed 0, device-seed 1, device-seed 2, device-seed 3])

Section: Body
  check-all : List Integer -> [Identity] Text
  check-all (pk) =
    if identity-whoami 0 /= pack-word pk 0 then "FAIL: word 0 mismatch"
    else if identity-whoami 1 /= pack-word pk 8 then "FAIL: word 1 mismatch"
    else if identity-whoami 2 /= pack-word pk 16 then "FAIL: word 2 mismatch"
    else if identity-whoami 3 /= pack-word pk 24 then "FAIL: word 3 mismatch"
    else "PASS: identity derived from device seed"

  final-step : List Integer, Integer -> [Identity] Text
  final-step (pk) (s3) =
    if s3 /= 0 then "FAIL: set3"
    else check-all pk

  step3 : List Integer, Integer -> [Identity] Text
  step3 (pk) (s2) =
    if s2 /= 0 then "FAIL: set2"
    else final-step pk (identity-set 3 (pack-word pk 24))

  step2 : List Integer, Integer -> [Identity] Text
  step2 (pk) (s1) =
    if s1 /= 0 then "FAIL: set1"
    else step3 pk (identity-set 2 (pack-word pk 16))

  step1 : List Integer, Integer -> [Identity] Text
  step1 (pk) (s0) =
    if s0 /= 0 then "FAIL: set0"
    else step2 pk (identity-set 1 (pack-word pk 8))

  run-keygen : List Integer -> [Identity] Text
  run-keygen (pk) = step1 pk (identity-set 0 (pack-word pk 0))

  opening : [Console, Identity] Nothing = act
    print-line-uni (run-keygen (pubkey-bytes 0))
  end
