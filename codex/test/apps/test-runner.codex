Chapter: TestRunnerTest
  cites Works chapter TestRunner
  cites Foreword chapter Console

  result : Text, TestOutcome, Integer -> TestResult
  result (n) (o) (ms) = TestResult { name = n, outcome = o, expected = "4", actual = "5", elapsed = ms }

  opening : [Console] Nothing =
    let pass = result "adds" TestPass 3
    in let fail = result "subtracts" TestFail 4
    in let err = result "divides" TestError 5
    in let skip = result "gpu" TestSkipped 0
    in let mixed = suite-add (suite-add (suite-add (suite-add (empty-suite "mixed") pass) fail) err) skip
    in let quiet = suite-add (suite-add (empty-suite "quiet") pass) skip
    in let empty = empty-suite "empty"
    in act
      print-line-uni ("outcomes   : " & format-outcome TestPass & " " & format-outcome TestFail & " " & format-outcome TestError & " " & format-outcome TestSkipped)
      print-line-uni ("passed     : " & show (test-passed pass) & " " & show (test-passed fail) & " " & show (test-passed err) & " " & show (test-passed skip))
      print-line-uni ("failed     : " & show (test-failed pass) & " " & show (test-failed fail) & " " & show (test-failed err) & " " & show (test-failed skip))
      print-line-uni ("pass line  : " & format-test-result pass)
      print-line-uni ("fail line  : " & format-test-result fail)
      print-line-uni ("error line : " & format-test-result err)
      print-line-uni (format-suite-summary mixed)
      print-line-uni ("mixed ok   : " & show (suite-all-pass mixed) & " results=" & show (list-length (mixed.results)))
      print-line-uni ("mixed report:")
      print-line-uni (format-failures mixed)
      print-line-uni (format-suite-summary quiet)
      print-line-uni ("quiet ok   : " & show (suite-all-pass quiet) & " report length=" & show (text-length (format-failures quiet)))
      print-line-uni (format-suite-summary empty)
      print-line-uni ("empty ok   : " & show (suite-all-pass empty))
      print-line-uni "done"
    end

