Chapter: PublishProposalTest

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Works chapter Annotation
  cites Works chapter SignedAnnotation
  cites Works chapter KeyManager
  cites Works chapter RepoProtocol

Section: Fixtures

  ppt-keypair : Keypair
  ppt-keypair = generate-keypair (text-to-bytes "publish-proposal-test-seed")

  ppt-target : AnnotationTarget
  ppt-target = make-target "RepoProtocol" "publish-proposal"

  ppt-annotation : Annotation
  ppt-annotation = create-annotation ppt-target Rationale "fester" "the outbox has to actually grow" 100

Section: Helpers

  ppt-head-author : Maybe ProposalPayload -> Text
  ppt-head-author (m) = when m
    is Just (p) -> p.annotation.annotation.author
    is otherwise -> "(none)"

  ppt-head-chapter : Maybe ProposalPayload -> Text
  ppt-head-chapter (m) = when m
    is Just (p) -> p.target-chapter
    is otherwise -> "(none)"

Section: Body

  opening : [Console] Nothing =
    let signed = sign-annotation ppt-keypair ppt-annotation
    in let r0 = repo-empty
    in let before-size = outbox-size r0
    in let before-head = ppt-head-author (peek-outbox-head r0)
    in let r1 = publish-proposal r0 signed "add the rationale" 100
    in let after-size = outbox-size r1
    in let after-author = ppt-head-author (peek-outbox-head r1)
    in let after-chapter = ppt-head-chapter (peek-outbox-head r1)
    in let r2 = drain-outbox r1
    in let drained-size = outbox-size r2
    in let drained-head = ppt-head-author (peek-outbox-head r2)
    in act
      print-line-uni ("before-size=" & show before-size)
      print-line-uni ("before-head=" & before-head)
      print-line-uni ("after-size=" & show after-size)
      print-line-uni ("after-head-author=" & after-author)
      print-line-uni ("after-head-chapter=" & after-chapter)
      print-line-uni ("drained-size=" & show drained-size)
      print-line-uni ("drained-head=" & drained-head)
    end
