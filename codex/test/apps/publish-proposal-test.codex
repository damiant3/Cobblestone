Chapter: PublishProposalTest

  cites Foreword chapter Console
  cites Works chapter RepoProtocol

Section: Body

  opening : [Console] Nothing =
    let repo = repo-empty
    in let ob = integer-to-text (outbox-size repo)
    in let seq = integer-to-text (repo.head-sequence)
    in act
      print-line-uni ("outbox=" & ob & " seq=" & seq)
      print-line-uni "ok"
    end
