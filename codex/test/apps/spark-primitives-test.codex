Chapter: SparkPrimitivesTest
  cites Math chapter Quaternion
  cites Math chapter Geometry

 Tests Spark-style mesh primitives. Inlines the TriMesh type and
 cube/plane generators to avoid citing the Spark quire (which the
 batch test harness cannot resolve).

Section: Types

  TriFace = record { tf-v0 : Integer, tf-v1 : Integer, tf-v2 : Integer }

  TriMesh = record {
    tm-verts : List Vec3,
    tm-uvs : List Vec2,
    tm-normals : List Vec3,
    tm-faces : List TriFace,
    tm-vert-count : Integer,
    tm-face-count : Integer
  }

Section: Construction

  tm-empty : TriMesh
  tm-empty = TriMesh { tm-verts = [], tm-uvs = [], tm-normals = [], tm-faces = [], tm-vert-count = 0, tm-face-count = 0 }

  tm-add-vert : TriMesh, Vec3, Vec2, Vec3 -> TriMesh
  tm-add-vert (m) (pos) (uv) (normal) =
    let nv = list-push (m.tm-verts) pos in let nu = list-push (m.tm-uvs) uv in let nn = list-push (m.tm-normals) normal
    in TriMesh { tm-verts = nv, tm-uvs = nu, tm-normals = nn, tm-faces = m.tm-faces, tm-vert-count = m.tm-vert-count + 1, tm-face-count = m.tm-face-count }

  tm-add-face : TriMesh, Integer, Integer, Integer -> TriMesh
  tm-add-face (m) (v0) (v1) (v2) =
    let nf = list-push (m.tm-faces) (TriFace { tf-v0 = v0, tf-v1 = v1, tf-v2 = v2 })
    in TriMesh { tm-verts = m.tm-verts, tm-uvs = m.tm-uvs, tm-normals = m.tm-normals, tm-faces = nf, tm-vert-count = m.tm-vert-count, tm-face-count = m.tm-face-count + 1 }

Section: Cube

  test-cube : Integer -> TriMesh
  test-cube (size) =
    let hr = real-from-int (size / 2)
    in let uv0 = vec2-new 0.0 0.0
    in let nf = vec3-new 0.0 0.0 1000.0 in let nb = vec3-new 0.0 0.0 (-1000.0)
    in let nu = vec3-new 0.0 1000.0 0.0 in let nd = vec3-new 0.0 (-1000.0) 0.0
    in let nr = vec3-new 1000.0 0.0 0.0 in let nl = vec3-new (-1000.0) 0.0 0.0
    in let m = tm-empty
    in let m1 = tm-add-vert m (vec3-new (-hr) (-hr) hr) uv0 nf
    in let m2 = tm-add-vert m1 (vec3-new hr (-hr) hr) uv0 nf
    in let m3 = tm-add-vert m2 (vec3-new hr hr hr) uv0 nf
    in let m4 = tm-add-vert m3 (vec3-new (-hr) hr hr) uv0 nf
    in let f1 = tm-add-face m4 0 1 2
    in let f2 = tm-add-face f1 0 2 3
    in let m5 = tm-add-vert f2 (vec3-new hr (-hr) (-hr)) uv0 nb
    in let m6 = tm-add-vert m5 (vec3-new (-hr) (-hr) (-hr)) uv0 nb
    in let m7 = tm-add-vert m6 (vec3-new (-hr) hr (-hr)) uv0 nb
    in let m8 = tm-add-vert m7 (vec3-new hr hr (-hr)) uv0 nb
    in let f3 = tm-add-face m8 4 5 6
    in tm-add-face f3 4 6 7

Section: Plane

  test-plane : Integer -> TriMesh
  test-plane (size) =
    let hr = real-from-int (size / 2) in let up = vec3-new 0.0 1000.0 0.0 in let uv0 = vec2-new 0.0 0.0
    in let m = tm-empty
    in let m1 = tm-add-vert m (vec3-new (-hr) 0.0 (-hr)) uv0 up
    in let m2 = tm-add-vert m1 (vec3-new hr 0.0 (-hr)) uv0 up
    in let m3 = tm-add-vert m2 (vec3-new hr 0.0 hr) uv0 up
    in let m4 = tm-add-vert m3 (vec3-new (-hr) 0.0 hr) uv0 up
    in let f1 = tm-add-face m4 0 1 2
    in tm-add-face f1 0 2 3

Section: Body

  opening : [Console] Nothing = act
    let cube = test-cube 1000
    in print-line-uni ("cube verts: " & show (cube.tm-vert-count))
    print-line-uni ("cube faces: " & show (cube.tm-face-count))

    let plane = test-plane 1000
    in print-line-uni ("plane verts: " & show (plane.tm-vert-count))
    print-line-uni ("plane faces: " & show (plane.tm-face-count))

    print-line-uni "primitives ok"
  end
