Chapter: SupervisorKillRestart

Section: Body
  spin-until : Integer -> Integer
  spin-until (deadline) =
    if get-ticks >= deadline then 0
    else spin-until deadline

  stuck-worker : Integer, Integer -> [Concurrent] Integer
  stuck-worker (ch) (value) =
    let s = spin-until (get-ticks + 10000)
    in chan-kern-send ch value

  good-worker : Integer, Integer -> [Concurrent] Integer
  good-worker (ch) (value) = act
    s <- chan-kern-send ch value
    let r = 0
    in r
  end

  opening : [Concurrent, Capability] Integer = act
    ch <- chan-kern-create 8
    w1 <- process-spawn (\x -> stuck-worker ch 10)
    k <- process-kill w1
    let w1b = process-wait w1
    in act
      w2 <- process-spawn (\x -> good-worker ch 42)
      let w2b = process-wait w2
      in act
        v <- chan-kern-recv ch
        cl <- chan-kern-close ch
        let r = k * 100 + v
        in r
      end
    end
  end
