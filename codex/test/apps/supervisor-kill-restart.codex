Chapter: SupervisorKillRestart

Section: Body
  stuck-worker : Integer, Integer -> Integer
  stuck-worker (ch) (value) =
    let s = spin-until (get-ticks + 10000)
    in chan-kern-send ch value

  good-worker : Integer, Integer -> Integer
  good-worker (ch) (value) =
    let s = chan-kern-send ch value
    in 0

  spin-until : Integer -> Integer
  spin-until (deadline) =
    if get-ticks >= deadline then 0
    else spin-until deadline

  opening : Integer =
    let ch = chan-kern-create 8
    in let w1 = process-spawn (\x -> stuck-worker ch 10)
    in let k = process-kill w1
    in let w1b = process-wait w1
    in let w2 = process-spawn (\x -> good-worker ch 42)
    in let w2b = process-wait w2
    in let v = chan-kern-recv ch
    in let cl = chan-kern-close ch
    in k * 100 + v
