Chapter: KeyContract
  cites Secrets chapter SecretsApp
  cites UI chapter Event
  cites UI chapter KeyInput
  cites Foreword chapter CCE

Section: Typing

 An EvKeyDown key is what poll-key answers: a character is its CCE code
 point, and Enter, Backspace and the rest are named keys at key-named-base.

  press : SecretsAppState, Integer -> SecretsAppState
  press (s) (k) = secrets-handle-lock-key s (event-key-down k 0 0)

  units : Text, Integer, Text -> Text
  units (t) (i) (acc) =
    if i >= text-length t then acc
    else units t (i + 1) (acc & " " & show (char-code (char-at t i)))

Section: Entry

  opening : [Console] Nothing = act
    let s0 = secrets-app-init 800 600
    in let s1 = press s0 (char-code 'a')
    in let s2 = press s1 (char-code 'B')
    in let s3 = press s2 (char-code '1')
    in let s4 = press s3 key-backspace
    in let s5 = press s4 (char-code 'z')
    in let s6 = press s5 key-f1
    in let s7 = press s6 (char-code ' ')
    in act
      print-line-uni ("typed a B 1 backspace z f1 space: \"" & s7.sa-password-input & "\" cursor " & show (s7.sa-password-cursor))
      print-line-uni ("equals \"aBz \": " & (if s7.sa-password-input == "aBz " then "yes" else "no"))
      print-line-uni ("units" & units (s7.sa-password-input) 0 "")
      print-line-uni ("key-is-char: a " & show (key-is-char (char-code 'a')) & ", enter " & show (key-is-char key-enter) & ", zero " & show (key-is-char 0))
      print-line-uni ("uefi UnicodeChar 97 decodes to CCE a: " & (if efi-key-decode 97 == char-code 'a' then "yes" else "no, " & show (efi-key-decode 97)))
      print-line-uni ("uefi UnicodeChar 13 decodes to key-enter: " & (if efi-key-decode 13 == key-enter then "yes" else "no"))
    end
  end

