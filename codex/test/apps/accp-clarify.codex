Chapter: AccpClarifyTest
  cites Accp chapter AccpClarify
  cites Foreword chapter Console

Section: Entry

  answer-line : Text, Text, Text -> Text
  answer-line (label) (text) (reg) =
    let a = ac-clarify text reg
    in label & " ok=" & (if a.ok then "yes" else "no") & " " & a.body

  nul-text : Text
  nul-text = "A" & char-to-text (code-to-char 0) & "B is here."

  opening : [Console] Nothing = act
    print-line-uni (answer-line "child" "I want the thing but not the other thing and it's not fair because he always gets more." "")
    print-line-uni (answer-line "reorder" "Most people want more, and they always ask." "casual")
    print-line-uni (answer-line "formal" "A meeting is at noon.\nHe said yes." "formal")
    print-line-uni (answer-line "resolved" "Add two to three." "")
    print-line-uni (answer-line "nul" nul-text "technical")
    print-line-uni (answer-line "badreg" "It is late." "shouting")
    print-line-uni (answer-line "empty" "" "")
    print-line-uni (answer-line "probe" "make the thing faster like we talked about, and fix it before the release, most of them are slow anyway" "casual")
    print-line-uni (answer-line "modality" "Users should log in, so the audit may run." "formal")
    print-line-uni (answer-line "second mention" "The report is due. The report has a chart." "technical")
    print-line-uni (answer-line "technical" "Call parse_json(x) on the API endpoint at /v1/items with limit=50." "")
    print-line-uni (answer-line "bound" "A server crashed. It restarted." "formal")
    print-line-uni (answer-line "bound plural" "Our servers crashed. They restarted and their logs grew." "formal")
    print-line-uni (answer-line "two candidates" "A server called a client. It crashed." "formal")
    print-line-uni (answer-line "number" "A server crashed. They restarted." "formal")
    print-line-uni (answer-line "adjective" "A big server crashed. It restarted." "formal")
    print-line-uni (answer-line "two back" "A server crashed. Nothing happened. It restarted." "formal")
    print-line-uni (answer-line "name" "Alice joined. She left." "formal")
    print-line-uni (answer-line "two names" "Alice called Bob. She left." "formal")
    print-line-uni (answer-line "starter" "Today the build passed. He left." "formal")
    print-line-uni (answer-line "name two back" "Alice arrived. Nothing happened. She left." "formal")
    print-line-uni (answer-line "unique" "The sun rose." "formal")
  end
