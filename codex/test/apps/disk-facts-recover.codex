Chapter: DiskFactsRecover
  cites Kernel chapter DiskFacts
  cites Foreword chapter FactStore
  cites Foreword chapter Hamt
  cites Foreword chapter Maybe
  cites Foreword chapter Sha256
  cites Foreword chapter Console

Section: Damage

  wreck-superblock : Integer -> [Device.Block] Integer
  wreck-superblock (sector) = act
    buf <- block-read-sector sector
    let old = peek-byte buf 0
    in let w = poke-byte buf 0 (if old == 88 then 89 else 88)
    in block-write-sector sector buf
  end

Section: Reporting

  found : Maybe Fact, Text -> Text
  found (m) (want) =
   when m
    is Just (f) -> if f.content == want then "ok" else "CORRUPTED"
    is None -> "lost"

  survey : DiskFactStore -> Text
  survey (store) =
   let a = found (disk-read-fact store (fact-content-hash "alpha")) "alpha"
   in let b = found (disk-read-fact store (fact-content-hash "bravo")) "bravo"
   in let c = found (disk-read-fact store (fact-content-hash "charlie")) "charlie"
   in let d = found (disk-read-fact store (fact-content-hash "delta")) "delta"
   in a & " " & b & " " & c & " " & d

Section: Entry

  opening : [Device.Block, Console.Write] Nothing = act
    let s0 = disk-init
    in let s1 = disk-write-fact s0 DefinitionFact "alpha" 1
    in let s2 = disk-write-fact s1 DefinitionFact "bravo" 2
    in let cp1 = disk-checkpoint s2
    in let s3 = disk-write-fact cp1 DefinitionFact "charlie" 3
    in let s4 = disk-write-fact s3 DefinitionFact "delta" 4
    in let cp2 = disk-checkpoint s4
    in act
      print-line-uni ("written=" & show (disk-fact-count cp2))
      let fresh = disk-load
      in act
        print-line-uni ("boot-count=" & show (disk-fact-count fresh))
        print-line-uni ("boot-facts=" & survey fresh)
      end
      torn <- wreck-superblock 1
      let fallback = disk-load
      in act
        print-line-uni ("fallback-count=" & show (disk-fact-count fallback))
        print-line-uni ("fallback-facts=" & survey fallback)
      end
      gone <- wreck-superblock 0
      let bare = disk-load
      in act
        print-line-uni ("bare-count=" & show (disk-fact-count bare))
        print-line-uni ("bare-facts=" & survey bare)
      end
    end
  end
