Chapter: SyntaxHighlightTest
  cites Works chapter SyntaxHighlight
  cites Foreword chapter CCE

 We say:

Section: Reporting

  probe : Text -> [Console] Nothing
  probe (s) = act
    print-line-uni ("[" & s & "]")
    print-line-uni ("[" & syn-tags s & "]")
  end

Section: Body

  opening : [Console] Nothing = act

    probe "Chapter: SyntaxHighlight"

    probe " cites is an ordinary word here"

    probe "  cites Foreword chapter CCE"

    probe "  let x = 42"

    probe "  syn-word-end (s) (i) (len) ="

    probe "  if a-2 > b then #FF else 0"

    probe "  n : Integer between 0 and 255"

    probe "  msg = \"hello\" & show n"

    probe "  x -> y"

  end
