Chapter: AnnotationReaderTest

  cites Foreword chapter Console
  cites Works chapter Annotation

Section: Body

  opening : [Console] Nothing =
    let t1 = make-target "Parser" "parse-expr"
    in let t2 = make-target "Emitter" "emit-code"
    in let a1 = create-annotation t1 Warning "bob" "hot path" 2000
    in let a2 = create-annotation t2 Invariant "carol" "never shrinks" 3000
    in let store = annotation-store-add (annotation-store-add annotation-store-empty a1) a2
    in let c = integer-to-text (annotation-count store)
    in let k1 = annotation-kind-name (a1.kind)
    in let k2 = annotation-kind-name (a2.kind)
    in act
      print-line-uni ("count=" & c)
      print-line-uni ("a1=" & k1)
      print-line-uni ("a2=" & k2)
    end
