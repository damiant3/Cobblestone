Chapter: UiListAlias
  cites UI chapter Binding
  cites UI chapter Overlay
  cites UI chapter Widget
  cites Foreword chapter Console

 Two values built from one base must not share its list (UI-1). list-push
 extends in place when the backing block has room, so a holder that pushes
 onto the caller's list hands both results one backing list. Native only:
 the HTML plug's list_push copies and hides it.

 We say:

Section: Reading

  obs-ids : List Observable, Integer, Integer, Text -> Text
  obs-ids (xs) (i) (n) (acc) =
    if i >= n then acc
    else obs-ids xs (i + 1) n (acc & (list-at xs i).obs-id)

  ot-ids : List ObsText, Integer, Integer, Text -> Text
  ot-ids (xs) (i) (n) (acc) =
    if i >= n then acc
    else ot-ids xs (i + 1) n (acc & (list-at xs i).ot-id)

  bd-ids : List Binding, Integer, Integer, Text -> Text
  bd-ids (xs) (i) (n) (acc) =
    if i >= n then acc
    else bd-ids xs (i + 1) n (acc & (list-at xs i).bd-source)

  ov-ids : List Overlay, Integer, Integer, Text -> Text
  ov-ids (xs) (i) (n) (acc) =
    if i >= n then acc
    else ov-ids xs (i + 1) n (acc & (list-at xs i).ov-id)

  show-obs : BindingTable -> Text
  show-obs (t) = show (list-length (t.bt-observables)) & ":" & obs-ids (t.bt-observables) 0 (list-length (t.bt-observables)) ""

  show-ot : BindingTable -> Text
  show-ot (t) = show (list-length (t.bt-text-obs)) & ":" & ot-ids (t.bt-text-obs) 0 (list-length (t.bt-text-obs)) ""

  show-bd : BindingTable -> Text
  show-bd (t) = show (list-length (t.bt-bindings)) & ":" & bd-ids (t.bt-bindings) 0 (list-length (t.bt-bindings)) ""

  show-ov : OverlayStack -> Text
  show-ov (s) = show (list-length (s.os-overlays)) & ":" & ov-ids (s.os-overlays) 0 (list-length (s.os-overlays)) ""

Section: Entry

  opening : [Console] Nothing = act
    let base = bt-add-obs (bt-add-obs binding-table-new (observable "a" 1)) (observable "b" 2)
    in let o1 = bt-add-obs base (observable "c" 3)
    in let o2 = bt-add-obs base (observable "d" 4)
    in let tbase = bt-add-text-obs (bt-add-text-obs binding-table-new (obs-text "a" "x")) (obs-text "b" "y")
    in let t1 = bt-add-text-obs tbase (obs-text "c" "z")
    in let t2 = bt-add-text-obs tbase (obs-text "d" "w")
    in let bbase = bt-add-binding (bt-add-binding binding-table-new (Binding { bd-source = "a", bd-target = BindLabel "l", bd-transform = 0 })) (Binding { bd-source = "b", bd-target = BindLabel "l", bd-transform = 0 })
    in let b1 = bt-add-binding bbase (Binding { bd-source = "c", bd-target = BindLabel "l", bd-transform = 0 })
    in let b2 = bt-add-binding bbase (Binding { bd-source = "d", bd-target = BindLabel "l", bd-transform = 0 })
    in let w = widget-label "w" "t"
    in let sbase = overlay-push (overlay-push overlay-stack-new (overlay-popup "a" 0 0 1 1 w)) (overlay-popup "b" 0 0 1 1 w)
    in let s1 = overlay-push sbase (overlay-popup "c" 0 0 1 1 w)
    in let s2 = overlay-push sbase (overlay-popup "d" 0 0 1 1 w)
    in act
      print-line-uni ("obs " & show-obs base & " " & show-obs o1 & " " & show-obs o2)
      print-line-uni ("text " & show-ot tbase & " " & show-ot t1 & " " & show-ot t2)
      print-line-uni ("bind " & show-bd bbase & " " & show-bd b1 & " " & show-bd b2)
      print-line-uni ("overlay " & show-ov sbase & " " & show-ov s1 & " " & show-ov s2)
    end
  end
