Chapter: HttpResponseGuard
  cites Net chapter HttpClient
  cites Foreword chapter CCE

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

  crlf : List Integer = [13, 10]

  report : Text, List Integer -> Text
  report (name) (bs) =
    let r = http-parse-response bs
    in name & " code=" & show (r.status-code) & " valid=" & show-bool (r.valid) & " body-len=" & show (text-length (r.body))

  report-cl : Text, List Integer -> Text
  report-cl (name) (bs) =
    let he = find-body-start bs 0 (list-length bs)
    in name & " he=" & show he & " cl=" & show (http-content-length bs he)

Section: Arms
  good : List Integer = http-to-ascii "HTTP/1.0 200 OK" & crlf & crlf & http-to-ascii "hello"
  not-found : List Integer = http-to-ascii "HTTP/1.0 404 Not Found" & crlf & crlf
  runt : List Integer = http-to-ascii "HT"
  status-only : List Integer = http-to-ascii "HTTP/1.0 200 OK"
  no-blank : List Integer = http-to-ascii "HTTP/1.0 200 OK" & crlf & http-to-ascii "X-A: b" & crlf
  cr-only : List Integer = http-to-ascii "HTTP/1.0 200 OK" & [13, 13, 13]
  big-status : List Integer = http-to-ascii "HTTP/1.0 99999999999999999999 OK" & crlf & crlf
  neg-status : List Integer = http-to-ascii "HTTP/1.0 -200 OK" & crlf & crlf
  high-body : List Integer = http-to-ascii "HTTP/1.0 200 OK" & crlf & crlf & [255, 0, 128, 13, 10, 200]
  one-cr : List Integer = [13]
  good-cl : List Integer = http-to-ascii "HTTP/1.0 200 OK" & crlf & http-to-ascii "Content-Length: 5" & crlf & crlf & http-to-ascii "hello"
  big-cl : List Integer = http-to-ascii "HTTP/1.0 200 OK" & crlf & http-to-ascii "content-length: 99999999999999999999" & crlf & crlf
  neg-cl : List Integer = http-to-ascii "HTTP/1.0 200 OK" & crlf & http-to-ascii "Content-Length: -5" & crlf & crlf
  no-cl : List Integer = http-to-ascii "HTTP/1.0 200 OK" & crlf & http-to-ascii "X-A: b" & crlf & crlf

  opening : [Console] Nothing = act
    print-line-uni (report "good" good)
    print-line-uni (report "not-found" not-found)
    print-line-uni (report "empty" [])
    print-line-uni (report "runt" runt)
    print-line-uni (report "status-only" status-only)
    print-line-uni (report "no-blank" no-blank)
    print-line-uni (report "cr-only" cr-only)
    print-line-uni (report "big-status" big-status)
    print-line-uni (report "neg-status" neg-status)
    print-line-uni (report "high-body" high-body)
    print-line-uni (report "one-cr" one-cr)
    print-line-uni (report-cl "good-cl" good-cl)
    print-line-uni (report-cl "big-cl" big-cl)
    print-line-uni (report-cl "neg-cl" neg-cl)
    print-line-uni (report-cl "no-cl" no-cl)
    print-line-uni "survived"
  end
