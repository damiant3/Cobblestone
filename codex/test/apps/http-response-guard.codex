Chapter: HttpResponseGuard
  cites Net chapter HttpClient
  cites Foreword chapter CCE

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

  crlf : List Integer = [13, 10]

  report : Text, List Integer -> Text
  report (name) (bs) =
    let r = http-parse-response bs
    in name & " code=" & show (r.status-code) & " valid=" & show-bool (r.valid) & " body-len=" & show (text-length (r.body))

  report-cl : Text, List Integer -> Text
  report-cl (name) (bs) =
    let he = find-body-start bs 0 (list-length bs)
    in name & " he=" & show he & " cl=" & show (http-content-length bs he)

Section: Arms
  good : List Integer = http-to-ascii "HTTP/1.0 200 OK" & crlf & crlf & http-to-ascii "hello"
  not-found : List Integer = http-to-ascii "HTTP/1.0 404 Not Found" & crlf & crlf
  runt : List Integer = http-to-ascii "HT"
  status-only : List Integer = http-to-ascii "HTTP/1.0 200 OK"
  no-blank : List Integer = http-to-ascii "HTTP/1.0 200 OK" & crlf & http-to-ascii "X-A: b" & crlf
  cr-only : List Integer = http-to-ascii "HTTP/1.0 200 OK" & [13, 13, 13]
  big-status : List Integer = http-to-ascii "HTTP/1.0 99999999999999999999 OK" & crlf & crlf
  neg-status : List Integer = http-to-ascii "HTTP/1.0 -200 OK" & crlf & crlf
  high-body : List Integer = http-to-ascii "HTTP/1.0 200 OK" & crlf & crlf & [255, 0, 128, 13, 10, 200]
  one-cr : List Integer = [13]
  good-cl : List Integer = http-to-ascii "HTTP/1.0 200 OK" & crlf & http-to-ascii "Content-Length: 5" & crlf & crlf & http-to-ascii "hello"
  big-cl : List Integer = http-to-ascii "HTTP/1.0 200 OK" & crlf & http-to-ascii "content-length: 99999999999999999999" & crlf & crlf
  neg-cl : List Integer = http-to-ascii "HTTP/1.0 200 OK" & crlf & http-to-ascii "Content-Length: -5" & crlf & crlf
  no-cl : List Integer = http-to-ascii "HTTP/1.0 200 OK" & crlf & http-to-ascii "X-A: b" & crlf & crlf
  head : List Integer = http-to-ascii "HTTP/1.0 200 OK" & crlf
  ows-cl : List Integer = head & http-to-ascii "Content-Length:" & [32, 9] & http-to-ascii "5" & [32] & crlf & crlf
  junk-before : List Integer = head & http-to-ascii "Content-Length: abc12" & crlf & crlf
  junk-after : List Integer = head & http-to-ascii "Content-Length: 12abc" & crlf & crlf
  empty-then-other : List Integer = head & http-to-ascii "Content-Length:" & crlf & http-to-ascii "X-A: 5" & crlf & crlf
  dup-same : List Integer = head & http-to-ascii "Content-Length: 5" & crlf & http-to-ascii "Content-Length: 5" & crlf & crlf
  dup-differ : List Integer = head & http-to-ascii "Content-Length: 5" & crlf & http-to-ascii "Content-Length: 7" & crlf & crlf
  prefixed-name : List Integer = head & http-to-ascii "X-Content-Length: 9" & crlf & crlf
  body-short : List Integer = head & http-to-ascii "Content-Length: 10" & crlf & crlf & http-to-ascii "hello"
  body-extra : List Integer = head & http-to-ascii "Content-Length: 5" & crlf & crlf & http-to-ascii "helloEXTRA"
  body-dup-differ : List Integer = head & http-to-ascii "Content-Length: 5" & crlf & http-to-ascii "Content-Length: 7" & crlf & crlf & http-to-ascii "hello"
  body-bad-cl : List Integer = head & http-to-ascii "Content-Length: 5x" & crlf & crlf & http-to-ascii "hello"
  not-modified : List Integer = http-to-ascii "HTTP/1.1 304 Not Modified" & crlf & http-to-ascii "Content-Length: 500" & crlf & crlf
  no-content-body : List Integer = http-to-ascii "HTTP/1.1 204 No Content" & crlf & crlf & http-to-ascii "junk"
  chunks : List Integer = http-to-ascii "5" & crlf & http-to-ascii "hello" & crlf & http-to-ascii "0" & crlf & crlf
  te-chunked : List Integer = http-to-ascii "HTTP/1.1 200 OK" & crlf & http-to-ascii "Transfer-Encoding: chunked" & crlf & crlf & chunks
  te-with-cl : List Integer = http-to-ascii "HTTP/1.1 200 OK" & crlf & http-to-ascii "Content-Length: 5" & crlf & http-to-ascii "transfer-encoding: chunked" & crlf & crlf & chunks
  bad-version : List Integer = http-to-ascii "XTTP/1.0 200 OK" & crlf & http-to-ascii "Content-Length: 5" & crlf & crlf & http-to-ascii "hello"
  version-2 : List Integer = http-to-ascii "HTTP/2.0 200 OK" & crlf & http-to-ascii "Content-Length: 5" & crlf & crlf & http-to-ascii "hello"
  te-prefixed : List Integer = head & http-to-ascii "X-Transfer-Encoding: chunked" & crlf & crlf & http-to-ascii "hello"

  opening : [Console] Nothing = act
    print-line-uni (report "good" good)
    print-line-uni (report "not-found" not-found)
    print-line-uni (report "empty" [])
    print-line-uni (report "runt" runt)
    print-line-uni (report "status-only" status-only)
    print-line-uni (report "no-blank" no-blank)
    print-line-uni (report "cr-only" cr-only)
    print-line-uni (report "big-status" big-status)
    print-line-uni (report "neg-status" neg-status)
    print-line-uni (report "high-body" high-body)
    print-line-uni (report "one-cr" one-cr)
    print-line-uni (report-cl "good-cl" good-cl)
    print-line-uni (report-cl "big-cl" big-cl)
    print-line-uni (report-cl "neg-cl" neg-cl)
    print-line-uni (report-cl "no-cl" no-cl)
    print-line-uni (report-cl "ows-cl" ows-cl)
    print-line-uni (report-cl "junk-before" junk-before)
    print-line-uni (report-cl "junk-after" junk-after)
    print-line-uni (report-cl "empty-then-other" empty-then-other)
    print-line-uni (report-cl "dup-same" dup-same)
    print-line-uni (report-cl "dup-differ" dup-differ)
    print-line-uni (report-cl "prefixed-name" prefixed-name)
    print-line-uni (report "good-cl" good-cl)
    print-line-uni (report "body-short" body-short)
    print-line-uni (report "body-extra" body-extra)
    print-line-uni (report "body-dup-differ" body-dup-differ)
    print-line-uni (report "body-bad-cl" body-bad-cl)
    print-line-uni (report "not-modified" not-modified)
    print-line-uni (report "no-content-body" no-content-body)
    print-line-uni (report "te-chunked" te-chunked)
    print-line-uni (report "te-with-cl" te-with-cl)
    print-line-uni (report "te-prefixed" te-prefixed)
    print-line-uni (report "bad-version" bad-version)
    print-line-uni (report "version-2" version-2)
    print-line-uni "survived"
  end
