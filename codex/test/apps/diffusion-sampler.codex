 DPM adaptive draws once per accepted step, so the draws counted at
 draw-count, outside every window the sampler reads back into, are its
 accepted steps.

  draw-count : Integer = #BD760000

  counted-draw : Text, Integer, Integer, Integer, Integer -> Integer
  counted-draw (file) (count) (nb) (shift) (k) =
    let c = poke-32 draw-count 0 (k + 1)
    in draw-from file count nb shift k

  arm-dpm-adaptive : Integer, Text -> Text
  arm-dpm-adaptive (shift) (label) =
    let mu = mu-buf 0
    in let nb = gpu-buf-alloc (n * 4)
    in let x = fresh-x0 0
    in let c0 = poke-32 draw-count 0 0
    in let bad = sample-dpm-adaptive (\xh s -> post-mean mu xh s) (\k -> counted-draw "sampler-noise-dpm-adaptive.bin" 11 nb shift k) x (sm-discrete-sigma 0) (sm-discrete-sigma 999) n
    in let r = label & " (" & show bad & " refused, " & show (peek-32 draw-count 0) & " draws, Forge 11 accepted of 15): " & check-latent x "sampler-dpm-adaptive.bin"
    in let f = gpu-buf-free mu & gpu-buf-free nb & gpu-buf-free x
    in r

 The guided denoiser at CFG 3 over two posterior means, the unconditional one
 about sampler-mu-uncond.bin, copying Du into ub.

  cfg-mean : Integer, Integer, Integer, Real, Integer -> Integer
  cfg-mean (mu) (mu-u) (x) (s) (ub) =
    let dc = post-mean mu x s
    in let du = post-mean mu-u x s
    in let rc = if du == 0 then 0 - 1 else sm-lincomb du du du ub 1.0 0.0 0.0 n
    in let out = gpu-buf-alloc (n * 4)
    in let r = if dc == 0 | rc < 0 | out == 0 then 0 - 1 else sm-lincomb du dc dc out (0.0 - 2.0) 3.0 0.0 n
    in let f = (if dc == 0 then True else gpu-buf-free dc) & (if du == 0 then True else gpu-buf-free du)
    in if r < 0 then 0 else out

  arm-ddim-cfgpp : Boolean, Text -> Text
  arm-ddim-cfgpp (plain) (label) =
    let mu = mu-buf 0
    in let mu-u = gpu-buf-alloc (n * 4)
    in let uu = gpu-buf-upload mu-u 0 "sampler-mu-uncond.bin" 0 n gpu-dt-f32 gpu-dt-f32
    in let ub = gpu-buf-alloc (n * 4)
    in let x = gpu-buf-alloc (n * 4)
    in let u = gpu-buf-upload x 0 "sampler-xt.bin" 0 n gpu-dt-f32 gpu-dt-f32
    in let bad = if plain then sample-ddim (\xh s -> cfg-mean mu mu-u xh s ub) x 6 n else sample-ddim-cfgpp (\xh s b -> cfg-mean mu mu-u xh s b) x 6 n
    in let r = label & " (" & show bad & " refused): " & check-latent x "sampler-ddim-cfgpp.bin"
    in let f = gpu-buf-free mu & gpu-buf-free mu-u & gpu-buf-free ub & gpu-buf-free x
    in r

  print-all : List Text, Integer -> [Console] Nothing
  print-all (ls) (i) =
    if i >= list-length ls then act
      print-uni ""
    end
    else act
      print-line-uni (list-at ls i)
      print-all ls (i + 1)
    end

  opening : [Console] Integer
  opening = act
    print-line-uni (arm-bounds 0)
    print-line-uni (arm-karras 0)
    print-all (arm-schedules 0) 0
    print-line-uni (arm-euler 0)
   print-line-uni (arm-heun "sampler-heun.bin" "heun vs Forge")
   print-line-uni (arm-heun "sampler-euler.bin" "control, heun graded against euler")
   print-line-uni (arm-dpm2 "sampler-dpm2.bin" "dpm2 vs Forge")
   print-line-uni (arm-dpm2 "sampler-heun.bin" "control, dpm2 graded against heun")
    print-line-uni (arm-dpmpp 0 "dpm++ sde vs Forge")
    print-line-uni (arm-dpmpp 1 "sabotage, draws shifted by one")
    print-line-uni (arm-euler-a 0 "euler a vs Forge")
    print-line-uni (arm-euler-a 1 "sabotage, euler a draws shifted by one")
   print-line-uni (arm-dpm2a 0 "dpm2 a vs Forge")
   print-line-uni (arm-dpm2a 1 "sabotage, dpm2 a draws shifted by one")
   print-line-uni (arm-dpmpp-2sa 0 "dpm++ 2s a vs Forge")
   print-line-uni (arm-dpmpp-2sa 1 "sabotage, dpm++ 2s a draws shifted by one")
   print-line-uni (arm-dpmpp-2msh 0 "dpm++ 2m sde heun vs Forge")
   print-line-uni (arm-dpmpp-2msh 1 "sabotage, dpm++ 2m sde heun draws shifted by one")
   print-line-uni (arm-dpmpp-3m 0 "dpm++ 3m sde vs Forge")
   print-line-uni (arm-dpmpp-3m 1 "sabotage, dpm++ 3m sde draws shifted by one")
    print-line-uni (arm-dpmpp-2m 0)
    print-line-uni (arm-dpmpp-2m-sde 0)
    print-line-uni (arm-ddim 0)
    print-line-uni (arm-unipc 0)
    print-line-uni (arm-lms 0)
    print-line-uni (arm-lms-control 0)
    print-all (arm-schedules-more 0) 0
    print-line-uni (arm-det (\d x s k -> sample-ipndm d x s k) "sampler-ipndm.bin" "ipndm vs Forge")
    print-line-uni (arm-det (\d x s k -> sample-ipndm d x s k) "sampler-lms.bin" "control, ipndm graded against lms")
    print-line-uni (arm-det (\d x s k -> sample-ipndm-v d x s k) "sampler-ipndm-v.bin" "ipndm v vs Forge")
    print-line-uni (arm-det (\d x s k -> sample-ipndm-v d x s k) "sampler-ipndm.bin" "control, ipndm v graded against ipndm")
    print-line-uni (arm-det (\d x s k -> sample-heunpp2 d x s k) "sampler-heunpp2.bin" "heunpp2 vs Forge")
    print-line-uni (arm-det (\d x s k -> sample-heunpp2 d x s k) "sampler-heun.bin" "control, heunpp2 graded against heun")
    print-line-uni (arm-det (\d x s k -> sample-deis d x s k) "sampler-deis.bin" "deis vs Forge")
    print-line-uni (arm-det (\d x s k -> sample-deis d x s k) "sampler-ipndm-v.bin" "control, deis graded against ipndm v")
    print-line-uni (arm-plms "sampler-plms.bin" "plms vs Forge")
    print-line-uni (arm-plms "sampler-ddim.bin" "control, plms graded against ddim")
    print-line-uni ("lcm schedule: " & sigma-report-from (lcm-sigmas 6) "sched-lcm.bin")
    print-line-uni (arm-lcm 0 "lcm vs Forge")
    print-line-uni (arm-lcm 1 "sabotage, lcm draws shifted by one")
    print-line-uni (arm-ddpm 0 "ddpm vs Forge")
    print-line-uni (arm-ddpm 1 "sabotage, ddpm draws shifted by one")
    print-line-uni (arm-restart 6 "sampler-noise-restart-20.bin" 1 0 "sampler-heun.bin" "restart 6, below 20 steps, vs Forge's heun")
    print-line-uni (arm-restart 20 "sampler-noise-restart-20.bin" 1 0 "sampler-restart-20.bin" "restart 20 vs Forge")
    print-line-uni (arm-restart 20 "sampler-noise-restart-36.bin" 2 1 "sampler-restart-20.bin" "sabotage, restart 20 fed another draw")
    print-line-uni (arm-restart 36 "sampler-noise-restart-36.bin" 2 0 "sampler-restart-36.bin" "restart 36 vs Forge")
    print-line-uni (arm-restart 36 "sampler-noise-restart-36.bin" 2 1 "sampler-restart-36.bin" "sabotage, restart 36 draws shifted by one")
    print-line-uni (arm-dpm-fast 0 "dpm fast vs Forge")
    print-line-uni (arm-dpm-fast 1 "sabotage, dpm fast draws shifted by one")
    print-line-uni (arm-dpm-adaptive 0 "dpm adaptive vs Forge")
    print-line-uni (arm-dpm-adaptive 1 "sabotage, dpm adaptive draws shifted by one")
    print-line-uni (arm-ddim-cfgpp False "ddim cfg++ vs Forge")
    print-line-uni (arm-ddim-cfgpp True "control, ddim with the guided eps graded against ddim cfg++")
    let r = 0 in r
  end