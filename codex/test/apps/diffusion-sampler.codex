Chapter: DiffusionSampler
  cites Diffusion chapter Sampler
  cites Kernel chapter GpuBridge
  cites Foreword chapter Console

 The fixtures are build/sampler-oracle.py's: Forge's Karras sigmas for 6
 steps over SDXL's discrete schedule, a latent of 1024 elements, the
 analytic denoiser D(x, sigma) = (s2 x + sigma^2 mu) / (s2 + sigma^2) with
 s2 = 0.25, and the results of Forge's sample_euler and sample_dpmpp_sde,
 the latter fed the recorded draws. The sabotage arm feeds DPM++ SDE the
 draws shifted by one.

 We say:

Section: Fixtures

  n : Integer = 1024

  scratch : Integer = #BD700000

  other : Integer = #BD740000

  f32-real : Integer -> Real
  f32-real (raw) =
    let b = bit-and raw #FFFFFFFF
    in let e = bit-and (bit-shru b 23) 255
    in if e == 0 then 0.0
    else bits-to-real (bit-or (bit-shl (bit-shru b 31) 63) (bit-or (bit-shl (e + 896) 52) (bit-shl (bit-and b #7FFFFF) 29)))

  f64-at : Integer, Integer -> Real
  f64-at (addr) (i) = bits-to-real (bit-or (bit-and (peek-32 addr (i * 8)) #FFFFFFFF) (bit-shl (peek-32 addr (i * 8 + 4)) 32))

  post-mean : Integer, Integer, Real -> Integer
  post-mean (mu) (x) (s) =
    let out = gpu-buf-alloc (n * 4)
    in let r = sm-lincomb x mu mu out (0.25 / (0.25 + s * s)) (s * s / (0.25 + s * s)) 0.0 n
    in if r < 0 then 0 else out

  draw : Integer, Integer, Integer -> Integer
  draw (nb) (shift) (k) = draw-from "sampler-noise.bin" 10 nb shift k

  draw-from : Text, Integer, Integer, Integer, Integer -> Integer
  draw-from (file) (count) (nb) (shift) (k) =
    let u = gpu-buf-upload nb 0 file (int-mod (k + shift) count * n * 4) n gpu-dt-f32 gpu-dt-f32
    in nb

Section: Comparisons

  abs-real : Real -> Real
  abs-real (v) = if v < 0.0 then 0.0 - v else v

  max-diff : Integer, Real -> Real
  max-diff (i) (acc) =
    if i >= n then acc
    else let d = abs-real (f32-real (peek-32 scratch (i * 4)) - f32-real (peek-32 other (i * 4)))
    in max-diff (i + 1) (if d > acc then d else acc)

  max-abs : Integer, Real -> Real
  max-abs (i) (acc) =
    if i >= n then acc
    else let d = abs-real (f32-real (peek-32 other (i * 4)))
    in max-abs (i + 1) (if d > acc then d else acc)

  sigma-error : List Real, Integer, Real -> Real
  sigma-error (ours) (i) (acc) =
    if i >= list-length ours then acc
    else let want = f64-at scratch i
    in let e = if want <= 0.0 then abs-real (list-at ours i) else abs-real (list-at ours i - want) / want
    in sigma-error ours (i + 1) (if e > acc then e else acc)

  check-latent : Integer, Text -> Text
  check-latent (x) (file) =
    let h = gpu-buf-alloc (n * 4)
    in let u = gpu-buf-upload h 0 file 0 n gpu-dt-f32 gpu-dt-f32
    in let ok = if gpu-buf-read x 0 (n * 4) scratch then gpu-buf-read h 0 (n * 4) other else False
    in let f = gpu-buf-free h
    in if ok then diff-text (real-to-int (max-diff 0 0.0 * 1000000000.0)) (real-to-int (max-abs 0 0.0 * 1000.0)) else "read refused"

  diff-text : Integer, Integer -> Text
  diff-text (d) (m) = "max abs diff " & show d & "e-9, max abs x " & show m & "e-3"

Section: Arms

  fresh-x0 : Integer -> Integer
  fresh-x0 (z) =
    let h = gpu-buf-alloc (n * 4)
    in let u = gpu-buf-upload h 0 "sampler-x0.bin" 0 n gpu-dt-f32 gpu-dt-f32
    in h

  sigma-report : List Real -> Text
  sigma-report (sig) = sigma-report-from sig "sampler-sigmas.bin"

  sigma-report-from : List Real, Text -> Text
  sigma-report-from (sig) (file) =
    let nb = 8 * list-length sig
    in let h = gpu-buf-alloc nb
    in let ok = if gpu-buf-upload h 0 file 0 nb gpu-dt-u8 gpu-dt-u8 == nb then gpu-buf-read h 0 nb scratch else False
    in let f = gpu-buf-free h
    in if ok == False then "read refused"
    else show (list-length sig) & " sigmas, max relative error vs Forge " & show (real-to-int (sigma-error sig 0 0.0 * 1000000000000.0)) & "e-12"

  mu-buf : Integer -> Integer
  mu-buf (z) =
    let mu = gpu-buf-alloc (n * 4)
    in let um = gpu-buf-upload mu 0 "sampler-mu.bin" 0 n gpu-dt-f32 gpu-dt-f32
    in mu

  arm-bounds : Integer -> Text
  arm-bounds (z) = "sigma bounds x 1e9: " & show (real-to-int (sm-discrete-sigma 0 * 1000000000.0)) & " " & show (real-to-int (sm-discrete-sigma 999 * 1000000000.0))

  arm-karras : Integer -> Text
  arm-karras (z) = "karras: " & sigma-report (sdxl-karras-sigmas 6)

  arm-euler : Integer -> Text
  arm-euler (z) =
    let mu = mu-buf 0
    in let x = fresh-x0 0
    in let bad = sample-euler (\xh s -> post-mean mu xh s) x (sdxl-karras-sigmas 6) n
    in let r = "euler vs Forge (" & show bad & " refused): " & check-latent x "sampler-euler.bin"
    in let f = gpu-buf-free mu
    in let g = gpu-buf-free x
    in r

  arm-heun : Text, Text -> Text
