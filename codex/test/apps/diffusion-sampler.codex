  arm-schedules : Integer -> List Text
  arm-schedules (z) =
    let e = "exponential: " & sigma-report-from (sdxl-exponential-sigmas 6) "sched-exponential.bin"
    in let g = "sgm uniform: " & sigma-report-from (sgm-uniform-sigmas 6) "sched-sgm-uniform.bin"
    in let nm = "normal: " & sigma-report-from (normal-sigmas 6) "sched-normal.bin"
    in let dd = "ddim: " & sigma-report-from (ddim-sigmas 6) "sched-ddim.bin"
    in let pe = "polyexponential: " & sigma-report-from (sdxl-polyexponential-sigmas 6) "sched-polyexponential.bin"
    in let un = "uniform: " & sigma-report-from (uniform-sigmas 6) "sched-uniform.bin"
    in let t6 = "turbo 6: " & sigma-report-from (turbo-sigmas 6) "sched-turbo-6.bin"
    in let t16 = "turbo 16: " & sigma-report-from (turbo-sigmas 16) "sched-turbo-16.bin"
    in [e, g, "simple: " & sigma-report-from (simple-sigmas 6) "sched-simple.bin", nm, dd, pe, un, t6, t16]

