Chapter: SpatialTest
  cites Game chapter Quadtree
  cites Game chapter Octree

Section: Tests
  test-oct-no-split : Text =
    let tree = oct-new (oct-bounds 0 0 0 1000 1000 1000) 4 4
    in let t1 = oct-insert tree (OctObject { obj-id = 1, ox = 100, oy = 100, oz = 100 })
    in let t2 = oct-insert t1 (OctObject { obj-id = 2, ox = 200, oy = 200, oz = 200 })
    in let t3 = oct-insert t2 (OctObject { obj-id = 3, ox = 800, oy = 800, oz = 800 })
    in "objects=" & show (oct-total-objects t3) & " nodes=" & show (oct-num-nodes t3)

  test-oct-query : Text =
    let tree = oct-new (oct-bounds 0 0 0 1000 1000 1000) 4 4
    in let t1 = oct-insert tree (OctObject { obj-id = 1, ox = 100, oy = 100, oz = 100 })
    in let t2 = oct-insert t1 (OctObject { obj-id = 2, ox = 200, oy = 200, oz = 200 })
    in let t3 = oct-insert t2 (OctObject { obj-id = 3, ox = 800, oy = 800, oz = 800 })
    in let results = oct-query-range t3 (oct-bounds 0 0 0 500 500 500)
    in "found=" & show (list-length results)

  test-qt-split : Text =
    let tree = qt-new (qt-bounds-new 0 0 100 100) 4 2
    in let t1 = qt-insert tree (QtPoint { pt-id = 1, pt-x = 10, pt-y = 10 })
    in let t2 = qt-insert t1 (QtPoint { pt-id = 2, pt-x = 50, pt-y = 50 })
    in let t3 = qt-insert t2 (QtPoint { pt-id = 3, pt-x = 90, pt-y = 90 })
    in "points=" & show (qt-total-points t3) & " nodes=" & show (qt-num-nodes t3)

  test-qt-query : Text =
    let tree = qt-new (qt-bounds-new 0 0 100 100) 4 2
    in let t1 = qt-insert tree (QtPoint { pt-id = 1, pt-x = 10, pt-y = 10 })
    in let t2 = qt-insert t1 (QtPoint { pt-id = 2, pt-x = 50, pt-y = 50 })
    in let t3 = qt-insert t2 (QtPoint { pt-id = 3, pt-x = 90, pt-y = 90 })
    in let results = qt-query-range t3 (qt-bounds-new 0 0 100 100)
    in "found=" & show (list-length results)

  test-oct-split : Text =
    let tree = oct-new (oct-bounds 0 0 0 1000 1000 1000) 4 2
    in let t1 = oct-insert tree (OctObject { obj-id = 1, ox = 100, oy = 100, oz = 100 })
    in let t2 = oct-insert t1 (OctObject { obj-id = 2, ox = 200, oy = 200, oz = 200 })
    in let t3 = oct-insert t2 (OctObject { obj-id = 3, ox = 800, oy = 800, oz = 800 })
    in "nodes=" & show (oct-num-nodes t3) & " points=" & show (oct-total-objects t3)

  opening : [Console] Nothing = act
    print-line-uni test-oct-no-split
    print-line-uni test-oct-query
    print-line-uni test-qt-split
    print-line-uni test-qt-query
    print-line-uni test-oct-split
  end
