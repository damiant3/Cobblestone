Chapter: InferenceDemoTest
  cites Foreword chapter Console
  cites Ai chapter NeuralNet
  cites Ai chapter Tensor
  cites Ai chapter GpuProxy

Section: Helpers
  classify : Integer -> Text
  classify (c) = if c == 0 then "red" else if c == 1 then "green" else "blue"

  show-prediction : NeuralNetwork, Integer, Integer -> Text
  show-prediction (net) (x) (y) =
    let input = [x, y]
    in let cls = nn-predict net input
    in let probs = nn-predict-probs net input
    in let max-prob = tensor-get probs cls 0
    in "(" & show x & "," & show y & ") -> " & classify cls & " (" & show max-prob & "/1000)"

Section: Tests
  opening : [Console] Nothing = act
    let w1 = tensor-from 4 2 [500, 500, 0 - 500, 0 - 500, 300, 0 - 300, 0 - 300, 300]
    in let b1 = tensor-from 4 1 [0, 0, 0, 0]
    in let w2 = tensor-from 3 4 [400, 0 - 200, 300, 0 - 100, 0 - 200, 400, 0 - 100, 300, 0 - 100, 0 - 100, 0 - 100, 0 - 100]
    in let b2 = tensor-from 3 1 [0, 0, 0]
    in let net0 = nn-new
    in let net1 = nn-add-layer net0 w1 b1 nn-act-relu
    in let net2 = nn-add-layer net1 w2 b2 nn-act-none
    in act
      print-line-uni ("Network: " & nn-summary net2 & " params=" & show (nn-param-count net2))
      print-line-uni (show-prediction net2 500 500)
      print-line-uni (show-prediction net2 (0 - 500) (0 - 500))
      print-line-uni (show-prediction net2 800 (0 - 200))
      print-line-uni (show-prediction net2 (0 - 800) 200)
      print-line-uni (show-prediction net2 0 0)
      let cmd = gpu-cmd-matmul 2 2 1
      in let buf = gpu-build-matmul-buffer (tensor-from 2 2 [1000, 0, 0, 1000]) (tensor-from 2 1 [500, 500])
      in print-line-uni ("GPU ready: " & format-gpu-cmd cmd & " bufsize=" & show (list-length buf))
    end
  end

