Chapter: SidecarLoadTest

  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Works chapter Annotation
  cites Works chapter AnnotationStore
  cites Works chapter AnnotationsSidecar

Section: Fixtures

  slt-chapter : Text = "Narrator"

  slt-sidecar : Text =
    "[" &
    "{\"target\":\"function:tell-story\",\"kind\":\"rationale\",\"author\":\"cam\",\"date\":\"2026-05-06\",\"body\":\"the prose is load-bearing\"}," &
    "{\"target\":\"function:tell-story\",\"kind\":\"invariant\",\"author\":\"cam\",\"date\":\"2026-05-07\",\"body\":\"the block is never empty\"}," &
    "{\"target\":\"function:fold\",\"kind\":\"banana\",\"author\":\"cam\",\"date\":\"2026/05/08\",\"body\":\"unknown kinds bucket to discovery\"}," &
    "{\"target\":\"function:fold\",\"kind\":\"discussion\",\"author\":\"fester\",\"date\":\"2026-05-09\",\"body\":\"routed to the thread\",\"thread\":\"t1\"}," &
    "{\"kind\":\"warning\",\"author\":\"cam\",\"date\":\"2026-05-10\",\"body\":\"no target, dropped\"}," &
    "{\"target\":\"function:fold\",\"author\":\"cam\",\"date\":\"2026-05-11\",\"body\":\"no kind, dropped\"}" &
    "]"

Section: Helpers

  slt-kinds : List Annotation, Integer, Integer, Text -> Text
  slt-kinds (anns) (i) (n) (acc) =
    if i >= n then acc
    else let sep = if i > 0 then "," else ""
    in let next = acc & sep & annotation-kind-name ((list-at anns i).kind)
    in slt-kinds anns (i + 1) n next

  slt-kinds-for : AnnotationFact, Text -> Text
  slt-kinds-for (af) (path) =
    let anns = af-annotations-for af (make-target slt-chapter path)
    in slt-kinds anns 0 (list-length anns) ""

  slt-has-thread : Maybe Thread -> Text
  slt-has-thread (m) = when m
    is Just (t) -> "yes"
    is otherwise -> "no"

Section: Body

  opening : [Console] Nothing =
    let base = annotation-fact-empty
    in let base-anns = af-annotation-count base
    in let loaded = load-sidecar base slt-chapter slt-sidecar
    in let n-anns = af-annotation-count loaded
    in let n-disc = af-discussion-count loaded
    in let story-kinds = slt-kinds-for loaded "function:tell-story"
    in let fold-kinds = slt-kinds-for loaded "function:fold"
    in let thread = slt-has-thread (af-discussion-for loaded (make-target slt-chapter "function:fold"))
    in let garbage = load-sidecar annotation-fact-empty slt-chapter "not json at all"
    in let n-garbage = af-annotation-count garbage
    in let parsed = parse-sidecar slt-chapter slt-sidecar
    in let n-parsed = when parsed
      is Just (l) -> list-length l
      is otherwise -> 0 - 1
    in let path = sidecar-path-for "works" slt-chapter
    in act
      print-line-uni ("base-annotations=" & show base-anns)
      print-line-uni ("annotations=" & show n-anns)
      print-line-uni ("discussions=" & show n-disc)
      print-line-uni ("tell-story-kinds=" & story-kinds)
      print-line-uni ("fold-kinds=" & fold-kinds)
      print-line-uni ("fold-thread=" & thread)
      print-line-uni ("garbage-annotations=" & show n-garbage)
      print-line-uni ("parse-sidecar-count=" & show n-parsed)
      print-line-uni ("date=" & show (parse-date "2026-05-06"))
      print-line-uni ("slashed-date=" & show (parse-date "2026/05/08"))
      print-line-uni ("bad-date=" & show (parse-date "not-a-date"))
      print-line-uni ("path=" & path)
    end
