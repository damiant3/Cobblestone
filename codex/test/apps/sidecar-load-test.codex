Chapter: SidecarLoadTest

  cites Foreword chapter Console
  cites Works chapter Annotation

Section: Body

  opening : [Console] Nothing =
    let store = annotation-store-empty
    in let t = make-target "Sidecar" "load"
    in let a = create-annotation t Discovery "loader" "found orphan" 200
    in let store2 = annotation-store-add store a
    in let c = integer-to-text (annotation-count store2)
    in let hl = integer-to-text (text-length (a.hash))
    in act
      print-line-uni ("loaded=" & c)
      print-line-uni ("hash-len=" & hl)
    end
