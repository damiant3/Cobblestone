Chapter: UvcDiscoverTest
  cites Codex chapter General
  cites Kernel chapter UsbVideo
  cites Kernel chapter Xhci
  cites Kernel chapter Pci
  cites Kernel chapter VgaGraphics
  cites Foreword chapter CCE

Section: Tests
  test-not-found : Text = format-uvc-device uvc-not-found

  test-device-record : Text =
    let dev = UvcDevice {
      uvc-slot = 3, uvc-stream-if = 1, uvc-stream-ep = 2,
      uvc-format-index = 1, uvc-frame-index = 1,
      uvc-width = 640, uvc-height = 480,
      uvc-frame-interval = 333333, uvc-max-frame-size = 614400,
      uvc-max-payload = 3072, uvc-processing-unit-id = 2,
      uvc-found = True
    }
    in format-uvc-device dev

  test-empty-frame : Text = format-uvc-frame uvc-empty-frame

  test-yuyv-clamp : Text =
    "low=" & show (yuyv-clamp (0 - 10)) & " mid=" & show (yuyv-clamp 128) & " high=" & show (yuyv-clamp 300)

  test-yuyv-convert : Text =
    let yuyv = [128, 128, 128, 128]
    in let pixels = yuyv-to-rgb yuyv 2 1
    in "r0=" & show (list-at pixels 0) & " g0=" & show (list-at pixels 1) & " b0=" & show (list-at pixels 2) & " r1=" & show (list-at pixels 3) & " g1=" & show (list-at pixels 4) & " b1=" & show (list-at pixels 5)

  test-yuyv-white : Text =
    let yuyv = [235, 128, 235, 128]
    in let pixels = yuyv-to-rgb yuyv 2 1
    in "r=" & show (list-at pixels 0) & " g=" & show (list-at pixels 1) & " b=" & show (list-at pixels 2)

  test-probe-data : Text =
    let dev = UvcDevice {
      uvc-slot = 3, uvc-stream-if = 1, uvc-stream-ep = 2,
      uvc-format-index = 1, uvc-frame-index = 1,
      uvc-width = 160, uvc-height = 120,
      uvc-frame-interval = 333333, uvc-max-frame-size = 38400,
      uvc-max-payload = 3072, uvc-processing-unit-id = 2,
      uvc-found = True
    }
    in let probe = uvc-probe-data dev
    in "len=" & show (list-length probe) & " fmt=" & show (list-at probe 2) & " frm=" & show (list-at probe 3)

  test-rx-init : Text =
    let rx = uvc-rx-init
    in "fid=" & show (rx.urx-fid) & " seq=" & show (rx.urx-sequence) & " buf=" & show (list-length (rx.urx-buf))

  opening : [Console] Nothing = act
    print-line-uni test-not-found
    print-line-uni test-device-record
    print-line-uni test-empty-frame
    print-line-uni test-yuyv-clamp
    print-line-uni test-yuyv-convert
    print-line-uni test-yuyv-white
    print-line-uni test-probe-data
    print-line-uni test-rx-init
  end
