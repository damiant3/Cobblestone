Chapter: BootInit
  cites Foreword chapter Console
  cites Foreword chapter FactStore
  cites Trust chapter PolicyEngine
  cites OS chapter ShellCore

Section: Entry

  opening : [Console] Nothing =
    let id = fact-content-hash "codex-node-identity"
    in let id-ok = if text-length id > 0 then "generated" else "failed"
    in let fs = fact-store-empty
    in let fs-ok = if fact-count fs == 0 then "initialized" else "failed"
    in let pol = policy-empty "boot-policy"
    in let shell = shell-init pol 1000
    in let shell-ok = if shell.fuel > 0 then "ready" else "failed"
    in act
      print-line-uni "BOOT: Codex OS"
      print-line-uni ("S3-ID: " & id-ok)
      print-line-uni ("S4-FS: " & fs-ok)
      print-line-uni ("S5-SHELL: " & shell-ok)
      print-line-uni "---"
      print-line-uni ">"
    end
