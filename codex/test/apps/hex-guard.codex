Chapter: Hex Guard
  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Foreword chapter StringUtils
  cites Encode chapter Hex
  cites Works chapter KeyManager

Section: Helpers

  dec-list : List Integer -> Text
  dec-list (bs) = dl bs 0 (list-length bs) ""

  dl : List Integer, Integer, Integer, Text -> Text
  dl (bs) (i) (n) (acc) =
    if i >= n then acc
    else let sep = if i == 0 then "" else " "
    in dl bs (i + 1) n (acc & sep & show (list-at bs i))

  arm : Text, Text -> Text
  arm (name) (s) =
    let raw = "raw=[" & dec-list (hex-decode s) & "]"
    in when hex-decode-checked s
      is Just (bs) -> name & " ok [" & dec-list bs & "] " & raw
      is None -> name & " refused " & raw

  bytes : Integer, Integer, List Integer -> List Integer
  bytes (i) (n) (acc) = if i >= n then acc else bytes (i + 1) n (list-push acc (bit-and i 255))

  enc-cost : Integer, Integer -> Integer
  enc-cost (which) (n) =
    let bs = bytes 0 n []
    in let b = __heap-save
    in let t = if which == 0 then hex-encode bs else if which == 1 then hex-encode-upper bs else hex-dump bs 16
    in let a = __heap-save
    in (a - b) + text-length t - text-length t

  scaling : Text, Integer -> Text
  scaling (name) (which) =
    let small = enc-cost which 256
    in let large = enc-cost which 1024
    in if large <= 5 * small then name & " linear"
    else name & " superlinear " & show small & " " & show large

  export : Text, Text, Text -> Text
  export (fp) (priv) (pub) =
    keypair-export-version & "\nfingerprint: " & fp & "\nprivate: " & priv & "\npublic: " & pub & "\n"

  imp : Text, Text -> Text
  imp (name) (content) = when parse-keypair-export content
    is Just (kp) -> name & " accepted verify=" & (if verify-signature (kp.public-key) "m" (sign-content kp "m") then "yes" else "no")
    is None -> name & " refused"

Section: Entry

  opening : [Console] Nothing =
    let a = generate-keypair [1, 2, 3]
    in let b = generate-keypair [4, 5, 6]
    in let priv = hex-encode (a.private-key)
    in let pub = hex-encode (a.public-key)
    in act
      print-line-uni (arm "lower" "00ff7f")
      print-line-uni (arm "mixed-case" "AbCd")
      print-line-uni (arm "empty" "")
      print-line-uni (arm "odd" "abc")
      print-line-uni (arm "bad-char" "zz")
      print-line-uni (arm "bad-low" "0g")
      print-line-uni ("encode=" & hex-encode [0, 15, 16, 255] & " upper=" & hex-encode-upper [0, 15, 16, 255])
      print-line-uni ("dump=" & hex-dump [1, 2, 3, 4, 5] 2)
      print-line-uni (scaling "encode" 0)
      print-line-uni (scaling "encode-upper" 1)
      print-line-uni (scaling "dump" 2)
      print-line-uni (imp "good" (format-keypair-export a))
      print-line-uni (imp "good-built" (export (a.fingerprint) priv pub))
      print-line-uni (imp "short-priv" (export (a.fingerprint) "abcd" pub))
      print-line-uni (imp "bad-hex-priv" (export (a.fingerprint) ("zz" & text-drop priv 2) pub))
      print-line-uni (imp "other-pub" (export (b.fingerprint) priv (hex-encode (b.public-key))))
      print-line-uni (imp "other-fp" (export (b.fingerprint) priv pub))
      print-line-uni (imp "priv-extra" (export (a.fingerprint) (priv & "f") pub))
      print-line-uni (imp "empty-priv" (export (a.fingerprint) "" pub))
    end
