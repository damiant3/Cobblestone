Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

  maybe-handler-name : Maybe MessageHandler -> Text
  maybe-handler-name (m) = when m
    is Just (h) -> h.name
    is None -> "none"

Section: Body
  opening : [Console] Nothing =
    let lat = lattice-add-direct lattice-empty "alice" 8000
    in let policy = policy-add-rule (policy-empty "test") (rule-allow "allow-all" AlwaysTrue)
    in let node = node-new [1, 2, 3] lat policy
    in let svc = service-new node
    in let svc1 = trust-service-register svc 1 "propose-handler" 0
    in let svc2 = trust-service-register svc1 3 "deny-handler" 5000
    in let stats = service-stats svc2
    in let pr = service-process svc2 0
    in let propose-h = handler-table-lookup (svc2.handlers) 1
    in let missing-h = handler-table-lookup (svc2.handlers) 5
    in act
      print-line-uni stats
      print-line-uni ("handled=" & show-bool (pr.handled) & " denied=" & show-bool (pr.denied))
      print-line-uni ("propose=" & maybe-handler-name propose-h & " deny=" & maybe-handler-name missing-h)
    end

