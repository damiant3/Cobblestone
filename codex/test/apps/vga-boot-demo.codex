Chapter: VgaBootDemo
  cites Kernel chapter Vga
  cites Foreword chapter CCE

Section: Body
  opening : [Console] Nothing = act
    let clr = vga-clear (vga-attr vga-light-gray vga-black)
    in let header-attr = vga-attr vga-white vga-blue
    in let boot-attr = vga-attr vga-light-green vga-black
    in let info-attr = vga-attr vga-cyan vga-black
    in let w1 = vga-put-text 0 0 "Codex OS v1.0" header-attr
    in let w2 = vga-put-text 1 0 "==================" header-attr
    in let w3 = vga-put-text 2 0 "OK: Boot sequence complete" boot-attr
    in let w4 = vga-put-text 3 0 "Memory: 64 MB" boot-attr
    in let w5 = vga-put-text 4 0 "CPU: x86_64" boot-attr
    in let w6 = vga-put-text 5 0 "VGA: 80x25 text" boot-attr
    in let w7 = vga-put-text 6 0 "Devices: PCI IDE" boot-attr
    in let w8 = vga-put-text 7 0 "Network: NE2K" boot-attr
    in let w9 = vga-put-text 8 0 "Services initialized" info-attr
    in let w10 = vga-put-text 9 0 "Policy engine: active" info-attr
    in let w11 = vga-put-text 10 0 "Verifier: ready" info-attr
    in let w12 = vga-put-text 11 0 "Scheduler: running" info-attr
    in let w13 = vga-put-text 12 0 "Shell: available" info-attr
    in let w14 = vga-put-text 13 0 "Kernel: 5 modules" info-attr
    in let w15 = vga-put-text 14 0 "IPC: 0 channels" info-attr
    in let w16 = vga-put-text 15 0 "codex> _" boot-attr
    in act
      print-line-uni "VGA boot demo rendered"
      let h0 = vga-get-char 0 0
      in let h0a = vga-get-attr 0 0
      in let b2 = vga-get-char 2 0
      in let b2a = vga-get-attr 2 0
      in let i8 = vga-get-char 8 0
      in let i8a = vga-get-attr 8 0
      in let p15 = vga-get-char 15 0
      in let p15a = vga-get-attr 15 0
      in act
        print-line-uni ("header: " & show h0 & " " & show h0a)
        print-line-uni ("boot[2]: " & show b2 & " " & show b2a)
        print-line-uni ("info[8]: " & show i8 & " " & show i8a)
        print-line-uni ("prompt[15]: " & show p15 & " " & show p15a)
      end
    end
  end

