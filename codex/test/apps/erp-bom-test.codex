Chapter: ErpBomTest
  cites ERP chapter ErpTypes
  cites ERP chapter FinControlling
  cites ERP chapter PpPlanning

 Known-answer test for the bill-of-material explosion. Order 10 of a
 base-quantity-1 assembly: component A needs 2 each with 10 percent
 scrap (20 required, 22 with scrap, 11000 at unit cost 500); component
 B needs 0.5 each with no scrap (5 required, 6000 at unit cost 1200).

Section: Setup

  comp-a : BomComponent =
    BomComponent { bom-material-id = "A", bom-quantity-x1000 = 2000, bom-unit-cost = 500, bom-scrap-pct = 10 }

  comp-b : BomComponent =
    BomComponent { bom-material-id = "B", bom-quantity-x1000 = 500, bom-unit-cost = 1200, bom-scrap-pct = 0 }

  test-bom : BomHeader =
    BomHeader {
      bh-id = "BOM1", bh-material-id = "FG1", bh-name = "Widget",
      bh-base-qty = 1, bh-valid-from = 0, bh-valid-to = 99999999,
      bh-status = "active", bh-components = [comp-a, comp-b]
    }

Section: Tests

  explosion-line : BomExplosionLine -> Text
  explosion-line (l) =
    let head = l.bel-material-id & ": req=" & show (l.bel-required-qty) & " scrap=" & show (l.bel-with-scrap)
    in head & " cost=" & show (l.bel-total-cost)

  test-explode : List Text =
    let lines = explode-bom test-bom 10
    in [explosion-line (list-at lines 0), explosion-line (list-at lines 1)]

  test-line-cost : Text =
    "line-cost: a=" & show (bom-line-cost comp-a) & " b=" & show (bom-line-cost comp-b)

Section: Body

  opening : [Console] Nothing = act
    let lines = test-explode
    in act
      print-line-uni (list-at lines 0)
      print-line-uni (list-at lines 1)
      print-line-uni test-line-cost
    end
  end
