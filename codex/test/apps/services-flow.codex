Chapter: Services Flow
  cites Foreword chapter Console
  cites Foreword chapter Maybe
  cites Services chapter Revocation
  cites Services chapter ServicesPersist
  cites Services chapter TimeService
  cites Accounts chapter ManagedAccounts
  cites Accounts chapter ParentalUI

Section: Arms

  created : Integer -> Text
  created (now) =
    let ui = parental-ui-init (account-store-new [1, 2, 3] now) 800 600
    in let named = __record-set (__record-set ui "pu-view" ViewCreateAccount) "pu-new-name" "Ada"
    in let done = handle-create-event named 13 now
    in done.pu-status & " accounts=" & show (list-length done.pu-store.as-accounts) & " name=[" & done.pu-new-name & "]"

  pin : Integer -> Text
  pin (now) =
    let ui = __record-set (parental-ui-init (account-store-new [1, 2, 3] now) 800 600) "pu-view" (ViewPinEntry 7)
    in let p1 = handle-pin-event ui 7 49 now
    in let p2 = handle-pin-event p1 7 50 now
    in let typed = p2.pu-pin-input
    in let p3 = handle-pin-event p2 7 8 now
    in "[" & typed & "] [" & p3.pu-pin-input & "]"

  clock : Integer -> Text
  clock (unix) =
    let ts = time-service-new unix [10, 0, 0, 1]
    in "ticks=" & show ts.ts-current-ticks & " syncs=" & show ts.ts-sync-count

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("create " & created 5000)
    print-line-uni ("pin " & pin 5000)
    print-line-uni ("time " & clock 1700000000)
  end
