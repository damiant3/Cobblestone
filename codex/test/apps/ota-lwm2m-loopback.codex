Section: Fixtures

  test-sk : List Integer = [157, 97, 177, 157, 239, 253, 90, 96, 186, 132, 74, 244, 146, 236, 44, 196, 68, 73, 197, 105, 123, 50, 105, 25, 112, 59, 172, 3, 28, 174, 127, 96]

  bank-base : Integer = 536875008

  stage-addr : Integer = 536879104

  stage-capacity : Integer = 65536

  foreign-sk : List Integer = [76, 205, 8, 155, 40, 255, 150, 218, 157, 182, 195, 70, 236, 17, 78, 15, 91, 138, 49, 159, 53, 171, 166, 36, 218, 140, 246, 237, 79, 184, 166, 251]

  trusted-key : Text = bytes-to-hex-range (ed25519-public-key test-sk) 0 32

  firmware-image : List Integer = signed-image test-sk

  foreign-image : List Integer = signed-image foreign-sk

  signed-image : List Integer -> List Integer
  signed-image (sk) =
   let caps = [CdxCapability { cap-id = cdx-cap-console, direction = cdx-dir-write, scope = "/", max-duration = 0 }]
   in let parts = CdxBinaryParts {
    flags = cdx-flag-bare-metal,
    capabilities = caps,
    effects = ["Console"],
    text-bytes = [144, 195],
    rodata-bytes = [],
    entry-offset = 0,
    stack-size = 65536,
    heap-size = 65536,
    trust-threshold = 5000
   }
   in cdx-encode-signed parts sk

  manifest : OtaManifest = manifest-for firmware-image

  manifest-for : List Integer -> OtaManifest
  manifest-for (image) = OtaManifest {
   firmware-uri = "/fw/image.cdx",
   firmware-size = list-length image,
   firmware-hash = hkdf-words-to-bytes (sha256 image),
   version = ota-version-new 7 1000,
   min-battery = 0,
   requires-reboot = True
  }

  boot0 : BootConfig
  boot0 = boot-config-new (ota-version-new 1 500)

Section: The Server Side

  block-size : Integer = 64

  slice-of : List Integer, Integer, Integer -> List Integer
  slice-of (xs) (off) (len) = slice-loop xs off len 0 []

  slice-loop : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  slice-loop (xs) (off) (len) (i) (acc) =
   if i >= len then acc
   else slice-loop xs off len (i + 1) (list-push acc (list-at xs (off + i)))

  block-count : Integer
  block-count =
   let n = list-length firmware-image
   in if int-mod n block-size == 0 then n / block-size else n / block-size + 1

  serve-block : List Integer, Integer -> List Integer
  serve-block (image) (num) =
   let off = num * block-size
   in let remaining = list-length image - off
   in let len = if remaining > block-size then block-size else remaining
   in let more = if num + 1 < block-count then 1 else 0
   in let body = slice-of image off len
   in let opts = [coap-block-option coap-opt-block2 num more 2]
   in coap-build-response CoapAcknowledgement coap-205-content (100 + num) [] opts body

Section: The Download Loop

  run-download : linear Board, Lwm2mFw, List Integer, Integer -> [Flash, Device.Mmio] (linear Board, Lwm2mFw)
  run-download (brd) (c) (image) (num) =
   if num >= block-count then board-pair brd c
   else act
    r <- fw-feed-response brd c (serve-block image num)
    when r
     is (brd1, c2) -> run-download brd1 c2 image (num + 1)
    end

Section: Gate B -- the real verifier

  trust-lattice : TrustLattice = lattice-add-direct lattice-empty trusted-key 8000

  allow-policy : Policy = policy-add-rule (policy-empty "ota") (rule-allow "allow-all" AlwaysTrue)

Section: The Runs

  clean-run : Integer -> [Flash, Device.Mmio] Lwm2mFw
  clean-run (x) = act
   brd0 <- board-open 0 0
   r <- run-download brd0 (fw-write-package-uri (fw-new boot0 (ota-version-new 1 500) bank-base stage-addr stage-capacity) manifest) firmware-image 0
   when r
    is (brd1, c1) -> act
      bc <- board-close brd1
      let c2 = fw-execute-update c1 trust-lattice allow-policy 0 fact-store-empty 100
      in fw-activate c2
    end
  end

  foreign-run : Integer -> [Flash, Device.Mmio] Lwm2mFw
  foreign-run (x) = act
   brd0 <- board-open 0 0
   r <- run-download brd0 (fw-write-package-uri (fw-new boot0 (ota-version-new 1 500) bank-base stage-addr stage-capacity) (manifest-for foreign-image)) foreign-image 0
   when r
    is (brd1, c1) -> act
      bc <- board-close brd1
      let c2 = fw-execute-update c1 trust-lattice allow-policy 0 fact-store-empty 100
      in fw-activate c2
    end
  end

  moved-slot-run : Integer -> [Flash, Device.Mmio] Lwm2mFw
  moved-slot-run (x) = act
   brd0 <- board-open 0 0
   r <- run-download brd0 (fw-write-package-uri (fw-new boot0 (ota-version-new 1 500) bank-base stage-addr stage-capacity) manifest) firmware-image 0
   when r
    is (brd1, c1) -> act
      bc <- board-close brd1
      let bc1 = (c1.fw-ctx).boot-config
      in let ctx1 = c1.fw-ctx
      in let moved = c1 revised { fw-ctx = ctx1 revised { boot-config = bc1 revised { active-slot = SlotB } } }
      in fw-activate (fw-execute-update moved trust-lattice allow-policy 0 fact-store-empty 100)
    end
  end

  tampered-image : List Integer
  tampered-image =
   let i = list-length firmware-image / 2
   in list-set-at (slice-of firmware-image 0 (list-length firmware-image)) i (bit-xor (list-at firmware-image i) 255)

  tampered-run : Integer -> [Flash, Device.Mmio] Lwm2mFw
  tampered-run (x) = act
   brd0 <- board-open 0 0
   r <- run-download brd0 (fw-write-package-uri (fw-new boot0 (ota-version-new 1 500) bank-base stage-addr stage-capacity) manifest) tampered-image 0
   when r
    is (brd1, bad) -> act
      bc <- (board-close brd1)
      bad
    end
  end

Section: The bank bound and the Size2 hint

 `declared` of 0 means the server sends no Size2 option at all.

  small-capacity : Integer = 128

  serve-block-s2 : List Integer, Integer, Integer -> List Integer
  serve-block-s2 (image) (num) (declared) =
   let off = num * block-size
   in let remaining = list-length image - off
   in let len = if remaining > block-size then block-size else remaining
   in let more = if num + 1 < block-count then 1 else 0
   in let body = slice-of image off len
   in let blk = coap-block-option coap-opt-block2 num more 2
   in let opts = if declared == 0 then [blk]
      else [blk, CoapOption { number = coap-opt-size2, value = coap-uint-bytes declared }]
   in coap-build-response CoapAcknowledgement coap-205-content (100 + num) [] opts body

  run-s2 : linear Board, Lwm2mFw, List Integer, Integer, Integer -> [Flash, Device.Mmio] (linear Board, Lwm2mFw)
  run-s2 (brd) (c) (image) (num) (declared) =
   if num >= block-count then board-pair brd c
   else if (c.fw-result) /= 0 then board-pair brd c
   else act
    r <- fw-feed-response brd c (serve-block-s2 image num declared)
    when r
     is (brd1, c2) -> run-s2 brd1 c2 image (num + 1) declared
    end

  bound-arm : Integer, Integer -> [Flash, Device.Mmio] Lwm2mFw
  bound-arm (capacity) (declared) = act
   brd0 <- board-open 0 0
   r <- run-s2 brd0 (fw-write-package-uri (fw-new boot0 (ota-version-new 1 500) bank-base stage-addr capacity) manifest) firmware-image 0 declared
   when r
    is (brd1, c1) -> act
      bc <- board-close brd1
      c1
    end
   end
  end

Section: A server that reads the request

 RFC 7959 section 2.4: the server answers the byte offset the request names
 (num times the requested block size) at its own block size when that is
 smaller, and the client continues at the server's size. `mode` 1 skips one
 block after the first, `mode` 2 labels its answer with the reserved SZX 7.

  req-serve : List Integer, List Integer, Integer, Integer -> List Integer
  req-serve (image) (req) (server-szx) (mode) =
   when coap-parse req
    is None -> []
    is Just (m) ->
      when coap-find-option (m.cm-options) coap-opt-block2
       is None -> []
       is Just (v) ->
         let bv = coap-uint-value v
         in let rszx = coap-block-szx bv
         in let szx = if rszx < server-szx then rszx else server-szx
         in let num = (coap-block-num bv * coap-block-size rszx) / coap-block-size szx
         in let num2 = if mode == 1 & num >= 1 then num + 1 else num
         in serve-at image num2 szx (if mode == 2 then 7 else szx)

  serve-at : List Integer, Integer, Integer, Integer -> List Integer
  serve-at (image) (num) (szx) (label) =
   let size = coap-block-size szx
   in let off = num * size
   in let remaining = list-length image - off
   in let len = if remaining > size then size else if remaining < 0 then 0 else remaining
   in let more = if off + len < list-length image then 1 else 0
   in let opts = [coap-block-option coap-opt-block2 num more label]
   in coap-build-response CoapAcknowledgement coap-205-content (200 + num) [] opts (slice-of image off len)

  run-req : linear Board, Lwm2mFw, List Integer, Integer, Integer, Integer -> [Flash, Device.Mmio] (linear Board, Lwm2mFw)
  run-req (brd) (c) (image) (server-szx) (mode) (fuel) =
   if fuel <= 0 then board-pair brd c
   else if (c.fw-result) /= 0 then board-pair brd c
   else if (c.fw-written) >= list-length image then board-pair brd c
   else act
    r <- fw-feed-response brd c (req-serve image (fw-next-request c (300 + fuel) [7]) server-szx mode)
    when r
     is (brd1, c2) -> run-req brd1 c2 image server-szx mode (fuel - 1)
    end

  req-arm : Integer, Integer -> [Flash, Device.Mmio] Lwm2mFw
  req-arm (server-szx) (mode) = act
   brd0 <- board-open 0 0
   r <- run-req brd0 (fw-write-package-uri (fw-new boot0 (ota-version-new 1 500) bank-base stage-addr stage-capacity) manifest) firmware-image server-szx mode 64
   when r
    is (brd1, c1) -> act
      bc <- board-close brd1
      c1
    end
   end
  end

Section: Body

  show-slot : BootSlot -> Text
  show-slot (s) = boot-slot-name s

  opening : [Console, Flash, Device.Mmio] Nothing = act
   ok <- clean-run 0
   print-line-uni ("blocks: " & show block-count)
   print-line-uni ("clean staged: " & show (ok.fw-written) & " of " & show (list-length firmware-image))
   print-line-uni ("clean state: " & show (fw-state-resource ok))
   print-line-uni ("clean result: " & show (fw-result-resource ok))
   print-line-uni ("clean target slot: " & show-slot (fw-target-slot ok))
   bad <- tampered-run 0
   print-line-uni ("tampered state: " & show (fw-state-resource bad))
   print-line-uni ("tampered result: " & show (fw-result-resource bad))
   print-line-uni ("tampered boots: " & show-slot ((fw-boot-config bad).active-slot))
   alien <- foreign-run 0
   print-line-uni ("foreign staged: " & show (alien.fw-written))
   print-line-uni ("foreign result: " & show (fw-result-resource alien))
   print-line-uni ("foreign boots: " & show-slot ((fw-boot-config alien).active-slot))
   moved <- moved-slot-run 0
   print-line-uni ("moved slot result: " & show (fw-result-resource moved) & " target: " & show-slot (fw-target-slot moved))
   fits <- bound-arm stage-capacity 254
   print-line-uni ("size2 honest wrote: " & show (fits.fw-written) & " result: " & show (fits.fw-result))
   over <- bound-arm small-capacity 0
   print-line-uni ("bank no-size2 wrote: " & show (over.fw-written) & " result: " & show (over.fw-result))
   early <- bound-arm stage-capacity 100000
   print-line-uni ("size2 over wrote: " & show (early.fw-written) & " result: " & show (early.fw-result))
   lie <- bound-arm small-capacity 64
   print-line-uni ("size2 lying low wrote: " & show (lie.fw-written) & " result: " & show (lie.fw-result))
   small <- req-arm 2 0
   print-line-uni ("64-byte server wrote: " & show (small.fw-written) & " result: " & show (small.fw-result))
   large <- req-arm 6 0
   print-line-uni ("1024-byte server wrote: " & show (large.fw-written) & " result: " & show (large.fw-result))
   skip <- req-arm 2 1
   print-line-uni ("server skipping a block wrote: " & show (skip.fw-written) & " result: " & show (skip.fw-result))
   reserved <- req-arm 2 2
   print-line-uni ("server answering szx 7 wrote: " & show (reserved.fw-written) & " result: " & show (reserved.fw-result))
  end