 We say:

Section: Fixtures

  test-sk : List Integer = [157, 97, 177, 157, 239, 253, 90, 96, 186, 132, 74, 244, 146, 236, 44, 196, 68, 73, 197, 105, 123, 50, 105, 25, 112, 59, 172, 3, 28, 174, 127, 96]

  bank-base : Integer = 536875008

  stage-addr : Integer = 536879104

 The staging bank's capacity. Generous against this fixture on purpose: the
 clean and tampered runs must not brush it, so a refusal in either of them
 would be a real failure and not the bound firing. The bound's own arms pick
 their capacity to make it fire.

  stage-capacity : Integer = 65536

  firmware-image : List Integer
  firmware-image =
   let caps = [CdxCapability { cap-id = cdx-cap-console, direction = cdx-dir-write, scope = "/", max-duration = 0 }]
   in let parts = CdxBinaryParts {
    flags = cdx-flag-bare-metal,
    capabilities = caps,
    effects = ["Console"],
    text-bytes = [144, 195],
    rodata-bytes = [],
    entry-offset = 0,
    stack-size = 65536,
    heap-size = 65536,
    trust-threshold = 5000
   }
   in cdx-encode-signed parts test-sk

  firmware-hash : List Integer
  firmware-hash = hkdf-words-to-bytes (sha256 firmware-image)

  manifest : OtaManifest
  manifest = OtaManifest {
   firmware-uri = "/fw/image.cdx",
   firmware-size = list-length firmware-image,
   firmware-hash = firmware-hash,
   version = ota-version-new 7 1000,
   min-battery = 0,
   requires-reboot = True
  }

  boot0 : BootConfig
  boot0 = boot-config-new (ota-version-new 1 500)

Section: The Server Side

  block-size : Integer = 64

  slice-of : List Integer, Integer, Integer -> List Integer
  slice-of (xs) (off) (len) = slice-loop xs off len 0 []

  slice-loop : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  slice-loop (xs) (off) (len) (i) (acc) =
   if i >= len then acc
   else slice-loop xs off len (i + 1) (list-push acc (list-at xs (off + i)))

  block-count : Integer
  block-count =
   let n = list-length firmware-image
   in if int-mod n block-size == 0 then n / block-size else n / block-size + 1

  serve-block : List Integer, Integer -> List Integer
  serve-block (image) (num) =
   let off = num * block-size
   in let remaining = list-length image - off
   in let len = if remaining > block-size then block-size else remaining
   in let more = if num + 1 < block-count then 1 else 0
   in let body = slice-of image off len
   in let opts = [coap-block-option coap-opt-block2 num more 2]
   in coap-build-response CoapAcknowledgement coap-205-content (100 + num) [] opts body

Section: The Download Loop

  run-download : linear Board, Lwm2mFw, List Integer, Integer -> [Flash, Device.Mmio] (linear Board, Lwm2mFw)
  run-download (brd) (c) (image) (num) =
   if num >= block-count then board-pair brd c
   else act
    r <- fw-feed-response brd c (serve-block image num)
    when r
     is (brd1, c2) -> run-download brd1 c2 image (num + 1)
    end
   end

Section: Gate B -- the real verifier

  read-staged : Integer, Integer -> List Integer
  read-staged (addr) (len) = read-staged-loop addr len 0 []

  read-staged-loop : Integer, Integer, Integer, List Integer -> List Integer
  read-staged-loop (addr) (len) (i) (acc) =
   if i >= len then acc
   else read-staged-loop addr len (i + 1) (list-push acc (peek-byte addr i))

 The staged image is read back out of the bank for Gate B, because
 evaluate-load takes a List Integer. That is the memory gap the OTA
 design names: a 192 KB-SRAM device cannot hold a multi-hundred-KB image
 as a List, and a buffer-taking verifier is the fix. Gate A above does
 not pay it -- sha256-buf hashes the address directly.

  gate-b-verdict : Lwm2mFw -> GateBResult
  gate-b-verdict (c) =
   let staged = read-staged stage-addr (list-length firmware-image)
   in let author = read-author-key staged
   in let lat = lattice-add-direct lattice-empty author 8000
   in let policy = policy-add-rule (policy-empty "ota") (rule-allow "allow-all" AlwaysTrue)
   in let decision = evaluate-load staged lat policy 0 fact-store-empty 100
   in if load-approved decision then GateBPass
      else GateBFailAuthor (load-reason decision)

Section: The Runs

  clean-run : Integer -> [Flash, Device.Mmio] Lwm2mFw
  clean-run (x) = act
   brd0 <- board-open 0 0
   r <- run-download brd0 (fw-write-package-uri (fw-new boot0 (ota-version-new 1 500) bank-base stage-addr stage-capacity) manifest) firmware-image 0
   when r
    is (brd1, c1) -> act
      bc <- board-close brd1
      let c2 = fw-execute-update c1 (gate-b-verdict c1)
      in fw-activate c2
    end
  end

  tampered-image : List Integer
  tampered-image =
   let i = list-length firmware-image / 2
   in list-set-at (slice-of firmware-image 0 (list-length firmware-image)) i (bit-xor (list-at firmware-image i) 255)

  tampered-run : Integer -> [Flash, Device.Mmio] Lwm2mFw
  tampered-run (x) = act
   brd0 <- board-open 0 0
   r <- run-download brd0 (fw-write-package-uri (fw-new boot0 (ota-version-new 1 500) bank-base stage-addr stage-capacity) manifest) tampered-image 0
   when r
    is (brd1, bad) -> act
      bc <- (board-close brd1)
      bad
    end
  end

Section: The bank bound and the Size2 hint

 Four arms over the two roles red ruled on 2026-08-20. The BANK SIZE
 enforces and refuses always; Size2 is an EARLY refusal only and can never
 permit more. The arms are chosen so each one fails alone if its own half is
 removed, and the pair that matters most is the last two: a server that
 omits Size2 and a server that declares a small total both have to be
 refused by the bank bound, or the hint has become the bound.

 `declared` of 0 means the server sends no Size2 option at all.

  small-capacity : Integer = 128

  serve-block-s2 : List Integer, Integer, Integer -> List Integer
  serve-block-s2 (image) (num) (declared) =
   let off = num * block-size
   in let remaining = list-length image - off
   in let len = if remaining > block-size then block-size else remaining
   in let more = if num + 1 < block-count then 1 else 0
   in let body = slice-of image off len
   in let blk = coap-block-option coap-opt-block2 num more 2
   in let opts = if declared == 0 then [blk]
      else [blk, CoapOption { number = coap-opt-size2, value = coap-uint-bytes declared }]
   in coap-build-response CoapAcknowledgement coap-205-content (100 + num) [] opts body

 The loop stops on the first failure. A real client abandons a download it
 has refused, and without that this arm would read the SECOND failure: the
 block-order check fires on the next block and would overwrite the result
 code with conn-lost, hiding the cause under a symptom.

  run-s2 : linear Board, Lwm2mFw, List Integer, Integer, Integer -> [Flash, Device.Mmio] (linear Board, Lwm2mFw)
  run-s2 (brd) (c) (image) (num) (declared) =
   if num >= block-count then board-pair brd c
   else if (c.fw-result) /= 0 then board-pair brd c
   else act
    r <- fw-feed-response brd c (serve-block-s2 image num declared)
    when r
     is (brd1, c2) -> run-s2 brd1 c2 image (num + 1) declared
    end
   end

  bound-arm : Integer, Integer -> [Flash, Device.Mmio] Lwm2mFw
  bound-arm (capacity) (declared) = act
   brd0 <- board-open 0 0
   r <- run-s2 brd0 (fw-write-package-uri (fw-new boot0 (ota-version-new 1 500) bank-base stage-addr capacity) manifest) firmware-image 0 declared
   when r
    is (brd1, c1) -> act
      bc <- board-close brd1
      c1
    end
   end
  end

Section: Body

  show-slot : BootSlot -> Text
  show-slot (s) = boot-slot-name s

  opening : [Console, Flash, Device.Mmio] Nothing = act
   ok <- clean-run 0
   print-line-uni ("blocks: " & show block-count)
   print-line-uni ("clean staged: " & show (ok.fw-written) & " of " & show (list-length firmware-image))
   print-line-uni ("clean state: " & show (fw-state-resource ok))
   print-line-uni ("clean result: " & show (fw-result-resource ok))
   print-line-uni ("clean target slot: " & show-slot (fw-target-slot ok))
   bad <- tampered-run 0
   print-line-uni ("tampered state: " & show (fw-state-resource bad))
   print-line-uni ("tampered result: " & show (fw-result-resource bad))
   print-line-uni ("tampered boots: " & show-slot ((fw-boot-config bad).active-slot))
   fits <- bound-arm stage-capacity 254
   print-line-uni ("size2 honest wrote: " & show (fits.fw-written) & " result: " & show (fits.fw-result))
   over <- bound-arm small-capacity 0
   print-line-uni ("bank no-size2 wrote: " & show (over.fw-written) & " result: " & show (over.fw-result))
   early <- bound-arm stage-capacity 100000
   print-line-uni ("size2 over wrote: " & show (early.fw-written) & " result: " & show (early.fw-result))
   lie <- bound-arm small-capacity 64
   print-line-uni ("size2 lying low wrote: " & show (lie.fw-written) & " result: " & show (lie.fw-result))
  end