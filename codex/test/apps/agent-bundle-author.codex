Section: The Forgery

  aa-hex-digit : Integer -> Integer
  aa-hex-digit (n) = if n < 10 then 48 + n else 87 + n

  aa-hex : List Integer, Integer, List Integer -> List Integer
  aa-hex (bs) (i) (acc) =
    if i >= list-length bs then acc
    else aa-hex bs (i + 1) (list-push (list-push acc (aa-hex-digit (bit-shru (list-at bs i) 4))) (aa-hex-digit (bit-and (list-at bs i) 15)))

  aa-seed : List Integer = [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]
  aa-pub : List Integer = ed25519-public-key aa-seed
  aa-signed : List Integer = aa-prefix & aa-hex aa-pub 0 [] & [10]
  aa-sig : List Integer = ed25519-sign aa-seed aa-pub aa-signed
  aa-forged : List Integer = aa-signed & [115, 105, 103, 32] & aa-hex aa-sig 0 [] & [10]

  aa-tampered : List Integer = list-set-at (for b in aa-genuine -> b) 27 (bit-xor (list-at aa-genuine 27) 1)

  aa-said : Maybe Text -> Text
  aa-said (m) = when m is None -> "accepted" is Just (why) -> "refused: " & why

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("genuine manifest = " & aa-said (ab-signature-refusal aa-genuine))
    print-line-uni ("forgery's signature verifies under its own key = " & show (ed25519-verify aa-pub aa-signed aa-sig))
    print-line-uni ("manifest re-keyed and re-signed by a stranger = " & aa-said (ab-signature-refusal aa-forged))
    print-line-uni ("genuine manifest with one byte changed = " & aa-said (ab-signature-refusal aa-tampered))
  end

