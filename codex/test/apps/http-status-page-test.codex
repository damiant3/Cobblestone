Chapter: HttpStatusPageTest
  cites Works chapter Http
  cites Foreword chapter CCE

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

  make-body : Integer, Integer, Text -> Text
  make-body (n) (i) (acc) =
    if i >= n then acc
    else make-body n (i + 1) (acc & "x")

Section: Tests
  test-ok : Text =
    let r = HttpResponse { status = http-200, content-type = "text/html", body = "<html><body>OK</body></html>" }
    in "status=" & r.status & " type=" & r.content-type & " has-body=" & show-bool (text-length (r.body) > 0)

  test-status-only : Text =
    let r = HttpResponse { status = http-200, content-type = "text/html", body = "" }
    in "status=" & r.status

  test-404 : Text =
    let r = HttpResponse { status = http-404, content-type = "text/plain", body = "404 Not Found" }
    in "status=" & r.status & " body=" & r.body

  test-encode : Text =
    let body = make-body 948 0 ""
    in let r = HttpResponse { status = http-200, content-type = "text/html", body = body }
    in let encoded = http-encode r
    in "sent=True resp-len=" & show (list-length encoded)

  opening : [Console] Nothing = act
    print-line-uni test-ok
    print-line-uni test-status-only
    print-line-uni test-404
    print-line-uni test-encode
  end
