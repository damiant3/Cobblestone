Chapter: UdpTest
  cites Net chapter Udp
  cites Net chapter Ethernet

Section: Helpers
  show-bool : Boolean -> Text
  show-bool (b) = if b then "True" else "False"

Section: Body
  opening : [Console] Nothing =
    let d1-bytes = udp-build 5000 53 [72, 101, 108, 108, 111]
    in let d1 = udp-parse d1-bytes
    in let d2 = udp-parse (udp-build 1234 5678 [])
    in let ip-pkt = udp-build-ip-packet [10, 0, 0, 1] [10, 0, 0, 2] 4000 53 [1, 2, 3, 4]
    in let ip-proto = list-at ip-pkt 9
    in let frame = udp-build-frame [255, 255, 255, 255, 255, 255] [0, 0, 0, 0, 0, 1] [10, 0, 0, 1] [10, 0, 0, 2] 5000 53 [65, 66, 67]
    in let d3 = udp-parse (udp-build 5000 53 [65, 66, 67])
    in let d-empty = udp-parse []
    in let uf = udp-parse-ip-payload (udp-build 3000 4000 [1, 2, 3, 4, 5]) [10, 0, 0, 5] [10, 0, 0, 6]
    in act
      print-line-uni ("src=" & show (d1.src-port) & " dst=" & show (d1.dst-port) & " len=" & show (udp-datagram-length d1))
      print-line-uni ("src=" & show (d2.src-port) & " dst=" & show (d2.dst-port) & " len=" & show (udp-datagram-length d2))
      print-line-uni ("proto=" & show ip-proto & " src=" & show 4000 & " dst=" & show 53 & " len=" & show 4)
      print-line-uni ("frame-len=" & show (list-length frame))
      print-line-uni (format-udp-datagram d3)
      print-line-uni ("src=" & show (d-empty.src-port) & " len=" & show (udp-datagram-length d-empty))
      print-line-uni ("valid=" & show-bool (uf.valid) & " " & format-udp-frame uf)
    end

