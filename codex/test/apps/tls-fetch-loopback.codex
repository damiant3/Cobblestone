  ca-parsed : Maybe X509Cert = x509-parse ca-cert

  anchors : List X509Anchor =
    when ca-parsed is None -> [] is Just (c) -> [X509Anchor { xa-subject = c.xc-subject, xa-key = c.xc-key }]

Section: Helpers

  tr-eq : List Integer, List Integer -> Boolean
  tr-eq (a) (b) =
    if list-length a /= list-length b then False
    else tr-eq-loop a b 0 (list-length a)

  tr-eq-loop : List Integer, List Integer, Integer, Integer -> Boolean
  tr-eq-loop (a) (b) (i) (n) =
    if i >= n then True
    else if list-at a i /= list-at b i then False
    else tr-eq-loop a b (i + 1) n

  copy-bytes : List Integer -> List Integer
  copy-bytes (bs) = cb-loop bs 0 (list-length bs) []
  cb-loop : List Integer, Integer, Integer, List Integer -> List Integer
  cb-loop (bs) (i) (n) (acc) =
    if i >= n then acc else cb-loop bs (i + 1) n (list-push acc (list-at bs i))

  flip-late : List Integer -> List Integer
  flip-late (bs) = list-set-at (copy-bytes bs) (list-length bs - 6) (bit-xor (list-at bs (list-length bs - 6)) 1)

Section: Setup

  s0 : TlsEp = tls-ep-server-new s-priv s-random [leaf-cert] leaf-priv leaf-pub
  c0 : TlsEp = tls-ep-client-new c-priv c-random anchors cal-now

Section: The Handshake

 Flight 1: the client's ClientHello, in the clear.

  st1 : TlsEpStep = tls-ep-hello c0
  ch : List Integer = list-at (st1.tes-out) 0

 The server answers with ServerHello in the clear and then
 EncryptedExtensions, Certificate, CertificateVerify and Finished, each
 encrypted under the server handshake key.

  sv1 : TlsEpStep = tls-ep-recv s0 ch
  sh : List Integer = list-at (sv1.tes-out) 0
  ee : List Integer = list-at (sv1.tes-out) 1
  cert : List Integer = list-at (sv1.tes-out) 2
  cv : List Integer = list-at (sv1.tes-out) 3
  fin : List Integer = list-at (sv1.tes-out) 4

 The client consumes the flight in order: ServerHello (key agreement),
 then the encrypted EncryptedExtensions, Certificate (chain walk to the
 anchor), CertificateVerify (signature over its own transcript), and the
 server Finished, at which point it emits its own encrypted Finished.

  c1 : TlsEpStep = tls-ep-recv (st1.tes-ep) sh
  c2 : TlsEpStep = tls-ep-recv (c1.tes-ep) ee
  c3 : TlsEpStep = tls-ep-recv (c2.tes-ep) cert
  c4 : TlsEpStep = tls-ep-recv (c3.tes-ep) cv
  c5 : TlsEpStep = tls-ep-recv (c4.tes-ep) fin
  cfin : List Integer = list-at (c5.tes-out) 0

  sv2 : TlsEpStep = tls-ep-recv (sv1.tes-ep) cfin

Section: Application Data

 GET goes up under the client application key; the server decrypts it. A
 reply goes back down under the server application key; the client decrypts
 that. This is the byte an https fetch would carry, and until this point in
 the tree no connection could carry it.

  cs1 : TlsEpStep = tls-ep-send-app (c5.tes-ep) [71, 69, 84]
  creq : List Integer = list-at (cs1.tes-out) 0
  sv3 : TlsEpStep = tls-ep-recv (sv2.tes-ep) creq

  ss1 : TlsEpStep = tls-ep-send-app (sv3.tes-ep) [79, 75]
  sresp : List Integer = list-at (ss1.tes-out) 0
  c6 : TlsEpStep = tls-ep-recv (cs1.tes-ep) sresp

Section: The Man In The Middle

 Flip a byte inside the ServerHello key share. The client derives a
 different shared secret, so its handshake keys do not match the server's,
 the encrypted flight will not decrypt, and it never completes.

  sh-bad : List Integer = flip-late sh

  m1 : TlsEpStep = tls-ep-recv (st1.tes-ep) sh-bad
  m2 : TlsEpStep = tls-ep-recv (m1.tes-ep) ee
  m3 : TlsEpStep = tls-ep-recv (m2.tes-ep) cert
  m4 : TlsEpStep = tls-ep-recv (m3.tes-ep) cv
  m5 : TlsEpStep = tls-ep-recv (m4.tes-ep) fin

Section: Results

  test-client-done : Text = "tls client-done=" & show (tls-ep-done (c5.tes-ep))
  test-server-done : Text = "tls server-done=" & show (tls-ep-done (sv2.tes-ep))
  test-auth : Text = "tls authenticated=" & show (tls-ep-authenticated (c5.tes-ep))
  test-c2s : Text = "tls c2s=" & show (tr-eq (tls-ep-app-in (sv3.tes-ep)) [71, 69, 84])
  test-s2c : Text = "tls s2c=" & show (tr-eq (tls-ep-app-in (c6.tes-ep)) [79, 75])
  test-mitm : Text = "tls mitm-done=" & show (tls-ep-done (m5.tes-ep)) & " mitm-auth=" & show (tls-ep-authenticated (m5.tes-ep))

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni test-client-done
    print-line-uni test-server-done
    print-line-uni test-auth
    print-line-uni test-c2s
    print-line-uni test-s2c
    print-line-uni test-mitm
  end
