Chapter: Base64Test
  cites Codex chapter General
  cites Encode chapter Base64

Section: Tests
  test-encode-empty : Text =
    "empty=" & base64-encode []

  test-encode-hello : Text =
    "hello=" & base64-encode [72, 101, 108, 108, 111]

  test-encode-one : Text =
    "one=" & base64-encode [77]

  test-encode-two : Text =
    "two=" & base64-encode [77, 97]

  test-decode-hello : Text =
    let bs = base64-decode "aGVsbG8="
    in "decoded=" & show (list-length bs) & " b0=" & show (list-at bs 0) & " b4=" & show (list-at bs 4)

  test-encode-text : Text =
    "text=" & base64-encode-text "Hi"

  opening : [Console] Nothing = act
    print-line-uni test-encode-empty
    print-line-uni test-encode-hello
    print-line-uni test-encode-one
    print-line-uni test-encode-two
    print-line-uni test-decode-hello
    print-line-uni test-encode-text
  end
