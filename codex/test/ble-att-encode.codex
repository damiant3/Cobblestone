Chapter: BleAttEncodeTest

  cites Encode chapter BleAtt

Section: Helpers

  bytes-eq : List Integer, List Integer -> Boolean
  bytes-eq (a) (b) =
   if list-length a /= list-length b then False
   else bytes-eq-loop a b 0 (list-length a)

  bytes-eq-loop : List Integer, List Integer, Integer, Integer -> Boolean
  bytes-eq-loop (a) (b) (i) (len) =
   if i >= len then True
   else if list-at a i /= list-at b i then False
   else bytes-eq-loop a b (i + 1) len

  flag : Boolean -> Integer
  flag (b) = if b then 1 else 0

Section: Checks

  check-read-request : Integer
  check-read-request =
   flag (bytes-eq (att-read-request #0025) [10, 37, 0])

  check-write-request : Integer
  check-write-request =
   flag (bytes-eq (att-write-request #0025 [1]) [18, 37, 0, 1])

  check-notification : Integer
  check-notification =
   flag (bytes-eq (att-notification #002A [100]) [27, 42, 0, 100])

  check-error-response : Integer
  check-error-response =
   flag (bytes-eq (att-error-response att-op-read-request #0025 #0A) [1, 10, 37, 0, 10])

  check-l2cap : Integer
  check-l2cap =
   flag (bytes-eq (att-l2cap (att-read-request #0025)) [3, 0, 4, 0, 10, 37, 0])

  opening : Integer =
   let a = check-read-request
   in let b = check-write-request
   in let c = check-notification
   in let d = check-error-response
   in let e = check-l2cap
   in a + b + c + d + e
