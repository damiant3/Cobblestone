Section: The test
  opening : [Console] Nothing = act
    let font = ttf-parse test-font-bytes
    in let saved-glyf = font.tf-glyf-off
    in let buf = font.tf-buf
    in let hms = font.tf-hmetrics
    in let g1 = ttf-read-glyph buf saved-glyf 20 hms 2
    in act
      print-line-uni (show saved-glyf)
      print-line-uni (show (g1.tg-x-max))
      let g2 = ttf-read-glyph buf saved-glyf 20 hms 2
      in act
        print-line-uni (show (g2.tg-x-max))
        print-line-uni (show (font.tf-num-glyphs))
      end
    end
  end