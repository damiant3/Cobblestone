Chapter: CceTier1Test
  cites Foreword chapter Console
  cites Foreword chapter CCE

Section: Tests

  test-encode-length : [Console] Nothing = act
    print-line-uni (show (cce-encode-length 0))
    print-line-uni (show (cce-encode-length 65))
    print-line-uni (show (cce-encode-length 127))
    print-line-uni (show (cce-encode-length 128))
    print-line-uni (show (cce-encode-length 500))
    print-line-uni (show (cce-encode-length 2175))
    print-line-uni (show (cce-encode-length 2176))
    print-line-uni (show (cce-encode-length 67711))
    print-line-uni (show (cce-encode-length 67712))
  end

