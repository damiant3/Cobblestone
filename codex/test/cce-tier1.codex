  test-roundtrip-unicode : [Console] Nothing = act
    print-line-uni (show (from-unicode (to-unicode 0)))
    print-line-uni (show (from-unicode (to-unicode 13)))
    print-line-uni (show (from-unicode (to-unicode 65)))
    print-line-uni (show (from-unicode (to-unicode 97)))
    print-line-uni (show (from-unicode (to-unicode 127)))
    print-line-uni (show (from-unicode (to-unicode 128)))
    print-line-uni (show (from-unicode (to-unicode 256)))
    print-line-uni (show (from-unicode (to-unicode 384)))
    print-line-uni (show (from-unicode (to-unicode 640)))
    print-line-uni (show (from-unicode (to-unicode 1152)))
    print-line-uni (show (from-unicode (to-unicode 2047)))
  end

  test-encode-bytes : [Console] Nothing = act
    print-line-uni (show (list-length (cce-encode 0)))
    print-line-uni (show (list-length (cce-encode 127)))
    print-line-uni (show (list-length (cce-encode 128)))
    print-line-uni (show (list-length (cce-encode 2175)))
    print-line-uni (show (list-length (cce-encode 2176)))
    print-line-uni (show (list-at (cce-encode 0) 0))
    print-line-uni (show (list-at (cce-encode 127) 0))
    print-line-uni (show (bit-and (list-at (cce-encode 128) 0) 224))
    print-line-uni (show (cce-is-continuation (list-at (cce-encode 128) 1)))
    print-line-uni (show (bit-and (list-at (cce-encode 2176) 0) 240))
  end

