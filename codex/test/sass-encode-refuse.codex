Chapter: SassEncodeRefuse
  cites Sass chapter SassEncode

Section: Main

  show-case : Text, SassInsn -> Text
  show-case (name) (i) = name & " " & sass-word-hex (sass-encode i)

  opening : [Console] Nothing = act
   print-line-uni (show-case "exit" (sass-always SExit))
   print-line-uni (show-case "guard8" (sass-when 8 0 SExit))
   print-line-uni (show-case "guard-neg2" (sass-when 1 2 SExit))
   print-line-uni (show-case "reg256" (sass-always (SIadd 256 1 (SrcReg 2))))
   print-line-uni (show-case "reg-neg" (sass-always (SFfma 1 2 (SrcReg 3) -1)))
   print-line-uni (show-case "sys36" (sass-always (SS2r 0 36)))
   print-line-uni (show-case "imm-wide" (sass-always (SMov32i 1 #100000000)))
   print-line-uni (show-case "imm-low" (sass-always (SMov32i 1 -2147483649)))
   print-line-uni (show-case "imm-min" (sass-always (SMov32i 1 -2147483648)))
   print-line-uni (show-case "float-imm" (sass-always (SFadd 0 1 (SrcImm 1))))
   print-line-uni (show-case "cb-unaligned" (sass-always (SIadd 0 1 (SrcCb 0 2))))
   print-line-uni (show-case "cb-bank32" (sass-always (SIadd 0 1 (SrcCb 32 0))))
   print-line-uni (show-case "cb-off-wide" (sass-always (SIadd 0 1 (SrcCb 0 65536))))
   print-line-uni (show-case "imm20-wide" (sass-always (SIadd 0 1 (SrcImm 524288))))
   print-line-uni (show-case "imm20-low" (sass-always (SMov 0 (SrcImm -524289))))
   print-line-uni (show-case "setp-cmp0" (sass-always (SIsetp 0 0 0 1 (SrcReg 2))))
   print-line-uni (show-case "setp-pt" (sass-always (SIsetp 7 1 0 1 (SrcReg 2))))
   print-line-uni (show-case "ldg64-odd" (sass-always (SLdg 5 2 0 64)))
   print-line-uni (show-case "ldg-width16" (sass-always (SLdg 0 2 0 16)))
   print-line-uni (show-case "ldg-off-wide" (sass-always (SLdg 0 2 8388608 32)))
   print-line-uni (show-case "ldg-edge" (sass-always (SLdg 0 2 -8388608 32)))
   print-line-uni (show-case "bra-misaligned" (sass-always (SBra 4)))
   print-line-uni (show-case "iscadd-shift32" (sass-always (SIscadd 0 1 (SrcReg 2) 32)))
   print-line-uni (show-case "lop3" (sass-always (SLop 0 3 1 (SrcReg 2))))
   print-line-uni (show-case "xmad-cb-cbcc" (sass-always (SXmad 0 1 0 (SrcCb 0 0) 0 3 0 4)))
   print-line-uni (show-case "xmad-imm-h1" (sass-always (SXmad 0 1 0 (SrcImm 5) 1 3 0 0)))
   print-line-uni (show-case "xmad-imm-wide" (sass-always (SXmad 0 1 0 (SrcImm 65536) 0 3 0 0)))
   print-line-uni (show-case "xmad-psl-chi" (sass-always (SXmad 0 1 0 (SrcReg 2) 0 3 1 2)))
   print-line-uni (show-case "xmad-mode5" (sass-always (SXmad 0 1 0 (SrcReg 2) 0 3 0 5)))
   print-line-uni (show-case "iaddc-flags16" (sass-always (SIaddc 0 1 (SrcReg 2) 16)))
   print-line-uni (show-case "iaddc-negimm" (sass-always (SIaddc 0 1 (SrcImm 2) 8)))
   print-line-uni (show-case "setpc-bool3" (sass-always (SIsetpc 0 1 0 0 1 (SrcReg 2) 3 7 0)))
   print-line-uni (show-case "setpc-q8" (sass-always (SIsetpc 0 1 0 0 1 (SrcReg 2) 0 8 0)))
   print-line-uni (show-case "shf-cb" (sass-always (SShf 0 0 1 (SrcCb 0 0) 3 0 0 0)))
   print-line-uni (show-case "shf-imm64" (sass-always (SShf 0 0 1 (SrcImm 64) 3 0 0 0)))
   print-line-uni (show-case "shf-type1" (sass-always (SShf 0 0 1 (SrcReg 2) 3 0 1 0)))
   print-line-uni ("mul-ok " & show (list-length (sass-mul-lo 0 1 (SrcReg 2) 255 3)))
   print-line-uni ("mul-d-is-a " & show (list-length (sass-mul-lo 1 1 (SrcReg 2) 255 3)))
   print-line-uni ("mul-x-is-a " & show (list-length (sass-mul-lo 0 1 (SrcReg 2) 255 1)))
   print-line-uni ("mul-x-is-b " & show (list-length (sass-mul-lo 0 1 (SrcReg 3) 255 3)))
   print-line-uni ("mul-x-is-c " & show (list-length (sass-mul-lo 0 1 (SrcReg 2) 3 3)))
   print-line-uni ("mul-x-is-d " & show (list-length (sass-mul-lo 0 1 (SrcReg 2) 255 0)))
   print-line-uni ("mul-x-is-rz " & show (list-length (sass-mul-lo 0 1 (SrcReg 2) 255 255)))
   print-line-uni ("mul-imm " & show (list-length (sass-mul-lo 0 1 (SrcImm 2) 255 3)))
  end
