Chapter: Ecdsa P384
  cites Foreword chapter Console
  cites Foreword chapter EcdsaP256

 P-384 verification against a vector this project did not produce.
 OpenSSL 3.2.4 generated the key, signed the message under SHA-256, and
 verified its own signature before these bytes were taken, so ours is the
 second implementation to see them rather than the only one.

Section: Vector

  q-pub : List Integer =
    [4, 204, 19, 247, 165, 27, 30, 165, 93, 92, 39, 22,
     139, 250, 167, 132, 244, 138, 115, 234, 130, 179, 243, 84,
     50, 87, 222, 203, 200, 75, 202, 92, 25, 84, 246, 154,
     151, 67, 44, 76, 234, 63, 142, 231, 223, 134, 27, 30,
     58, 5, 122, 32, 66, 76, 194, 210, 163, 165, 185, 19,
     106, 169, 165, 54, 208, 168, 60, 32, 106, 29, 104, 157,
     246, 95, 39, 21, 159, 22, 193, 168, 57, 254, 23, 159,
     180, 12, 79, 123, 89, 206, 183, 123, 186, 147, 47, 138,
     15]

  q-sig : List Integer =
    [246, 221, 222, 199, 248, 187, 186, 126, 78, 139, 66, 21,
     122, 101, 17, 157, 1, 249, 21, 232, 183, 254, 62, 191,
     128, 189, 239, 153, 15, 202, 33, 235, 135, 171, 45, 73,
