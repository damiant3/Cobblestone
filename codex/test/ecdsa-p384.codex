     30, 34, 88, 202, 196, 62, 215, 119, 239, 34, 239, 155]

 "sample", the same message the P-256 chapter signs.

  q-msg : List Integer =
    [115, 97, 109, 112, 108, 101]

Section: Cases

  ok-case : Boolean = ecdsa-p384-verify q-pub q-msg q-sig

  bad-sig : List Integer = list-set-at q-sig 0 (bit-xor (list-at q-sig 0) 1)

  bad-r-case : Boolean = ecdsa-p384-verify q-pub q-msg bad-sig

  bad-s : List Integer = list-set-at q-sig 90 (bit-xor (list-at q-sig 90) 1)

  bad-s-case : Boolean = ecdsa-p384-verify q-pub q-msg bad-s

  bad-key : List Integer = list-set-at q-pub 40 (bit-xor (list-at q-pub 40) 1)

  bad-key-case : Boolean = ecdsa-p384-verify q-pub q-msg bad-key

  q-msg-alt : List Integer = [115, 97, 109, 112, 108, 102]

  bad-msg-case : Boolean = ecdsa-p384-verify q-pub q-msg-alt q-sig

 A P-256 key handed to the P-384 entry point must be refused on length
 rather than reaching the arithmetic with a short buffer.

  short-case : Boolean = ecdsa-p384-verify [4, 1, 2] q-msg q-sig

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("ok=" & show ok-case)
    print-line-uni ("bad-r=" & show bad-r-case)
    print-line-uni ("bad-s=" & show bad-s-case)
    print-line-uni ("bad-key=" & show bad-key-case)
    print-line-uni ("bad-msg=" & show bad-msg-case)
    print-line-uni ("short=" & show short-case)
