# One QEMU boot per arm: QEMU's own i8042 and PS/2 mouse, then the machine without a controller.
i8042 -net none
absent -machine i8042=off -net none
# After the handshake, the pointer the test reads, sent through QEMU's monitor.
inject i8042 aux device ready yes => mouse_move 10 0; mouse_button 1; mouse_move 0 -20; mouse_move -300 0; mouse_button 0
