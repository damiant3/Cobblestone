Chapter: BufWriteByteCursor
  cites Foreword chapter Console

Section: Body

  wr : Integer, Integer, List Integer, Integer, Integer -> Integer
  wr (base) (dst) (xs) (i) (stop) =
    if i >= stop then dst
    else wr base (__buf-write-byte base dst (list-at xs i)) xs (i + 1) stop

  unused : Integer -> Integer
  unused (buf) =
    let e = wr buf 0 [7, 8, 9] 0 3
    in peek-byte buf 1

  used : Integer -> Integer
  used (buf) =
    let e = wr buf 0 [7, 8, 9] 0 3
    in peek-byte buf 1 + e * 0

  opening : [Console] Nothing = act
    print-line-uni ("unused " & show (unused (alloc-bytes 16)))
    print-line-uni ("used " & show (used (alloc-bytes 16)))
  end
