Chapter: ReverseReverse

 The founding flagship (docs/PM/Stories/Vision/NewRepository.txt): a
 machine-checked proof that reversing a list twice returns the original.
 Proven by structural induction over a self-contained list, resting on a
 chain of lemmas -- append-nil, append-assoc, reverse-append -- each an
 induction in its own right, applied at specific arguments inside the
 next. This exercises the whole Stage 5 stack: nested for-all binders,
 N-ary constructor congruence (cong / app-cong), and applicable lemmas.

Section: List

  MyList =
   | MyNil
   | MyCons (Integer) (MyList)

  append : MyList, MyList -> MyList
  append (xs) (ys) = when xs
   is MyNil -> ys
   is MyCons (h) (t) -> MyCons h (append t ys)

  reverse : MyList -> MyList
  reverse (xs) = when xs
   is MyNil -> MyNil
   is MyCons (h) (t) -> append (reverse t) (MyCons h MyNil)

Section: Lemmas

  claim append-nil : for all (xs : MyList), append xs MyNil === xs
  proof append-nil =
   induction on xs
    is MyNil -> Refl
    is MyCons (h) (t) (ih) -> cong ih
   qed

  claim append-assoc : for all (as : MyList), for all (bs : MyList), for all (cs : MyList), append (append as bs) cs === append as (append bs cs)
  proof append-assoc =
   induction on as
    is MyNil -> Refl
    is MyCons (h) (t) (ih) -> cong ih
   qed

  claim reverse-append : for all (xs : MyList), for all (ys : MyList), reverse (append xs ys) === append (reverse ys) (reverse xs)
  proof reverse-append =
   induction on xs
    is MyNil -> sym (append-nil (reverse ys))
    is MyCons (h) (t) (ih) -> trans (app-cong (cong ih)) (append-assoc (reverse ys) (reverse t) (MyCons h MyNil))
   qed

Section: The Flagship

  claim reverse-reverse : for all (xs : MyList), reverse (reverse xs) === xs
  proof reverse-reverse =
   induction on xs
    is MyNil -> Refl
    is MyCons (h) (t) (ih) -> trans (reverse-append (reverse t) (MyCons h MyNil)) (cong ih)
   qed

Section: Main

  opening : [Console] Nothing
  opening = act
   print-line-uni "reverse-reverse: QED"
  end
