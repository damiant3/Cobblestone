Chapter: UnitRealArith

Section: Units

  Metre = unit Real

  Span = unit Metre

  Tick = unit Integer

Section: Ops

  ma : Metre, Metre -> Integer
  ma (a) (b) = real-to-bits (a + b)

  ms : Metre, Metre -> Integer
  ms (a) (b) = real-to-bits (a - b)

  mm : Metre, Metre -> Integer
  mm (a) (b) = real-to-bits (a * b)

  md : Metre, Metre -> Integer
  md (a) (b) = real-to-bits (a / b)

  sa : Span, Span -> Integer
  sa (a) (b) = real-to-bits (a + b)

  sm : Span, Span -> Integer
  sm (a) (b) = real-to-bits (a * b)

  ta : Tick, Tick -> Integer
  ta (a) (b) = a + b

  ts : Tick, Tick -> Integer
  ts (a) (b) = a - b

Section: Report

  opening : [Console] Nothing
  opening = act
    print-line-uni ("add " & show (ma (Metre 1.5) (Metre 2.5)))
    print-line-uni ("addneg " & show (ma (Metre (0.0 - 2.9)) (Metre (0.0 - 1.5))))
    print-line-uni ("sub " & show (ms (Metre 1.5) (Metre 2.5)))
    print-line-uni ("subneg " & show (ms (Metre (0.0 - 2.9)) (Metre (0.0 - 1.5))))
    print-line-uni ("mul " & show (mm (Metre 2.5) (Metre 2.0)))
    print-line-uni ("mulneg " & show (mm (Metre (0.0 - 2.5)) (Metre 2.0)))
    print-line-uni ("div " & show (md (Metre 5.0) (Metre 2.0)))
    print-line-uni ("divneg " & show (md (Metre (0.0 - 5.0)) (Metre 2.0)))
    print-line-uni ("nestadd " & show (sa (Span (Metre 1.5)) (Span (Metre 2.5))))
    print-line-uni ("nestmul " & show (sm (Span (Metre 2.5)) (Span (Metre 2.0))))
    print-line-uni ("tadd " & show (ta (Tick 7) (Tick 5)))
    print-line-uni ("tsub " & show (ts (Tick 7) (Tick 5)))
  end
