Chapter: RuntimeBytesUnsigned

  cites Foreword chapter Console

Section: Body

 A byte at or above 128 is read unsigned by every runtime helper that orders
 bytes or hands one back (plugs-backlog 2.80). The CCE unit for code point 128
 is the two bytes 192 128, and "a" is one byte below 128.

  list-text : List Integer, Integer, Text -> Text
  list-text (xs) (i) (acc) =
    if i >= list-length xs then acc
    else list-text xs (i + 1) (acc & " " & show (list-at xs i))

  high : Text = char-encode (code-to-char 128)

  opening : [Console] Nothing = act
    let b = alloc-bytes 8
    in let w0 = poke-32 b 0 #C880
    in act
      print-line-uni ("buf-read" & list-text (__buf-read-bytes b 0 2) 0 "")
      print-line-uni ("compare-a-high " & show (text-compare "a" high))
      print-line-uni ("compare-high-a " & show (text-compare high "a"))
    end
  end
