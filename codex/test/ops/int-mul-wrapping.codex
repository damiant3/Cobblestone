Chapter: IntMulWrapping
  cites Foreword chapter Wrap64

Section: Operands

  big : Integer
  big = 4000000000

  by-param : Integer between -9223372036854775808 and 9223372036854775807 wrapping, Integer -> Integer
  by-param (a) (b) = a * b

  by-plain : Integer, Integer -> Integer
  by-plain (a) (b) = a * b

Section: Entry

  opening : [Console] Nothing
  opening = act
    print-line-uni ("funnel   want -2446744073709551616: " & integer-to-text (w64-mul big big))
    print-line-uni ("param    want -2446744073709551616: " & integer-to-text (by-param big big))
    print-line-uni ("in-band  want 9000000000000000000: " & integer-to-text (by-plain 3000000000 3000000000))
    print-line-uni ("small    want 42: " & integer-to-text (by-plain 6 7))
  end
