Chapter: Closure Seven Values

  Box = record { bx-a : Integer, bx-k : Integer }

  apply2 : (Integer, Integer -> Integer), Integer, Integer -> Integer
  apply2 (f) (x) (y) = f x y

  apply7 : (Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer), Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  apply7 (f) (a) (b) (c) (d) (e) (g) (h) = f a b c d e g h

  w6 : Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  w6 (a) (b) (c) (d) (x) (y) = a + b * 10 + c * 100 + d * 1000 + x * 10000 + y * 100000

  w7 : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  w7 (a) (b) (c) (d) (e) (x) (y) = a + b * 10 + c * 100 + d * 1000 + e * 10000 + x * 100000 + y * 1000000

  w11 : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  w11 (a) (b) (c) (d) (e) (g) (h) (i) (j) (x) (y) = a + b * 10 + c * 100 + d * 1000 + e * 10000 + g * 100000 + h * 1000000 + i * 10000000 + j * 100000000 + x * 1000000000 + y * 10000000000

  wb : Box, Integer, Integer -> Integer
  wb (r) (x) (y) = r.bx-a + r.bx-k * 10 + x * 100 + y * 1000

  four-captures : Integer, Integer, Integer, Integer -> Integer
  four-captures (a) (b) (c) (d) = apply2 (\x y -> w6 a b c d x y) 5 6

  five-captures : Integer, Integer, Integer, Integer, Integer -> Integer
  five-captures (a) (b) (c) (d) (e) = apply2 (\x y -> w7 a b c d e x y) 6 7

  nine-captures : Box, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  nine-captures (r) (a) (b) (c) (d) (e) (g) (h) (i) = apply2 (\x y -> w11 a b c d e g h i (r.bx-k) x y) 1 2

  one-record : Box -> Integer
  one-record (r) = apply2 (\x y -> wb r x y) 3 4

  w8 : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  w8 (a) (b) (c) (d) (e) (g) (h) (i) = a + b * 10 + c * 100 + d * 1000 + e * 10000 + g * 100000 + h * 1000000 + i * 10000000

  under-seven : (Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer) -> Integer
  under-seven (f) =
    let g = f 2 3 4 5 6 7 8
    in g 9 10 11

  make-adder : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> (Integer -> Integer)
  make-adder (a) (b) (c) (d) (e) (g) (h) = \i -> w8 a b c d e g h i

  over-eight : (Integer, Integer, Integer, Integer, Integer, Integer, Integer -> (Integer -> Integer)) -> Integer
  over-eight (f) = f 1 2 3 4 5 6 7 8

  opening : [Console] Nothing = act
   print-line-uni ("4 captures, 2 args: " & show (four-captures 1 2 3 4))
   print-line-uni ("1 record, 2 args: " & show (one-record (Box { bx-a = 1, bx-k = 2 })))
   print-line-uni ("5 captures, 2 args: " & show (five-captures 1 2 3 4 5))
   print-line-uni ("9 captures, 2 args: " & show (nine-captures (Box { bx-a = 1, bx-k = 9 }) 1 2 3 4 5 6 7 8))
   print-line-uni ("0 captures, 7 args: " & show (apply7 w7 1 2 3 4 5 6 7))
   print-line-uni ("7 args short of 10, then 3: " & show (under-seven (w11 1)))
   print-line-uni ("8 args to a closure taking 7: " & show (over-eight make-adder))
  end
