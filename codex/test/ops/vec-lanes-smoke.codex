Chapter: Vec Lanes Smoke

Section: Build

  poke-bits : Integer, Integer, Integer, Integer -> Integer
  poke-bits (base) (off) (bits) (i) =
   if i >= 8 then 0
   else let b = bit-and (bit-shru bits (i * 8)) 255
   in let w = poke-byte base (off + i) b
   in poke-bits base off bits (i + 1)

  mk2 : Real, Real -> Vector 2 Real
  mk2 (x) (y) =
   let base = alloc-bytes 16
   in let a = poke-bits base 0 (real-to-bits x) 0
   in let b = poke-bits base 8 (real-to-bits y) 0
   in vec-load-at base

Section: Probes

  lane0 : Real, Real -> Real
  lane0 (x) (y) = vec-extract (mk2 x y) 0

  lane1 : Real, Real -> Real
  lane1 (x) (y) = vec-extract (mk2 x y) 1

  add-lane : Real, Real, Real, Real, Integer -> Real
  add-lane (x0) (x1) (y0) (y1) (i) = vec-extract (mk2 x0 x1 + mk2 y0 y1) i

  sub-lane : Real, Real, Real, Real, Integer -> Real
  sub-lane (x0) (x1) (y0) (y1) (i) = vec-extract (mk2 x0 x1 - mk2 y0 y1) i

  mul-lane : Real, Real, Real, Real, Integer -> Real
  mul-lane (x0) (x1) (y0) (y1) (i) = vec-extract (mk2 x0 x1 * mk2 y0 y1) i

  div-lane : Real, Real, Real, Real, Integer -> Real
  div-lane (x0) (x1) (y0) (y1) (i) = vec-extract (mk2 x0 x1 / mk2 y0 y1) i

  hsum : Real, Real -> Real
  hsum (x) (y) = vec-reduce-add (mk2 x y)

Section: Entry

  opening : [Console] Nothing = act
   print-line-uni ("lane0: " & show (lane0 1.5 2.5))
   print-line-uni ("lane1: " & show (lane1 1.5 2.5))
   print-line-uni ("add0: " & show (add-lane 1.5 2.5 10.0 20.0 0))
   print-line-uni ("add1: " & show (add-lane 1.5 2.5 10.0 20.0 1))
   print-line-uni ("sub0: " & show (sub-lane 10.0 20.0 1.5 2.5 0))
   print-line-uni ("sub1: " & show (sub-lane 10.0 20.0 1.5 2.5 1))
   print-line-uni ("mul0: " & show (mul-lane 1.5 2.5 4.0 8.0 0))
   print-line-uni ("mul1: " & show (mul-lane 1.5 2.5 4.0 8.0 1))
   print-line-uni ("div0: " & show (div-lane 9.0 20.0 2.0 4.0 0))
   print-line-uni ("div1: " & show (div-lane 9.0 20.0 2.0 4.0 1))
   print-line-uni ("hsum: " & show (hsum 1.5 2.5))
  end

