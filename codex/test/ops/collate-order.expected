table vs to-unicode: lower-mismatches=0 upper-mismatches=0
accent table: entries=16 forms=16
letters: a/b=-1|-1 b/c=-1|1 c/d=-1|1 e/c=1|-1 t/a=1|-1 z/a=1|1
words: apple/banana=-1|-1 banana/cherry=-1|1 cherry/apple=1|1 apple/apple=0|0
prefix: app/apple=-1|-1 apple/app=1|1 /a=-1|-1
case: zebra/Apple=1|-1 apple/Banana=-1|-1 Apple/apple=1|1 APPLE/apple=1|1
classes: 9/a=-1|-1 1/9=-1|-1 !/1=-1|1  /a=-1|-1
accented: e-vs-z=-1 base-before-accent=-1 accent-before-f=-1 encoding-put-it-after-z=1
sorted: alpha Bravo charlie delta echo
