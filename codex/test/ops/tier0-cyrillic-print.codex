Chapter: Tier Zero Cyrillic Print

  show-run : Integer, Integer, Text -> Text
  show-run (i) (stop) (acc) =
   if i > stop then acc
   else show-run (i + 1) stop (acc & char-to-text (code-to-char i))

  opening : [Console] Nothing = act
   print-line-uni ("cyrillic-113-127: " & show-run 113 127 "")
   print-line-uni ("accented-97-104:  " & show-run 97 104 "")
   print-line-uni ("ascii-3-12:       " & show-run 3 12 "")
  end
