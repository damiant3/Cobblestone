Chapter: RecordEquality

 A record is compared by CONTENT without asking. Until COMPILER-75 `td-eq-safe`
 answered False for a record body, so every SUM was structural by default and a
 record was compared by POINTER unless its author wrote `deriving Eq`: two
 identical records answered False and nothing said why.

 Every row builds its two sides as SEPARATE allocations. Two names bound to one
 record would compare equal under a pointer compare as well and would prove
 nothing.

 `Priced` carries a Real field and is here for the guard rather than for an
 answer. A field the language refuses to compare takes the helper away, which
 is what keeps `codex/test/ops/real-mode-fields` compiling; this chapter only
 asserts that such a record still BUILDS and can be read, because `==` on it is
 the pointer compare that COMPILER-75 deliberately does not change.

  Point = record { px : Integer, py : Integer }

  Named = record { n-name : Text, n-point : Point }

  Carrier = record { c-items : List Integer, c-tag : Text }

  Priced = record { pr-name : Text, pr-cost : Real }

  yn : Boolean -> Text
  yn (b) = if b then "True" else "False"

  mk-point : Integer -> Point
  mk-point (k) = Point { px = k, py = k + 1 }

  mk-named : Integer -> Named
  mk-named (k) = Named { n-name = integer-to-text k, n-point = mk-point k }

  mk-carrier : Integer -> Carrier
  mk-carrier (k) = Carrier { c-items = [k, k + 1, k + 2], c-tag = integer-to-text k }

  a-plain : Text = "record equal=" & yn (mk-point 3 == mk-point 3)

  a-differs : Text = "record differs=" & yn (mk-point 3 == mk-point 4)

  a-neq : Text = "record not-equal-operator=" & yn (mk-point 3 /= mk-point 4)

  a-text-field : Text =
   "record text-field=" & yn (Named { n-name = integer-to-text 7, n-point = mk-point 1 } == Named { n-name = integer-to-text 7, n-point = mk-point 1 })

  a-nested : Text = "record nested=" & yn (mk-named 5 == mk-named 5)

  a-nested-differs : Text = "record nested-differs=" & yn (mk-named 5 == mk-named 6)

  a-list-field : Text = "record list-field=" & yn (mk-carrier 2 == mk-carrier 2)

  a-list-field-differs : Text = "record list-field-differs=" & yn (mk-carrier 2 == mk-carrier 9)

  a-real-builds : Text =
   "record real-field-builds=" & yn (text-length ((Priced { pr-name = "x", pr-cost = 1.5 }).pr-name) == 1)

  opening : [Console] Nothing = act
   print-line-uni a-plain
   print-line-uni a-differs
   print-line-uni a-neq
   print-line-uni a-text-field
   print-line-uni a-nested
   print-line-uni a-nested-differs
   print-line-uni a-list-field
   print-line-uni a-list-field-differs
   print-line-uni a-real-builds
  end
