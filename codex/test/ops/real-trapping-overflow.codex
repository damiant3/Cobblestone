Chapter: RealTrappingOverflow

Section: Operands

  real-max : Real
  real-max = bits-to-real #7FEFFFFFFFFFFFFF

Section: Ops

  add-trap : Real trapping, Real trapping -> Real trapping
  add-trap (a) (b) = a + b

  trap-bits : Real trapping -> Integer
  trap-bits (x) = real-to-bits (from-real-trapping x)

Section: Report

  opening : [Console] Nothing
  opening = act
    print-line-uni "alive"
    print-line-uni ("must-not-print " & show (trap-bits (add-trap (to-real-trapping real-max) (to-real-trapping real-max))))
  end
