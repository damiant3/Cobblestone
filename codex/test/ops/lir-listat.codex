Chapter: LirListAt

Section: Subjects

  la-sum : List Integer, Integer, Integer, Integer -> Integer
  la-sum (xs) (i) (n) (acc) =
    if i >= n then acc
    else la-sum xs (i + 1) n (acc + list-at xs i)

  la-imm : List Integer, Integer, Integer -> Integer
  la-imm (xs) (k) (acc) =
    if k <= 0 then acc
    else la-imm xs (k - 1) (acc + list-at xs 2 * k)

  la-trues : List Boolean, Integer, Integer, Integer -> Integer
  la-trues (bs) (i) (n) (acc) =
    if i >= n then acc
    else la-trues bs (i + 1) n (if list-at bs i then acc + 1 else acc)

  la-mix : List Integer, Integer, Integer, Integer -> Integer
  la-mix (ws) (i) (n) (h) =
    if i >= n then h
    else la-mix ws (i + 1) n (bit-and (bit-xor (bit-shl h 5) (h + list-at ws i)) 4294967295)

  la-tab : Integer, Integer, Integer -> Integer
  la-tab (i) (n) (acc) =
    if i >= n then acc
    else la-tab (i + 1) n (acc + list-at tab i)

  la-fresh : Integer, Integer -> Integer
  la-fresh (k) (acc) =
    if k <= 0 then acc
    else la-fresh (k - 1) (acc + list-at fresh 0)

  ls-fill : List Integer, Integer, Integer -> List Integer
  ls-fill (xs) (i) (n) =
    if i >= n then xs
    else ls-fill (list-set-at xs i (i * i + 1)) (i + 1) n

  lp-grow : List Integer, Integer, Integer -> List Integer
  lp-grow (xs) (i) (n) =
    if i >= n then xs
    else lp-grow (list-push xs (i * 3)) (i + 1) n

Section: Inputs

  tail-of : List Integer -> List Integer
  tail-of (xs) =
    when xs
     is Cons (hd) (tl) -> tl
     is otherwise -> xs

  ten : List Integer = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3]

  fresh : List Integer = [7, 8, 9]

  tab : List Integer = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3]

Section: Entry

  opening : [Console] Nothing =
    let view = tail-of (tail-of ten)
    in let written = list-set-at fresh 0 100
    in let pad = [0, 0, 0, 0, 0, 0]
    in let filled = ls-fill pad 0 6
    in let base = [7, 7, 7, 7, 7, 7]
    in let tview = ls-fill (tail-of (tail-of base)) 0 4
    in let grown = lp-grow [] 0 20
    in let four = [1, 2, 3, 4]
    in let pview = lp-grow (tail-of (tail-of four)) 0 3
    in let acc = lp-grow [] 0 3
    in let pushed = list-push acc 100
    in act
      print-line-uni ("sum:      " & show (la-sum ten 0 10 0))
      print-line-uni ("view-sum: " & show (la-sum view 0 (list-length view) 0))
      print-line-uni ("view-len: " & show (list-length view))
      print-line-uni ("imm:      " & show (la-imm ten 6 0))
      print-line-uni ("trues:    " & show (la-trues [True, False, True, True, False] 0 5 0))
      print-line-uni ("mix:      " & show (la-mix ten 0 10 2166136261))
      print-line-uni ("tab:      " & show (la-tab 0 10 0))
      print-line-uni ("written:  " & show (list-at written 0))
      print-line-uni ("fresh:    " & show (la-fresh 3 0))
      print-line-uni ("fill-sum: " & show (la-sum filled 0 6 0))
      print-line-uni ("fill-pad: " & show (list-at pad 3))
      print-line-uni ("set-view: " & show (list-at tview 0) & " " & show (list-length tview))
      print-line-uni ("set-base: " & show (la-sum base 0 6 0))
      print-line-uni ("set-head: " & show (list-at base 1))
      print-line-uni ("grow:     " & show (list-length grown) & " " & show (la-sum grown 0 (list-length grown) 0))
      print-line-uni ("push-view:" & show (list-length pview) & " " & show (la-sum pview 0 (list-length pview) 0))
      print-line-uni ("push-base:" & show (list-length four) & " " & show (la-sum four 0 4 0))
      print-line-uni ("alias:    " & show (list-length acc) & " " & show (list-at pushed 3))
    end
