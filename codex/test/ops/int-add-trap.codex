Chapter: IntAddTrap

Section: Operands

  top : Integer
  top = 9223372036854775807

Section: Ops

  add-one : Integer -> Integer
  add-one (a) = a + 1

Section: Report

  opening : [Console] Nothing
  opening = act
    print-line-uni "alive"
    print-line-uni ("must-not-print " & show (add-one top))
  end
