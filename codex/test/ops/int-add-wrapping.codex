Chapter: IntAddWrapping
  cites Foreword chapter Wrap64

Section: Operands

  top : Integer
  top = 9223372036854775807

  bottom : Integer
  bottom = 0 - 9223372036854775807 - 1

  add-param : Integer between -9223372036854775808 and 9223372036854775807 wrapping, Integer -> Integer
  add-param (a) (b) = a + b

  sub-param : Integer between -9223372036854775808 and 9223372036854775807 wrapping, Integer -> Integer
  sub-param (a) (b) = a - b

  add-imm-param : Integer between -9223372036854775808 and 9223372036854775807 wrapping -> Integer
  add-imm-param (a) = a + 1

  sub-imm-param : Integer between -9223372036854775808 and 9223372036854775807 wrapping -> Integer
  sub-imm-param (a) = a - 1

  add-plain : Integer, Integer -> Integer
  add-plain (a) (b) = a + b

  sub-plain : Integer, Integer -> Integer
  sub-plain (a) (b) = a - b

Section: Entry

  opening : [Console] Nothing
  opening = act
    print-line-uni ("funnel-add want -9223372036854775808: " & integer-to-text (w64-add top 1))
    print-line-uni ("funnel-sub want 9223372036854775807: " & integer-to-text (w64-sub bottom 1))
    print-line-uni ("param-add  want -9223372036854775808: " & integer-to-text (add-param top 1))
    print-line-uni ("param-sub  want 9223372036854775807: " & integer-to-text (sub-param bottom 1))
    print-line-uni ("imm-add    want -9223372036854775808: " & integer-to-text (add-imm-param top))
    print-line-uni ("imm-sub    want 9223372036854775807: " & integer-to-text (sub-imm-param bottom))
    print-line-uni ("in-band    want 9000000000000000000: " & integer-to-text (add-plain 4500000000000000000 4500000000000000000))
    print-line-uni ("in-band    want -9000000000000000000: " & integer-to-text (sub-plain (0 - 4500000000000000000) 4500000000000000000))
    print-line-uni ("small      want 42: " & integer-to-text (add-plain 40 2))
    print-line-uni ("small      want 42: " & integer-to-text (sub-plain 50 8))
  end
