Chapter: VariantAddress
  cites Foreword chapter Console
Section: Types
  Value = | Empty | Number (Integer)
  Branch = | Leaf | Children (List Branch)
  Generic (a) = | GNone | GSome (a)
Section: Functions
  read-value : Value -> Integer
  read-value (v) = when v
   is Number (n) -> n
   is Empty -> 0
  read-generic : Generic Integer -> Integer
  read-generic (v) = when v
   is GSome (n) -> n
   is GNone -> 0
  cx-frac : Integer -> Integer
  cx-frac (n) = n + 1
  opening : [Console] Nothing = act
   let hp = __heap-save
   in let v = Number 7
   in let empty = Empty
   in let branch = Children [Leaf]
   in let end-hp = __heap-save
   in act
    print-line-uni ("payload " & show (read-value v))
    print-line-uni ("empty " & show (read-value empty))
    print-line-uni ("generic " & show (read-generic (GSome 9)))
    print-line-uni ("value-address " & show (address-of v >= hp & address-of v < end-hp))
    print-line-uni ("empty-address " & show (address-of empty >= hp & address-of empty < end-hp))
    print-line-uni ("list-recursive-address " & show (address-of branch >= hp & address-of branch < end-hp))
    print-line-uni ("fraction-name " & show (cx-frac 4))
    print-line-uni ("real " & show 1.5)
   end
  end
