Chapter: LirBitops

Section: Subjects

  lb-xor-rr : Integer, Integer, Integer, Integer -> Integer
  lb-xor-rr (x) (i) (n) (acc) =
    if i >= n then acc
    else lb-xor-rr x (i + 1) n (bit-xor acc (x + i))

  lb-xor-imm : Integer, Integer, Integer, Integer -> Integer
  lb-xor-imm (x) (i) (n) (acc) =
    if i >= n then acc
    else lb-xor-imm x (i + 1) n (bit-xor (acc + i) 1311768467463790320)

  lb-and-wide : Integer, Integer, Integer, Integer -> Integer
  lb-and-wide (x) (i) (n) (acc) =
    if i >= n then acc
    else lb-and-wide x (i + 1) n (acc + bit-and (x + i) 4294967295)

  lb-and-neg : Integer, Integer, Integer, Integer -> Integer
  lb-and-neg (x) (i) (n) (acc) =
    if i >= n then acc
    else lb-and-neg x (i + 1) n (acc + bit-and (x + i) (0 - 256))

  lb-or-imm : Integer, Integer, Integer, Integer -> Integer
  lb-or-imm (x) (i) (n) (acc) =
    if i >= n then acc
    else lb-or-imm x (i + 1) n (bit-xor acc (bit-or (x + i) 1048576))

  lb-shl : Integer, Integer, Integer, Integer -> Integer
  lb-shl (x) (i) (n) (acc) =
    if i >= n then acc
    else lb-shl x (i + 1) n (bit-xor acc (bit-shl (x + i) 40))

  lb-sar : Integer, Integer, Integer, Integer -> Integer
  lb-sar (x) (i) (n) (acc) =
    if i >= n then acc
    else lb-sar x (i + 1) n (acc + bit-shr (x - i) 3)

  lb-shru : Integer, Integer, Integer, Integer -> Integer
  lb-shru (x) (i) (n) (acc) =
    if i >= n then acc
    else lb-shru x (i + 1) n (acc + bit-shru (x - i) 60)

  lb-imm-left : Integer, Integer, Integer, Integer -> Integer
  lb-imm-left (x) (i) (n) (acc) =
    if i >= n then acc
    else lb-imm-left x (i + 1) n (acc + bit-and 1023 (x + i))

  lb-edges : Integer, Integer, Integer, Integer -> Integer
  lb-edges (x) (i) (n) (acc) =
    if i >= n then acc
    else lb-edges x (i + 1) n (acc + bit-shl (x + i) 0 + bit-shru (x - i) 63)

  lb-mix : Integer, Integer, Integer, Integer -> Integer
  lb-mix (x) (i) (n) (acc) =
    if i >= n then acc
    else lb-mix x (i + 1) n (bit-and (bit-xor (bit-shl acc 5) (acc + bit-or x i)) 1099511627775)

  lb-var-shift : Integer, Integer, Integer, Integer -> Integer
  lb-var-shift (x) (i) (n) (acc) =
    if i >= n then acc
    else lb-var-shift x (i + 1) n (bit-xor acc (bit-shl (x + i) (bit-and i 63)))

Section: Entry

  opening : [Console] Nothing =
    let hi = 81985529216486895
    in let neg = 0 - 81985529216486895
    in act
      print-line-uni ("xor-rr:    " & show (lb-xor-rr hi 0 50 9151314442816847872))
      print-line-uni ("xor-imm:   " & show (lb-xor-imm hi 0 50 0))
      print-line-uni ("and-wide:  " & show (lb-and-wide hi 0 50 0))
      print-line-uni ("and-neg:   " & show (lb-and-neg (0 - 1000003) 0 50 0))
      print-line-uni ("or-imm:    " & show (lb-or-imm hi 0 50 0))
      print-line-uni ("shl:       " & show (lb-shl 12345 0 50 0))
      print-line-uni ("sar:       " & show (lb-sar neg 0 50 0))
      print-line-uni ("shru:      " & show (lb-shru neg 0 50 0))
      print-line-uni ("imm-left:  " & show (lb-imm-left hi 0 50 0))
      print-line-uni ("edges:     " & show (lb-edges (0 - 25) 0 50 0))
      print-line-uni ("mix:       " & show (lb-mix 987654321 0 50 1))
      print-line-uni ("var-shift: " & show (lb-var-shift 12345 0 50 0))
    end
