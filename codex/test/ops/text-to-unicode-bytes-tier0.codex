Chapter: Text To Unicode Bytes Tier Zero

  run-of : Integer, Integer, Text -> Text
  run-of (i) (stop) (acc) =
   if i > stop then acc
   else run-of (i + 1) stop (acc & char-to-text (code-to-char i))

  join-ints : List Integer, Integer, Text -> Text
  join-ints (xs) (i) (acc) =
   if i >= list-length xs then acc
   else join-ints xs (i + 1) (acc & " " & show (list-at xs i))

  codes-of : Integer, Integer -> Text
  codes-of (lo) (hi) = join-ints (text-to-unicode-bytes (run-of lo hi "")) 0 ""

  opening : [Console] Nothing = act
   print-line-uni ("cyrillic:" & codes-of 113 127)
   print-line-uni ("accented:" & codes-of 97 104)
   print-line-uni ("digits:  " & codes-of 3 12)
   print-line-uni ("upper:   " & codes-of 39 44)
  end
