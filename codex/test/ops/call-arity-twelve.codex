  tc4 (n) (x1) (x2) (x3) = if n == 0 then w3 x1 x2 x3 else tc4 (n - 1) (x2 + 2) (x3 + 3) (x1 + 1)

  t5 : Integer, Integer, Integer, Integer, Integer -> Integer
