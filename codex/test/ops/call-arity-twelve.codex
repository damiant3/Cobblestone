  late7 : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  late7 (x1) (x2) (x3) (x4) (x5) (x6) (x7) = let y = w2 x1 x2 in y * 1000000 + x7 * 10000 + x6 * 100 + x5

  late12 : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  late12 (x1) (x2) (x3) (x4) (x5) (x6) (x7) (x8) (x9) (x10) (x11) (x12) = let y = w2 x1 x2 in w11 y x3 x4 x5 x6 x7 x8 x9 x10 x11 x12

  dp : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dp (k) (x1) (x2) (x3) (x4) (x5) (x6) (x7) (x8) (x9) (x10) (x11) (x12) =
    if k == 1 then w1 x1
    else if k == 2 then w2 x1 x2
    else if k == 3 then w3 x1 x2 x3
    else if k == 4 then w4 x1 x2 x3 x4
    else if k == 5 then w5 x1 x2 x3 x4 x5
    else if k == 6 then w6 x1 x2 x3 x4 x5 x6
    else if k == 7 then w7 x1 x2 x3 x4 x5 x6 x7
    else if k == 8 then w8 x1 x2 x3 x4 x5 x6 x7 x8
    else if k == 9 then w9 x1 x2 x3 x4 x5 x6 x7 x8 x9
    else if k == 10 then w10 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10
    else if k == 11 then w11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11
    else w12 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12

  dc : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  dc (k) (x1) (x2) (x3) (x4) (x5) (x6) (x7) (x8) (x9) (x10) (x11) (x12) =
    if k == 1 then w1 (x1 * 2 + 1)
    else if k == 2 then w2 (x1 * 2 + 1) (x2 * 2 + 2)
    else if k == 3 then w3 (x1 * 2 + 1) (x2 * 2 + 2) (x3 * 2 + 3)
    else if k == 4 then w4 (x1 * 2 + 1) (x2 * 2 + 2) (x3 * 2 + 3) (x4 * 2 + 4)
    else if k == 5 then w5 (x1 * 2 + 1) (x2 * 2 + 2) (x3 * 2 + 3) (x4 * 2 + 4) (x5 * 2 + 5)
    else if k == 6 then w6 (x1 * 2 + 1) (x2 * 2 + 2) (x3 * 2 + 3) (x4 * 2 + 4) (x5 * 2 + 5) (x6 * 2 + 6)
    else if k == 7 then w7 (x1 * 2 + 1) (x2 * 2 + 2) (x3 * 2 + 3) (x4 * 2 + 4) (x5 * 2 + 5) (x6 * 2 + 6) (x7 * 2 + 7)
    else if k == 8 then w8 (x1 * 2 + 1) (x2 * 2 + 2) (x3 * 2 + 3) (x4 * 2 + 4) (x5 * 2 + 5) (x6 * 2 + 6) (x7 * 2 + 7) (x8 * 2 + 8)
    else if k == 9 then w9 (x1 * 2 + 1) (x2 * 2 + 2) (x3 * 2 + 3) (x4 * 2 + 4) (x5 * 2 + 5) (x6 * 2 + 6) (x7 * 2 + 7) (x8 * 2 + 8) (x9 * 2 + 9)
    else if k == 10 then w10 (x1 * 2 + 1) (x2 * 2 + 2) (x3 * 2 + 3) (x4 * 2 + 4) (x5 * 2 + 5) (x6 * 2 + 6) (x7 * 2 + 7) (x8 * 2 + 8) (x9 * 2 + 9) (x10 * 2 + 10)
    else if k == 11 then w11 (x1 * 2 + 1) (x2 * 2 + 2) (x3 * 2 + 3) (x4 * 2 + 4) (x5 * 2 + 5) (x6 * 2 + 6) (x7 * 2 + 7) (x8 * 2 + 8) (x9 * 2 + 9) (x10 * 2 + 10) (x11 * 2 + 11)
    else w12 (x1 * 2 + 1) (x2 * 2 + 2) (x3 * 2 + 3) (x4 * 2 + 4) (x5 * 2 + 5) (x6 * 2 + 6) (x7 * 2 + 7) (x8 * 2 + 8) (x9 * 2 + 9) (x10 * 2 + 10) (x11 * 2 + 11) (x12 * 2 + 12)

  cp : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  cp (k) (x1) (x2) (x3) (x4) (x5) (x6) (x7) (x8) (x9) (x10) (x11) (x12) =
    if k == 1 then via1 w1 x1
    else if k == 2 then via2 w2 x1 x2
    else if k == 3 then via3 w3 x1 x2 x3
    else if k == 4 then via4 w4 x1 x2 x3 x4
    else if k == 5 then via5 w5 x1 x2 x3 x4 x5
    else if k == 6 then via6 w6 x1 x2 x3 x4 x5 x6
    else if k == 7 then via7 w7 x1 x2 x3 x4 x5 x6 x7
    else if k == 8 then via8 w8 x1 x2 x3 x4 x5 x6 x7 x8
    else if k == 9 then via9 w9 x1 x2 x3 x4 x5 x6 x7 x8 x9
    else if k == 10 then via10 w10 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10
    else if k == 11 then via11 w11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11
    else via12 w12 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12

  cc : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  cc (k) (x1) (x2) (x3) (x4) (x5) (x6) (x7) (x8) (x9) (x10) (x11) (x12) =
    if k == 1 then viac1 w1 x1
    else if k == 2 then viac2 w2 x1 x2
    else if k == 3 then viac3 w3 x1 x2 x3
    else if k == 4 then viac4 w4 x1 x2 x3 x4
    else if k == 5 then viac5 w5 x1 x2 x3 x4 x5
    else if k == 6 then viac6 w6 x1 x2 x3 x4 x5 x6
    else if k == 7 then viac7 w7 x1 x2 x3 x4 x5 x6 x7
    else if k == 8 then viac8 w8 x1 x2 x3 x4 x5 x6 x7 x8
    else if k == 9 then viac9 w9 x1 x2 x3 x4 x5 x6 x7 x8 x9
    else if k == 10 then viac10 w10 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10
    else if k == 11 then viac11 w11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11
    else viac12 w12 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12

  tp : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  tp (k) (x1) (x2) (x3) (x4) (x5) (x6) (x7) (x8) (x9) (x10) (x11) (x12) =
    if k == 1 then t1 3
    else if k == 2 then t2 3 x1
    else if k == 3 then t3 3 x1 x2
    else if k == 4 then t4 3 x1 x2 x3
    else if k == 5 then t5 3 x1 x2 x3 x4
    else if k == 6 then t6 3 x1 x2 x3 x4 x5
    else if k == 7 then t7 3 x1 x2 x3 x4 x5 x6
    else if k == 8 then t8 3 x1 x2 x3 x4 x5 x6 x7
    else if k == 9 then t9 3 x1 x2 x3 x4 x5 x6 x7 x8
    else if k == 10 then t10 3 x1 x2 x3 x4 x5 x6 x7 x8 x9
    else if k == 11 then t11 3 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10
    else t12 3 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11

  tc : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  tc (k) (x1) (x2) (x3) (x4) (x5) (x6) (x7) (x8) (x9) (x10) (x11) (x12) =
    if k == 1 then tc1 3
    else if k == 2 then tc2 3 x1
    else if k == 3 then tc3 3 x1 x2
    else if k == 4 then tc4 3 x1 x2 x3
    else if k == 5 then tc5 3 x1 x2 x3 x4
    else if k == 6 then tc6 3 x1 x2 x3 x4 x5
    else if k == 7 then tc7 3 x1 x2 x3 x4 x5 x6
    else if k == 8 then tc8 3 x1 x2 x3 x4 x5 x6 x7
    else if k == 9 then tc9 3 x1 x2 x3 x4 x5 x6 x7 x8
    else if k == 10 then tc10 3 x1 x2 x3 x4 x5 x6 x7 x8 x9
    else if k == 11 then tc11 3 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10
    else tc12 3 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11

  mx : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  mx (k) (x1) (x2) (x3) (x4) (x5) (x6) (x7) (x8) (x9) (x10) (x11) (x12) =
    if k == 2 then w2 (w2 x1 x2) x3
    else if k == 3 then w3 x1 (w2 x2 x3) (w2 x4 x5)
    else if k == 4 then w4 (w3 x1 x2 x3) x4 (w2 x5 x6) 9
    else if k == 5 then w5 x1 x2 (w2 x3 x4) x5 (w2 x6 x7)
    else if k == 6 then w6 (w2 x1 x2) x3 (w2 x4 x5) x6 (x7 + 1) (w2 x8 x9)
    else if k == 8 then via2 w2 x1 x2
    else w7 (w2 x1 x2) x3 (w2 x4 x5) x6 x7 x8 (x9 + 1)

