  via1 : (Integer -> Integer), Integer -> Integer
  via1 (f) (x1) = f x1

  viac1 : (Integer -> Integer), Integer -> Integer
  viac1 (f) (x1) = f (x1 * 2 + 1)

  via2 : (Integer, Integer -> Integer), Integer, Integer -> Integer
