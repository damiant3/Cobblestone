  t1 : Integer -> Integer
  t1 (n) = if n == 0 then 99 else t1 (n - 1)

  tc1 : Integer -> Integer
  tc1 (n) = if n == 0 then 77 else tc1 (n * 2 - n - 1)

  t2 : Integer, Integer -> Integer
  t2 (n) (x1) = if n == 0 then w1 x1 else t2 (n - 1) x1

  tc2 : Integer, Integer -> Integer
  tc2 (n) (x1) = if n == 0 then w1 x1 else tc2 (n - 1) (x1 + 1)

  t3 : Integer, Integer, Integer -> Integer
  t3 (n) (x1) (x2) = if n == 0 then w2 x1 x2 else t3 (n - 1) x2 x1

  tc3 : Integer, Integer, Integer -> Integer
  tc3 (n) (x1) (x2) = if n == 0 then w2 x1 x2 else tc3 (n - 1) (x2 + 2) (x1 + 1)

  t4 : Integer, Integer, Integer, Integer -> Integer
