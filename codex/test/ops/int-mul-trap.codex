Chapter: IntMulTrap

Section: Operands

  big : Integer
  big = 1000000000000000000

Section: Ops

  times-ten : Integer -> Integer
  times-ten (a) = a * 10

Section: Report

  opening : [Console] Nothing
  opening = act
    print-line-uni "alive"
    print-line-uni ("must-not-print " & show (times-ten big))
  end
