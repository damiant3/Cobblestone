Chapter: LirBitopsShadow

Section: A definition named for a builtin

  bit-xor : Integer, Integer -> Integer
  bit-xor (a) (b) =
    if b <= 0 then a
    else bit-xor (a + 1) (b - 1)

  lbs-fold : Integer, Integer, Integer -> Integer
  lbs-fold (i) (n) (acc) =
    if i >= n then acc
    else lbs-fold (i + 1) n (bit-xor acc i)

Section: Entry

  opening : [Console] Nothing =
    act
      print-line-uni ("fold: " & show (lbs-fold 0 10 0))
      print-line-uni ("direct: " & show (bit-xor 6 3))
    end
