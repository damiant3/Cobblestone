Chapter: Saturated Call Returning Function

  add3 : Integer, Integer, Integer -> Integer
  add3 (a) (b) (c) = a + b + c

  mk : Integer -> (Integer, Integer -> Integer)
  mk (n) = if n == 0 then add3 6 else add3 5

  mk2 : Integer, Integer -> (Integer, Integer -> Integer)
  mk2 (x) (y) = if x == 0 then add3 (x + y + 1) else add3 (x + y)

  rec-fn : Integer -> (Integer, Integer -> Integer)
  rec-fn (n) = if n == 0 then add3 5 else rec-fn (n - 1)

  odd-fn : Integer -> (Integer, Integer -> Integer)
  odd-fn (n) = even-fn n

  even-fn : Integer -> (Integer, Integer -> Integer)
  even-fn (n) = if n == 0 then add3 5 else odd-fn (n - 1)

  opening : [Console] Nothing = act
   let a = mk 4
   in let a2 = a 20
   in print-line-uni ("one-at-a-time: " & show (a2 22))
   let e = mk 4
   in print-line-uni ("rest-at-once: " & show ((e 20) 22))
   print-line-uni ("flat: " & show (((mk 4) 20) 22))
   let z = mk 0
   in let z2 = z 20
   in print-line-uni ("other-branch: " & show (z2 22))
   let m = mk2 1 2
   in let m2 = m 20
   in print-line-uni ("arity-two: " & show (m2 22))
   let q = mk2 4 5
   in let q2 = q 20
   in print-line-uni ("arity-two-b: " & show (q2 22))
   let j = add3 5
   in let g = j 20
   in print-line-uni ("still-partial: " & show (g 22))
   let c = rec-fn 4
   in let c2 = c 20
   in print-line-uni ("self-recursive: " & show (c2 22))
   let d = even-fn 4
   in let d2 = d 20
   in print-line-uni ("mutual: " & show (d2 22))
  end
