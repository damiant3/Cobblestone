Chapter: Tier Zero Cyrillic Print Without Newline

  show-run : Integer, Integer, Text -> Text
  show-run (i) (stop) (acc) =
   if i > stop then acc
   else show-run (i + 1) stop (acc & char-to-text (code-to-char i))

  opening : [Console] Nothing = act
   print-uni ("cyrillic-113-127: " & show-run 113 127 "")
   print-uni (" | accented-97-104: " & show-run 97 104 "")
   print-line-uni " | end"
  end
