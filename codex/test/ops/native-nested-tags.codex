Chapter: NativeNestedTags

Section: Types

  Atom =
   | Yes
   | No
   | Both (Atom) (Atom)

Section: Functions

  nested-tag : Atom -> Integer
  nested-tag (value) =
   when value
    is Both (Yes) (No) -> 1
    is Both (No) (Yes) -> 2
    is otherwise -> 3

Section: Entry

  opening : [Console] Nothing = act
   print-line-uni (show (nested-tag (Both Yes No)))
   print-line-uni (show (nested-tag (Both No Yes)))
   print-line-uni (show (nested-tag (Both Yes Yes)))
   print-line-uni (show (nested-tag (Both No No)))
   print-line-uni (show (nested-tag Yes))
  end
