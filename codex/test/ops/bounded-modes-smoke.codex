Chapter: Bounded Modes Smoke

Section: Types

  WrapU8 = record {
   v : Integer between 0 and 255 wrapping
  }

  WrapI8 = record {
   v : Integer between -128 and 127 wrapping
  }

  ClampU8 = record {
   v : Integer between 0 and 100 clamping
  }

  ClampI8 = record {
   v : Integer between -50 and 50 clamping
  }

  ClampU32 = record {
   v : Integer between 0 and 4294967295 clamping
  }

  ClampBig = record {
   v : Integer between 0 and 10000000000 clamping
  }

Section: Definitions

  wu8 : Integer -> Integer
  wu8 (n) = (WrapU8 { v = n }).v

  wi8 : Integer -> Integer
  wi8 (n) = (WrapI8 { v = n }).v

  cu8 : Integer -> Integer
  cu8 (n) = (ClampU8 { v = n }).v

  ci8 : Integer -> Integer
  ci8 (n) = (ClampI8 { v = n }).v

  cu32 : Integer -> Integer
  cu32 (n) = (ClampU32 { v = n }).v

  cbig : Integer -> Integer
  cbig (n) = (ClampBig { v = n }).v

  wrap-add : Integer, Integer -> Integer
  wrap-add (a) (b) = wu8 (wu8 a + wu8 b)

  opening : [Console] Nothing = act
   print-line-uni ("wu8 300: " & show (wu8 300))
   print-line-uni ("wu8 -1: " & show (wu8 (-1)))
   print-line-uni ("wu8 255: " & show (wu8 255))
   print-line-uni ("wu8 256: " & show (wu8 256))
   print-line-uni ("wu8 512: " & show (wu8 512))
   print-line-uni ("wu8 100: " & show (wu8 100))
   print-line-uni ("wi8 128: " & show (wi8 128))
   print-line-uni ("wi8 -129: " & show (wi8 (-129)))
   print-line-uni ("wi8 130: " & show (wi8 130))
   print-line-uni ("wi8 -1: " & show (wi8 (-1)))
   print-line-uni ("cu8 150: " & show (cu8 150))
   print-line-uni ("cu8 -5: " & show (cu8 (-5)))
   print-line-uni ("cu8 100: " & show (cu8 100))
   print-line-uni ("cu8 0: " & show (cu8 0))
   print-line-uni ("ci8 99: " & show (ci8 99))
   print-line-uni ("ci8 -99: " & show (ci8 (-99)))
   print-line-uni ("ci8 0: " & show (ci8 0))
   print-line-uni ("wrap-add 200 100: " & show (wrap-add 200 100))
   print-line-uni ("cu32 4294967301: " & show (cu32 4294967301))
   print-line-uni ("cu32 -1: " & show (cu32 (-1)))
   print-line-uni ("cu32 4294967295: " & show (cu32 4294967295))
   print-line-uni ("cbig 20000000000: " & show (cbig 20000000000))
   print-line-uni ("cbig -5: " & show (cbig (-5)))
   print-line-uni ("cbig 10000000000: " & show (cbig 10000000000))
  end

