Chapter: UnitShow
  cites Foreword chapter Console

Section: Types

  Name = unit Text
  Flag = unit Boolean
  Dist = unit Real
  Count = unit Integer

Section: Operands

  plain-text : Text
  plain-text = "abcd"

  plain-bool : Boolean
  plain-bool = True

  plain-real : Real
  plain-real = 2.5

  plain-int : Integer
  plain-int = 42

  unit-text : Name
  unit-text = Name "abcd"

  unit-bool : Flag
  unit-bool = Flag True

  unit-real : Dist
  unit-real = Dist 2.5

  unit-int : Count
  unit-int = Count 42

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("text-plain=" & show plain-text)
    print-line-uni ("text-unit =" & show unit-text)
    print-line-uni ("bool-plain=" & show plain-bool)
    print-line-uni ("bool-unit =" & show unit-bool)
    print-line-uni ("real-plain=" & show plain-real)
    print-line-uni ("real-unit =" & show unit-real)
    print-line-uni ("int-plain =" & show plain-int)
    print-line-uni ("int-unit  =" & show unit-int)
  end
