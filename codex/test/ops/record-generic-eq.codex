Chapter: RecordGenericEq
  cites Foreword chapter Hamt

 Every row builds its two sides as SEPARATE allocations, so a pointer compare
 would answer False on the equal rows.

  Box a = record { item : a, tag : Integer }

  Pair a = record { left : Box a, right : List a }

  yn : Boolean -> Text
  yn (b) = if b then "True" else "False"

  box-text : Text -> Box Text
  box-text (s) = Box { item = s, tag = 1 }

  box-int : Integer -> Box Integer
  box-int (n) = Box { item = n, tag = 2 }

  pair-of : Integer, Integer -> Pair Integer
  pair-of (a) (b) = Pair { left = box-int a, right = [a, b] }

  map-of : Integer -> HamtMap Integer
  map-of (n) = hamt-set (hamt-set hamt-empty "a" 1) "b" n

  opening : [Console] Nothing = act
   print-line-uni ("box text equal=" & yn (box-text (integer-to-text 12) == box-text (integer-to-text 12)))
   print-line-uni ("box text differs=" & yn (box-text "x" == box-text "y"))
   print-line-uni ("box int equal=" & yn (box-int 7 == box-int 7))
   print-line-uni ("box int differs=" & yn (box-int 7 == box-int 8))
   print-line-uni ("box not-equal=" & yn (box-int 7 /= box-int 8))
   print-line-uni ("nested equal=" & yn (pair-of 3 4 == pair-of 3 4))
   print-line-uni ("nested differs=" & yn (pair-of 3 4 == pair-of 3 5))
   print-line-uni ("hamt equal=" & yn (map-of 2 == map-of 2))
   print-line-uni ("hamt differs=" & yn (map-of 2 == map-of 3))
  end
