Chapter: NativeNestedPattern

Section: Types

  Tree =
   | Leaf (Integer)
   | Join (Tree) (Tree)
   | Tip

  Packed =
   | Pack (Integer between 0 and 255) (Tree) (Boolean) (Integer between -128 and 127)
   | Blank

  Box (a) =
   | Wrapped (a)

Section: Functions

  boxed-text : Box Text -> Integer
  boxed-text (value) =
   when value
    is Wrapped ("hi") -> 1
    is otherwise -> 2

  siblings : Tree -> Integer
  siblings (v) =
   when v
    is Join (Leaf (a)) (Leaf (0)) when 100 / a > 0 -> a * 1000
    is Join (Leaf (a)) (Leaf (b)) -> a * 100 + b
    is otherwise -> 0 - 1

  wide : Tree -> Integer
  wide (v) =
   when v
    is Join (Join (Leaf (a)) (Leaf (b))) (Join (Leaf (c)) (Leaf (d))) -> a * 1000 + b * 100 + c * 10 + d
    is otherwise -> 0 - 1

  packed : Packed -> Integer
  packed (v) =
   when v
    is Pack (first) (Join (Leaf (a)) (Leaf (b))) (True) (last) -> first + a * 1000 + b * 10 + last
    is Pack (first) (Leaf (x)) (flag) (last) -> if flag then x + first + last else 0 - x
    is otherwise -> 0 - 1

  scope : Tree -> Integer
  scope (v) =
   let n = 99
   in let result = when v
    is Join (Leaf (n)) (Leaf (m)) -> n + m
    is otherwise -> 0
   in n + result

Section: Entry

  opening : [Console] Nothing = act
   print-line-uni (show (siblings (Join (Leaf 3) (Leaf 0))))
   print-line-uni (show (siblings (Join (Leaf 3) (Leaf 4))))
   print-line-uni (show (siblings (Join Tip (Leaf 0))))
   print-line-uni (show (siblings (Join (Leaf 0) Tip)))
   print-line-uni (show (siblings (Join (Leaf 0) (Leaf 1))))
   print-line-uni (show (siblings (Join (Leaf (0 - 7)) (Leaf 0))))
   print-line-uni (show (wide (Join (Join (Leaf 1) (Leaf 2)) (Join (Leaf 3) (Leaf 4)))))
   print-line-uni (show (wide (Join (Join (Leaf 1) Tip) (Join (Leaf 3) (Leaf 4)))))
   print-line-uni (show (wide (Join (Join (Leaf 1) (Leaf 2)) (Join (Leaf 3) Tip))))
   print-line-uni (show (packed (Pack 7 (Join (Leaf 2) (Leaf 4)) True (0 - 5))))
   print-line-uni (show (packed (Pack 7 (Join (Leaf 2) (Leaf 4)) False (0 - 5))))
   print-line-uni (show (packed (Pack 7 (Leaf 9) False (0 - 5))))
   print-line-uni (show (packed (Pack 7 (Leaf 9) True (0 - 5))))
   print-line-uni (show (packed Blank))
   print-line-uni (show (scope (Join (Leaf 2) (Leaf 3))))
   print-line-uni (show (boxed-text (Wrapped "hi")))
   print-line-uni (show (boxed-text (Wrapped "bye")))
  end
