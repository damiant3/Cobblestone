Chapter: RealLiteralRounding

  cites Foreword chapter Console

Section: Report

  chk : Text, Integer, Integer -> Text
  chk (name) (written) (computed) =
    name & " " & (if written == computed
      then "PASS"
      else "BAD written " & show written & " computed " & show computed)

  opening : [Console] Nothing
  opening = act
    print-line-uni ("2.9000001 " & show (real-to-bits 2.9000001))
    print-line-uni ("3.141592654 " & show (real-to-bits 3.141592654))
    print-line-uni ("6.283185307 " & show (real-to-bits 6.283185307))
    print-line-uni ("1.570796327 " & show (real-to-bits 1.570796327))
    print-line-uni ("0.707 " & show (real-to-bits 0.707))
    print-line-uni ("1.047 " & show (real-to-bits 1.047))
    print-line-uni ("2.22 " & show (real-to-bits 2.22))
    print-line-uni ("0.17 " & show (real-to-bits 0.17))
    print-line-uni ("1.333 " & show (real-to-bits 1.333))
    print-line-uni ("1.5 " & show (real-to-bits 1.5))
    print-line-uni ("0.5 " & show (real-to-bits 0.5))
    print-line-uni ("0.25 " & show (real-to-bits 0.25))
    print-line-uni ("11.700000000000001 " & show (real-to-bits 11.700000000000001))
    print-line-uni ("5.8500000000000005 " & show (real-to-bits 5.8500000000000005))
    print-line-uni ("97.59752277630605 " & show (real-to-bits 97.59752277630605))
    print-line-uni ("966.3754346193477 " & show (real-to-bits 966.3754346193477))
    print-line-uni ("0.1 " & show (real-to-bits 0.1))
    print-line-uni ("1.7976931348623157 " & show (real-to-bits 1.7976931348623157))
    print-line-uni ("123456789012345678.0 " & show (real-to-bits 123456789012345678.0))
    print-line-uni ("1.123456789012345678 " & show (real-to-bits 1.123456789012345678))
    print-line-uni ("9007199254740993.0 " & show (real-to-bits 9007199254740993.0))
    print-line-uni ("4503599627370497.5 " & show (real-to-bits 4503599627370497.5))
    print-line-uni ("0.00000000000000000001 " & show (real-to-bits 0.00000000000000000001))
    print-line-uni ("3.141592653589793 " & show (real-to-bits 3.141592653589793))
    print-line-uni ("2.718281828459045 " & show (real-to-bits 2.718281828459045))
    print-line-uni ("-11.700000000000001 " & show (real-to-bits -11.700000000000001))
    print-line-uni ("0.3333333333333333 " & show (real-to-bits 0.3333333333333333))
    print-line-uni ("1.0000000000000002 " & show (real-to-bits 1.0000000000000002))
    print-line-uni ("runtime 11.700000000000001 " & show (text-to-double-bits "11.700000000000001"))
    print-line-uni ("runtime 0.00000000000000000001 " & show (text-to-double-bits "0.00000000000000000001"))
    print-line-uni ("runtime -0.0 " & show (text-to-double-bits "-0.0"))
    print-line-uni ("runtime empty " & show (text-to-double-bits ""))
    print-line-uni (chk "11.7  = 4.5*1.3*2.0" (real-to-bits 11.700000000000001) (real-to-bits (4.5 * 1.3 * 2.0)))
    print-line-uni (chk "5.85  = 4.5*1.3    " (real-to-bits 5.8500000000000005) (real-to-bits (4.5 * 1.3)))
  end
