Chapter: ListIndexBounds
  cites Foreword chapter Console

Section: Report

  walk-at : List Integer, Integer, Integer, Text -> Text
  walk-at (xs) (i) (n) (acc) =
    if i >= n then acc
    else walk-at xs (i + 1) n (acc & " " & show (list-at xs i))

  read-all : List Integer -> Text
  read-all (xs) = walk-at xs 0 (list-length xs) ""

  set-walk : List Integer, Integer, Integer -> List Integer
  set-walk (xs) (i) (n) =
    if i >= n then xs
    else set-walk (list-set-at xs i (i * 10)) (i + 1) n

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni ("read:" & read-all [1, 2, 3, 4])
    print-line-uni ("last=" & show (list-at [1, 2, 3, 4] 3))
    print-line-uni ("set:" & read-all (set-walk [1, 2, 3, 4] 0 4))
    print-line-uni ("ins-front:" & read-all (list-insert-at [1, 2, 3] 0 99))
    print-line-uni ("ins-mid:" & read-all (list-insert-at [1, 2, 3] 1 99))
    print-line-uni ("ins-end:" & read-all (list-insert-at [1, 2, 3] 3 99))
  end

