Chapter: RealModeShow

Section: Entry

  opening : [Console] Nothing
  opening = act
    print-line-uni ("plain:      " & show 2.5)
    print-line-uni ("approx:     " & show (to-real-approx 2.5))
    print-line-uni ("trapping:   " & show (to-real-trapping 2.5))
    print-line-uni ("saturating: " & show (to-real-saturating 2.5))
    print-line-uni ("trap-neg:   " & show (to-real-trapping (0.0 - 2.5)))
    print-line-uni ("sat-neg:    " & show (to-real-saturating (0.0 - 2.5)))
  end
