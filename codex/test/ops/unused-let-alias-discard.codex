Chapter: Unused Let Alias Discard
  cites Foreword chapter Console

Section: Functions

  reads-in-body : Integer -> Integer
  reads-in-body (n) =
   let xs = [10, 20, 30]
   in let unused = xs
   in list-at xs 0 + list-at xs 1 + list-at xs 2

  reads-in-sibling : Integer -> Integer
  reads-in-sibling (n) =
   let xs = [40, 50]
   in let a = xs
   in let unused = xs
   in list-at a 1

  reads-in-tail : List Integer, Integer -> Integer
  reads-in-tail (xs) (n) =
   if n <= 0 then list-at xs 0
   else let unused = xs
   in reads-in-tail xs (n - 1)

Section: Entry

  opening : [Console] Nothing = act
   print-line-uni ("reads-in-body: " & show (reads-in-body 0))
   print-line-uni ("reads-in-sibling: " & show (reads-in-sibling 0))
   print-line-uni ("reads-in-tail: " & show (reads-in-tail [23] 10000))
  end
