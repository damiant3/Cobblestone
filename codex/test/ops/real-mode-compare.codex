Chapter: RealModeCompare

Section: Operands

  neg-big : Real
  neg-big = 0.0 - 2.9

  neg-small : Real
  neg-small = 0.0 - 1.5

  pos-small : Real
  pos-small = 1.5

Section: The Two Paths

  b2i : Boolean -> Integer
  b2i (b) = if b then 1 else 0

  plain-fused : Real, Real -> Integer
  plain-fused (a) (b) = if a < b then 1 else 0

  plain-val : Real, Real -> Integer
  plain-val (a) (b) = b2i (a < b)

  trap-fused : Real trapping, Real trapping -> Integer
  trap-fused (a) (b) = if a < b then 1 else 0

  trap-val : Real trapping, Real trapping -> Integer
  trap-val (a) (b) = b2i (a < b)

  trap-ge-fused : Real trapping, Real trapping -> Integer
  trap-ge-fused (a) (b) = if a >= b then 1 else 0

  sat-fused : Real saturating, Real saturating -> Integer
  sat-fused (a) (b) = if a < b then 1 else 0

  sat-val : Real saturating, Real saturating -> Integer
  sat-val (a) (b) = b2i (a < b)

  approx-fused : Real approximate, Real approximate -> Integer
  approx-fused (a) (b) = if a < b then 1 else 0

  approx-val : Real approximate, Real approximate -> Integer
  approx-val (a) (b) = b2i (a < b)

Section: Entry

  opening : [Console] Nothing
  opening = act
    print-line-uni ("plain  neg lt neg want 11: " & show (plain-fused neg-big neg-small) & show (plain-val neg-big neg-small))
    print-line-uni ("trap   neg lt neg want 11: " & show (trap-fused (to-real-trapping neg-big) (to-real-trapping neg-small)) & show (trap-val (to-real-trapping neg-big) (to-real-trapping neg-small)))
    print-line-uni ("sat    neg lt neg want 11: " & show (sat-fused (to-real-saturating neg-big) (to-real-saturating neg-small)) & show (sat-val (to-real-saturating neg-big) (to-real-saturating neg-small)))
    print-line-uni ("approx neg lt neg want 11: " & show (approx-fused (to-real-approx neg-big) (to-real-approx neg-small)) & show (approx-val (to-real-approx neg-big) (to-real-approx neg-small)))
    print-line-uni ("trap   neg ge neg want 00: " & show (trap-ge-fused (to-real-trapping neg-big) (to-real-trapping neg-small)) & show (trap-ge-fused (to-real-trapping neg-big) (to-real-trapping neg-small)))
    print-line-uni ("trap   neg lt pos want 11: " & show (trap-fused (to-real-trapping neg-big) (to-real-trapping pos-small)) & show (trap-val (to-real-trapping neg-big) (to-real-trapping pos-small)))
    print-line-uni ("sat    neg lt pos want 11: " & show (sat-fused (to-real-saturating neg-big) (to-real-saturating pos-small)) & show (sat-val (to-real-saturating neg-big) (to-real-saturating pos-small)))
  end
