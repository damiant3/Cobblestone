Chapter: Stack Args Eighteen
  cites Foreword chapter Console

  weigh : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Integer
  weigh (a1) (a2) (a3) (a4) (a5) (a6) (a7) (a8) (a9) (a10) (a11) (a12) (a13) (a14) (a15) (a16) (a17) (a18) =
    a1 * 1 + a2 * 2 + a3 * 3 + a4 * 4 + a5 * 5 + a6 * 6 + a7 * 7 + a8 * 8 + a9 * 9 + a10 * 10 + a11 * 11 + a12 * 12 + a13 * 13 + a14 * 14 + a15 * 15 + a16 * 16 + a17 * 17 + a18 * 18

  bump : Integer -> Integer
  bump (x) = x + 1

  opening : [Console] Nothing =
    let keep = bump 41
    in let keep2 = bump 99
    in let r = weigh (bump 1) (bump 2) (bump 3) (bump 4) (bump 5) (bump 6) (bump 7) (bump 8) (bump 9) (bump 10) (bump 11) (bump 12) (bump 13) (bump 14) (bump 15) (bump 16) (bump 17) (bump 18)
    in act
      print-line-uni ("weigh " & show r)
      print-line-uni ("caller locals " & show keep & " " & show keep2)
    end

