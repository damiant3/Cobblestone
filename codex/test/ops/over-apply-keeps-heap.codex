Chapter: Over Apply Keeps Heap
  cites Foreword chapter Console

  add3 : Integer, Integer, Integer -> Integer
  add3 (a) (b) (c) = a + b + c

  mk3 : Integer, Integer, Integer -> (Integer, Integer -> Integer)
  mk3 (x) (y) (z) = add3 (x + y + z)

  opening : [Console] Nothing = act
   let k = mk3 1
   in let h0 = __heap-save
   in let c = (k 2 3) 20
   in let h1 = __heap-save
   in let k3 = k 2 3 20
   in let h2 = __heap-save
   in print-line-uni ("flattened over-apply keeps the heap: " & show (h1 >= h0))
   print-line-uni ("over-apply keeps the heap: " & show (h2 >= h1))
   print-line-uni ("results: " & show (c 22) & " " & show (k3 22))
  end

