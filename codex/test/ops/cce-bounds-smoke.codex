Chapter: Cce Bounds Smoke
  cites Foreword chapter CCE

 The CCE band-edge axis. Every character predicate is a band test over a
 frequency-ordered numbering that shares no boundary with ASCII, so the
 cells that catch a wrong band are the edges. A letter is two bands with
 the punctuation between them (13..38 lowercase, 39..64 uppercase, 65..96
 punctuation, 97..112 accented Latin, 113..127 Cyrillic), and the obvious
 widening, one band to 127, calls every punctuation character a letter;
 the cells at 64/65 and 96/97 are what refuse it.

 Case conversion is deliberately decoupled from the widened predicates:
 the plus and minus 26 is arithmetic between the two ASCII bands, so
 to-upper must be the identity on punctuation and on the 31 non-ASCII
 letters, whose uppercase is a Tier 1 code point and does not fit a Char.

 The Unicode cells pin the tier arithmetic as measured: the em-dash HAS a
 code point (41464, three bytes) and round-trips, a carriage return is
 refused, the ASCII digits map contiguously (48..57 lands on 3..12) while
 the letters map by frequency (a lands on 15, e on 13), which is why
 digit arithmetic on CCE codes is legal and letter arithmetic never is.

 Whitespace is the band 1..2 and NUL is below it. That cell was the CCE
 oracle's G1 and was left out of this bundle while it was open; it is ruled
 and pinned now. The classify ladder is pinned beside it because it spells
 the same bands a second time and would otherwise drift away from the
 predicates, which is the whole defect this file exists to catch.

Section: Cells

  cbs-letter : Integer -> Text
  cbs-letter (n) = if is-letter (code-to-char n) then "T" else "F"

  cbs-lower : Integer -> Text
  cbs-lower (n) = if is-lower (code-to-char n) then "T" else "F"

  cbs-upper : Integer -> Text
  cbs-upper (n) = if is-upper (code-to-char n) then "T" else "F"

  cbs-digit : Integer -> Text
  cbs-digit (n) = if is-digit (code-to-char n) then "T" else "F"

  cbs-punct : Integer -> Text
  cbs-punct (n) = if is-punct (code-to-char n) then "T" else "F"

  cbs-ws : Integer -> Text
  cbs-ws (n) = if is-whitespace (code-to-char n) then "T" else "F"

  cbs-class : Integer -> Text
  cbs-class (n) = when classify (code-to-char n)
   is Whitespace -> "W"
   is Digit -> "D"
   is Lower -> "l"
   is Upper -> "U"
   is Punct -> "P"
   is Accented -> "A"
   is Cyrillic -> "C"
   is Other -> "O"

  cbs-up-code : Integer -> Integer
  cbs-up-code (n) = char-code (to-upper (code-to-char n))

  cbs-low-code : Integer -> Integer
  cbs-low-code (n) = char-code (to-lower (code-to-char n))

Section: Entry

  opening : [Console] Nothing = act
   print-line-uni ("letter-lo 2,12,13,38,39,64: " & cbs-letter 2 & cbs-letter 12 & cbs-letter 13 & cbs-letter 38 & cbs-letter 39 & cbs-letter 64)
   print-line-uni ("letter-hi 65,96,97,112,113,127: " & cbs-letter 65 & cbs-letter 96 & cbs-letter 97 & cbs-letter 112 & cbs-letter 113 & cbs-letter 127)
   print-line-uni ("lower 13,38,39,96,97,127: " & cbs-lower 13 & cbs-lower 38 & cbs-lower 39 & cbs-lower 96 & cbs-lower 97 & cbs-lower 127)
   print-line-uni ("upper 38,39,64,65: " & cbs-upper 38 & cbs-upper 39 & cbs-upper 64 & cbs-upper 65)
   print-line-uni ("digit 2,3,12,13: " & cbs-digit 2 & cbs-digit 3 & cbs-digit 12 & cbs-digit 13)
   print-line-uni ("punct 64,65,96,97: " & cbs-punct 64 & cbs-punct 65 & cbs-punct 96 & cbs-punct 97)
   print-line-uni ("ws 0,1,2,3: " & cbs-ws 0 & cbs-ws 1 & cbs-ws 2 & cbs-ws 3)
   print-line-uni ("class 0,1,2,3: " & cbs-class 0 & cbs-class 1 & cbs-class 2 & cbs-class 3)
   print-line-uni ("class 12,13,38,39,64,65: " & cbs-class 12 & cbs-class 13 & cbs-class 38 & cbs-class 39 & cbs-class 64 & cbs-class 65)
   print-line-uni ("class 96,97,112,113,127: " & cbs-class 96 & cbs-class 97 & cbs-class 112 & cbs-class 113 & cbs-class 127)
   print-line-uni ("dv 3,12: " & show (digit-value (code-to-char 3)) & show (digit-value (code-to-char 12)))
   print-line-uni ("up 13,38: " & show (cbs-up-code 13) & " " & show (cbs-up-code 38))
   print-line-uni ("up-id 65,96,97,127: " & show (cbs-up-code 65) & " " & show (cbs-up-code 96) & " " & show (cbs-up-code 97) & " " & show (cbs-up-code 127))
   print-line-uni ("low 39,64: " & show (cbs-low-code 39) & " " & show (cbs-low-code 64))
   print-line-uni ("low-id 13,65,97: " & show (cbs-low-code 13) & " " & show (cbs-low-code 65) & " " & show (cbs-low-code 97))
   print-line-uni ("fu 8212: " & show (from-unicode 8212))
   print-line-uni ("fu 8211: " & show (from-unicode 8211))
   print-line-uni ("fu 13: " & show (from-unicode 13))
   print-line-uni ("tu 41464: " & show (to-unicode 41464))
   print-line-uni ("el 41464: " & show (cce-encode-length 41464))
   print-line-uni ("fu 32: " & show (from-unicode 32))
   print-line-uni ("fu 48,57: " & show (from-unicode 48) & " " & show (from-unicode 57))
   print-line-uni ("fu 97,101: " & show (from-unicode 97) & " " & show (from-unicode 101))
  end

