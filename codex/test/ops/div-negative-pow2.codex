Chapter: DivNegativePow2

 Integer division truncates toward zero. The power-of-two strength
 reduction must answer what `idiv` answers, and for a negative dividend a
 bare arithmetic shift does not: `sar` rounds toward negative infinity,
 so -7 / 2 comes back -4 where truncation gives -3.

Section: Division

  d2 : Integer -> Integer
  d2 (a) = a / 2

  d3 : Integer -> Integer
  d3 (a) = a / 3

  d4 : Integer -> Integer
  d4 (a) = a / 4

  d5 : Integer -> Integer
  d5 (a) = a / 5

  d8 : Integer -> Integer
  d8 (a) = a / 8

Section: Remainder

  m2 : Integer -> Integer
  m2 (a) = int-mod a 2

  m3 : Integer -> Integer
  m3 (a) = int-mod a 3

Section: Report

  opening : [Console] Nothing
  opening = act
   print-line-uni ("-7 / 2 = " & show (d2 (0 - 7)))
   print-line-uni ("-7 / 3 = " & show (d3 (0 - 7)))
   print-line-uni ("-13 / 4 = " & show (d4 (0 - 13)))
   print-line-uni ("-13 / 5 = " & show (d5 (0 - 13)))
   print-line-uni ("-1 / 2 = " & show (d2 (0 - 1)))
   print-line-uni ("-1 / 8 = " & show (d8 (0 - 1)))
   print-line-uni ("-8 / 8 = " & show (d8 (0 - 8)))
   print-line-uni ("-9 / 8 = " & show (d8 (0 - 9)))
   print-line-uni ("7 / 2 = " & show (d2 7))
   print-line-uni ("13 / 4 = " & show (d4 13))
   print-line-uni ("-7 mod 2 = " & show (m2 (0 - 7)))
   print-line-uni ("-7 mod 3 = " & show (m3 (0 - 7)))
  end
