Chapter: IntWrappingSpelling

Section: Operands

  top : Integer
  top = 9223372036854775807

  bottom : Integer
  bottom = -9223372036854775808

  bump : Integer wrapping, Integer -> Integer
  bump (a) (b) = a + b

  drop : Integer wrapping -> Integer
  drop (a) = a - 1

  scale : Integer wrapping, Integer -> Integer
  scale (a) (b) = a * b

  plain-sub : Integer, Integer -> Integer
  plain-sub (a) (b) = a - b

Section: Entry

  opening : [Console] Nothing
  opening = act
    print-line-uni ("literal  want -9223372036854775808: " & integer-to-text bottom)
    print-line-uni ("literal  want -9223372036854775808: " & integer-to-text (-9223372036854775808))
    print-line-uni ("literal  want 9223372036854775807: " & integer-to-text (plain-sub top 0))
    print-line-uni ("bare-add want -9223372036854775808: " & integer-to-text (bump top 1))
    print-line-uni ("bare-sub want 9223372036854775807: " & integer-to-text (drop bottom))
    print-line-uni ("bare-mul want -2446744073709551616: " & integer-to-text (scale 4000000000 4000000000))
    print-line-uni ("small    want 42: " & integer-to-text (bump 40 2))
  end
