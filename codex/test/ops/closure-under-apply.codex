Chapter: Closure Under Apply

  add3 : Integer, Integer, Integer -> Integer
  add3 (a) (b) (c) = a + b + c

  add4 : Integer, Integer, Integer, Integer -> Integer
  add4 (a) (b) (c) (d) = a + b + c + d

  opening : [Console] Nothing = act
   print-line-uni ("full: " & show (add3 1 2 3))
   let h = add3 10
   in print-line-uni ("flat-two: " & show ((h 20) 12))
   let j = add3 10
   in let g = j 20
   in print-line-uni ("split-one-at-a-time: " & show (g 12))
   let k = add4 1
   in let k2 = k 2
   in let k3 = k2 3
   in print-line-uni ("split-four: " & show (k3 4))
   let m = add4 1 2
   in let m2 = m 3
   in print-line-uni ("half-then-one: " & show (m2 4))
  end