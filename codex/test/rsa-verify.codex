Section: The Public Exponent

 65537, big-endian, as it appears in every certificate worth reading.

  r-exp : List Integer = [1, 0, 1]

Section: Cases

  ok-case : Boolean = rsa-verify-pkcs1-sha256 r-mod r-exp r-msg r-sig

  bad-sig : List Integer = list-set-at (rsa-copy r-sig) 200 (bit-xor (list-at r-sig 200) 1)
  bad-case : Boolean = rsa-verify-pkcs1-sha256 r-mod r-exp r-msg bad-sig

  other-msg : List Integer = list-set-at (rsa-copy r-msg) 0 (bit-xor (list-at r-msg 0) 1)
  wrong-msg-case : Boolean = rsa-verify-pkcs1-sha256 r-mod r-exp other-msg r-sig

  short-sig : List Integer = rsa-take r-sig 255 0 []
  short-case : Boolean = rsa-verify-pkcs1-sha256 r-mod r-exp r-msg short-sig

Section: Helpers

  rsa-copy : List Integer -> List Integer
  rsa-copy (bs) = rsa-take bs (list-length bs) 0 []

  rsa-take : List Integer, Integer, Integer, List Integer -> List Integer
  rsa-take (bs) (n) (i) (acc) =
    if i >= n then acc
    else rsa-take bs n (i + 1) (list-push acc (list-at bs i))

Section: Body

  opening : [Console] Nothing = act
    print-line-uni ("openssl signature verifies = " & show ok-case)
    print-line-uni ("one bit flipped in signature = " & show bad-case)
    print-line-uni ("signature against another message = " & show wrong-msg-case)
    print-line-uni ("truncated signature = " & show short-case)
  end

