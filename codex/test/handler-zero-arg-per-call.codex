Chapter: HandlerZeroArgPerCall
  cites Foreword chapter Console

Section: Effects

  effect Dev where
    dinit : [Dev] Integer
    dsync : [Dev] Nothing
    dput : Integer -> [Dev] Integer

Section: Body

  twice : Integer -> [Dev] Integer
  twice (n) = act
    a <- dinit
    b <- dinit
    a + b + n
  end

  none : Integer -> [Dev] Integer
  none (n) = n + 1

  run : Integer, Integer -> [Console] Integer
  run (which) (n) = act
    with Dev (if which == 0 then twice n else none n)
      dinit (resume) = act
        print-line-uni "clause dinit"
        resume 10
      end
      dsync (resume) = print-line-uni "clause dsync"
      dput (v) (resume) = resume (v * 2)
  end

  opening : [Console] Nothing = act
    print-line-uni ("twice " & show (run 0 5))
    print-line-uni ("none " & show (run 1 5))
  end
