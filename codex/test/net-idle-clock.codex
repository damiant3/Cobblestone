Chapter: NetIdleClockTest
  cites Net chapter NetIdle

Section: Entry
  opening : [Console] Nothing = act
    print-line-uni ("countdown off " & show (ni-countdown 0 7) & " stopped " & show (ni-countdown (0 - 1) 7) & " fired " & show (ni-countdown 5 5) & " " & show (ni-countdown 5 9) & " left " & show (ni-countdown 12 5))
    clock <- NetIdleClock { epoch = 1000, base-tick = 40, period = 250, rx = [] }
    print-line-uni ("target before epoch " & show (ni-target clock 900) & " at epoch " & show (ni-target clock 1000) & " within a period " & show (ni-target clock 1249) & " three periods " & show (ni-target clock 1750))
  end
