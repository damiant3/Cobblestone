Chapter: DeskMenuSearchTest
  cites Works chapter GopPrograms
  cites UI chapter Widget
  cites Works chapter GopAhci

Section: Main

  dms-labels : List Integer, Integer, Text -> Text
  dms-labels (ms) (i) (acc) =
    if i >= list-length ms then acc
    else dms-labels ms (i + 1) (acc & (if i == 0 then "" else ",") & (gpr-at (list-at ms i)).ge-label)

  dms-keys : Integer, List Integer, Integer -> Integer
  dms-keys (ps) (scs) (i) =
    if i >= list-length scs then 0
    else let k = gpr-key ps (list-at scs i)
    in dms-keys ps scs (i + 1)

  dms-line : Integer, Text -> Text
  dms-line (ps) (label) =
    label & ": query [" & gpr-query ps & "] matches [" & dms-labels (gpr-matches ps) 0 "" & "] sel " & (gpr-at (gpr-sel ps)).ge-label

  dms-has : Integer, Text -> Text
  dms-has (ps) (id) = when widget-find (gpr-menu-tree ps False) id
    is Just (n) -> "yes"
    is None -> "no"

  opening : [Console] Nothing =
    let ps = alloc-zeroed 64 64
    in let e = gpr-ensure ps
    in let a = dms-keys ps [46, 30, 38] 0
    in let l1 = dms-line ps "cal"
    in let t1 = "tree: head " & dms-has ps "gpr-q" & ", Calendar row " & dms-has ps "gpr-Calendar" & ", Clock row " & dms-has ps "gpr-Clock" & ", group row " & dms-has ps "gprg-Accessories"
    in let enter1 = gpr-key ps 28
    in let b = dms-keys ps [80, 80] 0
    in let l2 = dms-line ps "down down"
    in let c = dms-keys ps [72] 0
    in let l3 = dms-line ps "up"
    in let d = dms-keys ps [14, 14, 14] 0
    in let l4 = dms-line ps "three backspaces"
    in let t2 = "tree after: head " & dms-has ps "gpr-q" & ", group row " & dms-has ps "gprg-Accessories"
    in let f = dms-keys ps [31, 18, 20] 0
    in let l5 = dms-line ps "set"
    in let g = dms-keys ps [14, 14, 14, 44, 44, 44] 0
    in let l6 = dms-line ps "zzz"
    in let enter2 = gpr-key ps 28
    in let h = dms-keys ps [16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16] 0
    in let cap = "45 more keys: length " & show (gpr-q-len ps)
    in let r = gpr-ensure ps
    in let reopen = "reopened: length " & show (gpr-q-len ps)
    in act
      print-line-uni l1
      print-line-uni t1
      print-line-uni ("enter answers " & show enter1)
      print-line-uni l2
      print-line-uni l3
      print-line-uni l4
      print-line-uni t2
      print-line-uni l5
      print-line-uni l6
      print-line-uni ("enter with no match answers " & show enter2)
      print-line-uni cap
      print-line-uni reopen
    end
