 Wycheproof's result for X25519 is the shared secret it expects; an all-zero expected secret is the low-order
 case, which this verifier answers with no secret at all.

  wy-x-ok : List Integer, List Integer -> Boolean
  wy-x-ok (got) (want) = if wy-all-zero want 0 then list-length got == 0 else got == want

  wy-all-zero : List Integer, Integer -> Boolean
  wy-all-zero (bs) (i) = if i >= list-length bs then True else if list-at bs i /= 0 then False else wy-all-zero bs (i + 1)
Section: Body

  wy-got : Integer -> Boolean
  wy-got (i) = wy-x-ok (x25519-shared-secret (list-at wy-a i) (list-at wy-b i)) (list-at wy-c i)

  wy-run : Integer, Integer, Integer, Integer, Integer, Integer -> [Console] Nothing
  wy-run (i) (good) (bad) (acc-yes) (acc-no) (wrong) =
    if i >= list-length wy-ids then act
      print-line-uni ("valid accepted = " & show good)
      print-line-uni ("invalid refused = " & show bad)
      print-line-uni ("acceptable accepted = " & show acc-yes & ", refused = " & show acc-no)
      print-line-uni ("disagreements = " & show wrong)
    end
    else let got = wy-got i
    in let want = list-at wy-want i
    in if want == 2 then wy-run (i + 1) good bad (if got then acc-yes + 1 else acc-yes) (if got then acc-no else acc-no + 1) wrong
    else if (if want == 1 then got else got == False) then wy-run (i + 1) (if got then good + 1 else good) (if got then bad else bad + 1) acc-yes acc-no wrong
    else act
      print-line-uni ("DISAGREE tcId " & show (list-at wy-ids i) & ": wycheproof " & (if want == 1 then "valid" else "invalid") & ", verifier " & show got)
      wy-run (i + 1) good bad acc-yes acc-no (wrong + 1)
    end

  opening : [Console] Nothing = act
    print-line-uni ("cases = " & show (list-length wy-ids))
    wy-run 0 0 0 0 0 0
  end

