Chapter: C5IntField

  cites Codex chapter Lists

  cites Codex chapter Text



Section: Types

  Box = record {

   xs : List Integer

  }



Section: Defs

  make-box : Box = Box { xs = [1, 2, 3] }



  take-2 : Integer, List Integer -> Integer

  take-2 (a) (q) = a + list-length q



Section: Callers

  bad : Integer

  bad =

   let b = make-box

   in take-2 0 (b.xs)



Section: Entry

  opening : [Console] Nothing = act

   print-line-uni "C5:start"

   let a = bad

   in act

    print-line-uni ("C5:bad=" & integer-to-text a)

    print-line-uni "C5:done"

   end

  end



