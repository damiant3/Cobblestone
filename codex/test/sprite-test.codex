Chapter: SpriteTest
  cites Codex chapter General
  cites Game chapter Sprite
  cites Game chapter Rasterizer
  cites Game chapter Color
  cites Game chapter Bresenham
  cites Math chapter Geometry
  cites Math chapter Quaternion

Section: Body

  test-sprite : Text =
    let spr = sprite-set (sprite-set (sprite-new 4 4 0) 1 1 255) 2 2 128
    in "pixels=" & show (sprite-pixel-count spr) & " get=" & show (sprite-get spr 1 1) & " count-0=" & show (sprite-count-color spr 0)

  test-blit : Text =
    let fb = fb-new 8 8 0
    in let spr = sprite-new 3 3 99
    in let fb2 = sprite-blit fb spr 2 2
    in "blit=" & show (fb-count-color fb2 99)

  test-key-blit : Text =
    let fb = fb-new 8 8 0
    in let spr = sprite-set (sprite-new 3 3 0) 1 1 42
    in let fb2 = sprite-blit-keyed fb spr 0 0 0
    in "keyed=" & show (fb-count-color fb2 42)

  test-flip : Text =
    let spr = sprite-set (sprite-new 3 3 0) 0 0 1
    in let flipped = sprite-flip-h spr
    in "orig=" & show (sprite-get spr 0 0) & " flip=" & show (sprite-get flipped 2 0)

  test-anim : Text =
    let f1 = anim-frame 100 (sprite-new 2 2 1)
    in let f2 = anim-frame 100 (sprite-new 2 2 2)
    in let anim = anim-new [f1, f2] True
    in let a1 = anim-tick anim 50
    in let a2 = anim-tick a1 60
    in let s1 = sprite-get (anim-current-sprite a1) 0 0
    in let s2 = sprite-get (anim-current-sprite a2) 0 0
    in "frame0=" & show s1 & " frame1=" & show s2

  test-extract : Text =
    let sheet = sprite-set (sprite-set (sprite-new 8 8 0) 4 0 77) 5 1 88
    in let frame = sprite-sheet-frame sheet 4 0 4 4
    in "extract=" & show (sprite-get frame 0 0) & "," & show (sprite-get frame 1 1)

  opening : [Console] Nothing = act
    print-line-uni test-sprite
    print-line-uni test-blit
    print-line-uni test-key-blit
    print-line-uni test-flip
    print-line-uni test-anim
    print-line-uni test-extract
  end

