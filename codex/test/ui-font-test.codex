Chapter: UiFontTest
  cites Codex chapter General
  cites UI chapter Font
  cites Game chapter Rasterizer
  cites Game chapter Color
  cites Game chapter Bresenham
  cites Math chapter Geometry
  cites Math chapter Quaternion

Section: Body

  test-font-info : Text =
    format-font font-5x7

  test-text-width : Text =
    let w = font-text-width font-5x7 "Hello"
    in "w=" & show w

  test-text-height : Text =
    "h=" & show (font-text-height font-5x7)

  test-glyph-count : Text =
    "glyphs=" & show (font-5x7.bf-count)

  test-char-width : Text =
    "cw=" & show (font-char-width font-5x7)

  test-glyph-a : Text =
    let g = font-glyph font-5x7 13
    in let p0 = list-at (g.gl-pixels) 0
    in let p6 = list-at (g.gl-pixels) 6
    in let p11 = list-at (g.gl-pixels) 11
    in "a: row0col0=" & show p0 & " row1col1=" & show p6 & " row2col1=" & show p11

  test-glyph-e : Text =
    let g = font-glyph font-5x7 17
    in let p6 = list-at (g.gl-pixels) 6
    in let p15 = list-at (g.gl-pixels) 15
    in "e: row1col1=" & show p6 & " row3full=" & show p15

  test-glyph-A : Text =
    let g = font-glyph font-5x7 39
    in let p1 = list-at (g.gl-pixels) 1
    in let p5 = list-at (g.gl-pixels) 5
    in "A: row0col1=" & show p1 & " row1col0=" & show p5

  test-draw-text : Text =
    let fb = fb-new 48 8 0
    in let fb2 = font-draw-text fb font-5x7 "hi" 0 0 255 0
    in let has-pixel = fb-get fb2 0 0
    in "rendered=" & show has-pixel

  opening : [Console] Nothing = act
    print-line-uni test-font-info
    print-line-uni test-text-width
    print-line-uni test-text-height
    print-line-uni test-glyph-count
    print-line-uni test-char-width
    print-line-uni test-glyph-a
    print-line-uni test-glyph-e
    print-line-uni test-glyph-A
    print-line-uni test-draw-text
  end

