Chapter: NetSendRawLength

 The NE2000 transmit buffer is card pages 64 to 69, 1536 bytes; the receive
 ring starts at page 70.

Section: Entry

  opening : [Console, Network] Nothing = act
    let buf = alloc-bytes 2048
    in act
      print-line-uni ("control " & show (net-send-raw buf 60))
      print-line-uni ("max " & show (net-send-raw buf 1536))
      print-line-uni ("zero " & show (net-send-raw buf 0))
      print-line-uni ("over " & show (net-send-raw buf 1537))
      print-line-uni ("negative " & show (net-send-raw buf (0 - 1)))
    end
  end
