Chapter: SessionTwoChannels
  cites Foreword chapter Console

Section: Body

  opening : [Console, Concurrent] Nothing = act
    c0 <- s-new
    c1 <- s-send c0 7
    v <- s-recv-value c1
    c2 <- s-recv c1
    cl <- s-close c2
    print-line-uni ("first: " & show v & " closed: " & show cl)
    d0 <- s-new
    e0 <- s-new
    d1 <- s-send d0 9
    e1 <- s-send e0 11
    w <- s-recv-value d1
    x <- s-recv-value e1
    d2 <- s-recv d1
    e2 <- s-recv e1
    dl <- s-close d2
    el <- s-close e2
    print-line-uni ("second: " & show w & " third: " & show x & " closed: " & show (dl + el))
  end