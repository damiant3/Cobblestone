Chapter: Esp32C6Board
  cites Foreword chapter Board
  cites Foreword chapter Units (Duration, Frequency)

 Board support for ESP32-C6 (RISC-V RV32IMC @ 160 MHz).
 Register addresses from the ESP32-C6 Technical Reference Manual.
 SRAM at 0x40800000, peripherals at 0x60000000+.

 GPIO, UART, SPI, and I2C drivers using MMIO primitives from the
 Board HAL. ESP32-C6 uses IO_MUX for pin function selection,
 a command-based I2C controller, and SPI with USR-triggered transfers.

 Every function here that touches a register declares [Device.Mmio].
 The row is what makes the access visible to the effect system, to the
 capability manifest, and to the boot grant. A driver that reads or
 writes hardware while typed pure is a driver the machine cannot see.

 What stays pure is worth as much as what does not: esp32c6-delay-loops
 spins on the CPU and touches nothing, so it is pure, and the type says
 so. The row separates the functions that reach the bus from the
 functions that do not.

Section: Core Addresses

  esp32c6-sram-base : Integer = #40800000
  esp32c6-sram-size : Integer = #80000
  esp32c6-periph-base : Integer = #60000000

Section: GPIO Matrix

  esp32c6-gpio-base : Integer = #60091000
  esp32c6-gpio-out-reg : Integer = #60091004
  esp32c6-gpio-out-set-reg : Integer = #60091008
  esp32c6-gpio-out-clr-reg : Integer = #6009100C
  esp32c6-gpio-enable-reg : Integer = #60091020
  esp32c6-gpio-enable-set-reg : Integer = #60091024
  esp32c6-gpio-enable-clr-reg : Integer = #60091028
  esp32c6-gpio-in-reg : Integer = #6009103C
  esp32c6-gpio-func-out-sel-base : Integer = #60091554

  esp32c6-io-mux-base : Integer = #60090000

Section: GPIO Driver

  esp32c6-gpio-set-output : Integer -> [Device.Mmio] Integer
  esp32c6-gpio-set-output (pin) =
   let io-mux = esp32c6-io-mux-base + pin * 4
   in act
    enable <- mmio-read-32 esp32c6-gpio-enable-reg
    w1 <- mmio-write-32 esp32c6-gpio-enable-reg (bit-or enable (bit-shl 1 pin))
    mux-val <- (mmio-read-32 io-mux)
    mmio-write-32 io-mux (bit-or (bit-and mux-val #FFFFFFF8) 1)
   end

  esp32c6-gpio-set-input : Integer -> [Device.Mmio] Integer
  esp32c6-gpio-set-input (pin) =
   let io-mux = esp32c6-io-mux-base + pin * 4
   in act
    enable <- mmio-read-32 esp32c6-gpio-enable-reg
    w1 <- mmio-write-32 esp32c6-gpio-enable-reg (bit-and enable (bit-xor (bit-shl 1 pin) (0 - 1)))
    mux-val <- (mmio-read-32 io-mux)
    mmio-write-32 io-mux (bit-or (bit-and mux-val #FFFFFFF8) 1)
   end

  esp32c6-gpio-set : Integer -> [Device.Mmio] Integer
  esp32c6-gpio-set (pin) =
   mmio-write-32 esp32c6-gpio-out-set-reg (bit-shl 1 pin)

  esp32c6-gpio-clear : Integer -> [Device.Mmio] Integer
  esp32c6-gpio-clear (pin) =
   mmio-write-32 esp32c6-gpio-out-clr-reg (bit-shl 1 pin)

  esp32c6-gpio-read : Integer -> [Device.Mmio] Integer
  esp32c6-gpio-read (pin) = act
   in-val <- (mmio-read-32 esp32c6-gpio-in-reg)
   bit-and (bit-shru in-val pin) 1
  end

  esp32c6-gpio-toggle : Integer -> [Device.Mmio] Integer
  esp32c6-gpio-toggle (pin) = act
   out <- mmio-read-32 esp32c6-gpio-out-reg
   if bit-and (bit-shru out pin) 1 == 1 then esp32c6-gpio-clear pin
      else esp32c6-gpio-set pin
  end

  esp32c6-gpio-set-pull : Integer, Integer -> [Device.Mmio] Integer
  esp32c6-gpio-set-pull (pin) (pull) =
   let io-mux = esp32c6-io-mux-base + pin * 4
   in let pull-bits = if pull == 1 then #100
        else if pull == 2 then #80
        else 0
   in act
    val <- (mmio-read-32 io-mux)
    mmio-write-32 io-mux (bit-or (bit-and val (bit-xor #180 (0 - 1))) pull-bits)
   end

Section: UART Registers

  esp32c6-uart0-base : Integer = #60000000
  esp32c6-uart1-base : Integer = #60001000
  esp32c6-uart-fifo-off : Integer = #00
  esp32c6-uart-clkdiv-off : Integer = #14
  esp32c6-uart-status-off : Integer = #1C
  esp32c6-uart-conf0-off : Integer = #20

  esp32c6-uart-txfifo-cnt-mask : Integer = #3F
  esp32c6-uart-rxfifo-cnt-mask : Integer = #3F
  esp32c6-uart-fifo-size : Integer = 128

Section: UART Driver

 UART0 at 0x60000000. TX FIFO count in STATUS_REG bits [5:0].
 RX FIFO count in STATUS_REG bits [19:14]. APB clock = 40 MHz.

  esp32c6-uart-init : Frequency -> [Device.Mmio] Integer
  esp32c6-uart-init (baud) =
   let base = esp32c6-uart0-base
   in let divisor = 40000000 / baud
   in act
    w-clkdiv <- mmio-write-32 (base + esp32c6-uart-clkdiv-off) divisor
    conf <- (mmio-read-32 (base + esp32c6-uart-conf0-off))
    mmio-write-32 (base + esp32c6-uart-conf0-off) (bit-or conf #1C)
   end

  esp32c6-uart-tx-ready : Integer -> [Device.Mmio] Boolean
  esp32c6-uart-tx-ready (uart-base) = act
   status <- (mmio-read-32 (uart-base + esp32c6-uart-status-off))
   bit-and status esp32c6-uart-txfifo-cnt-mask < esp32c6-uart-fifo-size
  end

  esp32c6-uart-rx-ready : Integer -> [Device.Mmio] Boolean
  esp32c6-uart-rx-ready (uart-base) = act
   status <- (mmio-read-32 (uart-base + esp32c6-uart-status-off))
   bit-and (bit-shru status 14) esp32c6-uart-rxfifo-cnt-mask > 0
  end

  esp32c6-uart-wait-tx : Integer, Integer -> [Device.Mmio] Integer
  esp32c6-uart-wait-tx (uart-base) (fuel) =
   if fuel <= 0 then 0
   else act
    ready <- esp32c6-uart-tx-ready uart-base
    if ready then 1
    else esp32c6-uart-wait-tx uart-base (fuel - 1)
   end

  esp32c6-uart-wait-rx : Integer, Integer -> [Device.Mmio] Integer
  esp32c6-uart-wait-rx (uart-base) (fuel) =
   if fuel <= 0 then 0
   else act
    ready <- esp32c6-uart-rx-ready uart-base
    if ready then 1
    else esp32c6-uart-wait-rx uart-base (fuel - 1)
   end

  esp32c6-uart-send-byte : Integer, Integer -> [Device.Mmio] Integer
  esp32c6-uart-send-byte (uart-base) (byte) = act
   w <- (esp32c6-uart-wait-tx uart-base 10000)
   mmio-write-8 (uart-base + esp32c6-uart-fifo-off) (bit-and byte #FF)
  end

 Reading the FIFO register is not a free observation: on real silicon it
 pops a byte off the receive queue. A timed-out receive must not touch
 it, so the read lives in its own function and is called only from the
 branch that wants it -- an act-block binding the read before testing the
 fuel result would quietly consume a byte on the timeout path.

  esp32c6-uart-read-fifo : Integer -> [Device.Mmio] Integer
  esp32c6-uart-read-fifo (uart-base) = act
   fifo <- (mmio-read-32 (uart-base + esp32c6-uart-fifo-off))
   bit-and fifo #FF
  end

  esp32c6-uart-recv-byte : Integer -> [Device.Mmio] Integer
  esp32c6-uart-recv-byte (uart-base) = act
   w <- esp32c6-uart-wait-rx uart-base 100000
   if w == 0 then 0 - 1
   else esp32c6-uart-read-fifo uart-base
  end

  esp32c6-uart-send-text : Integer, Text, Integer, Integer -> [Device.Mmio] Integer
  esp32c6-uart-send-text (uart-base) (s) (i) (len) =
   if i >= len then 0
   else act
    b <- (esp32c6-uart-send-byte uart-base (char-code (char-at s i)))
    esp32c6-uart-send-text uart-base s (i + 1) len
   end

  esp32c6-uart-print : Integer, Text -> [Device.Mmio] Integer
  esp32c6-uart-print (uart-base) (s) =
   esp32c6-uart-send-text uart-base s 0 (text-length s)

  esp32c6-uart-println : Integer, Text -> [Device.Mmio] Integer
  esp32c6-uart-println (uart-base) (s) = act
   p <- esp32c6-uart-print uart-base s
   cr <- (esp32c6-uart-send-byte uart-base 13)
   esp32c6-uart-send-byte uart-base 10
  end

Section: SPI Registers

  esp32c6-spi2-base : Integer = #60081000
  esp32c6-spi-cmd-off : Integer = #00
  esp32c6-spi-ctrl-off : Integer = #08
  esp32c6-spi-clock-off : Integer = #0C
  esp32c6-spi-user-off : Integer = #10
  esp32c6-spi-user1-off : Integer = #14
  esp32c6-spi-w0-off : Integer = #58
  esp32c6-spi-ms-dlen-off : Integer = #1C

  esp32c6-spi-cmd-usr : Integer = #1000000
  esp32c6-spi-user-doutdin : Integer = #01
  esp32c6-spi-user-usr-mosi : Integer = #8000000
  esp32c6-spi-user-usr-miso : Integer = #10000000

Section: SPI Driver

 SPI2 at 0x60081000. Command-based: write data to W0, set USR bit in
 CMD_REG to start, poll USR bit until it clears. Full-duplex via
 DOUTDIN mode. Clock divider set for APB/8 (~5 MHz from 40 MHz APB).

  esp32c6-spi-init : [Device.Mmio] Integer
  esp32c6-spi-init =
   let base = esp32c6-spi2-base
   in let user = bit-or (bit-or esp32c6-spi-user-doutdin esp32c6-spi-user-usr-mosi) esp32c6-spi-user-usr-miso
   in act
    w-clk <- mmio-write-32 (base + esp32c6-spi-clock-off) #70103
    w-user <- (mmio-write-32 (base + esp32c6-spi-user-off) user)
    mmio-write-32 (base + esp32c6-spi-ms-dlen-off) 7
   end

  esp32c6-spi-wait-done : Integer, Integer -> [Device.Mmio] Integer
  esp32c6-spi-wait-done (spi-base) (fuel) =
   if fuel <= 0 then 0
   else act
    cmd <- mmio-read-32 (spi-base + esp32c6-spi-cmd-off)
    if bit-and cmd esp32c6-spi-cmd-usr == 0 then 1
    else esp32c6-spi-wait-done spi-base (fuel - 1)
   end

  esp32c6-spi-transfer : Integer, Integer -> [Device.Mmio] Integer
  esp32c6-spi-transfer (spi-base) (byte) = act
   w-data <- mmio-write-32 (spi-base + esp32c6-spi-w0-off) (bit-and byte #FF)
   w-cmd <- mmio-write-32 (spi-base + esp32c6-spi-cmd-off) esp32c6-spi-cmd-usr
   done <- esp32c6-spi-wait-done spi-base 10000
   w0 <- (mmio-read-32 (spi-base + esp32c6-spi-w0-off))
   bit-and w0 #FF
  end

  esp32c6-spi-busy : Integer -> [Device.Mmio] Boolean
  esp32c6-spi-busy (spi-base) = act
   cmd <- (mmio-read-32 (spi-base + esp32c6-spi-cmd-off))
   bit-and cmd esp32c6-spi-cmd-usr > 0
  end

Section: I2C Registers

  esp32c6-i2c0-base : Integer = #60004000
  esp32c6-i2c-scl-low-off : Integer = #00
  esp32c6-i2c-ctr-off : Integer = #04
  esp32c6-i2c-sr-off : Integer = #08
  esp32c6-i2c-data-off : Integer = #1C
  esp32c6-i2c-cmd-off : Integer = #58
  esp32c6-i2c-scl-high-off : Integer = #38
  esp32c6-i2c-sda-hold-off : Integer = #30
  esp32c6-i2c-sda-sample-off : Integer = #34

  esp32c6-i2c-ctr-ms-mode : Integer = #10
  esp32c6-i2c-ctr-clk-en : Integer = #20
  esp32c6-i2c-ctr-conf-upgate : Integer = #08

  esp32c6-i2c-cmd-op-rstart : Integer = 0
  esp32c6-i2c-cmd-op-write : Integer = 1
  esp32c6-i2c-cmd-op-read : Integer = 2
  esp32c6-i2c-cmd-op-stop : Integer = 3

  esp32c6-i2c-sr-done : Integer = #80000

Section: I2C Driver

 I2C0 at 0x60004000. Command-based controller: load commands into
 COMD registers (opcode in bits [13:11], byte count in bits [7:0],
 ack-check in bit 8). Write address/data to FIFO, trigger via
 conf_upgate, poll status for completion. 100 kHz standard mode
 at 40 MHz APB: SCL_LOW = 200, SCL_HIGH = 200.

  esp32c6-i2c-init : [Device.Mmio] Integer
  esp32c6-i2c-init =
   let base = esp32c6-i2c0-base
   in act
    w-ctr <- mmio-write-32 (base + esp32c6-i2c-ctr-off) (bit-or esp32c6-i2c-ctr-ms-mode esp32c6-i2c-ctr-clk-en)
    w-scl-low <- mmio-write-32 (base + esp32c6-i2c-scl-low-off) 200
    w-scl-high <- mmio-write-32 (base + esp32c6-i2c-scl-high-off) 200
    w-sda-hold <- (mmio-write-32 (base + esp32c6-i2c-sda-hold-off) 40)
    mmio-write-32 (base + esp32c6-i2c-sda-sample-off) 40
   end

 The command word is bit packing over its arguments -- but the word
 lands in a COMD register, so the function reaches the bus and carries
 the row. Only the arithmetic above the store is pure.

  esp32c6-i2c-write-cmd : Integer, Integer, Integer, Integer, Integer -> [Device.Mmio] Integer
  esp32c6-i2c-write-cmd (i2c-base) (cmd-idx) (opcode) (byte-cnt) (ack-check) =
   let cmd-addr = i2c-base + esp32c6-i2c-cmd-off + cmd-idx * 4
   in let cmd-val = bit-or (bit-or (bit-shl opcode 11) byte-cnt) (bit-shl ack-check 8)
   in mmio-write-32 cmd-addr cmd-val

  esp32c6-i2c-wait-done : Integer, Integer -> [Device.Mmio] Integer
  esp32c6-i2c-wait-done (i2c-base) (fuel) =
   if fuel <= 0 then 0
   else act
    sr <- mmio-read-32 (i2c-base + esp32c6-i2c-sr-off)
    if bit-and sr esp32c6-i2c-sr-done > 0 then 1
    else esp32c6-i2c-wait-done i2c-base (fuel - 1)
   end

  esp32c6-i2c-trigger : Integer -> [Device.Mmio] Integer
  esp32c6-i2c-trigger (i2c-base) = act
   ctr <- (mmio-read-32 (i2c-base + esp32c6-i2c-ctr-off))
   mmio-write-32 (i2c-base + esp32c6-i2c-ctr-off) (bit-or ctr esp32c6-i2c-ctr-conf-upgate)
  end

  esp32c6-i2c-write-reg : Integer, Integer, Integer -> [Device.Mmio] Integer
  esp32c6-i2c-write-reg (dev-addr) (reg) (value) =
   let base = esp32c6-i2c0-base
   in act
    w-data0 <- mmio-write-8 (base + esp32c6-i2c-data-off) (bit-shl dev-addr 1)
    w-data1 <- mmio-write-8 (base + esp32c6-i2c-data-off) reg
    w-data2 <- mmio-write-8 (base + esp32c6-i2c-data-off) value
    cmd0 <- esp32c6-i2c-write-cmd base 0 esp32c6-i2c-cmd-op-rstart 0 0
    cmd1 <- esp32c6-i2c-write-cmd base 1 esp32c6-i2c-cmd-op-write 3 1
    cmd2 <- esp32c6-i2c-write-cmd base 2 esp32c6-i2c-cmd-op-stop 0 0
    trig <- (esp32c6-i2c-trigger base)
    esp32c6-i2c-wait-done base 100000
   end

  esp32c6-i2c-read-reg : Integer, Integer -> [Device.Mmio] Integer
  esp32c6-i2c-read-reg (dev-addr) (reg) =
   let base = esp32c6-i2c0-base
   in act
    w-addr <- mmio-write-8 (base + esp32c6-i2c-data-off) (bit-shl dev-addr 1)
    w-reg <- mmio-write-8 (base + esp32c6-i2c-data-off) reg
    cmd0 <- esp32c6-i2c-write-cmd base 0 esp32c6-i2c-cmd-op-rstart 0 0
    cmd1 <- esp32c6-i2c-write-cmd base 1 esp32c6-i2c-cmd-op-write 2 1
    cmd2 <- esp32c6-i2c-write-cmd base 2 esp32c6-i2c-cmd-op-rstart 0 0
    w-raddr <- mmio-write-8 (base + esp32c6-i2c-data-off) (bit-or (bit-shl dev-addr 1) 1)
    cmd3 <- esp32c6-i2c-write-cmd base 3 esp32c6-i2c-cmd-op-write 1 1
    cmd4 <- esp32c6-i2c-write-cmd base 4 esp32c6-i2c-cmd-op-read 1 0
    cmd5 <- esp32c6-i2c-write-cmd base 5 esp32c6-i2c-cmd-op-stop 0 0
    trig <- esp32c6-i2c-trigger base
    done <- esp32c6-i2c-wait-done base 100000
    d <- (mmio-read-32 (base + esp32c6-i2c-data-off))
    bit-and d #FF
   end

Section: Delay

 A busy-wait touches no register, so it is pure and says so.

  esp32c6-delay-loops : Integer, Integer -> Integer
  esp32c6-delay-loops (n) (i) =
   if i >= n then 0
   else esp32c6-delay-loops n (i + 1)

  esp32c6-delay-ms : Duration -> Integer
  esp32c6-delay-ms (ms) = esp32c6-delay-loops (ms * 160000) 0

Section: LED (DevKit: GPIO8 is the built-in LED)

  esp32c6-led-pin : Integer = 8

  esp32c6-led-init : [Device.Mmio] Integer
  esp32c6-led-init = esp32c6-gpio-set-output esp32c6-led-pin

  esp32c6-led-on : [Device.Mmio] Integer
  esp32c6-led-on = esp32c6-gpio-set esp32c6-led-pin

  esp32c6-led-off : [Device.Mmio] Integer
  esp32c6-led-off = esp32c6-gpio-clear esp32c6-led-pin

