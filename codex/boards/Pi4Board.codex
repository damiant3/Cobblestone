Chapter: Pi4Board
  cites Foreword chapter Board
  cites Foreword chapter Units (Duration, Frequency)

 Board support for Raspberry Pi 4 (BCM2711, ARM Cortex-A72 @ 1.5 GHz).
 Register addresses from the BCM2711 ARM Peripherals document.
 Peripheral base at 0xFE000000 (low-peripheral mode).
 GPIO memory-mapped, PL011 UART, SPI0, BSC I2C.

Section: Core Addresses

  pi4-periph-base : Integer = #FE000000
  pi4-ram-base : Integer = 0
  pi4-kernel-load : Integer = #80000

Section: GPIO Registers

  pi4-gpio-base : Integer = #FE200000
  pi4-gpio-fsel0 : Integer = #FE200000
  pi4-gpio-set0 : Integer = #FE20001C
  pi4-gpio-clr0 : Integer = #FE200028
  pi4-gpio-lev0 : Integer = #FE200034
  pi4-gpio-pup-pdn0 : Integer = #FE2000E4

Section: GPIO Driver

  pi4-gpio-set-output : Integer -> [Device.Mmio] Integer
  pi4-gpio-set-output (pin) =
   let reg = pi4-gpio-fsel0 + pin / 10 * 4
   in let shift = (int-mod pin 10) * 3
   in act
    fsel <- (mmio-read-32 reg)
    mmio-write-32 reg (bit-or (bit-and fsel (bit-xor (bit-shl 7 shift) (0 - 1))) (bit-shl 1 shift))
   end

  pi4-gpio-set-input : Integer -> [Device.Mmio] Integer
  pi4-gpio-set-input (pin) =
   let reg = pi4-gpio-fsel0 + pin / 10 * 4
   in let shift = (int-mod pin 10) * 3
   in act
    fsel <- (mmio-read-32 reg)
    mmio-write-32 reg (bit-and fsel (bit-xor (bit-shl 7 shift) (0 - 1)))
   end

  pi4-gpio-set-alternate : Integer, Integer -> [Device.Mmio] Integer
  pi4-gpio-set-alternate (pin) (af) =
   let fsel-val = if af == 0 then 4
                  else if af == 1 then 5
                  else if af == 2 then 6
                  else if af == 3 then 7
                  else if af == 4 then 3
                  else 2
   in let reg = pi4-gpio-fsel0 + pin / 10 * 4
   in let shift = (int-mod pin 10) * 3
   in act
    fsel <- (mmio-read-32 reg)
    mmio-write-32 reg (bit-or (bit-and fsel (bit-xor (bit-shl 7 shift) (0 - 1))) (bit-shl fsel-val shift))
   end

  pi4-gpio-set-pull : Integer, Integer -> [Device.Mmio] Integer
  pi4-gpio-set-pull (pin) (pull) =
   let reg = pi4-gpio-pup-pdn0 + pin / 16 * 4
   in let shift = (int-mod pin 16) * 2
   in act
    val <- (mmio-read-32 reg)
    mmio-write-32 reg (bit-or (bit-and val (bit-xor (bit-shl 3 shift) (0 - 1))) (bit-shl pull shift))
   end

  pi4-gpio-set : Integer -> [Device.Mmio] Integer
  pi4-gpio-set (pin) =
   let reg = pi4-gpio-set0 + pin / 32 * 4
   in mmio-write-32 reg (bit-shl 1 (int-mod pin 32))

  pi4-gpio-clear : Integer -> [Device.Mmio] Integer
  pi4-gpio-clear (pin) =
   let reg = pi4-gpio-clr0 + pin / 32 * 4
   in mmio-write-32 reg (bit-shl 1 (int-mod pin 32))

  pi4-gpio-read : Integer -> [Device.Mmio] Boolean
  pi4-gpio-read (pin) =
   let reg = pi4-gpio-lev0 + pin / 32 * 4
   in act
    val <- (mmio-read-32 reg)
    bit-and val (bit-shl 1 (int-mod pin 32)) /= 0
   end

  pi4-gpio-toggle : Integer -> [Device.Mmio] Integer
  pi4-gpio-toggle (pin) =
   let reg = pi4-gpio-lev0 + pin / 32 * 4
   in act
    val <- mmio-read-32 reg
    if bit-and val (bit-shl 1 (int-mod pin 32)) /= 0 then pi4-gpio-clear pin
    else pi4-gpio-set pin
   end

Section: GPIO Linear Handle

 The foreword Pin threaded onto the BCM2711 GPIO: open sets the pin's
 function, close returns it to input. The handle carries the GPIO base so
 close reaches the right FSEL register without the caller re-supplying
 it.

  pi4-gpio-config : Integer, PinMode -> [Device.Mmio] Integer
  pi4-gpio-config (pin) (mode) =
   when mode
    is PinOutput -> pi4-gpio-set-output pin
    is PinInput -> pi4-gpio-set-input pin
    is PinAlternate (af) -> pi4-gpio-set-alternate pin af
    is PinAnalog -> pi4-gpio-set-input pin

  pi4-gpio-open : linear Board, Integer, PinMode -> [Gpio, Device.Mmio] (linear Board, linear Pin)
  pi4-gpio-open (brd) (pin) (mode) =
   when brd
    is Board (pw) (sc) -> act
      m <- (pi4-gpio-config pin mode)
      (Board pw sc, Pin pi4-gpio-base pin)
    end

  pi4-pin-write : linear Pin, Boolean -> [Gpio, Device.Mmio] linear Pin
  pi4-pin-write (p) (high) =
   when p
    is Pin (base) (pin) -> act
      w <- (if high then pi4-gpio-set pin else pi4-gpio-clear pin)
      Pin base pin
    end

  pi4-pin-read : linear Pin -> [Gpio, Device.Mmio] (linear Pin, Boolean)
  pi4-pin-read (p) =
   when p
    is Pin (base) (pin) -> act
      v <- (pi4-gpio-read pin)
      (Pin base pin, v)
    end

  pi4-pin-close : linear Pin -> [Gpio, Device.Mmio] Integer
  pi4-pin-close (p) =
   when p
    is Pin (base) (pin) -> pi4-gpio-set-input pin

Section: UART Registers (PL011 UART0)

  pi4-uart0-base : Integer = #FE201000
  pi4-uart-dr : Integer = #FE201000
  pi4-uart-fr : Integer = #FE201018
  pi4-uart-ibrd : Integer = #FE201024
  pi4-uart-fbrd : Integer = #FE201028
  pi4-uart-lcrh : Integer = #FE20102C
  pi4-uart-cr : Integer = #FE201030

  pi4-uart-fr-txff : Integer = #20
  pi4-uart-fr-rxfe : Integer = #10
  pi4-uart-fr-busy : Integer = #08

  pi4-uart-cr-uarten : Integer = 1
  pi4-uart-cr-txe : Integer = #100
  pi4-uart-cr-rxe : Integer = #200

  pi4-uart-lcrh-fen : Integer = #10
  pi4-uart-lcrh-wlen8 : Integer = #60

Section: UART Driver

 PL011 UART0 on GPIO14 (TX, AF0) / GPIO15 (RX, AF0).
 UARTCLK = 48 MHz on Pi 4. Baud divisor = 48000000 / (16 * baud).
 For 115200: IBRD = 26, FBRD = 3.

  pi4-uart-init : Frequency -> [Device.Mmio] Integer
  pi4-uart-init (baud) =
   let ibrd = 48000000 / (16 * baud)
   in let fbrd-full = 48000000 - ibrd * 16 * baud
   in let fbrd = (fbrd-full * 64 + 16 * baud / 2) / (16 * baud)
   in act
    af-tx <- pi4-gpio-set-alternate 14 0
    af-rx <- pi4-gpio-set-alternate 15 0
    pull-rx <- pi4-gpio-set-pull 15 1
    disable <- mmio-write-32 pi4-uart-cr 0
    w-ibrd <- mmio-write-32 pi4-uart-ibrd ibrd
    w-fbrd <- mmio-write-32 pi4-uart-fbrd fbrd
    w-lcrh <- (mmio-write-32 pi4-uart-lcrh (bit-or pi4-uart-lcrh-fen pi4-uart-lcrh-wlen8))
    mmio-write-32 pi4-uart-cr (bit-or (bit-or pi4-uart-cr-uarten pi4-uart-cr-txe) pi4-uart-cr-rxe)
   end

  pi4-uart-tx-ready : [Device.Mmio] Boolean
  pi4-uart-tx-ready = act
   fr <- (mmio-read-32 pi4-uart-fr)
   bit-and fr pi4-uart-fr-txff == 0
  end

  pi4-uart-rx-ready : [Device.Mmio] Boolean
  pi4-uart-rx-ready = act
   fr <- (mmio-read-32 pi4-uart-fr)
   bit-and fr pi4-uart-fr-rxfe == 0
  end

  pi4-uart-wait-tx : Integer -> [Device.Mmio] Integer
  pi4-uart-wait-tx (fuel) =
   if fuel <= 0 then 0
   else act
    ready <- pi4-uart-tx-ready
    if ready then 1 else pi4-uart-wait-tx (fuel - 1)
   end

  pi4-uart-wait-rx : Integer -> [Device.Mmio] Integer
  pi4-uart-wait-rx (fuel) =
   if fuel <= 0 then 0
   else act
    ready <- pi4-uart-rx-ready
    if ready then 1 else pi4-uart-wait-rx (fuel - 1)
   end

  pi4-uart-send-byte : Integer -> [Device.Mmio] Integer
  pi4-uart-send-byte (byte) = act
   w <- (pi4-uart-wait-tx 10000)
   mmio-write-32 pi4-uart-dr (bit-and byte #FF)
  end

 Reading the data register is not a free observation: on real silicon it
 pops the receive FIFO. A timed-out receive must not touch it, so the
 read lives in its own function and is called only from the branch that
 wants it -- an act-block binding the read before testing the fuel result
 would quietly add a spurious read to the timeout path.

  pi4-uart-read-dr : [Device.Mmio] Integer
  pi4-uart-read-dr = act
   dr <- (mmio-read-32 pi4-uart-dr)
   bit-and dr #FF
  end

  pi4-uart-recv-byte : [Device.Mmio] Integer
  pi4-uart-recv-byte = act
   w <- pi4-uart-wait-rx 100000
   if w == 0 then 0 - 1 else pi4-uart-read-dr
  end

  pi4-uart-send-text : Text, Integer, Integer -> [Device.Mmio] Integer
  pi4-uart-send-text (s) (i) (len) =
   if i >= len then 0
   else act
    b <- (pi4-uart-send-byte (char-code (char-at s i)))
    pi4-uart-send-text s (i + 1) len
   end

  pi4-uart-print : Text -> [Device.Mmio] Integer
  pi4-uart-print (s) =
   pi4-uart-send-text s 0 (text-length s)

  pi4-uart-println : Text -> [Device.Mmio] Integer
  pi4-uart-println (s) = act
   p <- pi4-uart-print s
   cr <- (pi4-uart-send-byte 13)
   pi4-uart-send-byte 10
  end

Section: UART Linear Handle

 The foreword UartPort threaded onto PL011 UART0: open initialises the
 port, write sends one byte through the board's own TX-FIFO poll, close
 disables the UART. The board addresses UART0 directly, so the handle
 carries the base for the type's sake; close writes the fixed CR.

  pi4-uart-open : linear Board, Frequency -> [Uart, Device.Mmio] (linear Board, linear UartPort)
  pi4-uart-open (brd) (baud) =
   when brd
    is Board (pw) (sc) -> act
      i <- (pi4-uart-init baud)
      (Board pw sc, UartPort pi4-uart0-base)
    end

  pi4-uart-write : linear UartPort, Integer -> [Uart, Device.Mmio] linear UartPort
  pi4-uart-write (port) (byte) =
   when port
    is UartPort (b) -> act
      w <- pi4-uart-send-byte byte
      UartPort b
    end

  pi4-uart-recv-bytes : Integer, Integer, Integer, List Integer -> [Device.Mmio] List Integer
  pi4-uart-recv-bytes (b) (n) (i) (acc) =
   if i >= n then acc
   else act
    v <- (pi4-uart-recv-byte)
    pi4-uart-recv-bytes b n (i + 1) (list-push acc v)
   end

  pi4-uart-recv : linear UartPort, Integer -> [Uart, Device.Mmio] (linear UartPort, List Integer)
  pi4-uart-recv (port) (n) =
   when port
    is UartPort (b) -> act
      bytes <- (pi4-uart-recv-bytes b n 0 [])
      (UartPort b, bytes)
    end

  pi4-uart-close : linear UartPort -> [Uart, Device.Mmio] Integer
  pi4-uart-close (port) =
   when port
    is UartPort (b) -> mmio-write-32 pi4-uart-cr 0

Section: SPI Registers (SPI0)

  pi4-spi0-base : Integer = #FE204000
  pi4-spi-cs : Integer = #FE204000
  pi4-spi-fifo : Integer = #FE204004
  pi4-spi-clk : Integer = #FE204008
  pi4-spi-dlen : Integer = #FE20400C

  pi4-spi-cs-ta : Integer = #80
  pi4-spi-cs-done : Integer = #10000
  pi4-spi-cs-rxd : Integer = #20000
  pi4-spi-cs-txd : Integer = #40000
  pi4-spi-cs-clear-rx : Integer = #20
  pi4-spi-cs-clear-tx : Integer = #10

Section: SPI Driver

 SPI0 on GPIO8 (CE0, AF0) / GPIO9 (MISO, AF0) / GPIO10 (MOSI, AF0) /
 GPIO11 (SCLK, AF0). Master mode, clock divider sets SPI_CLK = core_clk / CDIV.

  pi4-spi-init : [Device.Mmio] Integer
  pi4-spi-init = act
   af-ce0 <- pi4-gpio-set-alternate 8 0
   af-miso <- pi4-gpio-set-alternate 9 0
   af-mosi <- pi4-gpio-set-alternate 10 0
   af-sclk <- pi4-gpio-set-alternate 11 0
   w-clk <- mmio-write-32 pi4-spi-clk 256
   clear <- (mmio-write-32 pi4-spi-cs (bit-or pi4-spi-cs-clear-rx pi4-spi-cs-clear-tx))
   0
  end

  pi4-spi-wait-txd : Integer -> [Device.Mmio] Integer
  pi4-spi-wait-txd (fuel) =
   if fuel <= 0 then 0
   else act
    cs <- mmio-read-32 pi4-spi-cs
    if bit-and cs pi4-spi-cs-txd > 0 then 1
    else pi4-spi-wait-txd (fuel - 1)
   end

  pi4-spi-wait-rxd : Integer -> [Device.Mmio] Integer
  pi4-spi-wait-rxd (fuel) =
   if fuel <= 0 then 0
   else act
    cs <- mmio-read-32 pi4-spi-cs
    if bit-and cs pi4-spi-cs-rxd > 0 then 1
    else pi4-spi-wait-rxd (fuel - 1)
   end

  pi4-spi-wait-done : Integer -> [Device.Mmio] Integer
  pi4-spi-wait-done (fuel) =
   if fuel <= 0 then 0
   else act
    cs <- mmio-read-32 pi4-spi-cs
    if bit-and cs pi4-spi-cs-done > 0 then 1
    else pi4-spi-wait-done (fuel - 1)
   end

  pi4-spi-transfer : Integer -> [Device.Mmio] Integer
  pi4-spi-transfer (byte) = act
   cs <- mmio-read-32 pi4-spi-cs
   start <- mmio-write-32 pi4-spi-cs (bit-or cs pi4-spi-cs-ta)
   wt <- pi4-spi-wait-txd 10000
   wr <- mmio-write-32 pi4-spi-fifo (bit-and byte #FF)
   wd <- pi4-spi-wait-done 10000
   fifo <- mmio-read-32 pi4-spi-fifo
   stop <- (mmio-write-32 pi4-spi-cs (bit-and cs (bit-xor pi4-spi-cs-ta (0 - 1))))
   bit-and fifo #FF
  end

  pi4-spi-busy : [Device.Mmio] Boolean
  pi4-spi-busy = act
   cs <- (mmio-read-32 pi4-spi-cs)
   bit-and cs pi4-spi-cs-ta > 0
  end

Section: Linear I2C Bus

  pi4-i2c-open : linear Board -> [I2c, Device.Mmio] (linear Board, linear I2cBus)
  pi4-i2c-open (brd) =
   when brd
    is Board (pw) (sc) -> act
      i <- (pi4-i2c-init)
      (Board pw sc, I2cBus pi4-bsc1-base)
    end

  pi4-i2c-bus-write-reg : linear I2cBus, Integer, Integer, Integer -> [I2c, Device.Mmio] (linear I2cBus, Integer)
  pi4-i2c-bus-write-reg (bus) (addr) (reg) (val) =
   when bus
    is I2cBus (b) -> act
      r <- (pi4-i2c-write-reg addr reg val)
      (I2cBus b, r)
    end

  pi4-i2c-bus-read-reg : linear I2cBus, Integer, Integer -> [I2c, Device.Mmio] (linear I2cBus, Integer)
  pi4-i2c-bus-read-reg (bus) (addr) (reg) =
   when bus
    is I2cBus (b) -> act
      v <- (pi4-i2c-read-reg addr reg)
      (I2cBus b, v)
    end

  pi4-i2c-close : linear I2cBus -> [I2c, Device.Mmio] Integer
  pi4-i2c-close (bus) =
   when bus
    is I2cBus (b) -> mmio-write-32 pi4-bsc-c 0

Section: Linear SPI Transaction

  pi4-spi-open : linear Board -> [Spi, Device.Mmio] (linear Board, linear SpiBus)
  pi4-spi-open (brd) =
   when brd
    is Board (pw) (sc) -> act
      i <- (pi4-spi-init)
      (Board pw sc, SpiBus pi4-spi0-base)
    end

  pi4-spi-select : linear SpiBus, Integer -> [Spi, Device.Mmio] linear SpiTxn
  pi4-spi-select (bus) (cs) =
   when bus
    is SpiBus (b) -> act
      w <- (pi4-gpio-clear cs)
      SpiTxn b cs
    end

  pi4-spi-transfer-bytes : Integer, List Integer, Integer, Integer, List Integer -> [Device.Mmio] List Integer
  pi4-spi-transfer-bytes (b) (out) (i) (len) (acc) =
   if i >= len then acc
   else act
    v <- (pi4-spi-transfer (list-at out i))
    pi4-spi-transfer-bytes b out (i + 1) len (list-push acc v)
   end

  pi4-spi-txn-transfer : linear SpiTxn, List Integer -> [Spi, Device.Mmio] (linear SpiTxn, List Integer)
  pi4-spi-txn-transfer (txn) (out) =
   when txn
    is SpiTxn (b) (cs) -> act
      got <- (pi4-spi-transfer-bytes b out 0 (list-length out) [])
      (SpiTxn b cs, got)
    end

  pi4-spi-deselect : linear SpiTxn -> [Spi, Device.Mmio] linear SpiBus
  pi4-spi-deselect (txn) =
   when txn
    is SpiTxn (b) (cs) -> act
      w <- (pi4-gpio-set cs)
      SpiBus b
    end

  pi4-spi-close : linear SpiBus -> [Spi, Device.Mmio] Integer
  pi4-spi-close (bus) =
   when bus
    is SpiBus (b) -> mmio-write-32 pi4-spi-cs 0

Section: I2C Registers (BSC1)

  pi4-bsc1-base : Integer = #FE804000
  pi4-bsc-c : Integer = #FE804000
  pi4-bsc-s : Integer = #FE804004
  pi4-bsc-dlen : Integer = #FE804008
  pi4-bsc-a : Integer = #FE80400C
  pi4-bsc-fifo : Integer = #FE804010

  pi4-bsc-c-i2cen : Integer = #8000
  pi4-bsc-c-st : Integer = #80
  pi4-bsc-c-read : Integer = 1
  pi4-bsc-c-clear : Integer = #30

  pi4-bsc-s-done : Integer = 2
  pi4-bsc-s-ta : Integer = 1
  pi4-bsc-s-clkt : Integer = #200
  pi4-bsc-s-err : Integer = #100

Section: I2C Driver

 BSC1 on GPIO2 (SDA1, AF0) / GPIO3 (SCL1, AF0).
 Standard mode (100 kHz). Clear status before each transaction.

  pi4-i2c-init : [Device.Mmio] Integer
  pi4-i2c-init = act
   af-sda <- pi4-gpio-set-alternate 2 0
   af-scl <- pi4-gpio-set-alternate 3 0
   pull-sda <- pi4-gpio-set-pull 2 1
   pull-scl <- (pi4-gpio-set-pull 3 1)
   mmio-write-32 pi4-bsc-c pi4-bsc-c-i2cen
  end

  pi4-i2c-wait-done : Integer -> [Device.Mmio] Integer
  pi4-i2c-wait-done (fuel) =
   if fuel <= 0 then 0
   else act
    status <- mmio-read-32 pi4-bsc-s
    if bit-and status pi4-bsc-s-done > 0 then 1
    else pi4-i2c-wait-done (fuel - 1)
   end

  pi4-i2c-clear-status : [Device.Mmio] Integer
  pi4-i2c-clear-status =
   mmio-write-32 pi4-bsc-s (bit-or (bit-or pi4-bsc-s-done pi4-bsc-s-clkt) pi4-bsc-s-err)

  pi4-i2c-write-reg : Integer, Integer, Integer -> [Device.Mmio] Integer
  pi4-i2c-write-reg (dev-addr) (reg) (value) = act
   clr <- pi4-i2c-clear-status
   w-addr <- mmio-write-32 pi4-bsc-a dev-addr
   w-dlen <- mmio-write-32 pi4-bsc-dlen 2
   w-fifo1 <- mmio-write-32 pi4-bsc-fifo reg
   w-fifo2 <- mmio-write-32 pi4-bsc-fifo value
   start <- (mmio-write-32 pi4-bsc-c (bit-or pi4-bsc-c-i2cen pi4-bsc-c-st))
   pi4-i2c-wait-done 100000
  end

  pi4-i2c-read-reg : Integer, Integer -> [Device.Mmio] Integer
  pi4-i2c-read-reg (dev-addr) (reg) = act
   clr1 <- pi4-i2c-clear-status
   w-addr <- mmio-write-32 pi4-bsc-a dev-addr
   w-dlen <- mmio-write-32 pi4-bsc-dlen 1
   w-fifo <- mmio-write-32 pi4-bsc-fifo reg
   start-w <- mmio-write-32 pi4-bsc-c (bit-or pi4-bsc-c-i2cen pi4-bsc-c-st)
   wait-w <- pi4-i2c-wait-done 100000
   clr2 <- pi4-i2c-clear-status
   w-dlen2 <- mmio-write-32 pi4-bsc-dlen 1
   start-r <- mmio-write-32 pi4-bsc-c (bit-or (bit-or pi4-bsc-c-i2cen pi4-bsc-c-st) pi4-bsc-c-read)
   wait-r <- pi4-i2c-wait-done 100000
   fifo <- (mmio-read-32 pi4-bsc-fifo)
   bit-and fifo #FF
  end

Section: Activity LED (GPIO 42 active-low on Pi 4)

  pi4-led-pin : Integer = 42

  pi4-led-init : [Device.Mmio] Integer
  pi4-led-init = pi4-gpio-set-output pi4-led-pin

  pi4-led-on : [Device.Mmio] Integer
  pi4-led-on = pi4-gpio-clear pi4-led-pin

  pi4-led-off : [Device.Mmio] Integer
  pi4-led-off = pi4-gpio-set pi4-led-pin

Section: Delay

  pi4-delay-loops : Integer, Integer -> Integer
  pi4-delay-loops (n) (i) =
   if i >= n then 0
   else pi4-delay-loops n (i + 1)

  pi4-delay-ms : Duration -> Integer
  pi4-delay-ms (ms) = pi4-delay-loops (ms * 1500000) 0

Page 1
