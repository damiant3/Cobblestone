Chapter: Stm32F4Board
  cites Foreword chapter Board
  cites Foreword chapter Units (Duration, Frequency)

 Board support for STM32F407 (ARM Cortex-M4F @ 168 MHz).
 Register addresses from RM0090 (STM32F405/F407 reference manual).
 Flash at 0x08000000, SRAM at 0x20000000, peripherals at 0x40000000+.

Section: Core Addresses

  stm32-flash-base : Integer = #08000000
  stm32-sram-base : Integer = #20000000
  stm32-sram-size : Integer = #30000
  stm32-periph-base : Integer = #40000000

Section: RCC (Reset and Clock Control)

  stm32-rcc-base : Integer = #40023800
  stm32-rcc-ahb1enr : Integer = #40023830
  stm32-rcc-apb1enr : Integer = #40023840
  stm32-rcc-apb2enr : Integer = #40023844

  stm32-rcc-gpioa-en : Integer = 1
  stm32-rcc-gpiob-en : Integer = 2
  stm32-rcc-gpioc-en : Integer = 4
  stm32-rcc-gpiod-en : Integer = 8

  stm32-rcc-usart2-en : Integer = #20000
  stm32-rcc-usart1-en : Integer = #10
  stm32-rcc-spi1-en : Integer = #1000
  stm32-rcc-i2c1-en : Integer = #200000

Section: GPIO Registers

  stm32-gpioa-base : Integer = #40020000
  stm32-gpiob-base : Integer = #40020400
  stm32-gpioc-base : Integer = #40020800
  stm32-gpiod-base : Integer = #40020C00

  stm32-gpio-moder-off : Integer = #00
  stm32-gpio-otyper-off : Integer = #04
  stm32-gpio-ospeedr-off : Integer = #08
  stm32-gpio-pupdr-off : Integer = #0C
  stm32-gpio-idr-off : Integer = #10
  stm32-gpio-odr-off : Integer = #14
  stm32-gpio-bsrr-off : Integer = #18
  stm32-gpio-afrl-off : Integer = #20
  stm32-gpio-afrh-off : Integer = #24

Section: GPIO Driver

  stm32-gpio-enable-port : Integer -> [Device.Mmio] Integer
  stm32-gpio-enable-port (port-bit) = act
   ahb1 <- mmio-read-32 stm32-rcc-ahb1enr
   mmio-write-32 stm32-rcc-ahb1enr (bit-or ahb1 port-bit)
  end

  stm32-gpio-set-mode : Integer, Integer, Integer -> [Device.Mmio] Integer
  stm32-gpio-set-mode (gpio-base) (pin) (mode) =
   let addr = gpio-base + stm32-gpio-moder-off
   in let shift = pin * 2
   in act
    moder <- mmio-read-32 addr
    mmio-write-32 addr (bit-or (bit-and moder (bit-xor (bit-shl 3 shift) (0 - 1))) (bit-shl mode shift))
   end

  stm32-gpio-set-output : Integer, Integer -> [Device.Mmio] Integer
  stm32-gpio-set-output (gpio-base) (pin) =
   stm32-gpio-set-mode gpio-base pin 1

  stm32-gpio-set-input : Integer, Integer -> [Device.Mmio] Integer
  stm32-gpio-set-input (gpio-base) (pin) =
   stm32-gpio-set-mode gpio-base pin 0

  stm32-gpio-set-alternate : Integer, Integer, Integer -> [Device.Mmio] Integer
  stm32-gpio-set-alternate (gpio-base) (pin) (af) =
   let af-reg = if pin < 8 then gpio-base + stm32-gpio-afrl-off else gpio-base + stm32-gpio-afrh-off
   in let af-pin = if pin < 8 then pin else pin - 8
   in let shift = af-pin * 4
   in act
    m <- stm32-gpio-set-mode gpio-base pin 2
    val <- mmio-read-32 af-reg
    mmio-write-32 af-reg (bit-or (bit-and val (bit-xor (bit-shl #F shift) (0 - 1))) (bit-shl af shift))
   end

  stm32-gpio-set-pull : Integer, Integer, Integer -> [Device.Mmio] Integer
  stm32-gpio-set-pull (gpio-base) (pin) (pull) =
   let addr = gpio-base + stm32-gpio-pupdr-off
   in let shift = pin * 2
   in act
    val <- mmio-read-32 addr
    mmio-write-32 addr (bit-or (bit-and val (bit-xor (bit-shl 3 shift) (0 - 1))) (bit-shl pull shift))
   end

  stm32-gpio-set-speed : Integer, Integer, Integer -> [Device.Mmio] Integer
  stm32-gpio-set-speed (gpio-base) (pin) (speed) =
   let addr = gpio-base + stm32-gpio-ospeedr-off
   in let shift = pin * 2
   in act
    val <- mmio-read-32 addr
    mmio-write-32 addr (bit-or (bit-and val (bit-xor (bit-shl 3 shift) (0 - 1))) (bit-shl speed shift))
   end

  gpio-set : Integer, Integer -> [Device.Mmio] Integer
  gpio-set (bsrr-addr) (pin) =
   mmio-write-32 bsrr-addr (bit-shl 1 pin)

  gpio-clear : Integer, Integer -> [Device.Mmio] Integer
  gpio-clear (bsrr-addr) (pin) =
   mmio-write-32 bsrr-addr (bit-shl 1 (pin + 16))

  stm32-gpio-write : Integer, Integer, Boolean -> [Device.Mmio] Integer
  stm32-gpio-write (gpio-base) (pin) (high) =
   let bsrr = gpio-base + stm32-gpio-bsrr-off
   in if high then gpio-set bsrr pin else gpio-clear bsrr pin

  stm32-gpio-read : Integer, Integer -> [Device.Mmio] Boolean
  stm32-gpio-read (gpio-base) (pin) = act
   idr <- (mmio-read-32 (gpio-base + stm32-gpio-idr-off))
   bit-and (bit-shru idr pin) 1 == 1
  end

  stm32-gpio-toggle : Integer, Integer -> [Device.Mmio] Integer
  stm32-gpio-toggle (gpio-base) (pin) = act
   odr <- mmio-read-32 (gpio-base + stm32-gpio-odr-off)
   if bit-and (bit-shru odr pin) 1 == 1
    then gpio-clear (gpio-base + stm32-gpio-bsrr-off) pin
    else gpio-set (gpio-base + stm32-gpio-bsrr-off) pin
  end

Section: GPIO Linear Handle

 The foreword Pin threaded onto an STM32 GPIO port: open sets the pin's
 mode, close returns it to input. The handle carries the port base so
 close reaches the same MODER without the caller re-supplying it. The
 caller still enables the port clock (stm32-gpio-enable-port) first.

  stm32-gpio-config : Integer, Integer, PinMode -> [Device.Mmio] Integer
  stm32-gpio-config (gpio-base) (pin) (mode) =
   when mode
    is PinOutput -> stm32-gpio-set-output gpio-base pin
    is PinInput -> stm32-gpio-set-input gpio-base pin
    is PinAlternate (af) -> stm32-gpio-set-alternate gpio-base pin af
    is PinAnalog -> stm32-gpio-set-mode gpio-base pin 3

  stm32-gpio-open : Integer, Integer, PinMode -> [Gpio, Device.Mmio] linear Pin
  stm32-gpio-open (gpio-base) (pin) (mode) = act
   m <- stm32-gpio-config gpio-base pin mode
   Pin gpio-base pin
  end

  stm32-pin-write : linear Pin, Boolean -> [Gpio, Device.Mmio] linear Pin
  stm32-pin-write (p) (high) =
   when p
    is Pin (base) (pin) -> act
      w <- stm32-gpio-write base pin high
      Pin base pin
    end

  stm32-pin-read : linear Pin -> [Gpio, Device.Mmio] (linear Pin, Boolean)
  stm32-pin-read (p) =
   when p
    is Pin (base) (pin) -> act
      v <- (stm32-gpio-read base pin)
      (Pin base pin, v)
    end

  stm32-pin-close : linear Pin -> [Gpio, Device.Mmio] Integer
  stm32-pin-close (p) =
   when p
    is Pin (base) (pin) -> stm32-gpio-set-mode base pin 0

Section: USART Registers

  stm32-usart1-base : Integer = #40011000
  stm32-usart2-base : Integer = #40004400
  stm32-usart-sr-off : Integer = #00
  stm32-usart-dr-off : Integer = #04
  stm32-usart-brr-off : Integer = #08
  stm32-usart-cr1-off : Integer = #0C

  stm32-usart-sr-txe : Integer = #80
  stm32-usart-sr-rxne : Integer = #20
  stm32-usart-cr1-ue : Integer = #2000
  stm32-usart-cr1-te : Integer = #08
  stm32-usart-cr1-re : Integer = #04

Section: UART Driver

  stm32-uart2-init : Frequency -> [Device.Mmio] Integer
  stm32-uart2-init (baud) =
   let brr = 16000000 / baud
   in act
    en-port <- stm32-gpio-enable-port stm32-rcc-gpioa-en
    apb1 <- mmio-read-32 stm32-rcc-apb1enr
    en-usart <- mmio-write-32 stm32-rcc-apb1enr (bit-or apb1 stm32-rcc-usart2-en)
    af-tx <- stm32-gpio-set-alternate stm32-gpioa-base 2 7
    af-rx <- stm32-gpio-set-alternate stm32-gpioa-base 3 7
    w-brr <- mmio-write-32 (stm32-usart2-base + stm32-usart-brr-off) brr
    mmio-write-32 (stm32-usart2-base + stm32-usart-cr1-off) (bit-or (bit-or stm32-usart-cr1-ue stm32-usart-cr1-te) stm32-usart-cr1-re)
   end

  stm32-uart-tx-ready : Integer -> [Device.Mmio] Boolean
  stm32-uart-tx-ready (usart-base) = act
   sr <- (mmio-read-32 (usart-base + stm32-usart-sr-off))
   bit-and sr stm32-usart-sr-txe > 0
  end

  stm32-uart-rx-ready : Integer -> [Device.Mmio] Boolean
  stm32-uart-rx-ready (usart-base) = act
   sr <- (mmio-read-32 (usart-base + stm32-usart-sr-off))
   bit-and sr stm32-usart-sr-rxne > 0
  end

  stm32-uart-send-byte : Integer, Integer -> [Device.Mmio] Integer
  stm32-uart-send-byte (usart-base) (byte) = act
   w <- stm32-uart-wait-tx usart-base 10000
   mmio-write-32 (usart-base + stm32-usart-dr-off) (bit-and byte #FF)
  end

  stm32-uart-wait-tx : Integer, Integer -> [Device.Mmio] Integer
  stm32-uart-wait-tx (usart-base) (fuel) =
   if fuel <= 0 then 0
   else act
    ready <- stm32-uart-tx-ready usart-base
    if ready then 1 else stm32-uart-wait-tx usart-base (fuel - 1)
   end

 Reading the data register is not a free observation: on real silicon it
 pops the receive FIFO and clears RXNE. So a timed-out receive must NOT
 touch it -- the original let-chain read DR only on the success path, and
 an act-block that binds the read before testing the fuel result would
 quietly add a spurious read to the timeout path. The read lives in its
 own function instead, called only from the branch that wants it.

  stm32-uart-read-dr : Integer -> [Device.Mmio] Integer
  stm32-uart-read-dr (usart-base) = act
   dr <- (mmio-read-32 (usart-base + stm32-usart-dr-off))
   bit-and dr #FF
  end

  stm32-uart-recv-byte : Integer -> [Device.Mmio] Integer
  stm32-uart-recv-byte (usart-base) = act
   w <- stm32-uart-wait-rx usart-base 100000
   if w == 0 then 0 - 1 else stm32-uart-read-dr usart-base
  end

  stm32-uart-wait-rx : Integer, Integer -> [Device.Mmio] Integer
  stm32-uart-wait-rx (usart-base) (fuel) =
   if fuel <= 0 then 0
   else act
    ready <- stm32-uart-rx-ready usart-base
    if ready then 1 else stm32-uart-wait-rx usart-base (fuel - 1)
   end

  stm32-uart-send-text : Integer, Text, Integer, Integer -> [Device.Mmio] Integer
  stm32-uart-send-text (usart-base) (s) (i) (len) =
   if i >= len then 0
   else act
    b <- stm32-uart-send-byte usart-base (char-code (char-at s i))
    stm32-uart-send-text usart-base s (i + 1) len
   end

  stm32-uart-print : Integer, Text -> [Device.Mmio] Integer
  stm32-uart-print (usart-base) (s) =
   stm32-uart-send-text usart-base s 0 (text-length s)

  stm32-uart-println : Integer, Text -> [Device.Mmio] Integer
  stm32-uart-println (usart-base) (s) = act
   p <- stm32-uart-print usart-base s
   cr <- stm32-uart-send-byte usart-base 13
   stm32-uart-send-byte usart-base 10
  end

Section: UART Linear Handle

 The foreword UartPort threaded onto USART2: open initialises the port,
 write sends one byte through the board's own TXE poll, close disables
 the USART. The handle carries the USART base so a caller cannot send
 down a different USART by passing the wrong address.

  stm32-uart-open : Frequency -> [Uart, Device.Mmio] linear UartPort
  stm32-uart-open (baud) = act
   i <- stm32-uart2-init baud
   UartPort stm32-usart2-base
  end

  stm32-uart-write : linear UartPort, Integer -> [Uart, Device.Mmio] linear UartPort
  stm32-uart-write (port) (byte) =
   when port
    is UartPort (b) -> act
      w <- stm32-uart-send-byte b byte
      UartPort b
    end

  stm32-uart-recv-bytes : Integer, Integer, Integer, List Integer -> [Device.Mmio] List Integer
  stm32-uart-recv-bytes (b) (n) (i) (acc) =
   if i >= n then acc
   else act
    v <- (stm32-uart-recv-byte b)
    stm32-uart-recv-bytes b n (i + 1) (list-push acc v)
   end

  stm32-uart-recv : linear UartPort, Integer -> [Uart, Device.Mmio] (linear UartPort, List Integer)
  stm32-uart-recv (port) (n) =
   when port
    is UartPort (b) -> act
      bytes <- (stm32-uart-recv-bytes b n 0 [])
      (UartPort b, bytes)
    end

  stm32-uart-close : linear UartPort -> [Uart, Device.Mmio] Integer
  stm32-uart-close (port) =
   when port
    is UartPort (b) -> mmio-write-32 (b + stm32-usart-cr1-off) 0

Section: SPI Registers

  stm32-spi1-base : Integer = #40013000
  stm32-spi-cr1-off : Integer = #00
  stm32-spi-cr2-off : Integer = #04
  stm32-spi-sr-off : Integer = #08
  stm32-spi-dr-off : Integer = #0C

  stm32-spi-cr1-spe : Integer = #40
  stm32-spi-cr1-mstr : Integer = #04
  stm32-spi-cr1-br-div8 : Integer = #10
  stm32-spi-sr-txe : Integer = #02
  stm32-spi-sr-rxne : Integer = #01
  stm32-spi-sr-bsy : Integer = #80

Section: SPI Driver

  stm32-spi1-init : [Device.Mmio] Integer
  stm32-spi1-init = act
   en-port <- stm32-gpio-enable-port stm32-rcc-gpioa-en
   apb2 <- mmio-read-32 stm32-rcc-apb2enr
   en-spi <- mmio-write-32 stm32-rcc-apb2enr (bit-or apb2 stm32-rcc-spi1-en)
   af-sck <- stm32-gpio-set-alternate stm32-gpioa-base 5 5
   af-miso <- stm32-gpio-set-alternate stm32-gpioa-base 6 5
   af-mosi <- stm32-gpio-set-alternate stm32-gpioa-base 7 5
   mmio-write-32 (stm32-spi1-base + stm32-spi-cr1-off) (bit-or (bit-or stm32-spi-cr1-mstr stm32-spi-cr1-br-div8) stm32-spi-cr1-spe)
  end

  stm32-spi-transfer : Integer, Integer -> [Device.Mmio] Integer
  stm32-spi-transfer (spi-base) (byte) = act
   w <- stm32-spi-wait-tx spi-base 10000
   wr <- mmio-write-32 (spi-base + stm32-spi-dr-off) (bit-and byte #FF)
   r <- stm32-spi-wait-rx spi-base 10000
   dr <- (mmio-read-32 (spi-base + stm32-spi-dr-off))
   bit-and dr #FF
  end

  stm32-spi-wait-tx : Integer, Integer -> [Device.Mmio] Integer
  stm32-spi-wait-tx (spi-base) (fuel) =
   if fuel <= 0 then 0
   else act
    sr <- mmio-read-32 (spi-base + stm32-spi-sr-off)
    if bit-and sr stm32-spi-sr-txe > 0 then 1
    else stm32-spi-wait-tx spi-base (fuel - 1)
   end

  stm32-spi-wait-rx : Integer, Integer -> [Device.Mmio] Integer
  stm32-spi-wait-rx (spi-base) (fuel) =
   if fuel <= 0 then 0
   else act
    sr <- mmio-read-32 (spi-base + stm32-spi-sr-off)
    if bit-and sr stm32-spi-sr-rxne > 0 then 1
    else stm32-spi-wait-rx spi-base (fuel - 1)
   end

  stm32-spi-busy : Integer -> [Device.Mmio] Boolean
  stm32-spi-busy (spi-base) = act
   sr <- (mmio-read-32 (spi-base + stm32-spi-sr-off))
   bit-and sr stm32-spi-sr-bsy > 0
  end

Section: Linear I2C Bus

  stm32-i2c-open : [I2c, Device.Mmio] linear I2cBus
  stm32-i2c-open = act
   i <- stm32-i2c1-init
   I2cBus stm32-i2c1-base
  end

  stm32-i2c-bus-write-reg : linear I2cBus, Integer, Integer, Integer -> [I2c, Device.Mmio] (linear I2cBus, Integer)
  stm32-i2c-bus-write-reg (bus) (addr) (reg) (val) =
   when bus
    is I2cBus (b) -> act
      r <- (stm32-i2c-write-reg b addr reg val)
      (I2cBus b, r)
    end

  stm32-i2c-bus-read-reg : linear I2cBus, Integer, Integer -> [I2c, Device.Mmio] (linear I2cBus, Integer)
  stm32-i2c-bus-read-reg (bus) (addr) (reg) =
   when bus
    is I2cBus (b) -> act
      v <- (stm32-i2c-read-reg b addr reg)
      (I2cBus b, v)
    end

  stm32-i2c-close : linear I2cBus -> [I2c, Device.Mmio] Integer
  stm32-i2c-close (bus) =
   when bus
    is I2cBus (b) -> mmio-write-32 (b + stm32-i2c-cr1-off) 0

Section: Linear SPI Transaction

  stm32-spi-open : [Spi, Device.Mmio] linear SpiBus
  stm32-spi-open = act
   i <- stm32-spi1-init
   SpiBus stm32-spi1-base
  end

  stm32-spi-select : linear SpiBus, Integer -> [Spi, Device.Mmio] linear SpiTxn
  stm32-spi-select (bus) (cs) =
   when bus
    is SpiBus (b) -> act
      w <- (stm32-gpio-write stm32-gpioa-base cs False)
      SpiTxn b cs
    end

  stm32-spi-transfer-bytes : Integer, List Integer, Integer, Integer, List Integer -> [Device.Mmio] List Integer
  stm32-spi-transfer-bytes (b) (out) (i) (len) (acc) =
   if i >= len then acc
   else act
    v <- (stm32-spi-transfer b (list-at out i))
    stm32-spi-transfer-bytes b out (i + 1) len (list-push acc v)
   end

  stm32-spi-txn-transfer : linear SpiTxn, List Integer -> [Spi, Device.Mmio] (linear SpiTxn, List Integer)
  stm32-spi-txn-transfer (txn) (out) =
   when txn
    is SpiTxn (b) (cs) -> act
      got <- (stm32-spi-transfer-bytes b out 0 (list-length out) [])
      (SpiTxn b cs, got)
    end

  stm32-spi-deselect : linear SpiTxn -> [Spi, Device.Mmio] linear SpiBus
  stm32-spi-deselect (txn) =
   when txn
    is SpiTxn (b) (cs) -> act
      w <- (stm32-gpio-write stm32-gpioa-base cs True)
      SpiBus b
    end

  stm32-spi-close : linear SpiBus -> [Spi, Device.Mmio] Integer
  stm32-spi-close (bus) =
   when bus
    is SpiBus (b) -> mmio-write-32 (b + stm32-spi-cr1-off) 0

Section: I2C Registers

  stm32-i2c1-base : Integer = #40005400
  stm32-i2c-cr1-off : Integer = #00
  stm32-i2c-cr2-off : Integer = #04
  stm32-i2c-oar1-off : Integer = #08
  stm32-i2c-dr-off : Integer = #10
  stm32-i2c-sr1-off : Integer = #14
  stm32-i2c-sr2-off : Integer = #18
  stm32-i2c-ccr-off : Integer = #1C
  stm32-i2c-trise-off : Integer = #20

  stm32-i2c-cr1-pe : Integer = 1
  stm32-i2c-cr1-start : Integer = #100
  stm32-i2c-cr1-stop : Integer = #200
  stm32-i2c-cr1-ack : Integer = #400
  stm32-i2c-cr1-swrst : Integer = #8000
  stm32-i2c-sr1-sb : Integer = 1
  stm32-i2c-sr1-addr : Integer = 2
  stm32-i2c-sr1-btf : Integer = 4
  stm32-i2c-sr1-txe : Integer = #80
  stm32-i2c-sr1-rxne : Integer = #40

Section: I2C Driver

  stm32-i2c1-init : [Device.Mmio] Integer
  stm32-i2c1-init = act
   en-port <- stm32-gpio-enable-port stm32-rcc-gpiob-en
   apb1 <- mmio-read-32 stm32-rcc-apb1enr
   en-i2c <- mmio-write-32 stm32-rcc-apb1enr (bit-or apb1 stm32-rcc-i2c1-en)
   af-scl <- stm32-gpio-set-alternate stm32-gpiob-base 6 4
   af-sda <- stm32-gpio-set-alternate stm32-gpiob-base 7 4
   rst <- mmio-write-32 (stm32-i2c1-base + stm32-i2c-cr1-off) stm32-i2c-cr1-swrst
   clr <- mmio-write-32 (stm32-i2c1-base + stm32-i2c-cr1-off) 0
   freq <- mmio-write-32 (stm32-i2c1-base + stm32-i2c-cr2-off) 16
   ccr <- mmio-write-32 (stm32-i2c1-base + stm32-i2c-ccr-off) 80
   trise <- mmio-write-32 (stm32-i2c1-base + stm32-i2c-trise-off) 17
   mmio-write-32 (stm32-i2c1-base + stm32-i2c-cr1-off) stm32-i2c-cr1-pe
  end

  stm32-i2c-start : Integer -> [Device.Mmio] Integer
  stm32-i2c-start (i2c-base) = act
   cr1 <- mmio-read-32 (i2c-base + stm32-i2c-cr1-off)
   w <- mmio-write-32 (i2c-base + stm32-i2c-cr1-off) (bit-or cr1 stm32-i2c-cr1-start)
   stm32-i2c-wait-flag i2c-base stm32-i2c-sr1-off stm32-i2c-sr1-sb 10000
  end

  stm32-i2c-stop : Integer -> [Device.Mmio] Integer
  stm32-i2c-stop (i2c-base) = act
   cr1 <- mmio-read-32 (i2c-base + stm32-i2c-cr1-off)
   mmio-write-32 (i2c-base + stm32-i2c-cr1-off) (bit-or cr1 stm32-i2c-cr1-stop)
  end

  stm32-i2c-send-addr : Integer, Integer, Boolean -> [Device.Mmio] Integer
  stm32-i2c-send-addr (i2c-base) (addr) (read) =
   let byte = if read then bit-or (bit-shl addr 1) 1 else bit-shl addr 1
   in act
    w <- mmio-write-32 (i2c-base + stm32-i2c-dr-off) byte
    f <- stm32-i2c-wait-flag i2c-base stm32-i2c-sr1-off stm32-i2c-sr1-addr 10000
    clear-addr <- (mmio-read-32 (i2c-base + stm32-i2c-sr2-off))
    f
   end

  stm32-i2c-write-byte : Integer, Integer -> [Device.Mmio] Integer
  stm32-i2c-write-byte (i2c-base) (byte) = act
   f <- stm32-i2c-wait-flag i2c-base stm32-i2c-sr1-off stm32-i2c-sr1-txe 10000
   mmio-write-32 (i2c-base + stm32-i2c-dr-off) (bit-and byte #FF)
  end

  stm32-i2c-read-byte : Integer, Boolean -> [Device.Mmio] Integer
  stm32-i2c-read-byte (i2c-base) (ack) = act
   cr1 <- mmio-read-32 (i2c-base + stm32-i2c-cr1-off)
   set-ack <- if ack then mmio-write-32 (i2c-base + stm32-i2c-cr1-off) (bit-or cr1 stm32-i2c-cr1-ack)
        else mmio-write-32 (i2c-base + stm32-i2c-cr1-off) (bit-and cr1 (bit-xor stm32-i2c-cr1-ack (0 - 1)))
   f <- stm32-i2c-wait-flag i2c-base stm32-i2c-sr1-off stm32-i2c-sr1-rxne 10000
   dr <- (mmio-read-32 (i2c-base + stm32-i2c-dr-off))
   bit-and dr #FF
  end

  stm32-i2c-wait-flag : Integer, Integer, Integer, Integer -> [Device.Mmio] Integer
  stm32-i2c-wait-flag (i2c-base) (reg-off) (flag) (fuel) =
   if fuel <= 0 then 0
   else act
    val <- mmio-read-32 (i2c-base + reg-off)
    if bit-and val flag > 0 then 1
    else stm32-i2c-wait-flag i2c-base reg-off flag (fuel - 1)
   end

  stm32-i2c-write-reg : Integer, Integer, Integer, Integer -> [Device.Mmio] Integer
  stm32-i2c-write-reg (i2c-base) (dev-addr) (reg) (value) = act
   s <- stm32-i2c-start i2c-base
   a <- stm32-i2c-send-addr i2c-base dev-addr False
   r <- stm32-i2c-write-byte i2c-base reg
   v <- stm32-i2c-write-byte i2c-base value
   stm32-i2c-stop i2c-base
  end

  stm32-i2c-read-reg : Integer, Integer, Integer -> [Device.Mmio] Integer
  stm32-i2c-read-reg (i2c-base) (dev-addr) (reg) = act
   s1 <- stm32-i2c-start i2c-base
   a1 <- stm32-i2c-send-addr i2c-base dev-addr False
   r <- stm32-i2c-write-byte i2c-base reg
   s2 <- stm32-i2c-start i2c-base
   a2 <- stm32-i2c-send-addr i2c-base dev-addr True
   val <- stm32-i2c-read-byte i2c-base False
   stop <- (stm32-i2c-stop i2c-base)
   val
  end

Section: LED (Discovery Board: PD12-PD15)

  stm32-led-green-pin : Integer = 12
  stm32-led-orange-pin : Integer = 13
  stm32-led-red-pin : Integer = 14
  stm32-led-blue-pin : Integer = 15
  stm32-led-gpio-base : Integer = stm32-gpiod-base

  stm32-led-init : [Device.Mmio] Integer
  stm32-led-init = act
   en <- stm32-gpio-enable-port stm32-rcc-gpiod-en
   g <- stm32-gpio-set-output stm32-led-gpio-base stm32-led-green-pin
   o <- stm32-gpio-set-output stm32-led-gpio-base stm32-led-orange-pin
   r <- stm32-gpio-set-output stm32-led-gpio-base stm32-led-red-pin
   stm32-gpio-set-output stm32-led-gpio-base stm32-led-blue-pin
  end

  stm32-led-on : Integer -> [Device.Mmio] Integer
  stm32-led-on (pin) = gpio-set (stm32-led-gpio-base + stm32-gpio-bsrr-off) pin

  stm32-led-off : Integer -> [Device.Mmio] Integer
  stm32-led-off (pin) = gpio-clear (stm32-led-gpio-base + stm32-gpio-bsrr-off) pin

Section: Delay

  stm32-delay-loops : Integer, Integer -> Integer
  stm32-delay-loops (n) (i) =
   if i >= n then 0
   else stm32-delay-loops n (i + 1)

  stm32-delay-ms : Duration -> Integer
  stm32-delay-ms (ms) = stm32-delay-loops (ms * 4000) 0

