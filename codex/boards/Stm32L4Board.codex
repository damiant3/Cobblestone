Chapter: Stm32L4Board
  cites Foreword chapter Board
  cites Foreword chapter Units (Duration, Frequency)

 Board support for STM32L476 (ARM Cortex-M4F @ 80 MHz, ultra-low-power).
 Register addresses from RM0351 (STM32L4x6 reference manual).
 Flash at 0x08000000, SRAM at 0x20000000 (96 KB SRAM1 + 32 KB SRAM2).
 Peripherals at 0x40000000+.

 Key difference from STM32F4: MSI clock (100 kHz - 48 MHz), low-power
 modes (Stop 0/1/2, Standby, Shutdown), LPTIM for wakeup.

Section: Core Addresses

  l4-flash-base : Integer = #08000000
  l4-sram-base : Integer = #20000000
  l4-sram-size : Integer = #20000
  l4-periph-base : Integer = #40000000

Section: RCC (0x40021000)

  l4-rcc-base : Integer = #40021000
  l4-rcc-cr-off : Integer = #00
  l4-rcc-cfgr-off : Integer = #08
  l4-rcc-ahb2enr-off : Integer = #4C
  l4-rcc-apb1enr1-off : Integer = #58
  l4-rcc-apb2enr-off : Integer = #60
  l4-rcc-ccipr-off : Integer = #88

  l4-rcc-gpioa-en : Integer = 1
  l4-rcc-gpiob-en : Integer = 2
  l4-rcc-gpioc-en : Integer = 4
  l4-rcc-usart2-en : Integer = #20000
  l4-rcc-spi1-en : Integer = #1000
  l4-rcc-i2c1-en : Integer = #200000
  l4-rcc-lptim1-en : Integer = #80000000
  l4-rcc-pwr-en : Integer = #10000000

  l4-rcc-cr-msion : Integer = 1
  l4-rcc-cr-msirange-mask : Integer = #F0
  l4-rcc-cr-msirgsel : Integer = #08

  l4-rcc-enable-port : Integer -> [Device.Mmio] Integer
  l4-rcc-enable-port (port-bit) = act
   ahb2 <- (mmio-read-32 (l4-rcc-base + l4-rcc-ahb2enr-off))
   mmio-write-32 (l4-rcc-base + l4-rcc-ahb2enr-off) (bit-or ahb2 port-bit)
  end

  l4-rcc-set-msi-range : Integer -> [Device.Mmio] Integer
  l4-rcc-set-msi-range (range) = act
   cr <- (mmio-read-32 (l4-rcc-base + l4-rcc-cr-off))
   mmio-write-32 (l4-rcc-base + l4-rcc-cr-off) (bit-or (bit-or (bit-and cr (bit-xor l4-rcc-cr-msirange-mask (0 - 1))) (bit-shl range 4)) l4-rcc-cr-msirgsel)
  end

Section: GPIO (same register layout as STM32F4, different bases)

  l4-gpioa-base : Integer = #48000000
  l4-gpiob-base : Integer = #48000400
  l4-gpioc-base : Integer = #48000800

  l4-gpio-moder-off : Integer = #00
  l4-gpio-ospeedr-off : Integer = #08
  l4-gpio-pupdr-off : Integer = #0C
  l4-gpio-idr-off : Integer = #10
  l4-gpio-odr-off : Integer = #14
  l4-gpio-bsrr-off : Integer = #18
  l4-gpio-afrl-off : Integer = #20
  l4-gpio-afrh-off : Integer = #24

  l4-gpio-set-mode : Integer, Integer, Integer -> [Device.Mmio] Integer
  l4-gpio-set-mode (gpio-base) (pin) (mode) =
   let addr = gpio-base + l4-gpio-moder-off
   in let shift = pin * 2
   in act
    moder <- (mmio-read-32 addr)
    mmio-write-32 addr (bit-or (bit-and moder (bit-xor (bit-shl 3 shift) (0 - 1))) (bit-shl mode shift))
   end

  l4-gpio-set-output : Integer, Integer -> [Device.Mmio] Integer
  l4-gpio-set-output (gpio-base) (pin) = l4-gpio-set-mode gpio-base pin 1

  l4-gpio-set-input : Integer, Integer -> [Device.Mmio] Integer
  l4-gpio-set-input (gpio-base) (pin) = l4-gpio-set-mode gpio-base pin 0

  l4-gpio-set-alternate : Integer, Integer, Integer -> [Device.Mmio] Integer
  l4-gpio-set-alternate (gpio-base) (pin) (af) =
   let af-reg = if pin < 8 then gpio-base + l4-gpio-afrl-off else gpio-base + l4-gpio-afrh-off
   in let af-pin = if pin < 8 then pin else pin - 8
   in let shift = af-pin * 4
   in act
    m <- l4-gpio-set-mode gpio-base pin 2
    val <- (mmio-read-32 af-reg)
    mmio-write-32 af-reg (bit-or (bit-and val (bit-xor (bit-shl #F shift) (0 - 1))) (bit-shl af shift))
   end

  l4-gpio-set-pull : Integer, Integer, Integer -> [Device.Mmio] Integer
  l4-gpio-set-pull (gpio-base) (pin) (pull) =
   let addr = gpio-base + l4-gpio-pupdr-off
   in let shift = pin * 2
   in act
    val <- (mmio-read-32 addr)
    mmio-write-32 addr (bit-or (bit-and val (bit-xor (bit-shl 3 shift) (0 - 1))) (bit-shl pull shift))
   end

  l4-gpio-write : Integer, Integer, Boolean -> [Device.Mmio] Integer
  l4-gpio-write (gpio-base) (pin) (high) =
   let bsrr = gpio-base + l4-gpio-bsrr-off
   in if high then mmio-write-32 bsrr (bit-shl 1 pin)
      else mmio-write-32 bsrr (bit-shl 1 (pin + 16))

  l4-gpio-read : Integer, Integer -> [Device.Mmio] Boolean
  l4-gpio-read (gpio-base) (pin) = act
   idr <- (mmio-read-32 (gpio-base + l4-gpio-idr-off))
   bit-and (bit-shru idr pin) 1 == 1
  end

  l4-gpio-toggle : Integer, Integer -> [Device.Mmio] Integer
  l4-gpio-toggle (gpio-base) (pin) =
   let bsrr = gpio-base + l4-gpio-bsrr-off
   in act
    odr <- mmio-read-32 (gpio-base + l4-gpio-odr-off)
    if bit-and (bit-shru odr pin) 1 == 1 then mmio-write-32 bsrr (bit-shl 1 (pin + 16))
    else mmio-write-32 bsrr (bit-shl 1 pin)
   end

Section: GPIO Linear Handle

 The foreword Pin threaded onto an STM32L4 GPIO port: open sets the pin's
 mode, close returns it to input. The handle carries the port base so
 close reaches the same MODER without the caller re-supplying it. The
 caller still enables the port clock (l4-rcc-enable-port) first.

  l4-gpio-config : Integer, Integer, PinMode -> [Device.Mmio] Integer
  l4-gpio-config (gpio-base) (pin) (mode) =
   when mode
    is PinOutput -> l4-gpio-set-output gpio-base pin
    is PinInput -> l4-gpio-set-input gpio-base pin
    is PinAlternate (af) -> l4-gpio-set-alternate gpio-base pin af
    is PinAnalog -> l4-gpio-set-mode gpio-base pin 3

  l4-gpio-open : linear Board, Integer, Integer, PinMode -> [Gpio, Device.Mmio] (linear Board, linear Pin)
  l4-gpio-open (brd) (gpio-base) (pin) (mode) =
   when brd
    is Board (pw) (sc) -> act
      m <- (l4-gpio-config gpio-base pin mode)
      (Board pw sc, Pin gpio-base pin)
    end

  l4-pin-write : linear Pin, Boolean -> [Gpio, Device.Mmio] linear Pin
  l4-pin-write (p) (high) =
   when p
    is Pin (base) (pin) -> act
      w <- l4-gpio-write base pin high
      Pin base pin
    end

  l4-pin-read : linear Pin -> [Gpio, Device.Mmio] (linear Pin, Boolean)
  l4-pin-read (p) =
   when p
    is Pin (base) (pin) -> act
      v <- (l4-gpio-read base pin)
      (Pin base pin, v)
    end

  l4-pin-close : linear Pin -> [Gpio, Device.Mmio] Integer
  l4-pin-close (p) =
   when p
    is Pin (base) (pin) -> l4-gpio-set-mode base pin 0

Section: USART2 (0x40004400)

  l4-usart2-base : Integer = #40004400
  l4-usart-cr1-off : Integer = #00
  l4-usart-brr-off : Integer = #0C
  l4-usart-isr-off : Integer = #1C
  l4-usart-tdr-off : Integer = #28

  l4-usart-cr1-ue : Integer = 1
  l4-usart-cr1-te : Integer = #08
  l4-usart-cr1-re : Integer = #04
  l4-usart-isr-txe : Integer = #80

  l4-uart-init : Frequency -> [Device.Mmio] Integer
  l4-uart-init (baud) =
   let brr = 4000000 / baud
   in act
    en-port <- l4-rcc-enable-port l4-rcc-gpioa-en
    apb1 <- mmio-read-32 (l4-rcc-base + l4-rcc-apb1enr1-off)
    en-usart <- mmio-write-32 (l4-rcc-base + l4-rcc-apb1enr1-off) (bit-or apb1 l4-rcc-usart2-en)
    af-tx <- l4-gpio-set-alternate l4-gpioa-base 2 7
    af-rx <- l4-gpio-set-alternate l4-gpioa-base 3 7
    w-brr <- (mmio-write-32 (l4-usart2-base + l4-usart-brr-off) brr)
    mmio-write-32 (l4-usart2-base + l4-usart-cr1-off) (bit-or (bit-or l4-usart-cr1-ue l4-usart-cr1-te) l4-usart-cr1-re)
   end

  l4-uart-send-byte : Integer -> [Device.Mmio] Integer
  l4-uart-send-byte (byte) = act
   w <- (l4-uart-wait-tx 10000)
   mmio-write-32 (l4-usart2-base + l4-usart-tdr-off) (bit-and byte #FF)
  end

  l4-uart-wait-tx : Integer -> [Device.Mmio] Integer
  l4-uart-wait-tx (fuel) =
   if fuel <= 0 then 0
   else act
    isr <- mmio-read-32 (l4-usart2-base + l4-usart-isr-off)
    if bit-and isr l4-usart-isr-txe > 0 then 1
    else l4-uart-wait-tx (fuel - 1)
   end

  l4-uart-print : Text -> [Device.Mmio] Integer
  l4-uart-print (s) = l4-uart-send-text s 0 (text-length s)

  l4-uart-send-text : Text, Integer, Integer -> [Device.Mmio] Integer
  l4-uart-send-text (s) (i) (len) =
   if i >= len then 0
   else act
    b <- (l4-uart-send-byte (char-code (char-at s i)))
    l4-uart-send-text s (i + 1) len
   end

  l4-uart-println : Text -> [Device.Mmio] Integer
  l4-uart-println (s) = act
   p <- l4-uart-print s
   cr <- (l4-uart-send-byte 13)
   l4-uart-send-byte 10
  end

Section: UART Linear Handle

 The foreword UartPort threaded onto USART2: open initialises the port,
 write sends one byte through the board's own TXE poll, close disables
 the USART. The board's send targets USART2 directly, so the handle
 carries the base for the type's sake and for close's CR1 write.

  l4-uart-open : linear Board, Frequency -> [Uart, Device.Mmio] (linear Board, linear UartPort)
  l4-uart-open (brd) (baud) =
   when brd
    is Board (pw) (sc) -> act
      i <- (l4-uart-init baud)
      (Board pw sc, UartPort l4-usart2-base)
    end

  l4-uart-write : linear UartPort, Integer -> [Uart, Device.Mmio] linear UartPort
  l4-uart-write (port) (byte) =
   when port
    is UartPort (b) -> act
      w <- l4-uart-send-byte byte
      UartPort b
    end

  l4-usart-rdr-off : Integer = #24
  l4-usart-isr-rxne : Integer = #20

  l4-uart-recv-byte : Integer, Integer -> [Device.Mmio] Integer
  l4-uart-recv-byte (usart-base) (fuel) =
   if fuel <= 0 then 0 - 1
   else act
    isr <- (mmio-read-32 (usart-base + l4-usart-isr-off))
    if bit-and isr l4-usart-isr-rxne > 0 then bit-and (mmio-read-32 (usart-base + l4-usart-rdr-off)) #FF
    else l4-uart-recv-byte usart-base (fuel - 1)
   end

  l4-uart-recv-bytes : Integer, Integer, Integer, List Integer -> [Device.Mmio] List Integer
  l4-uart-recv-bytes (b) (n) (i) (acc) =
   if i >= n then acc
   else act
    v <- (l4-uart-recv-byte b 100000)
    l4-uart-recv-bytes b n (i + 1) (list-push acc v)
   end

  l4-uart-recv : linear UartPort, Integer -> [Uart, Device.Mmio] (linear UartPort, List Integer)
  l4-uart-recv (port) (n) =
   when port
    is UartPort (b) -> act
      bytes <- (l4-uart-recv-bytes b n 0 [])
      (UartPort b, bytes)
    end
  l4-uart-close : linear UartPort -> [Uart, Device.Mmio] Integer
  l4-uart-close (port) =
   when port
    is UartPort (b) -> mmio-write-32 (b + l4-usart-cr1-off) 0

Section: SPI1 (0x40013000)

  l4-spi1-base : Integer = #40013000
  l4-spi-cr1-off : Integer = #00
  l4-spi-cr2-off : Integer = #04
  l4-spi-sr-off : Integer = #08
  l4-spi-dr-off : Integer = #0C

  l4-spi-cr1-spe : Integer = #40
  l4-spi-cr1-mstr : Integer = #04
  l4-spi-cr1-br-div8 : Integer = #10
  l4-spi-sr-txe : Integer = #02
  l4-spi-sr-rxne : Integer = #01

  l4-spi-init : [Device.Mmio] Integer
  l4-spi-init = act
   en-port <- l4-rcc-enable-port l4-rcc-gpioa-en
   apb2 <- mmio-read-32 (l4-rcc-base + l4-rcc-apb2enr-off)
   en-spi <- mmio-write-32 (l4-rcc-base + l4-rcc-apb2enr-off) (bit-or apb2 l4-rcc-spi1-en)
   af-sck <- l4-gpio-set-alternate l4-gpioa-base 5 5
   af-miso <- l4-gpio-set-alternate l4-gpioa-base 6 5
   af-mosi <- (l4-gpio-set-alternate l4-gpioa-base 7 5)
   mmio-write-32 (l4-spi1-base + l4-spi-cr1-off) (bit-or (bit-or l4-spi-cr1-mstr l4-spi-cr1-br-div8) l4-spi-cr1-spe)
  end

  l4-spi-transfer : Integer -> [Device.Mmio] Integer
  l4-spi-transfer (byte) = act
   w <- l4-spi-wait-txe 10000
   wr <- mmio-write-32 (l4-spi1-base + l4-spi-dr-off) (bit-and byte #FF)
   r <- l4-spi-wait-rxne 10000
   dr <- (mmio-read-32 (l4-spi1-base + l4-spi-dr-off))
   bit-and dr #FF
  end

  l4-spi-wait-txe : Integer -> [Device.Mmio] Integer
  l4-spi-wait-txe (fuel) =
   if fuel <= 0 then 0
   else act
    sr <- mmio-read-32 (l4-spi1-base + l4-spi-sr-off)
    if bit-and sr l4-spi-sr-txe > 0 then 1
    else l4-spi-wait-txe (fuel - 1)
   end

  l4-spi-wait-rxne : Integer -> [Device.Mmio] Integer
  l4-spi-wait-rxne (fuel) =
   if fuel <= 0 then 0
   else act
    sr <- mmio-read-32 (l4-spi1-base + l4-spi-sr-off)
    if bit-and sr l4-spi-sr-rxne > 0 then 1
    else l4-spi-wait-rxne (fuel - 1)
   end

Section: Linear I2C Bus

  l4-i2c-open : linear Board -> [I2c, Device.Mmio] (linear Board, linear I2cBus)
  l4-i2c-open (brd) =
   when brd
    is Board (pw) (sc) -> act
      i <- (l4-i2c-init)
      (Board pw sc, I2cBus l4-i2c1-base)
    end

  l4-i2c-bus-write-reg : linear I2cBus, Integer, Integer, Integer -> [I2c, Device.Mmio] (linear I2cBus, Integer)
  l4-i2c-bus-write-reg (bus) (addr) (reg) (val) =
   when bus
    is I2cBus (b) -> act
      r <- (l4-i2c-write-reg addr reg val)
      (I2cBus b, r)
    end

  l4-i2c-bus-read-reg : linear I2cBus, Integer, Integer -> [I2c, Device.Mmio] (linear I2cBus, Integer)
  l4-i2c-bus-read-reg (bus) (addr) (reg) =
   when bus
    is I2cBus (b) -> act
      v <- (l4-i2c-read-reg addr reg)
      (I2cBus b, v)
    end

  l4-i2c-close : linear I2cBus -> [I2c, Device.Mmio] Integer
  l4-i2c-close (bus) =
   when bus
    is I2cBus (b) -> mmio-write-32 (b + l4-i2c-cr1-off) 0

Section: Linear SPI Transaction

  l4-spi-open : linear Board -> [Spi, Device.Mmio] (linear Board, linear SpiBus)
  l4-spi-open (brd) =
   when brd
    is Board (pw) (sc) -> act
      i <- (l4-spi-init)
      (Board pw sc, SpiBus l4-spi1-base)
    end

  l4-spi-select : linear SpiBus, Integer -> [Spi, Device.Mmio] linear SpiTxn
  l4-spi-select (bus) (cs) =
   when bus
    is SpiBus (b) -> act
      w <- (l4-gpio-write l4-gpioa-base cs False)
      SpiTxn b cs
    end

  l4-spi-transfer-bytes : Integer, List Integer, Integer, Integer, List Integer -> [Device.Mmio] List Integer
  l4-spi-transfer-bytes (b) (out) (i) (len) (acc) =
   if i >= len then acc
   else act
    v <- (l4-spi-transfer (list-at out i))
    l4-spi-transfer-bytes b out (i + 1) len (list-push acc v)
   end

  l4-spi-txn-transfer : linear SpiTxn, List Integer -> [Spi, Device.Mmio] (linear SpiTxn, List Integer)
  l4-spi-txn-transfer (txn) (out) =
   when txn
    is SpiTxn (b) (cs) -> act
      got <- (l4-spi-transfer-bytes b out 0 (list-length out) [])
      (SpiTxn b cs, got)
    end

  l4-spi-deselect : linear SpiTxn -> [Spi, Device.Mmio] linear SpiBus
  l4-spi-deselect (txn) =
   when txn
    is SpiTxn (b) (cs) -> act
      w <- (l4-gpio-write l4-gpioa-base cs True)
      SpiBus b
    end

  l4-spi-close : linear SpiBus -> [Spi, Device.Mmio] Integer
  l4-spi-close (bus) =
   when bus
    is SpiBus (b) -> mmio-write-32 (b + l4-spi-cr1-off) 0

Section: I2C1 (0x40005400)

  l4-i2c1-base : Integer = #40005400
  l4-i2c-cr1-off : Integer = #00
  l4-i2c-cr2-off : Integer = #04
  l4-i2c-isr-off : Integer = #18
  l4-i2c-txdr-off : Integer = #28
  l4-i2c-rxdr-off : Integer = #24
  l4-i2c-timingr-off : Integer = #10

  l4-i2c-cr1-pe : Integer = 1
  l4-i2c-cr2-start : Integer = #2000
  l4-i2c-cr2-stop : Integer = #4000
  l4-i2c-cr2-autoend : Integer = #2000000
  l4-i2c-cr2-rd-wrn : Integer = #400
  l4-i2c-isr-txis : Integer = #02
  l4-i2c-isr-rxne : Integer = #04
  l4-i2c-isr-tc : Integer = #40
  l4-i2c-isr-stopf : Integer = #20

  l4-i2c-init : [Device.Mmio] Integer
  l4-i2c-init = act
   en-port <- l4-rcc-enable-port l4-rcc-gpiob-en
   apb1 <- mmio-read-32 (l4-rcc-base + l4-rcc-apb1enr1-off)
   en-i2c <- mmio-write-32 (l4-rcc-base + l4-rcc-apb1enr1-off) (bit-or apb1 l4-rcc-i2c1-en)
   af-scl <- l4-gpio-set-alternate l4-gpiob-base 6 4
   af-sda <- l4-gpio-set-alternate l4-gpiob-base 7 4
   timing <- (mmio-write-32 (l4-i2c1-base + l4-i2c-timingr-off) #00303D5B)
   mmio-write-32 (l4-i2c1-base + l4-i2c-cr1-off) l4-i2c-cr1-pe
  end

  l4-i2c-write-reg : Integer, Integer, Integer -> [Device.Mmio] Integer
  l4-i2c-write-reg (dev-addr) (reg) (value) =
   let cr2 = bit-or (bit-or (bit-shl dev-addr 1) (bit-shl 2 16)) (bit-or l4-i2c-cr2-start l4-i2c-cr2-autoend)
   in act
    w-cr2 <- mmio-write-32 (l4-i2c1-base + l4-i2c-cr2-off) cr2
    w1 <- l4-i2c-wait-flag l4-i2c-isr-txis 10000
    w-reg <- mmio-write-32 (l4-i2c1-base + l4-i2c-txdr-off) reg
    w2 <- (l4-i2c-wait-flag l4-i2c-isr-txis 10000)
    mmio-write-32 (l4-i2c1-base + l4-i2c-txdr-off) value
   end

  l4-i2c-read-reg : Integer, Integer -> [Device.Mmio] Integer
  l4-i2c-read-reg (dev-addr) (reg) =
   let cr2-w = bit-or (bit-shl dev-addr 1) (bit-or (bit-shl 1 16) l4-i2c-cr2-start)
   in let cr2-r = bit-or (bit-or (bit-shl dev-addr 1) l4-i2c-cr2-rd-wrn) (bit-or (bit-shl 1 16) (bit-or l4-i2c-cr2-start l4-i2c-cr2-autoend))
   in act
    w-cr2 <- mmio-write-32 (l4-i2c1-base + l4-i2c-cr2-off) cr2-w
    w1 <- l4-i2c-wait-flag l4-i2c-isr-txis 10000
    w-reg <- mmio-write-32 (l4-i2c1-base + l4-i2c-txdr-off) reg
    w2 <- l4-i2c-wait-flag l4-i2c-isr-tc 10000
    w-cr2r <- mmio-write-32 (l4-i2c1-base + l4-i2c-cr2-off) cr2-r
    w3 <- l4-i2c-wait-flag l4-i2c-isr-rxne 10000
    rxdr <- (mmio-read-32 (l4-i2c1-base + l4-i2c-rxdr-off))
    bit-and rxdr #FF
   end

  l4-i2c-wait-flag : Integer, Integer -> [Device.Mmio] Integer
  l4-i2c-wait-flag (flag) (fuel) =
   if fuel <= 0 then 0
   else act
    isr <- mmio-read-32 (l4-i2c1-base + l4-i2c-isr-off)
    if bit-and isr flag > 0 then 1
    else l4-i2c-wait-flag flag (fuel - 1)
   end

Section: ADC1 (0x50040000)

 RM0351 16.6: ISR at +0x00 (ADRDY bit 0, EOC bit 2), CR at +0x08
 (ADEN bit 0, ADDIS bit 1, ADSTART bit 2, ADVREGEN bit 28, DEEPPWD
 bit 29), SQR1 at +0x30 (first channel in bits 10:6), DR at +0x40.
 The common CCR sits at 0x50040308; CKMODE bits 17:16 = 01 clocks
 the ADC synchronously from HCLK. Clock enable is AHB2ENR bit 13.
 Wake order matters on silicon: DEEPPWD must clear before ADVREGEN
 is set, and ADEN only after the regulator is up.

  l4-adc1-base : Integer = #50040000
  l4-adc-ccr : Integer = #50040308
  l4-adc-isr-off : Integer = #00
  l4-adc-cr-off : Integer = #08
  l4-adc-sqr1-off : Integer = #30
  l4-adc-dr-off : Integer = #40

  l4-adc-isr-adrdy : Integer = 1
  l4-adc-isr-eoc : Integer = 4
  l4-adc-cr-aden : Integer = 1
  l4-adc-cr-addis : Integer = 2
  l4-adc-cr-adstart : Integer = 4
  l4-adc-cr-advregen : Integer = #10000000
  l4-adc-cr-deeppwd : Integer = #20000000
  l4-adc-ccr-ckmode-hclk : Integer = #10000
  l4-rcc-adc-en : Integer = #2000

  l4-adc-wait-flag : Integer, Integer -> [Device.Mmio] Integer
  l4-adc-wait-flag (flag) (fuel) =
   if fuel <= 0 then 0
   else act
    isr <- mmio-read-32 (l4-adc1-base + l4-adc-isr-off)
    if bit-and isr flag > 0 then 1
    else l4-adc-wait-flag flag (fuel - 1)
   end

  l4-adc1-init : [Device.Mmio] Integer
  l4-adc1-init = act
   ahb2 <- mmio-read-32 (l4-rcc-base + l4-rcc-ahb2enr-off)
   en <- mmio-write-32 (l4-rcc-base + l4-rcc-ahb2enr-off) (bit-or ahb2 l4-rcc-adc-en)
   ck <- mmio-write-32 l4-adc-ccr l4-adc-ccr-ckmode-hclk
   cr0 <- mmio-read-32 (l4-adc1-base + l4-adc-cr-off)
   wake <- mmio-write-32 (l4-adc1-base + l4-adc-cr-off) (bit-and cr0 (bit-xor l4-adc-cr-deeppwd (0 - 1)))
   vreg <- mmio-write-32 (l4-adc1-base + l4-adc-cr-off) l4-adc-cr-advregen
   den <- (mmio-write-32 (l4-adc1-base + l4-adc-cr-off) (bit-or l4-adc-cr-advregen l4-adc-cr-aden))
   l4-adc-wait-flag l4-adc-isr-adrdy 10000
  end

  l4-adc-read : Integer -> [Device.Mmio] Integer
  l4-adc-read (channel) = act
   sq <- mmio-write-32 (l4-adc1-base + l4-adc-sqr1-off) (bit-shl (bit-and channel 31) 6)
   cr <- mmio-read-32 (l4-adc1-base + l4-adc-cr-off)
   go <- mmio-write-32 (l4-adc1-base + l4-adc-cr-off) (bit-or cr l4-adc-cr-adstart)
   w <- l4-adc-wait-flag l4-adc-isr-eoc 10000
   dr <- (mmio-read-32 (l4-adc1-base + l4-adc-dr-off))
   bit-and dr #FFFF
  end

Section: Linear ADC Unit

  l4-adc-open : linear Board -> [Adc, Device.Mmio] (linear Board, linear AdcUnit)
  l4-adc-open (brd) =
   when brd
    is Board (pw) (sc) -> act
      i <- (l4-adc1-init)
      (Board pw sc, AdcUnit l4-adc1-base)
    end

  l4-adc-unit-sample : linear AdcUnit, Integer -> [Adc, Device.Mmio] (linear AdcUnit, Integer)
  l4-adc-unit-sample (adc) (channel) =
   when adc
    is AdcUnit (b) -> act
      v <- (l4-adc-read channel)
      (AdcUnit b, v)
    end

  l4-adc-close : linear AdcUnit -> [Adc, Device.Mmio] Integer
  l4-adc-close (adc) =
   when adc
    is AdcUnit (b) -> mmio-write-32 (b + l4-adc-cr-off) l4-adc-cr-addis

Section: PWR (Power Control, 0x40007000)

  l4-pwr-base : Integer = #40007000
  l4-pwr-cr1-off : Integer = #00
  l4-pwr-cr2-off : Integer = #04
  l4-pwr-sr1-off : Integer = #10
  l4-pwr-sr2-off : Integer = #14
  l4-pwr-scr-off : Integer = #18

  l4-pwr-cr1-lpms-stop0 : Integer = #000
  l4-pwr-cr1-lpms-stop1 : Integer = #001
  l4-pwr-cr1-lpms-stop2 : Integer = #002
  l4-pwr-cr1-lpms-standby : Integer = #003
  l4-pwr-cr1-lpms-shutdown : Integer = #004
  l4-pwr-cr1-lpms-mask : Integer = #007

  l4-pwr-enable : [Device.Mmio] Integer
  l4-pwr-enable = act
   apb1 <- (mmio-read-32 (l4-rcc-base + l4-rcc-apb1enr1-off))
   mmio-write-32 (l4-rcc-base + l4-rcc-apb1enr1-off) (bit-or apb1 l4-rcc-pwr-en)
  end

  l4-pwr-set-mode : Integer -> [Device.Mmio] Integer
  l4-pwr-set-mode (mode) = act
   cr1 <- (mmio-read-32 (l4-pwr-base + l4-pwr-cr1-off))
   mmio-write-32 (l4-pwr-base + l4-pwr-cr1-off) (bit-or (bit-and cr1 (bit-xor l4-pwr-cr1-lpms-mask (0 - 1))) mode)
  end

  l4-pwr-get-mode : [Device.Mmio] Integer
  l4-pwr-get-mode = act
   cr1 <- (mmio-read-32 (l4-pwr-base + l4-pwr-cr1-off))
   bit-and cr1 l4-pwr-cr1-lpms-mask
  end

Section: LPTIM1 (Low-Power Timer, 0x40007C00)

  l4-lptim1-base : Integer = #40007C00
  l4-lptim-isr-off : Integer = #00
  l4-lptim-icr-off : Integer = #04
  l4-lptim-cr-off : Integer = #10
  l4-lptim-cmp-off : Integer = #14
  l4-lptim-arr-off : Integer = #18
  l4-lptim-cfgr-off : Integer = #0C

  l4-lptim-cr-enable : Integer = 1
  l4-lptim-cr-sngstrt : Integer = 2

  l4-lptim-init : [Device.Mmio] Integer
  l4-lptim-init = act
   apb1 <- mmio-read-32 (l4-rcc-base + l4-rcc-apb1enr1-off)
   en <- (mmio-write-32 (l4-rcc-base + l4-rcc-apb1enr1-off) (bit-or apb1 l4-rcc-lptim1-en))
   mmio-write-32 (l4-lptim1-base + l4-lptim-cr-off) l4-lptim-cr-enable
  end

  l4-lptim-set-autoreload : Integer -> [Device.Mmio] Integer
  l4-lptim-set-autoreload (value) =
   mmio-write-32 (l4-lptim1-base + l4-lptim-arr-off) value

  l4-lptim-set-compare : Integer -> [Device.Mmio] Integer
  l4-lptim-set-compare (value) =
   mmio-write-32 (l4-lptim1-base + l4-lptim-cmp-off) value

  l4-lptim-start-single : [Device.Mmio] Integer
  l4-lptim-start-single = act
   cr <- (mmio-read-32 (l4-lptim1-base + l4-lptim-cr-off))
   mmio-write-32 (l4-lptim1-base + l4-lptim-cr-off) (bit-or cr l4-lptim-cr-sngstrt)
  end

Section: Sleep Entry Sequence

 Full sleep preparation per RM0351 §5.3. On real hardware the
 final step is WFI (Wait For Interrupt), which halts the CPU until
 an interrupt fires. Everything before WFI is register setup that
 we can test; WFI itself is a single ARM instruction that would
 halt the VM, so we stop one step short.

  l4-scb-base : Integer = #E000ED00
  l4-scb-scr-off : Integer = #10
  l4-scb-scr-sleepdeep : Integer = #04
  l4-scb-scr-sleeponexit : Integer = #02

  l4-pwr-scr-cwuf : Integer = #1F

  SleepMode =
    | SleepStop0
    | SleepStop1
    | SleepStop2
    | SleepStandby
    | SleepShutdown

  l4-sleep-mode-code : SleepMode -> Integer
  l4-sleep-mode-code (m) =
   when m
    is SleepStop0 -> l4-pwr-cr1-lpms-stop0
    is SleepStop1 -> l4-pwr-cr1-lpms-stop1
    is SleepStop2 -> l4-pwr-cr1-lpms-stop2
    is SleepStandby -> l4-pwr-cr1-lpms-standby
    is SleepShutdown -> l4-pwr-cr1-lpms-shutdown

  l4-sleep-prepare : SleepMode, Integer -> [Device.Mmio] Integer
  l4-sleep-prepare (mode) (lptim-wakeup-ticks) = act
   pwr <- l4-pwr-enable
   set-mode <- l4-pwr-set-mode (l4-sleep-mode-code mode)
   clear-wuf <- mmio-write-32 (l4-pwr-base + l4-pwr-scr-off) l4-pwr-scr-cwuf
   scr <- mmio-read-32 (l4-scb-base + l4-scb-scr-off)
   set-deep <- mmio-write-32 (l4-scb-base + l4-scb-scr-off) (bit-or scr l4-scb-scr-sleepdeep)
   timer <- l4-lptim-init
   arr <- l4-lptim-set-autoreload lptim-wakeup-ticks
   cmp <- l4-lptim-set-compare (lptim-wakeup-ticks / 2)
   start <- (l4-lptim-start-single)
   1
  end

  l4-sleep-restore : [Device.Mmio] Integer
  l4-sleep-restore = act
   scr <- mmio-read-32 (l4-scb-base + l4-scb-scr-off)
   clr-deep <- mmio-write-32 (l4-scb-base + l4-scb-scr-off) (bit-and scr (bit-xor l4-scb-scr-sleepdeep (0 - 1)))
   restore-clock <- (l4-rcc-set-msi-range 6)
   1
  end

  l4-sleep-mode-name : SleepMode -> Text
  l4-sleep-mode-name (m) =
   when m
    is SleepStop0 -> "Stop0"
    is SleepStop1 -> "Stop1"
    is SleepStop2 -> "Stop2"
    is SleepStandby -> "Standby"
    is SleepShutdown -> "Shutdown"

Section: LED (Nucleo-L476RG: PA5)

  l4-led-pin : Integer = 5

  l4-led-init : [Device.Mmio] Integer
  l4-led-init = act
   en <- (l4-rcc-enable-port l4-rcc-gpioa-en)
   l4-gpio-set-output l4-gpioa-base l4-led-pin
  end

  l4-led-on : [Device.Mmio] Integer
  l4-led-on = l4-gpio-write l4-gpioa-base l4-led-pin True

  l4-led-off : [Device.Mmio] Integer
  l4-led-off = l4-gpio-write l4-gpioa-base l4-led-pin False

Section: Delay

  l4-delay-loops : Integer, Integer -> Integer
  l4-delay-loops (n) (i) =
   if i >= n then 0
   else l4-delay-loops n (i + 1)

  l4-delay-ms : Duration -> Integer
  l4-delay-ms (ms) = l4-delay-loops (ms * 2000) 0

