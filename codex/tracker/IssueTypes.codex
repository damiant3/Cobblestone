Chapter: IssueTypes

 Core types for issue tracking. Status workflow, priority levels,
 labels, estimates, and the Issue record. Designed to be cited by
 any app that needs project management — TrackerApp, web apps,
 CLI tools, or the workflow engine.

 We say:

Section: Issue Status
  IssueStatus =
    | StatusBacklog
    | StatusTodo
    | StatusInProgress
    | StatusInReview
    | StatusDone
    | StatusCancelled

  issue-status-id : IssueStatus -> Integer
  issue-status-id (s) =
    when s
      is StatusBacklog -> 0
      is StatusTodo -> 1
      is StatusInProgress -> 2
      is StatusInReview -> 3
      is StatusDone -> 4
      is StatusCancelled -> 5

  issue-status-from-id : Integer -> IssueStatus
  issue-status-from-id (id) =
    if id == 0 then StatusBacklog
    else if id == 1 then StatusTodo
    else if id == 2 then StatusInProgress
    else if id == 3 then StatusInReview
    else if id == 4 then StatusDone
    else StatusCancelled

  issue-status-name : IssueStatus -> Text
  issue-status-name (s) =
    when s
      is StatusBacklog -> "Backlog"
      is StatusTodo -> "Todo"
      is StatusInProgress -> "In Progress"
      is StatusInReview -> "In Review"
      is StatusDone -> "Done"
      is StatusCancelled -> "Cancelled"

  issue-status-next : IssueStatus -> IssueStatus
  issue-status-next (s) =
    when s
      is StatusBacklog -> StatusTodo
      is StatusTodo -> StatusInProgress
      is StatusInProgress -> StatusInReview
      is StatusInReview -> StatusDone
      is StatusDone -> StatusCancelled
      is StatusCancelled -> StatusBacklog

  issue-status-is-open : IssueStatus -> Boolean
  issue-status-is-open (s) =
    when s
      is StatusDone -> False
      is StatusCancelled -> False
      is otherwise -> True

Section: Priority
  IssuePriority =
    | PriorityUrgent
    | PriorityHigh
    | PriorityMedium
    | PriorityLow
    | PriorityNone

  issue-priority-id : IssuePriority -> Integer
  issue-priority-id (p) =
    when p
      is PriorityUrgent -> 0
      is PriorityHigh -> 1
      is PriorityMedium -> 2
      is PriorityLow -> 3
      is PriorityNone -> 4

  issue-priority-from-id : Integer -> IssuePriority
  issue-priority-from-id (id) =
    if id == 0 then PriorityUrgent
    else if id == 1 then PriorityHigh
    else if id == 2 then PriorityMedium
    else if id == 3 then PriorityLow
    else PriorityNone

  issue-priority-name : IssuePriority -> Text
  issue-priority-name (p) =
    when p
      is PriorityUrgent -> "Urgent"
      is PriorityHigh -> "High"
      is PriorityMedium -> "Medium"
      is PriorityLow -> "Low"
      is PriorityNone -> "None"

  issue-priority-next : IssuePriority -> IssuePriority
  issue-priority-next (p) =
    when p
      is PriorityUrgent -> PriorityHigh
      is PriorityHigh -> PriorityMedium
      is PriorityMedium -> PriorityLow
      is PriorityLow -> PriorityNone
      is PriorityNone -> PriorityUrgent

Section: Issue
  Issue = record {
    issue-id : Integer,
    issue-key : Text,
    issue-title : Text,
    issue-status : IssueStatus,
    issue-priority : IssuePriority,
    issue-label : Text,
    issue-assignee : Text,
    issue-project : Text,
    issue-cycle : Text,
    issue-estimate : Integer,
    issue-description : Text,
    issue-created : Text
  }

Section: Project
  Project = record {
    project-id : Integer,
    project-name : Text,
    project-lead : Text,
    project-color : Integer
  }

Section: Cycle (Sprint)
  Cycle = record {
    cycle-id : Integer,
    cycle-name : Text,
    cycle-start : Text,
    cycle-end : Text,
    cycle-active : Boolean
  }

Section: Label
  Label = record {
    label-id : Integer,
    label-name : Text,
    label-color : Integer
  }

Section: Construction
  issue-new : Integer, Text, Text -> Issue
  issue-new (id) (key) (title) = Issue {
    issue-id = id,
    issue-key = key,
    issue-title = title,
    issue-status = StatusBacklog,
    issue-priority = PriorityNone,
    issue-label = "",
    issue-assignee = "",
    issue-project = "",
    issue-cycle = "",
    issue-estimate = 0,
    issue-description = "",
    issue-created = ""
  }

  project-new : Integer, Text, Text -> Project
  project-new (id) (name) (lead) = Project {
    project-id = id,
    project-name = name,
    project-lead = lead,
    project-color = 0
  }

  cycle-new : Integer, Text, Text, Text -> Cycle
  cycle-new (id) (name) (start) (end) = Cycle {
    cycle-id = id,
    cycle-name = name,
    cycle-start = start,
    cycle-end = end,
    cycle-active = False
  }

Section: Formatting
  format-issue : Issue -> Text
  format-issue (i) =
    i.issue-key & " [" & issue-status-name (i.issue-status) & "] " & i.issue-title

  format-project : Project -> Text
  format-project (p) = p.project-name & " (lead: " & p.project-lead & ")"

  format-cycle : Cycle -> Text
  format-cycle (c) = c.cycle-name & " " & c.cycle-start & " to " & c.cycle-end & (if c.cycle-active then " [active]" else "")

