 End-to-end text-to-image diffusion pipeline. Composes the text
 encoder, UNet, noise scheduler, and VAE decoder into a single
 inference function. Implements classifier-free guidance.

 Pipeline: tokenize -> encode text -> sample noise -> denoise loop
 -> decode latents -> output image.

 Fixed-point (scale 1000). SD 1.5 architecture (512x512 output).

 We say:

Section: Types
  PipelineConfig = record {
    pc-width : Integer,
    pc-height : Integer,
    pc-num-steps : Integer,
    pc-guidance-scale : Integer,
    pc-seed : Integer,
    pc-latent-channels : Integer,
    pc-latent-scale : Integer
  }

  PipelineState = record {
    ps-config : PipelineConfig,
    ps-text-encoder : TextEncoderState,
    ps-unet : UNetState,
    ps-scheduler : NoiseSchedule,
    ps-vae-decoder-w : List Integer,
    ps-vae-decoder-b : List Integer,
    ps-tokenizer : BpeTokenizer
  }

  PipelineOutput = record {
    po-pixels : List Integer,
    po-width : Integer,
    po-height : Integer,
    po-steps-completed : Integer
  }

Section: Default Configuration
  sd15-pipeline-config : PipelineConfig
  sd15-pipeline-config = PipelineConfig {
    pc-width = 512,
    pc-height = 512,
    pc-num-steps = 20,
    pc-guidance-scale = 7500,
    pc-seed = 42,
    pc-latent-channels = 4,
    pc-latent-scale = 8
  }

Section: Pipeline Entry Point
  pipeline-generate : Text, PipelineState -> PipelineOutput
  pipeline-generate (prompt) (state) =
    let cfg = state.ps-config
    in let latent-h = cfg.pc-height / cfg.pc-latent-scale
    in let latent-w = cfg.pc-width / cfg.pc-latent-scale
    in let text-cond = te-encode prompt (state.ps-tokenizer) (state.ps-text-encoder)
    in let uncond = te-encode "" (state.ps-tokenizer) (state.ps-text-encoder)
    in let noise = img-noise-tensor (cfg.pc-latent-channels) latent-h latent-w (cfg.pc-seed)
    in let denoised = pipeline-denoise-loop state noise text-cond uncond latent-h latent-w (cfg.pc-num-steps - 1)
    in let decoded = pipeline-decode-latents state denoised latent-h latent-w
    in PipelineOutput { po-pixels = decoded, po-width = cfg.pc-width, po-height = cfg.pc-height, po-steps-completed = cfg.pc-num-steps }

Section: Denoising Loop
  pipeline-denoise-loop : PipelineState, List Integer, List Integer, List Integer, Integer, Integer, Integer -> List Integer
  pipeline-denoise-loop (state) (latents) (text-cond) (uncond) (h) (w) (t) =
    if t < 0 then latents
    else let cfg = state.ps-config
    in let noise-pred-cond = unet-forward (state.ps-unet) latents t text-cond h w
    in let noise-pred-uncond = unet-forward (state.ps-unet) latents t uncond h w
    in let guided = pipeline-cfg-combine noise-pred-cond noise-pred-uncond (cfg.pc-guidance-scale) 0 (list-length noise-pred-cond) []
    in let stepped = diffusion-ddim-step latents guided t (t - 1) (state.ps-scheduler)
    in pipeline-denoise-loop state stepped text-cond uncond h w (t - 1)

Section: Classifier-Free Guidance
  pipeline-cfg-combine : List Integer, List Integer, Integer, Integer, Integer, List Integer -> List Integer
  pipeline-cfg-combine (cond) (uncond) (scale) (i) (n) (acc) =
    if i >= n then acc
    else let c = list-at cond i
    in let u = list-at uncond i
    in let guided = u + (c - u) * scale / 1000
    in pipeline-cfg-combine cond uncond scale (i + 1) n (list-push acc guided)

Section: Latent Decoding (simplified VAE decoder)
  pipeline-decode-latents : PipelineState, List Integer, Integer, Integer -> List Integer
  pipeline-decode-latents (state) (latents) (h) (w) =
    let cfg = state.ps-config
    in let scaled = pipeline-scale-latents latents 0 (list-length latents) []
    in let up1 = upsample-nearest scaled (cfg.pc-latent-channels) h w
    in let h2 = h * 2
    in let w2 = w * 2
    in let up2 = upsample-nearest up1 (cfg.pc-latent-channels) h2 w2
    in let h4 = h2 * 2
    in let w4 = w2 * 2
    in let up3 = upsample-nearest up2 (cfg.pc-latent-channels) h4 w4
    in let final-h = h4 * 2
    in let final-w = w4 * 2
    in pipeline-latent-to-rgb up3 (cfg.pc-latent-channels) final-h final-w

  pipeline-scale-latents : List Integer, Integer, Integer, List Integer -> List Integer
  pipeline-scale-latents (latents) (i) (n) (acc) =
    if i >= n then acc
    else let val = list-at latents i * 1000 / 18215
    in pipeline-scale-latents latents (i + 1) n (list-push acc val)

  pipeline-latent-to-rgb : List Integer, Integer, Integer, Integer -> List Integer
  pipeline-latent-to-rgb (data) (channels) (h) (w) =
    let spatial = h * w
    in pipeline-rgb-loop data channels spatial h w 0 []

  pipeline-rgb-loop : List Integer, Integer, Integer, Integer, Integer, Integer, List Integer -> List Integer
  pipeline-rgb-loop (data) (channels) (spatial) (h) (w) (i) (acc) =
    if i >= spatial then acc
    else let r = pipeline-channel-at data 0 spatial i
    in let g = if channels > 1 then pipeline-channel-at data 1 spatial i else r
    in let b = if channels > 2 then pipeline-channel-at data 2 spatial i else r
    in let r-byte = pipeline-clamp-byte ((r + 1000) * 255 / 2000)
    in let g-byte = pipeline-clamp-byte ((g + 1000) * 255 / 2000)
    in let b-byte = pipeline-clamp-byte ((b + 1000) * 255 / 2000)
    in let pixel = r-byte * 65536 + g-byte * 256 + b-byte
    in pipeline-rgb-loop data channels spatial h w (i + 1) (list-push acc pixel)

  pipeline-channel-at : List Integer, Integer, Integer, Integer -> Integer
  pipeline-channel-at (data) (ch) (spatial) (i) =
    if ch * spatial + i < list-length data then list-at data (ch * spatial + i) else 0

  pipeline-clamp-byte : Integer -> Integer
  pipeline-clamp-byte (v) =
    if v < 0 then 0
    else if v > 255 then 255
    else v

Section: Pipeline to PNG
  pipeline-to-png : PipelineOutput -> List Integer
  pipeline-to-png (output) =
    let pixels = pipeline-output-to-rgb output 0 (output.po-width * output.po-height) []
    in png-encode (output.po-width) (output.po-height) pixels

  pipeline-output-to-rgb : PipelineOutput, Integer, Integer, List Rgb -> List Rgb
  pipeline-output-to-rgb (output) (i) (n) (acc) =
    if i >= n then acc
    else let packed = list-at (output.po-pixels) i
    in let r = bit-and (bit-shru packed 16) 255
    in let g = bit-and (bit-shru packed 8) 255
    in let b = bit-and packed 255
    in pipeline-output-to-rgb output (i + 1) n (list-push acc (Rgb { cr = r, cg = g, cb = b }))

Section: Batch Generation
  pipeline-generate-batch : List Text, PipelineState -> List PipelineOutput
  pipeline-generate-batch (prompts) (state) =
    pipeline-batch-loop prompts state 0 (list-length prompts) []

  pipeline-batch-loop : List Text, PipelineState, Integer, Integer, List PipelineOutput -> List PipelineOutput
  pipeline-batch-loop (prompts) (state) (i) (n) (acc) =
    if i >= n then acc
    else let seed-state = PipelineState {
        ps-config = PipelineConfig {
          pc-width = (state.ps-config.pc-width),
          pc-height = (state.ps-config.pc-height),
          pc-num-steps = (state.ps-config.pc-num-steps),
          pc-guidance-scale = (state.ps-config.pc-guidance-scale),
          pc-seed = (state.ps-config.pc-seed) + i * 1000,
          pc-latent-channels = (state.ps-config.pc-latent-channels),
          pc-latent-scale = (state.ps-config.pc-latent-scale)
        },
        ps-text-encoder = state.ps-text-encoder,
        ps-unet = state.ps-unet,
        ps-scheduler = state.ps-scheduler,
        ps-vae-decoder-w = state.ps-vae-decoder-w,
        ps-vae-decoder-b = state.ps-vae-decoder-b,
        ps-tokenizer = state.ps-tokenizer
      }
    in let output = pipeline-generate (list-at prompts i) seed-state
    in pipeline-batch-loop prompts state (i + 1) n (list-push acc output)

Section: Image-to-Image (img2img)
  pipeline-img2img : Text, ImageData, Integer, PipelineState -> PipelineOutput
  pipeline-img2img (prompt) (init-image) (strength) (state) =
    let cfg = state.ps-config
    in let latent-h = cfg.pc-height / cfg.pc-latent-scale
    in let latent-w = cfg.pc-width / cfg.pc-latent-scale
    in let resized = image-resize init-image (cfg.pc-width) (cfg.pc-height)
    in let img-tensor = image-to-tensor resized
    in let init-latents = pipeline-encode-to-latent img-tensor (cfg.pc-latent-channels) latent-h latent-w
    in let text-cond = te-encode prompt (state.ps-tokenizer) (state.ps-text-encoder)
    in let uncond = te-encode "" (state.ps-tokenizer) (state.ps-text-encoder)
    in let start-step = cfg.pc-num-steps - (cfg.pc-num-steps * strength / 1000)
    in let noise = img-noise-tensor (cfg.pc-latent-channels) latent-h latent-w (cfg.pc-seed)
    in let noised = pipeline-add-init-noise init-latents noise start-step (state.ps-scheduler) 0 (list-length init-latents) []
    in let denoised = pipeline-img2img-loop state noised text-cond uncond latent-h latent-w (cfg.pc-num-steps - 1) start-step
    in let decoded = pipeline-decode-latents state denoised latent-h latent-w
    in PipelineOutput { po-pixels = decoded, po-width = cfg.pc-width, po-height = cfg.pc-height, po-steps-completed = cfg.pc-num-steps - start-step }

  pipeline-img2img-loop : PipelineState, List Integer, List Integer, List Integer, Integer, Integer, Integer, Integer -> List Integer
  pipeline-img2img-loop (state) (latents) (text-cond) (uncond) (h) (w) (t) (start-step) =
    if t < start-step then latents
    else let cfg = state.ps-config
    in let noise-pred-cond = unet-forward (state.ps-unet) latents t text-cond h w
    in let noise-pred-uncond = unet-forward (state.ps-unet) latents t uncond h w
    in let guided = pipeline-cfg-combine noise-pred-cond noise-pred-uncond (cfg.pc-guidance-scale) 0 (list-length noise-pred-cond) []
    in let stepped = diffusion-ddim-step latents guided t (t - 1) (state.ps-scheduler)
    in pipeline-img2img-loop state stepped text-cond uncond h w (t - 1) start-step

  pipeline-encode-to-latent : List Integer, Integer, Integer, Integer -> List Integer
  pipeline-encode-to-latent (img-data) (channels) (lat-h) (lat-w) =
    let spatial = lat-h * lat-w
    in let total = channels * spatial
    in let src-h = lat-h * 8
    in let src-w = lat-w * 8
    in pipeline-downsample-to-latent img-data src-h src-w channels lat-h lat-w 0 []

  pipeline-downsample-to-latent : List Integer, Integer, Integer, Integer, Integer, Integer, Integer, List Integer -> List Integer
  pipeline-downsample-to-latent (data) (src-h) (src-w) (channels) (lat-h) (lat-w) (i) (acc) =
    if i >= channels * lat-h * lat-w then acc
    else let ch = i / (lat-h * lat-w)
    in let pos = i - ch * lat-h * lat-w
    in let ly = pos / lat-w
    in let lx = pos - ly * lat-w
    in let sy = ly * 8
    in let sx = lx * 8
    in let src-ch = if ch < 3 then ch else 0
    in let val = if src-ch * src-h * src-w + sy * src-w + sx < list-length data then list-at data (src-ch * src-h * src-w + sy * src-w + sx) else 0
    in pipeline-downsample-to-latent data src-h src-w channels lat-h lat-w (i + 1) (list-push acc val)

  pipeline-add-init-noise : List Integer, List Integer, Integer, NoiseSchedule, Integer, Integer, List Integer -> List Integer
  pipeline-add-init-noise (latents) (noise) (t) (schedule) (i) (n) (acc) =
    if i >= n then acc
    else let abar = list-at (schedule.ns-alpha-cumprod) t
    in let sqrt-ab = pipeline-isqrt (abar * 1000)
    in let sqrt-one-minus = pipeline-isqrt ((1000 - abar) * 1000)
    in let val = list-at latents i * sqrt-ab / 1000 + list-at noise i * sqrt-one-minus / 1000
    in pipeline-add-init-noise latents noise t schedule (i + 1) n (list-push acc val)

  pipeline-isqrt : Integer -> Integer
  pipeline-isqrt (n) = if n <= 0 then 0 else pipeline-isqrt-loop n (n / 2 + 1)

  pipeline-isqrt-loop : Integer, Integer -> Integer
  pipeline-isqrt-loop (n) (guess) =
    let next = (guess + n / guess) / 2
    in if next >= guess then guess else pipeline-isqrt-loop n next

Section: Queries
  format-pipeline-config : PipelineConfig -> Text
  format-pipeline-config (cfg) =
    show (cfg.pc-width) & "x" & show (cfg.pc-height) & " steps=" & show (cfg.pc-num-steps) & " cfg=" & show (cfg.pc-guidance-scale) & " seed=" & show (cfg.pc-seed)

  format-pipeline-output : PipelineOutput -> Text
  format-pipeline-output (out) =
    show (out.po-width) & "x" & show (out.po-height) & " (" & show (out.po-steps-completed) & " steps)"

