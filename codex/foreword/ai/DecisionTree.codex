Chapter: DecisionTree
  cites Foreword chapter Maybe

 Decision tree classifier. Nodes split on a single feature at a
 threshold. Leaves hold class labels. Supports predict and tree
 traversal. Trees are built externally and loaded as node arrays.

 We say:

Section: Types
  DtNode =
    | DtLeaf (Integer)
    | DtSplit (Integer) (Integer) (Integer) (Integer)

  DecisionTree = record {
    dt-nodes : List DtNode,
    dt-count : Integer
  }

Section: Construction
  dt-leaf : Integer -> DtNode
  dt-leaf (label) = DtLeaf label

  dt-split : Integer, Integer, Integer, Integer -> DtNode
  dt-split (feature) (threshold) (left) (right) = DtSplit feature threshold left right

  dt-new : List DtNode -> DecisionTree
  dt-new (nodes) = DecisionTree { dt-nodes = nodes, dt-count = list-length nodes }

Section: Prediction
  dt-predict : DecisionTree, List Integer -> Integer
  dt-predict (tree) (features) = dt-walk (tree.dt-nodes) features 0

  dt-walk : List DtNode, List Integer, Integer -> Integer
  dt-walk (nodes) (features) (idx) =
    let node = list-at nodes idx
    in when node
      is DtLeaf (label) -> label
      is DtSplit (feat) (thresh) (left) (right) ->
        if list-at features feat < thresh then dt-walk nodes features left
        else dt-walk nodes features right

Section: Tree Info
  dt-depth : DecisionTree -> Integer
  dt-depth (tree) = dt-depth-at (tree.dt-nodes) 0

  dt-depth-at : List DtNode, Integer -> Integer
  dt-depth-at (nodes) (idx) =
    let node = list-at nodes idx
    in when node
      is DtLeaf (label) -> 1
      is DtSplit (feat) (thresh) (left) (right) ->
        let dl = dt-depth-at nodes left
        in let dr = dt-depth-at nodes right
        in 1 + (if dl > dr then dl else dr)

  dt-leaf-count : DecisionTree -> Integer
  dt-leaf-count (tree) = dt-count-leaves (tree.dt-nodes) 0 (tree.dt-count) 0

  dt-count-leaves : List DtNode, Integer, Integer, Integer -> Integer
  dt-count-leaves (nodes) (i) (len) (acc) =
    if i >= len then acc
    else let node = list-at nodes i
    in let is-leaf = when node is DtLeaf (l) -> 1 is DtSplit (f) (t) (l) (r) -> 0
    in dt-count-leaves nodes (i + 1) len (acc + is-leaf)

Section: Formatting
  format-dt-node : DtNode -> Text
  format-dt-node (n) = when n
    is DtLeaf (label) -> "leaf:" & show label
    is DtSplit (feat) (thresh) (left) (right) -> "split(f" & show feat & "<" & show thresh & " L=" & show left & " R=" & show right & ")"

