Chapter: SafeTensors
  cites AI chapter Tensor
  cites Foreword chapter Maybe
  cites Foreword chapter CCE
  cites Encode chapter Json

 Format:
   [8 bytes: header length N, little-endian u64]
   [N bytes: JSON header]
   [remaining: raw tensor data, contiguous]

 The JSON header maps tensor names to:
   {"dtype": "F16"|"F32"|"BF16"|"I32"|"I8",
    "shape": [dim0, dim1, ...],
    "data_offsets": [start, end]}

 Data offsets are relative to the first byte after the header.

 We say:

Section: Constants
  st-dtype-f32 : Integer = 0
  st-dtype-f16 : Integer = 1
  st-dtype-bf16 : Integer = 2
  st-dtype-i32 : Integer = 3
  st-dtype-i8 : Integer = 4
  st-dtype-f8-e4m3 : Integer = 5
  st-dtype-f8-e5m2 : Integer = 6
  st-dtype-unknown : Integer = 99

 An fp8 NaN or infinity has no fixed-point value, so it decodes to a sentinel
 outside every finite fp8 value times 1000 (448,000 and 57,344,000 are the
 largest): NaN is the smallest 64-bit integer, infinity the largest or its
 negation.

  st-f8-nan : Integer = 0 - 9223372036854775807 - 1
  st-f8-inf : Integer = 9223372036854775807

Section: Types
  SafeTensorFile = record {
    st-header-len : Integer,
    st-data-offset : Integer,
    st-tensors : List StTensorMeta,
    st-tensor-count : Integer,
    st-valid : Boolean
  }

  StTensorMeta = record {
    stm-name : Text,
    stm-dtype : Integer,
    stm-shape : List Integer,
    stm-ndim : Integer,
    stm-offset-start : Integer,
    stm-offset-end : Integer
  }

Section: Read Bounds

 The offset is st-data-offset plus stm-offset-start and the count is the product
 of the declared shape, all three taken from the file's own JSON header. The
 test is written subtractively, count <= (length - off) / width, so a shape
 whose product overflows a 64-bit integer cannot pass it by wrapping to a small
 number.

  st-can-read : List Integer, Integer, Integer, Integer -> Boolean
  st-can-read (data) (off) (count) (width) =
    if off < 0 then False
    else if count < 0 then False
    else if width <= 0 then False
    else if off > list-length data then False
    else count <= (list-length data - off) / width

Section: Byte Reading
  st-read-u32 : List Integer, Integer -> Integer
  st-read-u32 (data) (off) =
    let b0 = list-at data off
    in let b1 = bit-shl (list-at data (off + 1)) 8
    in let b2 = bit-shl (list-at data (off + 2)) 16
    in let b3 = bit-shl (list-at data (off + 3)) 24
    in bit-or b0 (bit-or b1 (bit-or b2 b3))

  st-read-u64 : List Integer, Integer -> Integer
  st-read-u64 (data) (off) =
    let lo = st-read-u32 data off
    in let hi = st-read-u32 data (off + 4)
    in lo + hi * 4294967296

Section: Header Parsing
  st-parse-file : List Integer -> SafeTensorFile
  st-parse-file (data) =
    if list-length data < 8 then
      SafeTensorFile {
        st-header-len = 0,
        st-data-offset = 0,
        st-tensors = [],
        st-tensor-count = 0,
        st-valid = False
      }
    else let hlen = st-read-u64 data 0
    in let data-off = 8 + hlen
    in let header-text = st-extract-text data 8 hlen ""
    in let parsed = json-parse header-text
    in when parsed
      is Just (jv) -> st-build-file hlen data-off jv
      is None -> SafeTensorFile {
        st-header-len = hlen,
        st-data-offset = data-off,
        st-tensors = [],
        st-tensor-count = 0,
        st-valid = False
      }

  st-build-file : Integer, Integer, JsonValue -> SafeTensorFile
  st-build-file (hlen) (data-off) (jv) =
    when jv
      is JsonObject (pairs) ->
        let tensors = st-parse-tensor-pairs pairs 0 (list-length pairs) []
        in SafeTensorFile {
          st-header-len = hlen,
          st-data-offset = data-off,
          st-tensors = tensors,
          st-tensor-count = list-length tensors,
          st-valid = True
        }
      is otherwise -> SafeTensorFile {
        st-header-len = hlen,
        st-data-offset = data-off,
        st-tensors = [],
        st-tensor-count = 0,
        st-valid = False
      }

  st-parse-tensor-pairs : List JsonPair, Integer, Integer, List StTensorMeta -> List StTensorMeta
  st-parse-tensor-pairs (pairs) (i) (len) (acc) =
    if i >= len then acc
    else let p = list-at pairs i
    in if p.key == "__metadata__" then st-parse-tensor-pairs pairs (i + 1) len acc
    else let meta = st-parse-one-tensor (p.key) (p.value)
    in st-parse-tensor-pairs pairs (i + 1) len (list-push acc meta)

  st-parse-one-tensor : Text, JsonValue -> StTensorMeta
  st-parse-one-tensor (name) (v) =
    let dtype = st-parse-dtype (json-get-str v "dtype" "F32")
    in let shape = st-parse-shape (json-get v "shape")
    in let offsets = st-parse-offsets (json-get v "data_offsets")
    in StTensorMeta {
      stm-name = name,
      stm-dtype = dtype,
      stm-shape = shape.st-dims,
      stm-ndim = shape.st-ndim,
      stm-offset-start = offsets.st-off-start,
      stm-offset-end = offsets.st-off-end
    }

Section: Header In Memory

 The header of a checkpoint read from a file sits in guest memory at addr, its
 hlen JSON bytes and no length prefix. The JSON is UTF-8 and every tensor name
 is ASCII, therefore a byte past 127 can only sit inside a __metadata__ string;
 such a byte is dropped, as is every ASCII byte CCE cannot carry.

  st-parse-header-at : Integer, Integer -> SafeTensorFile
  st-parse-header-at (addr) (hlen) =
    let rev = st-ascii-to-cce cce-to-unicode-table 0 (st-minus-ones 0 (__list-with-capacity 128))
    in let text = raw-bytes-to-text (st-header-codes addr 0 hlen rev (__list-with-capacity (hlen + 1)))
    in let parsed = json-parse text
    in when parsed
      is Just (jv) -> st-build-file hlen (8 + hlen) jv
      is None -> SafeTensorFile {
        st-header-len = hlen,
        st-data-offset = 8 + hlen,
        st-tensors = [],
        st-tensor-count = 0,
        st-valid = False
      }

  st-minus-ones : Integer, List Integer -> List Integer
  st-minus-ones (i) (acc) = if i >= 128 then acc else st-minus-ones (i + 1) (list-push acc (0 - 1))

  st-ascii-to-cce : List Integer, Integer, List Integer -> List Integer
  st-ascii-to-cce (tbl) (i) (rev) =
    if i >= 128 then rev
    else let u = list-at tbl i
    in let r = if u >= 0 & u < 128 then list-set-at rev u i else rev
    in st-ascii-to-cce tbl (i + 1) r

  st-header-codes : Integer, Integer, Integer, List Integer, List Integer -> List Integer
  st-header-codes (addr) (i) (n) (rev) (acc) =
    if i >= n then acc
    else let b = peek-byte addr i
    in let c = if b < 128 then list-at rev b else 0 - 1
    in if c < 0 then st-header-codes addr (i + 1) n rev acc
    else st-header-codes addr (i + 1) n rev (list-push acc c)

Section: Dtype Parsing
  st-parse-dtype : Text -> Integer
  st-parse-dtype (s) =
    if s == "F32" then st-dtype-f32
    else if s == "F16" then st-dtype-f16
    else if s == "BF16" then st-dtype-bf16
    else if s == "I32" then st-dtype-i32
    else if s == "I8" then st-dtype-i8
    else if s == "F8_E4M3" then st-dtype-f8-e4m3
    else if s == "F8_E5M2" then st-dtype-f8-e5m2
    else st-dtype-unknown

Section: Shape Parsing
  StShape = record { st-dims : List Integer, st-ndim : Integer }

  st-parse-shape : Maybe JsonValue -> StShape
  st-parse-shape (mv) =
    when mv
      is Just (jv) ->
        when jv
          is JsonArray (items) -> StShape {
            st-dims = st-extract-ints items 0 (list-length items) [],
            st-ndim = list-length items
          }
          is otherwise -> StShape { st-dims = [], st-ndim = 0 }
      is None -> StShape { st-dims = [], st-ndim = 0 }

  st-extract-ints : List JsonValue, Integer, Integer, List Integer -> List Integer
  st-extract-ints (items) (i) (len) (acc) =
    if i >= len then acc
    else let v = list-at items i
    in let n = when v
        is JsonInt (x) -> x
        is JsonNum (x) -> json-num-to-int x
        is otherwise -> 0
    in st-extract-ints items (i + 1) len (list-push acc n)

Section: Offset Parsing
  StOffsets = record { st-off-start : Integer, st-off-end : Integer }

  st-parse-offsets : Maybe JsonValue -> StOffsets
  st-parse-offsets (mv) =
    when mv
      is Just (jv) ->
        when jv
          is JsonArray (items) ->
            if list-length items >= 2 then
              let s = list-at items 0
              in let e = list-at items 1
              in StOffsets { st-off-start = st-json-to-int s, st-off-end = st-json-to-int e }
            else StOffsets { st-off-start = 0, st-off-end = 0 }
          is otherwise -> StOffsets { st-off-start = 0, st-off-end = 0 }
      is None -> StOffsets { st-off-start = 0, st-off-end = 0 }

  st-json-to-int : JsonValue -> Integer
  st-json-to-int (v) =
    when v
      is JsonInt (n) -> n
      is JsonNum (n) -> json-num-to-int n
      is otherwise -> 0

Section: Text Extraction
  st-extract-text : List Integer, Integer, Integer, Text -> Text
  st-extract-text (data) (off) (remaining) (acc) =
    let have = list-length data - off
    in let n = if have < 0 then 0 else if remaining < have then remaining else have
    in if n <= 0 then acc
    else acc & text-concat-list (st-text-pieces data off (off + n) (__list-with-capacity (n + 1)))

  st-text-pieces : List Integer, Integer, Integer, List Text -> List Text
  st-text-pieces (data) (i) (stop) (acc) =
    if i >= stop then acc
    else st-text-pieces data (i + 1) stop (list-push acc (cce-foreign-byte-text (list-at data i)))

Section: Tensor Lookup
  st-find-tensor : SafeTensorFile, Text -> Maybe StTensorMeta
  st-find-tensor (file) (name) = st-find-in-list (file.st-tensors) name 0 (file.st-tensor-count)

  st-find-in-list : List StTensorMeta, Text, Integer, Integer -> Maybe StTensorMeta
  st-find-in-list (tensors) (name) (i) (len) =
    if i >= len then None
    else let t = list-at tensors i
    in if t.stm-name == name then Just t
    else st-find-in-list tensors name (i + 1) len

Section: Tensor Loading (F32)
  st-load-f32 : List Integer, SafeTensorFile, StTensorMeta -> Tensor
  st-load-f32 (data) (file) (meta) =
    let abs-start = file.st-data-offset + meta.stm-offset-start
    in let elements = st-element-count meta
    in if st-can-read data abs-start elements 4 == False then tensor-new 0 0
    else let values = st-read-f32-loop data abs-start elements 0 []
    in tensor-from (st-rows meta) (st-cols meta) values

  st-read-f32-loop : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  st-read-f32-loop (data) (off) (count) (i) (acc) =
    if i >= count then acc
    else let raw = st-read-u32 data (off + i * 4)
    in let val = st-f32-to-fixed raw
    in st-read-f32-loop data off count (i + 1) (list-push acc val)

  st-f32-to-fixed : Integer -> Integer
  st-f32-to-fixed (raw) =
    let sign = bit-and (bit-shru raw 31) 1
    in let exp = bit-and (bit-shru raw 23) 255
    in let mant = bit-and raw 8388607
    in if exp == 0 then 0
    else let frac = 8388608 + mant
    in let val = frac * 1000 / 8388608
    in let e = exp - 127
    in let shifted = if e >= 0 then val * st-pow2 e else val / st-pow2 (-e)
    in if sign == 1 then -shifted else shifted

Section: Tensor Loading (F16)
  st-load-f16 : List Integer, SafeTensorFile, StTensorMeta -> Tensor
  st-load-f16 (data) (file) (meta) =
    let abs-start = file.st-data-offset + meta.stm-offset-start
    in let elements = st-element-count meta
    in if st-can-read data abs-start elements 2 == False then tensor-new 0 0
    else let values = st-read-f16-loop data abs-start elements 0 []
    in tensor-from (st-rows meta) (st-cols meta) values

  st-read-f16-loop : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  st-read-f16-loop (data) (off) (count) (i) (acc) =
    if i >= count then acc
    else let lo = list-at data (off + i * 2)
    in let hi = list-at data (off + i * 2 + 1)
    in let raw = bit-or lo (bit-shl hi 8)
    in let val = st-f16-to-fixed raw
    in st-read-f16-loop data off count (i + 1) (list-push acc val)

  st-f16-to-fixed : Integer -> Integer
  st-f16-to-fixed (h) =
    let sign = bit-and (bit-shru h 15) 1
    in let exp = bit-and (bit-shru h 10) 31
    in let mant = bit-and h 1023
    in if exp == 0 then 0
    else if exp == 31 then if sign == 1 then 0 - 30000 else 30000
    else let e = exp - 15
    in let frac = 1024 + mant
    in let val = frac * 1000 / 1024
    in let shifted = if e >= 0 then val * st-pow2 e else val / st-pow2 (-e)
    in if sign == 1 then -shifted else shifted

Section: Tensor Loading (BF16)
  st-load-bf16 : List Integer, SafeTensorFile, StTensorMeta -> Tensor
  st-load-bf16 (data) (file) (meta) =
    let abs-start = file.st-data-offset + meta.stm-offset-start
    in let elements = st-element-count meta
    in if st-can-read data abs-start elements 2 == False then tensor-new 0 0
    else let values = st-read-bf16-loop data abs-start elements 0 []
    in tensor-from (st-rows meta) (st-cols meta) values

  st-read-bf16-loop : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  st-read-bf16-loop (data) (off) (count) (i) (acc) =
    if i >= count then acc
    else let lo = list-at data (off + i * 2)
    in let hi = list-at data (off + i * 2 + 1)
    in let raw = bit-or lo (bit-shl hi 8)
    in let val = st-bf16-to-fixed raw
    in st-read-bf16-loop data off count (i + 1) (list-push acc val)

  st-bf16-to-fixed : Integer -> Integer
  st-bf16-to-fixed (h) =
    let sign = bit-and (bit-shru h 15) 1
    in let exp = bit-and (bit-shru h 7) 255
    in let mant = bit-and h 127
    in if exp == 0 then 0
    else let frac = 128 + mant
    in let val = frac * 1000 / 128
    in let e = exp - 127
    in let shifted = if e >= 0 then val * st-pow2 e else val / st-pow2 (-e)
    in if sign == 1 then -shifted else shifted

Section: Tensor Loading (FP8)

 E4M3 (the OCP "fn" form): sign, 4 exponent bits biased 7, 3 mantissa bits, no
 infinity, and S.1111.111 is NaN, so the largest value is 448. E5M2: sign, 5
 exponent bits biased 15, 2 mantissa bits, IEEE infinity and NaN at exponent
 31, largest 57,344. A zero exponent is subnormal in both. Values are times
 1000, truncated toward zero, as the other loaders answer.

  st-f8e4m3-to-fixed : Integer -> Integer
  st-f8e4m3-to-fixed (b) =
    let sign = bit-and (bit-shru b 7) 1
    in let exp = bit-and (bit-shru b 3) 15
    in let mant = bit-and b 7
    in if exp == 15 & mant == 7 then st-f8-nan
    else let mag = if exp == 0 then mant * 1000 / 512 else (8 + mant) * 1000 * st-pow2 exp / 1024
    in if sign == 1 then 0 - mag else mag

  st-f8e5m2-to-fixed : Integer -> Integer
  st-f8e5m2-to-fixed (b) =
    let sign = bit-and (bit-shru b 7) 1
    in let exp = bit-and (bit-shru b 2) 31
    in let mant = bit-and b 3
    in if exp == 31 then
      (if mant /= 0 then st-f8-nan else if sign == 1 then 0 - st-f8-inf else st-f8-inf)
    else let mag = if exp == 0 then
      mant * 1000 / 65536
    else (4 + mant) * 1000 * st-pow2 exp / 131072
    in if sign == 1 then 0 - mag else mag

  st-load-f8 : List Integer, SafeTensorFile, StTensorMeta -> Tensor
  st-load-f8 (data) (file) (meta) =
    let abs-start = file.st-data-offset + meta.stm-offset-start
    in let elements = st-element-count meta
    in if st-can-read data abs-start elements 1 == False then tensor-new 0 0
    else let values = st-read-f8-loop data abs-start elements (meta.stm-dtype == st-dtype-f8-e4m3) 0 []
    in tensor-from (st-rows meta) (st-cols meta) values

  st-read-f8-loop : List Integer, Integer, Integer, Boolean, Integer, List Integer -> List Integer
  st-read-f8-loop (data) (off) (count) (e4m3) (i) (acc) =
    if i >= count then acc
    else let b = list-at data (off + i)
    in let val = if e4m3 then st-f8e4m3-to-fixed b else st-f8e5m2-to-fixed b
    in st-read-f8-loop data off count e4m3 (i + 1) (list-push acc val)

Section: Auto-Load (dispatch on dtype)
  st-load-tensor : List Integer, SafeTensorFile, StTensorMeta -> Tensor
  st-load-tensor (data) (file) (meta) =
    if meta.stm-dtype == st-dtype-f32 then st-load-f32 data file meta
    else if meta.stm-dtype == st-dtype-f16 then st-load-f16 data file meta
    else if meta.stm-dtype == st-dtype-bf16 then st-load-bf16 data file meta
    else if meta.stm-dtype == st-dtype-f8-e4m3 then st-load-f8 data file meta
    else if meta.stm-dtype == st-dtype-f8-e5m2 then st-load-f8 data file meta
    else tensor-new 0 0

  st-load-by-name : List Integer, SafeTensorFile, Text -> Tensor
  st-load-by-name (data) (file) (name) =
    let found = st-find-tensor file name
    in when found
      is Just (meta) -> st-load-tensor data file meta
      is None -> tensor-new 0 0

Section: Helpers
  st-element-count : StTensorMeta -> Integer
  st-element-count (meta) = st-product (meta.stm-shape) 0 (meta.stm-ndim) 1

  st-rows : StTensorMeta -> Integer
  st-rows (meta) = if meta.stm-ndim >= 1 then list-at (meta.stm-shape) 0 else 1

  st-cols : StTensorMeta -> Integer
  st-cols (meta) =
    let r = st-rows meta
    in if r <= 0 then 0 else st-element-count meta / r

  st-product : List Integer, Integer, Integer, Integer -> Integer
  st-product (dims) (i) (len) (acc) =
    if i >= len then acc
    else let d = list-at dims i
    in if d <= 0 then 0
    else if acc > 9223372036854775807 / d then 0
    else st-product dims (i + 1) len (acc * d)

  st-pow2 : Integer -> Integer
  st-pow2 (n) = if n <= 0 then 1 else 2 * st-pow2 (n - 1)

Section: Queries
  format-st-file : SafeTensorFile -> Text
  format-st-file (f) =
    "header=" & show (f.st-header-len) & " tensors=" & show (f.st-tensor-count) & " valid=" & (if f.st-valid then "yes" else "no")

  format-st-tensor : StTensorMeta -> Text
  format-st-tensor (t) =
    t.stm-name & " dtype=" & st-dtype-name (t.stm-dtype) & " shape=" & st-format-shape (t.stm-shape) 0 (t.stm-ndim) "" & " bytes=" & show (t.stm-offset-end - t.stm-offset-start)

  st-dtype-name : Integer -> Text
  st-dtype-name (d) =
    if d == st-dtype-f32 then "F32"
    else if d == st-dtype-f16 then "F16"
    else if d == st-dtype-bf16 then "BF16"
    else if d == st-dtype-i32 then "I32"
    else if d == st-dtype-i8 then "I8"
    else if d == st-dtype-f8-e4m3 then "F8_E4M3"
    else if d == st-dtype-f8-e5m2 then "F8_E5M2"
    else "unknown"

  st-format-shape : List Integer, Integer, Integer, Text -> Text
  st-format-shape (dims) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else "x"
    in st-format-shape dims (i + 1) len (acc & sep & show (list-at dims i))

