Chapter: GeneticAlgorithm
  cites Foreword chapter Random

 We say:

Section: Types
  GaChromosome = record {
    genes : List Integer,
    gene-count : Integer
  }

  GaPopulation = record {
    individuals : List GaChromosome,
    fitness : List Integer,
    pop-size : Integer,
    gene-count : Integer,
    generation : Integer
  }

  GaConfig = record {
    mutation-rate : Integer between 0 and 1000,
    crossover-rate : Integer between 0 and 1000,
    tournament-size : Integer between 2 and 16,
    gene-min : Integer,
    gene-max : Integer
  }

Section: Construction
  ga-config-default : GaConfig
  ga-config-default = GaConfig { mutation-rate = 50, crossover-rate = 800, tournament-size = 3, gene-min = 0, gene-max = 1000 }

  ga-random-population : Integer, Integer, GaConfig, Integer -> GaPopulation
  ga-random-population (pop-size) (gene-count) (cfg) (seed) =
    let inds = ga-gen-individuals pop-size gene-count (cfg.gene-min) (cfg.gene-max) seed 0 []
    in GaPopulation { individuals = inds, fitness = ga-zero-fitness pop-size 0 [], pop-size = pop-size, gene-count = gene-count, generation = 0 }

  ga-gen-individuals : Integer, Integer, Integer, Integer, Integer, Integer, List GaChromosome -> List GaChromosome
  ga-gen-individuals (n) (genes) (lo) (hi) (seed) (i) (acc) =
    if i >= n then acc
    else let chromo = ga-random-chromo genes lo hi (seed + i * 7919) 0 []
    in ga-gen-individuals n genes lo hi seed (i + 1) (list-push acc (GaChromosome { genes = chromo, gene-count = genes }))

  ga-random-chromo : Integer, Integer, Integer, Integer, Integer, List Integer -> List Integer
  ga-random-chromo (n) (lo) (hi) (seed) (i) (acc) =
    if i >= n then acc
    else let val = ga-rand-range seed i lo hi
    in ga-random-chromo n lo hi seed (i + 1) (list-push acc val)

  ga-zero-fitness : Integer, Integer, List Integer -> List Integer
  ga-zero-fitness (n) (i) (acc) =
    if i >= n then acc
    else ga-zero-fitness n (i + 1) (list-push acc 0)

Section: Selection (Tournament)
  ga-tournament-select : GaPopulation, GaConfig, Integer -> Integer
  ga-tournament-select (pop) (cfg) (seed) =
    ga-tournament-loop pop (cfg.tournament-size) seed 0 0 (0 - 1)

  ga-tournament-loop : GaPopulation, Integer, Integer, Integer, Integer, Integer -> Integer
  ga-tournament-loop (pop) (k) (seed) (i) (best-idx) (best-fit) =
    if i >= k then best-idx
    else let idx = ga-rand-range seed i 0 (pop.pop-size - 1)
    in let fit = list-at (pop.fitness) idx
    in if fit > best-fit then ga-tournament-loop pop k seed (i + 1) idx fit
    else ga-tournament-loop pop k seed (i + 1) best-idx best-fit

Section: Crossover (Single Point)
  ga-crossover : GaChromosome, GaChromosome, Integer -> GaChromosome
  ga-crossover (a) (b) (seed) =
    let point = ga-rand-range seed 0 1 (a.gene-count - 1)
    in GaChromosome { genes = ga-splice (a.genes) (b.genes) point 0 (a.gene-count) [], gene-count = a.gene-count }

  ga-splice : List Integer, List Integer, Integer, Integer, Integer, List Integer -> List Integer
  ga-splice (a) (b) (point) (i) (len) (acc) =
    if i >= len then acc
    else let val = if i < point then list-at a i else list-at b i
    in ga-splice a b point (i + 1) len (list-push acc val)

Section: Mutation
  ga-mutate : GaChromosome, GaConfig, Integer -> GaChromosome
  ga-mutate (chromo) (cfg) (seed) =
    GaChromosome { genes = ga-mutate-loop (chromo.genes) (cfg.mutation-rate) (cfg.gene-min) (cfg.gene-max) seed 0 (chromo.gene-count) [], gene-count = chromo.gene-count }

  ga-mutate-loop : List Integer, Integer, Integer, Integer, Integer, Integer, Integer, List Integer -> List Integer
  ga-mutate-loop (genes) (rate) (lo) (hi) (seed) (i) (len) (acc) =
    if i >= len then acc
    else let r = ga-rand-range seed i 0 999
    in if r < rate then ga-mutate-loop genes rate lo hi seed (i + 1) len (list-push acc (ga-rand-range (seed + i * 31) i lo hi))
    else ga-mutate-loop genes rate lo hi seed (i + 1) len (list-push acc (list-at genes i))

Section: Evolution Step
  ga-evolve : GaPopulation, GaConfig, Integer -> GaPopulation
  ga-evolve (pop) (cfg) (seed) =
    let new-inds = ga-evolve-loop pop cfg seed 0 (pop.pop-size) []
    in GaPopulation { individuals = new-inds, fitness = ga-zero-fitness (pop.pop-size) 0 [], pop-size = pop.pop-size, gene-count = pop.gene-count, generation = pop.generation + 1 }

 crossover-rate is out of 1000 and is now read. It was declared, defaulted to
 800, and consulted by nothing: crossover was applied unconditionally, so the
 one knob nominally governing exploration against exploitation controlled
 nothing at all. Below the rate the pair is crossed; at or above it the first
 parent is carried forward unchanged and only mutation acts on it, which is
 what a crossover rate means.

 It is NOT plumbed into ga-offspring in the generic core, and that is
 deliberate. The core takes breed as a function and does not know what a
 chromosome is, let alone what a rate over one would mean. A domain that
 wants a crossover rate expresses it inside its own breed operator, where it
 has its own config in scope.

  ga-evolve-loop : GaPopulation, GaConfig, Integer, Integer, Integer, List GaChromosome -> List GaChromosome
  ga-evolve-loop (pop) (cfg) (seed) (i) (n) (acc) =
    if i >= n then acc
    else let p1 = ga-tournament-select pop cfg (seed + i * 101)
    in let p2 = ga-tournament-select pop cfg (seed + i * 307 + 1)
    in let a = list-at (pop.individuals) p1
    in let b = list-at (pop.individuals) p2
    in let roll = ga-rand-range (seed + i * 911) i 0 999
    in let child = if roll < cfg.crossover-rate then ga-crossover a b (seed + i * 503) else a
    in let mutated = ga-mutate child cfg (seed + i * 709)
    in ga-evolve-loop pop cfg seed (i + 1) n (list-push acc mutated)

Section: Generic Core

 The loop is the invariant part of a genetic algorithm; the representation is
 not. Everything above this section fixes the representation to an integer
 vector and leaves the operators implicit, which is the wrong axis and is why
 nothing outside this chapter could use it. A caller whose individual is a
 record has to encode it to genes and back, and no caller ever wanted to, so
 the working GA in this tree grew somewhere else: apps/games/magic breeds
 Personality records and DeckGenome records with its own copy of the loop.

  ga-rank : List a, List Integer -> List a
  ga-rank (pop) (scores) = ga-rank-loop pop scores [] (list-length pop) []

  ga-rank-loop : List a, List Integer, List Integer, Integer, List a -> List a
  ga-rank-loop (pop) (scores) (used) (left) (acc) =
    if left <= 0 then acc
    else let bi = ga-best-unused scores used 0 (list-length scores) (0 - 1) 0
    in if bi < 0 then acc
    else if bi >= list-length pop then acc
    else ga-rank-loop pop scores (list-push used bi) (left - 1) (list-push acc (list-at pop bi))

  ga-best-unused : List Integer, List Integer, Integer, Integer, Integer, Integer -> Integer
  ga-best-unused (scores) (used) (i) (len) (bi) (bv) =
    if i >= len then bi
    else if ga-seen used i 0 (list-length used) then ga-best-unused scores used (i + 1) len bi bv
    else let v = list-at scores i
    in if bi < 0 then ga-best-unused scores used (i + 1) len i v
    else if v > bv then ga-best-unused scores used (i + 1) len i v
    else ga-best-unused scores used (i + 1) len bi bv

  ga-seen : List Integer, Integer, Integer, Integer -> Boolean
  ga-seen (xs) (v) (i) (len) =
    if i >= len then False
    else if list-at xs i == v then True
    else ga-seen xs v (i + 1) len

  ga-take : List a, Integer -> List a
  ga-take (xs) (n) = ga-take-loop xs n 0 []

  ga-take-loop : List a, Integer, Integer, List a -> List a
  ga-take-loop (xs) (n) (i) (acc) =
    if i >= n then acc
    else if i >= list-length xs then acc
    else ga-take-loop xs n (i + 1) (list-push acc (list-at xs i))

  ga-offspring : List a, Integer, (a, a, Integer -> a), (a, Integer -> a), Integer -> List a
  ga-offspring (parents) (want) (breed) (mutate) (seed) =
    ga-offspring-loop parents want breed mutate seed 0 []

  ga-offspring-loop : List a, Integer, (a, a, Integer -> a), (a, Integer -> a), Integer, Integer, List a -> List a
  ga-offspring-loop (parents) (want) (breed) (mutate) (seed) (i) (acc) =
    if i >= want then acc
    else let np = list-length parents
    in if np <= 0 then acc
    else let m = list-at parents (int-mod i np)
    in let f = list-at parents (int-mod (i + 1) np)
    in let child = mutate (breed m f (seed + i * 503)) (seed + i * 709)
    in ga-offspring-loop parents want breed mutate seed (i + 1) (list-push acc child)

  ga-elitist-step : List a, List Integer, Integer, (a, a, Integer -> a), (a, Integer -> a), Integer -> List a
  ga-elitist-step (pop) (scores) (elite) (breed) (mutate) (seed) =
    let ranked = ga-rank pop scores
    in let keep = ga-take ranked elite
    in keep & ga-offspring keep (list-length pop - elite) breed mutate seed

Section: Integer-Vector Adapter

  ga-chromo-breed : GaChromosome, GaChromosome, Integer -> GaChromosome
  ga-chromo-breed (a) (b) (seed) = ga-crossover a b seed

  ga-chromo-mutate : GaChromosome, Integer -> GaChromosome
  ga-chromo-mutate (c) (seed) = ga-mutate c ga-config-default seed

  ga-evolve-elitist : GaPopulation, Integer, Integer -> GaPopulation
  ga-evolve-elitist (pop) (elite) (seed) =
    GaPopulation {
      individuals = ga-elitist-step (pop.individuals) (pop.fitness) elite ga-chromo-breed ga-chromo-mutate seed,
      fitness = ga-zero-fitness (pop.pop-size) 0 [],
      pop-size = pop.pop-size,
      gene-count = pop.gene-count,
      generation = pop.generation + 1
    }

Section: Fitness Assignment
  ga-set-fitness : GaPopulation, List Integer -> GaPopulation
  ga-set-fitness (pop) (fit) = GaPopulation { individuals = pop.individuals, fitness = fit, pop-size = pop.pop-size, gene-count = pop.gene-count, generation = pop.generation }

Section: Queries
  ga-best-idx : GaPopulation -> Integer
  ga-best-idx (pop) = ga-find-best (pop.fitness) 0 (pop.pop-size) 0 (0 - 1)

  ga-find-best : List Integer, Integer, Integer, Integer, Integer -> Integer
  ga-find-best (fit) (i) (len) (best-idx) (best-val) =
    if i >= len then best-idx
    else let v = list-at fit i
    in if v > best-val then ga-find-best fit (i + 1) len i v
    else ga-find-best fit (i + 1) len best-idx best-val

  ga-best-fitness : GaPopulation -> Integer
  ga-best-fitness (pop) = list-at (pop.fitness) (ga-best-idx pop)

  ga-best-individual : GaPopulation -> GaChromosome
  ga-best-individual (pop) = list-at (pop.individuals) (ga-best-idx pop)

  ga-avg-fitness : GaPopulation -> Integer
  ga-avg-fitness (pop) = ga-sum-fitness (pop.fitness) 0 (pop.pop-size) 0 / pop.pop-size

  ga-sum-fitness : List Integer, Integer, Integer, Integer -> Integer
  ga-sum-fitness (fit) (i) (len) (acc) =
    if i >= len then acc
    else ga-sum-fitness fit (i + 1) len (acc + list-at fit i)

Section: Helpers
 ga-rand-range used to be bit-xor (seed * 2654435761) (idx * 40503) and then
 a remainder. Multiplication carries entropy upward only, so at range 2 that
 reduced to lowbit(seed) XOR lowbit(idx): ga-random-population produced thirty
 chromosomes with the same alternating gene pattern and the same fitness, and
 a GA whose initial population has no fitness variance has nothing to select
 on. It now delegates to the shared mixer, which xor-shifts the high bits back
 down. See Foreword chapter Random for the measurement.

  ga-rand-range : Integer, Integer, Integer, Integer -> Integer
  ga-rand-range (seed) (idx) (lo) (hi) = rand-in-range seed idx lo hi

  format-chromosome : GaChromosome -> Text
  format-chromosome (c) = ga-fmt-genes (c.genes) 0 (c.gene-count) ""

  ga-fmt-genes : List Integer, Integer, Integer, Text -> Text
  ga-fmt-genes (genes) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ","
    in ga-fmt-genes genes (i + 1) len (acc & sep & show (list-at genes i))

