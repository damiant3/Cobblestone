Chapter: Mesh
  cites Math chapter Matrix4
  cites Math chapter Quaternion
  cites Math chapter Cordic
  cites Foreword chapter MathLib

 Vertex buffer and index buffer types for 3D geometry. Fixed-point
 (scale 1000). Vertices carry position, normal, UV, and color.
 Includes primitive generators for cube, sphere, plane, cylinder,
 cone, and torus.

 We say:

Section: Vertex

  Vertex = record {
    vp-x : Integer, vp-y : Integer, vp-z : Integer,
    vn-x : Integer, vn-y : Integer, vn-z : Integer,
    vu : Integer, vv : Integer,
    v-color : Integer
  }

  vertex : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Vertex
  vertex (px) (py) (pz) (nx) (ny) (nz) (u) (v) (color) =
    Vertex { vp-x = px, vp-y = py, vp-z = pz, vn-x = nx, vn-y = ny, vn-z = nz, vu = u, vv = v, v-color = color }

  vertex-pos : Integer, Integer, Integer -> Vertex
  vertex-pos (x) (y) (z) =
    Vertex { vp-x = x, vp-y = y, vp-z = z, vn-x = 0, vn-y = 0, vn-z = 1000, vu = 0, vv = 0, v-color = #FFFFFF }

  vertex-pos-normal : Integer, Integer, Integer, Integer, Integer, Integer -> Vertex
  vertex-pos-normal (px) (py) (pz) (nx) (ny) (nz) =
    Vertex { vp-x = px, vp-y = py, vp-z = pz, vn-x = nx, vn-y = ny, vn-z = nz, vu = 0, vv = 0, v-color = #FFFFFF }

  vertex-pos-uv : Integer, Integer, Integer, Integer, Integer -> Vertex
  vertex-pos-uv (px) (py) (pz) (u) (v) =
    Vertex { vp-x = px, vp-y = py, vp-z = pz, vn-x = 0, vn-y = 0, vn-z = 1000, vu = u, vv = v, v-color = #FFFFFF }

Section: Mesh Type

  MeshPrimitive =
    | MeshTriangles
    | MeshLines
    | MeshPoints

  Mesh = record {
    mesh-verts : List Vertex,
    mesh-indices : List Integer,
    mesh-vert-count : Integer,
    mesh-index-count : Integer,
    mesh-primitive : MeshPrimitive
  }

  mesh-new : List Vertex, List Integer -> Mesh
  mesh-new (verts) (indices) = Mesh {
    mesh-verts = verts,
    mesh-indices = indices,
    mesh-vert-count = list-length verts,
    mesh-index-count = list-length indices,
    mesh-primitive = MeshTriangles
  }

  mesh-empty : Mesh
  mesh-empty = Mesh {
    mesh-verts = [],
    mesh-indices = [],
    mesh-vert-count = 0,
    mesh-index-count = 0,
    mesh-primitive = MeshTriangles
  }

Section: Vertex Access

  mesh-vertex-at : Mesh, Integer -> Vertex
  mesh-vertex-at (m) (i) = list-at (m.mesh-verts) i

  mesh-index-at : Mesh, Integer -> Integer
  mesh-index-at (m) (i) = list-at (m.mesh-indices) i

  mesh-triangle-count : Mesh -> Integer
  mesh-triangle-count (m) = m.mesh-index-count / 3

Section: Primitive Generators

  mesh-cube : Integer -> Mesh
  mesh-cube (half) =
    let h = half
    in let n = 0 - half
    in let verts = [
      vertex n n h 0 0 1000 0 0 #FFFFFF,
      vertex h n h 0 0 1000 1000 0 #FFFFFF,
      vertex h h h 0 0 1000 1000 1000 #FFFFFF,
      vertex n h h 0 0 1000 0 1000 #FFFFFF,
      vertex h n n 0 0 (-1000) 0 0 #FFFFFF,
      vertex n n n 0 0 (-1000) 1000 0 #FFFFFF,
      vertex n h n 0 0 (-1000) 1000 1000 #FFFFFF,
      vertex h h n 0 0 (-1000) 0 1000 #FFFFFF,
      vertex n n n (-1000) 0 0 0 0 #FFFFFF,
      vertex n n h (-1000) 0 0 1000 0 #FFFFFF,
      vertex n h h (-1000) 0 0 1000 1000 #FFFFFF,
      vertex n h n (-1000) 0 0 0 1000 #FFFFFF,
      vertex h n h 1000 0 0 0 0 #FFFFFF,
      vertex h n n 1000 0 0 1000 0 #FFFFFF,
      vertex h h n 1000 0 0 1000 1000 #FFFFFF,
      vertex h h h 1000 0 0 0 1000 #FFFFFF,
      vertex n h h 0 1000 0 0 0 #FFFFFF,
      vertex h h h 0 1000 0 1000 0 #FFFFFF,
      vertex h h n 0 1000 0 1000 1000 #FFFFFF,
      vertex n h n 0 1000 0 0 1000 #FFFFFF,
      vertex n n n 0 (-1000) 0 0 0 #FFFFFF,
      vertex h n n 0 (-1000) 0 1000 0 #FFFFFF,
      vertex h n h 0 (-1000) 0 1000 1000 #FFFFFF,
      vertex n n h 0 (-1000) 0 0 1000 #FFFFFF
    ]
    in let indices = [
      0, 1, 2, 0, 2, 3,
      4, 5, 6, 4, 6, 7,
      8, 9, 10, 8, 10, 11,
      12, 13, 14, 12, 14, 15,
      16, 17, 18, 16, 18, 19,
      20, 21, 22, 20, 22, 23
    ]
    in mesh-new verts indices

  mesh-plane : Integer, Integer -> Mesh
  mesh-plane (half-w) (half-h) =
    let verts = [
      vertex (0 - half-w) 0 (0 - half-h) 0 1000 0 0 0 #FFFFFF,
      vertex half-w 0 (0 - half-h) 0 1000 0 1000 0 #FFFFFF,
      vertex half-w 0 half-h 0 1000 0 1000 1000 #FFFFFF,
      vertex (0 - half-w) 0 half-h 0 1000 0 0 1000 #FFFFFF
    ]
    in let indices = [0, 2, 1, 0, 3, 2]
    in mesh-new verts indices

  mesh-pyramid : Integer, Integer -> Mesh
  mesh-pyramid (half-base) (height) =
    let b = half-base
    in let nb = 0 - half-base
    in let verts = [
      vertex 0 height 0 0 1000 0 500 0 #FFFFFF,
      vertex nb 0 b 0 0 1000 0 1000 #FFFFFF,
      vertex b 0 b 0 0 1000 1000 1000 #FFFFFF,
      vertex b 0 nb 0 0 (-1000) 1000 1000 #FFFFFF,
      vertex nb 0 nb 0 0 (-1000) 0 1000 #FFFFFF
    ]
    in let indices = [
      0, 1, 2,
      0, 2, 3,
      0, 3, 4,
      0, 4, 1,
      1, 4, 3, 1, 3, 2
    ]
    in mesh-new verts indices

Section: Round Primitive Generators

 CORDIC trig is about 0.1 per cent, so ring vertices sit within a few
 milli of the ideal circle; the vertex and index counts and the seam
 UVs are exact regardless.

  msg-grid-indices : Integer, Integer, Integer, Integer, List Integer -> List Integer
  msg-grid-indices (segs) (rings) (i) (j) (acc) =
    if i >= rings then acc
    else if j >= segs then msg-grid-indices segs rings (i + 1) 0 acc
    else let a = i * (segs + 1) + j
    in let b = a + 1
    in let c = a + segs + 1
    in let d = c + 1
    in let acc2 = list-push (list-push (list-push acc a) b) d
    in let acc3 = list-push (list-push (list-push acc2 a) d) c
    in msg-grid-indices segs rings i (j + 1) acc3

  mesh-sphere : Integer, Integer, Integer -> Mesh
  mesh-sphere (radius) (segs) (rings) =
    let verts = msg-sphere-verts radius segs rings 0 0 []
    in mesh-new verts (msg-grid-indices segs rings 0 0 [])

  msg-sphere-verts : Integer, Integer, Integer, Integer, Integer, List Vertex -> List Vertex
  msg-sphere-verts (radius) (segs) (rings) (i) (j) (acc) =
    if i > rings then acc
    else if j > segs then msg-sphere-verts radius segs rings (i + 1) 0 acc
    else let phi = cordic-sincos (cordic-pi * i / rings)
    in let theta = cordic-sincos (cordic-two-pi * j / segs)
    in let ny = phi.cos-val
    in let ring-r = phi.sin-val
    in let nx = ring-r * theta.cos-val / 1000
    in let nz = ring-r * theta.sin-val / 1000
    in let vtx = vertex (radius * nx / 1000) (radius * ny / 1000) (radius * nz / 1000) nx ny nz (j * 1000 / segs) (i * 1000 / rings) #FFFFFF
    in msg-sphere-verts radius segs rings i (j + 1) (list-push acc vtx)

 The cylinder is a side grid of two rows plus two capped fans. The side
 rows share the rim positions but carry radial normals; the cap rims
 repeat them with axial normals, because one vertex cannot serve both.

  mesh-cylinder : Integer, Integer, Integer -> Mesh
  mesh-cylinder (radius) (half-h) (segs) =
    let side = msg-cyl-side radius half-h segs 0 0 []
    in let capped = msg-cyl-caps radius half-h segs side
    in let idx = msg-grid-indices segs 1 0 0 []
    in let top-base = 2 * (segs + 1)
    in let bot-base = top-base + segs + 2
    in let idx2 = msg-fan-indices top-base segs True 0 idx
    in mesh-new capped (msg-fan-indices bot-base segs False 0 idx2)

  msg-cyl-side : Integer, Integer, Integer, Integer, Integer, List Vertex -> List Vertex
  msg-cyl-side (radius) (half-h) (segs) (row) (j) (acc) =
    if row > 1 then acc
    else if j > segs then msg-cyl-side radius half-h segs (row + 1) 0 acc
    else let t = cordic-sincos (cordic-two-pi * j / segs)
    in let y = if row == 0 then half-h else 0 - half-h
    in let vtx = vertex (radius * t.cos-val / 1000) y (radius * t.sin-val / 1000) (t.cos-val) 0 (t.sin-val) (j * 1000 / segs) (row * 1000) #FFFFFF
    in msg-cyl-side radius half-h segs row (j + 1) (list-push acc vtx)

 Each cap is a centre vertex followed by segs+1 rim copies. The fan
 winds one way for the +y cap and the other for the -y cap.

  msg-cyl-caps : Integer, Integer, Integer, List Vertex -> List Vertex
  msg-cyl-caps (radius) (half-h) (segs) (acc) =
    let top = msg-cap-ring radius half-h 1000 segs 0 (list-push acc (vertex 0 half-h 0 0 1000 0 500 500 #FFFFFF))
    in msg-cap-ring radius (0 - half-h) (-1000) segs 0 (list-push top (vertex 0 (0 - half-h) 0 0 (-1000) 0 500 500 #FFFFFF))

  msg-cap-ring : Integer, Integer, Integer, Integer, Integer, List Vertex -> List Vertex
  msg-cap-ring (radius) (y) (ny) (segs) (j) (acc) =
    if j > segs then acc
    else let t = cordic-sincos (cordic-two-pi * j / segs)
    in let vtx = vertex (radius * t.cos-val / 1000) y (radius * t.sin-val / 1000) 0 ny 0 (500 + t.cos-val / 2) (500 + t.sin-val / 2) #FFFFFF
    in msg-cap-ring radius y ny segs (j + 1) (list-push acc vtx)

  msg-fan-indices : Integer, Integer, Boolean, Integer, List Integer -> List Integer
  msg-fan-indices (base) (segs) (flip) (j) (acc) =
    if j >= segs then acc
    else let r0 = base + 1 + j
    in let r1 = base + 2 + j
    in let acc2 = if flip then list-push (list-push (list-push acc base) r1) r0
      else list-push (list-push (list-push acc base) r0) r1
    in msg-fan-indices base segs flip (j + 1) acc2

 The cone's side is one triangle per segment against a per-segment apex
 copy, so each slant normal survives instead of averaging to the axis.

  mesh-cone : Integer, Integer, Integer -> Mesh
  mesh-cone (radius) (height) (segs) =
    let slant = math-isqrt (height * height + radius * radius)
    in let rim = msg-cone-rim radius height slant segs 0 []
    in let apexed = msg-cone-apexes radius height slant segs 0 rim
    in let based = msg-cap-ring radius 0 (-1000) segs 0 (list-push apexed (vertex 0 0 0 0 (-1000) 0 500 500 #FFFFFF))
    in let side-idx = msg-cone-side-indices segs 0 []
    in mesh-new based (msg-fan-indices (2 * segs + 1) segs False 0 side-idx)

  msg-cone-rim : Integer, Integer, Integer, Integer, Integer, List Vertex -> List Vertex
  msg-cone-rim (radius) (height) (slant) (segs) (j) (acc) =
    if j > segs then acc
    else let t = cordic-sincos (cordic-two-pi * j / segs)
    in let nx = height * t.cos-val / slant
    in let nz = height * t.sin-val / slant
    in let ny = radius * 1000 / slant
    in let vtx = vertex (radius * t.cos-val / 1000) 0 (radius * t.sin-val / 1000) nx ny nz (j * 1000 / segs) 1000 #FFFFFF
    in msg-cone-rim radius height slant segs (j + 1) (list-push acc vtx)

  msg-cone-apexes : Integer, Integer, Integer, Integer, Integer, List Vertex -> List Vertex
  msg-cone-apexes (radius) (height) (slant) (segs) (j) (acc) =
    if j >= segs then acc
    else let t = cordic-sincos (cordic-two-pi * j / segs + cordic-pi / segs)
    in let nx = height * t.cos-val / slant
    in let nz = height * t.sin-val / slant
    in let ny = radius * 1000 / slant
    in let vtx = vertex 0 height 0 nx ny nz (j * 1000 / segs + 500 / segs) 0 #FFFFFF
    in msg-cone-apexes radius height slant segs (j + 1) (list-push acc vtx)

 Side triangle j: rim j, apex j, rim j+1. Rim vertices are 0..segs and
 apex copies follow at segs+1..2*segs.

  msg-cone-side-indices : Integer, Integer, List Integer -> List Integer
  msg-cone-side-indices (segs) (j) (acc) =
    if j >= segs then acc
    else let acc2 = list-push (list-push (list-push acc j) (j + 1)) (segs + 1 + j)
    in msg-cone-side-indices segs (j + 1) acc2

  mesh-torus : Integer, Integer, Integer, Integer -> Mesh
  mesh-torus (major) (minor) (segs-u) (segs-v) =
    let verts = msg-torus-verts major minor segs-u segs-v 0 0 []
    in mesh-new verts (msg-grid-indices segs-u segs-v 0 0 [])

  msg-torus-verts : Integer, Integer, Integer, Integer, Integer, Integer, List Vertex -> List Vertex
  msg-torus-verts (major) (minor) (segs-u) (segs-v) (i) (j) (acc) =
    if i > segs-v then acc
    else if j > segs-u then msg-torus-verts major minor segs-u segs-v (i + 1) 0 acc
    else let ph = cordic-sincos (cordic-two-pi * i / segs-v)
    in let th = cordic-sincos (cordic-two-pi * j / segs-u)
    in let ring = major + minor * ph.cos-val / 1000
    in let nx = ph.cos-val * th.cos-val / 1000
    in let nz = ph.cos-val * th.sin-val / 1000
    in let vtx = vertex (ring * th.cos-val / 1000) (minor * ph.sin-val / 1000) (ring * th.sin-val / 1000) nx (ph.sin-val) nz (j * 1000 / segs-u) (i * 1000 / segs-v) #FFFFFF
    in msg-torus-verts major minor segs-u segs-v i (j + 1) (list-push acc vtx)

Section: Mesh Bounds

  MeshBounds = record {
    mb-min-x : Integer, mb-min-y : Integer, mb-min-z : Integer,
    mb-max-x : Integer, mb-max-y : Integer, mb-max-z : Integer
  }

  mesh-bounds : Mesh -> MeshBounds
  mesh-bounds (m) =
    if m.mesh-vert-count == 0 then MeshBounds { mb-min-x = 0, mb-min-y = 0, mb-min-z = 0, mb-max-x = 0, mb-max-y = 0, mb-max-z = 0 }
    else let v0 = mesh-vertex-at m 0
    in mesh-bounds-loop m 1 (m.mesh-vert-count) (MeshBounds { mb-min-x = v0.vp-x, mb-min-y = v0.vp-y, mb-min-z = v0.vp-z, mb-max-x = v0.vp-x, mb-max-y = v0.vp-y, mb-max-z = v0.vp-z })

  mesh-bounds-loop : Mesh, Integer, Integer, MeshBounds -> MeshBounds
  mesh-bounds-loop (m) (i) (n) (b) =
    if i >= n then b
    else let v = mesh-vertex-at m i
    in let b2 = MeshBounds {
      mb-min-x = mesh-min (b.mb-min-x) (v.vp-x),
      mb-min-y = mesh-min (b.mb-min-y) (v.vp-y),
      mb-min-z = mesh-min (b.mb-min-z) (v.vp-z),
      mb-max-x = mesh-max (b.mb-max-x) (v.vp-x),
      mb-max-y = mesh-max (b.mb-max-y) (v.vp-y),
      mb-max-z = mesh-max (b.mb-max-z) (v.vp-z)
    }
    in mesh-bounds-loop m (i + 1) n b2

Section: Helpers

  mesh-min : Integer, Integer -> Integer
  mesh-min (a) (b) = if a < b then a else b

  mesh-max : Integer, Integer -> Integer
  mesh-max (a) (b) = if a > b then a else b

Section: Heightmap to Mesh

  mesh-from-heightmap : List Integer, Integer, Integer, Integer -> Mesh
  mesh-from-heightmap (cells) (grid-size) (spacing) (height-scale) =
    let verts = mfh-build-verts cells grid-size spacing height-scale 0 0 []
    in let indices = mfh-build-indices grid-size 0 0 []
    in mesh-new verts indices

  mfh-build-verts : List Integer, Integer, Integer, Integer, Integer, Integer, List Vertex -> List Vertex
  mfh-build-verts (cells) (size) (spacing) (h-scale) (x) (z) (acc) =
    if z >= size then acc
    else if x >= size then mfh-build-verts cells size spacing h-scale 0 (z + 1) acc
    else let height = list-at cells (z * size + x) * h-scale
    in let px = x * spacing - size * spacing / 2
    in let pz = z * spacing - size * spacing / 2
    in let u = x * 1000 / (size - 1)
    in let v = z * 1000 / (size - 1)
    in let ny = 1000
    in let vert = vertex px height pz 0 ny 0 u v #8B7355
    in mfh-build-verts cells size spacing h-scale (x + 1) z (list-push acc vert)

  mfh-build-indices : Integer, Integer, Integer, List Integer -> List Integer
  mfh-build-indices (size) (x) (z) (acc) =
    if z >= size - 1 then acc
    else if x >= size - 1 then mfh-build-indices size 0 (z + 1) acc
    else let tl = z * size + x
    in let tr = tl + 1
    in let bl = tl + size
    in let br = bl + 1
    in let acc2 = list-push (list-push (list-push acc tl) bl) tr
    in let acc3 = list-push (list-push (list-push acc2 tr) bl) br
    in mfh-build-indices size (x + 1) z acc3

Section: Formatting

  format-mesh : Mesh -> Text
  format-mesh (m) = "Mesh(" & show (m.mesh-vert-count) & "v, " & show (m.mesh-index-count) & "i, " & show (mesh-triangle-count m) & "t)"

  format-vertex : Vertex -> Text
  format-vertex (v) = "(" & show (v.vp-x) & "," & show (v.vp-y) & "," & show (v.vp-z) & ")"

  format-bounds : MeshBounds -> Text
  format-bounds (b) = "[" & show (b.mb-min-x) & ".." & show (b.mb-max-x) & ", " & show (b.mb-min-y) & ".." & show (b.mb-max-y) & ", " & show (b.mb-min-z) & ".." & show (b.mb-max-z) & "]"

