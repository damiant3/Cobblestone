Chapter: Material
  cites Game chapter Color
  cites Foreword chapter Maybe

 Surface material properties. Defines shading models (unlit, flat,
 Gouraud, Phong), albedo color, specular response, and texture
 reference. Materials are value types -- no allocation overhead.

 We say:

Section: Shading Model

  ShadingModel =
    | Unlit
    | FlatShaded
    | GouraudShaded
    | PhongShaded

Section: Material Type

  EngineMaterial = record {
    emat-albedo : Rgb,
    emat-diffuse : Integer,
    emat-specular : Integer,
    emat-shininess : Integer,
    emat-shading : ShadingModel,
    emat-wireframe : Boolean,
    emat-double-sided : Boolean,
    emat-opacity : Integer
  }

Section: Construction

  emat-default : EngineMaterial
  emat-default = EngineMaterial {
    emat-albedo = rgb 200 200 200,
    emat-diffuse = 700,
    emat-specular = 300,
    emat-shininess = 16,
    emat-shading = PhongShaded,
    emat-wireframe = False,
    emat-double-sided = False,
    emat-opacity = 1000
  }

  emat-color : Rgb -> EngineMaterial
  emat-color (c) = EngineMaterial {
    emat-albedo = c,
    emat-diffuse = 700,
    emat-specular = 300,
    emat-shininess = 16,
    emat-shading = PhongShaded,
    emat-wireframe = False,
    emat-double-sided = False,
    emat-opacity = 1000
  }

  emat-flat : Rgb -> EngineMaterial
  emat-flat (c) = EngineMaterial {
    emat-albedo = c,
    emat-diffuse = 800,
    emat-specular = 200,
    emat-shininess = 4,
    emat-shading = FlatShaded,
    emat-wireframe = False,
    emat-double-sided = False,
    emat-opacity = 1000
  }

  emat-shiny : Rgb, Integer -> EngineMaterial
  emat-shiny (c) (shine) = EngineMaterial {
    emat-albedo = c,
    emat-diffuse = 400,
    emat-specular = 800,
    emat-shininess = shine,
    emat-shading = PhongShaded,
    emat-wireframe = False,
    emat-double-sided = False,
    emat-opacity = 1000
  }

  emat-unlit : Rgb -> EngineMaterial
  emat-unlit (c) = EngineMaterial {
    emat-albedo = c,
    emat-diffuse = 0,
    emat-specular = 0,
    emat-shininess = 1,
    emat-shading = Unlit,
    emat-wireframe = False,
    emat-double-sided = False,
    emat-opacity = 1000
  }

  emat-wire : Rgb -> EngineMaterial
  emat-wire (c) = EngineMaterial {
    emat-albedo = c,
    emat-diffuse = 0,
    emat-specular = 0,
    emat-shininess = 1,
    emat-shading = Unlit,
    emat-wireframe = True,
    emat-double-sided = True,
    emat-opacity = 1000
  }

Section: Modification

  emat-set-opacity : EngineMaterial, Integer -> EngineMaterial
  emat-set-opacity (m) (o) = __record-set m "emat-opacity" o

  emat-set-wireframe : EngineMaterial, Boolean -> EngineMaterial
  emat-set-wireframe (m) (w) = __record-set m "emat-wireframe" w

  emat-set-double-sided : EngineMaterial, Boolean -> EngineMaterial
  emat-set-double-sided (m) (d) = __record-set m "emat-double-sided" d

  emat-set-shading : EngineMaterial, ShadingModel -> EngineMaterial
  emat-set-shading (m) (s) = __record-set m "emat-shading" s

Section: Presets

  emat-red : EngineMaterial
  emat-red = emat-color (rgb 220 50 50)

  emat-green : EngineMaterial
  emat-green = emat-color (rgb 50 200 80)

  emat-blue : EngineMaterial
  emat-blue = emat-color (rgb 60 120 220)

  emat-white : EngineMaterial
  emat-white = emat-color (rgb 240 240 240)

  emat-gold : EngineMaterial
  emat-gold = emat-shiny (rgb 255 215 0) 64

  emat-chrome : EngineMaterial
  emat-chrome = emat-shiny (rgb 200 200 210) 128

  emat-ground : EngineMaterial
  emat-ground = emat-flat (rgb 120 100 80)

  emat-sky : EngineMaterial
  emat-sky = emat-unlit (rgb 135 206 235)

Section: Formatting

  format-emat : EngineMaterial -> Text
  format-emat (m) =
    let shade-name = when m.emat-shading
      is Unlit -> "unlit"
      is FlatShaded -> "flat"
      is GouraudShaded -> "gouraud"
      is PhongShaded -> "phong"
    in "Material(" & format-rgb (m.emat-albedo) & ", " & shade-name & ")"

