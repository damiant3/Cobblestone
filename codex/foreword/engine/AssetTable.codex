Chapter: AssetTable
  cites Engine chapter Mesh
  cites Engine chapter Texture
  cites Engine chapter Material
  cites Foreword chapter Maybe

 Format-agnostic asset registry. Assets are registered by name and
 kind, stored in parallel typed arrays indexed by asset ID. No
 external file formats -- assets are procedural or defined as Codex
 literals. The asset table is the single source of truth for all
 game resources.

 We say:

Section: Asset Kind

  AssetKind =
    | AssetMesh
    | AssetTexture
    | AssetMaterial
    | AssetSound

Section: Asset Entry

  AssetEntry = record {
    ae-id : Integer,
    ae-kind : AssetKind,
    ae-name : Text
  }

Section: Asset Table

  AssetTable = record {
    at-entries : List AssetEntry,
    at-meshes : List Mesh,
    at-textures : List EngineTexture,
    at-materials : List EngineMaterial,
    at-mesh-count : Integer,
    at-tex-count : Integer,
    at-mat-count : Integer
  }

  at-new : AssetTable
  at-new = AssetTable {
    at-entries = [],
    at-meshes = [],
    at-textures = [],
    at-materials = [],
    at-mesh-count = 0,
    at-tex-count = 0,
    at-mat-count = 0
  }

Section: Registration

  at-add-mesh : AssetTable, Text, Mesh -> AssetTable
  at-add-mesh (tbl) (name) (mesh) =
    let id = tbl.at-mesh-count
    in let entry = AssetEntry { ae-id = id, ae-kind = AssetMesh, ae-name = name }
    in AssetTable {
      at-entries = list-push (tbl.at-entries) entry,
      at-meshes = list-push (tbl.at-meshes) mesh,
      at-textures = tbl.at-textures,
      at-materials = tbl.at-materials,
      at-mesh-count = id + 1,
      at-tex-count = tbl.at-tex-count,
      at-mat-count = tbl.at-mat-count
    }

  at-add-texture : AssetTable, Text, EngineTexture -> AssetTable
  at-add-texture (tbl) (name) (tex) =
    let id = tbl.at-tex-count
    in let entry = AssetEntry { ae-id = id, ae-kind = AssetTexture, ae-name = name }
    in AssetTable {
      at-entries = list-push (tbl.at-entries) entry,
      at-meshes = tbl.at-meshes,
      at-textures = list-push (tbl.at-textures) tex,
      at-materials = tbl.at-materials,
      at-mesh-count = tbl.at-mesh-count,
      at-tex-count = id + 1,
      at-mat-count = tbl.at-mat-count
    }

  at-add-material : AssetTable, Text, EngineMaterial -> AssetTable
  at-add-material (tbl) (name) (mat) =
    let id = tbl.at-mat-count
    in let entry = AssetEntry { ae-id = id, ae-kind = AssetMaterial, ae-name = name }
    in AssetTable {
      at-entries = list-push (tbl.at-entries) entry,
      at-meshes = tbl.at-meshes,
      at-textures = tbl.at-textures,
      at-materials = list-push (tbl.at-materials) mat,
      at-mesh-count = tbl.at-mesh-count,
      at-tex-count = tbl.at-tex-count,
      at-mat-count = id + 1
    }

Section: Lookup

  at-get-mesh : AssetTable, Integer -> Maybe Mesh
  at-get-mesh (tbl) (id) =
    if id < 0 then None
    else if id >= tbl.at-mesh-count then None
    else Just (list-at (tbl.at-meshes) id)

  at-get-texture : AssetTable, Integer -> Maybe EngineTexture
  at-get-texture (tbl) (id) =
    if id < 0 then None
    else if id >= tbl.at-tex-count then None
    else Just (list-at (tbl.at-textures) id)

  at-get-material : AssetTable, Integer -> Maybe EngineMaterial
  at-get-material (tbl) (id) =
    if id < 0 then None
    else if id >= tbl.at-mat-count then None
    else Just (list-at (tbl.at-materials) id)

  at-find-by-name : AssetTable, Text -> Integer
  at-find-by-name (tbl) (name) = at-find-loop (tbl.at-entries) name 0 (list-length (tbl.at-entries))

  at-find-loop : List AssetEntry, Text, Integer, Integer -> Integer
  at-find-loop (entries) (name) (i) (n) =
    if i >= n then 0 - 1
    else if (list-at entries i).ae-name == name then (list-at entries i).ae-id
    else at-find-loop entries name (i + 1) n

Section: Queries

  at-total-count : AssetTable -> Integer
  at-total-count (tbl) = tbl.at-mesh-count + tbl.at-tex-count + tbl.at-mat-count

Section: Formatting

  format-asset-table : AssetTable -> Text
  format-asset-table (tbl) = "Assets(" & show (tbl.at-mesh-count) & " meshes, " & show (tbl.at-tex-count) & " textures, " & show (tbl.at-mat-count) & " materials)"

