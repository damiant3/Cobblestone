Chapter: RendererWork
  cites Engine chapter Renderer3D

 We say:

Section: Raster Storage

  R3dRasterWork = record {
    rw-a : ProjVert,
    rw-b : ProjVert,
    rw-c : ProjVert,
    rw-ctx : R3dShadeCtx,
    rw-x : Integer,
    rw-y : Integer,
    rw-min-x : Integer,
    rw-max-x : Integer,
    rw-max-y : Integer,
    rw-bias : Integer,
    rw-plain : Integer,
    rw-active : Integer,
    rw-attempts : Integer
  }

  rw-pixel-limit : Integer = 256
  rw-light-limit : Integer = 16
  rw-shininess-limit : Integer = 128

  rw-vertex-new : Integer -> ProjVert
  rw-vertex-new (unused) = ProjVert { pv-sx = 0, pv-sy = 0, pv-depth = 0, pv-nx = 0, pv-ny = 0, pv-nz = 0, pv-wu = 0, pv-wv = 0, pv-wx = 0.0, pv-wy = 0.0, pv-wz = 0.0, pv-lx = 0, pv-ly = 0, pv-ld = 0, pv-iw = 0 }

  rw-lights-new : Integer, List R3dLightPre -> List R3dLightPre
  rw-lights-new (remaining) (acc) =
    if remaining <= 0 then acc
    else rw-lights-new (remaining - 1) (list-push acc (R3dLightPre { lp-lx = 0, lp-ly = 0, lp-lz = 0, lp-scale = 0, lp-cr = 0, lp-cg = 0, lp-cb = 0 }))

  rw-new : Integer -> R3dRasterWork
  rw-new (light-count) =
    let ctx = r3d-shade-ctx-flat 0
    in let lights = __record-set ctx "sc-lights" (rw-lights-new (r3d-clamp light-count 0 rw-light-limit) [])
    in R3dRasterWork { rw-a = rw-vertex-new 0, rw-b = rw-vertex-new 0, rw-c = rw-vertex-new 0, rw-ctx = ctx, rw-x = 0, rw-y = 0, rw-min-x = 0, rw-max-x = 0, rw-max-y = 0, rw-bias = 0, rw-plain = 0, rw-active = 0, rw-attempts = 0 }

  rw-copy-vertex : ProjVert, ProjVert -> Integer
  rw-copy-vertex (dst) (src) =
    let d0 = __record-set dst "pv-sx" (src.pv-sx)
    in let d1 = __record-set dst "pv-sy" (src.pv-sy)
    in let d2 = __record-set dst "pv-depth" (src.pv-depth)
    in let d3 = __record-set dst "pv-nx" (src.pv-nx)
    in let d4 = __record-set dst "pv-ny" (src.pv-ny)
    in let d5 = __record-set dst "pv-nz" (src.pv-nz)
    in let d6 = __record-set dst "pv-wu" (src.pv-wu)
    in let d7 = __record-set dst "pv-wv" (src.pv-wv)
    in let d8 = __record-set dst "pv-wx" (src.pv-wx)
    in let d9 = __record-set dst "pv-wy" (src.pv-wy)
    in let d10 = __record-set dst "pv-wz" (src.pv-wz)
    in let d11 = __record-set dst "pv-lx" (src.pv-lx)
    in let d12 = __record-set dst "pv-ly" (src.pv-ly)
    in let d13 = __record-set dst "pv-ld" (src.pv-ld)
    in let d14 = __record-set dst "pv-iw" (src.pv-iw)
    in 0

  rw-copy-light : R3dLightPre, R3dLightPre -> Integer
  rw-copy-light (dst) (src) =
    let d0 = __record-set dst "lp-lx" (src.lp-lx)
    in let d1 = __record-set dst "lp-ly" (src.lp-ly)
    in let d2 = __record-set dst "lp-lz" (src.lp-lz)
    in let d3 = __record-set dst "lp-scale" (src.lp-scale)
    in let d4 = __record-set dst "lp-cr" (src.lp-cr)
    in let d5 = __record-set dst "lp-cg" (src.lp-cg)
    in let d6 = __record-set dst "lp-cb" (src.lp-cb)
    in 0

  rw-copy-ctx : R3dShadeCtx, R3dShadeCtx -> Integer
  rw-copy-ctx (dst) (src) =
    let d0 = __record-set dst "sc-mode" (src.sc-mode)
    in let d1 = __record-set dst "sc-g0" (src.sc-g0)
    in let d2 = __record-set dst "sc-g1" (src.sc-g1)
    in let d3 = __record-set dst "sc-g2" (src.sc-g2)
    in let d4 = __record-set dst "sc-base" (src.sc-base)
    in let d5 = __record-set dst "sc-ar" (src.sc-ar)
    in let d6 = __record-set dst "sc-ag" (src.sc-ag)
    in let d7 = __record-set dst "sc-ab" (src.sc-ab)
    in let d8 = __record-set dst "sc-diffuse" (src.sc-diffuse)
    in let d9 = __record-set dst "sc-specular" (src.sc-specular)
    in let d10 = __record-set dst "sc-shininess" (src.sc-shininess)
    in let d11 = __record-set dst "sc-ex" (src.sc-ex)
    in let d12 = __record-set dst "sc-ey" (src.sc-ey)
    in let d13 = __record-set dst "sc-ez" (src.sc-ez)
    in let d14 = __record-set dst "sc-amb" (src.sc-amb)
    in let d15 = __record-set dst "sc-sh-base" (src.sc-sh-base)
    in let d16 = __record-set dst "sc-sh-size" (src.sc-sh-size)
    in let d17 = __record-set dst "sc-sh-bias" (src.sc-sh-bias)
    in 0

  rw-copy-lights : List R3dLightPre, List R3dLightPre, Integer -> Integer
  rw-copy-lights (dst) (src) (i) =
    if i >= list-length dst then 0
    else let target = list-at dst i
    in let copied = if i < list-length src then rw-copy-light target (list-at src i)
      else let cleared = __record-set target "lp-scale" 0 in 0
    in rw-copy-lights dst src (i + 1)

Section: Raster Units

 The texture is borrowed from the pane-owned material. All numeric triangle
 and light state is copied into records allocated before the frame mark.
 A unit counts bounding-box attempts, including pixels outside the triangle.

  rw-begin : R3dRasterWork, R3dTriState, ProjVert, ProjVert, ProjVert, R3dShadeCtx, Maybe EngineTexture, Integer -> Integer
  rw-begin (work) (tgt) (a) (b) (c) (ctx) (texture) (plain) =
    let stopped = rw-cancel work
    in if list-length (ctx.sc-lights) > list-length (work.rw-ctx.sc-lights) | ctx.sc-shininess > rw-shininess-limit then 0 - 1
    else if tgt.r3t-w <= 0 | tgt.r3t-h <= 0 | tgt.r3t-stride < tgt.r3t-w then 0 - 1
    else if g-rw-target-ok tgt == False then 0 - 1
    else let ca = rw-copy-vertex (work.rw-a) a
    in let cb = rw-copy-vertex (work.rw-b) b
    in let cc = rw-copy-vertex (work.rw-c) c
    in let cs = rw-copy-ctx (work.rw-ctx) ctx
    in let cl = rw-copy-lights (work.rw-ctx.sc-lights) (ctx.sc-lights) 0
    in let tx = __record-set (work.rw-ctx) "sc-tex" texture
    in let min-x = r3d-max 0 (r3d-min3 (a.pv-sx) (b.pv-sx) (c.pv-sx))
    in let max-x = r3d-min (tgt.r3t-w - 1) (r3d-max3 (a.pv-sx) (b.pv-sx) (c.pv-sx))
    in let min-y = r3d-max 0 (r3d-min3 (a.pv-sy) (b.pv-sy) (c.pv-sy))
    in let max-y = r3d-min (tgt.r3t-h - 1) (r3d-max3 (a.pv-sy) (b.pv-sy) (c.pv-sy))
    in let x = __record-set work "rw-x" min-x
    in let y = __record-set work "rw-y" min-y
    in let lo = __record-set work "rw-min-x" min-x
    in let hi = __record-set work "rw-max-x" max-x
    in let bottom = __record-set work "rw-max-y" max-y
    in let bias = __record-set work "rw-bias" (r3d-slope-bias a b c ctx)
    in let mode = __record-set work "rw-plain" plain
    in let active = if min-x > max-x | min-y > max-y then 0 else 1
    in let state = __record-set work "rw-active" active
    in active

  g-rw-target-ok : R3dTriState -> Boolean
  g-rw-target-ok (tgt) = r3d-base-ok (tgt.r3t-base) & r3d-base-ok (tgt.r3t-depth)

  rw-cancel : R3dRasterWork -> Integer
  rw-cancel (work) =
    let a = __record-set work "rw-active" 0
    in let b = __record-set work "rw-attempts" 0
    in 0

  rw-step : R3dRasterWork, R3dTriState -> Integer
  rw-step (work) (tgt) =
    let reset = __record-set work "rw-attempts" 0
    in if work.rw-active /= 1 then 0
    else let service = (tgt.r3t-service) 0
    in rw-spans work tgt rw-pixel-limit

  rw-spans : R3dRasterWork, R3dTriState, Integer -> Integer
  rw-spans (work) (tgt) (left) =
    if work.rw-y > work.rw-max-y then
      let done = __record-set work "rw-active" 0 in 0
    else if left <= 0 then 1
    else let take = r3d-min left (work.rw-max-x - work.rw-x + 1)
    in let last = work.rw-x + take - 1
    in let drawn = if work.rw-plain == 1 then
      r3d-scan-cols tgt (work.rw-a) (work.rw-b) (work.rw-c) (work.rw-ctx.sc-g0) (work.rw-y) (work.rw-x) last
      else r3d-scan-cols-sh tgt (work.rw-a) (work.rw-b) (work.rw-c) (work.rw-ctx) (work.rw-bias) (work.rw-y) (work.rw-x) last
    in let count = __record-set work "rw-attempts" (work.rw-attempts + take)
    in let row-end = last >= work.rw-max-x
    in let y = __record-set work "rw-y" (work.rw-y + if row-end then 1 else 0)
    in let x = __record-set work "rw-x" (if row-end then work.rw-min-x else last + 1)
    in rw-spans work tgt (left - take)

  rw-clear-unit : R3dTriState, Integer, Integer -> Integer
  rw-clear-unit (tgt) (color) (at) =
    if g-rw-target-ok tgt == False | tgt.r3t-w <= 0 | tgt.r3t-h <= 0 | tgt.r3t-stride < tgt.r3t-w | at < 0 then 0 - 1
    else let service = (tgt.r3t-service) 0
    in rw-clear-pixels tgt color at (r3d-min (at + rw-pixel-limit) (tgt.r3t-w * tgt.r3t-h))

  rw-clear-pixels : R3dTriState, Integer, Integer, Integer -> Integer
  rw-clear-pixels (tgt) (color) (at) (stop) =
    if at >= stop then at
    else let y = at / tgt.r3t-w
    in let x = int-mod at tgt.r3t-w
    in let c = poke-32 (tgt.r3t-base) ((y * tgt.r3t-stride + x) * 4) color
    in let d = poke-32 (tgt.r3t-depth) (at * 4) r3d-far-depth
    in rw-clear-pixels tgt color (at + 1) stop

