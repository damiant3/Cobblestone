 Software 3D rasterization pipeline. Transforms mesh vertices through
 model-view-projection, clips against near plane, perspective-divides
 to screen coordinates, scanline-rasterizes with per-pixel depth test
 and Phong lighting. Fixed-point (scale 1000 for geometry, scale
 1000000 for depth buffer precision).

 We say:

Section: Depth Buffer

  DepthBuf = record {
    db-width : Integer,
    db-height : Integer,
    db-data : List Integer
  }

  db-new : Integer, Integer -> DepthBuf
  db-new (w) (h) = DepthBuf { db-width = w, db-height = h, db-data = db-fill-loop (w * h) [] }

  db-fill-loop : Integer, List Integer -> List Integer
  db-fill-loop (n) (acc) =
    if n <= 0 then acc
    else db-fill-loop (n - 1) (list-push acc 999999999)

  db-clear : DepthBuf -> DepthBuf
  db-clear (db) = db-new (db.db-width) (db.db-height)

  db-test-and-set : DepthBuf, Integer, Integer, Integer -> DepthBuf
  db-test-and-set (db) (x) (y) (depth) =
    if x < 0 then db
    else if y < 0 then db
    else if x >= db.db-width then db
    else if y >= db.db-height then db
    else let idx = y * db.db-width + x
    in let cur = list-at (db.db-data) idx
    in if depth < cur then DepthBuf { db-width = db.db-width, db-height = db.db-height, db-data = list-set-at (db.db-data) idx depth }
    else db

  db-test : DepthBuf, Integer, Integer, Integer -> Boolean
  db-test (db) (x) (y) (depth) =
    if x < 0 then False
    else if y < 0 then False
    else if x >= db.db-width then False
    else if y >= db.db-height then False
    else depth < list-at (db.db-data) (y * db.db-width + x)

Section: Render Target

  RenderTarget = record {
    rt-fb : Framebuf,
    rt-db : DepthBuf
  }

  rt-new : Integer, Integer, Integer -> RenderTarget
  rt-new (w) (h) (bg) = RenderTarget { rt-fb = fb-new w h bg, rt-db = db-new w h }

  rt-clear : RenderTarget, Integer -> RenderTarget
  rt-clear (rt) (bg) = RenderTarget { rt-fb = fb-new (rt.rt-fb.fb-width) (rt.rt-fb.fb-height) bg, rt-db = db-clear (rt.rt-db) }

Section: Projected Vertex

  ProjVert = record {
    pv-sx : Integer,
    pv-sy : Integer,
    pv-depth : Integer,
    pv-nx : Integer,
    pv-ny : Integer,
    pv-nz : Integer,
    pv-wu : Integer,
    pv-wv : Integer,
    pv-wx : Real,
    pv-wy : Real,
    pv-wz : Real
  }

Section: Vertex Transform Pipeline

 A Vertex holds integer world coordinates and Mat4 is Real, so the vertex
 crosses into clip space and the screen position crosses back to the integer
 pixel grid. The world position stays Real: it is only ever fed back into
 Vec3 arithmetic for shading. At v4w = 1.0 the w is a true homogeneous
 coordinate, where the old fixed-point code carried thousandths.

  r3d-transform-vertex : Vertex, Mat4, Mat4, Integer, Integer -> ProjVert
  r3d-transform-vertex (v) (mvp) (model) (half-w) (half-h) =
    let clip = mat4-transform-vec4 mvp (Vec4 { v4x = real-from-int (v.vp-x), v4y = real-from-int (v.vp-y), v4z = real-from-int (v.vp-z), v4w = 1.0 })
    in let world = mat4-transform-point model (vec3-new (real-from-int (v.vp-x)) (real-from-int (v.vp-y)) (real-from-int (v.vp-z)))
    in let w = clip.v4w
    in if w <= 0.0 then ProjVert { pv-sx = -9999, pv-sy = -9999, pv-depth = 999999999, pv-nx = v.vn-x, pv-ny = v.vn-y, pv-nz = v.vn-z, pv-wu = v.vu, pv-wv = v.vv, pv-wx = world.vx, pv-wy = world.vy, pv-wz = world.vz }
    else let ndc-x = clip.v4x / w
    in let ndc-y = clip.v4y / w
    in let ndc-z = clip.v4z / w
    in let fhw = real-from-int half-w
    in let fhh = real-from-int half-h
    in let sx = real-to-int (fhw + ndc-x * fhw)
    in let sy = real-to-int (fhh - ndc-y * fhh)
    in let depth = real-to-int ((ndc-z + 1.0) * 500000.0)
    in ProjVert { pv-sx = sx, pv-sy = sy, pv-depth = depth, pv-nx = v.vn-x, pv-ny = v.vn-y, pv-nz = v.vn-z, pv-wu = v.vu, pv-wv = v.vv, pv-wx = world.vx, pv-wy = world.vy, pv-wz = world.vz }

Section: Triangle Rasterization with Depth

  R3dTriState = record {
    r3t-fb : Framebuf,
    r3t-db : DepthBuf
  }

  r3d-rasterize-tri : R3dTriState, ProjVert, ProjVert, ProjVert, Integer -> R3dTriState
  r3d-rasterize-tri (st) (a) (b) (c) (color) =
    let min-y = r3d-max 0 (r3d-min3 (a.pv-sy) (b.pv-sy) (c.pv-sy))
    in let max-y = r3d-min (st.r3t-fb.fb-height - 1) (r3d-max3 (a.pv-sy) (b.pv-sy) (c.pv-sy))
    in let min-x = r3d-max 0 (r3d-min3 (a.pv-sx) (b.pv-sx) (c.pv-sx))
    in let max-x = r3d-min (st.r3t-fb.fb-width - 1) (r3d-max3 (a.pv-sx) (b.pv-sx) (c.pv-sx))
    in r3d-scan-rows st a b c color min-y max-y min-x max-x

  r3d-scan-rows : R3dTriState, ProjVert, ProjVert, ProjVert, Integer, Integer, Integer, Integer, Integer -> R3dTriState
  r3d-scan-rows (st) (a) (b) (c) (color) (y) (max-y) (min-x) (max-x) =
    if y > max-y then st
    else let st2 = r3d-scan-cols st a b c color y min-x max-x
    in r3d-scan-rows st2 a b c color (y + 1) max-y min-x max-x

  r3d-scan-cols : R3dTriState, ProjVert, ProjVert, ProjVert, Integer, Integer, Integer, Integer -> R3dTriState
  r3d-scan-cols (st) (a) (b) (c) (color) (y) (x) (max-x) =
    if x > max-x then st
    else let bary = r3d-barycentric a b c x y
    in if bary.bw0 >= 0 then if bary.bw1 >= 0 then if bary.bw2 >= 0 then
      let depth = r3d-interp-depth a b c (bary.bw0) (bary.bw1) (bary.bw2) (bary.bw-sum)
      in if db-test (st.r3t-db) x y depth then
        let st2 = R3dTriState {
          r3t-fb = fb-set (st.r3t-fb) x y color,
          r3t-db = db-test-and-set (st.r3t-db) x y depth
        }
        in r3d-scan-cols st2 a b c color y (x + 1) max-x
      else r3d-scan-cols st a b c color y (x + 1) max-x
    else r3d-scan-cols st a b c color y (x + 1) max-x
    else r3d-scan-cols st a b c color y (x + 1) max-x
    else r3d-scan-cols st a b c color y (x + 1) max-x

Section: R3dBarycentric Coordinates

  R3dBary = record {
    bw0 : Integer,
    bw1 : Integer,
    bw2 : Integer,
    bw-sum : Integer
  }

  r3d-barycentric : ProjVert, ProjVert, ProjVert, Integer, Integer -> R3dBary
  r3d-barycentric (a) (b) (c) (px) (py) =
    let v0x = c.pv-sx - a.pv-sx
    in let v0y = c.pv-sy - a.pv-sy
    in let v1x = b.pv-sx - a.pv-sx
    in let v1y = b.pv-sy - a.pv-sy
    in let v2x = px - a.pv-sx
    in let v2y = py - a.pv-sy
    in let d00 = v0x * v0x + v0y * v0y
    in let d01 = v0x * v1x + v0y * v1y
    in let d02 = v0x * v2x + v0y * v2y
    in let d11 = v1x * v1x + v1y * v1y
    in let d12 = v1x * v2x + v1y * v2y
    in let denom = d00 * d11 - d01 * d01
    in if denom == 0 then R3dBary { bw0 = -1, bw1 = -1, bw2 = -1, bw-sum = 1 }
    else let u = (d11 * d02 - d01 * d12) * 1000 / denom
    in let v = (d00 * d12 - d01 * d02) * 1000 / denom
    in let w = 1000 - u - v
    in R3dBary { bw0 = w, bw1 = v, bw2 = u, bw-sum = 1000 }

  r3d-interp-depth : ProjVert, ProjVert, ProjVert, Integer, Integer, Integer, Integer -> Integer
  r3d-interp-depth (a) (b) (c) (w0) (w1) (w2) (wsum) =
    if wsum == 0 then 999999999
    else (a.pv-depth * w0 + b.pv-depth * w1 + c.pv-depth * w2) / wsum

Section: Phong Shading

  r3d-shade-phong : Vec3, Vec3, Vec3, EngineMaterial, List Light3D, Integer, Integer, Integer -> Rgb
  r3d-shade-phong (world-pos) (normal) (eye-pos) (mat) (lights) (light-idx) (light-count) (ambient) =
    let base = rgb-scale (mat.emat-albedo) ambient
    in r3d-accum-lights world-pos normal eye-pos mat lights light-idx light-count base

  r3d-accum-lights : Vec3, Vec3, Vec3, EngineMaterial, List Light3D, Integer, Integer, Rgb -> Rgb
  r3d-accum-lights (world-pos) (normal) (eye-pos) (mat) (lights) (i) (n) (acc) =
    if i >= n then acc
    else let light = list-at lights i
    in let contrib = r3d-light-contrib world-pos normal eye-pos mat light
    in r3d-accum-lights world-pos normal eye-pos mat lights (i + 1) n (rgb-add acc contrib)

 Lighting stays on the integer 0..1000 scale that Rgb and EngineMaterial
 speak, and the geometry is Real, so a dot product crosses back at exactly
 one place: r3d-unit-to-milli.

 A lit surface keeps its own colour: the diffuse term is the albedo times the
 light, not the light alone. Scaling the bare light colour by the Lambert
 term, as this did, makes every lit face the colour of the lamp and leaves
 the material visible only in what ambient contributes, so a blue cube under
 a white key light comes out white.

  r3d-light-contrib : Vec3, Vec3, Vec3, EngineMaterial, Light3D -> Rgb
  r3d-light-contrib (world-pos) (normal) (eye-pos) (mat) (light) =
    when light
      is DirLight (dir) (col) (intensity) ->
        let to-light = mat4-v3-normalize dir
        in let n-dot-l = r3d-unit-to-milli (vec3-dot normal to-light)
        in let diffuse = if n-dot-l > 0 then n-dot-l * mat.emat-diffuse / 1000 else 0
        in let reflect = r3d-reflect (r3d-negate-vec to-light) normal
        in let to-eye = mat4-v3-normalize (vec3-subtract eye-pos world-pos)
        in let r-dot-v = r3d-unit-to-milli (vec3-dot reflect to-eye)
        in let spec-raw = if r-dot-v > 0 then r-dot-v else 0
        in let specular = r3d-pow-int spec-raw (mat.emat-shininess) * mat.emat-specular / 1000
        in let total = (diffuse + specular) * intensity / 1000
        in rgb-scale (rgb-multiply (mat.emat-albedo) col) (r3d-clamp total 0 1000)
      is PtLight (pos) (col) (intensity) (radius) ->
        let delta = vec3-subtract pos world-pos
        in let dist = r3d-vec-len delta
        in if dist > radius then rgb 0 0 0
        else let to-light = mat4-v3-normalize delta
        in let atten = 1000 - dist * 1000 / radius
        in let n-dot-l = r3d-unit-to-milli (vec3-dot normal to-light)
        in let diffuse = if n-dot-l > 0 then n-dot-l * mat.emat-diffuse * atten / 1000000 else 0
        in let total = diffuse * intensity / 1000
        in rgb-scale (rgb-multiply (mat.emat-albedo) col) (r3d-clamp total 0 1000)
      is SpotLight3D (pos) (dir) (col) (intensity) (angle) (falloff) ->
        rgb 0 0 0

Section: Scene Rendering

  r3d-render-scene : Scene3DState, Integer, Integer -> Framebuf
  r3d-render-scene (scene) (width) (height) =
    let rt = rt-new width height (rgb-to-packed (rgb 20 20 30))
    in let vp = camera3d-vp (scene.s3-camera)
    in let tri-st = R3dTriState { r3t-fb = rt.rt-fb, r3t-db = rt.rt-db }
    in let result = r3d-render-nodes scene vp tri-st 0 (scene.s3-count) width height
    in result.r3t-fb

  r3d-render-nodes : Scene3DState, Mat4, R3dTriState, Integer, Integer, Integer, Integer -> R3dTriState
  r3d-render-nodes (scene) (vp) (st) (i) (n) (w) (h) =
    if i >= n then st
    else let node = list-at (scene.s3-nodes) i
    in let st2 = if node.sn3-visible then r3d-render-node scene vp st node i w h else st
    in r3d-render-nodes scene vp st2 (i + 1) n w h

  r3d-render-node : Scene3DState, Mat4, R3dTriState, SceneNode3D, Integer, Integer, Integer -> R3dTriState
  r3d-render-node (scene) (vp) (st) (node) (idx) (w) (h) =
    when node.sn3-mesh
      is None -> st
      is Just (mesh) ->
        let model = scene3d-world-matrix scene idx
        in let mvp = mat4-mul vp model
        in let half-w = w / 2
        in let half-h = h / 2
        in r3d-render-mesh st mesh model mvp (node.sn3-material) (scene.s3-lights) (scene.s3-camera.c3-eye) (scene.s3-ambient) half-w half-h

  r3d-render-mesh : R3dTriState, Mesh, Mat4, Mat4, EngineMaterial, List Light3D, Vec3, Integer, Integer, Integer -> R3dTriState
  r3d-render-mesh (st) (mesh) (model) (mvp) (mat) (lights) (eye) (ambient) (half-w) (half-h) =
    let shading = mat.emat-shading
    in when shading
      is Unlit -> r3d-render-tris-unlit st mesh mvp mat half-w half-h 0 (mesh.mesh-index-count)
      is FlatShaded -> r3d-render-tris-flat st mesh model mvp mat lights eye ambient half-w half-h 0 (mesh.mesh-index-count)
      is GouraudShaded -> r3d-render-tris-flat st mesh model mvp mat lights eye ambient half-w half-h 0 (mesh.mesh-index-count)
      is PhongShaded -> r3d-render-tris-flat st mesh model mvp mat lights eye ambient half-w half-h 0 (mesh.mesh-index-count)

Section: Unlit Triangle Rendering

  r3d-render-tris-unlit : R3dTriState, Mesh, Mat4, EngineMaterial, Integer, Integer, Integer, Integer -> R3dTriState
  r3d-render-tris-unlit (st) (mesh) (mvp) (mat) (half-w) (half-h) (i) (n) =
    if i >= n then st
    else let i0 = mesh-index-at mesh i
    in let i1 = mesh-index-at mesh (i + 1)
    in let i2 = mesh-index-at mesh (i + 2)
    in let v0 = mesh-vertex-at mesh i0
    in let v1 = mesh-vertex-at mesh i1
    in let v2 = mesh-vertex-at mesh i2
    in let p0 = r3d-transform-vertex v0 mvp mat4-identity half-w half-h
    in let p1 = r3d-transform-vertex v1 mvp mat4-identity half-w half-h
    in let p2 = r3d-transform-vertex v2 mvp mat4-identity half-w half-h
    in let color = rgb-to-packed (mat.emat-albedo)
    in let st2 = r3d-rasterize-tri st p0 p1 p2 color
    in r3d-render-tris-unlit st2 mesh mvp mat half-w half-h (i + 3) n

Section: Flat/Phong Triangle Rendering

  r3d-render-tris-flat : R3dTriState, Mesh, Mat4, Mat4, EngineMaterial, List Light3D, Vec3, Integer, Integer, Integer, Integer, Integer -> R3dTriState
  r3d-render-tris-flat (st) (mesh) (model) (mvp) (mat) (lights) (eye) (ambient) (half-w) (half-h) (i) (n) =
    if i >= n then st
    else let i0 = mesh-index-at mesh i
    in let i1 = mesh-index-at mesh (i + 1)
    in let i2 = mesh-index-at mesh (i + 2)
    in let v0 = mesh-vertex-at mesh i0
    in let v1 = mesh-vertex-at mesh i1
    in let v2 = mesh-vertex-at mesh i2
    in let p0 = r3d-transform-vertex v0 mvp model half-w half-h
    in let p1 = r3d-transform-vertex v1 mvp model half-w half-h
    in let p2 = r3d-transform-vertex v2 mvp model half-w half-h
    in let face-nx = real-from-int (p0.pv-nx + p1.pv-nx + p2.pv-nx) / 3.0
    in let face-ny = real-from-int (p0.pv-ny + p1.pv-ny + p2.pv-ny) / 3.0
    in let face-nz = real-from-int (p0.pv-nz + p1.pv-nz + p2.pv-nz) / 3.0
    in let face-normal = mat4-v3-normalize (vec3-new face-nx face-ny face-nz)
    in let center = vec3-new ((p0.pv-wx + p1.pv-wx + p2.pv-wx) / 3.0) ((p0.pv-wy + p1.pv-wy + p2.pv-wy) / 3.0) ((p0.pv-wz + p1.pv-wz + p2.pv-wz) / 3.0)
    in let color = r3d-shade-phong center face-normal eye mat lights 0 (list-length lights) ambient
    in let st2 = r3d-rasterize-tri st p0 p1 p2 (rgb-to-packed color)
    in r3d-render-tris-flat st2 mesh model mvp mat lights eye ambient half-w half-h (i + 3) n

Section: Vector Helpers

 Vec3 is Real, so normalization and reflection are the Matrix4 primitives
 rather than the fixed-point integer routines this chapter used to carry.
 r3d-vec-len still answers in world units as an integer, because the point
 light compares it against an integer radius.

  r3d-unit-to-milli : Real -> Integer
  r3d-unit-to-milli (x) = real-to-int (x * 1000.0)

  r3d-vec-len : Vec3 -> Integer
  r3d-vec-len (v) = real-to-int (mat4-v3-length v)

  r3d-reflect : Vec3, Vec3 -> Vec3
  r3d-reflect (incoming) (normal) =
    let d = vec3-dot incoming normal
    in vec3-subtract incoming (vec3-scale normal (2.0 * d))

  r3d-negate-vec : Vec3 -> Vec3
  r3d-negate-vec (v) = vec3-scale v (-1.0)

Section: Math Helpers

  r3d-pow-int : Integer, Integer -> Integer
  r3d-pow-int (base) (exp) = r3d-pow-loop base exp 1000

  r3d-pow-loop : Integer, Integer, Integer -> Integer
  r3d-pow-loop (base) (exp) (acc) =
    if exp <= 0 then acc
    else r3d-pow-loop base (exp - 1) (acc * base / 1000)

  r3d-min : Integer, Integer -> Integer
  r3d-min (a) (b) = if a < b then a else b

  r3d-max : Integer, Integer -> Integer
  r3d-max (a) (b) = if a > b then a else b

  r3d-min3 : Integer, Integer, Integer -> Integer
  r3d-min3 (a) (b) (c) = r3d-min a (r3d-min b c)

  r3d-max3 : Integer, Integer, Integer -> Integer
  r3d-max3 (a) (b) (c) = r3d-max a (r3d-max b c)

  r3d-clamp : Integer, Integer, Integer -> Integer
  r3d-clamp (v) (lo) (hi) = if v < lo then lo else if v > hi then hi else v

  r3d-abs : Integer -> Integer
  r3d-abs (n) = if n < 0 then 0 - n else n

