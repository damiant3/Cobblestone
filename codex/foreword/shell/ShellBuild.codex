Chapter: ShellBuild

  cites Shell chapter ShellTypes
  cites Foreword chapter Maybe

 We say:

Section: Expression Builders

  sh-lit : Text -> ShellExpr
  sh-lit (s) = SeLit s

  var : Text -> ShellExpr
  var (s) = SeVar s

  env : Text -> ShellExpr
  env (s) = SeEnvVar s

 msg is the one to reach for when a string carries a $variable. sh-lit is
 SINGLE-quoted and cannot interpolate, which is what pushed authors to raw-expr
 with a hand-escaped shell string inside a Codex string; the emitter does that
 quoting now. raw-expr is DEPRECATED with the rest of the raw pair.

  msg : Text -> ShellExpr
  msg (s) = SeText s

  join-path : List ShellExpr -> ShellExpr
  join-path (parts) = SePathJoinN parts
  raw-expr : Text -> ShellExpr
  raw-expr (s) = SeRaw s

Section: Command Builders

  sh-run : Text, List ShellExpr -> ShellCmd
  sh-run (cmd) (args) = ScRun cmd args

  sh-dot : ShellExpr -> ShellCmd
  sh-dot (path) = ScRunDot path

  sh-assign : Text, ShellExpr -> ShellCmd
  sh-assign (name) (value) = ScAssign name value

  sh-echo : ShellExpr -> ShellCmd
  sh-echo (e) = ScEcho e

  sh-error : ShellExpr -> ShellCmd
  sh-error (e) = ScWriteError e

  sh-copy : ShellExpr, ShellExpr -> ShellCmd
  sh-copy (src) (dst) = ScCopy src dst

  sh-delete : ShellExpr -> ShellCmd
  sh-delete (path) = ScDelete path

  sh-mkdir : ShellExpr -> ShellCmd
  sh-mkdir (path) = ScMkdir path

  sh-if : ShellExpr, List ShellCmd, List ShellCmd -> ShellCmd
  sh-if (cond) (then-cmds) (else-cmds) = ScIf cond then-cmds else-cmds

  sh-when : ShellExpr, List ShellCmd -> ShellCmd
  sh-when (cond) (cmds) = ScIf cond cmds []

  set : Text, ShellExpr -> ShellCmd
  set (name) (value) = ScAssign name value

  if-set : Text, List ShellCmd, List ShellCmd -> ShellCmd
  if-set (name) (then-cmds) (else-cmds) = ScIf (SeVar name) then-cmds else-cmds

  need-file : ShellExpr, Integer, ShellExpr -> ShellCmd
  need-file (path) (code) (message) = ScIf (SeNot (SeFileExists path)) [ScWriteError message, ScExit (SeInt code)] []

  sh-for : Text, ShellExpr, List ShellCmd -> ShellCmd
  sh-for (name) (items) (cmds) = ScFor name items cmds

  sh-while : ShellExpr, List ShellCmd -> ShellCmd
  sh-while (cond) (cmds) = ScWhile cond cmds

  sh-exit : Integer -> ShellCmd
  sh-exit (code) = ScExit (SeInt code)

  sh-comment : Text -> ShellCmd
  sh-comment (text) = ScComment text

  sh-raw : Text -> ShellCmd
  sh-raw (text) = ScRaw text

  sh-foreach : Text, ShellExpr, List ShellCmd -> ShellCmd
  sh-foreach (name) (items) (body) = ScForEach name items body

  sh-for-loop : Text, ShellExpr, ShellExpr, ShellExpr, List ShellCmd -> ShellCmd
  sh-for-loop (name) (init) (cond) (step) (body) = ScForLoop name init cond step body

  sh-labeled-while : Text, ShellExpr, List ShellCmd -> ShellCmd
  sh-labeled-while (label) (cond) (body) = ScLabeledWhile label cond body

  sh-continue-label : Text -> ShellCmd
  sh-continue-label (label) = ScContinueLabel label

  sh-dotnet : Text, Text, List ShellExpr -> ShellCmd
  sh-dotnet (cls) (method) (args) = ScDotNetCall cls method args

  sh-dotnet-assign : Text, Text, Text, List ShellExpr -> ShellCmd
  sh-dotnet-assign (result) (cls) (method) (args) = ScDotNetCallAssign result cls method args

  sh-set-content : ShellExpr, ShellExpr -> ShellCmd
  sh-set-content (path) (value) = ScSetContent path value

  sh-add-content : ShellExpr, ShellExpr -> ShellCmd
  sh-add-content (path) (value) = ScAddContent path value

  sh-try : List ShellCmd, List ShellCmd, List ShellCmd -> ShellCmd
  sh-try (body) (catch-cmds) (finally-cmds) = ScTry body catch-cmds finally-cmds

  sh-hash : Text, Text, ShellExpr -> ShellCmd
  sh-hash (algo) (result-var) (path) = ScHashFile algo result-var path

  sh-read-bytes : Text, ShellExpr -> ShellCmd
  sh-read-bytes (result-var) (path) = ScReadBytes result-var path

  sh-write-bytes : ShellExpr, ShellExpr -> ShellCmd
  sh-write-bytes (path) (data) = ScWriteBytes path data

Section: Process Builders

  sh-start-process : Text, ShellExpr, List ShellExpr -> ShellCmd
  sh-start-process (result-var) (exe) (args) =
    ScStartProcess (ShellProcessSpec {
      sp-executable = exe,
      sp-arguments = args,
      sp-result-var = result-var,
      sp-stdout-file = None,
      sp-stderr-file = None,
      sp-hidden = True,
      sp-passthru = True
    })

  sh-start-process-stderr : Text, ShellExpr, List ShellExpr, ShellExpr -> ShellCmd
  sh-start-process-stderr (result-var) (exe) (args) (stderr-path) =
    ScStartProcess (ShellProcessSpec {
      sp-executable = exe,
      sp-arguments = args,
      sp-result-var = result-var,
      sp-stdout-file = None,
      sp-stderr-file = Just stderr-path,
      sp-hidden = True,
      sp-passthru = True
    })

  sh-wait : Text, Integer -> ShellCmd
  sh-wait (proc-var) (timeout-ms) = ScWaitProcess proc-var timeout-ms

Section: Param Builders

  sh-param : Text, ShellParamType -> ShellParam
  sh-param (name) (ty) = ShellParam {
    sp-name = name,
    sp-type = ty,
    sp-mandatory = True,
    sp-default = None,
    sp-choices = [],
    sp-doc = [],
    sp-attrs = []
  }

 Optional with no default, which is NOT the same as sh-param and is the
 shape a pass-through argument needs. A mandatory parameter with no value
 makes the shell prompt, and a prompt is a hang rather than a refusal when
 the caller is a harness with no console.

  sh-param-optional : Text, ShellParamType -> ShellParam
  sh-param-optional (name) (ty) = ShellParam {
    sp-name = name,
    sp-type = ty,
    sp-mandatory = False,
    sp-default = None,
    sp-choices = [],
    sp-doc = [],
    sp-attrs = []
  }

  sh-param-default : Text, ShellParamType, ShellExpr -> ShellParam
  sh-param-default (name) (ty) (def) = ShellParam {
    sp-name = name,
    sp-type = ty,
    sp-mandatory = False,
    sp-default = Just def,
    sp-choices = [],
    sp-doc = [],
    sp-attrs = []
  }

 A closed choice that also has a default, which is the shape every
 validated parameter in the tree actually has: -Arch, -Accel, -OnMissing
 and -Case are all ValidateSet with a value to fall back on. sh-param-choice
 alone cannot express it, being mandatory, and a mandatory parameter is the
 headless hang described above.

  sh-param-choice-default : Text, List Text, ShellExpr -> ShellParam
  sh-param-choice-default (name) (choices) (def) = ShellParam {
    sp-name = name,
    sp-type = SptString,
    sp-mandatory = False,
    sp-default = Just def,
    sp-choices = choices,
    sp-doc = [],
    sp-attrs = []
  }

  sh-param-choice : Text, List Text -> ShellParam
  sh-param-choice (name) (choices) = ShellParam {
    sp-name = name,
    sp-type = SptString,
    sp-mandatory = True,
    sp-default = None,
    sp-choices = choices,
    sp-doc = [],
    sp-attrs = []
  }

  sh-switch : Text -> ShellParam
  sh-switch (name) = ShellParam {
    sp-name = name,
    sp-type = SptSwitch,
    sp-mandatory = False,
    sp-default = None,
    sp-choices = [],
    sp-doc = [],
    sp-attrs = []
  }

  sh-doc : List Text, ShellParam -> ShellParam
  sh-doc (lines) (p) = ShellParam {
    sp-name = p.sp-name,
    sp-type = p.sp-type,
    sp-mandatory = p.sp-mandatory,
    sp-default = p.sp-default,
    sp-choices = p.sp-choices,
    sp-doc = lines,
    sp-attrs = p.sp-attrs
  }

  sh-attrs : List Text, ShellParam -> ShellParam
  sh-attrs (attrs) (p) = ShellParam {
    sp-name = p.sp-name,
    sp-type = p.sp-type,
    sp-mandatory = p.sp-mandatory,
    sp-default = p.sp-default,
    sp-choices = p.sp-choices,
    sp-doc = p.sp-doc,
    sp-attrs = attrs
  }

Section: Script Builder

  sh-script : Text, Text, List ShellParam, List ShellCmd -> ShellScript
  sh-script (name) (desc) (params) (body) = ShellScript {
    ss-name = name,
    ss-description = desc,
    ss-params = params,
    ss-body = body
  }

