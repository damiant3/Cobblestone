Chapter: Pipeline

  cites Foreword chapter Maybe
  cites Shell chapter ShellTypes

Section: Artifacts

  PipeKind =
    | PkFile
    | PkDir
    | PkValue
    | PkText
    | PkFunction

  PipeArtifact = record {
    pa-name : Text,
    pa-kind : PipeKind,
    pa-expr : ShellExpr,
    pa-from : Maybe ShellExpr
  }

Section: Resources

  PipeResourceKind =
    | RkGuests
    | RkMemoryMb
    | RkPort

  PipeResource =
    | PrGuests (Integer)
    | PrMemoryMb (Integer)
    | PrPort (Integer)
    | PrKernel (ShellExpr)
    | PrDriven (PipeResourceKind) (ShellExpr)

Section: Verdicts

  PipeOutcome =
    | PoExit (Integer) (Text)
    | PoPassthrough (Text)
    | PoComputed (Text)
    | PoThrow (Text)

Section: Stages

  PipeStage = record {
    ps-name : Text,
    ps-why : Text,
    ps-in : List Text,
    ps-out : List PipeArtifact,
    ps-needs : List PipeResource,
    ps-verdict : List PipeOutcome,
    ps-body : List ShellCmd
  }

  PipeRepeat =
    | PrWhile (ShellExpr)
    | PrWhileLabeled (Text) (ShellExpr)
    | PrForEach (Text) (ShellExpr)

  PipeStep =
    | PsStage (PipeStage)
    | PsGroup (Maybe PipeRepeat) (Maybe ShellExpr) (Maybe PipeStage) (List PipeStep)

  Pipeline = record {
    pl-name : Text,
    pl-doc : Text,
    pl-params : List ShellParam,
    pl-stages : List PipeStep
  }

Section: Resolving a name

  pipe-param-named : List ShellParam, Text, Integer -> Boolean
  pipe-param-named (ps) (name) (i) =
    if i >= list-length ps then False
    else if ((list-at ps i).sp-name) == name then True
    else pipe-param-named ps name (i + 1)

  pipe-find-in-outs : List PipeArtifact, Text, Integer -> Maybe ShellExpr
  pipe-find-in-outs (outs) (name) (i) =
    if i >= list-length outs then None
    else let a = list-at outs i
    in if (a.pa-name) == name then Just (a.pa-expr)
    else pipe-find-in-outs outs name (i + 1)

  pipe-ref : List PipeArtifact, List ShellParam, Text -> ShellExpr
  pipe-ref (arts) (params) (name) =
    if pipe-param-named params name 0 then SeVar name
    else when pipe-find-in-outs arts name 0
      is Just (e) -> e
      is None -> SeLit ("UNRESOLVED:" & name)

  pipe-param-ref : List ShellParam, Text -> ShellExpr
  pipe-param-ref (params) (name) =
    if pipe-param-named params name 0 then SeVar name
    else SeLit ("UNRESOLVED-PARAM:" & name)

  pipe-produce : PipeArtifact -> ShellCmd
  pipe-produce (a) =
    when a.pa-from
      is Just (e) -> ScAssign (a.pa-name) e
      is None -> ScComment ("UNPRODUCED:" & (a.pa-name))

Section: Lowering to the shell AST

  pipe-group-repeat : PipeRepeat, List ShellCmd -> ShellCmd
  pipe-group-repeat (r) (body) =
    when r
      is PrWhile (c) -> ScWhile c body
      is PrWhileLabeled (lbl) (c) -> ScLabeledWhile lbl c body
      is PrForEach (n) (items) -> ScForEach n items body

  pipe-one-or-seq : List ShellCmd -> ShellCmd
  pipe-one-or-seq (cs) =
    if list-length cs == 1 then list-at cs 0 else ScSequence cs

  pipe-group-wrap : Maybe PipeRepeat, Maybe ShellExpr, Maybe PipeStage, List ShellCmd -> ShellCmd
  pipe-group-wrap (rep) (guard) (handler) (body) =
    let held = when handler
      is Just (h) -> [ScTry body [] (h.ps-body)]
      is None -> body
    in let looped = when rep
      is Just (r) -> [pipe-group-repeat r held]
      is None -> held
    in when guard
      is Just (c) -> ScIf c looped []
      is None -> pipe-one-or-seq looped

  pipe-group-lone : List PipeStep, List ShellCmd -> List ShellCmd
  pipe-group-lone (steps) (walked) =
    if list-length steps >= 2 then walked
    else if list-length steps == 0 then walked
    else when list-at steps 0
      is PsStage (s) -> s.ps-body
      is PsGroup (r) (g) (h) (inner) -> walked

  pipe-stage-cmds : List PipeStep, Integer, List ShellCmd -> List ShellCmd
  pipe-stage-cmds (ss) (i) (acc) =
    if i >= list-length ss then acc
    else let one = when list-at ss i
      is PsStage (s) -> ScSequence (s.ps-body)
      is PsGroup (rep) (guard) (handler) (inner) ->
        pipe-group-wrap rep guard handler (pipe-group-lone inner (pipe-stage-cmds inner 0 []))
    in pipe-stage-cmds ss (i + 1) (list-push acc one)

  pipeline-to-shell : Pipeline -> ShellScript
  pipeline-to-shell (pl) =
    ShellScript {
      ss-name = pl.pl-name,
      ss-description = pl.pl-doc,
      ss-params = pl.pl-params,
      ss-body = pipe-stage-cmds (pl.pl-stages) 0 []
    }

Section: Reading the model back

  pipe-kind-text : PipeKind -> Text
  pipe-kind-text (k) =
    when k
      is PkFile -> "file"
      is PkDir -> "dir"
      is PkValue -> "value"
      is PkText -> "text"
      is PkFunction -> "function"

  pipe-arts-text : List PipeArtifact, Integer, Text -> Text
  pipe-arts-text (as) (i) (acc) =
    if i >= list-length as then acc
    else let a = list-at as i
    in pipe-arts-text as (i + 1) (acc & (if acc == "" then "" else ", ") & (a.pa-name) & ":" & pipe-kind-text (a.pa-kind))

  pipe-outcome-text : PipeOutcome -> Text
  pipe-outcome-text (o) =
    when o
      is PoExit (n) (why) -> "exit " & show n & ": " & why
      is PoPassthrough (why) -> "exit of the child: " & why
      is PoComputed (why) -> "a computed exit: " & why
      is PoThrow (why) -> "throws: " & why

  pipe-resource-kind-text : PipeResourceKind -> Text
  pipe-resource-kind-text (k) =
    when k
      is RkGuests -> "guests"
      is RkMemoryMb -> "memory-mb"
      is RkPort -> "port"

  pipe-names-text : List Text, Integer, Text -> Text
  pipe-names-text (ns) (i) (acc) =
    if i >= list-length ns then acc
    else pipe-names-text ns (i + 1) (acc & (if acc == "" then "" else ", ") & list-at ns i)

  pipe-stage-line : PipeStage -> Text
  pipe-stage-line (s) =
    (s.ps-name) & " | in: " & pipe-names-text (s.ps-in) 0 ""
      & " | out: " & pipe-arts-text (s.ps-out) 0 ""
      & " | " & (s.ps-why)

  pipe-repeat-text : PipeRepeat -> Text
  pipe-repeat-text (r) =
    when r
      is PrWhile (c) -> "while"
      is PrWhileLabeled (lbl) (c) -> "while :" & lbl
      is PrForEach (n) (items) -> "foreach $" & n

  pipe-rep-part : Maybe PipeRepeat -> Text
  pipe-rep-part (m) =
    when m
      is Just (r) -> " | repeat: " & pipe-repeat-text r
      is None -> ""

  pipe-guard-part : Maybe ShellExpr -> Text
  pipe-guard-part (m) =
    when m
      is Just (c) -> " | guarded"
      is None -> ""

  pipe-handler-part : Maybe PipeStage -> Text
  pipe-handler-part (m) =
    when m
      is Just (h) -> " | handler: " & (h.ps-name)
      is None -> ""

  pipe-doc-lines : List PipeStep, Integer, Text, List Text -> List Text
  pipe-doc-lines (ss) (i) (pad) (acc) =
    if i >= list-length ss then acc
    else when list-at ss i
      is PsStage (s) -> pipe-doc-lines ss (i + 1) pad (list-push acc (pad & pipe-stage-line s))
      is PsGroup (rep) (guard) (handler) (inner) ->
        pipe-doc-lines ss (i + 1) pad (pipe-doc-lines inner 0 (pad & "  ")
          (list-push acc (pad & "group" & pipe-rep-part rep & pipe-guard-part guard & pipe-handler-part handler)))

  pipeline-doc : Pipeline -> List Text
  pipeline-doc (pl) = pipe-doc-lines (pl.pl-stages) 0 "" []

