Section: Process Spec

  ShellProcessSpec = record {
    sp-executable : ShellExpr,
    sp-arguments : List ShellExpr,
    sp-result-var : Text,
    sp-stdout-file : Maybe ShellExpr,
    sp-stderr-file : Maybe ShellExpr,
    sp-hidden : Boolean,
    sp-passthru : Boolean
  }

Section: Parameters

  ShellParamType =
    | SptString
    | SptInt
    | SptSwitch
    | SptBool
    | SptPath
    | SptStringArray
    | SptLong

  ShellParam = record {
    sp-name : Text,
    sp-type : ShellParamType,
    sp-mandatory : Boolean,
    sp-default : Maybe ShellExpr,
    sp-choices : List Text,
    sp-doc : List Text,
    sp-attrs : List Text
  }

Section: The Generated Banner

 One definition rather than one per emitter, because three copies of a
 warning are three things that drift apart, and this one appears at the top
 of every generated script in the tree.

  generated-banner : Text =
    "# GENERATED FROM THE CODEX SHELL DSL. Do not edit by hand.\n# A hand edit here must NOT be submitted. Change the generator under\n# codex/build/, regenerate, and submit the generator and this file\n# together. Until then build/check-generated-scripts.ps1 reports this\n# file as drifted, and the next regeneration discards the edit.\n"

Section: Script

  ShellScript = record {
    ss-name : Text,
    ss-description : Text,
    ss-params : List ShellParam,
    ss-body : List ShellCmd
  }

