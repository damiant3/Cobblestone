Chapter: Easing

 Easing functions for animation. Input t is 0-1000 (fixed-point),
 output is 0-1000. Provides linear, quadratic, cubic, elastic,
 bounce, and back easing in ease-in, ease-out, ease-in-out forms.

 We say:

Section: Linear
  ease-linear : Integer -> Integer
  ease-linear (t) = t

Section: Quadratic
  ease-in-quad : Integer -> Integer
  ease-in-quad (t) = t * t / 1000

  ease-out-quad : Integer -> Integer
  ease-out-quad (t) = t * (2000 - t) / 1000

  ease-in-out-quad : Integer -> Integer
  ease-in-out-quad (t) =
    if t < 500 then 2 * t * t / 1000
    else let f = t - 500
    in 500 + 2 * f * (1000 - f) / 1000

Section: Cubic
  ease-in-cubic : Integer -> Integer
  ease-in-cubic (t) = t * t / 1000 * t / 1000

  ease-out-cubic : Integer -> Integer
  ease-out-cubic (t) =
    let f = t - 1000
    in 1000 + f * f / 1000 * f / 1000

  ease-in-out-cubic : Integer -> Integer
  ease-in-out-cubic (t) =
    if t < 500 then 4 * t * t / 1000 * t / 1000
    else let f = 2 * t - 2000
    in 1000 + f * f / 1000 * f / 2000

Section: Sine Approximation
  ease-in-sine : Integer -> Integer
  ease-in-sine (t) =
    let angle = t * 1571 / 1000
    in 1000 - ease-cos-approx angle

  ease-out-sine : Integer -> Integer
  ease-out-sine (t) =
    let angle = t * 1571 / 1000
    in ease-sin-approx angle

  ease-sin-approx : Integer -> Integer
  ease-sin-approx (x) =
    let x3 = x * x / 1000 * x / 1000
    in x - x3 / 6

  ease-cos-approx : Integer -> Integer
  ease-cos-approx (x) =
    let x2 = x * x / 1000
    in let x4 = x2 * x2 / 1000
    in 1000 - x2 / 2 + x4 / 24

Section: Elastic
  ease-out-elastic : Integer -> Integer
  ease-out-elastic (t) =
    if t <= 0 then 0
    else if t >= 1000 then 1000
    else let decay = 1000 - t * 3 / 10
    in let osc = ease-sin-approx (t * 10472 / 1000)
    in 1000 - decay * osc / 1000

Section: Bounce
  ease-out-bounce : Integer -> Integer
  ease-out-bounce (t) =
    if t < 363 then 7563 * t / 1000 * t / 1000000
    else if t < 727 then let f = t - 545
      in 7563 * f / 1000 * f / 1000000 + 750
    else if t < 909 then let f = t - 818
      in 7563 * f / 1000 * f / 1000000 + 938
    else let f = t - 955
    in 7563 * f / 1000 * f / 1000000 + 984

  ease-in-bounce : Integer -> Integer
  ease-in-bounce (t) = 1000 - ease-out-bounce (1000 - t)

Section: Back (Overshoot)
  ease-in-back : Integer -> Integer
  ease-in-back (t) =
    let s = 1700
    in t * t / 1000 * ((s + 1000) * t / 1000 - s) / 1000

  ease-out-back : Integer -> Integer
  ease-out-back (t) =
    let f = t - 1000
    in let s = 1700
    in 1000 + f * f / 1000 * ((s + 1000) * f / 1000 + s) / 1000

Section: Interpolation Helper
  ease-lerp : Integer, Integer, Integer -> Integer
  ease-lerp (a) (b) (t) = a + (b - a) * t / 1000

