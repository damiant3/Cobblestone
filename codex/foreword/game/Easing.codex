Chapter: Easing
  cites Math chapter Cordic

 Easing functions for animation. Input t is 0-1000 (fixed-point),
 output is 0-1000. Provides linear, quadratic, cubic, elastic,
 bounce, and back easing in ease-in, ease-out, ease-in-out forms.

Section: Linear
  ease-linear : Integer -> Integer
  ease-linear (t) = t

Section: Quadratic
  ease-in-quad : Integer -> Integer
  ease-in-quad (t) = t * t / 1000

  ease-out-quad : Integer -> Integer
  ease-out-quad (t) = t * (2000 - t) / 1000

  ease-in-out-quad : Integer -> Integer
  ease-in-out-quad (t) =
    if t < 500 then 2 * t * t / 1000
    else let f = t - 500
    in 500 + 2 * f * (1000 - f) / 1000

Section: Cubic
  ease-in-cubic : Integer -> Integer
  ease-in-cubic (t) = t * t / 1000 * t / 1000

  ease-out-cubic : Integer -> Integer
  ease-out-cubic (t) =
    let f = t - 1000
    in 1000 + f * f / 1000 * f / 1000

  ease-in-out-cubic : Integer -> Integer
  ease-in-out-cubic (t) =
    if t < 500 then 4 * t * t / 1000 * t / 1000
    else let f = 2 * t - 2000
    in 1000 + f * f / 1000 * f / 2000

Section: Sine Approximation
  ease-in-sine : Integer -> Integer
  ease-in-sine (t) =
    if t <= 0 then 0
    else if t >= 1000 then 1000
    else 1000 - cordic-cos (t * 1571 / 1000)

  ease-out-sine : Integer -> Integer
  ease-out-sine (t) =
    if t <= 0 then 0
    else if t >= 1000 then 1000
    else cordic-sin (t * 1571 / 1000)

Section: Elastic
 2^(-10t) * sin((10t - 0.75) * 2pi/3) + 1, t at scale 1000. 2094 is 2pi/3 at
 scale 1000.

  ease-out-elastic : Integer -> Integer
  ease-out-elastic (t) =
    if t <= 0 then 0
    else if t >= 1000 then 1000
    else let decay = ease-exp2-neg (10 * t)
    in let osc = cordic-sin ((10 * t - 750) * 2094 / 1000)
    in 1000 + decay * osc / 1000

 1000 * 2^(-x / 1000): whole halvings, then e^(-f ln 2) for the fraction by
 eight Taylor terms (693 is ln 2 at scale 1000, so the series argument stays
 below 1).

  ease-exp2-neg : Integer -> Integer
  ease-exp2-neg (x) =
    if x <= 0 then 1000
    else if x >= 20000 then 0
    else let frac = ease-exp-series ((x - x / 1000 * 1000) * 693 / 1000) 1 1000000 1000000
    in ease-halve (frac / 1000) (x / 1000)

  ease-halve : Integer, Integer -> Integer
  ease-halve (v) (k) = if k <= 0 then v else ease-halve (v / 2) (k - 1)

  ease-exp-series : Integer, Integer, Integer, Integer -> Integer
  ease-exp-series (y) (n) (term) (sum) =
    if n > 8 then sum
    else let next = (0 - term) * y / (1000 * n)
    in ease-exp-series y (n + 1) next (sum + next)

Section: Bounce
  ease-out-bounce : Integer -> Integer
  ease-out-bounce (t) =
    if t >= 1000 then 1000
    else if t < 363 then 7563 * t / 1000 * t / 1000
    else if t < 727 then let f = t - 545
    in 7563 * f / 1000 * f / 1000 + 750
    else if t < 909 then let f = t - 818
    in 7563 * f / 1000 * f / 1000 + 938
    else let f = t - 955
    in 7563 * f / 1000 * f / 1000 + 984

  ease-in-bounce : Integer -> Integer
  ease-in-bounce (t) = 1000 - ease-out-bounce (1000 - t)

Section: Back (Overshoot)
  ease-in-back : Integer -> Integer
  ease-in-back (t) =
    let s = 1700
    in t * t / 1000 * ((s + 1000) * t / 1000 - s) / 1000

  ease-out-back : Integer -> Integer
  ease-out-back (t) =
    let f = t - 1000
    in let s = 1700
    in 1000 + f * f / 1000 * ((s + 1000) * f / 1000 + s) / 1000

Section: Interpolation Helper
  ease-lerp : Integer, Integer, Integer -> Integer
  ease-lerp (a) (b) (t) = a + (b - a) * t / 1000

