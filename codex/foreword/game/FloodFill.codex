Chapter: FloodFill

 Flood fill on a 2D grid. Fills connected regions of matching
 cells with a new value. Uses an explicit stack (List Integer)
 instead of recursion to avoid stack overflow on large grids.

 We say:

Section: Grid
  FfGrid = record {
    ff-cells : List Integer,
    ff-width : Integer between 1 and 1024,
    ff-height : Integer between 1 and 1024
  }

  ff-new : Integer, Integer, Integer -> FfGrid
  ff-new (w) (h) (fill) = FfGrid { ff-cells = ff-fill-cells (w * h) fill 0 [], ff-width = __narrow w, ff-height = __narrow h }

  ff-fill-cells : Integer, Integer, Integer, List Integer -> List Integer
  ff-fill-cells (n) (fill) (i) (acc) =
    if i >= n then acc
    else ff-fill-cells n fill (i + 1) (list-push acc fill)

  ff-get : FfGrid, Integer, Integer -> Integer
  ff-get (g) (x) (y) =
    if x < 0 then 0 - 1 else if y < 0 then 0 - 1
    else if x >= g.ff-width then 0 - 1 else if y >= g.ff-height then 0 - 1
    else list-at (g.ff-cells) (y * g.ff-width + x)

  ff-set : FfGrid, Integer, Integer, Integer -> FfGrid
  ff-set (g) (x) (y) (val) =
    FfGrid { ff-cells = list-set-at (g.ff-cells) (y * g.ff-width + x) val, ff-width = g.ff-width, ff-height = g.ff-height }

Section: Flood Fill
  flood-fill : FfGrid, Integer, Integer, Integer -> FfGrid
  flood-fill (g) (x) (y) (new-val) =
    let old-val = ff-get g x y
    in if old-val == new-val then g
    else if old-val < 0 then g
    else ff-fill-loop (ff-set g x y new-val) old-val new-val [x, y]

  ff-fill-loop : FfGrid, Integer, Integer, List Integer -> FfGrid
  ff-fill-loop (g) (old-val) (new-val) (stack) =
    if list-length stack < 2 then g
    else let sx = list-at stack 0
    in let sy = list-at stack 1
    in let rest = ff-drop-2 stack
    in let result = ff-check-neighbors g old-val new-val sx sy rest
    in ff-fill-loop (result.ff-grid) old-val new-val (result.ff-stack)

  FfState = record { ff-grid : FfGrid, ff-stack : List Integer }

  ff-check-neighbors : FfGrid, Integer, Integer, Integer, Integer, List Integer -> FfState
  ff-check-neighbors (g) (old-val) (new-val) (x) (y) (stack) =
    let s1 = ff-try-fill g old-val new-val (x + 1) y stack
    in let s2 = ff-try-fill (s1.ff-grid) old-val new-val (x - 1) y (s1.ff-stack)
    in let s3 = ff-try-fill (s2.ff-grid) old-val new-val x (y + 1) (s2.ff-stack)
    in ff-try-fill (s3.ff-grid) old-val new-val x (y - 1) (s3.ff-stack)

  ff-try-fill : FfGrid, Integer, Integer, Integer, Integer, List Integer -> FfState
  ff-try-fill (g) (old-val) (new-val) (x) (y) (stack) =
    if ff-get g x y == old-val then FfState { ff-grid = ff-set g x y new-val, ff-stack = [x, y] & stack }
    else FfState { ff-grid = g, ff-stack = stack }

  ff-drop-2 : List Integer -> List Integer
  ff-drop-2 (xs) = ff-drop-n xs 2 (list-length xs) []

  ff-drop-n : List Integer, Integer, Integer, List Integer -> List Integer
  ff-drop-n (xs) (start) (len) (acc) =
    if start >= len then acc
    else ff-drop-n xs (start + 1) len (list-push acc (list-at xs start))

Section: Queries
  ff-count-value : FfGrid, Integer -> Integer
  ff-count-value (g) (val) = ff-count-loop (g.ff-cells) val 0 (g.ff-width * g.ff-height) 0

  ff-count-loop : List Integer, Integer, Integer, Integer, Integer -> Integer
  ff-count-loop (cells) (val) (i) (len) (acc) =
    if i >= len then acc
    else ff-count-loop cells val (i + 1) len (acc + if list-at cells i == val then 1 else 0)

  ff-row-text : FfGrid, Integer -> Text
  ff-row-text (g) (y) = ff-row-loop g 0 y ""

  ff-row-loop : FfGrid, Integer, Integer, Text -> Text
  ff-row-loop (g) (x) (y) (acc) =
    if x >= g.ff-width then acc
    else ff-row-loop g (x + 1) y (acc & show (ff-get g x y))

