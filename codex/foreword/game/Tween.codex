Chapter: Tween

 Animation interpolation (tweening). Fixed-point easing functions
 for smooth motion, UI transitions, and procedural animation.
 All values scaled by 1000. Time parameter t ranges 0-1000.

 We say:

Section: Constants
  tw-scale : Integer = 1000

Section: Linear
  tw-linear : Integer, Integer, Integer -> Integer
  tw-linear (from) (to) (t) = from + (to - from) * t / tw-scale

Section: Quadratic
  tw-ease-in-quad : Integer, Integer, Integer -> Integer
  tw-ease-in-quad (from) (to) (t) =
    let t2 = t * t / tw-scale
    in from + (to - from) * t2 / tw-scale

  tw-ease-out-quad : Integer, Integer, Integer -> Integer
  tw-ease-out-quad (from) (to) (t) =
    let inv = tw-scale - t
    in let factor = tw-scale - inv * inv / tw-scale
    in from + (to - from) * factor / tw-scale

  tw-ease-in-out-quad : Integer, Integer, Integer -> Integer
  tw-ease-in-out-quad (from) (to) (t) =
    if t < 500 then
      let t2 = t * 2
      in let factor = t2 * t2 / tw-scale / 2
      in from + (to - from) * factor / tw-scale
    else let t2 = t * 2 - tw-scale
    in let inv = tw-scale - t2
    in let factor = tw-scale - inv * inv / tw-scale / 2
    in from + (to - from) * factor / tw-scale

Section: Cubic
  tw-ease-in-cubic : Integer, Integer, Integer -> Integer
  tw-ease-in-cubic (from) (to) (t) =
    let t3 = t * t / tw-scale * t / tw-scale
    in from + (to - from) * t3 / tw-scale

  tw-ease-out-cubic : Integer, Integer, Integer -> Integer
  tw-ease-out-cubic (from) (to) (t) =
    let inv = tw-scale - t
    in let inv3 = inv * inv / tw-scale * inv / tw-scale
    in let factor = tw-scale - inv3
    in from + (to - from) * factor / tw-scale

Section: Elastic
  tw-ease-out-elastic : Integer, Integer, Integer -> Integer
  tw-ease-out-elastic (from) (to) (t) =
    if t == 0 then from
    else if t >= tw-scale then to
    else let decay = tw-scale - t * t / tw-scale
    in let osc = tw-oscillate t 3
    in let factor = tw-scale - decay * osc / tw-scale
    in from + (to - from) * factor / tw-scale

  tw-oscillate : Integer, Integer -> Integer
  tw-oscillate (t) (cycles) =
    let phase = t * cycles * 2
    in let quarter = phase / tw-scale
    in let r = quarter - (quarter / 4) * 4
    in if r == 0 then tw-scale
    else if r == 1 then 0
    else if r == 2 then -tw-scale
    else 0

Section: Bounce
  tw-ease-out-bounce : Integer, Integer, Integer -> Integer
  tw-ease-out-bounce (from) (to) (t) =
    let factor = tw-bounce-factor t
    in from + (to - from) * factor / tw-scale

  tw-bounce-factor : Integer -> Integer
  tw-bounce-factor (t) =
    if t < 363 then 7563 * t / tw-scale * t / tw-scale
    else if t < 727 then let t2 = t - 545
      in 7563 * t2 / tw-scale * t2 / tw-scale + 750
    else if t < 909 then let t2 = t - 818
      in 7563 * t2 / tw-scale * t2 / tw-scale + 937
    else let t2 = t - 954
    in 7563 * t2 / tw-scale * t2 / tw-scale + 984

Section: Helpers
  tw-clamp : Integer, Integer, Integer -> Integer
  tw-clamp (val) (lo) (hi) = if val < lo then lo else if val > hi then hi else val

  tw-ping-pong : Integer -> Integer
  tw-ping-pong (t) =
    let cycle = t - (t / (2 * tw-scale)) * (2 * tw-scale)
    in if cycle <= tw-scale then cycle else 2 * tw-scale - cycle

