Chapter: DiamondSquare

 Diamond Star terrain generation. Variant of diamond-square
 that rotates the grid 90 degrees between subdivision passes,
 distributing edge bias evenly across all four sides instead of
 accumulating on the same edges. Produces a (2^n + 1) square
 heightmap from corner seeds and a roughness parameter.
 All values are integers (fixed-point heights 0-255).

 We say:

Section: Heightmap
  Heightmap = record {
    cells : List Integer,
    size : Integer
  }

  hm-get : Heightmap, Integer, Integer -> Integer
  hm-get (hm) (x) (y) = list-at (hm.cells) (y * hm.size + x)

  hm-set : Heightmap, Integer, Integer, Integer -> Heightmap
  hm-set (hm) (x) (y) (val) =
    Heightmap { cells = list-set-at (hm.cells) (y * hm.size + x) (ds-clamp val), size = hm.size }

  ds-clamp : Integer -> Integer
  ds-clamp (v) = if v < 0 then 0 else if v > 255 then 255 else v

Section: Generation
  ds-generate : Integer, Integer, Integer, Integer, Integer, Integer -> Heightmap
  ds-generate (size) (tl) (tr) (bl) (br) (roughness) =
    let cells = ds-init-cells (size * size) 0 []
    in let hm0 = Heightmap { cells = cells, size = size }
    in let hm1 = hm-set hm0 0 0 tl
    in let hm2 = hm-set hm1 (size - 1) 0 tr
    in let hm3 = hm-set hm2 0 (size - 1) bl
    in let hm4 = hm-set hm3 (size - 1) (size - 1) br
    in ds-subdivide hm4 (size - 1) roughness 42

  ds-init-cells : Integer, Integer, List Integer -> List Integer
  ds-init-cells (n) (i) (acc) =
    if i >= n then acc
    else ds-init-cells n (i + 1) (list-push acc 0)

  ds-subdivide : Heightmap, Integer, Integer, Integer -> Heightmap
  ds-subdivide (hm) (step) (roughness) (seed) =
    if step < 2 then hm
    else let half = step / 2
    in let hm2 = ds-diamond-pass hm 0 0 (hm.size) step half roughness seed
    in let hm3 = ds-square-pass hm2 0 0 (hm.size) step half roughness (seed + 1000)
    in let hm4 = hm-rotate-90 hm3
    in ds-subdivide hm4 half (roughness * 3 / 4) (seed + 7919)

Section: Diamond Step
  ds-diamond-pass : Heightmap, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Heightmap
  ds-diamond-pass (hm) (x) (y) (size) (step) (half) (roughness) (seed) =
    if y >= size - 1 then hm
    else if x >= size - 1 then ds-diamond-pass hm 0 (y + step) size step half roughness (seed + 13)
    else let avg = (hm-get hm x y + hm-get hm (x + step) y + hm-get hm x (y + step) + hm-get hm (x + step) (y + step)) / 4
    in let noise = ds-noise seed x y roughness
    in let hm2 = hm-set hm (x + half) (y + half) (avg + noise)
    in ds-diamond-pass hm2 (x + step) y size step half roughness (seed + 7)

Section: Square Step
  ds-square-pass : Heightmap, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Heightmap
  ds-square-pass (hm) (x) (y) (size) (step) (half) (roughness) (seed) =
    if y >= size then hm
    else if x >= size then ds-square-pass hm 0 (y + half) size step half roughness (seed + 17)
    else let hm2 = ds-square-point hm x y size step half roughness seed
    in ds-square-pass hm2 (x + half) y size step half roughness (seed + 11)

  ds-square-point : Heightmap, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Heightmap
  ds-square-point (hm) (x) (y) (size) (step) (half) (roughness) (seed) =
    let sum = 0
    in let cnt = 0
    in let s1 = if y - half >= 0 then hm-get hm x (y - half) else 0
    in let c1 = if y - half >= 0 then 1 else 0
    in let s2 = if y + half < size then hm-get hm x (y + half) else 0
    in let c2 = if y + half < size then 1 else 0
    in let s3 = if x - half >= 0 then hm-get hm (x - half) y else 0
    in let c3 = if x - half >= 0 then 1 else 0
    in let s4 = if x + half < size then hm-get hm (x + half) y else 0
    in let c4 = if x + half < size then 1 else 0
    in let total = s1 + s2 + s3 + s4
    in let count = c1 + c2 + c3 + c4
    in if count == 0 then hm
    else let avg = total / count
    in let noise = ds-noise seed x y roughness
    in hm-set hm x y (avg + noise)

Section: Rotation
  hm-rotate-90 : Heightmap -> Heightmap
  hm-rotate-90 (hm) =
    let n = hm.size
    in Heightmap { cells = hm-rotate-cells hm n 0 0 [], size = n }

  hm-rotate-cells : Heightmap, Integer, Integer, Integer, List Integer -> List Integer
  hm-rotate-cells (hm) (n) (x) (y) (acc) =
    if y >= n then acc
    else if x >= n then hm-rotate-cells hm n 0 (y + 1) acc
    else let src-x = y
    in let src-y = n - 1 - x
    in hm-rotate-cells hm n (x + 1) y (list-push acc (hm-get hm src-x src-y))

Section: Noise
  ds-noise : Integer, Integer, Integer, Integer -> Integer
  ds-noise (seed) (x) (y) (roughness) =
    let h = bit-xor (seed * 2654435761) (x * 40503 + y * 73244475)
    in let h2 = bit-xor h (bit-shru h 13)
    in let h3 = h2 * 1103515245 + 12345
    in let positive = if h3 < 0 then -h3 else h3
    in let range = roughness * 2 + 1
    in if range == 0 then 0
    else (positive - (positive / range) * range) - roughness

Section: Queries
  hm-min : Heightmap -> Integer
  hm-min (hm) = hm-fold-min (hm.cells) 0 (hm.size * hm.size) 255

  hm-fold-min : List Integer, Integer, Integer, Integer -> Integer
  hm-fold-min (cells) (i) (len) (best) =
    if i >= len then best
    else let v = list-at cells i
    in hm-fold-min cells (i + 1) len (if v < best then v else best)

  hm-max : Heightmap -> Integer
  hm-max (hm) = hm-fold-max (hm.cells) 0 (hm.size * hm.size) 0

  hm-fold-max : List Integer, Integer, Integer, Integer -> Integer
  hm-fold-max (cells) (i) (len) (best) =
    if i >= len then best
    else let v = list-at cells i
    in hm-fold-max cells (i + 1) len (if v > best then v else best)

Section: Formatting
  hm-row-text : Heightmap, Integer -> Text
  hm-row-text (hm) (y) = hm-row-loop hm 0 (hm.size) y ""

  hm-row-loop : Heightmap, Integer, Integer, Integer, Text -> Text
  hm-row-loop (hm) (x) (size) (y) (acc) =
    if x >= size then acc
    else let sep = if x == 0 then "" else " "
    in hm-row-loop hm (x + 1) size y (acc & sep & show (hm-get hm x y))

