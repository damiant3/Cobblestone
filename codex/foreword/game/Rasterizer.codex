Chapter: Rasterizer
  cites Foreword chapter MathLib
  cites Math chapter Geometry
  cites Math chapter Quaternion
  cites Game chapter Bresenham

 Software 2D rasterizer. Scanline fill for triangles and convex
 polygons. Framebuffer is a flat array of integer color values
 indexed row-major (y * width + x). All coordinates are integer
 pixels, not fixed-point.

 We say:

Section: Framebuffer
  Framebuf = record {
    fb-width : Integer,
    fb-height : Integer,
    fb-pixels : List Integer
  }

  fb-new : Integer, Integer, Integer -> Framebuf
  fb-new (w) (h) (bg) = Framebuf { fb-width = w, fb-height = h, fb-pixels = fb-fill (w * h) bg }

  fb-fill : Integer, Integer -> List Integer
  fb-fill (n) (val) = fb-fill-loop n val []

  fb-fill-loop : Integer, Integer, List Integer -> List Integer
  fb-fill-loop (n) (val) (acc) =
    if n <= 0 then acc
    else fb-fill-loop (n - 1) val (list-push acc val)

  fb-set : Framebuf, Integer, Integer, Integer -> Framebuf
  fb-set (fb) (x) (y) (color) =
    if x < 0 then fb
    else if y < 0 then fb
    else if x >= fb.fb-width then fb
    else if y >= fb.fb-height then fb
    else Framebuf { fb-width = fb.fb-width, fb-height = fb.fb-height, fb-pixels = list-set-at (fb.fb-pixels) (y * fb.fb-width + x) color }

  fb-get : Framebuf, Integer, Integer -> Integer
  fb-get (fb) (x) (y) =
    if x < 0 then 0
    else if y < 0 then 0
    else if x >= fb.fb-width then 0
    else if y >= fb.fb-height then 0
    else list-at (fb.fb-pixels) (y * fb.fb-width + x)

Section: Horizontal Span
  fb-hline : Framebuf, Integer, Integer, Integer, Integer -> Framebuf
  fb-hline (fb) (x0) (x1) (y) (color) =
    if y < 0 then fb
    else if y >= fb.fb-height then fb
    else let lo = rast-max x0 0
    in let hi = rast-min x1 (fb.fb-width - 1)
    in fb-hline-loop fb lo hi y color

  fb-hline-loop : Framebuf, Integer, Integer, Integer, Integer -> Framebuf
  fb-hline-loop (fb) (x) (x1) (y) (color) =
    if x > x1 then fb
    else fb-hline-loop (fb-set fb x y color) (x + 1) x1 y color

Section: Line Drawing
  fb-line : Framebuf, Integer, Integer, Integer, Integer, Integer -> Framebuf
  fb-line (fb) (x0) (y0) (x1) (y1) (color) =
    let pts = bres-line x0 y0 x1 y1
    in fb-plot-points fb pts color 0 (list-length pts)

  fb-plot-points : Framebuf, List BresPoint, Integer, Integer, Integer -> Framebuf
  fb-plot-points (fb) (pts) (color) (i) (n) =
    if i >= n then fb
    else let p = list-at pts i
    in fb-plot-points (fb-set fb (p.bx) (p.by) color) pts color (i + 1) n

Section: Circle Drawing
  fb-circle : Framebuf, Integer, Integer, Integer, Integer -> Framebuf
  fb-circle (fb) (cx) (cy) (r) (color) =
    let pts = bres-circle cx cy r
    in fb-plot-points fb pts color 0 (list-length pts)

  fb-circle-filled : Framebuf, Integer, Integer, Integer, Integer -> Framebuf
  fb-circle-filled (fb) (cx) (cy) (r) (color) =
    fb-fill-circle-loop fb cx cy r (-r) color

  fb-fill-circle-loop : Framebuf, Integer, Integer, Integer, Integer, Integer -> Framebuf
  fb-fill-circle-loop (fb) (cx) (cy) (r) (dy) (color) =
    if dy > r then fb
    else let dx = math-isqrt (r * r - dy * dy)
    in let fb2 = fb-hline fb (cx - dx) (cx + dx) (cy + dy) color
    in fb-fill-circle-loop fb2 cx cy r (dy + 1) color

Section: Triangle Fill (Scanline)
  fb-tri : Framebuf, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Framebuf
  fb-tri (fb) (x0) (y0) (x1) (y1) (x2) (y2) (color) =
    let sorted = rast-sort-tri x0 y0 x1 y1 x2 y2
    in let ay = rast-tri-ay sorted
    in let by = rast-tri-by sorted
    in let cy = rast-tri-cy sorted
    in let ax = rast-tri-ax sorted
    in let bx = rast-tri-bx sorted
    in let cx = rast-tri-cx sorted
    in fb-tri-scan fb ax ay bx by cx cy color

  fb-tri-scan : Framebuf, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Framebuf
  fb-tri-scan (fb) (ax) (ay) (bx) (by) (cx) (cy) (color) =
    let fb2 = fb-tri-half fb ax ay bx by cx cy ay by color
    in fb-tri-half fb2 ax ay bx by cx cy by cy color

  fb-tri-half : Framebuf, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> Framebuf
  fb-tri-half (fb) (ax) (ay) (bx) (by) (cx) (cy) (y-start) (y-end) (color) =
    if y-start > y-end then fb
    else if y-start >= fb.fb-height then fb
    else let y = y-start
    in let x-ac = rast-edge-x ax ay cx cy y
    in let x-side = if y < by then rast-edge-x ax ay bx by y else rast-edge-x bx by cx cy y
    in let lo = rast-min x-ac x-side
    in let hi = rast-max x-ac x-side
    in let fb2 = if y >= 0 then fb-hline fb lo hi y color else fb
    in fb-tri-half fb2 ax ay bx by cx cy (y-start + 1) y-end color

  rast-edge-x : Integer, Integer, Integer, Integer, Integer -> Integer
  rast-edge-x (x0) (y0) (x1) (y1) (y) =
    let dy = y1 - y0
    in if dy == 0 then x0
    else x0 + (x1 - x0) * (y - y0) / dy

Section: Triangle Sorting (by Y ascending)
  TriSorted = record { ts-ax : Integer, ts-ay : Integer, ts-bx : Integer, ts-by : Integer, ts-cx : Integer, ts-cy : Integer }

  rast-sort-tri : Integer, Integer, Integer, Integer, Integer, Integer -> TriSorted
  rast-sort-tri (x0) (y0) (x1) (y1) (x2) (y2) =
    if y0 <= y1 then
      if y1 <= y2 then TriSorted { ts-ax = x0, ts-ay = y0, ts-bx = x1, ts-by = y1, ts-cx = x2, ts-cy = y2 }
      else if y0 <= y2 then TriSorted { ts-ax = x0, ts-ay = y0, ts-bx = x2, ts-by = y2, ts-cx = x1, ts-cy = y1 }
      else TriSorted { ts-ax = x2, ts-ay = y2, ts-bx = x0, ts-by = y0, ts-cx = x1, ts-cy = y1 }
    else if y0 <= y2 then TriSorted { ts-ax = x1, ts-ay = y1, ts-bx = x0, ts-by = y0, ts-cx = x2, ts-cy = y2 }
    else if y1 <= y2 then TriSorted { ts-ax = x1, ts-ay = y1, ts-bx = x2, ts-by = y2, ts-cx = x0, ts-cy = y0 }
    else TriSorted { ts-ax = x2, ts-ay = y2, ts-bx = x1, ts-by = y1, ts-cx = x0, ts-cy = y0 }

  rast-tri-ax : TriSorted -> Integer
  rast-tri-ax (t) = t.ts-ax
  rast-tri-ay : TriSorted -> Integer
  rast-tri-ay (t) = t.ts-ay
  rast-tri-bx : TriSorted -> Integer
  rast-tri-bx (t) = t.ts-bx
  rast-tri-by : TriSorted -> Integer
  rast-tri-by (t) = t.ts-by
  rast-tri-cx : TriSorted -> Integer
  rast-tri-cx (t) = t.ts-cx
  rast-tri-cy : TriSorted -> Integer
  rast-tri-cy (t) = t.ts-cy

Section: Rectangle
  fb-rect : Framebuf, Integer, Integer, Integer, Integer, Integer -> Framebuf
  fb-rect (fb) (x) (y) (w) (h) (color) = fb-rect-loop fb x y w (y + h - 1) color

  fb-rect-loop : Framebuf, Integer, Integer, Integer, Integer, Integer -> Framebuf
  fb-rect-loop (fb) (x) (y) (w) (y-end) (color) =
    if y > y-end then fb
    else fb-rect-loop (fb-hline fb x (x + w - 1) y color) x (y + 1) w y-end color

Section: Polygon Outline
  fb-polygon : Framebuf, List Vec2, Integer -> Framebuf
  fb-polygon (fb) (pts) (color) = fb-poly-loop fb pts color 0 (list-length pts)

  fb-poly-loop : Framebuf, List Vec2, Integer, Integer, Integer -> Framebuf
  fb-poly-loop (fb) (pts) (color) (i) (n) =
    if i >= n then fb
    else let j = if i + 1 >= n then 0 else i + 1
    in let pi = list-at pts i
    in let pj = list-at pts j
    in fb-poly-loop (fb-line fb (real-to-int (pi.v2x)) (real-to-int (pi.v2y)) (real-to-int (pj.v2x)) (real-to-int (pj.v2y)) color) pts color (i + 1) n

Section: Pixel Counting
  fb-count-color : Framebuf, Integer -> Integer
  fb-count-color (fb) (color) = fb-count-loop (fb.fb-pixels) color 0 (list-length (fb.fb-pixels)) 0

  fb-count-loop : List Integer, Integer, Integer, Integer, Integer -> Integer
  fb-count-loop (px) (color) (i) (n) (acc) =
    if i >= n then acc
    else let inc = if list-at px i == color then 1 else 0
    in fb-count-loop px color (i + 1) n (acc + inc)

Section: Helpers
  rast-min : Integer, Integer -> Integer
  rast-min (a) (b) = if a < b then a else b

  rast-max : Integer, Integer -> Integer
  rast-max (a) (b) = if a > b then a else b

  rast-abs : Integer -> Integer
  rast-abs (n) = if n < 0 then -n else n

