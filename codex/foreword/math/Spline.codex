Section: Evaluation
  catmull-rom : Vec3, Vec3, Vec3, Vec3, Real -> Vec3
  catmull-rom (p0) (p1) (p2) (p3) (t) =
    let t2 = t * t
    in let t3 = t2 * t
    in let c0 = -t3 / 2.0 + t2 - t / 2.0
    in let c1 = 3.0 * t3 / 2.0 - 5.0 * t2 / 2.0 + 1.0
    in let c2 = 0.0 - 3.0 * t3 / 2.0 + 2.0 * t2 + t / 2.0
    in let c3 = t3 / 2.0 - t2 / 2.0
    in vec3-new (c0 * p0.vx + c1 * p1.vx + c2 * p2.vx + c3 * p3.vx) (c0 * p0.vy + c1 * p1.vy + c2 * p2.vy + c3 * p3.vy) (c0 * p0.vz + c1 * p1.vz + c2 * p2.vz + c3 * p3.vz)

Section: Multi-Point Spline
  spline-eval : List Vec3, Real -> Vec3
  spline-eval (points) (t-global) =
    let num-segments = list-length points - 3
    in if num-segments <= 0 then vec3-zero
    else let ns = real-from-int num-segments
    in let segment = real-to-int (t-global * ns)
    in let seg-idx = if segment >= num-segments then num-segments - 1 else segment
    in let local-t = t-global * ns - real-from-int seg-idx
    in catmull-rom (list-at points seg-idx) (list-at points (seg-idx + 1)) (list-at points (seg-idx + 2)) (list-at points (seg-idx + 3)) local-t

