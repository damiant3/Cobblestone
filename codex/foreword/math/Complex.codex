Chapter: Complex

 Complex number arithmetic. Fixed-point (scale 1000). Supports add,
 multiply, conjugate, magnitude, phase, and polar conversion.
 Foundation for FFT, signal processing, and fractal generation.

 We say:

Section: Type
  Complex = record {
    re : Integer,
    im : Integer
  }

Section: Construction
  cx-new : Integer, Integer -> Complex
  cx-new (r) (i) = Complex { re = r, im = i }

  cx-real : Integer -> Complex
  cx-real (r) = Complex { re = r, im = 0 }

  cx-imag : Integer -> Complex
  cx-imag (i) = Complex { re = 0, im = i }

  cx-zero : Complex = Complex { re = 0, im = 0 }
  cx-one : Complex = Complex { re = 1000, im = 0 }
  cx-i : Complex = Complex { re = 0, im = 1000 }

Section: Arithmetic
  cx-add : Complex, Complex -> Complex
  cx-add (a) (b) = Complex { re = a.re + b.re, im = a.im + b.im }

  cx-sub : Complex, Complex -> Complex
  cx-sub (a) (b) = Complex { re = a.re - b.re, im = a.im - b.im }

  cx-mul : Complex, Complex -> Complex
  cx-mul (a) (b) = Complex { re = a.re * b.re / 1000 - a.im * b.im / 1000, im = a.re * b.im / 1000 + a.im * b.re / 1000 }

  cx-scale : Complex, Integer -> Complex
  cx-scale (z) (s) = Complex { re = z.re * s / 1000, im = z.im * s / 1000 }

  cx-conjugate : Complex -> Complex
  cx-conjugate (z) = Complex { re = z.re, im = -z.im }

  cx-negate : Complex -> Complex
  cx-negate (z) = Complex { re = -z.re, im = -z.im }

Section: Magnitude and Phase
  cx-mag-sq : Complex -> Integer
  cx-mag-sq (z) = z.re * z.re / 1000 + z.im * z.im / 1000

  cx-magnitude : Complex -> Integer
  cx-magnitude (z) = cx-isqrt (z.re * z.re + z.im * z.im)

  cx-isqrt : Integer -> Integer
  cx-isqrt (n) = if n <= 0 then 0 else cx-isqrt-loop n (n / 2 + 1)

  cx-isqrt-loop : Integer, Integer -> Integer
  cx-isqrt-loop (n) (g) = let next = (g + n / g) / 2 in if next >= g then g else cx-isqrt-loop n next

Section: Division
  cx-div : Complex, Complex -> Complex
  cx-div (a) (b) =
    let denom = b.re * b.re + b.im * b.im
    in if denom == 0 then cx-zero
    else Complex { re = (a.re * b.re + a.im * b.im) * 1000 / denom, im = (a.im * b.re - a.re * b.im) * 1000 / denom }

Section: Power
  cx-pow-int : Complex, Integer -> Complex
  cx-pow-int (z) (n) =
    if n <= 0 then cx-one
    else if n == 1 then z
    else cx-mul z (cx-pow-int z (n - 1))

Section: Mandelbrot Iteration
  cx-mandelbrot-escape : Complex, Integer -> Integer
  cx-mandelbrot-escape (c) (max-iter) = cx-mandel-loop c cx-zero 0 max-iter

  cx-mandel-loop : Complex, Complex, Integer, Integer -> Integer
  cx-mandel-loop (c) (z) (i) (max) =
    if i >= max then max
    else if cx-mag-sq z > 4000 then i
    else cx-mandel-loop c (cx-add (cx-mul z z) c) (i + 1) max

Section: Formatting
  format-complex : Complex -> Text
  format-complex (z) =
    if z.im >= 0 then show (z.re) & "+" & show (z.im) & "i"
    else show (z.re) & show (z.im) & "i"

