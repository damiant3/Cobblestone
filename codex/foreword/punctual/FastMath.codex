Chapter: FastMath
  cites Punctual chapter IntOps
  cites Punctual chapter BitOps

 Fast integer math primitives safe for real-time contexts. Every
 function is punctual: no heap, no recursion, bounded instruction
 count.

 We say:

Section: Interpolation

  punctual lerp : Integer, Integer, Integer, Integer -> Integer
  lerp (a) (b) (num) (den) =
    a + (b - a) * num / den

  punctual inverse-lerp : Integer, Integer, Integer, Integer -> Integer
  inverse-lerp (a) (b) (v) (scale) =
    if b == a then 0
    else (v - a) * scale / (b - a)

  punctual remap : Integer, Integer, Integer, Integer, Integer -> Integer
  remap (in-lo) (in-hi) (out-lo) (out-hi) (v) =
    let t = (v - in-lo) * 1000 / (in-hi - in-lo)
    in out-lo + (out-hi - out-lo) * t / 1000

  punctual smoothstep : Integer, Integer, Integer, Integer -> Integer
  smoothstep (edge0) (edge1) (x) (scale) =
    if x <= edge0 then 0
    else if x >= edge1 then scale
    else let t = (x - edge0) * scale / (edge1 - edge0)
    in t * t * (3 * scale - 2 * t) / (scale * scale)

  punctual step : Integer, Integer -> Integer
  step (edge) (x) = if x < edge then 0 else 1

Section: Integer Roots and Powers

  punctual int-sqrt : Integer -> Integer
  int-sqrt (n) =
    if n <= 0 then 0
    else if n == 1 then 1
    else let g0 = bit-shru n 1
    in let g1 = bit-shru (g0 + n / g0) 1
    in let g2 = bit-shru (g1 + n / g1) 1
    in let g3 = bit-shru (g2 + n / g2) 1
    in let g4 = bit-shru (g3 + n / g3) 1
    in let g5 = bit-shru (g4 + n / g4) 1
    in let g6 = bit-shru (g5 + n / g5) 1
    in let g7 = bit-shru (g6 + n / g6) 1
    in int-min g7 (n / g7)

  punctual int-pow : Integer, Integer -> Integer
  int-pow (base) (exp) =
    if exp <= 0 then 1
    else if exp == 1 then base
    else if exp == 2 then base * base
    else if exp == 3 then base * base * base
    else if exp == 4 then let b2 = base * base in b2 * b2
    else if exp == 5 then let b2 = base * base in b2 * b2 * base
    else if exp == 6 then let b2 = base * base in b2 * b2 * b2
    else if exp == 7 then let b2 = base * base in b2 * b2 * b2 * base
    else if exp == 8 then let b2 = base * base in let b4 = b2 * b2 in b4 * b4
    else if exp == 9 then let b2 = base * base in let b4 = b2 * b2 in b4 * b4 * base
    else if exp == 10 then let b2 = base * base in let b4 = b2 * b2 in b4 * b4 * b2
    else let b2 = base * base in let b4 = b2 * b2 in let b8 = b4 * b4 in if exp == 11 then b8 * b2 * base else if exp == 12 then b8 * b4 else if exp == 13 then b8 * b4 * base else if exp == 14 then b8 * b4 * b2 else if exp == 15 then b8 * b4 * b2 * base else if exp == 16 then b8 * b8 else if exp == 17 then b8 * b8 * base else if exp == 18 then b8 * b8 * b2 else if exp == 19 then b8 * b8 * b2 * base else if exp == 20 then b8 * b8 * b4 else 0

Section: Logarithm

  punctual int-log2 : Integer -> Integer
  int-log2 (x) =
    if x <= 0 then 0 - 1
    else 63 - bit-clz x

