Chapter: ColorOps

 Packed RGBA color manipulation safe for real-time contexts. Every
 function is punctual: no heap, no recursion, bounded instruction
 count.

 Colors are packed as 32-bit integers in ARGB order:
 bits [31:24] = alpha, [23:16] = red, [15:8] = green, [7:0] = blue.
 Channel values are 0-255.

 We say:

Section: Pack and Unpack

  punctual rgba-pack : Integer, Integer, Integer, Integer -> Integer
  rgba-pack (r) (g) (b) (a) =
    bit-or (bit-or (bit-shl a 24) (bit-shl r 16)) (bit-or (bit-shl g 8) b)

  punctual rgba-r : Integer -> Integer
  rgba-r (c) = bit-and (bit-shru c 16) 255

  punctual rgba-g : Integer -> Integer
  rgba-g (c) = bit-and (bit-shru c 8) 255

  punctual rgba-b : Integer -> Integer
  rgba-b (c) = bit-and c 255

  punctual rgba-a : Integer -> Integer
  rgba-a (c) = bit-and (bit-shru c 24) 255

Section: Blending

  punctual rgba-blend : Integer, Integer -> Integer
  rgba-blend (fg) (bg) =
    let a = bit-and (bit-shru fg 24) 255
    in let inv-a = 255 - a
    in let fr = bit-and (bit-shru fg 16) 255
    in let fg2 = bit-and (bit-shru fg 8) 255
    in let fb = bit-and fg 255
    in let br = bit-and (bit-shru bg 16) 255
    in let bg2 = bit-and (bit-shru bg 8) 255
    in let bb = bit-and bg 255
    in let or = (fr * a + br * inv-a) / 255
    in let og = (fg2 * a + bg2 * inv-a) / 255
    in let ob = (fb * a + bb * inv-a) / 255
    in bit-or (bit-or (bit-shl 255 24) (bit-shl or 16)) (bit-or (bit-shl og 8) ob)

Section: Brightness

  punctual rgb-luminance-packed : Integer -> Integer
  rgb-luminance-packed (c) =
    let r = bit-and (bit-shru c 16) 255
    in let g = bit-and (bit-shru c 8) 255
    in let b = bit-and c 255
    in (r * 77 + g * 150 + b * 29) / 256

Section: Interpolation

  punctual rgb-lerp-packed : Integer, Integer, Integer -> Integer
  rgb-lerp-packed (c1) (c2) (t) =
    let inv = 255 - t
    in let r = (bit-and (bit-shru c1 16) 255) * inv + (bit-and (bit-shru c2 16) 255) * t
    in let g = (bit-and (bit-shru c1 8) 255) * inv + (bit-and (bit-shru c2 8) 255) * t
    in let b = (bit-and c1 255) * inv + (bit-and c2 255) * t
    in let a = (bit-and (bit-shru c1 24) 255) * inv + (bit-and (bit-shru c2 24) 255) * t
    in bit-or (bit-or (bit-shl (a / 255) 24) (bit-shl (r / 255) 16)) (bit-or (bit-shl (g / 255) 8) (b / 255))

