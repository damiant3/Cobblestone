Chapter: Endian

 Endian conversion primitives safe for real-time contexts. Every
 function is punctual: no heap, no recursion, bounded instruction
 count. The host is assumed little-endian (x86-64, ARM64-LE,
 RISC-V LE).

 We say:

Section: 16-bit

  punctual to-big-endian-16 : Integer -> Integer
  to-big-endian-16 (x) =
    bit-or (bit-shl (bit-and x 255) 8) (bit-and (bit-shru x 8) 255)

  punctual from-big-endian-16 : Integer -> Integer
  from-big-endian-16 (x) =
    bit-or (bit-shl (bit-and x 255) 8) (bit-and (bit-shru x 8) 255)

Section: 32-bit

  punctual to-big-endian-32 : Integer -> Integer
  to-big-endian-32 (x) =
    let b0 = bit-and x 255
    in let b1 = bit-and (bit-shru x 8) 255
    in let b2 = bit-and (bit-shru x 16) 255
    in let b3 = bit-and (bit-shru x 24) 255
    in bit-or (bit-or (bit-shl b0 24) (bit-shl b1 16)) (bit-or (bit-shl b2 8) b3)

  punctual from-big-endian-32 : Integer -> Integer
  from-big-endian-32 (x) = to-big-endian-32 x

Section: 64-bit

  punctual to-big-endian-64 : Integer -> Integer
  to-big-endian-64 (x) =
    let b0 = bit-and x 255
    in let b1 = bit-and (bit-shru x 8) 255
    in let b2 = bit-and (bit-shru x 16) 255
    in let b3 = bit-and (bit-shru x 24) 255
    in let b4 = bit-and (bit-shru x 32) 255
    in let b5 = bit-and (bit-shru x 40) 255
    in let b6 = bit-and (bit-shru x 48) 255
    in let b7 = bit-and (bit-shru x 56) 255
    in bit-or (bit-or (bit-or (bit-shl b0 56) (bit-shl b1 48)) (bit-or (bit-shl b2 40) (bit-shl b3 32))) (bit-or (bit-or (bit-shl b4 24) (bit-shl b5 16)) (bit-or (bit-shl b6 8) b7))

  punctual from-big-endian-64 : Integer -> Integer
  from-big-endian-64 (x) = to-big-endian-64 x

Section: Pack and Unpack

  punctual pack-u16-be : Integer, Integer -> Integer
  pack-u16-be (hi) (lo) = bit-or (bit-shl (bit-and hi 255) 8) (bit-and lo 255)

  punctual pack-u32-be : Integer, Integer, Integer, Integer -> Integer
  pack-u32-be (b3) (b2) (b1) (b0) =
    bit-or (bit-or (bit-shl (bit-and b3 255) 24) (bit-shl (bit-and b2 255) 16)) (bit-or (bit-shl (bit-and b1 255) 8) (bit-and b0 255))

  punctual unpack-u16-be-hi : Integer -> Integer
  unpack-u16-be-hi (x) = bit-and (bit-shru x 8) 255

  punctual unpack-u16-be-lo : Integer -> Integer
  unpack-u16-be-lo (x) = bit-and x 255

