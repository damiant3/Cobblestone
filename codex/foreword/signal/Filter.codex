Chapter: Filter
  cites Math chapter Cordic
  cites Foreword chapter Units (Frequency)

 Digital filters -- FIR (finite impulse response) and IIR (infinite
 impulse response) implementations for audio and signal processing.
 Low-pass, high-pass, band-pass, and band-stop filter design with
 configurable cutoff and sample rate. Uses fixed-point scale-1000
 arithmetic.

 We say:

Section: FIR Filter

  FirFilter = record {
    coeffs : List Integer,
    order : Integer
  }

  fir-new : List Integer -> FirFilter
  fir-new (coeffs) = FirFilter { coeffs = coeffs, order = list-length coeffs }

  fir-apply : FirFilter, List Integer -> List Integer
  fir-apply (f) (input) =
    fir-apply-loop f input 0 (list-length input) []

  fir-apply-loop : FirFilter, List Integer, Integer, Integer, List Integer -> List Integer
  fir-apply-loop (f) (input) (i) (len) (acc) =
    if i >= len then acc
    else let sample = fir-convolve (f.coeffs) input i (f.order) 0
    in fir-apply-loop f input (i + 1) len (list-push acc (sample / 1000))

  fir-convolve : List Integer, List Integer, Integer, Integer, Integer -> Integer
  fir-convolve (coeffs) (input) (pos) (order) (k) =
    if k >= order then 0
    else let idx = pos - k
    in let sample = if idx < 0 then 0 else list-at input idx
    in (list-at coeffs k) * sample / 1000 + fir-convolve coeffs input pos order (k + 1)

Section: IIR Filter (Biquad)

  BiquadFilter = record {
    b0 : Integer,
    b1 : Integer,
    b2 : Integer,
    a1 : Integer,
    a2 : Integer
  }

  BiquadState = record {
    x1 : Integer,
    x2 : Integer,
    y1 : Integer,
    y2 : Integer
  }

  biquad-init : BiquadState
  biquad-init = BiquadState { x1 = 0, x2 = 0, y1 = 0, y2 = 0 }

  iir-apply : BiquadFilter, List Integer -> List Integer
  iir-apply (f) (input) =
    let r = iir-apply-loop f input biquad-init 0 (list-length input) []
    in r.output

  IirResult = record {
    output : List Integer,
    state : BiquadState
  }

  iir-apply-loop : BiquadFilter, List Integer, BiquadState, Integer, Integer, List Integer -> IirResult
  iir-apply-loop (f) (input) (st) (i) (len) (acc) =
    if i >= len then IirResult { output = acc, state = st }
    else let x0 = list-at input i
    in let y0 = (f.b0 * x0 + f.b1 * st.x1 + f.b2 * st.x2 - f.a1 * st.y1 - f.a2 * st.y2) / 1000
    in let st2 = BiquadState { x1 = x0, x2 = st.x1, y1 = y0, y2 = st.y1 }
    in iir-apply-loop f input st2 (i + 1) len (list-push acc y0)

Section: Filter Design

  lpf-design : Frequency, Frequency, Integer -> FirFilter
  lpf-design (cutoff) (sample-rate) (order) =
    let coeffs = lpf-coeffs cutoff sample-rate order 0 []
    in fir-new coeffs

  lpf-coeffs : Integer, Integer, Integer, Integer, List Integer -> List Integer
  lpf-coeffs (cutoff) (sr) (order) (i) (acc) =
    if i >= order then acc
    else let mid = order / 2
    in let n = i - mid
    in let coeff = if n == 0 then 2 * cutoff * 1000 / sr
      else filter-sinc (2 * cutoff * n * 1000 / sr) * hamming-window i order / 1000
    in lpf-coeffs cutoff sr order (i + 1) (list-push acc coeff)

  hpf-design : Frequency, Frequency, Integer -> FirFilter
  hpf-design (cutoff) (sample-rate) (order) =
    let lp = lpf-design cutoff sample-rate order
    in fir-new (spectral-invert (lp.coeffs) 0 (lp.order) [])

  spectral-invert : List Integer, Integer, Integer, List Integer -> List Integer
  spectral-invert (coeffs) (i) (len) (acc) =
    if i >= len then acc
    else let mid = len / 2
    in let v = 0 - (list-at coeffs i)
    in let adjusted = if i == mid then v + 1000 else v
    in spectral-invert coeffs (i + 1) len (list-push acc adjusted)

  biquad-lpf : Frequency, Frequency, Integer -> BiquadFilter
  biquad-lpf (cutoff) (sample-rate) (q) =
    let w0 = 6283 * cutoff / sample-rate
    in let alpha = filter-sinc w0 * 1000 / (2 * q)
    in let cos-w0 = cordic-cos w0
    in let a0 = 1000 + alpha
    in BiquadFilter {
      b0 = (1000 - cos-w0) / 2 * 1000 / a0,
      b1 = (1000 - cos-w0) * 1000 / a0,
      b2 = (1000 - cos-w0) / 2 * 1000 / a0,
      a1 = (0 - 2) * cos-w0 * 1000 / a0,
      a2 = (1000 - alpha) * 1000 / a0
    }

Section: Window Functions

  hamming-window : Integer, Integer -> Integer
  hamming-window (i) (n) =
    if n <= 1 then 1000
    else 540 - 460 * cordic-cos (6283 * i / (n - 1)) / 1000

Section: Sinc

  filter-sinc : Integer -> Integer
  filter-sinc (x) =
    if x == 0 then 1000
    else cordic-sin x * 1000 / x

