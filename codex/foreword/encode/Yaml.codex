Chapter: Yaml
  cites Foreword chapter Maybe

 We say:

Section: Types

  YamlValue =
    | YamlString (Text)
    | YamlInt (Integer)
    | YamlBool (Boolean)
    | YamlNull
    | YamlList (List YamlValue)
    | YamlMap (List YamlPair)

  YamlPair = record {
    yp-key : Text,
    yp-value : YamlValue
  }

Section: Construction

  yaml-string : Text -> YamlValue
  yaml-string (s) = YamlString s

  yaml-int : Integer -> YamlValue
  yaml-int (n) = YamlInt n

  yaml-bool : Boolean -> YamlValue
  yaml-bool (b) = YamlBool b

  yaml-null : YamlValue = YamlNull

  yaml-list : List YamlValue -> YamlValue
  yaml-list (items) = YamlList items

  yaml-map : List YamlPair -> YamlValue
  yaml-map (pairs) = YamlMap pairs

  yaml-pair : Text, YamlValue -> YamlPair
  yaml-pair (k) (v) = YamlPair { yp-key = k, yp-value = v }

Section: Lookup

  yaml-get : YamlValue, Text -> Maybe YamlValue
  yaml-get (v) (key) = when v
    is YamlMap (pairs) -> yaml-find-pair pairs key 0 (list-length pairs)
    is otherwise -> None

  yaml-find-pair : List YamlPair, Text, Integer, Integer -> Maybe YamlValue
  yaml-find-pair (pairs) (key) (i) (len) =
    if i >= len then None
    else let p = list-at pairs i
    in if p.yp-key == key then Just (p.yp-value)
    else yaml-find-pair pairs key (i + 1) len

  yaml-get-str : YamlValue, Text, Text -> Text
  yaml-get-str (v) (key) (default) =
    when yaml-get v key
      is Just (val) -> when val
        is YamlString (s) -> s
        is otherwise -> default
      is None -> default

  yaml-get-int : YamlValue, Text, Integer -> Integer
  yaml-get-int (v) (key) (default) =
    when yaml-get v key
      is Just (val) -> when val
        is YamlInt (n) -> n
        is otherwise -> default
      is None -> default

  yaml-get-list : YamlValue, Text -> List YamlValue
  yaml-get-list (v) (key) =
    when yaml-get v key
      is Just (val) -> when val
        is YamlList (items) -> items
        is otherwise -> []
      is None -> []

Section: Parsing

 The YAML subset read here, and everything outside it answers None rather than
 a value it did not read: one block at column 0, either a mapping of
 "key: scalar" and "key:" lines or a sequence of "- scalar" and "-" lines, with
 blank and # comment lines. A key is letters, digits, _, - and . and appears
 once, as YAML 1.2 requires. A scalar is plain (optionally ending in " #"
 comment), a one-line "double" string without escapes, a 'single' string, the
 1.2 core spellings of true, false and null, or a decimal integer of at most 18
 digits, since 19 can exceed the 64-bit range. A plain scalar that looks
 numeric but is not such an integer (a float, hex, 1_000) is refused rather
 than answered as text. Indentation, flow collections, anchors, aliases, tags,
 block scalars and document markers are outside it.

  yaml-parse : Text -> Maybe YamlValue
  yaml-parse (input) =
    let lines = text-split input "\n"
    in let n = list-length lines
    in let first = yaml-first-content lines 0 n
    in if first >= n then Just YamlNull
    else if yaml-is-item (list-at lines first) then yaml-seq-loop lines first n []
    else yaml-map-loop lines first n [] (yaml-slots n)

  yaml-first-content : List Text, Integer, Integer -> Integer
  yaml-first-content (lines) (i) (n) =
    if i >= n then n
    else if yaml-skippable (list-at lines i) then yaml-first-content lines (i + 1) n
    else i

  yaml-skippable : Text -> Boolean
  yaml-skippable (line) =
    let t = yaml-trim line
    in if text-length t == 0 then True else yaml-starts-with t "#"

  yaml-is-item : Text -> Boolean
  yaml-is-item (line) =
    if yaml-trim-right line == "-" then True else yaml-starts-with line "- "

  yaml-seq-loop : List Text, Integer, Integer, List YamlValue -> Maybe YamlValue
  yaml-seq-loop (lines) (i) (n) (acc) =
    if i >= n then Just (YamlList acc)
    else let line = yaml-trim-right (list-at lines i)
    in if yaml-skippable line then yaml-seq-loop lines (i + 1) n acc
    else if yaml-is-item line then
      when yaml-scalar (yaml-trim (substring line 1 (text-length line - 1)))
        is Just (v) -> yaml-seq-loop lines (i + 1) n (list-push acc v)
        is None -> None
    else None

  yaml-map-loop : List Text, Integer, Integer, List YamlPair, List Text -> Maybe YamlValue
  yaml-map-loop (lines) (i) (n) (acc) (seen) =
    if i >= n then Just (YamlMap acc)
    else let line = yaml-trim-right (list-at lines i)
    in if yaml-skippable line then yaml-map-loop lines (i + 1) n acc seen
    else let colon = yaml-key-end line 0 (text-length line)
    in if colon <= 0 then None
    else let key = substring line 0 colon
    in if yaml-plain-key key 0 colon then
      let slot = yaml-slot seen key
      in if text-length (list-at seen slot) > 0 then None
      else when yaml-scalar (yaml-trim (substring line (colon + 1) (text-length line - colon - 1)))
        is Just (v) -> yaml-map-loop lines (i + 1) n (list-push acc (YamlPair { yp-key = key, yp-value = v })) (list-set-at seen slot key)
        is None -> None
    else None

  yaml-key-end : Text, Integer, Integer -> Integer
  yaml-key-end (s) (i) (n) =
    if i >= n then 0 - 1
    else if char-code-at s i == char-code-at ":" 0 then
      if i + 1 >= n then i
      else if char-code-at s (i + 1) == char-code-at " " 0 then i
      else yaml-key-end s (i + 1) n
    else yaml-key-end s (i + 1) n

  yaml-plain-key : Text, Integer, Integer -> Boolean
  yaml-plain-key (k) (i) (n) =
    if i >= n then True
    else let c = char-code-at k i
    in if is-letter (char-at k i) then yaml-plain-key k (i + 1) n
    else if is-digit (char-at k i) then yaml-plain-key k (i + 1) n
    else if c == char-code-at "_" 0 then yaml-plain-key k (i + 1) n
    else if c == char-code-at "-" 0 then yaml-plain-key k (i + 1) n
    else if c == char-code-at "." 0 then yaml-plain-key k (i + 1) n
    else False

  yaml-scalar : Text -> Maybe YamlValue
  yaml-scalar (s) =
    if text-length s == 0 then Just YamlNull
    else if yaml-starts-with s "\"" then yaml-quoted s "\"" True
    else if yaml-starts-with s "'" then yaml-quoted s "'" False
    else yaml-plain (yaml-strip-comment s)

  yaml-quoted : Text, Text, Boolean -> Maybe YamlValue
  yaml-quoted (s) (quote) (double) =
    let close = yaml-find-char s (char-code-at quote 0) 1 (text-length s)
    in if close < 0 then None
    else let inner = substring s 1 (close - 1)
    in let rest = substring s (close + 1) (text-length s - close - 1)
    in if double then
      if text-contains inner "\\" then None
      else if yaml-rest-ok rest then Just (YamlString inner) else None
    else if yaml-rest-ok rest then Just (YamlString inner) else None

  yaml-rest-ok : Text -> Boolean
  yaml-rest-ok (rest) =
    if text-length rest == 0 then True
    else if yaml-starts-with rest " " then yaml-starts-with (yaml-trim rest) "#"
    else False

  yaml-plain : Text -> Maybe YamlValue
  yaml-plain (v) =
    if text-length v == 0 then Just YamlNull
    else if yaml-indicator (char-at v 0) then None
    else if text-contains v ": " then None
    else if char-code-at v (text-length v - 1) == char-code-at ":" 0 then None
    else if v == "true" then Just (YamlBool True)
    else if v == "True" then Just (YamlBool True)
    else if v == "TRUE" then Just (YamlBool True)
    else if v == "false" then Just (YamlBool False)
    else if v == "False" then Just (YamlBool False)
    else if v == "FALSE" then Just (YamlBool False)
    else if v == "null" then Just YamlNull
    else if v == "Null" then Just YamlNull
    else if v == "NULL" then Just YamlNull
    else if v == "~" then Just YamlNull
    else if yaml-numeric-start v then
      if yaml-decimal v then Just (YamlInt (yaml-integer-value v)) else None
    else if v == "-" then None
    else if yaml-starts-with v "- " then None
    else Just (YamlString v)

  yaml-indicator : Char -> Boolean
  yaml-indicator (c) = text-contains "[]{}&*!|>%@`,?:#'\"" (char-to-text c)

  yaml-numeric-start : Text -> Boolean
  yaml-numeric-start (v) =
    if is-digit (char-at v 0) then True
    else if text-length v < 2 then False
    else if is-digit (char-at v 1) then
      if yaml-starts-with v "-" then True
      else if yaml-starts-with v "+" then True
      else yaml-starts-with v "."
    else False

  yaml-decimal : Text -> Boolean
  yaml-decimal (v) =
    let n = text-length v
    in let start = if yaml-starts-with v "+" then 1 else if yaml-starts-with v "-" then 1 else 0
    in if n - start < 1 then False
    else if n - start > 18 then False
    else yaml-digits v start n

  yaml-digits : Text, Integer, Integer -> Boolean
  yaml-digits (s) (i) (n) =
    if i >= n then True
    else if is-digit (char-at s i) then yaml-digits s (i + 1) n
    else False

  yaml-integer-value : Text -> Integer
  yaml-integer-value (v) =
    if yaml-starts-with v "+" then text-to-integer (substring v 1 (text-length v - 1))
    else text-to-integer v

  yaml-strip-comment : Text -> Text
  yaml-strip-comment (s) =
    let hash = yaml-find-comment s 1 (text-length s)
    in if hash < 0 then s else yaml-trim (substring s 0 hash)

  yaml-find-comment : Text, Integer, Integer -> Integer
  yaml-find-comment (s) (i) (n) =
    if i >= n then 0 - 1
    else if char-code-at s i == char-code-at "#" 0 then
      if char-code-at s (i - 1) == char-code-at " " 0 then i else yaml-find-comment s (i + 1) n
    else yaml-find-comment s (i + 1) n

  yaml-find-char : Text, Integer, Integer, Integer -> Integer
  yaml-find-char (s) (target) (i) (n) =
    if i >= n then 0 - 1
    else if char-code-at s i == target then i
    else yaml-find-char s target (i + 1) n

 The keys already defined, as an open-addressing set: a list of at least twice
 as many slots as there are lines, so it never fills. The hash is masked to 24
 bits every step, so h * 31 + a character code stays under 2^30 and cannot
 overflow.

  yaml-slots : Integer -> List Text
  yaml-slots (n) = yaml-fill-slots 0 (yaml-capacity n 16) []

  yaml-capacity : Integer, Integer -> Integer
  yaml-capacity (n) (c) = if c >= 2 * n + 2 then c else yaml-capacity n (c * 2)

  yaml-fill-slots : Integer, Integer, List Text -> List Text
  yaml-fill-slots (i) (cap) (acc) = if i >= cap then acc else yaml-fill-slots (i + 1) cap (list-push acc "")

  yaml-slot : List Text, Text -> Integer
  yaml-slot (slots) (key) =
    let mask = list-length slots - 1
    in yaml-probe slots key (bit-and (yaml-hash key 0 (text-length key) 5381) mask) mask

  yaml-probe : List Text, Text, Integer, Integer -> Integer
  yaml-probe (slots) (key) (i) (mask) =
    let s = list-at slots i
    in if text-length s == 0 then i
    else if s == key then i
    else yaml-probe slots key (bit-and (i + 1) mask) mask

  yaml-hash : Text, Integer, Integer, Integer -> Integer
  yaml-hash (s) (i) (n) (h) =
    if i >= n then h
    else yaml-hash s (i + 1) n (bit-and (h * 31 + char-code-at s i) 16777215)

Section: Emission

  yaml-emit : YamlValue -> Text
  yaml-emit (v) = yaml-emit-at v 0

  yaml-emit-at : YamlValue, Integer -> Text
  yaml-emit-at (v) (indent) = when v
    is YamlString (s) -> yaml-quote-if-needed s
    is YamlInt (n) -> show n
    is YamlBool (b) -> if b then "true" else "false"
    is YamlNull -> "null"
    is YamlList (items) -> text-concat-list (yaml-emit-list items indent 0 (list-length items) [])
    is YamlMap (pairs) -> text-concat-list (yaml-emit-map pairs indent 0 (list-length pairs) [])

  yaml-emit-list : List YamlValue, Integer, Integer, Integer, List Text -> List Text
  yaml-emit-list (items) (indent) (i) (len) (acc) =
    if i >= len then acc
    else let prefix = if i == 0 then "" else "\n" & yaml-indent indent
    in let val = yaml-emit-at (list-at items i) (indent + 2)
    in yaml-emit-list items indent (i + 1) len (list-push acc (prefix & "- " & val))

  yaml-emit-map : List YamlPair, Integer, Integer, Integer, List Text -> List Text
  yaml-emit-map (pairs) (indent) (i) (len) (acc) =
    if i >= len then acc
    else let p = list-at pairs i
    in let prefix = if i == 0 then "" else "\n" & yaml-indent indent
    in let val = yaml-emit-at (p.yp-value) (indent + 2)
    in yaml-emit-map pairs indent (i + 1) len (list-push acc (prefix & p.yp-key & ": " & val))

  yaml-indent : Integer -> Text
  yaml-indent (n) = yaml-spaces n ""

  yaml-spaces : Integer, Text -> Text
  yaml-spaces (n) (acc) =
    if n <= 0 then acc
    else yaml-spaces (n - 1) (acc & " ")

  yaml-quote-if-needed : Text -> Text
  yaml-quote-if-needed (s) =
    if yaml-needs-quoting s then "\"" & s & "\""
    else s

  yaml-needs-quoting : Text -> Boolean
  yaml-needs-quoting (s) =
    if text-length s == 0 then True
    else if yaml-starts-with s "- " then True
    else yaml-contains s ": "

Section: Helpers

  yaml-trim : Text -> Text
  yaml-trim (s) =
    let n = text-length s
    in let a = yaml-first-solid s 0 n
    in let b = yaml-last-solid s n
    in if a >= b then "" else substring s a (b - a)

  yaml-trim-right : Text -> Text
  yaml-trim-right (s) =
    let b = yaml-last-solid s (text-length s)
    in if b == text-length s then s else substring s 0 b

  yaml-first-solid : Text, Integer, Integer -> Integer
  yaml-first-solid (s) (i) (n) =
    if i >= n then n
    else if char-code-at s i == char-code-at " " 0 then yaml-first-solid s (i + 1) n
    else i

  yaml-last-solid : Text, Integer -> Integer
  yaml-last-solid (s) (j) =
    if j <= 0 then 0
    else if char-code-at s (j - 1) == char-code-at " " 0 then yaml-last-solid s (j - 1)
    else j

  yaml-starts-with : Text, Text -> Boolean
  yaml-starts-with (s) (prefix) = text-starts-with s prefix

  yaml-contains : Text, Text -> Boolean
  yaml-contains (s) (sub) = text-contains s sub


