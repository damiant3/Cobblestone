Chapter: X509Write
  cites Encode chapter Asn1Write
  cites Encode chapter Asn1
  cites Encode chapter X509
  cites Encode chapter X509Chain
  cites Foreword chapter Ed25519
  cites Foreword chapter EcdsaP256Sign
  cites Foreword chapter Sha256
  cites Foreword chapter Maybe

 Ed25519 certificates (RFC 5280 profile, RFC 8410 key and signature): a
 self-signed development server certificate, a development CA root, and a
 leaf issued under that root. A P-256 self-signed development server
 certificate (RFC 5480, RFC 5758), because no browser offers Ed25519.

 The layout is RFC 5280 section 4.1: a v3 TBSCertificate of version [0],
 serial, signature AlgorithmIdentifier, issuer, validity, subject,
 subjectPublicKeyInfo and extensions [3], then the same AlgorithmIdentifier
 and the signature as a BIT STRING. RFC 8410 section 3: the Ed25519
 AlgorithmIdentifier carries no parameters, and the signature is over the
 DER of the TBSCertificate itself.

 RFC 5280 section 4.1.2.5: a time in 1950 through 2049 MUST be UTCTime,
 and any other year MUST be GeneralizedTime. The caller hands 14 ASCII
 digits, YYYYMMDDHHMMSS, UTC.

 RFC 5280 section 4.1.2.2: a serial is positive and at most 20 octets.

 The organization attribute is a DEV-ONLY marker on every name written
 here, the CA's and the issued leaf's included.

 RFC 5280 section 4.2.1.9: a CA carries basicConstraints cA TRUE, marked
 critical. pathLenConstraint 0 lets the root issue leaves and no further
 CA. Section 4.2.1.3: a CA certificate whose key verifies certificate
 signatures carries keyUsage with keyCertSign, marked critical.

 RFC 5280 sections 4.2.1.2 and 4.2.1.1: a CA certificate carries a
 subjectKeyIdentifier, and a certificate the CA issues carries an
 authorityKeyIdentifier whose keyIdentifier equals that value. The
 identifier is RFC 7093 section 2 method 1: the leftmost 160 bits of the
 SHA-256 of the subjectPublicKey BIT STRING's value, for Ed25519 the 32
 key bytes.

 We say:

Section: Object Identifiers

  x509w-oid-ed25519 : List Integer = [43, 101, 112]
  x509w-oid-cn : List Integer = [85, 4, 3]
  x509w-oid-org : List Integer = [85, 4, 10]
  x509w-oid-basic-constraints : List Integer = [85, 29, 19]
  x509w-oid-san : List Integer = [85, 29, 17]
  x509w-oid-key-usage : List Integer = [85, 29, 15]
  x509w-oid-ski : List Integer = [85, 29, 14]
  x509w-oid-aki : List Integer = [85, 29, 35]

 The ASCII of the texts Codex DEV-ONLY self-signed, Codex DEV-ONLY CA and
 Codex DEV-ONLY issued.

  x509w-dev-org : List Integer =
    [67, 111, 100, 101, 120, 32, 68, 69, 86, 45, 79, 78, 76, 89, 32, 115,
     101, 108, 102, 45, 115, 105, 103, 110, 101, 100]

  x509w-ca-org : List Integer =
    [67, 111, 100, 101, 120, 32, 68, 69, 86, 45, 79, 78, 76, 89, 32, 67, 65]

  x509w-issued-org : List Integer =
    [67, 111, 100, 101, 120, 32, 68, 69, 86, 45, 79, 78, 76, 89, 32, 105,
     115, 115, 117, 101, 100]

 keyUsage is a named BIT STRING with bit 0 the most significant bit of the
 first octet. keyCertSign is bit 5, therefore the octet is #04 with two
 unused trailing bits.

  x509w-ku-cert-sign : List Integer = [2, #04]

 GeneralName tags, RFC 5280 section 4.2.1.6: dNSName is context tag 2
 and iPAddress is context tag 7, both primitive.

  x509w-gn-dns : Integer = #82
  x509w-gn-ip : Integer = #87

Section: Checks

  x509w-digits : List Integer, Integer -> Boolean
  x509w-digits (t) (i) =
    if i >= list-length t then True
    else if list-at t i < 48 then False
    else if list-at t i > 57 then False
    else x509w-digits t (i + 1)

  x509w-time-ok : List Integer -> Boolean
  x509w-time-ok (t) =
    if list-length t /= 14 then False
    else x509w-digits t 0

  x509w-all-len : List (List Integer), Integer, Integer -> Boolean
  x509w-all-len (xs) (n) (i) =
    if i >= list-length xs then True
    else if list-length (list-at xs i) /= n then False
    else x509w-all-len xs n (i + 1)

  x509w-none-empty : List (List Integer), Integer -> Boolean
  x509w-none-empty (xs) (i) =
    if i >= list-length xs then True
    else if list-length (list-at xs i) < 1 then False
    else x509w-none-empty xs (i + 1)

Section: Serial

  x509w-strip0 : List Integer, Integer -> List Integer
  x509w-strip0 (bs) (i) =
    if i >= list-length bs then []
    else if list-at bs i == 0 then x509w-strip0 bs (i + 1)
    else x509w-from bs i []

  x509w-from : List Integer, Integer, List Integer -> List Integer
  x509w-from (bs) (i) (acc) =
    if i >= list-length bs then acc
    else x509w-from bs (i + 1) (list-push acc (list-at bs i))

  x509w-serial-content : List Integer -> List Integer
  x509w-serial-content (serial) =
    let s = x509w-strip0 serial 0
    in if list-length s < 1 then []
    else der-int-pad s

Section: Names And Times

  x509w-rdn : List Integer, List Integer -> List Integer
  x509w-rdn (oid) (value) = der-set (der-sequence (der-oid oid & der-utf8-string value))

  x509w-name : List Integer -> List Integer
  x509w-name (cn) = x509w-name-org x509w-dev-org cn

  x509w-name-org : List Integer, List Integer -> List Integer
  x509w-name-org (org) (cn) = der-sequence (x509w-rdn x509w-oid-org org & x509w-rdn x509w-oid-cn cn)

  x509w-year : List Integer -> Integer
  x509w-year (t) =
    (list-at t 0 - 48) * 1000 + (list-at t 1 - 48) * 100 + (list-at t 2 - 48) * 10 + (list-at t 3 - 48)

  x509w-time : List Integer -> List Integer
  x509w-time (t) =
    let y = x509w-year t
    in if y < 1950 then der-general-time (t & [90])
    else if y > 2049 then der-general-time (t & [90])
    else der-utc-time (x509w-from t 2 [] & [90])

  x509w-validity : List Integer, List Integer -> List Integer
  x509w-validity (not-before) (not-after) = der-sequence (x509w-time not-before & x509w-time not-after)

Section: Extensions

  x509w-ext : List Integer, Boolean, List Integer -> List Integer
  x509w-ext (oid) (critical) (value) =
    if critical then der-sequence (der-oid oid & der-bool True & der-octet-string value)
    else der-sequence (der-oid oid & der-octet-string value)

  x509w-general-names : List (List Integer), Integer, Integer, List Integer -> List Integer
  x509w-general-names (xs) (tag) (i) (acc) =
    if i >= list-length xs then acc
    else x509w-general-names xs tag (i + 1) (acc & der-tlv tag (list-at xs i))

 basicConstraints with cA absent is an empty SEQUENCE: DER omits a
 DEFAULT FALSE.

  x509w-extensions : List (List Integer), List (List Integer) -> List Integer
  x509w-extensions (dns-names) (ip-addrs) = der-ctx3 (der-sequence (x509w-leaf-exts dns-names ip-addrs))

  x509w-leaf-exts : List (List Integer), List (List Integer) -> List Integer
  x509w-leaf-exts (dns-names) (ip-addrs) =
    let bc = x509w-ext x509w-oid-basic-constraints True (der-sequence [])
    in let names = x509w-general-names ip-addrs x509w-gn-ip 0 (x509w-general-names dns-names x509w-gn-dns 0 [])
    in let san = x509w-ext x509w-oid-san False (der-sequence names)
    in bc & san

  x509w-key-id : List Integer -> List Integer
  x509w-key-id (pub) = x509w-take (sha256-bytes pub) 20 0 []

  x509w-take : List Integer, Integer, Integer, List Integer -> List Integer
  x509w-take (bs) (n) (i) (acc) =
    if i >= n then acc
    else x509w-take bs n (i + 1) (list-push acc (list-at bs i))

  x509w-ca-extensions : List Integer -> List Integer
  x509w-ca-extensions (pub) =
    let bc = x509w-ext x509w-oid-basic-constraints True (der-sequence (der-bool True & der-small-int 0))
    in let ku = x509w-ext x509w-oid-key-usage True (der-tlv asn1-bit-string-tag x509w-ku-cert-sign)
    in let ski = x509w-ext x509w-oid-ski False (der-octet-string (x509w-key-id pub))
    in der-ctx3 (der-sequence (bc & ku & ski))

 AuthorityKeyIdentifier's keyIdentifier is [0] IMPLICIT, a primitive
 context tag.

  x509w-issued-extensions : List (List Integer), List (List Integer), List Integer -> List Integer
  x509w-issued-extensions (dns-names) (ip-addrs) (ca-pub) =
    let aki = x509w-ext x509w-oid-aki False (der-sequence (der-tlv #80 (x509w-key-id ca-pub)))
    in der-ctx3 (der-sequence (x509w-leaf-exts dns-names ip-addrs & aki))

Section: The Certificate

  x509w-alg-id : List Integer = der-sequence (der-oid x509w-oid-ed25519)

  x509w-spki : List Integer -> List Integer
  x509w-spki (pub) = der-sequence (x509w-alg-id & der-bit-string pub)

  x509w-tbs-head : List Integer, List Integer, List Integer -> List Integer
  x509w-tbs-head (alg) (serial-content) (name) =
    der-ctx0 (der-small-int 2) & der-int-bytes serial-content & alg & name

  x509w-tbs-tail : List Integer, List Integer, List Integer, List Integer -> List Integer
  x509w-tbs-tail (validity) (name) (spki) (exts) =
    validity & name & spki & exts

  x509w-tbs : List Integer, List Integer, List Integer, List Integer, List Integer, List (List Integer), List (List Integer) -> List Integer
  x509w-tbs (pub) (serial-content) (cn) (not-before) (not-after) (dns-names) (ip-addrs) =
    let name = x509w-name cn
    in x509w-tbs-of pub serial-content name name (x509w-validity not-before not-after) (x509w-extensions dns-names ip-addrs)

  x509w-tbs-of : List Integer, List Integer, List Integer, List Integer, List Integer, List Integer -> List Integer
  x509w-tbs-of (pub) (serial-content) (issuer) (subject) (validity) (exts) =
    x509w-tbs-with x509w-alg-id (x509w-spki pub) serial-content issuer subject validity exts

  x509w-tbs-with : List Integer, List Integer, List Integer, List Integer, List Integer, List Integer, List Integer -> List Integer
  x509w-tbs-with (alg) (spki) (serial-content) (issuer) (subject) (validity) (exts) =
    der-sequence (x509w-tbs-head alg serial-content issuer & x509w-tbs-tail validity subject spki exts)

  x509w-sign : List Integer, List Integer, List Integer -> List Integer
  x509w-sign (priv) (pub) (tbs) =
    der-sequence (tbs & x509w-alg-id & der-bit-string (ed25519-sign priv pub tbs))

 A refusal is None, never a certificate: a 32-byte private key, a serial
 of 1 to 20 content octets after sign padding, a non-empty common name,
 two 14-digit times, and at least one name, every dNSName non-empty and
 every iPAddress four octets (IPv4).

  x509-dev-cert-ed25519 : List Integer, List Integer, List Integer, List Integer, List Integer, List (List Integer), List (List Integer) -> Maybe (List Integer)
  x509-dev-cert-ed25519 (priv) (serial) (cn) (not-before) (not-after) (dns-names) (ip-addrs) =
    let sc = x509w-serial-content serial
    in if list-length priv /= 32 then None
    else if list-length sc < 1 then None
    else if list-length sc > 20 then None
    else if list-length cn < 1 then None
    else if x509w-time-ok not-before == False then None
    else if x509w-time-ok not-after == False then None
    else if list-length dns-names + list-length ip-addrs < 1 then None
    else if x509w-none-empty dns-names 0 == False then None
    else if x509w-all-len ip-addrs 4 0 == False then None
    else x509w-mint priv sc cn not-before not-after dns-names ip-addrs

  x509w-mint : List Integer, List Integer, List Integer, List Integer, List Integer, List (List Integer), List (List Integer) -> Maybe (List Integer)
  x509w-mint (priv) (sc) (cn) (not-before) (not-after) (dns-names) (ip-addrs) =
    let pub = ed25519-public-key priv
    in Just (x509w-sign priv pub (x509w-tbs pub sc cn not-before not-after dns-names ip-addrs))

Section: The P-256 Certificate

 RFC 5480 section 2.1.1: a P-256 subjectPublicKeyInfo names
 id-ecPublicKey with the namedCurve prime256v1 as its parameters, and the
 key is the 65-byte SEC1 uncompressed point. RFC 5758 section 3.2:
 ecdsa-with-SHA256 carries NO parameters, and the signature BIT STRING
 holds the DER of Ecdsa-Sig-Value, SEQUENCE { r INTEGER, s INTEGER }, each
 INTEGER minimal and positive.

  x509w-p256-alg-id : List Integer = der-sequence (der-oid x509-oid-ecdsa-sha256)

  x509w-p256-spki : List Integer -> List Integer
  x509w-p256-spki (pub) =
    der-sequence (der-sequence (der-oid x509-oid-ec-public-key & der-oid x509-oid-p256) & der-bit-string pub)

  x509w-ecdsa-sig : List Integer -> List Integer
  x509w-ecdsa-sig (rs) =
    let r = der-int-bytes (x509w-serial-content (x509w-take rs 32 0 []))
    in der-sequence (r & der-int-bytes (x509w-serial-content (x509w-from rs 32 [])))

  x509w-names-ok : List (List Integer), List (List Integer) -> Boolean
  x509w-names-ok (dns-names) (ip-addrs) =
    if list-length dns-names + list-length ip-addrs < 1 then False
    else if x509w-none-empty dns-names 0 == False then False
    else x509w-all-len ip-addrs 4 0

 The refusals are the Ed25519 certificate's, with the key a P-256 scalar
 in [1, n-1] as 32 bytes, and None when the signer refuses.

  x509-dev-cert-p256 : List Integer, List Integer, List Integer, List Integer, List Integer, List (List Integer), List (List Integer) -> Maybe (List Integer)
  x509-dev-cert-p256 (priv) (serial) (cn) (not-before) (not-after) (dns-names) (ip-addrs) =
    let sc = x509w-serial-content serial
    in if list-length priv /= 32 then None
    else if x509w-common-ok sc cn not-before not-after == False then None
    else if x509w-names-ok dns-names ip-addrs == False then None
    else x509w-p256-mint priv (ecdsa-p256-public priv) sc (x509w-name cn) (x509w-validity not-before not-after) (x509w-extensions dns-names ip-addrs)

  x509w-p256-mint : List Integer, List Integer, List Integer, List Integer, List Integer, List Integer -> Maybe (List Integer)
  x509w-p256-mint (priv) (pub) (sc) (name) (validity) (exts) =
    if list-length pub /= 65 then None
    else x509w-p256-signed (x509w-tbs-with x509w-p256-alg-id (x509w-p256-spki pub) sc name name validity exts) priv

  x509w-p256-signed : List Integer, List Integer -> Maybe (List Integer)
  x509w-p256-signed (tbs) (priv) =
    let rs = ecdsa-p256-sign priv tbs
    in if list-length rs /= 64 then None
    else Just (der-sequence (tbs & x509w-p256-alg-id & der-bit-string (x509w-ecdsa-sig rs)))

Section: The Authority

 A refusal is None: a 32-byte private key, a serial of 1 to 20 content
 octets, a non-empty common name and two 14-digit times.

  x509-ca-cert-ed25519 : List Integer, List Integer, List Integer, List Integer, List Integer -> Maybe (List Integer)
  x509-ca-cert-ed25519 (priv) (serial) (cn) (not-before) (not-after) =
    let sc = x509w-serial-content serial
    in if list-length priv /= 32 then None
    else if x509w-common-ok sc cn not-before not-after == False then None
    else Just (x509w-ca-mint priv sc cn not-before not-after)

  x509w-common-ok : List Integer, List Integer, List Integer, List Integer -> Boolean
  x509w-common-ok (sc) (cn) (not-before) (not-after) =
    if list-length sc < 1 then False
    else if list-length sc > 20 then False
    else if list-length cn < 1 then False
    else if x509w-time-ok not-before == False then False
    else x509w-time-ok not-after

  x509w-ca-mint : List Integer, List Integer, List Integer, List Integer, List Integer -> List Integer
  x509w-ca-mint (priv) (sc) (cn) (not-before) (not-after) =
    let pub = ed25519-public-key priv
    in let name = x509w-name-org x509w-ca-org cn
    in x509w-sign priv pub (x509w-tbs-of pub sc name name (x509w-validity not-before not-after) (x509w-ca-extensions pub))

 A leaf issued under a CA the caller holds. The issuer is the CA
 certificate's subject as raw DER, the bytes a chain walk compares.
 Beyond the self-signed refusals, None when the CA certificate does not
 parse, is not a CA, or carries a key other than the Ed25519 public key
 of ca-priv, when the leaf's notAfter is later than the CA's, and when
 the leaf's public key is not 32 bytes.

  x509-issue-ed25519 : List Integer, List Integer, List Integer, List Integer, List Integer, List Integer, List Integer, List (List Integer), List (List Integer) -> Maybe (List Integer)
  x509-issue-ed25519 (ca-priv) (ca-cert) (pub) (serial) (cn) (not-before) (not-after) (dns-names) (ip-addrs) =
    let sc = x509w-serial-content serial
    in if list-length ca-priv /= 32 then None
    else if list-length pub /= 32 then None
    else if x509w-common-ok sc cn not-before not-after == False then None
    else if list-length dns-names + list-length ip-addrs < 1 then None
    else if x509w-none-empty dns-names 0 == False then None
    else if x509w-all-len ip-addrs 4 0 == False then None
    else x509w-issue-under ca-priv (x509-parse ca-cert) pub sc (x509w-name-org x509w-issued-org cn) not-before not-after (x509w-issued-extensions dns-names ip-addrs (ed25519-public-key ca-priv))

  x509w-issue-under : List Integer, Maybe X509Cert, List Integer, List Integer, List Integer, List Integer, List Integer, List Integer -> Maybe (List Integer)
  x509w-issue-under (ca-priv) (m) (pub) (sc) (subject) (not-before) (not-after) (exts) =
    when m
      is None -> None
      is Just (ca) -> x509w-issue-within ca-priv ca not-after (x509w-tbs-of pub sc (ca.xc-subject) subject (x509w-validity not-before not-after) exts)

  x509w-issue-within : List Integer, X509Cert, List Integer, List Integer -> Maybe (List Integer)
  x509w-issue-within (ca-priv) (ca) (not-after) (tbs) =
    when x509-time-norm (ca.xc-not-after)
      is None -> None
      is Just (ca-na) -> if x509-time-le not-after ca-na then x509w-issue-checked ca-priv ca tbs else None

  x509w-issue-checked : List Integer, X509Cert, List Integer -> Maybe (List Integer)
  x509w-issue-checked (ca-priv) (ca) (tbs) =
    let ca-pub = ed25519-public-key ca-priv
    in if ca.xc-is-ca == False then None
    else if x509w-key-is-ed ((ca.xc-key).xk-alg) == False then None
    else if x509w-bytes-eq ((ca.xc-key).xk-bytes) ca-pub == False then None
    else Just (x509w-sign ca-priv ca-pub tbs)

  x509w-key-is-ed : X509KeyAlg -> Boolean
  x509w-key-is-ed (a) =
    when a
      is KeyEd25519 -> True
      is otherwise -> False

  x509w-bytes-eq : List Integer, List Integer -> Boolean
  x509w-bytes-eq (a) (b) =
    if list-length a /= list-length b then False
    else x509w-bytes-eq-at a b 0

  x509w-bytes-eq-at : List Integer, List Integer, Integer -> Boolean
  x509w-bytes-eq-at (a) (b) (i) =
    if i >= list-length a then True
    else if list-at a i /= list-at b i then False
    else x509w-bytes-eq-at a b (i + 1)
