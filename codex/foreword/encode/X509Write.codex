Chapter: X509Write
  cites Encode chapter Asn1Write
  cites Encode chapter Asn1
  cites Foreword chapter Ed25519
  cites Foreword chapter Maybe

 A self-signed Ed25519 certificate (RFC 5280 profile, RFC 8410 key and
 signature), for a development server that has no issuer.

 The layout is RFC 5280 section 4.1: a v3 TBSCertificate of version [0],
 serial, signature AlgorithmIdentifier, issuer, validity, subject,
 subjectPublicKeyInfo and extensions [3], then the same AlgorithmIdentifier
 and the signature as a BIT STRING. RFC 8410 section 3: the Ed25519
 AlgorithmIdentifier carries no parameters, and the signature is over the
 DER of the TBSCertificate itself.

 RFC 5280 section 4.1.2.5: a time in 1950 through 2049 MUST be UTCTime,
 and any other year MUST be GeneralizedTime. The caller hands 14 ASCII
 digits, YYYYMMDDHHMMSS, UTC.

 RFC 5280 section 4.1.2.2: a serial is positive and at most 20 octets.

 The organization attribute is the DEV-ONLY marker, and issuer equals
 subject: nothing minted here can be read as an issued certificate.

 We say:

Section: Object Identifiers

  x509w-oid-ed25519 : List Integer = [43, 101, 112]
  x509w-oid-cn : List Integer = [85, 4, 3]
  x509w-oid-org : List Integer = [85, 4, 10]
  x509w-oid-basic-constraints : List Integer = [85, 29, 19]
  x509w-oid-san : List Integer = [85, 29, 17]

 The ASCII of the text Codex DEV-ONLY self-signed.

  x509w-dev-org : List Integer =
    [67, 111, 100, 101, 120, 32, 68, 69, 86, 45, 79, 78, 76, 89, 32, 115,
     101, 108, 102, 45, 115, 105, 103, 110, 101, 100]

 GeneralName tags, RFC 5280 section 4.2.1.6: dNSName is context tag 2
 and iPAddress is context tag 7, both primitive.

  x509w-gn-dns : Integer = #82
  x509w-gn-ip : Integer = #87

Section: Checks

  x509w-digits : List Integer, Integer -> Boolean
  x509w-digits (t) (i) =
    if i >= list-length t then True
    else if list-at t i < 48 then False
    else if list-at t i > 57 then False
    else x509w-digits t (i + 1)

  x509w-time-ok : List Integer -> Boolean
  x509w-time-ok (t) =
    if list-length t /= 14 then False
    else x509w-digits t 0

  x509w-all-len : List (List Integer), Integer, Integer -> Boolean
  x509w-all-len (xs) (n) (i) =
    if i >= list-length xs then True
    else if list-length (list-at xs i) /= n then False
    else x509w-all-len xs n (i + 1)

  x509w-none-empty : List (List Integer), Integer -> Boolean
  x509w-none-empty (xs) (i) =
    if i >= list-length xs then True
    else if list-length (list-at xs i) < 1 then False
    else x509w-none-empty xs (i + 1)

Section: Serial

  x509w-strip0 : List Integer, Integer -> List Integer
  x509w-strip0 (bs) (i) =
    if i >= list-length bs then []
    else if list-at bs i == 0 then x509w-strip0 bs (i + 1)
    else x509w-from bs i []

  x509w-from : List Integer, Integer, List Integer -> List Integer
  x509w-from (bs) (i) (acc) =
    if i >= list-length bs then acc
    else x509w-from bs (i + 1) (list-push acc (list-at bs i))

  x509w-serial-content : List Integer -> List Integer
  x509w-serial-content (serial) =
    let s = x509w-strip0 serial 0
    in if list-length s < 1 then []
    else der-int-pad s

Section: Names And Times

  x509w-rdn : List Integer, List Integer -> List Integer
  x509w-rdn (oid) (value) = der-set (der-sequence (der-oid oid & der-utf8-string value))

  x509w-name : List Integer -> List Integer
  x509w-name (cn) = der-sequence (x509w-rdn x509w-oid-org x509w-dev-org & x509w-rdn x509w-oid-cn cn)

  x509w-year : List Integer -> Integer
  x509w-year (t) =
    (list-at t 0 - 48) * 1000 + (list-at t 1 - 48) * 100 + (list-at t 2 - 48) * 10 + (list-at t 3 - 48)

  x509w-time : List Integer -> List Integer
  x509w-time (t) =
    let y = x509w-year t
    in if y < 1950 then der-general-time (t & [90])
    else if y > 2049 then der-general-time (t & [90])
    else der-utc-time (x509w-from t 2 [] & [90])

  x509w-validity : List Integer, List Integer -> List Integer
  x509w-validity (not-before) (not-after) = der-sequence (x509w-time not-before & x509w-time not-after)

Section: Extensions

  x509w-ext : List Integer, Boolean, List Integer -> List Integer
  x509w-ext (oid) (critical) (value) =
    if critical then der-sequence (der-oid oid & der-bool True & der-octet-string value)
    else der-sequence (der-oid oid & der-octet-string value)

  x509w-general-names : List (List Integer), Integer, Integer, List Integer -> List Integer
  x509w-general-names (xs) (tag) (i) (acc) =
    if i >= list-length xs then acc
    else x509w-general-names xs tag (i + 1) (acc & der-tlv tag (list-at xs i))

 basicConstraints with cA absent is an empty SEQUENCE: DER omits a
 DEFAULT FALSE.

  x509w-extensions : List (List Integer), List (List Integer) -> List Integer
  x509w-extensions (dns-names) (ip-addrs) =
    let bc = x509w-ext x509w-oid-basic-constraints True (der-sequence [])
    in let names = x509w-general-names ip-addrs x509w-gn-ip 0 (x509w-general-names dns-names x509w-gn-dns 0 [])
    in let san = x509w-ext x509w-oid-san False (der-sequence names)
    in der-ctx3 (der-sequence (bc & san))

Section: The Certificate

  x509w-alg-id : List Integer = der-sequence (der-oid x509w-oid-ed25519)

  x509w-spki : List Integer -> List Integer
  x509w-spki (pub) = der-sequence (x509w-alg-id & der-bit-string pub)

  x509w-tbs-head : List Integer, List Integer -> List Integer
  x509w-tbs-head (serial-content) (name) =
    der-ctx0 (der-small-int 2) & der-int-bytes serial-content & x509w-alg-id & name

  x509w-tbs-tail : List Integer, List Integer, List Integer, List Integer -> List Integer
  x509w-tbs-tail (validity) (name) (pub) (exts) =
    validity & name & x509w-spki pub & exts

  x509w-tbs : List Integer, List Integer, List Integer, List Integer, List Integer, List (List Integer), List (List Integer) -> List Integer
  x509w-tbs (pub) (serial-content) (cn) (not-before) (not-after) (dns-names) (ip-addrs) =
    let name = x509w-name cn
    in let front = x509w-tbs-head serial-content name
    in let back = x509w-tbs-tail (x509w-validity not-before not-after) name pub (x509w-extensions dns-names ip-addrs)
    in der-sequence (front & back)

  x509w-sign : List Integer, List Integer, List Integer -> List Integer
  x509w-sign (priv) (pub) (tbs) =
    der-sequence (tbs & x509w-alg-id & der-bit-string (ed25519-sign priv pub tbs))

 A refusal is None, never a certificate: a 32-byte private key, a serial
 of 1 to 20 content octets after sign padding, a non-empty common name,
 two 14-digit times, and at least one name, every dNSName non-empty and
 every iPAddress four octets (IPv4).

  x509-dev-cert-ed25519 : List Integer, List Integer, List Integer, List Integer, List Integer, List (List Integer), List (List Integer) -> Maybe (List Integer)
  x509-dev-cert-ed25519 (priv) (serial) (cn) (not-before) (not-after) (dns-names) (ip-addrs) =
    let sc = x509w-serial-content serial
    in if list-length priv /= 32 then None
    else if list-length sc < 1 then None
    else if list-length sc > 20 then None
    else if list-length cn < 1 then None
    else if x509w-time-ok not-before == False then None
    else if x509w-time-ok not-after == False then None
    else if list-length dns-names + list-length ip-addrs < 1 then None
    else if x509w-none-empty dns-names 0 == False then None
    else if x509w-all-len ip-addrs 4 0 == False then None
    else x509w-mint priv sc cn not-before not-after dns-names ip-addrs

  x509w-mint : List Integer, List Integer, List Integer, List Integer, List Integer, List (List Integer), List (List Integer) -> Maybe (List Integer)
  x509w-mint (priv) (sc) (cn) (not-before) (not-after) (dns-names) (ip-addrs) =
    let pub = ed25519-public-key priv
    in Just (x509w-sign priv pub (x509w-tbs pub sc cn not-before not-after dns-names ip-addrs))
