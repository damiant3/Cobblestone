Chapter: FontGen
  cites Encode chapter TrueType
  cites Encode chapter TrueTypeWriter

 Procedural TrueType font generators. Each generator produces a
 TtfBuildSpec with glyph outlines as quadratic Bezier contours.
 Feed the result to ttw-build-ttf to get a valid .ttf byte sequence.

 Three built-in styles:
 - Block: axis-aligned rectangles, industrial look
 - Round: rectangles with rounded corners, friendly look
 - Mono: fixed-width coding font with serifs on I/l, dots on 0

 All fonts target 1000 units-per-em with 95 ASCII glyphs (32-126).

Section: Constants
  fg-upem : Integer = 1000
  fg-ascent : Integer = 800
  fg-descent : Integer = -200
  fg-cap-h : Integer = 700
  fg-x-h : Integer = 500
  fg-baseline : Integer = 0
  fg-stroke : Integer = 80
  fg-advance : Integer = 600
  fg-mono-advance : Integer = 600

Section: Contour Helpers

  fg-pt : Integer, Integer -> TtfPoint
  fg-pt (x) (y) = TtfPoint { tp-x = x, tp-y = y, tp-on-curve = 1 }

  fg-off : Integer, Integer -> TtfPoint
  fg-off (x) (y) = TtfPoint { tp-x = x, tp-y = y, tp-on-curve = 0 }

  fg-rect-contour : Integer, Integer, Integer, Integer -> TtfContour
  fg-rect-contour (x) (y) (w) (h) =
    TtfContour { tc-points = [fg-pt x y, fg-pt (x + w) y, fg-pt (x + w) (y + h), fg-pt x (y + h)] }

  fg-rect-hole : Integer, Integer, Integer, Integer -> TtfContour
  fg-rect-hole (x) (y) (w) (h) =
    TtfContour { tc-points = [fg-pt x (y + h), fg-pt (x + w) (y + h), fg-pt (x + w) y, fg-pt x y] }

  fg-rounded-rect : Integer, Integer, Integer, Integer, Integer -> TtfContour
  fg-rounded-rect (x) (y) (w) (h) (r) =
    TtfContour { tc-points = [
      fg-pt (x + r) y,
      fg-pt (x + w - r) y,
      fg-off (x + w) y, fg-pt (x + w) (y + r),
      fg-pt (x + w) (y + h - r),
      fg-off (x + w) (y + h), fg-pt (x + w - r) (y + h),
      fg-pt (x + r) (y + h),
      fg-off x (y + h), fg-pt x (y + h - r),
      fg-pt x (y + r),
      fg-off x y
    ] }

  fg-rounded-hole : Integer, Integer, Integer, Integer, Integer -> TtfContour
  fg-rounded-hole (x) (y) (w) (h) (r) =
    TtfContour { tc-points = [
      fg-off x y, fg-pt x (y + r),
      fg-pt x (y + h - r),
      fg-off x (y + h), fg-pt (x + r) (y + h),
      fg-pt (x + w - r) (y + h),
      fg-off (x + w) (y + h), fg-pt (x + w) (y + h - r),
      fg-pt (x + w) (y + r),
      fg-off (x + w) y, fg-pt (x + w - r) y,
      fg-pt (x + r) y
    ] }

  fg-hbar : Integer, Integer, Integer, Integer -> TtfContour
  fg-hbar (x) (y) (w) (t) = fg-rect-contour x y w t

  fg-vbar : Integer, Integer, Integer, Integer -> TtfContour
  fg-vbar (x) (y) (t) (h) = fg-rect-contour x y t h

  fg-make-glyph : Integer, Integer, List TtfContour -> TtfBuildGlyph
  fg-make-glyph (cp) (adv) (contours) =
    let bounds = fg-contour-bounds contours 0 (list-length contours) 0 0 0 0
    in TtfBuildGlyph {
      bg-codepoint = cp,
      bg-advance = adv,
      bg-lsb = bounds.gb-x-min,
      bg-glyph = TtfGlyph {
        tg-contours = contours,
        tg-x-min = bounds.gb-x-min, tg-y-min = bounds.gb-y-min,
        tg-x-max = bounds.gb-x-max, tg-y-max = bounds.gb-y-max,
        tg-advance = adv, tg-lsb = bounds.gb-x-min
      }
    }

  fg-empty-glyph : Integer, Integer -> TtfBuildGlyph
  fg-empty-glyph (cp) (adv) =
    TtfBuildGlyph {
      bg-codepoint = cp, bg-advance = adv, bg-lsb = 0,
      bg-glyph = TtfGlyph {
        tg-contours = [], tg-x-min = 0, tg-y-min = 0,
        tg-x-max = 0, tg-y-max = 0, tg-advance = adv, tg-lsb = 0
      }
    }

  fg-contour-bounds : List TtfContour, Integer, Integer, Integer, Integer, Integer, Integer -> GlobalBounds
  fg-contour-bounds (cs) (i) (n) (xn) (yn) (xx) (yx) =
    if i >= n then GlobalBounds { gb-x-min = xn, gb-y-min = yn, gb-x-max = xx, gb-y-max = yx }
    else let pts = (list-at cs i).tc-points
    in let b = fg-point-bounds pts 0 (list-length pts) xn yn xx yx
    in fg-contour-bounds cs (i + 1) n (b.gb-x-min) (b.gb-y-min) (b.gb-x-max) (b.gb-y-max)

  fg-point-bounds : List TtfPoint, Integer, Integer, Integer, Integer, Integer, Integer -> GlobalBounds
  fg-point-bounds (pts) (i) (n) (xn) (yn) (xx) (yx) =
    if i >= n then GlobalBounds { gb-x-min = xn, gb-y-min = yn, gb-x-max = xx, gb-y-max = yx }
    else let p = list-at pts i
    in let nxn = if i == 0 then p.tp-x else if p.tp-x < xn then p.tp-x else xn
    in let nyn = if i == 0 then p.tp-y else if p.tp-y < yn then p.tp-y else yn
    in let nxx = if i == 0 then p.tp-x else if p.tp-x > xx then p.tp-x else xx
    in let nyx = if i == 0 then p.tp-y else if p.tp-y > yx then p.tp-y else yx
    in fg-point-bounds pts (i + 1) n nxn nyn nxx nyx

