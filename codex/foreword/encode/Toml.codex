Chapter: Toml
  cites Foreword chapter Maybe

 We say:

Section: Types

  TomlValue =
    | TomlString (Text)
    | TomlInteger (Integer)
    | TomlBool (Boolean)
    | TomlArray (List TomlValue)
    | TomlTable (List TomlPair)
    | TomlDatetime (Text)

  TomlPair = record {
    tp-key : Text,
    tp-value : TomlValue
  }

Section: Construction

  toml-string : Text -> TomlValue
  toml-string (s) = TomlString s

  toml-integer : Integer -> TomlValue
  toml-integer (n) = TomlInteger n

  toml-bool : Boolean -> TomlValue
  toml-bool (b) = TomlBool b

  toml-table : List TomlPair -> TomlValue
  toml-table (pairs) = TomlTable pairs

  toml-pair : Text, TomlValue -> TomlPair
  toml-pair (k) (v) = TomlPair { tp-key = k, tp-value = v }

  toml-empty : TomlValue
  toml-empty = TomlTable []

Section: Lookup

  toml-get : TomlValue, Text -> Maybe TomlValue
  toml-get (v) (key) = when v
    is TomlTable (pairs) -> toml-find-pair pairs key 0 (list-length pairs)
    is otherwise -> None

  toml-find-pair : List TomlPair, Text, Integer, Integer -> Maybe TomlValue
  toml-find-pair (pairs) (key) (i) (len) =
    if i >= len then None
    else let p = list-at pairs i
    in if p.tp-key == key then Just (p.tp-value)
    else toml-find-pair pairs key (i + 1) len

  toml-get-str : TomlValue, Text, Text -> Text
  toml-get-str (v) (key) (default) =
    when toml-get v key
      is Just (val) -> when val
        is TomlString (s) -> s
        is otherwise -> default
      is None -> default

  toml-get-int : TomlValue, Text, Integer -> Integer
  toml-get-int (v) (key) (default) =
    when toml-get v key
      is Just (val) -> when val
        is TomlInteger (n) -> n
        is otherwise -> default
      is None -> default

  toml-get-bool : TomlValue, Text, Boolean -> Boolean
  toml-get-bool (v) (key) (default) =
    when toml-get v key
      is Just (val) -> when val
        is TomlBool (b) -> b
        is otherwise -> default
      is None -> default

Section: Dotted Path

  toml-get-path : TomlValue, List Text -> Maybe TomlValue
  toml-get-path (v) (keys) = toml-walk v keys 0 (list-length keys)

  toml-walk : TomlValue, List Text, Integer, Integer -> Maybe TomlValue
  toml-walk (v) (keys) (i) (len) =
    if i >= len then Just v
    else when toml-get v (list-at keys i)
      is Just (child) -> toml-walk child keys (i + 1) len
      is None -> None

Section: Parsing

 The TOML subset read here, and everything outside it answers None rather than
 a value it did not read: blank and comment lines; [name] tables with a bare
 name; key = value with a bare key (letters, digits, _ and -); a value that is
 a one-line basic string without escapes, a one-line literal string, true,
 false, or a decimal integer of at most 18 digits, since 19 can exceed the
 64-bit range; a trailing # comment. TOML 1.0 refuses a key or table defined
 twice, and so does this.

  toml-parse : Text -> Maybe TomlValue
  toml-parse (input) =
    let lines = text-split input "\n"
    in toml-parse-lines lines 0 (list-length lines) [] "" [] (toml-slots (list-length lines))

  toml-parse-lines : List Text, Integer, Integer, List TomlPair, Text, List TomlPair, List Text -> Maybe TomlValue
  toml-parse-lines (lines) (i) (len) (top) (tname) (tpairs) (seen) =
    if i >= len then Just (TomlTable (toml-close-table top tname tpairs))
    else let line = toml-trim (list-at lines i)
    in if text-length line == 0 then toml-parse-lines lines (i + 1) len top tname tpairs seen
    else if toml-starts-with line "#" then toml-parse-lines lines (i + 1) len top tname tpairs seen
    else if toml-starts-with line "[" then
      let name = toml-header-name line
      in if text-length name == 0 then None
      else let slot = toml-slot seen ("." & name)
      in if text-length (list-at seen slot) > 0 then None
      else toml-parse-lines lines (i + 1) len (toml-close-table top tname tpairs) name [] (list-set-at seen slot ("." & name))
    else when toml-parse-kv line
      is None -> None
      is Just (kv) ->
        let full = tname & "." & kv.tp-key
        in let slot = toml-slot seen full
        in if text-length (list-at seen slot) > 0 then None
        else if text-length tname == 0 then toml-parse-lines lines (i + 1) len (list-push top kv) tname tpairs (list-set-at seen slot full)
        else toml-parse-lines lines (i + 1) len top tname (list-push tpairs kv) (list-set-at seen slot full)

 The names already defined, as an open-addressing set: a list of at least
 twice as many slots as there are lines, so it never fills, each slot "" or a
 name ("table.key", or ".key" at the top). The hash is masked to 24 bits every
 step, so h * 31 + a character code stays under 2^30 and cannot overflow.

  toml-slots : Integer -> List Text
  toml-slots (n) = toml-fill-slots 0 (toml-capacity n 16) []

  toml-capacity : Integer, Integer -> Integer
  toml-capacity (n) (c) = if c >= 2 * n + 2 then c else toml-capacity n (c * 2)

  toml-fill-slots : Integer, Integer, List Text -> List Text
  toml-fill-slots (i) (cap) (acc) = if i >= cap then acc else toml-fill-slots (i + 1) cap (list-push acc "")

  toml-slot : List Text, Text -> Integer
  toml-slot (slots) (name) =
    let mask = list-length slots - 1
    in toml-probe slots name (bit-and (toml-hash name 0 (text-length name) 5381) mask) mask

  toml-probe : List Text, Text, Integer, Integer -> Integer
  toml-probe (slots) (name) (i) (mask) =
    let s = list-at slots i
    in if text-length s == 0 then i
    else if s == name then i
    else toml-probe slots name (bit-and (i + 1) mask) mask

  toml-hash : Text, Integer, Integer, Integer -> Integer
  toml-hash (s) (i) (n) (h) =
    if i >= n then h
    else toml-hash s (i + 1) n (bit-and (h * 31 + char-code-at s i) 16777215)

  toml-close-table : List TomlPair, Text, List TomlPair -> List TomlPair
  toml-close-table (top) (tname) (tpairs) =
    if text-length tname == 0 then top
    else list-push top (TomlPair { tp-key = tname, tp-value = TomlTable tpairs })

  toml-header-name : Text -> Text
  toml-header-name (line) =
    let close = toml-find-char line (char-code-at "]" 0) 1 (text-length line)
    in if close < 0 then ""
    else if toml-rest-ok line (close + 1) then
      let name = toml-trim (substring line 1 (close - 1))
      in if toml-bare-key name then name else ""
    else ""

  toml-parse-kv : Text -> Maybe TomlPair
  toml-parse-kv (line) =
    let eq-pos = toml-find-char line (char-code-at "=" 0) 0 (text-length line)
    in if eq-pos < 0 then None
    else let key = toml-trim (substring line 0 eq-pos)
    in if toml-bare-key key then
      when toml-parse-value (toml-trim (substring line (eq-pos + 1) (text-length line - eq-pos - 1)))
        is Just (v) -> Just (TomlPair { tp-key = key, tp-value = v })
        is None -> None
    else None

  toml-parse-value : Text -> Maybe TomlValue
  toml-parse-value (s) =
    if toml-starts-with s "\"" then toml-quoted s "\"" True
    else if toml-starts-with s "'" then toml-quoted s "'" False
    else let bare = toml-strip-comment s
    in if bare == "true" then Just (TomlBool True)
    else if bare == "false" then Just (TomlBool False)
    else if toml-decimal bare then Just (TomlInteger (toml-integer-value bare))
    else None

  toml-quoted : Text, Text, Boolean -> Maybe TomlValue
  toml-quoted (s) (quote) (basic) =
    let close = toml-find-char s (char-code-at quote 0) 1 (text-length s)
    in if close < 0 then None
    else let inner = substring s 1 (close - 1)
    in if basic then
      if text-contains inner "\\" then None
      else if toml-rest-ok s (close + 1) then Just (TomlString inner) else None
    else if toml-rest-ok s (close + 1) then Just (TomlString inner) else None

  toml-integer-value : Text -> Integer
  toml-integer-value (s) =
    if toml-starts-with s "+" then text-to-integer (substring s 1 (text-length s - 1))
    else text-to-integer s

Section: Emission

  toml-emit : TomlValue -> Text
  toml-emit (v) = when v
    is TomlTable (pairs) -> text-concat-list (toml-emit-pairs pairs 0 (list-length pairs) [])
    is otherwise -> toml-emit-value v

  toml-emit-pairs : List TomlPair, Integer, Integer, List Text -> List Text
  toml-emit-pairs (pairs) (i) (len) (acc) =
    if i >= len then acc
    else let p = list-at pairs i
    in toml-emit-pairs pairs (i + 1) len (list-push acc (p.tp-key & " = " & toml-emit-value (p.tp-value) & "\n"))

  toml-emit-value : TomlValue -> Text
  toml-emit-value (v) = when v
    is TomlString (s) -> "\"" & s & "\""
    is TomlInteger (n) -> show n
    is TomlBool (b) -> if b then "true" else "false"
    is TomlDatetime (d) -> d
    is TomlArray (items) -> "[" & text-concat-list (toml-emit-array items 0 (list-length items) []) & "]"
    is TomlTable (pairs) -> "{ " & text-concat-list (toml-emit-inline pairs 0 (list-length pairs) []) & " }"

  toml-emit-array : List TomlValue, Integer, Integer, List Text -> List Text
  toml-emit-array (items) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ", "
    in toml-emit-array items (i + 1) len (list-push (list-push acc sep) (toml-emit-value (list-at items i)))

  toml-emit-inline : List TomlPair, Integer, Integer, List Text -> List Text
  toml-emit-inline (pairs) (i) (len) (acc) =
    if i >= len then acc
    else let p = list-at pairs i
    in let sep = if i == 0 then "" else ", "
    in toml-emit-inline pairs (i + 1) len (list-push (list-push acc sep) (p.tp-key & " = " & toml-emit-value (p.tp-value)))

Section: Helpers

  toml-decimal : Text -> Boolean
  toml-decimal (s) =
    let n = text-length s
    in let start = if toml-starts-with s "+" then 1 else if toml-starts-with s "-" then 1 else 0
    in if n - start < 1 then False
    else if n - start > 18 then False
    else if n - start > 1 then
      if char-code-at s start == char-code-at "0" 0 then False else toml-digits s start n
    else toml-digits s start n

  toml-digits : Text, Integer, Integer -> Boolean
  toml-digits (s) (i) (n) =
    if i >= n then True
    else if is-digit (char-at s i) then toml-digits s (i + 1) n
    else False

  toml-bare-key : Text -> Boolean
  toml-bare-key (k) = if text-length k == 0 then False else toml-bare-loop k 0 (text-length k)

  toml-bare-loop : Text, Integer, Integer -> Boolean
  toml-bare-loop (k) (i) (n) =
    if i >= n then True
    else let c = char-code-at k i
    in if is-letter (char-at k i) then toml-bare-loop k (i + 1) n
    else if is-digit (char-at k i) then toml-bare-loop k (i + 1) n
    else if c == char-code-at "_" 0 then toml-bare-loop k (i + 1) n
    else if c == char-code-at "-" 0 then toml-bare-loop k (i + 1) n
    else False

  toml-rest-ok : Text, Integer -> Boolean
  toml-rest-ok (s) (from) =
    let rest = toml-trim (substring s from (text-length s - from))
    in if text-length rest == 0 then True else toml-starts-with rest "#"

  toml-strip-comment : Text -> Text
  toml-strip-comment (s) =
    let hash = toml-find-char s (char-code-at "#" 0) 0 (text-length s)
    in if hash < 0 then s else toml-trim (substring s 0 hash)

  toml-trim : Text -> Text
  toml-trim (s) =
    let n = text-length s
    in let a = toml-first-solid s 0 n
    in let b = toml-last-solid s n
    in if a >= b then "" else substring s a (b - a)

  toml-first-solid : Text, Integer, Integer -> Integer
  toml-first-solid (s) (i) (n) =
    if i >= n then n
    else if char-code-at s i == char-code-at " " 0 then toml-first-solid s (i + 1) n
    else i

  toml-last-solid : Text, Integer -> Integer
  toml-last-solid (s) (j) =
    if j <= 0 then 0
    else if char-code-at s (j - 1) == char-code-at " " 0 then toml-last-solid s (j - 1)
    else j

  toml-starts-with : Text, Text -> Boolean
  toml-starts-with (s) (prefix) = text-starts-with s prefix

  toml-find-char : Text, Integer, Integer, Integer -> Integer
  toml-find-char (s) (target) (i) (len) =
    if i >= len then 0 - 1
    else if char-code (char-at s i) == target then i
    else toml-find-char s target (i + 1) len


