Chapter: GrayCode

 Gray code encoding and decoding. Adjacent values differ by exactly
 one bit. Useful for rotary encoders, error-minimizing ADCs, and
 Karnaugh maps.

 We say:

Section: Conversion
  gray-encode : Integer -> Integer
  gray-encode (n) = bit-xor n (bit-shru n 1)

  gray-decode : Integer -> Integer
  gray-decode (g) = gray-decode-loop g (bit-shru g 1)

  gray-decode-loop : Integer, Integer -> Integer
  gray-decode-loop (n) (mask) =
    if mask == 0 then n
    else gray-decode-loop (bit-xor n mask) (bit-shru mask 1)

Section: Sequences
  gray-sequence : Integer -> List Integer
  gray-sequence (bits) = gray-seq-loop (bit-shl 1 bits) 0 []

  gray-seq-loop : Integer, Integer, List Integer -> List Integer
  gray-seq-loop (limit) (i) (acc) =
    if i >= limit then acc
    else gray-seq-loop limit (i + 1) (list-push acc (gray-encode i))

Section: Properties
  gray-hamming : Integer, Integer -> Integer
  gray-hamming (a) (b) = gray-popcount (bit-xor a b) 0 32

  gray-popcount : Integer, Integer, Integer -> Integer
  gray-popcount (v) (i) (limit) =
    if i >= limit then 0
    else (if bit-and v (bit-shl 1 i) > 0 then 1 else 0) + gray-popcount v (i + 1) limit

  gray-adjacent : Integer, Integer -> Boolean
  gray-adjacent (a) (b) = gray-hamming (gray-encode a) (gray-encode b) == 1

Section: N-ary Gray Codes
  gray-encode-ternary : Integer -> Integer
  gray-encode-ternary (n) =
    let d0 = n - (n / 3) * 3
    in let d1 = (n / 3) - ((n / 3) / 3) * 3
    in let g0 = if (n / 3) - ((n / 3) / 3) * 3 - ((n / 3 - ((n / 3) / 3) * 3) / 2) * 2 == 0 then d0 else 2 - d0
    in g0 + d1 * 3

Section: Reflected Gray Code Matrix
  gray-matrix : Integer -> List (List Integer)
  gray-matrix (bits) = gray-matrix-loop bits 0 (bit-shl 1 bits) []

  gray-matrix-loop : Integer, Integer, Integer, List (List Integer) -> List (List Integer)
  gray-matrix-loop (bits) (i) (limit) (acc) =
    if i >= limit then acc
    else let code = gray-encode i
    in let row = gray-to-bits code bits 0 []
    in gray-matrix-loop bits (i + 1) limit (list-push acc row)

  gray-to-bits : Integer, Integer, Integer, List Integer -> List Integer
  gray-to-bits (code) (bits) (i) (acc) =
    if i >= bits then acc
    else let bit-pos = bits - 1 - i
    in gray-to-bits code bits (i + 1) (list-push acc (if bit-and code (bit-shl 1 bit-pos) > 0 then 1 else 0))

Section: Formatting
  format-gray-binary : Integer, Integer -> Text
  format-gray-binary (code) (bits) = gray-fmt-loop code bits 0 ""

  gray-fmt-loop : Integer, Integer, Integer, Text -> Text
  gray-fmt-loop (code) (bits) (i) (acc) =
    if i >= bits then acc
    else let bit-pos = bits - 1 - i
    in gray-fmt-loop code bits (i + 1) (acc & if bit-and code (bit-shl 1 bit-pos) > 0 then "1" else "0")

