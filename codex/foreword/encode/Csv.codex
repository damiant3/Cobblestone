Chapter: Csv
  cites Foreword chapter CCE

 CSV parsing and generation (RFC 4180). Handles quoted fields with
 embedded commas and escaped quotes. Rows are List Text, tables
 are List (List Text).

 We say:

Section: Parsing
  csv-parse : Text -> List (List Text)
  csv-parse (input) = csv-parse-rows input 0 (text-length input) []

  csv-parse-rows : Text, Integer, Integer, List (List Text) -> List (List Text)
  csv-parse-rows (input) (i) (len) (rows) =
    if i >= len then rows
    else let row-result = csv-parse-row input i len []
    in csv-parse-rows input (row-result.next-pos) len (list-push rows (row-result.fields))

  CsvRowResult = record {
    fields : List Text,
    next-pos : Integer
  }

  csv-parse-row : Text, Integer, Integer, List Text -> CsvRowResult
  csv-parse-row (input) (i) (len) (fields) =
    if i >= len then CsvRowResult { fields = fields, next-pos = len }
    else let ch = char-code (char-at input i)
    in if ch == char-code (char-at "\n" 0) then CsvRowResult { fields = fields, next-pos = i + 1 }
    else if ch == char-code (char-at "\"" 0) then
      let qr = csv-parse-quoted input (i + 1) len ""
      in let fields2 = list-push fields (qr.value)
      in let next = if qr.end-pos < len then
        if char-code (char-at input (qr.end-pos)) == char-code (char-at "," 0) then qr.end-pos + 1 else qr.end-pos
        else qr.end-pos
      in csv-parse-row input next len fields2
    else let ur = csv-parse-unquoted input i len ""
    in let fields2 = list-push fields (ur.value)
    in let next = if ur.end-pos < len then
      if char-code (char-at input (ur.end-pos)) == char-code (char-at "," 0) then ur.end-pos + 1 else ur.end-pos
      else ur.end-pos
    in csv-parse-row input next len fields2

  CsvFieldResult = record { value : Text, end-pos : Integer }

  csv-parse-quoted : Text, Integer, Integer, Text -> CsvFieldResult
  csv-parse-quoted (input) (i) (len) (acc) =
    if i >= len then CsvFieldResult { value = acc, end-pos = len }
    else let ch = char-code (char-at input i)
    in if ch == char-code (char-at "\"" 0) then
      if i + 1 < len then
        if char-code (char-at input (i + 1)) == char-code (char-at "\"" 0) then csv-parse-quoted input (i + 2) len (acc & "\"")
        else CsvFieldResult { value = acc, end-pos = i + 1 }
      else CsvFieldResult { value = acc, end-pos = i + 1 }
    else csv-parse-quoted input (i + 1) len (acc & char-to-text (char-at input i))

  csv-parse-unquoted : Text, Integer, Integer, Text -> CsvFieldResult
  csv-parse-unquoted (input) (i) (len) (acc) =
    if i >= len then CsvFieldResult { value = acc, end-pos = len }
    else let ch = char-code (char-at input i)
    in if ch == char-code (char-at "," 0) then CsvFieldResult { value = acc, end-pos = i }
    else if ch == char-code (char-at "\n" 0) then CsvFieldResult { value = acc, end-pos = i }
    else csv-parse-unquoted input (i + 1) len (acc & char-to-text (char-at input i))

Section: Generation
  csv-emit-row : List Text -> Text
  csv-emit-row (fields) = csv-emit-fields fields 0 (list-length fields) ""

  csv-emit-fields : List Text, Integer, Integer, Text -> Text
  csv-emit-fields (fields) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ","
    in let field = list-at fields i
    in let escaped = if csv-needs-quote field then "\"" & csv-escape-quotes field 0 (text-length field) "" & "\"" else field
    in csv-emit-fields fields (i + 1) len (acc & sep & escaped)

  csv-needs-quote : Text -> Boolean
  csv-needs-quote (s) = csv-needs-quote-loop s 0 (text-length s)

  csv-needs-quote-loop : Text, Integer, Integer -> Boolean
  csv-needs-quote-loop (s) (i) (len) =
    if i >= len then False
    else let ch = char-code (char-at s i)
    in if ch == char-code (char-at "," 0) then True
    else if ch == char-code (char-at "\"" 0) then True
    else if ch == char-code (char-at "\n" 0) then True
    else csv-needs-quote-loop s (i + 1) len

  csv-escape-quotes : Text, Integer, Integer, Text -> Text
  csv-escape-quotes (s) (i) (len) (acc) =
    if i >= len then acc
    else let ch = char-code (char-at s i)
    in if ch == char-code (char-at "\"" 0) then csv-escape-quotes s (i + 1) len (acc & "\"\"")
    else csv-escape-quotes s (i + 1) len (acc & char-to-text (char-at s i))

  csv-emit-table : List (List Text) -> Text
  csv-emit-table (rows) = csv-emit-table-loop rows 0 (list-length rows) ""

  csv-emit-table-loop : List (List Text), Integer, Integer, Text -> Text
  csv-emit-table-loop (rows) (i) (len) (acc) =
    if i >= len then acc
    else csv-emit-table-loop rows (i + 1) len (acc & csv-emit-row (list-at rows i) & "\n")

