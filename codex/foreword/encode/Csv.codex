Chapter: Csv
  cites Foreword chapter Maybe

 We say:

Section: Parsing
  csv-parse : Text -> List (List Text)
  csv-parse (input) = csv-parse-rows input 0 (text-length input) []

  csv-parse-rows : Text, Integer, Integer, List (List Text) -> List (List Text)
  csv-parse-rows (input) (i) (len) (rows) =
    if i >= len then rows
    else let row-result = csv-parse-row input i len [] False
    in csv-parse-rows input (row-result.next-pos) len (list-push rows (row-result.fields))

  CsvRowResult = record {
    fields : List Text,
    next-pos : Integer
  }

 A record is a field followed by any number of comma-and-field pairs,
 so a separator is always followed by a field and that field may be
 empty. A record ending in a comma therefore has an empty last field,
 and a record that is nothing but a comma has two of them.

  csv-close-row : List Text, Boolean -> List Text
  csv-close-row (fields) (after-sep) =
    if after-sep then list-push fields "" else fields

  csv-parse-row : Text, Integer, Integer, List Text, Boolean -> CsvRowResult
  csv-parse-row (input) (i) (len) (fields) (after-sep) =
    if i >= len then CsvRowResult { fields = csv-close-row fields after-sep, next-pos = len }
    else let ch = char-code (char-at input i)
    in if ch == char-code (char-at "\n" 0) then CsvRowResult { fields = csv-close-row fields after-sep, next-pos = i + 1 }
    else if ch == char-code (char-at "\"" 0) then
      let qr = csv-parse-quoted input (i + 1) (i + 1) len []
      in let fields2 = list-push fields (qr.value)
      in let saw-comma = csv-at-comma input (qr.end-pos) len
      in let next = if saw-comma then qr.end-pos + 1 else qr.end-pos
      in csv-parse-row input next len fields2 saw-comma
    else let ur = csv-parse-unquoted input i i len
    in let fields2 = list-push fields (ur.value)
    in let saw-comma = csv-at-comma input (ur.end-pos) len
    in let next = if saw-comma then ur.end-pos + 1 else ur.end-pos
    in csv-parse-row input next len fields2 saw-comma

  csv-at-comma : Text, Integer, Integer -> Boolean
  csv-at-comma (input) (pos) (len) =
    if pos >= len then False
    else char-code (char-at input pos) == char-code (char-at "," 0)

  CsvFieldResult = record { value : Text, end-pos : Integer }

  csv-parse-quoted : Text, Integer, Integer, Integer, List Text -> CsvFieldResult
  csv-parse-quoted (input) (start) (i) (len) (runs) =
    if i >= len then CsvFieldResult { value = text-concat-list (list-push runs (substring input start (len - start))), end-pos = len }
    else if char-code (char-at input i) /= char-code (char-at "\"" 0) then csv-parse-quoted input start (i + 1) len runs
    else if i + 1 < len & char-code (char-at input (i + 1)) == char-code (char-at "\"" 0) then
      csv-parse-quoted input (i + 2) (i + 2) len (list-push runs (substring input start (i + 1 - start)))
    else CsvFieldResult { value = text-concat-list (list-push runs (substring input start (i - start))), end-pos = i + 1 }

  csv-parse-unquoted : Text, Integer, Integer, Integer -> CsvFieldResult
  csv-parse-unquoted (input) (start) (i) (len) =
    if i >= len then CsvFieldResult { value = substring input start (len - start), end-pos = len }
    else let ch = char-code (char-at input i)
    in if ch == char-code (char-at "," 0) | ch == char-code (char-at "\n" 0) then CsvFieldResult { value = substring input start (i - start), end-pos = i }
    else csv-parse-unquoted input start (i + 1) len

Section: Well-Formedness

 RFC 4180 section 2, as one pass over four states: 0 at the start of a field,
 1 inside an unquoted field, 2 inside a quoted one, 3 just after a closing
 quote. A quote may open a field and nothing else may contain one; a doubled
 quote inside quotes is one quote; a closing quote must be followed by a
 comma, a newline or the end; the text may not end inside quotes. csv-parse
 answers something for every input, so a caller taking text from outside asks
 csv-parse-checked, which parses only what is well formed.

  csv-parse-checked : Text -> Maybe (List (List Text))
  csv-parse-checked (input) =
    if csv-well-formed input then Just (csv-parse input) else None

  csv-well-formed : Text -> Boolean
  csv-well-formed (input) = csv-wf input 0 (text-length input) 0

  csv-wf : Text, Integer, Integer, Integer -> Boolean
  csv-wf (s) (i) (n) (state) =
    if i >= n then state /= 2
    else let ch = char-code (char-at s i)
    in let quote = ch == char-code (char-at "\"" 0)
    in let sep = ch == char-code (char-at "," 0) | ch == char-code (char-at "\n" 0)
    in if state == 2 then
      if quote then
        if i + 1 < n & char-code (char-at s (i + 1)) == char-code (char-at "\"" 0) then csv-wf s (i + 2) n 2
        else csv-wf s (i + 1) n 3
      else csv-wf s (i + 1) n 2
    else if state == 3 then
      if sep then csv-wf s (i + 1) n 0 else False
    else if quote then
      if state == 0 then csv-wf s (i + 1) n 2 else False
    else if sep then csv-wf s (i + 1) n 0
    else csv-wf s (i + 1) n 1
Section: Generation
  csv-emit-row : List Text -> Text
  csv-emit-row (fields) = text-concat-list (csv-emit-fields fields 0 (list-length fields) [])

  csv-emit-fields : List Text, Integer, Integer, List Text -> List Text
  csv-emit-fields (fields) (i) (len) (acc) =
    if i >= len then acc
    else let field = list-at fields i
    in let with-sep = if i == 0 then acc else list-push acc ","
    in let pieces = if csv-needs-quote field then list-push (csv-escape-quotes field 0 0 (text-length field) (list-push with-sep "\"")) "\"" else list-push with-sep field
    in csv-emit-fields fields (i + 1) len pieces

  csv-needs-quote : Text -> Boolean
  csv-needs-quote (s) = csv-needs-quote-loop s 0 (text-length s)

  csv-needs-quote-loop : Text, Integer, Integer -> Boolean
  csv-needs-quote-loop (s) (i) (len) =
    if i >= len then False
    else let ch = char-code (char-at s i)
    in if ch == char-code (char-at "," 0) then True
    else if ch == char-code (char-at "\"" 0) then True
    else if ch == char-code (char-at "\n" 0) then True
    else csv-needs-quote-loop s (i + 1) len

  csv-escape-quotes : Text, Integer, Integer, Integer, List Text -> List Text
  csv-escape-quotes (s) (start) (i) (len) (acc) =
    if i >= len then list-push acc (substring s start (len - start))
    else if char-code (char-at s i) == char-code (char-at "\"" 0) then
      csv-escape-quotes s (i + 1) (i + 1) len (list-push (list-push acc (substring s start (i - start))) "\"\"")
    else csv-escape-quotes s start (i + 1) len acc

  csv-emit-table : List (List Text) -> Text
  csv-emit-table (rows) = text-concat-list (csv-emit-table-loop rows 0 (list-length rows) [])

  csv-emit-table-loop : List (List Text), Integer, Integer, List Text -> List Text
  csv-emit-table-loop (rows) (i) (len) (acc) =
    if i >= len then acc
    else csv-emit-table-loop rows (i + 1) len (list-push (csv-emit-fields (list-at rows i) 0 (list-length (list-at rows i)) acc) "\n")

