Chapter: Hex
  cites Foreword chapter CCE

 Hexadecimal encoding and decoding. Converts between List Integer
 (byte arrays) and hex text strings. Uses show for decimal digit
 values to avoid CCE/Unicode hex-char issues on bare metal.

 We say:

Section: Encoding
  hex-encode : List Integer -> Text
  hex-encode (bs) = hex-encode-loop bs 0 (list-length bs) ""

  hex-encode-loop : List Integer, Integer, Integer, Text -> Text
  hex-encode-loop (bs) (i) (len) (acc) =
    if i >= len then acc
    else let b = list-at bs i
    in hex-encode-loop bs (i + 1) len (acc & hex-byte b)

  hex-byte : Integer -> Text
  hex-byte (b) = hex-nibble (bit-shru b 4) & hex-nibble (bit-and b 15)

  hex-nibble : Integer -> Text
  hex-nibble (n) =
    if n == 0 then "0" else if n == 1 then "1" else if n == 2 then "2"
    else if n == 3 then "3" else if n == 4 then "4" else if n == 5 then "5"
    else if n == 6 then "6" else if n == 7 then "7" else if n == 8 then "8"
    else if n == 9 then "9" else if n == 10 then "a" else if n == 11 then "b"
    else if n == 12 then "c" else if n == 13 then "d" else if n == 14 then "e"
    else "f"

  hex-nibble-upper : Integer -> Text
  hex-nibble-upper (n) =
    if n == 0 then "0" else if n == 1 then "1" else if n == 2 then "2"
    else if n == 3 then "3" else if n == 4 then "4" else if n == 5 then "5"
    else if n == 6 then "6" else if n == 7 then "7" else if n == 8 then "8"
    else if n == 9 then "9" else if n == 10 then "A" else if n == 11 then "B"
    else if n == 12 then "C" else if n == 13 then "D" else if n == 14 then "E"
    else "F"

  hex-encode-upper : List Integer -> Text
  hex-encode-upper (bs) = hex-encode-upper-loop bs 0 (list-length bs) ""

  hex-encode-upper-loop : List Integer, Integer, Integer, Text -> Text
  hex-encode-upper-loop (bs) (i) (len) (acc) =
    if i >= len then acc
    else let b = list-at bs i
    in hex-encode-upper-loop bs (i + 1) len (acc & hex-nibble-upper (bit-shru b 4) & hex-nibble-upper (bit-and b 15))

Section: Decoding
  hex-decode : Text -> List Integer
  hex-decode (s) = hex-decode-loop s 0 (text-length s) []

  hex-decode-loop : Text, Integer, Integer, List Integer -> List Integer
  hex-decode-loop (s) (i) (len) (acc) =
    if i + 1 >= len then acc
    else let hi = hex-char-value (char-code (char-at s i))
    in let lo = hex-char-value (char-code (char-at s (i + 1)))
    in hex-decode-loop s (i + 2) len (list-push acc (bit-or (bit-shl hi 4) lo))

  hex-char-value : Integer -> Integer
  hex-char-value (c) =
    if c == char-code (char-at "0" 0) then 0
    else if c == char-code (char-at "1" 0) then 1
    else if c == char-code (char-at "2" 0) then 2
    else if c == char-code (char-at "3" 0) then 3
    else if c == char-code (char-at "4" 0) then 4
    else if c == char-code (char-at "5" 0) then 5
    else if c == char-code (char-at "6" 0) then 6
    else if c == char-code (char-at "7" 0) then 7
    else if c == char-code (char-at "8" 0) then 8
    else if c == char-code (char-at "9" 0) then 9
    else if c == char-code (char-at "a" 0) then 10
    else if c == char-code (char-at "b" 0) then 11
    else if c == char-code (char-at "c" 0) then 12
    else if c == char-code (char-at "d" 0) then 13
    else if c == char-code (char-at "e" 0) then 14
    else if c == char-code (char-at "f" 0) then 15
    else if c == char-code (char-at "A" 0) then 10
    else if c == char-code (char-at "B" 0) then 11
    else if c == char-code (char-at "C" 0) then 12
    else if c == char-code (char-at "D" 0) then 13
    else if c == char-code (char-at "E" 0) then 14
    else if c == char-code (char-at "F" 0) then 15
    else 0

Section: Formatting
  hex-dump : List Integer, Integer -> Text
  hex-dump (bs) (bytes-per-line) = hex-dump-loop bs 0 (list-length bs) bytes-per-line ""

  hex-dump-loop : List Integer, Integer, Integer, Integer, Text -> Text
  hex-dump-loop (bs) (i) (len) (per-line) (acc) =
    if i >= len then acc
    else let sep = if i > 0 then (if i / per-line * per-line == i then "\n" else " ") else ""
    in hex-dump-loop bs (i + 1) len per-line (acc & sep & hex-byte (list-at bs i))

  hex-int32 : Integer -> Text
  hex-int32 (v) =
    hex-byte (bit-and (bit-shru v 24) 255) & hex-byte (bit-and (bit-shru v 16) 255) & hex-byte (bit-and (bit-shru v 8) 255) & hex-byte (bit-and v 255)

  hex-int16 : Integer -> Text
  hex-int16 (v) = hex-byte (bit-and (bit-shru v 8) 255) & hex-byte (bit-and v 255)

