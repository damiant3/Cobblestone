Chapter: MessagePack
  cites Foreword chapter Maybe

 MessagePack binary serialization — compact schema-less format
 that encodes integers, strings, binary, arrays, maps, booleans,
 and nil in a self-describing byte stream. More compact than JSON,
 faster to parse than CBOR. Used for RPC, caching, and config.

 To msgpack-encode gives a byte list from a MsgPackValue.
 To msgpack-decode gives a Maybe MsgPackValue from a byte list.

 We say:

Section: Types

  MsgPackValue =
    | MpNil
    | MpBool (Boolean)
    | MpInt (Integer)
    | MpStr (Text)
    | MpBin (List Integer)
    | MpArray (List MsgPackValue)
    | MpMap (List MpMapEntry)

  MpMapEntry = record {
    mpe-key : MsgPackValue,
    mpe-value : MsgPackValue
  }

  MpDecodeResult = record {
    mpr-value : MsgPackValue,
    mpr-offset : Integer
  }

Section: Encoding

  msgpack-encode : MsgPackValue -> List Integer
  msgpack-encode (v) = when v
    is MpNil -> [192]
    is MpBool (b) -> [if b then 195 else 194]
    is MpInt (n) -> mp-encode-int n
    is MpStr (s) -> mp-encode-str s
    is MpBin (bs) -> mp-encode-bin bs
    is MpArray (items) -> mp-encode-array items
    is MpMap (entries) -> mp-encode-map entries

  mp-encode-int : Integer -> List Integer
  mp-encode-int (n) =
    if n >= 0 then mp-encode-uint n
    else if n >= (0 - 32) then [bit-and (n + 256) 255]
    else if n >= (0 - 128) then [208, bit-and (n + 256) 255]
    else if n >= (0 - 32768) then [209, bit-and (bit-shru (n + 65536) 8) 255, bit-and (n + 65536) 255]
    else [210, bit-and (bit-shru n 24) 255, bit-and (bit-shru n 16) 255, bit-and (bit-shru n 8) 255, bit-and n 255]

  mp-encode-uint : Integer -> List Integer
  mp-encode-uint (n) =
    if n < 128 then [n]
    else if n < 256 then [204, n]
    else if n < 65536 then [205, bit-shru n 8, bit-and n 255]
    else [206, bit-and (bit-shru n 24) 255, bit-and (bit-shru n 16) 255, bit-and (bit-shru n 8) 255, bit-and n 255]

  mp-encode-str : Text -> List Integer
  mp-encode-str (s) =
    let bytes = mp-text-to-bytes s 0 (text-length s) []
    in let len = list-length bytes
    in if len < 32 then [bit-or 160 len] & bytes
    else if len < 256 then [217, len] & bytes
    else [218, bit-shru len 8, bit-and len 255] & bytes

  mp-encode-bin : List Integer -> List Integer
  mp-encode-bin (bs) =
    let len = list-length bs
    in if len < 256 then [196, len] & bs
    else [197, bit-shru len 8, bit-and len 255] & bs

  mp-encode-array : List MsgPackValue -> List Integer
  mp-encode-array (items) =
    let len = list-length items
    in let header = if len < 16 then [bit-or 144 len]
      else if len < 65536 then [220, bit-shru len 8, bit-and len 255]
      else [221, bit-and (bit-shru len 24) 255, bit-and (bit-shru len 16) 255, bit-and (bit-shru len 8) 255, bit-and len 255]
    in header & mp-encode-list items 0 len []

  mp-encode-list : List MsgPackValue, Integer, Integer, List Integer -> List Integer
  mp-encode-list (items) (i) (len) (acc) =
    if i >= len then acc
    else mp-encode-list items (i + 1) len (acc & msgpack-encode (list-at items i))

  mp-encode-map : List MpMapEntry -> List Integer
  mp-encode-map (entries) =
    let len = list-length entries
    in let header = if len < 16 then [bit-or 128 len]
      else [222, bit-shru len 8, bit-and len 255]
    in header & mp-encode-entries entries 0 len []

  mp-encode-entries : List MpMapEntry, Integer, Integer, List Integer -> List Integer
  mp-encode-entries (entries) (i) (len) (acc) =
    if i >= len then acc
    else let e = list-at entries i
    in mp-encode-entries entries (i + 1) len (acc & msgpack-encode (e.mpe-key) & msgpack-encode (e.mpe-value))

Section: Decoding

  msgpack-decode : List Integer -> Maybe MsgPackValue
  msgpack-decode (bs) =
    if list-length bs == 0 then None
    else let r = mp-decode-at bs 0
    in Just (r.mpr-value)

  mp-decode-at : List Integer, Integer -> MpDecodeResult
  mp-decode-at (bs) (off) =
    let b = list-at bs off
    in if b == 192 then MpDecodeResult { mpr-value = MpNil, mpr-offset = off + 1 }
    else if b == 194 then MpDecodeResult { mpr-value = MpBool False, mpr-offset = off + 1 }
    else if b == 195 then MpDecodeResult { mpr-value = MpBool True, mpr-offset = off + 1 }
    else if b < 128 then MpDecodeResult { mpr-value = MpInt b, mpr-offset = off + 1 }
    else if b >= 224 then MpDecodeResult { mpr-value = MpInt (b - 256), mpr-offset = off + 1 }
    else if b == 204 then MpDecodeResult { mpr-value = MpInt (list-at bs (off + 1)), mpr-offset = off + 2 }
    else if b == 205 then MpDecodeResult { mpr-value = MpInt (bit-or (bit-shl (list-at bs (off + 1)) 8) (list-at bs (off + 2))), mpr-offset = off + 3 }
    else if b == 206 then MpDecodeResult { mpr-value = MpInt (bit-or (bit-or (bit-shl (list-at bs (off + 1)) 24) (bit-shl (list-at bs (off + 2)) 16)) (bit-or (bit-shl (list-at bs (off + 3)) 8) (list-at bs (off + 4)))), mpr-offset = off + 5 }
    else if b == 208 then MpDecodeResult { mpr-value = MpInt (list-at bs (off + 1) - 256), mpr-offset = off + 2 }
    else if b == 209 then MpDecodeResult { mpr-value = MpInt (bit-or (bit-shl (list-at bs (off + 1)) 8) (list-at bs (off + 2)) - 65536), mpr-offset = off + 3 }
    else if b == 210 then MpDecodeResult { mpr-value = MpInt (bit-or (bit-or (bit-shl (list-at bs (off + 1)) 24) (bit-shl (list-at bs (off + 2)) 16)) (bit-or (bit-shl (list-at bs (off + 3)) 8) (list-at bs (off + 4)))), mpr-offset = off + 5 }
    else if b == 196 then mp-decode-bin8 bs off
    else if b == 197 then mp-decode-bin16 bs off
    else if bit-and b 224 == 160 then mp-decode-fixstr bs off (bit-and b 31)
    else if b == 217 then mp-decode-str8 bs off
    else if b == 218 then mp-decode-str16 bs off
    else if bit-and b 240 == 144 then mp-decode-fixarray bs off (bit-and b 15)
    else if b == 220 then mp-decode-array16 bs off
    else if b == 221 then mp-decode-array32 bs off
    else if bit-and b 240 == 128 then mp-decode-fixmap bs off (bit-and b 15)
    else if b == 222 then mp-decode-map16 bs off
    else MpDecodeResult { mpr-value = MpNil, mpr-offset = off + 1 }

  mp-decode-fixstr : List Integer, Integer, Integer -> MpDecodeResult
  mp-decode-fixstr (bs) (off) (len) =
    let bytes = mp-slice bs (off + 1) len 0 []
    in let s = mp-bytes-to-text bytes 0 len ""
    in MpDecodeResult { mpr-value = MpStr s, mpr-offset = off + 1 + len }

  mp-decode-str8 : List Integer, Integer -> MpDecodeResult
  mp-decode-str8 (bs) (off) =
    let len = list-at bs (off + 1)
    in let bytes = mp-slice bs (off + 2) len 0 []
    in let s = mp-bytes-to-text bytes 0 len ""
    in MpDecodeResult { mpr-value = MpStr s, mpr-offset = off + 2 + len }

  mp-decode-fixarray : List Integer, Integer, Integer -> MpDecodeResult
  mp-decode-fixarray (bs) (off) (count) =
    mp-decode-array-loop bs (off + 1) count 0 []

  mp-decode-array16 : List Integer, Integer -> MpDecodeResult
  mp-decode-array16 (bs) (off) =
    let count = bit-or (bit-shl (list-at bs (off + 1)) 8) (list-at bs (off + 2))
    in mp-decode-array-loop bs (off + 3) count 0 []

  mp-decode-array-loop : List Integer, Integer, Integer, Integer, List MsgPackValue -> MpDecodeResult
  mp-decode-array-loop (bs) (off) (count) (i) (acc) =
    if i >= count then MpDecodeResult { mpr-value = MpArray acc, mpr-offset = off }
    else let r = mp-decode-at bs off
    in mp-decode-array-loop bs (r.mpr-offset) count (i + 1) (list-push acc (r.mpr-value))

  mp-decode-fixmap : List Integer, Integer, Integer -> MpDecodeResult
  mp-decode-fixmap (bs) (off) (count) =
    mp-decode-map-loop bs (off + 1) count 0 []

  mp-decode-map-loop : List Integer, Integer, Integer, Integer, List MpMapEntry -> MpDecodeResult
  mp-decode-map-loop (bs) (off) (count) (i) (acc) =
    if i >= count then MpDecodeResult { mpr-value = MpMap acc, mpr-offset = off }
    else let kr = mp-decode-at bs off
    in let vr = mp-decode-at bs (kr.mpr-offset)
    in mp-decode-map-loop bs (vr.mpr-offset) count (i + 1) (list-push acc (MpMapEntry { mpe-key = kr.mpr-value, mpe-value = vr.mpr-value }))

  mp-decode-bin8 : List Integer, Integer -> MpDecodeResult
  mp-decode-bin8 (bs) (off) =
    let len = list-at bs (off + 1)
    in let data = mp-slice bs (off + 2) len 0 []
    in MpDecodeResult { mpr-value = MpBin data, mpr-offset = off + 2 + len }

  mp-decode-bin16 : List Integer, Integer -> MpDecodeResult
  mp-decode-bin16 (bs) (off) =
    let len = bit-or (bit-shl (list-at bs (off + 1)) 8) (list-at bs (off + 2))
    in let data = mp-slice bs (off + 3) len 0 []
    in MpDecodeResult { mpr-value = MpBin data, mpr-offset = off + 3 + len }

  mp-decode-str16 : List Integer, Integer -> MpDecodeResult
  mp-decode-str16 (bs) (off) =
    let len = bit-or (bit-shl (list-at bs (off + 1)) 8) (list-at bs (off + 2))
    in let bytes = mp-slice bs (off + 3) len 0 []
    in let s = mp-bytes-to-text bytes 0 len ""
    in MpDecodeResult { mpr-value = MpStr s, mpr-offset = off + 3 + len }

  mp-decode-array32 : List Integer, Integer -> MpDecodeResult
  mp-decode-array32 (bs) (off) =
    let count = bit-or (bit-or (bit-shl (list-at bs (off + 1)) 24) (bit-shl (list-at bs (off + 2)) 16)) (bit-or (bit-shl (list-at bs (off + 3)) 8) (list-at bs (off + 4)))
    in mp-decode-array-loop bs (off + 5) count 0 []

  mp-decode-map16 : List Integer, Integer -> MpDecodeResult
  mp-decode-map16 (bs) (off) =
    let count = bit-or (bit-shl (list-at bs (off + 1)) 8) (list-at bs (off + 2))
    in mp-decode-map-loop bs (off + 3) count 0 []

Section: Helpers

  mp-text-to-bytes : Text, Integer, Integer, List Integer -> List Integer
  mp-text-to-bytes (s) (i) (len) (acc) =
    if i >= len then acc
    else mp-text-to-bytes s (i + 1) len (list-push acc (char-code (char-at s i)))

  mp-bytes-to-text : List Integer, Integer, Integer, Text -> Text
  mp-bytes-to-text (bs) (i) (len) (acc) =
    if i >= len then acc
    else mp-bytes-to-text bs (i + 1) len (acc & char-to-text (code-to-char (list-at bs i)))

  mp-slice : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  mp-slice (bs) (off) (len) (i) (acc) =
    if i >= len then acc
    else mp-slice bs off len (i + 1) (list-push acc (list-at bs (off + i)))

