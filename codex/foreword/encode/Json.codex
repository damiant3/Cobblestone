Chapter: Json
  cites Foreword chapter Maybe
  cites Foreword chapter CCE

 Minimal JSON value representation, emitter, and parser.
 Supports null, booleans, integers, strings, arrays, and objects.
 Objects are lists of key-value pairs (preserves insertion order).

 We say:

Section: Value Type
  JsonValue =
    | JsonNull
    | JsonBool (Boolean)
    | JsonInt (Integer)
    | JsonNum (JsonNumber)
    | JsonStr (Text)
    | JsonArray (List JsonValue)
    | JsonObject (List JsonPair)

 A JsonNumber is the exact decimal mantissa / 10 ^ decimals. JSON has one
 number type and no binary floating point, so carrying the digits as they
 were written is what round-trips: 2.000 stays 2.000 and does not become 2.

  JsonNumber = record {
    jn-mantissa : Integer,
    jn-decimals : Integer
  }

  JsonPair = record {
    key : Text,
    value : JsonValue
  }

Section: Constructors
  json-null : JsonValue = JsonNull

  json-bool : Boolean -> JsonValue
  json-bool (b) = JsonBool b

  json-int : Integer -> JsonValue
  json-int (n) = JsonInt n

 18 is the most decimal places a 64-bit mantissa can carry, so it is the
 cap on both the scale and the exponent everywhere in this chapter.

  json-max-decimals : Integer = 18

  json-num : Integer, Integer -> JsonValue
  json-num (mantissa) (decimals) =
    let d = if decimals < 0 then 0 else if decimals > json-max-decimals then json-max-decimals else decimals
    in JsonNum (JsonNumber { jn-mantissa = mantissa, jn-decimals = d })

  json-pow10 : Integer -> Integer
  json-pow10 (k) = if k <= 0 then 1 else 10 * json-pow10 (k - 1)

  json-num-to-int : JsonNumber -> Integer
  json-num-to-int (n) =
    if n.jn-decimals <= 0 then n.jn-mantissa
    else n.jn-mantissa / json-pow10 (n.jn-decimals)

  json-str : Text -> JsonValue
  json-str (s) = JsonStr s

  json-array : List JsonValue -> JsonValue
  json-array (items) = JsonArray items

  json-object : List JsonPair -> JsonValue
  json-object (pairs) = JsonObject pairs

  json-pair : Text, JsonValue -> JsonPair
  json-pair (k) (v) = JsonPair { key = k, value = v }

Section: Emitter
  json-emit : JsonValue -> Text
  json-emit (v) = when v
    is JsonNull -> "null"
    is JsonBool (b) -> if b then "true" else "false"
    is JsonInt (n) -> show n
    is JsonNum (n) -> json-emit-num n
    is JsonStr (s) -> json-quote s
    is JsonArray (items) -> "[" & json-emit-array items 0 (list-length items) "" & "]"
    is JsonObject (pairs) -> "{" & json-emit-object pairs 0 (list-length pairs) "" & "}"

  json-emit-num : JsonNumber -> Text
  json-emit-num (n) =
    if n.jn-decimals <= 0 then show (n.jn-mantissa)
    else let neg = n.jn-mantissa < 0
    in let m = if neg then 0 - n.jn-mantissa else n.jn-mantissa
    in let p = json-pow10 (n.jn-decimals)
    in let whole = m / p
    in let frac = m - whole * p
    in let sign = if neg then "-" else ""
    in sign & show whole & "." & json-zero-pad (show frac) (n.jn-decimals)

  json-zero-pad : Text, Integer -> Text
  json-zero-pad (t) (width) =
    if text-length t >= width then t
    else json-zero-pad ("0" & t) width

  json-quote : Text -> Text
  json-quote (s) = "\"" & json-escape s 0 (text-length s) "" & "\""

  json-escape : Text, Integer, Integer, Text -> Text
  json-escape (s) (i) (len) (acc) =
    if i >= len then acc
    else let c = char-code (char-at s i)
    in let u = to-unicode c
    in if u == 34 then json-escape s (i + 1) len (acc & "\\\"")
    else if u == 92 then json-escape s (i + 1) len (acc & "\\\\")
    else if u == 10 then json-escape s (i + 1) len (acc & "\\n")
    else if u == 13 then json-escape s (i + 1) len (acc & "\\r")
    else if u == 9 then json-escape s (i + 1) len (acc & "\\t")
    else json-escape s (i + 1) len (acc & char-to-text (char-at s i))

  json-emit-array : List JsonValue, Integer, Integer, Text -> Text
  json-emit-array (items) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ","
    in json-emit-array items (i + 1) len (acc & sep & json-emit (list-at items i))

  json-emit-object : List JsonPair, Integer, Integer, Text -> Text
  json-emit-object (pairs) (i) (len) (acc) =
    if i >= len then acc
    else let sep = if i == 0 then "" else ","
    in let p = list-at pairs i
    in json-emit-object pairs (i + 1) len (acc & sep & json-quote (p.key) & ":" & json-emit (p.value))

Section: Object Access
  json-get : JsonValue, Text -> Maybe JsonValue
  json-get (v) (key) = when v
    is JsonObject (pairs) -> json-find-key pairs key 0 (list-length pairs)
    is otherwise -> None

  json-find-key : List JsonPair, Text, Integer, Integer -> Maybe JsonValue
  json-find-key (pairs) (key) (i) (len) =
    if i >= len then None
    else let p = list-at pairs i
    in if p.key == key then Just (p.value)
    else json-find-key pairs key (i + 1) len

  json-get-str : JsonValue, Text, Text -> Text
  json-get-str (v) (key) (default-val) =
    let found = json-get v key
    in when found
      is Just (jv) -> when jv
        is JsonStr (s) -> s
        is otherwise -> default-val
      is None -> default-val

  json-get-int : JsonValue, Text, Integer -> Integer
  json-get-int (v) (key) (default-val) =
    let found = json-get v key
    in when found
      is Just (jv) -> when jv
        is JsonInt (n) -> n
        is JsonNum (n) -> json-num-to-int n
        is otherwise -> default-val
      is None -> default-val

 A caller asking for a number wants the number. Letting JsonNum fall to the
 catch-all would answer the default for a field that was present and
 numeric, which is the reading that hides a malformed document.

  json-get-num : JsonValue, Text -> Maybe JsonNumber
  json-get-num (v) (key) =
    let found = json-get v key
    in when found
      is Just (jv) -> when jv
        is JsonNum (n) -> Just n
        is JsonInt (i) -> Just (JsonNumber { jn-mantissa = i, jn-decimals = 0 })
        is otherwise -> None
      is None -> None

  json-get-bool : JsonValue, Text, Boolean -> Boolean
  json-get-bool (v) (key) (default-val) =
    let found = json-get v key
    in when found
      is Just (jv) -> when jv
        is JsonBool (b) -> b
        is otherwise -> default-val
      is None -> default-val

Section: Array Access
  json-array-length : JsonValue -> Integer
  json-array-length (v) = when v
    is JsonArray (items) -> list-length items
    is otherwise -> 0

  json-array-at : JsonValue, Integer -> Maybe JsonValue
  json-array-at (v) (i) = when v
    is JsonArray (items) ->
      if i < 0 then None
      else if i >= list-length items then None
      else Just (list-at items i)
    is otherwise -> None

Section: Parser

 Recursive-descent JSON parser. Total: malformed input yields
 None, never crashes the caller. Handles null, booleans, integer
 numbers, double-quoted strings with the standard escapes
 (\" \\ \/ \b \f \n \r \t \uXXXX), arrays, and objects.
 Whitespace tolerant per RFC 8259.

  JsonParseResult = record {
    value : JsonValue,
    next : Integer,
    ok : Boolean
  }

  parse-fail : Integer -> JsonParseResult
  parse-fail (at) = JsonParseResult { value = JsonNull, next = at, ok = False }

  parse-ok : JsonValue, Integer -> JsonParseResult
  parse-ok (v) (next) = JsonParseResult { value = v, next = next, ok = True }

  json-parse : Text -> Maybe JsonValue
  json-parse (s) =
    let r = json-parse-value s 0 (text-length s)
    in if r.ok then Just (r.value) else None

Section: Whitespace and Codepoints

 All character comparisons go through to-unicode so the parser
 is correct on the CCE-internal source. The JSON syntax tokens
 are all ASCII, where CCE and Unicode agree, but using
 to-unicode keeps the convention consistent with json-escape.

  cp-at : Text, Integer -> Integer
  cp-at (s) (i) = to-unicode (char-code (char-at s i))

  is-ws : Integer -> Boolean
  is-ws (cp) =
    if cp == 32 then True
    else if cp == 9 then True
    else if cp == 10 then True
    else if cp == 13 then True
    else False

  skip-ws : Text, Integer, Integer -> Integer
  skip-ws (s) (i) (len) =
    if i >= len then i
    else if is-ws (cp-at s i) then skip-ws s (i + 1) len
    else i

  json-is-digit : Integer -> Boolean
  json-is-digit (cp) = if cp >= 48 then if cp <= 57 then True else False else False

  json-is-hex-digit : Integer -> Boolean
  json-is-hex-digit (cp) =
    if json-is-digit cp then True
    else if cp >= 65 then if cp <= 70 then True
      else if cp >= 97 then if cp <= 102 then True else False
      else False
    else if cp >= 97 then if cp <= 102 then True else False
    else False

  json-hex-digit-value : Integer -> Integer
  json-hex-digit-value (cp) =
    if json-is-digit cp then cp - 48
    else if cp >= 97 then cp - 87
    else cp - 55

Section: Value Dispatch

  json-parse-value : Text, Integer, Integer -> JsonParseResult
  json-parse-value (s) (i) (len) =
    let p = skip-ws s i len
    in if p >= len then parse-fail p
    else dispatch-on-first s p len (cp-at s p)

  dispatch-on-first : Text, Integer, Integer, Integer -> JsonParseResult
  dispatch-on-first (s) (i) (len) (cp) =
    if cp == 110 then json-parse-null s i len
    else if cp == 116 then json-parse-true s i len
    else if cp == 102 then json-parse-false s i len
    else if cp == 34 then json-parse-string-value s i len
    else if cp == 91 then json-parse-array s i len
    else if cp == 123 then json-parse-object s i len
    else if cp == 45 then json-parse-number s i len
    else if json-is-digit cp then json-parse-number s i len
    else parse-fail i

Section: Literal Keywords

  match-keyword : Text, Integer, Integer, Text -> Boolean
  match-keyword (s) (i) (len) (kw) =
    let kn = text-length kw
    in if i + kn > len then False
    else substring s i kn == kw

  json-parse-null : Text, Integer, Integer -> JsonParseResult
  json-parse-null (s) (i) (len) =
    if match-keyword s i len "null" then parse-ok JsonNull (i + 4)
    else parse-fail i

  json-parse-true : Text, Integer, Integer -> JsonParseResult
  json-parse-true (s) (i) (len) =
    if match-keyword s i len "true" then parse-ok (JsonBool True) (i + 4)
    else parse-fail i

  json-parse-false : Text, Integer, Integer -> JsonParseResult
  json-parse-false (s) (i) (len) =
    if match-keyword s i len "false" then parse-ok (JsonBool False) (i + 5)
    else parse-fail i

Section: Numbers

 RFC 8259 section 6: minus? int frac? exp?, where frac and exp each
 require at least one digit after their marker. A number whose decimal
 places all cancel against its exponent is an integer and is answered as
 JsonInt, so 1e3 reads as 1000 and a document of plain integers parses
 exactly as it did before this chapter grew a decimal.

 Both the decimal places and the exponent are bounded by
 json-max-decimals. Digits past that bound are consumed and dropped
 rather than overflowing the mantissa; an exponent past it is refused
 rather than silently truncated, because a wrong magnitude is a worse
 answer than no answer.

  JsonNumScan = record {
    jns-mantissa : Integer,
    jns-decimals : Integer,
    jns-next : Integer,
    jns-ok : Boolean
  }

  json-scan-fail : Integer -> JsonNumScan
  json-scan-fail (at) = JsonNumScan { jns-mantissa = 0, jns-decimals = 0, jns-next = at, jns-ok = False }

  json-scan-ok : Integer, Integer, Integer -> JsonNumScan
  json-scan-ok (m) (d) (next) = JsonNumScan { jns-mantissa = m, jns-decimals = d, jns-next = next, jns-ok = True }

  json-parse-number : Text, Integer, Integer -> JsonParseResult
  json-parse-number (s) (i) (len) =
    let neg = is-minus s i len
    in let start = if neg then i + 1 else i
    in let int-stop = scan-digits s start len
    in if int-stop == start then parse-fail i
    else let whole = digits-to-int s start int-stop False 0
    in json-number-after-int s i len neg whole int-stop

  json-number-after-int : Text, Integer, Integer, Boolean, Integer, Integer -> JsonParseResult
  json-number-after-int (s) (i) (len) (neg) (whole) (at) =
    let fr = json-scan-frac s at len whole
    in if fr.jns-ok == False then parse-fail i
    else json-number-after-frac s i len neg fr

  json-number-after-frac : Text, Integer, Integer, Boolean, JsonNumScan -> JsonParseResult
  json-number-after-frac (s) (i) (len) (neg) (fr) =
    let ex = json-scan-exp s (fr.jns-next) len
    in if ex.jns-ok == False then parse-fail i
    else json-number-result (fr.jns-mantissa) (fr.jns-decimals - ex.jns-mantissa) neg (ex.jns-next)

  json-number-result : Integer, Integer, Boolean, Integer -> JsonParseResult
  json-number-result (mantissa) (decimals) (neg) (next) =
    let m = if neg then 0 - mantissa else mantissa
    in if decimals > 0 then parse-ok (json-num m decimals) next
    else if decimals == 0 then parse-ok (JsonInt m) next
    else if 0 - decimals > json-max-decimals then parse-fail next
    else parse-ok (JsonInt (m * json-pow10 (0 - decimals))) next

  json-scan-frac : Text, Integer, Integer, Integer -> JsonNumScan
  json-scan-frac (s) (i) (len) (whole) =
    if i >= len then json-scan-ok whole 0 i
    else if cp-at s i == 46 then json-scan-frac-digits s (i + 1) len whole 0
    else json-scan-ok whole 0 i

  json-scan-frac-digits : Text, Integer, Integer, Integer, Integer -> JsonNumScan
  json-scan-frac-digits (s) (i) (len) (acc) (count) =
    if i >= len then json-frac-end i acc count
    else if json-is-digit (cp-at s i) == False then json-frac-end i acc count
    else if count >= json-max-decimals then json-scan-frac-digits s (i + 1) len acc count
    else json-scan-frac-digits s (i + 1) len (acc * 10 + (cp-at s i - 48)) (count + 1)

  json-frac-end : Integer, Integer, Integer -> JsonNumScan
  json-frac-end (i) (acc) (count) =
    if count == 0 then json-scan-fail i
    else json-scan-ok acc count i

  json-scan-exp : Text, Integer, Integer -> JsonNumScan
  json-scan-exp (s) (i) (len) =
    if i >= len then json-scan-ok 0 0 i
    else if json-is-exp-marker (cp-at s i) then json-scan-exp-sign s (i + 1) len
    else json-scan-ok 0 0 i

  json-is-exp-marker : Integer -> Boolean
  json-is-exp-marker (cp) = if cp == 101 then True else if cp == 69 then True else False

  json-scan-exp-sign : Text, Integer, Integer -> JsonNumScan
  json-scan-exp-sign (s) (i) (len) =
    if i >= len then json-scan-fail i
    else if cp-at s i == 43 then json-scan-exp-digits s (i + 1) len False
    else if cp-at s i == 45 then json-scan-exp-digits s (i + 1) len True
    else json-scan-exp-digits s i len False

  json-scan-exp-digits : Text, Integer, Integer, Boolean -> JsonNumScan
  json-scan-exp-digits (s) (i) (len) (neg) =
    let stop = scan-digits s i len
    in if stop == i then json-scan-fail i
    else let v = digits-to-int s i stop False 0
    in if v > json-max-decimals then json-scan-fail i
    else let signed = if neg then 0 - v else v
    in json-scan-ok signed 0 stop

  is-minus : Text, Integer, Integer -> Boolean
  is-minus (s) (i) (len) =
    if i >= len then False
    else cp-at s i == 45

  scan-digits : Text, Integer, Integer -> Integer
  scan-digits (s) (i) (len) =
    if i >= len then i
    else if json-is-digit (cp-at s i) then scan-digits s (i + 1) len
    else i

  digits-to-int : Text, Integer, Integer, Boolean, Integer -> Integer
  digits-to-int (s) (i) (stop) (neg) (acc) =
    if i >= stop then if neg then 0 - acc else acc
    else digits-to-int s (i + 1) stop neg (acc * 10 + (cp-at s i - 48))

Section: Strings

 Double-quoted, with the standard JSON escapes. \uXXXX yields
 the codepoint converted back to CCE via from-unicode.

  json-parse-string-value : Text, Integer, Integer -> JsonParseResult
  json-parse-string-value (s) (i) (len) =
    let r = read-string-body s (i + 1) len ""
    in if r.ok then parse-ok (JsonStr (r.value-text)) (r.next)
    else parse-fail i

  StringReadResult = record {
    value-text : Text,
    next : Integer,
    ok : Boolean
  }

  string-fail : Integer -> StringReadResult
  string-fail (at) = StringReadResult { value-text = "", next = at, ok = False }

  string-ok : Text, Integer -> StringReadResult
  string-ok (t) (n) = StringReadResult { value-text = t, next = n, ok = True }

  read-string-body : Text, Integer, Integer, Text -> StringReadResult
  read-string-body (s) (i) (len) (acc) =
    if i >= len then string-fail i
    else read-string-step s i len acc (cp-at s i)

  read-string-step : Text, Integer, Integer, Text, Integer -> StringReadResult
  read-string-step (s) (i) (len) (acc) (cp) =
    if cp == 34 then string-ok acc (i + 1)
    else if cp == 92 then read-string-escape s (i + 1) len acc
    else read-string-body s (i + 1) len (acc & char-to-text (char-at s i))

  read-string-escape : Text, Integer, Integer, Text -> StringReadResult
  read-string-escape (s) (i) (len) (acc) =
    if i >= len then string-fail i
    else apply-escape s i len acc (cp-at s i)

  apply-escape : Text, Integer, Integer, Text, Integer -> StringReadResult
  apply-escape (s) (i) (len) (acc) (cp) =
    if cp == 34 then read-string-body s (i + 1) len (acc & "\"")
    else if cp == 92 then read-string-body s (i + 1) len (acc & "\\")
    else if cp == 47 then read-string-body s (i + 1) len (acc & "/")
    else if cp == 98 then read-string-body s (i + 1) len (acc & char-to-text (code-to-char (from-unicode 8)))
    else if cp == 102 then read-string-body s (i + 1) len (acc & char-to-text (code-to-char (from-unicode 12)))
    else if cp == 110 then read-string-body s (i + 1) len (acc & "\n")
    else if cp == 114 then read-string-body s (i + 1) len (acc & char-to-text (code-to-char (from-unicode 13)))
    else if cp == 116 then read-string-body s (i + 1) len (acc & char-to-text (code-to-char (from-unicode 9)))
    else if cp == 117 then read-unicode-escape s (i + 1) len acc
    else string-fail i

  read-unicode-escape : Text, Integer, Integer, Text -> StringReadResult
  read-unicode-escape (s) (i) (len) (acc) =
    if i + 4 > len then string-fail i
    else if four-hex-digits s i then
      let cp = unicode-from-hex-quad s i
      in read-string-body s (i + 4) len (acc & char-to-text (code-to-char (from-unicode cp)))
    else string-fail i

  four-hex-digits : Text, Integer -> Boolean
  four-hex-digits (s) (i) =
    if json-is-hex-digit (cp-at s i) == False then False
    else if json-is-hex-digit (cp-at s (i + 1)) == False then False
    else if json-is-hex-digit (cp-at s (i + 2)) == False then False
    else if json-is-hex-digit (cp-at s (i + 3)) == False then False
    else True

  unicode-from-hex-quad : Text, Integer -> Integer
  unicode-from-hex-quad (s) (i) =
    json-hex-digit-value (cp-at s i) * 4096
    + json-hex-digit-value (cp-at s (i + 1)) * 256
    + json-hex-digit-value (cp-at s (i + 2)) * 16
    + json-hex-digit-value (cp-at s (i + 3))

Section: Arrays

  json-parse-array : Text, Integer, Integer -> JsonParseResult
  json-parse-array (s) (i) (len) =
    let p = skip-ws s (i + 1) len
    in if p >= len then parse-fail i
    else if cp-at s p == 93 then parse-ok (JsonArray []) (p + 1)
    else read-array-items s p len []

  read-array-items : Text, Integer, Integer, List JsonValue -> JsonParseResult
  read-array-items (s) (i) (len) (acc) =
    let r = json-parse-value s i len
    in if r.ok == False then parse-fail i
    else array-after-item s (skip-ws s (r.next) len) len (list-snoc acc (r.value))

  array-after-item : Text, Integer, Integer, List JsonValue -> JsonParseResult
  array-after-item (s) (i) (len) (acc) =
    if i >= len then parse-fail i
    else if cp-at s i == 93 then parse-ok (JsonArray acc) (i + 1)
    else if cp-at s i == 44 then read-array-items s (skip-ws s (i + 1) len) len acc
    else parse-fail i

Section: Objects

  json-parse-object : Text, Integer, Integer -> JsonParseResult
  json-parse-object (s) (i) (len) =
    let p = skip-ws s (i + 1) len
    in if p >= len then parse-fail i
    else if cp-at s p == 125 then parse-ok (JsonObject []) (p + 1)
    else read-object-pairs s p len []

  read-object-pairs : Text, Integer, Integer, List JsonPair -> JsonParseResult
  read-object-pairs (s) (i) (len) (acc) =
    if i >= len then parse-fail i
    else if cp-at s i == 34 then read-object-key-value s i len acc
    else parse-fail i

  read-object-key-value : Text, Integer, Integer, List JsonPair -> JsonParseResult
  read-object-key-value (s) (i) (len) (acc) =
    let kr = read-string-body s (i + 1) len ""
    in if kr.ok == False then parse-fail i
    else expect-colon-then-value s (skip-ws s (kr.next) len) len acc (kr.value-text)

  expect-colon-then-value : Text, Integer, Integer, List JsonPair, Text -> JsonParseResult
  expect-colon-then-value (s) (i) (len) (acc) (key) =
    if i >= len then parse-fail i
    else if cp-at s i == 58 then read-object-value s (skip-ws s (i + 1) len) len acc key
    else parse-fail i

  read-object-value : Text, Integer, Integer, List JsonPair, Text -> JsonParseResult
  read-object-value (s) (i) (len) (acc) (key) =
    let r = json-parse-value s i len
    in if r.ok == False then parse-fail i
    else object-after-value s (skip-ws s (r.next) len) len (list-snoc acc (json-pair key (r.value)))

  object-after-value : Text, Integer, Integer, List JsonPair -> JsonParseResult
  object-after-value (s) (i) (len) (acc) =
    if i >= len then parse-fail i
    else if cp-at s i == 125 then parse-ok (JsonObject acc) (i + 1)
    else if cp-at s i == 44 then read-object-pairs s (skip-ws s (i + 1) len) len acc
    else parse-fail i

Page 1
