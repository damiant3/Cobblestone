Chapter: Jwt
  cites Foreword chapter Maybe
  cites Encode chapter Base64
  cites Encode chapter Json

 JSON Web Token decoder (RFC 7519). Splits a JWT into its three
 dot-separated segments, base64url-decodes header and payload,
 and parses claims from the JSON. V1 validates structure, expiry,
 issuer, and audience. Cryptographic signature verification against
 provider JWKS is deferred to V2.

Section: Types

  JwtHeader = record {
    jh-alg : Text,
    jh-typ : Text,
    jh-kid : Text
  }

  JwtPayload = record {
    jp-iss : Text,
    jp-sub : Text,
    jp-aud : Text,
    jp-exp : Integer,
    jp-iat : Integer,
    jp-nonce : Text,
    jp-email : Text,
    jp-name : Text
  }

  JwtToken = record {
    jt-header : JwtHeader,
    jt-payload : JwtPayload,
    jt-signature : Text,
    jt-raw : Text
  }

  JwtError =
    | JwtOk (JwtToken)
    | JwtMalformed (Text)

Section: Decoding

  jwt-decode : Text -> JwtError
  jwt-decode (raw) =
    let parts = text-split raw "."
    in if list-length parts /= 3 then JwtMalformed "expected 3 dot-separated segments"
    else let header-json = b64url-decode-text (list-at parts 0)
    in let payload-json = b64url-decode-text (list-at parts 1)
    in jwt-assemble raw (list-at parts 2) (json-parse header-json) (json-parse payload-json)

  jwt-assemble : Text, Text, Maybe JsonValue, Maybe JsonValue -> JwtError
  jwt-assemble (raw) (sig) (hp) (pp) =
    when hp
      is None -> JwtMalformed "header segment is not JSON"
      is Just (hv) -> jwt-assemble-payload raw sig hv pp

  jwt-assemble-payload : Text, Text, JsonValue, Maybe JsonValue -> JwtError
  jwt-assemble-payload (raw) (sig) (hv) (pp) =
    when pp
      is None -> JwtMalformed "payload segment is not JSON"
      is Just (pv) -> JwtOk (JwtToken {
        jt-header = jwt-header-of hv,
        jt-payload = jwt-payload-of pv,
        jt-signature = sig,
        jt-raw = raw
      })

  jwt-header-of : JsonValue -> JwtHeader
  jwt-header-of (v) = JwtHeader {
    jh-alg = json-get-str v "alg" "",
    jh-typ = json-get-str v "typ" "",
    jh-kid = json-get-str v "kid" ""
  }

  jwt-payload-of : JsonValue -> JwtPayload
  jwt-payload-of (v) = JwtPayload {
    jp-iss = json-get-str v "iss" "",
    jp-sub = json-get-str v "sub" "",
    jp-aud = json-get-str v "aud" "",
    jp-exp = json-get-int v "exp" 0,
    jp-iat = json-get-int v "iat" 0,
    jp-nonce = json-get-str v "nonce" "",
    jp-email = json-get-str v "email" "",
    jp-name = json-get-str v "name" ""
  }

Section: Validation

  jwt-validate-claims : JwtToken, Text, Text, Integer -> Boolean
  jwt-validate-claims (token) (expected-issuer) (expected-audience) (now-epoch) =
    let p = token.jt-payload
    in jwt-check-issuer p expected-issuer
    & jwt-check-audience p expected-audience
    & jwt-check-expiry p now-epoch

  jwt-check-issuer : JwtPayload, Text -> Boolean
  jwt-check-issuer (p) (expected) =
    if text-length expected == 0 then True
    else p.jp-iss == expected

  jwt-check-audience : JwtPayload, Text -> Boolean
  jwt-check-audience (p) (expected) =
    if text-length expected == 0 then True
    else p.jp-aud == expected

  jwt-check-expiry : JwtPayload, Integer -> Boolean
  jwt-check-expiry (p) (now) =
    if p.jp-exp == 0 then True
    else p.jp-exp > now

Section: Claim Accessors

  jwt-get-email : JwtToken -> Text
  jwt-get-email (t) = (t.jt-payload).jp-email

  jwt-get-sub : JwtToken -> Text
  jwt-get-sub (t) = (t.jt-payload).jp-sub

  jwt-get-name : JwtToken -> Text
  jwt-get-name (t) = (t.jt-payload).jp-name

  jwt-get-issuer : JwtToken -> Text
  jwt-get-issuer (t) = (t.jt-payload).jp-iss

  jwt-is-expired : JwtToken, Integer -> Boolean
  jwt-is-expired (t) (now) = (t.jt-payload).jp-exp > 0 & (t.jt-payload).jp-exp <= now

Section: Base64url

  b64url-decode-text : Text -> Text
  b64url-decode-text (s) = base64-decode-text (b64url-pad (b64url-to-std s))

 The four numbers below are CCE code points and not ASCII, and they
 are right: 73 is the hyphen, 76 the plus, 85 the underscore, 81 the
 solidus. They read like a transposition of the ASCII values and were
 suspected on that basis; measuring them cleared the substitution and
 left the boundary conversion above as the only defect here.

  b64url-to-std : Text -> Text
  b64url-to-std (s) = b64url-replace s 0 (text-length s) ""

  b64url-replace : Text, Integer, Integer, Text -> Text
  b64url-replace (s) (i) (n) (acc) =
    if i >= n then acc
    else let c = char-code-at s i
    in let replaced = if c == 73 then char-to-text (code-to-char 76)
      else if c == 85 then char-to-text (code-to-char 81)
      else char-to-text (code-to-char c)
    in b64url-replace s (i + 1) n (acc & replaced)

  b64url-pad : Text -> Text
  b64url-pad (s) =
    let rem = text-length s - (text-length s / 4) * 4
    in if rem == 0 then s
    else if rem == 2 then s & "=="
    else if rem == 3 then s & "="
    else s

Section: Formatting

  format-jwt-header : JwtHeader -> Text
  format-jwt-header (h) = "alg=" & h.jh-alg & " typ=" & h.jh-typ

  format-jwt-payload : JwtPayload -> Text
  format-jwt-payload (p) =
    "iss=" & p.jp-iss & " sub=" & p.jp-sub & " email=" & p.jp-email & " exp=" & show (p.jp-exp)

