Chapter: Jwt
  cites Foreword chapter Maybe
  cites Foreword chapter CCE
  cites Encode chapter Json

Section: Types

  JwtHeader = record {
    jh-alg : Text,
    jh-typ : Text,
    jh-kid : Text
  }

  JwtPayload = record {
    jp-iss : Text,
    jp-sub : Text,
    jp-aud : Text,
    jp-exp : Integer,
    jp-iat : Integer,
    jp-nonce : Text,
    jp-email : Text,
    jp-name : Text
  }

  JwtToken = record {
    jt-header : JwtHeader,
    jt-payload : JwtPayload,
    jt-signature : Text,
    jt-raw : Text
  }

  JwtError =
    | JwtOk (JwtToken)
    | JwtMalformed (Text)

Section: Decoding

  jwt-decode : Text -> JwtError
  jwt-decode (raw) =
    let parts = text-split raw "."
    in if list-length parts /= 3 then JwtMalformed "expected 3 dot-separated segments"
    else if b64url-valid (list-at parts 2) == False then JwtMalformed "signature segment is not base64url"
    else jwt-segments raw (list-at parts 2) (b64url-decode-utf8 (list-at parts 0)) (b64url-decode-utf8 (list-at parts 1))

  jwt-segments : Text, Text, Maybe Text, Maybe Text -> JwtError
  jwt-segments (raw) (sig) (h) (p) =
    when h
      is None -> JwtMalformed "header segment is not base64url UTF-8"
      is Just (hj) -> jwt-segment-payload raw sig hj p

  jwt-segment-payload : Text, Text, Text, Maybe Text -> JwtError
  jwt-segment-payload (raw) (sig) (hj) (p) =
    when p
      is None -> JwtMalformed "payload segment is not base64url UTF-8"
      is Just (pj) -> jwt-assemble raw sig (json-parse hj) (json-parse pj)

  jwt-assemble : Text, Text, Maybe JsonValue, Maybe JsonValue -> JwtError
  jwt-assemble (raw) (sig) (hp) (pp) =
    when hp
      is None -> JwtMalformed "header segment is not JSON"
      is Just (hv) -> jwt-assemble-payload raw sig hv pp

  jwt-assemble-payload : Text, Text, JsonValue, Maybe JsonValue -> JwtError
  jwt-assemble-payload (raw) (sig) (hv) (pp) =
    when pp
      is None -> JwtMalformed "payload segment is not JSON"
      is Just (pv) -> JwtOk (JwtToken {
        jt-header = jwt-header-of hv,
        jt-payload = jwt-payload-of pv,
        jt-signature = sig,
        jt-raw = raw
      })

  jwt-header-of : JsonValue -> JwtHeader
  jwt-header-of (v) = JwtHeader {
    jh-alg = json-get-str v "alg" "",
    jh-typ = json-get-str v "typ" "",
    jh-kid = json-get-str v "kid" ""
  }

  jwt-payload-of : JsonValue -> JwtPayload
  jwt-payload-of (v) = JwtPayload {
    jp-iss = json-get-str v "iss" "",
    jp-sub = json-get-str v "sub" "",
    jp-aud = json-get-str v "aud" "",
    jp-exp = json-get-int v "exp" 0,
    jp-iat = json-get-int v "iat" 0,
    jp-nonce = json-get-str v "nonce" "",
    jp-email = json-get-str v "email" "",
    jp-name = json-get-str v "name" ""
  }

Section: Validation

  jwt-validate-claims : JwtToken, Text, Text, Integer -> Boolean
  jwt-validate-claims (token) (expected-issuer) (expected-audience) (now-epoch) =
    let p = token.jt-payload
    in jwt-check-issuer p expected-issuer
    & jwt-check-audience p expected-audience
    & jwt-check-expiry p now-epoch

  jwt-check-issuer : JwtPayload, Text -> Boolean
  jwt-check-issuer (p) (expected) =
    if text-length expected == 0 then True
    else p.jp-iss == expected

  jwt-check-audience : JwtPayload, Text -> Boolean
  jwt-check-audience (p) (expected) =
    if text-length expected == 0 then True
    else p.jp-aud == expected

  jwt-check-expiry : JwtPayload, Integer -> Boolean
  jwt-check-expiry (p) (now) =
    if p.jp-exp == 0 then True
    else p.jp-exp > now

Section: Claim Accessors

  jwt-get-email : JwtToken -> Text
  jwt-get-email (t) = (t.jt-payload).jp-email

  jwt-get-sub : JwtToken -> Text
  jwt-get-sub (t) = (t.jt-payload).jp-sub

  jwt-get-name : JwtToken -> Text
  jwt-get-name (t) = (t.jt-payload).jp-name

  jwt-get-issuer : JwtToken -> Text
  jwt-get-issuer (t) = (t.jt-payload).jp-iss

  jwt-is-expired : JwtToken, Integer -> Boolean
  jwt-is-expired (t) (now) = (t.jt-payload).jp-exp > 0 & (t.jt-payload).jp-exp <= now

Section: Base64url

 RFC 7515 section 2 and appendix C: a segment is base64url (RFC 4648
 section 5, "-" and "_" for 62 and 63) with the padding omitted, so "=" is
 refused and a length of 1 modulo 4 cannot occur. RFC 7519 section 7.2: the
 header and payload are UTF-8, and RFC 3629 section 3 forbids overlong
 forms. A character CCE cannot hold is refused rather than dropped, which
 covers surrogates and code points above U+10FFFF, except JSON whitespace
 (RFC 8259 section 2: tab, LF, CR, space), which carries no value outside a
 string.

  b64url-decode-utf8 : Text -> Maybe Text
  b64url-decode-utf8 (s) =
    if b64url-valid s == False then None
    else let bytes = b64url-loop s 0 (text-length s) []
    in if jwt-utf8-ok bytes 0 (list-length bytes) then Just (utf8-bytes-to-text bytes) else None

  jwt-utf8-ok : List Integer, Integer, Integer -> Boolean
  jwt-utf8-ok (bytes) (i) (n) =
    if i >= n then True
    else let len = utf8-decode-length (list-at bytes i)
    in let u = utf8-code-point-at bytes i
    in if len == 0 | u < 0 then False
    else if len == 2 & u < 128 then False
    else if len == 3 & u < 2048 then False
    else if len == 4 & u < 65536 then False
    else if from-unicode u < 0 & u /= 9 & u /= 10 & u /= 13 & u /= 32 then False
    else jwt-utf8-ok bytes (i + len) n

  b64url-valid : Text -> Boolean
  b64url-valid (s) =
    let n = text-length s
    in if n - n / 4 * 4 == 1 then False
    else b64url-valid-loop s 0 n

  b64url-valid-loop : Text, Integer, Integer -> Boolean
  b64url-valid-loop (s) (i) (n) =
    if i >= n then True
    else if b64url-value (to-unicode (char-code (char-at s i))) < 0 then False
    else b64url-valid-loop s (i + 1) n

  b64url-value : Integer -> Integer
  b64url-value (c) =
    if c >= 65 & c <= 90 then c - 65
    else if c >= 97 & c <= 122 then c - 71
    else if c >= 48 & c <= 57 then c + 4
    else if c == 45 then 62
    else if c == 95 then 63
    else 0 - 1

  b64url-at : Text, Integer -> Integer
  b64url-at (s) (i) = b64url-value (to-unicode (char-code (char-at s i)))

  b64url-loop : Text, Integer, Integer, List Integer -> List Integer
  b64url-loop (s) (i) (n) (acc) =
    if i >= n then acc
    else let v1 = b64url-at s (i + 1)
    in let a1 = list-push acc (bit-and (bit-or (bit-shl (b64url-at s i) 2) (bit-shru v1 4)) 255)
    in if i + 2 >= n then a1
    else let v2 = b64url-at s (i + 2)
    in let a2 = list-push a1 (bit-and (bit-or (bit-shl v1 4) (bit-shru v2 2)) 255)
    in if i + 3 >= n then a2
    else b64url-loop s (i + 4) n (list-push a2 (bit-and (bit-or (bit-shl v2 6) (b64url-at s (i + 3))) 255))

Section: Formatting

  format-jwt-header : JwtHeader -> Text
  format-jwt-header (h) = "alg=" & h.jh-alg & " typ=" & h.jh-typ

  format-jwt-payload : JwtPayload -> Text
  format-jwt-payload (p) =
    "iss=" & p.jp-iss & " sub=" & p.jp-sub & " email=" & p.jp-email & " exp=" & show (p.jp-exp)

