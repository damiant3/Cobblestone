Chapter: Uri
  cites Foreword chapter Maybe
  cites Foreword chapter CCE
  cites Foreword chapter StringUtils

 The RFC 3986 subset read here; outside it uri-parse answers valid = False
 rather than components it did not read. A hierarchical URI is
 scheme "://" authority path ["?" query] ["#" fragment], where the scheme is
 ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ) (section 3.1), the authority ends
 at the first "/", "?" or "#" (section 3.2), and the authority is a reg-name
 host of unreserved characters and pct-encoded octets with an optional port of
 at most 65535. Userinfo and IP literals are outside the subset: splitting
 "a:b@c" at the first colon names host "a" where the RFC names "c", which is
 the shape of every URL-confusion attack. A relative reference whose first
 segment holds a colon is refused, as section 4.2 requires, and so is a
 non-hierarchical URI such as mailto:. A space is never part of a URI.

 We say:

Section: Components
  UriComponents = record {
    scheme : Text,
    host : Text,
    port : Integer,
    path : Text,
    query : Text,
    fragment : Text,
    valid : Boolean
  }

Section: Parsing
  uri-parse : Text -> UriComponents
  uri-parse (s) =
    let len = text-length s
    in if text-contains s " " then uri-invalid
    else let delim = min (uri-find-char s 0 len (char-code-at "/" 0)) (min (uri-find-char s 0 len (char-code-at "?" 0)) (uri-find-char s 0 len (char-code-at "#" 0)))
    in let colon = uri-find-char s 0 delim (char-code-at ":" 0)
    in if colon >= delim then uri-parse-relative s len
    else if uri-slash-slash s (colon + 1) len then
      if uri-scheme-ok s 0 colon then uri-parse-authority s (colon + 3) len (substring s 0 colon)
      else uri-invalid
    else uri-invalid

  uri-invalid : UriComponents
  uri-invalid = UriComponents { scheme = "", host = "", port = 0, path = "", query = "", fragment = "", valid = False }

  uri-slash-slash : Text, Integer, Integer -> Boolean
  uri-slash-slash (s) (i) (len) =
    if i + 1 >= len then False
    else if char-code-at s i == char-code-at "/" 0 then char-code-at s (i + 1) == char-code-at "/" 0
    else False

  uri-parse-relative : Text, Integer -> UriComponents
  uri-parse-relative (s) (len) =
    let hash = uri-find-char s 0 len (char-code-at "#" 0)
    in let qm = uri-find-char s 0 hash (char-code-at "?" 0)
    in UriComponents {
      scheme = "", host = "", port = 0,
      path = substring s 0 qm,
      query = if qm < hash then substring s (qm + 1) (hash - qm - 1) else "",
      fragment = if hash < len then substring s (hash + 1) (len - hash - 1) else "",
      valid = True
    }

  uri-parse-authority : Text, Integer, Integer, Text -> UriComponents
  uri-parse-authority (s) (start) (len) (scheme) =
    let hash = uri-find-char s start len (char-code-at "#" 0)
    in let qm = uri-find-char s start hash (char-code-at "?" 0)
    in let path-start = uri-find-char s start qm (char-code-at "/" 0)
    in let authority = substring s start (path-start - start)
    in let alen = text-length authority
    in let colon = uri-find-char authority 0 alen (char-code-at ":" 0)
    in let host = substring authority 0 colon
    in let port = if colon + 1 >= alen then uri-default-port scheme else uri-port authority (colon + 1) alen 0
    in if uri-host-ok host scheme then
      if port < 0 then uri-invalid
      else UriComponents {
        scheme = scheme, host = host, port = port,
        path = if path-start < qm then substring s path-start (qm - path-start) else "/",
        query = if qm < hash then substring s (qm + 1) (hash - qm - 1) else "",
        fragment = if hash < len then substring s (hash + 1) (len - hash - 1) else "",
        valid = True
      }
    else uri-invalid

  uri-port : Text, Integer, Integer, Integer -> Integer
  uri-port (a) (i) (n) (acc) =
    if i >= n then acc
    else let d = uri-digit-value (char-code-at a i)
    in if d < 0 then 0 - 1
    else if acc * 10 + d > 65535 then 0 - 1
    else uri-port a (i + 1) n (acc * 10 + d)

  uri-scheme-ok : Text, Integer, Integer -> Boolean
  uri-scheme-ok (s) (i) (n) =
    if n == 0 then False
    else if is-letter (char-at s 0) then uri-scheme-rest s 1 n
    else False

  uri-scheme-rest : Text, Integer, Integer -> Boolean
  uri-scheme-rest (s) (i) (n) =
    if i >= n then True
    else let c = char-code-at s i
    in if is-letter (char-at s i) then uri-scheme-rest s (i + 1) n
    else if is-digit (char-at s i) then uri-scheme-rest s (i + 1) n
    else if c == char-code-at "+" 0 then uri-scheme-rest s (i + 1) n
    else if c == char-code-at "-" 0 then uri-scheme-rest s (i + 1) n
    else if c == char-code-at "." 0 then uri-scheme-rest s (i + 1) n
    else False

  uri-host-ok : Text, Text -> Boolean
  uri-host-ok (h) (scheme) =
    if text-length h == 0 then scheme == "file"
    else uri-host-chars h 0 (text-length h)

  uri-host-chars : Text, Integer, Integer -> Boolean
  uri-host-chars (h) (i) (n) =
    if i >= n then True
    else let c = char-code-at h i
    in if is-letter (char-at h i) then uri-host-chars h (i + 1) n
    else if is-digit (char-at h i) then uri-host-chars h (i + 1) n
    else if c == char-code-at "-" 0 then uri-host-chars h (i + 1) n
    else if c == char-code-at "." 0 then uri-host-chars h (i + 1) n
    else if c == char-code-at "_" 0 then uri-host-chars h (i + 1) n
    else if c == char-code-at "~" 0 then uri-host-chars h (i + 1) n
    else if c == char-code-at "%" 0 then uri-host-chars h (i + 1) n
    else False

  uri-default-port : Text -> Integer
  uri-default-port (scheme) =
    if scheme == "http" then 80
    else if scheme == "https" then 443
    else if scheme == "ftp" then 21
    else 0

Section: String Helpers
  uri-find-char : Text, Integer, Integer, Integer -> Integer
  uri-find-char (s) (i) (len) (target) =
    if i >= len then len
    else if char-code (char-at s i) == target then i
    else uri-find-char s (i + 1) len target

  uri-digit-value : Integer -> Integer
  uri-digit-value (c) =
    if c == char-code (char-at "0" 0) then 0
    else if c == char-code (char-at "1" 0) then 1
    else if c == char-code (char-at "2" 0) then 2
    else if c == char-code (char-at "3" 0) then 3
    else if c == char-code (char-at "4" 0) then 4
    else if c == char-code (char-at "5" 0) then 5
    else if c == char-code (char-at "6" 0) then 6
    else if c == char-code (char-at "7" 0) then 7
    else if c == char-code (char-at "8" 0) then 8
    else if c == char-code (char-at "9" 0) then 9
    else 0 - 1

Section: Construction
  uri-build : Text, Text, Integer, Text -> Text
  uri-build (scheme) (host) (port) (path) =
    let authority = if port == uri-default-port scheme then host
      else if port == 0 then host
      else host & ":" & show port
    in scheme & "://" & authority & path

Section: Query String Parsing
  QueryParam = record {
    param-key : Text,
    param-value : Text
  }

  uri-parse-query : Text -> List QueryParam
  uri-parse-query (q) =
    let parts = text-split q "&"
    in uri-query-parts parts 0 (list-length parts) []

  uri-query-parts : List Text, Integer, Integer, List QueryParam -> List QueryParam
  uri-query-parts (parts) (i) (n) (acc) =
    if i >= n then acc
    else let p = list-at parts i
    in let plen = text-length p
    in let eq = uri-find-char p 0 plen (char-code-at "=" 0)
    in if eq == 0 then uri-query-parts parts (i + 1) n acc
    else if plen == 0 then uri-query-parts parts (i + 1) n acc
    else let val = if eq < plen then substring p (eq + 1) (plen - eq - 1) else ""
    in uri-query-parts parts (i + 1) n (list-push acc (QueryParam { param-key = substring p 0 eq, param-value = val }))

Section: Percent Encoding

 The encoding is over OCTETS, not characters, and that is the whole
 subtlety. RFC 3986 percent-encodes bytes, and a non-ASCII character is
 several of them, so encoding per character emits one escape where the
 standard wants two or three and no server decodes it back.

 **`text-to-unicode-bytes` does not give octets.** The name reads as
 though it does; it answers one integer per character, that integer
 being the Unicode CODE POINT. Written against the name, this encoder
 turned U+00E9 into `%E9` -- a single byte, and not a legal UTF-8
 sequence at all. The right answer is `%C3%A9`, and the only reason
 that was noticed is that `codex/test/uri-encode` was written to check
 it rather than to check the ASCII cases everyone gets right.

 So the UTF-8 expansion is done here, explicitly, in `uri-enc-cp`: one
 escape below U+0080, two below U+0800, three below U+10000, four
 above. Arithmetic rather than bit operations, because the constants
 read as the RFC's own (192, 224, 240 are the lead-byte markers and 128
 is the continuation marker) and a reader can check them against the
 table without translating.

 Unreserved is exactly `ALPHA / DIGIT / "-" / "." / "_" / "~"`
 (section 2.3) and everything else is escaped. That is deliberately
 the strict reading: encoding a character that did not need it is
 always safe to decode, and leaving one that did is what puts an
 unescaped `&` in a query value and silently splits a parameter in
 two.

 The hex digits are indexed out of a literal rather than computed from
 a code point, because the arithmetic is where this would go wrong:
 text is CCE internally, `0` is not 48 there, and building a digit by
 adding to a code point is the mistake that this chapter's neighbours
 have made repeatedly. Indexing a literal cannot have that bug.

  uri-encode : Text -> Text
  uri-encode (s) =
    let bs = text-to-unicode-bytes s
    in text-concat-list (uri-enc-loop bs 0 (list-length bs) [])

  uri-enc-loop : List Integer, Integer, Integer, List Text -> List Text
  uri-enc-loop (cs) (i) (n) (acc) =
    if i >= n then acc
    else uri-enc-loop cs (i + 1) n (list-push acc (uri-enc-cp (list-at cs i)))

  uri-enc-cp : Integer -> Text
  uri-enc-cp (c) =
    if c < 128 then uri-enc-ascii c
    else if c < 2048 then uri-pct (192 + c / 64) & uri-pct (128 + int-mod c 64)
    else if c < 65536 then uri-pct (224 + c / 4096) & uri-pct (128 + int-mod (c / 64) 64) & uri-pct (128 + int-mod c 64)
    else uri-pct (240 + c / 262144) & uri-pct (128 + int-mod (c / 4096) 64) & uri-pct (128 + int-mod (c / 64) 64) & uri-pct (128 + int-mod c 64)

  uri-enc-ascii : Integer -> Text
  uri-enc-ascii (b) =
    if uri-unreserved b then char-encode (code-to-char (from-unicode b))
    else uri-pct b

  uri-pct : Integer -> Text
  uri-pct (b) = "%" & uri-hex-digit (b / 16) & uri-hex-digit (int-mod b 16)

  uri-in-range : Integer, Integer, Integer -> Boolean
  uri-in-range (b) (lo) (hi) = if b < lo then False else b <= hi

  uri-unreserved : Integer -> Boolean
  uri-unreserved (b) =
    if uri-in-range b 65 90 then True
    else if uri-in-range b 97 122 then True
    else if uri-in-range b 48 57 then True
    else if b == 45 then True
    else if b == 46 then True
    else if b == 95 then True
    else b == 126

  uri-hex-digit : Integer -> Text
  uri-hex-digit (v) = text-take (text-drop "0123456789ABCDEF" v) 1

Section: Formatting
  format-uri : UriComponents -> Text
  format-uri (u) =
    let tail = (if text-length (u.query) > 0 then "?" & u.query else "") & (if text-length (u.fragment) > 0 then "#" & u.fragment else "")
    in if text-length (u.scheme) > 0 then uri-build (u.scheme) (u.host) (u.port) (u.path) & tail
    else u.path & tail

