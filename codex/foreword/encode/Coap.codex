Chapter: Coap
  cites Foreword chapter Maybe
  cites Foreword chapter CCE
  cites Foreword chapter MathLib (int-widen)

 CoAP (Constrained Application Protocol) per RFC 7252.
 UDP-based RESTful protocol for constrained IoT devices.
 Each builder returns a List Integer (the raw packet bytes).

Section: Message Types

  CoapType =
    | CoapConfirmable
    | CoapNonConfirmable
    | CoapAcknowledgement
    | CoapReset

  coap-type-value : CoapType -> Integer
  coap-type-value (t) =
   when t
    is CoapConfirmable -> 0
    is CoapNonConfirmable -> 1
    is CoapAcknowledgement -> 2
    is CoapReset -> 3

Section: Method Codes

  CoapMethod =
    | CoapGet
    | CoapPost
    | CoapPut
    | CoapDelete

  coap-method-code : CoapMethod -> Integer
  coap-method-code (m) =
   when m
    is CoapGet -> 1
    is CoapPost -> 2
    is CoapPut -> 3
    is CoapDelete -> 4

Section: Response Codes

  CoapResponseClass =
    | CoapSuccess
    | CoapClientError
    | CoapServerError

  coap-response-code : Integer, Integer -> Integer
  coap-response-code (class-val) (detail) =
   bit-or (bit-shl class-val 5) detail

  coap-200-ok : Integer = coap-response-code 2 0
  coap-201-created : Integer = coap-response-code 2 1
  coap-204-deleted : Integer = coap-response-code 2 2
  coap-205-content : Integer = coap-response-code 2 5
  coap-400-bad-request : Integer = coap-response-code 4 0
  coap-404-not-found : Integer = coap-response-code 4 4
  coap-405-not-allowed : Integer = coap-response-code 4 5
  coap-500-internal : Integer = coap-response-code 5 0

Section: Content Formats

  coap-format-text : Integer = 0
  coap-format-link : Integer = 40
  coap-format-xml : Integer = 41
  coap-format-octet : Integer = 42
  coap-format-json : Integer = 50
  coap-format-cbor : Integer = 60

Section: Option Numbers

  coap-opt-if-match : Integer = 1
  coap-opt-uri-host : Integer = 3
  coap-opt-uri-port : Integer = 7
  coap-opt-uri-path : Integer = 11
  coap-opt-content-format : Integer = 12
  coap-opt-accept : Integer = 17
  coap-opt-uri-query : Integer = 15
  coap-opt-observe : Integer = 6

Section: Packet Builder

  coap-build-header : CoapType, Integer, Integer, Integer -> List Integer
  coap-build-header (msg-type) (code) (msg-id) (token-len) =
   let ver = 1
   in let byte0 = bit-or (bit-or (bit-shl ver 6) (bit-shl (coap-type-value msg-type) 4)) (bit-and token-len 15)
   in [byte0, code, bit-shru msg-id 8, bit-and msg-id 255]

  CoapOption = record {
   number : Integer between 0 and 65535,
   value : List Integer
  }

 A type argument is invariant (`docs/DevelopersGuide.md` "Variance of Type
 Arguments"), and the three fragments below are joined with & and so must
 carry the SAME element type. bit-and yields 0..255 while a subtraction
 yields a plain Integer, so without the widening the branches of one if,
 and then the joins, disagree.

  coap-encode-option : Integer, CoapOption -> List Integer
  coap-encode-option (prev-number) (opt) =
   let delta = opt.number - prev-number
   in let opt-len = list-length (opt.value)
   in let delta-nibble = if delta < 13 then delta else if delta < 269 then 13 else 14
   in let len-nibble = if opt-len < 13 then opt-len else if opt-len < 269 then 13 else 14
   in let header = [int-widen (bit-or (bit-shl delta-nibble 4) len-nibble)]
   in let delta-ext = if delta < 13 then [] else if delta < 269 then [int-widen (delta - 13)] else [int-widen (bit-shru (delta - 269) 8), int-widen (bit-and (delta - 269) 255)]
   in let len-ext = if opt-len < 13 then [] else if opt-len < 269 then [int-widen (opt-len - 13)] else [int-widen (bit-shru (opt-len - 269) 8), int-widen (bit-and (opt-len - 269) 255)]
   in header & delta-ext & len-ext & opt.value

  coap-build-request : CoapType, CoapMethod, Integer, List Integer, List CoapOption, List Integer -> List Integer
  coap-build-request (msg-type) (method) (msg-id) (token) (options) (payload) =
   let header = coap-build-header msg-type (coap-method-code method) msg-id (list-length token)
   in let opts = coap-encode-options options 0 0
   in let payload-marker = if list-length payload > 0 then [255] else []
   in header & token & opts & payload-marker & payload

  coap-encode-options : List CoapOption, Integer, Integer -> List Integer
  coap-encode-options (options) (i) (prev-number) =
   if i >= list-length options then []
   else let opt = list-at options i
   in let encoded = coap-encode-option prev-number opt
   in encoded & coap-encode-options options (i + 1) (opt.number)

Section: URI Path Helper

  coap-uri-path-option : Text -> CoapOption
  coap-uri-path-option (segment) =
   CoapOption {
    number = coap-opt-uri-path,
    value = coap-text-to-bytes segment
   }

 RFC 7252 section 6.4 step 7 and section 5.10.1: each path SEGMENT is its
 own Uri-Path option, and an option value must not contain a slash. One
 option holding a whole path names a resource whose name has slashes in it,
 which on any conforming server is a different resource and usually no
 resource at all. Nothing caught it because every path this tree had ever
 asked for was a single segment -- "temperature", "actuator", "codex" in
 coap-interop-test -- and a single segment is the one case where the two
 spellings agree. An LwM2M path is /3/0/1 and needs three.

  coap-uri-path-options : Text -> List CoapOption
  coap-uri-path-options (path) = coap-split-opts (coap-text-to-bytes path) coap-opt-uri-path 47 0 0 []

 A query is Uri-Query (option 15), not part of the path. The caller passes
 the query alone, without the leading question mark, because the question
 mark separates the two and belongs to neither.

  coap-uri-query-options : Text -> List CoapOption
  coap-uri-query-options (query) = coap-split-opts (coap-text-to-bytes query) coap-opt-uri-query 38 0 0 []

  coap-split-opts : List Integer, Integer, Integer, Integer, Integer, List CoapOption -> List CoapOption
  coap-split-opts (bs) (num) (sep) (i) (start) (acc) =
   if i >= list-length bs then coap-emit-seg bs num start i acc
   else if list-at bs i == sep then coap-split-opts bs num sep (i + 1) (i + 1) (coap-emit-seg bs num start i acc)
   else coap-split-opts bs num sep (i + 1) start acc

 An empty segment is dropped rather than sent. A leading slash and a
 trailing one both produce one, and "//" produces one between them; an
 empty Uri-Path option is a legal encoding of a different path, so emitting
 it would make "/3/0/1" and "3/0/1" name different resources.

  coap-emit-seg : List Integer, Integer, Integer, Integer, List CoapOption -> List CoapOption
  coap-emit-seg (bs) (num) (start) (stop) (acc) =
   if stop <= start then acc
   else list-push acc (CoapOption { number = __narrow num, value = coap-slice bs start (stop - start) })

 A Uri-Path segment goes on the wire, so the conversion is an I/O
 boundary and runs through `to-unicode`. This said `char-code` alone
 until 2026-07-23, which answers the CCE code point and not the ASCII
 one -- `char-code` of "c" is not 99 -- so every path this chapter ever
 built named a resource no server could match. It was invisible for as
 long as the only reader was our own parser: both halves used the same
 mapping and agreed perfectly. aiocoap did not, and answered 4.04 for a
 resource that was there. Same bug, same cause and same hiding place as
 the TLS SNI hostname and the TLS key-schedule labels.

  coap-text-to-bytes : Text -> List Integer
  coap-text-to-bytes (s) = coap-text-to-bytes-loop s 0 (text-length s) []

  coap-text-to-bytes-loop : Text, Integer, Integer, List Integer -> List Integer
  coap-text-to-bytes-loop (s) (i) (len) (acc) =
   if i >= len then acc
   else coap-text-to-bytes-loop s (i + 1) len (list-push acc (to-unicode (char-code (char-at s i))))

Section: Convenience Builders

  coap-get : Integer, List Integer, Text -> List Integer
  coap-get (msg-id) (token) (path) =
   coap-build-request CoapConfirmable CoapGet msg-id token [coap-uri-path-option path] []

  coap-post : Integer, List Integer, Text, List Integer -> List Integer
  coap-post (msg-id) (token) (path) (payload) =
   coap-build-request CoapConfirmable CoapPost msg-id token [coap-uri-path-option path, CoapOption { number = coap-opt-content-format, value = [coap-format-cbor] }] payload

  coap-ack : Integer -> List Integer
  coap-ack (msg-id) =
   coap-build-header CoapAcknowledgement 0 msg-id 0

  coap-build-response : CoapType, Integer, Integer, List Integer, List CoapOption, List Integer -> List Integer
  coap-build-response (msg-type) (code) (msg-id) (token) (options) (payload) =
   let header = coap-build-header msg-type code msg-id (list-length token)
   in let opts = coap-encode-options options 0 0
   in let payload-marker = if list-length payload > 0 then [255] else []
   in header & token & opts & payload-marker & payload

Section: Block-Wise Transfer and Observe

 Block-wise transfer (RFC 7959) splits a large payload across many
 messages. The Block1 (request body, option 27) and Block2 (response
 body, option 23) option values pack a block number, a more-blocks
 flag, and a size exponent (block size is 2 raised to szx plus four)
 into a minimal-length unsigned integer: (num << 4) | (more << 3) | szx.
 The Observe option (RFC 7641, option 6) registers or cancels a
 subscription and carries a sequence number. CoAP option values use the
 shortest encoding, empty for zero.

  coap-opt-block2 : Integer = 23
  coap-opt-block1 : Integer = 27

 Size2 (RFC 7959 section 4) carries the total size of the resource the
 server is about to send in blocks. It is a HINT and the RFC says so: a
 server may omit it, and nothing obliges the value to be true. A receiver
 may use it to refuse early, and must not use it as the bound that keeps a
 transfer honest.

  coap-opt-size2 : Integer = 28

  coap-uint-bytes : Integer -> List Integer
  coap-uint-bytes (v) =
   if v == 0 then []
   else if v < 256 then [v]
   else if v < 65536 then [bit-and (bit-shru v 8) 255, bit-and v 255]
   else [bit-and (bit-shru v 16) 255, bit-and (bit-shru v 8) 255, bit-and v 255]

  coap-block-value : Integer, Integer, Integer -> Integer
  coap-block-value (num) (more) (szx) =
   bit-or (bit-or (bit-shl num 4) (bit-shl more 3)) szx

  coap-block-option : Integer, Integer, Integer, Integer -> CoapOption
  coap-block-option (option-num) (num) (more) (szx) =
   CoapOption {
    number = __narrow option-num,
    value = coap-uint-bytes (coap-block-value num more szx)
   }

  coap-observe-option : Integer -> CoapOption
  coap-observe-option (seq) =
   CoapOption {
    number = coap-opt-observe,
    value = coap-uint-bytes seq
   }

Section: Parsing

 coap-parse returns Maybe, and the None is the point: a malformed packet
 is not a packet with some fields missing, it is bytes from someone who
 is not speaking CoAP, and a parser that guesses at them on a firmware
 path is an attacker's instrument. Every refusal below is a rule from
 RFC 7252 section 3, not a defensive reflex.

 A packet is refused when it is shorter than the four-byte header or its
 token runs off the end; when its version is not 1, which the RFC says to
 ignore rather than interpret; when its token length is 9 through 15,
 which MUST NOT be sent and is a format error to receive; when an option
 delta or length nibble is 15, which is reserved and, outside the payload
 marker, a format error; when an option value runs past the end of the
 datagram; and when a payload marker has nothing behind it. That last one
 earns its place: an empty payload is spelled by omitting the marker, so
 a bare 0xFF is a lie about length, which is exactly the shape a
 truncation attack takes.

  CoapMessage = record {
   cm-type : Integer between 0 and 3,
   cm-code : Integer between 0 and 255,
   cm-msg-id : Integer between 0 and 65535,
   cm-token : List Integer,
   cm-options : List CoapOption,
   cm-payload : List Integer
  }

  CoapExt = record {
   ce-ok : Boolean,
   ce-val : Integer,
   ce-next : Integer
  }

  CoapOptScan = record {
   co-ok : Boolean,
   co-opts : List CoapOption,
   co-next : Integer
  }

  coap-slice : List Integer, Integer, Integer -> List Integer
  coap-slice (bytes) (off) (len) = coap-slice-loop bytes off len 0 []

  coap-slice-loop : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  coap-slice-loop (bytes) (off) (len) (i) (acc) =
   if i >= len then acc
   else coap-slice-loop bytes off len (i + 1) (list-push acc (list-at bytes (off + i)))

 An option delta or length is a nibble, and 13 and 14 mean the real value
 is in the bytes that follow (RFC 7252 section 3.1). The extension must
 fit inside the datagram, so a nibble that promises bytes the packet does
 not have is a refusal and not a zero.

  coap-ext : List Integer, Integer, Integer, Integer -> CoapExt
  coap-ext (bytes) (p) (n) (nib) =
   if nib < 13 then CoapExt { ce-ok = True, ce-val = nib, ce-next = p }
   else if nib == 13 then
     if p >= n then CoapExt { ce-ok = False, ce-val = 0, ce-next = p }
     else CoapExt { ce-ok = True, ce-val = (list-at bytes p) + 13, ce-next = p + 1 }
   else if p + 1 >= n then CoapExt { ce-ok = False, ce-val = 0, ce-next = p }
   else CoapExt { ce-ok = True, ce-val = (bit-or (bit-shl (list-at bytes p) 8) (list-at bytes (p + 1))) + 269, ce-next = p + 2 }

  coap-scan-fail : CoapOptScan
  coap-scan-fail = CoapOptScan { co-ok = False, co-opts = [], co-next = 0 }

  coap-scan-options : List Integer, Integer, Integer, Integer, List CoapOption -> CoapOptScan
  coap-scan-options (bytes) (i) (n) (prev) (acc) =
   if i >= n then CoapOptScan { co-ok = True, co-opts = acc, co-next = n }
   else if list-at bytes i == 255 then
     (if i + 1 >= n then coap-scan-fail
      else CoapOptScan { co-ok = True, co-opts = acc, co-next = i + 1 })
   else let h = list-at bytes i
   in let dn = bit-shru h 4
   in let ln = bit-and h 15
   in if dn == 15 then coap-scan-fail
   else if ln == 15 then coap-scan-fail
   else let de = coap-ext bytes (i + 1) n dn
   in if de.ce-ok == False then coap-scan-fail
   else let le = coap-ext bytes (de.ce-next) n ln
   in if le.ce-ok == False then coap-scan-fail
   else let vstart = le.ce-next
   in if vstart + (le.ce-val) > n then coap-scan-fail
   else let num = prev + (de.ce-val)
   in if num > 65535 then coap-scan-fail
   else coap-scan-options bytes (vstart + (le.ce-val)) n num (list-push acc (CoapOption {
     number = __narrow num,
     value = coap-slice bytes vstart (le.ce-val)
   }))

  coap-parse : List Integer -> Maybe CoapMessage
  coap-parse (bytes) =
   let n = list-length bytes
   in if n < 4 then None
   else let byte0 = list-at bytes 0
   in let ver = bit-shru byte0 6
   in let tkl = bit-and byte0 15
   in if ver /= 1 then None
   else if tkl > 8 then None
   else if 4 + tkl > n then None
   else let scan = coap-scan-options bytes (4 + tkl) n 0 []
   in if scan.co-ok == False then None
   else Just (CoapMessage {
     cm-type = __narrow (bit-and (bit-shru byte0 4) 3),
     cm-code = __narrow (list-at bytes 1),
     cm-msg-id = __narrow (bit-or (bit-shl (list-at bytes 2) 8) (list-at bytes 3)),
     cm-token = coap-slice bytes 4 tkl,
     cm-options = scan.co-opts,
     cm-payload = coap-slice bytes (scan.co-next) (n - (scan.co-next))
   })

Section: Reading Options

 An option that is absent and an option whose value is zero are not the
 same thing, and CoAP spells the second one with an empty value -- so
 coap-find-option answers Maybe and the caller decides. No Block2 option
 at all means the whole body is here; a Block2 option with an empty value
 means block 0, no more, size 16. Collapsing those loses the difference
 between a server that is not doing block-wise transfer and one that is.

 Uri-Path and Location-Path are repeatable and their ORDER is the path, so
 finding the first one answers a different question from reading the path.
 coap-find-option is right for a singleton option and wrong for these.

  coap-opt-location-path : Integer = 8

  coap-find-options : List CoapOption, Integer -> List (List Integer)
  coap-find-options (opts) (num) = coap-find-options-loop opts num 0 []

  coap-find-options-loop : List CoapOption, Integer, Integer, List (List Integer) -> List (List Integer)
  coap-find-options-loop (opts) (num) (i) (acc) =
   if i >= list-length opts then acc
   else let o = list-at opts i
   in if o.number == num then coap-find-options-loop opts num (i + 1) (list-push acc (o.value))
   else coap-find-options-loop opts num (i + 1) acc

 2.04 Changed, which a Write and an Execute both answer with. The constant
 named coap-204-deleted above is 2.02 Deleted (response-code 2 2); its VALUE
 is right and its NAME is not, and it is left alone here rather than renamed
 under an unrelated change.

  coap-204-changed : Integer = coap-response-code 2 4

  coap-find-option : List CoapOption, Integer -> Maybe (List Integer)
  coap-find-option (opts) (num) = coap-find-option-loop opts num 0 (list-length opts)

  coap-find-option-loop : List CoapOption, Integer, Integer, Integer -> Maybe (List Integer)
  coap-find-option-loop (opts) (num) (i) (len) =
   if i >= len then None
   else let o = list-at opts i
   in if o.number == num then Just (o.value)
   else coap-find-option-loop opts num (i + 1) len

  coap-uint-value : List Integer -> Integer
  coap-uint-value (bytes) = coap-uint-value-loop bytes 0 (list-length bytes) 0

  coap-uint-value-loop : List Integer, Integer, Integer, Integer -> Integer
  coap-uint-value-loop (bytes) (i) (len) (acc) =
   if i >= len then acc
   else coap-uint-value-loop bytes (i + 1) len (bit-or (bit-shl acc 8) (list-at bytes i))

  coap-block-num : Integer -> Integer
  coap-block-num (v) = bit-shru v 4

  coap-block-more : Integer -> Integer
  coap-block-more (v) = bit-and (bit-shru v 3) 1

  coap-block-szx : Integer -> Integer
  coap-block-szx (v) = bit-and v 7

 Block size is two raised to szx plus four, so szx 6 is 1024 bytes. szx 7
 is reserved (RFC 7959 section 2.2) and answers 0 rather than 2048, so a
 caller that trusts this number cannot be walked past the end of a buffer
 by a reserved value.

  coap-block-size : Integer -> Integer
  coap-block-size (szx) = if szx > 6 then 0 else bit-shl 1 (szx + 4)

