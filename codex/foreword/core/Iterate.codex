Chapter: Iterate

 Generic indexed iteration primitives for List.

 To list-fold-indexed gives b, folding a function over each element with its index.
 To list-map-generic gives List b, applying a function to each element.
 To list-filter-generic gives List a, keeping elements where the predicate returns True.
 To list-find-index gives Integer, the index of the first element satisfying a predicate, or -1.
 To list-any-generic gives Boolean, True when at least one element satisfies a predicate.
 To list-all-generic gives Boolean, True when every element satisfies a predicate.
 To list-take-generic gives List a, the first n elements.
 To list-drop-generic gives List a, elements after skipping the first n.
 To list-zip-with-generic gives List c, pairwise combination of two lists with a function.
 To list-count-where gives Integer, the number of elements satisfying a predicate.

 We say:

Section: Core Fold

 The function-taking primitives here are effect-polymorphic
 (EffectRows.md): the row variable e names exactly the effects of
 the function argument.

  list-fold-indexed : List a, b, (b, a, Integer -> [e] b) -> [e] b
  list-fold-indexed (xs) (init) (f) =
    list-fold-indexed-loop xs init f 0 (list-length xs)

  list-fold-indexed-loop : List a, b, (b, a, Integer -> [e] b), Integer, Integer -> [e] b
  list-fold-indexed-loop (xs) (acc) (f) (i) (len) =
    if i >= len then acc
    else list-fold-indexed-loop xs (f acc (list-at xs i) i) f (i + 1) len

Section: Map and Filter

  list-map-generic : (a -> [e] b), List a -> [e] List b
  list-map-generic (f) (xs) =
    list-map-generic-loop f xs 0 (list-length xs) []

  list-map-generic-loop : (a -> [e] b), List a, Integer, Integer, List b -> [e] List b
  list-map-generic-loop (f) (xs) (i) (len) (acc) =
    if i >= len then acc
    else list-map-generic-loop f xs (i + 1) len (list-push acc (f (list-at xs i)))

  list-filter-generic : (a -> [e] Boolean), List a -> [e] List a
  list-filter-generic (pred) (xs) =
    list-filter-generic-loop pred xs 0 (list-length xs) []

  list-filter-generic-loop : (a -> [e] Boolean), List a, Integer, Integer, List a -> [e] List a
  list-filter-generic-loop (pred) (xs) (i) (len) (acc) =
    if i >= len then acc
    else let x = list-at xs i
    in if pred x then list-filter-generic-loop pred xs (i + 1) len (list-push acc x)
    else list-filter-generic-loop pred xs (i + 1) len acc

Section: Search

  list-find-index : (a -> [e] Boolean), List a -> [e] Integer
  list-find-index (pred) (xs) =
    list-find-index-loop pred xs 0 (list-length xs)

  list-find-index-loop : (a -> [e] Boolean), List a, Integer, Integer -> [e] Integer
  list-find-index-loop (pred) (xs) (i) (len) =
    if i >= len then -1
    else if pred (list-at xs i) then i
    else list-find-index-loop pred xs (i + 1) len

  list-any-generic : (a -> [e] Boolean), List a -> [e] Boolean
  list-any-generic (pred) (xs) =
    list-find-index pred xs >= 0

  list-all-generic : (a -> [e] Boolean), List a -> [e] Boolean
  list-all-generic (pred) (xs) =
    list-all-generic-loop pred xs 0 (list-length xs)

  list-all-generic-loop : (a -> [e] Boolean), List a, Integer, Integer -> [e] Boolean
  list-all-generic-loop (pred) (xs) (i) (len) =
    if i >= len then True
    else if pred (list-at xs i) then list-all-generic-loop pred xs (i + 1) len
    else False

  list-count-where : (a -> [e] Boolean), List a -> [e] Integer
  list-count-where (pred) (xs) =
    list-count-where-loop pred xs 0 (list-length xs) 0

  list-count-where-loop : (a -> [e] Boolean), List a, Integer, Integer, Integer -> [e] Integer
  list-count-where-loop (pred) (xs) (i) (len) (count) =
    if i >= len then count
    else if pred (list-at xs i) then list-count-where-loop pred xs (i + 1) len (count + 1)
    else list-count-where-loop pred xs (i + 1) len count

Section: Slice

  list-take-generic : List a, Integer -> List a
  list-take-generic (xs) (n) =
    list-take-generic-loop xs 0 n []

  list-take-generic-loop : List a, Integer, Integer, List a -> List a
  list-take-generic-loop (xs) (i) (n) (acc) =
    if i >= n then acc
    else if i >= list-length xs then acc
    else list-take-generic-loop xs (i + 1) n (list-push acc (list-at xs i))

  list-drop-generic : List a, Integer -> List a
  list-drop-generic (xs) (n) =
    list-drop-generic-loop xs n (list-length xs) []

  list-drop-generic-loop : List a, Integer, Integer, List a -> List a
  list-drop-generic-loop (xs) (i) (len) (acc) =
    if i >= len then acc
    else list-drop-generic-loop xs (i + 1) len (list-push acc (list-at xs i))

Section: Zip

  list-zip-with-generic : (a, b -> [e] c), List a, List b -> [e] List c
  list-zip-with-generic (f) (xs) (ys) =
    let len = if list-length xs < list-length ys then list-length xs else list-length ys
    in list-zip-loop f xs ys 0 len []

  list-zip-loop : (a, b -> [e] c), List a, List b, Integer, Integer, List c -> [e] List c
  list-zip-loop (f) (xs) (ys) (i) (len) (acc) =
    if i >= len then acc
    else list-zip-loop f xs ys (i + 1) len (list-push acc (f (list-at xs i) (list-at ys i)))

