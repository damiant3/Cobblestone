Section: Definitions

  effect Random where
    random-integer : Integer, Integer -> [Random] Integer

Section: Deterministic Mixing

 Multiplication and addition carry entropy UPWARD only. Bit i of a product
 depends on bits 0..i of its inputs and on nothing above them, so the low bits
 of a multiply-and-add mixer are a function of the low bits of the inputs, and
 a caller that takes a remainder by a power of two or a small range, or masks
 off low bits, gets structure rather than noise.

 mix-bits multiplies to spread, then xor-shifts the high bits back down so the
 low ones inherit them: the SplitMix64 finalizer. Deterministic and pure; true
 entropy belongs to the Random EFFECT above, not here.

  mix-bits : Integer between -9223372036854775808 and 9223372036854775807 wrapping, Integer between -9223372036854775808 and 9223372036854775807 wrapping -> Integer
  mix-bits (seed) (idx) =
    let z = seed * 2654435769 + idx * 1442695040888963407
    in let a = bit-xor z (bit-shru z 30)
    in let b = w64-mul a 6364136223846793005
    in let c = bit-xor b (bit-shru b 27)
    in let d = w64-mul c 1442695040888963407
    in bit-xor d (bit-shru d 31)

  rand-in-range : Integer, Integer, Integer, Integer -> Integer
  rand-in-range (seed) (idx) (lo) (hi) =
    let h = mix-bits seed idx
    in let positive = if h < 0 then -h else h
    in let range = hi - lo + 1
    in if range <= 0 then lo
    else lo + (positive - (positive / range) * range)

Section: Hardware Entropy

  hardware-random-words : Integer -> Maybe (List Integer)
  hardware-random-words (count) = hrw-draw count (__list-with-capacity count)

  hrw-draw : Integer, List Integer -> Maybe (List Integer)
  hrw-draw (count) (acc) =
    if list-length acc >= count then Just acc
    else let w = __hardware-random-word
    in if w == 0 | w == 0 - 1 then None
    else hrw-draw count (list-push acc w)

  device-seed-present : List Integer -> Boolean
  device-seed-present (bytes) =
    list-length bytes == 32 & dsp-word bytes 0 & dsp-word bytes 8 & dsp-word bytes 16 & dsp-word bytes 24

  dsp-word : List Integer, Integer -> Boolean
  dsp-word (bytes) (at) = dsp-any bytes at (at + 8)

  dsp-any : List Integer, Integer, Integer -> Boolean
  dsp-any (bytes) (i) (stop) =
    if i >= stop then False
    else if list-at bytes i /= 0 then True
    else dsp-any bytes (i + 1) stop
