    255, 255, 255, 255, 255, 255, 255, 255,
    255, 255, 255, 255, 255, 255, 255, 255,
    199, 99, 77, 129, 244, 55, 45, 223,
    88, 26, 13, 178, 72, 176, 167, 122,
    236, 236, 25, 106, 204, 197, 41, 115]

