Chapter: Sort

 In-place quicksort with median-of-three pivot selection. Sorts the
 input list using list-set-at mutation, allocating nothing beyond the
 input array. The comparator returns a negative, zero, or positive
 integer. Average O n log n time, O log n stack.
 A SortPartition is a record containing the array after partitioning and the final index of the pivot element.
 To sort-by gives the sorted list using the given comparator.

 We say:

Section: Entry Point
  sort-by : List a, (a, a -> Integer) -> List a
  sort-by (xs) (cmp) =
   let len = list-length xs
   in if len <= 1 then xs
   else qsort-by xs cmp 0 (len - 1)

Section: Quicksort
  SortPartition (a) = record { list : List a, pivot : Integer }

  qsort-by : List a, (a, a -> Integer), Integer, Integer -> List a
  qsort-by (xs) (cmp) (lo) (hi) =
   if lo >= hi then xs
   else let xs2 = sort-med3 xs cmp lo (lo + (hi - lo) / 2) hi
   in let pr = sort-partition xs2 cmp lo hi lo (list-at xs2 hi)
   in let xs3 = qsort-by (pr.list) cmp lo (pr.pivot - 1)
   in qsort-by xs3 cmp (pr.pivot + 1) hi

  sort-med3 : List a, (a, a -> Integer), Integer, Integer, Integer -> List a
  sort-med3 (xs) (cmp) (a) (b) (c) =
   let va = list-at xs a
   in let vb = list-at xs b
   in let vc = list-at xs c
   in if cmp va vb <= 0
      then if cmp vb vc <= 0 then sort-swap xs b c
           else if cmp va vc <= 0 then xs
           else sort-swap xs a c
      else if cmp va vc <= 0 then sort-swap xs a c
           else if cmp vb vc <= 0 then xs
           else sort-swap xs b c

  sort-swap : List a, Integer, Integer -> List a
  sort-swap (xs) (i) (j) =
   if i == j then xs
   else let vi = list-at xs i
   in list-set-at (list-set-at xs i (list-at xs j)) j vi

  sort-partition : List a, (a, a -> Integer), Integer, Integer, Integer, a -> SortPartition a
  sort-partition (xs) (cmp) (j) (hi) (i) (pv) =
   if j >= hi
   then let xs2 = sort-swap xs i hi
   in SortPartition { list = xs2, pivot = i }
   else if cmp (list-at xs j) pv < 0
      then sort-partition (sort-swap xs i j) cmp (j + 1) hi (i + 1) pv
      else sort-partition xs cmp (j + 1) hi i pv
