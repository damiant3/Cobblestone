Chapter: Pbkdf
  cites Foreword chapter Hmac

 PBKDF2-HMAC-SHA256, RFC 8018 section 5.2. Invalid parameters or
 non-octet input produce an empty hash, which verification rejects.
 The output and two 32-byte round buffers precede each scratch mark.
 Time is proportional to iterations times output blocks; retained heap
 is independent of the iteration count. This is not a memory-hard KDF.

Section: Types

  PbkdfParams = record {
    pb-iterations : Integer,
    pb-hash-length : Integer
  }

  PbkdfResult = record {
    pbr-hash : List Integer,
    pbr-salt : List Integer,
    pbr-params : PbkdfParams
  }

  pbkdf-default-params : PbkdfParams = PbkdfParams {
    pb-iterations = 100000,
    pb-hash-length = 32
  }

Section: Hash

  pbkdf-params-ok : PbkdfParams -> Boolean
  pbkdf-params-ok (params) =
    params.pb-iterations > 0 & params.pb-hash-length > 0 & params.pb-hash-length <= 137438953440

  pb-octets-ok : List Integer, Integer -> Boolean
  pb-octets-ok (xs) (i) =
    if i >= list-length xs then True
    else if list-at xs i < 0 | list-at xs i > 255 then False
    else pb-octets-ok xs (i + 1)

  pbkdf-hash : List Integer, List Integer, PbkdfParams -> PbkdfResult
  pbkdf-hash (password) (salt) (params) =
    let valid = pbkdf-params-ok params & pb-octets-ok password 0 & pb-octets-ok salt 0
    in let tag = if valid then pb-derive password salt params else []
    in PbkdfResult { pbr-hash = tag, pbr-salt = salt, pbr-params = params }

  pb-derive : List Integer, List Integer, PbkdfParams -> List Integer
  pb-derive (password) (salt) (params) =
    let output = __list-with-capacity (params.pb-hash-length)
    in let mark = __heap-save
    in let key = hmac-normalize-key password
    in let ipad = for b in key -> bit-xor b 54
    in let opad = for b in key -> bit-xor b 92
    in let u = repeat-byte 0 32
    in let t = repeat-byte 0 32
    in let result = pb-output-blocks ipad opad salt (params.pb-iterations) (params.pb-hash-length) 1 u t output
    in let restored = __heap-restore mark
    in result

  pb-prf : List Integer, List Integer, List Integer -> List Integer
  pb-prf (ipad) (opad) (message) =
    hash-words-to-bytes (sha256 (opad & hash-words-to-bytes (sha256 (ipad & message))))

  pb-output-blocks : List Integer, List Integer, List Integer, Integer, Integer, Integer, List Integer, List Integer, List Integer -> List Integer
  pb-output-blocks (ipad) (opad) (salt) (iterations) (length) (index) (u) (t) (output) =
    if list-length output >= length then output
    else let mark = __heap-save
    in let first = pb-prf ipad opad (salt & pb-be32 index)
    in let u1 = pb-copy first u 0
    in let t1 = pb-copy first t 0
    in let restored = __heap-restore mark
    in let block = pb-rounds ipad opad u1 t1 (iterations - 1)
    in let count = min 32 (length - list-length output)
    in let appended = pb-append block count 0 output
    in pb-output-blocks ipad opad salt iterations length (index + 1) u1 t1 appended

  pb-rounds : List Integer, List Integer, List Integer, List Integer, Integer -> List Integer
  pb-rounds (ipad) (opad) (u) (t) (remaining) =
    if remaining <= 0 then t
    else let mark = __heap-save
    in let next = pb-prf ipad opad u
    in let copied = pb-copy next u 0
    in let mixed = pb-xor-into next t 0
    in let restored = __heap-restore mark
    in pb-rounds ipad opad copied mixed (remaining - 1)

  pb-copy : List Integer, List Integer, Integer -> List Integer
  pb-copy (source) (target) (i) =
    if i >= 32 then target
    else pb-copy source (list-set-at target i (list-at source i)) (i + 1)

  pb-xor-into : List Integer, List Integer, Integer -> List Integer
  pb-xor-into (source) (target) (i) =
    if i >= 32 then target
    else pb-xor-into source (list-set-at target i (bit-xor (list-at source i) (list-at target i))) (i + 1)

  pb-append : List Integer, Integer, Integer, List Integer -> List Integer
  pb-append (source) (count) (i) (output) =
    if i >= count then output
    else pb-append source count (i + 1) (list-push output (list-at source i))

  pb-be32 : Integer -> List Integer
  pb-be32 (n) = [bit-and (bit-shru n 24) 255, bit-and (bit-shru n 16) 255, bit-and (bit-shru n 8) 255, bit-and n 255]

Section: Verify

  pbkdf-verify : List Integer, PbkdfResult -> Boolean
  pbkdf-verify (password) (result) =
    if pbkdf-params-ok (result.pbr-params) == False then False
    else if list-length (result.pbr-hash) /= result.pbr-params.pb-hash-length then False
    else if pb-octets-ok (result.pbr-hash) 0 == False then False
    else let rehash = pbkdf-hash password (result.pbr-salt) (result.pbr-params)
    in if list-length (rehash.pbr-hash) /= list-length (result.pbr-hash) then False
    else pb-constant-eq (rehash.pbr-hash) (result.pbr-hash) 0 (list-length (result.pbr-hash)) 0

  pb-constant-eq : List Integer, List Integer, Integer, Integer, Integer -> Boolean
  pb-constant-eq (a) (b) (i) (len) (diff) =
    if i >= len then diff == 0
    else pb-constant-eq a b (i + 1) len (bit-or diff (bit-xor (list-at a i) (list-at b i)))

