Chapter: TextWrap
  cites Foreword chapter CCE

 To text-wrap gives a single text with newlines inserted at word boundaries to fit the given width.
 To text-wrap-lines gives a list of lines wrapped to the given width.
 To text-truncate gives text cut to the given maximum length with an ellipsis appended.
 To text-center gives text padded with leading spaces to center within the given width.
 To text-right-align gives text padded with leading spaces to right-align within the given width.
 To text-box gives text surrounded by an ASCII box border at the given width.

 We say:

Section: Wrapping
  text-wrap : Text, Integer -> Text
  text-wrap (s) (width) =
    let words = text-split s " "
    in wrap-words words width 0 (list-length words) 0 ""

  wrap-words : List Text, Integer, Integer, Integer, Integer, Text -> Text
  wrap-words (words) (width) (i) (n) (col) (acc) =
    if i >= n then acc
    else let word = list-at words i
    in let wlen = text-length word
    in if col == 0 then wrap-words words width (i + 1) n wlen (acc & word)
    else if col + 1 + wlen > width then wrap-words words width (i + 1) n wlen (acc & "\n" & word)
    else wrap-words words width (i + 1) n (col + 1 + wlen) (acc & " " & word)

Section: Wrap to Lines
  text-wrap-lines : Text, Integer -> List Text
  text-wrap-lines (s) (width) =
    let wrapped = text-wrap s width
    in text-split wrapped "\n"

Section: Truncation
  text-truncate : Text, Integer, Text -> Text
  text-truncate (s) (max-len) (ellipsis) =
    if text-length s <= max-len then s
    else let elen = text-length ellipsis
    in tw-take s (max-len - elen) & ellipsis

  tw-take : Text, Integer -> Text
  tw-take (s) (n) = substring s 0 n

Section: Center/Right Align
  text-center : Text, Integer -> Text
  text-center (s) (width) =
    let len = text-length s
    in if len >= width then s
    else let pad = (width - len) / 2
    in tw-spaces pad & s

  text-right-align : Text, Integer -> Text
  text-right-align (s) (width) =
    let len = text-length s
    in if len >= width then s
    else tw-spaces (width - len) & s

  tw-spaces : Integer -> Text
  tw-spaces (n) = tw-spaces-loop n ""

  tw-spaces-loop : Integer, Text -> Text
  tw-spaces-loop (n) (acc) =
    if n <= 0 then acc
    else tw-spaces-loop (n - 1) (acc & " ")

Section: Box Drawing
  text-box : Text, Integer -> Text
  text-box (s) (width) =
    let border = tw-repeat-char "-" (width + 2)
    in let padded = tw-pad-line s width
    in "+" & border & "+" & "\n" & "| " & padded & " |" & "\n" & "+" & border & "+"

  tw-pad-line : Text, Integer -> Text
  tw-pad-line (s) (width) =
    let len = text-length s
    in if len >= width then s
    else s & tw-spaces (width - len)

  tw-repeat-char : Text, Integer -> Text
  tw-repeat-char (ch) (n) = tw-rep-loop ch n ""

  tw-rep-loop : Text, Integer, Text -> Text
  tw-rep-loop (ch) (n) (acc) =
    if n <= 0 then acc
    else tw-rep-loop ch (n - 1) (acc & ch)

