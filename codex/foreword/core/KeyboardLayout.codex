Section: Layout Registry
  kbl-by-name : Text -> KbLayout
  kbl-by-name (name) =
    if name == "US" then kbl-us
    else if name == "UK" then kbl-uk
    else if name == "DE" then kbl-de
    else if name == "FR" then kbl-fr
    else if name == "ES" then kbl-es
    else if name == "PT" then kbl-pt
    else if name == "IT" then kbl-it
    else if name == "SE" then kbl-se
    else if name == "FI" then kbl-se
    else if name == "NO" then kbl-no
    else if name == "DA" then kbl-no
    else if name == "CH" then kbl-ch
    else if name == "PL" then kbl-pl
    else if name == "CZ" then kbl-cz
    else if name == "SK" then kbl-sk
    else if name == "HU" then kbl-hu
    else if name == "RO" then kbl-ro
    else if name == "HR" then kbl-hr
    else if name == "SI" then kbl-hr
    else if name == "TR" then kbl-tr
    else if name == "ET" then kbl-et
    else if name == "LV" then kbl-lv
    else if name == "LT" then kbl-lt
    else if name == "RU" then kbl-ru
    else if name == "UA" then kbl-ua
    else if name == "BG" then kbl-ru
    else if name == "EL" then kbl-el
    else kbl-us

  kbl-list-names : List Text
  kbl-list-names = ["US", "UK", "DE", "FR", "ES", "PT", "IT", "SE", "FI", "NO", "DA", "CH", "PL", "CZ", "SK", "HU", "RO", "HR", "SI", "TR", "ET", "LV", "LT", "RU", "UA", "BG", "EL"]

Section: Formatting
  format-layout : KbLayout -> Text
  format-layout (l) = "KbLayout: " & l.kbl-name

