Chapter: KeyboardLayout

 Keyboard layout tables for international input. Each layout maps PS/2
 scancode set 1 (XT, 84 keys) to CCE code points for unshifted and
 shifted states. Dead keys for accented characters use a two-stroke
 sequence: dead key sets a pending accent, next letter combines.

 We say:

Section: Layout Record
  KbLayout = record {
    kbl-name : Text,
    kbl-base : Integer,
    kbl-shift : Integer,
    kbl-dead1 : Integer,
    kbl-dead2 : Integer
  }

  kbl-num-keys : Integer = 84
  kbl-table-size : Integer = 168

  kbl-write : Integer, Integer, Integer -> Integer
  kbl-write (tbl) (sc) (cce) =
    let off = sc * 2
    in let lo = poke-byte tbl off (bit-and cce 255)
    in poke-byte tbl (off + 1) (bit-and (bit-shru cce 8) 255)

  kbl-lookup : Integer, Integer -> Integer
  kbl-lookup (tbl) (sc) =
    if sc >= kbl-num-keys then 0
    else let off = sc * 2
    in let lo = peek-byte tbl off
    in let hi = peek-byte tbl (off + 1)
    in hi * 256 + lo

Section: Dead Key Support
  DeadState = record {
    ds-pending : Integer
  }

  dead-none : DeadState
  dead-none = DeadState { ds-pending = 0 }

  dead-combine : DeadState, Integer -> Integer
  dead-combine (ds) (base-cce) =
    let accent = ds.ds-pending
    in if accent == 0 then base-cce
    else dead-apply accent base-cce

  dead-apply : Integer, Integer -> Integer
  dead-apply (accent) (base) =
    if accent == 1 then dead-acute base
    else if accent == 2 then dead-grave base
    else if accent == 3 then dead-circumflex base
    else if accent == 4 then dead-diaeresis base
    else if accent == 5 then dead-tilde base
    else if accent == 6 then dead-cedilla base
    else base

  dead-acute : Integer -> Integer
  dead-acute (b) =
    if b == 13 then from-unicode 233
    else if b == 17 then from-unicode 237
    else if b == 16 then from-unicode 243
    else if b == 15 then from-unicode 225
    else if b == 25 then from-unicode 250
    else if b == 39 then from-unicode 201
    else if b == 43 then from-unicode 205
    else if b == 42 then from-unicode 211
    else if b == 41 then from-unicode 193
    else if b == 51 then from-unicode 218
    else b

  dead-grave : Integer -> Integer
  dead-grave (b) =
    if b == 13 then from-unicode 232
    else if b == 15 then from-unicode 224
    else if b == 16 then from-unicode 242
    else if b == 25 then from-unicode 249
    else if b == 39 then from-unicode 200
    else if b == 41 then from-unicode 192
    else if b == 42 then from-unicode 210
    else if b == 51 then from-unicode 217
    else b

  dead-circumflex : Integer -> Integer
  dead-circumflex (b) =
    if b == 13 then from-unicode 234
    else if b == 15 then from-unicode 226
    else if b == 17 then from-unicode 238
    else if b == 16 then from-unicode 244
    else if b == 25 then from-unicode 251
    else if b == 39 then from-unicode 202
    else if b == 41 then from-unicode 194
    else if b == 43 then from-unicode 206
    else if b == 42 then from-unicode 212
    else if b == 51 then from-unicode 219
    else b

  dead-diaeresis : Integer -> Integer
  dead-diaeresis (b) =
    if b == 13 then from-unicode 235
    else if b == 15 then from-unicode 228
    else if b == 17 then from-unicode 239
    else if b == 16 then from-unicode 246
    else if b == 25 then from-unicode 252
    else if b == 39 then from-unicode 203
    else if b == 41 then from-unicode 196
    else if b == 43 then from-unicode 207
    else if b == 42 then from-unicode 214
    else if b == 51 then from-unicode 220
    else b

  dead-tilde : Integer -> Integer
  dead-tilde (b) =
    if b == 18 then from-unicode 241
    else if b == 44 then from-unicode 209
    else if b == 15 then from-unicode 227
    else if b == 16 then from-unicode 245
    else if b == 41 then from-unicode 195
    else if b == 42 then from-unicode 213
    else b

  dead-cedilla : Integer -> Integer
  dead-cedilla (b) =
    if b == 24 then from-unicode 231
    else if b == 50 then from-unicode 199
    else b

Section: US English (QWERTY)
  kbl-us : KbLayout
  kbl-us =
    let base = alloc-bytes kbl-table-size
    in let shift = alloc-bytes kbl-table-size
    in let b = kbl-build-us-base base
    in let s = kbl-build-us-shift shift
    in KbLayout { kbl-name = "US", kbl-base = base, kbl-shift = shift, kbl-dead1 = 0, kbl-dead2 = 0 }

  kbl-build-us-base : Integer -> Integer
  kbl-build-us-base (t) =
