Section: Ukrainian
  kbl-ua : KbLayout
  kbl-ua =
    let base = alloc-bytes kbl-table-size
    in let shift = alloc-bytes kbl-table-size
    in let b = kbl-build-ua-base base
    in let s = kbl-build-ua-shift shift
    in KbLayout { kbl-name = "UA", kbl-base = base, kbl-shift = shift, kbl-dead1 = 0, kbl-dead2 = 0 }

  kbl-build-ua-base : Integer -> Integer
  kbl-build-ua-base (t) =
    let w0 = kbl-build-ru-base t
    in let w1 = kbl-write t 23 (from-unicode 1110)
    in let w2 = kbl-write t 26 (from-unicode 1111)
    in let w3 = kbl-write t 27 (from-unicode 1169)
    in let w4 = kbl-write t 40 (from-unicode 1108)
    in t

  kbl-build-ua-shift : Integer -> Integer
  kbl-build-ua-shift (t) =
    let w0 = kbl-build-ru-shift t
    in let w1 = kbl-write t 23 (from-unicode 1030)
    in let w2 = kbl-write t 26 (from-unicode 1031)
    in let w3 = kbl-write t 27 (from-unicode 1168)
    in let w4 = kbl-write t 40 (from-unicode 1028)
    in t

