  kbl-build-uk-base : Integer -> Integer
  kbl-build-uk-base (t) =
    let w0 = kbl-build-us-base t
    in let w1 = kbl-write t 41 (from-unicode 96)
    in let w2 = kbl-write t 43 (from-unicode 35)
    in t

  kbl-build-uk-shift : Integer -> Integer
  kbl-build-uk-shift (t) =
    let w0 = kbl-build-us-shift t
    in let w1 = kbl-write t 3 (from-unicode 34)
    in let w2 = kbl-write t 4 (from-unicode 163)
    in let w3 = kbl-write t 41 (from-unicode 172)
    in let w4 = kbl-write t 40 (from-unicode 64)
    in let w5 = kbl-write t 43 (from-unicode 126)
    in t

