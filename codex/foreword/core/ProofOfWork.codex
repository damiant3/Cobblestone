Chapter: ProofOfWork
  cites Foreword chapter Sha256

 Partial SHA-256 hash collision for trust-network rate-limiting. Given
 a challenge byte list and a difficulty (number of leading zero bits),
 the solver searches for a nonce whose SHA-256 digest of
 challenge & nonce has the required leading zeros.

 To pow-solve gives List Integer,
   searching for a valid nonce up to a maximum number of attempts, returning the 8-byte nonce or an empty list on failure.

 To pow-check gives Boolean,
   verifying that the SHA-256 of the challenge concatenated with the nonce has at least the required number of leading zero bits.

 We say:

Section: Proof-of-Work

  pow-difficulty-bits : Integer, Integer -> Boolean
  pow-difficulty-bits (difficulty) (hash-word) =
    let mask = bit-shl 1 (32 - difficulty) - 1
    in let shifted = bit-shru (bit-and hash-word 4294967295) (32 - difficulty)
    in shifted == 0

  pow-check : List Integer, List Integer, Integer -> Boolean
  pow-check (challenge) (nonce) (difficulty) =
    let input = challenge & nonce
    in let hash = sha256 input
    in pow-check-leading-zeros hash difficulty

  pow-check-leading-zeros : List Integer, Integer -> Boolean
  pow-check-leading-zeros (hash-words) (difficulty) =
    if difficulty <= 0 then True
    else if difficulty >= 32 then
      let first = list-at hash-words 0
      in if first == 0 then pow-check-leading-zeros (pow-tail-words hash-words) (difficulty - 32)
         else False
    else pow-difficulty-bits difficulty (list-at hash-words 0)

  pow-tail-words : List Integer -> List Integer
  pow-tail-words (ws) = pow-tail-loop ws 1 (list-length ws) []

  pow-tail-loop : List Integer, Integer, Integer, List Integer -> List Integer
  pow-tail-loop (ws) (i) (len) (acc) =
    if i == len then acc
    else pow-tail-loop ws (i + 1) len (list-push acc (list-at ws i))

Section: Nonce Search

  pow-solve : List Integer, Integer, Integer -> List Integer
  pow-solve (challenge) (difficulty) (max-attempts) =
    pow-solve-loop challenge difficulty 0 max-attempts

  pow-solve-loop : List Integer, Integer, Integer, Integer -> List Integer
  pow-solve-loop (challenge) (difficulty) (nonce) (max) =
    if nonce >= max then []
    else let nonce-bytes = nonce-to-bytes nonce
    in if pow-check challenge nonce-bytes difficulty then nonce-bytes
       else pow-solve-loop challenge difficulty (nonce + 1) max

  nonce-to-bytes : Integer -> List Integer
  nonce-to-bytes (n) = [
    bit-and n 255,
    bit-and (bit-shru n 8) 255,
    bit-and (bit-shru n 16) 255,
    bit-and (bit-shru n 24) 255,
    bit-and (bit-shru n 32) 255,
    bit-and (bit-shru n 40) 255,
    bit-and (bit-shru n 48) 255,
    bit-and (bit-shru n 56) 255
  ]

