Chapter: EventBus
  cites Foreword chapter Maybe

 We say:

Section: Types
  BusEvent = record {
    evt-topic : Text,
    evt-payload : Text,
    evt-timestamp : Integer
  }

  EventLog = record {
    log-events : List BusEvent,
    log-count : Integer,
    log-max : Integer
  }

Section: Construction
  event-new : Text, Text, Integer -> BusEvent
  event-new (topic) (payload) (ts) = BusEvent { evt-topic = topic, evt-payload = payload, evt-timestamp = ts }

  event-log-new : Integer -> EventLog
  event-log-new (max) = EventLog { log-events = [], log-count = 0, log-max = max }

Section: Logging
  event-log-add : EventLog, BusEvent -> EventLog
  event-log-add (log) (evt) =
    let events = if log.log-count >= log.log-max then list-push (evt-drop-first (log.log-events)) evt
      else list-push (log.log-events) evt
    in let count = if log.log-count >= log.log-max then log.log-max else log.log-count + 1
    in EventLog { log-events = events, log-count = count, log-max = log.log-max }

  evt-drop-first : List BusEvent -> List BusEvent
  evt-drop-first (xs) = evt-drop-loop xs 1 (list-length xs) []

  evt-drop-loop : List BusEvent, Integer, Integer, List BusEvent -> List BusEvent
  evt-drop-loop (xs) (i) (n) (acc) =
    if i >= n then acc
    else evt-drop-loop xs (i + 1) n (list-push acc (list-at xs i))

Section: Queries
  event-log-filter : EventLog, Text -> List BusEvent
  event-log-filter (log) (topic) = evt-filter-loop (log.log-events) topic 0 (log.log-count) []

  evt-filter-loop : List BusEvent, Text, Integer, Integer, List BusEvent -> List BusEvent
  evt-filter-loop (events) (topic) (i) (n) (acc) =
    if i >= n then acc
    else let e = list-at events i
    in let matches = e.evt-topic == topic
    in if matches then evt-filter-loop events topic (i + 1) n (list-push acc e)
    else evt-filter-loop events topic (i + 1) n acc

  event-log-last : EventLog -> Maybe BusEvent
  event-log-last (log) =
    if log.log-count == 0 then None
    else Just (list-at (log.log-events) (log.log-count - 1))

  event-log-since : EventLog, Integer -> List BusEvent
  event-log-since (log) (ts) = evt-since-loop (log.log-events) ts 0 (log.log-count) []

  evt-since-loop : List BusEvent, Integer, Integer, Integer, List BusEvent -> List BusEvent
  evt-since-loop (events) (ts) (i) (n) (acc) =
    if i >= n then acc
    else let e = list-at events i
    in if e.evt-timestamp >= ts then evt-since-loop events ts (i + 1) n (list-push acc e)
    else evt-since-loop events ts (i + 1) n acc

Section: Formatting
  evt-format-event : BusEvent -> Text
  evt-format-event (e) = "[" & show (e.evt-timestamp) & "] " & e.evt-topic & ": " & e.evt-payload

  evt-format-event-log : EventLog -> Text
  evt-format-event-log (log) = show (log.log-count) & "/" & show (log.log-max) & " events"

