Chapter: HeapScrub

Section: Scrub

  heap-scrub-to : Integer -> Integer
  heap-scrub-to (mark) =
    let top = __heap-save
    in if top <= mark then 0 else heap-scrub-do mark (top - mark)

  heap-scrub-do : Integer, Integer -> Integer
  heap-scrub-do (mark) (n) =
    let z = heap-scrub-loop mark n 0
    in let r = __heap-restore mark
    in n

  heap-scrub-loop : Integer, Integer, Integer -> Integer
  heap-scrub-loop (base) (n) (i) =
    if i >= n then 0
    else if i + 8 <= n then let w = poke-qword-zero base i
      in heap-scrub-loop base n (i + 8)
    else let w = poke-byte base i 0
      in heap-scrub-loop base n (i + 1)

  poke-qword-zero : Integer, Integer -> Integer
  poke-qword-zero (base) (off) =
    let a = poke-32 base off 0
    in poke-32 base (off + 4) 0

  heap-region-nonzero : Integer, Integer, Integer, Integer -> Integer
  heap-region-nonzero (base) (n) (i) (acc) =
    if i >= n then acc
    else heap-region-nonzero base n (i + 1) (if peek-byte base i /= 0 then acc + 1 else acc)

