Chapter: Deque
  cites Foreword chapter Maybe
  cites Foreword chapter ListUtils
  cites Foreword chapter MathLib

 We say:

Section: Type
  Deque = record {
    dq-data : List Integer,
    dq-cap : Integer between 1 and 65535,
    dq-head : Integer between 0 and 65535,
    dq-tail : Integer between 0 and 65535,
    dq-count : Integer between 0 and 65535
  }

Section: Construction
  deque-new : Integer -> Deque
  deque-new (cap) = Deque { dq-data = list-zeros cap, dq-cap = __narrow cap, dq-head = 0, dq-tail = 0, dq-count = 0 }

Section: Push
  deque-push-back : Deque, Integer -> Deque
  deque-push-back (dq) (val) =
    if dq.dq-count >= dq.dq-cap then dq
    else Deque { dq-data = list-set-at (dq.dq-data) (dq.dq-tail) val, dq-cap = dq.dq-cap, dq-head = dq.dq-head, dq-tail = __narrow (math-mod (dq.dq-tail + 1) (dq.dq-cap)), dq-count = dq.dq-count + 1 }

  deque-push-front : Deque, Integer -> Deque
  deque-push-front (dq) (val) =
    if dq.dq-count >= dq.dq-cap then dq
    else let new-head = math-mod (dq.dq-head - 1 + dq.dq-cap) (dq.dq-cap)
    in Deque { dq-data = list-set-at (dq.dq-data) new-head val, dq-cap = dq.dq-cap, dq-head = __narrow new-head, dq-tail = dq.dq-tail, dq-count = dq.dq-count + 1 }

Section: Pop
  deque-pop-front : Deque -> (Integer, Deque, Boolean)
  deque-pop-front (dq) =
    if dq.dq-count == 0 then (0, dq, False)
    else let val = list-at (dq.dq-data) (dq.dq-head)
    in (val, Deque { dq-data = dq.dq-data, dq-cap = dq.dq-cap, dq-head = __narrow (math-mod (dq.dq-head + 1) (dq.dq-cap)), dq-tail = dq.dq-tail, dq-count = dq.dq-count - 1 }, True)

  deque-pop-back : Deque -> (Integer, Deque, Boolean)
  deque-pop-back (dq) =
    if dq.dq-count == 0 then (0, dq, False)
    else let new-tail = math-mod (dq.dq-tail - 1 + dq.dq-cap) (dq.dq-cap)
    in let val = list-at (dq.dq-data) new-tail
    in (val, Deque { dq-data = dq.dq-data, dq-cap = dq.dq-cap, dq-head = dq.dq-head, dq-tail = __narrow new-tail, dq-count = dq.dq-count - 1 }, True)

  deque-peek-front : Deque -> Maybe Integer
  deque-peek-front (dq) =
    if dq.dq-count == 0 then None
    else Just (list-at (dq.dq-data) (dq.dq-head))

  deque-peek-back : Deque -> Maybe Integer
  deque-peek-back (dq) =
    if dq.dq-count == 0 then None
    else Just (list-at (dq.dq-data) (math-mod (dq.dq-tail - 1 + dq.dq-cap) (dq.dq-cap)))

Section: Helpers
  deque-count : Deque -> Integer
  deque-count (dq) = dq.dq-count

  deque-is-empty : Deque -> Boolean
  deque-is-empty (dq) = dq.dq-count == 0

  deque-is-full : Deque -> Boolean
  deque-is-full (dq) = dq.dq-count == dq.dq-cap

