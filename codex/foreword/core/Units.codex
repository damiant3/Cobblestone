Chapter: Units

 Standard physical units as unit families. Cite this chapter to get
 type-safe domain-polymorphic units. Functions take the FAMILY name
 (e.g., Length, Duration) and accept any member unit. Conversion
 happens at construction time -- zero cost at call sites.

 Families are organized by scale to avoid 64-bit overflow. Human-scale
 lengths (mm through miles) share a family. Astronomical distances
 (AU, light-year, parsec) share a separate family with km as base.

Section: Duration (base: nanosecond)

  Duration = unit family Nanosecond
    Nanosecond = 1
    Microsecond = 1000
    Millisecond = 1000000
    Second = 1000000000
    Minute = 60000000000
    Hour = 3600000000000

Section: LongDuration (base: second)

  LongDuration = unit family LongSecond
    LongSecond = 1
    LongMinute = 60
    LongHour = 3600
    Day = 86400
    Week = 604800
    Month = 2592000
    Year = 31557600
    Century = 3155760000

Section: Length (base: millimeter)

  Length = unit family Millimeter
    Millimeter = 1
    Centimeter = 10
    Meter = 1000
    Kilometer = 1000000
    Inch = 25
    Foot = 305
    Yard = 914
    Mile = 1609344
    NauticalMile = 1852000

Section: AstroDistance (base: kilometer)

  AstroDistance = unit family AstroKm
    AstroKm = 1
    AstroMile = 1
    EarthRadius = 6371
    LunarDistance = 384400
    AU = 149597871
    LightMinute = 17987547
    LightHour = 1079252849
    LightYear = 9460730472581

Section: MicroLength (base: picometer)

  MicroLength = unit family Picometer
    Picometer = 1
    Angstrom = 100
    Nanometer = 1000
    Micrometer = 1000000
    MicroMm = 1000000000

Section: Mass (base: milligram)

  Mass = unit family Milligram
    Milligram = 1
    Gram = 1000
    Kilogram = 1000000
    MetricTon = 1000000000
    Ounce = 28350
    Pound = 453592
    Stone = 6350293

Section: Temperature (non-linear, manual conversions)

  Kelvin = unit Integer
  Celsius = unit Integer
  Fahrenheit = unit Integer

  Celsius-to-Kelvin : Celsius -> Kelvin
  Celsius-to-Kelvin (c) = Kelvin (c + 273)

  Kelvin-to-Celsius : Kelvin -> Celsius
  Kelvin-to-Celsius (k) = Celsius (k - 273)

  Celsius-to-Fahrenheit : Celsius -> Fahrenheit
  Celsius-to-Fahrenheit (c) = Fahrenheit (c * 9 / 5 + 32)

  Fahrenheit-to-Celsius : Fahrenheit -> Celsius
  Fahrenheit-to-Celsius (f) = Celsius ((f - 32) * 5 / 9)

Section: Speed (base: mm/s)

  Speed = unit family MmPerSec
    MmPerSec = 1
    MeterPerSec = 1000
    KmPerHour = 278
    MilePerHour = 447
    Knot = 514
    SpeedOfSound = 343000

Section: DataSize (base: byte)

  DataSize = unit family DataByte
    DataByte = 1
    Kilobyte = 1024
    Megabyte = 1048576
    Gigabyte = 1073741824
    Terabyte = 1099511627776

Section: DataRate (base: bit/s)

  DataRate = unit family BitPerSec
    BitPerSec = 1
    KilobitPerSec = 1000
    MegabitPerSec = 1000000
    GigabitPerSec = 1000000000
    BytePerSec = 8
    MegabytePerSec = 8388608

Section: Frequency (base: hertz)

  Frequency = unit family Hertz
    Hertz = 1
    Kilohertz = 1000
    Megahertz = 1000000
    Gigahertz = 1000000000
    Terahertz = 1000000000000

Section: Energy (base: millijoule)

  Energy = unit family Millijoule
    Millijoule = 1
    Joule = 1000
    Kilojoule = 1000000
    Calorie = 4184
    Kilocalorie = 4184000
    BTU = 1055060
    KilowattHour = 3600000000

Section: Force (base: millinewton)

  Force = unit family Millinewton
    Millinewton = 1
    Newton = 1000
    Kilonewton = 1000000
    PoundForce = 4448

Section: Power (base: milliwatt)

  Power = unit family Milliwatt
    Milliwatt = 1
    Watt = 1000
    Kilowatt = 1000000
    Megawatt = 1000000000
    Gigawatt = 1000000000000
    Horsepower = 745700

Section: Pressure (base: pascal)

  Pressure = unit family Pascal
    Pascal = 1
    Kilopascal = 1000
    PSI = 6895
    Torr = 133
    Bar = 100000
    Atmosphere = 101325

Section: Voltage (base: microvolt)

  Voltage = unit family Microvolt
    Microvolt = 1
    Millivolt = 1000
    Volt = 1000000
    Kilovolt = 1000000000

Section: Current (base: microamp)

  Current = unit family Microamp
    Microamp = 1
    Milliamp = 1000
    Amp = 1000000

Section: Resistance (base: milliohm)

  Resistance = unit family Milliohm
    Milliohm = 1
    Ohm = 1000
    Kilohm = 1000000
    Megohm = 1000000000

Section: Capacitance (base: picofarad)

  Capacitance = unit family Picofarad
    Picofarad = 1
    Nanofarad = 1000
