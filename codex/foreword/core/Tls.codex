Chapter: Tls
  cites Foreword chapter CCE
  cites Foreword chapter AesGcm
  cites Foreword chapter Sha256
  cites Foreword chapter Hmac
  cites Foreword chapter Hkdf
  cites Foreword chapter DiffieHellman
  cites Foreword chapter Maybe
  cites Foreword chapter ListUtils

 TLS 1.3 record layer and handshake protocol per RFC 8446. Supports
 ChaCha20-Poly1305 and AES-128-GCM cipher suites. Builds and parses
 TLS record bytes for integration with a TCP transport. Key exchange
 uses X25519; key derivation uses HKDF-SHA256.

 A TlsRecord is a record containing:
   tls-rec-type    -- content type (handshake, application, alert).
   tls-rec-version -- protocol version.
   tls-rec-payload -- raw payload bytes.

 A TlsClientHello is a record containing:
   tch-random       -- 32-byte client random.
   tch-session-id   -- legacy session identifier.
   tch-cipher-suites -- list of cipher suite codes.
   tch-key-share    -- X25519 public key bytes.
   tch-server-name  -- SNI hostname.

 A TlsState is a record containing:
   tls-client-random, tls-server-random -- random values.
   tls-my-private, tls-my-public       -- local X25519 key pair.
   tls-peer-public                     -- peer's X25519 public key.
   tls-shared-secret                   -- derived shared secret.
   tls-cipher-suite                    -- negotiated cipher suite.
   tls-connected                       -- handshake completion flag.

 A TlsKeyMaterial is a record containing:
   tkm-client-key, tkm-server-key -- symmetric keys for each direction.
   tkm-handshake-secret           -- intermediate HKDF secret.

 To tls-encode-record gives List Integer,
   wrapping a payload in a TLS record header with type, version, length, and data.

 To tls-decode-record gives TlsRecord,
   parsing a TLS record from raw bytes.

 To tls-build-client-hello gives List Integer,
   serializing a ClientHello message into a complete TLS record.

 To tls13-expand-label gives List Integer,
   performing HKDF-Expand-Label per RFC 8446 section 7.1 over the real foreword HKDF.

 To tls13-derive-secret gives List Integer,
   performing Derive-Secret: HKDF-Expand-Label over a transcript hash, one hash length wide.

 To tls-derive-keys gives TlsKeyMaterial,
   running the RFC 8446 key schedule from the X25519 shared secret and the transcript hash to the two handshake write keys.

 To tls-init-client gives TlsState,
   creating initial client-side TLS state from a private key.

 To tls-complete-handshake gives TlsState,
   completing the handshake by computing the shared secret from the server's public key.

 To format-tls-state gives Text,
   formatting TLS state as a diagnostic string.

 To format-tls-record gives Text,
   formatting a TLS record header as a diagnostic string.

 We say:

Section: Constants
  tls-version-12 : Integer = 771
  tls-version-13 : Integer = 772

  tls-content-change-cipher : Integer = 20
  tls-content-alert : Integer = 21
  tls-content-handshake : Integer = 22
  tls-content-application : Integer = 23

  tls-handshake-client-hello : Integer = 1
  tls-handshake-server-hello : Integer = 2
  tls-handshake-encrypted-ext : Integer = 8
  tls-handshake-certificate : Integer = 11
  tls-handshake-cert-verify : Integer = 15
  tls-handshake-finished : Integer = 20

  tls-cipher-aes-128-gcm-sha256 : Integer = 4865
  tls-cipher-chacha20-poly1305 : Integer = 4867

  tls-ext-server-name : Integer = 0
  tls-ext-supported-versions : Integer = 43
  tls-ext-key-share : Integer = 51
  tls-ext-supported-groups : Integer = 10
  tls-ext-signature-algorithms : Integer = 13

 The signature schemes this stack can verify. The extension says what we
 can actually check, and it has to stay honest in both directions:
 advertising a scheme we cannot verify invites a server to present a
 signature we then refuse, and omitting one we CAN verify turns a server
 we could have talked to into a handshake failure.

 RFC 8446 section 4.4.3 forbids PKCS#1 v1.5 in a CertificateVerify however
 the certificate chain itself was signed, which is why the RSA entry is
 rsa_pss_rsae_sha256 and 0x0401 appears nowhere here.

 ecdsa_secp384r1_sha384 names the curve and the digest together because
 RFC 8446 section 4.2.3 defines the code point that way. The digest is
 not a free choice made alongside the curve; it is half of the scheme.

  tls-sig-ed25519 : Integer = 2055
  tls-sig-ecdsa-p256-sha256 : Integer = 1027
  tls-sig-ecdsa-p384-sha384 : Integer = 1283
  tls-sig-rsa-pss-sha256 : Integer = 2052

  tls-group-x25519 : Integer = 29

Section: Types
  TlsRecord = record {
    tls-rec-type : Integer,
    tls-rec-version : Integer,
    tls-rec-payload : List Integer
  }

  TlsClientHello = record {
    tch-random : List Integer,
    tch-session-id : List Integer,
    tch-cipher-suites : List Integer,
    tch-key-share : List Integer,
    tch-server-name : Text
  }

  TlsState = record {
    tls-client-random : List Integer,
    tls-server-random : List Integer,
    tls-my-private : List Integer,
    tls-my-public : List Integer,
    tls-peer-public : List Integer,
    tls-shared-secret : List Integer,
    tls-cipher-suite : Integer,
    tls-connected : Boolean
  }

Section: Record Layer
  tls-encode-record : Integer, List Integer -> List Integer
  tls-encode-record (content-type) (payload) =
    let len = list-length payload
    in [content-type, 3, 3] & tls-be16 len & payload

  tls-decode-record : List Integer -> TlsRecord
  tls-decode-record (bytes) =
    let rec-type = list-at bytes 0
    in let version = bit-or (bit-shl (list-at bytes 1) 8) (list-at bytes 2)
    in let len = bit-or (bit-shl (list-at bytes 3) 8) (list-at bytes 4)
    in let payload = tls-slice bytes 5 len []
    in TlsRecord { tls-rec-type = rec-type, tls-rec-version = version, tls-rec-payload = payload }

Section: Client Hello
  tls-build-client-hello : TlsClientHello -> List Integer
  tls-build-client-hello (hello) =
    let body = [3, 3] & hello.tch-random & [32] & hello.tch-session-id & tls-encode-cipher-suites (hello.tch-cipher-suites) & [1, 0] & tls-build-extensions hello
    in let handshake = [tls-handshake-client-hello] & tls-be24 (list-length body) & body
    in tls-encode-record tls-content-handshake handshake

  tls-encode-cipher-suites : List Integer -> List Integer
  tls-encode-cipher-suites (suites) =
    let data = tls-cs-loop suites 0 (list-length suites) []
    in tls-be16 (list-length data) & data

  tls-cs-loop : List Integer, Integer, Integer, List Integer -> List Integer
  tls-cs-loop (suites) (i) (n) (acc) =
    if i >= n then acc
    else tls-cs-loop suites (i + 1) n (acc & tls-be16 (list-at suites i))

  tls-build-extensions : TlsClientHello -> List Integer
  tls-build-extensions (hello) =
    let sni = tls-ext-sni (hello.tch-server-name)
    in let versions = tls-ext-versions
    in let groups = tls-ext-groups
    in let sigalgs = tls-ext-sig-algs
    in let ks = tls-ext-key-share-client (hello.tch-key-share)
    in let ext-data = sni & versions & groups & sigalgs & ks
    in tls-be16 (list-length ext-data) & ext-data

Section: Extensions
  tls-ext-sni : Text -> List Integer
  tls-ext-sni (hostname) =
    let name-bytes = tls-text-to-bytes hostname
    in let name-len = list-length name-bytes
    in let entry = [0] & tls-be16 name-len & name-bytes
    in let list-data = tls-be16 (list-length entry) & entry
    in tls-be16 tls-ext-server-name & tls-be16 (list-length list-data) & list-data

  tls-ext-versions : List Integer
  tls-ext-versions =
    let data = [2, 3, 4]
    in tls-be16 tls-ext-supported-versions & tls-be16 (list-length data) & data

  tls-ext-groups : List Integer
  tls-ext-groups =
    let data = tls-be16 2 & tls-be16 tls-group-x25519
    in tls-be16 tls-ext-supported-groups & tls-be16 (list-length data) & data

 SIGNATURE_ALGORITHMS IS MANDATORY IN A CLIENTHELLO. RFC 8446 section 9.2
 requires it of any client that offers certificate authentication, and a
 conforming server MUST abort the handshake without it. This extension was
 absent until 2026-07-23 and no test could see that: our own server does
 not inspect it, so a loopback handshake completed perfectly, and the only
 interop harness in the tree drove our SERVER with openssl's client. Our
 CLIENT had never met a conforming server.

 mosquitto's OpenSSL says what it is: `missing sigalgs extension`, then
 `disconnected: protocol error`. Nothing came back on the wire -- an
 abort with no alert -- which from the client's seat is indistinguishable
 from a server that simply never answered.

 The list is in descending order of preference (RFC 8446 section 4.2.3),
 though a server chooses by what its certificate can do and not by what we
 prefer, so the order costs nothing either way.

  tls-ext-sig-algs : List Integer
  tls-ext-sig-algs =
    let schemes = tls-be16 tls-sig-ed25519 & tls-be16 tls-sig-ecdsa-p256-sha256 & tls-be16 tls-sig-ecdsa-p384-sha384 & tls-be16 tls-sig-rsa-pss-sha256
    in let list-data = tls-be16 (list-length schemes) & schemes
    in tls-be16 tls-ext-signature-algorithms & tls-be16 (list-length list-data) & list-data

  tls-ext-key-share-client : List Integer -> List Integer
  tls-ext-key-share-client (public-key) =
    let entry = tls-be16 tls-group-x25519 & tls-be16 32 & public-key
    in let entries = tls-be16 (list-length entry) & entry
    in tls-be16 tls-ext-key-share & tls-be16 (list-length entries) & entries

Section: Key Material

  TlsKeyMaterial = record {
    tkm-client-key : List Integer,
    tkm-server-key : List Integer,
    tkm-handshake-secret : List Integer
  }

Section: State Management
  tls-init-client : List Integer -> TlsState
  tls-init-client (private-key) =
    let public = x25519-public-key private-key
    in TlsState { tls-client-random = list-zeros 32, tls-server-random = [], tls-my-private = private-key, tls-my-public = public, tls-peer-public = [], tls-shared-secret = [], tls-cipher-suite = tls-cipher-chacha20-poly1305, tls-connected = False }

  tls-complete-handshake : TlsState, List Integer -> TlsState
  tls-complete-handshake (state) (server-public) =
    let shared = x25519-shared-secret (state.tls-my-private) server-public
    in TlsState { tls-client-random = state.tls-client-random, tls-server-random = state.tls-server-random, tls-my-private = state.tls-my-private, tls-my-public = state.tls-my-public, tls-peer-public = server-public, tls-shared-secret = shared, tls-cipher-suite = state.tls-cipher-suite, tls-connected = True }

Section: Helpers
  tls-be16 : Integer -> List Integer
  tls-be16 (v) = [bit-and (bit-shru v 8) 255, bit-and v 255]

  tls-be24 : Integer -> List Integer
  tls-be24 (v) = [bit-and (bit-shru v 16) 255, bit-and (bit-shru v 8) 255, bit-and v 255]

  tls-slice : List Integer, Integer, Integer, List Integer -> List Integer
  tls-slice (data) (start) (len) (acc) =
    if len <= 0 then acc
    else if start >= list-length data then acc
    else tls-slice data (start + 1) (len - 1) (list-push acc (list-at data start))

  tls-take-bytes : List Integer, Integer -> List Integer
  tls-take-bytes (bytes) (n) = tls-slice bytes 0 n []

 tls-text-to-bytes is what puts the SNI hostname on the wire, so it must
 emit ASCII. It used to be tls-t2b -- bare char-code, which yields the
 CCE code point, not the byte a peer expects. `example.com` went out as
 CCE and no server could have matched it. Same defect as the key-schedule
 labels, same fix: convert at the I/O boundary.

 tls-t2b is kept, unexported in spirit, ONLY as the pin in
 codex/test/tls13-schedule.codex that demonstrates the trap. Do not reach
 for it to build wire bytes.

  tls-text-to-bytes : Text -> List Integer
  tls-text-to-bytes (s) = tls13-ascii s

  tls-t2b : Text, Integer, Integer, List Integer -> List Integer
  tls-t2b (s) (i) (len) (acc) =
    if i >= len then acc
    else tls-t2b s (i + 1) len (list-push acc (char-code (char-at s i)))

Section: Formatting
  format-tls-state : TlsState -> Text
  format-tls-state (s) =
    "tls: cipher=" & show (s.tls-cipher-suite) & " connected=" & show (s.tls-connected) & " pubkey=" & show (list-length (s.tls-my-public)) & "B"

  format-tls-record : TlsRecord -> Text
  format-tls-record (r) =
    let type-name = if r.tls-rec-type == 22 then "handshake" else if r.tls-rec-type == 23 then "application" else if r.tls-rec-type == 21 then "alert" else "type-" & show (r.tls-rec-type)
    in type-name & " v=" & show (r.tls-rec-version) & " len=" & show (list-length (r.tls-rec-payload))

Section: TLS 1.3 Key Schedule

 The real one, RFC 8446 section 7.1, over the real foreword HKDF (RFC
 5869, counter-chained). It is gated on the published handshake trace in
 RFC 8448 -- every secret, key and IV below is checked against a value
 the IETF printed, not against this chapter agreeing with itself.

 This section replaces two earlier ones, and it is worth recording what
 they did, because both were wrong in ways that looked right:

 The first defined its own tls-hkdf-expand as a single HMAC block with a
 hardcoded counter of 1 -- not HKDF-Expand at all. It silently returned
 SHORT for any request above 32 bytes rather than failing, and
 tls-derive-keys built the handshake keys on it using ad-hoc labels
 ("c hs", "s hs") that appear in no specification. Deleted.

 The second was structurally correct but computed the early secret as
 HKDF-Extract(0, [0]) -- a ONE-byte IKM. RFC 8446 writes that input as
 "0", meaning a string of Hash.length zero bytes; a single zero byte is a
 different number and produces a different early secret, and therefore a
 different everything. Fixed here, and the RFC 8448 vector is what
 catches it.

  tls13-hkdf-label : List Integer, List Integer, Integer -> List Integer
  tls13-hkdf-label (label) (context) (length) =
    let hi = bit-and (bit-shru length 8) 255
    in let lo = bit-and length 255
    in [hi, lo] & [6 + list-length label] & [116, 108, 115, 49, 51, 32] & label & [list-length context] & context

 The label goes on the wire as ASCII, and Codex Text is CCE. `char-code`
 alone returns the CCE code point -- for "derived" that is
 16 0d 15 11 21 0d 16, not the 64 65 72 69 76 65 64 the RFC means. The
 conversion at the I/O boundary is `to-unicode`, and skipping it is the
 whole reason this chapter's key schedule was wrong below the first rung:
 every secret after the early secret is derived through a label, so one
 mis-encoded label silently poisons everything downstream while still
 producing 32 confident-looking bytes.

  tls13-ascii : Text -> List Integer
  tls13-ascii (s) = tls13-ascii-loop s 0 (text-length s) []

  tls13-ascii-loop : Text, Integer, Integer, List Integer -> List Integer
  tls13-ascii-loop (s) (i) (n) (acc) =
    if i >= n then acc
    else tls13-ascii-loop s (i + 1) n (list-push acc (to-unicode (char-code (char-at s i))))

  tls13-expand-label : List Integer, Text, List Integer, Integer -> List Integer
  tls13-expand-label (secret) (label) (context) (length) =
    hkdf-expand secret (tls13-hkdf-label (tls13-ascii label) context length) length

 Derive-Secret(Secret, Label, Messages) = HKDF-Expand-Label(Secret,
 Label, Transcript-Hash(Messages), Hash.length). The context is a hash,
 never the messages themselves.

  tls13-derive-secret : List Integer, Text, List Integer -> List Integer
  tls13-derive-secret (secret) (label) (messages-hash) =
    tls13-expand-label secret label messages-hash 32

 A trap worth naming, because it cost real time and it will cost the
 next reader the same: the foreword `sha256` returns the compressor's
 internal state, which is eight 32-bit WORDS, not thirty-two bytes.
 `sha256-to-hex` renders it with `words-to-hex`, and `Hkdf` wraps every
 hash it touches in `hkdf-words-to-bytes` for exactly this reason. Feed
 the word list into a key schedule as if it were bytes and you get
 plausible-looking key material that is wrong from the second rung down.
 tls13-hash is the byte-valued hash; use it, and never `sha256` directly,
 anywhere a transcript hash is wanted.

  tls13-hash : List Integer -> List Integer
  tls13-hash (msg) = hkdf-words-to-bytes (sha256 msg)

 The schedule proper. Each step is one line of RFC 8446's ladder.

  tls13-early-secret : List Integer
  tls13-early-secret = hkdf-extract (list-zeros 32) (list-zeros 32)

  tls13-derived : List Integer
  tls13-derived = tls13-derive-secret tls13-early-secret "derived" (tls13-hash [])

  tls13-handshake-secret : List Integer -> List Integer
  tls13-handshake-secret (ecdhe) = hkdf-extract tls13-derived ecdhe

  tls13-client-hs-traffic : List Integer, List Integer -> List Integer
  tls13-client-hs-traffic (hs-secret) (transcript-hash) =
    tls13-derive-secret hs-secret "c hs traffic" transcript-hash

  tls13-server-hs-traffic : List Integer, List Integer -> List Integer
  tls13-server-hs-traffic (hs-secret) (transcript-hash) =
    tls13-derive-secret hs-secret "s hs traffic" transcript-hash

 A traffic secret is not a key. The write key and IV are expanded out of
 it with an EMPTY context -- a detail that is easy to get wrong by
 passing the transcript hash again, which yields plausible bytes that
 decrypt nothing.

  tls13-traffic-key : List Integer -> List Integer
  tls13-traffic-key (traffic-secret) = tls13-expand-label traffic-secret "key" [] 16

  tls13-traffic-iv : List Integer -> List Integer
  tls13-traffic-iv (traffic-secret) = tls13-expand-label traffic-secret "iv" [] 12

 tls-derive-keys is the whole ladder in one call: the X25519 shared
 secret and the ClientHello..ServerHello transcript hash in, the two
 handshake write keys out.

  tls-derive-keys : List Integer, List Integer -> TlsKeyMaterial
  tls-derive-keys (ecdhe) (transcript-hash) =
    let hs = tls13-handshake-secret ecdhe
    in let c = tls13-client-hs-traffic hs transcript-hash
    in let s = tls13-server-hs-traffic hs transcript-hash
    in TlsKeyMaterial { tkm-client-key = tls13-traffic-key c, tkm-server-key = tls13-traffic-key s, tkm-handshake-secret = hs }

Section: TLS 1.3 Transcript And Finished

 RFC 8446 sections 4.4.4 and 4.4.1. These lived in Encode chapter
 DtlsMessage under dtls- names because DTLS is where a handshake was
 first driven to completion, and DTLS 1.3 inherits both of them from TLS
 1.3 unchanged. Nothing here is about datagrams: TlsEndpoint, which
 speaks TLS over TCP, was reaching into a DTLS chapter to hash a
 transcript. They belong here, beside the key schedule they are derived
 from.

 The transcript form is the TLS 1.3 one -- a type byte, a uint24 length
 and the body. DTLS carries a message_seq and fragment fields on the
 wire and RFC 9147 section 5.2 is explicit that none of them may be fed
 to the handshake hash, so a DTLS message is stripped back to THIS shape
 before hashing. That is why the DTLS chapter's own transcript function
 was already producing the TLS form.

  tls13-msg-transcript : Integer, List Integer -> List Integer
  tls13-msg-transcript (msg-type) (body) =
    [msg-type] & tls-be24 (list-length body) & body

 Messages accumulate as a running concatenation, hashed on demand:
 SHA-256 here has no incremental interface, so the transcript is held
 whole. It is a few kilobytes for a real handshake and it is the one
 multi-KB transient in the stack.

  tls13-transcript-add : List Integer, Integer, List Integer -> List Integer
  tls13-transcript-add (acc) (msg-type) (body) = acc & tls13-msg-transcript msg-type body

  tls13-transcript-hash : List Integer -> List Integer
  tls13-transcript-hash (acc) = hkdf-words-to-bytes (sha256 acc)

 THE HELLORETRYREQUEST TRANSCRIPT, RFC 8446 section 4.4.1. When a
 HelloRetryRequest happens, ClientHello1 does NOT stay in the transcript.
 It is REPLACED by a synthetic message: handshake type 254
 (message_hash), a uint24 length of 32, and the hash of ClientHello1. The
 transcript then continues with the HelloRetryRequest and the second
 ClientHello.

 Miss this and the Finished computes correctly on the no-retry path and
 wrongly on the retry path, so a test that never exercises a
 HelloRetryRequest passes and then fails against every server that asks
 for one. The bug hides exactly where the feature lives.

  tls13-msg-message-hash : Integer = 254

  tls13-transcript-after-hrr : List Integer -> List Integer
  tls13-transcript-after-hrr (ch1-transcript) =
    tls13-transcript-after-hrr-hash (tls13-transcript-hash ch1-transcript)

 A stateless server does not HAVE ClientHello1 by the time it needs this
 -- keeping it is precisely the state a cookie exists to avoid. RFC 8446
 section 4.2.2 gives the answer: the server puts the ClientHello1 hash
 inside the cookie and gets it back with the second ClientHello. So the
 hash, not the message, is what this takes.

  tls13-transcript-after-hrr-hash : List Integer -> List Integer
  tls13-transcript-after-hrr-hash (ch1-hash) =
    [tls13-msg-message-hash] & tls-be24 32 & ch1-hash

 The Finished, RFC 8446 section 4.4.4:

   finished_key = HKDF-Expand-Label(BaseKey, "finished", "", Hash.length)
   verify_data  = HMAC(finished_key, Transcript-Hash(...))

 The context on the finished key is EMPTY. The transcript hash is the
 HMAC message, not the key's context. Transposing them yields 32 bytes
 that look exactly as much like a key, and a peer that rejects them tells
 you nothing about which of the two you got wrong. The gate on this is
 RFC 8448's published finished_key.

  tls13-finished-key : List Integer -> List Integer
  tls13-finished-key (base-secret) = tls13-expand-label base-secret "finished" [] 32

  tls13-verify-data : List Integer, List Integer -> List Integer
  tls13-verify-data (base-secret) (transcript-hash) =
    hkdf-words-to-bytes (hmac-sha256 (tls13-finished-key base-secret) transcript-hash)

 Verification is constant-time. A Finished check that returns on the
 first differing byte leaks how much of a forgery was right.

  tls13-finished-ok : List Integer, List Integer, List Integer -> Boolean
  tls13-finished-ok (base-secret) (transcript-hash) (offered) =
    tls13-ct-equal (tls13-verify-data base-secret transcript-hash) offered

  tls13-ct-equal : List Integer, List Integer -> Boolean
  tls13-ct-equal (a) (b) =
    if list-length a /= list-length b then False
    else tls13-ct-loop a b 0 (list-length a) 0

  tls13-ct-loop : List Integer, List Integer, Integer, Integer, Integer -> Boolean
  tls13-ct-loop (a) (b) (i) (n) (diff) =
    if i >= n then diff == 0
    else tls13-ct-loop a b (i + 1) n (bit-or diff (bit-xor (list-at a i) (list-at b i)))

Section: TLS 1.3 Application Secrets

 The rungs above the handshake secret. RFC 8446 section 7.1: the master
 secret is HKDF-Extract of a zero IKM keyed by Derive-Secret(handshake,
 "derived", ""), and the two application traffic secrets come off the
 master over the transcript hash taken through the server's Finished --
 the same hash the client's own Finished is computed over. These are what
 protect application data, so a handshake that stops at the handshake
 traffic secrets (as the DTLS endpoint does) cannot carry a byte of it.

  tls13-master-secret : List Integer -> List Integer
  tls13-master-secret (hs-secret) =
    hkdf-extract (tls13-derive-secret hs-secret "derived" (tls13-hash [])) (list-zeros 32)

  tls13-client-ap-traffic : List Integer, List Integer -> List Integer
  tls13-client-ap-traffic (master) (transcript-hash) =
    tls13-derive-secret master "c ap traffic" transcript-hash

  tls13-server-ap-traffic : List Integer, List Integer -> List Integer
  tls13-server-ap-traffic (master) (transcript-hash) =
    tls13-derive-secret master "s ap traffic" transcript-hash

Section: TLS 1.3 Record Layer

 A TLS 1.3 record on the wire is application_data (23), legacy version
 0x0303, a length, then AEAD-Encrypt over the TLSInnerPlaintext -- the
 real content, one byte naming the real content type, and zero padding.
 The AEAD's additional data is the five-byte record header, length
 INCLUDED: leave the length unauthenticated and an attacker rewrites it
 and the AEAD never notices. RFC 8446 section 7.5 / 5.2. This is
 AES-128-GCM; the ChaCha20-Poly1305 suite is the same shape over the
 other open/seal pair.

 Decrypt returns None on a tag mismatch, and that None is the whole
 security property, not an error to paper over: a record that does not
 authenticate yields no plaintext, not partial plaintext.

  TlsInner = record {
    ti-type : Integer,
    ti-data : List Integer
  }

  tls13-rec-nonce : List Integer, Integer -> List Integer
  tls13-rec-nonce (iv) (seq) = tls13-xor-nonce iv seq

  tls13-rec-aad : Integer -> List Integer
  tls13-rec-aad (enc-len) =
    [tls-content-application, 3, 3, bit-and (bit-shru enc-len 8) 255, bit-and enc-len 255]

  tls13-record-encrypt : List Integer, List Integer, Integer, Integer, List Integer -> List Integer
  tls13-record-encrypt (key) (iv) (seq) (content-type) (content) =
    let inner = content & [content-type]
    in let enc-len = list-length inner + 16
    in let r = aesgcm-encrypt key (tls13-rec-nonce iv seq) inner (tls13-rec-aad enc-len)
    in tls13-rec-aad enc-len & r.ciphertext & r.tag

  tls13-record-decrypt : List Integer, List Integer, Integer, List Integer -> Maybe TlsInner
  tls13-record-decrypt (key) (iv) (seq) (wire) =
    if list-length wire < 6 then None
    else let enc-len = list-at wire 3 * 256 + list-at wire 4
    in if enc-len < 17 then None
    else if 5 + enc-len > list-length wire then None
    else let aad = tls-take-bytes wire 5
    in let enc = tls-slice wire 5 enc-len []
    in let ct = tls-take-bytes enc (enc-len - 16)
    in let tag = tls-slice enc (enc-len - 16) 16 []
    in when aesgcm-decrypt key (tls13-rec-nonce iv seq) ct aad tag
      is Just (inner) -> tls13-strip-inner inner
      is None -> None

  tls13-strip-inner : List Integer -> Maybe TlsInner
  tls13-strip-inner (inner) =
    let p = tls13-last-nonzero inner (list-length inner - 1)
    in if p < 0 then None
    else Just (TlsInner { ti-type = list-at inner p, ti-data = tls-take-bytes inner p })

  tls13-last-nonzero : List Integer, Integer -> Integer
  tls13-last-nonzero (bs) (i) =
    if i < 0 then (-1)
    else if list-at bs i /= 0 then i
    else tls13-last-nonzero bs (i - 1)

  tls13-xor-nonce : List Integer, Integer -> List Integer
  tls13-xor-nonce (base-nonce) (seq) =
    tls-xor-nonce-loop base-nonce seq 0 (list-length base-nonce) []

  tls-xor-nonce-loop : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  tls-xor-nonce-loop (base) (seq) (i) (len) (acc) =
    if i >= len then acc
    else let seq-byte = if i >= len - 8 then bit-and (bit-shru seq ((len - 1 - i) * 8)) 255 else 0
    in tls-xor-nonce-loop base seq (i + 1) len (list-push acc (bit-xor (list-at base i) seq-byte))

