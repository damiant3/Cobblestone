 We say:

Section: Types

  Fat16Volume = record {
    vol-part-start : Integer,
    vol-bytes-per-sector : Integer,
    vol-sectors-per-cluster : Integer,
    vol-reserved-sectors : Integer,
    vol-num-fats : Integer,
    vol-root-entry-count : Integer,
    vol-fat-sectors : Integer,
    vol-fat-start : Integer,
    vol-root-start : Integer,
    vol-data-start : Integer,
    vol-total-sectors : Integer,
    vol-cluster-count : Integer
  }

  Fat16DirEntry = record {
    de-name : Text,
    de-attr : Integer,
    de-cluster : Integer,
    de-size : Integer
  }

Section: BPB Parsing

  fat16-read-u16 : Integer, Integer -> Integer
  fat16-read-u16 (buf) (off) =
    bit-or (peek-byte buf off) (bit-shl (peek-byte buf (off + 1)) 8)

  fat16-read-u32 : Integer, Integer -> Integer
  fat16-read-u32 (buf) (off) =
    bit-or (fat16-read-u16 buf off) (bit-shl (fat16-read-u16 buf (off + 2)) 16)

  fat16-init : Integer -> [Device.Block] Fat16Volume
  fat16-init (part-start) = act
    buf <- block-read-sector part-start
    fat16-parse-bpb part-start buf
  end

 A boot record that does not parse is an unusable volume, not a fault.
 With no disk attached the block device hands back a sector of zeroes, and
 bytes-per-sector reads 0 -- the very number the root-directory size is
 divided by, two lines down. Dividing there takes the machine out with
 !EXC=00, so the sector must be refused before the arithmetic, not after
 it: nothing downstream gets the chance to notice a bad volume if reaching
 the volume is what crashed.

  fat16-zero-volume : Integer -> Fat16Volume
  fat16-zero-volume (part-start) =
    Fat16Volume {
      vol-part-start = part-start,
      vol-bytes-per-sector = 0,
      vol-sectors-per-cluster = 0,
      vol-reserved-sectors = 0,
      vol-num-fats = 0,
      vol-root-entry-count = 0,
      vol-fat-sectors = 0,
      vol-fat-start = 0,
      vol-root-start = 0,
      vol-data-start = 0,
      vol-total-sectors = 0,
      vol-cluster-count = 0
    }

 The cluster count is computed from BPB fields the image supplies -- a
 declared total-sector count sets it, and everything derived from it. The FAT
 specification caps a FAT16 volume at 65524 data clusters; past that the
 format is FAT32 and not what this BPB claims. So a count above the format's
 own maximum is refused down to that maximum, which is what makes
 `fat16-chain-fuel` a bound rather than a number the image chooses.

  fat16-parse-bpb : Integer, Integer -> Fat16Volume
  fat16-parse-bpb (part-start) (buf) =
    let bps = fat16-read-u16 buf 11
    in let spc = peek-byte buf 13
    in if bps == 0 then fat16-zero-volume part-start
    else if spc == 0 then fat16-zero-volume part-start
    else let reserved = fat16-read-u16 buf 14
    in let nfats = peek-byte buf 16
    in let root-cnt = fat16-read-u16 buf 17
    in let fat-sz = fat16-read-u16 buf 22
    in let fat-start = part-start + reserved
    in let root-dir-sectors = (root-cnt * 32 + bps - 1) / bps
    in let root-start = fat-start + nfats * fat-sz
    in let data-start = root-start + root-dir-sectors
    in let total = fat16-total-sectors buf
    in let data-sectors = total - (data-start - part-start)
    in let raw-clusters = if data-sectors <= 0 then 0 else data-sectors / spc
    in let clusters = if raw-clusters > 65524 then 65524 else raw-clusters
    in Fat16Volume {
      vol-part-start = part-start,
      vol-bytes-per-sector = bps,
      vol-sectors-per-cluster = spc,
      vol-reserved-sectors = reserved,
      vol-num-fats = nfats,
      vol-root-entry-count = root-cnt,
      vol-fat-sectors = fat-sz,
      vol-fat-start = fat-start,
      vol-root-start = root-start,
      vol-data-start = data-start,
      vol-total-sectors = total,
      vol-cluster-count = clusters
    }

 The 16-bit total-sector count at offset 19 is zero on any volume that does
 not fit in it, and the real count is then the 32-bit field at offset 32.
 Reading only the first would size every volume above 32 MB as empty, which
 is not a small error here: vol-cluster-count is the bound on the free-cluster
 scan, and a bound of zero means the allocator reports a full disk on a disk
 that is entirely free.

  fat16-total-sectors : Integer -> Integer
  fat16-total-sectors (buf) =
    let small = fat16-read-u16 buf 19
    in if small == 0 then fat16-read-u32 buf 32 else small

Section: FAT Chain

 Per the FAT specification data clusters number from 2, and the highest one a
 volume has is `vol-cluster-count + 1`. A cluster number arrives from a
 directory entry or from a FAT slot, both of which are bytes on a medium we
 did not produce, and the two lines below turn one into a sector address by
 arithmetic alone. Outside that range the address is not on the volume: below
 2 it runs backwards out of the data region, and above the count it runs past
 the end of the medium.

 The refusal answers 65535 because that is end-of-chain in this format's own
 width, which is what the callers already handle -- a bad cluster truncates a
 file instead of reading a foreign sector, the same way a failed sector read
 does.

  fat16-cluster-ok : Fat16Volume, Integer -> Boolean
  fat16-cluster-ok (vol) (cluster) =
    cluster >= 2 & cluster <= fat16-last-cluster vol

 A FAT whose chain cycles is well formed at every step -- every cluster in it
 is a valid address -- so only a bound on the WALK catches it. The walkers
 below carry Brent's cycle detection: a saved cluster, a power, and a step
 count. Each step compares the next cluster against the saved one and, when
 the step count reaches the power, re-saves and doubles. A cycle is found
 within about twice the tail plus the loop, and a chain that ends still ends.
 On a `2 -> 3 -> 2` fixture that is three steps.

 It is Brent rather than the more familiar Floyd because Floyd's hare takes
 two steps per iteration and every step here is a FAT sector read, so Floyd
 would cost about half again as many reads on healthy volumes. Brent advances
 one cursor exactly as the unguarded walk did, so a well-formed chain pays
 nothing but the comparison.

 Two integers, not a count of clusters: a bound taken from the volume's own
 declared size would be a number the image sets, and the cluster count is
 computed from BPB fields that arrive on the medium.


  fat16-next-cluster : Fat16Volume, Integer -> [Device.Block] Integer
  fat16-next-cluster (vol) (cluster) = act
    if fat16-cluster-ok vol cluster == False then 65535
    else act
      buf <- block-read-sector ((vol.vol-fat-start) + (cluster * 2) / (vol.vol-bytes-per-sector))
      fat16-read-u16 buf (int-mod (cluster * 2) (vol.vol-bytes-per-sector))
    end
  end

  fat16-is-end : Integer -> Boolean
  fat16-is-end (cluster) = cluster >= 65528

  fat16-cluster-sector : Fat16Volume, Integer -> Integer
  fat16-cluster-sector (vol) (cluster) =
    (vol.vol-data-start) + (cluster - 2) * (vol.vol-sectors-per-cluster)

Section: Writing The FAT

 A volume carries vol-num-fats copies of the FAT, laid end to end after the
 reserved sectors, and they are not decoration -- they are the redundancy the
 format is built on. A driver that updates one copy and not the others leaves
 a disk whose two answers to "what follows this cluster" disagree, and the
 next thing to mount it is entitled to believe either one. Every write here
 goes to every copy. That is what fat16-write-fat-entry is for, and it is why
 nothing below it writes a FAT sector directly.

  fat16-write-u16 : Integer, Integer, Integer -> Integer
  fat16-write-u16 (buf) (off) (val) =
    let lo = poke-byte buf off (bit-and val 255)
    in poke-byte buf (off + 1) (bit-and (bit-shru val 8) 255)

  fat16-fat-entry-sector : Fat16Volume, Integer, Integer -> Integer
  fat16-fat-entry-sector (vol) (fat-index) (cluster) =
    (vol.vol-fat-start) + fat-index * (vol.vol-fat-sectors)
      + (cluster * 2) / (vol.vol-bytes-per-sector)

  fat16-fat-entry-offset : Fat16Volume, Integer -> Integer
  fat16-fat-entry-offset (vol) (cluster) =
    int-mod (cluster * 2) (vol.vol-bytes-per-sector)

  fat16-read-fat-entry : Fat16Volume, Integer, Integer -> [Device.Block] Integer
  fat16-read-fat-entry (vol) (fat-index) (cluster) = act
    buf <- block-read-sector (fat16-fat-entry-sector vol fat-index cluster)
    fat16-read-u16 buf (fat16-fat-entry-offset vol cluster)
  end

  fat16-write-fat-entry : Fat16Volume, Integer, Integer -> [Device.Block] Integer
  fat16-write-fat-entry (vol) (cluster) (value) =
    fat16-write-fat-copies vol 0 cluster value

  fat16-write-fat-copies : Fat16Volume, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-write-fat-copies (vol) (i) (cluster) (value) =
    if i >= (vol.vol-num-fats) then 0
    else let h = __heap-save
    in act
      buf <- block-read-sector (fat16-fat-entry-sector vol i cluster)
      s <- fat16-put-fat-entry vol i cluster value buf
      fat16-fat-copy-next vol i cluster value h
    end

  fat16-fat-copy-next : Fat16Volume, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-fat-copy-next (vol) (i) (cluster) (value) (h) =
    let z = __heap-restore h
    in fat16-write-fat-copies vol (i + 1) cluster value

  fat16-put-fat-entry : Fat16Volume, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-put-fat-entry (vol) (fat-index) (cluster) (value) (buf) =
    let w = fat16-write-u16 buf (fat16-fat-entry-offset vol cluster) value
    in block-write-sector (fat16-fat-entry-sector vol fat-index cluster) buf

Section: Allocating A Cluster

 block-read-sector bump-allocates 512 bytes on every call and never returns
 them, so each FAT sector the scan crosses is 512 bytes of permanent arena
 unless the scan gives them back. It does: the buffer is bracketed between
 __heap-save and __heap-restore, and only the cluster number survives.

 Allocation takes a HINT and resumes from it, wrapping to 2 once before
 reporting the volume full. Restarting at cluster 2 for every cluster of a
 file makes the free scan grow with the frontier: measured 2026-08-08 before
 this changed, a write cost 55 bytes of arena per byte written, of which about
 50 was the rescan, which put a 2.7 MB file past a 128 MB arena.

 A free entry is 0. Clusters number from 2, and the last valid one is
 vol-cluster-count + 1. Zero is returned when the volume is full, because 0
 is not a cluster anyone can allocate -- it is the free marker itself.

  fat16-last-cluster : Fat16Volume -> Integer
  fat16-last-cluster (vol) = (vol.vol-cluster-count) + 1

  fat16-find-free-cluster : Fat16Volume -> [Device.Block] Integer
  fat16-find-free-cluster (vol) = fat16-find-free-from vol 2

  fat16-find-free-from : Fat16Volume, Integer -> [Device.Block] Integer
  fat16-find-free-from (vol) (hint) = act
    found <- fat16-scan-free-sectors vol (if hint < 2 then 2 else hint)
    if found > 0 then found
    else if hint <= 2 then 0
    else fat16-scan-free-sectors vol 2
  end

  fat16-scan-free-sectors : Fat16Volume, Integer -> [Device.Block] Integer
  fat16-scan-free-sectors (vol) (c) =
    if c > fat16-last-cluster vol then 0
    else let per-sector = (vol.vol-bytes-per-sector) / 2
    in let sector-last = (c / per-sector) * per-sector + per-sector - 1
    in let upto = min sector-last (fat16-last-cluster vol)
    in act
      found <- fat16-scan-free-sector vol c upto
      if found > 0 then found
      else fat16-scan-free-sectors vol (sector-last + 1)
    end

  fat16-scan-free-sector : Fat16Volume, Integer, Integer -> [Device.Block] Integer
  fat16-scan-free-sector (vol) (c) (upto) =
    let h = __heap-save
    in act
      buf <- block-read-sector (fat16-fat-entry-sector vol 0 c)
      fat16-scan-free-done vol buf c upto h
    end

  fat16-scan-free-done : Fat16Volume, Integer, Integer, Integer, Integer -> Integer
  fat16-scan-free-done (vol) (buf) (c) (upto) (h) =
    let found = fat16-scan-free-in-sector vol buf c upto
    in let z = __heap-restore h
    in found

  fat16-scan-free-in-sector : Fat16Volume, Integer, Integer, Integer -> Integer
  fat16-scan-free-in-sector (vol) (buf) (c) (upto) =
    if c > upto then 0
    else if fat16-read-u16 buf (fat16-fat-entry-offset vol c) == 0 then c
    else fat16-scan-free-in-sector vol buf (c + 1) upto

  fat16-alloc-cluster : Fat16Volume -> [Device.Block] Integer
  fat16-alloc-cluster (vol) = fat16-alloc-cluster-from vol 2

  fat16-alloc-cluster-from : Fat16Volume, Integer -> [Device.Block] Integer
  fat16-alloc-cluster-from (vol) (hint) = act
    c <- fat16-find-free-from vol hint
    fat16-claim-cluster vol c
  end

  fat16-claim-cluster : Fat16Volume, Integer -> [Device.Block] Integer
  fat16-claim-cluster (vol) (c) =
    if c == 0 then 0
    else act
      w <- fat16-write-fat-entry vol c 65535
      if w == 0 then c else 0
    end

Section: Writing Bytes Into Clusters

 A sector is written by reading it, poking the bytes that change, and writing
 it back. That is not a wasted read: block-write-sector writes a whole 512-byte
 buffer, and the only way to get a buffer here is block-read-sector, which
 allocates one. Read-modify-write costs nothing extra and it is the only shape
 that does not need an allocator of its own.

 An act block here never ends on a bare value. `w <- write-something ...`
 followed by a lone `True`, or a lone `c`, parses in the source only if the
 application is parenthesised -- and the text emitter does not reprint those
 parentheses, so the re-emitted source stops parsing and the text round-trip
 goes red. The source compiling is not the standard; the source the emitter
 prints has to compile too. The fix is to end on something a parser can never
 mistake for a trailing argument, which means an `if`. Both places that needed
 it got more honest for the trouble: they now report what the write actually
 returned instead of assuming it worked.

 The tail of the last cluster is zero-filled rather than left as whatever the
 disk happened to hold. A file whose final cluster carries the previous
 tenant's bytes past end-of-file is a disclosure, not a formatting detail.

  fat16-bytes-per-cluster : Fat16Volume -> Integer
  fat16-bytes-per-cluster (vol) =
    (vol.vol-bytes-per-sector) * (vol.vol-sectors-per-cluster)

  fat16-clusters-needed : Fat16Volume, Integer -> Integer
  fat16-clusters-needed (vol) (n) =
    if n == 0 then 1
    else (n + fat16-bytes-per-cluster vol - 1) / (fat16-bytes-per-cluster vol)

 A payload arrives as up to three segments -- a leading list, a raw buffer,
 and a trailing list -- because the one caller that matters hands over a CDX
 whose body is already a buffer. Routing that buffer through a List would cost
 eight bytes of arena per byte of file, which for a 2.7 MB binary is 21 MB
 live and about 44 MB while list-push doubles. The segments are read in place
 instead and nothing is copied.

  Fat16Source = record {
   fs-head : List Integer,
   fs-buf : Integer,
   fs-buf-len : Integer,
   fs-tail : List Integer,
   fs-len : Integer
  }

  fat16-src-of-list : List Integer -> Fat16Source
  fat16-src-of-list (bs) =
    Fat16Source { fs-head = bs, fs-buf = 0, fs-buf-len = 0, fs-tail = [], fs-len = list-length bs }

  fat16-src-empty : Fat16Source
  fat16-src-empty = fat16-src-of-list []

  fat16-src-of-parts : List Integer, Integer, Integer, List Integer -> Fat16Source
  fat16-src-of-parts (head) (buf) (blen) (tail) =
    Fat16Source { fs-head = head, fs-buf = buf, fs-buf-len = blen, fs-tail = tail, fs-len = list-length head + blen + list-length tail }

  fat16-src-at : Fat16Source, Integer -> Integer
  fat16-src-at (s) (i) =
    let hn = list-length (s.fs-head)
    in if i < hn then list-at (s.fs-head) i
    else let j = i - hn
    in if j < (s.fs-buf-len) then peek-byte (s.fs-buf) j
    else list-at (s.fs-tail) (j - (s.fs-buf-len))

  fat16-fill-sector : Integer, Fat16Source, Integer, Integer, Integer -> Integer
  fat16-fill-sector (buf) (bytes) (start) (i) (bps) =
    if i >= bps then 0
    else let src = start + i
    in let b = if src < (bytes.fs-len) then fat16-src-at bytes src else 0
    in let w = poke-byte buf i b
    in fat16-fill-sector buf bytes start (i + 1) bps

  fat16-write-data-sector : Fat16Volume, Integer, Fat16Source, Integer -> [Device.Block] Integer
  fat16-write-data-sector (vol) (sector) (bytes) (start) =
    let h = __heap-save
    in act
      buf <- block-read-sector sector
      r <- fat16-put-data-sector vol sector bytes start buf
      fat16-drop-to h r
    end

 The sector buffer is dead the moment block-write-sector has taken it, and a
 megabyte-scale file walks one per data sector, so it is returned rather than
 left on the arena.

  fat16-drop-to : Integer, Integer -> Integer
  fat16-drop-to (h) (r) =
    let z = __heap-restore h
    in r

  fat16-put-data-sector : Fat16Volume, Integer, Fat16Source, Integer, Integer -> [Device.Block] Integer
  fat16-put-data-sector (vol) (sector) (bytes) (start) (buf) =
    let f = fat16-fill-sector buf bytes start 0 (vol.vol-bytes-per-sector)
    in block-write-sector sector buf

  fat16-write-cluster : Fat16Volume, Integer, Fat16Source, Integer, Integer -> [Device.Block] Integer
  fat16-write-cluster (vol) (cluster) (bytes) (start) (i) =
    if i >= (vol.vol-sectors-per-cluster) then 0
    else let sec = fat16-cluster-sector vol cluster + i
    in let at = start + i * (vol.vol-bytes-per-sector)
    in act
      w <- fat16-write-data-sector vol sec bytes at
      fat16-write-cluster vol cluster bytes start (i + 1)
    end

 The chain is built as it is written: allocate a cluster, fill it, and only
 then decide whether another is needed. Each new cluster is claimed as
 end-of-chain first and the previous link is repointed at it afterwards, so
 the FAT never contains a link to a cluster that is not yet marked as owned.
 A crash between the two leaves a lost cluster, which chkdsk understands; the
 other order leaves a chain running into free space, which it does not.

  fat16-write-chain : Fat16Volume, Integer, Fat16Source, Integer -> [Device.Block] Integer
  fat16-write-chain (vol) (cluster) (bytes) (start) = act
    w <- fat16-write-cluster vol cluster bytes start 0
    fat16-extend-chain vol cluster bytes (start + fat16-bytes-per-cluster vol)
  end

  fat16-extend-chain : Fat16Volume, Integer, Fat16Source, Integer -> [Device.Block] Integer
  fat16-extend-chain (vol) (prev) (bytes) (start) =
    if start >= (bytes.fs-len) then 1
    else act
      next <- fat16-alloc-cluster-from vol prev
      fat16-link-and-continue vol prev next bytes start
    end

  fat16-link-and-continue : Fat16Volume, Integer, Integer, Fat16Source, Integer -> [Device.Block] Integer
  fat16-link-and-continue (vol) (prev) (next) (bytes) (start) =
    if next == 0 then 0
    else act
      l <- fat16-write-fat-entry vol prev next
      fat16-write-chain vol next bytes start
    end

Section: Writing A Directory Entry

 FAT short names are the OEM character set -- ASCII, on any disk anyone will
 hand us. Codex Text is CCE. char-code returns the CCE code point, so writing
 it raw would put CCE on the disk: "CODEX" would go down as bytes no other
 reader recognises, and our own reader would agree with it perfectly, because
 fat16-extract-name maps back through the same table. to-unicode is the
 boundary, and it is the same boundary from-unicode crosses on the way in.

  fat16-name-byte : Text, Integer -> Integer
  fat16-name-byte (s) (i) =
    if i >= text-length s then 32
    else to-unicode (char-code (char-at s i))

  fat16-poke-83 : Integer, Integer, Text, Text -> Integer
  fat16-poke-83 (buf) (off) (base) (ext) =
    let b = fat16-poke-run buf off base 0 8
    in fat16-poke-run buf (off + 8) ext 0 3

  fat16-poke-run : Integer, Integer, Text, Integer, Integer -> Integer
  fat16-poke-run (buf) (off) (s) (i) (n) =
    if i >= n then 0
    else let w = poke-byte buf (off + i) (fat16-name-byte s i)
    in fat16-poke-run buf off s (i + 1) n

 A name whose base exceeds eight characters or whose extension exceeds three
 cannot be spelled in an 8.3 directory entry. fat16-poke-run copies exactly
 eight and three and pads the rest, so writing one used to SUCCEED and
 silently store a different name: measured 2026-08-28, `fat16-write-file
 "foreword/BBB.codex"` answered True, `fat16-read-text` of that same path
 answered None, and the bytes came back only under "foreword/BBB.COD". A name
 that does not survive fat16-short-form unchanged gets a long-name run and an
 8.3 alias instead, so the two agree again. What is still refused is a name no
 run can hold either: longer than the format's 255 characters, or carrying a
 character that does not survive the CCE round trip.

  fat16-name-fits-83 : Text -> Boolean
  fat16-name-fits-83 (name) =
   text-length (fat16-base-of name) <= 8 & text-length (fat16-ext-of name) <= 3

 The 8.3 form is what fat16-poke-83 will actually store, reassembled. A name
 equal to its own 8.3 form needs no run and is written exactly as it was
 before long names existed, which is what keeps every short-named volume and
 every existing fixture byte-identical. Anything else -- too long for either
 field, or merely lowercase -- needs one.

  fat16-short-form : Text -> Text
  fat16-short-form (name) =
    let b = fat16-base-of name
    in let e = fat16-ext-of name
    in if text-length e == 0 then b else b & "." & e

  fat16-needs-long : Text -> Boolean
  fat16-needs-long (name) =
    if fat16-name-fits-83 name == False then True
    else fat16-short-form name /= name

  fat16-name-writable : Text -> Boolean
  fat16-name-writable (name) =
    let n = text-length name
    in if n == 0 then False
    else if n > fat16-lfn-max-name then False
    else fat16-lfn-name-spellable name 0 n

  fat16-path-writable : Text -> Boolean
  fat16-path-writable (path) =
   fat16-parts-writable (fat16-split-path path) 0

  fat16-parts-writable : List Text, Integer -> Boolean
  fat16-parts-writable (parts) (i) =
   if i >= list-length parts then True
   else if fat16-name-writable (list-at parts i) == False then False
   else fat16-parts-writable parts (i + 1)

  fat16-base-of : Text -> Text
  fat16-base-of (name) =
    let dot = text-index-of name "."
    in if dot < 0 then fat16-upper name
       else fat16-upper (text-substring name 0 dot)

  fat16-ext-of : Text -> Text
  fat16-ext-of (name) =
    let dot = text-index-of name "."
    in if dot < 0 then ""
       else fat16-upper (text-substring name (dot + 1) (text-length name - dot - 1))

  fat16-poke-dir-entry : Integer, Integer, Text, Integer, Integer, Integer -> Integer
  fat16-poke-dir-entry (buf) (off) (name) (attr) (cluster) (size) =
    let n = fat16-poke-83 buf off (fat16-base-of name) (fat16-ext-of name)
    in let a = poke-byte buf (off + 11) attr
    in let z = fat16-zero-run buf (off + 12) 0 14
    in let c = fat16-write-u16 buf (off + 26) cluster
    in let s1 = fat16-write-u16 buf (off + 28) (bit-and size 65535)
    in fat16-write-u16 buf (off + 30) (bit-and (bit-shru size 16) 65535)

  fat16-zero-run : Integer, Integer, Integer, Integer -> Integer
  fat16-zero-run (buf) (off) (i) (n) =
    if i >= n then 0
    else let w = poke-byte buf (off + i) 0
    in fat16-zero-run buf off (i + 1) n

 A free root slot is one whose first byte is 0 (never used) or 0xE5 (deleted).
 The root directory is a flat region of vol-root-entry-count entries; there is
 no chain to follow and no growing it. A full root is a real condition on
 FAT16 and it is reported, not worked around.

  fat16-root-sector-count : Fat16Volume -> Integer
  fat16-root-sector-count (vol) =
    ((vol.vol-root-entry-count) * 32 + (vol.vol-bytes-per-sector) - 1)
      / (vol.vol-bytes-per-sector)

Section: Growing A Directory

 The order is claim, zero, then link, and each step is the reason the next one
 is safe. fat16-alloc-cluster marks the new cluster as end-of-chain before
 anyone points at it, so the FAT never carries a link into free space. Zeroing
 happens before the link for the same reason it happens when a directory is
 born: a reader stops at the first slot whose first byte is zero, so a cluster
 joined to the chain still holding its last tenant's bytes would read as
 entries -- deleted files reappearing inside a directory that never had them.
 Link last, and the growth is invisible until it is complete and correct.

 The walk stops on anything that is not a cluster a chain can continue into,
 not only on the end-of-chain marker. A free entry (0) or a reserved one (1)
 in the middle of a chain is a corrupt volume, and treating it as the end
 stops here rather than recursing forever on a disk that lies.

  fat16-dir-chain-ends-at : Integer -> Boolean
  fat16-dir-chain-ends-at (c) =
    if c < 2 then True else fat16-is-end c

  fat16-last-cluster-of : Fat16Volume, Integer -> [Device.Block] Integer
  fat16-last-cluster-of (vol) (cluster) = act
    next <- fat16-next-cluster vol cluster
    if fat16-dir-chain-ends-at next then cluster else fat16-last-cluster-of vol next
  end

  fat16-grow-dir-at : Fat16Volume, Integer -> [Device.Block] Integer
  fat16-grow-dir-at (vol) (last) = act
    fresh <- fat16-alloc-cluster vol
    fat16-grow-dir-with vol last fresh
  end

  fat16-grow-dir-with : Fat16Volume, Integer, Integer -> [Device.Block] Integer
  fat16-grow-dir-with (vol) (last) (fresh) =
    if fresh == 0 then 0 - 1
    else act
      z <- fat16-zero-dir-cluster vol fresh 0
      fat16-link-grown-dir vol last fresh
    end

  fat16-zero-dir-cluster : Fat16Volume, Integer, Integer -> [Device.Block] Integer
  fat16-zero-dir-cluster (vol) (cluster) (i) =
    if i >= (vol.vol-sectors-per-cluster) then 0
    else act
      w <- fat16-write-data-sector vol (fat16-cluster-sector vol cluster + i) fat16-src-empty 0
      fat16-zero-dir-cluster vol cluster (i + 1)
    end

  fat16-link-grown-dir : Fat16Volume, Integer, Integer -> [Device.Block] Integer
  fat16-link-grown-dir (vol) (last) (fresh) = act
    l <- fat16-write-fat-entry vol last fresh
    if l == 0 then fat16-cluster-sector vol fresh * 512 else 0 - 1
  end

Section: Creating A File

 A name that is already taken is REPLACED, not committed a second time.
 Until this was written, writing a file twice did exactly what
 fat16-mkdir-if-free exists a hundred lines below to prevent for
 directories: fat16-find-free-slot answers the first FREE slot and knows
 nothing about names, so the second write claimed a fresh cluster chain
 and committed a second entry under the same name. Two entries, one name,
 and every reader takes whichever it meets first -- which is the OLD one,
 because the old entry sits in a lower slot than the free one found after
 it.

 So the write reported True, the bytes were really written, the clusters
 were really consumed, and the file still read back with its previous
 contents. That is worse than a refusal and worse than a no-op: it is a
 silent leak that also looks like success. It was found because a test
 asserted a REFUSED write left the old bytes in place -- which it does,
 and so does an admitted one, so the assertion could not fail.

  fat16-create-file : Fat16Volume, Text, Fat16Source -> [Device.Block] Boolean
  fat16-create-file (vol) (name) (bytes) =
    if fat16-scope-admits name == False then False
    else if fat16-path-writable name == False then False
    else if fat16-vol-is-usable vol == False then False
    else if text-contains name "/" then fat16-create-in-subdir vol name bytes
    else act
      found <- fat16-find-in-root vol name
      fat16-create-or-replace vol name bytes found
    end

 The existing entry is looked up by the name the caller gave, which may be a
 long one, and its SLOT is then found by the 8.3 name that lookup answered
 with. Two scans, and the second is exact: de-name is the short entry's own
 name, which is unique in its directory by construction.

  fat16-create-or-replace : Fat16Volume, Text, Fat16Source, Maybe Fat16DirEntry -> [Device.Block] Boolean
  fat16-create-or-replace (vol) (name) (bytes) (found) = when found
    is Just (e) -> fat16-replace-in-root vol name bytes e
    is None -> fat16-create-fresh-in-root vol name bytes

  fat16-replace-in-root : Fat16Volume, Text, Fat16Source, Fat16DirEntry -> [Device.Block] Boolean
  fat16-replace-in-root (vol) (name) (bytes) (e) = act
    slot <- fat16-find-name-slot vol (e.de-name)
    fat16-replace-at-slot vol name bytes slot (e.de-cluster)
  end

 A replacement erases the old entry outright rather than writing over it,
 because the new name may need a different number of records than the old one
 did and a run is located by adjacency. The erased slots are free the instant
 they are marked, so the run finder below usually places the new entry in the
 same place.

  fat16-replace-at-slot : Fat16Volume, Text, Fat16Source, Integer, Integer -> [Device.Block] Boolean
  fat16-replace-at-slot (vol) (name) (bytes) (slot) (old) =
    if slot < 0 then False
    else act
      f <- fat16-free-chain vol old
      fat16-erase-then-create-root vol name bytes slot
    end

  fat16-erase-then-create-root : Fat16Volume, Text, Fat16Source, Integer -> [Device.Block] Boolean
  fat16-erase-then-create-root (vol) (name) (bytes) (slot) = act
    d <- fat16-erase-entry vol slot
    fat16-create-fresh-in-root vol name bytes
  end

  fat16-create-fresh-in-root : Fat16Volume, Text, Fat16Source -> [Device.Block] Boolean
  fat16-create-fresh-in-root (vol) (name) (bytes) = act
    short <- fat16-pick-alias-root vol name 1
    fat16-place-in-root vol name short bytes
  end

  fat16-place-in-root : Fat16Volume, Text, Text, Fat16Source -> [Device.Block] Boolean
  fat16-place-in-root (vol) (name) (short) (bytes) =
    if text-length short == 0 then False
    else act
      slot <- fat16-find-run-in-root vol (fat16-slots-for name)
      fat16-create-at-run vol name short bytes slot
    end

 An alias is searched for rather than derived, because uniqueness is a fact
 about the directory and not about the name. A name needing no run keeps its
 own spelling and no search happens at all. An empty answer means the search
 ran out of numbers, and it is a refusal: there is no alias left to write
 under, and writing a duplicate would be the failure this is here to avoid.

  fat16-pick-alias-root : Fat16Volume, Text, Integer -> [Device.Block] Text
  fat16-pick-alias-root (vol) (name) (n) =
    if fat16-needs-long name == False then name
    else if n > fat16-alias-max-tries then ""
    else let cand = fat16-alias-of name n
    in act
      taken <- fat16-find-name-slot vol cand
      if taken >= 0 then fat16-pick-alias-root vol name (n + 1) else cand
    end

  fat16-pick-alias-dir : Fat16Volume, Integer, Text, Integer -> [Device.Block] Text
  fat16-pick-alias-dir (vol) (cluster) (name) (n) =
    if fat16-needs-long name == False then name
    else if n > fat16-alias-max-tries then ""
    else let cand = fat16-alias-of name n
    in act
      taken <- fat16-find-name-slot-in-dir vol cluster cand
      if taken >= 0 then fat16-pick-alias-dir vol cluster name (n + 1) else cand
    end

 Returning each cluster to free by writing 0 across every FAT copy, which
 is what fat16-write-fat-entry already guarantees. The walk reads the next
 link BEFORE clearing the current one, because clearing first would lose
 the pointer to the rest of the chain and leak everything behind it.

 A cluster below 2 is not a chain -- 0 means "no clusters" on an empty
 file and 1 is reserved -- so it terminates rather than trying to free a
 reserved FAT entry. This walk is bounded by the chain it is given and
 carries no fuel cap, exactly as every other chain walk in this chapter;
 a FAT with a cycle in it would spin here and would equally spin in
 fat16-read-cluster-bytes.

  fat16-free-chain : Fat16Volume, Integer -> [Device.Block] Integer
  fat16-free-chain (vol) (cluster) =
    fat16-free-chain-walk vol cluster cluster 1 0

  fat16-free-chain-walk : Fat16Volume, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-free-chain-walk (vol) (cluster) (saved) (power) (steps) =
    if cluster < 2 then 0
    else if fat16-is-end cluster then 0
    else fat16-free-chain-from vol cluster (fat16-next-cluster vol cluster) saved power steps

  fat16-free-chain-from : Fat16Volume, Integer, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-free-chain-from (vol) (cluster) (nxt) (saved) (power) (steps) = act
    w <- fat16-write-fat-entry vol cluster 0
    if nxt == saved then 0
    else if steps + 1 == power then fat16-free-chain-walk vol nxt nxt (power * 2) 0
    else fat16-free-chain-walk vol nxt saved power (steps + 1)
  end

  fat16-find-name-slot : Fat16Volume, Text -> [Device.Block] Integer
  fat16-find-name-slot (vol) (name) =
    fat16-name-slot-sectors vol name (vol.vol-root-start) (fat16-root-sector-count vol) 0

  fat16-name-slot-sectors : Fat16Volume, Text, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-name-slot-sectors (vol) (name) (sector) (remaining) (checked) =
    if remaining == 0 then 0 - 1
    else if checked >= (vol.vol-root-entry-count) then 0 - 1
    else act
      buf <- block-read-sector sector
      fat16-name-slot-step vol name sector remaining checked buf
    end

  fat16-name-slot-step : Fat16Volume, Text, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-name-slot-step (vol) (name) (sector) (remaining) (checked) (buf) =
    let eps = (vol.vol-bytes-per-sector) / 32
    in let found = fat16-name-slot-in-sector buf name 0 eps
    in if found >= 0 then sector * 512 + found
       else fat16-name-slot-sectors vol name (sector + 1) (remaining - 1) (checked + eps)

  fat16-name-slot-in-sector : Integer, Text, Integer, Integer -> Integer
  fat16-name-slot-in-sector (buf) (name) (i) (count) =
    if i >= count then 0 - 1
    else let off = i * 32
    in if fat16-is-free-entry buf off then fat16-name-slot-in-sector buf name (i + 1) count
    else if fat16-is-lfn-entry buf off then fat16-name-slot-in-sector buf name (i + 1) count
    else if fat16-is-volume-label buf off then fat16-name-slot-in-sector buf name (i + 1) count
    else if fat16-name-matches (fat16-entry-name-at buf off) name then off
    else fat16-name-slot-in-sector buf name (i + 1) count

  fat16-entry-name-at : Integer, Integer -> Text
  fat16-entry-name-at (buf) (off) = (fat16-read-dir-entry buf off).de-name

  fat16-find-name-slot-in-dir : Fat16Volume, Integer, Text -> [Device.Block] Integer
  fat16-find-name-slot-in-dir (vol) (cluster) (name) =
    fat16-find-name-slot-walk vol cluster name cluster 1 0

  fat16-find-name-slot-walk : Fat16Volume, Integer, Text, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-find-name-slot-walk (vol) (cluster) (name) (saved) (power) (steps) =
    if fat16-is-end cluster then 0 - 1
    else act
      found <- fat16-name-slot-dir-sectors vol name (fat16-cluster-sector vol cluster) (vol.vol-sectors-per-cluster)
      fat16-name-slot-or-next vol cluster name found saved power steps
    end

  fat16-name-slot-or-next : Fat16Volume, Integer, Text, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-name-slot-or-next (vol) (cluster) (name) (found) (saved) (power) (steps) = act
    if found >= 0 then found
    else act
      nxt <- fat16-next-cluster vol cluster
      if nxt == saved then 0 - 1
      else if steps + 1 == power then fat16-find-name-slot-walk vol nxt name nxt (power * 2) 0
      else fat16-find-name-slot-walk vol nxt name saved power (steps + 1)
    end
  end

  fat16-name-slot-dir-sectors : Fat16Volume, Text, Integer, Integer -> [Device.Block] Integer
  fat16-name-slot-dir-sectors (vol) (name) (sector) (remaining) =
    if remaining == 0 then 0 - 1
    else act
      buf <- block-read-sector sector
      fat16-name-slot-dir-step vol name sector remaining buf
    end

  fat16-name-slot-dir-step : Fat16Volume, Text, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-name-slot-dir-step (vol) (name) (sector) (remaining) (buf) =
    let found = fat16-name-slot-in-sector buf name 0 ((vol.vol-bytes-per-sector) / 32)
    in if found >= 0 then sector * 512 + found
       else fat16-name-slot-dir-sectors vol name (sector + 1) (remaining - 1)

  fat16-create-in-subdir : Fat16Volume, Text, Fat16Source -> [Device.Block] Boolean
  fat16-create-in-subdir (vol) (path) (bytes) =
    let parts = fat16-split-path path
    in let n = list-length parts
    in if n < 2 then False
    else when fat16-walk-path vol parts 0 (n - 1)
      is None -> False
      is Just (dir) -> fat16-create-in-dir-entry vol dir (list-at parts (n - 1)) bytes

 A parent that resolves but is a FILE is refused. Without this test the entry
 would be written into whatever data cluster the file's contents occupy, which
 corrupts the file and produces a directory entry no walk will ever find.

  fat16-create-in-dir-entry : Fat16Volume, Fat16DirEntry, Text, Fat16Source -> [Device.Block] Boolean
  fat16-create-in-dir-entry (vol) (dir) (leaf) (bytes) =
    if bit-and (dir.de-attr) 16 == 16
      then fat16-create-in-cluster-dir vol (dir.de-cluster) leaf bytes
      else False

  fat16-create-in-cluster-dir : Fat16Volume, Integer, Text, Fat16Source -> [Device.Block] Boolean
  fat16-create-in-cluster-dir (vol) (cluster) (leaf) (bytes) = act
    found <- fat16-find-in-cluster-dir vol cluster leaf
    fat16-create-or-replace-in-dir vol cluster leaf bytes found
  end

  fat16-create-or-replace-in-dir : Fat16Volume, Integer, Text, Fat16Source, Maybe Fat16DirEntry -> [Device.Block] Boolean
  fat16-create-or-replace-in-dir (vol) (cluster) (leaf) (bytes) (found) = when found
    is Just (e) -> fat16-replace-in-dir vol cluster leaf bytes e
    is None -> fat16-create-fresh-in-dir vol cluster leaf bytes

  fat16-replace-in-dir : Fat16Volume, Integer, Text, Fat16Source, Fat16DirEntry -> [Device.Block] Boolean
  fat16-replace-in-dir (vol) (cluster) (leaf) (bytes) (e) = act
    slot <- fat16-find-name-slot-in-dir vol cluster (e.de-name)
    fat16-replace-at-slot-in-dir vol cluster leaf bytes slot (e.de-cluster)
  end

  fat16-replace-at-slot-in-dir : Fat16Volume, Integer, Text, Fat16Source, Integer, Integer -> [Device.Block] Boolean
  fat16-replace-at-slot-in-dir (vol) (cluster) (leaf) (bytes) (slot) (old) =
    if slot < 0 then False
    else act
      f <- fat16-free-chain vol old
      fat16-erase-then-create-dir vol cluster leaf bytes slot
    end

  fat16-erase-then-create-dir : Fat16Volume, Integer, Text, Fat16Source, Integer -> [Device.Block] Boolean
  fat16-erase-then-create-dir (vol) (cluster) (leaf) (bytes) (slot) = act
    d <- fat16-erase-entry vol slot
    fat16-create-fresh-in-dir vol cluster leaf bytes
  end

  fat16-create-fresh-in-dir : Fat16Volume, Integer, Text, Fat16Source -> [Device.Block] Boolean
  fat16-create-fresh-in-dir (vol) (cluster) (leaf) (bytes) = act
    short <- fat16-pick-alias-dir vol cluster leaf 1
    fat16-place-in-dir vol cluster leaf short bytes
  end

  fat16-place-in-dir : Fat16Volume, Integer, Text, Text, Fat16Source -> [Device.Block] Boolean
  fat16-place-in-dir (vol) (cluster) (leaf) (short) (bytes) =
    if text-length short == 0 then False
    else act
      slot <- fat16-find-or-grow-run-in-dir vol cluster (fat16-slots-for leaf)
      fat16-create-at-run vol leaf short bytes slot
    end

  fat16-create-at-run : Fat16Volume, Text, Text, Fat16Source, Integer -> [Device.Block] Boolean
  fat16-create-at-run (vol) (name) (short) (bytes) (slot) =
    if slot < 0 then False
    else act
      first <- fat16-alloc-cluster vol
      fat16-create-with-cluster vol name short bytes slot first
    end

  fat16-create-with-cluster : Fat16Volume, Text, Text, Fat16Source, Integer, Integer -> [Device.Block] Boolean
  fat16-create-with-cluster (vol) (name) (short) (bytes) (slot) (first) =
    if first == 0 then False
    else act
      w <- fat16-write-chain vol first bytes 0
      fat16-commit-entry vol name short bytes slot first w
    end

  fat16-commit-entry : Fat16Volume, Text, Text, Fat16Source, Integer, Integer, Integer -> [Device.Block] Boolean
  fat16-commit-entry (vol) (name) (short) (bytes) (slot) (first) (ok) =
    if ok == 0 then False
    else act
      r <- fat16-write-run vol name short slot (fat16-records-for name)
      fat16-commit-short-if short bytes slot first (fat16-records-for name) r
    end

  fat16-commit-short-if : Text, Fat16Source, Integer, Integer, Integer, Integer -> [Device.Block] Boolean
  fat16-commit-short-if (short) (bytes) (slot) (first) (records) (r) =
    if r /= 0 then False
    else fat16-commit-short short bytes slot first records

  fat16-commit-short : Text, Fat16Source, Integer, Integer, Integer -> [Device.Block] Boolean
  fat16-commit-short (short) (bytes) (slot) (first) (records) = act
    buf <- block-read-sector ((slot + records * 32) / 512)
    fat16-put-entry-and-write short bytes slot first records buf
  end

  fat16-put-entry-and-write : Text, Fat16Source, Integer, Integer, Integer, Integer -> [Device.Block] Boolean
  fat16-put-entry-and-write (short) (bytes) (slot) (first) (records) (buf) =
    let at = slot + records * 32
    in let p = fat16-poke-dir-entry buf (int-mod at 512) short 32 first (bytes.fs-len)
    in act
      s <- block-write-sector (at / 512) buf
      if s == 0 then True else False
    end

Section: Creating A Directory

 A directory is a file whose contents are directory entries and whose attr
 bit 0x10 is set. Making one is: claim a cluster, zero it so no previous
 tenant's bytes read as entries, write . and .. into its first two slots, and
 commit an entry for it in the parent. The dot entries are not decoration --
 .. is how every walker climbs, and its cluster is 0 when the parent is the
 root, which is the spec's convention and not the root's actual sector.

 Zeroing the cluster is load-bearing rather than tidy. A directory's extent is
 not recorded anywhere: a reader stops at the first slot whose first byte is
 0. Leave the cluster as found and whatever bytes were there are read as
 entries, so the new directory is born holding the deleted contents of
 whatever used it last.

  fat16-create-directory : Fat16Volume, Text -> [Device.Block] Boolean
  fat16-create-directory (vol) (path) =
    if fat16-scope-admits path == False then False
    else if fat16-path-writable path == False then False
    else if fat16-vol-is-usable vol == False then False
    else if text-length path == 0 then False
    else act
      taken <- fat16-resolve-path vol path
      fat16-mkdir-if-free vol path taken
    end

  fat16-mkdir-if-free : Fat16Volume, Text, Maybe Fat16DirEntry -> [Device.Block] Boolean
  fat16-mkdir-if-free (vol) (path) (taken) = when taken
    is Just (e) -> False
    is None ->
      if text-contains path "/" then fat16-mkdir-in-subdir vol path
      else fat16-mkdir-in-root vol path

  fat16-mkdir-in-root : Fat16Volume, Text -> [Device.Block] Boolean
  fat16-mkdir-in-root (vol) (name) = act
    short <- fat16-pick-alias-root vol name 1
    fat16-mkdir-place-root vol name short
  end

  fat16-mkdir-place-root : Fat16Volume, Text, Text -> [Device.Block] Boolean
  fat16-mkdir-place-root (vol) (name) (short) =
    if text-length short == 0 then False
    else act
      slot <- fat16-find-run-in-root vol (fat16-slots-for name)
      fat16-mkdir-at-slot vol name short slot 0
    end

  fat16-mkdir-in-subdir : Fat16Volume, Text -> [Device.Block] Boolean
  fat16-mkdir-in-subdir (vol) (path) =
    let parts = fat16-split-path path
    in let n = list-length parts
    in if n < 2 then False
    else when fat16-walk-path vol parts 0 (n - 1)
      is None -> False
      is Just (dir) -> fat16-mkdir-under vol dir (list-at parts (n - 1))

  fat16-mkdir-under : Fat16Volume, Fat16DirEntry, Text -> [Device.Block] Boolean
  fat16-mkdir-under (vol) (dir) (leaf) =
    if bit-and (dir.de-attr) 16 == 16
      then fat16-mkdir-in-cluster vol (dir.de-cluster) leaf
      else False

  fat16-mkdir-in-cluster : Fat16Volume, Integer, Text -> [Device.Block] Boolean
  fat16-mkdir-in-cluster (vol) (parent) (leaf) = act
    short <- fat16-pick-alias-dir vol parent leaf 1
    fat16-mkdir-place-dir vol parent leaf short
  end

  fat16-mkdir-place-dir : Fat16Volume, Integer, Text, Text -> [Device.Block] Boolean
  fat16-mkdir-place-dir (vol) (parent) (leaf) (short) =
    if text-length short == 0 then False
    else act
      slot <- fat16-find-or-grow-run-in-dir vol parent (fat16-slots-for leaf)
      fat16-mkdir-at-slot vol leaf short slot parent
    end

  fat16-mkdir-at-slot : Fat16Volume, Text, Text, Integer, Integer -> [Device.Block] Boolean
  fat16-mkdir-at-slot (vol) (name) (short) (slot) (parent) =
    if slot < 0 then False
    else act
      first <- fat16-alloc-cluster vol
      fat16-mkdir-with-cluster vol name short slot parent first
    end

  fat16-mkdir-with-cluster : Fat16Volume, Text, Text, Integer, Integer, Integer -> [Device.Block] Boolean
  fat16-mkdir-with-cluster (vol) (name) (short) (slot) (parent) (first) =
    if first == 0 then False
    else act
      z <- fat16-mkdir-init-cluster vol first parent 0
      fat16-mkdir-commit vol name short slot first
    end

  fat16-mkdir-init-cluster : Fat16Volume, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-mkdir-init-cluster (vol) (cluster) (parent) (i) =
    if i >= (vol.vol-sectors-per-cluster) then fat16-mkdir-write-dots vol cluster parent
    else act
      w <- fat16-write-data-sector vol (fat16-cluster-sector vol cluster + i) fat16-src-empty 0
      fat16-mkdir-init-cluster vol cluster parent (i + 1)
    end

  fat16-mkdir-write-dots : Fat16Volume, Integer, Integer -> [Device.Block] Integer
  fat16-mkdir-write-dots (vol) (cluster) (parent) = act
    buf <- block-read-sector (fat16-cluster-sector vol cluster)
    fat16-mkdir-poke-dots vol cluster parent buf
  end

  fat16-mkdir-poke-dots : Fat16Volume, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-mkdir-poke-dots (vol) (cluster) (parent) (buf) =
    let d1 = fat16-poke-dot-entry buf 0 1 cluster
    in let d2 = fat16-poke-dot-entry buf 32 2 parent
    in block-write-sector (fat16-cluster-sector vol cluster) buf

 The dot entries cannot go through fat16-poke-dir-entry, and this is the kind
 of thing that is obvious only once. That function writes an 8.3 name via
 fat16-base-of, which splits on the FIRST dot and keeps what is before it --
 so "." yields an empty base and an empty extension, and the entry lands as
 eleven spaces. The directory would be created, it would look fine in a
 listing, and nothing would ever climb out of it, because .. would not be
 there under any name a walker looks for. So the two dot names are poked as
 literal bytes (46 is '.'), space-padded to 11, and the rest of the entry is
 laid out exactly as fat16-poke-dir-entry lays it out.

  fat16-poke-dot-entry : Integer, Integer, Integer, Integer -> Integer
  fat16-poke-dot-entry (buf) (off) (dots) (cluster) =
    let n = fat16-poke-dot-name buf off dots
    in let a = poke-byte buf (off + 11) 16
    in let z = fat16-zero-run buf (off + 12) 0 14
    in let c = fat16-write-u16 buf (off + 26) cluster
    in let s1 = fat16-write-u16 buf (off + 28) 0
    in fat16-write-u16 buf (off + 30) 0

  fat16-poke-dot-name : Integer, Integer, Integer -> Integer
  fat16-poke-dot-name (buf) (off) (dots) =
    let d1 = poke-byte buf off 46
    in let d2 = if dots > 1 then poke-byte buf (off + 1) 46 else 0
    in fat16-fill-run buf (off + dots) 0 (11 - dots) 32

  fat16-fill-run : Integer, Integer, Integer, Integer, Integer -> Integer
  fat16-fill-run (buf) (off) (i) (n) (v) =
    if i >= n then 0
    else let w = poke-byte buf (off + i) v
    in fat16-fill-run buf off (i + 1) n v

  fat16-mkdir-commit : Fat16Volume, Text, Text, Integer, Integer -> [Device.Block] Boolean
  fat16-mkdir-commit (vol) (name) (short) (slot) (first) = act
    r <- fat16-write-run vol name short slot (fat16-records-for name)
    fat16-mkdir-place-if short slot first (fat16-records-for name) r
  end

  fat16-mkdir-place-if : Text, Integer, Integer, Integer, Integer -> [Device.Block] Boolean
  fat16-mkdir-place-if (short) (slot) (first) (records) (r) =
    if r /= 0 then False
    else fat16-mkdir-place-entry short slot first records

  fat16-mkdir-place-entry : Text, Integer, Integer, Integer -> [Device.Block] Boolean
  fat16-mkdir-place-entry (short) (slot) (first) (records) = act
    buf <- block-read-sector ((slot + records * 32) / 512)
    fat16-mkdir-put-entry short slot first records buf
  end

  fat16-mkdir-put-entry : Text, Integer, Integer, Integer, Integer -> [Device.Block] Boolean
  fat16-mkdir-put-entry (short) (slot) (first) (records) (buf) =
    let at = slot + records * 32
    in let p = fat16-poke-dir-entry buf (int-mod at 512) short 16 first 0
    in act
      s <- block-write-sector (at / 512) buf
      if s == 0 then True else False
    end

Section: Directory Reading

  fat16-read-dir-entry : Integer, Integer -> Fat16DirEntry
  fat16-read-dir-entry (buf) (off) =
    let name = fat16-extract-name buf off
    in let attr = peek-byte buf (off + 11)
    in let cluster = fat16-read-u16 buf (off + 26)
    in let size = fat16-read-u32 buf (off + 28)
    in Fat16DirEntry { de-name = name, de-attr = attr, de-cluster = cluster, de-size = size }

  fat16-extract-name : Integer, Integer -> Text
  fat16-extract-name (buf) (off) =
    let base = fat16-extract-chars buf off 8 ""
    in let ext = fat16-extract-chars buf (off + 8) 3 ""
    in let trimmed-base = fat16-trim-spaces base
    in let trimmed-ext = fat16-trim-spaces ext
    in if text-length trimmed-ext == 0 then trimmed-base
       else trimmed-base & "." & trimmed-ext

 Bytes on disk are ASCII (FAT short names are the OEM character set, and
 a file's bytes are whatever wrote them). `code-to-char` maps a CCE code
 to a character, so it must be fed the CCE code for the byte, not the
 byte: `from-unicode` performs that mapping. Passing the raw byte made
 every name compare unequal to any Codex string literal -- an on-disk
 "EFI" never matched "EFI".

  fat16-extract-chars : Integer, Integer, Integer, Text -> Text
  fat16-extract-chars (buf) (off) (n) (acc) =
    if n == 0 then acc
    else let c = peek-byte buf off
    in fat16-extract-chars buf (off + 1) (n - 1) (acc & char-encode (code-to-char (from-unicode c)))

  fat16-trim-spaces : Text -> Text
  fat16-trim-spaces (s) = fat16-trim-loop s (text-length s)

  fat16-trim-loop : Text, Integer -> Text
  fat16-trim-loop (s) (len) =
    if len == 0 then ""
    else if char-code (char-at s (len - 1)) == from-unicode 32 then fat16-trim-loop s (len - 1)
    else substring s 0 len

  fat16-is-free-entry : Integer, Integer -> Boolean
  fat16-is-free-entry (buf) (off) =
    let first = peek-byte buf off
    in first == 0 | first == 229

  fat16-is-lfn-entry : Integer, Integer -> Boolean
  fat16-is-lfn-entry (buf) (off) = peek-byte buf (off + 11) == 15

  fat16-is-volume-label : Integer, Integer -> Boolean
  fat16-is-volume-label (buf) (off) = bit-and (peek-byte buf (off + 11)) 8 == 8

Section: The Long Name Record

 VFAT spells a name the 8.3 field cannot hold in a run of 32-byte records
 placed IMMEDIATELY BEFORE the short entry they belong to, in DESCENDING
 sequence: the record first on disk carries the highest ordinal with bit 0x40
 set, and the one directly above the short entry carries ordinal 1. A run is
 at most 20 records and the format caps a name at 255 characters.

 Each record holds 13 UTF-16 code units at three disjoint runs -- five from
 byte 1, six from byte 14, two from byte 28 -- because the bytes between them
 are the fields a reader that knows only 8.3 inspects. Byte 11 is the
 attribute and holds 0x0F, which such a reader decodes as read-only, hidden,
 system and volume label at once. No real file carries all four, so the run is
 invisible to it. Bytes 26 and 27 are the short entry's first-cluster field
 and must be zero, because a reader that mistook the record for a file would
 follow whatever is there.

 A name that does not fill its last record is terminated with a 0x0000 unit
 and the slots after it are filled with 0xFFFF.

 Byte 13 of every record in a run is a checksum over the ELEVEN bytes of the
 short name the run belongs to, and it is the only thing binding the two. A
 driver that knows only 8.3 is entitled to move, delete or rewrite a short
 entry without touching the records above it, so a run whose checksum does not
 match the short entry below it is stale and describes some other file.

  fat16-lfn-attr : Integer = 15

  fat16-lfn-last : Integer = 64

  fat16-lfn-per-record : Integer = 13

  fat16-lfn-max-records : Integer = 20

  fat16-lfn-max-name : Integer = 255

  fat16-lfn-ord : Integer, Integer -> Integer
  fat16-lfn-ord (buf) (off) = bit-and (peek-byte buf off) 63

  fat16-lfn-is-last : Integer, Integer -> Boolean
  fat16-lfn-is-last (buf) (off) =
    bit-and (peek-byte buf off) fat16-lfn-last == fat16-lfn-last

  fat16-lfn-stored-sum : Integer, Integer -> Integer
  fat16-lfn-stored-sum (buf) (off) = peek-byte buf (off + 13)

  fat16-lfn-records-needed : Integer -> Integer
  fat16-lfn-records-needed (n) =
    (n + fat16-lfn-per-record - 1) / fat16-lfn-per-record

 The checksum is a byte-wide rotate-right of the running sum added to each
 name byte in turn, so the mask after every step is what keeps a 64-bit
 register holding a byte.

  fat16-short-checksum : Integer, Integer -> Integer
  fat16-short-checksum (buf) (off) = fat16-checksum-step buf off 0 0

  fat16-checksum-step : Integer, Integer, Integer, Integer -> Integer
  fat16-checksum-step (buf) (off) (i) (sum) =
    if i >= 11 then sum
    else let next = fat16-checksum-mix sum (peek-byte buf (off + i))
    in fat16-checksum-step buf off (i + 1) next

  fat16-checksum-mix : Integer, Integer -> Integer
  fat16-checksum-mix (sum) (b) =
    bit-and ((bit-shl (bit-and sum 1) 7) + (bit-shru sum 1) + b) 255

  fat16-lfn-slot-offset : Integer -> Integer
  fat16-lfn-slot-offset (k) =
    if k < 5 then 1 + k * 2
    else if k < 11 then 14 + (k - 5) * 2
    else 28 + (k - 11) * 2

  fat16-lfn-unit-at : Integer, Integer, Integer -> Integer
  fat16-lfn-unit-at (buf) (off) (k) =
    fat16-read-u16 buf (off + fat16-lfn-slot-offset k)

  fat16-lfn-units-used : Integer, Integer, Integer -> Integer
  fat16-lfn-units-used (buf) (off) (k) =
    if k >= fat16-lfn-per-record then k
    else let u = fat16-lfn-unit-at buf off k
    in if u == 0 then k
       else if u == 65535 then k
       else fat16-lfn-units-used buf off (k + 1)

 A unit this build cannot spell is refused rather than substituted, in both
 directions, and the two refusals are separate because the two conversions
 fail differently. `from-unicode` answers -1 for a unit outside CCE's three
 tiers, so a decode can test the answer. `to-unicode` answers 65533 for a CCE
 code with no Unicode, which is a legitimate code unit and cannot be told from
 a real one, so an encode has to convert BACK and compare: a character that
 does not survive the round trip would be stored as U+FFFD and read as a
 different name, which is the write-read disagreement 8.3 truncation already
 produced once.

  fat16-lfn-units-decodable : Integer, Integer, Integer, Integer -> Boolean
  fat16-lfn-units-decodable (buf) (off) (k) (n) =
    if k >= n then True
    else if from-unicode (fat16-lfn-unit-at buf off k) < 0 then False
    else fat16-lfn-units-decodable buf off (k + 1) n

  fat16-lfn-decode-units : Integer, Integer, Integer, Integer, Text -> Text
  fat16-lfn-decode-units (buf) (off) (k) (n) (acc) =
    if k >= n then acc
    else let piece = char-encode (code-to-char (from-unicode (fat16-lfn-unit-at buf off k)))
    in fat16-lfn-decode-units buf off (k + 1) n (acc & piece)

  fat16-lfn-unit-of : Text, Integer -> Integer
  fat16-lfn-unit-of (name) (i) =
    let c = char-code (char-at name i)
    in let u = to-unicode c
    in if from-unicode u == c then u else -1

  fat16-lfn-name-spellable : Text, Integer, Integer -> Boolean
  fat16-lfn-name-spellable (name) (i) (n) =
    if i >= n then True
    else if fat16-lfn-unit-of name i < 0 then False
    else fat16-lfn-name-spellable name (i + 1) n

  fat16-poke-lfn-record : Integer, Integer, Text, Integer, Integer, Boolean -> Integer
  fat16-poke-lfn-record (buf) (off) (name) (seq) (sum) (last) =
    let o = poke-byte buf off (if last then bit-or seq fat16-lfn-last else seq)
    in let a = poke-byte buf (off + 11) fat16-lfn-attr
    in let t = poke-byte buf (off + 12) 0
    in let s = poke-byte buf (off + 13) sum
    in let c = fat16-write-u16 buf (off + 26) 0
    in fat16-poke-lfn-units buf off name ((seq - 1) * fat16-lfn-per-record) 0

  fat16-poke-lfn-units : Integer, Integer, Text, Integer, Integer -> Integer
  fat16-poke-lfn-units (buf) (off) (name) (base) (k) =
    if k >= fat16-lfn-per-record then 0
    else let i = base + k
    in let n = text-length name
    in let u = if i < n then fat16-lfn-unit-of name i
               else if i == n then 0
               else 65535
    in let w = fat16-write-u16 buf (off + fat16-lfn-slot-offset k) u
    in fat16-poke-lfn-units buf off name base (k + 1)

Section: Assembling A Long Name

 A run is read in the order the format stores it, which is the reverse of the
 order the name reads in, so each record's characters go in FRONT of what is
 already assembled. `lf-ord` carries the ordinal the next record must show:
 the run's first record on disk sets it to its own ordinal less one, every
 record after it must match, and reaching the short entry with `lf-ord` at
 zero is what says the run is whole. Anything else -- a gap in the sequence, a
 record whose checksum disagrees with the run, a unit CCE cannot spell, an
 ordinal past the format's 20 -- puts the run out and the short entry answers
 under its 8.3 name, which is a name that is really on the volume rather than
 a guess at the one that is not.

 The state also has to survive a sector boundary and a cluster boundary,
 because a run is up to 640 bytes and a directory is walked one 512-byte
 sector at a time. Nothing in the format keeps a run inside either.

  Fat16Lfn = record {
    lf-name : Text,
    lf-ord : Integer,
    lf-sum : Integer,
    lf-live : Boolean
  }

  Fat16Scan = record {
    sc-found : Maybe Fat16DirEntry,
    sc-lfn : Fat16Lfn
  }

  fat16-lfn-none : Fat16Lfn
  fat16-lfn-none = Fat16Lfn { lf-name = "", lf-ord = 0, lf-sum = 0, lf-live = False }

 A nullary definition is a recipe rather than a cell, so every mention of
 fat16-lfn-none builds another record. Resetting through here instead spends
 nothing on a volume that carries no long names, which is every volume this
 tree has today: the dead state that entered the scan is the one that leaves
 it. Measured against the depot chapter over 40 lookups, resetting by
 construction at each of the three arms below cost 41,504 bytes per lookup
 on top of the 183,888 the walk already spent, a 22.6 per cent rise for a
 directory with nothing long in it at all.

  fat16-lfn-reset : Fat16Lfn -> Fat16Lfn
  fat16-lfn-reset (st) = if (st.lf-live) then fat16-lfn-none else st

  fat16-lfn-absorb : Integer, Integer, Fat16Lfn -> Fat16Lfn
  fat16-lfn-absorb (buf) (off) (st) =
    let ord = fat16-lfn-ord buf off
    in if fat16-lfn-is-last buf off then fat16-lfn-open buf off ord
       else fat16-lfn-extend buf off ord st

  fat16-lfn-open : Integer, Integer, Integer -> Fat16Lfn
  fat16-lfn-open (buf) (off) (ord) =
    if ord < 1 then fat16-lfn-none
    else if ord > fat16-lfn-max-records then fat16-lfn-none
    else fat16-lfn-take buf off ord (fat16-lfn-stored-sum buf off) ""

  fat16-lfn-extend : Integer, Integer, Integer, Fat16Lfn -> Fat16Lfn
  fat16-lfn-extend (buf) (off) (ord) (st) =
    if (st.lf-live) == False then fat16-lfn-none
    else if ord /= (st.lf-ord) then fat16-lfn-none
    else if fat16-lfn-stored-sum buf off /= (st.lf-sum) then fat16-lfn-none
    else fat16-lfn-take buf off ord (st.lf-sum) (st.lf-name)

  fat16-lfn-take : Integer, Integer, Integer, Integer, Text -> Fat16Lfn
  fat16-lfn-take (buf) (off) (ord) (sum) (rest) =
    let used = fat16-lfn-units-used buf off 0
    in if fat16-lfn-units-decodable buf off 0 used == False then fat16-lfn-none
    else let part = fat16-lfn-decode-units buf off 0 used ""
    in Fat16Lfn { lf-name = part & rest, lf-ord = ord - 1, lf-sum = sum, lf-live = True }

  fat16-lfn-final : Integer, Integer, Fat16Lfn -> Maybe Text
  fat16-lfn-final (buf) (off) (st) =
    if (st.lf-live) == False then None
    else if (st.lf-ord) /= 0 then None
    else if fat16-short-checksum buf off /= (st.lf-sum) then None
    else if text-length (st.lf-name) == 0 then None
    else if text-length (st.lf-name) > fat16-lfn-max-name then None
    else Just (st.lf-name)

 The short name is tried first and on its own terms, so a volume carrying no
 long names is matched exactly as it was before any of this existed. A file
 that has a long name keeps its 8.3 alias as a second spelling, because that
 alias is a real entry that any other driver will also answer to.

 The caller's entry is passed in rather than re-read. fat16-extract-name goes
 through from-unicode once per character and from-unicode names the 128-entry
 CCE table, which a nullary definition re-materialises at every mention, so
 one name costs about eleven kilobytes to read. Extracting it a second time
 here to compare it cost 20,064 bytes per directory lookup, measured against
 the depot chapter, which is the whole of what the long-name reader was
 charging a volume that has no long names on it.

  fat16-entry-matches : Fat16DirEntry, Integer, Integer, Fat16Lfn, Text -> Boolean
  fat16-entry-matches (entry) (buf) (off) (st) (name) =
    if fat16-name-matches (entry.de-name) name then True
    else if (st.lf-live) == False then False
    else when fat16-lfn-final buf off st
      is Just (n) -> fat16-name-matches n name
      is None -> False

Section: The Short Alias

 A file with a long name still carries an 8.3 entry, and that entry's name has
 to be unique in its directory, because every driver that knows only 8.3 will
 address the file by it and two files answering to one alias is the same
 duplicate-name failure a second entry under one name already produced here.
 The format's convention is a stem taken from the name, a tilde and a number,
 and the number is what makes it unique.

 The stem is built from the name's own characters and uppercased by
 arithmetic on the Unicode value rather than through fat16-upper, whose
 char-to-text keeps only the low byte of a multi-byte CCE code. Every
 character 8.3 cannot hold becomes an underscore: the spec permits it, the
 alias is not the name, and the number after the tilde is what tells two
 similar names apart in any case.

  fat16-alias-max-tries : Integer = 99

  fat16-alias-byte-ok : Integer -> Boolean
  fat16-alias-byte-ok (u) =
    if u >= 65 then u <= 90
    else if u >= 48 then u <= 57
    else if u == 95 then True
    else if u == 45 then True
    else if u == 126 then True
    else False

  fat16-alias-char : Text, Integer -> Text
  fat16-alias-char (s) (i) =
    let u = to-unicode (char-code (char-at s i))
    in let up = if u >= 97 then (if u <= 122 then u - 32 else u) else u
    in if fat16-alias-byte-ok up then char-encode (code-to-char (from-unicode up))
       else "_"

  fat16-alias-chars : Text, Integer, Integer, Text -> Text
  fat16-alias-chars (s) (i) (upto) (acc) =
    if i >= upto then acc
    else let piece = fat16-alias-char s i
    in fat16-alias-chars s (i + 1) upto (acc & piece)

  fat16-alias-base-len : Text -> Integer
  fat16-alias-base-len (name) =
    let dot = text-index-of name "."
    in if dot < 0 then text-length name else dot

  fat16-alias-ext-start : Text -> Integer
  fat16-alias-ext-start (name) =
    let dot = text-index-of name "."
    in if dot < 0 then text-length name else dot + 1

  fat16-alias-of : Text, Integer -> Text
  fat16-alias-of (name) (n) =
    let tag = "~" & show n
    in let stem = fat16-alias-chars name 0 (min (8 - text-length tag) (fat16-alias-base-len name)) ""
    in let es = fat16-alias-ext-start name
    in let el = min 3 (text-length name - es)
    in if el <= 0 then stem & tag
       else stem & tag & "." & fat16-alias-chars name es (es + el) ""

 The checksum a run carries is over the eleven bytes fat16-poke-83 is going to
 write, so the write side computes it from the text rather than from a buffer
 nothing has poked yet. fat16-name-byte answering a space past the end of its
 argument is what makes the two agree: it is the same padding poke-run lays
 down.

  fat16-short-checksum-of : Text -> Integer
  fat16-short-checksum-of (short) =
    fat16-name-checksum-step (fat16-base-of short) (fat16-ext-of short) 0 0

  fat16-name-checksum-step : Text, Text, Integer, Integer -> Integer
  fat16-name-checksum-step (base) (ext) (i) (sum) =
    if i >= 11 then sum
    else let b = if i < 8 then fat16-name-byte base i else fat16-name-byte ext (i - 8)
    in let next = fat16-checksum-mix sum b
    in fat16-name-checksum-step base ext (i + 1) next

Section: Finding A Run Of Free Slots

 A long name needs its records and the short entry they belong to in
 CONSECUTIVE slots, because adjacency is the only thing that binds a run to an
 entry. Slots run consecutively across the sectors of a directory, which are
 contiguous on the medium, but NOT across its clusters: the next cluster of a
 directory chain sits wherever the allocator put it. So a run is placed inside
 one cluster, and a directory with no cluster roomy enough grows a fresh one,
 which is empty and holds a whole cluster's worth of slots. A name needing
 more slots than a cluster has is refused rather than split.

  Fat16Run = record {
    rn-found : Boolean,
    rn-at : Integer,
    rn-streak : Integer
  }

  fat16-run-in-sector : Integer, Integer, Integer, Integer, Integer -> Fat16Run
  fat16-run-in-sector (buf) (i) (n) (need) (streak) =
    if i >= n then Fat16Run { rn-found = False, rn-at = 0, rn-streak = streak }
    else if fat16-is-free-entry buf (i * 32) == False then
      fat16-run-in-sector buf (i + 1) n need 0
    else if streak + 1 >= need then
      Fat16Run { rn-found = True, rn-at = i + 1 - need, rn-streak = need }
    else fat16-run-in-sector buf (i + 1) n need (streak + 1)

 A run that began in an earlier sector answers a NEGATIVE slot index, and the
 address arithmetic below is what makes that the right answer rather than a
 special case: sector times 512 plus a negative offset lands in the previous
 sector, which is where the run really starts.

  fat16-find-run-in-root : Fat16Volume, Integer -> [Device.Block] Integer
  fat16-find-run-in-root (vol) (need) =
    fat16-run-root-sectors vol need (vol.vol-root-start) (fat16-root-sector-count vol) 0

  fat16-run-root-sectors : Fat16Volume, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-run-root-sectors (vol) (need) (sector) (remaining) (streak) =
    if remaining == 0 then 0 - 1
    else act
      buf <- block-read-sector sector
      fat16-run-root-step vol need sector remaining streak buf
    end

  fat16-run-root-step : Fat16Volume, Integer, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-run-root-step (vol) (need) (sector) (remaining) (streak) (buf) =
    let eps = (vol.vol-bytes-per-sector) / 32
    in let r = fat16-run-in-sector buf 0 eps need streak
    in if (r.rn-found) then sector * 512 + (r.rn-at) * 32
       else fat16-run-root-sectors vol need (sector + 1) (remaining - 1) (r.rn-streak)

  fat16-find-run-in-dir : Fat16Volume, Integer, Integer -> [Device.Block] Integer
  fat16-find-run-in-dir (vol) (cluster) (need) =
    fat16-run-dir-walk vol cluster need cluster 1 0

  fat16-run-dir-walk : Fat16Volume, Integer, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-run-dir-walk (vol) (cluster) (need) (saved) (power) (steps) =
    if fat16-is-end cluster then 0 - 1
    else act
      found <- fat16-run-dir-sectors vol need (fat16-cluster-sector vol cluster) (vol.vol-sectors-per-cluster) 0
      fat16-run-dir-or-next vol cluster need found saved power steps
    end

  fat16-run-dir-or-next : Fat16Volume, Integer, Integer, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-run-dir-or-next (vol) (cluster) (need) (found) (saved) (power) (steps) = act
    if found >= 0 then found
    else act
      nxt <- fat16-next-cluster vol cluster
      if nxt == saved then 0 - 1
      else if steps + 1 == power then fat16-run-dir-walk vol nxt need nxt (power * 2) 0
      else fat16-run-dir-walk vol nxt need saved power (steps + 1)
    end
  end

  fat16-run-dir-sectors : Fat16Volume, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-run-dir-sectors (vol) (need) (sector) (remaining) (streak) =
    if remaining == 0 then 0 - 1
    else act
      buf <- block-read-sector sector
      fat16-run-dir-step vol need sector remaining streak buf
    end

  fat16-run-dir-step : Fat16Volume, Integer, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-run-dir-step (vol) (need) (sector) (remaining) (streak) (buf) =
    let eps = (vol.vol-bytes-per-sector) / 32
    in let r = fat16-run-in-sector buf 0 eps need streak
    in if (r.rn-found) then sector * 512 + (r.rn-at) * 32
       else fat16-run-dir-sectors vol need (sector + 1) (remaining - 1) (r.rn-streak)

  fat16-find-or-grow-run-in-dir : Fat16Volume, Integer, Integer -> [Device.Block] Integer
  fat16-find-or-grow-run-in-dir (vol) (cluster) (need) = act
    found <- fat16-find-run-in-dir vol cluster need
    fat16-run-or-grow vol cluster need found
  end

  fat16-run-or-grow : Fat16Volume, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-run-or-grow (vol) (cluster) (need) (found) =
    if found >= 0 then found
    else if need * 32 > fat16-bytes-per-cluster vol then 0 - 1
    else act
      last <- fat16-last-cluster-of vol cluster
      fat16-grow-dir-at vol last
    end

Section: Writing A Long Name

 The records go down before the short entry, and that order is the same
 reasoning the directory growth above uses. A run with no short entry beneath
 it is skipped by every reader, ours included, because a run is only ever
 claimed by the entry it sits on. A short entry with no run reads under its
 8.3 alias, which is a real file. Either half alone is therefore harmless, and
 writing the cheap half last is what makes the file appear whole.

  fat16-records-for : Text -> Integer
  fat16-records-for (name) =
    if fat16-needs-long name == False then 0
    else fat16-lfn-records-needed (text-length name)

  fat16-slots-for : Text -> Integer
  fat16-slots-for (name) = fat16-records-for name + 1

  fat16-write-run : Fat16Volume, Text, Text, Integer, Integer -> [Device.Block] Integer
  fat16-write-run (vol) (name) (short) (slot) (records) =
    fat16-write-run-step vol name (fat16-short-checksum-of short) slot records 0

 block-write-sector answers 0 for SUCCESS, which is the convention
 fat16-claim-cluster and fat16-put-entry-and-write already test. A record
 write that fails and is not read leaves the run short while the short entry
 below it still lands, so the file comes back under its 8.3 alias and not
 under the name it was written with -- which is the write-and-read
 disagreement this whole section exists to remove, reintroduced one layer
 down. The status is threaded and the first failure stops the walk.

  fat16-write-run-step : Fat16Volume, Text, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-write-run-step (vol) (name) (sum) (slot) (records) (j) =
    if j >= records then 0
    else act
      w <- fat16-write-lfn-slot name sum (slot + j * 32) (records - j) (j == 0)
      fat16-write-run-next vol name sum slot records j w
    end

  fat16-write-run-next : Fat16Volume, Text, Integer, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-write-run-next (vol) (name) (sum) (slot) (records) (j) (w) =
    if w /= 0 then w
    else fat16-write-run-step vol name sum slot records (j + 1)

  fat16-write-lfn-slot : Text, Integer, Integer, Integer, Boolean -> [Device.Block] Integer
  fat16-write-lfn-slot (name) (sum) (at) (seq) (last) =
    let h = __heap-save
    in act
      buf <- block-read-sector (at / 512)
      r <- fat16-put-lfn-slot name sum at seq last buf
      fat16-drop-to h r
    end

  fat16-put-lfn-slot : Text, Integer, Integer, Integer, Boolean, Integer -> [Device.Block] Integer
  fat16-put-lfn-slot (name) (sum) (at) (seq) (last) (buf) =
    let p = fat16-poke-lfn-record buf (int-mod at 512) name seq sum last
    in block-write-sector (at / 512) buf

 Erasing walks BACKWARD from the short entry, which is the only direction the
 format offers: nothing in an entry points at the run above it. The walk is
 held by three bounds because none of them is a proof on its own -- the record
 must carry the run attribute, its checksum must be the erased entry's, and no
 more than the format's 20 records are taken. A record belonging to some other
 file agrees on the checksum one time in 256, and there is nothing on the
 medium that would settle it.

  fat16-erase-entry : Fat16Volume, Integer -> [Device.Block] Integer
  fat16-erase-entry (vol) (slot) = act
    sum <- fat16-sum-at slot
    e <- fat16-mark-free slot
    fat16-erase-run (slot - 32) sum 0 ((vol.vol-root-start) * 512)
  end

  fat16-sum-at : Integer -> [Device.Block] Integer
  fat16-sum-at (slot) = act
    buf <- block-read-sector (slot / 512)
    fat16-short-checksum buf (int-mod slot 512)
  end

  fat16-mark-free : Integer -> [Device.Block] Integer
  fat16-mark-free (at) = act
    buf <- block-read-sector (at / 512)
    fat16-put-mark-free at buf
  end

  fat16-put-mark-free : Integer, Integer -> [Device.Block] Integer
  fat16-put-mark-free (at) (buf) =
    let p = poke-byte buf (int-mod at 512) 229
    in block-write-sector (at / 512) buf

  fat16-erase-run : Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-erase-run (at) (sum) (steps) (floor) =
    if steps >= fat16-lfn-max-records then 0
    else if at < floor then 0
    else act
      buf <- block-read-sector (at / 512)
      fat16-erase-run-step at sum steps floor buf
    end

  fat16-erase-run-step : Integer, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat16-erase-run-step (at) (sum) (steps) (floor) (buf) =
    let off = int-mod at 512
    in if fat16-is-lfn-entry buf off == False then 0
    else if fat16-lfn-stored-sum buf off /= sum then 0
    else act
      m <- fat16-mark-free at
      fat16-erase-run (at - 32) sum (steps + 1) floor
    end

Section: Root Directory Search

  fat16-find-in-root : Fat16Volume, Text -> [Device.Block] Maybe Fat16DirEntry
  fat16-find-in-root (vol) (name) =
    let root-sectors = ((vol.vol-root-entry-count) * 32 + (vol.vol-bytes-per-sector) - 1) / (vol.vol-bytes-per-sector)
    in fat16-scan-root-sectors vol name (vol.vol-root-start) root-sectors 0 fat16-lfn-none

  fat16-scan-root-sectors : Fat16Volume, Text, Integer, Integer, Integer, Fat16Lfn -> [Device.Block] Maybe Fat16DirEntry
  fat16-scan-root-sectors (vol) (name) (sector) (remaining) (entries-checked) (st) =
    if remaining == 0 then None
    else if entries-checked >= (vol.vol-root-entry-count) then None
    else act
      buf <- block-read-sector sector
      fat16-scan-root-step vol name sector remaining entries-checked buf st
    end

  fat16-scan-root-step : Fat16Volume, Text, Integer, Integer, Integer, Integer, Fat16Lfn -> [Device.Block] Maybe Fat16DirEntry
  fat16-scan-root-step (vol) (name) (sector) (remaining) (entries-checked) (buf) (st) =
    let entries-per-sector = (vol.vol-bytes-per-sector) / 32
    in let r = fat16-scan-sector-lfn buf name 0 entries-per-sector st
    in when (r.sc-found)
      is Just (entry) -> Just entry
      is None -> fat16-scan-root-sectors vol name (sector + 1) (remaining - 1) (entries-checked + entries-per-sector) (r.sc-lfn)

 Two scanners over the same bytes, and the split is deliberate. The LFN one is
 this chapter's, and it carries the run state a long name needs. The 8.3 one
 below it is FAT32's -- `fat32-scan-dir-step` and `codex/test/fat32-parse`
 both call it, a FAT32 directory sector holding the same 32-byte entries a
 FAT16 one does. FAT32 does not thread run state across its sectors, so
 pointing it at the assembling scanner would assemble a run only when it
 happened to fall inside one sector and silently miss the rest, which is worse
 than answering 8.3 honestly.

  fat16-scan-sector-lfn : Integer, Text, Integer, Integer, Fat16Lfn -> Fat16Scan
  fat16-scan-sector-lfn (buf) (name) (i) (count) (st) =
    if i >= count then Fat16Scan { sc-found = None, sc-lfn = st }
    else let off = i * 32
    in if fat16-is-free-entry buf off then
      if peek-byte buf off == 0 then Fat16Scan { sc-found = None, sc-lfn = fat16-lfn-reset st }
      else fat16-scan-sector-lfn buf name (i + 1) count (fat16-lfn-reset st)
    else if fat16-is-lfn-entry buf off then
      fat16-scan-sector-lfn buf name (i + 1) count (fat16-lfn-absorb buf off st)
    else if fat16-is-volume-label buf off then
      fat16-scan-sector-lfn buf name (i + 1) count (fat16-lfn-reset st)
    else let entry = fat16-read-dir-entry buf off
    in if fat16-entry-matches entry buf off st name then
      Fat16Scan { sc-found = Just entry, sc-lfn = st }
    else fat16-scan-sector-lfn buf name (i + 1) count (fat16-lfn-reset st)

  fat16-scan-sector-entries : Integer, Text, Integer, Integer -> Maybe Fat16DirEntry
  fat16-scan-sector-entries (buf) (name) (i) (count) =
    if i >= count then None
    else let off = i * 32
    in if fat16-is-free-entry buf off then
      if peek-byte buf off == 0 then None
      else fat16-scan-sector-entries buf name (i + 1) count
    else if fat16-is-lfn-entry buf off then fat16-scan-sector-entries buf name (i + 1) count
    else if fat16-is-volume-label buf off then fat16-scan-sector-entries buf name (i + 1) count
    else let entry = fat16-read-dir-entry buf off
    in if fat16-name-matches (entry.de-name) name then Just entry
    else fat16-scan-sector-entries buf name (i + 1) count

Section: Cluster Directory Search

  fat16-find-in-cluster-dir : Fat16Volume, Integer, Text -> [Device.Block] Maybe Fat16DirEntry
  fat16-find-in-cluster-dir (vol) (cluster) (name) =
    fat16-find-in-cluster-walk vol cluster name cluster 1 0 fat16-lfn-none

  fat16-find-in-cluster-walk : Fat16Volume, Integer, Text, Integer, Integer, Integer, Fat16Lfn -> [Device.Block] Maybe Fat16DirEntry
  fat16-find-in-cluster-walk (vol) (cluster) (name) (saved) (power) (steps) (st) =
    if fat16-is-end cluster then None
    else act
      r <- fat16-scan-cluster-sectors vol name (fat16-cluster-sector vol cluster) (vol.vol-sectors-per-cluster) st
      fat16-cluster-found-or-next vol cluster name saved power steps r
    end

  fat16-cluster-found-or-next : Fat16Volume, Integer, Text, Integer, Integer, Integer, Fat16Scan -> [Device.Block] Maybe Fat16DirEntry
  fat16-cluster-found-or-next (vol) (cluster) (name) (saved) (power) (steps) (r) =
    when (r.sc-found)
      is Just (entry) -> Just entry
      is None -> fat16-find-in-cluster-step vol cluster name saved power steps (r.sc-lfn)

  fat16-find-in-cluster-step : Fat16Volume, Integer, Text, Integer, Integer, Integer, Fat16Lfn -> [Device.Block] Maybe Fat16DirEntry
  fat16-find-in-cluster-step (vol) (cluster) (name) (saved) (power) (steps) (st) = act
    nxt <- fat16-next-cluster vol cluster
    if nxt == saved then None
    else if steps + 1 == power then fat16-find-in-cluster-walk vol nxt name nxt (power * 2) 0 st
    else fat16-find-in-cluster-walk vol nxt name saved power (steps + 1) st
  end

  fat16-scan-cluster-sectors : Fat16Volume, Text, Integer, Integer, Fat16Lfn -> [Device.Block] Fat16Scan
  fat16-scan-cluster-sectors (vol) (name) (sector) (remaining) (st) =
    if remaining == 0 then Fat16Scan { sc-found = None, sc-lfn = st }
    else act
      buf <- block-read-sector sector
      fat16-scan-cluster-step vol name sector remaining buf st
    end

  fat16-scan-cluster-step : Fat16Volume, Text, Integer, Integer, Integer, Fat16Lfn -> [Device.Block] Fat16Scan
  fat16-scan-cluster-step (vol) (name) (sector) (remaining) (buf) (st) =
    let entries-per-sector = (vol.vol-bytes-per-sector) / 32
    in let r = fat16-scan-sector-lfn buf name 0 entries-per-sector st
    in when (r.sc-found)
      is Just (e) -> r
      is None -> fat16-scan-cluster-sectors vol name (sector + 1) (remaining - 1) (r.sc-lfn)

Section: Path Resolution

  fat16-name-matches : Text, Text -> Boolean
  fat16-name-matches (entry-name) (search-name) =
    fat16-upper entry-name == fat16-upper search-name

  fat16-upper : Text -> Text
  fat16-upper (s) = fat16-upper-loop s 0 (text-length s) ""

  fat16-upper-loop : Text, Integer, Integer, Text -> Text
  fat16-upper-loop (s) (i) (len) (acc) =
    if i >= len then acc
    else let c = char-at s i
    in fat16-upper-loop s (i + 1) len (acc & char-to-text (to-upper c))

 The relation is a PREFIX, and it is a prefix because the effect family
 is a filesystem one -- the same judgement scope-admits makes in the
 type checker, where a network grant is an authority and a console
 grant is a channel instead. Scope is not one relation. Do not
 "simplify" this into a single text-starts-with shared with those.

 An empty scope admits everything, which is what an unscoped grant
 means and what the empty prefix already says by itself. That is also
 why process-get-scope never answers with a null.

 There is NO single chokepoint here, and believing there was one is how
 this nearly shipped with every write ungated. Reads funnel through
 fat16-resolve-path. Writes do NOT -- they go to fat16-create-file. The
 root listing goes through neither. So the gate is applied three times,
 and a fourth caller that reaches the disk another way needs a fourth.

  fat16-scope-admits : Text -> Boolean
  fat16-scope-admits (path) =
    let grant = process-get-scope process-get-pid
    in if text-length grant == 0 then True
       else text-starts-with path grant

  fat16-resolve-path : Fat16Volume, Text -> [Device.Block] Maybe Fat16DirEntry
  fat16-resolve-path (vol) (path) =
    if fat16-scope-admits path == False then None
    else let parts = fat16-split-path path
    in fat16-walk-path vol parts 0 (list-length parts)

  fat16-walk-path : Fat16Volume, List Text, Integer, Integer -> [Device.Block] Maybe Fat16DirEntry
  fat16-walk-path (vol) (parts) (depth) (total) =
    if depth >= total then None
    else let name = list-at parts depth
    in when (if depth == 0 then fat16-find-in-root vol name else None)
      is Just (entry) ->
        if depth == total - 1 then Just entry
        else if bit-and (entry.de-attr) 16 == 16
          then fat16-walk-path-sub vol parts (depth + 1) total (entry.de-cluster)
          else None
      is None -> None

  fat16-walk-path-sub : Fat16Volume, List Text, Integer, Integer, Integer -> [Device.Block] Maybe Fat16DirEntry
  fat16-walk-path-sub (vol) (parts) (depth) (total) (cluster) =
    if depth >= total then None
    else let name = list-at parts depth
    in when fat16-find-in-cluster-dir vol cluster name
      is Just (entry) ->
        if depth == total - 1 then Just entry
        else if bit-and (entry.de-attr) 16 == 16
          then fat16-walk-path-sub vol parts (depth + 1) total (entry.de-cluster)
          else None
      is None -> None

  fat16-split-path : Text -> List Text
  fat16-split-path (path) = fat16-split-loop path 0 (text-length path) 0 []

 The separator test compares CCE codes: `char-code` yields the internal
 CCE code, so the ASCII slash must be mapped with `from-unicode` first.
 Comparing against a bare 47 never matched, and every path resolved as a
 single name -- "EFI/BOOT/BOOTX64.EFI" was looked up verbatim in the root.

  fat16-split-loop : Text, Integer, Integer, Integer, List Text -> List Text
  fat16-split-loop (s) (i) (len) (start) (acc) =
    if i >= len then if i > start then list-push acc (substring s start (i - start)) else acc
    else if char-code (char-at s i) == from-unicode 47 then
      if i > start then fat16-split-loop s (i + 1) len (i + 1) (list-push acc (substring s start (i - start)))
      else fat16-split-loop s (i + 1) len (i + 1) acc
    else fat16-split-loop s (i + 1) len start acc

Section: File Reading

  fat16-read-cluster-bytes : Fat16Volume, Integer, Integer, Integer, List Integer -> [Device.Block] List Integer
  fat16-read-cluster-bytes (vol) (cluster) (remaining) (sector-off) (acc) =
    if remaining <= 0 then acc
    else if fat16-is-end cluster then acc
    else act
      buf <- block-read-sector (fat16-cluster-sector vol cluster + sector-off)
      fat16-read-cluster-step vol cluster remaining sector-off acc buf
    end

  fat16-read-cluster-step : Fat16Volume, Integer, Integer, Integer, List Integer, Integer -> [Device.Block] List Integer
  fat16-read-cluster-step (vol) (cluster) (remaining) (sector-off) (acc) (buf) =
    let bytes-this = if remaining < (vol.vol-bytes-per-sector) then remaining else (vol.vol-bytes-per-sector)
    in let acc2 = fat16-copy-bytes buf 0 bytes-this acc
    in let next-sector-off = sector-off + 1
    in if next-sector-off >= (vol.vol-sectors-per-cluster)
      then fat16-read-cluster-bytes vol (fat16-next-cluster vol cluster) (remaining - bytes-this) 0 acc2
      else fat16-read-cluster-bytes vol cluster (remaining - bytes-this) next-sector-off acc2

  fat16-copy-bytes : Integer, Integer, Integer, List Integer -> List Integer
  fat16-copy-bytes (buf) (off) (count) (acc) =
    if count <= 0 then acc
    else fat16-copy-bytes buf (off + 1) (count - 1) (list-push acc (peek-byte buf off))

 The unusable-volume check is the one the writes and the listings already
 make, and reading was the only entry without it. `fat16-find-in-root`
 divides by `vol-bytes-per-sector` to size the root directory, and a volume
 that did not parse carries 0 there, so a read on a machine with no disk
 attached divided by zero. RISC-V and ARM64 define that division and answer
 without trapping, which is why this reached x86-64 alone, as `!EXC=00`.

  fat16-read-bytes : Fat16Volume, Text -> [Device.Block] Maybe (List Integer)
  fat16-read-bytes (vol) (path) =
    if fat16-vol-is-usable vol == False then None
    else when fat16-resolve-path vol path
      is Just (entry) -> Just (fat16-read-cluster-bytes vol (entry.de-cluster) (entry.de-size) 0 [])
      is None -> None

 The tier-0 table is threaded, not named here: a list constant is a definition,
 not storage, so every mention re-materialises all 128 elements.

  fat16-byte-to-cce : List Integer, Integer -> Integer
  fat16-byte-to-cce (tbl) (b) =
    let t0 = from-unicode-tier0 tbl b 0 128
    in if t0 >= 0 then t0 else from-unicode b

  fat16-bytes-to-chars : List Integer, List Integer, Integer, Integer, List Text -> List Text
  fat16-bytes-to-chars (tbl) (bs) (i) (len) (acc) =
    if i >= len then acc
    else fat16-bytes-to-chars tbl bs (i + 1) len (list-push acc (char-to-text (code-to-char (fat16-byte-to-cce tbl (list-at bs i)))))

  fat16-bytes-to-text : List Integer, Integer, Integer, Text -> Text
  fat16-bytes-to-text (bs) (i) (len) (acc) =
    acc & text-concat-list (fat16-bytes-to-chars cce-to-unicode-table bs i len [])

  fat16-read-text : Fat16Volume, Text -> [Device.Block] Maybe Text
  fat16-read-text (vol) (path) =
    when fat16-read-bytes vol path
      is Just (bs) -> Just (fat16-bytes-to-text bs 0 (list-length bs) "")
      is None -> None

 Byte 13 is dropped rather than mapped. It is the one byte in a text file that
 from-unicode answers -1 for, so code-to-char would place an invalid character
 where a line ending was. __bare_metal_read_serial drops the same byte before
 its own CCE lookup, so a source arriving over the wire and the same source
 arriving off a volume have to agree here or the two compiles differ.

  fat16-source-chars : List Integer, List Integer, Integer, Integer, List Text -> List Text
  fat16-source-chars (tbl) (bs) (i) (len) (acc) =
    if i >= len then acc
    else if list-at bs i == 13 then fat16-source-chars tbl bs (i + 1) len acc
    else fat16-source-chars tbl bs (i + 1) len (list-push acc (char-to-text (code-to-char (fat16-byte-to-cce tbl (list-at bs i)))))

  fat16-read-source : Fat16Volume, Text -> [Device.Block] Maybe Text
  fat16-read-source (vol) (path) =
    when fat16-read-bytes vol path
      is Just (bs) -> Just (text-concat-list (fat16-source-chars cce-to-unicode-table bs 0 (list-length bs) []))
      is None -> None

  fat16-file-exists : Fat16Volume, Text -> [Device.Block] Boolean
  fat16-file-exists (vol) (path) =
    when fat16-resolve-path vol path
      is Just (entry) -> True
      is None -> False

Section: Asking Whether A File Is There

 The disk is asked about first, and that guard is not politeness. With no
 disk attached the block device hands back zeroes, the boot record parses
 into a volume whose bytes-per-sector is zero, and the first thing that
 divides by it takes the machine down. No disk means no files: that is an
 answer, not a fault.

 The guard asked the wrong thing, and asking it wrongly cost the whole
 function. It called block-sector-count, which returned 0 on a disk that was
 attached and read perfectly, so the guard fired every time and file-exists
 answered False for every path on every disk. The builtin it replaced
 answered True for every path. Same disease, opposite constant, and the
 second one is harder to see, because a missing file is a believable answer.

 That counter is fixed now (2026-07-13). The cause was not the guest: the ATA
 IDENTIFY was always correct. codex-vm returned 0xFF for the LBA-mid and
 LBA-high registers, which is the floating-bus "no drive" answer, and reading
 0x00/0x00 there after a drive select IS the ATA device signature -- so the
 drive detect concluded there was no disk and branched away before ever
 issuing IDENTIFY. Reads worked throughout, because READ SECTORS writes those
 registers and the write path was fine.

 The guard below still does not consult it, and should not. Whether the volume
 parses is the question this function actually needs answered, and it is the
 one that stays right no matter what the counter does.

 WHERE THE VOLUME STARTS IS A PROPERTY OF THE DISK, NOT A CONSTANT. This was
 2048 everywhere, which is only ever right for an image our own GptWriter
 laid down -- it puts its one ESP at LBA 2048 and nothing else does. A stick
 partitioned by anyone else, a vendor ESP, or our own dual-boot install
 (DriveManager places its Codex partition after the last existing one, at a
 computed offset) all put the volume somewhere else, and every read then
 lands on the wrong sectors and parses garbage as a boot record.

 WHICH PARTITION IS THE ONE WE WANT IS NOT ANSWERED BY ITS TYPE GUID. A
 dual-boot disk carries a FAT32 vendor ESP and a FAT16 Codex partition, and
 both are "the boot partition" by some reading. The test that actually
 matters is the one this chapter already uses everywhere else: does the
 volume parse. fat16-init is total and fat16-vol-is-usable is the existing
 judgement, so walk the table and take the first partition that answers yes.
 That is self-validating -- it cannot pick a partition it then fails to read
 -- and it is the same reasoning the prose above gives for asking the volume
 rather than a counter.

 NO READABLE GPT DOES NOT MEAN LBA 2048. UEFI firmware hands a payload booted
 from a GPT disk its own PARTITION as the block device (LoadedImage's
 DeviceHandle), and through that handle LBA 0 is the volume's first sector --
 the BPB itself -- while LBA 1 is a FAT sector that fails the GPT header
 check. So when gpt-read answers None, LBA 0 is probed as a BPB first: byte
 11 is the FAT boot record's bytes-per-sector low byte and 13 its
 sectors-per-cluster, and both are probed RAW before fat16-init is allowed
 near the sector, because fat16-parse-bpb divides by both and a protective
 MBR holds zeroes there. A raw FAT image with no partition table also mounts
 through this probe. 2048 survives as the last resort: no disk, or nothing
 that parses, and 2048 is as good a guess as it ever was.

  fat16-fallback-partition-start : Integer = 2048

  fat16-vol-is-usable : Fat16Volume -> Boolean
  fat16-vol-is-usable (vol) =
    (vol.vol-bytes-per-sector) > 0 & (vol.vol-sectors-per-cluster) > 0

  fat16-boot-volume : [Device.Block] Fat16Volume
  fat16-boot-volume = act
    disk <- gpt-read
    when disk
      is Just (d) -> fat16-first-usable (d.gd-partitions) 0 (list-length (d.gd-partitions))
      is None -> fat16-boot-volume-nogpt
  end

  fat16-boot-volume-nogpt : [Device.Block] Fat16Volume
  fat16-boot-volume-nogpt = act
    buf <- block-read-sector 0
    fat16-boot-volume-probe buf
  end

  fat16-boot-volume-probe : Integer -> [Device.Block] Fat16Volume
  fat16-boot-volume-probe (buf) =
    let bps = peek-byte buf 11 + peek-byte buf 12 * 256
    in let spc = peek-byte buf 13
    in if (bps == 512) & (spc > 0) then fat16-init 0
       else fat16-init fat16-fallback-partition-start

  fat16-first-usable : List GptPartition, Integer, Integer -> [Device.Block] Fat16Volume
  fat16-first-usable (parts) (i) (n) =
    if i >= n then fat16-init fat16-fallback-partition-start
    else let p = list-at parts i
    in act
      vol <- fat16-init (p.gp-start-lba)
      if fat16-vol-is-usable vol then vol
      else fat16-first-usable parts (i + 1) n
    end

  file-exists : Text -> [Device.Block] Boolean
  file-exists (path) = fat16-exists-on-disk path

  fat16-exists-on-disk : Text -> [Device.Block] Boolean
  fat16-exists-on-disk (path) = act
    vol <- fat16-boot-volume
    if fat16-vol-is-usable vol == False then False
    else fat16-file-exists vol path
  end

Section: Saving A File

 The effect row is [Device.Block] and not [FileSystem.Write], because
 [Device.Block] is what it actually does. There is no filesystem beneath this
 -- there is a disk, and a FAT16 volume we parse ourselves, and the row says
 so. A caller that wanted the fiction can no longer have it.

 The names carry the fat16- prefix, and that is deliberate rather than
 timid. Foreword chapter FileSystem declares write-file as an *effect
 operation* -- the abstract, handler-dispatched interface -- and a bare
 write-file defined here would collide with it in any chapter citing both.
 That is the duplicate-name hazard described above; it is not
 worth spending on a shorter name. file-exists took the bare name because
 nothing else claims it.

  fat16-text-bytes : Text, Integer, Integer, List Integer -> List Integer
  fat16-text-bytes (s) (i) (n) (acc) =
    if i >= n then acc
    else let b = to-unicode (char-code (char-at s i))
    in fat16-text-bytes s (i + 1) n (list-push acc b)

  fat16-write-file : Text, Text -> [Device.Block] Boolean
  fat16-write-file (path) (content) =
    let bytes = fat16-text-bytes content 0 (text-length content) []
    in fat16-write-binary-file path bytes

  fat16-write-binary-file : Text, List Integer -> [Device.Block] Boolean
  fat16-write-binary-file (path) (bytes) =
    fat16-write-source path (fat16-src-of-list bytes)

 fat16-write-segments is what a binary emitter wants: a leading list, a raw
 buffer, and a trailing list, written as one chain with no copy. The CDX sink
 uses it to put a header, a code buffer and a tail on the volume.

  fat16-write-segments : Text, List Integer, Integer, Integer, List Integer -> [Device.Block] Boolean
  fat16-write-segments (path) (head) (buf) (blen) (tail) =
    fat16-write-source path (fat16-src-of-parts head buf blen tail)

  fat16-write-source : Text, Fat16Source -> [Device.Block] Boolean
  fat16-write-source (path) (src) = act
    vol <- fat16-boot-volume
    fat16-create-file vol path src
  end

Section: Root Listing

 A scoped grant may not enumerate the root. Listing "/" answers with
 every name on the volume, including the ones the scope exists to keep
 out of reach, and a grant over "/config/" does not admit "/". This is
 the third gate, and it is the one a reader would never think to look
 for: neither fat16-list-root nor fat16-root-entries touches
 fat16-resolve-path, so neither of them was covered by the read gate.

 The name listing is the entry listing with the names taken out of it. The two
 used to be separate walks with identical structure, and only one of them
 would have learned to assemble a run.

  fat16-list-root : Fat16Volume -> [Device.Block] List Text
  fat16-list-root (vol) =
    if fat16-scope-admits "/" == False then []
    else act
      es <- fat16-root-entries vol
      fat16-entry-names es 0 (list-length es) []
    end

  fat16-entry-names : List Fat16DirEntry, Integer, Integer, List Text -> List Text
  fat16-entry-names (es) (i) (n) (acc) =
    if i >= n then acc
    else fat16-entry-names es (i + 1) n (list-push acc ((list-at es i).de-name))

 fat16-list-sector-entries has no caller in this chapter and is NOT dead:
 `fat32-list-dir-sectors` borrows it, because a FAT32 directory sector holds
 the same 32-byte entries a FAT16 one does. It answers 8.3 names and SKIPS
 long-name records rather than assembling them, which is what FAT32 wants:
 `Fat32.codex` has no long-name support of its own, so giving this one the
 assembling reader would hand FAT32 half a capability whose other half nothing
 over there implements.

  fat16-list-sector-entries : Integer, Integer, Integer, List Text -> List Text
  fat16-list-sector-entries (buf) (i) (count) (acc) =
    if i >= count then acc
    else let off = i * 32
    in if fat16-is-free-entry buf off then
      if peek-byte buf off == 0 then acc
      else fat16-list-sector-entries buf (i + 1) count acc
    else if fat16-is-lfn-entry buf off then fat16-list-sector-entries buf (i + 1) count acc
    else if fat16-is-volume-label buf off then fat16-list-sector-entries buf (i + 1) count acc
    else let entry = fat16-read-dir-entry buf off
    in fat16-list-sector-entries buf (i + 1) count (list-push acc (entry.de-name))

Section: Listing Any Directory

 A listing answers the LONG name where there is one, because a listing is what
 list-files filters by extension and an alias's extension is truncated: a
 directory of .codex chapters listed under its aliases answers .COD to every
 caller asking for .codex. The alias is still what fat16-read-dir-entry
 answers, and that is what the slot search and the alias search below need,
 so the two readings are separate functions rather than one with a flag.

  Fat16List = record {
    li-entries : List Fat16DirEntry,
    li-lfn : Fat16Lfn
  }

  fat16-read-entry-named : Integer, Integer, Fat16Lfn -> Fat16DirEntry
  fat16-read-entry-named (buf) (off) (st) =
    let e = fat16-read-dir-entry buf off
    in when fat16-lfn-final buf off st
      is Just (n) -> Fat16DirEntry { de-name = n, de-attr = (e.de-attr), de-cluster = (e.de-cluster), de-size = (e.de-size) }
      is None -> e

  fat16-entries-in-sector : Integer, Integer, Integer, List Fat16DirEntry, Fat16Lfn -> Fat16List
  fat16-entries-in-sector (buf) (i) (count) (acc) (st) =
    if i >= count then Fat16List { li-entries = acc, li-lfn = st }
    else let off = i * 32
    in if fat16-is-free-entry buf off then
      if peek-byte buf off == 0 then Fat16List { li-entries = acc, li-lfn = fat16-lfn-reset st }
      else fat16-entries-in-sector buf (i + 1) count acc (fat16-lfn-reset st)
    else if fat16-is-lfn-entry buf off then
      fat16-entries-in-sector buf (i + 1) count acc (fat16-lfn-absorb buf off st)
    else if fat16-is-volume-label buf off then
      fat16-entries-in-sector buf (i + 1) count acc (fat16-lfn-reset st)
    else let named = fat16-read-entry-named buf off st
    in fat16-entries-in-sector buf (i + 1) count (list-push acc named) (fat16-lfn-reset st)

  fat16-root-entries : Fat16Volume -> [Device.Block] List Fat16DirEntry
  fat16-root-entries (vol) =
    if fat16-scope-admits "/" == False then []
    else let root-sectors = ((vol.vol-root-entry-count) * 32 + (vol.vol-bytes-per-sector) - 1) / (vol.vol-bytes-per-sector)
    in fat16-root-entry-sectors vol (vol.vol-root-start) root-sectors 0 [] fat16-lfn-none

  fat16-root-entry-sectors : Fat16Volume, Integer, Integer, Integer, List Fat16DirEntry, Fat16Lfn -> [Device.Block] List Fat16DirEntry
  fat16-root-entry-sectors (vol) (sector) (remaining) (checked) (acc) (st) =
    if remaining == 0 then acc
    else if checked >= (vol.vol-root-entry-count) then acc
    else act
      buf <- block-read-sector sector
      let per = (vol.vol-bytes-per-sector) / 32
      in let r = fat16-entries-in-sector buf 0 per acc st
      in fat16-root-entry-sectors vol (sector + 1) (remaining - 1) (checked + per) (r.li-entries) (r.li-lfn)
    end

  fat16-cluster-entries : Fat16Volume, Integer, List Fat16DirEntry -> [Device.Block] List Fat16DirEntry
  fat16-cluster-entries (vol) (cluster) (acc) =
    fat16-cluster-entries-walk vol cluster acc cluster 1 0 fat16-lfn-none

  fat16-cluster-entries-walk : Fat16Volume, Integer, List Fat16DirEntry, Integer, Integer, Integer, Fat16Lfn -> [Device.Block] List Fat16DirEntry
  fat16-cluster-entries-walk (vol) (cluster) (acc) (saved) (power) (steps) (st) =
    if fat16-is-end cluster then acc
    else act
      here <- fat16-cluster-entry-sectors vol (fat16-cluster-sector vol cluster) (vol.vol-sectors-per-cluster) acc st
      next <- fat16-next-cluster vol cluster
      if next == saved then (here.li-entries)
      else if steps + 1 == power then fat16-cluster-entries-walk vol next (here.li-entries) next (power * 2) 0 (here.li-lfn)
      else fat16-cluster-entries-walk vol next (here.li-entries) saved power (steps + 1) (here.li-lfn)
    end

  fat16-cluster-entry-sectors : Fat16Volume, Integer, Integer, List Fat16DirEntry, Fat16Lfn -> [Device.Block] Fat16List
  fat16-cluster-entry-sectors (vol) (sector) (remaining) (acc) (st) =
    if remaining == 0 then Fat16List { li-entries = acc, li-lfn = st }
    else act
      buf <- block-read-sector sector
      let per = (vol.vol-bytes-per-sector) / 32
      in let r = fat16-entries-in-sector buf 0 per acc st
      in fat16-cluster-entry-sectors vol (sector + 1) (remaining - 1) (r.li-entries) (r.li-lfn)
    end

  fat16-is-root-path : Text -> Boolean
  fat16-is-root-path (p) =
    text-length p == 0 | p == "/" | p == "."

  fat16-is-dir-entry : Fat16DirEntry -> Boolean
  fat16-is-dir-entry (e) = bit-and (e.de-attr) 16 == 16

  fat16-list-dir : Fat16Volume, Text -> [Device.Block] List Fat16DirEntry
  fat16-list-dir (vol) (path) =
    if fat16-is-root-path path then fat16-root-entries vol
    else act
      found <- fat16-resolve-path vol path
      when found
        is Just (entry) ->
          if fat16-is-dir-entry entry then fat16-cluster-entries vol (entry.de-cluster) []
          else []
        is None -> []
    end

Section: Listing A Directory By Name

 No disk means no files, and the volume is what says so: with nothing
 attached the boot record parses out of zeroes and its bytes-per-sector is
 zero, which is the value the division would fault on. Ask the volume, not
 block-sector-count -- that counter reads 0 on a disk that works, and
 resting a filesystem answer on it is what made file-exists answer False
 for every path on every disk.

  list-files : Text, Text -> [Device.Block] List Text
  list-files (dir) (ext) = act
    vol <- fat16-boot-volume
    if fat16-vol-is-usable vol == False then []
    else act
      entries <- fat16-list-dir vol dir
      fat16-pick-files entries 0 (list-length entries) ext []
    end
  end

  fat16-pick-files : List Fat16DirEntry, Integer, Integer, Text, List Text -> List Text
  fat16-pick-files (es) (i) (n) (ext) (acc) =
    if i >= n then acc
    else let e = list-at es i
    in if fat16-is-dir-entry e then fat16-pick-files es (i + 1) n ext acc
    else if fat16-name-has-ext (e.de-name) ext then fat16-pick-files es (i + 1) n ext (list-push acc (e.de-name))
    else fat16-pick-files es (i + 1) n ext acc

  fat16-name-has-ext : Text, Text -> Boolean
  fat16-name-has-ext (name) (ext) =
    if text-length ext == 0 then True
    else text-ends-with (fat16-upper name) (fat16-upper ext)

  list-directories : Text -> [Device.Block] List Text
  list-directories (dir) = act
    vol <- fat16-boot-volume
    if fat16-vol-is-usable vol == False then []
    else act
      entries <- fat16-list-dir vol dir
      fat16-pick-dirs entries 0 (list-length entries) []
    end
  end

  fat16-pick-dirs : List Fat16DirEntry, Integer, Integer, List Text -> List Text
  fat16-pick-dirs (es) (i) (n) (acc) =
    if i >= n then acc
    else let e = list-at es i
    in if fat16-is-dir-entry e == False then fat16-pick-dirs es (i + 1) n acc
    else if (e.de-name) == "." then fat16-pick-dirs es (i + 1) n acc
    else if (e.de-name) == ".." then fat16-pick-dirs es (i + 1) n acc
    else fat16-pick-dirs es (i + 1) n (list-push acc (e.de-name))

