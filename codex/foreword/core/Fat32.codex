Chapter: Fat32
  cites Foreword chapter Maybe
  cites Foreword chapter Fat16

 We say:

Section: Types

  Fat32Volume = record {
    f32-part-start : Integer,
    f32-bytes-per-sector : Integer,
    f32-sectors-per-cluster : Integer,
    f32-reserved-sectors : Integer,
    f32-num-fats : Integer,
    f32-fat-sectors : Integer,
    f32-root-cluster : Integer,
    f32-fat-start : Integer,
    f32-data-start : Integer,
    f32-total-clusters : Integer,
    f32-next-free : Integer
  }

Section: BPB Parsing

  fat32-init : Integer -> [Device.Block] Fat32Volume
  fat32-init (part-start) = act
    buf <- block-read-sector part-start
    next-free <- fat32-read-fsinfo-next-free part-start
    fat32-parse-bpb32 part-start buf next-free
  end

 Byte 13 of the BPB is the divisor two lines below, and byte 11 sizes every
 read on the volume. With no disk attached the block device hands back a
 sector of zeroes, and dividing by that zero takes the machine out with
 !EXC=00 before anything downstream gets the chance to notice a bad volume.
 `Fat16` has answered a zeroed volume here since the same fault was found on
 its side; this chapter had no such escape and divided regardless.

  fat32-zero-volume : Integer -> Fat32Volume
  fat32-zero-volume (part-start) =
    Fat32Volume {
      f32-part-start = part-start,
      f32-bytes-per-sector = 0,
      f32-sectors-per-cluster = 0,
      f32-reserved-sectors = 0,
      f32-num-fats = 0,
      f32-fat-sectors = 0,
      f32-root-cluster = 0,
      f32-fat-start = 0,
      f32-data-start = 0,
      f32-total-clusters = 0,
      f32-next-free = 0
    }

  fat32-parse-bpb32 : Integer, Integer, Integer -> Fat32Volume
  fat32-parse-bpb32 (part-start) (buf) (next-free) =
    let bps = fat16-read-u16 buf 11
    in let spc = peek-byte buf 13
    in if bps == 0 then fat32-zero-volume part-start
    else if spc == 0 then fat32-zero-volume part-start
    else let reserved = fat16-read-u16 buf 14
    in let nfats = peek-byte buf 16
    in let fat-sz = fat16-read-u32 buf 36
    in let root-cluster = fat16-read-u32 buf 44
    in let fat-start = part-start + reserved
    in let data-start = fat-start + nfats * fat-sz
    in let total-sectors = fat16-read-u32 buf 32
    in let data-sectors = total-sectors - (reserved + nfats * fat-sz)
    in let raw-clusters = if data-sectors <= 0 then 0 else data-sectors / spc
    in let total-clusters = if raw-clusters > 268435445 then 268435445 else raw-clusters
    in Fat32Volume {
      f32-part-start = part-start,
      f32-bytes-per-sector = bps,
      f32-sectors-per-cluster = spc,
      f32-reserved-sectors = reserved,
      f32-num-fats = nfats,
      f32-fat-sectors = fat-sz,
      f32-root-cluster = root-cluster,
      f32-fat-start = fat-start,
      f32-data-start = data-start,
      f32-total-clusters = total-clusters,
      f32-next-free = next-free
    }

  fat32-read-fsinfo-next-free : Integer -> [Device.Block] Integer
  fat32-read-fsinfo-next-free (part-start) = act
    buf <- block-read-sector (part-start + 1)
    fat32-fsinfo-next-free-of buf
  end

  fat32-fsinfo-next-free-of : Integer -> Integer
  fat32-fsinfo-next-free-of (buf) =
    let sig = fat16-read-u32 buf 0
    in if sig /= 1098025042 then 3
    else let nf = fat16-read-u32 buf 492
    in if nf == 4294967295 then 3 else nf

Section: FAT Chain

 Per the FAT specification data clusters number from 2, and the highest one a
 volume has is its cluster count plus one. A cluster number arrives from a
 directory entry or from a FAT slot, both bytes on a medium we did not
 produce, and the read below turns one into a FAT sector address by
 arithmetic alone. The refusal answers 268435455, end-of-chain in this
 format's own 28-bit width, so a bad cluster truncates a chain instead of
 reading a foreign sector.

  fat32-last-cluster : Fat32Volume -> Integer
  fat32-last-cluster (vol) = (vol.f32-total-clusters) + 1

  fat32-cluster-ok : Fat32Volume, Integer -> Boolean
  fat32-cluster-ok (vol) (cluster) =
    cluster >= 2 & cluster <= fat32-last-cluster vol

 The walkers below carry Brent's cycle detection, as `Fat16` does and for the
 same reason: a cyclic chain is well formed at every step, so only a bound on
 the walk catches it. A saved cluster, a power and a step count; each step
 compares the next cluster against the saved one and re-saves on a doubling
 schedule. It is Brent rather than Floyd because every step is a FAT sector
 read and Floyd's hare would take two of them per iteration.

 A count of clusters would not have served as the bound: it is computed from
 BPB fields the image supplies, so the image would be setting it, and on this
 format the clamped maximum is 268435445 -- finite, and far too many reads to
 survive.

  fat32-next-cluster : Fat32Volume, Integer -> [Device.Block] Integer
  fat32-next-cluster (vol) (cluster) = act
    if fat32-cluster-ok vol cluster == False then 268435455
    else act
      buf <- block-read-sector ((vol.f32-fat-start) + (cluster * 4) / 512)
      bit-and (fat16-read-u32 buf (int-mod (cluster * 4) 512)) 268435455
    end
  end

  fat32-is-end : Integer -> Boolean
  fat32-is-end (cluster) = cluster >= 268435448

  fat32-cluster-sector : Fat32Volume, Integer -> Integer
  fat32-cluster-sector (vol) (cluster) =
    (vol.f32-data-start) + (cluster - 2) * (vol.f32-sectors-per-cluster)

Section: FAT Write

  fat32-set-fat-entry : Fat32Volume, Integer, Integer -> [Device.Block] Integer
  fat32-set-fat-entry (vol) (cluster) (value) = act
    buf <- block-read-sector ((vol.f32-fat-start) + (cluster * 4) / 512)
    fat32-fmt-u32 buf (int-mod (cluster * 4) 512) value
    block-write-sector ((vol.f32-fat-start) + (cluster * 4) / 512) buf
    buf2 <- block-read-sector ((vol.f32-fat-start) + (cluster * 4) / 512 + (vol.f32-fat-sectors))
    fat32-fmt-u32 buf2 (int-mod (cluster * 4) 512) value
    block-write-sector ((vol.f32-fat-start) + (cluster * 4) / 512 + (vol.f32-fat-sectors)) buf2
  end

  fat32-alloc-cluster : Fat32Volume, Integer -> [Device.Block] Integer
  fat32-alloc-cluster (vol) (start) =
    fat32-alloc-loop vol start (vol.f32-total-clusters + 2)

  fat32-alloc-loop : Fat32Volume, Integer, Integer -> [Device.Block] Integer
  fat32-alloc-loop (vol) (cluster) (limit) =
    if cluster >= limit then 0
    else when fat32-next-cluster vol cluster
      is 0 -> cluster
      is otherwise -> fat32-alloc-loop vol (cluster + 1) limit

  fat32-alloc-chain : Fat32Volume, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-alloc-chain (vol) (count) (search-from) (first) =
    if count <= 0 then first
    else act
      c <- fat32-alloc-cluster vol search-from
      fat32-alloc-chain-step vol count c first
    end

  fat32-alloc-chain-step : Fat32Volume, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-alloc-chain-step (vol) (count) (c) (first) =
    if c == 0 then 0
    else if first == 0 then act
      fat32-set-fat-entry vol c 268435455
      fat32-alloc-chain vol (count - 1) (c + 1) c
    end
    else act
      prev-last <- fat32-find-chain-end vol first
      fat32-set-fat-entry vol prev-last c
      fat32-set-fat-entry vol c 268435455
      fat32-alloc-chain vol (count - 1) (c + 1) first
    end

  fat32-find-chain-end : Fat32Volume, Integer -> [Device.Block] Integer
  fat32-find-chain-end (vol) (cluster) =
    fat32-find-chain-end-walk vol cluster cluster 1 0

  fat32-find-chain-end-walk : Fat32Volume, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-find-chain-end-walk (vol) (cluster) (saved) (power) (steps) = act
    next <- fat32-next-cluster vol cluster
    if fat32-is-end next then cluster
    else if next == saved then cluster
    else if steps + 1 == power then fat32-find-chain-end-walk vol next next (power * 2) 0
    else fat32-find-chain-end-walk vol next saved power (steps + 1)
  end

Section: Directory Reading

 A run is up to 640 bytes and a FAT32 directory is walked one 512-byte sector
 at a time inside a cluster chain, so the assembling state has to survive both
 a sector boundary and a cluster boundary. That is why the 8.3 scanner was
 this chapter's until now: pointing the assembling one at an untreaded walk
 would have caught a run only when it happened to fall inside one sector.
 `Fat16.codex` "Two scanners over the same bytes" recorded that, and the state
 is threaded here rather than the scanner being swapped underneath it.

 `fat32-find-in-dir` keeps its three arguments because `DriveManager` resolves
 the ESP through it; the run state is opened here and never crosses the seam.

  fat32-find-in-dir : Fat32Volume, Integer, Text -> [Device.Block] Maybe Fat16DirEntry
  fat32-find-in-dir (vol) (cluster) (name) =
    fat32-find-in-dir-walk vol cluster name cluster 1 0 fat16-lfn-none

  fat32-find-in-dir-walk : Fat32Volume, Integer, Text, Integer, Integer, Integer, Fat16Lfn -> [Device.Block] Maybe Fat16DirEntry
  fat32-find-in-dir-walk (vol) (cluster) (name) (saved) (power) (steps) (st) =
    if fat32-is-end cluster then None
    else if cluster < 2 then None
    else act
      r <- fat32-scan-dir-sectors vol name (fat32-cluster-sector vol cluster) (vol.f32-sectors-per-cluster) st
      fat32-dir-found-or-next vol cluster name saved power steps r
    end

  fat32-dir-found-or-next : Fat32Volume, Integer, Text, Integer, Integer, Integer, Fat16Scan -> [Device.Block] Maybe Fat16DirEntry
  fat32-dir-found-or-next (vol) (cluster) (name) (saved) (power) (steps) (r) =
    when (r.sc-found)
      is Just (entry) -> Just entry
      is None -> fat32-find-in-dir-step vol cluster name saved power steps (r.sc-lfn)

  fat32-find-in-dir-step : Fat32Volume, Integer, Text, Integer, Integer, Integer, Fat16Lfn -> [Device.Block] Maybe Fat16DirEntry
  fat32-find-in-dir-step (vol) (cluster) (name) (saved) (power) (steps) (st) = act
    nxt <- fat32-next-cluster vol cluster
    if nxt == saved then None
    else if steps + 1 == power then fat32-find-in-dir-walk vol nxt name nxt (power * 2) 0 st
    else fat32-find-in-dir-walk vol nxt name saved power (steps + 1) st
  end

  fat32-scan-dir-sectors : Fat32Volume, Text, Integer, Integer, Fat16Lfn -> [Device.Block] Fat16Scan
  fat32-scan-dir-sectors (vol) (name) (sector) (remaining) (st) =
    if remaining == 0 then Fat16Scan { sc-found = None, sc-lfn = st }
    else act
      buf <- block-read-sector sector
      fat32-scan-dir-step vol name sector remaining buf st
    end

  fat32-scan-dir-step : Fat32Volume, Text, Integer, Integer, Integer, Fat16Lfn -> [Device.Block] Fat16Scan
  fat32-scan-dir-step (vol) (name) (sector) (remaining) (buf) (st) =
    let r = fat16-scan-sector-lfn buf name 0 (512 / 32) st
    in when (r.sc-found)
      is Just (e) -> r
      is None -> fat32-scan-dir-sectors vol name (sector + 1) (remaining - 1) (r.sc-lfn)

Section: Path Resolution

  fat32-resolve-path : Fat32Volume, Text -> [Device.Block] Maybe Fat16DirEntry
  fat32-resolve-path (vol) (path) =
    let parts = fat16-split-path path
    in fat32-walk-path vol parts 0 (list-length parts) (vol.f32-root-cluster)

  fat32-walk-path : Fat32Volume, List Text, Integer, Integer, Integer -> [Device.Block] Maybe Fat16DirEntry
  fat32-walk-path (vol) (parts) (depth) (total) (dir-cluster) =
    if depth >= total then None
    else let name = list-at parts depth
    in when fat32-find-in-dir vol dir-cluster name
      is Just (entry) ->
        if depth == total - 1 then Just entry
        else if bit-and (entry.de-attr) 16 == 16
          then let child-cluster = entry.de-cluster
          in fat32-walk-path vol parts (depth + 1) total child-cluster
          else None
      is None -> None

Section: File Reading

  fat32-read-cluster-bytes : Fat32Volume, Integer, Integer, Integer, List Integer -> [Device.Block] List Integer
  fat32-read-cluster-bytes (vol) (cluster) (remaining) (sector-off) (acc) =
    if remaining <= 0 then acc
    else if fat32-is-end cluster then acc
    else if cluster < 2 then acc
    else act
      buf <- block-read-sector (fat32-cluster-sector vol cluster + sector-off)
      fat32-read-cluster-step vol cluster remaining sector-off acc buf
    end

  fat32-read-cluster-step : Fat32Volume, Integer, Integer, Integer, List Integer, Integer -> [Device.Block] List Integer
  fat32-read-cluster-step (vol) (cluster) (remaining) (sector-off) (acc) (buf) =
    let bytes-this = if remaining < 512 then remaining else 512
    in let acc2 = fat16-copy-bytes buf 0 bytes-this acc
    in let next-off = sector-off + 1
    in if next-off >= (vol.f32-sectors-per-cluster)
      then fat32-read-cluster-bytes vol (fat32-next-cluster vol cluster) (remaining - bytes-this) 0 acc2
      else fat32-read-cluster-bytes vol cluster (remaining - bytes-this) next-off acc2

  fat32-read-bytes : Fat32Volume, Text -> [Device.Block] Maybe (List Integer)
  fat32-read-bytes (vol) (path) =
    when fat32-resolve-path vol path
      is Just (entry) -> Just (fat32-read-cluster-bytes vol (entry.de-cluster) (entry.de-size) 0 [])
      is None -> None

  fat32-read-text : Fat32Volume, Text -> [Device.Block] Maybe Text
  fat32-read-text (vol) (path) =
    when fat32-read-bytes vol path
      is Just (bs) -> Just (fat16-bytes-to-text bs 0 (list-length bs) "")
      is None -> None

  fat32-file-exists : Fat32Volume, Text -> [Device.Block] Boolean
  fat32-file-exists (vol) (path) =
    when fat32-resolve-path vol path
      is Just (entry) -> True
      is None -> False

Section: Root Listing

  fat32-list-root : Fat32Volume -> [Device.Block] List Text
  fat32-list-root (vol) =
    fat32-list-dir-cluster vol (vol.f32-root-cluster) []

  fat32-list-dir-cluster : Fat32Volume, Integer, List Text -> [Device.Block] List Text
  fat32-list-dir-cluster (vol) (cluster) (acc) =
    fat32-list-dir-walk vol cluster acc cluster 1 0

  fat32-list-dir-walk : Fat32Volume, Integer, List Text, Integer, Integer, Integer -> [Device.Block] List Text
  fat32-list-dir-walk (vol) (cluster) (acc) (saved) (power) (steps) =
    if fat32-is-end cluster then acc
    else if cluster < 2 then acc
    else fat32-list-dir-step vol cluster (fat32-list-dir-sectors (fat32-cluster-sector vol cluster) (vol.f32-sectors-per-cluster) acc) saved power steps

  fat32-list-dir-step : Fat32Volume, Integer, List Text, Integer, Integer, Integer -> [Device.Block] List Text
  fat32-list-dir-step (vol) (cluster) (acc) (saved) (power) (steps) = act
    nxt <- fat32-next-cluster vol cluster
    if nxt == saved then acc
    else if steps + 1 == power then fat32-list-dir-walk vol nxt acc nxt (power * 2) 0
    else fat32-list-dir-walk vol nxt acc saved power (steps + 1)
  end

  fat32-list-dir-sectors : Integer, Integer, List Text -> [Device.Block] List Text
  fat32-list-dir-sectors (sector) (remaining) (acc) =
    if remaining == 0 then acc
    else act
      buf <- block-read-sector sector
      fat32-list-dir-sectors (sector + 1) (remaining - 1) (fat16-list-sector-entries buf 0 16 acc)
    end

Section: File Writing

 A name no run can hold is refused rather than written short. The format caps
 a long name at 255 characters and a run at 20 records, and a name past that
 would be spelled by a run whose ordinals no reader will reassemble, which
 comes back under the 8.3 alias and reads as a file that was written with a
 different name.

  fat32-write-file : Fat32Volume, Text, List Integer -> [Device.Block] Boolean
  fat32-write-file (vol) (path) (data) =
    if fat16-path-writable path == False then False
    else let parts = fat16-split-path path
    in act
      dir-cluster <- fat32-ensure-parent-dirs vol parts 0 (list-length parts - 1) (vol.f32-root-cluster)
      fat32-write-file-step vol parts data dir-cluster
    end

  fat32-write-file-step : Fat32Volume, List Text, List Integer, Integer -> [Device.Block] Boolean
  fat32-write-file-step (vol) (parts) (data) (dir-cluster) =
    if dir-cluster == 0 then False
    else let data-len = list-length data
    in let clusters-needed = if data-len == 0 then 1 else (data-len + (vol.f32-sectors-per-cluster) * 512 - 1) / ((vol.f32-sectors-per-cluster) * 512)
    in act
      first-cluster <- fat32-alloc-chain vol clusters-needed (vol.f32-next-free) 0
      fat32-write-file-finish vol data dir-cluster (list-at parts (list-length parts - 1)) first-cluster
    end

  fat32-write-file-finish : Fat32Volume, List Integer, Integer, Text, Integer -> [Device.Block] Boolean
  fat32-write-file-finish (vol) (data) (dir-cluster) (file-name) (first-cluster) =
    if first-cluster == 0 then False
    else act
      fat32-write-data-to-chain vol first-cluster data 0
      r <- fat32-add-dir-entry vol dir-cluster file-name 32 first-cluster (list-length data)
      fat32-entry-ok r
    end

  fat32-entry-ok : Integer -> Boolean
  fat32-entry-ok (r) = r == 0

  fat32-write-data-to-chain : Fat32Volume, Integer, List Integer, Integer -> [Device.Block] Integer
  fat32-write-data-to-chain (vol) (cluster) (data) (offset) =
    if offset >= list-length data then 0
    else if fat32-is-end cluster then 0
    else act
      fat32-write-cluster-data vol cluster data offset ((vol.f32-sectors-per-cluster) * 512)
      fat32-write-data-to-chain vol (fat32-next-cluster vol cluster) data (offset + (vol.f32-sectors-per-cluster) * 512)
    end

  fat32-write-cluster-data : Fat32Volume, Integer, List Integer, Integer, Integer -> [Device.Block] Integer
  fat32-write-cluster-data (vol) (cluster) (data) (offset) (cluster-bytes) =
    fat32-write-cluster-sectors vol cluster data offset 0 (vol.f32-sectors-per-cluster)

  fat32-write-cluster-sectors : Fat32Volume, Integer, List Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-write-cluster-sectors (vol) (cluster) (data) (offset) (sec-idx) (spc) =
    if sec-idx >= spc then 0
    else let buf = alloc-bytes 512
    in let z = fat32-zero-buf buf 0
    in let w = fat32-fill-buf buf data (offset + sec-idx * 512) 0 512
    in act
      block-write-sector (fat32-cluster-sector vol cluster + sec-idx) buf
      fat32-write-cluster-sectors vol cluster data offset (sec-idx + 1) spc
    end

  fat32-zero-buf : Integer, Integer -> Integer
  fat32-zero-buf (buf) (i) =
    if i >= 512 then 0
    else let w = poke-byte buf i 0
    in fat32-zero-buf buf (i + 1)

  fat32-fill-buf : Integer, List Integer, Integer, Integer, Integer -> Integer
  fat32-fill-buf (buf) (data) (data-off) (buf-off) (count) =
    if buf-off >= count then 0
    else if data-off >= list-length data then 0
    else let w = poke-byte buf buf-off (list-at data data-off)
    in fat32-fill-buf buf data (data-off + 1) (buf-off + 1) count

Section: Directory Entry Writing

 VFAT spells a name the 8.3 field cannot hold as a run of 32-byte records
 placed IMMEDIATELY BEFORE the short entry they belong to, in descending
 sequence, and that adjacency is the only thing binding the two. Slots run
 consecutively across the sectors of a cluster, which are contiguous on the
 medium, but NOT across a directory's clusters: the next one sits wherever
 the allocator put it. So a run goes inside one cluster, and a directory
 with no cluster roomy enough grows a fresh one.

 A slot is addressed by absolute byte throughout, which is what lets a run
 straddle a sector boundary without the placer knowing it happened. It is
 also the arithmetic the reader already uses, and the same arithmetic
 `fat16-write-lfn-slot` performs on the FAT16 side.

  fat32-slots-for : Text -> Integer
  fat32-slots-for (name) = fat16-records-for name + 1

  fat32-add-dir-entry : Fat32Volume, Integer, Text, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-add-dir-entry (vol) (dir-cluster) (name) (attr) (cluster) (size) = act
    short <- fat32-pick-alias-dir vol dir-cluster name 1
    fat32-add-with-alias vol dir-cluster name short attr cluster size
  end

  fat32-add-with-alias : Fat32Volume, Integer, Text, Text, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-add-with-alias (vol) (dir-cluster) (name) (short) (attr) (cluster) (size) =
    if text-length short == 0 then 0 - 1
    else act
      slot <- fat32-find-or-grow-run-in-dir vol dir-cluster (fat32-slots-for name)
      fat32-add-at-run vol name short attr cluster size slot
    end

 The records go down before the short entry. A run with no short entry
 beneath it is skipped by every reader, ours included, because a run is only
 ever claimed by the entry it sits on; a short entry with no run reads under
 its 8.3 alias, which is a real file. Either half alone is harmless, and
 writing the cheap half last is what makes the file appear whole.

  fat32-add-at-run : Fat32Volume, Text, Text, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-add-at-run (vol) (name) (short) (attr) (cluster) (size) (slot) =
    if slot < 0 then 0 - 1
    else act
      w <- fat32-write-run name short slot (fat16-records-for name)
      fat32-commit-short w name short attr cluster size slot
    end

  fat32-commit-short : Integer, Text, Text, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-commit-short (w) (name) (short) (attr) (cluster) (size) (slot) =
    if w /= 0 then w
    else let at = slot + fat16-records-for name * 32
    in fat32-write-entry-at (at / 512) (int-mod at 512) (fat32-to-83 short) attr cluster size

Section: Writing A Long Name

 `block-write-sector` answers 0 for SUCCESS. A record write that fails and
 is not read leaves the run short while the short entry below it still
 lands, so the file comes back under its 8.3 alias and not under the name it
 was written with, which is the write-and-read disagreement this whole
 section exists to remove, reintroduced one layer down. The status is
 threaded and the first failure stops the walk.

  fat32-write-run : Text, Text, Integer, Integer -> [Device.Block] Integer
  fat32-write-run (name) (short) (slot) (records) =
    fat32-write-run-step name (fat16-short-checksum-of short) slot records 0

  fat32-write-run-step : Text, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-write-run-step (name) (sum) (slot) (records) (j) =
    if j >= records then 0
    else act
      w <- fat16-write-lfn-slot name sum (slot + j * 32) (records - j) (j == 0)
      fat32-write-run-next name sum slot records j w
    end

  fat32-write-run-next : Text, Integer, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-write-run-next (name) (sum) (slot) (records) (j) (w) =
    if w /= 0 then w
    else fat32-write-run-step name sum slot records (j + 1)

Section: Finding A Run Of Free Slots

 A run that began in an earlier sector answers a NEGATIVE slot index, and
 the address arithmetic below is what makes that the right answer rather
 than a special case: sector times 512 plus a negative offset lands in the
 previous sector, which is where the run really starts. The streak resets at
 every cluster because a run may not cross one.

  fat32-find-run-in-dir : Fat32Volume, Integer, Integer -> [Device.Block] Integer
  fat32-find-run-in-dir (vol) (cluster) (need) =
    fat32-run-dir-walk vol cluster need cluster 1 0

  fat32-run-dir-walk : Fat32Volume, Integer, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-run-dir-walk (vol) (cluster) (need) (saved) (power) (steps) =
    if fat32-is-end cluster then 0 - 1
    else if cluster < 2 then 0 - 1
    else act
      found <- fat32-run-dir-sectors vol need (fat32-cluster-sector vol cluster) (vol.f32-sectors-per-cluster) 0
      fat32-run-dir-or-next vol cluster need found saved power steps
    end

  fat32-run-dir-or-next : Fat32Volume, Integer, Integer, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-run-dir-or-next (vol) (cluster) (need) (found) (saved) (power) (steps) = act
    if found >= 0 then found
    else act
      nxt <- fat32-next-cluster vol cluster
      if nxt == saved then 0 - 1
      else if steps + 1 == power then fat32-run-dir-walk vol nxt need nxt (power * 2) 0
      else fat32-run-dir-walk vol nxt need saved power (steps + 1)
    end
  end

  fat32-run-dir-sectors : Fat32Volume, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-run-dir-sectors (vol) (need) (sector) (remaining) (streak) =
    if remaining == 0 then 0 - 1
    else act
      buf <- block-read-sector sector
      fat32-run-dir-step vol need sector remaining streak buf
    end

  fat32-run-dir-step : Fat32Volume, Integer, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-run-dir-step (vol) (need) (sector) (remaining) (streak) (buf) =
    let eps = (vol.f32-bytes-per-sector) / 32
    in let r = fat16-run-in-sector buf 0 eps need streak
    in if (r.rn-found) then sector * 512 + (r.rn-at) * 32
       else fat32-run-dir-sectors vol need (sector + 1) (remaining - 1) (r.rn-streak)

  fat32-find-or-grow-run-in-dir : Fat32Volume, Integer, Integer -> [Device.Block] Integer
  fat32-find-or-grow-run-in-dir (vol) (cluster) (need) = act
    found <- fat32-find-run-in-dir vol cluster need
    fat32-run-or-grow vol cluster need found
  end

  fat32-run-or-grow : Fat32Volume, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-run-or-grow (vol) (cluster) (need) (found) =
    if found >= 0 then found
    else if need * 32 > (vol.f32-sectors-per-cluster) * 512 then 0 - 1
    else act
      last <- fat32-find-chain-end vol cluster
      fat32-grow-dir-at vol last
    end

Section: Growing A Directory

 The fresh cluster is claimed and zeroed BEFORE it is linked. A directory's
 extent is not recorded anywhere: a reader stops at the first slot whose
 first byte is zero, so a cluster carrying a previous tenant's bytes reads
 as entries, and one linked before it is terminated is a chain a reader can
 walk off the end of.

  fat32-grow-dir-at : Fat32Volume, Integer -> [Device.Block] Integer
  fat32-grow-dir-at (vol) (last) = act
    fresh <- fat32-alloc-cluster vol (vol.f32-next-free)
    fat32-grow-dir-with vol last fresh
  end

  fat32-grow-dir-with : Fat32Volume, Integer, Integer -> [Device.Block] Integer
  fat32-grow-dir-with (vol) (last) (fresh) =
    if fresh == 0 then 0 - 1
    else act
      m <- fat32-set-fat-entry vol fresh 268435455
      z <- fat32-zero-dir-cluster vol fresh 0
      l <- fat32-set-fat-entry vol last fresh
      fat32-cluster-byte vol fresh
    end

  fat32-cluster-byte : Fat32Volume, Integer -> Integer
  fat32-cluster-byte (vol) (cluster) = fat32-cluster-sector vol cluster * 512

 One buffer for the whole cluster, because every sector of it is the same
 bytes. Taking it inside the loop costs 512 bytes per sector with no
 collector to take them back, which at eight sectors per cluster is 4 KB
 permanent per directory created or grown.

  fat32-zero-dir-cluster : Fat32Volume, Integer, Integer -> [Device.Block] Integer
  fat32-zero-dir-cluster (vol) (cluster) (i) =
    let buf = alloc-bytes 512
    in let z = fat32-zero-buf buf 0
    in fat32-zero-dir-sectors vol cluster i buf

  fat32-zero-dir-sectors : Fat32Volume, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-zero-dir-sectors (vol) (cluster) (i) (buf) =
    if i >= (vol.f32-sectors-per-cluster) then 0
    else act
      block-write-sector (fat32-cluster-sector vol cluster + i) buf
      fat32-zero-dir-sectors vol cluster (i + 1) buf
    end

Section: Choosing An Alias

 An alias is searched for rather than derived, because uniqueness is a fact
 about the directory and not about the name. A name needing no run keeps its
 own spelling and no search happens at all. An empty answer means the search
 ran out of numbers, and it is a refusal: there is no alias left to write
 under, and writing a duplicate would be the failure this is here to avoid.

  fat32-pick-alias-dir : Fat32Volume, Integer, Text, Integer -> [Device.Block] Text
  fat32-pick-alias-dir (vol) (cluster) (name) (n) =
    if fat16-needs-long name == False then name
    else if n > fat16-alias-max-tries then ""
    else let cand = fat16-alias-of name n
    in act
      taken <- fat32-find-name-slot-in-dir vol cluster cand
      if taken >= 0 then fat32-pick-alias-dir vol cluster name (n + 1) else cand
    end

  fat32-find-name-slot-in-dir : Fat32Volume, Integer, Text -> [Device.Block] Integer
  fat32-find-name-slot-in-dir (vol) (cluster) (name) =
    fat32-name-slot-walk vol cluster name cluster 1 0

  fat32-name-slot-walk : Fat32Volume, Integer, Text, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-name-slot-walk (vol) (cluster) (name) (saved) (power) (steps) =
    if fat32-is-end cluster then 0 - 1
    else if cluster < 2 then 0 - 1
    else act
      found <- fat32-name-slot-sectors vol name (fat32-cluster-sector vol cluster) (vol.f32-sectors-per-cluster)
      fat32-name-slot-or-next vol cluster name found saved power steps
    end

  fat32-name-slot-or-next : Fat32Volume, Integer, Text, Integer, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-name-slot-or-next (vol) (cluster) (name) (found) (saved) (power) (steps) = act
    if found >= 0 then found
    else act
      nxt <- fat32-next-cluster vol cluster
      if nxt == saved then 0 - 1
      else if steps + 1 == power then fat32-name-slot-walk vol nxt name nxt (power * 2) 0
      else fat32-name-slot-walk vol nxt name saved power (steps + 1)
    end
  end

  fat32-name-slot-sectors : Fat32Volume, Text, Integer, Integer -> [Device.Block] Integer
  fat32-name-slot-sectors (vol) (name) (sector) (remaining) =
    if remaining == 0 then 0 - 1
    else act
      buf <- block-read-sector sector
      fat32-name-slot-step vol name sector remaining buf
    end

  fat32-name-slot-step : Fat32Volume, Text, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-name-slot-step (vol) (name) (sector) (remaining) (buf) =
    let eps = (vol.f32-bytes-per-sector) / 32
    in let found = fat16-name-slot-in-sector buf name 0 eps
    in if found >= 0 then sector * 512 + found
       else fat32-name-slot-sectors vol name (sector + 1) (remaining - 1)

  fat32-write-entry-at : Integer, Integer, Text, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-write-entry-at (sector) (off) (name83) (attr) (cluster) (size) = act
    buf <- block-read-sector sector
    fat32-write-entry-fields buf off name83 attr cluster size
    block-write-sector sector buf
  end

  fat32-write-entry-fields : Integer, Integer, Text, Integer, Integer, Integer -> Integer
  fat32-write-entry-fields (buf) (off) (name83) (attr) (cluster) (size) =
    let w0 = fat32-write-name83 buf off name83 0
    in let w1 = poke-byte buf (off + 11) attr
    in let w2 = poke-byte buf (off + 20) (bit-and (bit-shru cluster 16) 255)
    in let w3 = poke-byte buf (off + 21) (bit-and (bit-shru cluster 24) 255)
    in let w4 = poke-byte buf (off + 26) (bit-and cluster 255)
    in let w5 = poke-byte buf (off + 27) (bit-and (bit-shru cluster 8) 255)
    in let w6 = poke-byte buf (off + 28) (bit-and size 255)
    in let w7 = poke-byte buf (off + 29) (bit-and (bit-shru size 8) 255)
    in let w8 = poke-byte buf (off + 30) (bit-and (bit-shru size 16) 255)
    in poke-byte buf (off + 31) (bit-and (bit-shru size 24) 255)

 A directory entry's name is ASCII on the medium. `char-code` answers the CCE
 code point, so this wrote `EFI` as three CCE bytes and the resulting volume
 was unreadable by anything expecting FAT -- including this library's own
 reader, which converts the other way (`fat16-extract-chars` does
 `from-unicode`), and including every UEFI firmware, which is the entire point
 of writing an ESP.

 Nothing caught it because nothing had ever read a volume this code wrote. The
 shipped images are formatted by `build/build-img.ps1` on the host, in ASCII,
 and the only in-tree writer is the drive installer, which could not run while
 block-select selected nothing.

  fat32-write-name83 : Integer, Integer, Text, Integer -> Integer
  fat32-write-name83 (buf) (off) (name) (i) =
    if i >= 11 then 0
    else if i >= text-length name then
      let w = poke-byte buf (off + i) 32
      in fat32-write-name83 buf off name (i + 1)
    else let w = poke-byte buf (off + i) (to-unicode (char-code (char-at name i)))
    in fat32-write-name83 buf off name (i + 1)

Section: 8.3 Name Conversion

  fat32-to-83 : Text -> Text
  fat32-to-83 (name) =
    let dot = fat32-find-dot name 0 (text-length name)
    in if dot < 0
      then fat32-pad-right (fat16-upper name) 11
      else let base = fat32-pad-right (fat16-upper (substring name 0 dot)) 8
      in let ext = fat32-pad-right (fat16-upper (substring name (dot + 1) (text-length name - dot - 1))) 3
      in base & ext

 The 46 is ASCII for a full stop, and `char-code` does not answer ASCII, so no
 name ever split at its dot: `BOOTX64.EFI` was padded whole into eleven
 characters as `BOOTX64.EFI` rather than `BOOTX64 EFI`, which is a different
 entry from the one any reader looks up.

  fat32-find-dot : Text, Integer, Integer -> Integer
  fat32-find-dot (s) (i) (len) =
    if i >= len then 0 - 1
    else if to-unicode (char-code (char-at s i)) == 46 then i
    else fat32-find-dot s (i + 1) len

  fat32-pad-right : Text, Integer -> Text
  fat32-pad-right (s) (width) =
    if text-length s >= width then substring s 0 width
    else fat32-pad-right (s & " ") width

Section: Directory Creation

  fat32-mkdir : Fat32Volume, Integer, Text -> [Device.Block] Integer
  fat32-mkdir (vol) (parent-cluster) (name) = act
    dir-cluster <- fat32-alloc-chain vol 1 (vol.f32-next-free) 0
    fat32-mkdir-step vol parent-cluster name dir-cluster
  end

  fat32-mkdir-step : Fat32Volume, Integer, Text, Integer -> [Device.Block] Integer
  fat32-mkdir-step (vol) (parent-cluster) (name) (dir-cluster) =
    if dir-cluster == 0 then 0
    else let buf = alloc-bytes 512
    in let z = fat32-zero-buf buf 0
    in let w = fat32-mkdir-dot-entries buf dir-cluster parent-cluster
    in act
      c <- fat32-zero-dir-cluster vol dir-cluster 0
      block-write-sector (fat32-cluster-sector vol dir-cluster) buf
      r <- fat32-add-dir-entry vol parent-cluster name 16 dir-cluster 0
      fat32-mkdir-result r dir-cluster
    end

  fat32-mkdir-result : Integer, Integer -> Integer
  fat32-mkdir-result (r) (dir-cluster) = if r == 0 then dir-cluster else 0

  fat32-mkdir-dot-entries : Integer, Integer, Integer -> Integer
  fat32-mkdir-dot-entries (buf) (dir-cluster) (parent-cluster) =
    let w0 = fat32-write-name83 buf 0 ".          " 0
    in let w1 = poke-byte buf 11 16
    in let w2 = poke-byte buf 26 (bit-and dir-cluster 255)
    in let w3 = poke-byte buf 27 (bit-and (bit-shru dir-cluster 8) 255)
    in let w4 = poke-byte buf 20 (bit-and (bit-shru dir-cluster 16) 255)
    in let w5 = poke-byte buf 21 (bit-and (bit-shru dir-cluster 24) 255)
    in let w6 = fat32-write-name83 buf 32 "..         " 0
    in let w7 = poke-byte buf 43 16
    in let w8 = poke-byte buf 58 (bit-and parent-cluster 255)
    in let w9 = poke-byte buf 59 (bit-and (bit-shru parent-cluster 8) 255)
    in let w10 = poke-byte buf 52 (bit-and (bit-shru parent-cluster 16) 255)
    in poke-byte buf 53 (bit-and (bit-shru parent-cluster 24) 255)

  fat32-ensure-parent-dirs : Fat32Volume, List Text, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-ensure-parent-dirs (vol) (parts) (depth) (stop) (current) =
    if depth >= stop then current
    else let name = list-at parts depth
    in when fat32-find-in-dir vol current name
      is Just (entry) ->
        if bit-and (entry.de-attr) 16 == 16
          then fat32-ensure-parent-dirs vol parts (depth + 1) stop (entry.de-cluster)
          else 0
      is None -> fat32-ensure-parent-child vol parts depth stop (fat32-mkdir vol current name)

  fat32-ensure-parent-child : Fat32Volume, List Text, Integer, Integer, Integer -> [Device.Block] Integer
  fat32-ensure-parent-child (vol) (parts) (depth) (stop) (new-dir) =
    if new-dir == 0 then 0
    else fat32-ensure-parent-dirs vol parts (depth + 1) stop new-dir

Section: Format

  fat32-format : Integer, Integer, Text -> [Device.Block] Boolean
  fat32-format (part-start) (part-sectors) (label) =
    let spc = fat32-pick-spc part-sectors
    in let reserved = 32
    in let fat-sectors = ((part-sectors - reserved + 2) * 4 + 511) / 512
    in let buf = alloc-bytes 512
    in act
      fat32-format-bpb buf part-start part-sectors label spc reserved fat-sectors
      block-write-sector part-start buf
      fat32-format-fsinfo buf part-sectors spc
      block-write-sector (part-start + 1) buf
      fat32-write-empty-fat part-start reserved fat-sectors
      fat32-format-root buf label
      fat32-done (block-write-sector (part-start + reserved + 2 * fat-sectors) buf)
    end

  fat32-format-bpb : Integer, Integer, Integer, Text, Integer, Integer, Integer -> Integer
  fat32-format-bpb (buf) (part-start) (part-sectors) (label) (spc) (reserved) (fat-sectors) =
    let z = fat32-zero-buf buf 0
    in let w0 = poke-byte buf 0 235
    in let w1 = poke-byte buf 1 88
    in let w2 = poke-byte buf 2 144
    in let w3 = fat32-write-name83 buf 3 "CODEXOS " 0
    in let w4 = fat32-fmt-u16 buf 11 512
    in let w5 = poke-byte buf 13 spc
    in let w6 = fat32-fmt-u16 buf 14 reserved
    in let w7 = poke-byte buf 16 2
    in let w8 = poke-byte buf 21 248
    in let w9 = fat32-fmt-u16 buf 24 63
    in let w10 = fat32-fmt-u16 buf 26 255
    in let w11 = fat32-fmt-u32 buf 28 part-start
    in let w12 = fat32-fmt-u32 buf 32 part-sectors
    in let w13 = fat32-fmt-u32 buf 36 fat-sectors
    in let w14 = fat32-fmt-u32 buf 44 2
    in let w15 = fat32-fmt-u16 buf 48 1
    in let w16 = fat32-fmt-u16 buf 50 6
    in let w17 = poke-byte buf 66 41
    in let w18 = fat32-write-name83 buf 71 (fat32-pad-right label 11) 0
    in let w19 = fat32-write-name83 buf 82 "FAT32   " 0
    in let w20 = poke-byte buf 510 85
    in poke-byte buf 511 170

  fat32-format-fsinfo : Integer, Integer, Integer -> Integer
  fat32-format-fsinfo (buf) (part-sectors) (spc) =
    let z2 = fat32-zero-buf buf 0
    in let w23 = fat32-fmt-u32 buf 0 1098025042
    in let w24 = fat32-fmt-u32 buf 484 1633967730
    in let w25 = fat32-fmt-u32 buf 488 (part-sectors / spc - 10)
    in let w26 = fat32-fmt-u32 buf 492 3
    in let w27 = poke-byte buf 510 85
    in poke-byte buf 511 170

  fat32-format-root : Integer, Text -> Integer
  fat32-format-root (buf) (label) =
    let z3 = fat32-zero-buf buf 0
    in let w31 = fat32-write-name83 buf 0 (fat32-pad-right label 11) 0
    in poke-byte buf 11 8

  fat32-write-empty-fat : Integer, Integer, Integer -> [Device.Block] Integer
  fat32-write-empty-fat (part-start) (reserved) (fat-sectors) =
    let fat1-start = part-start + reserved
    in let buf = alloc-bytes 512
    in let z = fat32-zero-buf buf 0
    in let w0 = fat32-fmt-u32 buf 0 268435448
    in let w1 = fat32-fmt-u32 buf 4 268435455
    in let w2 = fat32-fmt-u32 buf 8 268435455
    in act
      block-write-sector fat1-start buf
      block-write-sector (fat1-start + fat-sectors) buf
      fat32-zero-buf buf 0
      fat32-zero-fat-sectors buf (fat1-start + 1) (fat-sectors - 1)
      fat32-zero-fat-sectors buf (fat1-start + fat-sectors + 1) (fat-sectors - 1)
    end

  fat32-zero-fat-sectors : Integer, Integer, Integer -> [Device.Block] Integer
  fat32-zero-fat-sectors (buf) (sector) (count) =
    if count <= 0 then 0
    else act
      block-write-sector sector buf
      fat32-zero-fat-sectors buf (sector + 1) (count - 1)
    end

  fat32-pick-spc : Integer -> Integer
  fat32-pick-spc (sectors) =
    if sectors < 16384 then 1
    else if sectors < 2097152 then 8
    else if sectors < 16777216 then 32
    else 64

Section: Format Helpers

  fat32-done : Integer -> Boolean
  fat32-done (w) = True

  fat32-fmt-u16 : Integer, Integer, Integer -> Integer
  fat32-fmt-u16 (buf) (off) (v) =
    let w0 = poke-byte buf off (bit-and v 255)
    in poke-byte buf (off + 1) (bit-and (bit-shru v 8) 255)

  fat32-fmt-u32 : Integer, Integer, Integer -> Integer
  fat32-fmt-u32 (buf) (off) (v) =
    let w0 = poke-byte buf off (bit-and v 255)
    in let w1 = poke-byte buf (off + 1) (bit-and (bit-shru v 8) 255)
    in let w2 = poke-byte buf (off + 2) (bit-and (bit-shru v 16) 255)
    in poke-byte buf (off + 3) (bit-and (bit-shru v 24) 255)

Page 1
