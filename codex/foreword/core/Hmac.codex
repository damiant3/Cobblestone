Chapter: Hmac
  cites Foreword chapter Sha256

 HMAC-SHA256 keyed-hash message authentication code per RFC 2104.
 Combines a secret key with SHA-256 to produce a 256-bit MAC that
 verifies both data integrity and authenticity. The key is normalized
 to 64 bytes (hashed if longer, zero-padded if shorter), then XORed
 with inner and outer padding before double-hashing.

 We say:

Section: HMAC-SHA256

  hmac-sha256 : List Integer, List Integer -> List Integer
  hmac-sha256 (key) (msg) =
    let k-prime = hmac-normalize-key key
    in let ipad-key = xor-bytes k-prime (repeat-byte 54 64) 0 64 []
    in let opad-key = xor-bytes k-prime (repeat-byte 92 64) 0 64 []
    in let inner-hash = sha256 (ipad-key & msg)
    in let inner-bytes = hash-words-to-bytes inner-hash
    in sha256 (opad-key & inner-bytes)

  hmac-normalize-key : List Integer -> List Integer
  hmac-normalize-key (key) =
    if list-length key > 64
      then pad-to-64 (hash-words-to-bytes (sha256 key))
    else pad-to-64 key

  pad-to-64 : List Integer -> List Integer
  pad-to-64 (bs) =
    if list-length bs >= 64 then bs
    else pad-to-64 (list-push bs 0)

  xor-bytes : List Integer, List Integer, Integer, Integer, List Integer -> List Integer
  xor-bytes (a) (b) (i) (len) (acc) =
    if i == len then acc
    else xor-bytes a b (i + 1) len (list-push acc (bit-xor (list-at a i) (list-at b i)))

  repeat-byte : Integer, Integer -> List Integer
  repeat-byte (val) (n) = repeat-byte-loop val n []

  repeat-byte-loop : Integer, Integer, List Integer -> List Integer
  repeat-byte-loop (val) (n) (acc) =
    if n <= 0 then acc
    else repeat-byte-loop val (n - 1) (list-push acc val)

  hmac-sha256-hex : List Integer, List Integer -> Text
  hmac-sha256-hex (key) (msg) = sha256-to-hex (hmac-sha256 key msg)

  hash-words-to-bytes : List Integer -> List Integer
  hash-words-to-bytes (ws) = hmac-hw2b ws 0 (list-length ws) []

  hmac-hw2b : List Integer, Integer, Integer, List Integer -> List Integer
  hmac-hw2b (ws) (i) (len) (acc) =
    if i == len then acc
    else let w = list-at ws i
    in hmac-hw2b ws (i + 1) len (acc & [bit-and (bit-shru w 24) 255, bit-and (bit-shru w 16) 255, bit-and (bit-shru w 8) 255, bit-and w 255])

