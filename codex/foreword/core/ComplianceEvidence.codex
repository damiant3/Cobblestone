Chapter: ComplianceEvidence

 Compliance evidence generator for EU CRA, ETSI EN 303 645,
 and NISTIR 8259. Produces a structured evidence report mapping
 regulatory requirements to the Codex mechanisms that satisfy them.

 Each requirement is classified:
   BY-CONSTRUCTION -- the language makes violation inexpressible
   MECHANISM -- a runtime mechanism enforces it
   DEPLOYMENT -- satisfied by provisioning/operations
   ORGANIZATIONAL -- process obligation on the manufacturer

Section: Evidence Classes

  EvidenceClass =
    | ByConstruction
    | Mechanism
    | Deployment
    | Organizational

  evidence-class-name : EvidenceClass -> Text
  evidence-class-name (c) =
   when c
    is ByConstruction -> "BY-CONSTRUCTION"
    is Mechanism -> "MECHANISM"
    is Deployment -> "DEPLOYMENT"
    is Organizational -> "ORGANIZATIONAL"

Section: Requirement Model

  Requirement = record {
   regulation : Text,
   section : Text,
   title : Text,
   class : EvidenceClass,
   mechanism : Text,
   artifact : Text
  }

  format-requirement : Requirement -> Text
  format-requirement (r) =
   "[" & evidence-class-name (r.class) & "] " & r.regulation & " " & r.section & ": " & r.title & " -- " & r.mechanism

Section: EU CRA Annex I Requirements

  cra-requirements : List Requirement
  cra-requirements = [
   Requirement { regulation = "CRA", section = "Annex-I-1(a)", title = "No known exploitable vulnerabilities at release", class = ByConstruction, mechanism = "Linear types eliminate use-after-free/double-free (CDX2061/2063); a bounded field refuses an out-of-range literal (CDX2050) and an unproven range (CDX2051), both errors that halt codegen, with __narrow the explicit opt-out that traps at runtime instead; an undeclared effect is CDX2031, also an error", artifact = "compile-log" },
   Requirement { regulation = "CRA", section = "Annex-I-1(b)", title = "Secure default configuration", class = Deployment, mechanism = "Capability manifest declares minimum privileges; template checklist for manufacturer", artifact = "capability-manifest" },
   Requirement { regulation = "CRA", section = "Annex-I-1(c)", title = "Security updates mechanism", class = Mechanism, mechanism = "OTA via LwM2M Object 5 with streaming Gate A + full Gate B verification; anti-rollback via signed release-fact sequence", artifact = "ota-design" },
   Requirement { regulation = "CRA", section = "Annex-I-1(d)", title = "Minimize attack surface", class = ByConstruction, mechanism = "No OS kernel, no libc, no POSIX -- bare-metal compilation produces only compiler-emitted code; every byte auditable", artifact = "cdx-binary" },
   Requirement { regulation = "CRA", section = "Annex-I-1(e)", title = "Protect confidentiality of data", class = Mechanism, mechanism = "AES-256-GCM (SP 800-38D) and ChaCha20-Poly1305 (RFC 8439) AEADs, known-answer tested against the published vectors; X25519 key exchange; the [Network] effect confines every I/O path. TLS 1.3 ships and interoperates: our server negotiated TLS_AES_128_GCM_SHA256 with OpenSSL 3.0.13, which walked the chain to the anchor and refused an unrelated CA. DTLS is loopback-tested only", artifact = "crypto-suite" },
   Requirement { regulation = "CRA", section = "Annex-I-1(f)", title = "Protect integrity of data", class = Mechanism, mechanism = "Every CDX carries a SHA-256 content hash in its header, which is by construction of the format; the Ed25519 signature is NOT universal -- build.ps1 signs the compiler under test and only when the signing key is present, and compile.ps1 never signs, so an ordinarily compiled CDX is unsigned. The verifier checks hash and signature at load", artifact = "cdx-header" },
   Requirement { regulation = "CRA", section = "Annex-I-2(a)", title = "Unique device identification", class = Mechanism, mechanism = "Trust lattice identity: Ed25519 keypair per device, capability leases scoped to device identity", artifact = "trust-lattice" },
   Requirement { regulation = "CRA", section = "Annex-I-2(b)", title = "Vulnerability reporting within 24 hours", class = Organizational, mechanism = "Manufacturer process obligation -- outside toolchain scope", artifact = "none" }
  ]

Section: ETSI EN 303 645 Requirements

  etsi-requirements : List Requirement
  etsi-requirements = [
   Requirement { regulation = "ETSI", section = "5.1-1", title = "No universal default passwords", class = Mechanism, mechanism = "Capability lease model: each device generates unique Ed25519 identity at first boot; no shared secrets", artifact = "trust-lattice" },
   Requirement { regulation = "ETSI", section = "5.1-2", title = "Implement means to manage credentials", class = Mechanism, mechanism = "Trust lattice key rotation; lease revocation; capability scope narrowing", artifact = "trust-lattice" },
   Requirement { regulation = "ETSI", section = "5.3-1", title = "Use encryption for sensitive communication", class = Mechanism, mechanism = "The toolchain supplies the AEADs (AES-256-GCM, ChaCha20-Poly1305), X25519, and a TLS 1.3 transport that is interop-proven against OpenSSL 3.0.13 with the chain walked and an unrelated CA refused; the [Network] effect confines I/O. Restored to MECHANISM: the 2026-07-27 downgrade to DEPLOYMENT reasoned that we do not ship the transport, and we do. DTLS is loopback-tested only", artifact = "crypto-suite" },
   Requirement { regulation = "ETSI", section = "5.4-1", title = "Security updates shall not degrade device security", class = Mechanism, mechanism = "OTA Gate B: capability superset check -- new firmware cannot request capabilities not in trust policy", artifact = "ota-design" },
   Requirement { regulation = "ETSI", section = "5.5-1", title = "Securely communicate", class = Mechanism, mechanism = "TLS 1.3 supplies the secure channel and is interop-proven against OpenSSL 3.0.13, chain walked and an unrelated CA refused; the [Network] effect confines which functions may reach the wire at all, so a library without it cannot exfiltrate. Not ByConstruction: the effect row governs whether I/O happens, not whether it is encrypted", artifact = "crypto-suite" },
   Requirement { regulation = "ETSI", section = "5.6-1", title = "Minimize exposed attack surface", class = ByConstruction, mechanism = "Bare-metal compilation: no OS, no dynamic linking, no shell, no debug ports in production CDX", artifact = "cdx-binary" },
   Requirement { regulation = "ETSI", section = "5.1-3", title = "Authentication mechanisms use unique per-device credentials", class = Mechanism, mechanism = "Trust lattice: per-device Ed25519 keypair generated at first boot", artifact = "trust-lattice" },
   Requirement { regulation = "ETSI", section = "5.1-4", title = "User authentication uses best practice", class = Mechanism, mechanism = "Capability lease authentication; no plaintext passwords in capability grants", artifact = "trust-lattice" },
   Requirement { regulation = "ETSI", section = "5.2-1", title = "Vulnerability disclosure policy", class = Organizational, mechanism = "Manufacturer process obligation: publish coordinated disclosure policy", artifact = "none" },
   Requirement { regulation = "ETSI", section = "5.3-2", title = "Sufficiently reviewed cryptographic implementation", class = Mechanism, mechanism = "Codex crypto forewords (AES, AES-GCM, ChaCha20, Poly1305, Ed25519, SHA-256, SHA-512, HKDF) implement published standards and are gated on the standards own known-answer vectors -- thirteen crypto tests, every one carrying an .expected. Known-answer vectors prove conformance to the vectors, NOT review: independent cryptographic review is a manufacturer obligation and is not something the language can make inexpressible", artifact = "crypto-suite" },
   Requirement { regulation = "ETSI", section = "5.3-3", title = "Cryptographic key uniqueness", class = Mechanism, mechanism = "Ed25519 key generation per device; no shared secrets across devices", artifact = "trust-lattice" },
   Requirement { regulation = "ETSI", section = "5.3-4", title = "Best practice cryptography", class = Mechanism, mechanism = "AES-256-GCM, ChaCha20-Poly1305, X25519, Ed25519, SHA-512 -- all NIST/IETF approved, and each one gated on the published test vectors rather than on agreeing with itself", artifact = "crypto-suite" },
   Requirement { regulation = "ETSI", section = "5.3-5", title = "No hard-coded credentials", class = Organizational, mechanism = "Manufacturer obligation: nothing in the compiler rejects a hard-coded credential. Measured 2026-07-28 -- a chapter defining an AWS-shaped api-key, a password admin and an eight-byte signing key compiles with zero diagnostics and prints all three at runtime. Effect types govern what a function may DO, not what a constant may CONTAIN. A secret scanner over source would be the instrument and none exists", artifact = "none" },
   Requirement { regulation = "ETSI", section = "5.3-6", title = "Sensitive data encrypted in transit", class = Deployment, mechanism = "TLS 1.3 ships and is interop-proven against OpenSSL 3.0.13, and the AEADs are available to encrypt a payload directly; the [Network] effect makes every send visible in the type. Deployment rather than by-construction because nothing in the toolchain forces a given payload through either", artifact = "crypto-suite" },
   Requirement { regulation = "ETSI", section = "5.3-7", title = "Sensitive data encrypted at rest", class = Deployment, mechanism = "Manufacturer must enable AES encryption for persistent storage; toolchain provides AES foreword", artifact = "crypto-suite" },
   Requirement { regulation = "ETSI", section = "5.3-8", title = "Secure key management", class = Mechanism, mechanism = "The private seed is wrapped with AES-256-CBC under an HKDF key derived from the passphrase, and the trust lattice manages the lifecycle. The salt and IV are SHA-256 over the hardware-random device seed, the timestamp and a domain-separation tag, so they differ from each other and across ceremonies; pinned by codex/test/idm-salt-iv-distinct, whose two assertions both flip when the derivation is reverted. Until 2026-07-28 both were the same fixed sixteen bytes", artifact = "trust-lattice" },
   Requirement { regulation = "ETSI", section = "5.4-2", title = "Verify authenticity of updates", class = Mechanism, mechanism = "OTA Gate A: Ed25519 signature verification before any flash write", artifact = "ota-design" },
   Requirement { regulation = "ETSI", section = "5.4-3", title = "Update mechanism timely", class = Deployment, mechanism = "LwM2M Object 5 resources and registration ship, so a deployer can drive an update; the MQTT/CoAP push notification this row used to claim does NOT exist -- there is no Observe or Notify anywhere in the LwM2M chapters, so nothing tells a device an update is waiting. Timeliness is the deployer's polling policy", artifact = "ota-design" },
   Requirement { regulation = "ETSI", section = "5.4-4", title = "Automatic update mechanism", class = Deployment, mechanism = "Registration and the Object 5 resources ship and the boot side is automatic -- OtaBoot activates and can roll back with no user action. Server-INITIATED push does not ship: LwM2M Observe/Notify is unimplemented, so the device cannot be told to fetch. A deployer must poll", artifact = "ota-design" },
   Requirement { regulation = "ETSI", section = "5.5-2", title = "Minimize unnecessary network exposure", class = ByConstruction, mechanism = "Effect types: only functions with [Network] can access network; no implicit background connections", artifact = "effect-types" },
   Requirement { regulation = "ETSI", section = "5.5-3", title = "Data collected is necessary", class = Organizational, mechanism = "Manufacturer process obligation: data minimization review", artifact = "none" },
   Requirement { regulation = "ETSI", section = "5.5-4", title = "No unnecessary pre-installed software", class = ByConstruction, mechanism = "Bare-metal compilation: binary contains only compiler-emitted code; no OS, no shell, no debug agents", artifact = "cdx-binary" },
   Requirement { regulation = "ETSI", section = "5.5-5", title = "Device hardware not unnecessarily accessible", class = Deployment, mechanism = "Capability manifest restricts peripheral access; manufacturer disables debug interfaces", artifact = "capability-manifest" },
   Requirement { regulation = "ETSI", section = "5.5-6", title = "Device operates on minimal necessary network services", class = ByConstruction, mechanism = "Effect types restrict network access to declared effects; unused protocols produce zero code", artifact = "effect-types" },
   Requirement { regulation = "ETSI", section = "5.5-7", title = "Code minimized to necessary functionality", class = ByConstruction, mechanism = "Dead code elimination at compile time; proof erasure removes compile-time-only definitions (CDX4020)", artifact = "cdx-binary" },
   Requirement { regulation = "ETSI", section = "5.6-2", title = "No unnecessary open ports", class = ByConstruction, mechanism = "Network stack requires explicit [Network] effect; no default listeners; every port binding is a declared effect", artifact = "effect-types" },
   Requirement { regulation = "ETSI", section = "5.6-3", title = "Disable debug interfaces in production", class = Organizational, mechanism = "Manufacturer obligation with no toolchain support today: there is NO production build flag. No build script carries one, so nothing excludes a debug shell or serial diagnostic from a CDX. What the toolchain does give is that a debug facility must be cited and its effects declared, so its presence is visible in the source rather than implicit", artifact = "none" },
   Requirement { regulation = "ETSI", section = "5.6-4", title = "Secure boot process", class = Mechanism, mechanism = "Signed CDX binary verified at boot via Ed25519; boot loader checks hash before execution", artifact = "cdx-header" },
   Requirement { regulation = "ETSI", section = "5.7-1", title = "Verify software integrity at boot", class = Mechanism, mechanism = "CDX header SHA-256 hash verified at load time; tampered binary detected before execution", artifact = "cdx-header" },
   Requirement { regulation = "ETSI", section = "5.7-2", title = "Alert user on failed integrity check", class = Mechanism, mechanism = "Verification failure reported via fact store event; manufacturer configures alert channel", artifact = "fact-store" },
   Requirement { regulation = "ETSI", section = "5.8-1", title = "Personal data protection", class = Mechanism, mechanism = "AEADs protect personal data at rest and TLS 1.3 in transit; the effect row makes every path that could touch it visible in the signature. Not ByConstruction: linear types stop a resource being consumed twice, which is a use-after-move property, and a linear value may still be printed or sent exactly once with no diagnostic", artifact = "crypto-suite" },
   Requirement { regulation = "ETSI", section = "5.8-2", title = "Clear user data on request", class = Deployment, mechanism = "Manufacturer implements data erasure command via capability-scoped operation", artifact = "capability-manifest" },
   Requirement { regulation = "ETSI", section = "5.8-3", title = "User consent for data collection", class = Organizational, mechanism = "Manufacturer process obligation: consent UI/flow", artifact = "none" },
   Requirement { regulation = "ETSI", section = "5.9-1", title = "Resilience to outages", class = Mechanism, mechanism = "punctual watchdog: bounded execution guarantees system responsiveness; automatic restart on deadline miss", artifact = "punctual-report" },
   Requirement { regulation = "ETSI", section = "5.9-2", title = "Resilience to data loss", class = Mechanism, mechanism = "The fact store is append-only, and structurally so: DiskFacts exposes no delete, truncate, erase or compact operation, so a written fact cannot be removed. CRC framing does NOT exist -- there is no crc or checksum anywhere in the fact-store chapters; that idea is an unshipped proposal in Annotations Addendum I and belongs to the annotation store, not this one", artifact = "fact-store" },
   Requirement { regulation = "ETSI", section = "5.9-3", title = "System recoverable from failure", class = Mechanism, mechanism = "OTA dual-slot A/B partitioning with verified fallback; boot config selects last-known-good", artifact = "ota-design" },
   Requirement { regulation = "ETSI", section = "5.10-1", title = "Telemetry data examined", class = Organizational, mechanism = "Manufacturer process obligation: review collected telemetry", artifact = "none" },
   Requirement { regulation = "ETSI", section = "5.11-1", title = "User can delete personal data", class = Deployment, mechanism = "Manufacturer implements user-facing data deletion; fact store supports tombstone entries", artifact = "fact-store" },
   Requirement { regulation = "ETSI", section = "5.12-1", title = "Simple installation and maintenance", class = Deployment, mechanism = "OTA automatic update; LwM2M bootstrap for zero-touch provisioning", artifact = "ota-design" },
   Requirement { regulation = "ETSI", section = "5.13-1", title = "Validate input data", class = ByConstruction, mechanism = "Bounded integers validate range at construction (CDX2050/2051); effect types prevent unvalidated I/O reaching core logic", artifact = "compile-log" }
  ]

Section: NISTIR 8259 Requirements

  nist-requirements : List Requirement
  nist-requirements = [
   Requirement { regulation = "NIST", section = "8259A-1", title = "Device identification", class = Mechanism, mechanism = "Ed25519 keypair generated at provisioning and stored encrypted (IdentityManager), which is the logical identifier. PARTIAL: no physical identifier is populated -- LwM2M Object 3 supplies the resource ids only, and nothing writes a serial into resource 2", artifact = "trust-lattice" },
   Requirement { regulation = "NIST", section = "8259A-2", title = "Device configuration", class = Mechanism, mechanism = "Capability manifest: explicit declaration of all I/O, peripherals, network access; the verifier's capability and effect phases decode and enforce it at load, not only at compile time", artifact = "capability-manifest" },
   Requirement { regulation = "NIST", section = "8259A-3", title = "Data protection", class = Mechanism, mechanism = "AES-256-GCM (SP 800-38D) and ChaCha20-Poly1305 (RFC 8439) AEADs protect data at rest, known-answer tested; TLS 1.3 protects it in transit, measured against OpenSSL 3.0.13 with the chain walked and an unrelated CA refused. DTLS is loopback-tested only, with no foreign peer", artifact = "crypto-suite" },
   Requirement { regulation = "NIST", section = "8259A-4", title = "Logical access to interfaces", class = ByConstruction, mechanism = "Effect types: an interface touched without the effect declared in the signature is a compile error, so unauthorized local or network access is not expressible rather than merely refused at runtime", artifact = "effect-types" },
   Requirement { regulation = "NIST", section = "8259A-5", title = "Software update", class = Mechanism, mechanism = "LwM2M Object 5 OTA; OtaBoot re-checks at boot that the bank holds what Gate B blessed, bounds retries at boot-attempt-limit, and writes the record flag last in its own cycle so a power loss boots the firmware already trusted", artifact = "ota-design" },
   Requirement { regulation = "NIST", section = "8259A-6", title = "Cybersecurity state awareness", class = Mechanism, mechanism = "CapabilityAudit, Forensics and NotificationLog record capability decisions, trust decisions and notifications as content-addressed facts. PARTIAL: these are separate surfaces, and nothing enforces that a state change cannot occur without a fact being written", artifact = "fact-store" }
  ]

Section: IEC 62443 Requirements

  iec-requirements : List Requirement
  iec-requirements = [
   Requirement { regulation = "IEC62443", section = "FR1", title = "Identification and Authentication", class = Mechanism, mechanism = "Trust lattice: Ed25519 keypair per device; capability leases scoped to authenticated identity; no default credentials", artifact = "trust-lattice" },
   Requirement { regulation = "IEC62443", section = "FR2", title = "Use Control", class = ByConstruction, mechanism = "Capability manifests declare permitted operations and an ungranted capability is CDX4001; separately, an undeclared effect is CDX2031, an error that halts codegen, so undeclared I/O is refused at compile time rather than at runtime", artifact = "capability-manifest" },
   Requirement { regulation = "IEC62443", section = "FR3", title = "System Integrity", class = Mechanism, mechanism = "Every CDX carries a SHA-256 content hash in its header by construction; the Ed25519 signature is applied by the build pipeline to the compiler under test, not to every CDX, and compile.ps1 never signs. The fact store records the state changes written to it; nothing enforces that a state change cannot occur without a fact", artifact = "cdx-header" },
   Requirement { regulation = "IEC62443", section = "FR4", title = "Data Confidentiality", class = Mechanism, mechanism = "AES-256-GCM and ChaCha20-Poly1305 AEADs, known-answer tested; linear types prevent key material reuse. TLS 1.3 supplies confidentiality on the wire and is interop-proven against OpenSSL 3.0.13; DTLS is loopback-tested only, so a datagram deployment still rests on the AEADs", artifact = "crypto-suite" },
   Requirement { regulation = "IEC62443", section = "FR5", title = "Restricted Data Flow", class = ByConstruction, mechanism = "Effect types: a function without [Network] cannot perform I/O; capability scope restricts data flow to declared paths", artifact = "effect-types" },
   Requirement { regulation = "IEC62443", section = "FR6", title = "Timely Response to Events", class = Mechanism, mechanism = "punctual counts instructions at compile time and reports the worst case (CDX6010) against a declared budget. Not ByConstruction: CDX6011 is a WARNING, measured 2026-07-28 -- a punctual function at 40 instructions against a budget of 5 emits a binary and runs. The bound is proven and reported, not enforced", artifact = "punctual-report" },
   Requirement { regulation = "IEC62443", section = "FR7", title = "Resource Availability", class = ByConstruction, mechanism = "No GC, no dynamic allocation in punctual paths (CDX6002); bounded integers prevent overflow; stack-heap collision check in every prologue", artifact = "punctual-report" }
  ]

Section: Evidence Report Generator

  count-by-class : List Requirement, EvidenceClass, Integer, Integer -> Integer
  count-by-class (reqs) (target) (i) (acc) =
   if i >= list-length reqs then acc
   else let r = list-at reqs i
   in let matched = when r.class
    is ByConstruction -> when target is ByConstruction -> 1 is otherwise -> 0
    is Mechanism -> when target is Mechanism -> 1 is otherwise -> 0
    is Deployment -> when target is Deployment -> 1 is otherwise -> 0
    is Organizational -> when target is Organizational -> 1 is otherwise -> 0
   in count-by-class reqs target (i + 1) (acc + matched)

  format-summary : Text, List Requirement -> Text
  format-summary (regulation) (reqs) =
   let total = list-length reqs
   in let by-const = count-by-class reqs ByConstruction 0 0
   in let mech = count-by-class reqs Mechanism 0 0
   in let deploy = count-by-class reqs Deployment 0 0
   in let org = count-by-class reqs Organizational 0 0
   in regulation & ": " & show total & " requirements -- " & show by-const & " by-construction, " & show mech & " mechanism, " & show deploy & " deployment, " & show org & " organizational"

  format-all-requirements : List Requirement, Integer -> Text
  format-all-requirements (reqs) (i) =
   if i >= list-length reqs then ""
   else format-requirement (list-at reqs i) & "\n" & format-all-requirements reqs (i + 1)

  generate-evidence-report : Text
  generate-evidence-report =
   "=== CODEX COMPLIANCE EVIDENCE REPORT ===\n" &
   format-summary "CRA" cra-requirements & "\n" &
   format-summary "ETSI" etsi-requirements & "\n" &
   format-summary "NIST" nist-requirements & "\n" &
   format-summary "IEC62443" iec-requirements & "\n" &
   "\n--- CRA Annex I ---\n" &
   format-all-requirements cra-requirements 0 &
   "\n--- ETSI EN 303 645 ---\n" &
   format-all-requirements etsi-requirements 0 &
   "\n--- NISTIR 8259A ---\n" &
   format-all-requirements nist-requirements 0 &
   "\n--- IEC 62443 ---\n" &
   format-all-requirements iec-requirements 0

