Chapter: FactStore
  cites Foreword chapter Hamt
  cites Foreword chapter Maybe
  cites Foreword chapter Sha256

 We say:

Section: Fact Types

  FactKind =
    | DefinitionFact
    | ProofFact
    | VouchFact
    | PolicyFact
    | CapabilityFact

  Fact = record {
    hash : Text,
    kind : FactKind,
    content : Text,
    author : Text,
    timestamp : Integer
  }

  BareFactStore = record {
    facts : HamtMap Fact,
    count : Integer between 0 and 4294967295
  }

Section: Store Operations

  fact-store-empty : BareFactStore = BareFactStore { facts = hamt-empty, count = 0 }

  fact-content-hash : Text -> Text
  fact-content-hash (content) = sha256-to-hex (sha256 (text-to-bytes content))

  fact-create : FactKind, Text, Text, Integer -> Fact
  fact-create (kind) (content) (author) (timestamp) =
    let hash = fact-content-hash content
    in Fact { hash = hash, kind = kind, content = content, author = author, timestamp = timestamp }

  fact-store : BareFactStore, Fact -> BareFactStore
  fact-store (store) (f) =
    if hamt-contains (store.facts) (f.hash) then store
    else BareFactStore { facts = hamt-set (store.facts) (f.hash) f, count = store.count + 1 }

  fact-load : BareFactStore, Text -> Maybe Fact
  fact-load (store) (hash) = hamt-get (store.facts) hash

  fact-has : BareFactStore, Text -> Boolean
  fact-has (store) (hash) = hamt-contains (store.facts) hash

  fact-count : BareFactStore -> Integer
  fact-count (store) = store.count

Section: Replay Deduplication

  fact-is-replay : BareFactStore, Text -> Boolean
  fact-is-replay (store) (hash) = hamt-contains (store.facts) hash

  fact-store-if-new : BareFactStore, Fact -> StoreResult
  fact-store-if-new (store) (f) =
    if hamt-contains (store.facts) (f.hash)
      then StoreResult { store = store, was-new = False }
    else StoreResult { store = fact-store store f, was-new = True }

  StoreResult = record {
    store : BareFactStore,
    was-new : Boolean
  }

Section: Fact Kind Helpers

  fact-kind-name : FactKind -> Text
  fact-kind-name (k) = when k
    is DefinitionFact -> "Definition"
    is ProofFact -> "Proof"
    is VouchFact -> "Vouch"
    is PolicyFact -> "Policy"
    is CapabilityFact -> "Capability"

