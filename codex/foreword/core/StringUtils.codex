Chapter: StringUtils
  cites Foreword chapter CCE

 We say:

Section: Predicates
  text-starts-with : Text, Text -> Boolean
  text-starts-with (s) (prefix) =
    let plen = text-length prefix
    in if plen > text-length s then False
    else str-prefix-match s prefix 0 plen

  str-prefix-match : Text, Text, Integer, Integer -> Boolean
  str-prefix-match (s) (prefix) (i) (len) =
    if i >= len then True
    else if char-at s i /= char-at prefix i then False
    else str-prefix-match s prefix (i + 1) len

  text-ends-with : Text, Text -> Boolean
  text-ends-with (s) (suffix) =
    let slen = text-length s
    in let plen = text-length suffix
    in if plen > slen then False
    else str-prefix-match-at s suffix (slen - plen) 0 plen

  str-prefix-match-at : Text, Text, Integer, Integer, Integer -> Boolean
  str-prefix-match-at (s) (prefix) (offset) (i) (len) =
    if i >= len then True
    else if char-at s (offset + i) /= char-at prefix i then False
    else str-prefix-match-at s prefix offset (i + 1) len

  text-contains : Text, Text -> Boolean
  text-contains (s) (sub) = text-index-of s sub >= 0

Section: Search
  text-index-of : Text, Text -> Integer
  text-index-of (s) (sub) =
    let slen = text-length s
    in let sublen = text-length sub
    in if sublen > slen then 0 - 1
    else str-index-loop s sub 0 (slen - sublen + 1) sublen

  str-index-loop : Text, Text, Integer, Integer, Integer -> Integer
  str-index-loop (s) (sub) (i) (limit) (sublen) =
    if i >= limit then 0 - 1
    else if str-prefix-match-at s sub i 0 sublen then i
    else str-index-loop s sub (i + 1) limit sublen

  text-count : Text, Text -> Integer
  text-count (s) (sub) = str-count-loop s sub 0 (text-length s) (text-length sub) 0

  str-count-loop : Text, Text, Integer, Integer, Integer, Integer -> Integer
  str-count-loop (s) (sub) (i) (slen) (sublen) (acc) =
    if i > slen - sublen then acc
    else if str-prefix-match-at s sub i 0 sublen then str-count-loop s sub (i + sublen) slen sublen (acc + 1)
    else str-count-loop s sub (i + 1) slen sublen acc

Section: Transform
  text-replace : Text, Text, Text -> Text
  text-replace (s) (old) (new) =
    if text-length old == 0 then s
    else str-replace-loop s old new 0 (text-length s) (text-length old) ""

  str-replace-loop : Text, Text, Text, Integer, Integer, Integer, Text -> Text
  str-replace-loop (s) (old) (new) (i) (slen) (oldlen) (acc) =
    if i >= slen then acc
    else if i <= slen - oldlen then
      if str-prefix-match-at s old i 0 oldlen then str-replace-loop s old new (i + oldlen) slen oldlen (acc & new)
      else str-replace-loop s old new (i + 1) slen oldlen (acc & char-to-text (char-at s i))
    else str-replace-loop s old new (i + 1) slen oldlen (acc & char-to-text (char-at s i))

  text-reverse : Text -> Text
  text-reverse (s) = str-rev-loop s (text-length s - 1) ""

  str-rev-loop : Text, Integer, Text -> Text
  str-rev-loop (s) (i) (acc) =
    if i < 0 then acc
    else str-rev-loop s (i - 1) (acc & char-to-text (char-at s i))

 The case pair delegates to CCE rather than deriving the rule again,
 and that is the whole point of it. TextSearch defined this pair too,
 and its versions were written as ASCII: `to-upper` tested
 `cd >= 97 & cd <= 122` and subtracted 32. CCE is not ASCII --
 lowercase is 13..38, uppercase is 39..64, and the offset is 26 -- so
 the test never matched a letter and both functions returned every
 letter unchanged. What 97..122 actually holds is the accented and
 Cyrillic band, which the subtraction mapped into punctuation, so the
 one input they did affect they corrupted.

  text-to-upper : Text -> Text
  text-to-upper (s) = str-case-loop s to-upper 0 (text-length s) ""

  text-to-lower : Text -> Text
  text-to-lower (s) = str-case-loop s to-lower 0 (text-length s) ""

  str-case-loop : Text, (Char -> Char), Integer, Integer, Text -> Text
  str-case-loop (s) (f) (i) (len) (acc) =
    if i >= len then acc
    else str-case-loop s f (i + 1) len (acc & char-to-text (f (char-at s i)))

Section: Padding

  text-pad-left : Text, Integer, Text -> Text
  text-pad-left (s) (width) (fill) =
    if text-length s >= width then s
    else text-pad-left (fill & s) width fill

  text-pad-right : Text, Integer, Text -> Text
  text-pad-right (s) (width) (fill) =
    if text-length s >= width then s
    else text-pad-right (s & fill) width fill

Section: Substring
  text-substring : Text, Integer, Integer -> Text
  text-substring (s) (start) (len) = substring s start len

  text-take : Text, Integer -> Text
  text-take (s) (n) = substring s 0 n

  text-drop : Text, Integer -> Text
  text-drop (s) (n) = substring s n (text-length s - n)

Section: Join
  text-join : Text, List Text -> Text
  text-join (sep) (parts) = str-join-loop sep parts 0 (list-length parts) ""

  str-join-loop : Text, List Text, Integer, Integer, Text -> Text
  str-join-loop (sep) (parts) (i) (n) (acc) =
    if i >= n then acc
    else let prefix = if i == 0 then "" else sep
    in str-join-loop sep parts (i + 1) n (acc & prefix & list-at parts i)

