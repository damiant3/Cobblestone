 We say:

Section: Token Bucket
  TokenBucket = record {
    tb-tokens : Integer,
    tb-capacity : Integer,
    tb-refill-rate : Integer,
    tb-last-refill : Timestamp
  }

  tb-new : Integer, Integer -> TokenBucket
  tb-new (capacity) (refill-per-second) = TokenBucket { tb-tokens = capacity, tb-capacity = capacity, tb-refill-rate = refill-per-second, tb-last-refill = 0 }

  tb-try-consume : TokenBucket, Integer, Timestamp -> TokenBucket
  tb-try-consume (bucket) (count) (now) =
    let refilled = tb-refill bucket now
    in if refilled.tb-tokens >= count then TokenBucket { tb-tokens = refilled.tb-tokens - count, tb-capacity = refilled.tb-capacity, tb-refill-rate = refilled.tb-refill-rate, tb-last-refill = refilled.tb-last-refill }
    else refilled

  tb-can-consume : TokenBucket, Integer, Timestamp -> Boolean
  tb-can-consume (bucket) (count) (now) =
    let refilled = tb-refill bucket now
    in refilled.tb-tokens >= count

  tb-refill : TokenBucket, Timestamp -> TokenBucket
  tb-refill (bucket) (now) =
    let elapsed = now - bucket.tb-last-refill
    in let new-tokens = elapsed * bucket.tb-refill-rate / 1000
    in let total = bucket.tb-tokens + new-tokens
    in let capped = if total > bucket.tb-capacity then bucket.tb-capacity else total
    in TokenBucket { tb-tokens = capped, tb-capacity = bucket.tb-capacity, tb-refill-rate = bucket.tb-refill-rate, tb-last-refill = now }

  tb-available : TokenBucket, Timestamp -> Integer
  tb-available (bucket) (now) = (tb-refill bucket now).tb-tokens

Section: Sliding Window
  SlidingWindow = record {
    sw-counts : List Integer,
    sw-slots : Integer,
    sw-window-ms : Timestamp,
    sw-limit : Integer,
    sw-current-slot : Integer
  }

  sw-new : Timestamp, Integer, Integer -> SlidingWindow
  sw-new (window-ms) (slots) (limit) = SlidingWindow { sw-counts = list-zeros slots, sw-slots = slots, sw-window-ms = window-ms, sw-limit = limit, sw-current-slot = 0 }

  sw-record : SlidingWindow, Timestamp -> SlidingWindow
  sw-record (w) (now) =
    let slot = sw-slot-for w now
    in let advanced = sw-advance w slot
    in let cur = list-at (advanced.sw-counts) (advanced.sw-current-slot)
    in SlidingWindow { sw-counts = list-set-at (advanced.sw-counts) (advanced.sw-current-slot) (cur + 1), sw-slots = w.sw-slots, sw-window-ms = w.sw-window-ms, sw-limit = w.sw-limit, sw-current-slot = advanced.sw-current-slot }

  sw-is-limited : SlidingWindow -> Boolean
  sw-is-limited (w) = sw-total w >= w.sw-limit

  sw-total : SlidingWindow -> Integer
  sw-total (w) = sw-sum-loop (w.sw-counts) 0 (w.sw-slots) 0

  sw-sum-loop : List Integer, Integer, Integer, Integer -> Integer
  sw-sum-loop (counts) (i) (n) (acc) =
    if i >= n then acc
    else sw-sum-loop counts (i + 1) n (acc + list-at counts i)

  sw-slot-for : SlidingWindow, Integer -> Integer
  sw-slot-for (w) (now) =
    let slot-width = w.sw-window-ms / w.sw-slots
    in if slot-width <= 0 then 0
    else (now / slot-width) - (now / slot-width) / w.sw-slots * w.sw-slots

  sw-advance : SlidingWindow, Integer -> SlidingWindow
  sw-advance (w) (new-slot) =
    if new-slot == w.sw-current-slot then w
    else SlidingWindow { sw-counts = list-set-at (w.sw-counts) new-slot 0, sw-slots = w.sw-slots, sw-window-ms = w.sw-window-ms, sw-limit = w.sw-limit, sw-current-slot = new-slot }

Section: Formatting
  format-tb : TokenBucket -> Text
  format-tb (b) = "tokens=" & show (b.tb-tokens) & "/" & show (b.tb-capacity) & " rate=" & show (b.tb-refill-rate) & "/s"

  format-sw : SlidingWindow -> Text
  format-sw (w) = "requests=" & show (sw-total w) & "/" & show (w.sw-limit) & " limited=" & show (sw-is-limited w)

