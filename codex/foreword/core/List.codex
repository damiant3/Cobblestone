Chapter: List

 A ConsList is one of:
   Cons -- carries a head element and a tail ConsList.
   Nil -- the empty list.

 To cl-nil gives ConsList a, the empty list constant.
 To cl-cons gives ConsList a, prepending an element before a tail list.
 To cl-is-empty gives Boolean, True when the list is Nil.
 To cl-head gives a, the first element of the list; diverges on Nil.
 To cl-tail gives ConsList a, all elements after the first; Nil on Nil.
 To cl-length gives Integer, the number of elements in the list.
 To cl-map gives ConsList b, applying a function to each element.
 To cl-filter gives ConsList a, keeping elements where the predicate returns True.
 To cl-foldl gives b, left fold over the list with an accumulator and combining function.
 To cl-foldr gives b, right fold over the list with an accumulator and combining function.
 To cl-reverse gives ConsList a, reversing element order.
 To cl-append gives ConsList a, concatenating two lists.
 To cl-any gives Boolean, True when the predicate holds for at least one element.
 To cl-all gives Boolean, True when the predicate holds for every element.
 To cl-take gives ConsList a, the first n elements.
 To cl-drop gives ConsList a, the list without the first n elements.
 To cl-zip-with gives ConsList c, pairwise combination of two lists truncated to the shorter one.
 To cl-sum gives Integer, the sum of all elements in a list of integers.

 We say:

Section: Definitions

  ConsList (a) =
    | Cons (a) (ConsList a)
    | Nil

  cl-nil : ConsList a = Nil

  cl-cons : a, ConsList a -> ConsList a
  cl-cons (x) (xs) = Cons x xs

  cl-is-empty : ConsList a -> Boolean
  cl-is-empty (xs) = when xs
    is Cons (h) (t) -> False
    is Nil -> True

  cl-head : ConsList a -> a
  cl-head (xs) = when xs
    is Cons (h) (t) -> h
    is Nil -> cl-head xs

  cl-tail : ConsList a -> ConsList a
  cl-tail (xs) = when xs
    is Cons (h) (t) -> t
    is Nil -> Nil

  cl-length : ConsList a -> Integer
  cl-length (xs) = cl-length-acc xs 0

  cl-length-acc : ConsList a, Integer -> Integer
  cl-length-acc (xs) (acc) = when xs
    is Cons (h) (t) -> cl-length-acc t (acc + 1)
    is Nil -> acc

  cl-map : (a -> b), ConsList a -> ConsList b
  cl-map (f) (xs) = when xs
    is Cons (h) (t) -> Cons (f h) (cl-map f t)
    is Nil -> Nil

  cl-filter : (a -> Boolean), ConsList a -> ConsList a
  cl-filter (pred) (xs) = when xs
    is Cons (h) (t) -> if pred h then Cons h (cl-filter pred t) else cl-filter pred t
    is Nil -> Nil

  cl-foldl : (b, a -> b), b, ConsList a -> b
  cl-foldl (f) (acc) (xs) = when xs
    is Cons (h) (t) -> cl-foldl f (f acc h) t
    is Nil -> acc

  cl-foldr : (a, b -> b), b, ConsList a -> b
  cl-foldr (f) (acc) (xs) = when xs
    is Cons (h) (t) -> f h (cl-foldr f acc t)
    is Nil -> acc

  cl-reverse : ConsList a -> ConsList a
  cl-reverse (xs) = cl-foldl (cl-flip-cons) Nil xs

  cl-flip-cons : ConsList a, a -> ConsList a
  cl-flip-cons (acc) (x) = Cons x acc

  cl-append : ConsList a, ConsList a -> ConsList a
  cl-append (xs) (ys) = when xs
    is Cons (h) (t) -> Cons h (cl-append t ys)
    is Nil -> ys

  cl-any : (a -> Boolean), ConsList a -> Boolean
  cl-any (pred) (xs) = when xs
    is Cons (h) (t) -> if pred h then True else cl-any pred t
    is Nil -> False

  cl-all : (a -> Boolean), ConsList a -> Boolean
  cl-all (pred) (xs) = when xs
    is Cons (h) (t) -> if pred h then cl-all pred t else False
    is Nil -> True

  cl-take : Integer, ConsList a -> ConsList a
  cl-take (n) (xs) =
    if n <= 0 then Nil
    else when xs
      is Cons (h) (t) -> Cons h (cl-take (n - 1) t)
      is Nil -> Nil

  cl-drop : Integer, ConsList a -> ConsList a
  cl-drop (n) (xs) =
    if n <= 0 then xs
    else when xs
      is Cons (h) (t) -> cl-drop (n - 1) t
      is Nil -> Nil

  cl-zip-with : (a, b -> c), ConsList a, ConsList b -> ConsList c
  cl-zip-with (f) (xs) (ys) = when xs
    is Cons (hx) (tx) -> when ys
      is Cons (hy) (ty) -> Cons (f hx hy) (cl-zip-with f tx ty)
      is Nil -> Nil
    is Nil -> Nil

  cl-sum : ConsList Integer -> Integer
  cl-sum (xs) = cl-foldl cl-add-int 0 xs

  cl-add-int : Integer, Integer -> Integer
  cl-add-int (a) (b) = a + b

