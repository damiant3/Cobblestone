Chapter: Lwm2m
  cites Foreword chapter Maybe

 OMA LwM2M (Lightweight Machine-to-Machine) object model.
 LwM2M defines a standard data model for IoT device management
 using CoAP as the transport. Objects have numeric IDs and
 contain resources (also numeric IDs) with typed values.

 Standard object IDs per OMA registry:
   0 = Security, 1 = Server, 3 = Device, 4 = Connectivity,
   5 = Firmware Update, 6 = Location, 3303 = Temperature,
   3304 = Humidity, 3313 = Accelerometer, 3200 = Digital Input,
   3201 = Digital Output

Section: Object Model

  Lwm2mObjectId = record {
   id : Integer between 0 and 65535,
   instance : Integer between 0 and 65535
  }

  Lwm2mResourceId = record {
   object-id : Integer between 0 and 65535,
   instance : Integer between 0 and 65535,
   resource : Integer between 0 and 65535
  }

  Lwm2mValue =
    | Lwm2mString (Text)
    | Lwm2mInteger (Integer)
    | Lwm2mFloat (Integer) (Integer)
    | Lwm2mBoolean (Boolean)
    | Lwm2mOpaque (List Integer)
    | Lwm2mTime (Integer)

Section: Standard Object IDs

  lwm2m-obj-security : Integer = 0
  lwm2m-obj-server : Integer = 1
  lwm2m-obj-device : Integer = 3
  lwm2m-obj-connectivity : Integer = 4
  lwm2m-obj-firmware : Integer = 5
  lwm2m-obj-location : Integer = 6
  lwm2m-obj-temperature : Integer = 3303
  lwm2m-obj-humidity : Integer = 3304
  lwm2m-obj-accelerometer : Integer = 3313
  lwm2m-obj-digital-input : Integer = 3200
  lwm2m-obj-digital-output : Integer = 3201

Section: Device Object Resources (Object 3)

  lwm2m-res-manufacturer : Integer = 0
  lwm2m-res-model : Integer = 1
  lwm2m-res-serial : Integer = 2
  lwm2m-res-firmware-version : Integer = 3
  lwm2m-res-reboot : Integer = 4
  lwm2m-res-factory-reset : Integer = 5
  lwm2m-res-battery-level : Integer = 9
  lwm2m-res-memory-free : Integer = 10
  lwm2m-res-error-code : Integer = 11
  lwm2m-res-current-time : Integer = 13

Section: URI Path Helpers

  lwm2m-uri : Integer, Integer, Integer -> Text
  lwm2m-uri (obj) (inst) (res) =
   "/" & show obj & "/" & show inst & "/" & show res

  lwm2m-object-uri : Integer, Integer -> Text
  lwm2m-object-uri (obj) (inst) =
   "/" & show obj & "/" & show inst

Section: Registration

  LwmRegistration = record {
   endpoint : Text,
   lifetime : Integer between 30 and 86400,
   binding : Text,
   objects : List Lwm2mObjectId
  }

  default-lwm2m-registration : LwmRegistration
  default-lwm2m-registration = LwmRegistration {
   endpoint = "codex-device",
   lifetime = 300,
   binding = "U",
   objects = []
  }

  lwm2m-registration-path : LwmRegistration -> Text
  lwm2m-registration-path (reg) =
   "/rd?ep=" & reg.endpoint & "&lt=" & show (reg.lifetime) & "&b=" & reg.binding

Section: TLV Encoding (Type-Length-Value per LwM2M spec)

  lwm2m-tlv-type-resource : Integer = 3

  lwm2m-encode-tlv-resource : Integer, List Integer -> List Integer
  lwm2m-encode-tlv-resource (resource-id) (value) =
   let type-byte = bit-or (bit-shl lwm2m-tlv-type-resource 6) (if resource-id > 255 then 32 else 0)
   in let id-bytes = if resource-id > 255 then [bit-shru resource-id 8, bit-and resource-id 255] else [resource-id]
   in let len = list-length value
   in let len-field = if len < 8 then bit-or type-byte len
    else type-byte
   in let len-bytes = if len < 8 then []
    else if len < 256 then [bit-or type-byte 8, len]
    else [bit-or type-byte 16, bit-shru len 8, bit-and len 255]
   in [len-field] & id-bytes & len-bytes & value

