Chapter: SessionTypes

Section: Protocol States

  SSend m p = | MkSSend
  SRecv m p = | MkSRecv
  SEnd = | MkSEnd
  SOffer l r = | MkSOffer

Section: Pure Sessions

  Session p a = | MkSession (a)

  Peeked p a = | MkPeeked (a) (linear Session p a)

  Offered l r a =
    | TookLeft (linear Session l a)
    | TookRight (linear Session r a)
    | Refused (a)

  Answered p a =
    | Accepted (linear Session p a)
    | Rejected (a)

  session-open : a -> linear Session p a
  session-open (v) = MkSession v

  session-peek : linear Session p a -> Peeked p a
  session-peek (x) =
    when x
      is MkSession (v) -> MkPeeked v (MkSession v)

  session-send : linear Session (SSend m p) a, a -> linear Session p a
  session-send (x) (v) =
    when x
      is MkSession (old) -> MkSession v

  session-recv : linear Session (SRecv m p) a, a -> linear Session p a
  session-recv (x) (v) =
    when x
      is MkSession (old) -> MkSession v

  session-left : linear Session (SOffer l r) a -> linear Session l a
  session-left (x) =
    when x
      is MkSession (v) -> MkSession v

  session-right : linear Session (SOffer l r) a -> linear Session r a
  session-right (x) =
    when x
      is MkSession (v) -> MkSession v

  session-stay : linear Session p a, a -> linear Session p a
  session-stay (x) (v) =
    when x
      is MkSession (old) -> MkSession v

  session-close : linear Session SEnd a -> a
  session-close (x) =
    when x
      is MkSession (v) -> v

  session-abandon : linear Session p a -> a
  session-abandon (x) =
    when x
      is MkSession (v) -> v

