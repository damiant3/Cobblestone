Chapter: RingBuffer
  cites Foreword chapter Maybe
  cites Foreword chapter ListUtils

 We say:

Section: Type
  RingBuffer = record {
    storage : List Integer,
    capacity : Integer between 1 and 65535,
    head : Integer between 0 and 65535,
    tail : Integer between 0 and 65535,
    count : Integer between 0 and 65535
  }

Section: Construction
  ring-new : Integer -> RingBuffer
  ring-new (cap) = RingBuffer { storage = list-zeros cap, capacity = __narrow cap, head = 0, tail = 0, count = 0 }

Section: Push / Pop
  ring-push : RingBuffer, Integer -> RingBuffer
  ring-push (rb) (val) =
    let new-storage = list-set-at (rb.storage) (rb.tail) val
    in let new-tail = ring-wrap (rb.tail + 1) (rb.capacity)
    in if rb.count == rb.capacity then
      RingBuffer { storage = new-storage, capacity = rb.capacity, head = __narrow (ring-wrap (rb.head + 1) (rb.capacity)), tail = __narrow new-tail, count = rb.count }
    else RingBuffer { storage = new-storage, capacity = rb.capacity, head = rb.head, tail = __narrow new-tail, count = rb.count + 1 }

  RingPopResult = record {
    value : Integer,
    buffer : RingBuffer,
    valid : Boolean
  }

  ring-pop : RingBuffer -> RingPopResult
  ring-pop (rb) =
    if rb.count == 0 then RingPopResult { value = 0, buffer = rb, valid = False }
    else let val = list-at (rb.storage) (rb.head)
    in let new-head = ring-wrap (rb.head + 1) (rb.capacity)
    in RingPopResult { value = val, buffer = RingBuffer { storage = rb.storage, capacity = rb.capacity, head = __narrow new-head, tail = rb.tail, count = rb.count - 1 }, valid = True }

  ring-peek : RingBuffer -> Maybe Integer
  ring-peek (rb) =
    if rb.count == 0 then None
    else Just (list-at (rb.storage) (rb.head))

  ring-wrap : Integer, Integer -> Integer
  ring-wrap (idx) (cap) = if idx >= cap then idx - cap else idx

Section: Bulk Operations
  ring-push-all : RingBuffer, List Integer, Integer, Integer -> RingBuffer
  ring-push-all (rb) (items) (i) (len) =
    if i >= len then rb
    else ring-push-all (ring-push rb (list-at items i)) items (i + 1) len

  ring-drain : RingBuffer -> List Integer
  ring-drain (rb) = ring-drain-loop rb []

  ring-drain-loop : RingBuffer, List Integer -> List Integer
  ring-drain-loop (rb) (acc) =
    if rb.count == 0 then acc
    else let r = ring-pop rb
    in ring-drain-loop (r.buffer) (list-push acc (r.value))

Section: Queries
  ring-count : RingBuffer -> Integer
  ring-count (rb) = rb.count

  ring-is-empty : RingBuffer -> Boolean
  ring-is-empty (rb) = rb.count == 0

  ring-is-full : RingBuffer -> Boolean
  ring-is-full (rb) = rb.count == rb.capacity

  ring-capacity : RingBuffer -> Integer
  ring-capacity (rb) = rb.capacity

  ring-available : RingBuffer -> Integer
  ring-available (rb) = rb.capacity - rb.count

