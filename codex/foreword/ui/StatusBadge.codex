Chapter: StatusBadge
  cites UI chapter Widget
  cites UI chapter Theme

 Color-coded status badges and priority indicators. Provides a
 standard visual language for status across all apps: filled dot
 for done/cancelled, outlined dot for in-progress, colored pill
 for labels, priority bars for urgency.

 Used by: TrackerApp, Helm, Explorer, WorkflowHtml, Collab.

 We say:

Section: Types
  BadgeStyle =
    | BsDot (Integer)
    | BsDotFilled (Integer)
    | BsPill (Text) (Integer)
    | BsPriorityBar (Integer) (Integer)
    | BsIcon (Text) (Integer)

Section: Standard Status Dots
  badge-status : Integer -> BadgeStyle
  badge-status (status) =
    let color = badge-status-color status
    in if status >= 4 then BsDotFilled color else BsDot color

  badge-status-color : Integer -> Integer
  badge-status-color (s) =
    if s == 0 then #64748B
    else if s == 1 then #A78BFA
    else if s == 2 then #F59E0B
    else if s == 3 then #3B82F6
    else if s == 4 then #22C55E
    else #6B7280

  badge-status-name : Integer -> Text
  badge-status-name (s) =
    if s == 0 then "Backlog" else if s == 1 then "Todo"
    else if s == 2 then "Active" else if s == 3 then "Review"
    else if s == 4 then "Done" else "Cancelled"

Section: Standard Priority Bars
  badge-priority : Integer -> BadgeStyle
  badge-priority (pri) =
    let color = badge-priority-color pri
    in let bars = if pri == 0 then 4 else if pri == 1 then 3 else if pri == 2 then 2 else if pri == 3 then 1 else 0
    in BsPriorityBar bars color

  badge-priority-color : Integer -> Integer
  badge-priority-color (p) =
    if p == 0 then #EF4444
    else if p == 1 then #F97316
    else if p == 2 then #F59E0B
    else if p == 3 then #3B82F6
    else #6B7280

  badge-priority-name : Integer -> Text
  badge-priority-name (p) =
    if p == 0 then "Urgent" else if p == 1 then "High"
    else if p == 2 then "Medium" else if p == 3 then "Low" else "None"

Section: Label Pills
  badge-label : Text -> BadgeStyle
  badge-label (label) = BsPill label (badge-label-color label)

  badge-label-color : Text -> Integer
  badge-label-color (label) =
    if label == "bug" then #EF4444 else if label == "feature" then #8B5CF6
    else if label == "improve" then #3B82F6 else if label == "docs" then #14B8A6
    else if label == "perf" then #F97316 else if label == "security" then #EC4899
    else if label == "critical" then #DC2626 else if label == "enhancement" then #6366F1
    else if label == "question" then #8B5CF6 else if label == "wontfix" then #6B7280
    else #6B7280

Section: Widget Rendering
  badge-widget : Text, BadgeStyle -> WidgetNode
  badge-widget (id) (style) =
    when style
      is BsDot (color) -> widget-custom id "status-dot" 10 10
      is BsDotFilled (color) -> widget-custom id "status-dot-filled" 10 10
      is BsPill (text) (color) -> widget-set-min (widget-label id text) 48 14
      is BsPriorityBar (bars) (color) -> widget-custom id "priority-bar" 12 12
      is BsIcon (icon) (color) -> widget-set-min (widget-label id icon) 16 16

Section: Workflow Status (maps ProcessStatus to badge)
  badge-process-status : Text -> BadgeStyle
  badge-process-status (status) =
    if status == "active" then BsDot #F59E0B
    else if status == "completed" then BsDotFilled #22C55E
    else if status == "suspended" then BsDot #F59E0B
    else if status == "cancelled" then BsDotFilled #6B7280
    else BsDot #EF4444

Section: Severity Badges (for alerts, errors, warnings)
  badge-severity : Text -> BadgeStyle
  badge-severity (sev) =
    if sev == "critical" then BsPill "CRIT" #DC2626
    else if sev == "warning" then BsPill "WARN" #F59E0B
    else if sev == "info" then BsPill "INFO" #3B82F6
    else BsPill sev #6B7280

