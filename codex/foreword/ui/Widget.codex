Chapter: Widget
  cites Foreword chapter Maybe
  cites UI chapter Theme
  cites UI chapter BoxModel
  cites UI chapter Layout

Section: Widget Kind
  WidgetKind =
    | WkPanel
    | WkLabel (Text)
    | WkButton (Text)
    | WkGauge (Integer) (Integer)
    | WkSeparator
    | WkInput (Text) (Integer)
    | WkCustom (Text)

Section: Widget Node
  WidgetNode = record {
    wn-kind : WidgetKind,
    wn-state : Integer,
    wn-id : Text,
    wn-children : List WidgetNode,
    wn-child-count : Integer,
    wn-layout-dir : LayoutDir,
    wn-gap : Integer between 0 and 256,
    wn-flex : Integer between 0 and 1000,
    wn-min-w : Integer between 0 and 32767,
    wn-min-h : Integer between 0 and 32767,
    wn-tone : Integer between 0 and 5,
    wn-bounds : LayoutRect
  }

Section: Construction
  widget-panel : Text, LayoutDir, Integer, List WidgetNode -> WidgetNode
  widget-panel (id) (dir) (gap) (children) =
    WidgetNode {
      wn-kind = WkPanel,
      wn-state = state-normal,
      wn-id = id,
      wn-children = children,
      wn-child-count = list-length children,
      wn-layout-dir = dir,
      wn-gap = __narrow gap,
      wn-flex = 1,
      wn-min-w = 0,
      wn-min-h = 0,
      wn-tone = tone-none,
      wn-bounds = layout-rect-zero
    }

  wk-scroll-view-tag : Text = "scroll-view"

  widget-scroll-view : Text, LayoutDir, Integer, List WidgetNode -> WidgetNode
  widget-scroll-view (id) (dir) (gap) (children) =
    WidgetNode {
      wn-kind = WkCustom wk-scroll-view-tag,
      wn-state = state-normal,
      wn-id = id,
      wn-children = children,
      wn-child-count = list-length children,
      wn-layout-dir = dir,
      wn-gap = __narrow gap,
      wn-flex = 1,
      wn-min-w = 0,
      wn-min-h = 0,
      wn-tone = tone-none,
      wn-bounds = layout-rect-zero
    }

  widget-is-scroll-view : WidgetNode -> Boolean
  widget-is-scroll-view (w) = when w.wn-kind
    is WkCustom (tag) -> tag == wk-scroll-view-tag
    is otherwise -> False

  widget-label : Text, Text -> WidgetNode
  widget-label (id) (txt) =
    WidgetNode {
      wn-kind = WkLabel txt,
      wn-state = state-normal,
      wn-id = id,
      wn-children = [],
      wn-child-count = 0,
      wn-layout-dir = DirRow,
      wn-gap = 0,
      wn-flex = 0,
      wn-min-w = __narrow (text-length txt * 8),
      wn-min-h = 16,
      wn-tone = tone-none,
      wn-bounds = layout-rect-zero
    }

  widget-button : Text, Text -> WidgetNode
  widget-button (id) (txt) =
    WidgetNode {
      wn-kind = WkButton txt,
      wn-state = state-normal,
      wn-id = id,
      wn-children = [],
      wn-child-count = 0,
      wn-layout-dir = DirRow,
      wn-gap = 0,
      wn-flex = 0,
      wn-min-w = __narrow (text-length txt * 8 + 16),
      wn-min-h = 24,
      wn-tone = tone-none,
      wn-bounds = layout-rect-zero
    }

  widget-gauge : Text, Integer, Integer -> WidgetNode
  widget-gauge (id) (value) (max-val) =
    WidgetNode {
      wn-kind = WkGauge value max-val,
      wn-state = state-normal,
      wn-id = id,
      wn-children = [],
      wn-child-count = 0,
      wn-layout-dir = DirRow,
      wn-gap = 0,
      wn-flex = 1,
      wn-min-w = 60,
      wn-min-h = 16,
      wn-tone = tone-none,
      wn-bounds = layout-rect-zero
    }

  widget-separator : Text -> WidgetNode
  widget-separator (id) =
    WidgetNode {
      wn-kind = WkSeparator,
      wn-state = state-normal,
      wn-id = id,
      wn-children = [],
      wn-child-count = 0,
      wn-layout-dir = DirRow,
      wn-gap = 0,
      wn-flex = 0,
      wn-min-w = 0,
      wn-min-h = 2,
      wn-tone = tone-none,
      wn-bounds = layout-rect-zero
    }

  widget-input : Text, Text, Integer -> WidgetNode
  widget-input (id) (txt) (cursor) =
    WidgetNode {
      wn-kind = WkInput txt cursor,
      wn-state = state-normal,
      wn-id = id,
      wn-children = [],
      wn-child-count = 0,
      wn-layout-dir = DirRow,
      wn-gap = 0,
      wn-flex = 1,
      wn-min-w = 80,
      wn-min-h = 24,
      wn-tone = tone-none,
      wn-bounds = layout-rect-zero
    }

  widget-custom : Text, Text, Integer, Integer -> WidgetNode
  widget-custom (id) (tag) (w) (h) =
    WidgetNode {
      wn-kind = WkCustom tag,
      wn-state = state-normal,
      wn-id = id,
      wn-children = [],
      wn-child-count = 0,
      wn-layout-dir = DirRow,
      wn-gap = 0,
      wn-flex = 0,
      wn-min-w = __narrow w,
      wn-min-h = __narrow h,
      wn-tone = tone-none,
      wn-bounds = layout-rect-zero
    }

Section: Modification
  widget-set-state : WidgetNode, Integer -> WidgetNode
  widget-set-state (w) (s) =
    WidgetNode {
      wn-kind = w.wn-kind, wn-state = s, wn-id = w.wn-id,
      wn-children = w.wn-children, wn-child-count = w.wn-child-count,
      wn-layout-dir = w.wn-layout-dir, wn-gap = w.wn-gap,
      wn-flex = w.wn-flex, wn-min-w = w.wn-min-w, wn-min-h = w.wn-min-h,
      wn-tone = w.wn-tone,
      wn-bounds = w.wn-bounds
    }

  widget-set-flex : WidgetNode, Integer -> WidgetNode
  widget-set-flex (w) (f) =
    WidgetNode {
      wn-kind = w.wn-kind, wn-state = w.wn-state, wn-id = w.wn-id,
      wn-children = w.wn-children, wn-child-count = w.wn-child-count,
      wn-layout-dir = w.wn-layout-dir, wn-gap = w.wn-gap,
      wn-flex = __narrow f, wn-min-w = w.wn-min-w, wn-min-h = w.wn-min-h,
      wn-tone = w.wn-tone,
      wn-bounds = w.wn-bounds
    }

  widget-set-min : WidgetNode, Integer, Integer -> WidgetNode
  widget-set-min (w) (minw) (minh) =
    WidgetNode {
      wn-kind = w.wn-kind, wn-state = w.wn-state, wn-id = w.wn-id,
      wn-children = w.wn-children, wn-child-count = w.wn-child-count,
      wn-layout-dir = w.wn-layout-dir, wn-gap = w.wn-gap,
      wn-flex = w.wn-flex, wn-min-w = __narrow minw, wn-min-h = __narrow minh,
      wn-tone = w.wn-tone,
      wn-bounds = w.wn-bounds
    }

 A size a caller means as FIXED takes both calls, and this is the one that
 says so. `widget-set-min` sets a minimum and preserves flex, and
 `widget-panel` defaults flex to 1 where a label, a button and a separator
 all default it to 0, so a panel given only a minimum stays flexible and
 shares out the container instead. The minimum never binds and nothing
 reports it: the browser's chrome asked for a 32-pixel tab bar and got three
 rows of 247, and a `FilterableList` row asking for 22 measured 135 in a
 600-tall box (`browser-backlog.md` BROWSER-2, `codex/test/ui/fixed-row`).

 It is still a MINIMUM and not a ceiling, so a fixed row is at least as tall
 as what it holds, as WORKS-45 requires of every panel.

  widget-fixed : WidgetNode, Integer, Integer -> WidgetNode
  widget-fixed (w) (minw) (minh) = widget-set-flex (widget-set-min w minw minh) 0

  widget-set-tone : WidgetNode, Integer -> WidgetNode
  widget-set-tone (w) (tone) =
    WidgetNode {
      wn-kind = w.wn-kind, wn-state = w.wn-state, wn-id = w.wn-id,
      wn-children = w.wn-children, wn-child-count = w.wn-child-count,
      wn-layout-dir = w.wn-layout-dir, wn-gap = w.wn-gap,
      wn-flex = w.wn-flex, wn-min-w = w.wn-min-w, wn-min-h = w.wn-min-h,
      wn-tone = __narrow tone,
      wn-bounds = w.wn-bounds
    }

  widget-set-bounds : WidgetNode, LayoutRect -> WidgetNode
  widget-set-bounds (w) (r) =
    WidgetNode {
      wn-kind = w.wn-kind, wn-state = w.wn-state, wn-id = w.wn-id,
      wn-children = w.wn-children, wn-child-count = w.wn-child-count,
      wn-layout-dir = w.wn-layout-dir, wn-gap = w.wn-gap,
      wn-flex = w.wn-flex, wn-min-w = w.wn-min-w, wn-min-h = w.wn-min-h,
      wn-tone = w.wn-tone,
      wn-bounds = r
    }

  widget-set-children : WidgetNode, List WidgetNode -> WidgetNode
  widget-set-children (w) (kids) =
    WidgetNode {
      wn-kind = w.wn-kind, wn-state = w.wn-state, wn-id = w.wn-id,
      wn-children = kids, wn-child-count = list-length kids,
      wn-layout-dir = w.wn-layout-dir, wn-gap = w.wn-gap,
      wn-flex = w.wn-flex, wn-min-w = w.wn-min-w, wn-min-h = w.wn-min-h,
      wn-tone = w.wn-tone,
      wn-bounds = w.wn-bounds
    }

  widget-add-child : WidgetNode, WidgetNode -> WidgetNode
  widget-add-child (parent) (child) =
    WidgetNode {
      wn-kind = parent.wn-kind, wn-state = parent.wn-state, wn-id = parent.wn-id,
      wn-children = list-push (parent.wn-children) child,
      wn-child-count = parent.wn-child-count + 1,
      wn-layout-dir = parent.wn-layout-dir, wn-gap = parent.wn-gap,
      wn-flex = parent.wn-flex, wn-min-w = parent.wn-min-w, wn-min-h = parent.wn-min-h,
      wn-tone = parent.wn-tone,
      wn-bounds = parent.wn-bounds
    }

Section: Queries
  widget-kind-name : WidgetKind -> Text
  widget-kind-name (k) = when k
    is WkPanel -> "panel"
    is WkLabel (t) -> "label"
    is WkButton (t) -> "button"
    is WkGauge (v) (m) -> "gauge"
    is WkSeparator -> "separator"
    is WkInput (t) (c) -> "input"
    is WkCustom (tag) -> tag

  widget-is-leaf : WidgetNode -> Boolean
  widget-is-leaf (w) = w.wn-child-count == 0

  widget-find : WidgetNode, Text -> Maybe WidgetNode
  widget-find (w) (target) =
    if w.wn-id == target then Just w
    else widget-find-children (w.wn-children) target 0 (w.wn-child-count)

  widget-find-children : List WidgetNode, Text, Integer, Integer -> Maybe WidgetNode
  widget-find-children (children) (target) (i) (n) =
    if i >= n then None
    else let result = widget-find (list-at children i) target
    in when result
      is Just (found) -> Just found
      is None -> widget-find-children children target (i + 1) n

Section: Intrinsic Size

 `flex-col-place` gives a child a rect of `li-min-h` plus its margin, and
 `box-content-from-style` then subtracts margin, border and padding again
 from inside that rect. So a panel needing `inner` for its children must ask
 for `inner + style-overhead-h`, margin counted twice, which is the engine's
 own arithmetic rather than the box model's.

  widget-measure : WidgetNode, Theme -> WidgetNode
  widget-measure (w) (th) =
    if w.wn-child-count == 0 then w
    else let kids = widget-measure-children (w.wn-children) th 0 (w.wn-child-count) []
    in let style = widget-resolve-style w th
    in let n = w.wn-child-count
    in let total-gap = if n > 1 then w.wn-gap * (n - 1) else 0
    in let inner-w = when w.wn-layout-dir
      is DirRow -> widget-sum-min-w kids th 0 n 0 + total-gap
      is DirColumn -> widget-max-min-w kids th 0 n 0
    in let inner-h = when w.wn-layout-dir
      is DirRow -> widget-max-min-h kids th 0 n 0
      is DirColumn -> widget-sum-min-h kids th 0 n 0 + total-gap
    in WidgetNode {
      wn-kind = w.wn-kind, wn-state = w.wn-state, wn-id = w.wn-id,
      wn-children = kids, wn-child-count = n,
      wn-layout-dir = w.wn-layout-dir, wn-gap = w.wn-gap,
      wn-flex = w.wn-flex,
      wn-min-w = __narrow (box-min 32767 (if widget-is-scroll-view w then w.wn-min-w else box-max (w.wn-min-w) (inner-w + style-overhead-w style))),
      wn-min-h = __narrow (box-min 32767 (if widget-is-scroll-view w then w.wn-min-h else box-max (w.wn-min-h) (inner-h + style-overhead-h style))),
      wn-tone = w.wn-tone,
      wn-bounds = w.wn-bounds
    }

  widget-measure-children : List WidgetNode, Theme, Integer, Integer, List WidgetNode -> List WidgetNode
  widget-measure-children (children) (th) (i) (n) (acc) =
    if i >= n then acc
    else widget-measure-children children th (i + 1) n (list-push acc (widget-measure (list-at children i) th))

  widget-item-w : WidgetNode, Theme -> Integer
  widget-item-w (c) (th) =
    let style = widget-resolve-style c th
    in box-max (c.wn-min-w) (style.ws-min-width) + edges-h (style.ws-margin)

  widget-item-h : WidgetNode, Theme -> Integer
  widget-item-h (c) (th) =
    let style = widget-resolve-style c th
    in box-max (c.wn-min-h) (style.ws-min-height) + edges-v (style.ws-margin)

  widget-sum-min-w : List WidgetNode, Theme, Integer, Integer, Integer -> Integer
  widget-sum-min-w (kids) (th) (i) (n) (acc) =
    if i >= n then acc
    else widget-sum-min-w kids th (i + 1) n (acc + widget-item-w (list-at kids i) th)

  widget-sum-min-h : List WidgetNode, Theme, Integer, Integer, Integer -> Integer
  widget-sum-min-h (kids) (th) (i) (n) (acc) =
    if i >= n then acc
    else widget-sum-min-h kids th (i + 1) n (acc + widget-item-h (list-at kids i) th)

  widget-max-min-w : List WidgetNode, Theme, Integer, Integer, Integer -> Integer
  widget-max-min-w (kids) (th) (i) (n) (acc) =
    if i >= n then acc
    else widget-max-min-w kids th (i + 1) n (box-max acc (widget-item-w (list-at kids i) th))

  widget-max-min-h : List WidgetNode, Theme, Integer, Integer, Integer -> Integer
  widget-max-min-h (kids) (th) (i) (n) (acc) =
    if i >= n then acc
    else widget-max-min-h kids th (i + 1) n (box-max acc (widget-item-h (list-at kids i) th))

Section: Tree Layout

 The measure runs once at the root and the arrange walks the tree the
 measured node hands back. Measuring inside the recursion instead would walk
 every subtree once per level it sits under.

  widget-layout : WidgetNode, Theme, LayoutRect -> WidgetNode
  widget-layout (w) (th) (container) = widget-arrange (widget-measure w th) th container

  widget-arrange : WidgetNode, Theme, LayoutRect -> WidgetNode
  widget-arrange (w) (th) (container) =
    let style = widget-resolve-style w th
    in let content = box-content-from-style container style
    in let placed = widget-set-bounds w container
    in if placed.wn-child-count == 0 then placed
    else let items = widget-children-to-items (placed.wn-children) th 0 (placed.wn-child-count) []
    in let result = flex-layout content (placed.wn-layout-dir) (placed.wn-gap) items (placed.wn-child-count)
    in let laid-out = widget-arrange-children (placed.wn-children) th (result.lrs) 0 (placed.wn-child-count) []
    in WidgetNode {
      wn-kind = placed.wn-kind, wn-state = placed.wn-state, wn-id = placed.wn-id,
      wn-children = laid-out, wn-child-count = placed.wn-child-count,
      wn-layout-dir = placed.wn-layout-dir, wn-gap = placed.wn-gap,
      wn-flex = placed.wn-flex, wn-min-w = placed.wn-min-w, wn-min-h = placed.wn-min-h,
      wn-tone = w.wn-tone,
      wn-bounds = container
    }

  widget-children-to-items : List WidgetNode, Theme, Integer, Integer, List LayoutItem -> List LayoutItem
  widget-children-to-items (children) (th) (i) (n) (acc) =
    if i >= n then acc
    else let child = list-at children i
    in let style = widget-resolve-style child th
    in let item = layout-item-m (box-max (child.wn-min-w) (style.ws-min-width)) (box-max (child.wn-min-h) (style.ws-min-height)) (child.wn-flex) (style.ws-margin)
    in widget-children-to-items children th (i + 1) n (list-push acc item)

  widget-arrange-children : List WidgetNode, Theme, List LayoutRect, Integer, Integer, List WidgetNode -> List WidgetNode
  widget-arrange-children (children) (th) (rects) (i) (n) (acc) =
    if i >= n then acc
    else let child = list-at children i
    in let r = list-at rects i
    in let laid-out = widget-arrange child th r
    in widget-arrange-children children th rects (i + 1) n (list-push acc laid-out)

Section: Style Resolution
  widget-resolve-style : WidgetNode, Theme -> WidgetStyle
  widget-resolve-style (w) (th) = when w.wn-kind
    is WkPanel -> theme-resolve-panel th (w.wn-state)
    is WkLabel (t) -> theme-resolve-label th (w.wn-state)
    is WkButton (t) -> theme-resolve-button th (w.wn-state)
    is WkGauge (v) (m) -> theme-resolve-gauge th (w.wn-state)
    is WkSeparator -> theme-resolve-separator th (w.wn-state)
    is WkInput (t) (c) -> theme-resolve-input th (w.wn-state)
    is WkCustom (tag) -> if tag == wk-scroll-view-tag then widget-style-bare else theme-resolve-panel th (w.wn-state)

Section: Formatting
  format-widget : WidgetNode -> Text
  format-widget (w) =
    widget-kind-name (w.wn-kind) & "[" & w.wn-id & "]" & format-rect (w.wn-bounds)

  format-widget-tree : WidgetNode, Integer -> Text
  format-widget-tree (w) (depth) =
    let indent = fmt-indent depth
    in let line = indent & format-widget w
    in if w.wn-child-count == 0 then line
    else line & "\n" & fmt-children (w.wn-children) depth 0 (w.wn-child-count)

  fmt-children : List WidgetNode, Integer, Integer, Integer -> Text
  fmt-children (children) (depth) (i) (n) =
    if i >= n then ""
    else let child = format-widget-tree (list-at children i) (depth + 1)
    in let sep = if i + 1 < n then "\n" else ""
    in child & sep & fmt-children children depth (i + 1) n

  fmt-indent : Integer -> Text
  fmt-indent (n) = if n <= 0 then "" else "  " & fmt-indent (n - 1)

Section: Widget Catalog

  widget-checkbox : Text, Boolean -> WidgetNode
  widget-checkbox (id) (checked) =
    let label = if checked then "[x]" else "[ ]"
    in widget-button id label

  widget-radio : Text, Boolean -> WidgetNode
  widget-radio (id) (selected) =
    let label = if selected then "(o)" else "( )"
    in widget-button id label

  widget-slider : Text, Integer, Integer, Integer -> WidgetNode
  widget-slider (id) (value) (lo) (hi) =
    widget-gauge id (value - lo) (hi - lo)

  widget-progress : Text, Integer, Integer -> WidgetNode
  widget-progress (id) (value) (max-val) =
    widget-gauge id value max-val

  widget-dropdown : Text, Text, List Text -> WidgetNode
  widget-dropdown (id) (selected) (options) =
    let panel = widget-panel id DirColumn 0 []
    in widget-add-child panel (widget-label (id & "-sel") selected)

  widget-toolbar : Text, List WidgetNode -> WidgetNode
  widget-toolbar (id) (buttons) =
    widget-panel id DirRow 4 buttons

  widget-menu : Text, List Text -> WidgetNode
  widget-menu (id) (items) =
    let children = wk-menu-items id items 0 (list-length items) []
    in widget-panel id DirColumn 0 children

  wk-menu-items : Text, List Text, Integer, Integer, List WidgetNode -> List WidgetNode
  wk-menu-items (id) (items) (i) (len) (acc) =
    if i >= len then acc
    else let item = widget-button (id & "-" & show i) (list-at items i)
    in wk-menu-items id items (i + 1) len (list-push acc item)

  widget-tabs : Text, List Text, Integer -> WidgetNode
  widget-tabs (id) (labels) (selected) =
    let tabs = wk-tab-buttons id labels selected 0 (list-length labels) []
    in widget-panel id DirRow 0 tabs

  wk-tab-buttons : Text, List Text, Integer, Integer, Integer, List WidgetNode -> List WidgetNode
  wk-tab-buttons (id) (labels) (sel) (i) (len) (acc) =
    if i >= len then acc
    else let label = list-at labels i
    in let btn = widget-button (id & "-tab-" & show i) (if i == sel then "[" & label & "]" else label)
    in wk-tab-buttons id labels sel (i + 1) len (list-push acc btn)

  widget-list-view : Text, List Text -> WidgetNode
  widget-list-view (id) (items) =
    let children = wk-list-items id items 0 (list-length items) []
    in widget-panel id DirColumn 2 children

  wk-list-items : Text, List Text, Integer, Integer, List WidgetNode -> List WidgetNode
  wk-list-items (id) (items) (i) (len) (acc) =
    if i >= len then acc
    else wk-list-items id items (i + 1) len (list-push acc (widget-label (id & "-" & show i) (list-at items i)))

  widget-number-field : Text, Integer -> WidgetNode
  widget-number-field (id) (value) = widget-input id (show value) (text-length (show value))

  widget-text-area : Text, Text -> WidgetNode
  widget-text-area (id) (content) = widget-input id content (text-length content)

Page 1
