Chapter: Window
  cites UI chapter Event
  cites Foreword chapter Maybe

 Multi-window and tab management. A WindowManager tracks a list of
 windows with z-order, focus state, and layout bounds. Windows can
 be created, closed, focused, moved, resized, and tiled. Tabs are
 windows grouped into a tab bar within a parent window.

 To wm-new gives an empty window manager.
 To wm-open gives a manager with a new window added.
 To wm-close gives a manager with a window removed.
 To wm-focus gives a manager with a window brought to front.
 To wm-tile gives a manager with windows tiled.

 We say:

Section: Types

  WindowState =
    | WsNormal
    | WsMinimized
    | WsMaximized

  Window = record {
    win-id : Text,
    win-title : Text,
    win-x : Integer,
    win-y : Integer,
    win-width : Integer,
    win-height : Integer,
    win-state : WindowState,
    win-z : Integer,
    win-focused : Boolean,
    win-closeable : Boolean
  }

  WindowManager = record {
    wm-windows : List Window,
    wm-count : Integer,
    wm-next-z : Integer,
    wm-screen-w : Integer,
    wm-screen-h : Integer
  }

Section: Construction

  wm-new : Integer, Integer -> WindowManager
  wm-new (screen-w) (screen-h) = WindowManager {
    wm-windows = [],
    wm-count = 0,
    wm-next-z = 1,
    wm-screen-w = screen-w,
    wm-screen-h = screen-h
  }

  wm-open : WindowManager, Text, Text, Integer, Integer, Integer, Integer -> WindowManager
  wm-open (wm) (id) (title) (x) (y) (w) (h) =
    let win = Window { win-id = id, win-title = title, win-x = x, win-y = y, win-width = w, win-height = h, win-state = WsNormal, win-z = wm.wm-next-z, win-focused = True, win-closeable = True }
    in let unfocused = wm-unfocus-all (wm.wm-windows) 0 (wm.wm-count) []
    in WindowManager {
      wm-windows = list-push unfocused win,
      wm-count = wm.wm-count + 1,
      wm-next-z = wm.wm-next-z + 1,
      wm-screen-w = wm.wm-screen-w,
      wm-screen-h = wm.wm-screen-h
    }

  wm-close : WindowManager, Text -> WindowManager
  wm-close (wm) (id) =
    let filtered = wm-remove (wm.wm-windows) id 0 (wm.wm-count) []
    in WindowManager {
      wm-windows = filtered,
      wm-count = list-length filtered,
      wm-next-z = wm.wm-next-z,
      wm-screen-w = wm.wm-screen-w,
      wm-screen-h = wm.wm-screen-h
    }

Section: Focus

  wm-focus : WindowManager, Text -> WindowManager
  wm-focus (wm) (id) =
    let updated = wm-set-focus (wm.wm-windows) id (wm.wm-next-z) 0 (wm.wm-count) []
    in WindowManager {
      wm-windows = updated,
      wm-count = wm.wm-count,
      wm-next-z = wm.wm-next-z + 1,
      wm-screen-w = wm.wm-screen-w,
      wm-screen-h = wm.wm-screen-h
    }

  wm-set-focus : List Window, Text, Integer, Integer, Integer, List Window -> List Window
  wm-set-focus (wins) (id) (new-z) (i) (len) (acc) =
    if i >= len then acc
    else let w = list-at wins i
    in if w.win-id == id then
      wm-set-focus wins id new-z (i + 1) len (list-push acc (__record-set (__record-set w "win-focused" True) "win-z" new-z))
    else wm-set-focus wins id new-z (i + 1) len (list-push acc (__record-set w "win-focused" False))

  wm-unfocus-all : List Window, Integer, Integer, List Window -> List Window
  wm-unfocus-all (wins) (i) (len) (acc) =
    if i >= len then acc
    else wm-unfocus-all wins (i + 1) len (list-push acc (__record-set (list-at wins i) "win-focused" False))

Section: Move and Resize

  wm-move : WindowManager, Text, Integer, Integer -> WindowManager
  wm-move (wm) (id) (new-x) (new-y) =
    __record-set wm "wm-windows" (wm-update-win (wm.wm-windows) id (\win -> __record-set (__record-set win "win-x" new-x) "win-y" new-y) 0 (wm.wm-count) [])

  wm-resize : WindowManager, Text, Integer, Integer -> WindowManager
  wm-resize (wm) (id) (new-w) (new-h) =
    __record-set wm "wm-windows" (wm-update-win (wm.wm-windows) id (\win -> __record-set (__record-set win "win-width" new-w) "win-height" new-h) 0 (wm.wm-count) [])

  wm-update-win : List Window, Text, (Window -> Window), Integer, Integer, List Window -> List Window
  wm-update-win (wins) (id) (f) (i) (len) (acc) =
    if i >= len then acc
    else let w = list-at wins i
    in if w.win-id == id then wm-update-win wins id f (i + 1) len (list-push acc (f w))
    else wm-update-win wins id f (i + 1) len (list-push acc w)

Section: Tiling

  wm-tile : WindowManager -> WindowManager
  wm-tile (wm) =
    if wm.wm-count == 0 then wm
    else let cols = wm-tile-cols (wm.wm-count)
    in let rows = (wm.wm-count + cols - 1) / cols
    in let cell-w = wm.wm-screen-w / cols
    in let cell-h = wm.wm-screen-h / rows
    in __record-set wm "wm-windows" (wm-tile-loop (wm.wm-windows) cols cell-w cell-h 0 (wm.wm-count) [])

  wm-tile-cols : Integer -> Integer
  wm-tile-cols (n) =
    if n <= 1 then 1
    else if n <= 4 then 2
    else 3

  wm-tile-loop : List Window, Integer, Integer, Integer, Integer, Integer, List Window -> List Window
  wm-tile-loop (wins) (cols) (cw) (ch) (i) (len) (acc) =
    if i >= len then acc
    else let w = list-at wins i
    in let col = i - (i / cols) * cols
    in let row = i / cols
    in let tiled = __record-set (__record-set (__record-set (__record-set w "win-x" (col * cw)) "win-y" (row * ch)) "win-width" cw) "win-height" ch
    in wm-tile-loop wins cols cw ch (i + 1) len (list-push acc tiled)

Section: Queries

  wm-find : WindowManager, Text -> Maybe Window
  wm-find (wm) (id) = wm-find-loop (wm.wm-windows) id 0 (wm.wm-count)

  wm-find-loop : List Window, Text, Integer, Integer -> Maybe Window
  wm-find-loop (wins) (id) (i) (len) =
    if i >= len then None
    else let w = list-at wins i
    in if w.win-id == id then Just w
    else wm-find-loop wins id (i + 1) len

  wm-focused : WindowManager -> Maybe Window
  wm-focused (wm) = wm-focused-loop (wm.wm-windows) 0 (wm.wm-count)

  wm-focused-loop : List Window, Integer, Integer -> Maybe Window
  wm-focused-loop (wins) (i) (len) =
    if i >= len then None
    else let w = list-at wins i
    in if w.win-focused then Just w
    else wm-focused-loop wins (i + 1) len

  wm-remove : List Window, Text, Integer, Integer, List Window -> List Window
  wm-remove (wins) (id) (i) (len) (acc) =
    if i >= len then acc
    else let w = list-at wins i
    in if w.win-id == id then wm-remove wins id (i + 1) len acc
    else wm-remove wins id (i + 1) len (list-push acc w)

