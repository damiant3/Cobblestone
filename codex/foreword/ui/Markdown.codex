Section: Block Types

  UiMdBlock =
    | UiMdParagraph (RichText)
    | UiMdHeading (Integer) (RichText)
    | UiMdCodeBlock (Text) (Text)
    | UiMdBlockquote (RichText)
    | UiMdListItem (RichText)
    | UiMdOrderedItem (Integer) (RichText)
    | UiMdHRule
    | UiMdBlank

  UiMdDocument = record {
    md-blocks : List UiMdBlock,
    md-block-count : Integer
  }

Section: Parsing

  ui-md-parse : Text -> UiMdDocument
  ui-md-parse (input) =
    let lines = text-split input "\n"
    in let blocks = ui-md-parse-lines lines 0 (list-length lines) False "" [] []
    in UiMdDocument { md-blocks = blocks, md-block-count = list-length blocks }

  ui-md-parse-lines : List Text, Integer, Integer, Boolean, Text, List Text, List UiMdBlock -> List UiMdBlock
  ui-md-parse-lines (lines) (i) (n) (in-code) (code-lang) (code-acc) (blocks) =
    if i >= n then
      if in-code then list-push blocks (md-code-block code-lang code-acc)
      else blocks
    else let line = list-at lines i
    in if in-code then
      if text-starts-with line "```" then ui-md-parse-lines lines (i + 1) n False "" [] (list-push blocks (md-code-block code-lang code-acc))
      else ui-md-parse-lines lines (i + 1) n True code-lang (md-code-add code-acc line) blocks
    else if text-starts-with line "```" then ui-md-parse-lines lines (i + 1) n True (text-drop line 3) [] blocks
    else ui-md-parse-lines lines (i + 1) n False "" [] (list-push blocks (md-line-block line))

  md-code-add : List Text, Text -> List Text
  md-code-add (acc) (line) =
    if list-length acc == 0 then list-push acc line
    else list-push (list-push acc "\n") line

  md-code-block : Text, List Text -> UiMdBlock
  md-code-block (lang) (acc) = UiMdCodeBlock lang (text-concat-list acc)

  md-line-block : Text -> UiMdBlock
  md-line-block (line) =
    if text-length line == 0 then UiMdBlank
    else if md-is-hrule line then UiMdHRule
    else if text-starts-with line "######" then md-heading 6 line
    else if text-starts-with line "#####" then md-heading 5 line
    else if text-starts-with line "####" then md-heading 4 line
    else if text-starts-with line "###" then md-heading 3 line
    else if text-starts-with line "##" then md-heading 2 line
    else if text-starts-with line "#" then md-heading 1 line
    else if text-starts-with line "> " then UiMdBlockquote (md-parse-inline (text-drop line 2))
    else if text-starts-with line "- " then UiMdListItem (md-parse-inline (text-drop line 2))
    else if text-starts-with line "* " then UiMdListItem (md-parse-inline (text-drop line 2))
    else if md-is-ordered line then md-ordered-item line
    else UiMdParagraph (md-parse-inline line)

  md-heading : Integer, Text -> UiMdBlock
  md-heading (level) (line) =
    let content = md-strip-hashes line level
    in UiMdHeading level (md-parse-inline content)

  md-strip-hashes : Text, Integer -> Text
  md-strip-hashes (line) (level) =
    let dropped = text-drop line level
    in if text-starts-with dropped " " then text-drop dropped 1 else dropped

  md-is-hrule : Text -> Boolean
  md-is-hrule (line) =
    if text-length line < 3 then False
    else if text-starts-with line "---" then True
    else if text-starts-with line "***" then True
    else if text-starts-with line "___" then True
    else False

 CommonMark 5.2: an ordered list marker is one to nine digits.

  md-is-ordered : Text -> Boolean
  md-is-ordered (line) =
    if text-length line < 3 then False
    else if is-digit (char-at line 0) then md-has-dot-space line 1 (text-length line)
    else False

  md-has-dot-space : Text, Integer, Integer -> Boolean
  md-has-dot-space (line) (i) (n) =
    if i >= n then False
    else if i > 9 then False
    else let c = char-code-at line i
    in if c == 65 then
      if i + 1 < n then char-code-at line (i + 1) == 2
      else False
    else if is-digit (char-at line i) then md-has-dot-space line (i + 1) n
    else False

  md-ordered-item : Text -> UiMdBlock
  md-ordered-item (line) =
    let dot-pos = md-find-dot line 0 (text-length line)
    in let num-text = text-take line dot-pos
    in let content = text-drop line (dot-pos + 2)
    in UiMdOrderedItem (text-to-integer num-text) (md-parse-inline content)

  md-find-dot : Text, Integer, Integer -> Integer
  md-find-dot (line) (i) (n) =
    if i >= n then 0
    else if char-code-at line i == 65 then i
    else md-find-dot line (i + 1) n

Section: Inline Formatting

  md-parse-inline : Text -> RichText
  md-parse-inline (text) =
    let runs = md-inline-scan text 0 (text-length text) 0 True []
    in RichText { rt-runs = runs, rt-run-count = list-length runs }

  md-inline-scan : Text, Integer, Integer, Integer, Boolean, List TextRun -> List TextRun
  md-inline-scan (text) (i) (n) (plain-start) (link-ok) (runs) =
    if i >= n then md-flush-plain text plain-start n runs
    else if md-at text i n "**" then
      let flushed = md-flush-plain text plain-start i runs
      in let close = md-find-marker text (i + 2) n "**"
      in if close < 0 then md-inline-scan text (i + 2) n (i + 2) link-ok (md-push flushed (rich-text-plain "**"))
      else md-inline-scan text (close + 2) n (close + 2) link-ok (md-push flushed (rich-text-bold (substring text (i + 2) (close - i - 2))))
    else if md-at text i n "*" then
      let flushed = md-flush-plain text plain-start i runs
      in let close = md-find-marker text (i + 1) n "*"
      in if close < 0 then md-inline-scan text (i + 1) n (i + 1) link-ok (md-push flushed (rich-text-plain "*"))
      else md-inline-scan text (close + 1) n (close + 1) link-ok (md-push flushed (rich-text-italic (substring text (i + 1) (close - i - 1))))
    else if md-at text i n "`" then
      let flushed = md-flush-plain text plain-start i runs
      in let close = md-find-marker text (i + 1) n "`"
      in if close < 0 then md-inline-scan text (i + 1) n (i + 1) link-ok (md-push flushed (rich-text-plain "`"))
      else md-inline-scan text (close + 1) n (close + 1) link-ok (md-push flushed (rich-text-colored (substring text (i + 1) (close - i - 1)) #888888))
    else if md-at text i n "[" then
      if link-ok then
        let close-bracket = md-find-marker text (i + 1) n "]("
        in let close-paren = if close-bracket < 0 then -1 else md-find-marker text (close-bracket + 2) n ")"
        in if close-paren < 0 then md-inline-scan text (i + 1) n plain-start False runs
        else let label = substring text (i + 1) (close-bracket - i - 1)
        in let url = substring text (close-bracket + 2) (close-paren - close-bracket - 2)
        in md-inline-scan text (close-paren + 1) n (close-paren + 1) True (md-push (md-flush-plain text plain-start i runs) (rich-text-link label url))
      else md-inline-scan text (i + 1) n plain-start False runs
    else md-inline-scan text (i + 1) n plain-start link-ok runs

  md-at : Text, Integer, Integer, Text -> Boolean
  md-at (text) (i) (n) (marker) =
    let mlen = text-length marker
    in if i + mlen > n then False
    else md-match text i marker 0 mlen

  md-match : Text, Integer, Text, Integer, Integer -> Boolean
  md-match (text) (i) (marker) (j) (mlen) =
    if j >= mlen then True
    else if char-code-at text (i + j) == char-code-at marker j then md-match text i marker (j + 1) mlen
    else False

  md-push : List TextRun, RichText -> List TextRun
  md-push (runs) (rt) = list-push runs (list-at (rt.rt-runs) 0)

  md-flush-plain : Text, Integer, Integer, List TextRun -> List TextRun
  md-flush-plain (text) (start) (end-pos) (runs) =
    if start >= end-pos then runs
    else md-push runs (rich-text-plain (substring text start (end-pos - start)))

  md-find-marker : Text, Integer, Integer, Text -> Integer
  md-find-marker (text) (start) (n) (marker) =
    if start + text-length marker > n then -1
    else if md-at text start n marker then start
    else md-find-marker text (start + 1) n marker

Section: Widget Building

  md-document-to-widget : UiMdDocument, Text -> WidgetNode
  md-document-to-widget (doc) (id) =
    let children = md-blocks-to-widgets (doc.md-blocks) id 0 (doc.md-block-count) []
    in widget-panel id DirColumn 4 children

  md-blocks-to-widgets : List UiMdBlock, Text, Integer, Integer, List WidgetNode -> List WidgetNode
  md-blocks-to-widgets (blocks) (id) (i) (n) (acc) =
    if i >= n then acc
    else let block = list-at blocks i
    in let w = md-block-to-widget block (id & "-b" & show i)
    in md-blocks-to-widgets blocks id (i + 1) n (list-push acc w)

  md-block-to-widget : UiMdBlock, Text -> WidgetNode
  md-block-to-widget (block) (id) = when block
    is UiMdParagraph (rt) -> widget-label id (rich-text-to-plain rt)
    is UiMdHeading (level) (rt) -> md-heading-widget id level rt
    is UiMdCodeBlock (lang) (content) -> md-code-widget id content
    is UiMdBlockquote (rt) -> md-quote-widget id rt
    is UiMdListItem (rt) -> widget-label id ("  - " & rich-text-to-plain rt)
    is UiMdOrderedItem (num) (rt) -> widget-label id ("  " & show num & ". " & rich-text-to-plain rt)
    is UiMdHRule -> widget-separator id
    is UiMdBlank -> widget-label id ""

  md-heading-widget : Text, Integer, RichText -> WidgetNode
  md-heading-widget (id) (level) (rt) =
    let prefix = if level == 1 then "# "
      else if level == 2 then "## "
      else if level == 3 then "### "
      else if level == 4 then "#### "
      else if level == 5 then "##### "
      else "###### "
    in let lbl = widget-label id (prefix & rich-text-to-plain rt)
    in widget-set-tone (widget-add-flag lbl flag-focused) tone-primary

  md-code-widget : Text, Text -> WidgetNode
  md-code-widget (id) (content) =
    let lbl = widget-label id content
    in widget-set-tone (widget-add-flag lbl flag-hovered) tone-muted

  md-quote-widget : Text, RichText -> WidgetNode
  md-quote-widget (id) (rt) =
    let lbl = widget-label id ("> " & rich-text-to-plain rt)
    in widget-set-tone (widget-add-flag lbl flag-disabled) tone-muted

Section: Rich Text Extraction

  rich-text-to-plain : RichText -> Text
  rich-text-to-plain (rt) = rt-to-plain-loop (rt.rt-runs) 0 (rt.rt-run-count) ""

  rt-to-plain-loop : List TextRun, Integer, Integer, Text -> Text
  rt-to-plain-loop (runs) (i) (n) (acc) =
    if i >= n then acc
    else let run = list-at runs i
    in rt-to-plain-loop runs (i + 1) n (acc & run.tr-text)

Section: Formatting

  format-md-document : UiMdDocument -> Text
  format-md-document (doc) = "markdown blocks=" & show (doc.md-block-count)

  format-md-block : UiMdBlock -> Text
  format-md-block (block) = when block
    is UiMdParagraph (rt) -> "para"
    is UiMdHeading (level) (rt) -> "h" & show level
    is UiMdCodeBlock (lang) (content) -> "code(" & lang & ")"
    is UiMdBlockquote (rt) -> "quote"
    is UiMdListItem (rt) -> "li"
    is UiMdOrderedItem (num) (rt) -> "ol(" & show num & ")"
    is UiMdHRule -> "hr"
    is UiMdBlank -> "blank"

