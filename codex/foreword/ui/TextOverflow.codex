Chapter: TextOverflow

Section: The Behaviour

  TextOverflow =
    | OverflowClip
    | OverflowEllipsis
    | OverflowScroll

  text-overflow-default : TextOverflow
  text-overflow-default = OverflowClip

Section: Fitting

  text-fit-count : Integer, Integer, Integer -> Integer
  text-fit-count (avail) (advance) (glyph) =
    if advance <= 0 then 0
    else if avail < glyph then 0
    else (avail - glyph) / advance + 1

  text-ellipsis-glyphs : Integer
  text-ellipsis-glyphs = 3

  text-overflow-start : TextOverflow, Integer, Integer, Integer, Integer -> Integer
  text-overflow-start (mode) (len) (avail) (advance) (glyph) =
    let fits = text-fit-count avail advance glyph
    in if len <= fits then 0
    else when mode
      is OverflowClip -> 0
      is OverflowEllipsis -> 0
      is OverflowScroll -> len - fits

  text-overflow-count : TextOverflow, Integer, Integer, Integer, Integer -> Integer
  text-overflow-count (mode) (len) (avail) (advance) (glyph) =
    let fits = text-fit-count avail advance glyph
    in if len <= fits then len
    else when mode
      is OverflowClip -> fits
      is OverflowEllipsis -> if fits < text-ellipsis-glyphs + 1 then fits else fits - text-ellipsis-glyphs
      is OverflowScroll -> fits

  text-overflow-dots : TextOverflow, Integer, Integer, Integer, Integer -> Integer
  text-overflow-dots (mode) (len) (avail) (advance) (glyph) =
    let fits = text-fit-count avail advance glyph
    in if len <= fits then 0
    else when mode
      is OverflowClip -> 0
      is OverflowEllipsis -> if fits < text-ellipsis-glyphs + 1 then 0 else text-ellipsis-glyphs
      is OverflowScroll -> 0

Section: Names

  text-overflow-name : TextOverflow -> Text
  text-overflow-name (mode) = when mode
    is OverflowClip -> "clip"
    is OverflowEllipsis -> "ellipsis"
    is OverflowScroll -> "scroll"

