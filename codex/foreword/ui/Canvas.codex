Chapter: Canvas
  cites UI chapter BoxModel

 Viewport for pannable, zoomable canvas areas. Provides coordinate
 transforms between screen space and world space, grid snapping,
 and zoom with nonlinear steps.

Section: Types

  ViewPort = record {
    vp-pan-x : Integer,
    vp-pan-y : Integer,
    vp-zoom : Integer,
    vp-grid : Integer,
    vp-canvas-x : Integer,
    vp-canvas-y : Integer,
    vp-canvas-w : Integer,
    vp-canvas-h : Integer
  }

Section: Construction

  viewport-new : Integer, Integer, Integer, Integer -> ViewPort
  viewport-new (cx) (cy) (cw) (ch) = ViewPort {
    vp-pan-x = 0, vp-pan-y = 0,
    vp-zoom = 100, vp-grid = 20,
    vp-canvas-x = cx, vp-canvas-y = cy,
    vp-canvas-w = cw, vp-canvas-h = ch
  }

Section: Pan

  viewport-pan : ViewPort, Integer, Integer -> ViewPort
  viewport-pan (vp) (dx) (dy) = ViewPort {
    vp-pan-x = vp.vp-pan-x + dx, vp-pan-y = vp.vp-pan-y + dy,
    vp-zoom = vp.vp-zoom, vp-grid = vp.vp-grid,
    vp-canvas-x = vp.vp-canvas-x, vp-canvas-y = vp.vp-canvas-y,
    vp-canvas-w = vp.vp-canvas-w, vp-canvas-h = vp.vp-canvas-h
  }

Section: Zoom

  viewport-zoom-in : ViewPort -> ViewPort
  viewport-zoom-in (vp) =
    let nz = if vp.vp-zoom < 50 then vp.vp-zoom + 10
      else if vp.vp-zoom < 200 then vp.vp-zoom + 25
      else if vp.vp-zoom < 800 then vp.vp-zoom + 50
      else vp.vp-zoom
    in let clamped = if nz > 800 then 800 else nz
    in ViewPort {
      vp-pan-x = vp.vp-pan-x, vp-pan-y = vp.vp-pan-y,
      vp-zoom = clamped, vp-grid = vp.vp-grid,
      vp-canvas-x = vp.vp-canvas-x, vp-canvas-y = vp.vp-canvas-y,
      vp-canvas-w = vp.vp-canvas-w, vp-canvas-h = vp.vp-canvas-h
    }

  viewport-zoom-out : ViewPort -> ViewPort
  viewport-zoom-out (vp) =
    let nz = if vp.vp-zoom <= 25 then 10
      else if vp.vp-zoom <= 50 then vp.vp-zoom - 10
      else if vp.vp-zoom <= 200 then vp.vp-zoom - 25
      else vp.vp-zoom - 50
    in let clamped = if nz < 10 then 10 else nz
    in ViewPort {
      vp-pan-x = vp.vp-pan-x, vp-pan-y = vp.vp-pan-y,
      vp-zoom = clamped, vp-grid = vp.vp-grid,
      vp-canvas-x = vp.vp-canvas-x, vp-canvas-y = vp.vp-canvas-y,
      vp-canvas-w = vp.vp-canvas-w, vp-canvas-h = vp.vp-canvas-h
    }

  viewport-zoom-fit : ViewPort -> ViewPort
  viewport-zoom-fit (vp) = ViewPort {
    vp-pan-x = 0, vp-pan-y = 0,
    vp-zoom = 100, vp-grid = vp.vp-grid,
    vp-canvas-x = vp.vp-canvas-x, vp-canvas-y = vp.vp-canvas-y,
    vp-canvas-w = vp.vp-canvas-w, vp-canvas-h = vp.vp-canvas-h
  }

Section: Coordinate Transforms

  vp-screen-to-world-x : ViewPort, Integer -> Integer
  vp-screen-to-world-x (vp) (sx) =
    (sx - vp.vp-canvas-x - vp.vp-canvas-w / 2) * 100 / vp.vp-zoom - vp.vp-pan-x

  vp-screen-to-world-y : ViewPort, Integer -> Integer
  vp-screen-to-world-y (vp) (sy) =
    (sy - vp.vp-canvas-y - vp.vp-canvas-h / 2) * 100 / vp.vp-zoom - vp.vp-pan-y

  vp-world-to-screen-x : ViewPort, Integer -> Integer
  vp-world-to-screen-x (vp) (wx) =
    vp.vp-canvas-x + vp.vp-canvas-w / 2 + (wx + vp.vp-pan-x) * vp.vp-zoom / 100

  vp-world-to-screen-y : ViewPort, Integer -> Integer
  vp-world-to-screen-y (vp) (wy) =
    vp.vp-canvas-y + vp.vp-canvas-h / 2 + (wy + vp.vp-pan-y) * vp.vp-zoom / 100

Section: Grid Snap

  vp-snap-to-grid : Integer, Integer -> Integer
  vp-snap-to-grid (val) (grid) =
    if grid <= 0 then val
    else let half = grid / 2
    in let shifted = val + half
    in shifted - shifted + (shifted / grid) * grid

Section: Queries

  vp-contains : ViewPort, Integer, Integer -> Boolean
  vp-contains (vp) (sx) (sy) =
    if sx < vp.vp-canvas-x then False
    else if sx >= vp.vp-canvas-x + vp.vp-canvas-w then False
    else if sy < vp.vp-canvas-y then False
    else if sy >= vp.vp-canvas-y + vp.vp-canvas-h then False
    else True

  vp-set-canvas : ViewPort, Integer, Integer, Integer, Integer -> ViewPort
  vp-set-canvas (vp) (cx) (cy) (cw) (ch) = ViewPort {
    vp-pan-x = vp.vp-pan-x, vp-pan-y = vp.vp-pan-y,
    vp-zoom = vp.vp-zoom, vp-grid = vp.vp-grid,
    vp-canvas-x = cx, vp-canvas-y = cy,
    vp-canvas-w = cw, vp-canvas-h = ch
  }

