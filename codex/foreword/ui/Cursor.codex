    1,1,1,1,1,1,1,1]

Section: Rendering
  cursor-render : Framebuf, CursorState, Integer -> Framebuf
  cursor-render (fb) (c) (color) =
    if c.cur-visible then
      let ico = cursor-icon (c.cur-style)
      in icon-blit-keyed fb ico (c.cur-x - c.cur-hot-x) (c.cur-y - c.cur-hot-y) color
    else fb

Section: Queries
  cursor-style-name : CursorStyle -> Text
  cursor-style-name (s) = when s
    is CsArrow -> "arrow"
    is CsHand -> "hand"
    is CsBeam -> "beam"
    is CsCrosshair -> "crosshair"
    is CsResizeH -> "resize-h"
    is CsResizeV -> "resize-v"
    is CsMove -> "move"
    is CsWait -> "wait"
    is CsNone -> "none"

  format-cursor : CursorState -> Text
  format-cursor (c) = cursor-style-name (c.cur-style) & " (" & show (c.cur-x) & "," & show (c.cur-y) & ")"

