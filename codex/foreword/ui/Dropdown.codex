Chapter: Dropdown
  cites Foreword chapter StringUtils
  cites UI chapter Widget
  cites UI chapter Layout
  cites UI chapter KeyInput

Section: State

  DropdownState = record {
    dd-id : Text,
    dd-options : List Text,
    dd-option-count : Integer,
    dd-selected : Integer,
    dd-open : Boolean,
    dd-filter : Text,
    dd-highlight : Integer,
    dd-max-visible : Integer
  }

  dropdown-new : Text, List Text -> DropdownState
  dropdown-new (id) (options) = DropdownState {
    dd-id = id,
    dd-options = options,
    dd-option-count = list-length options,
    dd-selected = -1,
    dd-open = False,
    dd-filter = "",
    dd-highlight = 0,
    dd-max-visible = 8
  }

  dropdown-with-selected : Text, List Text, Integer -> DropdownState
  dropdown-with-selected (id) (options) (sel) = DropdownState {
    dd-id = id,
    dd-options = options,
    dd-option-count = list-length options,
    dd-selected = sel,
    dd-open = False,
    dd-filter = "",
    dd-highlight = sel,
    dd-max-visible = 8
  }

Section: Actions

  dropdown-toggle : DropdownState -> DropdownState
  dropdown-toggle (dd) =
    if dd.dd-open then __record-set (__record-set dd "dd-open" False) "dd-filter" ""
    else __record-set dd "dd-open" True

  dropdown-close : DropdownState -> DropdownState
  dropdown-close (dd) = __record-set (__record-set dd "dd-open" False) "dd-filter" ""

  dropdown-set-selected : DropdownState, Integer -> DropdownState
  dropdown-set-selected (dd) (idx) =
    __record-set (__record-set (__record-set dd "dd-selected" idx) "dd-open" False) "dd-filter" ""

  dropdown-set-filter : DropdownState, Text -> DropdownState
  dropdown-set-filter (dd) (f) =
    __record-set (__record-set dd "dd-filter" f) "dd-highlight" 0

  dropdown-nav-up : DropdownState -> DropdownState
  dropdown-nav-up (dd) =
    let h = dd.dd-highlight - 1
    in __record-set dd "dd-highlight" (if h < 0 then 0 else h)

  dropdown-nav-down : DropdownState -> DropdownState
  dropdown-nav-down (dd) =
    let visible = dd-visible-count dd
    in let h = dd.dd-highlight + 1
    in __record-set dd "dd-highlight" (if h >= visible then visible - 1 else h)

  dropdown-confirm : DropdownState -> DropdownState
  dropdown-confirm (dd) =
    let vis = dropdown-visible-options dd
    in let vis-count = list-length vis
    in if dd.dd-highlight < 0 then dropdown-close dd
    else if dd.dd-highlight >= vis-count then dropdown-close dd
    else let chosen = list-at vis (dd.dd-highlight)
    in let idx = dd-find-index (dd.dd-options) chosen 0 (dd.dd-option-count)
    in dropdown-set-selected dd idx

Section: Queries

  dropdown-selected-text : DropdownState -> Text
  dropdown-selected-text (dd) =
    if dd.dd-selected < 0 then ""
    else if dd.dd-selected >= dd.dd-option-count then ""
    else list-at (dd.dd-options) (dd.dd-selected)

  dropdown-visible-options : DropdownState -> List Text
  dropdown-visible-options (dd) =
    if text-length (dd.dd-filter) == 0 then dd-take-visible dd (dd.dd-options) (dd.dd-option-count)
    else dd-filter-options (dd.dd-options) (dd.dd-filter) 0 (dd.dd-option-count) [] (dd.dd-max-visible)

  dd-visible-count : DropdownState -> Integer
  dd-visible-count (dd) = list-length (dropdown-visible-options dd)

  dd-filter-options : List Text, Text, Integer, Integer, List Text, Integer -> List Text
  dd-filter-options (opts) (filter) (i) (n) (acc) (max-vis) =
    if i >= n then acc
    else if list-length acc >= max-vis then acc
    else let opt = list-at opts i
    in if text-contains opt filter then dd-filter-options opts filter (i + 1) n (list-push acc opt) max-vis
    else dd-filter-options opts filter (i + 1) n acc max-vis

  dd-take-visible : DropdownState, List Text, Integer -> List Text
  dd-take-visible (dd) (opts) (n) =
    if n <= dd.dd-max-visible then opts
    else dd-take-loop opts 0 (dd.dd-max-visible) []

  dd-take-loop : List Text, Integer, Integer, List Text -> List Text
  dd-take-loop (opts) (i) (n) (acc) =
    if i >= n then acc
    else dd-take-loop opts (i + 1) n (list-push acc (list-at opts i))

  dd-find-index : List Text, Text, Integer, Integer -> Integer
  dd-find-index (opts) (target) (i) (n) =
    if i >= n then -1
    else if list-at opts i == target then i
    else dd-find-index opts target (i + 1) n

Section: Widget Building

  dropdown-widget : DropdownState -> WidgetNode
  dropdown-widget (dd) =
    if dd.dd-open then dropdown-open-widget dd
    else dropdown-closed-widget dd

  dropdown-closed-widget : DropdownState -> WidgetNode
  dropdown-closed-widget (dd) =
    let sel = dropdown-selected-text dd
    in let label = if text-length sel == 0 then "-- select --" else sel
    in widget-button (dd.dd-id & "-trigger") (label & " v")

  dropdown-open-widget : DropdownState -> WidgetNode
  dropdown-open-widget (dd) =
    let filter-input = widget-input (dd.dd-id & "-filter") (dd.dd-filter) (text-length (dd.dd-filter))
    in let vis = dropdown-visible-options dd
    in let items = dd-option-widgets (dd.dd-id) vis (dd.dd-highlight) 0 (list-length vis) []
    in let item-panel = widget-panel (dd.dd-id & "-items") DirColumn 1 items
    in widget-panel (dd.dd-id & "-popup") DirColumn 2 [filter-input, item-panel]

  dd-option-widgets : Text, List Text, Integer, Integer, Integer, List WidgetNode -> List WidgetNode
  dd-option-widgets (id) (opts) (highlight) (i) (n) (acc) =
    if i >= n then acc
    else let opt = list-at opts i
    in let btn = widget-button (id & "-opt-" & show i) opt
    in let styled = if i == highlight then widget-set-state btn state-focused else btn
    in dd-option-widgets id opts highlight (i + 1) n (list-push acc styled)

Section: Keyboard Handling

 A key is what `UI chapter KeyInput` says it is: a character is its CCE
 code point and a named key is a constant at or above `key-named-base`.
 These arms tested 13, 32, 27, 38 and 40, which are ASCII control codes
 and Windows virtual key codes; read as CCE those numbers are ordinary
 letters. Under the contract the quire publishes, every one of them
 missed, so a dropdown could not be opened, walked, confirmed or closed
 from the keyboard at all. Space is `char-code ' '` rather than 32 for
 the same reason: the CCE space is 2.

 The filter is deliberately not fed from here. This handler translates
 navigation, and text entry is `UI chapter TextField`'s job; a caller
 wiring the search box drives `dropdown-set-filter` with what the user
 typed. That the filter box is rendered by `dropdown-open-widget` and
 reachable only that way is worth knowing before wiring one up.

  dropdown-handle-key : DropdownState, Integer -> DropdownState
  dropdown-handle-key (dd) (key) =
    if dd.dd-open then dd-handle-open-key dd key
    else if key == key-enter then dropdown-toggle dd
    else if key == char-code ' ' then dropdown-toggle dd
    else dd

  dd-handle-open-key : DropdownState, Integer -> DropdownState
  dd-handle-open-key (dd) (key) =
    if key == key-escape then dropdown-close dd
    else if key == key-enter then dropdown-confirm dd
    else if key == key-up then dropdown-nav-up dd
    else if key == key-down then dropdown-nav-down dd
    else dd

Section: Formatting

  format-dropdown : DropdownState -> Text
  format-dropdown (dd) =
    dd.dd-id & " sel=" & show (dd.dd-selected) & " open=" & if dd.dd-open then "true" else "false"

