Chapter: Theme

 Theming system for Codex UI. A Theme is pure data describing how
 every widget type looks in every state. Swap the theme record and
 the entire interface transforms — LCARS, cockpit, terminal, anything.

Section: Color Palette
  Palette = record {
    pal-bg : Integer between 0 and 16777215,
    pal-fg : Integer between 0 and 16777215,
    pal-primary : Integer between 0 and 16777215,
    pal-secondary : Integer between 0 and 16777215,
    pal-accent : Integer between 0 and 16777215,
    pal-muted : Integer between 0 and 16777215,
    pal-error : Integer between 0 and 16777215,
    pal-success : Integer between 0 and 16777215,
    pal-warning : Integer between 0 and 16777215,
    pal-border : Integer between 0 and 16777215
  }

Section: Border
  CornerStyle =
    | CornerSharp
    | CornerRound (Integer)
    | CornerBevel (Integer)

  BorderSide = record {
    brd-width : Integer between 0 and 64,
    brd-color : Integer between 0 and 16777215
  }

  Border = record {
    bdr-top : BorderSide,
    bdr-right : BorderSide,
    bdr-bottom : BorderSide,
    bdr-left : BorderSide,
    bdr-corner : CornerStyle
  }

Section: Edges
  Edges = record {
    edge-top : Integer between 0 and 1024,
    edge-right : Integer between 0 and 1024,
    edge-bottom : Integer between 0 and 1024,
    edge-left : Integer between 0 and 1024
  }

Section: Shadow
  Shadow = record {
    sh-offset-x : Integer between 0 and 64,
    sh-offset-y : Integer between 0 and 64,
    sh-blur : Integer between 0 and 32,
    sh-color : Integer between 0 and 16777215,
    sh-enabled : Boolean
  }

  shadow-none : Shadow
  shadow-none = Shadow { sh-offset-x = 0, sh-offset-y = 0, sh-blur = 0, sh-color = 0, sh-enabled = False }

  shadow-subtle : Integer -> Shadow
  shadow-subtle (color) = Shadow { sh-offset-x = 2, sh-offset-y = 2, sh-blur = 4, sh-color = __narrow color, sh-enabled = True }

  shadow-medium : Integer -> Shadow
  shadow-medium (color) = Shadow { sh-offset-x = 4, sh-offset-y = 4, sh-blur = 8, sh-color = __narrow color, sh-enabled = True }

Section: Gradient
  Gradient = record {
    gr-start-color : Integer between 0 and 16777215,
    gr-end-color : Integer between 0 and 16777215,
    gr-vertical : Boolean,
    gr-enabled : Boolean
  }

  gradient-none : Gradient
  gradient-none = Gradient { gr-start-color = 0, gr-end-color = 0, gr-vertical = True, gr-enabled = False }

  gradient-v : Integer, Integer -> Gradient
  gradient-v (start) (stop) = Gradient { gr-start-color = __narrow start, gr-end-color = __narrow stop, gr-vertical = True, gr-enabled = True }

  gradient-h : Integer, Integer -> Gradient
  gradient-h (start) (stop) = Gradient { gr-start-color = __narrow start, gr-end-color = __narrow stop, gr-vertical = False, gr-enabled = True }

Section: Accent Border
  AccentBorder = record {
    ab-side : Integer between 0 and 3,
    ab-width : Integer between 0 and 16,
    ab-color : Integer between 0 and 16777215,
    ab-enabled : Boolean
  }

  accent-border-none : AccentBorder
  accent-border-none = AccentBorder { ab-side = 0, ab-width = 0, ab-color = 0, ab-enabled = False }

  accent-border-top : Integer, Integer -> AccentBorder
  accent-border-top (width) (color) = AccentBorder { ab-side = 0, ab-width = __narrow width, ab-color = __narrow color, ab-enabled = True }

  accent-border-bottom : Integer, Integer -> AccentBorder
  accent-border-bottom (width) (color) = AccentBorder { ab-side = 2, ab-width = __narrow width, ab-color = __narrow color, ab-enabled = True }

  accent-border-left : Integer, Integer -> AccentBorder
  accent-border-left (width) (color) = AccentBorder { ab-side = 3, ab-width = __narrow width, ab-color = __narrow color, ab-enabled = True }

Section: Widget Style
  WidgetStyle = record {
    ws-bg : Integer between 0 and 16777215,
    ws-fg : Integer between 0 and 16777215,
    ws-border : Border,
    ws-padding : Edges,
    ws-margin : Edges,
    ws-min-width : Integer between 0 and 32767,
    ws-min-height : Integer between 0 and 32767,
    ws-shadow : Shadow,
    ws-gradient : Gradient,
    ws-accent-border : AccentBorder
  }

Section: State Map
  StateStyles = record {
    ss-normal : WidgetStyle,
    ss-hover : WidgetStyle,
    ss-pressed : WidgetStyle,
    ss-disabled : WidgetStyle,
    ss-focused : WidgetStyle
  }

Section: Theme
  Theme = record {
    th-name : Text,
    th-palette : Palette,
    th-panel : StateStyles,
    th-button : StateStyles,
    th-label : StateStyles,
    th-input : StateStyles,
    th-gauge : StateStyles,
    th-separator : StateStyles
  }

Section: Constructors
  edges-uniform : Integer -> Edges
  edges-uniform (v) = Edges { edge-top = __narrow v, edge-right = __narrow v, edge-bottom = __narrow v, edge-left = __narrow v }

  edges-zero : Edges
  edges-zero = Edges { edge-top = 0, edge-right = 0, edge-bottom = 0, edge-left = 0 }

  edges-xy : Integer, Integer -> Edges
  edges-xy (x) (y) = Edges { edge-top = __narrow y, edge-right = __narrow x, edge-bottom = __narrow y, edge-left = __narrow x }

  border-side : Integer, Integer -> BorderSide
  border-side (w) (c) = BorderSide { brd-width = __narrow w, brd-color = __narrow c }

  border-side-none : BorderSide
  border-side-none = BorderSide { brd-width = 0, brd-color = 0 }

  border-uniform : Integer, Integer, CornerStyle -> Border
  border-uniform (w) (c) (corner) =
    let side = border-side w c
    in Border { bdr-top = side, bdr-right = side, bdr-bottom = side, bdr-left = side, bdr-corner = corner }

  border-none : Border
  border-none = Border { bdr-top = border-side-none, bdr-right = border-side-none, bdr-bottom = border-side-none, bdr-left = border-side-none, bdr-corner = CornerSharp }

  widget-style : Integer, Integer, Border, Edges, Edges -> WidgetStyle
  widget-style (bg) (fg) (bdr) (pad) (mar) =
    WidgetStyle { ws-bg = __narrow bg, ws-fg = __narrow fg, ws-border = bdr, ws-padding = pad, ws-margin = mar, ws-min-width = 0, ws-min-height = 0, ws-shadow = shadow-none, ws-gradient = gradient-none, ws-accent-border = accent-border-none }

  widget-style-sized : Integer, Integer, Border, Edges, Edges, Integer, Integer -> WidgetStyle
  widget-style-sized (bg) (fg) (bdr) (pad) (mar) (minw) (minh) =
    WidgetStyle { ws-bg = __narrow bg, ws-fg = __narrow fg, ws-border = bdr, ws-padding = pad, ws-margin = mar, ws-min-width = __narrow minw, ws-min-height = __narrow minh, ws-shadow = shadow-none, ws-gradient = gradient-none, ws-accent-border = accent-border-none }

  widget-style-rich : Integer, Integer, Border, Edges, Edges, Shadow, Gradient, AccentBorder -> WidgetStyle
  widget-style-rich (bg) (fg) (bdr) (pad) (mar) (sh) (gr) (ab) =
    WidgetStyle { ws-bg = __narrow bg, ws-fg = __narrow fg, ws-border = bdr, ws-padding = pad, ws-margin = mar, ws-min-width = 0, ws-min-height = 0, ws-shadow = sh, ws-gradient = gr, ws-accent-border = ab }

  state-styles-flat : WidgetStyle -> StateStyles
  state-styles-flat (s) = StateStyles { ss-normal = s, ss-hover = s, ss-pressed = s, ss-disabled = s, ss-focused = s }

Section: Edge Arithmetic
  edges-h : Edges -> Integer
  edges-h (e) = e.edge-left + e.edge-right

  edges-v : Edges -> Integer
  edges-v (e) = e.edge-top + e.edge-bottom

