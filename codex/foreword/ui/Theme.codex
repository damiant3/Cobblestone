Section: Built-in Themes
  theme-terminal : Theme
  theme-terminal =
    let pal = palette-terminal
    in let bdr = border-uniform 1 (pal.pal-border) CornerSharp
    in let pad = edges-uniform 4
    in let mar = edges-uniform 2
    in let base = widget-style (pal.pal-bg) (pal.pal-fg) bdr pad mar
    in let btn = widget-style (pal.pal-primary) (pal.pal-bg) bdr pad mar
    in let btn-h = widget-style (pal.pal-accent) (pal.pal-bg) bdr pad mar
    in let btn-p = widget-style (pal.pal-secondary) (pal.pal-fg) bdr pad mar
    in let btn-d = widget-style (pal.pal-muted) (pal.pal-muted) bdr pad mar
    in let inp = widget-style (pal.pal-bg) (pal.pal-fg) (border-uniform 1 (pal.pal-muted) CornerSharp) pad mar
    in let inp-f = widget-style (pal.pal-bg) (pal.pal-fg) (border-uniform 2 (pal.pal-accent) CornerSharp) pad mar
    in let lbl = widget-style 0 (pal.pal-fg) border-none edges-zero mar
    in let sep = widget-style (pal.pal-border) (pal.pal-border) border-none edges-zero (edges-xy 0 4)
    in Theme {
      th-name = "terminal",
      th-palette = pal,
      th-panel = state-styles-flat base,
      th-button = StateStyles { ss-normal = btn, ss-hover = btn-h, ss-pressed = btn-p, ss-disabled = btn-d, ss-focused = btn-h },
      th-label = state-styles-flat lbl,
      th-input = StateStyles { ss-normal = inp, ss-hover = inp, ss-pressed = inp, ss-disabled = btn-d, ss-focused = inp-f },
      th-gauge = state-styles-flat (widget-style (pal.pal-bg) (pal.pal-primary) bdr (edges-uniform 2) mar),
      th-separator = state-styles-flat sep
    }

  theme-lcars : Theme
  theme-lcars =
    let pal = palette-lcars
    in let round = CornerRound 12
    in let bdr = border-uniform 2 (pal.pal-primary) round
    in let pad = edges-xy 16 8
    in let mar = edges-uniform 4
    in let base = widget-style (pal.pal-bg) (pal.pal-fg) (border-uniform 2 (pal.pal-primary) round) pad mar
    in let btn = widget-style-sized (pal.pal-primary) (pal.pal-bg) border-none pad mar 120 40
    in let btn-h = widget-style-sized (pal.pal-secondary) (pal.pal-bg) border-none pad mar 120 40
    in let btn-p = widget-style-sized (pal.pal-accent) (pal.pal-bg) border-none pad mar 120 40
    in let btn-d = widget-style-sized (pal.pal-muted) (pal.pal-muted) border-none pad mar 120 40
    in let inp = widget-style (pal.pal-bg) (pal.pal-fg) (border-uniform 2 (pal.pal-secondary) round) pad mar
    in let inp-f = widget-style (pal.pal-bg) (pal.pal-fg) (border-uniform 3 (pal.pal-accent) round) pad mar
    in let lbl = widget-style 0 (pal.pal-fg) border-none edges-zero mar
    in let sep = widget-style-sized (pal.pal-primary) (pal.pal-primary) border-none edges-zero (edges-xy 0 4) 0 6
    in Theme {
      th-name = "lcars",
      th-palette = pal,
      th-panel = state-styles-flat base,
      th-button = StateStyles { ss-normal = btn, ss-hover = btn-h, ss-pressed = btn-p, ss-disabled = btn-d, ss-focused = btn-h },
      th-label = state-styles-flat lbl,
      th-input = StateStyles { ss-normal = inp, ss-hover = inp, ss-pressed = inp, ss-disabled = btn-d, ss-focused = inp-f },
      th-gauge = state-styles-flat (widget-style (pal.pal-bg) (pal.pal-accent) (border-uniform 2 (pal.pal-secondary) round) (edges-uniform 2) mar),
      th-separator = state-styles-flat sep
    }

  theme-minimal : Theme
  theme-minimal =
    let pal = palette-minimal
    in let bdr = border-uniform 1 (pal.pal-border) CornerSharp
    in let pad = edges-xy 8 4
    in let mar = edges-uniform 2
    in let base = widget-style (pal.pal-bg) (pal.pal-fg) bdr pad mar
    in let btn = widget-style (pal.pal-bg) (pal.pal-primary) (border-uniform 1 (pal.pal-primary) CornerSharp) pad mar
    in let btn-h = widget-style (pal.pal-primary) (pal.pal-bg) (border-uniform 1 (pal.pal-primary) CornerSharp) pad mar
    in let btn-p = widget-style (pal.pal-accent) (pal.pal-bg) (border-uniform 1 (pal.pal-accent) CornerSharp) pad mar
    in let btn-d = widget-style (pal.pal-muted) (pal.pal-muted) (border-uniform 1 (pal.pal-muted) CornerSharp) pad mar
    in let inp = widget-style (pal.pal-bg) (pal.pal-fg) (border-uniform 1 (pal.pal-border) CornerSharp) pad mar
    in let inp-f = widget-style (pal.pal-bg) (pal.pal-fg) (border-uniform 2 (pal.pal-accent) CornerSharp) pad mar
    in let lbl = widget-style 0 (pal.pal-fg) border-none edges-zero mar
    in let sep = widget-style (pal.pal-border) (pal.pal-border) border-none edges-zero (edges-xy 0 4)
    in Theme {
      th-name = "minimal",
      th-palette = pal,
      th-panel = state-styles-flat base,
      th-button = StateStyles { ss-normal = btn, ss-hover = btn-h, ss-pressed = btn-p, ss-disabled = btn-d, ss-focused = btn-h },
      th-label = state-styles-flat lbl,
      th-input = StateStyles { ss-normal = inp, ss-hover = inp, ss-pressed = inp, ss-disabled = btn-d, ss-focused = inp-f },
      th-gauge = state-styles-flat (widget-style (pal.pal-bg) (pal.pal-primary) bdr (edges-uniform 2) mar),
      th-separator = state-styles-flat sep
    }

Section: Theme Queries
  theme-resolve-panel : Theme, Integer -> WidgetStyle
  theme-resolve-panel (th) (state) = resolve-state (th.th-panel) state

  theme-resolve-button : Theme, Integer -> WidgetStyle
  theme-resolve-button (th) (state) = resolve-state (th.th-button) state

  theme-resolve-label : Theme, Integer -> WidgetStyle
  theme-resolve-label (th) (state) = resolve-state (th.th-label) state

  theme-resolve-input : Theme, Integer -> WidgetStyle
  theme-resolve-input (th) (state) = resolve-state (th.th-input) state

  theme-resolve-gauge : Theme, Integer -> WidgetStyle
  theme-resolve-gauge (th) (state) = resolve-state (th.th-gauge) state

  theme-resolve-separator : Theme, Integer -> WidgetStyle
  theme-resolve-separator (th) (state) = resolve-state (th.th-separator) state

  resolve-state : StateStyles, Integer -> WidgetStyle
  resolve-state (ss) (state) =
    if state == 1 then ss.ss-hover
    else if state == 2 then ss.ss-pressed
    else if state == 3 then ss.ss-disabled
    else if state == 4 then ss.ss-focused
    else ss.ss-normal

Section: State Constants
  state-normal : Integer
  state-normal = 0

  state-hover : Integer
  state-hover = 1

  state-pressed : Integer
  state-pressed = 2

  state-disabled : Integer
  state-disabled = 3

  state-focused : Integer
  state-focused = 4

Section: Formatting
  fmt-bool : Boolean -> Text
  fmt-bool (b) = if b then "true" else "false"

