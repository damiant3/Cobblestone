Chapter: InputSource
  cites UI chapter Event
  cites UI chapter BoxModel

 Bare-metal input polling. Produces Event records that the
 Orchestrator can dispatch. The keyboard arrives in the kernel
 key-buffer cell (28680), written by the IRQ1 interrupt handler or
 by a USB HID pump; the cell is consumed with a single atomic
 exchange because a plain read-then-clear races the handler and
 loses the key. The pointer arrives one of two ways: on the bare
 runtime a driver folds relative reports into an absolute position
 and publishes it to the pointer mailbox cells below (magic word
 written last, so firmware residue cannot impersonate a pointer);
 without a publisher the legacy codex-vm ports 0xE1-0xE4 answer,
 guarded against the floating bus, where an absent device reads
 0xFF and every status bit lies.

 On the port fallback, 0xE1 (buttons) is a LEVEL -- it holds the
 current button mask and stays valid between events -- while 0xE4 is
 an EDGE: a new mouse event arrived, consumed by the 0xE3 read. So
 presence (0xE4 not floating 0xFF) gates the BUTTON read and
 freshness (0xE4 == 1) gates the POSITION reads only. Gating the
 button on the edge makes a held button legible for exactly one poll
 per host mouse message and read as released on every other poll --
 a press-and-hold becomes a millisecond pulse and no drag can ever
 be seen.

Section: Constants

  is-kb-addr : Integer = 28680

 The pointer mailbox: [0] magic "PTR1", [4] x, [8] y, [12] buttons
 (bit 0 left, bit 1 right, bit 2 middle). Published by the machine's
 pointer driver (GopUsbMouse on the Option A runtime).

  ptr-cells : Integer = 36736
  ptr-cells-magic : Integer = #31525450

Section: Types

  RawInput = record {
    ri-mx : Integer,
    ri-my : Integer,
    ri-left : Integer,
    ri-right : Integer,
    ri-middle : Integer,
    ri-key : Integer,
    ri-prev-mx : Integer,
    ri-prev-my : Integer,
    ri-prev-left : Integer,
    ri-prev-right : Integer,
    ri-prev-middle : Integer,
    ri-prev-key : Integer,
    ri-max-x : Integer,
    ri-max-y : Integer
  }

Section: Construction

  raw-input-new : Integer, Integer -> RawInput
  raw-input-new (w) (h) = RawInput {
    ri-mx = w / 2, ri-my = h / 2,
    ri-left = 0, ri-right = 0, ri-middle = 0, ri-key = 0,
    ri-prev-mx = w / 2, ri-prev-my = h / 2,
    ri-prev-left = 0, ri-prev-right = 0, ri-prev-middle = 0, ri-prev-key = 0,
    ri-max-x = w - 1, ri-max-y = h - 1
  }

Section: Polling

 No port-0x60 read here: with the keyboard interrupt handler live,
 polling the data port races the handler for the byte and one of
 them loses it. The cell is the only keyboard surface.

  raw-input-poll : RawInput -> [Device.Port] RawInput
  raw-input-poll (ri) = act
    sc <- ri-take-key
    mp <- ri-pointer-published
    e4 <- if mp == 1 then 255 else port-in-byte #E4
    btn <- if mp == 1 then peek-32 ptr-cells 12 else if e4 == 255 then 0 else port-in-byte #E1
    abs-x <- if mp == 1 then peek-32 ptr-cells 4 else if e4 == 1 then port-in-16 #E2 else ri.ri-mx
    abs-y <- if mp == 1 then peek-32 ptr-cells 8 else if e4 == 1 then port-in-16 #E3 else ri.ri-my
    ri-build ri sc btn abs-x abs-y
  end

  ri-take-key : Integer
  ri-take-key = bit-and (atomic-exchange is-kb-addr 0) 255

  ri-pointer-published : Integer
  ri-pointer-published = if peek-32 ptr-cells 0 == ptr-cells-magic then 1 else 0

  ri-mouse-flag : Integer -> Integer
  ri-mouse-flag (hm) = if hm == 0 then 0 else if hm == 255 then 0 else 1

  ri-build : RawInput, Integer, Integer, Integer, Integer -> RawInput
  ri-build (ri) (sc) (btn) (abs-x) (abs-y) =
    RawInput {
      ri-mx = ri-clamp abs-x 0 (ri.ri-max-x),
      ri-my = ri-clamp abs-y 0 (ri.ri-max-y),
      ri-left = if bit-and btn 1 > 0 then 1 else 0,
      ri-right = if bit-and btn 2 > 0 then 1 else 0,
      ri-middle = if bit-and btn 4 > 0 then 1 else 0,
      ri-key = sc,
      ri-prev-mx = ri.ri-mx, ri-prev-my = ri.ri-my,
      ri-prev-left = ri.ri-left, ri-prev-right = ri.ri-right,
      ri-prev-middle = ri.ri-middle, ri-prev-key = ri.ri-key,
      ri-max-x = ri.ri-max-x, ri-max-y = ri.ri-max-y
    }

Section: Event Generation

  ri-collect-events : RawInput, Integer -> List Event
  ri-collect-events (ri) (ts) =
    let acc = ri-mouse-move-events ri ts []
    in let acc2 = ri-mouse-btn-events ri ts acc
    in ri-key-events ri ts acc2

  ri-mouse-move-events : RawInput, Integer, List Event -> List Event
  ri-mouse-move-events (ri) (ts) (acc) =
    if ri.ri-mx == ri.ri-prev-mx then
      if ri.ri-my == ri.ri-prev-my then acc
      else list-push acc (event-mouse-move (ri.ri-mx) (ri.ri-my) ts)
    else list-push acc (event-mouse-move (ri.ri-mx) (ri.ri-my) ts)

  ri-mouse-btn-events : RawInput, Integer, List Event -> List Event
  ri-mouse-btn-events (ri) (ts) (acc) =
    let acc2 = ri-btn-edge acc ri.ri-left ri.ri-prev-left btn-left (ri.ri-mx) (ri.ri-my) ts
    in let acc3 = ri-btn-edge acc2 ri.ri-right ri.ri-prev-right btn-right (ri.ri-mx) (ri.ri-my) ts
    in ri-btn-edge acc3 ri.ri-middle ri.ri-prev-middle btn-middle (ri.ri-mx) (ri.ri-my) ts

  ri-btn-edge : List Event, Integer, Integer, Integer, Integer, Integer, Integer -> List Event
  ri-btn-edge (acc) (cur) (prev) (btn) (mx) (my) (ts) =
    if cur == 1 then
      if prev == 0 then list-push acc (event-mouse-down mx my btn ts)
      else acc
    else if prev == 1 then list-push acc (event-mouse-up mx my btn ts)
    else acc

  ri-key-events : RawInput, Integer, List Event -> List Event
  ri-key-events (ri) (ts) (acc) =
    let sc = ri.ri-key
    in if sc == 0 then acc
    else if sc >= 128 then list-push acc (event-key-up (sc - 128) mod-none ts)
    else if ri.ri-prev-key == 0 then list-push acc (event-key-down sc mod-none ts)
    else acc

Section: Helpers

  ri-clamp : Integer, Integer, Integer -> Integer
  ri-clamp (v) (lo) (hi) = if v < lo then lo else if v > hi then hi else v

  ri-dx : RawInput -> Integer
  ri-dx (ri) = ri.ri-mx - ri.ri-prev-mx

  ri-dy : RawInput -> Integer
  ri-dy (ri) = ri.ri-my - ri.ri-prev-my

  ri-left-down : RawInput -> Boolean
  ri-left-down (ri) = if ri.ri-left == 1 then if ri.ri-prev-left == 0 then True else False else False

  ri-left-up : RawInput -> Boolean
  ri-left-up (ri) = if ri.ri-left == 0 then if ri.ri-prev-left == 1 then True else False else False

  ri-right-down : RawInput -> Boolean
  ri-right-down (ri) = if ri.ri-right == 1 then if ri.ri-prev-right == 0 then True else False else False

  ri-middle-held : RawInput -> Boolean
  ri-middle-held (ri) = if ri.ri-middle == 1 then True else False

  ri-key-pressed : RawInput -> Integer
  ri-key-pressed (ri) =
    let sc = ri.ri-key
    in if sc > 0 then if sc < 128 then if ri.ri-prev-key == 0 then sc else 0 else 0 else 0

