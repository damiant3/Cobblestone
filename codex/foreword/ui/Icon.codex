Section: Icons 32x32 (scaled from 24x24)
  ico-close-32 : Icon
  ico-close-32 = icon-scale ico-close-24 32 32

  ico-check-32 : Icon
  ico-check-32 = icon-scale ico-check-24 32 32

  ico-gear-32 : Icon
  ico-gear-32 = icon-scale ico-gear-24 32 32

  ico-warning-32 : Icon
  ico-warning-32 = icon-scale ico-warning-24 32 32

Section: Legacy Aliases
  icon-close : Icon
  icon-close = ico-close-8

  icon-check : Icon
  icon-check = ico-check-8

  icon-arrow-right : Icon
  icon-arrow-right = ico-arrow-right-8

  icon-arrow-down : Icon
  icon-arrow-down = ico-arrow-down-8

