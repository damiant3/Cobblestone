  icon-set-12 : IconSet
  icon-set-12 =
    let is0 = icon-set-new
    in let is1 = icon-set-add is0 ico-close-12
    in let is2 = icon-set-add is1 ico-check-12
    in let is3 = icon-set-add is2 ico-arrow-right-12
    in let is4 = icon-set-add is3 ico-warning-12
    in let is5 = icon-set-add is4 ico-gear-12
    in icon-set-add is5 ico-lock-12

  icon-set-16 : IconSet
  icon-set-16 =
    let is0 = icon-set-new
    in let is1 = icon-set-add is0 ico-close-16
    in let is2 = icon-set-add is1 ico-check-16
    in let is3 = icon-set-add is2 ico-arrow-right-16
    in let is4 = icon-set-add is3 ico-warning-16
    in let is5 = icon-set-add is4 ico-gear-16
    in let is6 = icon-set-add is5 ico-lock-16
    in let is7 = icon-set-add is6 ico-home-16
    in let is8 = icon-set-add is7 ico-search-16
    in let is9 = icon-set-add is8 ico-star-16
    in icon-set-add is9 ico-power-16

  icon-set-24 : IconSet
  icon-set-24 =
    let is0 = icon-set-new
    in let is1 = icon-set-add is0 ico-close-24
    in let is2 = icon-set-add is1 ico-check-24
    in let is3 = icon-set-add is2 ico-gear-24
    in icon-set-add is3 ico-warning-24

  icon-set-all : IconSet
  icon-set-all =
    let s8 = ico-merge-sets icon-set-8 icon-set-12
    in let s16 = ico-merge-sets s8 icon-set-16
    in let s24 = ico-merge-sets s16 icon-set-24
    in let s32 = icon-set-add s24 ico-close-32
    in let s33 = icon-set-add s32 ico-check-32
    in let s34 = icon-set-add s33 ico-gear-32
    in icon-set-add s34 ico-warning-32

  ico-merge-sets : IconSet, IconSet -> IconSet
  ico-merge-sets (a) (b) = ico-merge-loop a (b.is-icons) 0 (b.is-count)

  ico-merge-loop : IconSet, List Icon, Integer, Integer -> IconSet
  ico-merge-loop (acc) (icons) (i) (n) =
    if i >= n then acc
    else ico-merge-loop (icon-set-add acc (list-at icons i)) icons (i + 1) n

Section: Formatting
  format-icon : Icon -> Text
  format-icon (ico) = ico.ico-name & " " & show (ico.ico-width) & "x" & show (ico.ico-height)

