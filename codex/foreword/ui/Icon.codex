  icon-gear : Icon
  icon-gear = ico-gear-8

Section: Standard Icon Sets
  icon-set-standard : IconSet
  icon-set-standard = icon-set-8

  icon-set-8 : IconSet
  icon-set-8 =
    let is0 = icon-set-new
    in let is1 = icon-set-add is0 ico-close-8
    in let is2 = icon-set-add is1 ico-check-8
    in let is3 = icon-set-add is2 ico-arrow-right-8
