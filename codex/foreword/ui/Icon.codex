Chapter: Icon
  cites Foreword chapter Maybe
  cites Foreword chapter MathLib
  cites Game chapter Rasterizer

 Bitmap icon system. Icons are fixed-size pixel grids stored as
 flat integer lists (1 = foreground, 0 = background). Standard
 icons ship at 8x8, 12x12, 16x16, 24x24, and 32x32. An IconSet
 provides named+sized lookup with nearest-size fallback. Icons
 render with foreground/background color override so the same
 icon works across any theme. Nearest-neighbor scaling lets you
 define once and resize on demand.

Section: Icon
  Icon = record {
    ico-name : Text,
    ico-width : Integer,
    ico-height : Integer,
    ico-pixels : List Integer
  }

Section: Icon Set
  IconSet = record {
    is-icons : List Icon,
    is-count : Integer
  }

Section: Construction
  icon-new : Text, Integer, Integer, List Integer -> Icon
  icon-new (name) (w) (h) (pixels) =
    Icon { ico-name = name, ico-width = w, ico-height = h, ico-pixels = pixels }

  icon-set-new : IconSet
  icon-set-new = IconSet { is-icons = [], is-count = 0 }

  icon-set-add : IconSet, Icon -> IconSet
  icon-set-add (iset) (ico) =
    IconSet { is-icons = list-push (iset.is-icons) ico, is-count = iset.is-count + 1 }

Section: Lookup
  icon-set-find : IconSet, Text -> Maybe Icon
  icon-set-find (iset) (name) = ico-find-loop (iset.is-icons) name 0 (iset.is-count)

  ico-find-loop : List Icon, Text, Integer, Integer -> Maybe Icon
  ico-find-loop (icons) (name) (i) (n) =
    if i >= n then None
    else let ico = list-at icons i
    in if ico.ico-name == name then Just ico
    else ico-find-loop icons name (i + 1) n

  icon-set-find-sized : IconSet, Text, Integer -> Maybe Icon
  icon-set-find-sized (iset) (name) (size) =
    ico-find-sized-loop (iset.is-icons) name size 0 (iset.is-count) None 99999

  ico-find-sized-loop : List Icon, Text, Integer, Integer, Integer, Maybe Icon, Integer -> Maybe Icon
  ico-find-sized-loop (icons) (name) (size) (i) (n) (best) (best-dist) =
    if i >= n then best
    else let ico = list-at icons i
    in if ico.ico-name == name then
      let dist = math-abs (ico.ico-width - size)
      in if dist == 0 then Just ico
      else if dist < best-dist then ico-find-sized-loop icons name size (i + 1) n (Just ico) dist
      else ico-find-sized-loop icons name size (i + 1) n best best-dist
    else ico-find-sized-loop icons name size (i + 1) n best best-dist

Section: Pixel Access
  icon-get : Icon, Integer, Integer -> Integer
  icon-get (ico) (x) (y) =
    if x < 0 then 0
    else if y < 0 then 0
    else if x >= ico.ico-width then 0
    else if y >= ico.ico-height then 0
    else list-at (ico.ico-pixels) (y * ico.ico-width + x)

Section: Scaling
  icon-scale : Icon, Integer, Integer -> Icon
  icon-scale (src) (tw) (th) =
    let pixels = ico-scale-build src tw th 0 0 []
    in Icon { ico-name = src.ico-name, ico-width = tw, ico-height = th, ico-pixels = pixels }

  ico-scale-build : Icon, Integer, Integer, Integer, Integer, List Integer -> List Integer
  ico-scale-build (src) (tw) (th) (tx) (ty) (acc) =
    if ty >= th then acc
    else if tx >= tw then ico-scale-build src tw th 0 (ty + 1) acc
    else let sx = tx * src.ico-width / tw
    in let sy = ty * src.ico-height / th
    in let pixel = icon-get src sx sy
    in ico-scale-build src tw th (tx + 1) ty (list-push acc pixel)

Section: Rendering
  icon-blit : Framebuf, Icon, Integer, Integer, Integer, Integer -> Framebuf
  icon-blit (fb) (ico) (dx) (dy) (fg) (bg) =
    ico-blit-loop fb ico dx dy fg bg 0 0

  ico-blit-loop : Framebuf, Icon, Integer, Integer, Integer, Integer, Integer, Integer -> Framebuf
  ico-blit-loop (fb) (ico) (dx) (dy) (fg) (bg) (sx) (sy) =
    if sy >= ico.ico-height then fb
    else if sx >= ico.ico-width then ico-blit-loop fb ico dx dy fg bg 0 (sy + 1)
    else let pixel = icon-get ico sx sy
    in let color = if pixel > 0 then fg else bg
    in let fb2 = if bg == 0 then
        if pixel > 0 then fb-set fb (dx + sx) (dy + sy) fg else fb
      else fb-set fb (dx + sx) (dy + sy) color
    in ico-blit-loop fb2 ico dx dy fg bg (sx + 1) sy

  icon-blit-keyed : Framebuf, Icon, Integer, Integer, Integer -> Framebuf
  icon-blit-keyed (fb) (ico) (dx) (dy) (fg) =
    ico-blit-key-loop fb ico dx dy fg 0 0

  ico-blit-key-loop : Framebuf, Icon, Integer, Integer, Integer, Integer, Integer -> Framebuf
  ico-blit-key-loop (fb) (ico) (dx) (dy) (fg) (sx) (sy) =
    if sy >= ico.ico-height then fb
    else if sx >= ico.ico-width then ico-blit-key-loop fb ico dx dy fg 0 (sy + 1)
    else let pixel = icon-get ico sx sy
    in let fb2 = if pixel > 0 then fb-set fb (dx + sx) (dy + sy) fg else fb
    in ico-blit-key-loop fb2 ico dx dy fg (sx + 1) sy

  icon-blit-scaled : Framebuf, Icon, Integer, Integer, Integer, Integer, Integer -> Framebuf
  icon-blit-scaled (fb) (ico) (dx) (dy) (size) (fg) (bg) =
    let scaled = icon-scale ico size size
    in icon-blit fb scaled dx dy fg bg

