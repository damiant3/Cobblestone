Chapter: Vector
  cites Foreword chapter Maybe
  cites Foreword chapter MathLib
  cites Math chapter Cordic
  cites UI chapter GlyphRasterizer

 Vector graphics primitives -- paths, line segments, bezier curves,
 arcs, fills, and strokes. A vector path is a list of path commands
 that can be rasterized to pixels or exported as SVG-like output.
 Uses fixed-point scale-1000 arithmetic for coordinates.

 We say:

Section: Types

  PathCmd =
    | PcMoveTo (Integer) (Integer)
    | PcLineTo (Integer) (Integer)
    | PcBezierTo (Integer) (Integer) (Integer) (Integer) (Integer) (Integer)
    | PcArcTo (Integer) (Integer) (Integer) (Integer) (Integer)
    | PcClose

  VecPath = record {
    vp-commands : List PathCmd,
    vp-count : Integer
  }

  VecStyle = record {
    vs-stroke-color : Integer between 0 and 16777215,
    vs-fill-color : Integer between 0 and 16777215,
    vs-stroke-width : Integer between 0 and 1000,
    vs-filled : Boolean,
    vs-stroked : Boolean
  }

  VecPixel = record {
    vpx-x : Integer,
    vpx-y : Integer,
    vpx-color : Integer
  }

Section: Construction

  vec-path-new : VecPath
  vec-path-new = VecPath { vp-commands = [], vp-count = 0 }

  vec-move-to : VecPath, Integer, Integer -> VecPath
  vec-move-to (p) (x) (y) = VecPath {
    vp-commands = list-push (p.vp-commands) (PcMoveTo x y),
    vp-count = p.vp-count + 1
  }

  vec-line-to : VecPath, Integer, Integer -> VecPath
  vec-line-to (p) (x) (y) = VecPath {
    vp-commands = list-push (p.vp-commands) (PcLineTo x y),
    vp-count = p.vp-count + 1
  }

  vec-bezier-to : VecPath, Integer, Integer, Integer, Integer, Integer, Integer -> VecPath
  vec-bezier-to (p) (cx1) (cy1) (cx2) (cy2) (x) (y) = VecPath {
    vp-commands = list-push (p.vp-commands) (PcBezierTo cx1 cy1 cx2 cy2 x y),
    vp-count = p.vp-count + 1
  }

  vec-arc-to : VecPath, Integer, Integer, Integer, Integer, Integer -> VecPath
  vec-arc-to (p) (cx) (cy) (rx) (ry) (angle) = VecPath {
    vp-commands = list-push (p.vp-commands) (PcArcTo cx cy rx ry angle),
    vp-count = p.vp-count + 1
  }

  vec-close : VecPath -> VecPath
  vec-close (p) = VecPath {
    vp-commands = list-push (p.vp-commands) PcClose,
    vp-count = p.vp-count + 1
  }

Section: Style

  vec-style-default : VecStyle = VecStyle {
    vs-stroke-color = 0,
    vs-fill-color = 0,
    vs-stroke-width = 1000,
    vs-filled = False,
    vs-stroked = True
  }

  vec-style-fill : Integer -> VecStyle
  vec-style-fill (color) = VecStyle {
    vs-stroke-color = 0,
    vs-fill-color = __narrow color,
    vs-stroke-width = 0,
    vs-filled = True,
    vs-stroked = False
  }

  vec-style-stroke : Integer, Integer -> VecStyle
  vec-style-stroke (color) (width) = VecStyle {
    vs-stroke-color = __narrow color,
    vs-fill-color = 0,
    vs-stroke-width = __narrow width,
    vs-filled = False,
    vs-stroked = True
  }

Section: Shapes

  vec-rect : Integer, Integer, Integer, Integer -> VecPath
  vec-rect (x) (y) (w) (h) =
    let p = vec-move-to vec-path-new x y
    in let p2 = vec-line-to p (x + w) y
    in let p3 = vec-line-to p2 (x + w) (y + h)
    in let p4 = vec-line-to p3 x (y + h)
    in vec-close p4

  vec-circle : Integer, Integer, Integer, Integer -> VecPath
  vec-circle (cx) (cy) (r) (segments) =
    vec-circle-loop vec-path-new cx cy r segments 0 True

  vec-circle-loop : VecPath, Integer, Integer, Integer, Integer, Integer, Boolean -> VecPath
  vec-circle-loop (p) (cx) (cy) (r) (segments) (i) (first) =
    if i > segments then vec-close p
    else let angle = i * 6283 / segments
    in let px = cx + r * cordic-cos angle / 1000
    in let py = cy + r * cordic-sin angle / 1000
    in if first then vec-circle-loop (vec-move-to p px py) cx cy r segments (i + 1) False
    else vec-circle-loop (vec-line-to p px py) cx cy r segments (i + 1) False

  vec-line : Integer, Integer, Integer, Integer -> VecPath
  vec-line (x1) (y1) (x2) (y2) =
    vec-line-to (vec-move-to vec-path-new x1 y1) x2 y2

Section: Rasterization (Bresenham Line)

  vec-rasterize : VecPath, VecStyle -> List VecPixel
  vec-rasterize (path) (style) =
    vec-stroke-edges (vec-edges path 1) 0 (style.vs-stroke-color) []

  vec-stroke-edges : List Edge, Integer, Integer, List VecPixel -> List VecPixel
  vec-stroke-edges (es) (i) (color) (acc) =
    if i >= list-length es then acc
    else let e = list-at es i
    in vec-stroke-edges es (i + 1) color (acc & bresenham (e.e-x0) (e.e-y0) (e.e-x1) (e.e-y1) color [])

  bresenham : Integer, Integer, Integer, Integer, Integer, List VecPixel -> List VecPixel
  bresenham (x0) (y0) (x1) (y1) (color) (acc) =
    let dx = if x1 > x0 then x1 - x0 else x0 - x1
    in let dy = if y1 > y0 then y1 - y0 else y0 - y1
    in let sx = if x0 < x1 then 1 else 0 - 1
    in let sy = if y0 < y1 then 1 else 0 - 1
    in bresenham-loop x0 y0 x1 y1 dx dy sx sy (dx - dy) color acc

  bresenham-loop : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, List VecPixel -> List VecPixel
  bresenham-loop (x) (y) (x1) (y1) (dx) (dy) (sx) (sy) (err) (color) (acc) =
    let acc2 = list-push acc (VecPixel { vpx-x = x, vpx-y = y, vpx-color = color })
    in if x == x1 then if y == y1 then acc2
      else bresenham-step x y x1 y1 dx dy sx sy err color acc2
    else bresenham-step x y x1 y1 dx dy sx sy err color acc2

  bresenham-step : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, List VecPixel -> List VecPixel
  bresenham-step (x) (y) (x1) (y1) (dx) (dy) (sx) (sy) (err) (color) (acc) =
    let e2 = err * 2
    in let x2 = if e2 > 0 - dy then x + sx else x
    in let y2 = if e2 < dx then y + sy else y
    in let err2 = err + (if e2 > 0 - dy then 0 - dy else 0) + (if e2 < dx then dx else 0)
    in bresenham-loop x2 y2 x1 y1 dx dy sx sy err2 color acc

Section: Coverage

 A path could only be stroked. `vs-filled` and `vs-fill-color` were set by
 `vec-style-fill` and read by nothing, `PcBezierTo` and `PcArcTo` fell to the
 `otherwise` arm of the rasterizer and never produced a pixel, and `VecPixel`
 carries a colour with no coverage, so an outline came out as a staircase.

 `GlyphRasterizer` has done coverage-based filling since it was written, for
 glyphs. Its `Edge` is a plain segment record and `gr-render-edges` is a
 scanline fill over a list of them, so a path reaches it by being flattened
 into edges rather than by a second rasterizer being written.

 The edge space is SIXTY-FOURTHS OF A SUPERSAMPLED PIXEL, which is what
 `gr-scale-pts` produces for a glyph and what `gr-scanline-loop` samples at
 `y * 64 + 32`. Coordinates are scaled once on the way in, so every
 subdivision below happens with that precision under it rather than rounding
 to whole path units.

 `gr-fill-scanline` pairs its intersections and fills between them, which is
 the EVEN-ODD rule; its `winding` counter is incremented and never returns to
 zero, so the non-zero arm its chapter header names is unreachable. That is
 the same rule every glyph on the screen is already filled by. It is recorded
 here rather than changed, because changing it moves every glyph.

  vec-super : Integer = 4
  vec-sub : Integer = 64

  vec-abs : Integer -> Integer
  vec-abs (v) = if v < 0 then 0 - v else v

  vec-min : Integer, Integer -> Integer
  vec-min (a) (b) = if a < b then a else b

  vec-max : Integer, Integer -> Integer
  vec-max (a) (b) = if a > b then a else b

  vec-seg : List Edge, Integer, Integer, Integer, Integer -> List Edge
  vec-seg (acc) (x0) (y0) (x1) (y1) =
    list-push acc (Edge { e-x0 = x0, e-y0 = y0, e-x1 = x1, e-y1 = y1 })

  vec-cubic : List Edge, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> List Edge
  vec-cubic (acc) (k) (x0) (y0) (x1) (y1) (x2) (y2) (x3) (y3) (depth) =
    let flat = vec-abs (x0 + x3 - x1 - x2) + vec-abs (y0 + y3 - y1 - y2)
    in if depth >= 8 then vec-seg acc x0 y0 x3 y3
    else if flat <= k then vec-seg acc x0 y0 x3 y3
    else let ax = (x0 + x1) / 2
    in let ay = (y0 + y1) / 2
    in let bx = (x1 + x2) / 2
    in let by = (y1 + y2) / 2
    in let cx = (x2 + x3) / 2
    in let cy = (y2 + y3) / 2
    in let dx = (ax + bx) / 2
    in let dy = (ay + by) / 2
    in let ex = (bx + cx) / 2
    in let ey = (by + cy) / 2
    in let mx = (dx + ex) / 2
    in let my = (dy + ey) / 2
    in let left = vec-cubic acc k x0 y0 ax ay dx dy mx my (depth + 1)
    in vec-cubic left k mx my ex ey cx cy x3 y3 (depth + 1)

 An arc sweeps `angle` from where the path already is, about the centre it
 names, so its start is the current point's own bearing and needs no separate
 field. Sixteen segments to the half turn is the same density `vec-circle`
 chose.

  vec-arc-steps : Integer -> Integer
  vec-arc-steps (angle) = 1 + vec-abs angle * 16 / cordic-pi

  vec-arc-x : Integer, Integer, Integer -> Integer
  vec-arc-x (cx) (rx) (a) = cx + rx * cordic-cos a / cordic-scale

  vec-arc-y : Integer, Integer, Integer -> Integer
  vec-arc-y (cy) (ry) (a) = cy + ry * cordic-sin a / cordic-scale

  vec-arc-edges : List Edge, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> List Edge
  vec-arc-edges (acc) (cx) (cy) (rx) (ry) (a0) (sweep) (n) (i) (px) (py) =
    if i > n then acc
    else let a = a0 + sweep * i / n
    in let x = vec-arc-x cx rx a
    in let y = vec-arc-y cy ry a
    in vec-arc-edges (vec-seg acc px py x y) cx cy rx ry a0 sweep n (i + 1) x y

  vec-arc-start : Integer, Integer, Integer, Integer -> Integer
  vec-arc-start (cx) (cy) (px) (py) = (cordic-atan2 (py - cy) (px - cx)).angle

  vec-edges : VecPath, Integer -> List Edge
  vec-edges (p) (k) = vec-edge-cmds (p.vp-commands) 0 (p.vp-count) k 0 0 0 0 []

  vec-edge-cmds : List PathCmd, Integer, Integer, Integer, Integer, Integer, Integer, Integer, List Edge -> List Edge
  vec-edge-cmds (cmds) (i) (len) (k) (cx) (cy) (sx) (sy) (acc) =
    if i >= len then acc
    else let cmd = list-at cmds i
    in when cmd
      is PcMoveTo (x) (y) -> vec-edge-cmds cmds (i + 1) len k (x * k) (y * k) (x * k) (y * k) acc
      is PcLineTo (x) (y) -> vec-edge-cmds cmds (i + 1) len k (x * k) (y * k) sx sy (vec-seg acc cx cy (x * k) (y * k))
      is PcBezierTo (c1x) (c1y) (c2x) (c2y) (x) (y) ->
        vec-edge-cmds cmds (i + 1) len k (x * k) (y * k) sx sy (vec-cubic acc k cx cy (c1x * k) (c1y * k) (c2x * k) (c2y * k) (x * k) (y * k) 0)
      is PcArcTo (ax) (ay) (rx) (ry) (ang) ->
        let a0 = vec-arc-start (ax * k) (ay * k) cx cy
        in let n = vec-arc-steps ang
        in let ex = vec-arc-x (ax * k) (rx * k) (a0 + ang)
        in let ey = vec-arc-y (ay * k) (ry * k) (a0 + ang)
        in vec-edge-cmds cmds (i + 1) len k ex ey sx sy (vec-arc-edges acc (ax * k) (ay * k) (rx * k) (ry * k) a0 ang n 1 cx cy)
      is PcClose -> vec-edge-cmds cmds (i + 1) len k sx sy sx sy (vec-seg acc cx cy sx sy)

  vec-coverage : VecPath, Integer, Integer -> List Integer
  vec-coverage (p) (w) (h) =
    let sw = w * vec-super
    in let sh = h * vec-super
    in let edges = vec-edges p (vec-super * vec-sub)
    in gr-downsample-4x (gr-render-edges edges sw sh 0 sh) sw sh w h

 A path has no size of its own, so the grid it is rasterized into is a CROP
 of its own coordinates unless something maps one onto the other.
 `vec-coverage` crops, which is what a caller working in pixel coordinates
 asks for. Artwork is drawn in a box of its own and wants the box mapped onto
 the grid instead, so the ratio multiplies into the same factor `vec-edges`
 already applies and the flatness test underneath still means one unit of the
 box.

  vec-coverage-in : VecPath, Integer, Integer -> List Integer
  vec-coverage-in (p) (em) (n) =
    if em <= 0 then vec-coverage p n n
    else let sw = n * vec-super
    in let edges = vec-edges p (vec-super * vec-sub * n / em)
    in gr-downsample-4x (gr-render-edges edges sw sw 0 sw) sw sw n n

  vec-coverage-at : List Integer, Integer, Integer, Integer -> Integer
  vec-coverage-at (cov) (w) (x) (y) = list-at cov (y * w + x)

Section: Stroke Coverage

 A stroke is a FILLED region, so an antialiased one is the coverage the fill
 already produces rather than a second rasterizer. Each segment becomes a
 quad, extended by half a width along its own axis at both ends so a join is
 covered without a miter calculation and a cap has square ends.

 THE QUADS ARE RENDERED ONE AT A TIME AND MERGED BY MAXIMUM, and that is the
 whole reason this is not one edge list handed to `gr-render-edges` once.
 `gr-fill-scanline` pairs its intersections, which is the even-odd rule, so
 two overlapping quads CANCEL: a single edge list punches a hole at every
 join, at every cap that meets another, and wherever a path crosses itself.
 Merging by maximum is what makes ink stay ink.

 Each quad is rendered over ONLY the rows it spans, and `gr-render-edges`
 allocates `width * height` on every call, so the buffer is the band rather
 than the grid. There is no collector: a per-quad full grid would stay
 resident for the whole paint, which for a twenty segment icon is twenty
 copies of the supersampled surface.

 The width is in PATH UNITS, the same units as the coordinates. `VecStyle`'s
 `vs-stroke-width` is not read here: it is capped at 1000 and its scale was
 never settled, and a caller that has a width in that convention converts at
 its own boundary rather than having a guess about it baked in.

  vec-half-w : Integer, Integer -> Integer
  vec-half-w (width) (k) = width * k / 2

  vec-quad : Integer, Integer, Integer, Integer, Integer -> List Edge
  vec-quad (x0) (y0) (x1) (y1) (hw) =
    let ex = x1 - x0
    in let ey = y1 - y0
    in let len = math-isqrt (ex * ex + ey * ey)
    in if len <= 0 then []
    else let ux = ex * hw / len
    in let uy = ey * hw / len
    in let nx = 0 - uy
    in let ny = ux
    in let ax = x0 - ux + nx
    in let ay = y0 - uy + ny
    in let bx = x1 + ux + nx
    in let by = y1 + uy + ny
    in let cx = x1 + ux - nx
    in let cy = y1 + uy - ny
    in let dx = x0 - ux - nx
    in let dy = y0 - uy - ny
    in vec-seg (vec-seg (vec-seg (vec-seg [] ax ay bx by) bx by cx cy) cx cy dx dy) dx dy ax ay

  vec-edges-min-y : List Edge, Integer, Integer, Integer -> Integer
  vec-edges-min-y (es) (i) (n) (m) =
    if i >= n then m
    else let e = list-at es i
    in vec-edges-min-y es (i + 1) n (vec-min m (vec-min (e.e-y0) (e.e-y1)))

  vec-edges-max-y : List Edge, Integer, Integer, Integer -> Integer
  vec-edges-max-y (es) (i) (n) (m) =
    if i >= n then m
    else let e = list-at es i
    in vec-edges-max-y es (i + 1) n (vec-max m (vec-max (e.e-y0) (e.e-y1)))

  vec-cov-max : List Integer, List Integer, Integer, Integer, Integer, Integer -> List Integer
  vec-cov-max (acc) (band) (sw) (row0) (n) (i) =
    if i >= n then acc
    else let v = list-at band i
    in if v <= 0 then vec-cov-max acc band sw row0 n (i + 1)
    else let idx = row0 * sw + i
    in if v <= list-at acc idx then vec-cov-max acc band sw row0 n (i + 1)
    else vec-cov-max (list-set-at acc idx v) band sw row0 n (i + 1)

  vec-stroke-seg : List Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> List Integer
  vec-stroke-seg (acc) (sw) (sh) (x0) (y0) (x1) (y1) (hw) =
    let q = vec-quad x0 y0 x1 y1 hw
    in if list-length q == 0 then acc
    else let lo0 = vec-edges-min-y q 0 (list-length q) 999999999 / vec-sub
    in let hi0 = vec-edges-max-y q 0 (list-length q) (0 - 999999999) / vec-sub + 1
    in let lo = vec-max 0 lo0
    in let hi = vec-min sh hi0
    in if hi <= lo then acc
    else vec-cov-max acc (gr-render-edges q sw (hi - lo) lo hi) sw lo (sw * (hi - lo)) 0

  vec-stroke-loop : List Integer, List Edge, Integer, Integer, Integer, Integer, Integer -> List Integer
  vec-stroke-loop (acc) (es) (i) (n) (sw) (sh) (hw) =
    if i >= n then acc
    else let e = list-at es i
    in vec-stroke-loop (vec-stroke-seg acc sw sh (e.e-x0) (e.e-y0) (e.e-x1) (e.e-y1) hw) es (i + 1) n sw sh hw

  vec-stroke-cov-k : VecPath, Integer, Integer, Integer, Integer, Integer, Integer -> List Integer
  vec-stroke-cov-k (p) (sw) (sh) (w) (h) (hw) (k) =
    let es = vec-edges p k
    in let acc = gr-make-row (sw * sh) 0
    in gr-downsample-4x (vec-stroke-loop acc es 0 (list-length es) sw sh hw) sw sh w h

  vec-stroke-coverage : VecPath, Integer, Integer, Integer -> List Integer
  vec-stroke-coverage (p) (w) (h) (width) =
    let k = vec-super * vec-sub
    in vec-stroke-cov-k p (w * vec-super) (h * vec-super) w h (vec-half-w width k) k

 The em-mapped form, matching `vec-coverage-in`: artwork authored in a box of
 its own is scaled onto the grid, and the width scales with it.

  vec-stroke-coverage-in : VecPath, Integer, Integer, Integer -> List Integer
  vec-stroke-coverage-in (p) (em) (n) (width) =
    if em <= 0 then vec-stroke-coverage p n n width
    else let k = vec-super * vec-sub * n / em
    in vec-stroke-cov-k p (n * vec-super) (n * vec-super) n n (vec-half-w width k) k

Section: Queries

  vec-path-length : VecPath -> Integer
  vec-path-length (p) = p.vp-count

  vec-bounds : VecPath -> List Integer
  vec-bounds (p) =
    let es = vec-edges p 1
    in if list-length es == 0 then vec-bounds-cmds (p.vp-commands) 0 (p.vp-count) 999999 999999 (0 - 999999) (0 - 999999)
    else vec-bounds-loop es 0 (list-length es) 999999 999999 (0 - 999999) (0 - 999999)

  vec-bounds-loop : List Edge, Integer, Integer, Integer, Integer, Integer, Integer -> List Integer
  vec-bounds-loop (es) (i) (len) (min-x) (min-y) (max-x) (max-y) =
    if i >= len then [min-x, min-y, max-x, max-y]
    else let e = list-at es i
    in let nx = vec-min min-x (vec-min (e.e-x0) (e.e-x1))
    in let ny = vec-min min-y (vec-min (e.e-y0) (e.e-y1))
    in let xx = vec-max max-x (vec-max (e.e-x0) (e.e-x1))
    in let xy = vec-max max-y (vec-max (e.e-y0) (e.e-y1))
    in vec-bounds-loop es (i + 1) len nx ny xx xy

  vec-bounds-cmds : List PathCmd, Integer, Integer, Integer, Integer, Integer, Integer -> List Integer
  vec-bounds-cmds (cmds) (i) (len) (min-x) (min-y) (max-x) (max-y) =
    if i >= len then [min-x, min-y, max-x, max-y]
    else let cmd = list-at cmds i
    in when cmd
      is PcMoveTo (x) (y) -> vec-bounds-cmds cmds (i + 1) len (vec-min min-x x) (vec-min min-y y) (vec-max max-x x) (vec-max max-y y)
      is otherwise -> vec-bounds-cmds cmds (i + 1) len min-x min-y max-x max-y

