  app-update-binding : AppState, Text, Integer -> AppState
  app-update-binding (app) (obs-id) (value) =
    AppState {
      app-root = app.app-root, app-theme = app.app-theme,
      app-compositor = app.app-compositor, app-overlays = app.app-overlays,
      app-bindings = bt-set (app.app-bindings) obs-id value,
      app-animations = app.app-animations,
      app-sounds = app.app-sounds, app-handlers = app.app-handlers,
