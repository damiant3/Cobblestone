      app-bindings = app.app-bindings,
      app-animations = anim-set-tick (app.app-animations) dt,
      app-sounds = app.app-sounds, app-handlers = app.app-handlers,
      app-timers = app.app-timers, app-timer-count = app.app-timer-count,
      app-focused = app.app-focused, app-hovered = app.app-hovered,
      app-dirty = app.app-dirty, app-frame = app.app-frame, app-time = app.app-time
    }

Section: Overlay Tick
  orch-tick-overlays : AppState, Integer -> AppState
  orch-tick-overlays (app) (dt) =
    AppState {
      app-root = app.app-root, app-theme = app.app-theme,
      app-compositor = app.app-compositor,
      app-overlays = overlay-stack-tick (app.app-overlays) dt,
      app-bindings = app.app-bindings, app-animations = app.app-animations,
      app-sounds = app.app-sounds, app-handlers = app.app-handlers,
      app-timers = app.app-timers, app-timer-count = app.app-timer-count,
      app-focused = app.app-focused, app-hovered = app.app-hovered,
      app-dirty = app.app-dirty, app-frame = app.app-frame, app-time = app.app-time
    }

Section: Binding Application
  orch-apply-bindings : AppState -> AppState
  orch-apply-bindings (app) =
    let cleaned = bt-clean (app.app-bindings)
    in AppState {
      app-root = app.app-root, app-theme = app.app-theme,
      app-compositor = app.app-compositor, app-overlays = app.app-overlays,
      app-bindings = cleaned, app-animations = app.app-animations,
      app-sounds = app.app-sounds, app-handlers = app.app-handlers,
      app-timers = app.app-timers, app-timer-count = app.app-timer-count,
      app-focused = app.app-focused, app-hovered = app.app-hovered,
      app-dirty = app.app-dirty, app-frame = app.app-frame, app-time = app.app-time
    }

Section: Re-layout
  orch-relayout : AppState -> AppState
  orch-relayout (app) =
    if app.app-dirty then
      let container = layout-rect 0 0 (app.app-compositor).comp-width (app.app-compositor).comp-height
      in let laid-out = widget-layout (app.app-root) (app.app-theme) container
      in AppState {
        app-root = laid-out, app-theme = app.app-theme,
        app-compositor = app.app-compositor, app-overlays = app.app-overlays,
        app-bindings = app.app-bindings, app-animations = app.app-animations,
        app-sounds = app.app-sounds, app-handlers = app.app-handlers,
        app-timers = app.app-timers, app-timer-count = app.app-timer-count,
        app-focused = app.app-focused, app-hovered = app.app-hovered,
        app-dirty = False, app-frame = app.app-frame, app-time = app.app-time
      }
    else app

Section: Frame Advance
  orch-advance-frame : AppState, Integer -> AppState
  orch-advance-frame (app) (dt) =
    AppState {
      app-root = app.app-root, app-theme = app.app-theme,
      app-compositor = app.app-compositor, app-overlays = app.app-overlays,
      app-bindings = app.app-bindings, app-animations = app.app-animations,
      app-sounds = app.app-sounds, app-handlers = app.app-handlers,
      app-timers = app.app-timers, app-timer-count = app.app-timer-count,
      app-focused = app.app-focused, app-hovered = app.app-hovered,
      app-dirty = app.app-dirty, app-frame = app.app-frame + 1, app-time = app.app-time + dt
    }

