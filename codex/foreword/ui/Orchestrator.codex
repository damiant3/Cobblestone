Section: Queries
  app-frame-count : AppState -> Integer
  app-frame-count (app) = app.app-frame

  app-elapsed : AppState -> Integer
  app-elapsed (app) = app.app-time

  app-is-dirty : AppState -> Boolean
  app-is-dirty (app) = app.app-dirty

  app-has-modal : AppState -> Boolean
  app-has-modal (app) = overlay-has-modal (app.app-overlays)

  format-app-state : AppState -> Text
  format-app-state (app) =
    "frame=" & show (app.app-frame) & " t=" & show (app.app-time) & " dirty=" & fmt-bool (app.app-dirty) & " focus=" & app.app-focused & " timers=" & show (app.app-timer-count) & " overlays=" & show ((app.app-overlays).os-count)

