Chapter: Constraint

 Distance constraints, springs, and joints for physics simulation.
 Operates on 2D point pairs with fixed-point scale-1000 arithmetic.
 Constraints are resolved iteratively via projection — each solve
 step moves points toward satisfaction.

 To constraint-distance gives a distance constraint between two points.
 To constraint-spring gives a spring constraint with stiffness.
 To constraint-solve gives updated points after one solve iteration.
 To constraint-solve-n gives updated points after N iterations.

 We say:

Section: Types

  Vec2 = record {
    vx : Integer,
    vy : Integer
  }

  vec2 : Integer, Integer -> Vec2
  vec2 (x) (y) = Vec2 { vx = x, vy = y }

  vec2-add : Vec2, Vec2 -> Vec2
  vec2-add (a) (b) = Vec2 { vx = a.vx + b.vx, vy = a.vy + b.vy }

  vec2-sub : Vec2, Vec2 -> Vec2
  vec2-sub (a) (b) = Vec2 { vx = a.vx - b.vx, vy = a.vy - b.vy }

  vec2-scale : Vec2, Integer -> Vec2
  vec2-scale (v) (s) = Vec2 { vx = v.vx * s / 1000, vy = v.vy * s / 1000 }

  vec2-length-sq : Vec2 -> Integer
  vec2-length-sq (v) = v.vx * v.vx / 1000 + v.vy * v.vy / 1000

  vec2-length : Vec2 -> Integer
  vec2-length (v) = isqrt (vec2-length-sq v * 1000)

  isqrt : Integer -> Integer
  isqrt (n) =
    if n <= 0 then 0
    else isqrt-loop n (n / 2 + 1)

  isqrt-loop : Integer, Integer -> Integer
  isqrt-loop (n) (guess) =
    let next = (guess + n / guess) / 2
    in if next >= guess then guess
    else isqrt-loop n next

Section: Constraints

  ConstraintKind =
    | CkDistance (Integer)
    | CkSpring (Integer) (Integer)
    | CkPin (Vec2)

  Constraint = record {
    c-kind : ConstraintKind,
    c-idx-a : Integer,
    c-idx-b : Integer,
    c-stiffness : Integer
  }

  constraint-distance : Integer, Integer, Integer -> Constraint
  constraint-distance (a) (b) (rest-length) = Constraint {
    c-kind = CkDistance rest-length,
    c-idx-a = a,
    c-idx-b = b,
    c-stiffness = 1000
  }

  constraint-spring : Integer, Integer, Integer, Integer -> Constraint
  constraint-spring (a) (b) (rest-length) (stiffness) = Constraint {
    c-kind = CkSpring rest-length stiffness,
    c-idx-a = a,
    c-idx-b = b,
    c-stiffness = stiffness
  }

  constraint-pin : Integer, Vec2 -> Constraint
  constraint-pin (idx) (pos) = Constraint {
    c-kind = CkPin pos,
    c-idx-a = idx,
    c-idx-b = idx,
    c-stiffness = 1000
  }

Section: Solver

  constraint-solve : List Vec2, List Constraint -> List Vec2
  constraint-solve (points) (constraints) =
    cs-solve-loop points constraints 0 (list-length constraints)

  cs-solve-loop : List Vec2, List Constraint, Integer, Integer -> List Vec2
  cs-solve-loop (pts) (cs) (i) (len) =
    if i >= len then pts
    else let c = list-at cs i
    in cs-solve-loop (cs-apply-one pts c) cs (i + 1) len

  cs-apply-one : List Vec2, Constraint -> List Vec2
  cs-apply-one (pts) (c) = when c.c-kind
    is CkDistance (rest) -> cs-apply-distance pts c rest
    is CkSpring (rest) (k) -> cs-apply-spring pts c rest k
    is CkPin (target) -> list-set-at pts (c.c-idx-a) target

  cs-apply-distance : List Vec2, Constraint, Integer -> List Vec2
  cs-apply-distance (pts) (c) (rest) =
    let a = list-at pts (c.c-idx-a)
    in let b = list-at pts (c.c-idx-b)
    in let delta = vec2-sub b a
    in let dist = vec2-length delta
    in if dist == 0 then pts
    else let diff = (dist - rest) * 1000 / dist
    in let correction = vec2-scale delta (diff / 2)
    in let a2 = vec2-add a correction
    in let b2 = vec2-sub b correction
    in list-set-at (list-set-at pts (c.c-idx-a) a2) (c.c-idx-b) b2

  cs-apply-spring : List Vec2, Constraint, Integer, Integer -> List Vec2
  cs-apply-spring (pts) (c) (rest) (k) =
    let a = list-at pts (c.c-idx-a)
    in let b = list-at pts (c.c-idx-b)
    in let delta = vec2-sub b a
    in let dist = vec2-length delta
    in if dist == 0 then pts
    else let displacement = dist - rest
    in let force = k * displacement / 1000
    in let correction = vec2-scale delta (force * 500 / dist)
    in let a2 = vec2-add a correction
    in let b2 = vec2-sub b correction
    in list-set-at (list-set-at pts (c.c-idx-a) a2) (c.c-idx-b) b2

Section: Multi-Iteration

  constraint-solve-n : List Vec2, List Constraint, Integer -> List Vec2
  constraint-solve-n (points) (constraints) (iterations) =
    cs-solve-n-loop points constraints iterations 0

  cs-solve-n-loop : List Vec2, List Constraint, Integer, Integer -> List Vec2
  cs-solve-n-loop (pts) (cs) (n) (i) =
    if i >= n then pts
    else cs-solve-n-loop (constraint-solve pts cs) cs n (i + 1)

