Chapter: Constraint

  cites Foreword chapter MathLib

 Distance constraints, springs, and joints for physics simulation.
 Operates on 2D point pairs with fixed-point scale-1000 arithmetic.
 Constraints are resolved iteratively via projection -- each solve
 step moves points toward satisfaction.

 We say:

Section: Types

 Named for this chapter, because `Math chapter Geometry` defines a
 `Vec2` too and the two are not the same vector. Geometry's carries
 `Real` components in fields `v2x`/`v2y`; this one carries fixed-point
 `Integer` at scale 1000 in `vx`/`vy`, which is the arithmetic the whole
 sim quire works in. Sharing the name meant two records and five
 same-named operations differing in both representation and units, and
 a unit reaching both got whichever the glob order found first --
 except that a colliding TYPE is worse than a colliding definition: it
 is a hard CDX3001 rather than a silent pick.

  ConVec2 = record {
    vx : Integer,
    vy : Integer
  }

  con-vec2 : Integer, Integer -> ConVec2
  con-vec2 (x) (y) = ConVec2 { vx = x, vy = y }

  con-vec2-add : ConVec2, ConVec2 -> ConVec2
  con-vec2-add (a) (b) = ConVec2 { vx = a.vx + b.vx, vy = a.vy + b.vy }

  con-vec2-sub : ConVec2, ConVec2 -> ConVec2
  con-vec2-sub (a) (b) = ConVec2 { vx = a.vx - b.vx, vy = a.vy - b.vy }

  con-vec2-scale : ConVec2, Integer -> ConVec2
  con-vec2-scale (v) (s) = ConVec2 { vx = v.vx * s / 1000, vy = v.vy * s / 1000 }

  con-vec2-length-sq : ConVec2 -> Integer
  con-vec2-length-sq (v) = v.vx * v.vx / 1000 + v.vy * v.vy / 1000

  con-vec2-length : ConVec2 -> Integer
  con-vec2-length (v) = math-isqrt (con-vec2-length-sq v * 1000)

Section: Constraints

  ConstraintKind =
    | CkDistance (Integer)
    | CkSpring (Integer) (Integer)
    | CkPin (ConVec2)

  Constraint = record {
    c-kind : ConstraintKind,
    c-idx-a : Integer,
    c-idx-b : Integer,
    c-stiffness : Integer
  }

  constraint-distance : Integer, Integer, Integer -> Constraint
  constraint-distance (a) (b) (rest-length) = Constraint {
    c-kind = CkDistance rest-length,
    c-idx-a = a,
    c-idx-b = b,
    c-stiffness = 1000
  }

  constraint-spring : Integer, Integer, Integer, Integer -> Constraint
  constraint-spring (a) (b) (rest-length) (stiffness) = Constraint {
    c-kind = CkSpring rest-length stiffness,
    c-idx-a = a,
    c-idx-b = b,
    c-stiffness = stiffness
  }

  constraint-pin : Integer, ConVec2 -> Constraint
  constraint-pin (idx) (pos) = Constraint {
    c-kind = CkPin pos,
    c-idx-a = idx,
    c-idx-b = idx,
    c-stiffness = 1000
  }

Section: Solver

  constraint-solve : List ConVec2, List Constraint -> List ConVec2
  constraint-solve (points) (constraints) =
    cs-solve-loop points constraints 0 (list-length constraints)

  cs-solve-loop : List ConVec2, List Constraint, Integer, Integer -> List ConVec2
  cs-solve-loop (pts) (cs) (i) (len) =
    if i >= len then pts
    else let c = list-at cs i
    in cs-solve-loop (cs-apply-one pts c) cs (i + 1) len

  cs-apply-one : List ConVec2, Constraint -> List ConVec2
  cs-apply-one (pts) (c) = when c.c-kind
    is CkDistance (rest) -> cs-apply-distance pts c rest
    is CkSpring (rest) (k) -> cs-apply-spring pts c rest k
    is CkPin (target) -> list-set-at pts (c.c-idx-a) target

  cs-apply-distance : List ConVec2, Constraint, Integer -> List ConVec2
  cs-apply-distance (pts) (c) (rest) =
    let a = list-at pts (c.c-idx-a)
    in let b = list-at pts (c.c-idx-b)
    in let delta = con-vec2-sub b a
    in let dist = con-vec2-length delta
    in if dist == 0 then pts
    else let diff = (dist - rest) * 1000 / dist
    in let correction = con-vec2-scale delta (diff / 2)
    in let a2 = con-vec2-add a correction
    in let b2 = con-vec2-sub b correction
    in list-set-at (list-set-at pts (c.c-idx-a) a2) (c.c-idx-b) b2

  cs-apply-spring : List ConVec2, Constraint, Integer, Integer -> List ConVec2
  cs-apply-spring (pts) (c) (rest) (k) =
    let a = list-at pts (c.c-idx-a)
    in let b = list-at pts (c.c-idx-b)
    in let delta = con-vec2-sub b a
    in let dist = con-vec2-length delta
    in if dist == 0 then pts
    else let displacement = dist - rest
    in let force = k * displacement / 1000
    in let correction = con-vec2-scale delta (force * 500 / dist)
    in let a2 = con-vec2-add a correction
    in let b2 = con-vec2-sub b correction
    in list-set-at (list-set-at pts (c.c-idx-a) a2) (c.c-idx-b) b2

Section: Multi-Iteration

  constraint-solve-n : List ConVec2, List Constraint, Integer -> List ConVec2
  constraint-solve-n (points) (constraints) (iterations) =
    cs-solve-n-loop points constraints iterations 0

  cs-solve-n-loop : List ConVec2, List Constraint, Integer, Integer -> List ConVec2
  cs-solve-n-loop (pts) (cs) (n) (i) =
    if i >= n then pts
    else cs-solve-n-loop (constraint-solve pts cs) cs n (i + 1)

