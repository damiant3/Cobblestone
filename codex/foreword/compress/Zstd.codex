Chapter: Zstd
  cites Compress chapter Huffman

 Zstandard framing (RFC 8878) — raw stored blocks. Wraps input in
 a valid Zstd frame with the magic number, frame header, and raw
 (uncompressed) blocks. Decompression reads the frame and extracts
 the payload. This is the simplest correct Zstd stream — proper
 framing with no entropy coding. FSE/Huffman compressed blocks
 are a future extension.

 To zstd-compress gives a Zstd-framed byte stream (raw blocks).
 To zstd-decompress gives original bytes from a Zstd stream.
 To zstd-valid gives True when input has a valid Zstd magic number.

 We say:

Section: Constants

  zstd-magic-0 : Integer = 40
  zstd-magic-1 : Integer = 181
  zstd-magic-2 : Integer = 47
  zstd-magic-3 : Integer = 253
  zstd-block-max : Integer = 131071

Section: Compression (Raw Blocks)

  zstd-compress : List Integer -> List Integer
  zstd-compress (input) =
    let len = list-length input
    in zstd-frame-header len & zstd-emit-raw-blocks input len 0

  zstd-frame-header : Integer -> List Integer
  zstd-frame-header (content-size) =
    let fhd = 96
    in [zstd-magic-0, zstd-magic-1, zstd-magic-2, zstd-magic-3, fhd, bit-and content-size 255, bit-and (bit-shru content-size 8) 255]

  zstd-emit-raw-blocks : List Integer, Integer, Integer -> List Integer
  zstd-emit-raw-blocks (input) (total) (pos) =
    if pos >= total then []
    else let remaining = total - pos
    in let chunk = if remaining > zstd-block-max then zstd-block-max else remaining
    in let is-last = pos + chunk >= total
    in let header = zstd-raw-block-header is-last chunk
    in let data = zstd-slice input pos chunk 0 []
    in header & data & zstd-emit-raw-blocks input total (pos + chunk)

  zstd-raw-block-header : Boolean, Integer -> List Integer
  zstd-raw-block-header (is-last) (size) =
    let last-bit = if is-last then 1 else 0
    in let raw = bit-or last-bit (bit-shl size 3)
    in [bit-and raw 255, bit-and (bit-shru raw 8) 255, bit-and (bit-shru raw 16) 255]

Section: Decompression

  zstd-decompress : List Integer -> List Integer
  zstd-decompress (input) =
    if zstd-valid input == False then []
    else zstd-decode-blocks input 7 (list-length input) []

  zstd-decode-blocks : List Integer, Integer, Integer, List Integer -> List Integer
  zstd-decode-blocks (input) (pos) (len) (acc) =
    if pos + 2 >= len then acc
    else let header = bit-or (bit-or (list-at input pos) (bit-shl (list-at input (pos + 1)) 8)) (bit-shl (list-at input (pos + 2)) 16)
    in let is-last = bit-and header 1
    in let block-type = bit-and (bit-shru header 1) 3
    in let block-size = bit-shru header 3
    in let data = zstd-slice input (pos + 3) block-size 0 []
    in let acc2 = acc & data
    in if is-last == 1 then acc2
    else zstd-decode-blocks input (pos + 3 + block-size) len acc2

Section: Validation

  zstd-valid : List Integer -> Boolean
  zstd-valid (input) =
    if list-length input < 7 then False
    else if list-at input 0 == zstd-magic-0 then
      if list-at input 1 == zstd-magic-1 then
        if list-at input 2 == zstd-magic-2 then
          list-at input 3 == zstd-magic-3
        else False
      else False
    else False

Section: Helpers

  zstd-slice : List Integer, Integer, Integer, Integer, List Integer -> List Integer
  zstd-slice (xs) (off) (len) (i) (acc) =
    if i >= len then acc
    else if off + i >= list-length xs then acc
    else zstd-slice xs off len (i + 1) (list-push acc (list-at xs (off + i)))

