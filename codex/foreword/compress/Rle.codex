Chapter: Rle

 Run-length encoding and decoding. Encodes consecutive repeated
 bytes as (count, value) pairs. Simple and effective for data
 with repeated runs (bitmaps, sprites, scan lines).

 We say:

Section: Encoding
  rle-encode : List Integer -> List Integer
  rle-encode (data) =
    let len = list-length data
    in if len == 0 then []
    else rle-encode-loop data 1 len (list-at data 0) 1 []

  rle-encode-loop : List Integer, Integer, Integer, Integer, Integer, List Integer -> List Integer
  rle-encode-loop (data) (i) (len) (current) (count) (acc) =
    if i >= len then acc & [count, current]
    else let b = list-at data i
    in if b == current then
      if count >= 255 then rle-encode-loop data (i + 1) len current 1 (acc & [255, current])
      else rle-encode-loop data (i + 1) len current (count + 1) acc
    else rle-encode-loop data (i + 1) len b 1 (acc & [count, current])

Section: Decoding
  rle-decode : List Integer -> List Integer
  rle-decode (encoded) = rle-decode-loop encoded 0 (list-length encoded) []

  rle-decode-loop : List Integer, Integer, Integer, List Integer -> List Integer
  rle-decode-loop (encoded) (i) (len) (acc) =
    if i + 1 >= len then acc
    else let count = list-at encoded i
    in let val = list-at encoded (i + 1)
    in rle-decode-loop encoded (i + 2) len (rle-repeat acc val count)

  rle-repeat : List Integer, Integer, Integer -> List Integer
  rle-repeat (acc) (val) (count) =
    if count <= 0 then acc
    else rle-repeat (list-push acc val) val (count - 1)

Section: Queries
  rle-compression-ratio : List Integer, List Integer -> Text
  rle-compression-ratio (original) (encoded) =
    show (list-length original) & "->" & show (list-length encoded)

