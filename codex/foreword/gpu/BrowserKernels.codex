     p0 <- shared-load-approx ((jj * 65 + (2 * ((ty * 16 + tx) / 8))) * 4)
     p1 <- shared-load-approx ((jj * 65 + (2 * ((ty * 16 + tx) / 8)) + 1) * 4)
     v0 <- shared-load-approx ((1040 + jj * 64 + ((ty * 16 + tx) - (ty * 16 + tx) / 8 * 8) + 0) * 4)
     v1 <- shared-load-approx ((1040 + jj * 64 + ((ty * 16 + tx) - (ty * 16 + tx) / 8 * 8) + 8) * 4)
     v2 <- shared-load-approx ((1040 + jj * 64 + ((ty * 16 + tx) - (ty * 16 + tx) / 8 * 8) + 16) * 4)
     v3 <- shared-load-approx ((1040 + jj * 64 + ((ty * 16 + tx) - (ty * 16 + tx) / 8 * 8) + 24) * 4)
     v4 <- shared-load-approx ((1040 + jj * 64 + ((ty * 16 + tx) - (ty * 16 + tx) / 8 * 8) + 32) * 4)
     bk-fa-step qb kb vb ob heads sq sk d scale h r0 ty tx kt k0 k q (jj + 1) a00 a01 a02 a03 a10 a11 a12 a13 a20 a21 a22 a23 a30 a31 a32 a33 (o00 + p0 * v0) (o01 + p0 * v1) (o02 + p0 * v2) (o03 + p0 * v3) (o04 + p0 * v4) (o10 + p1 * v0) (o11 + p1 * v1) (o12 + p1 * v2) (o13 + p1 * v3) (o14 + p1 * v4)
    end

  bk-fa-mask : Real approximate, Real approximate, Integer, Integer -> Real approximate
  bk-fa-mask (a) (s) (col) (sk) = if col < sk then a * s else (to-real-approx (0.0 - 1000000000.0))

  bk-fa-p : Real approximate, Real approximate, Integer, Integer, Real approximate -> Real approximate
  bk-fa-p (a) (s) (col) (sk) (m) = bk-fa-exp (bk-fa-mask a s col sk - m)

  bk-fa-exp : Real approximate -> Real approximate
  bk-fa-exp (v) = to-real-approx (bk-exp-of (from-real-approx v))

  bk-fa-max2 : Real approximate, Real approximate -> Real approximate
  bk-fa-max2 (a) (b) = if b > a then b else a

  bk-fa-max4 : Real approximate, Real approximate, Real approximate, Real approximate -> Real approximate
  bk-fa-max4 (a) (b) (c) (e) = bk-fa-max2 (bk-fa-max2 a b) (bk-fa-max2 c e)

  bk-fa-pick : Integer, Real approximate, Real approximate, Real approximate, Real approximate -> Real approximate
  bk-fa-pick (q) (a) (b) (c) (e) = if q == 0 then a else if q == 1 then b else if q == 2 then c else e

  bk-fa-rmax : Integer, Integer, Real approximate -> [Device] Real approximate
  bk-fa-rmax (base) (i) (acc) =
    if i >= 16 then acc else act
     v <- shared-load-approx ((base + i) * 4)
     bk-fa-rmax base (i + 1) (bk-fa-max2 acc v)
    end

  bk-fa-rsum : Integer, Integer, Real approximate -> [Device] Real approximate
  bk-fa-rsum (base) (i) (acc) =
    if i >= 16 then acc else act
     v <- shared-load-approx ((base + i) * 4)
     bk-fa-rsum base (i + 1) (acc + v)
    end

  bk-fa-final : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate -> [Device] Integer
  bk-fa-final (ob) (heads) (sq) (d) (h) (row) (cg) (l0) (l1) (o00) (o01) (o02) (o03) (o04) (o10) (o11) (o12) (o13) (o14) = act
   f00 <- bk-fa-out ob heads sq d h row cg (o00 / l0)
   f01 <- bk-fa-out ob heads sq d h row (cg + 8) (o01 / l0)
   f02 <- bk-fa-out ob heads sq d h row (cg + 16) (o02 / l0)
   f03 <- bk-fa-out ob heads sq d h row (cg + 24) (o03 / l0)
   f04 <- bk-fa-out ob heads sq d h row (cg + 32) (o04 / l0)
   f10 <- bk-fa-out ob heads sq d h (row + 1) cg (o10 / l1)
   f11 <- bk-fa-out ob heads sq d h (row + 1) (cg + 8) (o11 / l1)
   f12 <- bk-fa-out ob heads sq d h (row + 1) (cg + 16) (o12 / l1)
   f13 <- bk-fa-out ob heads sq d h (row + 1) (cg + 24) (o13 / l1)
   f14 <- bk-fa-out ob heads sq d h (row + 1) (cg + 32) (o14 / l1)
   0
  end

  bk-fa-out : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Real approximate -> [Device] Integer
  bk-fa-out (ob) (heads) (sq) (d) (h) (row) (col) (v) =
    if row < sq then (if col < d then device-store-approx ob ((row * heads + h) * d + col) v else 0) else 0

Section: Layout

  bk-transpose : Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-transpose (xb) (yb) (rows) (cols) (n) (gid) =
    if gid < n then device-store-f32 yb gid (device-load-f32 xb ((gid - gid / rows * rows) * cols + gid / rows)) else 0

  bk-concat : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-concat (ab) (bb) (yb) (ca) (cb) (inner) (n) (gid) =
    if gid < n then device-store-f32 yb gid (bk-concat-at ab bb ca cb inner (gid / inner) gid) else 0

  bk-concat-at : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Real
  bk-concat-at (ab) (bb) (ca) (cb) (inner) (plane) (i) =
    let bt = plane / (ca + cb)
    in let ch = plane - bt * (ca + cb)
    in if ch < ca then device-load-f32 ab ((bt * ca + ch) * inner + i - plane * inner)
    else device-load-f32 bb ((bt * cb + ch - ca) * inner + i - plane * inner)

  bk-upsample : Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-upsample (xb) (yb) (h) (w) (n) (gid) =
    if gid < n then device-store-f32 yb gid (device-load-f32 xb (bk-upsample-src h w (gid / (4 * h * w)) gid)) else 0

  bk-upsample-src : Integer, Integer, Integer, Integer -> Integer
  bk-upsample-src (h) (w) (plane) (i) =
    let oy = (i - plane * 4 * h * w) / (2 * w)
    in plane * h * w + (oy / 2) * w + (i - plane * 4 * h * w - oy * 2 * w) / 2

Section: Timestep Embedding

 The LDM sinusoidal embedding as kernel-timestep-embedding, in f32 as Forge
 computes it: for half = dim / 2 and k < half, frequency
 e^(-log-period k / half), the row [cos (t f), sin (t f)].

  bk-timestep : Integer, Integer, Integer, Real, Integer, Integer -> [Device] Integer
  bk-timestep (tb) (yb) (dim) (log-period) (n) (gid) =
    if gid < n then device-store-f32 yb gid (bk-timestep-at (device-load-f32 tb (gid / dim)) (dim / 2) log-period (gid - gid / dim * dim)) else 0

  bk-timestep-at : Real, Integer, Real, Integer -> Real
  bk-timestep-at (tv) (half) (log-period) (j) =
    if j < half then real-cos (tv * bk-exp-of (0.0 - log-period * real-from-int j / real-from-int half))
    else real-sin (tv * bk-exp-of (0.0 - log-period * real-from-int (j - half) / real-from-int half))

Section: Linear

 A 64 x 64 tile of y per 256-thread workgroup, 4 x 4 outputs a thread, rows
 ly + 16 i and columns lx + 16 j; a 16-wide step of kk is staged k-major with a
 row stride of 65, x at word 0 and w at word 1040, so the staging stores of a
 warp (16 k columns, stride 65) fall in 16 distinct banks where a stride of 64
 puts them in one. `half` 1 reads w as packed f16.

  bk-linear : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-linear (xb) (wb) (bb) (yb) (mm) (nn) (kk) (gid) = act
   t <- thread-idx-x
   bx <- block-idx-x
   bk-linear-4x4 xb wb bb yb mm nn kk 0 (bx / ((nn + 63) / 64) * 64) ((bx - bx / ((nn + 63) / 64) * ((nn + 63) / 64)) * 64) (t / 16) (t - t / 16 * 16) 0 16 (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0)
  end

  bk-linear-4x4 : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate -> [Device] Integer
  bk-linear-4x4 (xb) (wb) (bb) (yb) (mm) (nn) (kk) (half) (r0) (c0) (ly) (lx) (k0) (k) (a00) (a01) (a02) (a03) (a10) (a11) (a12) (a13) (a20) (a21) (a22) (a23) (a30) (a31) (a32) (a33) =
    if k >= 16 & k0 >= kk then bk-linear-store16 yb bb mm nn (r0 + ly) (c0 + lx) a00 a01 a02 a03 a10 a11 a12 a13 a20 a21 a22 a23 a30 a31 a32 a33
    else if k >= 16 then act
     s0 <- sync-threads
     p0 <- shared-store-approx ((lx * 65 + ly) * 4) (bk-linear-x-at xb mm kk (r0 + ly) (k0 + lx))
     p1 <- shared-store-approx ((lx * 65 + ly + 16) * 4) (bk-linear-x-at xb mm kk (r0 + ly + 16) (k0 + lx))
     p2 <- shared-store-approx ((lx * 65 + ly + 32) * 4) (bk-linear-x-at xb mm kk (r0 + ly + 32) (k0 + lx))
     p3 <- shared-store-approx ((lx * 65 + ly + 48) * 4) (bk-linear-x-at xb mm kk (r0 + ly + 48) (k0 + lx))
     q0 <- shared-store-approx ((1040 + lx * 65 + ly) * 4) (bk-linear-wany-at wb nn kk half (c0 + ly) (k0 + lx))
     q1 <- shared-store-approx ((1040 + lx * 65 + ly + 16) * 4) (bk-linear-wany-at wb nn kk half (c0 + ly + 16) (k0 + lx))
     q2 <- shared-store-approx ((1040 + lx * 65 + ly + 32) * 4) (bk-linear-wany-at wb nn kk half (c0 + ly + 32) (k0 + lx))
     q3 <- shared-store-approx ((1040 + lx * 65 + ly + 48) * 4) (bk-linear-wany-at wb nn kk half (c0 + ly + 48) (k0 + lx))
     s1 <- sync-threads
     bk-linear-4x4 xb wb bb yb mm nn kk half r0 c0 ly lx (k0 + 16) 0 a00 a01 a02 a03 a10 a11 a12 a13 a20 a21 a22 a23 a30 a31 a32 a33
    end
    else act
     x0 <- shared-load-approx ((k * 65 + ly) * 4)
     x1 <- shared-load-approx ((k * 65 + ly + 16) * 4)
     x2 <- shared-load-approx ((k * 65 + ly + 32) * 4)
     x3 <- shared-load-approx ((k * 65 + ly + 48) * 4)
     w0 <- shared-load-approx ((1040 + k * 65 + lx) * 4)
     w1 <- shared-load-approx ((1040 + k * 65 + lx + 16) * 4)
     w2 <- shared-load-approx ((1040 + k * 65 + lx + 32) * 4)
     w3 <- shared-load-approx ((1040 + k * 65 + lx + 48) * 4)
     bk-linear-4x4 xb wb bb yb mm nn kk half r0 c0 ly lx k0 (k + 1) (a00 + x0 * w0) (a01 + x0 * w1) (a02 + x0 * w2) (a03 + x0 * w3) (a10 + x1 * w0) (a11 + x1 * w1) (a12 + x1 * w2) (a13 + x1 * w3) (a20 + x2 * w0) (a21 + x2 * w1) (a22 + x2 * w2) (a23 + x2 * w3) (a30 + x3 * w0) (a31 + x3 * w1) (a32 + x3 * w2) (a33 + x3 * w3)
    end

  bk-linear-store16 : Integer, Integer, Integer, Integer, Integer, Integer, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate -> [Device] Integer
  bk-linear-store16 (yb) (bb) (mm) (nn) (row) (col) (a00) (a01) (a02) (a03) (a10) (a11) (a12) (a13) (a20) (a21) (a22) (a23) (a30) (a31) (a32) (a33) = act
   s00 <- bk-linear-out yb bb mm nn row col a00
   s01 <- bk-linear-out yb bb mm nn row (col + 16) a01
   s02 <- bk-linear-out yb bb mm nn row (col + 32) a02
   s03 <- bk-linear-out yb bb mm nn row (col + 48) a03
   s10 <- bk-linear-out yb bb mm nn (row + 16) col a10
   s11 <- bk-linear-out yb bb mm nn (row + 16) (col + 16) a11
   s12 <- bk-linear-out yb bb mm nn (row + 16) (col + 32) a12
   s13 <- bk-linear-out yb bb mm nn (row + 16) (col + 48) a13
   s20 <- bk-linear-out yb bb mm nn (row + 32) col a20
   s21 <- bk-linear-out yb bb mm nn (row + 32) (col + 16) a21
   s22 <- bk-linear-out yb bb mm nn (row + 32) (col + 32) a22
   s23 <- bk-linear-out yb bb mm nn (row + 32) (col + 48) a23
   s30 <- bk-linear-out yb bb mm nn (row + 48) col a30
   s31 <- bk-linear-out yb bb mm nn (row + 48) (col + 16) a31
   s32 <- bk-linear-out yb bb mm nn (row + 48) (col + 32) a32
   s33 <- bk-linear-out yb bb mm nn (row + 48) (col + 48) a33
   0
  end

  bk-linear-wany-at : Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-linear-wany-at (wb) (rows) (cols) (half) (r) (c) =
    if half == 1 then bk-linear-wh-at wb rows cols r c else bk-linear-w-at wb rows cols r c

  bk-linear-x-at : Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-linear-x-at (xb) (rows) (cols) (r) (c) =
    if r < rows then (if c < cols then device-load-approx xb (r * cols + c) else real-approx-from-int 0) else real-approx-from-int 0

  bk-linear-w-at : Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-linear-w-at (wb) (rows) (cols) (r) (c) =
    if r < rows then (if c < cols then device-load-approx wb (r * cols + c) else real-approx-from-int 0) else real-approx-from-int 0

  bk-linear-out : Integer, Integer, Integer, Integer, Integer, Integer, Real approximate -> [Device] Integer
  bk-linear-out (yb) (bb) (mm) (nn) (row) (col) (v) =
    if row < mm then (if col < nn then device-store-approx yb (row * nn + col) (v + device-load-approx bb col) else 0) else 0

 bk-linear-h is bk-linear with w in packed f16 (SD and SDXL weights as a
 checkpoint stores them); x, b and y stay f32.

  bk-linear-h : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-linear-h (xb) (wb) (bb) (yb) (mm) (nn) (kk) (gid) = act
   t <- thread-idx-x
   bx <- block-idx-x
   bk-linear-4x4 xb wb bb yb mm nn kk 1 (bx / ((nn + 63) / 64) * 64) ((bx - bx / ((nn + 63) / 64) * ((nn + 63) / 64)) * 64) (t / 16) (t - t / 16 * 16) 0 16 (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0)
  end

  bk-linear-wh-at : Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-linear-wh-at (wb) (rows) (cols) (r) (c) =
    if r < rows then (if c < cols then device-load-f16-approx wb (r * cols + c) else real-approx-from-int 0) else real-approx-from-int 0

Section: Conv2d

 y = conv2d x w + b as an implicit GEMM, kernel-conv2d-wmma's contract with a
 cout bias: x is cin x h x wd, w is cout x (cin kh kw) in PyTorch order, y is
 cout x (oh ow). M = cout, N = oh ow, K = cin kh kw; 64 x 64 tiles of y as
 bk-linear, the weight tile at word 0 and the im2col tile, zero outside the
 image and past K, at word 1040. bk-conv2d-h reads w as packed f16.

  bk-conv2d-h : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-conv2d-h (xb) (wb) (bb) (yb) (cin) (h) (wd) (cout) (kh) (kw) (stride) (pad) (oh) (ow) (gid) = act
   t <- thread-idx-x
   bx <- block-idx-x
   bk-conv-go xb wb bb yb cin h wd cout kh kw stride pad 1 ow (oh * ow) 0 (cin * kh * kw) 0 1 (bx / ((oh * ow + 63) / 64) * 64) ((bx - bx / ((oh * ow + 63) / 64) * ((oh * ow + 63) / 64)) * 64) (t / 16) (t - t / 16 * 16)
  end

  bk-conv2d : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-conv2d (xb) (wb) (bb) (yb) (cin) (h) (wd) (cout) (kh) (kw) (stride) (pad) (oh) (ow) (gid) = act
   t <- thread-idx-x
   bx <- block-idx-x
   bk-conv-go xb wb bb yb cin h wd cout kh kw stride pad 0 ow (oh * ow) 0 (cin * kh * kw) 0 1 (bx / ((oh * ow + 63) / 64) * 64) ((bx - bx / ((oh * ow + 63) / 64) * ((oh * ow + 63) / 64)) * 64) (t / 16) (t - t / 16 * 16)
  end

 bk-conv2d-hs is bk-conv2d-h over one of `splits` slices of k, each a whole
 number of 16-wide steps, for a conv whose tiles leave the multiprocessors
 idle (1280 channels at 8 x 8 is 20 workgroups): workgroup bx takes tile
 bx mod tiles of slice bx / tiles and writes its partial product at word
 slice x cout x npix of yb, the bias in slice 0 only; bk-sum-splits adds the
 slices in order.

  bk-conv2d-hs : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-conv2d-hs (xb) (wb) (bb) (yb) (cin) (h) (wd) (cout) (kh) (kw) (stride) (pad) (oh) (ow) (splits) (gid) = act
   t <- thread-idx-x
   bx <- block-idx-x
   bk-conv-slice xb wb bb yb cin h wd cout kh kw stride pad ow (oh * ow) ((cin * kh * kw + splits * 16 - 1) / (splits * 16) * 16) (bx / (((cout + 63) / 64) * ((oh * ow + 63) / 64))) (bx - bx / (((cout + 63) / 64) * ((oh * ow + 63) / 64)) * (((cout + 63) / 64) * ((oh * ow + 63) / 64))) t
  end

  bk-conv-slice : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-conv-slice (xb) (wb) (bb) (yb) (cin) (h) (wd) (cout) (kh) (kw) (stride) (pad) (ow) (npix) (kc) (s) (tile) (t) =
    bk-conv-go xb wb bb yb cin h wd cout kh kw stride pad 1 ow npix (s * kc) kc (s * cout * npix) (if s == 0 then 1 else 0) (tile / ((npix + 63) / 64) * 64) ((tile - tile / ((npix + 63) / 64) * ((npix + 63) / 64)) * 64) (t / 16) (t - t / 16 * 16)

  bk-sum-splits : Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-sum-splits (pb) (yb) (splits) (n) (gid) =
    if gid < n then device-store-f32 yb gid (bk-split-sum pb n gid 0 splits 0.0) else 0

  bk-split-sum : Integer, Integer, Integer, Integer, Integer, Real -> [Device] Real
  bk-split-sum (pb) (n) (i) (s) (splits) (acc) =
    if s >= splits then acc else bk-split-sum pb n i (s + 1) splits (acc + device-load-f32 pb (s * n + i))

 A thread stages one pixel of the im2col tile for the whole k loop, so its
 input row and column are divided out once here; a pixel past npix starts a
 million rows above the image, which bk-conv-x-pix answers with 0. The 3 x 3
 and 1 x 1 paths divide by literals, which the shader compiler turns into
 multiplies; a division by a uniform stays a division.

  bk-conv-go : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-conv-go (xb) (wb) (bb) (yb) (cin) (h) (wd) (cout) (kh) (kw) (stride) (pad) (half) (ow) (npix) (kbeg) (kc) (yoff) (withb) (m0) (n0) (ly) (lx) =
    let n = n0 + (ly - ly / 4 * 4) * 16 + lx
    in bk-conv-4x4 xb wb bb yb cin h wd cout kh kw stride pad half ow npix kbeg kc yoff withb m0 n0 ly lx (if n < npix then (n / ow) * stride - pad else 0 - 1000000) ((n - n / ow * ow) * stride - pad) 0 16 (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0) (real-approx-from-int 0)

  bk-conv-4x4 : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate -> [Device] Integer
  bk-conv-4x4 (xb) (wb) (bb) (yb) (cin) (h) (wd) (cout) (kh) (kw) (stride) (pad) (half) (ow) (npix) (kbeg) (kc) (yoff) (withb) (m0) (n0) (ly) (lx) (iy0) (ix0) (k0) (k) (a00) (a01) (a02) (a03) (a10) (a11) (a12) (a13) (a20) (a21) (a22) (a23) (a30) (a31) (a32) (a33) =
    if k >= 16 & k0 >= kc then bk-conv-store16 yb bb cout npix yoff withb (m0 + ly) (n0 + lx) a00 a01 a02 a03 a10 a11 a12 a13 a20 a21 a22 a23 a30 a31 a32 a33
    else if k >= 16 then act
     s0 <- sync-threads
     p0 <- shared-store-approx ((lx * 65 + ly) * 4) (bk-conv-w-at wb half cout (cin * kh * kw) (m0 + ly) (kbeg + k0 + lx))
     p1 <- shared-store-approx ((lx * 65 + ly + 16) * 4) (bk-conv-w-at wb half cout (cin * kh * kw) (m0 + ly + 16) (kbeg + k0 + lx))
     p2 <- shared-store-approx ((lx * 65 + ly + 32) * 4) (bk-conv-w-at wb half cout (cin * kh * kw) (m0 + ly + 32) (kbeg + k0 + lx))
     p3 <- shared-store-approx ((lx * 65 + ly + 48) * 4) (bk-conv-w-at wb half cout (cin * kh * kw) (m0 + ly + 48) (kbeg + k0 + lx))
     q0 <- shared-store-approx ((1040 + (ly / 4) * 65 + (ly - ly / 4 * 4) * 16 + lx) * 4) (bk-conv-xk xb cin h wd kh kw iy0 ix0 (kbeg + k0 + ly / 4))
     q1 <- shared-store-approx ((1040 + (ly / 4 + 4) * 65 + (ly - ly / 4 * 4) * 16 + lx) * 4) (bk-conv-xk xb cin h wd kh kw iy0 ix0 (kbeg + k0 + ly / 4 + 4))
     q2 <- shared-store-approx ((1040 + (ly / 4 + 8) * 65 + (ly - ly / 4 * 4) * 16 + lx) * 4) (bk-conv-xk xb cin h wd kh kw iy0 ix0 (kbeg + k0 + ly / 4 + 8))
     q3 <- shared-store-approx ((1040 + (ly / 4 + 12) * 65 + (ly - ly / 4 * 4) * 16 + lx) * 4) (bk-conv-xk xb cin h wd kh kw iy0 ix0 (kbeg + k0 + ly / 4 + 12))
     s1 <- sync-threads
     bk-conv-4x4 xb wb bb yb cin h wd cout kh kw stride pad half ow npix kbeg kc yoff withb m0 n0 ly lx iy0 ix0 (k0 + 16) 0 a00 a01 a02 a03 a10 a11 a12 a13 a20 a21 a22 a23 a30 a31 a32 a33
    end
    else act
     x0 <- shared-load-approx ((k * 65 + ly) * 4)
     x1 <- shared-load-approx ((k * 65 + ly + 16) * 4)
     x2 <- shared-load-approx ((k * 65 + ly + 32) * 4)
     x3 <- shared-load-approx ((k * 65 + ly + 48) * 4)
     w0 <- shared-load-approx ((1040 + k * 65 + lx) * 4)
     w1 <- shared-load-approx ((1040 + k * 65 + lx + 16) * 4)
     w2 <- shared-load-approx ((1040 + k * 65 + lx + 32) * 4)
     w3 <- shared-load-approx ((1040 + k * 65 + lx + 48) * 4)
     bk-conv-4x4 xb wb bb yb cin h wd cout kh kw stride pad half ow npix kbeg kc yoff withb m0 n0 ly lx iy0 ix0 k0 (k + 1) (a00 + x0 * w0) (a01 + x0 * w1) (a02 + x0 * w2) (a03 + x0 * w3) (a10 + x1 * w0) (a11 + x1 * w1) (a12 + x1 * w2) (a13 + x1 * w3) (a20 + x2 * w0) (a21 + x2 * w1) (a22 + x2 * w2) (a23 + x2 * w3) (a30 + x3 * w0) (a31 + x3 * w1) (a32 + x3 * w2) (a33 + x3 * w3)
    end

  bk-conv-store16 : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate -> [Device] Integer
  bk-conv-store16 (yb) (bb) (cout) (npix) (yoff) (withb) (m) (n) (a00) (a01) (a02) (a03) (a10) (a11) (a12) (a13) (a20) (a21) (a22) (a23) (a30) (a31) (a32) (a33) = act
   s00 <- bk-conv-out yb bb cout npix yoff withb m n a00
   s01 <- bk-conv-out yb bb cout npix yoff withb m (n + 16) a01
   s02 <- bk-conv-out yb bb cout npix yoff withb m (n + 32) a02
   s03 <- bk-conv-out yb bb cout npix yoff withb m (n + 48) a03
   s10 <- bk-conv-out yb bb cout npix yoff withb (m + 16) n a10
   s11 <- bk-conv-out yb bb cout npix yoff withb (m + 16) (n + 16) a11
   s12 <- bk-conv-out yb bb cout npix yoff withb (m + 16) (n + 32) a12
   s13 <- bk-conv-out yb bb cout npix yoff withb (m + 16) (n + 48) a13
   s20 <- bk-conv-out yb bb cout npix yoff withb (m + 32) n a20
   s21 <- bk-conv-out yb bb cout npix yoff withb (m + 32) (n + 16) a21
   s22 <- bk-conv-out yb bb cout npix yoff withb (m + 32) (n + 32) a22
   s23 <- bk-conv-out yb bb cout npix yoff withb (m + 32) (n + 48) a23
   s30 <- bk-conv-out yb bb cout npix yoff withb (m + 48) n a30
   s31 <- bk-conv-out yb bb cout npix yoff withb (m + 48) (n + 16) a31
   s32 <- bk-conv-out yb bb cout npix yoff withb (m + 48) (n + 32) a32
   s33 <- bk-conv-out yb bb cout npix yoff withb (m + 48) (n + 48) a33
   0
  end

  bk-conv-w-at : Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-conv-w-at (wb) (half) (cout) (kk) (m) (kx) =
    if half == 1 then bk-linear-wh-at wb cout kk m kx else bk-linear-w-at wb cout kk m kx

  bk-conv-xk : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-conv-xk (xb) (cin) (h) (wd) (kh) (kw) (iy0) (ix0) (kx) =
    if kx >= cin * kh * kw then real-approx-from-int 0
    else if kh == 3 & kw == 3 then bk-conv-x-pix xb h wd (kx / 9) (iy0 + (kx - kx / 9 * 9) / 3) (ix0 + (kx - kx / 9 * 9) - (kx - kx / 9 * 9) / 3 * 3)
    else if kh == 1 & kw == 1 then bk-conv-x-pix xb h wd kx iy0 ix0
    else let rest = kx - kx / (kh * kw) * (kh * kw)
    in bk-conv-x-pix xb h wd (kx / (kh * kw)) (iy0 + rest / kw) (ix0 + rest - rest / kw * kw)

  bk-conv-x-pix : Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-conv-x-pix (xb) (h) (wd) (ci) (iy) (ix) =
    if iy < 0 then real-approx-from-int 0
    else if iy >= h then real-approx-from-int 0
    else if ix < 0 then real-approx-from-int 0
    else if ix >= wd then real-approx-from-int 0
    else device-load-approx xb ((ci * h + iy) * wd + ix)

  bk-conv-out : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Real approximate -> [Device] Integer
  bk-conv-out (yb) (bb) (cout) (npix) (yoff) (withb) (m) (n) (v) =
    if m < cout then (if n < npix then device-store-approx yb (yoff + m * npix + n) (if withb == 1 then v + device-load-approx bb m else v) else 0) else 0

Section: Element-wise

  bk-add-channel : Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-add-channel (xb) (cb) (yb) (hw) (n) (gid) =
    if gid < n then device-store-f32 yb gid (device-load-f32 xb gid + device-load-f32 cb (gid / hw)) else 0

  bk-scale : Integer, Integer, Real, Integer, Integer -> [Device] Integer
  bk-scale (xb) (yb) (s) (n) (gid) =
    if gid < n then device-store-f32 yb gid (device-load-f32 xb gid * s) else 0

 The sampler's a x + b y + c z. WebGPU refuses one buffer bound twice as
 writable storage, so out is never x, y or z here.

  bk-lincomb3 : Integer, Integer, Integer, Integer, Real, Real, Real, Integer, Integer -> [Device] Integer
  bk-lincomb3 (xb) (yb) (zb) (ob) (a) (b) (c) (n) (gid) =
    if gid < n then device-store-f32 ob gid (a * device-load-f32 xb gid + b * device-load-f32 yb gid + c * device-load-f32 zb gid) else 0

  bk-add : Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-add (ab) (bb) (yb) (n) (gid) =
    if gid < n then device-store-f32 yb gid (device-load-f32 ab gid + device-load-f32 bb gid) else 0
