Chapter: BrowserKernels
  cites Gpu chapter DeviceEffect
  cites Gpu chapter DeviceMath

 The layer kernels in the form the WGSL plug lowers for WebGPU
 (docs/Designs/Active/Apps/InBrowserDiffusion.md, stage 1): f32 in and out,
 no f64, and the thread index as the last parameter, gid.

 We say:

Section: Activations

 SiLU, x / (1 + e^-x); e^-x is 2^(-x log2 e), log2 e = 1.4426950408889634.

  bk-silu : Integer, Integer, Integer, Integer -> [Device] Integer
  bk-silu (xb) (yb) (n) (gid) =
    if gid < n then device-store-f32 yb gid (bk-silu-of (device-load-f32 xb gid)) else 0

  bk-silu-of : Real -> Real
  bk-silu-of (v) = v / (1.0 + real-exp2-approx (0.0 - v * 1.4426950408889634))

 The exact GELU, 0.5 x (1 + erf (x / sqrt 2)), erf by Abramowitz and Stegun
 7.1.26 (absolute error below 1.5e-7), as lk-erf-fast computes it.

  bk-gelu : Integer, Integer, Integer, Integer -> [Device] Integer
  bk-gelu (xb) (yb) (n) (gid) =
    if gid < n then device-store-f32 yb gid (bk-gelu-of (device-load-f32 xb gid)) else 0

  bk-gelu-of : Real -> Real
  bk-gelu-of (v) = 0.5 * v * (1.0 + bk-erf (v * 0.7071067811865476))

  bk-erf : Real -> Real
  bk-erf (x) =
    let a = if x < 0.0 then 0.0 - x else x
    in let t = 1.0 / (1.0 + 0.3275911 * a)
    in let e = 1.0 - t * (0.254829592 + t * ((0.0 - 0.284496736) + t * (1.421413741 + t * ((0.0 - 1.453152027) + t * 1.061405429)))) * real-exp2-approx (0.0 - a * a * 1.4426950408889634)
    in if x < 0.0 then 0.0 - e else e

 GEGLU as kernel-geglu: a row of x is [a, gate], each inner wide.

  bk-geglu : Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-geglu (xb) (yb) (inner) (n) (gid) =
    if gid < n then device-store-f32 yb gid (bk-geglu-of (device-load-f32 xb (gid / inner * 2 * inner + gid - gid / inner * inner)) (device-load-f32 xb (gid / inner * 2 * inner + inner + gid - gid / inner * inner))) else 0

  bk-geglu-of : Real, Real -> Real
  bk-geglu-of (a) (g) = a * bk-gelu-of g

 CLIP-L's quick_gelu, x sigmoid (1.702 x).

  bk-quick-gelu : Integer, Integer, Integer, Integer -> [Device] Integer
  bk-quick-gelu (xb) (yb) (n) (gid) =
    if gid < n then device-store-f32 yb gid (bk-quick-gelu-of (device-load-f32 xb gid)) else 0

  bk-quick-gelu-of : Real -> Real
  bk-quick-gelu-of (v) = v / (1.0 + real-exp2-approx (0.0 - 1.702 * v * 1.4426950408889634))

Section: Normalization

 One thread per row: the mean and 1/sqrt(var + eps) of `len` elements, stored
 as an f32 pair per row. GroupNorm is a row per (batch, group); bk-group-affine
 then normalizes element i of channel ch, row b * groups + ch / (c / groups).

 The WGSL plug lowers a store only as a statement, so the pair is two
 kernels, one store each; bk-row-rstd recomputes the mean.

  bk-row-mean : Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-row-mean (xb) (sb) (len) (rows) (gid) =
    if gid < rows then device-store-f32 sb (gid * 2) (bk-sum xb (gid * len) (gid * len + len) 0.0 / real-from-int len) else 0

  bk-row-rstd : Integer, Integer, Integer, Real, Integer, Integer -> [Device] Integer
  bk-row-rstd (xb) (sb) (len) (eps) (rows) (gid) =
    if gid < rows then device-store-f32 sb (gid * 2 + 1) (bk-rstd-of xb (gid * len) len (bk-sum xb (gid * len) (gid * len + len) 0.0 / real-from-int len) eps) else 0

  bk-rstd-of : Integer, Integer, Integer, Real, Real -> [Device] Real
  bk-rstd-of (xb) (start) (len) (mean) (eps) =
    1.0 / real-sqrt (bk-sq-dev xb start (start + len) mean 0.0 / real-from-int len + eps)

  bk-sum : Integer, Integer, Integer, Real -> [Device] Real
  bk-sum (xb) (i) (stop) (acc) =
    if i >= stop then acc else bk-sum xb (i + 1) stop (acc + device-load-f32 xb i)

  bk-sq-dev : Integer, Integer, Integer, Real, Real -> [Device] Real
  bk-sq-dev (xb) (i) (stop) (mean) (acc) =
    if i >= stop then acc else bk-sq-dev xb (i + 1) stop mean (acc + (device-load-f32 xb i - mean) * (device-load-f32 xb i - mean))

  bk-group-affine : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-group-affine (xb) (sb) (gb) (bb) (yb) (c) (hw) (groups) (n) (gid) =
    if gid < n then bk-affine-at xb sb gb bb yb ((gid / hw / c) * groups + (gid / hw - (gid / hw / c) * c) / (c / groups)) (gid / hw - (gid / hw / c) * c) gid else 0

  bk-layer-affine : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-layer-affine (xb) (sb) (gb) (bb) (yb) (dim) (n) (gid) =
    if gid < n then bk-affine-at xb sb gb bb yb (gid / dim) (gid - gid / dim * dim) gid else 0

  bk-affine-at : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-affine-at (xb) (sb) (gb) (bb) (yb) (row) (ch) (i) =
    device-store-f32 yb i ((device-load-f32 xb i - device-load-f32 sb (row * 2)) * device-load-f32 sb (row * 2 + 1) * device-load-f32 gb ch + device-load-f32 bb ch)

Section: Softmax

 Row softmax out of place, one thread per element: each thread finds its row's
 max and exponent sum, then stores one value.

  bk-softmax : Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-softmax (sb) (yb) (cols) (n) (gid) =
    if gid < n then device-store-f32 yb gid (bk-softmax-at sb (gid / cols * cols) cols gid) else 0

  bk-softmax-at : Integer, Integer, Integer, Integer -> [Device] Real
  bk-softmax-at (sb) (lo) (cols) (i) =
    bk-softmax-with sb lo cols i (bk-max sb (lo + 1) (lo + cols) (device-load-f32 sb lo))

  bk-softmax-with : Integer, Integer, Integer, Integer, Real -> [Device] Real
  bk-softmax-with (sb) (lo) (cols) (i) (m) =
    bk-exp-of (device-load-f32 sb i - m) / bk-exp-sum sb lo (lo + cols) m 0.0

  bk-max : Integer, Integer, Integer, Real -> [Device] Real
  bk-max (sb) (i) (stop) (acc) =
    if i >= stop then acc else bk-max sb (i + 1) stop (real-max acc (device-load-f32 sb i))

  bk-exp-sum : Integer, Integer, Integer, Real, Real -> [Device] Real
  bk-exp-sum (sb) (i) (stop) (m) (acc) =
    if i >= stop then acc else bk-exp-sum sb (i + 1) stop m (acc + bk-exp-of (device-load-f32 sb i - m))

 The same softmax for long rows in three launches, one store each: every
 row's max into mb at 2 r, its exponent sum at 2 r + 1, then one thread per
 element. A row of 4096 (SD1.5's self-attention at 512 x 512) costs three
 passes, where bk-softmax rereads the row twice for every element.

  bk-row-max : Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-row-max (sb) (mb) (cols) (rows) (gid) =
    if gid < rows then device-store-f32 mb (gid * 2) (bk-max sb (gid * cols + 1) (gid * cols + cols) (device-load-f32 sb (gid * cols))) else 0

  bk-row-expsum : Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-row-expsum (sb) (mb) (cols) (rows) (gid) =
    if gid < rows then device-store-f32 mb (gid * 2 + 1) (bk-exp-sum sb (gid * cols) (gid * cols + cols) (device-load-f32 mb (gid * 2)) 0.0) else 0

  bk-softmax-apply : Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-softmax-apply (sb) (mb) (yb) (cols) (n) (gid) =
    if gid < n then device-store-f32 yb gid (bk-exp-of (device-load-f32 sb gid - device-load-f32 mb (gid / cols * 2)) / device-load-f32 mb (gid / cols * 2 + 1)) else 0

 e^v is 2^(v log2 e).

  bk-exp-of : Real -> Real
  bk-exp-of (v) = real-exp2-approx (v * 1.4426950408889634)

 Causal softmax as kernel-softmax-causal, out of place: row r sees its first
 r mod sq + 1 entries, and the rest are 0.

  bk-softmax-causal : Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-softmax-causal (sb) (yb) (cols) (sq) (n) (gid) =
    if gid < n then device-store-f32 yb gid (bk-causal-at sb (gid / cols * cols) (bk-causal-seen (gid / cols - gid / cols / sq * sq + 1) cols) (gid - gid / cols * cols)) else 0

  bk-causal-seen : Integer, Integer -> Integer
  bk-causal-seen (seen) (cols) = if seen < cols then seen else cols

  bk-causal-at : Integer, Integer, Integer, Integer -> [Device] Real
  bk-causal-at (sb) (lo) (seen) (j) =
    if j >= seen then 0.0 else bk-softmax-at sb lo seen (lo + j)

Section: Attention

 The three-step attention the SD1.5 UNet and CLIP-L run, as kernel-attn-scores
 and kernel-attn-values: q, k and v are rows of heads x d, s and p are heads
 x sq x sk, the output rows of heads x d.

  bk-attn-scores : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Real, Integer, Integer -> [Device] Integer
  bk-attn-scores (qb) (kb) (sb) (heads) (sq) (sk) (d) (scale) (n) (gid) =
    if gid < n then device-store-f32 sb gid (bk-dot qb kb (((gid - gid / (sq * sk) * sq * sk) / sk * heads + gid / (sq * sk)) * d) ((gid - gid / sk * sk) * heads * d + gid / (sq * sk) * d) 0 d 0.0 * scale) else 0

  bk-dot : Integer, Integer, Integer, Integer, Integer, Integer, Real -> [Device] Real
  bk-dot (ab) (bb) (ao) (bo) (t) (d) (acc) =
    if t >= d then acc else bk-dot ab bb ao bo (t + 1) d (acc + device-load-f32 ab (ao + t) * device-load-f32 bb (bo + t))

  bk-attn-values : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-attn-values (pb) (vb) (yb) (heads) (sq) (sk) (d) (n) (gid) =
    if gid < n then device-store-f32 yb gid (bk-weighted pb vb (((gid - gid / (heads * d) * heads * d) / d * sq + gid / (heads * d)) * sk) (gid - gid / (heads * d) * heads * d) (heads * d) 0 sk 0.0) else 0

  bk-weighted : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Real -> [Device] Real
  bk-weighted (pb) (vb) (po) (vo) (vstride) (j) (sk) (acc) =
    if j >= sk then acc else bk-weighted pb vb po vo vstride (j + 1) sk (acc + device-load-f32 pb (po + j) * device-load-f32 vb (vo + j * vstride))

Section: Layout

  bk-transpose : Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-transpose (xb) (yb) (rows) (cols) (n) (gid) =
    if gid < n then device-store-f32 yb gid (device-load-f32 xb ((gid - gid / rows * rows) * cols + gid / rows)) else 0

  bk-concat : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-concat (ab) (bb) (yb) (ca) (cb) (inner) (n) (gid) =
    if gid < n then device-store-f32 yb gid (bk-concat-at ab bb ca cb inner (gid / inner) gid) else 0

  bk-concat-at : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Real
  bk-concat-at (ab) (bb) (ca) (cb) (inner) (plane) (i) =
    let bt = plane / (ca + cb)
    in let ch = plane - bt * (ca + cb)
    in if ch < ca then device-load-f32 ab ((bt * ca + ch) * inner + i - plane * inner)
    else device-load-f32 bb ((bt * cb + ch - ca) * inner + i - plane * inner)

  bk-upsample : Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-upsample (xb) (yb) (h) (w) (n) (gid) =
    if gid < n then device-store-f32 yb gid (device-load-f32 xb (bk-upsample-src h w (gid / (4 * h * w)) gid)) else 0

  bk-upsample-src : Integer, Integer, Integer, Integer -> Integer
  bk-upsample-src (h) (w) (plane) (i) =
    let oy = (i - plane * 4 * h * w) / (2 * w)
    in plane * h * w + (oy / 2) * w + (i - plane * 4 * h * w - oy * 2 * w) / 2

Section: Timestep Embedding

 The LDM sinusoidal embedding as kernel-timestep-embedding, in f32 as Forge
 computes it: for half = dim / 2 and k < half, frequency
 e^(-log-period k / half), the row [cos (t f), sin (t f)].

  bk-timestep : Integer, Integer, Integer, Real, Integer, Integer -> [Device] Integer
  bk-timestep (tb) (yb) (dim) (log-period) (n) (gid) =
    if gid < n then device-store-f32 yb gid (bk-timestep-at (device-load-f32 tb (gid / dim)) (dim / 2) log-period (gid - gid / dim * dim)) else 0

  bk-timestep-at : Real, Integer, Real, Integer -> Real
  bk-timestep-at (tv) (half) (log-period) (j) =
    if j < half then real-cos (tv * bk-exp-of (0.0 - log-period * real-from-int j / real-from-int half))
    else real-sin (tv * bk-exp-of (0.0 - log-period * real-from-int (j - half) / real-from-int half))

Section: Linear

 y = x w^T + b, as kernel-linear-fast: x is mm rows of kk, w is nn rows of kk,
 b is nn wide, y is mm rows of nn. One workgroup of 256 threads per 16 x 16
 tile of y, tiles in row-major order, ceil (nn / 16) to a row; each 16-wide
 step of kk is staged in shared memory, x's tile at word 0, w's at word 256.
 Every thread reaches every barrier, so nothing above the store is guarded.

  bk-linear : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-linear (xb) (wb) (bb) (yb) (mm) (nn) (kk) (gid) = act
   t <- thread-idx-x
   bx <- block-idx-x
   bk-linear-tile xb wb bb yb mm nn kk (bx / ((nn + 15) / 16) * 16) ((bx - bx / ((nn + 15) / 16) * ((nn + 15) / 16)) * 16) (t / 16) (t - t / 16 * 16)
  end

  bk-linear-tile : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-linear-tile (xb) (wb) (bb) (yb) (mm) (nn) (kk) (r0) (c0) (ly) (lx) =
    bk-linear-out yb bb mm nn (r0 + ly) (c0 + lx) (bk-linear-acc xb wb mm nn kk (r0 + ly) (c0 + ly) ly lx 0 (real-approx-from-int 0))

  bk-linear-acc : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Real approximate -> [Device] Real approximate
  bk-linear-acc (xb) (wb) (mm) (nn) (kk) (row) (wrow) (ly) (lx) (k0) (acc) =
    if k0 >= kk then acc
    else act
     a <- shared-store-approx ((ly * 16 + lx) * 4) (bk-linear-x-at xb mm kk row (k0 + lx))
     b <- shared-store-approx ((256 + ly * 16 + lx) * 4) (bk-linear-w-at wb nn kk wrow (k0 + lx))
     s1 <- sync-threads
     d <- bk-linear-dot ly lx 0 acc
     s2 <- sync-threads
     bk-linear-acc xb wb mm nn kk row wrow ly lx (k0 + 16) d
    end

  bk-linear-x-at : Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-linear-x-at (xb) (rows) (cols) (r) (c) =
    if r < rows then (if c < cols then device-load-approx xb (r * cols + c) else real-approx-from-int 0) else real-approx-from-int 0

  bk-linear-w-at : Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-linear-w-at (wb) (rows) (cols) (r) (c) =
    if r < rows then (if c < cols then device-load-approx wb (r * cols + c) else real-approx-from-int 0) else real-approx-from-int 0

  bk-linear-dot : Integer, Integer, Integer, Real approximate -> [Device] Real approximate
  bk-linear-dot (ly) (lx) (k) (acc) =
    if k >= 16 then acc else bk-linear-dot ly lx (k + 1) (acc + shared-load-approx ((ly * 16 + k) * 4) * shared-load-approx ((256 + lx * 16 + k) * 4))

  bk-linear-out : Integer, Integer, Integer, Integer, Integer, Integer, Real approximate -> [Device] Integer
  bk-linear-out (yb) (bb) (mm) (nn) (row) (col) (v) =
    if row < mm then (if col < nn then device-store-approx yb (row * nn + col) (v + device-load-approx bb col) else 0) else 0

 bk-linear-h is bk-linear with w in packed f16 (SD and SDXL weights as a
 checkpoint stores them); x, b and y stay f32.

  bk-linear-h : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-linear-h (xb) (wb) (bb) (yb) (mm) (nn) (kk) (gid) = act
   t <- thread-idx-x
   bx <- block-idx-x
   bk-linear-h-tile xb wb bb yb mm nn kk (bx / ((nn + 15) / 16) * 16) ((bx - bx / ((nn + 15) / 16) * ((nn + 15) / 16)) * 16) (t / 16) (t - t / 16 * 16)
  end

  bk-linear-h-tile : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-linear-h-tile (xb) (wb) (bb) (yb) (mm) (nn) (kk) (r0) (c0) (ly) (lx) =
    bk-linear-out yb bb mm nn (r0 + ly) (c0 + lx) (bk-linear-h-acc xb wb mm nn kk (r0 + ly) (c0 + ly) ly lx 0 (real-approx-from-int 0))

  bk-linear-h-acc : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Real approximate -> [Device] Real approximate
  bk-linear-h-acc (xb) (wb) (mm) (nn) (kk) (row) (wrow) (ly) (lx) (k0) (acc) =
    if k0 >= kk then acc
    else act
     a <- shared-store-approx ((ly * 16 + lx) * 4) (bk-linear-x-at xb mm kk row (k0 + lx))
     b <- shared-store-approx ((256 + ly * 16 + lx) * 4) (bk-linear-wh-at wb nn kk wrow (k0 + lx))
     s1 <- sync-threads
     d <- bk-linear-dot ly lx 0 acc
     s2 <- sync-threads
     bk-linear-h-acc xb wb mm nn kk row wrow ly lx (k0 + 16) d
    end

  bk-linear-wh-at : Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-linear-wh-at (wb) (rows) (cols) (r) (c) =
    if r < rows then (if c < cols then device-load-f16-approx wb (r * cols + c) else real-approx-from-int 0) else real-approx-from-int 0

Section: Conv2d

 y = conv2d x w + b as an implicit GEMM, kernel-conv2d-wmma's contract with a
 cout bias: x is cin x h x wd, w is cout x (cin kh kw) in PyTorch order, y is
 cout x (oh ow). M = cout, N = oh ow, K = cin kh kw; 16 x 16 tiles of y as
 bk-linear, the weight tile at word 0 and the im2col tile, zero outside the
 image and past K, at word 256.

  bk-conv2d : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-conv2d (xb) (wb) (bb) (yb) (cin) (h) (wd) (cout) (kh) (kw) (stride) (pad) (oh) (ow) (gid) = act
   t <- thread-idx-x
   bx <- block-idx-x
   bk-conv-tile xb wb bb yb cin h wd cout kh kw stride pad ow (oh * ow) (bx / ((oh * ow + 15) / 16) * 16) ((bx - bx / ((oh * ow + 15) / 16) * ((oh * ow + 15) / 16)) * 16) (t / 16) (t - t / 16 * 16)
  end

  bk-conv-tile : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-conv-tile (xb) (wb) (bb) (yb) (cin) (h) (wd) (cout) (kh) (kw) (stride) (pad) (ow) (npix) (m0) (n0) (ly) (lx) =
    bk-conv-out yb bb cout npix (m0 + ly) (n0 + lx) (bk-conv-acc xb wb cin h wd cout kh kw stride pad ow npix (m0 + ly) (n0 + ly) ly lx 0 (real-approx-from-int 0))

  bk-conv-acc : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Real approximate -> [Device] Real approximate
  bk-conv-acc (xb) (wb) (cin) (h) (wd) (cout) (kh) (kw) (stride) (pad) (ow) (npix) (m) (n) (ly) (lx) (k0) (acc) =
    if k0 >= cin * kh * kw then acc
    else act
     a <- shared-store-approx ((ly * 16 + lx) * 4) (bk-conv-w-at wb cout (cin * kh * kw) m (k0 + lx))
     b <- shared-store-approx ((256 + ly * 16 + lx) * 4) (bk-conv-x-at xb cin h wd kh kw stride pad ow npix n (k0 + lx))
     s1 <- sync-threads
     d <- bk-linear-dot ly lx 0 acc
     s2 <- sync-threads
     bk-conv-acc xb wb cin h wd cout kh kw stride pad ow npix m n ly lx (k0 + 16) d
    end

  bk-conv-w-at : Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-conv-w-at (wb) (cout) (kk) (m) (kx) =
    if m < cout then (if kx < kk then device-load-approx wb (m * kk + kx) else real-approx-from-int 0) else real-approx-from-int 0

  bk-conv-x-at : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-conv-x-at (xb) (cin) (h) (wd) (kh) (kw) (stride) (pad) (ow) (npix) (n) (kx) =
    if n >= npix then real-approx-from-int 0
    else if kx >= cin * kh * kw then real-approx-from-int 0
    else let rest = kx - kx / (kh * kw) * (kh * kw)
    in bk-conv-x-pix xb h wd (kx / (kh * kw)) ((n / ow) * stride - pad + rest / kw) ((n - n / ow * ow) * stride - pad + rest - rest / kw * kw)

  bk-conv-x-pix : Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-conv-x-pix (xb) (h) (wd) (ci) (iy) (ix) =
    if iy < 0 then real-approx-from-int 0
    else if iy >= h then real-approx-from-int 0
    else if ix < 0 then real-approx-from-int 0
    else if ix >= wd then real-approx-from-int 0
    else device-load-approx xb ((ci * h + iy) * wd + ix)

  bk-conv-out : Integer, Integer, Integer, Integer, Integer, Integer, Real approximate -> [Device] Integer
  bk-conv-out (yb) (bb) (cout) (npix) (m) (n) (v) =
    if m < cout then (if n < npix then device-store-approx yb (m * npix + n) (v + device-load-approx bb m) else 0) else 0

Section: Element-wise

  bk-add-channel : Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-add-channel (xb) (cb) (yb) (hw) (n) (gid) =
    if gid < n then device-store-f32 yb gid (device-load-f32 xb gid + device-load-f32 cb (gid / hw)) else 0

  bk-scale : Integer, Integer, Real, Integer, Integer -> [Device] Integer
  bk-scale (xb) (yb) (s) (n) (gid) =
    if gid < n then device-store-f32 yb gid (device-load-f32 xb gid * s) else 0

 The sampler's a x + b y + c z. WebGPU refuses one buffer bound twice as
 writable storage, so out is never x, y or z here.

  bk-lincomb3 : Integer, Integer, Integer, Integer, Real, Real, Real, Integer, Integer -> [Device] Integer
  bk-lincomb3 (xb) (yb) (zb) (ob) (a) (b) (c) (n) (gid) =
    if gid < n then device-store-f32 ob gid (a * device-load-f32 xb gid + b * device-load-f32 yb gid + c * device-load-f32 zb gid) else 0

  bk-add : Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-add (ab) (bb) (yb) (n) (gid) =
    if gid < n then device-store-f32 yb gid (device-load-f32 ab gid + device-load-f32 bb gid) else 0
