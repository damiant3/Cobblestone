  bk-attn-p-at : Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-attn-p-at (pb) (sq) (sk) (h) (r) (c) =
    if r < sq then (if c < sk then device-load-approx pb ((h * sq + r) * sk + c) else real-approx-from-int 0) else real-approx-from-int 0

  bk-attn-v-at : Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-attn-v-at (vb) (heads) (rows) (d) (h) (j) (c) =
    if j < rows then (if c < d then device-load-approx vb ((j * heads + h) * d + c) else real-approx-from-int 0) else real-approx-from-int 0

