  end

  bk-conv-4x4 : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate -> [Device] Integer
  bk-conv-4x4 (xb) (wb) (bb) (yb) (cin) (h) (wd) (cout) (kh) (kw) (stride) (pad) (half) (ow) (npix) (m0) (n0) (ly) (lx) (k0) (k) (a00) (a01) (a02) (a03) (a10) (a11) (a12) (a13) (a20) (a21) (a22) (a23) (a30) (a31) (a32) (a33) =
    if k >= 16 & k0 >= cin * kh * kw then bk-conv-store16 yb bb cout npix (m0 + ly) (n0 + lx) a00 a01 a02 a03 a10 a11 a12 a13 a20 a21 a22 a23 a30 a31 a32 a33
    else if k >= 16 then act
     s0 <- sync-threads
     p0 <- shared-store-approx ((lx * 65 + ly) * 4) (bk-conv-w-at wb half cout (cin * kh * kw) (m0 + ly) (k0 + lx))
     p1 <- shared-store-approx ((lx * 65 + ly + 16) * 4) (bk-conv-w-at wb half cout (cin * kh * kw) (m0 + ly + 16) (k0 + lx))
     p2 <- shared-store-approx ((lx * 65 + ly + 32) * 4) (bk-conv-w-at wb half cout (cin * kh * kw) (m0 + ly + 32) (k0 + lx))
     p3 <- shared-store-approx ((lx * 65 + ly + 48) * 4) (bk-conv-w-at wb half cout (cin * kh * kw) (m0 + ly + 48) (k0 + lx))
     q0 <- shared-store-approx ((1040 + lx * 65 + ly) * 4) (bk-conv-x-at xb cin h wd kh kw stride pad ow npix (n0 + ly) (k0 + lx))
     q1 <- shared-store-approx ((1040 + lx * 65 + ly + 16) * 4) (bk-conv-x-at xb cin h wd kh kw stride pad ow npix (n0 + ly + 16) (k0 + lx))
     q2 <- shared-store-approx ((1040 + lx * 65 + ly + 32) * 4) (bk-conv-x-at xb cin h wd kh kw stride pad ow npix (n0 + ly + 32) (k0 + lx))
     q3 <- shared-store-approx ((1040 + lx * 65 + ly + 48) * 4) (bk-conv-x-at xb cin h wd kh kw stride pad ow npix (n0 + ly + 48) (k0 + lx))
     s1 <- sync-threads
     bk-conv-4x4 xb wb bb yb cin h wd cout kh kw stride pad half ow npix m0 n0 ly lx (k0 + 16) 0 a00 a01 a02 a03 a10 a11 a12 a13 a20 a21 a22 a23 a30 a31 a32 a33
    end
    else act
     x0 <- shared-load-approx ((k * 65 + ly) * 4)
     x1 <- shared-load-approx ((k * 65 + ly + 16) * 4)
     x2 <- shared-load-approx ((k * 65 + ly + 32) * 4)
     x3 <- shared-load-approx ((k * 65 + ly + 48) * 4)
     w0 <- shared-load-approx ((1040 + k * 65 + lx) * 4)
     w1 <- shared-load-approx ((1040 + k * 65 + lx + 16) * 4)
     w2 <- shared-load-approx ((1040 + k * 65 + lx + 32) * 4)
     w3 <- shared-load-approx ((1040 + k * 65 + lx + 48) * 4)
     bk-conv-4x4 xb wb bb yb cin h wd cout kh kw stride pad half ow npix m0 n0 ly lx k0 (k + 1) (a00 + x0 * w0) (a01 + x0 * w1) (a02 + x0 * w2) (a03 + x0 * w3) (a10 + x1 * w0) (a11 + x1 * w1) (a12 + x1 * w2) (a13 + x1 * w3) (a20 + x2 * w0) (a21 + x2 * w1) (a22 + x2 * w2) (a23 + x2 * w3) (a30 + x3 * w0) (a31 + x3 * w1) (a32 + x3 * w2) (a33 + x3 * w3)
    end

  bk-conv-store16 : Integer, Integer, Integer, Integer, Integer, Integer, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate, Real approximate -> [Device] Integer
  bk-conv-store16 (yb) (bb) (cout) (npix) (m) (n) (a00) (a01) (a02) (a03) (a10) (a11) (a12) (a13) (a20) (a21) (a22) (a23) (a30) (a31) (a32) (a33) = act
   s00 <- bk-conv-out yb bb cout npix m n a00
   s01 <- bk-conv-out yb bb cout npix m (n + 16) a01
   s02 <- bk-conv-out yb bb cout npix m (n + 32) a02
   s03 <- bk-conv-out yb bb cout npix m (n + 48) a03
   s10 <- bk-conv-out yb bb cout npix (m + 16) n a10
   s11 <- bk-conv-out yb bb cout npix (m + 16) (n + 16) a11
   s12 <- bk-conv-out yb bb cout npix (m + 16) (n + 32) a12
   s13 <- bk-conv-out yb bb cout npix (m + 16) (n + 48) a13
   s20 <- bk-conv-out yb bb cout npix (m + 32) n a20
   s21 <- bk-conv-out yb bb cout npix (m + 32) (n + 16) a21
   s22 <- bk-conv-out yb bb cout npix (m + 32) (n + 32) a22
   s23 <- bk-conv-out yb bb cout npix (m + 32) (n + 48) a23
   s30 <- bk-conv-out yb bb cout npix (m + 48) n a30
   s31 <- bk-conv-out yb bb cout npix (m + 48) (n + 16) a31
   s32 <- bk-conv-out yb bb cout npix (m + 48) (n + 32) a32
   s33 <- bk-conv-out yb bb cout npix (m + 48) (n + 48) a33
   0
  end

  bk-conv-w-at : Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-conv-w-at (wb) (half) (cout) (kk) (m) (kx) =
    if half == 1 then bk-linear-wh-at wb cout kk m kx else bk-linear-w-at wb cout kk m kx

  bk-conv-x-at : Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-conv-x-at (xb) (cin) (h) (wd) (kh) (kw) (stride) (pad) (ow) (npix) (n) (kx) =
    if n >= npix then real-approx-from-int 0
    else if kx >= cin * kh * kw then real-approx-from-int 0
    else let rest = kx - kx / (kh * kw) * (kh * kw)
    in bk-conv-x-pix xb h wd (kx / (kh * kw)) ((n / ow) * stride - pad + rest / kw) ((n - n / ow * ow) * stride - pad + rest - rest / kw * kw)

  bk-conv-x-pix : Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Real approximate
  bk-conv-x-pix (xb) (h) (wd) (ci) (iy) (ix) =
    if iy < 0 then real-approx-from-int 0
    else if iy >= h then real-approx-from-int 0
    else if ix < 0 then real-approx-from-int 0
    else if ix >= wd then real-approx-from-int 0
    else device-load-approx xb ((ci * h + iy) * wd + ix)

  bk-conv-out : Integer, Integer, Integer, Integer, Integer, Integer, Real approximate -> [Device] Integer
  bk-conv-out (yb) (bb) (cout) (npix) (m) (n) (v) =
    if m < cout then (if n < npix then device-store-approx yb (m * npix + n) (v + device-load-approx bb m) else 0) else 0

Section: Element-wise

  bk-add-channel : Integer, Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-add-channel (xb) (cb) (yb) (hw) (n) (gid) =
    if gid < n then device-store-f32 yb gid (device-load-f32 xb gid + device-load-f32 cb (gid / hw)) else 0

  bk-scale : Integer, Integer, Real, Integer, Integer -> [Device] Integer
  bk-scale (xb) (yb) (s) (n) (gid) =
    if gid < n then device-store-f32 yb gid (device-load-f32 xb gid * s) else 0

 The sampler's a x + b y + c z. WebGPU refuses one buffer bound twice as
 writable storage, so out is never x, y or z here.

  bk-lincomb3 : Integer, Integer, Integer, Integer, Real, Real, Real, Integer, Integer -> [Device] Integer
  bk-lincomb3 (xb) (yb) (zb) (ob) (a) (b) (c) (n) (gid) =
    if gid < n then device-store-f32 ob gid (a * device-load-f32 xb gid + b * device-load-f32 yb gid + c * device-load-f32 zb gid) else 0

  bk-add : Integer, Integer, Integer, Integer, Integer -> [Device] Integer
  bk-add (ab) (bb) (yb) (n) (gid) =
    if gid < n then device-store-f32 yb gid (device-load-f32 ab gid + device-load-f32 bb gid) else 0
