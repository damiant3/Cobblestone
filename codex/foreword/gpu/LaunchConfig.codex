Chapter: LaunchConfig

 Launch configuration for a GPU kernel. Specifies grid dimensions
 (number of thread blocks), block dimensions (threads per block),
 and shared memory budget in bytes.

 We say:

Section: Types

  LaunchConfig = record {
    lc-grid-x : Integer,
    lc-grid-y : Integer,
    lc-grid-z : Integer,
    lc-block-x : Integer,
    lc-block-y : Integer,
    lc-block-z : Integer,
    lc-shared-bytes : Integer
  }

Section: Construction

  launch-config-1d : Integer, Integer -> LaunchConfig
  launch-config-1d (grid) (block) =
    LaunchConfig {
      lc-grid-x = grid, lc-grid-y = 1, lc-grid-z = 1,
      lc-block-x = block, lc-block-y = 1, lc-block-z = 1,
      lc-shared-bytes = 0
    }

  launch-config-for-num-elems : Integer -> LaunchConfig
  launch-config-for-num-elems (n) =
    let block-size = 256
    in let grid-size = (n + block-size - 1) / block-size
    in launch-config-1d grid-size block-size

