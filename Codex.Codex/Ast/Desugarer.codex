Chapter: Desugarer
  cites Codex chapter Text
  cites Codex chapter Lists

 Transforms the concrete syntax tree into the abstract syntax tree.
 Tokens become Names, literal token text becomes literal values,
 parenthesized nodes are removed, binary operators are resolved, and
 a SourceSpan is carried on every AST node. Compound nodes without
 a natural source token inherit a span from a sub-expression (or fall
 back to synthetic) and are tagged ProvDesugared.

Section: Span Helpers
  token-span : Token -> SourceSpan
  token-span (tok) =
   span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id)

  desugared-span : SourceSpan -> SourceSpan
  desugared-span (s) =
   span-with-provenance s ProvDesugared

Section: Fuel Budget

 Recursive desugaring is capped at max-recursion-depth stack
 frames. On exhaustion, return an AErrorExpr sentinel; the
 message rides through the AST and downstream phases surface
 the failure as an ErrorTy. Bails rather than stack-overflow.

  max-recursion-depth : Integer = 256

Section: Expression Desugaring
  desugar-expr : Expr -> AExpr
  desugar-expr (node) = desugar-expr-at node 0

  desugar-expr-at : Expr -> Integer -> AExpr
  desugar-expr-at (node) (depth) =
   if depth >= max-recursion-depth then deck-record (AErrorExpr "desugar fuel exhausted" synthetic-span)
   else when node
    is LitExpr (tok) -> desugar-literal tok
    is NameExpr (tok) -> deck-record (ANameExpr (make-name (token-text tok)) (token-span tok))
    is AppExpr (f) (a) ->
     let df = desugar-expr-at f (depth + 1)
     in let da = desugar-expr-at a (depth + 1)
     in deck-record (AApplyExpr df da (desugared-span (aexpr-span df)))
    is BinExpr (l) (op) (r) ->
     let dl = desugar-expr-at l (depth + 1)
     in let dr = desugar-expr-at r (depth + 1)
     in deck-record (ABinaryExpr dl (desugar-bin-op (op.kind)) dr (token-span op))
    is UnaryExpr (op) (operand) -> deck-record (AUnaryExpr (desugar-expr-at operand (depth + 1)) (token-span op))
    is IfExpr (c) (t) (e) ->
     let dc = desugar-expr-at c (depth + 1)
     in deck-record (AIfExpr dc (desugar-expr-at t (depth + 1)) (desugar-expr-at e (depth + 1)) (desugared-span (aexpr-span dc)))
    is LetExpr (bindings) (body) ->
     let db = desugar-expr-at body (depth + 1)
     in deck-record (ALetExpr (map-list desugar-let-bind bindings) db (desugared-span (aexpr-span db)))
    is MatchExpr (scrut) (arms) ->
     let ds = desugar-expr-at scrut (depth + 1)
     in deck-record (AMatchExpr ds (map-list desugar-match-arm arms) (desugared-span (aexpr-span ds)))
    is ListExpr (elems) -> deck-record (AListExpr (map-list desugar-expr elems) synthetic-span)
    is RecordExpr (type-tok) (fields) -> deck-record (ARecordExpr (make-name (token-text type-tok)) (map-list desugar-field-expr fields) (token-span type-tok))
    is FieldExpr (rec) (field-tok) -> deck-record (AFieldAccess (desugar-expr-at rec (depth + 1)) (make-name (token-text field-tok)) (token-span field-tok))
    is ParenExpr (inner) -> desugar-expr-at inner (depth + 1)
    is ActExpr (stmts) -> deck-record (AActExpr (map-list desugar-act-stmt stmts) synthetic-span)
    is HandleExpr (eff-tok) (body) (clauses) -> deck-record (AHandleExpr (make-name (token-text eff-tok)) (desugar-expr-at body (depth + 1)) (map-list desugar-handle-clause clauses) (token-span eff-tok))
    is LambdaExpr (params) (body) -> deck-record (ALambdaExpr (map-list desugar-lambda-param params) (desugar-expr-at body (depth + 1)) synthetic-span)
    is ErrExpr (tok) -> deck-record (AErrorExpr (token-text tok) (token-span tok))

  literal-body-length : Token -> Integer
  literal-body-length (tok) =
   if tok.length < 2 then 0 else tok.length - 2

  decode-char-literal-value : Token -> Text
  decode-char-literal-value (tok) =
   let body-off = tok.offset + 1
   in let body-len = literal-body-length tok
   in if body-len <= 0 then "0"
      else let c0 = char-code-at (tok.source) body-off
      in if c0 == cc-backslash then if body-len < 2 then integer-to-text c0
            else let nc = char-code-at (tok.source) (body-off + 1)
            in let val = if nc == cc-lower-n then cc-newline
                  else if nc == cc-lower-t then cc-space
                  else if nc == cc-lower-r then cc-newline
                  else if nc == cc-backslash then cc-backslash
                  else if nc == cc-single-quote then cc-single-quote
                  else nc
            in integer-to-text val
         else integer-to-text c0

  literal-value-text : Token -> Text
  literal-value-text (tok) =
   when tok.kind
    is TextLiteral -> decode-escapes (substring (tok.source) (tok.offset + 1) (literal-body-length tok))
    is CharLiteral -> decode-char-literal-value tok
    is otherwise -> token-text tok

  desugar-literal : Token -> AExpr
  desugar-literal (tok) =
   if is-literal (tok.kind) then deck-record (ALitExpr (literal-value-text tok) (classify-literal (tok.kind)) (token-span tok))
   else deck-record (AErrorExpr (token-text tok) (token-span tok))

  classify-literal : TokenKind -> LiteralKind
  classify-literal (k) =
   when k
    is IntegerLiteral -> IntLit
    is NumberLiteral -> NumLit
    is TextLiteral -> TextLit
    is CharLiteral -> CharLit
    is TrueKeyword -> BoolLit
    is FalseKeyword -> BoolLit
    is otherwise -> TextLit

  desugar-let-bind : LetBind -> ALetBind
  desugar-let-bind (b) =
   deck-record (ALetBind {
    name = make-name (token-text (b.name)),
    value = desugar-expr (b.value),
    span = token-span (b.name)
   })

  desugar-match-arm : MatchArm -> AMatchArm
  desugar-match-arm (arm) =
   let dp = desugar-pattern (arm.pattern)
   in deck-record (AMatchArm {
    pattern = dp,
    body = desugar-expr (arm.body),
    span = apat-span dp
   })

  desugar-field-expr : RecordFieldExpr -> AFieldExpr
  desugar-field-expr (f) =
   deck-record (AFieldExpr {
    name = make-name (token-text (f.name)),
    value = desugar-expr (f.value),
    span = token-span (f.name)
   })

  desugar-act-stmt : ActStmt -> AActStmt
  desugar-act-stmt (s) =
   when s
    is ActBindStmt (tok) (val) -> deck-record (AActBindStmt (make-name (token-text tok)) (desugar-expr val) (token-span tok))
    is ActExprStmt (e) ->
     let de = desugar-expr e
     in deck-record (AActExprStmt de (aexpr-span de))

  desugar-handle-clause : HandleClause -> AHandleClause
  desugar-handle-clause (c) =
   deck-record (AHandleClause {
    op-name = make-name (token-text (c.op-name)),
    resume-name = make-name (token-text (c.resume-name)),
    body = desugar-expr (c.body),
    span = token-span (c.op-name)
   })

  desugar-lambda-param : Token -> Name
  desugar-lambda-param (tok) =
   make-name (token-text tok)

Section: Binary Operator Desugaring
  desugar-bin-op : TokenKind -> BinaryOp
  desugar-bin-op (k) =
   when k
    is Plus -> OpAdd
    is Minus -> OpSub
    is Star -> OpMul
    is Slash -> OpDiv
    is Caret -> OpPow
    is DoubleEquals -> OpEq
    is NotEquals -> OpNotEq
    is LessThan -> OpLt
    is GreaterThan -> OpGt
    is LessOrEqual -> OpLtEq
    is GreaterOrEqual -> OpGtEq
    is TripleEquals -> OpDefEq
    is PlusPlus -> OpAppend
    is ColonColon -> OpCons
    is Ampersand -> OpAnd
    is Pipe -> OpOr
    is otherwise -> OpAdd

Section: Pattern Desugaring
  apat-span : APat -> SourceSpan
  apat-span (p) =
   when p
    is AVarPat (n) (s) -> s
    is ALitPat (t) (k) (s) -> s
    is ACtorPat (n) (sub) (s) -> s
    is AWildPat (s) -> s

  desugar-pattern : Pat -> APat
  desugar-pattern (p) = desugar-pattern-at p 0

  desugar-pattern-at : Pat -> Integer -> APat
  desugar-pattern-at (p) (depth) =
   if depth >= max-recursion-depth then deck-record (AWildPat synthetic-span)
   else when p
    is VarPat (tok) -> deck-record (AVarPat (make-name (token-text tok)) (token-span tok))
    is LitPat (tok) -> deck-record (ALitPat (literal-value-text tok) (classify-literal (tok.kind)) (token-span tok))
    is CtorPat (tok) (subs) -> deck-record (ACtorPat (make-name (token-text tok)) (map-list desugar-pattern subs) (token-span tok))
    is WildPat (tok) -> deck-record (AWildPat (token-span tok))

Section: Type Desugaring
  desugar-type-expr : TypeExpr -> ATypeExpr
  desugar-type-expr (t) = desugar-type-expr-at t 0

  desugar-type-expr-at : TypeExpr -> Integer -> ATypeExpr
  desugar-type-expr-at (t) (depth) =
   if depth >= max-recursion-depth then deck-record (ANamedType (make-name "_fuel") synthetic-span)
   else when t
    is NamedType (tok) -> deck-record (ANamedType (make-name (token-text tok)) (token-span tok))
    is FunType (param) (ret) ->
     let dp = desugar-type-expr-at param (depth + 1)
     in deck-record (AFunType dp (desugar-type-expr-at ret (depth + 1)) (atype-span dp))
    is AppType (ctor) (args) ->
     let dc = desugar-type-expr-at ctor (depth + 1)
     in deck-record (AAppType dc (map-list desugar-type-expr args) (atype-span dc))
    is ParenType (inner) -> desugar-type-expr-at inner (depth + 1)
    is ListType (elem) ->
     let de = desugar-type-expr-at elem (depth + 1)
     in deck-record (AAppType (deck-record (ANamedType (make-name "List") (atype-span de))) [de] (atype-span de))
    is LinearTypeExpr (inner) -> desugar-type-expr-at inner (depth + 1)
    is EffectTypeExpr (effs) (ret) ->
     let dr = desugar-type-expr-at ret (depth + 1)
     in deck-record (AEffectType (map-list make-type-param-name effs) dr (atype-span dr))
    is BoundedIntType (base) (lo) (hi) (mode) ->
     let db = desugar-type-expr-at base (depth + 1)
     in deck-record (ABoundedIntType db lo hi mode (atype-span db))

  atype-span : ATypeExpr -> SourceSpan
  atype-span (t) =
   when t
    is ANamedType (n) (s) -> s
    is AFunType (p) (r) (s) -> s
    is AAppType (c) (args) (s) -> s
    is AEffectType (effs) (r) (s) -> s
    is ABoundedIntType (b) (lo) (hi) (mode) (s) -> s

Section: Definition Desugaring
  desugar-def : Def -> ADef
  desugar-def (d) =
   let ann-types = desugar-annotations (d.ann)
   in deck-record (ADef {
    name = make-name (token-text (d.name)),
    params = map-list desugar-param (d.params),
    declared-type = ann-types,
    body = desugar-expr (d.body),
    chapter-slug = d.chapter-slug,
    span = token-span (d.name)
   })

  desugar-annotations : List TypeAnn -> List ATypeExpr
  desugar-annotations (anns) =
   if list-length anns == 0 then []
   else let a = list-at anns 0
   in [desugar-type-expr (a.type-expr)]

  desugar-param : Token -> AParam
  desugar-param (tok) =
   deck-record (AParam { name = make-name (token-text tok), span = token-span tok })

  desugar-type-def : TypeDef -> ATypeDef
  desugar-type-def (td) =
   when td.body
    is RecordBody (fields) -> deck-record (ARecordTypeDef (make-name (token-text (td.name))) (map-list make-type-param-name (td.type-params)) (map-list desugar-record-field-def fields) (token-span (td.name)))
    is VariantBody (ctors) -> deck-record (AVariantTypeDef (make-name (token-text (td.name))) (map-list make-type-param-name (td.type-params)) (map-list desugar-variant-ctor-def ctors) (token-span (td.name)))

  make-type-param-name : Token -> Name
  make-type-param-name (tok) =
   make-name (token-text tok)

  desugar-record-field-def : RecordFieldDef -> ARecordFieldDef
  desugar-record-field-def (f) =
   deck-record (ARecordFieldDef {
    name = make-name (token-text (f.name)),
    type-expr = desugar-type-expr (f.type-expr),
    span = token-span (f.name)
   })

  desugar-variant-ctor-def : VariantCtorDef -> AVariantCtorDef
  desugar-variant-ctor-def (c) =
   deck-record (AVariantCtorDef {
    name = make-name (token-text (c.name)),
    fields = map-list desugar-type-expr (c.fields),
    span = token-span (c.name)
   })

Section: Document Desugaring
  desugar-document : Text -> Document -> Text -> AChapter
  desugar-document (source) (doc) (chapter-name) =
   deck-record (AChapter {
    name = make-name chapter-name,
    defs = map-list desugar-def (doc.defs),
    type-defs = map-list desugar-type-def (doc.type-defs),
    effect-defs = map-list desugar-effect-def (doc.effect-defs),
    citations = map-list desugar-cite (doc.citations),
    chapter-title = doc.chapter-title,
    prose = "",
    section-titles = doc.section-titles,
    span = synthetic-span
   })

  desugar-cite : CitesDecl -> ACitesDecl
  desugar-cite (imp) =
   deck-record (ACitesDecl {
    quire = make-name (token-text (imp.quire)),
    chapter-name = make-name (imp.chapter-name),
    selected-names = map-list desugar-cite-name (imp.selected-names),
    citing-chapter = imp.citing-chapter,
    span = token-span (imp.quire)
   })

  desugar-cite-name : Token -> Name
  desugar-cite-name (tok) =
   make-name (token-text tok)

  desugar-effect-def : EffectDef -> AEffectDef
  desugar-effect-def (ed) =
   deck-record (AEffectDef {
    name = make-name (token-text (ed.name)),
    ops = map-list desugar-effect-op (ed.ops),
    span = token-span (ed.name)
   })

  desugar-effect-op : EffectOpDef -> AEffectOpDef
  desugar-effect-op (op) =
   deck-record (AEffectOpDef {
    name = make-name (token-text (op.name)),
    type-expr = desugar-type-expr (op.type-expr),
    span = token-span (op.name)
   })

