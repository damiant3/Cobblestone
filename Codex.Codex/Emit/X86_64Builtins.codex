Section: Builtin Detection

 Builtin names are kept in a SkipListText, sorted by the same
 text-compare that skip-list-text-has uses. Source-order here is
 ASCII for human readability; skip-list-text-from-list sorts the
 literal into the skip list at binding-init time, not per
 is-builtin call.

  sorted-builtin-names : SkipListText
  sorted-builtin-names = skip-list-text-from-list [
   "abs",
   "bit-and",
   "bit-not",
   "bit-or",
   "bit-shl",
   "bit-shr",
   "bit-xor",
   "__buf-read-bytes",
   "__buf-write-byte",
   "__buf-write-bytes",
   "char-at",
   "char-code",
   "char-code-at",
   "char-to-text",
   "code-to-char",
   "current-dir",
   "__deck-alloc",
   "__deck-pos",
   "__deck-set",
   "file-exists",
   "get-args",
   "__heap-advance",
   "__heap-restore",
   "__heap-save",
   "int-mod",
   "integer-to-text",
   "is-digit",
   "is-letter",
   "is-whitespace",
   "__linked-list-empty",
   "__linked-list-push",
   "__linked-list-to-list",
   "list-append",
   "list-at",
   "list-cons",
   "list-insert-at",
   "list-length",
   "list-set-at",
   "list-snoc",
   "__list-with-capacity",
   "max",
   "min",
   "__narrow",
   "negate",
   "print-line",
   "print-error",
   "read-file",
   "read-line",
   "__record-set",
   "run-state",
   "set-state",
   "show",
   "substring",
   "text-compare",
   "text-concat-list",
   "text-contains",
   "text-length",
   "text-replace",
   "text-split",
   "text-starts-with",
   "text-to-double-bits",
   "text-to-integer",
   "write-binary",
   "write-file"
  ]

  is-builtin : SkipListText -> Text -> Boolean
  is-builtin (names) (name) =
   skip-list-text-has names name

Section: Builtin Emission
  emit-helper-call-1 : CodegenState -> List IRExpr -> Text -> EmitResult
  emit-helper-call-1 (st) (args) (helper) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = st-append-text (r.state) (mov-rr reg-rdi (r.reg))
   in let st2 = emit-call-to st1 helper
   in let tmp = alloc-temp st2
   in EmitResult {
   state = st-append-text (tmp.state) (mov-rr (tmp.reg) reg-rax),
   reg = tmp.reg
  }

  emit-helper-call-2 : CodegenState -> List IRExpr -> Text -> EmitResult
  emit-helper-call-2 (st) (args) (helper) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc = alloc-local (r0.state)
   in let st1 = store-local (loc.state) (loc.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let loaded = load-local (r1.state) (loc.reg)
   in let st2 = st-append-text (loaded.state) (mov-rr reg-rsi (r1.reg))
   in let st3 = st-append-text st2 (mov-rr reg-rdi (loaded.reg))
   in let st4 = emit-call-to st3 helper
   in let tmp = alloc-temp st4
   in EmitResult {
   state = st-append-text (tmp.state) (mov-rr (tmp.reg) reg-rax),
   reg = tmp.reg
  }

  emit-helper-call-3 : CodegenState -> List IRExpr -> Text -> EmitResult
  emit-helper-call-3 (st) (args) (helper) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let loc1 = alloc-local (r1.state)
   in let st2 = store-local (loc1.state) (loc1.reg) (r1.reg)
   in let r2 = emit-expr st2 (list-at args 2)
   in let st3 = st-append-text (r2.state) (mov-rr reg-rdx (r2.reg))
   in let ld1 = load-local st3 (loc1.reg)
   in let st4 = st-append-text (ld1.state) (mov-rr reg-rsi (ld1.reg))
   in let ld0 = load-local st4 (loc0.reg)
   in let st5 = st-append-text (ld0.state) (mov-rr reg-rdi (ld0.reg))
   in let st6 = emit-call-to st5 helper
   in let tmp = alloc-temp st6
   in EmitResult {
   state = st-append-text (tmp.state) (mov-rr (tmp.reg) reg-rax),
   reg = tmp.reg
  }

  emit-text-length-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-text-length-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let tmp = alloc-temp (r.state)
   in EmitResult {
   state = st-append-text (tmp.state) (mov-load (tmp.reg) (r.reg) 0),
   reg = tmp.reg
  }

  emit-list-length-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-list-length-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let tmp = alloc-temp (r.state)
   in EmitResult {
   state = st-append-text (tmp.state) (mov-load (tmp.reg) (r.reg) 0),
   reg = tmp.reg
  }

  emit-list-at-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-list-at-builtin (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc = alloc-local (r0.state)
   in let st1 = store-local (loc.state) (loc.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let list-loaded = load-local (r1.state) (loc.reg)
   in let addr = alloc-temp (list-loaded.state)
   in let st2 = st-append-text (addr.state) (mov-rr (addr.reg) (r1.reg))
   in let st3 = st-append-text st2 (shl-ri (addr.reg) 3)
   in let st4 = st-append-text st3 (add-rr (addr.reg) (list-loaded.reg))
   in let rd = alloc-temp st4
   in EmitResult {
   state = st-append-text (rd.state) (mov-load (rd.reg) (addr.reg) 8),
   reg = rd.reg
  }

  emit-char-at-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-char-at-builtin (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc = alloc-local (r0.state)
   in let st1 = store-local (loc.state) (loc.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let str-loaded = load-local (r1.state) (loc.reg)
   in let rd = alloc-temp (str-loaded.state)
   in let st2 = st-append-text (rd.state) (mov-rr (rd.reg) (r1.reg))
   in let st3 = st-append-text st2 (add-rr (rd.reg) (str-loaded.reg))
   in let st4 = st-append-text st3 (movzx-byte (rd.reg) (rd.reg) 8)
   in EmitResult {
   state = st4,
   reg = rd.reg
  }

  emit-char-code-at-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-char-code-at-builtin (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc = alloc-local (r0.state)
   in let st1 = store-local (loc.state) (loc.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let text-loaded = load-local (r1.state) (loc.reg)
   in let rd = alloc-temp (text-loaded.state)
   in let st2 = st-append-text (rd.state) (mov-rr (rd.reg) (text-loaded.reg))
   in let st3 = st-append-text st2 (add-rr (rd.reg) (r1.reg))
   in let st4 = st-append-text st3 (movzx-byte (rd.reg) (rd.reg) 8)
   in EmitResult {
   state = st4,
   reg = rd.reg
  }

  emit-char-to-text-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-char-to-text-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc = alloc-local (r.state)
   in let st1 = store-local (loc.state) (loc.reg) (r.reg)
   in let ptr-loc = alloc-local st1
   in let ptr-tmp = alloc-temp (ptr-loc.state)
   in let st2 = st-append-text (ptr-tmp.state) (mov-rr (ptr-tmp.reg) reg-r10)
   in let st3 = store-local st2 (ptr-loc.reg) (ptr-tmp.reg)
   in let st4 = st-append-text st3 (add-ri reg-r10 16)
   in let st5 = st-append-text st4 (li reg-r11 1)
   in let ptr-loaded = load-local st5 (ptr-loc.reg)
   in let st6 = st-append-text (ptr-loaded.state) (mov-store (ptr-loaded.reg) reg-r11 0)
   in let code-loaded = load-local st6 (loc.reg)
   in let ptr-loaded2 = load-local (code-loaded.state) (ptr-loc.reg)
   in let st7 = st-append-text (ptr-loaded2.state) (mov-store-byte (ptr-loaded2.reg) (code-loaded.reg) 8)
   in let result = load-local st7 (ptr-loc.reg)
   in EmitResult {
   state = result.state,
   reg = result.reg
  }

  emit-is-letter-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-is-letter-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (r.state)
   in let st0 = st-append-text (rd.state) (mov-rr (rd.reg) (r.reg))
   in let st1 = st-append-text st0 (sub-ri (rd.reg) 13)
   in let st2 = st-append-text st1 (cmp-ri (rd.reg) 51)
   in let st3 = st-append-text st2 (setcc cc-be (rd.reg))
   in let st4 = st-append-text st3 (movzx-byte-self (rd.reg))
   in EmitResult {
   state = st4,
   reg = rd.reg
  }

  emit-is-digit-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-is-digit-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (r.state)
   in let st0 = st-append-text (rd.state) (mov-rr (rd.reg) (r.reg))
   in let st1 = st-append-text st0 (sub-ri (rd.reg) 3)
   in let st2 = st-append-text st1 (cmp-ri (rd.reg) 9)
   in let st3 = st-append-text st2 (setcc cc-be (rd.reg))
   in let st4 = st-append-text st3 (movzx-byte-self (rd.reg))
   in EmitResult {
   state = st4,
   reg = rd.reg
  }

  emit-is-whitespace-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-is-whitespace-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (r.state)
   in let st0 = st-append-text (rd.state) (mov-rr (rd.reg) (r.reg))
   in let st1 = st-append-text st0 (cmp-ri (rd.reg) 2)
   in let st2 = st-append-text st1 (setcc cc-be (rd.reg))
   in let st3 = st-append-text st2 (movzx-byte-self (rd.reg))
   in EmitResult {
   state = st3,
   reg = rd.reg
  }

  emit-negate-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-negate-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (r.state)
   in let st1 = st-append-text (rd.state) (mov-rr (rd.reg) (r.reg))
   in let st2 = st-append-text st1 (neg-r (rd.reg))
   in EmitResult {
   state = st2,
   reg = rd.reg
  }

  emit-narrow-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-narrow-builtin (st) (args) =
   emit-expr st (list-at args 0)

  emit-abs-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-abs-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (r.state)
   in let st1 = st-append-text (rd.state) (mov-rr (rd.reg) (r.reg))
   in let st2 = st-append-text st1 (test-rr (rd.reg) (rd.reg))
   in let jge-pos = st2.text-len
   in let st3 = st-append-text st2 (jcc cc-ge 0)
   in let st4 = st-append-text st3 (neg-r (rd.reg))
   in let st5 = patch-jcc-at st4 jge-pos (st4.text-len)
   in EmitResult {
    state = st5,
    reg = rd.reg
   }

  emit-min-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-min-builtin (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let ld0 = load-local (r1.state) (loc0.reg)
   in let rd = alloc-temp (ld0.state)
   in let st2 = st-append-text (rd.state) (mov-rr (rd.reg) (ld0.reg))
   in let st3 = st-append-text st2 (cmp-rr (rd.reg) (r1.reg))
   in let jle-pos = st3.text-len
   in let st4 = st-append-text st3 (jcc cc-le 0)
   in let st5 = st-append-text st4 (mov-rr (rd.reg) (r1.reg))
   in let st6 = patch-jcc-at st5 jle-pos (st5.text-len)
   in EmitResult {
    state = st6,
    reg = rd.reg
   }

  emit-max-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-max-builtin (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let ld0 = load-local (r1.state) (loc0.reg)
   in let rd = alloc-temp (ld0.state)
   in let st2 = st-append-text (rd.state) (mov-rr (rd.reg) (ld0.reg))
   in let st3 = st-append-text st2 (cmp-rr (rd.reg) (r1.reg))
   in let jge-pos = st3.text-len
   in let st4 = st-append-text st3 (jcc cc-ge 0)
   in let st5 = st-append-text st4 (mov-rr (rd.reg) (r1.reg))
   in let st6 = patch-jcc-at st5 jge-pos (st5.text-len)
   in EmitResult {
    state = st6,
    reg = rd.reg
   }

  emit-int-mod-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-int-mod-builtin (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let loc1 = alloc-local (r1.state)
   in let st2 = store-local (loc1.state) (loc1.reg) (r1.reg)
   in let ld0 = load-local st2 (loc0.reg)
   in let st3 = st-append-text (ld0.state) (mov-rr reg-rax (ld0.reg))
   in let st4 = st-append-text st3 cqo
   in let ld1 = load-local st4 (loc1.reg)
   in let st5 = st-append-text (ld1.state) (idiv-r (ld1.reg))
   in let rd = alloc-temp st5
   in let st6 = st-append-text (rd.state) (mov-rr (rd.reg) reg-rdx)
   in let st7 = st-append-text st6 (test-rr (rd.reg) (rd.reg))
   in let jge-pos = st7.text-len
   in let st8 = st-append-text st7 (jcc cc-ge 0)
   in let rc = alloc-temp st8
   in let ld1b = load-local (rc.state) (loc1.reg)
   in let st9 = st-append-text (ld1b.state) (mov-rr (rc.reg) (ld1b.reg))
   in let sm = alloc-temp st9
   in let st10 = st-append-text (sm.state) (mov-rr (sm.reg) (rc.reg))
   in let st11 = st-append-text st10 (sar-ri (sm.reg) 63)
   in let st12 = st-append-text st11 (xor-rr (rc.reg) (sm.reg))
   in let st13 = st-append-text st12 (sub-rr (rc.reg) (sm.reg))
   in let st14 = st-append-text st13 (add-rr (rd.reg) (rc.reg))
   in let st15 = patch-jcc-at st14 jge-pos (st14.text-len)
   in EmitResult {
    state = st15,
    reg = rd.reg
   }

  emit-get-args-builtin : CodegenState -> EmitResult
  emit-get-args-builtin (st) =
    let rd = alloc-temp st
   in let st1 = st-append-text (rd.state) (li reg-r11 0)
   in let st2 = st-append-text st1 (mov-store reg-r10 reg-r11 0)
   in let st3 = st-append-text st2 (add-ri reg-r10 8)
   in let st4 = st-append-text st3 (mov-rr (rd.reg) reg-r10)
   in let st5 = st-append-text st4 (mov-store reg-r10 reg-r11 0)
   in let st6 = st-append-text st5 (add-ri reg-r10 8)
   in EmitResult {
   state = st6,
   reg = rd.reg
  }

  emit-current-dir-builtin : CodegenState -> EmitResult
  emit-current-dir-builtin (st) =
    let rd = alloc-temp st
   in let st1 = st-append-text (rd.state) (mov-rr (rd.reg) reg-r10)
   in let st2 = st-append-text st1 (li reg-r11 0)
   in let st3 = st-append-text st2 (mov-store reg-r10 reg-r11 0)
   in let st4 = st-append-text st3 (add-ri reg-r10 8)
   in EmitResult {
   state = st4,
   reg = rd.reg
  }

  emit-file-exists-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-file-exists-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (r.state)
   in let st1 = st-append-text (rd.state) (li (rd.reg) 1)
   in EmitResult {
   state = st1,
   reg = rd.reg
  }

  emit-substring-alloc : CodegenState -> Integer -> Integer -> Integer -> CodegenState
  emit-substring-alloc (st) (str-loc) (start-loc) (len-loc) =
    let len-loaded = load-local st len-loc
   in let st0 = st-append-text (len-loaded.state) (mov-rr reg-r11 (len-loaded.reg))
   in let st1 = st-append-text st0 (add-ri reg-r11 15)
   in let st2 = st-append-text st1 (and-ri reg-r11 (-8))
   in st-append-text st2 (add-rr reg-r10 reg-r11)

  emit-substring-copy : CodegenState -> Integer -> Integer -> Integer -> Integer -> CodegenState
  emit-substring-copy (st) (str-loc) (start-loc) (len-loc) (ptr-loc) =
    let st0 = st-append-text st (li reg-r11 0)
   in let sub-loop = st0.text-len
   in let len-ld = load-local st0 len-loc
   in let st1 = st-append-text (len-ld.state) (cmp-rr reg-r11 (len-ld.reg))
   in let sub-exit-pos = st1.text-len
   in let st2 = st-append-text st1 (jcc cc-ge 0)
   in let src-ld = load-local st2 str-loc
   in let start-ld = load-local (src-ld.state) start-loc
   in let st3 = st-append-text (start-ld.state) (mov-rr reg-rsi (src-ld.reg))
   in let st4 = st-append-text st3 (add-rr reg-rsi (start-ld.reg))
   in let st5 = st-append-text st4 (add-rr reg-rsi reg-r11)
   in let st6 = st-append-text st5 (movzx-byte reg-rsi reg-rsi 8)
   in let ptr-ld = load-local st6 ptr-loc
   in let st7 = st-append-text (ptr-ld.state) (mov-rr reg-rdx (ptr-ld.reg))
   in let st8 = st-append-text st7 (add-rr reg-rdx reg-r11)
   in let st9 = st-append-text st8 (mov-store-byte reg-rdx reg-rsi 8)
   in let st10 = st-append-text st9 (add-ri reg-r11 1)
   in let st11 = st-append-text st10 (jmp (sub-loop - (st10.text-len + 5)))
   in patch-jcc-at st11 sub-exit-pos (st11.text-len)

  emit-substring-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-substring-builtin (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let loc1 = alloc-local (r1.state)
   in let st2 = store-local (loc1.state) (loc1.reg) (r1.reg)
   in let r2 = emit-expr st2 (list-at args 2)
   in let loc2 = alloc-local (r2.state)
   in let st3 = store-local (loc2.state) (loc2.reg) (r2.reg)
   in let ptr-loc = alloc-local st3
   in let ptr-tmp = alloc-temp (ptr-loc.state)
   in let st4 = st-append-text (ptr-tmp.state) (mov-rr (ptr-tmp.reg) reg-r10)
   in let st5 = store-local st4 (ptr-loc.reg) (ptr-tmp.reg)
   in let len-ld = load-local st5 (loc2.reg)
   in let ptr-ld = load-local (len-ld.state) (ptr-loc.reg)
   in let st6 = st-append-text (ptr-ld.state) (mov-store (ptr-ld.reg) (len-ld.reg) 0)
   in let st7 = emit-substring-alloc st6 (loc0.reg) (loc1.reg) (loc2.reg)
   in let st8 = emit-substring-copy st7 (loc0.reg) (loc1.reg) (loc2.reg) (ptr-loc.reg)
   in let result = load-local st8 (ptr-loc.reg)
   in EmitResult {
   state = result.state,
   reg = result.reg
  }

  emit-print-line-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-print-line-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = emit-print-text (r.state) (r.reg)
   in let rd = alloc-temp st1
   in EmitResult {
   state = st-append-text (rd.state) (li (rd.reg) 0),
   reg = rd.reg
  }

  emit-read-file-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-read-file-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = st-append-text (r.state) (mov-rr reg-rdi (r.reg))
   in let st2 = emit-call-to st1 "__bare_metal_read_serial"
   in let rd = alloc-temp st2
   in EmitResult {
   state = st-append-text (rd.state) (mov-rr (rd.reg) reg-rax),
   reg = rd.reg
  }

  emit-write-file-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-write-file-builtin (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let r1 = emit-expr (r0.state) (list-at args 1)
   in let st1 = emit-print-text-no-newline (r1.state) (r1.reg)
   in let rd = alloc-temp st1
   in EmitResult {
   state = st-append-text (rd.state) (li (rd.reg) 0),
   reg = rd.reg
  }

  emit-read-line-builtin : CodegenState -> EmitResult
  emit-read-line-builtin (st) =
    let st1 = emit-call-to st "__read_line"
   in let rd = alloc-temp st1
   in EmitResult {
   state = st-append-text (rd.state) (mov-rr (rd.reg) reg-rax),
   reg = rd.reg
  }

  emit-write-binary-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-write-binary-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = st-append-text (r.state) (mov-rr reg-rdi (r.reg))
   in let st2 = emit-call-to st1 "__write_binary"
   in let rd = alloc-temp st2
   in EmitResult {
   state = st-append-text (rd.state) (li (rd.reg) 0),
   reg = rd.reg
  }

  emit-linked-list-empty-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-linked-list-empty-builtin (st) (args) =
   let rd = alloc-temp st
   in EmitResult {
   state = st-append-text (rd.state) (li (rd.reg) 0),
   reg = rd.reg
  }

  emit-linked-list-push-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-linked-list-push-builtin (st) (args) =
   let list-result = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let list-loc = alloc-local (list-result.state)
   in let st1 = store-local (list-loc.state) (list-loc.reg) (list-result.reg)
   in let val-result = emit-expr st1 (list-at args 1)
   in let val-loc = alloc-local (val-result.state)
   in let st2 = store-local (val-loc.state) (val-loc.reg) (val-result.reg)
   in let ptr = alloc-temp st2
   in let st3 = st-append-text (ptr.state) (mov-rr (ptr.reg) reg-r10)
   in let vr = load-local st3 (val-loc.reg)
   in let st4 = st-append-text (vr.state) (mov-store (ptr.reg) (vr.reg) 0)
   in let lr = load-local st4 (list-loc.reg)
   in let st5 = st-append-text (lr.state) (mov-store (ptr.reg) (lr.reg) 8)
   in let st6 = st-append-text st5 (add-ri reg-r10 16)
   in EmitResult {
   state = st6,
   reg = ptr.reg
  }

  emit-linked-list-to-list-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-linked-list-to-list-builtin (st) (args) =
   let head-result = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = st-append-text (head-result.state) (mov-rr reg-rdi (head-result.reg))
   in let st2 = emit-call-to st1 "__linked_list_to_list"
   in let rd = alloc-temp st2
   in EmitResult {
   state = st-append-text (rd.state) (mov-rr (rd.reg) reg-rax),
   reg = rd.reg
  }

  emit-record-set-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-record-set-builtin (st) (args) =
    let rec-result = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rec-loc = alloc-local (rec-result.state)
   in let st1 = store-local (rec-loc.state) (rec-loc.reg) (rec-result.reg)
   in let field-name = when (list-at args 1)
    is IrTextLit (s) (sp) -> s
    is otherwise -> ""
   in let rec-ty = resolve-constructed-ty st (ir-expr-type (list-at args 0))
   in let val-result = emit-expr st1 (list-at args 2)
   in let loaded = load-local (val-result.state) (rec-loc.reg)
   in when rec-ty
    is RecordTy (rname) (rargs) (rfields) ->
     let fot = cce-byte-offset-and-type rfields field-name
     in EmitResult {
      state = emit-narrow-store-checked (loaded.state) (fot.type-val) (loaded.reg) (val-result.reg) (fot.offset),
      reg = loaded.reg
     }
    is otherwise ->
     let st-err = st-add-error (loaded.state) cdx-ir-error ("__record-set: unresolved type for field '" ++ field-name ++ "'") (ir-expr-span (list-at args 0))
     in EmitResult {
      state = st-append-text st-err [15, 11],
      reg = loaded.reg
     }

  emit-heap-save-builtin : CodegenState -> EmitResult
  emit-heap-save-builtin (st) =
   let rd = alloc-temp st
   in EmitResult {
   state = st-append-text (rd.state) (mov-rr (rd.reg) reg-r10),
   reg = rd.reg
  }

  emit-heap-restore-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-heap-restore-builtin (st) (args) =
   let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = st-append-text (r.state) (mov-rr reg-r10 (r.reg))
   in let rd = alloc-temp st1
   in EmitResult {
   state = st-append-text (rd.state) (li (rd.reg) 0),
   reg = rd.reg
  }

  emit-heap-advance-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-heap-advance-builtin (st) (args) =
   let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (r.state)
   in let st1 = st-append-text (rd.state) (add-rr reg-r10 (r.reg))
   in EmitResult {
   state = st-append-text st1 (li (rd.reg) 0),
   reg = rd.reg
  }

  emit-deck-pos-builtin : CodegenState -> EmitResult
  emit-deck-pos-builtin (st) =
   let rd = alloc-temp st
   in let st1 = st-append-text (rd.state) (li (rd.reg) deck-pos-addr)
   in EmitResult {
   state = st-append-text st1 (mov-load (rd.reg) (rd.reg) 0),
   reg = rd.reg
  }

  emit-deck-set-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-deck-set-builtin (st) (args) =
   let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let addr-tmp = alloc-temp (r.state)
   in let st1 = st-append-text (addr-tmp.state) (li (addr-tmp.reg) deck-pos-addr)
   in let st2 = st-append-text st1 (mov-store (addr-tmp.reg) (r.reg) 0)
   in let rd = alloc-temp st2
   in EmitResult {
   state = st-append-text (rd.state) (li (rd.reg) 0),
   reg = rd.reg
  }

  emit-deck-alloc-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-deck-alloc-builtin (st) (args) =
   let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let addr-tmp = alloc-temp (r.state)
   in let st1 = st-append-text (addr-tmp.state) (li (addr-tmp.reg) deck-pos-addr)
   in let rd = alloc-temp st1
   in let st2 = st-append-text (rd.state) (mov-load (rd.reg) (addr-tmp.reg) 0)
   in let new-tmp = alloc-temp st2
   in let st3 = st-append-text (new-tmp.state) (mov-rr (new-tmp.reg) (rd.reg))
   in let st4 = st-append-text st3 (add-rr (new-tmp.reg) (r.reg))
   in EmitResult {
   state = st-append-text st4 (mov-store (addr-tmp.reg) (new-tmp.reg) 0),
   reg = rd.reg
  }

  emit-list-with-capacity-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-list-with-capacity-builtin (st) (args) =
   let cap-result = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in emit-list-with-capacity-builtin-bivy (cap-result.state) (cap-result.reg)

  emit-list-with-capacity-builtin-bivy : CodegenState -> Integer -> EmitResult
  emit-list-with-capacity-builtin-bivy (st) (cap-reg) =
   let rd = alloc-temp st
   in let st1 = st-append-text (rd.state) (mov-store reg-r10 cap-reg 0)
   in let st2 = st-append-text st1 (add-ri reg-r10 8)
   in let st3 = st-append-text st2 (mov-rr (rd.reg) reg-r10)
   in let zero-tmp = alloc-temp st3
   in let st4 = st-append-text (zero-tmp.state) (li (zero-tmp.reg) 0)
   in let st5 = st-append-text st4 (mov-store reg-r10 (zero-tmp.reg) 0)
   in let adv-tmp = alloc-temp st5
   in let st6 = st-append-text (adv-tmp.state) (mov-rr (adv-tmp.reg) cap-reg)
   in let st7 = st-append-text st6 (shl-ri (adv-tmp.reg) 3)
   in let st8 = st-append-text st7 (add-ri (adv-tmp.reg) 8)
   in EmitResult {
   state = st-append-text st8 (add-rr reg-r10 (adv-tmp.reg)),
   reg = rd.reg
  }

  emit-list-with-capacity-builtin-deck : CodegenState -> Integer -> EmitResult
  emit-list-with-capacity-builtin-deck (st) (cap-reg) =
   let addr-tmp = alloc-temp st
   in let st0 = st-append-text (addr-tmp.state) (li (addr-tmp.reg) deck-pos-addr)
   in let deckp-tmp = alloc-temp st0
   in let st1 = st-append-text (deckp-tmp.state) (mov-load (deckp-tmp.reg) (addr-tmp.reg) 0)
   in let st2 = st-append-text st1 (mov-store (deckp-tmp.reg) cap-reg 0)
   in let st3 = st-append-text st2 (add-ri (deckp-tmp.reg) 8)
   in let rd = alloc-temp st3
   in let st4 = st-append-text (rd.state) (mov-rr (rd.reg) (deckp-tmp.reg))
   in let zero-tmp = alloc-temp st4
   in let st5 = st-append-text (zero-tmp.state) (li (zero-tmp.reg) 0)
   in let st6 = st-append-text st5 (mov-store (deckp-tmp.reg) (zero-tmp.reg) 0)
   in let adv-tmp = alloc-temp st6
   in let st7 = st-append-text (adv-tmp.state) (mov-rr (adv-tmp.reg) cap-reg)
   in let st8 = st-append-text st7 (shl-ri (adv-tmp.reg) 3)
   in let st9 = st-append-text st8 (add-ri (adv-tmp.reg) 8)
   in let st10 = st-append-text st9 (add-rr (deckp-tmp.reg) (adv-tmp.reg))
   in EmitResult {
   state = st-append-text st10 (mov-store (addr-tmp.reg) (deckp-tmp.reg) 0),
   reg = rd.reg
  }

  emit-buf-write-byte-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-buf-write-byte-builtin (st) (args) =
   let base-result = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let base-loc = alloc-local (base-result.state)
   in let st1 = store-local (base-loc.state) (base-loc.reg) (base-result.reg)
   in let off-result = emit-expr st1 (list-at args 1)
   in let off-loc = alloc-local (off-result.state)
   in let st2 = store-local (off-loc.state) (off-loc.reg) (off-result.reg)
   in let byte-result = emit-expr st2 (list-at args 2)
   in let byte-loc = alloc-local (byte-result.state)
   in let st3 = store-local (byte-loc.state) (byte-loc.reg) (byte-result.reg)
   in let addr = alloc-temp st3
   in let base2 = load-local (addr.state) (base-loc.reg)
   in let off2 = load-local (base2.state) (off-loc.reg)
   in let st4 = st-append-text (off2.state) (mov-rr (addr.reg) (base2.reg))
   in let st5 = st-append-text st4 (add-rr (addr.reg) (off2.reg))
   in let byte2 = load-local st5 (byte-loc.reg)
   in let st6 = st-append-text (byte2.state) (mov-store-byte (addr.reg) (byte2.reg) 0)
   in let rd = alloc-temp st6
   in let off3 = load-local (rd.state) (off-loc.reg)
   in let st7 = st-append-text (off3.state) (mov-rr (rd.reg) (off3.reg))
   in EmitResult {
   state = st-append-text st7 (add-ri (rd.reg) 1),
   reg = rd.reg
  }

  emit-buf-write-bytes-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-buf-write-bytes-builtin (st) (args) =
   let base-result = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let base-loc = alloc-local (base-result.state)
   in let st1 = store-local (base-loc.state) (base-loc.reg) (base-result.reg)
   in let off-result = emit-expr st1 (list-at args 1)
   in let off-loc = alloc-local (off-result.state)
   in let st2 = store-local (off-loc.state) (off-loc.reg) (off-result.reg)
   in let list-result = emit-expr st2 (list-at args 2)
   in let st3 = st-append-text (list-result.state) (mov-rr reg-rdx (list-result.reg))
   in let off2 = load-local st3 (off-loc.reg)
   in let st4 = st-append-text (off2.state) (mov-rr reg-rsi (off2.reg))
   in let base2 = load-local st4 (base-loc.reg)
   in let st5 = st-append-text (base2.state) (mov-rr reg-rdi (base2.reg))
   in let st6 = emit-call-to st5 "__buf_write_bytes"
   in let rd = alloc-temp st6
   in EmitResult {
   state = st-append-text (rd.state) (mov-rr (rd.reg) reg-rax),
   reg = rd.reg
  }

  emit-buf-read-bytes-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-buf-read-bytes-builtin (st) (args) =
   let base-result = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let base-loc = alloc-local (base-result.state)
   in let st1 = store-local (base-loc.state) (base-loc.reg) (base-result.reg)
   in let off-result = emit-expr st1 (list-at args 1)
   in let off-loc = alloc-local (off-result.state)
   in let st2 = store-local (off-loc.state) (off-loc.reg) (off-result.reg)
   in let count-result = emit-expr st2 (list-at args 2)
   in let st3 = st-append-text (count-result.state) (mov-rr reg-rdx (count-result.reg))
   in let off2 = load-local st3 (off-loc.reg)
   in let st4 = st-append-text (off2.state) (mov-rr reg-rsi (off2.reg))
   in let base2 = load-local st4 (base-loc.reg)
   in let st5 = st-append-text (base2.state) (mov-rr reg-rdi (base2.reg))
   in let st6 = emit-call-to st5 "__buf_read_bytes"
   in let rd = alloc-temp st6
   in EmitResult {
   state = st-append-text (rd.state) (mov-rr (rd.reg) reg-rax),
   reg = rd.reg
  }

  emit-bit-op-2 : CodegenState -> List IRExpr -> (Integer -> Integer -> List Integer) -> EmitResult
  emit-bit-op-2 (st) (args) (op-bytes) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let ld0 = load-local (r1.state) (loc0.reg)
   in let rd = alloc-temp (ld0.state)
   in EmitResult {
    state = st-append-text (rd.state) (mov-rr (rd.reg) (ld0.reg) ++ op-bytes (rd.reg) (r1.reg)),
    reg = rd.reg
   }

  emit-bit-shift : CodegenState -> List IRExpr -> (Integer -> List Integer) -> EmitResult
  emit-bit-shift (st) (args) (shift-bytes) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let loc0 = alloc-local (r0.state)
   in let st1 = store-local (loc0.state) (loc0.reg) (r0.reg)
   in let r1 = emit-expr st1 (list-at args 1)
   in let st2 = st-append-text (r1.state) (mov-rr reg-rcx (r1.reg))
   in let ld0 = load-local st2 (loc0.reg)
   in let rd = alloc-temp (ld0.state)
   in EmitResult {
    state = st-append-text (rd.state) (mov-rr (rd.reg) (ld0.reg) ++ shift-bytes (rd.reg)),
    reg = rd.reg
   }

  emit-bit-not : CodegenState -> List IRExpr -> EmitResult
  emit-bit-not (st) (args) =
    let r0 = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (r0.state)
   in EmitResult {
    state = st-append-text (rd.state) (mov-rr (rd.reg) (r0.reg) ++ not-r (rd.reg)),
    reg = rd.reg
   }

Section: State Effect

 Integer-width state scoped to a run-state body. Mirrors REF's
 EmitRunState / EmitGetState / EmitSetState — state lives in a single
 stack-slot local whose slot index is tracked on CodegenState.state-local.
 Nested run-state saves and restores the slot index so inner scopes
 shadow, not overwrite, outer ones.

  emit-run-state-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-run-state-builtin (st) (args) =
   let init = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let cell = alloc-local (init.state)
   in let st1 = store-local (cell.state) (cell.reg) (init.reg)
   in let saved = st1.state-local
   in let st2 = __record-set st1 "state-local" (cell.reg)
   in let body = emit-expr st2 (list-at args 1)
   in let st3 = __record-set (body.state) "state-local" saved
   in EmitResult { state = st3, reg = body.reg }

  emit-get-state-builtin : CodegenState -> EmitResult
  emit-get-state-builtin (st) =
   if st.state-local < 0 then
    let tmp = alloc-temp st
    in EmitResult {
     state = st-append-text (tmp.state) (li (tmp.reg) 0),
     reg = tmp.reg
    }
   else load-local st (st.state-local)

  emit-set-state-builtin : CodegenState -> List IRExpr -> EmitResult
  emit-set-state-builtin (st) (args) =
   let v = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = if st.state-local < 0 then v.state
                else store-local (v.state) (st.state-local) (v.reg)
   in let rd = alloc-temp st1
   in EmitResult {
    state = st-append-text (rd.state) (li (rd.reg) 0),
    reg = rd.reg
   }

Section: Builtin Registry
  BuiltinX86Emitter = record {
   name : Text,
   emit : CodegenState -> List IRExpr -> EmitResult
  }

  bsearch-x86-emitter-pos : List BuiltinX86Emitter -> Text -> Integer -> Integer -> Integer
  bsearch-x86-emitter-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at entries mid).name
   in if text-compare name mid-name <= 0 then bsearch-x86-emitter-pos entries name lo mid
      else bsearch-x86-emitter-pos entries name (mid + 1) hi

  sort-x86-emitters : List BuiltinX86Emitter -> List BuiltinX86Emitter
  sort-x86-emitters (xs) =
   let len = list-length xs
   in if len <= 1 then xs
   else let mid = len / 2
   in let left = sort-x86-emitters (copy-x86-emitter-range xs 0 mid [])
   in let right = sort-x86-emitters (copy-x86-emitter-range xs mid len [])
   in merge-x86-emitters-sorted left right

  copy-x86-emitter-range : List BuiltinX86Emitter -> Integer -> Integer -> List BuiltinX86Emitter -> List BuiltinX86Emitter
  copy-x86-emitter-range (src) (i) (stop) (acc) =
   if i >= stop then acc
   else copy-x86-emitter-range src (i + 1) stop (list-snoc acc (list-at src i))

  merge-x86-emitters-sorted : List BuiltinX86Emitter -> List BuiltinX86Emitter -> List BuiltinX86Emitter
  merge-x86-emitters-sorted (a) (b) =
   merge-x86-emitters-loop a b 0 0 (list-length a) (list-length b) []

  merge-x86-emitters-loop : List BuiltinX86Emitter -> List BuiltinX86Emitter -> Integer -> Integer -> Integer -> Integer -> List BuiltinX86Emitter -> List BuiltinX86Emitter
  merge-x86-emitters-loop (a) (b) (ia) (ib) (la) (lb) (acc) =
   if ia >= la then copy-x86-emitter-range b ib lb acc
   else if ib >= lb then copy-x86-emitter-range a ia la acc
   else let ea = list-at a ia
   in let eb = list-at b ib
   in if text-compare (ea.name) (eb.name) <= 0
      then merge-x86-emitters-loop a b (ia + 1) ib la lb (list-snoc acc ea)
      else merge-x86-emitters-loop a b ia (ib + 1) la lb (list-snoc acc eb)

  x86-builtin-emitters : List BuiltinX86Emitter
  x86-builtin-emitters = sort-x86-emitters [
   BuiltinX86Emitter { name = "print-line", emit = \s a -> emit-print-line-builtin s a },
   BuiltinX86Emitter { name = "print-error", emit = \s a -> emit-print-line-builtin s a },
   BuiltinX86Emitter { name = "read-file", emit = \s a -> emit-read-file-builtin s a },
