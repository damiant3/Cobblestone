Chapter: CodexType Helpers

 Shared CodexType transformations used across the type checker, IR
 lowering, and emitters. Each helper has one canonical definition;
 duplicates in IR/LoweringTypes, TypeCheckerInference, CSharpEmitter,
 and X86_64Compound were consolidated here.

Section: Function-Type Peeling
  peel-fun-param : CodexType -> CodexType
  peel-fun-param (ty) =
   when ty
    is FunTy (p) (r) -> p
    is ForAllTy (id) (body) -> peel-fun-param body
    is otherwise -> ErrorTy

  peel-fun-return : CodexType -> CodexType
  peel-fun-return (ty) =
   when ty
    is FunTy (p) (r) -> r
    is ForAllTy (id) (body) -> peel-fun-return body
    is otherwise -> ErrorTy

  strip-fun-args : CodexType -> CodexType
  strip-fun-args (ty) =
   when ty
    is FunTy (p) (r) -> strip-fun-args r
    is ForAllTy (id) (body) -> strip-fun-args body
    is otherwise -> ty

  strip-forall-ty : CodexType -> CodexType
  strip-forall-ty (ty) =
   when ty
    is ForAllTy (id) (body) -> strip-forall-ty body
    is otherwise -> ty

