   in let e10b = env-bind e10 "char-code-at" (FunTy TextTy (FunTy int-ty-default int-ty-default))
   in let e11 = env-bind e10b "code-to-char" (FunTy int-ty-default CharTy)
   in let e12 = env-bind e11 "text-replace" (FunTy TextTy (FunTy TextTy (FunTy TextTy TextTy)))
   in let e12b = env-bind e12 "text-to-double-bits" (FunTy TextTy int-ty-default)
   in let e13 = env-bind e12b "text-to-integer" (FunTy TextTy int-ty-default)
