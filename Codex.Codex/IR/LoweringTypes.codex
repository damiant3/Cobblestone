Chapter: Lowering
  cites Codex chapter Lists

 Type lookup, substitution, and constructor binding utilities
 used by the main lowering pass.

Section: Lookup Overlay

 Cons-cell stack used by lowering for nested let / lambda / match / act bindings.
 Each binding prepends a single OverlayCons cell. List<TypeBinding> with `[X]
 ++ xs` was quadratic per function in the number of sequential bindings —
 each prepend allocated a fresh List of size N+1 and copied the prior N
 elements. The cons-cell variant is one cell per binding regardless of depth.

  LookupOverlay =
   | OverlayNil
   | OverlayCons (TypeBinding) (LookupOverlay)

  lookup-overlay : LookupOverlay -> Text -> CodexType
  lookup-overlay (ovl) (name) =
   when ovl
    is OverlayNil -> ErrorTy
    is OverlayCons (b) (rest) ->
     if b.name == name then b.bound-type
     else lookup-overlay rest name

Section: Type Lookup
  lookup-type : List TypeBinding -> Text -> CodexType
  lookup-type (bindings) (name) =
   lookup-type-loop bindings name 0 (list-length bindings)

  lookup-type-loop : List TypeBinding -> Text -> Integer -> Integer -> CodexType
  lookup-type-loop (bindings) (name) (i) (len) =
   if i == len then ErrorTy
   else let b = list-at bindings i
   in if b.name == name then b.bound-type
      else lookup-type-loop bindings name (i + 1) len

  lookup-type-bsearch : List TypeBinding -> Text -> CodexType
  lookup-type-bsearch (bindings) (name) =
   let len = list-length bindings
   in if len == 0 then ErrorTy
   else let pos = bsearch-text-pos bindings name 0 len
   in if pos >= len then ErrorTy
   else let b = list-at bindings pos
   in if b.name == name then b.bound-type else ErrorTy

  lookup-type-split : LookupOverlay -> List TypeBinding -> Text -> CodexType
  lookup-type-split (overlay) (base) (name) =
   let overlay-hit = lookup-overlay overlay name
   in when overlay-hit
    is ErrorTy -> lookup-type-bsearch base name
    is otherwise -> overlay-hit

  sort-bindings : List TypeBinding -> List TypeBinding
  sort-bindings (xs) =
   let len = list-length xs
   in if len <= 1 then xs
   else let mid = len / 2
   in merge-bindings-dedup (sort-bindings (copy-binding-range xs 0 mid [])) (sort-bindings (copy-binding-range xs mid len []))

  copy-binding-range : List TypeBinding -> Integer -> Integer -> List TypeBinding -> List TypeBinding
  copy-binding-range (xs) (i) (stop) (acc) =
   if i == stop then acc
   else copy-binding-range xs (i + 1) stop (list-snoc acc (list-at xs i))

  merge-bindings-dedup : List TypeBinding -> List TypeBinding -> List TypeBinding
  merge-bindings-dedup (left) (right) =
   merge-bindings-loop left right 0 0 (list-length left) (list-length right) []

  merge-bindings-loop : List TypeBinding -> List TypeBinding -> Integer -> Integer -> Integer -> Integer -> List TypeBinding -> List TypeBinding
  merge-bindings-loop (left) (right) (li) (ri) (ll) (rl) (acc) =
   if li == ll then copy-binding-range right ri rl acc
   else if ri == rl then copy-binding-range left li ll acc
   else let cmp = text-compare (list-at left li).name (list-at right ri).name
   in if cmp < 0 then merge-bindings-loop left right (li + 1) ri ll rl (list-snoc acc (list-at left li))
   else if cmp > 0 then merge-bindings-loop left right li (ri + 1) ll rl (list-snoc acc (list-at right ri))
   else merge-bindings-loop left right (li + 1) (ri + 1) ll rl (list-snoc acc (list-at left li))

Section: Type Substitution
  subst-type-vars-from-arg : CodexType -> CodexType -> CodexType -> CodexType
  subst-type-vars-from-arg (param-ty) (arg-ty) (target) =
   when param-ty
    is TypeVar (id) -> subst-type-var-in-target target id arg-ty
    is ListTy (pe) -> subst-from-list pe arg-ty target
    is FunTy (pp) (pr) -> subst-from-fun pp pr arg-ty target
    is otherwise -> target

  subst-from-list : CodexType -> CodexType -> CodexType -> CodexType
  subst-from-list (pe) (arg-ty) (target) =
   when arg-ty
    is ListTy (ae) -> subst-type-vars-from-arg pe ae target
    is otherwise -> target

  subst-from-fun : CodexType -> CodexType -> CodexType -> CodexType -> CodexType
  subst-from-fun (pp) (pr) (arg-ty) (target) =
   when arg-ty
    is FunTy (ap) (ar) ->
     let t2 = subst-type-vars-from-arg pp ap target
     in subst-type-vars-from-arg pr ar t2
    is otherwise -> target

  subst-type-var-in-target : CodexType -> Integer -> CodexType -> CodexType
  subst-type-var-in-target (ty) (var-id) (replacement) =
   if ty-has-typevars ty == False then ty
   else when ty
    is TypeVar (id) -> if id == var-id then replacement else ty
    is ForAllTy (fid) (body) ->
     if fid == var-id then ty
     else ForAllTy fid (subst-type-var-in-target body var-id replacement)
    is otherwise -> codex-type-map-children (\c -> subst-type-var-in-target c var-id replacement) ty

  is-text-type : CodexType -> Boolean
  is-text-type (ty) =
   when ty
    is TextTy -> True
    is otherwise -> False

Section: Binary Op Lowering
  is-number-type : CodexType -> Boolean
  is-number-type (ty) =
   when ty
    is NumberTy -> True
    is otherwise -> False

  lower-bin-op : BinaryOp -> CodexType -> IRBinaryOp
  lower-bin-op (op) (ty) =
   when op
    is OpAdd -> if is-number-type ty then IrAddNum else IrAddInt
    is OpSub -> if is-number-type ty then IrSubNum else IrSubInt
    is OpMul -> if is-number-type ty then IrMulNum else IrMulInt
    is OpDiv -> if is-number-type ty then IrDivNum else IrDivInt
    is OpPow -> IrPowInt
    is OpEq -> IrEq
    is OpNotEq -> IrNotEq
    is OpLt -> IrLt
    is OpGt -> IrGt
    is OpLtEq -> IrLtEq
    is OpGtEq -> IrGtEq
    is OpDefEq -> IrEq
    is OpAppend -> if is-text-type ty then IrAppendText else IrAppendList
    is OpCons -> IrConsList
    is OpAnd -> IrAnd
    is OpOr -> IrOr

  binary-result-type : BinaryOp -> CodexType -> CodexType -> CodexType
  binary-result-type (op) (left-ty) (expected-ty) =
   when op
    is OpEq -> BooleanTy
    is OpNotEq -> BooleanTy
    is OpLt -> BooleanTy
    is OpGt -> BooleanTy
    is OpLtEq -> BooleanTy
    is OpGtEq -> BooleanTy
    is OpDefEq -> BooleanTy
    is OpAnd -> BooleanTy
    is OpOr -> BooleanTy
    is OpAppend -> if is-text-type left-ty then TextTy
           else if is-text-type expected-ty then TextTy
           else left-ty
    is otherwise -> left-ty

