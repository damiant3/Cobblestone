Chapter: Tokens

Section: Types
  TokenKind =
   | EndOfFile
   | Newline
   | Indent
   | Dedent
   | IntegerLiteral
   | NumberLiteral
   | TextLiteral
   | CharLiteral
   | TrueKeyword
   | FalseKeyword
