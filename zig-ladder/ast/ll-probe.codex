Chapter: LlProbe

  probe : Integer -> List Integer
  probe (n) =
   let a = __linked-list-push [] 7
   in let b = __linked-list-push a (n + 1)
   in __linked-list-to-list b

  opening : [Console] Nothing = act
    let xs = probe 41
    in act
      print-line-uni (show (list-length xs))
      print-line-uni (show (list-at xs 0))
      print-line-uni (show (list-at xs 1))
    end
  end
