  Prov =
   | PParsed
   | PDesugared
   | PSynthetic

  SPos = record {
   line : Integer between 0 and 131071,
   column : Integer between 0 and 4294967295,
   offset : Integer between 0 and 4294967295
  }

  SSpan = record {
   start : SPos,
   end : SPos,
   file-id : Integer between 0 and 65535,
   provenance : Prov
  }

  Diag = record {
   code : Integer between 0 and 65535,
   message : Text,
   severity : Integer between 0 and 4,
   span : SSpan,
   related-spans : List SSpan
  }

  Tok = record {
   kind : TokKind,
   source : Text,
   offset : Integer between 0 and 4294967295,
   length : Integer between 0 and 4294967295,
   line : Integer between 0 and 131071,
   column : Integer between 0 and 4294967295,
   file-id : Integer between 0 and 65535
  }

  mutable LState = record {
   source : Text,
   offset : Integer between 0 and 4294967295,
   line : Integer between 0 and 131071,
   column : Integer between 0 and 4294967295,
   file-id : Integer between 0 and 65535,
   errors : LinkedList Diag,
   prose-mode : Boolean
  }

  LStep =
   | LTok (Tok) (LState)
   | LEnd

  LColl = record {
   c-toks : LinkedList Tok,
   c-errs : LinkedList Diag
  }

  deck-rec : a -> a
  deck-rec (x) = x

  mk-state : Text, Integer between 0 and 65535, LinkedList Diag -> LState
  mk-state (src) (fid) (pre) =
   LState { source = src, offset = 0, line = 1, column = 1, file-id = fid, errors = pre, prose-mode = False }

  at-end : LState -> Boolean
  at-end (st) = st.offset >= text-length (st.source)

  peek : LState -> Integer
  peek (st) =
   if at-end st then 0
   else char-code-at (st.source) (st.offset)

  adv : LState -> LState
  adv (st) =
   if peek st == 10 then LState {
     source = st.source,
     offset = st.offset + 1,
     line = st.line + 1,
     column = 1,
     file-id = st.file-id,
     errors = st.errors,
     prose-mode = st.prose-mode
    }
    else LState {
     source = st.source,
     offset = st.offset + 1,
     line = st.line,
     column = st.column + 1,
     file-id = st.file-id,
     errors = st.errors,
     prose-mode = st.prose-mode
    }

  mk-tok : TokKind, Integer between 0 and 4294967295, LState -> Tok
  mk-tok (kind) (length) (st) =
   deck-rec (Tok { kind = kind, source = st.source, offset = st.offset, length = length, line = st.line, column = st.column, file-id = st.file-id })

  my-scan : LState -> LStep
  my-scan (st) =
   if st.offset >= 1 then LEnd
   else LTok (mk-tok (deck-rec KIdent) 1 st) (adv st)

  my-collect : LState, LinkedList Tok, Integer -> LColl
  my-collect (st) (acc) (ceiling) =
   when my-scan st
    is LTok (tok) (next) ->
     if tok.kind == KEof then LColl { c-toks = __linked-list-push acc tok, c-errs = next.errors }
      else my-collect next (__linked-list-push acc tok) ceiling
    is LEnd ->
     LColl { c-toks = __linked-list-push acc (mk-tok (deck-rec KEof) 0 st), c-errs = st.errors }

  opening : [Console] Nothing = act
    let raw = my-collect (mk-state "x" 1 (__linked-list-empty 0)) (__linked-list-empty 0) 0
    in act
      print-line-uni ("toks " & show (list-length (__linked-list-to-list (raw.c-toks))))
      print-line-uni ("errs " & show (list-length (__linked-list-to-list (raw.c-errs))))
    end
  end
