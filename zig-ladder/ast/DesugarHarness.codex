Chapter: DesugarHarness

Section: Subject
  subject-text : Text
  subject-text = "Chapter: AST Nodes\n\nSection: Names and Literals\n  LiteralKind =\n   | IntLit\n   | NumLit\n   | TextLit\n   | CharLit\n   | BoolLit\n\n  BinaryOp =\n   | OpAdd\n   | OpSub\n   | OpMul\n   | OpDiv\n   | OpPow\n   | OpEq\n   | OpNotEq\n   | OpLt\n   | OpGt\n   | OpLtEq\n   | OpGtEq\n   | OpDefEq\n   | OpAppend\n   | OpCons\n   | OpAnd\n   | OpOr\n   | OpApproxEq\n   | OpApproxEqExact\n\nSection: Expressions\n  AExpr =\n   | ALitExpr (Text) (LiteralKind) (SourceSpan)\n   | ANameExpr (Name) (SourceSpan)\n   | AApplyExpr (AExpr) (AExpr) (SourceSpan)\n   | ABinaryExpr (AExpr) (BinaryOp) (AExpr) (SourceSpan)\n   | AUnaryExpr (AExpr) (SourceSpan)\n   | AIfExpr (AExpr) (AExpr) (AExpr) (SourceSpan)\n   | ALetExpr (List ALetBind) (AExpr) (SourceSpan)\n   | ALambdaExpr (List Name) (AExpr) (SourceSpan)\n   | AMatchExpr (AExpr) (List AMatchArm) (SourceSpan)\n   | AListExpr (List AExpr) (SourceSpan)\n   | ARecordExpr (Name) (List AFieldExpr) (SourceSpan)\n   | AFieldAccess (AExpr) (Name) (SourceSpan)\n   | AActExpr (List AActStmt) (SourceSpan)\n   | AHandleExpr (Name) (AExpr) (List AHandleClause) (SourceSpan)\n   | AWithTimeoutExpr (Text) (List Name) (List Text) (AExpr) (SourceSpan)\n   | ATryExpr (Integer) (List AActStmt) (List AActStmt) (List AActStmt) (SourceSpan)\n   | AFieldAssignExpr (AExpr) (Name) (AExpr) (SourceSpan)\n   | ALazyExpr (AExpr) (SourceSpan)\n   | AErrorExpr (Text) (SourceSpan)\n   | AInductionExpr (AExpr) (List AMatchArm) (SourceSpan)\n\n  ALetBind = record {\n   name : Name,\n   value : AExpr,\n   span : SourceSpan\n  }\n\n  AMatchArm = record {\n   pattern : APat,\n   body : AExpr,\n   guard : AExpr,\n   span : SourceSpan,\n   alt-group : Integer\n  }\n\n  AFieldExpr = record {\n   name : Name,\n   value : AExpr,\n   span : SourceSpan\n  }\n\n  AActStmt =\n   | AActBindStmt (Name) (AExpr) (SourceSpan)\n   | AActExprStmt (AExpr) (SourceSpan)\n\n  AHandleClause = record {\n   op-name : Name,\n   params : List Name,\n   resume-name : Name,\n   body : AExpr,\n   span : SourceSpan\n  }\n\nSection: Patterns\n  APat =\n   | AVarPat (Name) (SourceSpan)\n   | ALitPat (Text) (LiteralKind) (SourceSpan)\n   | ACtorPat (Name) (List APat) (SourceSpan)\n   | AWildPat (SourceSpan)\n   | AVecPat (List APat) (SourceSpan)\n\nSection: Type Expressions\n  ATypeExpr =\n   | ANamedType (Name) (SourceSpan)\n   | AFunType (ATypeExpr) (ATypeExpr) (SourceSpan)\n   | AAppType (ATypeExpr) (List ATypeExpr) (SourceSpan)\n   | AEffectType (List Name) (List Text) (List Name) (ATypeExpr) (SourceSpan)\n   | ABoundedIntType (ATypeExpr) (Integer) (Integer) (OverflowMode) (SourceSpan)\n   | APropEqType (ATypeExpr) (ATypeExpr) (SourceSpan)\n   | AConstrainedType (Name) (Name) (ATypeExpr) (SourceSpan)\n   | ALinearType (ATypeExpr) (SourceSpan)\n   | AForallType (Name) (ATypeExpr) (ATypeExpr) (SourceSpan)\n\nSection: Definitions\n  AParam = record {\n   name : Name,\n   span : SourceSpan\n  }\n\n  mutable ADef = record {\n   name : Name,\n   params : List AParam,\n   declared-type : List ATypeExpr,\n   body : AExpr,\n   chapter-slug : Text,\n   span : SourceSpan\n  }\n\n  ARecordFieldDef = record {\n   name : Name,\n   type-expr : ATypeExpr,\n   span : SourceSpan\n  }\n\n  AVariantCtorDef = record {\n   name : Name,\n   fields : List ATypeExpr,\n   return-type : List ATypeExpr,\n   span : SourceSpan\n  }\n\n  ATypeDef =\n   | ARecordTypeDef (Name) (List Name) (List ARecordFieldDef) (Boolean) (SourceSpan)\n   | AVariantTypeDef (Name) (List Name) (List AVariantCtorDef) (SourceSpan)\n   | AUnitTypeDef (Name) (ATypeExpr) (SourceSpan)\n\n  AEffectOpDef = record {\n   name : Name,\n   type-expr : ATypeExpr,\n   span : SourceSpan\n  }\n\n  AEffectDef = record {\n   name : Name,\n   ops : List AEffectOpDef,\n   span : SourceSpan\n  }\n\n  AClassDef = record {\n   name : Name,\n   methods : List AEffectOpDef,\n   span : SourceSpan\n  }\n\n  AInstanceMethodDef = record {\n   name : Name,\n   params : List Name,\n   body : AExpr,\n   span : SourceSpan\n  }\n\n  AInstanceDef = record {\n   class-name : Name,\n   type-name : Name,\n   methods : List AInstanceMethodDef,\n   span : SourceSpan\n  }\n\nSection: Chapter\n  ACitesDecl = record {\n   quire : Name,\n   chapter-name : Name,\n   selected-names : List Name,\n   citing-chapter : Text,\n   span : SourceSpan\n  }\n\n  AChapter = record {\n   name : Name,\n   defs : List ADef,\n   type-defs : List ATypeDef,\n   effect-defs : List AEffectDef,\n   class-defs : List AClassDef,\n   instance-defs : List AInstanceDef,\n   citations : List ACitesDecl,\n   ground-effects : List Text,\n   chapter-title : Text,\n   prose : Text,\n   prose-blocks : List ProseBlock,\n   annotations : List AnnotationNode,\n   section-titles : List Text,\n   rt-names : List Text,\n   rt-budgets : List Integer,\n   conversions : List Text,\n   span : SourceSpan\n  }\n\nSection: Span Accessor\n  aexpr-span : AExpr -> SourceSpan\n  aexpr-span (e) =\n   when e\n    is ALitExpr (t) (k) (s) | ANameExpr (n) (s) | AApplyExpr (f) (a) (s) | ABinaryExpr (l) (op) (r) (s) | AUnaryExpr (x) (s) | AIfExpr (c) (t) (el) (s) | ALetExpr (bs) (b) (s) | ALambdaExpr (ps) (b) (s) | AMatchExpr (sc) (arms) (s) | AListExpr (es) (s) | ARecordExpr (n) (fs) (s) | AFieldAccess (r) (f) (s) | AActExpr (ss) (s) | AHandleExpr (eff) (b) (cs) (s) | AWithTimeoutExpr (timeout) (effs) (scopes) (b) (s) | ATryExpr (max) (body) (fb) (fail) (s) | AFieldAssignExpr (r) (f) (v) (s) | ALazyExpr (inner) (s) | AErrorExpr (m) (s) | AInductionExpr (sc) (arms) (s) -> s\n\nSection: Deck Copies\n\n Deep-copy functions for the AST, used by the frontend keep deck\n to copy desugared survivors below the dead LEX/PARSE/DESUGAR\n decks. Same positional sharing rule as the CST copiers: values\n at or below the reservation base b are already in the keep\n region and shared in place; values above b are rebuilt. Leaf\n copiers (copy-sx-text, copy-sx-span, copy-sx-ov) live in\n SyntaxNodes. Enums (LiteralKind, BinaryOp) are nullary sums\n that heap-box, so they are rebuilt unconditionally.\n\n  copy-as-name : Integer, Name -> Name\n  copy-as-name (b) (n) = Name { value = copy-sx-text b (n.value) }\n\n  copy-as-names : Integer, List Name -> List Name\n  copy-as-names (b) (ns) = for n in ns -> copy-as-name b n\n\n  copy-as-litk : LiteralKind -> LiteralKind\n  copy-as-litk (k) =\n   when k\n    is IntLit -> IntLit\n    is NumLit -> NumLit\n    is TextLit -> TextLit\n    is CharLit -> CharLit\n    is BoolLit -> BoolLit\n\n  copy-as-binop : BinaryOp -> BinaryOp\n  copy-as-binop (op) =\n   when op\n    is OpAdd -> OpAdd\n    is OpSub -> OpSub\n    is OpMul -> OpMul\n    is OpDiv -> OpDiv\n    is OpPow -> OpPow\n    is OpEq -> OpEq\n    is OpNotEq -> OpNotEq\n    is OpLt -> OpLt\n    is OpGt -> OpGt\n    is OpLtEq -> OpLtEq\n    is OpGtEq -> OpGtEq\n    is OpDefEq -> OpDefEq\n    is OpAppend -> OpAppend\n    is OpCons -> OpCons\n    is OpAnd -> OpAnd\n    is OpOr -> OpOr\n    is OpApproxEq -> OpApproxEq\n    is OpApproxEqExact -> OpApproxEqExact\n\n  copy-as-actstmt : Integer, AActStmt -> AActStmt\n  copy-as-actstmt (b) (s) =\n   when s\n    is AActBindStmt (n) (e) (sp) -> AActBindStmt (copy-as-name b n) (copy-as-expr b e) (copy-sx-span b sp)\n    is AActExprStmt (e) (sp) -> AActExprStmt (copy-as-expr b e) (copy-sx-span b sp)\n\n  copy-as-letbind : Integer, ALetBind -> ALetBind\n  copy-as-letbind (b) (lb) = ALetBind { name = copy-as-name b (lb.name), value = copy-as-expr b (lb.value), span = copy-sx-span b (lb.span) }\n\n  copy-as-pat : Integer, APat -> APat\n  copy-as-pat (b) (p) =\n   when p\n    is AVarPat (n) (sp) -> AVarPat (copy-as-name b n) (copy-sx-span b sp)\n    is ALitPat (t) (k) (sp) -> ALitPat (copy-sx-text b t) (copy-as-litk k) (copy-sx-span b sp)\n    is ACtorPat (n) (args) (sp) -> ACtorPat (copy-as-name b n) (for a in args -> copy-as-pat b a) (copy-sx-span b sp)\n    is AWildPat (sp) -> AWildPat (copy-sx-span b sp)\n    is AVecPat (subs) (sp) -> AVecPat (for a in subs -> copy-as-pat b a) (copy-sx-span b sp)\n\n  copy-as-matcharm : Integer, AMatchArm -> AMatchArm\n  copy-as-matcharm (b) (a) = AMatchArm {\n   pattern = copy-as-pat b (a.pattern),\n   body = copy-as-expr b (a.body),\n   guard = copy-as-expr b (a.guard),\n   span = copy-sx-span b (a.span),\n   alt-group = a.alt-group\n  }\n\n  copy-as-fieldexpr : Integer, AFieldExpr -> AFieldExpr\n  copy-as-fieldexpr (b) (f) = AFieldExpr { name = copy-as-name b (f.name), value = copy-as-expr b (f.value), span = copy-sx-span b (f.span) }\n\n  copy-as-handleclause : Integer, AHandleClause -> AHandleClause\n  copy-as-handleclause (b) (c) = AHandleClause {\n   op-name = copy-as-name b (c.op-name),\n   params = copy-as-names b (c.params),\n   resume-name = copy-as-name b (c.resume-name),\n   body = copy-as-expr b (c.body),\n   span = copy-sx-span b (c.span)\n  }\n\n  copy-as-expr : Integer, AExpr -> AExpr\n  copy-as-expr (b) (e) =\n   when e\n    is ALitExpr (t) (k) (sp) -> ALitExpr (copy-sx-text b t) (copy-as-litk k) (copy-sx-span b sp)\n    is ANameExpr (n) (sp) -> ANameExpr (copy-as-name b n) (copy-sx-span b sp)\n    is AApplyExpr (f) (a) (sp) -> AApplyExpr (copy-as-expr b f) (copy-as-expr b a) (copy-sx-span b sp)\n    is ABinaryExpr (l) (op) (r) (sp) -> ABinaryExpr (copy-as-expr b l) (copy-as-binop op) (copy-as-expr b r) (copy-sx-span b sp)\n    is AUnaryExpr (x) (sp) -> AUnaryExpr (copy-as-expr b x) (copy-sx-span b sp)\n    is AIfExpr (c) (t) (el) (sp) -> AIfExpr (copy-as-expr b c) (copy-as-expr b t) (copy-as-expr b el) (copy-sx-span b sp)\n    is ALetExpr (bs) (body) (sp) -> ALetExpr (for lb in bs -> copy-as-letbind b lb) (copy-as-expr b body) (copy-sx-span b sp)\n    is ALambdaExpr (ps) (body) (sp) -> ALambdaExpr (copy-as-names b ps) (copy-as-expr b body) (copy-sx-span b sp)\n    is AMatchExpr (sc) (arms) (sp) -> AMatchExpr (copy-as-expr b sc) (for a in arms -> copy-as-matcharm b a) (copy-sx-span b sp)\n    is AListExpr (es) (sp) -> AListExpr (for el in es -> copy-as-expr b el) (copy-sx-span b sp)\n    is ARecordExpr (n) (fs) (sp) -> ARecordExpr (copy-as-name b n) (for f in fs -> copy-as-fieldexpr b f) (copy-sx-span b sp)\n    is AFieldAccess (rec) (fld) (sp) -> AFieldAccess (copy-as-expr b rec) (copy-as-name b fld) (copy-sx-span b sp)\n    is AActExpr (stmts) (sp) -> AActExpr (for s in stmts -> copy-as-actstmt b s) (copy-sx-span b sp)\n    is AHandleExpr (eff) (body) (cs) (sp) -> AHandleExpr (copy-as-name b eff) (copy-as-expr b body) (for c in cs -> copy-as-handleclause b c) (copy-sx-span b sp)\n    is AWithTimeoutExpr (timeout) (effs) (scopes) (body) (sp) -> AWithTimeoutExpr (copy-sx-text b timeout) (copy-as-names b effs) (copy-sx-texts b scopes) (copy-as-expr b body) (copy-sx-span b sp)\n    is ATryExpr (max) (t-stmts) (c-stmts) (f-stmts) (sp) -> ATryExpr max (for ts in t-stmts -> copy-as-actstmt b ts) (for cs in c-stmts -> copy-as-actstmt b cs) (for fs in f-stmts -> copy-as-actstmt b fs) (copy-sx-span b sp)\n    is AFieldAssignExpr (rec) (fld) (val) (sp) -> AFieldAssignExpr (copy-as-expr b rec) (copy-as-name b fld) (copy-as-expr b val) (copy-sx-span b sp)\n    is ALazyExpr (inner) (sp) -> ALazyExpr (copy-as-expr b inner) (copy-sx-span b sp)\n    is AErrorExpr (m) (sp) -> AErrorExpr (copy-sx-text b m) (copy-sx-span b sp)\n    is AInductionExpr (sc) (arms) (sp) -> AInductionExpr (copy-as-expr b sc) (for a in arms -> copy-as-matcharm b a) (copy-sx-span b sp)\n\n  copy-as-typeexpr : Integer, ATypeExpr -> ATypeExpr\n  copy-as-typeexpr (b) (t) =\n   when t\n    is ANamedType (n) (sp) -> ANamedType (copy-as-name b n) (copy-sx-span b sp)\n    is AFunType (a) (r) (sp) -> AFunType (copy-as-typeexpr b a) (copy-as-typeexpr b r) (copy-sx-span b sp)\n    is AAppType (f) (args) (sp) -> AAppType (copy-as-typeexpr b f) (for a in args -> copy-as-typeexpr b a) (copy-sx-span b sp)\n    is AEffectType (effs) (caps) (tail) (inner) (sp) -> AEffectType (copy-as-names b effs) (copy-sx-texts b caps) (copy-as-names b tail) (copy-as-typeexpr b inner) (copy-sx-span b sp)\n    is ABoundedIntType (inner) (lo) (hi) (mode) (sp) -> ABoundedIntType (copy-as-typeexpr b inner) lo hi (copy-sx-ov mode) (copy-sx-span b sp)\n    is APropEqType (l) (r) (sp) -> APropEqType (copy-as-typeexpr b l) (copy-as-typeexpr b r) (copy-sx-span b sp)\n    is AConstrainedType (cls) (param) (inner) (sp) -> AConstrainedType (copy-as-name b cls) (copy-as-name b param) (copy-as-typeexpr b inner) (copy-sx-span b sp)\n    is ALinearType (inner) (sp) -> ALinearType (copy-as-typeexpr b inner) (copy-sx-span b sp)\n    is AForallType (v) (vt) (p) (sp) -> AForallType (copy-as-name b v) (copy-as-typeexpr b vt) (copy-as-typeexpr b p) (copy-sx-span b sp)\n\n  copy-as-param : Integer, AParam -> AParam\n  copy-as-param (b) (p) = AParam { name = copy-as-name b (p.name), span = copy-sx-span b (p.span) }\n\n  copy-as-def : Integer, ADef -> ADef\n  copy-as-def (b) (d) = ADef {\n   name = copy-as-name b (d.name),\n   params = for p in (d.params) -> copy-as-param b p,\n   declared-type = for t in (d.declared-type) -> copy-as-typeexpr b t,\n   body = copy-as-expr b (d.body),\n   chapter-slug = copy-sx-text b (d.chapter-slug),\n   span = copy-sx-span b (d.span)\n  }\n\n  copy-as-recordfielddef : Integer, ARecordFieldDef -> ARecordFieldDef\n  copy-as-recordfielddef (b) (f) = ARecordFieldDef { name = copy-as-name b (f.name), type-expr = copy-as-typeexpr b (f.type-expr), span = copy-sx-span b (f.span) }\n\n  copy-as-variantctordef : Integer, AVariantCtorDef -> AVariantCtorDef\n  copy-as-variantctordef (b) (c) = AVariantCtorDef { name = copy-as-name b (c.name), fields = for f in (c.fields) -> copy-as-typeexpr b f, return-type = for r in (c.return-type) -> copy-as-typeexpr b r, span = copy-sx-span b (c.span) }\n\n  copy-as-typedef : Integer, ATypeDef -> ATypeDef\n  copy-as-typedef (b) (d) =\n   when d\n    is ARecordTypeDef (n) (ps) (fs) (m) (sp) -> ARecordTypeDef (copy-as-name b n) (copy-as-names b ps) (for f in fs -> copy-as-recordfielddef b f) m (copy-sx-span b sp)\n    is AVariantTypeDef (n) (ps) (cs) (sp) -> AVariantTypeDef (copy-as-name b n) (copy-as-names b ps) (for c in cs -> copy-as-variantctordef b c) (copy-sx-span b sp)\n    is AUnitTypeDef (n) (base) (sp) -> AUnitTypeDef (copy-as-name b n) (copy-as-typeexpr b base) (copy-sx-span b sp)\n\n  copy-as-effectopdef : Integer, AEffectOpDef -> AEffectOpDef\n  copy-as-effectopdef (b) (o) = AEffectOpDef { name = copy-as-name b (o.name), type-expr = copy-as-typeexpr b (o.type-expr), span = copy-sx-span b (o.span) }\n\n  copy-as-effectdef : Integer, AEffectDef -> AEffectDef\n  copy-as-effectdef (b) (d) = AEffectDef { name = copy-as-name b (d.name), ops = for o in (d.ops) -> copy-as-effectopdef b o, span = copy-sx-span b (d.span) }\n\n  copy-as-classdef : Integer, AClassDef -> AClassDef\n  copy-as-classdef (b) (d) = AClassDef { name = copy-as-name b (d.name), methods = for m in (d.methods) -> copy-as-effectopdef b m, span = copy-sx-span b (d.span) }\n\n  copy-as-instmethod : Integer, AInstanceMethodDef -> AInstanceMethodDef\n  copy-as-instmethod (b) (m) = AInstanceMethodDef {\n   name = copy-as-name b (m.name),\n   params = copy-as-names b (m.params),\n   body = copy-as-expr b (m.body),\n   span = copy-sx-span b (m.span)\n  }\n\n  copy-as-instancedef : Integer, AInstanceDef -> AInstanceDef\n  copy-as-instancedef (b) (d) = AInstanceDef {\n   class-name = copy-as-name b (d.class-name),\n   type-name = copy-as-name b (d.type-name),\n   methods = for m in (d.methods) -> copy-as-instmethod b m,\n   span = copy-sx-span b (d.span)\n  }\n\n  copy-as-citesdecl : Integer, ACitesDecl -> ACitesDecl\n  copy-as-citesdecl (b) (c) = ACitesDecl {\n   quire = copy-as-name b (c.quire),\n   chapter-name = copy-as-name b (c.chapter-name),\n   selected-names = copy-as-names b (c.selected-names),\n   citing-chapter = copy-sx-text b (c.citing-chapter),\n   span = copy-sx-span b (c.span)\n  }\n\n  copy-as-chapter : Integer, AChapter -> AChapter\n  copy-as-chapter (b) (ch) = AChapter {\n   name = copy-as-name b (ch.name),\n   defs = for d in (ch.defs) -> copy-as-def b d,\n   type-defs = for t in (ch.type-defs) -> copy-as-typedef b t,\n   effect-defs = for e in (ch.effect-defs) -> copy-as-effectdef b e,\n   class-defs = for c in (ch.class-defs) -> copy-as-classdef b c,\n   instance-defs = for i in (ch.instance-defs) -> copy-as-instancedef b i,\n   citations = for c in (ch.citations) -> copy-as-citesdecl b c,\n   ground-effects = copy-sx-texts b (ch.ground-effects),\n   chapter-title = copy-sx-text b (ch.chapter-title),\n   prose = copy-sx-text b (ch.prose),\n   prose-blocks = for p in (ch.prose-blocks) -> copy-sx-proseblock b p,\n   annotations = for a in (ch.annotations) -> copy-sx-annotation b a,\n   section-titles = copy-sx-texts b (ch.section-titles),\n   rt-names = copy-sx-texts b (ch.rt-names),\n   rt-budgets = for x in (ch.rt-budgets) -> x,\n   conversions = copy-sx-texts b (ch.conversions),\n   span = copy-sx-span b (ch.span)\n  }\n\n The frontier is __heap-save (R10), not __deck-pos: this copy runs inside\n a phase-wide deck-record extent, where __deck-exit writes the deck-pos\n cell back only when the nesting counter returns to zero, so the cell is\n frozen at the deck's base for the whole copy. Measured 2026-07-21 with a\n `deck-record (__heap-save)` probe on either side of the extent: R10\n inside it reads exactly fk-base at entry and exactly the post-exit cell\n value at exit, so it tracks the deck the cell cannot.\n\n On saturation an EMPTY chapter is returned, and it must be empty rather\n than the shared original -- this is DESUGAR's contract, not the\n PARSE-KEEP one, because the callers differ in what happens next.\n compile-parse ends its phase at its copy, so returning the shared scratch\n there is safe until the caller halts. compile-desugar-and-scope does NOT:\n it compacts the DESUGAR deck three lines later and runs SCOPE inside the\n same function, before any caller can read the bag. Measured by shipping\n the shared original: the selfhost against an 8 MB keep floor dies\n `!EXC=0d` in scope-adefs-ll, reading a chapter whose deck had been\n reclaimed underneath it. The empty wind-down is O(1) -- a name and a span\n -- so it cannot walk through the ceiling the way LEX's token conversion\n did.\n\n  GuardedChapterCopy = record {\n   chapter : AChapter,\n   sat : Integer\n  }\n\n  copy-as-defs-guarded : Integer, Integer, List ADef, Integer, Integer, List ADef -> List ADef\n  copy-as-defs-guarded (b) (ceiling) (ds) (i) (len) (acc) =\n   if i == len then acc\n   else if __heap-save >= ceiling then acc\n   else copy-as-defs-guarded b ceiling ds (i + 1) len (list-push acc (copy-as-def b (list-at ds i)))\n\n  copy-as-typedefs-guarded : Integer, Integer, List ATypeDef, Integer, Integer, List ATypeDef -> List ATypeDef\n  copy-as-typedefs-guarded (b) (ceiling) (ts) (i) (len) (acc) =\n   if i == len then acc\n   else if __heap-save >= ceiling then acc\n   else copy-as-typedefs-guarded b ceiling ts (i + 1) len (list-push acc (copy-as-typedef b (list-at ts i)))\n\n  copy-as-proseblocks-guarded : Integer, Integer, List ProseBlock, Integer, Integer, List ProseBlock -> List ProseBlock\n  copy-as-proseblocks-guarded (b) (ceiling) (ps) (i) (len) (acc) =\n   if i == len then acc\n   else if __heap-save >= ceiling then acc\n   else copy-as-proseblocks-guarded b ceiling ps (i + 1) len (list-push acc (copy-sx-proseblock b (list-at ps i)))\n\n  copy-as-annotations-guarded : Integer, Integer, List AnnotationNode, Integer, Integer, List AnnotationNode -> List AnnotationNode\n  copy-as-annotations-guarded (b) (ceiling) (ns) (i) (len) (acc) =\n   if i == len then acc\n   else if __heap-save >= ceiling then acc\n   else copy-as-annotations-guarded b ceiling ns (i + 1) len (list-push acc (copy-sx-annotation b (list-at ns i)))\n\n  empty-as-chapter : Integer, AChapter -> AChapter\n  empty-as-chapter (b) (ch) = AChapter {\n   name = copy-as-name b (ch.name),\n   defs = [],\n   type-defs = [],\n   effect-defs = [],\n   class-defs = [],\n   instance-defs = [],\n   citations = [],\n   ground-effects = [],\n   chapter-title = \"\",\n   prose = \"\",\n   prose-blocks = [],\n   annotations = [],\n   section-titles = [],\n   rt-names = [],\n   rt-budgets = [],\n   conversions = [],\n   span = copy-sx-span b (ch.span)\n  }\n\n  copy-as-chapter-guarded : Integer, Integer, AChapter -> GuardedChapterCopy\n  copy-as-chapter-guarded (b) (ceiling) (ch) =\n   let defs2 = copy-as-defs-guarded b ceiling (ch.defs) 0 (list-length (ch.defs)) []\n   in let tds2 = copy-as-typedefs-guarded b ceiling (ch.type-defs) 0 (list-length (ch.type-defs)) []\n   in let pbs2 = copy-as-proseblocks-guarded b ceiling (ch.prose-blocks) 0 (list-length (ch.prose-blocks)) []\n   in let anns2 = copy-as-annotations-guarded b ceiling (ch.annotations) 0 (list-length (ch.annotations)) []\n   in if __heap-save >= ceiling\n      then GuardedChapterCopy { chapter = empty-as-chapter b ch, sat = 1 }\n      else GuardedChapterCopy { chapter = AChapter {\n       name = copy-as-name b (ch.name),\n       defs = defs2,\n       type-defs = tds2,\n       effect-defs = for e in (ch.effect-defs) -> copy-as-effectdef b e,\n       class-defs = for c in (ch.class-defs) -> copy-as-classdef b c,\n       instance-defs = for i in (ch.instance-defs) -> copy-as-instancedef b i,\n       citations = for c in (ch.citations) -> copy-as-citesdecl b c,\n       ground-effects = copy-sx-texts b (ch.ground-effects),\n       chapter-title = copy-sx-text b (ch.chapter-title),\n       prose = copy-sx-text b (ch.prose),\n       prose-blocks = pbs2,\n       annotations = anns2,\n       section-titles = copy-sx-texts b (ch.section-titles),\n       rt-names = copy-sx-texts b (ch.rt-names),\n       rt-budgets = for x in (ch.rt-budgets) -> x,\n       conversions = copy-sx-texts b (ch.conversions),\n       span = copy-sx-span b (ch.span)\n      }, sat = 0 }\n\nPage 1\n"

Section: Show Lists
  show-texts : List Text, Integer, Integer, Text -> [Console] Nothing
  show-texts (xs) (i) (len) (label) = act
    if i >= len then print-line-uni "."
    else act
      print-line-uni (label & " " & list-at xs i)
      show-texts xs (i + 1) len label
    end
  end

  show-defs : List Def, Integer, Integer -> [Console] Nothing
  show-defs (ds) (i) (len) = act
    if i >= len then print-line-uni "."
    else act
      let d = list-at ds i
      in print-line-uni ("def " & token-text (d.name)
           & " params " & show (list-length (d.params))
           & " anns " & show (list-length (d.ann))
           & " L" & show ((d.name).line) & "C" & show ((d.name).column)
           & " slug " & d.chapter-slug)
      show-defs ds (i + 1) len
    end
  end

  show-adefs : List ADef, Integer, Integer -> [Console] Nothing
  show-adefs (ds) (i) (len) = act
    if i >= len then print-line-uni "."
    else act
      let d = list-at ds i
      in print-line-uni ("adef " & (d.name).value
           & " params " & show (list-length (d.params))
           & " dtype " & show (list-length (d.declared-type))
           & " L" & show (((d.span).start).line) & "C" & show (((d.span).start).column)
           & " slug " & d.chapter-slug)
      show-adefs ds (i + 1) len
    end
  end

Section: Driver
  opening : [Console] Nothing = act
    let toks = tokenize subject-text 1
    in let doc = parse-document (make-parse-state (toks.tokens) subject-text) 0
    in let dr = desugar-document subject-text doc (doc.chapter-title) 0
    in let ch = dr.dr-chapter
    in act
      print-line-uni ("lex-tokens " & show (list-length (toks.tokens)))
      print-line-uni ("lex-errors " & show (list-length (toks.errors)))
      print-line-uni ("chapter |" & doc.chapter-title & "|")
      print-line-uni ("defs " & show (list-length (doc.defs)))
      show-defs (doc.defs) 0 (list-length (doc.defs))
      print-line-uni ("parse-errors " & show ((doc.parse-bag).error-count))
      print-line-uni "--- desugar ---"
      print-line-uni ("dr-sat " & show (dr.dr-sat))
      print-line-uni ("a-name |" & (ch.name).value & "|")
      print-line-uni ("a-chapter-title |" & ch.chapter-title & "|")
      print-line-uni ("a-prose-len " & show (text-length (ch.prose)))
      print-line-uni ("a-defs " & show (list-length (ch.defs)))
      show-adefs (ch.defs) 0 (list-length (ch.defs))
      print-line-uni ("a-type-defs " & show (list-length (ch.type-defs)))
      print-line-uni ("a-effect-defs " & show (list-length (ch.effect-defs)))
      print-line-uni ("a-class-defs " & show (list-length (ch.class-defs)))
      print-line-uni ("a-instance-defs " & show (list-length (ch.instance-defs)))
      print-line-uni ("a-citations " & show (list-length (ch.citations)))
      print-line-uni ("a-ground-effects " & show (list-length (ch.ground-effects)))
      print-line-uni ("a-prose-blocks " & show (list-length (ch.prose-blocks)))
      print-line-uni ("a-annotations " & show (list-length (ch.annotations)))
      print-line-uni ("a-sections " & show (list-length (ch.section-titles)))
      show-texts (ch.section-titles) 0 (list-length (ch.section-titles)) "a-section"
      print-line-uni ("a-rt-names " & show (list-length (ch.rt-names)))
      print-line-uni ("a-conversions " & show (list-length (ch.conversions)))
      print-line-uni "---"
    end
  end
