    code : Integer between 0 and 65535,
    name : Text,
    severity : Integer between 0 and 3,
    phase : Integer between 0 and 15,
    summary : Text
  }

Section: Infrastructure
  cdx-too-many-errors : Integer = 1

  cdx-resource-exhausted : Integer = 9001

  cdx-deck-overflow : Integer = 9002

  cdx-escape-violation : Integer = 9003

  cdx-list-literal-too-large : Integer = 9004

  cdx-accum-overflow : Integer = 9005

  cdx-lir-prologue-violation : Integer = 9006

  cdx-lir-structural-violation : Integer = 9007

  cdx-lir-allocation-violation : Integer = 9008

  cdx-tco-shuffle-violation : Integer = 9009

  cdx-int-compare-on-float : Integer = 9010

  cdx-pow-on-float : Integer = 9011

  cdx-order-compare-on-text : Integer = 9012

