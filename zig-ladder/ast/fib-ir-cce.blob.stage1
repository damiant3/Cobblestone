  is-right-brace : TokenKind -> Boolean
  is-right-brace (k) =
   when k
    is RightBrace -> True
    is otherwise -> False

  is-right-bracket : TokenKind -> Boolean
  is-right-bracket (k) =
   when k
    is RightBracket -> True
    is otherwise -> False

  is-right-paren : TokenKind -> Boolean
  is-right-paren (k) =
   when k
    is RightParen -> True
    is otherwise -> False

  is-if-keyword : TokenKind -> Boolean
  is-if-keyword (k) =
   when k
    is IfKeyword -> True
    is otherwise -> False

  is-is-keyword : TokenKind -> Boolean
  is-is-keyword (k) =
   when k
    is IsKeyword -> True
    is otherwise -> False

  is-match-arm-start : TokenKind -> Boolean
  is-match-arm-start (k) =
