Section: Type Parsing
  is-forall-start : ParseState -> Boolean
  is-forall-start (st) =
   when (current-kind st)
    is ForAllKeyword -> True
    is Identifier ->
     if token-text (current st) == "for" then
      let idx = (st.pos) + 1
      in if idx >= list-length (st.tokens) then False
      else token-text (list-at (st.tokens) idx) == "all"
     else False
    is otherwise -> False

  parse-forall-type : ParseState -> ParseTypeResult
  parse-forall-type (st) =
   let qtok = current st
   in let st1 = when (current-kind st) is ForAllKeyword -> advance st is otherwise -> advance (advance st)
   in let st2 = expect LeftParen st1
   in let var-tok = current st2
   in let st3 = if is-ident (current-kind st2) then advance st2 else st2
   in let st4 = expect Colon st3
   in when (parse-type st4)
    is TypeOk (vty) (st5) ->
     let st6 = expect RightParen st5
     in let st7 = expect Comma st6
     in when (parse-type st7)
      is TypeOk (pty) (st8) ->
       TypeOk (subj-deck-record (ForAllType var-tok vty pty)) st8

  parse-type : ParseState -> ParseTypeResult
  parse-type (st) =
   if parse-fuel-exhausted st then TypeOk (subj-deck-record (NamedType (current st))) (emit-parse-fuel-error st "parse-type")
   else let st0 = consume-parse-fuel st
   in if is-forall-start st0 then parse-forall-type st0
   else when (current-kind st0)
    is LinearKeyword ->
     let atom-r = parse-type-atom (advance st0)
     in unwrap-type-ok atom-r parse-linear-after
    is MutableKeyword ->
     let atom-r = parse-type-atom (advance st0)
     in unwrap-type-ok atom-r parse-type-with-args
    is otherwise ->
     let atom-r = parse-type-atom st0
     in unwrap-type-ok atom-r parse-type-with-args

  parse-linear-after : TypeExpr, ParseState -> ParseTypeResult
  parse-linear-after (atom) (st) =
   let applied-r = parse-type-args atom st
   in unwrap-type-ok applied-r wrap-linear-continue

  wrap-linear-continue : TypeExpr, ParseState -> ParseTypeResult
  wrap-linear-continue (applied) (st) =
   parse-type-bound-or-continue (subj-deck-record (LinearTypeExpr applied)) st

  parse-type-with-args : TypeExpr, ParseState -> ParseTypeResult
  parse-type-with-args (atom) (st) =
   let applied-r = parse-type-args atom st
   in unwrap-type-ok applied-r parse-type-bound-or-continue

  parse-type-bound-or-continue : TypeExpr, ParseState -> ParseTypeResult
  parse-type-bound-or-continue (left) (st) =
   if is-between-keyword (current-kind st) then parse-bound-between left (advance st)
   else unwrap-type-ok (parse-type-mul-tail left st) parse-type-add-tail

  is-type-mul-op : TokenKind -> Boolean
  is-type-mul-op (k) =
   when k
    is Star | Slash -> True
    is otherwise -> False

  is-type-add-op : TokenKind -> Boolean
  is-type-add-op (k) =
   when k
    is Plus | Minus -> True
    is otherwise -> False

  parse-type-arith-operand : ParseState -> ParseTypeResult
  parse-type-arith-operand (st) =
   let atom-r = parse-type-atom st
   in unwrap-type-ok atom-r parse-type-args

  parse-type-mul-tail : TypeExpr, ParseState -> ParseTypeResult
  parse-type-mul-tail (left) (st) =
   if parse-fuel-exhausted st then TypeOk left (emit-parse-fuel-error st "parse-type-mul-tail")
   else let st-fueled = consume-parse-fuel st
   in if is-type-mul-op (current-kind st-fueled)
    then let op-tok = current st-fueled
     in unwrap-type-ok (parse-type-arith-operand (advance st-fueled)) (make-type-arith-mul left op-tok)
    else TypeOk left st-fueled

  make-type-arith-mul : TypeExpr, Token, TypeExpr, ParseState -> ParseTypeResult
  make-type-arith-mul (left) (op-tok) (right) (st) =
   parse-type-mul-tail (subj-deck-record (AppType (subj-deck-record (NamedType op-tok)) [left, right])) st

  parse-type-add-tail : TypeExpr, ParseState -> ParseTypeResult
  parse-type-add-tail (left) (st) =
   unwrap-type-ok (parse-type-add-loop left st) parse-type-append-tail

  parse-type-add-loop : TypeExpr, ParseState -> ParseTypeResult
  parse-type-add-loop (left) (st) =
   if parse-fuel-exhausted st then TypeOk left (emit-parse-fuel-error st "parse-type-add-tail")
   else let st-fueled = consume-parse-fuel st
   in if is-type-add-op (current-kind st-fueled)
    then let op-tok = current st-fueled
     in unwrap-type-ok (parse-type-add-operand (advance st-fueled)) (make-type-arith-add left op-tok)
    else TypeOk left st-fueled

  parse-type-add-operand : ParseState -> ParseTypeResult
  parse-type-add-operand (st) =
   unwrap-type-ok (parse-type-arith-operand st) parse-type-mul-tail

  make-type-arith-add : TypeExpr, Token, TypeExpr, ParseState -> ParseTypeResult
  make-type-arith-add (left) (op-tok) (right) (st) =
   parse-type-add-loop (subj-deck-record (AppType (subj-deck-record (NamedType op-tok)) [left, right])) st

  parse-type-append-tail : TypeExpr, ParseState -> ParseTypeResult
  parse-type-append-tail (left) (st) =
   if parse-fuel-exhausted st then TypeOk left (emit-parse-fuel-error st "parse-type-append-tail")
   else let st-fueled = consume-parse-fuel st
   in if current-kind st-fueled == Ampersand
    then let op-tok = current st-fueled
     in unwrap-type-ok (parse-type-append-operand (advance st-fueled)) (make-type-append left op-tok)
    else parse-type-continue left st-fueled

  parse-type-append-operand : ParseState -> ParseTypeResult
  parse-type-append-operand (st) =
   unwrap-type-ok (unwrap-type-ok (parse-type-arith-operand st) parse-type-mul-tail) parse-type-add-loop

  make-type-append : TypeExpr, Token, TypeExpr, ParseState -> ParseTypeResult
  make-type-append (left) (op-tok) (right) (st) =
   parse-type-append-tail (subj-deck-record (AppType (subj-deck-record (NamedType op-tok)) [left, right])) st

  parse-bound-int : ParseState -> (Integer, ParseState)
  parse-bound-int (st) =
   if is-minus (current-kind st) then
    let st1 = advance st
    in if is-literal (current-kind st1) then (-(lit-text-to-integer (token-text (current st1))), advance st1)
    else (0, report-bound-int-error st1)
   else if is-literal (current-kind st) then (lit-text-to-integer (token-text (current st)), advance st)
   else (0, report-bound-int-error st)

  report-bound-int-error : ParseState -> ParseState
  report-bound-int-error (st) =
   let tok = current st
   in __record-set st "bag" (bag-add (st.bag) (make-error cdx-expected-token-kind ("expected integer literal in bound annotation, got '" & (token-text tok) & "'") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))

  parse-bound-between : TypeExpr, ParseState -> ParseTypeResult
  parse-bound-between (base) (st) =
   let (lo, st-lo) = parse-bound-int st
   in let st-and = expect-and-keyword st-lo
   in let (hi, st-hi) = parse-bound-int st-and
   in let mode-tok = current st-hi
   in let (mode, st-mode) = parse-overflow-mode st-hi
   in let st-mode-ok = check-wrapping-band lo hi mode mode-tok st-mode
   in parse-type-continue (subj-deck-record (BoundedIntType base lo hi mode)) st-mode-ok

  check-wrapping-band : Integer, Integer, OverflowMode, Token, ParseState -> ParseState
  check-wrapping-band (lo) (hi) (mode) (tok) (st) =
   when mode
    is OvWrapping ->
     if bounds-are-hw-width lo hi then st
     else __record-set st "bag" (bag-add (st.bag) (make-error cdx-wrapping-band-not-hw-width ("a wrapping band must be exactly its hardware width, and " & show lo & " to " & show hi & " is not: the store wraps at the width, so the field can hold a value outside the declared range while the bounds prover still trusts that range. Widen the band to the whole width, or use clamping or error") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))
    is otherwise -> st

  expect-and-keyword : ParseState -> ParseState
  expect-and-keyword (st) =
   if is-ident (current-kind st) & token-text (current st) == "and"
   then advance st
   else let tok = current st
        in __record-set st "bag" (bag-add (st.bag) (make-error cdx-expected-token-kind ("expected 'and' in bound annotation, got '" & (token-text tok) & "'") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))

  parse-overflow-mode : ParseState -> (OverflowMode, ParseState)
  parse-overflow-mode (st) =
   if is-ident (current-kind st) then
    let txt = token-text (current st)
    in if txt == "wrapping" then (subj-deck-record OvWrapping, advance st)
       else if txt == "clamping" then (subj-deck-record OvClamping, advance st)
       else if txt == "error" then (subj-deck-record OvError, advance st)
       else (subj-deck-record OvError, st)
   else (subj-deck-record OvError, st)

  parse-type-continue : TypeExpr, ParseState -> ParseTypeResult
  parse-type-continue (left) (st) =
   if parse-fuel-exhausted st then TypeOk left (emit-parse-fuel-error st "parse-type-continue")
   else let st-fueled = consume-parse-fuel st
   in if is-arrow (current-kind st-fueled) then let arrow-span = token-to-span (current st-fueled)
     in let st2 = advance st-fueled
     in let right-result = parse-type st2
     in unwrap-type-ok right-result (make-fun-type-arrow left arrow-span)
    else if is-fat-arrow (current-kind st-fueled) then let st2 = advance st-fueled
     in let right-result = parse-type st2
     in unwrap-type-ok right-result (make-constrained-type left)
    else if current-kind st-fueled == TripleEquals then let eq-span = token-to-span (current st-fueled)
     in let st2 = advance st-fueled
     in let right-result = parse-type st2
     in unwrap-type-ok right-result (make-prop-eq-type left eq-span)
    else if is-comma (current-kind st-fueled) then if comma-starts-type-param st-fueled
     then let st2 = skip-newlines (advance st-fueled)
       in let right-result = parse-type st2
       in unwrap-type-ok right-result (make-fun-type left)
     else TypeOk left st-fueled
    else TypeOk left st-fueled

  comma-starts-type-param : ParseState -> Boolean
  comma-starts-type-param (st) =
   let next = peek-kind st 1
   in if is-type-ident next then True
      else if is-left-bracket next then True
      else if is-left-paren next then True
      else if is-ident next then if is-colon (peek-kind st 2) then False else True
      else False

  make-fun-type : TypeExpr, TypeExpr, ParseState -> ParseTypeResult
  make-fun-type (left) (right) (st) =
   TypeOk (subj-deck-record (FunType left right)) st

  make-prop-eq-type : TypeExpr, SourceSpan, TypeExpr, ParseState -> ParseTypeResult
  make-prop-eq-type (left) (span) (right) (st) =
   TypeOk (subj-deck-record (PropEqType left right span)) st

  make-constrained-type : TypeExpr, TypeExpr, ParseState -> ParseTypeResult
  make-constrained-type (constraint) (body) (st) =
   TypeOk (subj-deck-record (ConstrainedType constraint body)) st

  make-fun-type-arrow : TypeExpr, SourceSpan, TypeExpr, ParseState -> ParseTypeResult
  make-fun-type-arrow (left) (arrow-span) (right) (st) =
   let st2 = when right
    is FunType (p) (r) -> __record-set st "bag" (bag-add (st.bag) (make-error cdx-chained-arrow-type "Chained '->' in a type is not allowed; use commas for multiple parameters: 'A, B -> C' not 'A -> B -> C'" arrow-span))
    is otherwise -> st
   in TypeOk (subj-deck-record (FunType left right)) st2

  unwrap-type-ok : ParseTypeResult, (TypeExpr, ParseState -> ParseTypeResult) -> ParseTypeResult
  unwrap-type-ok (r) (f) =
   when r
    is TypeOk (t) (st) -> f t st

  parse-type-atom : ParseState -> ParseTypeResult
  parse-type-atom (st) =
   if is-ident (current-kind st) then let tok = current st
   in TypeOk (subj-deck-record (NamedType tok)) (advance st)
   else if is-type-ident (current-kind st) then let tok = current st
   in TypeOk (subj-deck-record (NamedType tok)) (advance st)
   else if is-left-paren (current-kind st) then parse-paren-type (advance st)
   else if is-left-bracket (current-kind st) then parse-effect-type (advance st)
   else if is-signed-literal-atom st then parse-signed-literal-atom st
   else let tok = current st
   in TypeOk (subj-deck-record (NamedType tok)) (advance st)

 Adjacency is what separates this from binary subtraction, and it has
 to be adjacency in the SOURCE rather than token order: `1 - 3` and
 `-2` produce the same two token kinds. The digits must begin at the
 byte immediately after the minus. That also makes the synthesized
 token honest -- its text is read straight out of the source across
 both tokens, so `token-text` answers "-2" without anything being
 fabricated.

  is-signed-literal-atom : ParseState -> Boolean
  is-signed-literal-atom (st) =
   if current-kind st == Minus then
    let nxt = peek-kind st 1
    in if nxt == IntegerLiteral | nxt == NumberLiteral
       then (list-at (st.tokens) (st.pos + 1)).offset == (current st).offset + 1
       else False
   else False

  parse-signed-literal-atom : ParseState -> ParseTypeResult
  parse-signed-literal-atom (st) =
   let minus-tok = current st
   in let num-tok = list-at (st.tokens) (st.pos + 1)
   in let signed = subj-deck-record (Token {
    kind = num-tok.kind,
    source = minus-tok.source,
    offset = minus-tok.offset,
    length = (num-tok.offset + num-tok.length) - minus-tok.offset,
    line = minus-tok.line,
    column = minus-tok.column,
    file-id = minus-tok.file-id
   })
   in TypeOk (subj-deck-record (NamedType signed)) (advance (advance st))

  parse-paren-type : ParseState -> ParseTypeResult
  parse-paren-type (st) =
   if classify-paren-type st 0 False False == 2 then parse-tuple-type st
   else let inner = parse-type st
   in unwrap-type-ok inner finish-paren-type

  classify-paren-type : ParseState, Integer, Boolean, Boolean -> Integer
  classify-paren-type (st) (depth) (saw-arrow) (saw-comma) =
   if is-done st then classify-paren-result saw-arrow saw-comma
   else let k = current-kind st
   in if is-left-paren k then classify-paren-type (advance st) (depth + 1) saw-arrow saw-comma
    else if is-left-bracket k then classify-paren-type (advance st) (depth + 1) saw-arrow saw-comma
    else if is-right-paren k then if depth == 0 then classify-paren-result saw-arrow saw-comma
       else classify-paren-type (advance st) (depth - 1) saw-arrow saw-comma
    else if is-right-bracket k then classify-paren-type (advance st) (depth - 1) saw-arrow saw-comma
    else if depth == 0 then if is-arrow k then classify-paren-type (advance st) depth True saw-comma
       else if is-comma k then classify-paren-type (advance st) depth saw-arrow True
       else classify-paren-type (advance st) depth saw-arrow saw-comma
    else classify-paren-type (advance st) depth saw-arrow saw-comma

  classify-paren-result : Boolean, Boolean -> Integer
  classify-paren-result (saw-arrow) (saw-comma) =
   if saw-arrow then 1 else if saw-comma then 2 else 0

  parse-tuple-type : ParseState -> ParseTypeResult
  parse-tuple-type (st) =
   let e = parse-tuple-type-elem st
   in unwrap-type-ok e tuple-type-after-first

  parse-tuple-type-elem : ParseState -> ParseTypeResult
  parse-tuple-type-elem (st) =
   let atom-r = parse-type-atom st
   in unwrap-type-ok atom-r parse-type-args

  tuple-type-after-first : TypeExpr, ParseState -> ParseTypeResult
  tuple-type-after-first (first) (st) =
   if is-comma (current-kind st) then collect-tuple-type (__linked-list-push [] first) (advance st)
   else finish-paren-type first st

  collect-tuple-type : LinkedList TypeExpr, ParseState -> ParseTypeResult
  collect-tuple-type (acc) (st) =
   let e = parse-tuple-type-elem st
   in unwrap-type-ok e (after-tuple-type-elem acc)

  after-tuple-type-elem : LinkedList TypeExpr, TypeExpr, ParseState -> ParseTypeResult
  after-tuple-type-elem (acc) (e) (st) =
   let acc2 = __linked-list-push acc e
   in if is-comma (current-kind st) then collect-tuple-type acc2 (advance st)
   else let st2 = expect RightParen st
   in TypeOk (subj-deck-record (TupleType (subj-deck-record (__linked-list-to-list acc2)))) st2

  finish-paren-type : TypeExpr, ParseState -> ParseTypeResult
  finish-paren-type (t) (st) =
   let st2 = expect RightParen st
   in TypeOk (subj-deck-record (ParenType t)) st2

  parse-effect-type : ParseState -> ParseTypeResult
  parse-effect-type (st) =
   let (eff-names, st-effs, eff-scopes, eff-tail) = parse-effect-names st [] [] []
   in let ret = parse-type st-effs
   in unwrap-type-ok ret (finish-effect-type eff-names eff-scopes eff-tail)

  finish-effect-type : List Token, List Token, List Token, TypeExpr, ParseState -> ParseTypeResult
  finish-effect-type (effs) (scopes) (tail) (ret) (st) =
   TypeOk (subj-deck-record (EffectTypeExpr effs scopes tail ret)) st

  empty-scope-tok : Token = Token {
   kind = TextLiteral,
   source = "",
   offset = 0,
   length = 0,
   line = 0,
   column = 0,
   file-id = 0
  }

 Inside effect brackets the identifier case is load-bearing:
 a PascalCase identifier is a concrete
 effect name; a lowercase identifier is the row's tail variable. A
 row names at most one tail (CDX1120), and a tail is bare -- no scope
 literal, no dotted sub-effect (CDX1121).

  parse-effect-names : ParseState, List Token, List Token, List Token -> (List Token, ParseState, List Token, List Token)
  parse-effect-names (st) (acc) (sacc) (tacc) =
   if is-done st then (acc, st, sacc, tacc)
   else if is-right-bracket (current-kind st) then (acc, advance st, sacc, tacc)
   else if is-comma (current-kind st) then parse-effect-names (advance st) acc sacc tacc
   else if is-ident (current-kind st) then parse-row-tail st acc sacc tacc
   else if is-type-ident (current-kind st) then
    let tok = current st
    in let st2 = advance st
    in if is-dot (current-kind st2) then parse-dotted-effect st2 tok acc sacc tacc
       else parse-effect-with-scope st2 tok acc sacc tacc
   else parse-effect-names (advance st) acc sacc tacc

  parse-row-tail : ParseState, List Token, List Token, List Token -> (List Token, ParseState, List Token, List Token)
  parse-row-tail (st) (acc) (sacc) (tacc) =
   let tok = current st
   in let st2 = advance st
   in if is-dot (current-kind st2) then
       let st3 = __record-set st2 "bag" (bag-add (st2.bag) (make-error cdx-row-tail-decorated ("a row variable is a bare lowercase identifier; '" & token-text tok & "' cannot take a dotted sub-effect") (token-to-span tok)))
       in parse-dotted-effect st3 tok acc sacc tacc
      else if is-text-lit (current-kind st2) then
       let st3 = __record-set st2 "bag" (bag-add (st2.bag) (make-error cdx-row-tail-decorated ("a row variable is a bare lowercase identifier; '" & token-text tok & "' cannot take a scope literal") (token-to-span tok)))
       in parse-effect-names (advance st3) acc sacc (list-push tacc tok)
      else if list-length tacc > 0 then
       let st3 = __record-set st2 "bag" (bag-add (st2.bag) (make-error cdx-row-two-tails ("an effect row may name at most one row variable; found '" & token-text tok & "' after an earlier row variable") (token-to-span tok)))
       in parse-effect-names st3 acc sacc tacc
      else parse-effect-names st2 acc sacc (list-push tacc tok)

  parse-effect-with-scope : ParseState, Token, List Token, List Token, List Token -> (List Token, ParseState, List Token, List Token)
  parse-effect-with-scope (st) (name-tok) (acc) (sacc) (tacc) =
   if is-text-lit (current-kind st) then
    let scope-tok = current st
    in parse-effect-names (advance st) (list-push acc name-tok) (list-push sacc scope-tok) tacc
   else parse-effect-names st (list-push acc name-tok) (list-push sacc empty-scope-tok) tacc

  parse-dotted-effect : ParseState, Token, List Token, List Token, List Token -> (List Token, ParseState, List Token, List Token)
  parse-dotted-effect (st) (base-tok) (acc) (sacc) (tacc) =
   let st2 = advance st
   in if is-ident (current-kind st2) | is-type-ident (current-kind st2) then
    let sub = current st2
    in let combined = subj-deck-record (Token {
     kind = Identifier,
     source = base-tok.source,
     offset = base-tok.offset,
     length = sub.offset + sub.length - base-tok.offset,
     line = base-tok.line,
     column = base-tok.column,
     file-id = base-tok.file-id
    })
    in parse-effect-with-scope (advance st2) combined acc sacc tacc
   else parse-effect-names st2 (list-push acc base-tok) (list-push sacc empty-scope-tok) tacc

  parse-type-args : TypeExpr, ParseState -> ParseTypeResult
  parse-type-args (base-type) (st) =
   if parse-fuel-exhausted st then TypeOk base-type (emit-parse-fuel-error st "parse-type-args")
   else let st-fueled = consume-parse-fuel st
   in if is-done st-fueled then TypeOk base-type st-fueled
   else if is-type-arg-start (current-kind st-fueled) then parse-type-arg-next base-type st-fueled
   else TypeOk base-type st-fueled

  parse-type-arg-next : TypeExpr, ParseState -> ParseTypeResult
  parse-type-arg-next (base-type) (st) =
   let arg-result = parse-type-atom st
   in unwrap-type-ok arg-result (continue-type-args base-type)

  continue-type-args : TypeExpr, TypeExpr, ParseState -> ParseTypeResult
  continue-type-args (base-type) (arg) (st) =
   parse-type-args (subj-deck-record (AppType base-type [arg])) st

Section: Pattern Parsing
  parse-pattern : ParseState -> ParsePatResult
  parse-pattern (st) =
   if parse-fuel-exhausted st then PatOk (subj-deck-record (WildPat (current st))) (emit-parse-fuel-error st "parse-pattern")
   else let st-fueled = consume-parse-fuel st
   in if is-wildcard-pat (current-kind st-fueled) then PatOk (subj-deck-record (WildPat (current st-fueled))) (advance st-fueled)
   else if is-literal (current-kind st-fueled) then PatOk (subj-deck-record (LitPat (current st-fueled))) (advance st-fueled)
   else if is-type-ident (current-kind st-fueled) then let tok = current st-fueled
       in parse-ctor-pattern-fields tok [] (advance st-fueled)
   else if is-ident (current-kind st-fueled) then PatOk (subj-deck-record (VarPat (current st-fueled))) (advance st-fueled)
   else if is-keyword (current-kind st-fueled) then PatOk (subj-deck-record (VarPat (current st-fueled))) (advance (report-reserved-keyword "a pattern variable" st-fueled))
   else if is-left-paren (current-kind st-fueled) then parse-tuple-pattern (advance st-fueled)
       else PatOk (subj-deck-record (WildPat (current st-fueled))) (advance st-fueled)

  parse-tuple-pattern : ParseState -> ParsePatResult
  parse-tuple-pattern (st) =
   let p = parse-pattern st
   in unwrap-pat-ok p continue-tuple-pat

  continue-tuple-pat : Pat, ParseState -> ParsePatResult
  continue-tuple-pat (first) (st) =
   if is-comma (current-kind st) then collect-tuple-pat (__linked-list-push [] first) (advance st)
   else PatOk first (expect RightParen st)

  collect-tuple-pat : LinkedList Pat, ParseState -> ParsePatResult
  collect-tuple-pat (acc) (st) =
   let p = parse-pattern st
   in unwrap-pat-ok p (after-tuple-pat acc)

  after-tuple-pat : LinkedList Pat, Pat, ParseState -> ParsePatResult
  after-tuple-pat (acc) (p) (st) =
   let acc2 = __linked-list-push acc p
   in if is-comma (current-kind st) then collect-tuple-pat acc2 (advance st)
   else PatOk (subj-deck-record (TuplePat (subj-deck-record (__linked-list-to-list acc2)))) (expect RightParen st)

  parse-ctor-pattern-fields : Token, LinkedList Pat, ParseState -> ParsePatResult
  parse-ctor-pattern-fields (ctor) (acc) (st) =
   if parse-fuel-exhausted st then PatOk (subj-deck-record (CtorPat ctor (subj-deck-record (__linked-list-to-list acc)))) (emit-parse-fuel-error st "parse-ctor-pattern-fields")
   else let st-fueled = consume-parse-fuel st
   in if token-text ctor == "Vector" & is-left-bracket (current-kind st-fueled) then parse-vec-pat-elems [] (advance st-fueled)
    else if is-left-paren (current-kind st-fueled) then let st2 = advance st-fueled
     in let sub = parse-pattern st2
     in unwrap-pat-ok sub (continue-ctor-fields ctor acc)
    else PatOk (subj-deck-record (CtorPat ctor (subj-deck-record (__linked-list-to-list acc)))) st-fueled

  continue-ctor-fields : Token, LinkedList Pat, Pat, ParseState -> ParsePatResult
  continue-ctor-fields (ctor) (acc) (p) (st) =
   let st2 = expect RightParen st
   in parse-ctor-pattern-fields ctor (__linked-list-push acc p) st2

  parse-vec-pat-elems : List Pat, ParseState -> ParsePatResult
  parse-vec-pat-elems (acc) (st) =
   if is-right-bracket (current-kind st) then PatOk (subj-deck-record (VecPat acc)) (advance st)
   else let p = parse-pattern st
   in unwrap-pat-ok p (after-vec-pat-elem acc)

  after-vec-pat-elem : List Pat, Pat, ParseState -> ParsePatResult
  after-vec-pat-elem (acc) (p) (st) =
   let acc2 = list-push acc p
   in if is-comma (current-kind st) then parse-vec-pat-elems acc2 (advance st)
   else PatOk (subj-deck-record (VecPat acc2)) (expect RightBracket st)

  unwrap-pat-ok : ParsePatResult, (Pat, ParseState -> ParsePatResult) -> ParsePatResult
  unwrap-pat-ok (r) (f) =
   when r
    is PatOk (p) (st) -> f p st

Section: Definition Parsing
  parse-type-annotation : ParseState -> ParseTypeResult
  parse-type-annotation (st) =
   let st2 = advance st
   in let st3 = expect Colon st2
   in parse-type st3

  parse-definition : ParseState -> ParseDefResult
  parse-definition (st) =
   if is-done st then ParseDefResult { maybe-def = None, state = st }
   else if is-claim-keyword (current-kind st) then skip-claim-def st
   else if is-proof-keyword (current-kind st) then parse-definition (advance st)
   else if is-ident (current-kind st) then try-parse-def st
   else if is-type-ident (current-kind st) then try-parse-def st
     else ParseDefResult { maybe-def = None, state = st }

  is-simple-claim : ParseState -> Boolean
  is-simple-claim (st) =
   if is-ident (peek-kind st 1) then is-colon (peek-kind st 2)
   else False

  parse-claim-annotation : ParseState -> AnnotationNode
  parse-claim-annotation (st) =
   let st1 = advance st
   in if is-ident (current-kind st1) then
    let name = token-text (current st1)
    in let prop = collect-claim-prop (advance st1) ""
    in subj-deck-record (AnnotationNode { kind = "claim", target = name, body = prop })
   else subj-deck-record (AnnotationNode { kind = "claim", target = "", body = "" })

  collect-claim-prop : ParseState, Text -> Text
  collect-claim-prop (st) (acc) =
   if is-done st then acc
   else when current-kind st
    is Newline -> acc
    is otherwise -> collect-claim-prop (advance st) (acc & " " & token-text (current st))

  skip-claim-def : ParseState -> ParseDefResult
  skip-claim-def (st) =
   let col = (current st).column
   in let st2 = advance st
   in let st3 = skip-claim-tokens st2 col
   in parse-definition st3

  skip-claim-tokens : ParseState, Integer -> ParseState
  skip-claim-tokens (st) (col) =
   if is-done st then st
   else if (current st).column <= col & is-claim-or-def-start (current-kind st) then st
   else skip-claim-tokens (advance st) col

  is-claim-or-def-start : TokenKind -> Boolean
  is-claim-or-def-start (k) =
   when k
    is Identifier | TypeIdentifier | ClaimKeyword | ProofKeyword -> True
    is otherwise -> False

  try-parse-def : ParseState -> ParseDefResult
  try-parse-def (st) =
   if is-colon (peek-kind st 1) then let first-name = current st
     in let ann-result = parse-type-annotation st
     in unwrap-type-for-def first-name ann-result
    else parse-def-body-with-ann [] st

  unwrap-type-for-def : Token, ParseTypeResult -> ParseDefResult
  unwrap-type-for-def (first-name) (r) =
   when r
    is TypeOk (ann-type) (st) ->
     if is-equals (current-kind st) then
      let ann = subj-deck-record ([subj-deck-record (TypeAnn {
       name = first-name,
       type-expr = ann-type
      })])
      in let st2 = advance st
      in let st3 = skip-newlines st2
      in let body-result = parse-def-body-seq st3 (first-name.column)
      in unwrap-def-body body-result ann first-name []
     else
      let name-tok = subj-deck-record (Token {
       kind = Identifier,
       source = "",
       offset = 0,
       length = 0,
       line = 0,
       column = 0,
       file-id = 0
      })
      in let ann = subj-deck-record ([subj-deck-record (TypeAnn {
       name = name-tok,
       type-expr = ann-type
      })])
      in let st2 = skip-newlines st
      in parse-def-body-with-ann ann st2

  parse-def-body-with-ann : List TypeAnn, ParseState -> ParseDefResult
  parse-def-body-with-ann (ann) (st) =
   let st-skip = if is-proof-keyword (current-kind st) then advance st else st
   in let name-tok = current st-skip
   in let st2 = advance st-skip
   in parse-def-params-then ann name-tok [] st2

  parse-def-params-then : List TypeAnn, Token, LinkedList Token, ParseState -> ParseDefResult
  parse-def-params-then (ann) (name-tok) (acc) (st) =
   if is-left-paren (current-kind st) then parse-def-params-after-lparen ann name-tok acc (advance st)
   else finish-def ann name-tok (subj-deck-record (__linked-list-to-list acc)) st

  parse-def-params-after-lparen : List TypeAnn, Token, LinkedList Token, ParseState -> ParseDefResult
  parse-def-params-after-lparen (ann) (name-tok) (acc) (st) =
   if is-ident (current-kind st) then let param = current st
     in let st2 = expect RightParen (advance st)
     in parse-def-params-then ann name-tok (__linked-list-push acc param) st2
    else if is-reserved-keyword (current-kind st) then
     let st2 = report-reserved-keyword "a parameter name" st
     in let st3 = expect RightParen (advance st2)
     in parse-def-params-then ann name-tok acc st3
      else finish-def ann name-tok (subj-deck-record (__linked-list-to-list acc)) st

  finish-def : List TypeAnn, Token, List Token, ParseState -> ParseDefResult
  finish-def (ann) (name-tok) (params) (st) =
   if is-equals (current-kind st) then
    let st2 = advance st
    in let st3 = skip-newlines st2
    in let body-result = parse-def-body-seq st3 (name-tok.column)
    in unwrap-def-body body-result ann name-tok params
   else let tok = current st
    in let err-st = expect Equals st
    in let st2 = skip-body-tokens err-st (name-tok.column)
    in ParseDefResult {
     maybe-def = Just (subj-deck-record (Def {
      name = name-tok,
      params = params,
      ann = ann,
      body = ErrExpr tok,
      chapter-slug = ""
     })),
     state = st2
    }

  unwrap-def-body : ParseExprResult, List TypeAnn, Token, List Token -> ParseDefResult
  unwrap-def-body (r) (ann) (name-tok) (params) =
   when r
    is ExprOk (b) (st) ->
     ParseDefResult {
      maybe-def = Just (subj-deck-record (Def {
       name = name-tok,
       params = params,
       ann = ann,
       body = b,
       chapter-slug = ""
      })),
      state = st
     }

Section: Type Definition Parsing
  is-paren-type-param : ParseState -> Boolean
  is-paren-type-param (st) =
   if is-left-paren (current-kind st) then let k1 = peek-kind st 1
   in if is-ident k1 then is-right-paren (peek-kind st 2)
      else if is-type-ident k1 then is-right-paren (peek-kind st 2)
      else False
    else False

  is-type-param-pattern : ParseState -> Boolean
  is-type-param-pattern (st) =
   if is-paren-type-param st then True
   else is-ident (current-kind st)

  parse-type-params : ParseState, LinkedList Token -> ParseState
  parse-type-params (st) (acc) =
   if is-paren-type-param st then parse-type-params (advance (advance (advance st))) (__linked-list-push acc (list-at (st.tokens) (st.pos + 1)))
   else if is-ident (current-kind st) then parse-type-params (advance st) (__linked-list-push acc (current st))
   else st

  parse-unit-family : Token, List Token, ParseState -> ParseTypeDefResult
  parse-unit-family (name-tok) (tparams) (st) =
   let base-tok = current st
   in let st2 = skip-newlines (advance st)
   in let (members, st3) = parse-family-members st2 []
   in ParseTypeDefResult {
    maybe-type-def = Just (subj-deck-record (TypeDef {
     name = name-tok,
     type-params = tparams,
     body = UnitFamilyBody base-tok members,
     is-mutable = False,
     deriving = []
    })),
    state = st3
   }

  parse-family-members : ParseState, LinkedList UnitFamilyMember -> (List UnitFamilyMember, ParseState)
  parse-family-members (st) (acc) =
   if is-done st then (subj-deck-record (__linked-list-to-list acc), st)
   else if is-type-ident (current-kind st) then let mem-tok = current st
     in let st2 = advance st
     in if is-equals (current-kind st2) then let st3 = advance st2
       in if current-kind st3 == IntegerLiteral then let factor = lit-text-to-integer (token-text (current st3))
         in let member = subj-deck-record (UnitFamilyMember { member-name = mem-tok, factor = factor })
         in parse-family-members (skip-newlines (advance st3)) (__linked-list-push acc member)
       else (subj-deck-record (__linked-list-to-list acc), st)
     else (subj-deck-record (__linked-list-to-list acc), st)
   else (subj-deck-record (__linked-list-to-list acc), st)

  collect-type-params : ParseState, LinkedList Token -> List Token
  collect-type-params (st) (acc) =
   if is-paren-type-param st then collect-type-params (advance (advance (advance st))) (__linked-list-push acc (list-at (st.tokens) (st.pos + 1)))
   else if is-ident (current-kind st) then collect-type-params (advance st) (__linked-list-push acc (current st))
   else subj-deck-record (__linked-list-to-list acc)

  parse-type-def : ParseState -> ParseTypeDefResult
  parse-type-def (st) =
   if is-mutable-keyword (current-kind st) then let st0 = advance st
     in parse-type-def-inner True st0
   else parse-type-def-inner False st

  parse-type-def-inner : Boolean, ParseState -> ParseTypeDefResult
  parse-type-def-inner (is-mut) (st) =
   if is-type-ident (current-kind st) then let name-tok = current st
     in let st2 = advance st
     in let tparams = collect-type-params st2 []
     in let st3 = parse-type-params st2 []
     in if is-equals (current-kind st3) then let st4 = skip-newlines (advance st3)
     in if is-unit-keyword (current-kind st4) then let st-after-unit = advance st4
            in if is-ident (current-kind st-after-unit) & token-text (current st-after-unit) == "family" then parse-unit-family name-tok tparams (advance st-after-unit)
            else when parse-type st-after-unit
            is TypeOk (base-te) (st5) -> ParseTypeDefResult {
             maybe-type-def = Just (subj-deck-record (TypeDef {
              name = name-tok,
              type-params = tparams,
              body = UnitBody base-te,
              is-mutable = False,
              deriving = []
             })),
             state = st5
            }
            else if is-record-keyword (current-kind st4) then attach-deriving (parse-record-type name-tok tparams is-mut st4)
            else if is-pipe (current-kind st4) then attach-deriving (parse-variant-type name-tok tparams st4)
            else if is-type-ident (current-kind st4) & looks-like-variant st4 then attach-deriving (parse-variant-type name-tok tparams st4)
            else ParseTypeDefResult { maybe-type-def = None, state = st }
         else ParseTypeDefResult { maybe-type-def = None, state = st }
    else ParseTypeDefResult { maybe-type-def = None, state = st }

  is-deriving-kw : ParseState -> Boolean
  is-deriving-kw (st) =
   if is-ident (current-kind st) then token-text (current st) == "deriving"
   else False

  parse-deriving-names : ParseState, LinkedList Token -> (List Token, ParseState)
  parse-deriving-names (st) (acc) =
   if is-type-ident (current-kind st) then let acc2 = __linked-list-push acc (current st)
     in let st2 = advance st
     in if is-comma (current-kind st2) then parse-deriving-names (skip-newlines (advance st2)) acc2
        else (subj-deck-record (__linked-list-to-list acc2), st2)
   else (subj-deck-record (__linked-list-to-list acc), st)

  attach-deriving : ParseTypeDefResult -> ParseTypeDefResult
  attach-deriving (r) =
   when (r.maybe-type-def)
    is None -> r
    is Just (td) ->
     let st1 = skip-newlines (r.state)
     in if is-deriving-kw st1 then let (deriv-names, st-deriv) = parse-deriving-names (skip-newlines (advance st1)) []
          in ParseTypeDefResult { maybe-type-def = Just (subj-deck-record (__record-set td "deriving" deriv-names)), state = st-deriv }
        else r

  parse-record-type : Token, List Token, Boolean, ParseState -> ParseTypeDefResult
  parse-record-type (name-tok) (tparams) (is-mut) (st) =
   let st2 = advance st
   in let st3 = expect LeftBrace st2
   in let st4 = skip-newlines st3
   in parse-record-fields-loop name-tok tparams is-mut [] st4

  parse-record-fields-loop : Token, List Token, Boolean, LinkedList RecordFieldDef, ParseState -> ParseTypeDefResult
  parse-record-fields-loop (name-tok) (tparams) (is-mut) (acc) (st) =
   if is-right-brace (current-kind st) then ParseTypeDefResult {
    maybe-type-def = Just (subj-deck-record (TypeDef {
     name = name-tok,
     type-params = tparams,
     body = RecordBody (subj-deck-record (__linked-list-to-list acc)),
     is-mutable = is-mut,
     deriving = []
    })),
    state = advance st
   }
   else if is-field-name-token (current-kind st) then parse-one-record-field name-tok tparams is-mut acc st
   else ParseTypeDefResult {
    maybe-type-def = Just (subj-deck-record (TypeDef {
     name = name-tok,
     type-params = tparams,
     body = RecordBody (subj-deck-record (__linked-list-to-list acc)),
     is-mutable = is-mut,
     deriving = []
    })),
    state = st
   }

  parse-one-record-field : Token, List Token, Boolean, LinkedList RecordFieldDef, ParseState -> ParseTypeDefResult
  parse-one-record-field (name-tok) (tparams) (is-mut) (acc) (st) =
   let field-name = current st
   in let st2 = advance st
   in let st3 = expect Colon st2
   in let field-type-result = parse-type st3
   in unwrap-record-field-type name-tok tparams is-mut acc field-name field-type-result

  unwrap-record-field-type : Token, List Token, Boolean, LinkedList RecordFieldDef, Token, ParseTypeResult -> ParseTypeDefResult
  unwrap-record-field-type (name-tok) (tparams) (is-mut) (acc) (field-name) (r) =
   when r
    is TypeOk (ft) (st) ->
     let field = subj-deck-record (RecordFieldDef {
      name = field-name,
      type-expr = ft
     })
     in let st2 = skip-newlines st
     in if is-comma (current-kind st2) then parse-record-fields-loop name-tok tparams is-mut (__linked-list-push acc field) (skip-newlines (advance st2))
         else parse-record-fields-loop name-tok tparams is-mut (__linked-list-push acc field) st2

  looks-like-variant : ParseState -> Boolean
  looks-like-variant (st) =
   looks-like-variant-scan (st.tokens) (st.pos + 1) (list-length (st.tokens))

  looks-like-variant-scan : List Token, Integer, Integer -> Boolean
  looks-like-variant-scan (tokens) (i) (len) =
   if i >= len then False
   else let k = (list-at tokens i).kind
   in if is-pipe k then True
      else when k
      is Newline | EndOfFile -> False
      is otherwise -> looks-like-variant-scan tokens (i + 1) len

  parse-variant-type : Token, List Token, ParseState -> ParseTypeDefResult
  parse-variant-type (name-tok) (tparams) (st) =
   if is-type-ident (current-kind st) then let ctor-name = current st
     in let st2 = advance st
     in parse-ctor-fields ctor-name [] st2 name-tok tparams []
    else parse-variant-ctors name-tok tparams [] st

  parse-variant-ctors : Token, List Token, LinkedList VariantCtorDef, ParseState -> ParseTypeDefResult
  parse-variant-ctors (name-tok) (tparams) (acc) (st) =
   if is-pipe (current-kind st) then let st2 = skip-newlines (advance st)
     in let ctor-name = current st2
     in let st3 = advance st2
     in parse-ctor-fields ctor-name [] st3 name-tok tparams acc
    else ParseTypeDefResult {
     maybe-type-def = Just (subj-deck-record (TypeDef {
      name = name-tok,
      type-params = tparams,
      body = VariantBody (subj-deck-record (__linked-list-to-list acc)),
      is-mutable = False,
      deriving = []
     })),
     state = st
    }

  parse-ctor-fields : Token, LinkedList TypeExpr, ParseState, Token, List Token, LinkedList VariantCtorDef -> ParseTypeDefResult
  parse-ctor-fields (ctor-name) (fields) (st) (name-tok) (tparams) (acc) =
   if is-left-paren (current-kind st) then let field-result = parse-type (advance st)
     in unwrap-ctor-field field-result ctor-name fields name-tok tparams acc
    else let st2 = skip-newlines st
    in if is-colon (current-kind st2) then let ret-result = parse-type (advance st2) in unwrap-ctor-return ret-result ctor-name fields name-tok tparams acc else let ctor = subj-deck-record (VariantCtorDef { name = ctor-name, fields = subj-deck-record (__linked-list-to-list fields), return-type = [] }) in parse-variant-ctors name-tok tparams (__linked-list-push acc ctor) st2

  unwrap-ctor-field : ParseTypeResult, Token, LinkedList TypeExpr, Token, List Token, LinkedList VariantCtorDef -> ParseTypeDefResult
  unwrap-ctor-field (r) (ctor-name) (fields) (name-tok) (tparams) (acc) =
   when r
    is TypeOk (ty) (st) ->
     let st2 = expect RightParen st
      in parse-ctor-fields ctor-name (__linked-list-push fields ty) st2 name-tok tparams acc

  unwrap-ctor-return : ParseTypeResult, Token, LinkedList TypeExpr, Token, List Token, LinkedList VariantCtorDef -> ParseTypeDefResult
  unwrap-ctor-return (r) (ctor-name) (fields) (name-tok) (tparams) (acc) =
   when r
    is TypeOk (ty) (st) -> let ctor = subj-deck-record (VariantCtorDef { name = ctor-name, fields = subj-deck-record (__linked-list-to-list fields), return-type = [ty] }) in parse-variant-ctors name-tok tparams (__linked-list-push acc ctor) (skip-newlines st)

Section: Document Parsing

 The ceiling is the PARSE scratch reservation's top. THREE walks write
 that deck here and all three are bounded, because guarding only the
 middle one does not keep the deck inside its floor -- measured
 2026-07-21 by keying the phase's report on the post-hoc parse-ov flag
 alone, where a compile with parse-top-level guarded still raised
 CDX9002 at a 2.5 MB floor. scan-class-instance-defs and check-pagination
 each walk the whole token list again, after parse-top-level has stopped,
 and between them they carried the deck past the ceiling on their own.

  parse-document : ParseState, Integer -> Document
  parse-document (st) (ceiling) =
   let st0 = __record-set st "deck-ceiling" ceiling
   in let st2 = skip-newlines st0
   in let (imp-list, imp-st) = parse-citations st2 "" []
   in let doc = parse-top-level [] [] [] imp-list "" [] [] [] [] imp-st
   in let short = deck-short-of ceiling demand-parse-scratch-guard-band
   in let ci = if short then empty-class-instance-scan else scan-class-instance-defs (make-parse-state (st.tokens) "") [] []
   in let pag-errs = if short then [] else check-pagination (scan-chapter-pages (make-parse-state (st.tokens) "") [])
   in let doc2 = __record-set (__record-set doc "class-defs" (ci.class-defs)) "instance-defs" (ci.instance-defs)
   in __record-set doc2 "parse-bag" (add-bag-diags (doc2.parse-bag) pag-errs 0 (list-length pag-errs))

  deck-copy-text : Text -> Text
  deck-copy-text (t) =
   if text-length t == 0 then "" else subj-deck-record (substring t 0 (text-length t))

  collect-cite-title : ParseState, Text -> (Text, ParseState)
  collect-cite-title (st) (acc) =
   if is-done st then (deck-copy-text acc, st)
    else when current-kind st
     is Newline | LeftParen -> (deck-copy-text acc, st)
     is otherwise -> let tok = current st
      in collect-cite-title (advance st) (join-title-parts acc (token-text tok))

  parse-citations : ParseState, Text, LinkedList CitesDecl -> (List CitesDecl, ParseState)
  parse-citations (st) (citing) (acc) =
   if is-cites-keyword (current-kind st) then let st2 = advance st
     in let quire-tok = current st2
     in let st3 = advance st2
     in let st4 = advance st3
     in let (cite-title, st5) = collect-cite-title st4 ""
     in if is-left-paren (current-kind st5) then let (sel-names, st-sel) = parse-selected-names (advance st5) []
     in let st6 = skip-newlines st-sel
     in parse-citations st6 citing (__linked-list-push acc (subj-deck-record (CitesDecl {
           quire = quire-tok,
           chapter-name = cite-title,
           selected-names = sel-names,
           citing-chapter = citing,
           decl-kind = decl-cite,
           content-hash = "",
           trust-floor = 0
          })))
     else let st6 = skip-newlines st5
     in parse-citations st6 citing (__linked-list-push acc (subj-deck-record (CitesDecl {
          quire = quire-tok,
          chapter-name = cite-title,
          selected-names = [],
          citing-chapter = citing,
          decl-kind = decl-cite,
          content-hash = "",
          trust-floor = 0
         })))
    else (subj-deck-record (__linked-list-to-list acc), st)

Section: Quotations

  quote-body-text : Token -> Text
  quote-body-text (tok) =
   let n = tok.length
   in if n < 2 then ""
      else subj-deck-record (substring (tok.source) (tok.offset + 1) (n - 2))

  parse-quotation : ParseState, Text -> (CitesDecl, ParseState)
  parse-quotation (st) (citing) =
   let qtok = current st
   in let st1 = advance st
   in let hash-tok = current st1
   in let st2 = advance st1
   in let st3 = if is-ident (current-kind st2) then advance st2 else st2
   in let name-tok = current st3
   in let st4 = skip-newlines (advance st3)
   in (subj-deck-record (CitesDecl {
        quire = qtok,
        chapter-name = deck-copy-text (token-text name-tok),
        selected-names = [],
        citing-chapter = citing,
        decl-kind = decl-quote,
        content-hash = quote-body-text hash-tok,
        trust-floor = 0
       }), st4)

  parse-trusting : ParseState, Text -> (CitesDecl, ParseState)
  parse-trusting (st) (citing) =
   let ttok = current st
   in let st1 = advance st
   in if is-text-lit (current-kind st1)
      then parse-trusting-key ttok st1 citing
      else parse-trusting-floor ttok st1 citing

 A trust FLOOR: trusting above N. The floor is the threshold every quoted
 work's signer must clear. The above word is optional.

  parse-trusting-floor : Token, ParseState, Text -> (CitesDecl, ParseState)
  parse-trusting-floor (ttok) (st1) (citing) =
   let st2 = if is-above-keyword (current-kind st1) then advance st1 else st1
   in let n-tok = current st2
   in let st3 = skip-newlines (advance st2)
   in (subj-deck-record (CitesDecl {
        quire = ttok,
        chapter-name = "",
        selected-names = [],
        citing-chapter = citing,
        decl-kind = decl-trust,
        content-hash = "",
        trust-floor = text-to-integer (token-text n-tok)
       }), st3)

 A trusted KEY: trusting "<fingerprint>" "<public-key-hex>" <score>. The
 fingerprint is the lookup name a signed work will claim; the public key is
 the bytes its signature is verified against; the score is how far this
 source trusts that key. Because the key is named here in the source rather
 than in the offered works, a forged work signed by any other key is
 verified against the wrong bytes and refused -- the messenger cannot
 vouch for its own message. The two texts still carry their quotation
 marks in the token, so the body is what quote-body-text lifts out.

  parse-trusting-key : Token, ParseState, Text -> (CitesDecl, ParseState)
  parse-trusting-key (ttok) (st1) (citing) =
   let fp-tok = current st1
   in let st2 = advance st1
   in let pub-tok = current st2
   in let st3 = advance st2
   in let score-tok = current st3
   in let st4 = skip-newlines (advance st3)
   in (subj-deck-record (CitesDecl {
        quire = ttok,
        chapter-name = quote-body-text fp-tok,
        selected-names = [],
        citing-chapter = citing,
        decl-kind = decl-trust-key,
        content-hash = quote-body-text pub-tok,
        trust-floor = text-to-integer (token-text score-tok)
       }), st4)

Section: Grounds

 A grounds declaration names the hardware effects a chapter is the
 SOURCE of -- the layer where the abstraction meets the metal. Its
 functions may perform those effects without declaring them (the
 internal exemption, no bookkeeping); a function that DECLARES the
 effect in its signature publishes it to out-of-kernel callers (a root).
 The exemption is scoped to the named effects, so a chapter grounding
 Device.Port that performs Device.Mmio is still rejected. Each named
 effect rides the header as a decl-grounds CitesDecl carrying the effect
 name (chapter-name) and the chapter that grounds it (citing-chapter);
 grounds-strings collects them into the Document as "slug\neffect"
 entries the type checker reads. A dotted effect
 (Device.Mmio) is read base-dot-member, the same shape parse-effect-names
 reads inside a row.

  parse-grounds : Token, ParseState, Text, LinkedList CitesDecl -> (List CitesDecl, ParseState)
  parse-grounds (gtok) (st) (citing) (acc) =
   if is-type-ident (current-kind st) | is-ident (current-kind st) then
    let tok = current st
    in let st2 = advance st
    in if is-dot (current-kind st2) then
        let st3 = advance st2
        in let sub = current st3
        in parse-grounds gtok (advance st3) citing (__linked-list-push acc (subj-deck-record (CitesDecl {
             quire = gtok,
             chapter-name = deck-copy-text (token-text tok & "." & token-text sub),
             selected-names = [],
             citing-chapter = citing,
             decl-kind = decl-grounds,
             content-hash = "",
             trust-floor = 0
            })))
       else parse-grounds gtok st2 citing (__linked-list-push acc (subj-deck-record (CitesDecl {
             quire = gtok,
             chapter-name = deck-copy-text (token-text tok),
             selected-names = [],
             citing-chapter = citing,
             decl-kind = decl-grounds,
             content-hash = "",
             trust-floor = 0
            })))
   else if is-comma (current-kind st) then parse-grounds gtok (advance st) citing acc
   else (subj-deck-record (__linked-list-to-list acc), skip-newlines st)

  grounds-strings : List CitesDecl, Integer, Integer, List Text -> List Text
  grounds-strings (ds) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at ds i
   in if d.decl-kind == decl-grounds
      then grounds-strings ds (i + 1) len (list-push acc (subj-deck-record ((d.citing-chapter) & "\n" & (d.chapter-name))))
      else grounds-strings ds (i + 1) len acc

Section: Sorting Out The Header

  filter-decl-kind : List CitesDecl, Integer, Integer, Integer, List CitesDecl -> List CitesDecl
  filter-decl-kind (ds) (want) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at ds i
   in if d.decl-kind == want
      then filter-decl-kind ds want (i + 1) len (list-push acc d)
      else filter-decl-kind ds want (i + 1) len acc

  header-trust-floor : List CitesDecl, Integer, Integer, Integer -> Integer
  header-trust-floor (ds) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at ds i
   in if d.decl-kind == decl-trust
      then header-trust-floor ds (i + 1) len (d.trust-floor)
      else header-trust-floor ds (i + 1) len acc

  stamp-trust-floor : List CitesDecl, Integer, Integer, Integer, List CitesDecl -> List CitesDecl
  stamp-trust-floor (qs) (floor) (i) (len) (acc) =
   if i >= len then acc
   else let q = list-at qs i
   in let stamped = subj-deck-record (__record-set q "trust-floor" floor)
   in stamp-trust-floor qs floor (i + 1) len (list-push acc stamped)

  parse-selected-names : ParseState, LinkedList Token -> (List Token, ParseState)
  parse-selected-names (st) (acc) =
   if is-ident (current-kind st) | is-type-ident (current-kind st) then let tok = current st
     in let st2 = advance st
     in let acc2 = __linked-list-push acc tok
     in if is-comma (current-kind st2) then parse-selected-names (skip-newlines (advance st2)) acc2
        else if is-right-paren (current-kind st2) then (subj-deck-record (__linked-list-to-list acc2), advance st2)
        else (subj-deck-record (__linked-list-to-list acc2), st2)
    else if is-right-paren (current-kind st) then (subj-deck-record (__linked-list-to-list acc), advance st)
    else (subj-deck-record (__linked-list-to-list acc), st)

  is-chapter-header : ParseState -> Boolean
  is-chapter-header (st) =
   if is-type-ident (current-kind st) then let tok = current st
      in if tok.length == 7 then if (token-text tok) == "Chapter" then is-colon (peek-kind st 1)
            else False
         else False
    else False

  is-section-header : ParseState -> Boolean
  is-section-header (st) =
   if is-type-ident (current-kind st) then let tok = current st
      in if tok.length == 7 then if (token-text tok) == "Section" then is-colon (peek-kind st 1)
            else False
         else False
    else False

Section: Chapter Pagination

 A chapter may span several files. Each file is a PAGE, and says so:
 `Page 3 of 13`. That is why a repeated `Chapter:` name is not an error
 -- the X86-64 code generator is one chapter across thirteen files, and
 the parser is right to merge them.

 So: a chapter that appears once needs nothing. A chapter that appears
 k > 1 times must have, on every page, `Page N of M` with M == k and
 the N distinct. Anything else is CDX3004.

  PageOcc = record {
   po-chapter : Text,
   po-n : Integer,
   po-m : Integer,
   po-span : SourceSpan
  }

  page-marker-n : ParseState -> Integer
  page-marker-n (st) = text-to-integer (token-text (current (advance st)))

  page-marker-m : ParseState -> Integer
  page-marker-m (st) =
   let st2 = advance (advance st)
   in if is-ident (current-kind st2) then
       if (token-text (current st2)) == "of" then text-to-integer (token-text (current (advance st2)))
       else 0
      else 0

  set-last-page : List PageOcc, Integer, Integer -> List PageOcc
  set-last-page (occs) (n) (m) =
   let len = list-length occs
   in if len == 0 then occs
   else let last = list-at occs (len - 1)
   in list-set-at occs (len - 1) (subj-deck-record (PageOcc {
    po-chapter = last.po-chapter,
    po-n = n,
    po-m = m,
    po-span = last.po-span
   }))

  scan-chapter-pages : ParseState, List PageOcc -> List PageOcc
  scan-chapter-pages (st) (acc) =
   if is-done st then acc
   else if is-chapter-header st then
    let tok = current st
    in let title = extract-header-title st
    in scan-chapter-pages (skip-to-next-line st) (list-push acc (subj-deck-record (PageOcc {
     po-chapter = title,
     po-n = 0,
     po-m = 0,
     po-span = token-to-span tok
    })))
   else if is-page-marker st then
    let n = page-marker-n st
    in let m = page-marker-m st
    in scan-chapter-pages (skip-to-next-line st) (set-last-page acc n m)
   else scan-chapter-pages (advance st) acc

  count-chapter-occs : List PageOcc, Text, Integer, Integer, Integer -> Integer
  count-chapter-occs (occs) (name) (i) (len) (acc) =
   if i == len then acc
   else if (list-at occs i).po-chapter == name then count-chapter-occs occs name (i + 1) len (acc + 1)
   else count-chapter-occs occs name (i + 1) len acc

  count-chapter-page-n : List PageOcc, Text, Integer, Integer, Integer, Integer -> Integer
  count-chapter-page-n (occs) (name) (n) (i) (len) (acc) =
   if i == len then acc
   else let o = list-at occs i
   in if o.po-chapter == name then
       if o.po-n == n then count-chapter-page-n occs name n (i + 1) len (acc + 1)
       else count-chapter-page-n occs name n (i + 1) len acc
      else count-chapter-page-n occs name n (i + 1) len acc

  check-pagination : List PageOcc -> List Diagnostic
  check-pagination (occs) = check-pagination-loop occs 0 (list-length occs) []

  check-pagination-loop : List PageOcc, Integer, Integer, List Diagnostic -> List Diagnostic
  check-pagination-loop (occs) (i) (len) (errs) =
   if i == len then errs
   else let o = list-at occs i
   in let k = count-chapter-occs occs (o.po-chapter) 0 len 0
   in if k <= 1 then check-pagination-loop occs (i + 1) len errs
      else if o.po-m == 0
       then check-pagination-loop occs (i + 1) len (errs & [make-error cdx-chapter-pagination ("Chapter '" & (o.po-chapter) & "' spans " & show k & " files, but this page carries no 'Page N of M' marker. Number the pages, or an accidental duplicate chapter name is indistinguishable from a deliberate page and the two merge silently.") (o.po-span)])
      else if o.po-m /= k
       then check-pagination-loop occs (i + 1) len (errs & [make-error cdx-chapter-pagination ("Chapter '" & (o.po-chapter) & "' spans " & show k & " files but this page declares 'of " & show (o.po-m) & "'. The declared page count must equal the number of files the chapter spans.") (o.po-span)])
      else if count-chapter-page-n occs (o.po-chapter) (o.po-n) 0 len 0 > 1
       then check-pagination-loop occs (i + 1) len (errs & [make-error cdx-chapter-pagination ("Chapter '" & (o.po-chapter) & "' has two pages numbered " & show (o.po-n) & ". Each page of a chapter needs a distinct number.") (o.po-span)])
      else check-pagination-loop occs (i + 1) len errs

  add-bag-diags : DiagnosticBag, List Diagnostic, Integer, Integer -> DiagnosticBag
  add-bag-diags (bag) (ds) (i) (len) =
   if i == len then bag
   else add-bag-diags (bag-add bag (list-at ds i)) ds (i + 1) len

  is-page-number : TokenKind -> Boolean
  is-page-number (k) =
   when k
    is IntegerLiteral -> True
    is otherwise -> False

  is-page-marker : ParseState -> Boolean
  is-page-marker (st) =
   if is-type-ident (current-kind st) then let tok = current st
      in if tok.length == 4 then if (token-text tok) == "Page" then is-page-number (peek-kind st 1)
         else False
      else False
    else False

  extract-header-title : ParseState -> Text
  extract-header-title (st) =
   let st2 = advance (advance st)
   in deck-copy-text (collect-title-tokens st2 "")

  join-title-parts : Text, Text -> Text
  join-title-parts (acc) (next) =
   if text-length acc == 0 then next
    else if text-length next == 0 then acc
    else let prev-last = char-code-at acc (text-length acc - 1)
     in let next-first = char-code-at next 0
     in if (is-letter-code prev-last | is-digit-code prev-last) & (is-letter-code next-first | is-digit-code next-first)
        then subj-deck-record (acc & " " & next)
        else subj-deck-record (acc & next)

  collect-title-tokens : ParseState, Text -> Text
  collect-title-tokens (st) (acc) =
   if is-done st then acc
   else when current-kind st
    is Newline -> acc
    is otherwise -> let tok = current st
     in collect-title-tokens (advance st) (join-title-parts acc (token-text tok))

  is-prose-line : ParseState -> Boolean
  is-prose-line (st) = (current st).column == 2

  skip-body-lines : ParseState -> ParseState
  skip-body-lines (st) =
   let st2 = skip-newlines st
   in if is-done st2 then st2
   else if (current st2).column >= 3 then skip-body-lines (skip-to-next-line st2)
   else st2

  skip-prose-lines : ParseState -> ParseState
  skip-prose-lines (st) =
   let st2 = skip-newlines st
   in if is-done st2 then st2
      else if is-prose-line st2 then skip-prose-lines (skip-to-next-line st2)
      else if (current st2).column > 3 then skip-prose-lines (skip-to-next-line st2)
      else st2

  is-prose-token : ParseState -> Boolean
  is-prose-token (st) = current-kind st == ProseText

  classify-transition : Text -> ProseTransition
  classify-transition (line) =
   if text-contains line "We say:" then PtWeSay
   else if text-contains line "This is written:" then PtThisIsWritten
   else PtNone

  extract-template-name : Text, Text -> Text
  extract-template-name (line) (marker) =
   let parts = text-split line marker
   in if list-length parts < 1 then ""
      else let prefix = list-at parts 0
   in let words = text-split prefix " "
   in extract-last-word words (list-length words)

  extract-last-word : List Text, Integer -> Text
  extract-last-word (words) (len) =
   if len == 0 then ""
   else let w = list-at words (len - 1)
   in if text-length w == 0 then extract-last-word words (len - 1)
      else w

  extract-function-name : Text -> Text
  extract-function-name (line) =
   let parts = text-split line " "
   in if list-length parts < 2 then ""
      else let second = list-at parts 1
   in if text-length second == 0 then "" else second

  classify-template : Text -> ProseTemplate
  classify-template (line) =
   if text-contains line "is a record containing:" then
    PtRecordTemplate (extract-template-name line "is a record containing:")
   else if text-contains line "is one of:" then
    PtVariantTemplate (extract-template-name line "is one of:")
   else if text-contains line "is either:" then
    PtVariantTemplate (extract-template-name line "is either:")
   else if text-starts-with line "To " then
    PtFunctionTemplate (extract-function-name line)
   else if text-starts-with line "such that " then PtConstraintTemplate
   else if text-starts-with line "where " then PtConstraintTemplate
   else if text-starts-with line "provided that " then PtConstraintTemplate
   else if text-starts-with line "claim:" then PtProofTemplate
   else if text-starts-with line "Claim:" then PtProofTemplate
   else if text-starts-with line "therefore," then PtProofTemplate
   else if text-starts-with line "it follows that " then PtProofTemplate
   else if text-starts-with line "first," then PtProcedureTemplate
   else if text-starts-with line "First," then PtProcedureTemplate
   else if text-starts-with line "then," then PtProcedureTemplate
   else if text-starts-with line "Then," then PtProcedureTemplate
   else if text-starts-with line "finally," then PtProcedureTemplate
   else if text-starts-with line "Finally," then PtProcedureTemplate
   else if text-starts-with line "for every " then PtQuantifiedTemplate
   else if text-starts-with line "For every " then PtQuantifiedTemplate
   else if text-starts-with line "there exists " then PtQuantifiedTemplate
   else if text-starts-with line "There exists " then PtQuantifiedTemplate
   else if text-starts-with line "no " then PtQuantifiedTemplate
   else PtNoTemplate

  classify-prose-line : Text, Integer -> ProseBlock
  classify-prose-line (line) (off) =
   subj-deck-record (ProseBlock {
    text = line,
    transition = classify-transition line,
    template = classify-template line,
    anchor = "",
    offset = off
   })

  CollectProseResult = record { state : ParseState, lines : LinkedList Text, blocks : LinkedList ProseBlock }

  collect-prose-with-text : ParseState, LinkedList Text, LinkedList ProseBlock -> CollectProseResult
  collect-prose-with-text (st) (acc) (blk-acc) =
   let st2 = skip-newlines st
   in if is-done st2 then CollectProseResult { state = st2, lines = acc, blocks = blk-acc }
      else if is-prose-token st2 then let txt = token-text (current st2)
        in let block = classify-prose-line txt ((current st2).offset)
        in collect-prose-with-text (skip-to-next-line (advance st2)) (__linked-list-push acc (txt & "\n")) (__linked-list-push blk-acc block)
      else if is-prose-line st2 then collect-prose-with-text (skip-to-next-line st2) acc blk-acc
      else if (current st2).column > 3 then collect-prose-with-text (skip-to-next-line st2) acc blk-acc
      else CollectProseResult { state = st2, lines = acc, blocks = blk-acc }

  skip-to-next-line : ParseState -> ParseState
  skip-to-next-line (st) =
   if is-done st then st
   else when current-kind st
    is Newline -> advance st
    is otherwise -> skip-to-next-line (advance st)

  is-conversion-decl : ParseState -> Boolean
  is-conversion-decl (st) =
   if current-kind st == IntegerLiteral then let st1 = advance st
   in if is-done st1 then False
   else if is-type-ident (current-kind st1) then let st2 = advance st1
     in if is-done st2 then False
     else is-equals (current-kind st2)
   else False
   else False

  parse-conversion-decl : ParseState -> AnnotationNode
  parse-conversion-decl (st) =
   let from-val = token-text (current st)
   in let st1 = advance st
   in let from-unit = token-text (current st1)
   in let st2 = advance (advance st1)
   in let to-val = if is-done st2 then "1" else token-text (current st2)
   in let st3 = if is-done st2 then st2 else advance st2
   in let to-unit = if is-done st3 then from-unit else token-text (current st3)
   in let factor = text-to-integer to-val / text-to-integer from-val
   in subj-deck-record (AnnotationNode { kind = "conversion", target = from-unit, body = integer-to-text factor & " " & to-unit })

  empty-parse-document : DiagnosticBag -> Document
  empty-parse-document (bag) =
   subj-deck-record (Document {
    defs = [],
    type-defs = [],
    effect-defs = [],
    class-defs = [],
    instance-defs = [],
    citations = [],
    quotations = [],
    trust-keys = [],
    ground-effects = [],
    chapter-title = "",
    section-titles = [],
    prose = "",
    prose-blocks = [],
    annotations = [],
    parse-bag = bag
   })

  parse-top-level : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document
  parse-top-level (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =
   if deck-short-of (st.deck-ceiling) demand-parse-scratch-guard-band then empty-parse-document (st.bag)
   else if is-done st then let prose-text = subj-deck-record (text-concat-list (subj-deck-record (__linked-list-to-list prose)))
    in let hdr-len = list-length imports
    in let floor = header-trust-floor imports 0 hdr-len (-1)
    in let raw-quotes = filter-decl-kind imports decl-quote 0 hdr-len []
    in let defs-list = subj-deck-record (__linked-list-to-list defs)
    in let type-defs-list = subj-deck-record (__linked-list-to-list type-defs)
    in let raw-blocks = subj-deck-record (__linked-list-to-list blocks)
    in subj-deck-record (Document {
    defs = defs-list,
    type-defs = type-defs-list,
    effect-defs = subj-deck-record (__linked-list-to-list effect-defs),
    class-defs = [],
    instance-defs = [],
    citations = subj-deck-record (filter-decl-kind imports decl-cite 0 hdr-len []),
    quotations = subj-deck-record (stamp-trust-floor raw-quotes floor 0 (list-length raw-quotes) []),
    trust-keys = subj-deck-record (filter-decl-kind imports decl-trust-key 0 hdr-len []),
    ground-effects = subj-deck-record (grounds-strings imports 0 hdr-len []),
    chapter-title = ch-title,
    section-titles = subj-deck-record (__linked-list-to-list sec-titles),
    prose = prose-text,
    prose-blocks = subj-deck-record (anchor-prose-blocks raw-blocks defs-list type-defs-list),
    annotations = subj-deck-record (__linked-list-to-list anns),
    parse-bag = st.bag
   })
   else if is-chapter-header st then let title = extract-header-title st
     in let pr = collect-prose-with-text (skip-to-next-line st) prose blocks
     in parse-top-level defs type-defs effect-defs imports title sec-titles (pr.lines) (pr.blocks) anns (pr.state)
   else if is-section-header st then let title = extract-header-title st
     in let pr = collect-prose-with-text (skip-to-next-line st) prose blocks
     in parse-top-level defs type-defs effect-defs imports ch-title (__linked-list-push sec-titles title) (pr.lines) (pr.blocks) anns (pr.state)
   else if is-page-marker st then parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-to-next-line st)
   else if is-cites-keyword (current-kind st) then let (cite-imports, cite-st) = parse-citations st ch-title []
     in parse-top-level defs type-defs effect-defs (subj-deck-record (imports & cite-imports)) ch-title sec-titles prose blocks anns cite-st
   else if is-quotes-keyword (current-kind st) then let (q, q-st) = parse-quotation st ch-title
     in parse-top-level defs type-defs effect-defs (subj-deck-record (imports & [q])) ch-title sec-titles prose blocks anns q-st
   else if is-trusting-keyword (current-kind st) then let (t, t-st) = parse-trusting st ch-title
     in parse-top-level defs type-defs effect-defs (subj-deck-record (imports & [t])) ch-title sec-titles prose blocks anns t-st
   else if is-grounds-keyword (current-kind st) then let (g, g-st) = parse-grounds (current st) (advance st) ch-title []
     in parse-top-level defs type-defs effect-defs (subj-deck-record (imports & g)) ch-title sec-titles prose blocks anns g-st
   else if is-effect-keyword (current-kind st) then parse-top-level-effect defs type-defs effect-defs imports ch-title sec-titles prose blocks anns st
   else if is-class-keyword (current-kind st) then let st-c1 = advance st
    in let st-c2 = advance st-c1
    in let st-c2b = if is-ident (current-kind st-c2) & is-fat-arrow (peek-kind st-c2 1)
      then advance (advance (advance st-c2))
      else st-c2
    in let st-c3 = if is-where-keyword (current-kind st-c2b) then skip-newlines (advance st-c2b) else st-c2b
    in let (_, ops-st) = parse-effect-ops st-c3 []
    in parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines ops-st)
   else if is-instance-keyword (current-kind st) then let st-i1 = advance st
    in let st-i2 = advance st-i1
    in let st-i3 = advance st-i2
    in let st-i4 = if is-where-keyword (current-kind st-i3) then skip-newlines (advance st-i3) else st-i3
    in parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-body-lines st-i4)
   else if is-claim-keyword (current-kind st) then parse-claim-arm defs type-defs effect-defs imports ch-title sec-titles prose blocks anns st
   else if is-proof-keyword (current-kind st) then try-top-level-def defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (advance st)
   else if is-punctual-keyword (current-kind st) then let pst = advance st
     in if is-done pst then parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns pst
     else if current-kind pst == IntegerLiteral then let budget-text = token-text (current pst)
       in let pst2 = advance pst
       in let pname = if is-done pst2 then "" else token-text (current pst2)
       in let pann = subj-deck-record (AnnotationNode { kind = "hard-realtime", target = pname, body = budget-text })
       in try-top-level-def defs type-defs effect-defs imports ch-title sec-titles prose blocks (__linked-list-push anns pann) pst2
     else let pname = token-text (current pst)
     in let pann = subj-deck-record (AnnotationNode { kind = "hard-realtime", target = pname, body = "" })
     in try-top-level-def defs type-defs effect-defs imports ch-title sec-titles prose blocks (__linked-list-push anns pann) pst
   else if is-conversion-decl st then let conv-ann = parse-conversion-decl st
     in parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks (__linked-list-push anns conv-ann) (skip-to-next-line st)
   else if is-prose-line st then let pr = collect-prose-with-text st prose blocks
     in parse-top-level defs type-defs effect-defs imports ch-title sec-titles (pr.lines) (pr.blocks) anns (pr.state)
   else if (current st).column > 3 then parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-to-next-line st)
   else try-top-level-type-def defs type-defs effect-defs imports ch-title sec-titles prose blocks anns st

  parse-top-level-effect : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document
  parse-top-level-effect (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =
   let st1 = advance st
   in let name-tok = current st1
   in let st2 = advance st1
   in let st3 = if is-where-keyword (current-kind st2) then skip-newlines (advance st2) else st2
   in let (ops-list, ops-st) = parse-effect-ops st3 []
   in let ed = subj-deck-record (EffectDef {
        name = name-tok,
        ops = ops-list
       })
   in parse-top-level defs type-defs (__linked-list-push effect-defs ed) imports ch-title sec-titles prose blocks anns (skip-newlines ops-st)

  parse-effect-ops : ParseState, LinkedList EffectOpDef -> (List EffectOpDef, ParseState)
  parse-effect-ops (st) (acc) =
   if is-ident (current-kind st) then if is-colon (peek-kind st 1) then let op-tok = current st
      in let st2 = advance (advance st)
      in let type-result = parse-type st2
      in when type-result
         is TypeOk (ty) (st3) ->
          let op = subj-deck-record (EffectOpDef {
           name = op-tok,
           type-expr = ty
          })
      in parse-effect-ops (skip-newlines st3) (__linked-list-push acc op)
     else (subj-deck-record (__linked-list-to-list acc), st)
    else (subj-deck-record (__linked-list-to-list acc), st)

  ClassDefsResult = record { class-defs : List ClassDef, instance-defs : List InstanceDef }

  empty-class-instance-scan : ClassDefsResult
  empty-class-instance-scan = ClassDefsResult { class-defs = [], instance-defs = [] }

  scan-class-instance-defs : ParseState, LinkedList ClassDef, LinkedList InstanceDef -> ClassDefsResult
  scan-class-instance-defs (st) (cacc) (iacc) =
   if is-done st then ClassDefsResult {
    class-defs = subj-deck-record (__linked-list-to-list cacc),
    instance-defs = subj-deck-record (__linked-list-to-list iacc)
   }
   else if is-class-keyword (current-kind st) & (is-ident (peek-kind st 1) | is-type-ident (peek-kind st 1)) then let st1 = advance st
    in let name-tok = current st1
    in let st2 = advance st1
    in if is-ident (current-kind st2) & is-fat-arrow (peek-kind st2 1) then
      let super-name = token-text name-tok
      in let st3 = advance (advance st2)
      in let real-name = current st3
      in let st4 = advance st3
      in let st5 = if is-where-keyword (current-kind st4) then skip-newlines (advance st4) else st4
      in let (ops-list, ops-st) = parse-effect-ops st5 []
      in let cd = subj-deck-record (ClassDef { name = real-name, methods = ops-list, superclass = super-name })
      in scan-class-instance-defs (skip-newlines ops-st) (__linked-list-push cacc cd) iacc
    else let st3 = if is-where-keyword (current-kind st2) then skip-newlines (advance st2) else st2
    in let (ops-list, ops-st) = parse-effect-ops st3 []
    in let cd = subj-deck-record (ClassDef { name = name-tok, methods = ops-list, superclass = "" })
    in scan-class-instance-defs (skip-newlines ops-st) (__linked-list-push cacc cd) iacc
   else if is-instance-keyword (current-kind st) & is-type-ident (peek-kind st 1) then let st1 = advance st
    in let class-tok = current st1
    in let st2 = advance st1
    in let (it-head, it-st) = parse-instance-type-head st2
    in let st4 = if is-where-keyword (current-kind it-st) then skip-newlines (advance it-st) else it-st
    in let (method-defs, methods-st) = parse-instance-methods st4 []
    in let id = subj-deck-record (InstanceDef { class-name = class-tok, type-name = it-head, methods = method-defs })
    in scan-class-instance-defs (skip-newlines methods-st) cacc (__linked-list-push iacc id)
   else scan-class-instance-defs (advance st) cacc iacc

  parse-instance-type-head : ParseState -> (Token, ParseState)
  parse-instance-type-head (st) =
   if is-left-paren (current-kind st)
    then let st1 = advance st
     in (current st1, skip-to-close-paren (advance st1) 1)
   else (current st, advance st)

  skip-to-close-paren : ParseState, Integer -> ParseState
  skip-to-close-paren (st) (depth) =
   if depth <= 0 then st
   else when (current-kind st)
    is EndOfFile -> st
    is otherwise ->
     if is-left-paren (current-kind st) then skip-to-close-paren (advance st) (depth + 1)
     else if is-right-paren (current-kind st) then skip-to-close-paren (advance st) (depth - 1)
     else skip-to-close-paren (advance st) depth

  finish-instance-methods : LinkedList InstanceMethodDef, ParseState -> (List InstanceMethodDef, ParseState)
  finish-instance-methods (acc) (st) =
   (subj-deck-record (__linked-list-to-list acc), st)

  parse-instance-methods : ParseState, LinkedList InstanceMethodDef -> (List InstanceMethodDef, ParseState)
  parse-instance-methods (st) (acc) =
   if is-ident (current-kind st) then let name-tok = current st
    in let st2 = advance st
    in let (inst-params, params-st) = parse-instance-params st2 []
    in if is-equals (current-kind params-st)
     then let st3 = skip-newlines (advance params-st)
      in let expr-result = parse-expr st3
      in when expr-result
       is ExprOk (body) (st4) ->
        let md = subj-deck-record (InstanceMethodDef { name = name-tok, params = inst-params, body = body })
        in parse-instance-methods (skip-newlines st4) (__linked-list-push acc md)
     else finish-instance-methods acc st
   else finish-instance-methods acc st

  parse-instance-params : ParseState, LinkedList Token -> (List Token, ParseState)
  parse-instance-params (st) (acc) =
   if is-left-paren (current-kind st) then let st2 = advance st
    in let p = current st2
    in let st3 = advance st2
    in let st4 = if is-right-paren (current-kind st3) then advance st3 else st3
    in parse-instance-params st4 (__linked-list-push acc p)
   else (subj-deck-record (__linked-list-to-list acc), st)

  try-top-level-type-def : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document
  try-top-level-type-def (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =
   let td-result = parse-type-def st
   in let st2 = td-result.state
   in when td-result.maybe-type-def
    is Just (td) ->
     parse-top-level defs (__linked-list-push type-defs td) effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines st2)
    is None ->
     try-top-level-def defs type-defs effect-defs imports ch-title sec-titles prose blocks anns st

  try-top-level-def : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document
  try-top-level-def (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =
   let def-result = parse-definition st
   in let st2 = def-result.state
   in when def-result.maybe-def
    is Just (d) ->
     let tagged = subj-deck-record (Def {
      name = d.name,
      params = d.params,
      ann = d.ann,
      body = d.body,
      chapter-slug = ch-title
     })
     in parse-top-level (__linked-list-push defs tagged) type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines st2)
    is None ->
     parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines (advance st2))

  parse-claim-arm : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document
  parse-claim-arm (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =
   if is-simple-claim st then parse-simple-claim defs type-defs effect-defs imports ch-title sec-titles prose blocks anns st
   else let claim-ann = parse-claim-annotation st
    in parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks (__linked-list-push anns claim-ann) (skip-to-next-line st)

  parse-simple-claim : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document
  parse-simple-claim (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =
   let name-tok = current (advance st)
   in when parse-type-annotation (advance st)
    is TypeOk (prop-ty) (st4) ->
     let ann = subj-deck-record ([subj-deck-record (TypeAnn { name = name-tok, type-expr = prop-ty })])
     in let st5 = skip-newlines st4
     in let st6 = if is-proof-keyword (current-kind st5) then advance st5 else st5
     in let proof-name = current st6
     in let dr = parse-def-params-then ann proof-name [] (advance st6)
     in when dr.maybe-def
      is Just (d) ->
       let tagged = subj-deck-record (Def {
        name = d.name,
        params = d.params,
        ann = d.ann,
        body = d.body,
        chapter-slug = ch-title
       })
       in parse-top-level (__linked-list-push defs tagged) type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines (dr.state))
      is None ->
       parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines (advance (dr.state)))
    is otherwise ->
     parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-to-next-line st)

Section: Prose Anchoring

  template-anchor : ProseTemplate -> Text
  template-anchor (t) =
   when t
    is PtRecordTemplate (n) -> n
    is PtVariantTemplate (n) -> n
    is PtFunctionTemplate (n) -> n
    is PtNoTemplate | PtConstraintTemplate | PtProofTemplate | PtProcedureTemplate | PtQuantifiedTemplate -> ""

  def-name-offset : List Def, Integer -> Integer
  def-name-offset (defs) (i) =
   let tok = (list-at defs i).name
   in tok.offset

  type-def-name-offset : List TypeDef, Integer -> Integer
  type-def-name-offset (type-defs) (i) =
   let tok = (list-at type-defs i).name
   in tok.offset

  advance-defs-past : List Def, Integer, Integer, Integer -> Integer
  advance-defs-past (defs) (di) (dlen) (off) =
   if di >= dlen then di
   else if def-name-offset defs di < off then advance-defs-past defs (di + 1) dlen off
   else di

  advance-type-defs-past : List TypeDef, Integer, Integer, Integer -> Integer
  advance-type-defs-past (type-defs) (ti) (tlen) (off) =
   if ti >= tlen then ti
   else if type-def-name-offset type-defs ti < off then advance-type-defs-past type-defs (ti + 1) tlen off
   else ti

  following-def-name : List Def, List TypeDef, Integer, Integer, Integer, Integer -> Text
  following-def-name (defs) (type-defs) (di) (ti) (dlen) (tlen) =
   if di >= dlen then if ti >= tlen then "" else token-text ((list-at type-defs ti).name)
   else if ti >= tlen then token-text ((list-at defs di).name)
   else if def-name-offset defs di <= type-def-name-offset type-defs ti then token-text ((list-at defs di).name)
   else token-text ((list-at type-defs ti).name)

  anchor-one-block : ProseBlock, List Def, List TypeDef, Integer, Integer, Integer, Integer -> ProseBlock
  anchor-one-block (block) (defs) (type-defs) (di) (ti) (dlen) (tlen) =
   let claimed = template-anchor (block.template)
   in let name = if text-length claimed > 0 then claimed
      else following-def-name defs type-defs di ti dlen tlen
   in subj-deck-record (ProseBlock {
    text = block.text,
    transition = block.transition,
    template = block.template,
    anchor = name,
    offset = block.offset
   })

  anchor-blocks-loop : List ProseBlock, List Def, List TypeDef, Integer, Integer, Integer, Integer, Integer, Integer, List ProseBlock -> List ProseBlock
  anchor-blocks-loop (blocks) (defs) (type-defs) (i) (di) (ti) (blen) (dlen) (tlen) (acc) =
   if i >= blen then acc
   else let block = list-at blocks i
   in let di2 = advance-defs-past defs di dlen (block.offset)
   in let ti2 = advance-type-defs-past type-defs ti tlen (block.offset)
   in anchor-blocks-loop blocks defs type-defs (i + 1) di2 ti2 blen dlen tlen (list-push acc (anchor-one-block block defs type-defs di2 ti2 dlen tlen))

  anchor-prose-blocks : List ProseBlock, List Def, List TypeDef -> List ProseBlock
  anchor-prose-blocks (blocks) (defs) (type-defs) =
   anchor-blocks-loop blocks defs type-defs 0 0 0 (list-length blocks) (list-length defs) (list-length type-defs) []

Section: Prose-Notation Consistency

  find-type-def-named : List TypeDef, Text, Integer -> Integer
  find-type-def-named (type-defs) (name) (i) =
   if i >= list-length type-defs then 0 - 1
   else if token-text ((list-at type-defs i).name) == name then i
   else find-type-def-named type-defs name (i + 1)

  check-prose-type-name : Text, List TypeDef, Integer between 0 and 65535, Text, List Diagnostic -> List Diagnostic
  check-prose-type-name (template-name) (type-defs) (diag-code) (kind) (acc) =
   let found = find-type-def-named type-defs template-name 0
   in if found < 0 then list-push acc (make-warning diag-code ("Prose declares " & kind & " '" & template-name & "' but no type definition with that name exists") synthetic-span)
   else acc

  parser-find-def-index : List Def, Text, Integer, Integer -> Integer
  parser-find-def-index (defs) (name) (i) (len) =
   if i >= len then (-1)
   else if token-text ((list-at defs i).name) == name then i
   else parser-find-def-index defs name (i + 1) len

  effect-op-declares : List EffectOpDef, Text, Integer, Integer -> Boolean
  effect-op-declares (ops) (name) (i) (len) =
   if i >= len then False
   else if token-text ((list-at ops i).name) == name then True
   else effect-op-declares ops name (i + 1) len

  effect-defs-declare : List EffectDef, Text, Integer, Integer -> Boolean
  effect-defs-declare (eds) (name) (i) (len) =
   if i >= len then False
   else let ops = (list-at eds i).ops
   in if effect-op-declares ops name 0 (list-length ops) then True
      else effect-defs-declare eds name (i + 1) len

  check-prose-function : Text, List Def, List EffectDef, List Diagnostic -> List Diagnostic
  check-prose-function (template-name) (defs) (effect-defs) (acc) =
   if list-length defs == 0 then acc
   else if parser-find-def-index defs template-name 0 (list-length defs) >= 0 then acc
      else if effect-defs-declare effect-defs template-name 0 (list-length effect-defs) then acc
      else list-push acc (make-warning cdx-prose-function-name-mismatch ("Prose declares function '" & template-name & "' but no definition of that name appears in this chapter") synthetic-span)

  extract-prose-params : Text, Integer, Integer, List Text -> List Text
  extract-prose-params (line) (i) (len) (acc) =
   if i >= len then acc
   else if char-at line i == '(' then extract-prose-param-name line (i + 1) len acc
   else extract-prose-params line (i + 1) len acc

  extract-prose-param-name : Text, Integer, Integer, List Text -> List Text
  extract-prose-param-name (line) (i) (len) (acc) =
   if i >= len then acc
   else if char-at line i == ')' then
    let name = extract-prose-param-word line i (i - 1)
    in extract-prose-params line (i + 1) len (if text-length name > 0 then list-push acc name else acc)
   else if char-at line i == ':' then
    let name = extract-prose-param-word line i (i - 1)
    in let skip = prose-skip-close-paren line (i + 1) len
    in extract-prose-params line (skip + 1) len (if text-length name > 0 then list-push acc name else acc)
   else extract-prose-param-name line (i + 1) len acc

  extract-prose-param-word : Text, Integer, Integer -> Text
  extract-prose-param-word (line) (limit) (j) =
   if j < 0 then ""
   else if char-at line j == '(' then substring line (j + 1) (limit - j - 1)
   else if char-at line j == ' ' then substring line (j + 1) (limit - j - 1)
   else extract-prose-param-word line limit (j - 1)

  prose-skip-close-paren : Text, Integer, Integer -> Integer
  prose-skip-close-paren (line) (i) (len) =
   if i >= len then len
   else if char-at line i == ')' then i
   else prose-skip-close-paren line (i + 1) len

  check-prose-params : Text, List Text, List Def, List Diagnostic -> List Diagnostic
  check-prose-params (template-name) (prose-params) (defs) (acc) =
   if list-length defs == 0 then acc
   else let idx = parser-find-def-index defs template-name 0 (list-length defs)
   in if idx >= 0 then
    let matched-def = list-at defs idx
    in let def-name = token-text (matched-def.name)
    in let def-params = matched-def.params
    in let def-count = list-length def-params
    in let prose-count = list-length prose-params
    in if prose-count == 0 then acc
       else if prose-count == def-count then check-prose-param-names prose-params def-params 0 def-count acc
       else list-push acc (make-warning cdx-prose-parameter-mismatch ("Prose declares " & show prose-count & " parameters but '" & def-name & "' has " & show def-count) synthetic-span)
      else acc

  check-prose-param-names : List Text, List Token, Integer, Integer, List Diagnostic -> List Diagnostic
  check-prose-param-names (prose-params) (def-params) (i) (len) (acc) =
   if i >= len then acc
   else let prose-name = list-at prose-params i
   in let def-name = token-text (list-at def-params i)
   in if prose-name == def-name then check-prose-param-names prose-params def-params (i + 1) len acc
      else list-push (check-prose-param-names prose-params def-params (i + 1) len acc) (make-warning cdx-prose-parameter-mismatch ("Prose parameter " & show (i + 1) & " is '" & prose-name & "' but notation has '" & def-name & "'") synthetic-span)

  check-prose-block-against-defs : ProseBlock, List Def, List TypeDef, List EffectDef, List Diagnostic -> List Diagnostic
  check-prose-block-against-defs (block) (defs) (type-defs) (effect-defs) (acc) =
   when (block.template)
    is PtFunctionTemplate (fn) ->
     let name-diags = check-prose-function (block.anchor) defs effect-defs acc
     in let prose-params = extract-prose-params (block.text) 0 (text-length (block.text)) []
     in check-prose-params (block.anchor) prose-params defs name-diags
    is PtRecordTemplate (rn) -> check-prose-type-name (block.anchor) type-defs cdx-prose-record-field-mismatch "record" acc
    is PtVariantTemplate (vn) -> check-prose-type-name (block.anchor) type-defs cdx-prose-variant-ctor-mismatch "variant" acc
    is PtNoTemplate | PtConstraintTemplate | PtProofTemplate | PtProcedureTemplate | PtQuantifiedTemplate -> acc

  check-prose-consistency : Document -> List Diagnostic
  check-prose-consistency (doc) =
   check-prose-blocks-loop (doc.prose-blocks) (doc.defs) (doc.type-defs) (doc.effect-defs) 0 (list-length (doc.prose-blocks)) []

  check-prose-blocks-loop : List ProseBlock, List Def, List TypeDef, List EffectDef, Integer, Integer, List Diagnostic -> List Diagnostic
  check-prose-blocks-loop (blocks) (defs) (type-defs) (effect-defs) (i) (len) (acc) =
   if i >= len then acc
   else let block = list-at blocks i
   in check-prose-blocks-loop blocks defs type-defs effect-defs (i + 1) len (check-prose-block-against-defs block defs type-defs effect-defs acc)

Section: Banned Word Enforcement

  BannedWord = record {
   word : Text,
   substitute : Text
  }

  banned-words : List BannedWord = [
   BannedWord { word = " it ", substitute = "the named value" },
   BannedWord { word = " this ", substitute = "the named value" },
   BannedWord { word = " they ", substitute = "the named collection" },
   BannedWord { word = " some ", substitute = "a quantifier (all, every, exactly one, ...)" },
   BannedWord { word = " many ", substitute = "a quantifier or explicit bound" },
   BannedWord { word = " few ", substitute = "a quantifier or explicit bound" },
   BannedWord { word = " etc.", substitute = "exhaust the list or use a type" },
   BannedWord { word = " etc ", substitute = "exhaust the list or use a type" },
   BannedWord { word = " so ", substitute = "'therefore' or 'in order to'" },
   BannedWord { word = " since ", substitute = "'because' (causal) or 'after' (temporal)" },
   BannedWord { word = " while ", substitute = "'during' or 'at the same time as'" },
   BannedWord { word = " may ", substitute = "'can' (possibility) or 'is permitted to' (permission)" },
   BannedWord { word = " might ", substitute = "'can' (possibility) or 'is permitted to' (permission)" },
   BannedWord { word = " should ", substitute = "'must' (obligation) or 'is recommended to' (recommendation)" }
  ]

  check-banned-word : Text, BannedWord -> Maybe Diagnostic
  check-banned-word (line) (bw) =
   if text-contains line (bw.word) then
    Just (make-warning cdx-prose-banned-word ("Banned word '" & bw.word & "' in load-bearing prose; use " & bw.substitute) synthetic-span)
   else None

  check-banned-words-in-line : Text, List BannedWord, Integer, Integer, List Diagnostic -> List Diagnostic
  check-banned-words-in-line (line) (words) (i) (len) (acc) =
   if i >= len then acc
   else let bw = list-at words i
   in when check-banned-word line bw
    is Just (d) -> check-banned-words-in-line line words (i + 1) len (list-push acc d)
    is None -> check-banned-words-in-line line words (i + 1) len acc

  check-banned-in-blocks : List ProseBlock, Integer, Integer, Boolean, List Diagnostic -> List Diagnostic
  check-banned-in-blocks (blocks) (i) (len) (in-we-say) (acc) =
   if i >= len then acc
   else let block = list-at blocks i
   in let now-in-we-say = when (block.transition) is PtWeSay | PtThisIsWritten -> True is PtNone -> in-we-say
   in if now-in-we-say then let diags = check-banned-words-in-line (block.text) banned-words 0 (list-length banned-words) acc
      in check-banned-in-blocks blocks (i + 1) len now-in-we-say diags
      else check-banned-in-blocks blocks (i + 1) len now-in-we-say acc

  check-prose-banned : Document -> List Diagnostic
  check-prose-banned (doc) =
   check-banned-in-blocks (doc.prose-blocks) 0 (list-length (doc.prose-blocks)) False []

Section: Header Scanning (streaming)

  scan-document : ParseState -> ScanResult
  scan-document (st) =
   let st2 = skip-newlines st
   in let (imp-list, imp-st) = parse-citations st2 "" []
   in scan-top-level [] [] [] imp-list "" "" [] [] imp-st

  scan-top-level : LinkedList DefHeader, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, Text, LinkedList Text, LinkedList Text, ParseState -> ScanResult
  scan-top-level (headers) (type-defs) (effect-defs) (imports) (cur-chap) (ch-title) (sec-titles) (chap-names) (st) =
   if is-done st then subj-deck-record (ScanResult {
    type-defs = subj-deck-record (__linked-list-to-list type-defs),
    effect-defs = subj-deck-record (__linked-list-to-list effect-defs),
    class-defs = [],
    instance-defs = [],
    def-headers = subj-deck-record (__linked-list-to-list headers),
    citations = imports,
    chapter-title = ch-title,
    section-titles = subj-deck-record (__linked-list-to-list sec-titles),
    chapter-names = subj-deck-record (__linked-list-to-list chap-names)
   })
   else if is-chapter-header st then let title = extract-header-title st
     in scan-top-level headers type-defs effect-defs imports title title sec-titles (__linked-list-push chap-names title) (skip-prose-lines (skip-to-next-line st))
   else if is-section-header st then let title = extract-header-title st
     in scan-top-level headers type-defs effect-defs imports cur-chap ch-title (__linked-list-push sec-titles title) chap-names (skip-prose-lines (skip-to-next-line st))
   else if is-page-marker st then scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-to-next-line st)
   else if is-cites-keyword (current-kind st) then let (cite-imports, cite-st) = parse-citations st cur-chap []
     in scan-top-level headers type-defs effect-defs (subj-deck-record (imports & cite-imports)) cur-chap ch-title sec-titles chap-names cite-st
   else if is-quotes-keyword (current-kind st) | is-trusting-keyword (current-kind st) | is-grounds-keyword (current-kind st) then scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-to-next-line st)
   else if is-effect-keyword (current-kind st) then scan-top-level-effect headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names st
   else if is-class-keyword (current-kind st) then let st-c1 = advance st
    in let st-c2 = advance st-c1
    in let st-c2b = if is-ident (current-kind st-c2) & is-fat-arrow (peek-kind st-c2 1)
      then advance (advance (advance st-c2))
      else st-c2
    in let st-c3 = if is-where-keyword (current-kind st-c2b) then skip-newlines (advance st-c2b) else st-c2b
    in let (_, ops-st) = parse-effect-ops st-c3 []
    in scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-newlines ops-st)
   else if is-instance-keyword (current-kind st) then let st-i1 = advance st
    in let st-i2 = advance st-i1
    in let st-i3 = advance st-i2
    in let st-i4 = if is-where-keyword (current-kind st-i3) then skip-newlines (advance st-i3) else st-i3
    in scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-body-lines st-i4)
   else if is-prose-line st then scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-prose-lines st)
   else if (current st).column > 3 then scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-to-next-line st)
   else try-scan-type-def headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names st

  scan-top-level-effect : LinkedList DefHeader, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, Text, LinkedList Text, LinkedList Text, ParseState -> ScanResult
  scan-top-level-effect (headers) (type-defs) (effect-defs) (imports) (cur-chap) (ch-title) (sec-titles) (chap-names) (st) =
   let st1 = advance st
   in let name-tok = current st1
   in let st2 = advance st1
   in let st3 = if is-where-keyword (current-kind st2) then skip-newlines (advance st2) else st2
   in let (ops-list, ops-st) = parse-effect-ops st3 []
   in let ed = subj-deck-record (EffectDef {
        name = name-tok,
        ops = ops-list
       })
   in scan-top-level headers type-defs (__linked-list-push effect-defs ed) imports cur-chap ch-title sec-titles chap-names (skip-newlines ops-st)

  try-scan-type-def : LinkedList DefHeader, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, Text, LinkedList Text, LinkedList Text, ParseState -> ScanResult
  try-scan-type-def (headers) (type-defs) (effect-defs) (imports) (cur-chap) (ch-title) (sec-titles) (chap-names) (st) =
   let td-result = parse-type-def st
   in let st2 = td-result.state
   in when td-result.maybe-type-def
    is Just (td) ->
     scan-top-level headers (__linked-list-push type-defs td) effect-defs imports cur-chap ch-title sec-titles chap-names (skip-newlines st2)
    is None ->
     try-scan-def-header headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names st

  try-scan-def-header : LinkedList DefHeader, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, Text, LinkedList Text, LinkedList Text, ParseState -> ScanResult
  try-scan-def-header (headers) (type-defs) (effect-defs) (imports) (cur-chap) (ch-title) (sec-titles) (chap-names) (st) =
   let hdr-result = scan-definition cur-chap st
   in let st2 = hdr-result.state
   in when hdr-result.maybe-header
    is Just (hdr) ->
     scan-top-level (__linked-list-push headers hdr) type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-newlines st2)
    is None ->
     scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-newlines (advance st2))

  scan-definition : Text, ParseState -> ScanDefResult
  scan-definition (cur-chap) (st) =
   if is-done st then ScanDefResult { maybe-header = None, state = st }
   else if is-ident (current-kind st) then try-scan-def cur-chap st
   else if is-type-ident (current-kind st) then try-scan-def cur-chap st
     else ScanDefResult { maybe-header = None, state = st }

  try-scan-def : Text, ParseState -> ScanDefResult
  try-scan-def (cur-chap) (st) =
   if is-colon (peek-kind st 1) then let first-name = current st
     in let ann-result = parse-type-annotation st
     in unwrap-type-for-scan cur-chap first-name ann-result
    else scan-def-body-with-ann cur-chap [] st

  unwrap-type-for-scan : Text, Token, ParseTypeResult -> ScanDefResult
  unwrap-type-for-scan (cur-chap) (first-name) (r) =
   when r
    is TypeOk (ann-type) (st) ->
     if is-equals (current-kind st) then
      let ann = subj-deck-record ([subj-deck-record (TypeAnn {
       name = first-name,
       type-expr = ann-type
      })])
      in let st2 = advance st
      in let st3 = skip-newlines st2
      in let body-pos = st3.pos
      in let st4 = skip-body-tokens st3 (first-name.column)
      in ScanDefResult {
          maybe-header = Just (subj-deck-record (DefHeader {
           name = first-name,
           params = [],
           ann = ann,
           body-pos = body-pos,
           chapter-slug = cur-chap
          })),
          state = st4
         }
     else
      let name-tok = subj-deck-record (Token {
       kind = Identifier,
       source = "",
       offset = 0,
       length = 0,
       line = 0,
       column = 0,
       file-id = 0
      })
      in let ann = subj-deck-record ([subj-deck-record (TypeAnn {
       name = name-tok,
       type-expr = ann-type
      })])
      in let st2 = skip-newlines st
      in scan-def-body-with-ann cur-chap ann st2

  scan-def-body-with-ann : Text, List TypeAnn, ParseState -> ScanDefResult
  scan-def-body-with-ann (cur-chap) (ann) (st) =
   let name-tok = current st
   in let st2 = advance st
   in scan-def-params-then cur-chap ann name-tok [] st2

  scan-def-params-then : Text, List TypeAnn, Token, LinkedList Token, ParseState -> ScanDefResult
  scan-def-params-then (cur-chap) (ann) (name-tok) (acc) (st) =
   if is-left-paren (current-kind st) then let st2 = advance st
   in if is-ident (current-kind st2) then let param = current st2
   in let st3 = advance st2
   in let st4 = expect RightParen st3
   in scan-def-params-then cur-chap ann name-tok (__linked-list-push acc param) st4
      else finish-def-scan cur-chap ann name-tok (subj-deck-record (__linked-list-to-list acc)) st
    else finish-def-scan cur-chap ann name-tok (subj-deck-record (__linked-list-to-list acc)) st

  finish-def-scan : Text, List TypeAnn, Token, List Token, ParseState -> ScanDefResult
  finish-def-scan (cur-chap) (ann) (name-tok) (params) (st) =
   if is-equals (current-kind st) == False then ScanDefResult { maybe-header = None, state = st }
   else let st2 = advance st
   in let st3 = skip-newlines st2
   in let body-pos = st3.pos
   in let st4 = skip-body-tokens st3 (name-tok.column)
   in ScanDefResult {
       maybe-header = Just (subj-deck-record (DefHeader {
        name = name-tok,
        params = params,
        ann = ann,
        body-pos = body-pos,
        chapter-slug = cur-chap
       })),
       state = st4
      }

  skip-body-tokens : ParseState, Integer -> ParseState
  skip-body-tokens (st) (name-col) =
   if is-done st then st
   else let tok = current st
   in when tok.kind
     is Newline | Indent | Dedent -> skip-body-tokens (advance st) name-col
     is otherwise -> if tok.column <= name-col then st
      else skip-body-tokens (advance st) name-col

Page 1 of 3



Chapter: Parsmi--AST Nodes

Section: Names and Literals
  LiteralKind =
   | IntLit
   | NumLit
   | TextLit
   | CharLit
   | BoolLit

  BinaryOp =
   | OpAdd
   | OpSub
   | OpMul
   | OpDiv
   | OpPow
   | OpEq
   | OpNotEq
   | OpLt
   | OpGt
   | OpLtEq
   | OpGtEq
   | OpDefEq
   | OpAppend
   | OpCons
   | OpAnd
   | OpOr
   | OpApproxEq
   | OpApproxEqExact

Section: Expressions
  AExpr =
   | ALitExpr (Text) (LiteralKind) (SourceSpan)
   | ANameExpr (Name) (SourceSpan)
   | AApplyExpr (AExpr) (AExpr) (SourceSpan)
   | ABinaryExpr (AExpr) (BinaryOp) (AExpr) (SourceSpan)
   | AUnaryExpr (AExpr) (SourceSpan)
   | AIfExpr (AExpr) (AExpr) (AExpr) (SourceSpan)
   | ALetExpr (List ALetBind) (AExpr) (SourceSpan)
   | ALambdaExpr (List Name) (AExpr) (SourceSpan)
   | AMatchExpr (AExpr) (List AMatchArm) (SourceSpan)
   | AListExpr (List AExpr) (SourceSpan)
   | ARecordExpr (Name) (List AFieldExpr) (SourceSpan)
   | AFieldAccess (AExpr) (Name) (SourceSpan)
   | AActExpr (List AActStmt) (SourceSpan)
   | AHandleExpr (Name) (AExpr) (List AHandleClause) (SourceSpan)
   | AWithTimeoutExpr (Text) (List Name) (List Text) (AExpr) (SourceSpan)
   | ATryExpr (Integer) (List AActStmt) (List AActStmt) (List AActStmt) (SourceSpan)
   | AFieldAssignExpr (AExpr) (Name) (AExpr) (SourceSpan)
   | ALazyExpr (AExpr) (SourceSpan)
   | AErrorExpr (Text) (SourceSpan)
   | AInductionExpr (AExpr) (List AMatchArm) (SourceSpan)

  ALetBind = record {
   name : Name,
   value : AExpr,
   span : SourceSpan
  }

  AMatchArm = record {
   pattern : APat,
   body : AExpr,
   guard : AExpr,
   span : SourceSpan,
   alt-group : Integer
  }

  AFieldExpr = record {
   name : Name,
   value : AExpr,
   span : SourceSpan
  }

  AActStmt =
   | AActBindStmt (Name) (AExpr) (SourceSpan)
   | AActExprStmt (AExpr) (SourceSpan)

  AHandleClause = record {
   op-name : Name,
   params : List Name,
   resume-name : Name,
   body : AExpr,
   span : SourceSpan
  }

Section: Patterns
  APat =
   | AVarPat (Name) (SourceSpan)
   | ALitPat (Text) (LiteralKind) (SourceSpan)
   | ACtorPat (Name) (List APat) (SourceSpan)
   | AWildPat (SourceSpan)
   | AVecPat (List APat) (SourceSpan)

Section: Type Expressions
  ATypeExpr =
   | ANamedType (Name) (SourceSpan)
   | AFunType (ATypeExpr) (ATypeExpr) (SourceSpan)
   | AAppType (ATypeExpr) (List ATypeExpr) (SourceSpan)
   | AEffectType (List Name) (List Text) (List Name) (ATypeExpr) (SourceSpan)
   | ABoundedIntType (ATypeExpr) (Integer) (Integer) (OverflowMode) (SourceSpan)
   | APropEqType (ATypeExpr) (ATypeExpr) (SourceSpan)
   | AConstrainedType (Name) (Name) (ATypeExpr) (SourceSpan)
   | ALinearType (ATypeExpr) (SourceSpan)
   | AForallType (Name) (ATypeExpr) (ATypeExpr) (SourceSpan)

Section: Definitions
  AParam = record {
   name : Name,
   span : SourceSpan
  }

  mutable ADef = record {
   name : Name,
   params : List AParam,
   declared-type : List ATypeExpr,
   body : AExpr,
   chapter-slug : Text,
   span : SourceSpan
  }

  ARecordFieldDef = record {
   name : Name,
   type-expr : ATypeExpr,
   span : SourceSpan
  }

  AVariantCtorDef = record {
   name : Name,
   fields : List ATypeExpr,
   return-type : List ATypeExpr,
   span : SourceSpan
  }

  ATypeDef =
   | ARecordTypeDef (Name) (List Name) (List ARecordFieldDef) (Boolean) (SourceSpan)
   | AVariantTypeDef (Name) (List Name) (List AVariantCtorDef) (SourceSpan)
   | AUnitTypeDef (Name) (ATypeExpr) (SourceSpan)

  AEffectOpDef = record {
   name : Name,
   type-expr : ATypeExpr,
   span : SourceSpan
  }

  AEffectDef = record {
   name : Name,
   ops : List AEffectOpDef,
   span : SourceSpan
  }

  AClassDef = record {
   name : Name,
   methods : List AEffectOpDef,
   span : SourceSpan
  }

  AInstanceMethodDef = record {
   name : Name,
   params : List Name,
   body : AExpr,
   span : SourceSpan
  }

  AInstanceDef = record {
   class-name : Name,
   type-name : Name,
   methods : List AInstanceMethodDef,
   span : SourceSpan
  }

Section: Chapter
  ACitesDecl = record {
   quire : Name,
   chapter-name : Name,
   selected-names : List Name,
   citing-chapter : Text,
   span : SourceSpan
  }

  AChapter = record {
   name : Name,
   defs : List ADef,
   type-defs : List ATypeDef,
   effect-defs : List AEffectDef,
   class-defs : List AClassDef,
   instance-defs : List AInstanceDef,
   citations : List ACitesDecl,
   ground-effects : List Text,
   chapter-title : Text,
   prose : Text,
   prose-blocks : List ProseBlock,
   annotations : List AnnotationNode,
   section-titles : List Text,
   rt-names : List Text,
   rt-budgets : List Integer,
   conversions : List Text,
   span : SourceSpan
  }

Section: Span Accessor
  aexpr-span : AExpr -> SourceSpan
  aexpr-span (e) =
   when e
    is ALitExpr (t) (k) (s) | ANameExpr (n) (s) | AApplyExpr (f) (a) (s) | ABinaryExpr (l) (op) (r) (s) | AUnaryExpr (x) (s) | AIfExpr (c) (t) (el) (s) | ALetExpr (bs) (b) (s) | ALambdaExpr (ps) (b) (s) | AMatchExpr (sc) (arms) (s) | AListExpr (es) (s) | ARecordExpr (n) (fs) (s) | AFieldAccess (r) (f) (s) | AActExpr (ss) (s) | AHandleExpr (eff) (b) (cs) (s) | AWithTimeoutExpr (timeout) (effs) (scopes) (b) (s) | ATryExpr (max) (body) (fb) (fail) (s) | AFieldAssignExpr (r) (f) (v) (s) | ALazyExpr (inner) (s) | AErrorExpr (m) (s) | AInductionExpr (sc) (arms) (s) -> s

Section: Deck Copies

 Deep-copy functions for the AST, used by the frontend keep deck
 to copy desugared survivors below the dead LEX/PARSE/DESUGAR
 decks. Same positional sharing rule as the CST copiers: values
 at or below the reservation base b are already in the keep
 region and shared in place; values above b are rebuilt. Leaf
 copiers (copy-sx-text, copy-sx-span, copy-sx-ov) live in
 SyntaxNodes. Enums (LiteralKind, BinaryOp) are nullary sums
 that heap-box, so they are rebuilt unconditionally.

  copy-as-name : Integer, Name -> Name
  copy-as-name (b) (n) = Name { value = copy-sx-text b (n.value) }

  copy-as-names : Integer, List Name -> List Name
  copy-as-names (b) (ns) = for n in ns -> copy-as-name b n

  copy-as-litk : LiteralKind -> LiteralKind
  copy-as-litk (k) =
   when k
    is IntLit -> IntLit
    is NumLit -> NumLit
    is TextLit -> TextLit
    is CharLit -> CharLit
    is BoolLit -> BoolLit

  copy-as-binop : BinaryOp -> BinaryOp
  copy-as-binop (op) =
   when op
    is OpAdd -> OpAdd
    is OpSub -> OpSub
    is OpMul -> OpMul
    is OpDiv -> OpDiv
    is OpPow -> OpPow
    is OpEq -> OpEq
    is OpNotEq -> OpNotEq
    is OpLt -> OpLt
    is OpGt -> OpGt
    is OpLtEq -> OpLtEq
    is OpGtEq -> OpGtEq
    is OpDefEq -> OpDefEq
    is OpAppend -> OpAppend
    is OpCons -> OpCons
    is OpAnd -> OpAnd
    is OpOr -> OpOr
    is OpApproxEq -> OpApproxEq
    is OpApproxEqExact -> OpApproxEqExact

  copy-as-actstmt : Integer, AActStmt -> AActStmt
  copy-as-actstmt (b) (s) =
   when s
    is AActBindStmt (n) (e) (sp) -> AActBindStmt (copy-as-name b n) (copy-as-expr b e) (copy-sx-span b sp)
    is AActExprStmt (e) (sp) -> AActExprStmt (copy-as-expr b e) (copy-sx-span b sp)

  copy-as-letbind : Integer, ALetBind -> ALetBind
  copy-as-letbind (b) (lb) = ALetBind { name = copy-as-name b (lb.name), value = copy-as-expr b (lb.value), span = copy-sx-span b (lb.span) }

  copy-as-pat : Integer, APat -> APat
  copy-as-pat (b) (p) =
   when p
    is AVarPat (n) (sp) -> AVarPat (copy-as-name b n) (copy-sx-span b sp)
    is ALitPat (t) (k) (sp) -> ALitPat (copy-sx-text b t) (copy-as-litk k) (copy-sx-span b sp)
    is ACtorPat (n) (args) (sp) -> ACtorPat (copy-as-name b n) (for a in args -> copy-as-pat b a) (copy-sx-span b sp)
    is AWildPat (sp) -> AWildPat (copy-sx-span b sp)
    is AVecPat (subs) (sp) -> AVecPat (for a in subs -> copy-as-pat b a) (copy-sx-span b sp)

  copy-as-matcharm : Integer, AMatchArm -> AMatchArm
  copy-as-matcharm (b) (a) = AMatchArm {
   pattern = copy-as-pat b (a.pattern),
   body = copy-as-expr b (a.body),
   guard = copy-as-expr b (a.guard),
   span = copy-sx-span b (a.span),
   alt-group = a.alt-group
  }

  copy-as-fieldexpr : Integer, AFieldExpr -> AFieldExpr
  copy-as-fieldexpr (b) (f) = AFieldExpr { name = copy-as-name b (f.name), value = copy-as-expr b (f.value), span = copy-sx-span b (f.span) }

  copy-as-handleclause : Integer, AHandleClause -> AHandleClause
  copy-as-handleclause (b) (c) = AHandleClause {
   op-name = copy-as-name b (c.op-name),
   params = copy-as-names b (c.params),
   resume-name = copy-as-name b (c.resume-name),
   body = copy-as-expr b (c.body),
   span = copy-sx-span b (c.span)
  }

  copy-as-expr : Integer, AExpr -> AExpr
  copy-as-expr (b) (e) =
   when e
    is ALitExpr (t) (k) (sp) -> ALitExpr (copy-sx-text b t) (copy-as-litk k) (copy-sx-span b sp)
    is ANameExpr (n) (sp) -> ANameExpr (copy-as-name b n) (copy-sx-span b sp)
    is AApplyExpr (f) (a) (sp) -> AApplyExpr (copy-as-expr b f) (copy-as-expr b a) (copy-sx-span b sp)
    is ABinaryExpr (l) (op) (r) (sp) -> ABinaryExpr (copy-as-expr b l) (copy-as-binop op) (copy-as-expr b r) (copy-sx-span b sp)
    is AUnaryExpr (x) (sp) -> AUnaryExpr (copy-as-expr b x) (copy-sx-span b sp)
    is AIfExpr (c) (t) (el) (sp) -> AIfExpr (copy-as-expr b c) (copy-as-expr b t) (copy-as-expr b el) (copy-sx-span b sp)
    is ALetExpr (bs) (body) (sp) -> ALetExpr (for lb in bs -> copy-as-letbind b lb) (copy-as-expr b body) (copy-sx-span b sp)
    is ALambdaExpr (ps) (body) (sp) -> ALambdaExpr (copy-as-names b ps) (copy-as-expr b body) (copy-sx-span b sp)
    is AMatchExpr (sc) (arms) (sp) -> AMatchExpr (copy-as-expr b sc) (for a in arms -> copy-as-matcharm b a) (copy-sx-span b sp)
    is AListExpr (es) (sp) -> AListExpr (for el in es -> copy-as-expr b el) (copy-sx-span b sp)
    is ARecordExpr (n) (fs) (sp) -> ARecordExpr (copy-as-name b n) (for f in fs -> copy-as-fieldexpr b f) (copy-sx-span b sp)
    is AFieldAccess (rec) (fld) (sp) -> AFieldAccess (copy-as-expr b rec) (copy-as-name b fld) (copy-sx-span b sp)
    is AActExpr (stmts) (sp) -> AActExpr (for s in stmts -> copy-as-actstmt b s) (copy-sx-span b sp)
    is AHandleExpr (eff) (body) (cs) (sp) -> AHandleExpr (copy-as-name b eff) (copy-as-expr b body) (for c in cs -> copy-as-handleclause b c) (copy-sx-span b sp)
    is AWithTimeoutExpr (timeout) (effs) (scopes) (body) (sp) -> AWithTimeoutExpr (copy-sx-text b timeout) (copy-as-names b effs) (copy-sx-texts b scopes) (copy-as-expr b body) (copy-sx-span b sp)
    is ATryExpr (max) (t-stmts) (c-stmts) (f-stmts) (sp) -> ATryExpr max (for ts in t-stmts -> copy-as-actstmt b ts) (for cs in c-stmts -> copy-as-actstmt b cs) (for fs in f-stmts -> copy-as-actstmt b fs) (copy-sx-span b sp)
    is AFieldAssignExpr (rec) (fld) (val) (sp) -> AFieldAssignExpr (copy-as-expr b rec) (copy-as-name b fld) (copy-as-expr b val) (copy-sx-span b sp)
    is ALazyExpr (inner) (sp) -> ALazyExpr (copy-as-expr b inner) (copy-sx-span b sp)
    is AErrorExpr (m) (sp) -> AErrorExpr (copy-sx-text b m) (copy-sx-span b sp)
    is AInductionExpr (sc) (arms) (sp) -> AInductionExpr (copy-as-expr b sc) (for a in arms -> copy-as-matcharm b a) (copy-sx-span b sp)

  copy-as-typeexpr : Integer, ATypeExpr -> ATypeExpr
  copy-as-typeexpr (b) (t) =
   when t
    is ANamedType (n) (sp) -> ANamedType (copy-as-name b n) (copy-sx-span b sp)
    is AFunType (a) (r) (sp) -> AFunType (copy-as-typeexpr b a) (copy-as-typeexpr b r) (copy-sx-span b sp)
    is AAppType (f) (args) (sp) -> AAppType (copy-as-typeexpr b f) (for a in args -> copy-as-typeexpr b a) (copy-sx-span b sp)
    is AEffectType (effs) (caps) (tail) (inner) (sp) -> AEffectType (copy-as-names b effs) (copy-sx-texts b caps) (copy-as-names b tail) (copy-as-typeexpr b inner) (copy-sx-span b sp)
    is ABoundedIntType (inner) (lo) (hi) (mode) (sp) -> ABoundedIntType (copy-as-typeexpr b inner) lo hi (copy-sx-ov mode) (copy-sx-span b sp)
    is APropEqType (l) (r) (sp) -> APropEqType (copy-as-typeexpr b l) (copy-as-typeexpr b r) (copy-sx-span b sp)
    is AConstrainedType (cls) (param) (inner) (sp) -> AConstrainedType (copy-as-name b cls) (copy-as-name b param) (copy-as-typeexpr b inner) (copy-sx-span b sp)
    is ALinearType (inner) (sp) -> ALinearType (copy-as-typeexpr b inner) (copy-sx-span b sp)
    is AForallType (v) (vt) (p) (sp) -> AForallType (copy-as-name b v) (copy-as-typeexpr b vt) (copy-as-typeexpr b p) (copy-sx-span b sp)

  copy-as-param : Integer, AParam -> AParam
  copy-as-param (b) (p) = AParam { name = copy-as-name b (p.name), span = copy-sx-span b (p.span) }

  copy-as-def : Integer, ADef -> ADef
  copy-as-def (b) (d) = ADef {
   name = copy-as-name b (d.name),
   params = for p in (d.params) -> copy-as-param b p,
   declared-type = for t in (d.declared-type) -> copy-as-typeexpr b t,
   body = copy-as-expr b (d.body),
   chapter-slug = copy-sx-text b (d.chapter-slug),
   span = copy-sx-span b (d.span)
  }

  copy-as-recordfielddef : Integer, ARecordFieldDef -> ARecordFieldDef
  copy-as-recordfielddef (b) (f) = ARecordFieldDef { name = copy-as-name b (f.name), type-expr = copy-as-typeexpr b (f.type-expr), span = copy-sx-span b (f.span) }

  copy-as-variantctordef : Integer, AVariantCtorDef -> AVariantCtorDef
  copy-as-variantctordef (b) (c) = AVariantCtorDef { name = copy-as-name b (c.name), fields = for f in (c.fields) -> copy-as-typeexpr b f, return-type = for r in (c.return-type) -> copy-as-typeexpr b r, span = copy-sx-span b (c.span) }

  copy-as-typedef : Integer, ATypeDef -> ATypeDef
  copy-as-typedef (b) (d) =
   when d
    is ARecordTypeDef (n) (ps) (fs) (m) (sp) -> ARecordTypeDef (copy-as-name b n) (copy-as-names b ps) (for f in fs -> copy-as-recordfielddef b f) m (copy-sx-span b sp)
    is AVariantTypeDef (n) (ps) (cs) (sp) -> AVariantTypeDef (copy-as-name b n) (copy-as-names b ps) (for c in cs -> copy-as-variantctordef b c) (copy-sx-span b sp)
    is AUnitTypeDef (n) (base) (sp) -> AUnitTypeDef (copy-as-name b n) (copy-as-typeexpr b base) (copy-sx-span b sp)

  copy-as-effectopdef : Integer, AEffectOpDef -> AEffectOpDef
  copy-as-effectopdef (b) (o) = AEffectOpDef { name = copy-as-name b (o.name), type-expr = copy-as-typeexpr b (o.type-expr), span = copy-sx-span b (o.span) }

  copy-as-effectdef : Integer, AEffectDef -> AEffectDef
  copy-as-effectdef (b) (d) = AEffectDef { name = copy-as-name b (d.name), ops = for o in (d.ops) -> copy-as-effectopdef b o, span = copy-sx-span b (d.span) }

  copy-as-classdef : Integer, AClassDef -> AClassDef
  copy-as-classdef (b) (d) = AClassDef { name = copy-as-name b (d.name), methods = for m in (d.methods) -> copy-as-effectopdef b m, span = copy-sx-span b (d.span) }

  copy-as-instmethod : Integer, AInstanceMethodDef -> AInstanceMethodDef
  copy-as-instmethod (b) (m) = AInstanceMethodDef {
   name = copy-as-name b (m.name),
   params = copy-as-names b (m.params),
   body = copy-as-expr b (m.body),
   span = copy-sx-span b (m.span)
  }

  copy-as-instancedef : Integer, AInstanceDef -> AInstanceDef
  copy-as-instancedef (b) (d) = AInstanceDef {
   class-name = copy-as-name b (d.class-name),
   type-name = copy-as-name b (d.type-name),
   methods = for m in (d.methods) -> copy-as-instmethod b m,
   span = copy-sx-span b (d.span)
  }

  copy-as-citesdecl : Integer, ACitesDecl -> ACitesDecl
  copy-as-citesdecl (b) (c) = ACitesDecl {
   quire = copy-as-name b (c.quire),
   chapter-name = copy-as-name b (c.chapter-name),
   selected-names = copy-as-names b (c.selected-names),
   citing-chapter = copy-sx-text b (c.citing-chapter),
   span = copy-sx-span b (c.span)
  }

  copy-as-chapter : Integer, AChapter -> AChapter
  copy-as-chapter (b) (ch) = AChapter {
   name = copy-as-name b (ch.name),
   defs = for d in (ch.defs) -> copy-as-def b d,
   type-defs = for t in (ch.type-defs) -> copy-as-typedef b t,
   effect-defs = for e in (ch.effect-defs) -> copy-as-effectdef b e,
   class-defs = for c in (ch.class-defs) -> copy-as-classdef b c,
   instance-defs = for i in (ch.instance-defs) -> copy-as-instancedef b i,
   citations = for c in (ch.citations) -> copy-as-citesdecl b c,
   ground-effects = copy-sx-texts b (ch.ground-effects),
   chapter-title = copy-sx-text b (ch.chapter-title),
   prose = copy-sx-text b (ch.prose),
   prose-blocks = for p in (ch.prose-blocks) -> copy-sx-proseblock b p,
   annotations = for a in (ch.annotations) -> copy-sx-annotation b a,
   section-titles = copy-sx-texts b (ch.section-titles),
   rt-names = copy-sx-texts b (ch.rt-names),
   rt-budgets = for x in (ch.rt-budgets) -> x,
   conversions = copy-sx-texts b (ch.conversions),
   span = copy-sx-span b (ch.span)
  }

 The frontier is __heap-save (R10), not __deck-pos: this copy runs inside
 a phase-wide subj-deck-record extent, where __deck-exit writes the deck-pos
 cell back only when the nesting counter returns to zero, so the cell is
 frozen at the deck's base for the whole copy. Measured 2026-07-21 with a
 `subj-deck-record (__heap-save)` probe on either side of the extent: R10
 inside it reads exactly fk-base at entry and exactly the post-exit cell
 value at exit, so it tracks the deck the cell cannot.

 On saturation an EMPTY chapter is returned, and it must be empty rather
 than the shared original -- this is DESUGAR's contract, not the
 PARSE-KEEP one, because the callers differ in what happens next.
 compile-parse ends its phase at its copy, so returning the shared scratch
 there is safe until the caller halts. compile-desugar-and-scope does NOT:
 it compacts the DESUGAR deck three lines later and runs SCOPE inside the
 same function, before any caller can read the bag. Measured by shipping
 the shared original: the selfhost against an 8 MB keep floor dies
 `!EXC=0d` in scope-adefs-ll, reading a chapter whose deck had been
 reclaimed underneath it. The empty wind-down is O(1) -- a name and a span
 -- so it cannot walk through the ceiling the way LEX's token conversion
 did.

  GuardedChapterCopy = record {
   chapter : AChapter,
   sat : Integer
  }

  copy-as-defs-guarded : Integer, Integer, List ADef, Integer, Integer, List ADef -> List ADef
  copy-as-defs-guarded (b) (ceiling) (ds) (i) (len) (acc) =
   if i == len then acc
   else if __heap-save >= ceiling then acc
   else copy-as-defs-guarded b ceiling ds (i + 1) len (list-push acc (copy-as-def b (list-at ds i)))

  copy-as-typedefs-guarded : Integer, Integer, List ATypeDef, Integer, Integer, List ATypeDef -> List ATypeDef
  copy-as-typedefs-guarded (b) (ceiling) (ts) (i) (len) (acc) =
   if i == len then acc
   else if __heap-save >= ceiling then acc
   else copy-as-typedefs-guarded b ceiling ts (i + 1) len (list-push acc (copy-as-typedef b (list-at ts i)))

  copy-as-proseblocks-guarded : Integer, Integer, List ProseBlock, Integer, Integer, List ProseBlock -> List ProseBlock
  copy-as-proseblocks-guarded (b) (ceiling) (ps) (i) (len) (acc) =
   if i == len then acc
   else if __heap-save >= ceiling then acc
   else copy-as-proseblocks-guarded b ceiling ps (i + 1) len (list-push acc (copy-sx-proseblock b (list-at ps i)))

  copy-as-annotations-guarded : Integer, Integer, List AnnotationNode, Integer, Integer, List AnnotationNode -> List AnnotationNode
  copy-as-annotations-guarded (b) (ceiling) (ns) (i) (len) (acc) =
   if i == len then acc
   else if __heap-save >= ceiling then acc
   else copy-as-annotations-guarded b ceiling ns (i + 1) len (list-push acc (copy-sx-annotation b (list-at ns i)))

  empty-as-chapter : Integer, AChapter -> AChapter
  empty-as-chapter (b) (ch) = AChapter {
   name = copy-as-name b (ch.name),
   defs = [],
   type-defs = [],
   effect-defs = [],
   class-defs = [],
   instance-defs = [],
   citations = [],
   ground-effects = [],
   chapter-title = "",
   prose = "",
   prose-blocks = [],
   annotations = [],
   section-titles = [],
   rt-names = [],
   rt-budgets = [],
   conversions = [],
   span = copy-sx-span b (ch.span)
  }

  copy-as-chapter-guarded : Integer, Integer, AChapter -> GuardedChapterCopy
  copy-as-chapter-guarded (b) (ceiling) (ch) =
   let defs2 = copy-as-defs-guarded b ceiling (ch.defs) 0 (list-length (ch.defs)) []
   in let tds2 = copy-as-typedefs-guarded b ceiling (ch.type-defs) 0 (list-length (ch.type-defs)) []
   in let pbs2 = copy-as-proseblocks-guarded b ceiling (ch.prose-blocks) 0 (list-length (ch.prose-blocks)) []
   in let anns2 = copy-as-annotations-guarded b ceiling (ch.annotations) 0 (list-length (ch.annotations)) []
   in if __heap-save >= ceiling
      then GuardedChapterCopy { chapter = empty-as-chapter b ch, sat = 1 }
      else GuardedChapterCopy { chapter = AChapter {
       name = copy-as-name b (ch.name),
       defs = defs2,
       type-defs = tds2,
       effect-defs = for e in (ch.effect-defs) -> copy-as-effectdef b e,
       class-defs = for c in (ch.class-defs) -> copy-as-classdef b c,
       instance-defs = for i in (ch.instance-defs) -> copy-as-instancedef b i,
       citations = for c in (ch.citations) -> copy-as-citesdecl b c,
       ground-effects = copy-sx-texts b (ch.ground-effects),
       chapter-title = copy-sx-text b (ch.chapter-title),
       prose = copy-sx-text b (ch.prose),
       prose-blocks = pbs2,
       annotations = anns2,
       section-titles = copy-sx-texts b (ch.section-titles),
       rt-names = copy-sx-texts b (ch.rt-names),
       rt-budgets = for x in (ch.rt-budgets) -> x,
       conversions = copy-sx-texts b (ch.conversions),
       span = copy-sx-span b (ch.span)
      }, sat = 0 }

Page 1


Chapter: Parsmi--Desugarer
  cites Codex chapter Build Settings (max-recursion-depth, demand-desugar-guard-band)
  cites Codex chapter Phase Allocator (deck-short-of)

Section: Span Helpers
  token-span : Token -> SourceSpan
  token-span (tok) =
   span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id)

  desugared-span : SourceSpan -> SourceSpan
  desugared-span (s) =
   span-with-provenance s ProvDesugared

Section: Expression Desugaring
  desugar-expr : Expr -> AExpr
  desugar-expr (node) = desugar-expr-at node 0

  desugar-expr-at : Expr, Integer -> AExpr
  desugar-expr-at (node) (depth) =
   if depth >= max-recursion-depth then subj-deck-record (AErrorExpr "desugar fuel exhausted" synthetic-span)
   else when node
    is LitExpr (tok) -> desugar-literal tok
    is NameExpr (tok) -> subj-deck-record (ANameExpr (make-name (token-text tok)) (token-span tok))
    is AppExpr (f) (a) ->
     let df = desugar-expr-at f (depth + 1)
     in let da = desugar-expr-at a (depth + 1)
     in subj-deck-record (AApplyExpr df da (desugared-span (aexpr-span df)))
    is BinExpr (l) (op) (r) ->
     let dl = desugar-expr-at l (depth + 1)
     in let dr = desugar-expr-at r (depth + 1)
     in if is-pipe-forward (op.kind) then subj-deck-record (AApplyExpr dr dl (desugared-span (token-span op)))
     else subj-deck-record (ABinaryExpr dl (desugar-bin-op (op.kind)) dr (token-span op))
    is UnaryExpr (op) (operand) -> subj-deck-record (AUnaryExpr (desugar-expr-at operand (depth + 1)) (token-span op))
    is IfExpr (c) (t) (e) ->
     let dc = desugar-expr-at c (depth + 1)
     in subj-deck-record (AIfExpr dc (desugar-expr-at t (depth + 1)) (desugar-expr-at e (depth + 1)) (desugared-span (aexpr-span dc)))
    is LetExpr (bindings) (body) ->
     let db = desugar-expr-at body (depth + 1)
     in subj-deck-record (ALetExpr (map-list desugar-let-bind bindings) db (desugared-span (aexpr-span db)))
    is MatchExpr (scrut) (arms) ->
     let ds = desugar-expr-at scrut (depth + 1)
     in subj-deck-record (AMatchExpr ds (map-list desugar-match-arm arms) (desugared-span (aexpr-span ds)))
    is ListExpr (elems) (sp) -> subj-deck-record (AListExpr (map-list desugar-expr elems) sp)
    is RecordExpr (type-tok) (fields) -> subj-deck-record (ARecordExpr (make-name (token-text type-tok)) (map-list desugar-field-expr fields) (token-span type-tok))
    is FieldExpr (rec) (field-tok) -> subj-deck-record (AFieldAccess (desugar-expr-at rec (depth + 1)) (make-name (token-text field-tok)) (token-span field-tok))
    is ParenExpr (inner) -> desugar-expr-at inner (depth + 1)
    is TupleExpr (elems) -> apply-aexpr-args (subj-deck-record (ANameExpr (make-name ("MkTup" & integer-to-text (list-length elems))) synthetic-span)) (map-list desugar-expr elems) 0 (list-length elems)
    is ActExpr (stmts) -> let ds = map-list desugar-act-stmt stmts in subj-deck-record (AActExpr ds (act-stmts-span ds))
    is HandleExpr (eff-tok) (body) (clauses) -> subj-deck-record (AHandleExpr (make-name (token-text eff-tok)) (desugar-expr-at body (depth + 1)) (map-list desugar-handle-clause clauses) (token-span eff-tok))
    is WithTimeoutExpr (timeout-tok) (effs) (scopes) (body) -> subj-deck-record (AWithTimeoutExpr (token-text timeout-tok) (map-list make-type-param-name effs) (map-list extract-scope-text scopes) (desugar-expr-at body (depth + 1)) (token-span timeout-tok))
    is LambdaExpr (params) (body) -> subj-deck-record (ALambdaExpr (map-list desugar-lambda-param params) (desugar-expr-at body (depth + 1)) synthetic-span)
    is TryExpr (count-tok) (body) (fb) (fail) -> subj-deck-record (ATryExpr (lit-text-to-integer (token-text count-tok)) (map-list desugar-act-stmt body) (map-list desugar-act-stmt fb) (map-list desugar-act-stmt fail) (token-span count-tok))
    is FieldAssignExpr (lhs) (field-tok) (rhs) ->
     let dr = desugar-expr-at rhs (depth + 1)
     in when lhs
      is FieldExpr (rec) (ftok) -> subj-deck-record (AFieldAssignExpr (desugar-expr-at rec (depth + 1)) (make-name (token-text field-tok)) dr (token-span field-tok))
      is otherwise -> subj-deck-record (AFieldAssignExpr (desugar-expr-at lhs (depth + 1)) (make-name (token-text field-tok)) dr (token-span field-tok))
    is SeqExpr (stmt) (rest) ->
     let ds = desugar-expr-at stmt (depth + 1)
     in let dr = desugar-expr-at rest (depth + 1)
     in subj-deck-record (ALetExpr [subj-deck-record (ALetBind { name = make-name "__seq", value = ds, span = aexpr-span ds })] dr (desugared-span (aexpr-span dr)))
    is RevisedExpr (base) (fields) ->
     let dbase = desugar-expr-at base (depth + 1)
     in let rev-name = make-name "__rev"
     in let rev-ref = subj-deck-record (ANameExpr rev-name synthetic-span)
     in let rev-vals = desugar-revised-vals fields 0 (depth + 1)
     in let rev-chain = desugar-revised-chain rev-ref fields 0 (list-length fields)
     in let bind-vals = desugar-revised-val-binds rev-vals rev-chain 0 (list-length rev-vals)
     in subj-deck-record (ALetExpr [subj-deck-record (ALetBind { name = rev-name, value = dbase, span = synthetic-span })] bind-vals (desugared-span synthetic-span))
    is LazyExpr (inner) -> subj-deck-record (ALazyExpr (desugar-expr-at inner (depth + 1)) synthetic-span)
    is ForExpr (var-tok) (list-expr) (body) ->
     let dlist = desugar-expr-at list-expr (depth + 1)
     in let dbody = desugar-expr-at body (depth + 1)
     in let lam = subj-deck-record (ALambdaExpr [make-name (token-text var-tok)] dbody synthetic-span)
     in let map-fn = subj-deck-record (ANameExpr (make-name "map-list") synthetic-span)
     in subj-deck-record (AApplyExpr (subj-deck-record (AApplyExpr map-fn lam synthetic-span)) dlist synthetic-span)
    is ErrExpr (tok) -> subj-deck-record (AErrorExpr (token-text tok) (token-span tok))
    is InductionExpr (scrut) (arms) ->
     let ds = desugar-expr-at scrut (depth + 1)
     in subj-deck-record (AInductionExpr ds (map-list desugar-match-arm arms) (desugared-span (aexpr-span ds)))

  apply-aexpr-args : AExpr, List AExpr, Integer, Integer -> AExpr
  apply-aexpr-args (f) (args) (i) (len) =
   if i >= len then f
   else apply-aexpr-args (subj-deck-record (AApplyExpr f (list-at args i) (desugared-span (aexpr-span f)))) args (i + 1) len

  literal-body-length : Token -> Integer
  literal-body-length (tok) =
   if tok.length < 2 then 0 else tok.length - 2

  decode-char-literal-value : Token -> Text
  decode-char-literal-value (tok) =
   let body-off = tok.offset + 1
   in let body-len = literal-body-length tok
   in if body-len <= 0 then "0"
      else let c0 = char-code-at (tok.source) body-off
      in if c0 == cc-backslash then if body-len < 2 then integer-to-text c0
            else let nc = char-code-at (tok.source) (body-off + 1)
            in let val = if nc == cc-lower-n then cc-newline
                  else if nc == cc-lower-t then cc-space
                  else if nc == cc-lower-r then cc-newline
                  else if nc == cc-backslash then cc-backslash
                  else if nc == cc-single-quote then cc-single-quote
                  else nc
            in integer-to-text val
         else integer-to-text c0

  literal-value-text : Token -> Text
  literal-value-text (tok) =
   when tok.kind
    is TextLiteral -> decode-escapes (substring (tok.source) (tok.offset + 1) (literal-body-length tok))
    is CharLiteral -> decode-char-literal-value tok
    is otherwise -> token-text tok

  desugar-literal : Token -> AExpr
  desugar-literal (tok) =
   if is-literal (tok.kind) then subj-deck-record (ALitExpr (literal-value-text tok) (classify-literal (tok.kind)) (token-span tok))
   else subj-deck-record (AErrorExpr (token-text tok) (token-span tok))

  classify-literal : TokenKind -> LiteralKind
  classify-literal (k) =
   when k
    is IntegerLiteral -> IntLit
    is NumberLiteral -> NumLit
    is TextLiteral -> TextLit
    is CharLiteral -> CharLit
    is TrueKeyword | FalseKeyword -> BoolLit
    is otherwise -> TextLit

  desugar-let-bind : LetBind -> ALetBind
  desugar-let-bind (b) =
   subj-deck-record (ALetBind {
    name = make-name (token-text (b.name)),
    value = desugar-expr (b.value),
    span = token-span (b.name)
   })

  desugar-match-arm : MatchArm -> AMatchArm
  desugar-match-arm (arm) =
   let dp = desugar-pattern (arm.pattern)
   in subj-deck-record (AMatchArm {
    pattern = dp,
    body = desugar-expr (arm.body),
    guard = desugar-expr (arm.guard),
    span = apat-span dp,
    alt-group = arm.alt-group
   })

  desugar-field-expr : RecordFieldExpr -> AFieldExpr
  desugar-field-expr (f) =
   subj-deck-record (AFieldExpr {
    name = make-name (token-text (f.name)),
    value = desugar-expr (f.value),
    span = token-span (f.name)
   })

  is-narrow-app : Expr -> Boolean
  is-narrow-app (e) =
   when e
    is AppExpr (f) (a) ->
     when f
      is NameExpr (t) -> token-text t == "__narrow"
      is otherwise -> False
    is otherwise -> False

  narrow-app-arg : Expr -> Expr
  narrow-app-arg (e) =
   when e
    is AppExpr (f) (a) -> a
    is otherwise -> e

  desugar-revised-vals : List RecordFieldExpr, Integer, Integer -> List AExpr
  desugar-revised-vals (fields) (i) (depth) =
   if i >= list-length fields then []
   else let f = list-at fields i
     in let hoisted = if is-narrow-app (f.value) then narrow-app-arg (f.value) else f.value
     in [desugar-expr-at hoisted depth] & desugar-revised-vals fields (i + 1) depth

  desugar-revised-chain : AExpr, List RecordFieldExpr, Integer, Integer -> AExpr
  desugar-revised-chain (acc) (fields) (i) (len) =
   if i >= len then acc
   else let f = list-at fields i
     in let val-name = make-name ("__rv" & integer-to-text i)
     in let raw-ref = subj-deck-record (ANameExpr val-name synthetic-span)
     in let val-ref = if is-narrow-app (f.value)
        then subj-deck-record (AApplyExpr (subj-deck-record (ANameExpr (make-name "__narrow") synthetic-span)) raw-ref synthetic-span)
        else raw-ref
     in let field-text = token-text (f.name)
     in let rs = subj-deck-record (ANameExpr (make-name "__record-set") synthetic-span)
     in let a1 = subj-deck-record (AApplyExpr rs acc synthetic-span)
     in let a2 = subj-deck-record (AApplyExpr a1 (subj-deck-record (ALitExpr field-text TextLit synthetic-span)) synthetic-span)
     in let a3 = subj-deck-record (AApplyExpr a2 val-ref synthetic-span)
     in desugar-revised-chain a3 fields (i + 1) len

  desugar-revised-val-binds : List AExpr, AExpr, Integer, Integer -> AExpr
  desugar-revised-val-binds (vals) (body) (i) (len) =
   if i >= len then body
   else let val-name = make-name ("__rv" & integer-to-text i)
     in let val-expr = list-at vals i
     in let rest = desugar-revised-val-binds vals body (i + 1) len
     in subj-deck-record (ALetExpr [subj-deck-record (ALetBind { name = val-name, value = val-expr, span = synthetic-span })] rest (desugared-span synthetic-span))

  desugar-act-stmt : ActStmt -> AActStmt
  desugar-act-stmt (s) =
   when s
    is ActBindStmt (tok) (val) -> subj-deck-record (AActBindStmt (make-name (token-text tok)) (desugar-expr val) (token-span tok))
    is ActExprStmt (e) ->
     let de = desugar-expr e
     in subj-deck-record (AActExprStmt de (aexpr-span de))

  act-stmts-span : List AActStmt -> SourceSpan
  act-stmts-span (ss) =
   if list-length ss == 0 then synthetic-span
   else when list-at ss 0
    is AActBindStmt (n) (e) (sp) -> sp
    is AActExprStmt (e) (sp) -> sp

  desugar-handle-clause : HandleClause -> AHandleClause
  desugar-handle-clause (c) =
   subj-deck-record (AHandleClause {
    op-name = make-name (token-text (c.op-name)),
    params = for p in (c.params) -> make-name (token-text p),
    resume-name = make-name (token-text (c.resume-name)),
    body = desugar-expr (c.body),
    span = token-span (c.op-name)
   })

  desugar-lambda-param : Token -> Name
  desugar-lambda-param (tok) =
   make-name (token-text tok)

Section: Binary Operator Desugaring
  desugar-bin-op : TokenKind -> BinaryOp
  desugar-bin-op (k) =
   when k
    is Plus -> OpAdd
    is Minus -> OpSub
    is Star -> OpMul
    is Slash -> OpDiv
    is Caret -> OpPow
    is DoubleEquals -> OpEq
    is NotEquals -> OpNotEq
    is LessThan -> OpLt
    is GreaterThan -> OpGt
    is LessOrEqual -> OpLtEq
    is GreaterOrEqual -> OpGtEq
    is TripleEquals -> OpDefEq
    is ColonColon -> OpCons
    is Ampersand -> OpAnd
    is Pipe -> OpOr
    is Tilde -> OpApproxEq
    is TildeZero -> OpApproxEqExact
    is otherwise -> OpAdd

Section: Pattern Desugaring
  apat-span : APat -> SourceSpan
  apat-span (p) =
   when p
    is AVarPat (n) (s) | ALitPat (t) (k) (s) | ACtorPat (n) (sub) (s) | AWildPat (s) | AVecPat (sub) (s) -> s

  desugar-pattern : Pat -> APat
  desugar-pattern (p) = desugar-pattern-at p 0

  desugar-pattern-at : Pat, Integer -> APat
  desugar-pattern-at (p) (depth) =
   if depth >= max-recursion-depth then subj-deck-record (AWildPat synthetic-span)
   else when p
    is VarPat (tok) -> subj-deck-record (AVarPat (make-name (token-text tok)) (token-span tok))
    is LitPat (tok) -> subj-deck-record (ALitPat (literal-value-text tok) (classify-literal (tok.kind)) (token-span tok))
    is CtorPat (tok) (subs) -> subj-deck-record (ACtorPat (make-name (token-text tok)) (map-list desugar-pattern subs) (token-span tok))
    is WildPat (tok) -> subj-deck-record (AWildPat (token-span tok))
    is VecPat (pats) -> subj-deck-record (AVecPat (for p in pats -> desugar-pattern p) synthetic-span)
    is TuplePat (pats) -> subj-deck-record (ACtorPat (make-name ("MkTup" & integer-to-text (list-length pats))) (map-list desugar-pattern pats) synthetic-span)

Section: Type Desugaring
  desugar-type-expr : TypeExpr -> ATypeExpr
  desugar-type-expr (t) = desugar-type-expr-at t 0

  desugar-type-expr-at : TypeExpr, Integer -> ATypeExpr
  desugar-type-expr-at (t) (depth) =
   if depth >= max-recursion-depth then subj-deck-record (ANamedType (make-name "_fuel") synthetic-span)
   else when t
    is NamedType (tok) -> subj-deck-record (ANamedType (make-name (token-text tok)) (token-span tok))
    is FunType (param) (ret) ->
     let dp = desugar-type-expr-at param (depth + 1)
     in subj-deck-record (AFunType dp (desugar-type-expr-at ret (depth + 1)) (atype-span dp))
    is AppType (ctor) (args) ->
     let dc = desugar-type-expr-at ctor (depth + 1)
     in subj-deck-record (AAppType dc (map-list desugar-type-expr args) (atype-span dc))
    is ParenType (inner) -> desugar-type-expr-at inner (depth + 1)
    is ListType (elem) ->
     let de = desugar-type-expr-at elem (depth + 1)
     in subj-deck-record (AAppType (subj-deck-record (ANamedType (make-name "List") (atype-span de))) [de] (atype-span de))
    is LinearTypeExpr (inner) ->
     let di = desugar-type-expr-at inner (depth + 1)
     in subj-deck-record (ALinearType di (atype-span di))
    is EffectTypeExpr (effs) (scopes) (tail) (ret) ->
     let dr = desugar-type-expr-at ret (depth + 1)
     in subj-deck-record (AEffectType (map-list make-type-param-name effs) (map-list extract-scope-text scopes) (map-list make-type-param-name tail) dr (atype-span dr))
    is BoundedIntType (base) (lo) (hi) (mode) ->
     let db = desugar-type-expr-at base (depth + 1)
     in subj-deck-record (ABoundedIntType db lo hi mode (atype-span db))
    is PropEqType (left) (right) (sp) ->
     let dl = desugar-type-expr-at left (depth + 1)
     in let dr = desugar-type-expr-at right (depth + 1)
     in subj-deck-record (APropEqType dl dr sp)
    is ConstrainedType (constraint) (body) ->
     let db = desugar-type-expr-at body (depth + 1)
     in desugar-constraint constraint db
    is TupleType (elems) ->
     let de-elems = map-list desugar-type-expr elems
     in make-atuple-type de-elems (list-length de-elems)
    is ForAllType (var-tok) (var-ty) (prop) ->
     let dv = desugar-type-expr-at var-ty (depth + 1)
     in subj-deck-record (AForallType (make-name (token-text var-tok)) dv (desugar-type-expr-at prop (depth + 1)) (token-span var-tok))

  make-atuple-type : List ATypeExpr, Integer -> ATypeExpr
  make-atuple-type (elems) (n) =
   let base = subj-deck-record (ANamedType (make-name ("Tup" & integer-to-text n)) synthetic-span)
   in apply-atype-args base elems 0 n

  apply-atype-args : ATypeExpr, List ATypeExpr, Integer, Integer -> ATypeExpr
  apply-atype-args (base) (elems) (i) (n) =
   if i == n then base
   else apply-atype-args (subj-deck-record (AAppType base [list-at elems i] synthetic-span)) elems (i + 1) n

  desugar-constraint : TypeExpr, ATypeExpr -> ATypeExpr
  desugar-constraint (constraint) (body) =
   when constraint
    is AppType (ctor) (args) ->
     when ctor
      is NamedType (class-tok) ->
       if list-length args >= 1
        then when (list-at args 0)
         is NamedType (var-tok) -> subj-deck-record (AConstrainedType (make-name (token-text class-tok)) (make-name (token-text var-tok)) body synthetic-span)
         is otherwise -> body
        else body
      is otherwise -> body
    is otherwise -> body

  atype-span : ATypeExpr -> SourceSpan
  atype-span (t) =
   when t
    is ANamedType (n) (s) | AFunType (p) (r) (s) | AAppType (c) (args) (s) | AEffectType (effs) (scopes) (tail) (r) (s) | ABoundedIntType (b) (lo) (hi) (mode) (s) | APropEqType (l) (r) (s) | AConstrainedType (cn) (cv) (body) (s) | ALinearType (inner) (s) | AForallType (v) (vt) (p) (s) -> s

Section: Definition Desugaring
  desugar-def : Def -> ADef
  desugar-def (d) =
   let ann-types = desugar-annotations (d.ann)
   in subj-deck-record (ADef {
    name = make-name (token-text (d.name)),
    params = map-list desugar-param (d.params),
    declared-type = ann-types,
    body = desugar-expr (d.body),
    chapter-slug = d.chapter-slug,
    span = token-span (d.name)
   })

  desugar-annotations : List TypeAnn -> List ATypeExpr
  desugar-annotations (anns) =
   if list-length anns == 0 then []
   else let a = list-at anns 0
   in subj-deck-record [desugar-type-expr (a.type-expr)]

  desugar-param : Token -> AParam
  desugar-param (tok) =
   subj-deck-record (AParam { name = make-name (token-text tok), span = token-span tok })

  desugar-type-def : TypeDef -> ATypeDef
  desugar-type-def (td) =
   when td.body
    is RecordBody (fields) -> subj-deck-record (ARecordTypeDef (make-name (token-text (td.name))) (map-list make-type-param-name (td.type-params)) (map-list desugar-record-field-def fields) (td.is-mutable) (token-span (td.name)))
    is VariantBody (ctors) -> subj-deck-record (AVariantTypeDef (make-name (token-text (td.name))) (map-list make-type-param-name (td.type-params)) (map-list desugar-variant-ctor-def ctors) (token-span (td.name)))
    is UnitBody (base) -> subj-deck-record (AUnitTypeDef (make-name (token-text (td.name))) (desugar-type-expr base) (token-span (td.name)))
    is UnitFamilyBody (base-tok) (members) -> subj-deck-record (AUnitTypeDef (make-name (token-text (td.name))) (subj-deck-record (ANamedType (make-name "Integer") synthetic-span)) (token-span (td.name)))

  desugar-family-as-unit-body : UnitFamilyMember -> TypeBody
  desugar-family-as-unit-body (m) = UnitBody (subj-deck-record (NamedType (m.member-name)))

  make-type-param-name : Token -> Name
  make-type-param-name (tok) =
   make-name (token-text tok)

  extract-scope-text : Token -> Text
  extract-scope-text (tok) =
   let raw = token-text tok
   in let len = text-length raw
   in if len >= 2 then substring raw 1 (len - 2)
      else ""

  desugar-record-field-def : RecordFieldDef -> ARecordFieldDef
  desugar-record-field-def (f) =
   subj-deck-record (ARecordFieldDef {
    name = make-name (token-text (f.name)),
    type-expr = desugar-type-expr (f.type-expr),
    span = token-span (f.name)
   })

  desugar-variant-ctor-def : VariantCtorDef -> AVariantCtorDef
  desugar-variant-ctor-def (c) =
   subj-deck-record (AVariantCtorDef {
    name = make-name (token-text (c.name)),
    fields = map-list desugar-type-expr (c.fields),
    return-type = map-list desugar-type-expr (c.return-type),
    span = token-span (c.name)
   })

Section: Document Desugaring

  desugar-defs-ll : List Def, Integer, Integer, LinkedList ADef, Integer -> LinkedList ADef
  desugar-defs-ll (src) (i) (len) (acc) (ceiling) =
   if i >= len then acc
   else if deck-out-of-room ceiling then acc
   else desugar-defs-ll src (i + 1) len (__linked-list-push acc (desugar-def (list-at src i))) ceiling

  desugar-type-defs-ll : List TypeDef, Integer, Integer, LinkedList ATypeDef, Integer -> LinkedList ATypeDef
  desugar-type-defs-ll (src) (i) (len) (acc) (ceiling) =
   if i >= len then acc
   else if deck-out-of-room ceiling then acc
   else desugar-type-defs-ll src (i + 1) len (__linked-list-push acc (desugar-type-def (list-at src i))) ceiling

  desugar-effect-defs-ll : List EffectDef, Integer, Integer, LinkedList AEffectDef -> LinkedList AEffectDef
  desugar-effect-defs-ll (src) (i) (len) (acc) =
   if i >= len then acc
   else desugar-effect-defs-ll src (i + 1) len (__linked-list-push acc (desugar-effect-def (list-at src i)))

  desugar-cites-ll : List CitesDecl, Integer, Integer, LinkedList ACitesDecl -> LinkedList ACitesDecl
  desugar-cites-ll (src) (i) (len) (acc) =
   if i >= len then acc
   else desugar-cites-ll src (i + 1) len (__linked-list-push acc (desugar-cite (list-at src i)))

  collect-rt-names : List AnnotationNode, Integer, Integer, List Text -> List Text
  collect-rt-names (anns) (i) (len) (acc) =
   if i >= len then acc
   else let a = list-at anns i
   in if a.kind == "hard-realtime" then collect-rt-names anns (i + 1) len (list-push acc (a.target))
   else collect-rt-names anns (i + 1) len acc

  parse-rt-budget : Text -> Integer
  parse-rt-budget (body) =
   if text-length body == 0 then 0
   else let sp = find-space body 0 (text-length body)
   in if sp == text-length body then text-to-integer body
   else text-to-integer (substring body 0 sp)

  find-space : Text, Integer, Integer -> Integer
  find-space (t) (i) (len) =
   if i >= len then len
   else if char-code-at t i == char-code ' ' then i
   else find-space t (i + 1) len

  collect-rt-budgets : List AnnotationNode, Integer, Integer, List Integer -> List Integer
  collect-rt-budgets (anns) (i) (len) (acc) =
   if i >= len then acc
   else let a = list-at anns i
   in if a.kind == "hard-realtime" then collect-rt-budgets anns (i + 1) len (list-push acc (parse-rt-budget (a.body)))
   else collect-rt-budgets anns (i + 1) len acc

  collect-conversions : List AnnotationNode, Integer, Integer, List Text -> List Text
  collect-conversions (anns) (i) (len) (acc) =
   if i >= len then acc
   else let a = list-at anns i
   in if a.kind == "conversion" then collect-conversions anns (i + 1) len (list-push acc (a.target & " " & a.body))
   else collect-conversions anns (i + 1) len acc

  synth-conversion-defs : List AnnotationNode, Integer, Integer, LinkedList ADef -> LinkedList ADef
  synth-conversion-defs (anns) (i) (len) (acc) =
   if i >= len then acc
   else let a = list-at anns i
   in if a.kind == "conversion" then synth-conversion-defs anns (i + 1) len (synth-one-conversion (a.target) (a.body) acc)
   else synth-conversion-defs anns (i + 1) len acc

  synth-one-conversion : Text, Text, LinkedList ADef -> LinkedList ADef
  synth-one-conversion (from-unit) (body) (acc) =
   let sp = find-space body 0 (text-length body)
   in if sp >= text-length body then acc
   else let factor-text = substring body 0 sp
   in let to-unit = substring body (sp + 1) (text-length body - sp - 1)
   in let pname = make-name "__cv"
   in let fname = make-name (from-unit & "-to-" & to-unit)
   in let from-ty = subj-deck-record (ANamedType (make-name from-unit) synthetic-span)
   in let to-ty = subj-deck-record (ANamedType (make-name to-unit) synthetic-span)
   in let sig = subj-deck-record (AFunType from-ty to-ty synthetic-span)
   in let mul-expr = subj-deck-record (ABinaryExpr (subj-deck-record (ANameExpr pname synthetic-span)) OpMul (subj-deck-record (ALitExpr factor-text IntLit synthetic-span)) synthetic-span)
   in let ctor-call = subj-deck-record (AApplyExpr (subj-deck-record (ANameExpr (make-name to-unit) synthetic-span)) mul-expr synthetic-span)
   in let fwd-def = subj-deck-record (ADef {
    name = fname,
    params = [subj-deck-record (AParam { name = pname, span = synthetic-span })],
    declared-type = [sig],
    body = ctor-call,
    chapter-slug = "",
    span = synthetic-span
   })
   in __linked-list-push acc fwd-def

  synth-family-member-defs : List TypeDef, Integer, Integer, LinkedList ADef -> LinkedList ADef
  synth-family-member-defs (tds) (i) (len) (acc) =
   if i >= len then acc
   else let td = list-at tds i
   in when td.body
    is UnitFamilyBody (base-tok) (members) -> synth-family-member-defs tds (i + 1) len (synth-family-members (token-text (td.name)) members 0 (list-length members) acc)
    is otherwise -> synth-family-member-defs tds (i + 1) len acc

  synth-family-members : Text, List UnitFamilyMember, Integer, Integer, LinkedList ADef -> LinkedList ADef
  synth-family-members (family-name) (members) (i) (len) (acc) =
   if i >= len then acc
   else let m = list-at members i
   in let member-name = token-text (m.member-name)
   in let acc2 = synth-family-ctor family-name member-name (m.factor) acc
   in let acc3 = synth-family-extract family-name member-name (m.factor) acc2
   in synth-family-members family-name members (i + 1) len acc3

  synth-family-ctor : Text, Text, Integer, LinkedList ADef -> LinkedList ADef
  synth-family-ctor (family-name) (member-name) (factor) (acc) =
   let pname = make-name "__fv"
   in let fname = make-name member-name
   in let family-ty = subj-deck-record (ANamedType (make-name family-name) synthetic-span)
   in let int-ty = subj-deck-record (ANamedType (make-name "Integer") synthetic-span)
   in let sig = subj-deck-record (AFunType int-ty family-ty synthetic-span)
   in let body = if factor == 1 then subj-deck-record (AApplyExpr (subj-deck-record (ANameExpr (make-name family-name) synthetic-span)) (subj-deck-record (ANameExpr pname synthetic-span)) synthetic-span)
     else let mul = subj-deck-record (ABinaryExpr (subj-deck-record (ANameExpr pname synthetic-span)) OpMul (subj-deck-record (ALitExpr (integer-to-text factor) IntLit synthetic-span)) synthetic-span)
     in subj-deck-record (AApplyExpr (subj-deck-record (ANameExpr (make-name family-name) synthetic-span)) mul synthetic-span)
   in __linked-list-push acc (subj-deck-record (ADef {
    name = fname,
    params = [subj-deck-record (AParam { name = pname, span = synthetic-span })],
    declared-type = [sig],
    body = body,
    chapter-slug = "",
    span = synthetic-span
   }))

  synth-family-extract : Text, Text, Integer, LinkedList ADef -> LinkedList ADef
  synth-family-extract (family-name) (member-name) (factor) (acc) =
   let pname = make-name "__fv"
   in let fname = make-name (family-name & "-to-" & member-name)
   in let family-ty = subj-deck-record (ANamedType (make-name family-name) synthetic-span)
   in let int-ty = subj-deck-record (ANamedType (make-name "Integer") synthetic-span)
   in let sig = subj-deck-record (AFunType family-ty int-ty synthetic-span)
   in let body = if factor == 1 then subj-deck-record (ANameExpr pname synthetic-span)
     else subj-deck-record (ABinaryExpr (subj-deck-record (ANameExpr pname synthetic-span)) OpDiv (subj-deck-record (ALitExpr (integer-to-text factor) IntLit synthetic-span)) synthetic-span)
   in __linked-list-push acc (subj-deck-record (ADef {
    name = fname,
    params = [subj-deck-record (AParam { name = pname, span = synthetic-span })],
    declared-type = [sig],
    body = body,
    chapter-slug = "",
    span = synthetic-span
   }))

  deck-out-of-room : Integer -> Boolean
  deck-out-of-room (ceiling) = deck-short-of ceiling demand-desugar-guard-band

  DesugarResult = record {
   dr-chapter : AChapter,
   dr-sat : Integer
  }

  empty-achapter : Text -> AChapter
  empty-achapter (chapter-name) =
   subj-deck-record (AChapter {
    name = make-name chapter-name,
    defs = [],
    type-defs = [],
    effect-defs = [],
    class-defs = [],
    instance-defs = [],
    citations = [],
    ground-effects = [],
    chapter-title = "",
    prose = "",
    prose-blocks = [],
    annotations = [],
    section-titles = [],
    rt-names = [],
    rt-budgets = [],
    conversions = [],
    span = synthetic-span
   })

  desugar-document : Text, Document, Text, Integer -> DesugarResult
  desugar-document (source) (doc) (chapter-name) (ceiling) =
   let raw-defs0 = desugar-defs-ll (doc.defs) 0 (list-length (doc.defs)) [] ceiling
   in let raw-defs-fam = synth-family-member-defs (doc.type-defs) 0 (list-length (doc.type-defs)) raw-defs0
   in let raw-defs-conv = synth-conversion-defs (doc.annotations) 0 (list-length (doc.annotations)) raw-defs-fam
   in let raw-defs = synth-derived-defs (doc.type-defs) 0 (list-length (doc.type-defs)) raw-defs-conv
   in let raw-tds = desugar-type-defs-ll (doc.type-defs) 0 (list-length (doc.type-defs)) [] ceiling
   in let raw-eds = desugar-effect-defs-ll (doc.effect-defs) 0 (list-length (doc.effect-defs)) []
   in let raw-cites = desugar-cites-ll (doc.citations) 0 (list-length (doc.citations)) []
   in let class-tds = synth-class-type-defs (doc.class-defs) (doc.instance-defs) 0 (list-length (doc.class-defs)) raw-tds
   in let inst-defs = synth-instance-defs (doc.class-defs) (doc.instance-defs) 0 (list-length (doc.instance-defs)) raw-defs
   in let all-defs = __linked-list-to-list inst-defs
   in let rewritten = rewrite-constrained-defs all-defs (doc.class-defs) (doc.instance-defs) 0 (list-length all-defs) [] ceiling
   in let constrained-info = collect-constrained-names all-defs (doc.class-defs) (doc.instance-defs) 0 (list-length all-defs) []
   in let base-defs = insert-dicts-at-call-sites rewritten constrained-info 0 (list-length rewritten) [] ceiling
   in if deck-out-of-room ceiling
      then subj-deck-record (DesugarResult { dr-chapter = empty-achapter chapter-name, dr-sat = 1 })
      else subj-deck-record (DesugarResult { dr-chapter = desugar-assemble doc chapter-name base-defs all-defs class-tds raw-eds raw-cites, dr-sat = 0 })

  desugar-assemble : Document, Text, List ADef, List ADef, LinkedList ATypeDef, LinkedList AEffectDef, LinkedList ACitesDecl -> AChapter
  desugar-assemble (doc) (chapter-name) (base-defs) (all-defs) (class-tds) (raw-eds) (raw-cites) =
   subj-deck-record (AChapter {
    name = make-name chapter-name,
    defs = subj-deck-record (prepend-prim-wrappers all-defs base-defs),
    type-defs = subj-deck-record (__linked-list-to-list class-tds),
    effect-defs = subj-deck-record (__linked-list-to-list raw-eds),
    class-defs = subj-deck-record (desugar-class-defs (doc.class-defs) 0 (list-length (doc.class-defs)) []),
    instance-defs = subj-deck-record (desugar-instance-defs (doc.instance-defs) 0 (list-length (doc.instance-defs)) []),
    citations = subj-deck-record (__linked-list-to-list raw-cites),
    ground-effects = doc.ground-effects,
    chapter-title = doc.chapter-title,
    prose = doc.prose,
    prose-blocks = doc.prose-blocks,
    annotations = doc.annotations,
    section-titles = doc.section-titles,
    rt-names = collect-rt-names (doc.annotations) 0 (list-length (doc.annotations)) [],
    rt-budgets = collect-rt-budgets (doc.annotations) 0 (list-length (doc.annotations)) [],
    conversions = collect-conversions (doc.annotations) 0 (list-length (doc.annotations)) [],
    span = synthetic-span
   })

  deriving-has : List Token, Text -> Boolean
  deriving-has (toks) (name) = deriving-has-loop toks 0 (list-length toks) name

  deriving-has-loop : List Token, Integer, Integer, Text -> Boolean
  deriving-has-loop (toks) (i) (len) (name) =
   if i >= len then False
   else if token-text (list-at toks i) == name then True
   else deriving-has-loop toks (i + 1) len name

  synth-derived-defs : List TypeDef, Integer, Integer, LinkedList ADef -> LinkedList ADef
  synth-derived-defs (tds) (i) (len) (acc) =
   if i >= len then acc
   else let td = list-at tds i
   in synth-derived-defs tds (i + 1) len (push-derived-for-type td acc)

  push-derived-for-type : TypeDef, LinkedList ADef -> LinkedList ADef
  push-derived-for-type (td) (acc) =
   let acc1 = if deriving-has (td.deriving) "Show" then __linked-list-push acc (gen-show-def td) else acc
   in let acc2 = if deriving-has (td.deriving) "Eq" then __linked-list-push acc1 (gen-eq-def td) else acc1
   in if deriving-has (td.deriving) "Ord" then __linked-list-push acc2 (gen-compare-def td) else acc2

  gen-wild-pats : Integer, Integer, LinkedList APat -> List APat
  gen-wild-pats (n) (i) (acc) =
   if i >= n then subj-deck-record (__linked-list-to-list acc)
   else gen-wild-pats n (i + 1) (__linked-list-push acc (subj-deck-record (AWildPat synthetic-span)))

  vars-to-exprs : List Name, Integer, Integer, LinkedList AExpr -> List AExpr
  vars-to-exprs (vars) (i) (len) (acc) =
   if i >= len then subj-deck-record (__linked-list-to-list acc)
   else vars-to-exprs vars (i + 1) len (__linked-list-push acc (subj-deck-record (ANameExpr (list-at vars i) synthetic-span)))

  rec-accessors : List RecordFieldDef, Name, Integer, Integer, LinkedList AExpr -> List AExpr
  rec-accessors (fields) (rn) (i) (len) (acc) =
   if i >= len then subj-deck-record (__linked-list-to-list acc)
   else rec-accessors fields rn (i + 1) len (__linked-list-push acc (subj-deck-record (AFieldAccess (subj-deck-record (ANameExpr rn synthetic-span)) (make-name (token-text (list-at fields i).name)) synthetic-span)))

  acompare-call : AExpr, AExpr -> AExpr
  acompare-call (lhs) (rhs) =
   subj-deck-record (AApplyExpr (subj-deck-record (AApplyExpr (subj-deck-record (ANameExpr (make-name "compare") synthetic-span)) lhs synthetic-span)) rhs synthetic-span)

  gen-cmp-lex : List AExpr, List AExpr, Integer, Integer -> AExpr
  gen-cmp-lex (lhss) (rhss) (i) (len) =
   if i >= len then subj-deck-record (ALitExpr "0" IntLit synthetic-span)
   else let ci = make-name ("__cc" & integer-to-text i)
   in let cmp = acompare-call (list-at lhss i) (list-at rhss i)
   in let rest = gen-cmp-lex lhss rhss (i + 1) len
   in subj-deck-record (ALetExpr [subj-deck-record (ALetBind { name = ci, value = cmp, span = synthetic-span })] (subj-deck-record (AIfExpr (subj-deck-record (ABinaryExpr (subj-deck-record (ANameExpr ci synthetic-span)) OpEq (subj-deck-record (ALitExpr "0" IntLit synthetic-span)) synthetic-span)) rest (subj-deck-record (ANameExpr ci synthetic-span)) synthetic-span)) synthetic-span)

  gen-compare-def : TypeDef -> ADef
  gen-compare-def (td) =
   let tname = token-text (td.name)
   in let xn = make-name "__cx"
   in let yn = make-name "__cy"
   in let tref = subj-deck-record (ANamedType (make-name tname) synthetic-span)
   in subj-deck-record (ADef {
    name = make-name ("__compare_" & tname),
    params = [subj-deck-record (AParam { name = xn, span = synthetic-span }), subj-deck-record (AParam { name = yn, span = synthetic-span })],
    declared-type = [subj-deck-record (AFunType tref (subj-deck-record (AFunType tref (subj-deck-record (ANamedType (make-name "Integer") synthetic-span)) synthetic-span)) synthetic-span)],
    body = gen-cmp-body (td.body) xn yn,
    chapter-slug = "",
    span = synthetic-span
   })

  gen-cmp-body : TypeBody, Name, Name -> AExpr
  gen-cmp-body (body) (xn) (yn) =
   when body
    is VariantBody (ctors) -> subj-deck-record (AMatchExpr (subj-deck-record (ANameExpr xn synthetic-span)) (gen-cmp-x-arms ctors yn 0 (list-length ctors) []) synthetic-span)
    is RecordBody (fields) -> gen-cmp-lex (rec-accessors fields xn 0 (list-length fields) []) (rec-accessors fields yn 0 (list-length fields) []) 0 (list-length fields)
    is UnitBody (base) -> subj-deck-record (AApplyExpr (subj-deck-record (ANameExpr (make-name "compare") synthetic-span)) (subj-deck-record (ANameExpr xn synthetic-span)) synthetic-span)
    is UnitFamilyBody (bt) (ms) -> subj-deck-record (AApplyExpr (subj-deck-record (ANameExpr (make-name "compare") synthetic-span)) (subj-deck-record (ANameExpr xn synthetic-span)) synthetic-span)

  gen-cmp-x-arms : List VariantCtorDef, Name, Integer, Integer, LinkedList AMatchArm -> List AMatchArm
  gen-cmp-x-arms (ctors) (yn) (i) (len) (acc) =
   if i >= len then subj-deck-record (__linked-list-to-list acc)
   else gen-cmp-x-arms ctors yn (i + 1) len (__linked-list-push acc (gen-cmp-x-arm ctors i yn))

  gen-cmp-x-arm : List VariantCtorDef, Integer, Name -> AMatchArm
  gen-cmp-x-arm (ctors) (i) (yn) =
   let c = list-at ctors i
   in let cname = token-text (c.name)
   in let xvars = gen-field-vars-pre "__cxf" (list-length (c.fields)) 0 []
   in subj-deck-record (AMatchArm {
    pattern = subj-deck-record (ACtorPat (make-name cname) (gen-var-pats xvars 0 (list-length xvars) []) synthetic-span),
    body = subj-deck-record (AMatchExpr (subj-deck-record (ANameExpr yn synthetic-span)) (gen-cmp-y-arms ctors i xvars 0 (list-length ctors) []) synthetic-span),
    guard = subj-deck-record (ALitExpr "True" BoolLit synthetic-span),
    span = synthetic-span,
    alt-group = -1
   })

  gen-cmp-y-arms : List VariantCtorDef, Integer, List Name, Integer, Integer, LinkedList AMatchArm -> List AMatchArm
  gen-cmp-y-arms (ctors) (i) (xvars) (j) (len) (acc) =
   if j >= len then subj-deck-record (__linked-list-to-list acc)
   else gen-cmp-y-arms ctors i xvars (j + 1) len (__linked-list-push acc (gen-cmp-y-arm ctors i xvars j))

  gen-cmp-y-arm : List VariantCtorDef, Integer, List Name, Integer -> AMatchArm
  gen-cmp-y-arm (ctors) (i) (xvars) (j) =
   let c = list-at ctors j
   in let cname = token-text (c.name)
   in let nf = list-length (c.fields)
   in if i == j then let yvars = gen-field-vars-pre "__cyf" nf 0 []
       in subj-deck-record (AMatchArm {
        pattern = subj-deck-record (ACtorPat (make-name cname) (gen-var-pats yvars 0 nf []) synthetic-span),
        body = gen-cmp-lex (vars-to-exprs xvars 0 (list-length xvars) []) (vars-to-exprs yvars 0 nf []) 0 nf,
        guard = subj-deck-record (ALitExpr "True" BoolLit synthetic-span),
        span = synthetic-span,
        alt-group = -1
       })
      else subj-deck-record (AMatchArm {
        pattern = subj-deck-record (ACtorPat (make-name cname) (gen-wild-pats nf 0 []) synthetic-span),
        body = if i < j then subj-deck-record (AUnaryExpr (subj-deck-record (ALitExpr "1" IntLit synthetic-span)) synthetic-span) else subj-deck-record (ALitExpr "1" IntLit synthetic-span),
        guard = subj-deck-record (ALitExpr "True" BoolLit synthetic-span),
        span = synthetic-span,
        alt-group = -1
       })

  gen-field-vars-pre : Text, Integer, Integer, LinkedList Name -> List Name
  gen-field-vars-pre (pre) (n) (i) (acc) =
   if i >= n then subj-deck-record (__linked-list-to-list acc)
   else gen-field-vars-pre pre n (i + 1) (__linked-list-push acc (make-name (pre & integer-to-text i)))

  gen-eq-def : TypeDef -> ADef
  gen-eq-def (td) =
   let tname = token-text (td.name)
   in let xn = make-name "__ex"
   in let yn = make-name "__ey"
   in let tref = subj-deck-record (ANamedType (make-name tname) synthetic-span)
   in subj-deck-record (ADef {
    name = make-name ("__eq_" & tname),
    params = [subj-deck-record (AParam { name = xn, span = synthetic-span }), subj-deck-record (AParam { name = yn, span = synthetic-span })],
    declared-type = [subj-deck-record (AFunType tref (subj-deck-record (AFunType tref (subj-deck-record (ANamedType (make-name "Boolean") synthetic-span)) synthetic-span)) synthetic-span)],
    body = gen-eq-body (td.body) xn yn,
    chapter-slug = "",
    span = synthetic-span
   })

  gen-eq-body : TypeBody, Name, Name -> AExpr
  gen-eq-body (body) (xn) (yn) =
   when body
    is VariantBody (ctors) -> subj-deck-record (AMatchExpr (subj-deck-record (ANameExpr xn synthetic-span)) (gen-eq-x-arms ctors yn 0 (list-length ctors) []) synthetic-span)
    is RecordBody (fields) -> gen-eq-record fields xn yn 1 (list-length fields) (gen-record-eq0 fields xn yn)
    is UnitBody (base) -> subj-deck-record (ABinaryExpr (subj-deck-record (ANameExpr xn synthetic-span)) OpEq (subj-deck-record (ANameExpr yn synthetic-span)) synthetic-span)
    is UnitFamilyBody (bt) (ms) -> subj-deck-record (ABinaryExpr (subj-deck-record (ANameExpr xn synthetic-span)) OpEq (subj-deck-record (ANameExpr yn synthetic-span)) synthetic-span)

  gen-eq-x-arms : List VariantCtorDef, Name, Integer, Integer, LinkedList AMatchArm -> List AMatchArm
  gen-eq-x-arms (ctors) (yn) (i) (len) (acc) =
   if i >= len then subj-deck-record (__linked-list-to-list acc)
   else gen-eq-x-arms ctors yn (i + 1) len (__linked-list-push acc (gen-eq-x-arm (list-at ctors i) yn))

  gen-eq-x-arm : VariantCtorDef, Name -> AMatchArm
  gen-eq-x-arm (c) (yn) =
   let cname = token-text (c.name)
   in let xvars = gen-field-vars-pre "__exf" (list-length (c.fields)) 0 []
   in subj-deck-record (AMatchArm {
    pattern = subj-deck-record (ACtorPat (make-name cname) (gen-var-pats xvars 0 (list-length xvars) []) synthetic-span),
    body = gen-eq-y-match cname xvars yn,
    guard = subj-deck-record (ALitExpr "True" BoolLit synthetic-span),
    span = synthetic-span,
    alt-group = -1
   })

  gen-eq-y-match : Text, List Name, Name -> AExpr
  gen-eq-y-match (cname) (xvars) (yn) =
   let yvars = gen-field-vars-pre "__eyf" (list-length xvars) 0 []
   in let match-arm = subj-deck-record (AMatchArm {
       pattern = subj-deck-record (ACtorPat (make-name cname) (gen-var-pats yvars 0 (list-length yvars) []) synthetic-span),
       body = gen-field-eq xvars yvars,
       guard = subj-deck-record (ALitExpr "True" BoolLit synthetic-span),
       span = synthetic-span,
       alt-group = -1
      })
   in let else-arm = subj-deck-record (AMatchArm {
       pattern = subj-deck-record (AWildPat synthetic-span),
       body = subj-deck-record (ALitExpr "False" BoolLit synthetic-span),
       guard = subj-deck-record (ALitExpr "True" BoolLit synthetic-span),
       span = synthetic-span,
       alt-group = -1
      })
   in subj-deck-record (AMatchExpr (subj-deck-record (ANameExpr yn synthetic-span)) [match-arm, else-arm] synthetic-span)

  gen-one-eq : AExpr, AExpr -> AExpr
  gen-one-eq (lhs) (rhs) = subj-deck-record (ABinaryExpr lhs OpEq rhs synthetic-span)

  gen-field-eq : List Name, List Name -> AExpr
  gen-field-eq (xvars) (yvars) =
   if list-length xvars == 0 then subj-deck-record (ALitExpr "True" BoolLit synthetic-span)
   else gen-field-eq-loop xvars yvars 1 (list-length xvars) (gen-one-eq (subj-deck-record (ANameExpr (list-at xvars 0) synthetic-span)) (subj-deck-record (ANameExpr (list-at yvars 0) synthetic-span)))

  gen-field-eq-loop : List Name, List Name, Integer, Integer, AExpr -> AExpr
  gen-field-eq-loop (xvars) (yvars) (i) (len) (acc) =
   if i >= len then acc
   else gen-field-eq-loop xvars yvars (i + 1) len (subj-deck-record (ABinaryExpr acc OpAnd (gen-one-eq (subj-deck-record (ANameExpr (list-at xvars i) synthetic-span)) (subj-deck-record (ANameExpr (list-at yvars i) synthetic-span))) synthetic-span))

  gen-record-eq0 : List RecordFieldDef, Name, Name -> AExpr
  gen-record-eq0 (fields) (xn) (yn) =
   if list-length fields == 0 then subj-deck-record (ALitExpr "True" BoolLit synthetic-span)
   else gen-one-field-eq (list-at fields 0) xn yn

  gen-eq-record : List RecordFieldDef, Name, Name, Integer, Integer, AExpr -> AExpr
  gen-eq-record (fields) (xn) (yn) (i) (len) (acc) =
   if i >= len then acc
   else gen-eq-record fields xn yn (i + 1) len (subj-deck-record (ABinaryExpr acc OpAnd (gen-one-field-eq (list-at fields i) xn yn) synthetic-span))

  gen-one-field-eq : RecordFieldDef, Name, Name -> AExpr
  gen-one-field-eq (f) (xn) (yn) =
   let fname = token-text (f.name)
   in gen-one-eq (subj-deck-record (AFieldAccess (subj-deck-record (ANameExpr xn synthetic-span)) (make-name fname) synthetic-span)) (subj-deck-record (AFieldAccess (subj-deck-record (ANameExpr yn synthetic-span)) (make-name fname) synthetic-span))

  gen-show-def : TypeDef -> ADef
  gen-show-def (td) =
   let pname = make-name "__sv"
   in subj-deck-record (ADef {
    name = make-name ("__show_" & token-text (td.name)),
    params = [subj-deck-record (AParam { name = pname, span = synthetic-span })],
    declared-type = [],
    body = gen-show-body (td.body) pname,
    chapter-slug = "",
    span = synthetic-span
   })

  gen-show-body : TypeBody, Name -> AExpr
  gen-show-body (body) (pname) =
   when body
    is VariantBody (ctors) -> subj-deck-record (AMatchExpr (subj-deck-record (ANameExpr pname synthetic-span)) (gen-show-arms ctors 0 (list-length ctors) []) synthetic-span)
    is RecordBody (fields) -> gen-show-record fields pname 0 (list-length fields) (subj-deck-record (ALitExpr "{" TextLit synthetic-span))
    is UnitBody (base) -> subj-deck-record (AApplyExpr (subj-deck-record (ANameExpr (make-name "show") synthetic-span)) (subj-deck-record (ANameExpr pname synthetic-span)) synthetic-span)
    is UnitFamilyBody (bt) (ms) -> subj-deck-record (AApplyExpr (subj-deck-record (ANameExpr (make-name "show") synthetic-span)) (subj-deck-record (ANameExpr pname synthetic-span)) synthetic-span)

  gen-show-arms : List VariantCtorDef, Integer, Integer, LinkedList AMatchArm -> List AMatchArm
  gen-show-arms (ctors) (i) (len) (acc) =
   if i >= len then subj-deck-record (__linked-list-to-list acc)
   else gen-show-arms ctors (i + 1) len (__linked-list-push acc (gen-show-arm (list-at ctors i)))

  gen-show-arm : VariantCtorDef -> AMatchArm
  gen-show-arm (c) =
   let cname = token-text (c.name)
   in let vars = gen-field-vars (list-length (c.fields)) 0 []
   in subj-deck-record (AMatchArm {
    pattern = subj-deck-record (ACtorPat (make-name cname) (gen-var-pats vars 0 (list-length vars) []) synthetic-span),
    body = gen-show-arm-body cname vars,
    guard = subj-deck-record (ALitExpr "True" BoolLit synthetic-span),
    span = synthetic-span,
    alt-group = -1
   })

  gen-field-vars : Integer, Integer, LinkedList Name -> List Name
  gen-field-vars (n) (i) (acc) =
   if i >= n then subj-deck-record (__linked-list-to-list acc)
   else gen-field-vars n (i + 1) (__linked-list-push acc (make-name ("__f" & integer-to-text i)))

  gen-var-pats : List Name, Integer, Integer, LinkedList APat -> List APat
  gen-var-pats (vars) (i) (len) (acc) =
   if i >= len then subj-deck-record (__linked-list-to-list acc)
   else gen-var-pats vars (i + 1) len (__linked-list-push acc (subj-deck-record (AVarPat (list-at vars i) synthetic-span)))

  gen-show-arm-body : Text, List Name -> AExpr
  gen-show-arm-body (cname) (vars) =
   if list-length vars == 0 then subj-deck-record (ALitExpr cname TextLit synthetic-span)
   else gen-show-fields (subj-deck-record (ALitExpr cname TextLit synthetic-span)) vars 0 (list-length vars)

  gen-show-fields : AExpr, List Name, Integer, Integer -> AExpr
  gen-show-fields (acc) (vars) (i) (len) =
   if i >= len then acc
   else let spaced = subj-deck-record (ABinaryExpr acc OpAppend (subj-deck-record (ALitExpr " " TextLit synthetic-span)) synthetic-span)
   in let showed = subj-deck-record (AApplyExpr (subj-deck-record (ANameExpr (make-name "show") synthetic-span)) (subj-deck-record (ANameExpr (list-at vars i) synthetic-span)) synthetic-span)
   in gen-show-fields (subj-deck-record (ABinaryExpr spaced OpAppend showed synthetic-span)) vars (i + 1) len

  gen-show-record : List RecordFieldDef, Name, Integer, Integer, AExpr -> AExpr
  gen-show-record (fields) (pname) (i) (len) (acc) =
   if i >= len then subj-deck-record (ABinaryExpr acc OpAppend (subj-deck-record (ALitExpr " }" TextLit synthetic-span)) synthetic-span)
   else let f = list-at fields i
   in let fname = token-text (f.name)
   in let sep = if i == 0 then " " else ", "
   in let label = subj-deck-record (ABinaryExpr acc OpAppend (subj-deck-record (ALitExpr (sep & fname & " = ") TextLit synthetic-span)) synthetic-span)
   in let showed = subj-deck-record (AApplyExpr (subj-deck-record (ANameExpr (make-name "show") synthetic-span)) (subj-deck-record (AFieldAccess (subj-deck-record (ANameExpr pname synthetic-span)) (make-name fname) synthetic-span)) synthetic-span)
   in gen-show-record fields pname (i + 1) len (subj-deck-record (ABinaryExpr label OpAppend showed synthetic-span))

  desugar-cite : CitesDecl -> ACitesDecl
  desugar-cite (imp) =
   subj-deck-record (ACitesDecl {
    quire = make-name (token-text (imp.quire)),
    chapter-name = make-name (imp.chapter-name),
    selected-names = map-list desugar-cite-name (imp.selected-names),
    citing-chapter = imp.citing-chapter,
    span = token-span (imp.quire)
   })

  desugar-cite-name : Token -> Name
  desugar-cite-name (tok) =
   make-name (token-text tok)

  desugar-effect-def : EffectDef -> AEffectDef
  desugar-effect-def (ed) =
   subj-deck-record (AEffectDef {
    name = make-name (token-text (ed.name)),
    ops = map-list desugar-effect-op (ed.ops),
    span = token-span (ed.name)
   })

  desugar-effect-op : EffectOpDef -> AEffectOpDef
  desugar-effect-op (op) =
   subj-deck-record (AEffectOpDef {
    name = make-name (token-text (op.name)),
    type-expr = desugar-type-expr (op.type-expr),
    span = token-span (op.name)
   })

  synth-class-type-defs : List ClassDef, List InstanceDef, Integer, Integer, LinkedList ATypeDef -> LinkedList ATypeDef
  synth-class-type-defs (cds) (ids) (i) (len) (acc) =
   if i >= len then acc
   else let cd = list-at cds i
   in let dict-name = make-name (token-text (cd.name) & "Dict")
   in let method-fields = synth-class-fields (cd.methods) 0 (list-length (cd.methods)) []
   in let fields = if text-length (cd.superclass) > 0
     then let super-field = subj-deck-record (ARecordFieldDef {
       name = make-name ("__super-" & (cd.superclass)),
       type-expr = subj-deck-record (ANamedType (make-name ((cd.superclass) & "Dict")) synthetic-span),
       span = synthetic-span
      })
     in list-insert-at method-fields 0 super-field
     else method-fields
   in let tparams = if count-class-instances ids (token-text (cd.name)) 0 (list-length ids) 0 > 1 then [make-name "a"] else []
   in let td = subj-deck-record (ARecordTypeDef dict-name tparams fields False synthetic-span)
   in synth-class-type-defs cds ids (i + 1) len (__linked-list-push acc td)

  synth-class-fields : List EffectOpDef, Integer, Integer, List ARecordFieldDef -> List ARecordFieldDef
  synth-class-fields (ops) (i) (len) (acc) =
   if i >= len then acc
   else let op = list-at ops i
   in let field = subj-deck-record (ARecordFieldDef {
    name = make-name (token-text (op.name) & "-impl"),
    type-expr = desugar-type-expr (op.type-expr),
    span = synthetic-span
   })
   in synth-class-fields ops (i + 1) len (list-push acc field)

  rewrite-constrained-defs : List ADef, List ClassDef, List InstanceDef, Integer, Integer, List ADef, Integer -> List ADef
  rewrite-constrained-defs (defs) (cds) (ids) (i) (len) (acc) (ceiling) =
   if i >= len then acc
   else if deck-out-of-room ceiling then acc
   else let d = list-at defs i
   in let rewritten = rewrite-if-constrained d cds ids
   in rewrite-constrained-defs defs cds ids (i + 1) len (list-push acc rewritten) ceiling

  rewrite-if-constrained : ADef, List ClassDef, List InstanceDef -> ADef
  rewrite-if-constrained (d) (cds) (ids) =
   if list-length (d.declared-type) == 0 then d
   else let ty = list-at (d.declared-type) 0
   in when ty
    is AConstrainedType (class-name) (type-var) (body-type) (sp) ->
     if is-derived-class (class-name.value) then rewrite-derived-constrained d (class-name.value) type-var body-type
     else let ic = count-class-instances ids (class-name.value) 0 (list-length ids) 0
     in if ic == 1
      then subj-deck-record (__record-set d "declared-type" [body-type])
      else let dict-param-name = "__" & (class-name.value) & "-dict"
       in let method-names = subj-deck-record (collect-class-method-names cds (class-name.value) 0 (list-length cds) [])
       in let new-param = subj-deck-record (AParam { name = make-name dict-param-name, span = synthetic-span })
       in let new-params = list-insert-at (d.params) 0 new-param
       in let new-body = rewrite-method-calls (d.body) method-names dict-param-name
       in let dict-type = subj-deck-record (AAppType (subj-deck-record (ANamedType (make-name ((class-name.value) & "Dict")) synthetic-span)) [subj-deck-record (ANamedType type-var synthetic-span)] synthetic-span)
       in let new-decl = subj-deck-record (AFunType dict-type body-type synthetic-span)
       in subj-deck-record (ADef {
        name = d.name,
        params = new-params,
        declared-type = [new-decl],
        body = new-body,
        chapter-slug = d.chapter-slug,
        span = d.span
       })
    is otherwise -> d

  is-derived-class : Text -> Boolean
  is-derived-class (name) = name == "Show" | name == "Ord"

  first-param-is-tyvar : ATypeExpr, Text -> Boolean
  first-param-is-tyvar (body-type) (tv) =
   when body-type
    is AFunType (p) (r) (s) ->
     when p
      is ANamedType (n) (ns) -> (n.value) == tv
      is otherwise -> False
    is otherwise -> False

  derived-class-method : Text -> Text
  derived-class-method (cls) = if cls == "Show" then "show" else "compare"

  derived-dict-type : Text, Name -> ATypeExpr
  derived-dict-type (cls) (type-var) =
   let tv = subj-deck-record (ANamedType type-var synthetic-span)
   in if cls == "Show"
    then subj-deck-record (AFunType tv (subj-deck-record (ANamedType (make-name "Text") synthetic-span)) synthetic-span)
    else subj-deck-record (AFunType tv (subj-deck-record (AFunType tv (subj-deck-record (ANamedType (make-name "Integer") synthetic-span)) synthetic-span)) synthetic-span)

  rewrite-derived-constrained : ADef, Text, Name, ATypeExpr -> ADef
  rewrite-derived-constrained (d) (cls) (type-var) (body-type) =
   if first-param-is-tyvar body-type (type-var.value) == False
    then subj-deck-record (__record-set d "declared-type" [body-type])
   else let dict-param-name = "__d-" & cls & "-" & (type-var.value)
   in let dict-ty = derived-dict-type cls type-var
   in let new-param = subj-deck-record (AParam { name = make-name dict-param-name, span = synthetic-span })
   in let new-params = list-insert-at (d.params) 0 new-param
   in let all-param-names = for p in (d.params) -> p.name.value
   in let new-body = rewrite-derived-method-calls-scoped (d.body) (derived-class-method cls) dict-param-name all-param-names
   in let new-decl = subj-deck-record (AFunType dict-ty body-type synthetic-span)
   in subj-deck-record (ADef {
    name = d.name,
    params = new-params,
    declared-type = [new-decl],
    body = new-body,
    chapter-slug = d.chapter-slug,
    span = d.span
   })

  rewrite-derived-method-calls : AExpr, Text, Text -> AExpr
  rewrite-derived-method-calls (expr) (method) (dict-param) =
   when expr
    is AApplyExpr (func) (arg) (s) ->
     let new-arg = rewrite-derived-method-calls arg method dict-param
     in when func
      is ANameExpr (n) (ns) ->
       if (n.value) == method
        then if is-concrete-arg arg then subj-deck-record (AApplyExpr func new-arg s)
        else subj-deck-record (AApplyExpr (subj-deck-record (ANameExpr (make-name dict-param) synthetic-span)) new-arg s)
        else subj-deck-record (AApplyExpr func new-arg s)
      is otherwise -> subj-deck-record (AApplyExpr (rewrite-derived-method-calls func method dict-param) new-arg s)
    is ABinaryExpr (l) (op) (r) (s) ->
     subj-deck-record (ABinaryExpr (rewrite-derived-method-calls l method dict-param) op (rewrite-derived-method-calls r method dict-param) s)
    is AIfExpr (c) (t) (e) (s) ->
     subj-deck-record (AIfExpr (rewrite-derived-method-calls c method dict-param) (rewrite-derived-method-calls t method dict-param) (rewrite-derived-method-calls e method dict-param) s)
    is ALetExpr (binds) (body) (s) ->
     subj-deck-record (ALetExpr (rewrite-derived-let-binds binds method dict-param 0 (list-length binds) []) (rewrite-derived-method-calls body method dict-param) s)
    is AMatchExpr (scrut) (arms) (s) ->
     subj-deck-record (AMatchExpr (rewrite-derived-method-calls scrut method dict-param) (rewrite-derived-arms arms method dict-param 0 (list-length arms) []) s)
    is AActExpr (stmts) (s) ->
     subj-deck-record (AActExpr (rewrite-derived-stmts stmts method dict-param 0 (list-length stmts) []) s)
    is otherwise -> expr

  rewrite-derived-arms : List AMatchArm, Text, Text, Integer, Integer, List AMatchArm -> List AMatchArm
  rewrite-derived-arms (arms) (method) (dict-param) (i) (len) (acc) =
   if i >= len then acc
   else let a = list-at arms i
   in let na = subj-deck-record (AMatchArm { pattern = a.pattern, body = rewrite-derived-method-calls (a.body) method dict-param, guard = a.guard, span = a.span, alt-group = a.alt-group })
   in rewrite-derived-arms arms method dict-param (i + 1) len (list-push acc na)

  rewrite-derived-stmts : List AActStmt, Text, Text, Integer, Integer, List AActStmt -> List AActStmt
  rewrite-derived-stmts (stmts) (method) (dict-param) (i) (len) (acc) =
   if i >= len then acc
   else let st = list-at stmts i
   in let nst = when st
    is AActExprStmt (e) (s) -> subj-deck-record (AActExprStmt (rewrite-derived-method-calls e method dict-param) s)
    is AActBindStmt (n) (e) (s) -> subj-deck-record (AActBindStmt n (rewrite-derived-method-calls e method dict-param) s)
   in rewrite-derived-stmts stmts method dict-param (i + 1) len (list-push acc nst)

  rewrite-derived-let-binds : List ALetBind, Text, Text, Integer, Integer, List ALetBind -> List ALetBind
  rewrite-derived-let-binds (binds) (method) (dict-param) (i) (len) (acc) =
   if i >= len then acc
   else let b = list-at binds i
   in let nb = subj-deck-record (ALetBind { name = b.name, value = rewrite-derived-method-calls (b.value) method dict-param, span = b.span })
   in rewrite-derived-let-binds binds method dict-param (i + 1) len (list-push acc nb)

  is-concrete-arg : AExpr -> Boolean
  is-concrete-arg (e) =
   when e
    is ALitExpr (v) (k) (s) -> True
    is AUnaryExpr (inner) (s) -> is-concrete-arg inner
    is otherwise -> False

  collect-tyvar-param-names : ATypeExpr, List AParam, Text, Integer -> List Text
  collect-tyvar-param-names (ty) (params) (tv) (i) =
   if i >= list-length params then []
   else when ty
    is AFunType (p) (r) (s) ->
     let rest = collect-tyvar-param-names r params tv (i + 1)
     in when p
      is ANamedType (n) (ns) -> if (n.value) == tv then list-insert-at rest 0 ((list-at params i).name.value) else rest
      is otherwise -> rest
    is otherwise -> []

  is-tyvar-arg : AExpr, List Text -> Boolean
  is-tyvar-arg (e) (tyvar-params) =
   when e
    is ANameExpr (n) (s) -> name-in-list (n.value) tyvar-params 0
    is otherwise -> False

  name-in-list : Text, List Text, Integer -> Boolean
  name-in-list (name) (names) (i) =
   if i >= list-length names then False
   else if (list-at names i) == name then True
   else name-in-list name names (i + 1)

  rewrite-derived-method-calls-scoped : AExpr, Text, Text, List Text -> AExpr
  rewrite-derived-method-calls-scoped (expr) (method) (dict-param) (tvp) =
   when expr
    is AApplyExpr (func) (arg) (s) ->
     let new-arg = rewrite-derived-method-calls-scoped arg method dict-param tvp
     in when func
      is ANameExpr (n) (ns) ->
       if (n.value) == method
        then if is-tyvar-arg arg tvp then subj-deck-record (AApplyExpr (subj-deck-record (ANameExpr (make-name dict-param) synthetic-span)) new-arg s)
        else subj-deck-record (AApplyExpr func new-arg s)
        else subj-deck-record (AApplyExpr func new-arg s)
      is otherwise -> subj-deck-record (AApplyExpr (rewrite-derived-method-calls-scoped func method dict-param tvp) new-arg s)
    is ABinaryExpr (l) (op) (r) (s) ->
     subj-deck-record (ABinaryExpr (rewrite-derived-method-calls-scoped l method dict-param tvp) op (rewrite-derived-method-calls-scoped r method dict-param tvp) s)
    is AIfExpr (c) (t) (e) (s) ->
     subj-deck-record (AIfExpr (rewrite-derived-method-calls-scoped c method dict-param tvp) (rewrite-derived-method-calls-scoped t method dict-param tvp) (rewrite-derived-method-calls-scoped e method dict-param tvp) s)
    is ALetExpr (binds) (body) (s) ->
     let new-binds = rewrite-derived-let-binds-scoped binds method dict-param tvp 0 (list-length binds) []
     in subj-deck-record (ALetExpr new-binds (rewrite-derived-method-calls-scoped body method dict-param tvp) s)
    is AMatchExpr (scrut) (arms) (s) ->
     subj-deck-record (AMatchExpr (rewrite-derived-method-calls-scoped scrut method dict-param tvp) (rewrite-derived-arms-scoped arms method dict-param tvp 0 (list-length arms) []) s)
    is AActExpr (stmts) (s) ->
     subj-deck-record (AActExpr (rewrite-derived-stmts-scoped stmts method dict-param tvp 0 (list-length stmts) []) s)
    is otherwise -> expr

  rewrite-derived-arms-scoped : List AMatchArm, Text, Text, List Text, Integer, Integer, List AMatchArm -> List AMatchArm
  rewrite-derived-arms-scoped (arms) (method) (dict-param) (tvp) (i) (len) (acc) =
   if i >= len then acc
   else let a = list-at arms i
   in let na = subj-deck-record (AMatchArm { pattern = a.pattern, body = rewrite-derived-method-calls-scoped (a.body) method dict-param tvp, guard = a.guard, span = a.span, alt-group = a.alt-group })
   in rewrite-derived-arms-scoped arms method dict-param tvp (i + 1) len (list-push acc na)

  rewrite-derived-stmts-scoped : List AActStmt, Text, Text, List Text, Integer, Integer, List AActStmt -> List AActStmt
  rewrite-derived-stmts-scoped (stmts) (method) (dict-param) (tvp) (i) (len) (acc) =
   if i >= len then acc
   else let st = list-at stmts i
   in let nst = when st
    is AActExprStmt (e) (s) -> subj-deck-record (AActExprStmt (rewrite-derived-method-calls-scoped e method dict-param tvp) s)
    is AActBindStmt (n) (e) (s) -> subj-deck-record (AActBindStmt n (rewrite-derived-method-calls-scoped e method dict-param tvp) s)
   in rewrite-derived-stmts-scoped stmts method dict-param tvp (i + 1) len (list-push acc nst)

  rewrite-derived-let-binds-scoped : List ALetBind, Text, Text, List Text, Integer, Integer, List ALetBind -> List ALetBind
  rewrite-derived-let-binds-scoped (binds) (method) (dict-param) (tvp) (i) (len) (acc) =
   if i >= len then acc
   else let b = list-at binds i
   in let nb = subj-deck-record (ALetBind { name = b.name, value = rewrite-derived-method-calls-scoped (b.value) method dict-param tvp, span = b.span })
   in rewrite-derived-let-binds-scoped binds method dict-param tvp (i + 1) len (list-push acc nb)

  named-aty : Text -> ATypeExpr
  named-aty (n) = subj-deck-record (ANamedType (make-name n) synthetic-span)

  prim-show-wrapper : Text -> ADef
  prim-show-wrapper (tn) =
   let pn = make-name "__w"
   in subj-deck-record (ADef {
    name = make-name ("__show_" & tn),
    params = [subj-deck-record (AParam { name = pn, span = synthetic-span })],
    declared-type = [subj-deck-record (AFunType (named-aty tn) (named-aty "Text") synthetic-span)],
    body = subj-deck-record (AApplyExpr (subj-deck-record (ANameExpr (make-name "show") synthetic-span)) (subj-deck-record (ANameExpr pn synthetic-span)) synthetic-span),
    chapter-slug = "",
    span = synthetic-span
   })

  prim-compare-wrapper : Text -> ADef
  prim-compare-wrapper (tn) =
   let xn = make-name "__wx"
   in let yn = make-name "__wy"
   in subj-deck-record (ADef {
    name = make-name ("__compare_" & tn),
    params = [subj-deck-record (AParam { name = xn, span = synthetic-span }), subj-deck-record (AParam { name = yn, span = synthetic-span })],
    declared-type = [subj-deck-record (AFunType (named-aty tn) (subj-deck-record (AFunType (named-aty tn) (named-aty "Integer") synthetic-span)) synthetic-span)],
    body = subj-deck-record (AApplyExpr (subj-deck-record (AApplyExpr (subj-deck-record (ANameExpr (make-name "compare") synthetic-span)) (subj-deck-record (ANameExpr xn synthetic-span)) synthetic-span)) (subj-deck-record (ANameExpr yn synthetic-span)) synthetic-span),
    chapter-slug = "",
    span = synthetic-span
   })

  chapter-has-constraint : List ADef, Text, Integer, Integer -> Boolean
  chapter-has-constraint (defs) (cls) (i) (len) =
   if i >= len then False
   else let d = list-at defs i
   in if list-length (d.declared-type) == 0 then chapter-has-constraint defs cls (i + 1) len
   else when (list-at (d.declared-type) 0)
    is AConstrainedType (cn) (cv) (b) (s) -> if (cn.value) == cls then True else chapter-has-constraint defs cls (i + 1) len
    is otherwise -> chapter-has-constraint defs cls (i + 1) len

  prepend-prim-wrappers : List ADef, List ADef -> List ADef
  prepend-prim-wrappers (all-defs) (base) =
   let n = list-length all-defs
   in let with-show = if chapter-has-constraint all-defs "Show" 0 n
        then [prim-show-wrapper "Integer", prim-show-wrapper "Boolean", prim-show-wrapper "Text", prim-show-wrapper "Real"] & base
        else base
   in if chapter-has-constraint all-defs "Ord" 0 n
      then [prim-compare-wrapper "Integer", prim-compare-wrapper "Boolean", prim-compare-wrapper "Text", prim-compare-wrapper "Real"] & with-show
      else with-show

  collect-class-method-names : List ClassDef, Text, Integer, Integer, List Text -> List Text
  collect-class-method-names (cds) (class-name) (i) (len) (acc) =
   if i >= len then acc
   else let cd = list-at cds i
   in if token-text (cd.name) == class-name
    then collect-method-names-from (cd.methods) 0 (list-length (cd.methods)) acc
    else collect-class-method-names cds class-name (i + 1) len acc

  collect-method-names-from : List EffectOpDef, Integer, Integer, List Text -> List Text
  collect-method-names-from (ops) (i) (len) (acc) =
   if i >= len then acc
   else collect-method-names-from ops (i + 1) len (list-push acc (token-text (list-at ops i).name))

  rewrite-method-calls : AExpr, List Text, Text -> AExpr
  rewrite-method-calls (expr) (method-names) (dict-param) =
   when expr
    is AApplyExpr (func) (arg) (s) ->
     let new-arg = rewrite-method-calls arg method-names dict-param
     in when func
      is ANameExpr (n) (ns) ->
       if is-in-list (n.value) method-names 0 (list-length method-names)
        then let dict-ref = subj-deck-record (ANameExpr (make-name dict-param) synthetic-span)
         in let field-acc = subj-deck-record (AFieldAccess dict-ref (make-name ((n.value) & "-impl")) s)
         in subj-deck-record (AApplyExpr field-acc new-arg s)
        else subj-deck-record (AApplyExpr func new-arg s)
      is otherwise -> subj-deck-record (AApplyExpr (rewrite-method-calls func method-names dict-param) new-arg s)
    is ABinaryExpr (l) (op) (r) (s) ->
     subj-deck-record (ABinaryExpr (rewrite-method-calls l method-names dict-param) op (rewrite-method-calls r method-names dict-param) s)
    is AIfExpr (c) (t) (e) (s) ->
     subj-deck-record (AIfExpr (rewrite-method-calls c method-names dict-param) (rewrite-method-calls t method-names dict-param) (rewrite-method-calls e method-names dict-param) s)
    is ALetExpr (binds) (body) (s) ->
     subj-deck-record (ALetExpr (rewrite-let-binds binds method-names dict-param 0 (list-length binds) []) (rewrite-method-calls body method-names dict-param) s)
    is otherwise -> expr

  rewrite-let-binds : List ALetBind, List Text, Text, Integer, Integer, List ALetBind -> List ALetBind
  rewrite-let-binds (binds) (method-names) (dict-param) (i) (len) (acc) =
   if i >= len then acc
   else let b = list-at binds i
   in let new-b = subj-deck-record (ALetBind { name = b.name, value = rewrite-method-calls (b.value) method-names dict-param, span = b.span })
   in rewrite-let-binds binds method-names dict-param (i + 1) len (list-push acc new-b)

  ConstrainedFnInfo = record {
   fn-name : Text,
   dict-name : Text
  }

  collect-constrained-names : List ADef, List ClassDef, List InstanceDef, Integer, Integer, List ConstrainedFnInfo -> List ConstrainedFnInfo
  collect-constrained-names (defs) (cds) (ids) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at defs i
   in if list-length (d.declared-type) == 0 then collect-constrained-names defs cds ids (i + 1) len acc
   else let ty = list-at (d.declared-type) 0
   in when ty
    is AConstrainedType (class-name) (type-var) (body-type) (sp) ->
     if is-derived-class (class-name.value)
      then if first-param-is-tyvar body-type (type-var.value)
        then collect-constrained-names defs cds ids (i + 1) len (list-push acc (ConstrainedFnInfo { fn-name = d.name.value, dict-name = "__dderiv-" & (class-name.value) }))
        else collect-constrained-names defs cds ids (i + 1) len acc
      else let ic = count-class-instances ids (class-name.value) 0 (list-length ids) 0
     in if ic > 1
      then let dict = "__dict-of-" & (class-name.value)
       in collect-constrained-names defs cds ids (i + 1) len (list-push acc (ConstrainedFnInfo { fn-name = d.name.value, dict-name = dict }))
      else collect-constrained-names defs cds ids (i + 1) len acc
    is otherwise -> collect-constrained-names defs cds ids (i + 1) len acc

  find-single-instance-type : List InstanceDef, Text, Integer, Integer -> Text
  find-single-instance-type (ids) (class-name) (i) (len) =
   if i >= len then ""
   else let id = list-at ids i
   in if token-text (id.class-name) == class-name then token-text (id.type-name)
   else find-single-instance-type ids class-name (i + 1) len

  insert-dicts-at-call-sites : List ADef, List ConstrainedFnInfo, Integer, Integer, List ADef, Integer -> List ADef
  insert-dicts-at-call-sites (defs) (info) (i) (len) (acc) (ceiling) =
   if i >= len then acc
   else if deck-out-of-room ceiling then acc
   else let d = list-at defs i
   in let new-body = insert-dict-refs (d.body) info
   in let new-d = subj-deck-record (__record-set d "body" new-body)
   in insert-dicts-at-call-sites defs info (i + 1) len (list-push acc new-d) ceiling

  insert-dict-refs : AExpr, List ConstrainedFnInfo -> AExpr
  insert-dict-refs (expr) (info) =
   if list-length info == 0 then expr
   else when expr
    is AApplyExpr (func) (arg) (s) ->
     let new-arg = insert-dict-refs arg info
     in when func
      is ANameExpr (n) (ns) ->
       let dict = lookup-constrained-dict (n.value) info 0 (list-length info)
       in if dict == "" then subj-deck-record (AApplyExpr func new-arg s)
       else let dict-ref = subj-deck-record (ANameExpr (make-name dict) synthetic-span)
        in let with-dict = subj-deck-record (AApplyExpr func dict-ref s)
        in subj-deck-record (AApplyExpr with-dict new-arg s)
      is otherwise -> subj-deck-record (AApplyExpr (insert-dict-refs func info) new-arg s)
    is ABinaryExpr (l) (op) (r) (s) ->
     subj-deck-record (ABinaryExpr (insert-dict-refs l info) op (insert-dict-refs r info) s)
    is AIfExpr (c) (t) (e) (s) ->
     subj-deck-record (AIfExpr (insert-dict-refs c info) (insert-dict-refs t info) (insert-dict-refs e info) s)
    is ALetExpr (binds) (body) (s) ->
     let new-binds = rewrite-let-binds-dict binds info 0 (list-length binds) []
     in subj-deck-record (ALetExpr new-binds (insert-dict-refs body info) s)
    is AActExpr (stmts) (s) ->
     subj-deck-record (AActExpr (insert-dict-refs-stmts stmts info 0 (list-length stmts) []) s)
    is otherwise -> expr

  insert-dict-refs-stmts : List AActStmt, List ConstrainedFnInfo, Integer, Integer, List AActStmt -> List AActStmt
  insert-dict-refs-stmts (stmts) (info) (i) (len) (acc) =
   if i >= len then acc
   else let st = list-at stmts i
   in let new-st = when st
    is AActExprStmt (e) (s) -> subj-deck-record (AActExprStmt (insert-dict-refs e info) s)
    is AActBindStmt (n) (e) (s) -> subj-deck-record (AActBindStmt n (insert-dict-refs e info) s)
   in insert-dict-refs-stmts stmts info (i + 1) len (list-push acc new-st)

  rewrite-let-binds-dict : List ALetBind, List ConstrainedFnInfo, Integer, Integer, List ALetBind -> List ALetBind
  rewrite-let-binds-dict (binds) (info) (i) (len) (acc) =
   if i >= len then acc
   else let b = list-at binds i
   in let new-b = subj-deck-record (ALetBind { name = b.name, value = insert-dict-refs (b.value) info, span = b.span })
   in rewrite-let-binds-dict binds info (i + 1) len (list-push acc new-b)

  lookup-constrained-dict : Text, List ConstrainedFnInfo, Integer, Integer -> Text
  lookup-constrained-dict (name) (info) (i) (len) =
   if i >= len then ""
   else let ci = list-at info i
   in if ci.fn-name == name then ci.dict-name
   else lookup-constrained-dict name info (i + 1) len

  is-in-list : Text, List Text, Integer, Integer -> Boolean
  is-in-list (target) (xs) (i) (len) =
   if i >= len then False
   else if list-at xs i == target then True
   else is-in-list target xs (i + 1) len

  synth-instance-defs : List ClassDef, List InstanceDef, Integer, Integer, LinkedList ADef -> LinkedList ADef
  synth-instance-defs (cds) (ids) (i) (len) (acc) =
   if i >= len then acc
   else let id = list-at ids i
   in let class-name = token-text (id.class-name)
   in let type-name = token-text (id.type-name)
   in let dict-name = class-name & "Dict"
   in let def-name = make-name (class-name & "-dict-" & type-name)
   in let method-fields = synth-instance-fields (id.methods) 0 (list-length (id.methods)) []
   in let super-name = class-superclass-of cds class-name 0 (list-length cds)
   in let fields = if text-length super-name > 0
     then let super-field = subj-deck-record (AFieldExpr {
       name = make-name ("__super-" & super-name),
       value = subj-deck-record (ANameExpr (make-name (super-name & "-dict-" & type-name)) synthetic-span),
       span = synthetic-span
      })
     in list-insert-at method-fields 0 super-field
     else method-fields
   in let body = subj-deck-record (ARecordExpr (make-name dict-name) fields synthetic-span)
   in let instance-count = count-class-instances ids class-name 0 (list-length ids) 0
   in let def = subj-deck-record (ADef {
    name = def-name,
    params = [],
    declared-type = [],
    body = body,
    chapter-slug = "",
    span = synthetic-span
   })
   in let acc2 = __linked-list-push acc def
   in let acc3 = synth-specialized-methods (id.methods) type-name 0 (list-length (id.methods)) acc2
   in let acc4 = if instance-count == 1
    then synth-bare-methods (id.methods) 0 (list-length (id.methods)) acc3
    else acc3
   in synth-instance-defs cds ids (i + 1) len acc4

  count-class-instances : List InstanceDef, Text, Integer, Integer, Integer -> Integer
  count-class-instances (ids) (class-name) (i) (len) (acc) =
   if i >= len then acc
   else let id = list-at ids i
   in let cn = token-text (id.class-name)
   in count-class-instances ids class-name (i + 1) len (if cn == class-name then acc + 1 else acc)

  synth-bare-methods : List InstanceMethodDef, Integer, Integer, LinkedList ADef -> LinkedList ADef
  synth-bare-methods (ms) (i) (len) (acc) =
   if i >= len then acc
   else let m = list-at ms i
   in let method-name = token-text (m.name)
   in let params = for p in (m.params) -> make-name (token-text p)
   in let param-list = for n in params -> subj-deck-record (AParam { name = n, span = synthetic-span })
   in let def = subj-deck-record (ADef {
    name = make-name method-name,
    params = param-list,
    declared-type = [],
    body = desugar-expr (m.body),
    chapter-slug = "",
    span = synthetic-span
   })
   in synth-bare-methods ms (i + 1) len (__linked-list-push acc def)

  synth-specialized-methods : List InstanceMethodDef, Text, Integer, Integer, LinkedList ADef -> LinkedList ADef
  synth-specialized-methods (ms) (type-name) (i) (len) (acc) =
   if i >= len then acc
   else let m = list-at ms i
   in let method-name = token-text (m.name)
   in let spec-name = make-name (method-name & "-" & type-name)
   in let params = for p in (m.params) -> make-name (token-text p)
   in let param-list = for n in params -> subj-deck-record (AParam { name = n, span = synthetic-span })
   in let def = subj-deck-record (ADef {
    name = spec-name,
    params = param-list,
    declared-type = [],
    body = desugar-expr (m.body),
    chapter-slug = "",
    span = synthetic-span
   })
   in synth-specialized-methods ms type-name (i + 1) len (__linked-list-push acc def)

  class-superclass-of : List ClassDef, Text, Integer, Integer -> Text
  class-superclass-of (cds) (class-name) (i) (len) =
   if i >= len then ""
   else let cd = list-at cds i
   in if token-text (cd.name) == class-name then cd.superclass
      else class-superclass-of cds class-name (i + 1) len

  synth-instance-fields : List InstanceMethodDef, Integer, Integer, List AFieldExpr -> List AFieldExpr
  synth-instance-fields (ms) (i) (len) (acc) =
   if i >= len then acc
   else let m = list-at ms i
   in let params = for p in (m.params) -> make-name (token-text p)
   in let lam-body = desugar-expr (m.body)
   in let field-val = if list-length params == 0 then lam-body
    else subj-deck-record (ALambdaExpr params lam-body synthetic-span)
   in let field = subj-deck-record (AFieldExpr {
    name = make-name (token-text (m.name) & "-impl"),
    value = field-val,
    span = synthetic-span
   })
   in synth-instance-fields ms (i + 1) len (list-push acc field)

  desugar-class-defs : List ClassDef, Integer, Integer, List AClassDef -> List AClassDef
  desugar-class-defs (cds) (i) (len) (acc) =
   if i >= len then acc
   else let cd = list-at cds i
   in let acd = subj-deck-record (AClassDef {
    name = make-name (token-text (cd.name)),
    methods = map-list desugar-effect-op (cd.methods),
    span = token-span (cd.name)
   })
   in desugar-class-defs cds (i + 1) len (list-push acc acd)

  desugar-instance-defs : List InstanceDef, Integer, Integer, List AInstanceDef -> List AInstanceDef
  desugar-instance-defs (ids) (i) (len) (acc) =
   if i >= len then acc
   else let id = list-at ids i
   in let aid = subj-deck-record (AInstanceDef {
    class-name = make-name (token-text (id.class-name)),
    type-name = make-name (token-text (id.type-name)),
    methods = desugar-instance-methods (id.methods) 0 (list-length (id.methods)) [],
    span = token-span (id.class-name)
   })
   in desugar-instance-defs ids (i + 1) len (list-push acc aid)

  desugar-instance-methods : List InstanceMethodDef, Integer, Integer, List AInstanceMethodDef -> List AInstanceMethodDef
  desugar-instance-methods (ms) (i) (len) (acc) =
   if i >= len then acc
   else let m = list-at ms i
   in let am = subj-deck-record (AInstanceMethodDef {
    name = make-name (token-text (m.name)),
    params = map-list desugar-cite-name (m.params),
    body = desugar-expr (m.body),
    span = token-span (m.name)
   })
   in desugar-instance-methods ms (i + 1) len (list-push acc am)

Page 1


Chapter: Parsmi--SkipListText
  cites Codex chapter Phase Allocator (subj-deck-record)

Section: Types

  SkipNodeText = record {
   value : Text,
   is-end : Boolean,
   forward : List SkipNodeText,
   spans : List Integer
  }

  SkipListText = record {
   head : SkipNodeText,
   size : Integer between 0 and 4294967295,
   max-level : Integer between 0 and 255
  }

Section: Constants

  skip-list-text-max-height : Integer
  skip-list-text-max-height = 16

Section: Internal Helpers

  make-end-node : SkipNodeText
  make-end-node =
   subj-deck-record (SkipNodeText {
    value = "",
    is-end = True,
    forward = [],
    spans = []
   })

  replicate-node : Integer, SkipNodeText -> List SkipNodeText
  replicate-node (n) (v) =
   replicate-node-loop n v 0 []

  replicate-node-loop : Integer, SkipNodeText, Integer, List SkipNodeText -> List SkipNodeText
  replicate-node-loop (n) (v) (i) (acc) =
   if i == n then acc
   else replicate-node-loop n v (i + 1) (list-push acc v)

  replicate-int : Integer, Integer -> List Integer
  replicate-int (n) (v) =
   replicate-int-loop n v 0 []

  replicate-int-loop : Integer, Integer, Integer, List Integer -> List Integer
  replicate-int-loop (n) (v) (i) (acc) =
   if i == n then acc
   else replicate-int-loop n v (i + 1) (list-push acc v)

  trailing-zeros : Integer -> Integer
  trailing-zeros (n) =
   if n == 0 then 0
   else trailing-zeros-loop n 0

  trailing-zeros-loop : Integer, Integer -> Integer
  trailing-zeros-loop (n) (acc) =
   if n / 2 * 2 /= n then acc
   else trailing-zeros-loop (n / 2) (acc + 1)

  pick-height : Integer -> Integer
  pick-height (counter) =
   let raw = 1 + trailing-zeros counter
   in if raw > skip-list-text-max-height then skip-list-text-max-height
      else raw

Section: Construction

  skip-list-text-empty : SkipListText
  skip-list-text-empty =
   let end-node = make-end-node
   in let head-forward = replicate-node skip-list-text-max-height end-node
   in let head-spans = replicate-int skip-list-text-max-height 0
   in subj-deck-record (SkipListText {
    head = subj-deck-record (SkipNodeText {
     value = "",
     is-end = False,
     forward = head-forward,
     spans = head-spans
    }),
    size = 0,
    max-level = 0
   })

Section: Query

  skip-list-text-size : SkipListText -> Integer
  skip-list-text-size (s) = s.size

  skip-list-text-is-empty : SkipListText -> Boolean
  skip-list-text-is-empty (s) = s.size == 0

  skip-list-text-has : SkipListText, Text -> Boolean
  skip-list-text-has (s) (v) =
   if s.size == 0 then False
   else has-descend (s.head) (s.max-level - 1) v

  has-descend : SkipNodeText, Integer, Text -> Boolean
  has-descend (node) (level) (v) =
   if level < 0 then False
   else let node2 = advance-while-less node level v
   in let next = list-at (node2.forward) level
   in if next.is-end then has-descend node2 (level - 1) v
      else if next.value == v then True
      else has-descend node2 (level - 1) v

  advance-while-less : SkipNodeText, Integer, Text -> SkipNodeText
  advance-while-less (node) (level) (v) =
   let next = list-at (node.forward) level
   in if next.is-end then node
      else if text-compare (next.value) v < 0 then advance-while-less next level v
      else node

Section: Indexed Access

  AdvanceResult = record {
   node : SkipNodeText,
   pos : Integer between 0 and 4294967295 wrapping
  }

  skip-list-text-at : SkipListText, Integer -> Text
  skip-list-text-at (s) (i) =
   if i < 0 then ""
   else if i >= s.size then ""
   else at-descend (s.head) 0 (i + 1) (s.max-level - 1)

  at-descend : SkipNodeText, Integer, Integer, Integer -> Text
  at-descend (node) (pos) (target) (level) =
   if level < 0 then
    if pos == target then node.value
    else ""
   else let advanced = advance-with-spans node pos target level
   in at-descend (advanced.node) (advanced.pos) target (level - 1)

  advance-with-spans : SkipNodeText, Integer, Integer, Integer -> AdvanceResult
  advance-with-spans (node) (pos) (target) (level) =
   let next = list-at (node.forward) level
   in if next.is-end then AdvanceResult { node = node, pos = pos }
      else let span = list-at (node.spans) level
      in if pos + span > target then AdvanceResult { node = node, pos = pos }
      else advance-with-spans next (pos + span) target level

  skip-list-text-rank-of : SkipListText, Text -> Integer
  skip-list-text-rank-of (s) (v) =
   if s.size == 0 then 0 - 1
   else rank-descend (s.head) 0 v (s.max-level - 1)

  rank-descend : SkipNodeText, Integer, Text, Integer -> Integer
  rank-descend (node) (pos) (v) (level) =
   if level < 0 then
    let next = list-at (node.forward) 0
    in if next.is-end then 0 - 1
       else if text-compare (next.value) v == 0 then pos
       else 0 - 1
   else let advanced = advance-rank node pos v level
   in rank-descend (advanced.node) (advanced.pos) v (level - 1)

  advance-rank : SkipNodeText, Integer, Text, Integer -> AdvanceResult
  advance-rank (node) (pos) (v) (level) =
   let next = list-at (node.forward) level
   in if next.is-end then AdvanceResult { node = node, pos = pos }
      else if text-compare (next.value) v < 0 then
       let span = list-at (node.spans) level
       in advance-rank next (pos + span) v level
      else AdvanceResult { node = node, pos = pos }

Section: Iteration

  skip-list-text-to-list : SkipListText -> List Text
  skip-list-text-to-list (s) =
   if s.size == 0 then []
   else to-list-loop (list-at (s.head.forward) 0) []

  to-list-loop : SkipNodeText, List Text -> List Text
  to-list-loop (node) (acc) =
   if node.is-end then acc
   else to-list-loop (list-at (node.forward) 0) (list-push acc (node.value))

Section: Bulk Construction

  skip-list-text-from-list : List Text -> SkipListText
  skip-list-text-from-list (xs) =
   skip-list-text-from-list-loop xs 0 (list-length xs) skip-list-text-empty

  skip-list-text-from-list-loop : List Text, Integer, Integer, SkipListText -> SkipListText
  skip-list-text-from-list-loop (xs) (i) (len) (acc) =
   if i == len then acc
   else skip-list-text-from-list-loop xs (i + 1) len (skip-list-text-insert acc (list-at xs i))

  skip-list-text-clone : SkipListText -> SkipListText
  skip-list-text-clone (s) =
   skip-list-text-from-list (skip-list-text-to-list s)

  skip-list-text-union : SkipListText, SkipListText -> SkipListText
  skip-list-text-union (a) (b) =
   let xs = skip-list-text-to-list b
   in skip-list-text-union-loop a xs 0 (list-length xs)

  skip-list-text-union-loop : SkipListText, List Text, Integer, Integer -> SkipListText
  skip-list-text-union-loop (a) (xs) (i) (len) =
   if i == len then a
   else skip-list-text-union-loop (skip-list-text-insert a (list-at xs i)) xs (i + 1) len

Section: Insertion

  UpdatePath = record {
   nodes : List SkipNodeText,
   ranks : List Integer
  }

  skip-list-text-insert : SkipListText, Text -> SkipListText
  skip-list-text-insert (s) (v) =
   let path = build-update-path s v
   in let pred0 = list-at (path.nodes) 0
   in let next0 = list-at (pred0.forward) 0
   in if next0.is-end == False then
        if next0.value == v then s
        else install-new-node s v path
      else install-new-node s v path

  build-update-path : SkipListText, Text -> UpdatePath
  build-update-path (s) (v) =
   let init-nodes = replicate-node skip-list-text-max-height (s.head)
   in let init-ranks = replicate-int skip-list-text-max-height 0
   in build-update-loop (s.head) 0 (s.max-level - 1) v init-nodes init-ranks

  build-update-loop : SkipNodeText, Integer, Integer, Text, List SkipNodeText, List Integer -> UpdatePath
  build-update-loop (cursor) (pos) (level) (v) (nodes) (ranks) =
   if level < 0 then UpdatePath { nodes = nodes, ranks = ranks }
   else let advanced = advance-less-with-spans cursor pos level v
   in let nodes2 = list-set-at nodes level (advanced.node)
   in let ranks2 = list-set-at ranks level (advanced.pos)
   in build-update-loop (advanced.node) (advanced.pos) (level - 1) v nodes2 ranks2

  advance-less-with-spans : SkipNodeText, Integer, Integer, Text -> AdvanceResult
  advance-less-with-spans (node) (pos) (level) (v) =
   let next = list-at (node.forward) level
   in if next.is-end then AdvanceResult { node = node, pos = pos }
      else if text-compare (next.value) v < 0 then
       let span = list-at (node.spans) level
       in advance-less-with-spans next (pos + span) level v
      else AdvanceResult { node = node, pos = pos }

  install-new-node : SkipListText, Text, UpdatePath -> SkipListText
  install-new-node (s) (v) (path) =
   let new-height = pick-height (s.size + 1)
   in let path2 = extend-path-for-height s path new-height
   in let new-pos = list-at (path2.ranks) 0 + 1
   in let new-node = allocate-node v new-height path2 new-pos
   in let s2 = splice-new-node s path2 new-node new-height new-pos 0
   in let new-max = if new-height > s2.max-level then new-height else s2.max-level
   in let s3 = bump-spans-above s2 path2 new-height new-max
   in subj-deck-record (SkipListText {
    head = s3.head,
    size = s3.size + 1,
    max-level = __narrow new-max
   })

  extend-path-for-height : SkipListText, UpdatePath, Integer -> UpdatePath
  extend-path-for-height (s) (path) (new-height) =
   if new-height <= s.max-level then path
   else extend-path-loop s path (s.max-level) new-height

  extend-path-loop : SkipListText, UpdatePath, Integer, Integer -> UpdatePath
  extend-path-loop (s) (path) (l) (new-height) =
   if l == new-height then path
   else let nodes2 = list-set-at (path.nodes) l (s.head)
   in let ranks2 = list-set-at (path.ranks) l 0
   in let dummy = list-set-at (s.head.spans) l (s.size)
   in extend-path-loop s (UpdatePath { nodes = nodes2, ranks = ranks2 }) (l + 1) new-height

  allocate-node : Text, Integer, UpdatePath, Integer -> SkipNodeText
  allocate-node (v) (height) (path) (new-pos) =
   let init-forward = replicate-node height make-end-node
   in let init-spans = replicate-int height 0
   in let node-forward = fill-new-forward path height init-forward 0
   in let node-spans = fill-new-spans path height init-spans new-pos 0
   in subj-deck-record (SkipNodeText {
    value = v,
    is-end = False,
    forward = node-forward,
    spans = node-spans
   })

  fill-new-forward : UpdatePath, Integer, List SkipNodeText, Integer -> List SkipNodeText
  fill-new-forward (path) (height) (acc) (i) =
   if i == height then acc
   else let pred = list-at (path.nodes) i
   in let target = list-at (pred.forward) i
   in fill-new-forward path height (list-set-at acc i target) (i + 1)

  fill-new-spans : UpdatePath, Integer, List Integer, Integer, Integer -> List Integer
  fill-new-spans (path) (height) (acc) (new-pos) (i) =
   if i == height then acc
   else let pred = list-at (path.nodes) i
   in let pred-rank = list-at (path.ranks) i
   in let old-span = list-at (pred.spans) i
   in let new-span = old-span - (new-pos - pred-rank - 1)
   in fill-new-spans path height (list-set-at acc i new-span) new-pos (i + 1)

  splice-new-node : SkipListText, UpdatePath, SkipNodeText, Integer, Integer, Integer -> SkipListText
  splice-new-node (s) (path) (new-node) (height) (new-pos) (i) =
   if i == height then s
   else let pred = list-at (path.nodes) i
   in let pred-rank = list-at (path.ranks) i
   in let dummy1 = list-set-at (pred.forward) i new-node
   in let dummy2 = list-set-at (pred.spans) i (new-pos - pred-rank)
   in splice-new-node s path new-node height new-pos (i + 1)

  bump-spans-above : SkipListText, UpdatePath, Integer, Integer -> SkipListText
  bump-spans-above (s) (path) (from-level) (max-level-val) =
   if from-level >= max-level-val then s
   else let pred = list-at (path.nodes) from-level
   in let old = list-at (pred.spans) from-level
   in let dummy = list-set-at (pred.spans) from-level (old + 1)
   in bump-spans-above s path (from-level + 1) max-level-val

Page 1


Chapter: Parsmi--Chapter Scoper
  cites Foreword chapter Sort
  cites Codex chapter Build Settings (demand-scope-guard-band)
  cites Codex chapter Phase Allocator (deck-short-of)

Section: Chapter Assignment
  ChapterAssignment = record {
   def-name : Text,
   chapter-slug : Text
  }

  assign-chapters : List DefHeader, Text, Integer, List ChapterAssignment -> List ChapterAssignment
  assign-chapters (headers) (current-chapter) (i) (acc) =
   if i == list-length headers then acc
   else let hdr = list-at headers i
   in assign-chapters headers current-chapter (i + 1) (list-push acc (ChapterAssignment {
    def-name = token-text (hdr.name),
    chapter-slug = current-chapter
   }))

Section: Collision Detection
  find-colliding-names : List ChapterAssignment -> SkipListText
  find-colliding-names (assignments) =
   find-collisions-loop assignments 0 (list-length assignments) skip-list-text-empty [] []

  find-collisions-loop : List ChapterAssignment, Integer, Integer, SkipListText, List Text, List Text -> SkipListText
  find-collisions-loop (assignments) (i) (len) (acc) (seen-names) (seen-slugs) =
   if i == len then acc
   else let a = list-at assignments i
   in if a.def-name == opening-entry-point then find-collisions-loop assignments (i + 1) len acc seen-names seen-slugs
      else if skip-list-text-has acc (a.def-name) then find-collisions-loop assignments (i + 1) len acc seen-names seen-slugs
      else let slen = list-length seen-names
      in let pos = bsearch-text-set seen-names (a.def-name) 0 slen
      in if pos < slen then
        if list-at seen-names pos == a.def-name then
          if list-at seen-slugs pos /= a.chapter-slug
            then find-collisions-loop assignments (i + 1) len (skip-list-text-insert acc (a.def-name)) seen-names seen-slugs
            else find-collisions-loop assignments (i + 1) len acc seen-names seen-slugs
        else find-collisions-loop assignments (i + 1) len acc (list-insert-at seen-names pos (a.def-name)) (list-insert-at seen-slugs pos (a.chapter-slug))
      else find-collisions-loop assignments (i + 1) len acc (list-insert-at seen-names pos (a.def-name)) (list-insert-at seen-slugs pos (a.chapter-slug))

  count-openings : List ChapterAssignment, Integer, Integer, Integer -> Integer
  count-openings (assignments) (i) (len) (count) =
   if i == len then count
   else let a = list-at assignments i
   in if a.def-name == opening-entry-point then count-openings assignments (i + 1) len (count + 1)
      else count-openings assignments (i + 1) len count

  check-entry-point-duplicate : List ChapterAssignment -> List Diagnostic
  check-entry-point-duplicate (assignments) =
   if count-openings assignments 0 (list-length assignments) 0 >= 2
   then [make-error cdx-duplicate-definition "'opening' is defined in multiple chapters. A program has exactly one entry point." synthetic-span]
   else []

Section: Builtin Shadowing

 It does not win everywhere, and that is the sharper half. Measured
 2026-07-18 by shadowing five builtins in one chapter and printing what
 each call returned: abs, int-mod, text-contains and is-digit took the
 definition; text-length took the BUILTIN and ignored the definition
 entirely. A builtin lowered to its own IR node never reaches the
 dispatch a definition could displace. So the same shadowing pattern
 resolves two different ways depending on which builtin it names, and
 the source says nothing about which -- you would have to know how that
 particular builtin is lowered. Inconsistent is worse than either
 answer consistently, and it is the reason to say something at the
 definition rather than leave it to be reasoned out at each call.

 What the warning buys is that the dangerous case stops being silent.
 The danger is not a different ANSWER, it is a different COST: `Hamt`
 defined list-insert-at -- a builtin that is in-place and amortised
 O(1) -- with a pure O(n) body, and citing Hamt into the compiler sent
 TypeEnv, ChapterScoper, TypeChecker and LambdaLifting quadratic until
 R10 walked into the stack. That shadow was correct by every test and
 wrong by every clock.

  check-shadowed-builtins : List DefHeader, SkipListText, Integer, Integer, List Diagnostic -> List Diagnostic
  check-shadowed-builtins (headers) (bset) (i) (len) (acc) =
   if i >= len then acc
   else let h = list-at headers i
   in let n = token-text (h.name)
   in if skip-list-text-has bset n
      then check-shadowed-builtins headers bset (i + 1) len (list-push acc (make-warning cdx-shadows-builtin ("Definition '" & n & "' has the same name as a builtin. Whether a call site gets this definition or the builtin depends on how that builtin is lowered, and the source does not say which -- so if this is deliberate, it is deliberate about something you cannot read here. If it is not, rename it. Check the COST as well as the answer: a shadow that computes the same result more slowly is the failure mode that has actually cost time here. This chapter's shadow applies to the whole compilation unit, and to any unit that cites it.") (token-span (h.name))))
      else check-shadowed-builtins headers bset (i + 1) len acc

Section: Colliding Across Chapters

 It has been paid for once already. CL 8955 moved three builtin emitter
 bodies from the Emit quire into Types, where emit-expr resolved to the
 text emitter instead of the x86 one. That was caught, but only because
 the two signatures were far enough apart to raise CDX2001. Two
 colliding definitions with compatible types compile clean and emit the
 wrong code, and nothing looks wrong anywhere.

  colliding-other-chapter : List ChapterAssignment, Text, Text, Integer, Integer -> Text
  colliding-other-chapter (assignments) (name) (own-slug) (i) (len) =
   if i >= len then ""
   else let a = list-at assignments i
   in if a.def-name == name then if a.chapter-slug /= own-slug then a.chapter-slug
      else colliding-other-chapter assignments name own-slug (i + 1) len
      else colliding-other-chapter assignments name own-slug (i + 1) len

  check-cross-chapter-collisions : List DefHeader, SkipListText, List ChapterAssignment, Integer, Integer, List Diagnostic -> List Diagnostic
  check-cross-chapter-collisions (headers) (colliding) (assignments) (i) (len) (acc) =
   if i >= len then acc
   else let h = list-at headers i
   in let n = token-text (h.name)
   in if skip-list-text-has colliding n
      then let other = colliding-other-chapter assignments n (h.chapter-slug) 0 (list-length assignments)
   in check-cross-chapter-collisions headers colliding assignments (i + 1) len (list-push acc (make-warning cdx-collides-across-chapters ("Definition '" & n & "' is also defined in chapter '" & other & "'. Both are kept and each chapter sees its own, so this compiles and runs -- but which definition a mention gets depends on the chapter the mention sits in, and in a chapter that defines neither it depends on the order the build globs files. Move this body to the other chapter and it silently means the other thing. Give one of them a chapter-specific prefix, or cite the one you mean instead of defining it twice.") (token-span (h.name))))
      else check-cross-chapter-collisions headers colliding assignments (i + 1) len acc

Section: Name Mangling
  mangle-name : Text, Text -> Text
  mangle-name (chapter-slug) (def-name) =
   slugify chapter-slug & "_" & def-name

  slugify-loop : Text, Integer, Integer, List Text -> List Text
  slugify-loop (s) (i) (len) (acc) =
   if i == len then acc
   else let c = char-code-at s i
   in if c == char-code-at " " 0 then slugify-loop s (i + 1) len (list-push acc "-")
      else if c >= cc-first-upper then if c <= cc-upper-z then slugify-loop s (i + 1) len (list-push acc (char-to-text (code-to-char (c - 26))))
      else slugify-loop s (i + 1) len (list-push acc (char-to-text (code-to-char c)))
      else slugify-loop s (i + 1) len (list-push acc (char-to-text (code-to-char c)))

  slugify : Text -> Text
  slugify (s) = text-concat-list (slugify-loop s 0 (text-length s) [])

  lookup-chapter : List ChapterAssignment, Text -> Text
  lookup-chapter (assignments) (name) =
   lookup-chapter-loop assignments name 0 (list-length assignments)

  lookup-chapter-loop : List ChapterAssignment, Text, Integer, Integer -> Text
  lookup-chapter-loop (assignments) (name) (i) (len) =
   if i == len then ""
   else let a = list-at assignments i
   in if a.def-name == name then a.chapter-slug
      else lookup-chapter-loop assignments name (i + 1) len

Section: Rename Map
  RenameEntry = record {
   original : Text,
   mangled : Text
  }

Section: Binary Search -- RenameEntry (lower bound by original)
  bsearch-rename-pos : List RenameEntry, Text, Integer, Integer -> Integer
  bsearch-rename-pos (entries) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in if text-compare name (list-at entries mid).original <= 0 then bsearch-rename-pos entries name lo mid
      else bsearch-rename-pos entries name (mid + 1) hi

  sorted-rename-insert : List RenameEntry, RenameEntry -> List RenameEntry
  sorted-rename-insert (entries) (entry) =
   list-insert-at entries (bsearch-rename-pos entries (entry.original) 0 (list-length entries)) entry

Section: Apply Rename
  scope-copy-text : Text -> Text
  scope-copy-text (t) =
   if text-length t == 0 then "" else subj-deck-record (substring t 0 (text-length t))

  rename-lookup : List RenameEntry, Text -> Text
  rename-lookup (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-rename-pos entries name 0 len
   in if pos < len then
     if (list-at entries pos).original == name then scope-copy-text ((list-at entries pos).mangled)
     else name
   else name

  is-colliding : SkipListText, Text -> Boolean
  is-colliding (names) (name) =
   skip-list-text-has names name

Section: IR Expression Renaming
  rename-has-entry : List RenameEntry, Text -> Boolean
  rename-has-entry (entries) (name) =
   let len = list-length entries
   in let pos = bsearch-rename-pos entries name 0 len
   in if pos >= len then False
      else (list-at entries pos).original == name

  remove-rename : List RenameEntry, Text -> List RenameEntry
  remove-rename (entries) (name) =
   if rename-has-entry entries name then
    remove-rename-loop entries name 0 (list-length entries) []
   else entries

  remove-rename-loop : List RenameEntry, Text, Integer, Integer, List RenameEntry -> List RenameEntry
  remove-rename-loop (entries) (name) (i) (len) (acc) =
   if i == len then acc
   else let e = list-at entries i
   in if e.original == name then remove-rename-loop entries name (i + 1) len acc
      else remove-rename-loop entries name (i + 1) len (list-push acc e)

  remove-renames-for-params : List RenameEntry, List IRParam, Integer -> List RenameEntry
  remove-renames-for-params (entries) (params) (i) =
   if i == list-length params then entries
   else let p = list-at params i
   in remove-renames-for-params (remove-rename entries (p.name)) params (i + 1)

  rename-ir-expr : List RenameEntry, IRExpr -> IRExpr
  rename-ir-expr (rn) (e) =
   when e
    is IrIntLit (v) (sp) | IrNumLit (v) (sp) | IrTextLit (v) (sp) | IrBoolLit (v) (sp) | IrCharLit (v) (sp) | IrError (msg) (ty) (sp) -> e
    is IrFork (x) (ty) (sp) -> IrFork (rename-ir-expr rn x) ty sp
    is IrAwait (x) (ty) (sp) -> IrAwait (rename-ir-expr rn x) ty sp
    is IrNegate (x) (t) (sp) -> IrNegate (rename-ir-expr rn x) t sp
    is IrName (n) (ty) (sp) -> IrName (rename-lookup rn n) ty sp
    is IrBinary (op) (l) (r) (ty) (sp) -> IrBinary op (rename-ir-expr rn l) (rename-ir-expr rn r) ty sp
    is IrApply (f) (a) (ty) (sp) -> IrApply (rename-ir-expr rn f) (rename-ir-expr rn a) ty sp
    is IrIf (c) (t) (el) (ty) (sp) -> IrIf (rename-ir-expr rn c) (rename-ir-expr rn t) (rename-ir-expr rn el) ty sp
    is IrFieldAccess (rec) (field) (ty) (sp) -> IrFieldAccess (rename-ir-expr rn rec) field ty sp
    is IrLet (nm) (ty) (val) (body) (sp) -> rename-ir-let rn nm ty val body sp
    is IrLambda (params) (body) (ty) (sp) -> rename-ir-lambda rn params body ty sp
    is IrMatch (scrut) (branches) (ty) (sp) -> IrMatch (rename-ir-expr rn scrut) (rename-ir-branches rn branches 0 []) ty sp
    is IrList (elems) (ty) (sp) -> IrList (for e in elems -> rename-ir-expr rn e) ty sp
    is IrRecord (nm) (fields) (ty) (sp) -> IrRecord nm (for f in fields -> IRFieldVal { name = f.name, value = rename-ir-expr rn (f.value), span = f.span }) ty sp
    is IrAct (stmts) (ty) (sp) -> IrAct (rename-ir-act-stmts rn stmts 0 []) ty sp
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> IrHandle eff (rename-ir-expr rn body) (rename-ir-handle-clauses rn clauses 0 []) ty sp
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> IrWithTimeout secs effs scopes (rename-ir-expr rn body) ty sp
    is IrTry (max) (body) (fb) (fail) (ty) (sp) -> IrTry max (rename-ir-act-stmts rn body 0 []) (rename-ir-act-stmts rn fb 0 []) (rename-ir-act-stmts rn fail 0 []) ty sp
    is otherwise -> e

  rename-ir-let : List RenameEntry, Text, CodexType, IRExpr, IRExpr, SourceSpan -> IRExpr
  rename-ir-let (rn) (nm) (ty) (val) (body) (sp) =
   let rn2 = remove-rename rn nm
   in IrLet nm ty (rename-ir-expr rn val) (rename-ir-expr rn2 body) sp

  rename-ir-lambda : List RenameEntry, List IRParam, IRExpr, CodexType, SourceSpan -> IRExpr
  rename-ir-lambda (rn) (params) (body) (ty) (sp) =
   let rn2 = remove-renames-for-params rn params 0
   in IrLambda params (rename-ir-expr rn2 body) ty sp

Section: IR Collection Renaming
  rename-ir-branches : List RenameEntry, List IRBranch, Integer, List IRBranch -> List IRBranch
  rename-ir-branches (rn) (branches) (i) (acc) =
   if i == list-length branches then acc
   else let b = list-at branches i
   in let rn2 = remove-renames-for-pat rn (b.pattern)
   in let b2 = subj-deck-record (__record-set b "body" (rename-ir-expr rn2 (b.body)))
   in let b3 = subj-deck-record (__record-set b2 "guard" (rename-ir-expr rn2 (b.guard)))
   in rename-ir-branches rn branches (i + 1) (list-push acc b3)

  remove-renames-for-pat : List RenameEntry, IRPat -> List RenameEntry
  remove-renames-for-pat (rn) (p) =
   when p
    is IrVarPat (nm) (ty) (sp) -> remove-rename rn nm
    is IrCtorPat (nm) (subs) (ty) (sp) -> remove-renames-for-pats rn subs 0
    is IrVecPat (subs) (ty) (sp) -> remove-renames-for-pats rn subs 0
    is IrLitPat (v) (ty) (sp) | IrWildPat (sp) -> rn

  remove-renames-for-pats : List RenameEntry, List IRPat, Integer -> List RenameEntry
  remove-renames-for-pats (rn) (pats) (i) =
   if i == list-length pats then rn
   else remove-renames-for-pats (remove-renames-for-pat rn (list-at pats i)) pats (i + 1)

  rename-ir-act-stmts : List RenameEntry, List IRActStmt, Integer, List IRActStmt -> List IRActStmt
  rename-ir-act-stmts (rn) (stmts) (i) (acc) =
   if i == list-length stmts then acc
   else let stmt = list-at stmts i
   in when stmt
    is IrDoBind (nm) (ty) (expr) (sp) ->
     let rn2 = remove-rename rn nm
   in rename-ir-act-stmts rn2 stmts (i + 1) (list-push acc (IrDoBind nm ty (rename-ir-expr rn expr) sp))
    is IrDoExec (expr) (sp) ->
     rename-ir-act-stmts rn stmts (i + 1) (list-push acc (IrDoExec (rename-ir-expr rn expr) sp))

  rename-ir-handle-clauses : List RenameEntry, List IRHandleClause, Integer, List IRHandleClause -> List IRHandleClause
  rename-ir-handle-clauses (rn) (clauses) (i) (acc) =
   if i == list-length clauses then acc
   else let c = list-at clauses i
   in let rn2 = remove-rename rn (c.resume-name)
   in let rn3 = remove-clause-param-renames rn2 (c.params) 0 (list-length (c.params))
   in rename-ir-handle-clauses rn clauses (i + 1) (list-push acc (IRHandleClause {
    op-name = c.op-name,
    params = c.params,
    resume-name = c.resume-name,
    body = rename-ir-expr rn3 (c.body),
    span = c.span
   }))

  remove-clause-param-renames : List RenameEntry, List Text, Integer, Integer -> List RenameEntry
  remove-clause-param-renames (rn) (ps) (i) (len) =
   if i >= len then rn
   else remove-clause-param-renames (remove-rename rn (list-at ps i)) ps (i + 1) len

Section: Chapter Scoping Pipeline
  build-all-assignments : Text, List DefHeader, Integer, List ChapterAssignment -> List ChapterAssignment
  build-all-assignments (source) (headers) (i) (acc) =
   if i == list-length headers then acc
   else let hdr = list-at headers i
   in build-all-assignments source headers (i + 1) (list-push acc (ChapterAssignment {
    def-name = token-text (hdr.name),
    chapter-slug = hdr.chapter-slug
   }))

  build-chapter-rename-map : SkipListText, List ChapterAssignment, Text -> List RenameEntry
  build-chapter-rename-map (colliding) (assignments) (cur-chap) =
   build-mod-renames colliding assignments cur-chap 0 (list-length assignments) []

  build-mod-renames : SkipListText, List ChapterAssignment, Text, Integer, Integer, List RenameEntry -> List RenameEntry
  build-mod-renames (colliding) (assignments) (cur-chap) (i) (len) (acc) =
   if i == len then acc
   else let a = list-at assignments i
   in if is-colliding colliding (a.def-name)
      then if a.chapter-slug == cur-chap
           then let cleaned = remove-rename acc (a.def-name)
   in build-mod-renames colliding assignments cur-chap (i + 1) len (sorted-rename-insert cleaned (RenameEntry {
                 original = a.def-name,
                 mangled = mangle-name cur-chap (a.def-name)
                }))
           else if has-rename acc (a.def-name)
                then build-mod-renames colliding assignments cur-chap (i + 1) len acc
                else build-mod-renames colliding assignments cur-chap (i + 1) len (sorted-rename-insert acc (RenameEntry {
                 original = a.def-name,
                 mangled = mangle-name (a.chapter-slug) (a.def-name)
                }))
      else build-mod-renames colliding assignments cur-chap (i + 1) len acc

  build-global-rename-table : List ChapterAssignment, SkipListText -> List RenameEntry
  build-global-rename-table (assignments) (colliding) =
   let pushed = build-global-renames assignments colliding (list-length assignments - 1) (__list-with-capacity (list-length assignments))
   in dedupe-renames (sort-by pushed compare-rename-originals)

 The table is built by a single reversed push pass, one merge sort,
 and an adjacent dedupe - O(n log n). The previous per-entry
 sorted-rename-insert rebuilt the whole immutable list on every
 insert: O(n squared) ALLOCATION, and because the call site runs
 inside subj-deck-record the quadratic garbage landed on the scope deck
 and was retained for the entire compile (~180 MB on the selfhost -
 the largest single retained block in the compiler, found by the
 MEASURE deck-span map). Winner preservation: the old leftmost-equal
 bsearch returned the LAST-inserted duplicate; pushing in reverse
 assignment order and relying on merge-sort stability puts that same
 entry leftmost, and the dedupe keeps it.

  compare-rename-originals : RenameEntry, RenameEntry -> Integer
  compare-rename-originals (a) (b) = text-compare (a.original) (b.original)

  build-global-renames : List ChapterAssignment, SkipListText, Integer, List RenameEntry -> List RenameEntry
  build-global-renames (assignments) (colliding) (i) (acc) =
   if i < 0 then acc
   else let a = list-at assignments i
   in if is-colliding colliding (a.def-name)
      then build-global-renames assignments colliding (i - 1) (list-push acc (RenameEntry {
            original = a.def-name,
            mangled = mangle-name (a.chapter-slug) (a.def-name)
           }))
      else build-global-renames assignments colliding (i - 1) acc

  dedupe-renames : List RenameEntry -> List RenameEntry
  dedupe-renames (entries) =
   dedupe-renames-loop entries 0 (list-length entries) (__list-with-capacity (list-length entries))

  dedupe-renames-loop : List RenameEntry, Integer, Integer, List RenameEntry -> List RenameEntry
  dedupe-renames-loop (entries) (i) (len) (acc) =
   if i == len then acc
   else let e = list-at entries i
   in if i > 0
      then if (list-at entries (i - 1)).original == e.original
           then dedupe-renames-loop entries (i + 1) len acc
           else dedupe-renames-loop entries (i + 1) len (list-push acc e)
      else dedupe-renames-loop entries (i + 1) len (list-push acc e)

  resolve-def-name : List RenameEntry, Text, Text -> Text
  resolve-def-name (renames) (name) (chapter-slug) =
   if rename-has-entry renames name then mangle-name chapter-slug name
   else name

  has-rename : List RenameEntry, Text -> Boolean
  has-rename (entries) (name) =
   rename-has-entry entries name

Section: Duplicate Cite Detection
  cite-selects-name : ACitesDecl, Text -> Boolean
  cite-selects-name (c) (name) =
   cite-selects-name-loop (c.selected-names) name 0 (list-length (c.selected-names))

  cite-selects-name-loop : List Name, Text, Integer, Integer -> Boolean
  cite-selects-name-loop (names) (target) (j) (len) =
   if j == len then False
   else if (list-at names j).value == target then True
   else cite-selects-name-loop names target (j + 1) len

  find-cite-conflict : List ACitesDecl, Text, Text, Integer, Integer -> Text
  find-cite-conflict (citations) (citing) (name) (k) (total) =
   if k == total then ""
   else let c = list-at citations k
   in if c.citing-chapter == citing then if cite-selects-name c name then c.chapter-name.value
     else find-cite-conflict citations citing name (k + 1) total
     else find-cite-conflict citations citing name (k + 1) total

  add-duplicate-cite-error : DiagnosticBag, ACitesDecl, Text, Text -> DiagnosticBag
  add-duplicate-cite-error (bag) (cite) (name-val) (conflict) =
   bag-add bag (make-error cdx-duplicate-cite ("Name '" & name-val & "' is cited from both '" & (cite.chapter-name.value) & "' and '" & conflict & "' in chapter '" & (cite.citing-chapter) & "'") (cite.span))

  check-cite-names : ACitesDecl, Integer, Integer, List ACitesDecl, Integer, Integer, DiagnosticBag -> DiagnosticBag
  check-cite-names (cite) (j) (nlen) (all-citations) (i) (total) (bag) =
   if j == nlen then bag
   else let name = list-at (cite.selected-names) j
   in let conflict = find-cite-conflict all-citations (cite.citing-chapter) (name.value) (i + 1) total
   in let bag2 = if conflict == "" then bag else add-duplicate-cite-error bag cite (name.value) conflict
   in check-cite-names cite (j + 1) nlen all-citations i total bag2

  check-duplicate-cites-loop : List ACitesDecl, Integer, Integer, DiagnosticBag -> DiagnosticBag
  check-duplicate-cites-loop (citations) (i) (len) (bag) =
   if i == len then bag
   else let cite-i = list-at citations i
   in let bag2 = check-cite-names cite-i 0 (list-length (cite-i.selected-names)) citations i len bag
   in check-duplicate-cites-loop citations (i + 1) len bag2

  check-duplicate-cites : List ACitesDecl -> DiagnosticBag
  check-duplicate-cites (citations) =
   check-duplicate-cites-loop citations 0 (list-length citations) empty-bag

 It is an ERROR (CDX3007) since 2026-07-20, and both the warning period
 and the flip were decided by measurement rather than by taste. It began
 as a warning because as an error it would have halted the sign tool and
 three sibling tools -- all citing Foreword chapter Console, all
 assembled without Console.codex, a class the presence check could not
 see while it asked only the per-definition assignments (Console
 declares only effect operations). The header-presence fix
 resolved that whole class, and the warning then measured ZERO
 firings across every population anyone could assemble: all 265 app
 entry units, all 1,154 test units compiled standalone, the selfhost,
 the sign tool, the canary and the plug bundles. A cite that names no
 chapter in the unit is a broken unit, the host resolver already
 refuses the same fact as CDX3010, and with the false-positive class
 gone there is nothing left for a warning to measure.

  chapter-slug-dashes : Text, Integer, Integer -> Integer
  chapter-slug-dashes (s) (i) (len) =
   if i + 1 >= len then -1
   else if char-code-at s i == char-code-at "-" 0 then if char-code-at s (i + 1) == char-code-at "-" 0 then i
     else chapter-slug-dashes s (i + 1) len
     else chapter-slug-dashes s (i + 1) len

  chapter-bare-name : Text -> Text
  chapter-bare-name (s) =
   let p = chapter-slug-dashes s 0 (text-length s)
   in if p < 0 then s else substring s (p + 2) (text-length s - p - 2)

  cite-key-loop : Text, Integer, Integer, List Text -> List Text
  cite-key-loop (s) (i) (len) (acc) =
   if i == len then acc
   else let c = char-code-at s i
   in if c == char-code-at " " 0 then cite-key-loop s (i + 1) len acc
      else if c >= cc-first-upper then if c <= cc-upper-z then cite-key-loop s (i + 1) len (list-push acc (char-to-text (code-to-char (c - 26))))
      else cite-key-loop s (i + 1) len (list-push acc (char-to-text (code-to-char c)))
      else cite-key-loop s (i + 1) len (list-push acc (char-to-text (code-to-char c)))

  cite-key : Text -> Text
  cite-key (s) = text-concat-list (cite-key-loop s 0 (text-length s) [])

  add-missing-cite-error : DiagnosticBag, ACitesDecl -> DiagnosticBag
  add-missing-cite-error (bag) (cite) =
   bag-add bag (make-error cdx-cite-not-in-unit ("Cited chapter '" & (cite.chapter-name.value) & "' of quire '" & (cite.quire.value) & "' is not present in this compilation unit") (cite.span))

  bare-name-present : List Text, Text, Integer, Integer -> Boolean
  bare-name-present (bare-cache) (target) (i) (len) =
   if i == len then False
   else if list-at bare-cache i == target then True
   else bare-name-present bare-cache target (i + 1) len

  check-cites-resolve-loop : List ACitesDecl, List Text, Integer, Integer, DiagnosticBag -> DiagnosticBag
  check-cites-resolve-loop (citations) (bare-cache) (i) (len) (bag) =
   if i == len then bag
   else let cite = list-at citations i
   in if bare-name-present bare-cache (cite-key (cite.chapter-name.value)) 0 (list-length bare-cache)
      then check-cites-resolve-loop citations bare-cache (i + 1) len bag
      else check-cites-resolve-loop citations bare-cache (i + 1) len (add-missing-cite-error bag cite)

  check-cites-resolve : List ACitesDecl, List ChapterAssignment, List Text -> DiagnosticBag
  check-cites-resolve (citations) (assignments) (chapter-names) =
   let from-defs = for a in assignments -> cite-key (chapter-bare-name (a.chapter-slug))
   in let from-headers = for n in chapter-names -> cite-key (chapter-bare-name n)
   in check-cites-resolve-loop citations (subj-deck-record (from-defs & from-headers)) 0 (list-length citations) empty-bag

Section: AST-Level Chapter Scoping
  scope-achapter : AChapter, SkipListText, List ChapterAssignment, Integer -> AChapter
  scope-achapter (ast) (colliding) (assignments) (ceiling) =
   let slug-cache = for a in assignments -> cite-key (a.chapter-slug)
   in let raw-defs = scope-adefs-ll (ast.defs) colliding assignments (ast.citations) slug-cache "" [] 0 [] ceiling
   in subj-deck-record (AChapter {
    name = ast.name,
    defs = subj-deck-record (__linked-list-to-list raw-defs),
    type-defs = ast.type-defs,
    effect-defs = ast.effect-defs,
    class-defs = ast.class-defs,
    instance-defs = ast.instance-defs,
    citations = ast.citations,
    ground-effects = ast.ground-effects,
    chapter-title = ast.chapter-title,
    prose = ast.prose,
    prose-blocks = ast.prose-blocks,
    annotations = ast.annotations,
    section-titles = ast.section-titles,
    rt-names = ast.rt-names,
    rt-budgets = ast.rt-budgets,
    conversions = ast.conversions,
    span = ast.span
   })

  scope-adefs-ll : List ADef, SkipListText, List ChapterAssignment, List ACitesDecl, List Text, Text, List RenameEntry, Integer, LinkedList ADef, Integer -> LinkedList ADef
  scope-adefs-ll (defs) (colliding) (assignments) (citations) (slug-cache) (cur-slug) (cur-rn) (i) (acc) (ceiling) =
   if i == list-length defs then acc
   else if deck-short-of ceiling demand-scope-guard-band then acc
   else let d = list-at defs i
   in let rn = if d.chapter-slug == cur-slug then cur-rn
      else apply-cite-overrides (build-chapter-rename-map colliding assignments (d.chapter-slug)) citations colliding assignments slug-cache (d.chapter-slug) 0
   in let new-name = subj-deck-record (Name { value = rename-lookup rn (d.name.value) })
   in scope-adefs-ll defs colliding assignments citations slug-cache (d.chapter-slug) rn (i + 1) (__linked-list-push acc (subj-deck-record (ADef {
    name = new-name,
    params = d.params,
    declared-type = d.declared-type,
    body = d.body,
    chapter-slug = d.chapter-slug,
    span = d.span
   }))) ceiling

  apply-cite-overrides : List RenameEntry, List ACitesDecl, SkipListText, List ChapterAssignment, List Text, Text, Integer -> List RenameEntry
  apply-cite-overrides (rn) (citations) (colliding) (assignments) (slug-cache) (cur-slug) (i) =
   apply-cite-overrides-loop rn citations colliding assignments slug-cache cur-slug i

  apply-cite-overrides-loop : List RenameEntry, List ACitesDecl, SkipListText, List ChapterAssignment, List Text, Text, Integer -> List RenameEntry
  apply-cite-overrides-loop (rn) (citations) (colliding) (assignments) (slug-cache) (cur-slug) (i) =
   if i == list-length citations then rn
   else let cite = list-at citations i
   in let cite-slug = find-slug-for-cite-name (cite.quire.value) (cite.chapter-name.value) assignments slug-cache
   in let rn2 = apply-cite-selected rn (cite.selected-names) cite-slug colliding assignments cur-slug 0
   in apply-cite-overrides-loop rn2 citations colliding assignments slug-cache cur-slug (i + 1)

 The suffix test compares characters in place. It runs per assignment,
 per citation that misses the composed key, per slug transition of the
 defs walk -- and the walk runs in all four passes, one of which (LOWER)
 retains every byte it allocates until the phase compact. Written with
 `substring`, this one comparison put 5.4 MB per bare-name citation on
 the LOWER deck, about 135 MB of the selfhost's 302.

  slug-has-suffix : Text, Text -> Boolean
  slug-has-suffix (s) (suf) =
   let sl = text-length s
   in let fl = text-length suf
   in if fl > sl then False else slug-suffix-eq s suf (sl - fl) 0 fl

  slug-suffix-eq : Text, Text, Integer, Integer, Integer -> Boolean
  slug-suffix-eq (s) (suf) (base) (j) (fl) =
   if j == fl then True
   else if char-code-at s (base + j) == char-code-at suf j then slug-suffix-eq s suf base (j + 1) fl
   else False

  slug-matches-bare : Text, Text, Text -> Boolean
  slug-matches-bare (s) (bare) (suf) =
   if s == bare then True else slug-has-suffix s suf

  count-bare-matches : Text, Text, List Text, Integer, Integer, Integer -> Integer
  count-bare-matches (bare) (suf) (slug-cache) (i) (len) (n) =
   if i == len then n
   else if slug-matches-bare (list-at slug-cache i) bare suf then count-bare-matches bare suf slug-cache (i + 1) len (n + 1)
      else count-bare-matches bare suf slug-cache (i + 1) len n

  find-slug-bare-loop : Text, Text, List ChapterAssignment, List Text, Integer, Integer -> Text
  find-slug-bare-loop (bare) (suf) (assignments) (slug-cache) (i) (len) =
   if i == len then ""
   else if slug-matches-bare (list-at slug-cache i) bare suf then (list-at assignments i).chapter-slug
      else find-slug-bare-loop bare suf assignments slug-cache (i + 1) len

  find-slug-by-bare-name : Text, List ChapterAssignment, List Text -> Text
  find-slug-by-bare-name (bare) (assignments) (slug-cache) =
   let suf = "--" & bare
   in if count-bare-matches bare suf slug-cache 0 (list-length slug-cache) 0 == 1
      then find-slug-bare-loop bare suf assignments slug-cache 0 (list-length assignments)
      else ""

  find-slug-for-cite-name : Text, Text, List ChapterAssignment, List Text -> Text
  find-slug-for-cite-name (quire) (cite-name) (assignments) (slug-cache) =
   let exact = find-slug-for-cite-name-loop (cite-key (quire & "--" & cite-name)) assignments slug-cache 0 (list-length assignments)
   in if exact == "" then find-slug-by-bare-name (cite-key cite-name) assignments slug-cache
      else exact

  find-slug-for-cite-name-loop : Text, List ChapterAssignment, List Text, Integer, Integer -> Text
  find-slug-for-cite-name-loop (slug-cite) (assignments) (slug-cache) (i) (len) =
   if i == len then ""
   else if list-at slug-cache i == slug-cite then (list-at assignments i).chapter-slug
      else find-slug-for-cite-name-loop slug-cite assignments slug-cache (i + 1) len

  apply-cite-selected : List RenameEntry, List Name, Text, SkipListText, List ChapterAssignment, Text, Integer -> List RenameEntry
  apply-cite-selected (rn) (names) (cite-slug) (colliding) (assignments) (cur-slug) (i) =
   if i == list-length names then rn
   else let n = (list-at names i).value
   in if is-colliding colliding n then if chapter-defines-name assignments cur-slug n
     then apply-cite-selected rn names cite-slug colliding assignments cur-slug (i + 1)
   else let cleaned = remove-rename rn n
   in apply-cite-selected (sorted-rename-insert cleaned (RenameEntry {
      original = n,
      mangled = mangle-name cite-slug n
     })) names cite-slug colliding assignments cur-slug (i + 1)
     else apply-cite-selected rn names cite-slug colliding assignments cur-slug (i + 1)

  chapter-defines-name : List ChapterAssignment, Text, Text -> Boolean
  chapter-defines-name (assignments) (slug) (name) =
   chapter-defines-loop assignments slug name 0 (list-length assignments)

  chapter-defines-loop : List ChapterAssignment, Text, Text, Integer, Integer -> Boolean
  chapter-defines-loop (assignments) (slug) (name) (i) (len) =
   if i == len then False
   else let a = list-at assignments i
   in if a.def-name == name then if a.chapter-slug == slug then True
      else chapter-defines-loop assignments slug name (i + 1) len
      else chapter-defines-loop assignments slug name (i + 1) len

Page 1



Chapter: Parsmi--Name Resolution
  cites Codex chapter Phase Allocator (subj-deck-record, deck-short-of)
  cites Codex chapter Build Settings (max-recursion-depth, demand-scope-guard-band)

Section: Scope
 A scope is two lists. `names` is the chapter-level set -- top-level
 defs + ctors + builtins -- built once before resolving expressions
 and never mutated per-def. `locals` is the per-def set -- function
 params, `let` bindings, lambda params, pattern vars. Splitting them
 prevents the big `names` list (~2000 entries in self-host) from being
 cloned on every local binding via `list-insert-at`: without the split,
 each def's first `scope-add` fell off heap-top and allocated a fresh
 16 KB copy. With locals on their own list, the main `names` is never
 touched after chapter-scope construction.

  mutable Scope = record {
   names : SkipListText,
   locals : SkipListText,
   chapter-renames : List RenameEntry
  }

  empty-scope : Scope = Scope { names = skip-list-text-empty, locals = skip-list-text-empty, chapter-renames = [] }

  scope-has : Scope, Text -> Boolean
  scope-has (sc) (name) =
   if skip-list-text-has (sc.locals) name then True
   else let resolved = rename-lookup (sc.chapter-renames) name
   in skip-list-text-has (sc.names) resolved

  scope-add : Scope, Text -> Scope
  scope-add (sc) (name) =
   let __seq = sc.names = skip-list-text-insert (sc.names) name
   in sc

  scope-add-local : Scope, Text -> Scope
  scope-add-local (sc) (name) =
   let __seq = sc.locals = skip-list-text-insert (sc.locals) name
   in sc

  scope-fork : Scope -> Scope
  scope-fork (sc) =
   Scope { names = sc.names, locals = skip-list-text-clone (sc.locals), chapter-renames = sc.chapter-renames }

Section: Built-in Names

  builtin-names : List Text
  builtin-names = let bs = builtins in builtin-names-from bs 0 (list-length bs) []

Section: Name Classification
  is-type-name : Text -> Boolean
  is-type-name (name) =
   if text-length name == 0 then False
   else is-letter (char-at name 0) & is-upper-char (char-at name 0)

  is-upper-char : Char -> Boolean
  is-upper-char (c) =
   let code = char-code c
   in code >= char-code 'E' & code <= char-code 'Z'

Section: Resolution Result
  ResolveResult = record {
   bag : DiagnosticBag,
   top-level-names : SkipListText,
   type-names : SkipListText,
   ctor-names : List Text
  }

Section: Scope Results
  ResolveScopeResult = record {
   scope : Scope,
   errors : List Diagnostic
  }

  PatResult = record {
   scope : Scope,
   seen : SkipListText,
   errors : List Diagnostic
  }

Section: Collect Names
  collect-top-level-names : List ADef, Integer, Integer, SkipListText, List Diagnostic -> CollectResult
  collect-top-level-names (defs) (i) (len) (acc) (errs) =
   if i == len then subj-deck-record (CollectResult {
    names = acc,
    errors = errs
   })
   else let def = list-at defs i
   in let name = def.name.value
   in if skip-list-text-has acc name
      then collect-top-level-names defs (i + 1) len acc (errs & [make-error cdx-duplicate-definition ("Duplicate definition: " & name) (def.span)])
      else collect-top-level-names defs (i + 1) len (skip-list-text-insert acc name) errs

  CollectResult = record {
   names : SkipListText,
   errors : List Diagnostic
  }

  collect-ctor-names : List ATypeDef, Integer, Integer, SkipListText, SkipListText, List Diagnostic -> CtorCollectResult
  collect-ctor-names (type-defs) (i) (len) (type-acc) (ctor-acc) (errs) =
   if i == len then subj-deck-record (CtorCollectResult {
    type-names = type-acc,
    ctor-names = ctor-acc,
    errors = errs
   })
   else let td = list-at type-defs i
   in when td
     is AVariantTypeDef (name) (params) (ctors) (s) ->
      let dup-check = check-type-name-dup type-acc (name.value) s errs
   in let ctor-result = collect-variant-ctors ctors 0 (list-length ctors) ctor-acc (dup-check.errors)
   in collect-ctor-names type-defs (i + 1) len (dup-check.type-acc) (ctor-result.ctor-acc) (ctor-result.errors)
     is ARecordTypeDef (name) (params) (fields) (is-mut) (s) ->
      let dup-check = check-type-name-dup type-acc (name.value) s errs
   in collect-ctor-names type-defs (i + 1) len (dup-check.type-acc) ctor-acc (dup-check.errors)
     is AUnitTypeDef (name) (base) (s) ->
      let dup-check = check-type-name-dup type-acc (name.value) s errs
   in let unit-ctor-acc = skip-list-text-insert ctor-acc (name.value)
   in collect-ctor-names type-defs (i + 1) len (dup-check.type-acc) unit-ctor-acc (dup-check.errors)

  CtorCollectResult = record {
   type-names : SkipListText,
   ctor-names : SkipListText,
   errors : List Diagnostic
  }

  count-typecheck-units : List ATypeDef, Integer, Integer, Integer -> Integer
  count-typecheck-units (tds) (i) (n) (acc) =
   if i == n then acc
   else let td = list-at tds i
   in let c = when td
      is AVariantTypeDef (name) (params) (ctors) (s) -> list-length ctors
      is ARecordTypeDef (name) (params) (fields) (is-mut) (s) -> 1
      is AUnitTypeDef (name) (base) (s) -> 1
   in count-typecheck-units tds (i + 1) n (acc + c)

  TypeNameDupResult = record {
   type-acc : SkipListText,
   errors : List Diagnostic
  }

  check-type-name-dup : SkipListText, Text, SourceSpan, List Diagnostic -> TypeNameDupResult
  check-type-name-dup (type-acc) (name) (span) (errs) =
   if skip-list-text-has type-acc name then subj-deck-record (TypeNameDupResult {
    type-acc = type-acc,
    errors = errs & [make-error cdx-duplicate-definition ("Duplicate type definition: '" & name & "' is already defined") span]
   })
   else subj-deck-record (TypeNameDupResult {
    type-acc = skip-list-text-insert type-acc name,
    errors = errs
   })

  VariantCtorResult = record {
   ctor-acc : SkipListText,
   errors : List Diagnostic
  }

  collect-variant-ctors : List AVariantCtorDef, Integer, Integer, SkipListText, List Diagnostic -> VariantCtorResult
  collect-variant-ctors (ctors) (i) (len) (acc) (errs) =
   if i == len then subj-deck-record (VariantCtorResult { ctor-acc = acc, errors = errs })
   else let c = list-at ctors i
   in let name = c.name.value
   in if skip-list-text-has acc name
      then collect-variant-ctors ctors (i + 1) len acc (errs & [make-error cdx-duplicate-definition ("Duplicate constructor: '" & name & "' is already defined") (c.span)])
      else collect-variant-ctors ctors (i + 1) len (skip-list-text-insert acc name) errs

Section: Collect Effect Op Names
  EffectOpCollectResult = record {
   op-names : SkipListText,
   errors : List Diagnostic
  }

  collect-effect-op-names : List AEffectDef, SkipListText, SkipListText, Integer, Integer, SkipListText, List Diagnostic -> EffectOpCollectResult
  collect-effect-op-names (effs) (top-names) (ctor-names) (i) (len) (op-acc) (errs) =
   if i == len then subj-deck-record (EffectOpCollectResult { op-names = op-acc, errors = errs })
   else let eff = list-at effs i
   in let after = collect-ops-of-effect (eff.ops) top-names ctor-names 0 (list-length (eff.ops)) op-acc errs
   in collect-effect-op-names effs top-names ctor-names (i + 1) len (after.op-names) (after.errors)

  collect-ops-of-effect : List AEffectOpDef, SkipListText, SkipListText, Integer, Integer, SkipListText, List Diagnostic -> EffectOpCollectResult
  collect-ops-of-effect (ops) (top-names) (ctor-names) (i) (len) (op-acc) (errs) =
   if i == len then subj-deck-record (EffectOpCollectResult { op-names = op-acc, errors = errs })
   else let op = list-at ops i
   in let name = op.name.value
   in let op-is-dup = skip-list-text-has op-acc name
   in let collides = op-is-dup | skip-list-text-has top-names name | skip-list-text-has ctor-names name
   in let new-acc = if op-is-dup then op-acc else skip-list-text-insert op-acc name
   in let new-errs = if collides then errs & [make-error cdx-duplicate-definition ("Effect operation '" & name & "' conflicts with existing name") (op.span)] else errs
   in collect-ops-of-effect ops top-names ctor-names (i + 1) len new-acc new-errs

Section: Build Initial Scope
  build-all-names-scope : SkipListText, SkipListText, List Text -> Scope
  build-all-names-scope (top-names) (ctor-names) (builtins) =
   let top-list = skip-list-text-to-list top-names
   in let sc = add-names-to-scope empty-scope top-list 0 (list-length top-list)
   in let ctor-list = skip-list-text-to-list ctor-names
   in let sc2 = add-names-to-scope sc ctor-list 0 (list-length ctor-list)
   in add-names-to-scope sc2 builtins 0 (list-length builtins)

  add-names-to-scope : Scope, List Text, Integer, Integer -> Scope
  add-names-to-scope (sc) (names) (i) (len) =
   if i == len then sc
   else add-names-to-scope (scope-add sc (list-at names i)) names (i + 1) len

Section: Resolve Expressions
  resolve-expr : Scope, AExpr -> List Diagnostic
  resolve-expr (sc) (expr) = resolve-expr-at sc expr 0

  resolve-expr-at : Scope, AExpr, Integer -> List Diagnostic
  resolve-expr-at (sc) (expr) (depth) =
   if depth >= max-recursion-depth then [make-error cdx-resource-exhausted ("compiler resource exhausted in name-resolver.resolve-expr (budget " & integer-to-text max-recursion-depth & ")") (aexpr-span expr)]
   else when expr
    is ALitExpr (val) (kind) (s) -> []
    is ANameExpr (name) (s) ->
     if scope-has sc (name.value) | is-type-name (name.value) then []
     else [make-error cdx-undefined-name ("Undefined name: " & name.value) s]
    is ABinaryExpr (left) (op) (right) (s) ->
     resolve-expr-at sc left (depth + 1) & resolve-expr-at sc right (depth + 1)
    is AUnaryExpr (operand) (s) -> resolve-expr-at sc operand (depth + 1)
    is AApplyExpr (func) (arg) (s) ->
     resolve-expr-at sc func (depth + 1) & resolve-expr-at sc arg (depth + 1)
    is AIfExpr (cond) (then-e) (else-e) (s) ->
     resolve-expr-at sc cond (depth + 1) & resolve-expr-at sc then-e (depth + 1) & resolve-expr-at sc else-e (depth + 1)
    is ALetExpr (bindings) (body) (s) ->
     resolve-let (scope-fork sc) bindings body
    is ALambdaExpr (params) (body) (s) ->
     let param-result = add-lambda-params sc params 0 (list-length params) s skip-list-text-empty []
     in param-result.errors & resolve-expr-at (param-result.scope) body (depth + 1)
    is AMatchExpr (scrutinee) (arms) (s) ->
     resolve-expr-at sc scrutinee (depth + 1) & resolve-match-arms sc arms 0 (list-length arms) []
    is AListExpr (elems) (s) ->
     resolve-list-elems sc elems 0 (list-length elems) []
    is ARecordExpr (name) (fields) (s) ->
     resolve-record-fields sc fields 0 (list-length fields) []
    is AFieldAccess (obj) (field) (s) -> resolve-expr-at sc obj (depth + 1)
    is AActExpr (stmts) (s) -> resolve-act-stmts (scope-fork sc) stmts 0 (list-length stmts) skip-list-text-empty []
    is AHandleExpr (eff) (body) (clauses) (s) ->
     resolve-expr-at sc body (depth + 1) & resolve-handle-clauses sc clauses 0 (list-length clauses) []
    is AWithTimeoutExpr (timeout) (effs) (scopes) (body) (s) ->
     resolve-expr-at sc body (depth + 1)
    is ATryExpr (max) (body) (fb) (fail) (s) ->
     resolve-try-region sc body & resolve-try-region sc fb & resolve-try-region sc fail
    is AFieldAssignExpr (rec) (field) (val) (s) ->
     resolve-expr-at sc rec (depth + 1) & resolve-expr-at sc val (depth + 1)
    is ALazyExpr (inner) (s) -> resolve-expr-at sc inner (depth + 1)
    is AErrorExpr (msg) (s) -> []
    is AInductionExpr (scrut) (arms) (s) ->
     let sc2 = when scrut is ANameExpr (nm) (ss) -> scope-add-local (scope-fork sc) (nm.value) is otherwise -> sc
     in resolve-match-arms sc2 arms 0 (list-length arms) []

  resolve-try-region : Scope, List AActStmt -> List Diagnostic
  resolve-try-region (sc) (stmts) =
   resolve-act-stmts (scope-fork sc) stmts 0 (list-length stmts) skip-list-text-empty []

  resolve-handle-clauses : Scope, List AHandleClause, Integer, Integer, List Diagnostic -> List Diagnostic
  resolve-handle-clauses (sc) (clauses) (i) (len) (errs) =
   if i == len then errs
   else let c = list-at clauses i
   in let clause-scope = scope-fork sc
   in let sc2 = scope-add-local clause-scope (c.resume-name.value)
   in let resume-seen = skip-list-text-insert skip-list-text-empty (c.resume-name.value)
   in let param-result = scope-add-clause-params sc2 (c.params) 0 (list-length (c.params)) (c.span) resume-seen []
   in let clause-errs = resolve-expr (param-result.scope) (c.body)
   in resolve-handle-clauses sc clauses (i + 1) len (errs & param-result.errors & clause-errs)

  scope-add-clause-params : Scope, List Name, Integer, Integer, SourceSpan, SkipListText, List Diagnostic -> ResolveScopeResult
  scope-add-clause-params (sc) (ps) (i) (len) (clause-span) (seen) (errs) =
   if i >= len then subj-deck-record (ResolveScopeResult { scope = sc, errors = errs })
   else let name = (list-at ps i).value
   in if skip-list-text-has seen name
      then scope-add-clause-params sc ps (i + 1) len clause-span seen (errs & [make-error cdx-duplicate-definition ("Duplicate parameter: '" & name & "'") clause-span])
      else scope-add-clause-params (scope-add-local sc name) ps (i + 1) len clause-span (skip-list-text-insert seen name) errs

Section: Resolve Let

  resolve-let-binds : Scope, List ALetBind, Integer, Integer, SkipListText, List Diagnostic -> List Diagnostic
  resolve-let-binds (sc) (bindings) (i) (len) (seen) (errs) =
   if i == len then errs
   else let b = list-at bindings i
   in let name = b.name.value
   in let bind-errs = resolve-expr sc (b.value)
   in let dup-errs = if skip-list-text-has seen name then [make-error cdx-duplicate-definition ("Duplicate binding: '" & name & "'") (b.span)] else []
   in let sc2 = scope-add-local sc name
   in resolve-let-binds sc2 bindings (i + 1) len (skip-list-text-insert seen name) (errs & bind-errs & dup-errs)

  resolve-let : Scope, List ALetBind, AExpr -> List Diagnostic
  resolve-let (sc) (bindings) (body) =
   let bind-errs = resolve-let-binds sc bindings 0 (list-length bindings) skip-list-text-empty []
   in bind-errs & resolve-expr sc body

Section: Resolve Lambda Parameters
  add-lambda-params : Scope, List Name, Integer, Integer, SourceSpan, SkipListText, List Diagnostic -> ResolveScopeResult
  add-lambda-params (sc) (params) (i) (len) (lam-span) (seen) (errs) =
   if i == len then subj-deck-record (ResolveScopeResult { scope = sc, errors = errs })
   else let name = (list-at params i).value
   in if skip-list-text-has seen name
      then add-lambda-params sc params (i + 1) len lam-span seen (errs & [make-error cdx-duplicate-definition ("Duplicate parameter: '" & name & "'") lam-span])
      else add-lambda-params (scope-add-local sc name) params (i + 1) len lam-span (skip-list-text-insert seen name) errs

Section: Resolve Match Arms
  resolve-match-arms : Scope, List AMatchArm, Integer, Integer, List Diagnostic -> List Diagnostic
  resolve-match-arms (sc) (arms) (i) (len) (errs) =
   if i == len then errs
   else let arm = list-at arms i
   in let arm-scope = scope-fork sc
   in let pat-result = collect-pattern-names arm-scope (arm.pattern)
   in let guard-errs = resolve-expr (pat-result.scope) (arm.guard)
   in let arm-errs = resolve-expr (pat-result.scope) (arm.body)
   in resolve-match-arms sc arms (i + 1) len (errs & pat-result.errors & guard-errs & arm-errs)

  collect-pattern-names : Scope, APat -> ResolveScopeResult
  collect-pattern-names (sc) (pat) =
   let pr = collect-pattern-names-at sc pat 0 skip-list-text-empty []
   in subj-deck-record (ResolveScopeResult { scope = pr.scope, errors = pr.errors })

  collect-pattern-names-at : Scope, APat, Integer, SkipListText, List Diagnostic -> PatResult
  collect-pattern-names-at (sc) (pat) (depth) (seen) (errs) =
   if depth >= max-recursion-depth then subj-deck-record (PatResult { scope = sc, seen = seen, errors = errs })
   else when pat
    is AVarPat (name) (s) ->
     if skip-list-text-has seen (name.value)
     then subj-deck-record (PatResult { scope = sc, seen = seen, errors = errs & [make-error cdx-duplicate-definition ("Duplicate pattern variable: '" & name.value & "'") s] })
     else subj-deck-record (PatResult { scope = scope-add-local sc (name.value), seen = skip-list-text-insert seen (name.value), errors = errs })
    is ACtorPat (name) (subs) (s) -> collect-ctor-pat-names sc subs 0 (list-length subs) (depth + 1) seen errs
    is AVecPat (subs) (s) -> collect-ctor-pat-names sc subs 0 (list-length subs) (depth + 1) seen errs
    is ALitPat (val) (kind) (s) | AWildPat (s) -> subj-deck-record (PatResult { scope = sc, seen = seen, errors = errs })

  collect-ctor-pat-names : Scope, List APat, Integer, Integer, Integer, SkipListText, List Diagnostic -> PatResult
  collect-ctor-pat-names (sc) (subs) (i) (len) (depth) (seen) (errs) =
   if i == len then subj-deck-record (PatResult { scope = sc, seen = seen, errors = errs })
   else let sub = list-at subs i
   in let result = collect-pattern-names-at sc sub depth seen errs
   in collect-ctor-pat-names (result.scope) subs (i + 1) len depth (result.seen) (result.errors)

Section: Resolve List Elements
  resolve-list-elems : Scope, List AExpr, Integer, Integer, List Diagnostic -> List Diagnostic
  resolve-list-elems (sc) (elems) (i) (len) (errs) =
   if i == len then errs
   else let errs2 = resolve-expr sc (list-at elems i)
   in resolve-list-elems sc elems (i + 1) len (errs & errs2)

Section: Resolve Record Fields
  resolve-record-fields : Scope, List AFieldExpr, Integer, Integer, List Diagnostic -> List Diagnostic
  resolve-record-fields (sc) (fields) (i) (len) (errs) =
   if i == len then errs
   else let f = list-at fields i
   in let errs2 = resolve-expr sc (f.value)
   in resolve-record-fields sc fields (i + 1) len (errs & errs2)

Section: Resolve Act Statements
  resolve-act-stmts : Scope, List AActStmt, Integer, Integer, SkipListText, List Diagnostic -> List Diagnostic
  resolve-act-stmts (sc) (stmts) (i) (len) (seen) (errs) =
   if i == len then errs
   else let stmt = list-at stmts i
   in when stmt
     is AActExprStmt (e) (s) ->
      when e
       is ALetExpr (binds) (lbody) (ls) -> resolve-act-let sc binds lbody stmts i len seen errs
       is otherwise ->
        let errs2 = resolve-expr sc e
        in resolve-act-stmts sc stmts (i + 1) len seen (errs & errs2)
     is AActBindStmt (name) (e) (s) ->
      let errs2 = resolve-expr sc e
   in let dup-errs = if skip-list-text-has seen (name.value) then [make-error cdx-duplicate-definition ("Duplicate binding: '" & name.value & "'") s] else []
   in let sc2 = scope-add-local sc (name.value)
   in resolve-act-stmts sc2 stmts (i + 1) len (skip-list-text-insert seen (name.value)) (errs & errs2 & dup-errs)

  resolve-act-let : Scope, List ALetBind, AExpr, List AActStmt, Integer, Integer, SkipListText, List Diagnostic -> List Diagnostic
  resolve-act-let (sc) (binds) (body) (stmts) (i) (len) (seen) (errs) =
   let bind-errs = resolve-let-binds sc binds 0 (list-length binds) skip-list-text-empty []
   in when body
    is ALetExpr (binds2) (body2) (ls2) -> resolve-act-let sc binds2 body2 stmts i len seen (errs & bind-errs)
    is otherwise ->
     let body-errs = resolve-expr sc body
     in resolve-act-stmts sc stmts (i + 1) len seen (errs & bind-errs & body-errs)

Section: Resolve All Definitions

 The ceiling is the SCOPE deck reservation's top, and this loop checks it
 because it is the phase's bulk deck writer -- not through its own records
 but through resolve-expr's pattern path, whose per-pattern-variable
 subj-deck-record wraps the scope and seen skiplist inserts, so every insert
 node lands on the deck: measured 2026-07-21, 53.3 MB of the SCOPE deck's
 56.3 is written under this walk, against 0.3 MB for scope-adefs-ll.
 Guarding only scope-adefs-ll left this walk free to grow through a
 starved reservation into the bivy that holds the scope's own skiplists,
 and the compile died in a divide error inside advance-while-less instead
 of raising CDX9002. A def's resolve writes kilobytes, so a per-definition
 check against an 8 MB band cannot be outrun. The stop returns the
 diagnostics collected so far; compile-desugar-and-scope reads
 deck-short-of again after the walk and raises CDX9002 from there.

  resolve-all-defs : Scope, List ADef, Integer, Integer, List Diagnostic, SkipListText, List ChapterAssignment, List ACitesDecl, List Text, Text, List RenameEntry, Integer -> List Diagnostic
  resolve-all-defs (sc) (defs) (i) (len) (errs) (colliding) (assignments) (citations) (slug-cache) (cur-slug) (cur-chapter-rn) (ceiling) =
   if i == len then errs
   else if deck-short-of ceiling demand-scope-guard-band then errs
   else let def = list-at defs i
   in let chapter-rn = if def.chapter-slug == cur-slug then cur-chapter-rn
      else apply-cite-overrides (build-chapter-rename-map colliding assignments (def.chapter-slug)) citations colliding assignments slug-cache (def.chapter-slug) 0
   in let fresh-scope = Scope { names = sc.names, locals = skip-list-text-empty, chapter-renames = chapter-rn }
   in let param-result = add-def-params fresh-scope (def.params) 0 (list-length (def.params)) []
   in let body-scope = add-forall-binders (param-result.scope) def
   in let errs2 = resolve-expr body-scope (def.body)
   in resolve-all-defs sc defs (i + 1) len (errs & param-result.errors & errs2) colliding assignments citations slug-cache (def.chapter-slug) chapter-rn ceiling

  add-forall-binders : Scope, ADef -> Scope
  add-forall-binders (sc) (def) =
   if list-length (def.declared-type) == 0 then sc
   else add-forall-binder-names sc (list-at (def.declared-type) 0)

  add-forall-binder-names : Scope, ATypeExpr -> Scope
  add-forall-binder-names (sc) (t) =
   when t
    is AForallType (v) (vt) (p) (s) -> add-forall-binder-names (scope-add-local sc (v.value)) p
    is otherwise -> sc

  add-def-params : Scope, List AParam, Integer, Integer, List Diagnostic -> ResolveScopeResult
  add-def-params (sc) (params) (i) (len) (errs) =
   if i == len then subj-deck-record (ResolveScopeResult { scope = sc, errors = errs })
   else let p = list-at params i
   in let name = p.name.value
   in if skip-list-text-has (sc.locals) name
      then add-def-params sc params (i + 1) len (errs & [make-error cdx-duplicate-definition ("Duplicate parameter: '" & name & "'") (p.span)])
      else add-def-params (scope-add-local sc name) params (i + 1) len errs

Section: Resolve Chapter
  resolve-chapter : AChapter, SkipListText, List ChapterAssignment, Integer -> ResolveResult
  resolve-chapter (mod) (colliding) (assignments) (ceiling) =
   resolve-chapter-with-citations mod [] colliding assignments ceiling

  resolve-chapter-with-citations : AChapter, List ResolveResult, SkipListText, List ChapterAssignment, Integer -> ResolveResult
  resolve-chapter-with-citations (mod) (imported) (colliding) (assignments) (ceiling) =
   let top = collect-top-level-names (mod.defs) 0 (list-length (mod.defs)) skip-list-text-empty []
   in let ctors = collect-ctor-names (mod.type-defs) 0 (list-length (mod.type-defs)) skip-list-text-empty skip-list-text-empty []
   in let effect-ops = collect-effect-op-names (mod.effect-defs) (top.names) (ctors.ctor-names) 0 (list-length (mod.effect-defs)) skip-list-text-empty []
   in let cited-names = collect-cited-names imported 0 (list-length imported) skip-list-text-empty
   in let class-method-names = collect-class-method-names-nr (mod.class-defs) 0 (list-length (mod.class-defs)) skip-list-text-empty
   in let dict-placeholder-names = collect-dict-placeholder-names-nr (mod.class-defs) (mod.instance-defs) 0 (list-length (mod.class-defs)) skip-list-text-empty
   in let all-top = skip-list-text-union (skip-list-text-union (skip-list-text-union (skip-list-text-union (skip-list-text-clone (top.names)) (effect-ops.op-names)) cited-names) class-method-names) dict-placeholder-names
   in let sc = build-all-names-scope all-top (ctors.ctor-names) builtin-names
   in let slug-cache = for a in assignments -> cite-key (a.chapter-slug)
   in let expr-errs = resolve-all-defs sc (mod.defs) 0 (list-length (mod.defs)) [] colliding assignments (mod.citations) slug-cache "" [] ceiling
   in let ctor-list = subj-deck-record (skip-list-text-to-list (ctors.ctor-names))
   in subj-deck-record (ResolveResult {
     bag = subj-deck-record (bag-from-list (top.errors & ctors.errors & effect-ops.errors & expr-errs)),
     top-level-names = top.names,
     type-names = ctors.type-names,
     ctor-names = ctor-list
    })

  collect-cited-names : List ResolveResult, Integer, Integer, SkipListText -> SkipListText
  collect-cited-names (results) (i) (len) (acc) =
   if i == len then acc
   else let r = list-at results i
   in let acc2 = skip-list-text-union acc (r.top-level-names)
   in let acc3 = skip-list-text-union acc2 (skip-list-text-from-list (r.ctor-names))
   in collect-cited-names results (i + 1) len acc3

  collect-class-method-names-nr : List AClassDef, Integer, Integer, SkipListText -> SkipListText
  collect-class-method-names-nr (cds) (i) (len) (acc) =
   if i == len then acc
   else let cd = list-at cds i
   in collect-class-method-names-nr cds (i + 1) len (add-class-method-names-nr (cd.methods) 0 (list-length (cd.methods)) acc)

  add-class-method-names-nr : List AEffectOpDef, Integer, Integer, SkipListText -> SkipListText
  add-class-method-names-nr (ops) (i) (len) (acc) =
   if i == len then acc
   else let op = list-at ops i
   in add-class-method-names-nr ops (i + 1) len (skip-list-text-insert acc (op.name.value))

  collect-dict-placeholder-names-nr : List AClassDef, List AInstanceDef, Integer, Integer, SkipListText -> SkipListText
  collect-dict-placeholder-names-nr (cds) (ids) (i) (len) (acc) =
   if i == len then acc
   else let cd = list-at cds i
   in let ic = count-instances-nr ids (cd.name.value) 0 (list-length ids) 0
   in if ic > 1
    then collect-dict-placeholder-names-nr cds ids (i + 1) len (skip-list-text-insert acc ("__dict-of-" & (cd.name.value)))
    else collect-dict-placeholder-names-nr cds ids (i + 1) len acc

  count-instances-nr : List AInstanceDef, Text, Integer, Integer, Integer -> Integer
  count-instances-nr (ids) (cname) (i) (len) (acc) =
   if i == len then acc
   else let id = list-at ids i
   in count-instances-nr ids cname (i + 1) len (if (id.class-name.value) == cname then acc + 1 else acc)

Page 1



Chapter: Parsmi--CodexType Tree

Section: Children Map
  codex-type-map-children : (CodexType -> CodexType), CodexType -> CodexType
  codex-type-map-children (f) (ty) =
   when ty
    is FunTy (param) (row) (ret) -> subj-deck-record (FunTy (f param) row (f ret))
    is ListTy (elem) -> subj-deck-record (ListTy (f elem))
    is LinkedListTy (elem) -> subj-deck-record (LinkedListTy (f elem))
    is ForAllTy (id) (body) -> subj-deck-record (ForAllTy id (f body))
    is ForAllEff (id) (body) -> subj-deck-record (ForAllEff id (f body))
    is EffectfulTy (effs) (sc) (ret) -> subj-deck-record (EffectfulTy effs sc (f ret))
    is ConstructedTy (name) (args) -> subj-deck-record (ConstructedTy name (for a in args -> f a))
    is SumTy (name) (args) (ctors) -> subj-deck-record (SumTy name (for a in args -> f a) (for c in ctors -> subj-deck-record (SumCtor { name = c.name, fields = for fld in (c.fields) -> f fld, return-type = for rt in (c.return-type) -> f rt })))
    is RecordTy (name) (args) (fields) -> subj-deck-record (RecordTy name (for a in args -> f a) (for r in fields -> subj-deck-record (RecordField { name = r.name, type-val = f (r.type-val) })))
    is PropEqTy (a) (b) -> subj-deck-record (PropEqTy (f a) (f b))
    is VectorTy (n) (t) -> subj-deck-record (VectorTy n (f t))
    is VectorMaskTy (n) -> ty
    is TypeApply (tf) (ta) -> subj-deck-record (TypeApply (f tf) (f ta))
    is LinearTy (inner) -> subj-deck-record (LinearTy (f inner))
    is otherwise -> ty

Section: Children Fold
  codex-type-fold-children : (CodexType, a -> a), CodexType, a -> a
  codex-type-fold-children (f) (ty) (acc) =
   when ty
    is FunTy (p) (row) (r) -> f r (f p acc)
    is ListTy (elem) | LinkedListTy (elem) -> f elem acc
    is ForAllTy (id) (body) -> f body acc
    is ForAllEff (id) (body) -> f body acc
    is EffectfulTy (effs) (sc) (ret) -> f ret acc
    is ConstructedTy (name) (args) -> fold-children-list f args 0 (list-length args) acc
    is SumTy (name) (args) (ctors) -> fold-children-sum-ctors f ctors 0 (list-length ctors) (fold-children-list f args 0 (list-length args) acc)
    is RecordTy (name) (args) (fields) -> fold-children-record-fields f fields 0 (list-length fields) (fold-children-list f args 0 (list-length args) acc)
    is PropEqTy (a) (b) -> f b (f a acc)
    is VectorTy (n) (t) -> f t acc
    is VectorMaskTy (n) -> acc
    is TypeApply (tf) (ta) -> f ta (f tf acc)
    is LinearTy (inner) -> f inner acc
    is otherwise -> acc

  fold-children-list : (CodexType, a -> a), List CodexType, Integer, Integer, a -> a
  fold-children-list (f) (xs) (i) (len) (acc) =
   if i == len then acc
   else fold-children-list f xs (i + 1) len (f (list-at xs i) acc)

  fold-children-record-fields : (CodexType, a -> a), List RecordField, Integer, Integer, a -> a
  fold-children-record-fields (f) (fs) (i) (len) (acc) =
   if i == len then acc
   else let r = list-at fs i
   in fold-children-record-fields f fs (i + 1) len (f (r.type-val) acc)

  fold-children-sum-ctors : (CodexType, a -> a), List SumCtor, Integer, Integer, a -> a
  fold-children-sum-ctors (f) (cs) (i) (len) (acc) =
   if i == len then acc
   else let c = list-at cs i
   in fold-children-sum-ctors f cs (i + 1) len (fold-children-list f (c.fields) 0 (list-length (c.fields)) acc)

Page 1


Chapter: Parsmi--Type Environment
  cites Foreword chapter Sort

Section: Environment Type
  TypeEnv = record {
   bindings : List TypeBinding,
   locals : List TypeBinding,
   chapter-renames : List RenameEntry,
   const-ranges : List ConstRange,
   local-ranges : List ConstRange
  }

  TypeBinding = record {
   name : Text,
   bound-type : CodexType
  }

  ConstRange = record {
   name : Text,
   lo : Integer,
   hi : Integer
  }

Section: Construction
  empty-type-env : TypeEnv = TypeEnv { bindings = [], locals = [], chapter-renames = [], const-ranges = [], local-ranges = [] }

Section: Lookup (locals first, then globals)
  env-lookup-in : List TypeBinding, Text -> CodexType
  env-lookup-in (bs) (name) =
   let len = list-length bs
   in if len == 0 then ErrorTy
   else let pos = bsearch-text-pos bs name 0 len
   in if pos >= len then ErrorTy
   else let b = list-at bs pos
   in if b.name == name then b.bound-type else ErrorTy

  env-has-in : List TypeBinding, Text -> Boolean
  env-has-in (bs) (name) =
   let len = list-length bs
   in if len == 0 then False
   else let pos = bsearch-text-pos bs name 0 len
   in if pos >= len then False
      else (list-at bs pos).name == name

  env-lookup : TypeEnv, Text -> CodexType
  env-lookup (env) (name) =
   let llen = list-length (env.locals)
   in let lpos = bsearch-text-pos (env.locals) name 0 llen
   in if lpos < llen
      then let lb = list-at (env.locals) lpos
           in if lb.name == name then lb.bound-type
              else env-lookup-in (env.bindings) name
      else env-lookup-in (env.bindings) name

  env-has : TypeEnv, Text -> Boolean
  env-has (env) (name) =
   let llen = list-length (env.locals)
   in let lpos = bsearch-text-pos (env.locals) name 0 llen
   in if lpos < llen
      then if (list-at (env.locals) lpos).name == name then True
           else env-has-in (env.bindings) name
      else env-has-in (env.bindings) name

Section: Unsorted Membership (linear scan, for use before env-finalize)
  env-has-linear-in : List TypeBinding, Text, Integer, Integer -> Boolean
  env-has-linear-in (bs) (name) (i) (len) =
   if i == len then False
   else if (list-at bs i).name == name then True
        else env-has-linear-in bs name (i + 1) len

  env-has-unsorted : TypeEnv, Text -> Boolean
  env-has-unsorted (env) (name) =
   env-has-linear-in (env.bindings) name 0 (list-length (env.bindings))

Section: Bind (unsorted accumulation -- call env-finalize before lookup)
  env-replace-in : List TypeBinding, Text, CodexType, Integer, Integer -> List TypeBinding
  env-replace-in (bs) (name) (ty) (i) (len) =
   if i >= len then list-push bs (subj-deck-record (TypeBinding { name = name, bound-type = ty }))
   else if (list-at bs i).name == name then list-set-at bs i (subj-deck-record (TypeBinding { name = name, bound-type = ty }))
   else env-replace-in bs name ty (i + 1) len

  env-bind : TypeEnv, Text, CodexType -> TypeEnv
  env-bind (env) (name) (ty) =
   let bs = env.bindings
   in __record-set env "bindings" (env-replace-in bs name ty 0 (list-length bs))

 Cost is one 5-field record plus a copy of (locals + 1) per bind.
 `check-all-defs` resets `locals` per def, so the copy is bounded by one
 def's binders in scope, not by the unit.

  env-bind-local : TypeEnv, Text, CodexType -> TypeEnv
  env-bind-local (env) (name) (ty) =
   let len = list-length (env.locals)
   in let pos = bsearch-text-pos (env.locals) name 0 len
   in subj-deck-record (TypeEnv {
    bindings = env.bindings,
    locals = list-insert-at (copy-list-with-headroom (env.locals) 1) pos (subj-deck-record (TypeBinding {
     name = name,
     bound-type = ty
    })),
    chapter-renames = env.chapter-renames,
    const-ranges = env.const-ranges,
    local-ranges = env.local-ranges
   })

Section: Constant Ranges (proven values of literal-defined constants)

 The table is appended during def registration and scanned linearly,
 but only on the narrowing lint's would-warn path, so the scan cost
 is bounded by the handful of stores that fail the type-range check.

  env-add-const-range : TypeEnv, Text, Integer -> TypeEnv
  env-add-const-range (env) (name) (value) =
   __record-set env "const-ranges" (list-push (env.const-ranges) (subj-deck-record (ConstRange {
    name = name,
    lo = value,
    hi = value
   })))

  env-const-find : List ConstRange, Text, Integer, Integer -> Integer
  env-const-find (cs) (name) (i) (len) =
   if i == len then 0 - 1
   else if (list-at cs i).name == name then i
   else env-const-find cs name (i + 1) len

  env-is-local : TypeEnv, Text -> Boolean
  env-is-local (env) (name) =
   let llen = list-length (env.locals)
   in let lpos = bsearch-text-pos (env.locals) name 0 llen
   in if lpos < llen then (list-at (env.locals) lpos).name == name
   else False

  env-add-local-range : TypeEnv, Text, Integer, Integer -> TypeEnv
  env-add-local-range (env) (name) (lo) (hi) =
   subj-deck-record (TypeEnv {
    bindings = env.bindings,
    locals = env.locals,
    chapter-renames = env.chapter-renames,
    const-ranges = env.const-ranges,
    local-ranges = subj-deck-record (ConstRange { name = name, lo = lo, hi = hi }) :: (env.local-ranges)
   })

  env-local-find : List ConstRange, Text, Integer, Integer -> Integer
  env-local-find (cs) (name) (i) (len) =
   if i == len then 0 - 1
   else if (list-at cs i).name == name then i
   else env-local-find cs name (i + 1) len

Section: Finalize (sort bindings for bsearch lookup)
  compare-type-binding-names : TypeBinding, TypeBinding -> Integer
  compare-type-binding-names (a) (b) = text-compare (a.name) (b.name)

  env-finalize : TypeEnv -> TypeEnv
  env-finalize (env) =
   __record-set env "bindings" (sort-by (env.bindings) compare-type-binding-names)

Section: Builtins

  identity-admin-row : EffectRow
  identity-admin-row = EffectRow {
   labels = [
    EffectLabel { name = Name { value = "Identity" }, scope = "" },
    EffectLabel { name = Name { value = "Capability" }, scope = "" }
   ],
   tail-name = "",
   tail-id = __narrow (-1)
  }

  builtin-type-env : TypeEnv
  builtin-type-env = let bs = builtins in builtin-env-fold bs 0 (list-length bs) empty-type-env

  builtin-env-fold : List BuiltinSpec, Integer, Integer, TypeEnv -> TypeEnv
  builtin-env-fold (bs) (i) (len) (env) =
   if i >= len then env
   else let b = list-at bs i
   in when b.bs-type
    is Just (ty) -> builtin-env-fold bs (i + 1) len (env-bind env (b.bs-name) ty)
    is otherwise -> builtin-env-fold bs (i + 1) len env

Page 1



Chapter: Parsmi--Unification
  cites Foreword chapter Sort
  cites Codex chapter Build Settings (max-recursion-depth)
  cites Foreword chapter Tuple
  cites Foreword chapter MathLib (int-widen)

 Row variables have their own id space and their own substitution
 table: rows are not CodexTypes, so a type position can never resolve
 to a row nor a row to a type, and a row id can never be confused
 with a type-variable id because no operation accepts both. The table
 is dense -- slot i holds the binding for row id i, unbound slots hold
 the self-row (row-var i), mirroring the TypeVar self-slot trick -- so
 lookup is a direct index. Stage 3 mints a row variable per
 application site; an association list here would make resolution
 quadratic in program size. Row ids share the 32-bit bound ruling
 with type-variable ids. The table grows on first binding past its
 length (fresh ids alone allocate nothing); an index past the end
 reads as unbound.

Section: State
  ExprTypeEntry = record {
   key : Integer,
   ty : CodexType
  }

  mutable UnificationState = record {
   substitutions : List CodexType,
   row-substitutions : List EffectRow,
   next-id : Integer between 0 and 4294967295,
   next-row-id : Integer between 0 and 4294967295,
   bag : DiagnosticBag,
   expr-types : List ExprTypeEntry,
   effect-exempt : Boolean,
   scope-grants : List EffectLabel,
   chapter-grounds : List Text
  }

Section: Construction
  empty-unification-state : UnificationState
  empty-unification-state =
   UnificationState {
    substitutions = subj-deck-record [subj-deck-record (TypeVar 0), subj-deck-record (TypeVar 1)],
    row-substitutions = [],
    next-id = 2,
    next-row-id = 0,
    bag = empty-bag,
    expr-types = [],
    effect-exempt = False,
    scope-grants = [],
    chapter-grounds = []
   }

Section: Fresh Variables
  fresh-var : UnificationState -> CodexType
  fresh-var (st) =
   TypeVar (st.next-id)

  advance-id : UnificationState -> UnificationState
  advance-id (st) =
   let new-subs = list-push (st.substitutions) (subj-deck-record (TypeVar (st.next-id)))
   in let new-id = st.next-id + 1
   in let __seq = st.substitutions = new-subs
   in let __seq = st.next-id = new-id
   in st

  fresh-and-advance : UnificationState -> (CodexType, UnificationState)
  fresh-and-advance (st) =
   (TypeVar (st.next-id), advance-id st)

 next-row-id is declared 0..4294967295 and a type argument is invariant, so
 the pair below would otherwise be a Tup2 carrying those bounds. Widening
 HERE rather than declaring the narrow type in the signature keeps all
 eleven call sites seeing a plain Integer; declaring it narrow pushes the
 bounds out to every caller and moves the mismatch rather than fixing it.

  fresh-row-id : UnificationState -> (Integer, UnificationState)
  fresh-row-id (st) =
   let id = st.next-row-id
   in let __seq = st.next-row-id = __narrow (id + 1)
   in (int-widen id, st)

Section: Fuel Budget

 Recursive type-level operations cap at max-recursion-depth stack
 frames. A legitimate AST is nowhere near that deep; exceeding this
 bound means a bypassed occurs-check, a substitution cycle, or an
 adversarial input. Emit CDX9001 and bail rather than stack-overflow.

Section: Resolve

  resolve-silent : UnificationState, CodexType -> CodexType
  resolve-silent (st) (ty) = resolve-silent-at st ty 0

  resolve-silent-at : UnificationState, CodexType, Integer -> CodexType
  resolve-silent-at (st) (ty) (depth) =
   if depth >= max-recursion-depth then ErrorTy
   else when ty
    is TypeVar (id) ->
     if id >= list-length (st.substitutions) then ty
     else let slot = list-at (st.substitutions) id
     in if slot-is-unbound slot id then ty else resolve-silent-at st slot (depth + 1)
    is otherwise -> ty

  slot-is-unbound : CodexType, Integer -> Boolean
  slot-is-unbound (slot) (id) =
   when slot
    is TypeVar (slot-id) -> slot-id == id
    is otherwise -> False

Section: Add Substitution
  add-subst : UnificationState, Integer, CodexType -> UnificationState
  add-subst (st) (var-id) (ty) =
   let __seq = st.substitutions = list-set-at (st.substitutions) var-id ty
   in st

Section: Expr Types

 Records per-expression resolved types keyed by span, for lowering to
 consult after type-checking finishes. Spans are keyed as a composite
 integer packed as file-id (16 bits) | start offset (32 bits) | span
 length capped at 65535 (16 bits) - an exact 64-bit fit. The previous
 decimal packing multiplied by 1e6 with the raw end offset in the low
 field; any source past one megabyte overflowed the field and bled
 into the start digits, silently aliasing distinct spans and
 shadowing entries behind the binary search. Entries are appended
 unsorted during type-checking via list-push (O(1) per call), then
 merge-sorted once at the check-lower boundary via sort-expr-types
 (O(N log N)). Lookup after sort is O(log N) via binary search.
 Populated only from narrow inference sites (ANameExpr, ARecordExpr).

  expr-type-key : SourceSpan -> Integer
  expr-type-key (sp) =
   let len = sp.end.offset - sp.start.offset
   in let capped = if len > 65535 then 65535 else if len < 0 then 0 else len
   in sp.file-id * 281474976710656 + sp.start.offset * 65536 + capped

  bsearch-expr-type-pos : List ExprTypeEntry, Integer, Integer, Integer -> Integer
  bsearch-expr-type-pos (entries) (k) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-key = (list-at entries mid).key
   in if k <= mid-key then bsearch-expr-type-pos entries k lo mid
      else bsearch-expr-type-pos entries k (mid + 1) hi

  record-expr-type : UnificationState, SourceSpan, CodexType -> UnificationState
  record-expr-type (st) (sp) (ty) =
   if is-synthetic-span sp then st
   else let k = expr-type-key sp
   in let __seq = st.expr-types = list-push (st.expr-types) (subj-deck-record (ExprTypeEntry { key = k, ty = ty }))
   in st

  compare-expr-type-keys : ExprTypeEntry, ExprTypeEntry -> Integer
  compare-expr-type-keys (a) (b) =
   if a.key < b.key then (0 - 1) else if a.key > b.key then 1 else 0

  sort-expr-types : List ExprTypeEntry -> List ExprTypeEntry
  sort-expr-types (xs) = sort-by xs compare-expr-type-keys

  lookup-expr-type : UnificationState, SourceSpan -> CodexType
  lookup-expr-type (st) (sp) =
   if is-synthetic-span sp then ErrorTy
   else let k = expr-type-key sp
   in let entries = st.expr-types
   in let len = list-length entries
   in let pos = bsearch-expr-type-pos entries k 0 len
   in if pos < len
      then if (list-at entries pos).key == k
           then (list-at entries pos).ty
           else ErrorTy
      else ErrorTy

Section: Add Error
  add-unify-error : UnificationState, Integer between 0 and 65535, Text, SourceSpan -> UnificationState
  add-unify-error (st) (code) (msg) (span) =
   let __seq = st.bag = bag-add (st.bag) (make-error code msg span)
   in st

  add-fuel-error : UnificationState, Text, SourceSpan -> UnificationState
  add-fuel-error (st) (op) (span) =
   add-unify-error st cdx-resource-exhausted ("compiler resource exhausted in unifier." & op & " (budget " & integer-to-text max-recursion-depth & ")") span

Section: Occurs Check
  occurs-in : UnificationState, Integer, CodexType, Integer -> Boolean
  occurs-in (st) (var-id) (ty) (depth) =
   if depth >= max-recursion-depth then True
   else let resolved = resolve-silent st ty
   in when resolved
    is TypeVar (id) -> id == var-id
    is FunTy (param) (row) (ret) -> occurs-in st var-id param (depth + 1) | occurs-in st var-id ret (depth + 1)
    is ListTy (elem) | LinkedListTy (elem) -> occurs-in st var-id elem (depth + 1)
    is TypeApply (tf) (ta) -> occurs-in st var-id tf (depth + 1) | occurs-in st var-id ta (depth + 1)
    is LinearTy (inner) -> occurs-in st var-id inner (depth + 1)
    is otherwise -> False

Section: Effect Row Substitution

  label-compare : EffectLabel, EffectLabel -> Integer
  label-compare (a) (b) =
   let nc = text-compare (a.name.value) (b.name.value)
   in if nc /= 0 then nc else text-compare (a.scope) (b.scope)

  insert-label-sorted : List EffectLabel, EffectLabel, Integer, Integer, List EffectLabel, Boolean -> List EffectLabel
  insert-label-sorted (xs) (x) (i) (len) (acc) (placed) =
   if i == len then if placed then acc else list-push acc x
   else let cur = list-at xs i
   in let c = label-compare x cur
   in if placed then insert-label-sorted xs x (i + 1) len (list-push acc cur) True
      else if c == 0 then insert-label-sorted xs x (i + 1) len (list-push acc cur) True
      else if c < 0 then insert-label-sorted xs x (i + 1) len (list-push (list-push acc x) cur) True
      else insert-label-sorted xs x (i + 1) len (list-push acc cur) False

  sort-labels-canonical : List EffectLabel, Integer, Integer, List EffectLabel -> List EffectLabel
  sort-labels-canonical (xs) (i) (len) (acc) =
   if i == len then acc
   else sort-labels-canonical xs (i + 1) len (insert-label-sorted acc (list-at xs i) 0 (list-length acc) [] False)

  make-row : List EffectLabel, Text, Integer -> EffectRow
  make-row (labels) (tname) (tid) =
   subj-deck-record (EffectRow { labels = subj-deck-record (sort-labels-canonical labels 0 (list-length labels) []), tail-name = tname, tail-id = __narrow tid })

  labels-equal : List EffectLabel, List EffectLabel -> Boolean
  labels-equal (xs) (ys) =
   if list-length xs /= list-length ys then False
   else labels-equal-loop xs ys 0 (list-length xs)

  labels-equal-loop : List EffectLabel, List EffectLabel, Integer, Integer -> Boolean
  labels-equal-loop (xs) (ys) (i) (len) =
   if i == len then True
   else if label-compare (list-at xs i) (list-at ys i) == 0 then labels-equal-loop xs ys (i + 1) len
   else False

  labels-minus : List EffectLabel, List EffectLabel -> List EffectLabel
  labels-minus (xs) (ys) =
   labels-minus-merge xs ys 0 0 (list-length xs) (list-length ys) []

  labels-minus-merge : List EffectLabel, List EffectLabel, Integer, Integer, Integer, Integer, List EffectLabel -> List EffectLabel
  labels-minus-merge (xs) (ys) (i) (j) (xlen) (ylen) (acc) =
   if i == xlen then acc
   else if j == ylen then labels-minus-merge xs ys (i + 1) j xlen ylen (list-push acc (list-at xs i))
   else let c = label-compare (list-at xs i) (list-at ys j)
   in if c == 0 then labels-minus-merge xs ys (i + 1) (j + 1) xlen ylen acc
      else if c < 0 then labels-minus-merge xs ys (i + 1) j xlen ylen (list-push acc (list-at xs i))
      else labels-minus-merge xs ys i (j + 1) xlen ylen acc

  row-slot-unbound : EffectRow, Integer -> Boolean
  row-slot-unbound (slot) (id) =
   slot.tail-id == id & list-length (slot.labels) == 0

  grow-row-substs : List EffectRow, Integer, Integer -> List EffectRow
  grow-row-substs (entries) (len) (want) =
   if len > want then entries
   else grow-row-substs (list-push entries (subj-deck-record (row-var len))) (len + 1) want

  add-row-subst : UnificationState, Integer, EffectRow -> UnificationState
  add-row-subst (st) (id) (row) =
   let grown = grow-row-substs (st.row-substitutions) (list-length (st.row-substitutions)) id
   in let __seq = st.row-substitutions = list-set-at grown id row
   in st

  resolve-row : UnificationState, EffectRow -> EffectRow
  resolve-row (st) (row) = resolve-row-at st row 0

  resolve-row-at : UnificationState, EffectRow, Integer -> EffectRow
  resolve-row-at (st) (row) (depth) =
   if depth >= max-recursion-depth then row
   else if row.tail-id < 0 then row
   else let entries = st.row-substitutions
   in if row.tail-id >= list-length entries then row
   else let slot = list-at entries (row.tail-id)
   in if row-slot-unbound slot (row.tail-id) then row
   else let bound = resolve-row-at st slot (depth + 1)
   in make-row ((row.labels) & (bound.labels)) (bound.tail-name) (bound.tail-id)

  row-occurs : UnificationState, Integer, EffectRow, Integer -> Boolean
  row-occurs (st) (tid) (row) (depth) =
   if depth >= max-recursion-depth then True
   else if row.tail-id < 0 then False
   else if row.tail-id == tid then True
   else let entries = st.row-substitutions
   in if row.tail-id >= list-length entries then False
   else let slot = list-at entries (row.tail-id)
   in if row-slot-unbound slot (row.tail-id) then False
   else row-occurs st tid slot (depth + 1)

  row-desc : EffectRow -> Text
  row-desc (row) =
   "[" & row-desc-labels (row.labels) 0 (list-length (row.labels)) & row-desc-tail row (list-length (row.labels) > 0) & "]"

  row-desc-labels : List EffectLabel, Integer, Integer -> Text
  row-desc-labels (labels) (i) (len) =
   if i == len then ""
   else let l = list-at labels i
   in let prefix = if i == 0 then "" else ", "
   in let scope-part = if text-length (l.scope) > 0 then " \"" & (l.scope) & "\"" else ""
   in prefix & (l.name.value) & scope-part & row-desc-labels labels (i + 1) len

  row-desc-tail : EffectRow, Boolean -> Text
  row-desc-tail (row) (have-labels) =
   if row.tail-id < 0 then ""
   else let sep = if have-labels then ", " else ""
   in if text-length (row.tail-name) > 0 then sep & (row.tail-name)
      else sep & "e" & integer-to-text (row.tail-id)

Section: Row Unification

 unify-row implements the ACI1 set-row algorithm: resolve both
 rows, cancel shared labels with one sorted
 merge, then case on the tails. Label equality is EXACT -- the dotted
 sub-effect lattice lives only in the directed row-le check (stage
 3), never in symmetric unification. Under payload-free labels and
 at most one tail per row this produces a unifier that is most
 general up to ACI1 equivalence: the only candidate divergence --
 re-adding a shared label into both tails -- is collapsed by
 idempotence.

  rows-identical : EffectRow, EffectRow -> Boolean
  rows-identical (a) (b) =
   a.tail-id == b.tail-id & labels-equal (a.labels) (b.labels)

  row-mismatch-msg : EffectRow, EffectRow -> Text
  row-mismatch-msg (a) (b) =
   "cannot reconcile effect rows " & row-desc a & " and " & row-desc b & ": an effect on one side is not allowed by the other"

  unify-row : UnificationState, EffectRow, EffectRow, SourceSpan -> (Boolean, UnificationState)
  unify-row (st) (r1) (r2) (span) =
   let a = resolve-row st r1
   in let b = resolve-row st r2
   in if rows-identical a b then (True, st)
   else let only1 = labels-minus (a.labels) (b.labels)
   in let only2 = labels-minus (b.labels) (a.labels)
   in if a.tail-id < 0 & b.tail-id < 0 then unify-row-both-closed st a b only1 only2 span
   else if a.tail-id >= 0 & b.tail-id < 0 then unify-row-open-closed st a only1 only2 b span
   else if a.tail-id < 0 & b.tail-id >= 0 then unify-row-open-closed st b only2 only1 a span
   else if a.tail-id == b.tail-id then unify-row-both-closed st a b only1 only2 span
   else unify-row-open-open st a b only1 only2 span

  unify-row-both-closed : UnificationState, EffectRow, EffectRow, List EffectLabel, List EffectLabel, SourceSpan -> (Boolean, UnificationState)
  unify-row-both-closed (st) (a) (b) (only1) (only2) (span) =
   if list-length only1 == 0 & list-length only2 == 0 then (True, st)
   else (False, add-unify-error st cdx-row-mismatch (row-mismatch-msg a b) span)

  unify-row-open-closed : UnificationState, EffectRow, List EffectLabel, List EffectLabel, EffectRow, SourceSpan -> (Boolean, UnificationState)
  unify-row-open-closed (st) (open-r) (open-only) (closed-only) (closed-r) (span) =
   if list-length open-only /= 0 then (False, add-unify-error st cdx-row-mismatch (row-mismatch-msg open-r closed-r) span)
   else (True, add-row-subst st (open-r.tail-id) (make-row closed-only "" (-1)))

 row-union joins two ambient rows (the effects a compound expression
 performs = the union of what its parts perform). A representable
 row has at most one tail, so joining two open rows with distinct
 tails EQUATES them (bind t1 := {| t2}) -- the Koka shared-ambient
 move: every performing site inside one body ends up sharing one
 effect variable. That over-approximates (sound direction, section
 2) and never fails: both tails are unbound after resolution and
 distinct, so no occurs violation is possible. An empty operand
 returns the other unchanged -- the all-pure case allocates nothing.

  row-union : UnificationState, EffectRow, EffectRow -> (EffectRow, UnificationState)
  row-union (st) (r1) (r2) =
   let a = resolve-row st r1
   in let b = resolve-row st r2
   in if row-is-empty a then (b, st)
   else if row-is-empty b then (a, st)
   else if rows-identical a b then (a, st)
   else let merged = (a.labels) & (b.labels)
   in if a.tail-id < 0 then (make-row merged (b.tail-name) (b.tail-id), st)
   else if b.tail-id < 0 then (make-row merged (a.tail-name) (a.tail-id), st)
   else if a.tail-id == b.tail-id then (make-row merged (a.tail-name) (a.tail-id), st)
   else let st2 = add-row-subst st (a.tail-id) (subj-deck-record (row-var (b.tail-id)))
   in (make-row merged (b.tail-name) (b.tail-id), st2)

  unify-row-open-open : UnificationState, EffectRow, EffectRow, List EffectLabel, List EffectLabel, SourceSpan -> (Boolean, UnificationState)
  unify-row-open-open (st) (a) (b) (only1) (only2) (span) =
   let (t3, st2) = fresh-row-id st
   in let bind-a = make-row only2 "" t3
   in let bind-b = make-row only1 "" t3
   in if row-occurs st2 (a.tail-id) bind-a 0 | row-occurs st2 (b.tail-id) bind-b 0
      then (False, add-unify-error st2 cdx-row-infinite "effect row would be infinite (a row variable absorbs itself)" span)
      else (True, add-row-subst (add-row-subst st2 (a.tail-id) bind-a) (b.tail-id) bind-b)

Section: Unify
 The `inv` flag threaded from here down means "this pair sits in a type
 ARGUMENT position", where `docs/DevelopersGuide.md` "Variance of Type
 Arguments" requires the two types to be the same rather than merely
 compatible. It is set at the argument positions below and never cleared,
 so nesting inside an argument stays invariant. Everything reached with it
 False keeps the assignability the language has always had.

  unify : UnificationState, CodexType, CodexType, SourceSpan -> (Boolean, UnificationState)
  unify (st) (a) (b) (span) =
   unify-at st a b span 0 False

  unify-at : UnificationState, CodexType, CodexType, SourceSpan, Integer, Boolean -> (Boolean, UnificationState)
  unify-at (st) (a) (b) (span) (depth) (inv) =
   if depth >= max-recursion-depth then (False, add-fuel-error st "unify" span)
   else let ra = strip-linear-ty (resolve-silent st a)
   in let rb = strip-linear-ty (resolve-silent st b)
   in unify-resolved st ra rb span (depth + 1) inv

  unify-resolved : UnificationState, CodexType, CodexType, SourceSpan, Integer, Boolean -> (Boolean, UnificationState)
  unify-resolved (st) (a) (b) (span) (depth) (inv) =
   if types-equal a b then (True, st)
   else when a
    is TypeVar (id-a) -> when b
     is TypeVar (id-b) ->
      if id-a < id-b
       then (True, add-subst st id-b a)
       else (True, add-subst st id-a b)
     is otherwise ->
      if occurs-in st id-a b 0 then (False, add-unify-error st cdx-infinite-type "Infinite type" span)
       else (True, add-subst st id-a b)
    is otherwise -> unify-rhs st a b span depth inv

  types-equal : CodexType, CodexType -> Boolean
  types-equal (a) (b) =
   when a
    is TypeVar (id-a) -> when b
     is TypeVar (id-b) -> id-a == id-b
     is otherwise -> False
    is IntegerTy (a-lo) (a-hi) (a-mode) -> when b
     is IntegerTy (b-lo) (b-hi) (b-mode) -> a-lo == b-lo & a-hi == b-hi
     is otherwise -> False
    is RealTy (a-w) (a-m) -> when b
     is RealTy (b-w) (b-m) -> real-width-eq a-w b-w & real-mode-eq a-m b-m
     is otherwise -> False
    is TextTy -> when b
     is TextTy -> True
     is otherwise -> False
    is BooleanTy -> when b
     is BooleanTy -> True
     is otherwise -> False
    is CharTy -> when b
     is CharTy -> True
     is otherwise -> False
    is NothingTy -> when b
     is NothingTy -> True
     is otherwise -> False
    is VoidTy -> when b
     is VoidTy -> True
     is otherwise -> False
    is ProofTy -> when b
     is ProofTy | PropEqTy (b1) (b2) -> True
     is otherwise -> False
    is PropEqTy (a1) (a2) -> when b
     is PropEqTy (b1) (b2) -> types-equal a1 b1 & types-equal a2 b2
     is ProofTy -> True
     is otherwise -> False
    is ErrorTy -> when b
     is ErrorTy -> True
     is otherwise -> False
    is UnitTy (na) (inner-a) -> when b
     is UnitTy (nb) (inner-b) -> na.value == nb.value & types-equal inner-a inner-b
     is otherwise -> False
    is VectorTy (na) (ta) -> when b
     is VectorTy (nb) (tb) -> na == nb & types-equal ta tb
     is otherwise -> False
    is VectorMaskTy (na) -> when b
     is VectorMaskTy (nb) -> na == nb
     is otherwise -> False
    is TypeCon (na) -> when b
     is TypeCon (nb) -> na.value == nb.value
     is otherwise -> False
    is TypeApply (fa) (aa) -> when b
     is TypeApply (fb) (ab) -> types-equal fa fb & types-equal aa ab
     is otherwise -> False
    is FunTy (pa) (rwa) (ra) -> when b
     is FunTy (pb) (rwb) (rb) -> types-equal pa pb & rows-identical rwa rwb & types-equal ra rb
     is otherwise -> False
    is ListTy (ea) -> when b
     is ListTy (eb) -> types-equal ea eb
     is otherwise -> False
    is LinkedListTy (ea) -> when b
     is LinkedListTy (eb) -> types-equal ea eb
     is otherwise -> False
    is LinearTy (ia) -> when b
     is LinearTy (ib) -> types-equal ia ib
     is otherwise -> False
    is ForAllTy (id-a) (body-a) -> when b
     is ForAllTy (id-b) (body-b) -> id-a == id-b & types-equal body-a body-b
     is otherwise -> False
    is ForAllEff (id-a) (body-a) -> when b
     is ForAllEff (id-b) (body-b) -> id-a == id-b & types-equal body-a body-b
     is otherwise -> False
    is SumTy (na) (args-a) (ctors-a) -> when b
     is SumTy (nb) (args-b) (ctors-b) -> na.value == nb.value & type-lists-equal args-a args-b
     is otherwise -> False
    is RecordTy (na) (args-a) (fields-a) -> when b
     is RecordTy (nb) (args-b) (fields-b) -> na.value == nb.value & type-lists-equal args-a args-b
     is otherwise -> False
    is ConstructedTy (na) (args-a) -> when b
     is ConstructedTy (nb) (args-b) -> na.value == nb.value & type-lists-equal args-a args-b
     is otherwise -> False
    is EffectfulTy (ea) (sa) (ia) -> when b
     is EffectfulTy (eb) (sb) (ib) -> name-sets-equal ea eb & types-equal ia ib
     is otherwise -> False
    is otherwise -> False

  type-lists-equal : List CodexType, List CodexType -> Boolean
  type-lists-equal (xs) (ys) =
   if list-length xs /= list-length ys then False
   else type-lists-equal-loop xs ys 0 (list-length xs)

  type-lists-equal-loop : List CodexType, List CodexType, Integer, Integer -> Boolean
  type-lists-equal-loop (xs) (ys) (i) (len) =
   if i == len then True
   else if types-equal (list-at xs i) (list-at ys i) then type-lists-equal-loop xs ys (i + 1) len
   else False

  unify-rhs : UnificationState, CodexType, CodexType, SourceSpan, Integer, Boolean -> (Boolean, UnificationState)
  unify-rhs (st) (a) (b) (span) (depth) (inv) =
   when b
    is TypeVar (id-b) ->
     if occurs-in st id-b a 0 then (False, add-unify-error st cdx-infinite-type "Infinite type" span)
      else (True, add-subst st id-b a)
    is otherwise -> unify-structural st a b span depth inv

 The integer arm is where every widening in the language is actually
 admitted, and at a non-argument position it stays exactly as it was:
 either range inside the other, or merely OVERLAPPING, is accepted. In an
 argument position the bounds must match. Overflow mode is not compared in
 either branch, which is pre-existing and is a separate question from
 variance.

  unify-structural : UnificationState, CodexType, CodexType, SourceSpan, Integer, Boolean -> (Boolean, UnificationState)
  unify-structural (st) (a) (b) (span) (depth) (inv) =
   when a
    is IntegerTy (a-lo) (a-hi) (a-mode) -> when b
     is IntegerTy (b-lo) (b-hi) (b-mode) ->
      if inv then
       if a-lo == b-lo & a-hi == b-hi then (True, st) else unify-mismatch st a b span
      else if a-lo >= b-lo & a-hi <= b-hi then (True, st)
      else if b-lo >= a-lo & b-hi <= a-hi then (True, st)
      else if a-lo <= b-hi & b-lo <= a-hi then (True, st)
      else unify-mismatch st a b span
     is UnitTy (nb) (inner-b) -> unify-at st a inner-b span (depth + 1) inv
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is RealTy (a-w) (a-m) -> when b
     is RealTy (b-w) (b-m) ->
      if real-width-eq a-w b-w & real-mode-eq a-m b-m then (True, st)
      else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is UnitTy (nb) (inner-b) -> unify-at st a inner-b span (depth + 1) inv
     is otherwise -> unify-mismatch st a b span
    is TextTy -> when b
     is TextTy | ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is BooleanTy -> when b
     is BooleanTy | ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is NothingTy -> when b
     is NothingTy | ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is VoidTy -> when b
     is VoidTy | ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is ProofTy -> when b
     is ProofTy | PropEqTy (b1) (b2) | ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is PropEqTy (a1) (a2) -> when b
     is PropEqTy (b1) (b2) ->
      let (ok1, st1) = unify-at st a1 b1 span (depth + 1) inv
      in if ok1 then unify-at st1 a2 b2 span (depth + 1) inv
         else (ok1, st1)
     is ProofTy | ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is ErrorTy -> (True, st)
    is FunTy (pa) (rwa) (ra) -> when b
     is FunTy (pb) (rwb) (rb) -> unify-fun st pa rwa ra pb rwb rb span depth inv
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is EffectfulTy (ea) (sa) (ia) -> when b
     is EffectfulTy (eb) (sb) (ib) ->
      if name-sets-equal ea eb then unify-at st ia ib span (depth + 1) inv
      else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is ListTy (ea) -> when b
     is ListTy (eb) | LinkedListTy (eb) -> unify-at st ea eb span (depth + 1) True
     is TypeApply (fb) (ab) -> let (ok1, st1) = unify-at st (subj-deck-record (TypeCon (Name { value = "List" }))) fb span (depth + 1) inv in if ok1 then unify-at st1 ea ab span (depth + 1) True else (ok1, st1)
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is LinkedListTy (ea) -> when b
     is LinkedListTy (eb) | ListTy (eb) -> unify-at st ea eb span (depth + 1) True
     is TypeApply (fb) (ab) -> let (ok1, st1) = unify-at st (subj-deck-record (TypeCon (Name { value = "LinkedList" }))) fb span (depth + 1) inv in if ok1 then unify-at st1 ea ab span (depth + 1) True else (ok1, st1)
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is ConstructedTy (na) (args-a) -> when b
     is ConstructedTy (nb) (args-b) ->
      if na.value == nb.value then unify-constructed-args st args-a args-b 0 (list-length args-a) span depth
       else unify-mismatch st a b span
     is SumTy (sb-name) (sb-args) (sb-ctors) ->
      if na.value == sb-name.value then unify-constructed-args st args-a sb-args 0 (list-length args-a) span depth
      else unify-mismatch st a b span
     is RecordTy (rb-name) (rb-args) (rb-fields) ->
      if na.value == rb-name.value then unify-constructed-args st args-a rb-args 0 (list-length args-a) span depth
      else unify-mismatch st a b span
     is TypeApply (fb) (ab) -> if list-length args-a >= 1 then unify-ctor-apply-peel st na args-a fb ab span depth inv else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is SumTy (sa-name) (sa-args) (sa-ctors) -> when b
     is SumTy (sb-name) (sb-args) (sb-ctors) ->
      if sa-name.value == sb-name.value then unify-constructed-args st sa-args sb-args 0 (list-length sa-args) span depth
      else unify-mismatch st a b span
     is ConstructedTy (nb) (args-b) ->
      if sa-name.value == nb.value then unify-constructed-args st sa-args args-b 0 (list-length sa-args) span depth
      else unify-mismatch st a b span
     is TypeApply (fb) (ab) -> if list-length sa-args == 1 then let (ok1, st1) = unify-at st (subj-deck-record (TypeCon sa-name)) fb span (depth + 1) inv in if ok1 then unify-at st1 (list-at sa-args 0) ab span (depth + 1) True else (ok1, st1) else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is RecordTy (ra-name) (ra-args) (ra-fields) -> when b
     is RecordTy (rb-name) (rb-args) (rb-fields) ->
      if ra-name.value == rb-name.value then unify-constructed-args st ra-args rb-args 0 (list-length ra-args) span depth
      else unify-mismatch st a b span
     is ConstructedTy (nb) (args-b) ->
      if ra-name.value == nb.value then unify-constructed-args st ra-args args-b 0 (list-length ra-args) span depth
      else unify-mismatch st a b span
     is TypeApply (fb) (ab) -> if list-length ra-args == 1 then let (ok1, st1) = unify-at st (subj-deck-record (TypeCon ra-name)) fb span (depth + 1) inv in if ok1 then unify-at st1 (list-at ra-args 0) ab span (depth + 1) True else (ok1, st1) else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is ForAllTy (id) (body) -> unify-at st body b span (depth + 1) inv
    is ForAllEff (id) (body) -> unify-at st body b span (depth + 1) inv
    is UnitTy (na) (inner-a) -> when b
     is UnitTy (nb) (inner-b) ->
      unify-at st inner-a inner-b span (depth + 1) inv
     is ErrorTy -> (True, st)
     is otherwise -> unify-at st inner-a b span (depth + 1) inv
    is VectorTy (na) (ta) -> when b
     is VectorTy (nb) (tb) ->
      if na == nb | na < 0 | nb < 0 then unify-at st ta tb span (depth + 1) True
      else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is VectorMaskTy (na) -> when b
     is VectorMaskTy (nb) ->
      if na == nb then (True, st)
      else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is TypeCon (na) -> when b
     is TypeCon (nb) -> if na.value == nb.value then (True, st) else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is TypeApply (fa) (aa) -> when b
     is TypeApply (fb) (ab) -> let (ok1, st1) = unify-at st fa fb span (depth + 1) inv in if ok1 then unify-at st1 aa ab span (depth + 1) True else (ok1, st1)
     is ListTy (eb) -> let (ok1, st1) = unify-at st fa (subj-deck-record (TypeCon (Name { value = "List" }))) span (depth + 1) inv in if ok1 then unify-at st1 aa eb span (depth + 1) True else (ok1, st1)
     is LinkedListTy (eb) -> let (ok1, st1) = unify-at st fa (subj-deck-record (TypeCon (Name { value = "LinkedList" }))) span (depth + 1) inv in if ok1 then unify-at st1 aa eb span (depth + 1) True else (ok1, st1)
     is ConstructedTy (nb) (args-b) -> if list-length args-b >= 1 then unify-ctor-apply-peel st nb args-b fa aa span depth inv else unify-mismatch st a b span
     is SumTy (sb-name) (sb-args) (sb-ctors) -> if list-length sb-args == 1 then let (ok1, st1) = unify-at st fa (subj-deck-record (TypeCon sb-name)) span (depth + 1) inv in if ok1 then unify-at st1 aa (list-at sb-args 0) span (depth + 1) True else (ok1, st1) else unify-mismatch st a b span
     is RecordTy (rb-name) (rb-args) (rb-fields) -> if list-length rb-args == 1 then let (ok1, st1) = unify-at st fa (subj-deck-record (TypeCon rb-name)) span (depth + 1) inv in if ok1 then unify-at st1 aa (list-at rb-args 0) span (depth + 1) True else (ok1, st1) else unify-mismatch st a b span
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span
    is otherwise -> when b
     is UnitTy (nb) (inner-b) -> unify-at st a inner-b span (depth + 1) inv
     is TypeApply (fb) (ab) -> unify-at st b a span (depth + 1) inv
     is ErrorTy -> (True, st)
     is otherwise -> unify-mismatch st a b span

 unify-constructed-args and unify-cargs-loop take no inv parameter because
 every pair they compare is a type argument by construction, so they pass
 True unconditionally.

  unify-constructed-args : UnificationState, List CodexType, List CodexType, Integer, Integer, SourceSpan, Integer -> (Boolean, UnificationState)
  unify-constructed-args (st) (args-a) (args-b) (i) (len) (span) (depth) =
   if len /= list-length args-b then (False, add-unify-error st cdx-type-mismatch "Type mismatch: type constructor applied at different arities" span)
   else unify-cargs-loop st args-a args-b i len span depth

  unify-cargs-loop : UnificationState, List CodexType, List CodexType, Integer, Integer, SourceSpan, Integer -> (Boolean, UnificationState)
  unify-cargs-loop (st) (args-a) (args-b) (i) (len) (span) (depth) =
   if i == len then (True, st)
   else let (ok, st1) = unify-at st (list-at args-a i) (list-at args-b i) span (depth + 1) True
   in if ok then unify-cargs-loop st1 args-a args-b (i + 1) len span depth
        else (ok, st1)

  unify-ctor-apply-peel : UnificationState, Name, List CodexType, CodexType, CodexType, SourceSpan, Integer, Boolean -> (Boolean, UnificationState)
  unify-ctor-apply-peel (st) (name) (args) (fb) (ab) (span) (depth) (inv) =
   let n = list-length args
   in if n == 1
    then let (ok1, st1) = unify-at st (subj-deck-record (TypeCon name)) fb span (depth + 1) inv
      in if ok1 then unify-at st1 (list-at args 0) ab span (depth + 1) True else (ok1, st1)
    else let head-ty = subj-deck-record (ConstructedTy name (ctype-list-take args 0 (n - 1) []))
      in let (ok1, st1) = unify-at st head-ty fb span (depth + 1) inv
      in if ok1 then unify-at st1 (list-at args (n - 1)) ab span (depth + 1) True else (ok1, st1)

  ctype-list-take : List CodexType, Integer, Integer, List CodexType -> List CodexType
  ctype-list-take (xs) (i) (k) (acc) =
   if i == k then acc
   else ctype-list-take xs (i + 1) k (list-push acc (list-at xs i))

  unify-fun : UnificationState, CodexType, EffectRow, CodexType, CodexType, EffectRow, CodexType, SourceSpan, Integer, Boolean -> (Boolean, UnificationState)
  unify-fun (st) (pa) (rwa) (ra) (pb) (rwb) (rb) (span) (depth) (inv) =
   let (ok1, st1) = unify-at st pa pb span (depth + 1) inv
   in if ok1 then
       let (ok2, st2) = unify-row st1 rwa rwb span
       in if ok2 then unify-at st2 ra rb span (depth + 1) inv
          else (ok2, st2)
      else (ok1, st1)

  name-sets-equal : List Name, List Name -> Boolean
  name-sets-equal (xs) (ys) =
   names-all-in xs ys 0 (list-length xs) & names-all-in ys xs 0 (list-length ys)

  names-all-in : List Name, List Name, Integer, Integer -> Boolean
  names-all-in (xs) (ys) (i) (len) =
   if i == len then True
   else if name-list-has ys ((list-at xs i).value) then names-all-in xs ys (i + 1) len
   else False

  unify-mismatch : UnificationState, CodexType, CodexType, SourceSpan -> (Boolean, UnificationState)
  unify-mismatch (st) (a) (b) (span) =
   let base = "Type mismatch: " & type-desc a & " vs " & type-desc b
   in (False, add-unify-error st cdx-type-mismatch (base & (ctor-as-type-hint a & ctor-as-type-hint b)) span)

  ctor-as-type-hint : CodexType -> Text
  ctor-as-type-hint (ty) =
   when ty
    is ConstructedTy (name) (args) ->
     if list-length args == 0 & is-maybe-value-ctor (name.value)
      then " (note: '" & name.value & "' is a Maybe value constructor, not a type; an effectful procedure returns 'Nothing', and the empty Maybe value is 'None')"
      else ""
    is otherwise -> ""

  is-maybe-value-ctor : Text -> Boolean
  is-maybe-value-ctor (n) =
   if n == "None" then True
   else if n == "Just" then True
   else False

 The bounds are printed only when they are narrower than the default,
 because "Integer vs Integer" is what this message said for every bounded
 mismatch and it names neither side. Invariance of type arguments makes
 that pair common, and locating one such error in the compiler's own
 57,000 lines cost a full diagnostic cycle against a message that could
 have answered it.

  int-bounds-desc : Integer, Integer -> Text
  int-bounds-desc (lo) (hi) =
   if lo == i64-min & hi == i64-max then ""
   else " between " & integer-to-text lo & " and " & integer-to-text hi

  type-desc : CodexType -> Text
  type-desc (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> "Integer" & int-bounds-desc lo hi
    is RealTy (w) (m) -> "Real" & real-width-suffix w & real-mode-suffix m
    is TextTy -> "Text"
    is BooleanTy -> "Boolean"
    is CharTy -> "Char"
    is VoidTy -> "Void"
    is NothingTy -> "Nothing"
    is ErrorTy -> "Error"
    is FunTy (p) (row) (r) -> "Fun"
    is ListTy (e) -> "List"
    is LinkedListTy (e) -> "LinkedList"
    is TypeVar (id) -> "T" & integer-to-text id
    is ForAllTy (id) (body) -> "ForAll"
    is ForAllEff (id) (body) -> "ForAllEff"
    is EffectfulTy (effs) (sc) (ret) -> "Effectful"
    is ProofTy -> "Proof"
    is PropEqTy (a) (b) -> "PropEq[" & type-desc a & "," & type-desc b & "]"
    is ConstructedTy (name) (args) -> if list-length args == 0 then "Con:" & name.value
                                       else "Con:" & name.value & "[" & type-desc-args args 0 & "]"
    is RecordTy (name) (args) (fields) -> if list-length args == 0 then "Rec:" & name.value
                                          else "Rec:" & name.value & "[" & type-desc-args args 0 & "]"
    is SumTy (name) (args) (ctors) -> if list-length args == 0 then "Sum:" & name.value
                                       else "Sum:" & name.value & "[" & type-desc-args args 0 & "]"
    is UnitTy (name) (inner) -> "Unit:" & name.value
    is VectorTy (vn) (vt) -> "Vector " & integer-to-text vn & " " & type-desc vt
    is VectorMaskTy (n) -> "VectorMask " & integer-to-text n
    is TypeCon (name) -> "TCon:" & name.value
    is TypeApply (f) (a) -> "App[" & type-desc f & " " & type-desc a & "]"
    is LinearTy (inner) -> "linear " & type-desc inner

  type-desc-args : List CodexType, Integer -> Text
  type-desc-args (args) (i) =
   if i >= list-length args then ""
   else let prefix = if i == 0 then "" else ", "
   in prefix & type-desc (list-at args i) & type-desc-args args (i + 1)

Section: Deep Resolve

  ty-has-typevars : CodexType -> Boolean
  ty-has-typevars (ty) =
   when ty
    is TypeVar (id) -> True
    is otherwise -> codex-type-fold-children ty-has-typevars-fold ty False

  ty-has-typevars-fold : CodexType, Boolean -> Boolean
  ty-has-typevars-fold (c) (acc) =
   if acc then True else ty-has-typevars c

  deep-resolve : UnificationState, CodexType -> CodexType
  deep-resolve (st) (ty) =
   if ty-has-typevars ty then deep-resolve-at st ty 0
   else ty

  deep-resolve-at : UnificationState, CodexType, Integer -> CodexType
  deep-resolve-at (st) (ty) (depth) =
   if depth >= max-recursion-depth then ty
   else let resolved = resolve-silent st ty
   in if ty-has-typevars resolved == False then resolved
   else when resolved
    is SumTy (name) (args) (ctors) -> subj-deck-record (SumTy name (for a in args -> deep-resolve-at st a (depth + 1)) ctors)
    is TypeApply (tf) (ta) -> reduce-type-apply (deep-resolve-at st tf (depth + 1)) (deep-resolve-at st ta (depth + 1))
    is otherwise -> codex-type-map-children (\c -> deep-resolve-at st c (depth + 1)) resolved

  reduce-type-apply : CodexType, CodexType -> CodexType
  reduce-type-apply (f) (a) =
   when f
    is TypeCon (name) -> if name.value == "List" then subj-deck-record (ListTy a) else if name.value == "LinkedList" then subj-deck-record (LinkedListTy a) else subj-deck-record (ConstructedTy name [a])
    is otherwise -> subj-deck-record (TypeApply f a)

Section: Deep Type Copy

 A memoized structural deep copy of type graphs onto the CURRENT
 allocator (call inside subj-deck-record to land copies on a deck).
 deep-resolve above SHARES every subtree that contains no type
 variables, so resolved binding and expr-type graphs still point
 into the scratch arena the checker worked in (check-all-defs runs
 deck-exited), and the check compact poisons that scratch under the
 survivors' feet. The memo table (open addressing, key32/val32
 slots, Fibonacci top-bits index) maps each source box address to
 its copy, so sharing topology is preserved and the copy volume is
 the unique-box count, not the unshared traversal count (measured
 9x larger on the selfhost - an unmemoized copy exhausts the heap).
 Copies are read back through four typed side lists; a slot value
 is index+1 into its kind's list. A slot is claimed BEFORE children
 are copied, so a cycle back-edge finds value 0 and receives the
 ORIGINAL pointer instead of recursing forever. Boxes below the memo
 FLOOR (the keep reservation base) are SHARED, not copied: nothing
 rewinds R10 below the keep after the check compact, so parse- and
 scope-era Texts, Names and type boxes - the bulk of the population
 - survive in place and only check-era boxes are materialized into
 the keep. A degraded path (probe fuel exhausted, side list at
 capacity, tag out of range, depth cap) returns the original box
 unchanged for Texts, Names, rows and the four list kinds;
 `mcopy-type` answers `ErrorTy` on its unsafe escapes instead, because a
 CodexType handed back into scratch is the one that reached codegen.
 That is never wrong for one box, but it is NOT merely
 less deduplicated in aggregate: a saturated address memo makes
 every re-visit of a shared subtree a fresh unmemoized copy, the
 re-copies feed fresh addresses into the cons keys of every parent
 list so the content layer stops matching too, and the copy volume
 explodes combinatorially - measured 95 MB of keep deck for a graph
 whose memoized copy is 0.17 MB (measured on ShellBuild). The
 table is therefore sized from the CHECK deck's measured usage -
 the population the memo actually keys is address-distinct boxes,
 not post-dedup contents - and mc-ceiling is the second line: a
 copy entry that would allocate once the keep frontier has climbed
 past the ceiling shares the original instead (`mcopy-type` answers
 `ErrorTy` there), and the caller raises CDX9002 for the phase by
 comparing the keep deck's measured end against mc-ceiling. That
 comparison is calibrated: forced below the measured keep use it
 raises CDX9002 naming CHECK-KEEP, forced above it the same edited
 line raises nothing. A shared original is a pointer into scratch the
 caller is about to reclaim, so the phase must not be allowed to
 succeed once one has been handed out. The copy must never write
 past its reservation into the scratch it is still reading; that
 silent breach is how ShellBuild died with no diagnostic. The interned
 empty-row is preserved so arrows keep sharing one empty row.
 Null-tolerant (calloc-zero fields pass through unchanged).

  MemoCtx = record {
   mc-table : Integer,
   mc-slots : Integer,
   mc-shift : Integer,
   mc-floor : Integer,
   mc-ty : List CodexType,
   mc-text : List Text,
   mc-name : List Name,
   mc-row : List EffectRow,
   mc-tylist : List (List CodexType),
   mc-fieldlist : List (List RecordField),
   mc-ctorlist : List (List SumCtor),
   mc-labellist : List (List EffectLabel),
   mc-cons : Integer,
   mc-cons-slots : Integer,
   mc-cons-shift : Integer,
   mc-cap-ty : Integer,
   mc-cap-text : Integer,
   mc-cap-name : Integer,
   mc-cap-row : Integer,
   mc-cap-list : Integer,
   mc-ceiling : Integer
  }

  memo-pow2-at-least : Integer, Integer -> Integer
  memo-pow2-at-least (n) (p) =
   if p >= n then p else memo-pow2-at-least n (p * 2)

  memo-shift-for : Integer, Integer -> Integer
  memo-shift-for (p) (s) =
   if p <= 1 then s else memo-shift-for (p / 2) (s - 1)

  memo-probe : Integer, MemoCtx -> Integer
  memo-probe (a) (mc) =
   let h = a * 2177342782468422677
   in memo-probe-at a (mc.mc-table) (mc.mc-slots) (bit-shru h (mc.mc-shift)) 64

  memo-probe-at : Integer, Integer, Integer, Integer, Integer -> Integer
  memo-probe-at (a) (table) (slots) (idx) (fuel) =
   if fuel == 0 then 0
   else let slot = table + idx * 8
   in let k = bit-and (peek-32 slot 0) 4294967295
   in if k == bit-and a 4294967295 then slot
   else if k == 0 then slot
   else memo-probe-at a table slots (if idx + 1 == slots then 0 else idx + 1) (fuel - 1)

  memo-slot-key : Integer -> Integer
  memo-slot-key (slot) = bit-and (peek-32 slot 0) 4294967295

 The cons layer. The address memo above deduplicates by SOURCE box;
 the checker's AST-to-CodexType conversion materializes a full
 distinct structure per mention, so address identity recovers almost
 nothing across mentions. The cons table deduplicates by CONTENT: a
 64-bit key mixed from a node's tag, scalars, and the addresses of
 its ALREADY-CANONICAL children (each key function canonicalizes
 children through mcopy before mixing, so structurally equal trees
 cascade to equal keys bottom-up with no construction on the hit
 path). Slots are 16 bytes: the full 64-bit key plus a 32-bit
 index+1 into the kind's side list. Hits compare the FULL key - at
 half a million keys the 64-bit collision probability is on the
 order of 1e-8 per compile, below hardware error rates, and the
 fixed-point, battery and poison gates stand behind it. Every
 degraded path (probe fuel, side list at capacity) constructs a
 private copy - never wrong, only less deduplicated. OverflowMode
 is keyed by ordinal, never by box address (a fresh mode box per
 copy would make every IntegerTy key unique).

  cons-mix : Integer, Integer -> Integer
  cons-mix (h) (v) = h * 1099511628211 + v

  cons-norm : Integer -> Integer
  cons-norm (k) = if k == 0 then 1 else k

  cons-probe : Integer, MemoCtx -> Integer
  cons-probe (k) (mc) =
   cons-probe-at k (mc.mc-cons) (mc.mc-cons-slots) (bit-shru (k * 2177342782468422677) (mc.mc-cons-shift)) 64

  cons-probe-at : Integer, Integer, Integer, Integer, Integer -> Integer
  cons-probe-at (k) (table) (slots) (idx) (fuel) =
   if fuel == 0 then 0
   else let slot = table + idx * 16
   in let cur = peek-qword slot 0
   in if cur == k then slot
   else if cur == 0 then slot
   else cons-probe-at k table slots (if idx + 1 == slots then 0 else idx + 1) (fuel - 1)

  cons-slot-set : Integer, Integer, Integer -> Integer
  cons-slot-set (slot) (k) (v) =
   let vlo = poke-32 slot 0 (bit-and k 4294967295)
   in let vhi = poke-32 (slot + 4) 0 (bit-shru k 32)
   in poke-32 (slot + 8) 0 v

  mode-ordinal : OverflowMode -> Integer
  mode-ordinal (m) =
   if address-of m == 0 then 0
   else when m
    is OvError -> 1
    is OvWrapping -> 2
    is OvClamping -> 3

  real-width-ordinal : RealWidth -> Integer
  real-width-ordinal (w) =
   if address-of w == 0 then 0
   else when w
    is RwF64 -> 1
    is RwF32 -> 2

  real-mode-ordinal : RealMode -> Integer
  real-mode-ordinal (m) =
   if address-of m == 0 then 0
   else when m
    is RmDefault -> 1
    is RmTrapping -> 2
    is RmSaturating -> 3

  real-width-suffix : RealWidth -> Text
  real-width-suffix (w) =
   when w
    is RwF32 -> " approximate"
    is otherwise -> ""

  real-mode-suffix : RealMode -> Text
  real-mode-suffix (m) =
   when m
    is RmTrapping -> " trapping"
    is RmSaturating -> " saturating"
    is otherwise -> ""

 A CodexType box carries its constructor index in its first word, and there
 are 27 of them, so a first word outside 0..28 is not a CodexType. Returning
 the argument in that case hands the caller a pointer into scratch it is about
 to reclaim, and the value is already known to be wrong; ErrorTy is a defined
 value the rest of the compiler already understands.

  mcopy-text : Text, MemoCtx -> Text
  mcopy-text (t) (mc) =
   let a = address-of t
   in if a == 0 then t
   else if a < mc.mc-floor then t
   else if __heap-save >= mc.mc-ceiling then t
   else mcopy-text-memo t a (memo-probe a mc) mc

  mcopy-text-memo : Text, Integer, Integer, MemoCtx -> Text
  mcopy-text-memo (t) (a) (slot) (mc) =
   if slot == 0 then substring t 0 (text-length t)
   else if memo-slot-key slot == bit-and a 4294967295 then mcopy-text-hit t slot mc
   else mcopy-text-fresh t a slot mc

  mcopy-text-hit : Text, Integer, MemoCtx -> Text
  mcopy-text-hit (t) (slot) (mc) =
   let v = peek-32 slot 4
   in if v == 0 then t else list-at (mc.mc-text) (v - 1)

  mcopy-text-fresh : Text, Integer, Integer, MemoCtx -> Text
  mcopy-text-fresh (t) (a) (slot) (mc) =
   let claimed = poke-32 slot 0 a
   in let copy = substring t 0 (text-length t)
   in let n = list-length (mc.mc-text)
   in if n >= mc.mc-cap-text then copy
   else let pushed = list-push (mc.mc-text) copy
   in let vset = poke-32 slot 4 (n + 1)
   in copy

  mcopy-texts : List Text, MemoCtx -> List Text
  mcopy-texts (ts) (mc) =
   let a = address-of ts
   in if a == 0 then ts
   else if a < mc.mc-floor then ts
   else for t in ts -> mcopy-text t mc

  mcopy-name : Name, MemoCtx -> Name
  mcopy-name (nm) (mc) =
   let a = address-of nm
   in if a == 0 then nm
   else if a < mc.mc-floor then nm
   else if __heap-save >= mc.mc-ceiling then nm
   else mcopy-name-memo nm a (memo-probe a mc) mc

  mcopy-name-memo : Name, Integer, Integer, MemoCtx -> Name
  mcopy-name-memo (nm) (a) (slot) (mc) =
   if slot == 0 then Name { value = mcopy-text (nm.value) mc }
   else if memo-slot-key slot == bit-and a 4294967295 then mcopy-name-hit nm slot mc
   else mcopy-name-fresh nm a slot mc

  mcopy-name-hit : Name, Integer, MemoCtx -> Name
  mcopy-name-hit (nm) (slot) (mc) =
   let v = peek-32 slot 4
   in if v == 0 then nm else list-at (mc.mc-name) (v - 1)

  mcopy-name-fresh : Name, Integer, Integer, MemoCtx -> Name
  mcopy-name-fresh (nm) (a) (slot) (mc) =
   let claimed = poke-32 slot 0 a
   in let copy = Name { value = mcopy-text (nm.value) mc }
   in let n = list-length (mc.mc-name)
   in if n >= mc.mc-cap-name then copy
   else let pushed = list-push (mc.mc-name) copy
   in let vset = poke-32 slot 4 (n + 1)
   in copy

  mcopy-names : List Name, MemoCtx -> List Name
  mcopy-names (ns) (mc) =
   let a = address-of ns
   in if a == 0 then ns
   else if a < mc.mc-floor then ns
   else for nm in ns -> mcopy-name nm mc

  mcopy-row : EffectRow, MemoCtx -> EffectRow
  mcopy-row (row) (mc) =
   let a = address-of row
   in if a == 0 then row
   else if row-is-empty row then empty-row
   else if a < mc.mc-floor then row
   else if __heap-save >= mc.mc-ceiling then row
   else mcopy-row-memo row a (memo-probe a mc) mc

  mcopy-row-memo : EffectRow, Integer, Integer, MemoCtx -> EffectRow
  mcopy-row-memo (row) (a) (slot) (mc) =
   if slot == 0 then mcopy-row-node row mc
   else if memo-slot-key slot == bit-and a 4294967295 then mcopy-row-hit row slot mc
   else mcopy-row-fresh row a slot mc

  mcopy-row-hit : EffectRow, Integer, MemoCtx -> EffectRow
  mcopy-row-hit (row) (slot) (mc) =
   let v = peek-32 slot 4
   in if v == 0 then row else list-at (mc.mc-row) (v - 1)

  mcopy-row-fresh : EffectRow, Integer, Integer, MemoCtx -> EffectRow
  mcopy-row-fresh (row) (a) (slot) (mc) =
   let claimed = poke-32 slot 0 a
   in let k = cons-norm (mkey-row row mc)
   in let v = cons-lookup k mc
   in if v /= 0 then mcopy-row-adopt slot v mc
   else let copy = mcopy-row-node row mc
   in let v2 = cons-lookup k mc
   in if v2 /= 0 then mcopy-row-adopt slot v2 mc
   else let n = list-length (mc.mc-row)
   in if n >= mc.mc-cap-row then copy
   else let pushed = list-push (mc.mc-row) copy
   in let aset = poke-32 slot 4 (n + 1)
   in let cslot = cons-probe k mc
   in let w = if cslot == 0 then 0 else cons-slot-set cslot k (n + 1)
   in copy

  mcopy-row-adopt : Integer, Integer, MemoCtx -> EffectRow
  mcopy-row-adopt (slot) (v) (mc) =
   let aset = poke-32 slot 4 v
   in list-at (mc.mc-row) (v - 1)

  mkey-row : EffectRow, MemoCtx -> Integer
  mkey-row (row) (mc) =
   cons-mix (cons-mix (cons-mix 601 (address-of (mcopy-labels (row.labels) mc))) (row.tail-id)) (mkey-textlen (row.tail-name))

  mcopy-row-node : EffectRow, MemoCtx -> EffectRow
  mcopy-row-node (row) (mc) =
   EffectRow { labels = mcopy-labels (row.labels) mc, tail-name = mcopy-text (row.tail-name) mc, tail-id = row.tail-id }

  mcopy-labels : List EffectLabel, MemoCtx -> List EffectLabel
  mcopy-labels (ls) (mc) =
   let a = address-of ls
   in if a == 0 then ls
   else if a < mc.mc-floor then ls
   else if __heap-save >= mc.mc-ceiling then ls
   else let k = cons-norm (mkey-labels ls mc)
   in let v = cons-lookup k mc
   in if v /= 0 then list-at (mc.mc-labellist) (v - 1)
   else mcopy-labels-insert ls k mc

  mcopy-labels-insert : List EffectLabel, Integer, MemoCtx -> List EffectLabel
  mcopy-labels-insert (ls) (k) (mc) =
   let copy = mcopy-labels-node ls mc
   in let v2 = cons-lookup k mc
   in if v2 /= 0 then list-at (mc.mc-labellist) (v2 - 1)
   else let cslot = cons-probe k mc
   in if cslot == 0 then copy
   else let n = list-length (mc.mc-labellist)
   in if n >= mc.mc-cap-list then copy
   else let pushed = list-push (mc.mc-labellist) copy
   in let w = cons-slot-set cslot k (n + 1)
   in copy

  mcopy-labels-node : List EffectLabel, MemoCtx -> List EffectLabel
  mcopy-labels-node (ls) (mc) =
   for l in ls -> EffectLabel { name = mcopy-name (l.name) mc, scope = mcopy-text (l.scope) mc }

  mkey-labels : List EffectLabel, MemoCtx -> Integer
  mkey-labels (ls) (mc) =
   mkey-labels-loop ls 0 (list-length ls) mc (cons-mix 401 (list-length ls))

  mkey-labels-loop : List EffectLabel, Integer, Integer, MemoCtx, Integer -> Integer
  mkey-labels-loop (ls) (i) (len) (mc) (acc) =
   if i == len then acc
   else let l = list-at ls i
   in mkey-labels-loop ls (i + 1) len mc (cons-mix (cons-mix acc (address-of (mcopy-name (l.name) mc))) (address-of (mcopy-text (l.scope) mc)))

  mcopy-rows : List EffectRow, MemoCtx -> List EffectRow
  mcopy-rows (rs) (mc) =
   if address-of rs == 0 then rs
   else for r in rs -> mcopy-row r mc

  mcopy-mode : OverflowMode -> OverflowMode
  mcopy-mode (m) =
   if address-of m == 0 then m
   else when m
    is OvError -> OvError
    is OvWrapping -> OvWrapping
    is OvClamping -> OvClamping

  mcopy-real-width : RealWidth -> RealWidth
  mcopy-real-width (w) =
   if address-of w == 0 then w
   else when w
    is RwF64 -> RwF64
    is RwF32 -> RwF32

  mcopy-real-mode : RealMode -> RealMode
  mcopy-real-mode (m) =
   if address-of m == 0 then m
   else when m
    is RmDefault -> RmDefault
    is RmTrapping -> RmTrapping
    is RmSaturating -> RmSaturating

  mcopy-types : List CodexType, Integer, MemoCtx -> List CodexType
  mcopy-types (ts) (depth) (mc) =
   let a = address-of ts
   in if a == 0 then ts
   else if a < mc.mc-floor then ts
   else if __heap-save >= mc.mc-ceiling then ts
   else let k = cons-norm (mkey-types ts depth mc)
   in let v = cons-lookup k mc
   in if v /= 0 then list-at (mc.mc-tylist) (v - 1)
   else mcopy-types-insert ts k depth mc

  mcopy-types-insert : List CodexType, Integer, Integer, MemoCtx -> List CodexType
  mcopy-types-insert (ts) (k) (depth) (mc) =
   let copy = mcopy-types-node ts depth mc
   in let v2 = cons-lookup k mc
   in if v2 /= 0 then list-at (mc.mc-tylist) (v2 - 1)
   else let cslot = cons-probe k mc
   in if cslot == 0 then copy
   else let n = list-length (mc.mc-tylist)
   in if n >= mc.mc-cap-list then copy
   else let pushed = list-push (mc.mc-tylist) copy
   in let w = cons-slot-set cslot k (n + 1)
   in copy

  mcopy-types-node : List CodexType, Integer, MemoCtx -> List CodexType
  mcopy-types-node (ts) (depth) (mc) =
   for t in ts -> mcopy-type t depth mc

  mkey-types : List CodexType, Integer, MemoCtx -> Integer
  mkey-types (ts) (depth) (mc) =
   mkey-types-loop ts 0 (list-length ts) depth mc (cons-mix 101 (list-length ts))

  mkey-types-loop : List CodexType, Integer, Integer, Integer, MemoCtx, Integer -> Integer
  mkey-types-loop (ts) (i) (len) (depth) (mc) (acc) =
   if i == len then acc
   else mkey-types-loop ts (i + 1) len depth mc (cons-mix acc (address-of (mcopy-type (list-at ts i) depth mc)))

  mcopy-fields : List RecordField, Integer, MemoCtx -> List RecordField
  mcopy-fields (fs) (depth) (mc) =
   let a = address-of fs
   in if a == 0 then fs
   else if a < mc.mc-floor then fs
   else if __heap-save >= mc.mc-ceiling then fs
   else let k = cons-norm (mkey-fields fs depth mc)
   in let v = cons-lookup k mc
   in if v /= 0 then list-at (mc.mc-fieldlist) (v - 1)
   else mcopy-fields-insert fs k depth mc

  mcopy-fields-insert : List RecordField, Integer, Integer, MemoCtx -> List RecordField
  mcopy-fields-insert (fs) (k) (depth) (mc) =
   let copy = mcopy-fields-node fs depth mc
   in let v2 = cons-lookup k mc
   in if v2 /= 0 then list-at (mc.mc-fieldlist) (v2 - 1)
   else let cslot = cons-probe k mc
   in if cslot == 0 then copy
   else let n = list-length (mc.mc-fieldlist)
   in if n >= mc.mc-cap-list then copy
   else let pushed = list-push (mc.mc-fieldlist) copy
   in let w = cons-slot-set cslot k (n + 1)
   in copy

  mcopy-fields-node : List RecordField, Integer, MemoCtx -> List RecordField
  mcopy-fields-node (fs) (depth) (mc) =
   for f in fs -> RecordField { name = mcopy-name (f.name) mc, type-val = mcopy-type (f.type-val) depth mc }

  mkey-fields : List RecordField, Integer, MemoCtx -> Integer
  mkey-fields (fs) (depth) (mc) =
   mkey-fields-loop fs 0 (list-length fs) depth mc (cons-mix 201 (list-length fs))

  mkey-fields-loop : List RecordField, Integer, Integer, Integer, MemoCtx, Integer -> Integer
  mkey-fields-loop (fs) (i) (len) (depth) (mc) (acc) =
   if i == len then acc
   else let f = list-at fs i
   in mkey-fields-loop fs (i + 1) len depth mc (cons-mix (cons-mix acc (address-of (mcopy-name (f.name) mc))) (address-of (mcopy-type (f.type-val) depth mc)))

  mcopy-ctors : List SumCtor, Integer, MemoCtx -> List SumCtor
  mcopy-ctors (cs) (depth) (mc) =
   let a = address-of cs
   in if a == 0 then cs
   else if a < mc.mc-floor then cs
   else if __heap-save >= mc.mc-ceiling then cs
   else let k = cons-norm (mkey-ctors cs depth mc)
   in let v = cons-lookup k mc
   in if v /= 0 then list-at (mc.mc-ctorlist) (v - 1)
   else mcopy-ctors-insert cs k depth mc

  mcopy-ctors-insert : List SumCtor, Integer, Integer, MemoCtx -> List SumCtor
  mcopy-ctors-insert (cs) (k) (depth) (mc) =
   let copy = mcopy-ctors-node cs depth mc
   in let v2 = cons-lookup k mc
   in if v2 /= 0 then list-at (mc.mc-ctorlist) (v2 - 1)
   else let cslot = cons-probe k mc
   in if cslot == 0 then copy
   else let n = list-length (mc.mc-ctorlist)
   in if n >= mc.mc-cap-list then copy
   else let pushed = list-push (mc.mc-ctorlist) copy
   in let w = cons-slot-set cslot k (n + 1)
   in copy

  mcopy-ctors-node : List SumCtor, Integer, MemoCtx -> List SumCtor
  mcopy-ctors-node (cs) (depth) (mc) =
   for c in cs -> SumCtor { name = mcopy-name (c.name) mc, fields = mcopy-types (c.fields) depth mc, return-type = mcopy-types (c.return-type) depth mc }

  mkey-ctors : List SumCtor, Integer, MemoCtx -> Integer
  mkey-ctors (cs) (depth) (mc) =
   mkey-ctors-loop cs 0 (list-length cs) depth mc (cons-mix 301 (list-length cs))

  mkey-ctors-loop : List SumCtor, Integer, Integer, Integer, MemoCtx, Integer -> Integer
  mkey-ctors-loop (cs) (i) (len) (depth) (mc) (acc) =
   if i == len then acc
   else let c = list-at cs i
   in mkey-ctors-loop cs (i + 1) len depth mc (cons-mix (cons-mix (cons-mix acc (address-of (mcopy-name (c.name) mc))) (address-of (mcopy-types (c.fields) depth mc))) (address-of (mcopy-types (c.return-type) depth mc)))

  mcopy-type : CodexType, Integer, MemoCtx -> CodexType
  mcopy-type (ty) (depth) (mc) =
   let a = address-of ty
   in if a == 0 then ty
   else if a < mc.mc-floor then ty
   else if __heap-save >= mc.mc-ceiling then ErrorTy
   else if depth >= max-recursion-depth then ErrorTy
   else if peek-qword a 0 < 0 then ErrorTy
   else if peek-qword a 0 > 28 then ErrorTy
   else mcopy-type-memo ty a (memo-probe a mc) depth mc

  mcopy-type-memo : CodexType, Integer, Integer, Integer, MemoCtx -> CodexType
  mcopy-type-memo (ty) (a) (slot) (depth) (mc) =
   if slot == 0 then mcopy-type-node ty depth mc
   else if memo-slot-key slot == bit-and a 4294967295 then mcopy-type-hit ty slot mc
   else mcopy-type-fresh ty a slot depth mc

  mcopy-type-hit : CodexType, Integer, MemoCtx -> CodexType
  mcopy-type-hit (ty) (slot) (mc) =
   let v = peek-32 slot 4
   in if v == 0 then ty else list-at (mc.mc-ty) (v - 1)

  cons-lookup : Integer, MemoCtx -> Integer
  cons-lookup (k) (mc) =
   let slot = cons-probe k mc
   in if slot == 0 then 0
   else if peek-qword slot 0 == k then peek-32 (slot + 8) 0
   else 0

  mkey-textlen : Text -> Integer
  mkey-textlen (t) =
   if address-of t == 0 then 0
   else text-length t

  mcopy-type-fresh : CodexType, Integer, Integer, Integer, MemoCtx -> CodexType
  mcopy-type-fresh (ty) (a) (slot) (depth) (mc) =
   let claimed = poke-32 slot 0 a
   in let k = cons-norm (mkey-type ty depth mc)
   in let v = cons-lookup k mc
   in if v /= 0 then mcopy-type-adopt slot v mc
   else let copy = mcopy-type-node ty depth mc
   in let v2 = cons-lookup k mc
   in if v2 /= 0 then mcopy-type-adopt slot v2 mc
   else let n = list-length (mc.mc-ty)
   in if n >= mc.mc-cap-ty then copy
   else let pushed = list-push (mc.mc-ty) copy
   in let aset = poke-32 slot 4 (n + 1)
   in let cslot = cons-probe k mc
   in let w = if cslot == 0 then 0 else cons-slot-set cslot k (n + 1)
   in copy

  mcopy-type-adopt : Integer, Integer, MemoCtx -> CodexType
  mcopy-type-adopt (slot) (v) (mc) =
   let aset = poke-32 slot 4 v
   in list-at (mc.mc-ty) (v - 1)

  mkey-type : CodexType, Integer, MemoCtx -> Integer
  mkey-type (ty) (depth) (mc) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> cons-mix (cons-mix (cons-mix 1 lo) hi) (mode-ordinal mode)
    is RealTy (w) (m) -> cons-mix (cons-mix 2 (real-width-ordinal w)) (real-mode-ordinal m)
    is TextTy -> 6
    is BooleanTy -> 7
    is CharTy -> 8
    is VoidTy -> 9
    is NothingTy -> 10
    is ErrorTy -> 11
    is FunTy (p) (row) (r) -> cons-mix (cons-mix (cons-mix 12 (address-of (mcopy-type p (depth + 1) mc))) (address-of (mcopy-row row mc))) (address-of (mcopy-type r (depth + 1) mc))
    is ListTy (e) -> cons-mix 13 (address-of (mcopy-type e (depth + 1) mc))
    is LinkedListTy (e) -> cons-mix 14 (address-of (mcopy-type e (depth + 1) mc))
    is TypeVar (i) -> cons-mix 15 i
    is ForAllTy (i) (b) -> cons-mix (cons-mix 16 i) (address-of (mcopy-type b (depth + 1) mc))
    is SumTy (n) (a) (ctors) -> cons-mix (cons-mix (cons-mix 17 (address-of (mcopy-name n mc))) (address-of (mcopy-types a (depth + 1) mc))) (address-of (mcopy-ctors ctors (depth + 1) mc))
    is RecordTy (n) (a) (fields) -> cons-mix (cons-mix (cons-mix 18 (address-of (mcopy-name n mc))) (address-of (mcopy-types a (depth + 1) mc))) (address-of (mcopy-fields fields (depth + 1) mc))
    is ConstructedTy (n) (a) -> cons-mix (cons-mix 19 (address-of (mcopy-name n mc))) (address-of (mcopy-types a (depth + 1) mc))
    is EffectfulTy (effs) (sc) (r) -> cons-mix (cons-mix (cons-mix 20 (address-of (mcopy-names effs mc))) (address-of (mcopy-texts sc mc))) (address-of (mcopy-type r (depth + 1) mc))
    is ProofTy -> 21
    is PropEqTy (pa) (pb) -> cons-mix (cons-mix 22 (address-of (mcopy-type pa (depth + 1) mc))) (address-of (mcopy-type pb (depth + 1) mc))
    is UnitTy (n) (inner) -> cons-mix (cons-mix 23 (address-of (mcopy-name n mc))) (address-of (mcopy-type inner (depth + 1) mc))
    is VectorTy (vn) (vt) -> cons-mix (cons-mix 24 vn) (address-of (mcopy-type vt (depth + 1) mc))
    is VectorMaskTy (mn) -> cons-mix 25 mn
    is TypeCon (n) -> cons-mix 26 (address-of (mcopy-name n mc))
    is TypeApply (tf) (ta) -> cons-mix (cons-mix 27 (address-of (mcopy-type tf (depth + 1) mc))) (address-of (mcopy-type ta (depth + 1) mc))
    is ForAllEff (i) (b) -> cons-mix (cons-mix 28 i) (address-of (mcopy-type b (depth + 1) mc))
    is LinearTy (inner) -> cons-mix 29 (address-of (mcopy-type inner (depth + 1) mc))

  mcopy-type-node : CodexType, Integer, MemoCtx -> CodexType
  mcopy-type-node (ty) (depth) (mc) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> IntegerTy lo hi (mcopy-mode mode)
    is RealTy (w) (m) -> RealTy (mcopy-real-width w) (mcopy-real-mode m)
    is TextTy -> TextTy
    is BooleanTy -> BooleanTy
    is CharTy -> CharTy
    is VoidTy -> VoidTy
    is NothingTy -> NothingTy
    is ErrorTy -> ErrorTy
    is FunTy (p) (row) (r) -> FunTy (mcopy-type p (depth + 1) mc) (mcopy-row row mc) (mcopy-type r (depth + 1) mc)
    is ListTy (e) -> ListTy (mcopy-type e (depth + 1) mc)
    is LinkedListTy (e) -> LinkedListTy (mcopy-type e (depth + 1) mc)
    is TypeVar (i) -> TypeVar i
    is ForAllTy (i) (b) -> ForAllTy i (mcopy-type b (depth + 1) mc)
    is SumTy (n) (a) (ctors) -> SumTy (mcopy-name n mc) (mcopy-types a (depth + 1) mc) (mcopy-ctors ctors (depth + 1) mc)
    is RecordTy (n) (a) (fields) -> RecordTy (mcopy-name n mc) (mcopy-types a (depth + 1) mc) (mcopy-fields fields (depth + 1) mc)
    is ConstructedTy (n) (a) -> ConstructedTy (mcopy-name n mc) (mcopy-types a (depth + 1) mc)
    is EffectfulTy (effs) (sc) (r) -> EffectfulTy (mcopy-names effs mc) (mcopy-texts sc mc) (mcopy-type r (depth + 1) mc)
    is ProofTy -> ProofTy
    is PropEqTy (a) (b) -> PropEqTy (mcopy-type a (depth + 1) mc) (mcopy-type b (depth + 1) mc)
    is UnitTy (n) (inner) -> UnitTy (mcopy-name n mc) (mcopy-type inner (depth + 1) mc)
    is VectorTy (vn) (vt) -> VectorTy vn (mcopy-type vt (depth + 1) mc)
    is VectorMaskTy (mn) -> VectorMaskTy mn
    is TypeCon (n) -> TypeCon (mcopy-name n mc)
    is TypeApply (tf) (ta) -> TypeApply (mcopy-type tf (depth + 1) mc) (mcopy-type ta (depth + 1) mc)
    is ForAllEff (i) (b) -> ForAllEff i (mcopy-type b (depth + 1) mc)
    is LinearTy (inner) -> LinearTy (mcopy-type inner (depth + 1) mc)

  copy-bindings-deep : List TypeBinding, MemoCtx -> List TypeBinding
  copy-bindings-deep (bs) (mc) =
   if address-of bs == 0 then bs
   else for b in bs -> TypeBinding { name = mcopy-text (b.name) mc, bound-type = mcopy-type (b.bound-type) 0 mc }

  copy-expr-types-deep : List ExprTypeEntry, MemoCtx -> List ExprTypeEntry
  copy-expr-types-deep (es) (mc) =
   if address-of es == 0 then es
   else for e in es -> ExprTypeEntry { key = e.key, ty = mcopy-type (e.ty) 0 mc }

Section: List Pre-Allocation

  copy-list-with-headroom : List a, Integer -> List a
  copy-list-with-headroom (src) (extra-cap) =
   let len = list-length src
   in let dst = __list-with-capacity (len + extra-cap)
   in copy-list-loop src dst 0 len

  copy-list-loop : List a, List a, Integer, Integer -> List a
  copy-list-loop (src) (dst) (i) (len) =
   if i == len then dst
   else copy-list-loop src (list-push dst (list-at src i)) (i + 1) len

Section: GADT Snapshot

  SubstSnapshot = record {
   snap-types : List CodexType,
   snap-rows : List EffectRow
  }

  snapshot-substitutions : UnificationState -> SubstSnapshot
  snapshot-substitutions (st) =
   SubstSnapshot {
    snap-types = copy-list-with-headroom (st.substitutions) 16,
    snap-rows = copy-list-with-headroom (st.row-substitutions) 8
   }

  restore-substitutions : UnificationState, SubstSnapshot -> UnificationState
  restore-substitutions (st) (saved) =
   let __seq = __record-set st "substitutions" (saved.snap-types)
   in let __seq2 = __record-set st "row-substitutions" (saved.snap-rows)
   in st

