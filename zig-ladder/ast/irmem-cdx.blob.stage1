Chapter: Parsmi--IR Chapter

Section: IR Expressions
  IRBinaryOp =
   | IrAddInt | IrSubInt | IrMulInt | IrDivInt | IrPowInt | IrRemInt
   | IrAddNum | IrSubNum | IrMulNum | IrDivNum
   | IrAddRealApprox | IrSubRealApprox | IrMulRealApprox | IrDivRealApprox
   | IrAddRealTrapping | IrSubRealTrapping | IrMulRealTrapping | IrDivRealTrapping
   | IrAddRealSaturating | IrSubRealSaturating | IrMulRealSaturating | IrDivRealSaturating
   | IrEq | IrNotEq | IrLt | IrGt | IrLtEq | IrGtEq
   | IrAnd | IrOr
   | IrAppendText | IrAppendList
   | IrConsList
   | IrApproxEq
   | IrApproxEqExact
   | IrAddVec | IrSubVec | IrMulVec | IrDivVec
   | IrLtVec | IrGtVec | IrLtEqVec | IrGtEqVec

  IRExpr =
   | IrIntLit (Integer) (SourceSpan)
   | IrNumLit (Integer) (SourceSpan)
   | IrTextLit (Text) (SourceSpan)
   | IrBoolLit (Boolean) (SourceSpan)
   | IrCharLit (Integer) (SourceSpan)
   | IrName (Text) (CodexType) (SourceSpan)
   | IrBinary (IRBinaryOp) (IRExpr) (IRExpr) (CodexType) (SourceSpan)
   | IrNegate (IRExpr) (CodexType) (SourceSpan)
   | IrIf (IRExpr) (IRExpr) (IRExpr) (CodexType) (SourceSpan)
   | IrLet (Text) (CodexType) (IRExpr) (IRExpr) (SourceSpan)
   | IrApply (IRExpr) (IRExpr) (CodexType) (SourceSpan)
   | IrLambda (List IRParam) (IRExpr) (CodexType) (SourceSpan)
   | IrList (List IRExpr) (CodexType) (SourceSpan)
   | IrMatch (IRExpr) (List IRBranch) (CodexType) (SourceSpan)
   | IrAct (List IRActStmt) (CodexType) (SourceSpan)
   | IrHandle (Text) (IRExpr) (List IRHandleClause) (CodexType) (SourceSpan)
   | IrWithTimeout (Integer) (List Text) (List Text) (IRExpr) (CodexType) (SourceSpan)
   | IrRecord (Text) (List IRFieldVal) (CodexType) (SourceSpan)
   | IrFieldAccess (IRExpr) (Text) (CodexType) (SourceSpan)
   | IrFork (IRExpr) (CodexType) (SourceSpan)
   | IrAwait (IRExpr) (CodexType) (SourceSpan)
   | IrTry (Integer) (List IRActStmt) (List IRActStmt) (List IRActStmt) (CodexType) (SourceSpan)
   | IrFieldStore (IRExpr) (Text) (IRExpr) (CodexType) (SourceSpan)
   | IrError (Text) (CodexType) (SourceSpan)

  IRParam = record {
   name : Text,
   type-val : CodexType,
   span : SourceSpan
  }

  IRBranch = record {
   pattern : IRPat,
   body : IRExpr,
   guard : IRExpr,
   span : SourceSpan,
   alt-group : Integer
  }

  IRPat =
   | IrVarPat (Text) (CodexType) (SourceSpan)
   | IrLitPat (Text) (CodexType) (SourceSpan)
   | IrCtorPat (Text) (List IRPat) (CodexType) (SourceSpan)
   | IrWildPat (SourceSpan)
   | IrVecPat (List IRPat) (CodexType) (SourceSpan)

  IRActStmt =
   | IrDoBind (Text) (CodexType) (IRExpr) (SourceSpan)
   | IrDoExec (IRExpr) (SourceSpan)

  ir-act-stmt-expr : IRActStmt -> IRExpr
  ir-act-stmt-expr (s) =
   when s
    is IrDoBind (n) (t) (v) (sp) ->
     let result = v
     in result
    is IrDoExec (v) (sp) -> v

  IRHandleClause = record {
   op-name : Text,
   params : List Text,
   resume-name : Text,
   body : IRExpr,
   span : SourceSpan
  }

  IRFieldVal = record {
   name : Text,
   value : IRExpr,
   span : SourceSpan
  }

Section: IR Definitions
  IRDef = record {
   name : Text,
   params : List IRParam,
   type-val : CodexType,
   body : IRExpr,
   chapter-slug : Text,
   is-punctual : Boolean,
   wcet-budget : Integer,
   unique-params : List Text,
   span : SourceSpan
  }

  IRChapter = record {
   name : Name,
   defs : List IRDef,
   effect-op-names : List Text,
   span : SourceSpan
  }

  ProseTransition =
   | PtNone
   | PtWeSay
   | PtThisIsWritten

  ProseTemplate =
   | PtNoTemplate
   | PtRecordTemplate (Text)
   | PtVariantTemplate (Text)
   | PtFunctionTemplate (Text)
   | PtConstraintTemplate
   | PtProofTemplate
   | PtProcedureTemplate
   | PtQuantifiedTemplate

  ProseBlock = record {
   text : Text,
   transition : ProseTransition,
   template : ProseTemplate,
   anchor : Text,
   offset : Integer
  }

 These four are declared here rather than in Syntax chapter
 SyntaxNodes, where the parser that builds them lives, because the
 plug bundle takes this chapter's declarations and not that one's.
 A plug that cannot name ProseBlock cannot read the pblocks form the
 text emitter writes, and the field it leaves empty is indistinguishable
 from a chapter that carried no prose.

  AnnotationNode = record {
   kind : Text,
   target : Text,
   body : Text
  }

  IRTextMeta = record {
   chapter-title : Text,
   prose : Text,
   section-titles : List Text,
   ctor-names : List Text,
   prose-blocks : List ProseBlock,
   annotations : List AnnotationNode,
   ground-effects : List Text
  }

 ground-effects carries the chapter's grounds table onto the text wire as
 the type checker holds it: one "slug\neffect" entry per grounded effect.
 A chapter grounds the hardware effects it is the SOURCE of and its bodies
 may then perform exactly those without declaring them, which means a
 reader of the IR text sees a signature performing an effect it does not
 declare and has no way to tell that from a violation. It had no way at
 all before 2026-08-04: the rule was enforced by the compiler and absent
 from the artifact, so an independent checker reported every grounded call
 in the tree.

Section: IR Expression Type
  ir-expr-type : IRExpr -> CodexType
  ir-expr-type (e) =
   when e
    is IrIntLit (v) (s) -> int-ty-default
    is IrNumLit (v) (s) -> real-f64
    is IrTextLit (v) (s) -> TextTy
    is IrBoolLit (v) (s) -> BooleanTy
    is IrCharLit (v) (s) -> CharTy
    is IrName (n) (t) (s) | IrBinary (op) (l) (r) (t) (s) -> t
    is IrNegate (x) (t) (s) -> t
    is IrIf (c) (th) (el) (t) (s) -> t
    is IrLet (n) (t) (v) (b) (s) -> ir-expr-type b
    is IrApply (f) (a) (t) (s) | IrLambda (ps) (b) (t) (s) -> t
    is IrList (es) (t) (s) -> ListTy t
    is IrMatch (sc) (bs) (t) (s) | IrAct (ss) (t) (s) | IrHandle (eff) (h) (cs) (t) (s) | IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) | IrRecord (n) (fs) (t) (s) | IrFieldAccess (r) (f) (t) (s) | IrFork (body) (t) (s) | IrAwait (task) (t) (s) | IrTry (max) (body) (fb) (fail) (t) (s) | IrFieldStore (r) (f) (v) (t) (s) | IrError (m) (t) (s) -> t

  set-ir-expr-type : IRExpr, CodexType -> IRExpr
  set-ir-expr-type (e) (new-ty) =
   when e
    is IrName (n) (t) (s) -> deck-record (IrName n new-ty s)
    is IrApply (f) (a) (t) (s) -> deck-record (IrApply f a new-ty s)
    is IrLet (n) (t) (v) (b) (s) -> deck-record (IrLet n new-ty v b s)
    is IrIf (c) (th) (el) (t) (s) -> deck-record (IrIf c th el new-ty s)
    is IrMatch (sc) (bs) (t) (s) -> deck-record (IrMatch sc bs new-ty s)
    is IrAct (ss) (t) (s) -> deck-record (IrAct ss new-ty s)
    is IrRecord (n) (fs) (t) (s) -> deck-record (IrRecord n fs new-ty s)
    is IrFieldAccess (r) (f) (t) (s) -> deck-record (IrFieldAccess r f new-ty s)
    is otherwise -> e

  ir-expr-span : IRExpr -> SourceSpan
  ir-expr-span (e) =
   when e
    is IrIntLit (v) (s) | IrNumLit (v) (s) | IrTextLit (v) (s) | IrBoolLit (v) (s) | IrCharLit (v) (s) | IrName (n) (t) (s) | IrBinary (op) (l) (r) (t) (s) | IrNegate (x) (nt) (s) | IrIf (c) (th) (el) (t) (s) | IrLet (n) (t) (v) (b) (s) | IrApply (f) (a) (t) (s) | IrLambda (ps) (b) (t) (s) | IrList (es) (t) (s) | IrMatch (sc) (bs) (t) (s) | IrAct (ss) (t) (s) | IrHandle (eff) (h) (cs) (t) (s) | IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) | IrRecord (n) (fs) (t) (s) | IrFieldAccess (r) (f) (t) (s) | IrFork (body) (t) (s) | IrAwait (task) (t) (s) | IrTry (max) (body) (fb) (fail) (t) (s) | IrFieldStore (r) (f) (v) (t) (s) | IrError (m) (t) (s) -> s

Page 1


Chapter: Parsmi--AST Nodes

Section: Names and Literals
  LiteralKind =
   | IntLit
   | NumLit
   | TextLit
   | CharLit
   | BoolLit

  BinaryOp =
   | OpAdd
   | OpSub
   | OpMul
   | OpDiv
   | OpPow
   | OpEq
   | OpNotEq
   | OpLt
   | OpGt
   | OpLtEq
   | OpGtEq
   | OpDefEq
   | OpAppend
   | OpCons
   | OpAnd
   | OpOr
   | OpApproxEq
   | OpApproxEqExact

Section: Expressions
  AExpr =
   | ALitExpr (Text) (LiteralKind) (SourceSpan)
   | ANameExpr (Name) (SourceSpan)
   | AApplyExpr (AExpr) (AExpr) (SourceSpan)
   | ABinaryExpr (AExpr) (BinaryOp) (AExpr) (SourceSpan)
   | AUnaryExpr (AExpr) (SourceSpan)
   | AIfExpr (AExpr) (AExpr) (AExpr) (SourceSpan)
   | ALetExpr (List ALetBind) (AExpr) (SourceSpan)
   | ALambdaExpr (List Name) (AExpr) (SourceSpan)
   | AMatchExpr (AExpr) (List AMatchArm) (SourceSpan)
   | AListExpr (List AExpr) (SourceSpan)
   | ARecordExpr (Name) (List AFieldExpr) (SourceSpan)
   | AFieldAccess (AExpr) (Name) (SourceSpan)
   | AActExpr (List AActStmt) (SourceSpan)
   | AHandleExpr (Name) (AExpr) (List AHandleClause) (SourceSpan)
   | AWithTimeoutExpr (Text) (List Name) (List Text) (AExpr) (SourceSpan)
   | ATryExpr (Integer) (List AActStmt) (List AActStmt) (List AActStmt) (SourceSpan)
   | AFieldAssignExpr (AExpr) (Name) (AExpr) (SourceSpan)
   | ALazyExpr (AExpr) (SourceSpan)
   | AErrorExpr (Text) (SourceSpan)
   | AInductionExpr (AExpr) (List AMatchArm) (SourceSpan)

  ALetBind = record {
   name : Name,
   value : AExpr,
   span : SourceSpan
  }

  AMatchArm = record {
   pattern : APat,
   body : AExpr,
   guard : AExpr,
   span : SourceSpan,
   alt-group : Integer
  }

  AFieldExpr = record {
   name : Name,
   value : AExpr,
   span : SourceSpan
  }

  AActStmt =
   | AActBindStmt (Name) (AExpr) (SourceSpan)
   | AActExprStmt (AExpr) (SourceSpan)

  AHandleClause = record {
   op-name : Name,
   params : List Name,
   resume-name : Name,
   body : AExpr,
   span : SourceSpan
  }

Section: Patterns
  APat =
   | AVarPat (Name) (SourceSpan)
   | ALitPat (Text) (LiteralKind) (SourceSpan)
   | ACtorPat (Name) (List APat) (SourceSpan)
   | AWildPat (SourceSpan)
   | AVecPat (List APat) (SourceSpan)

Section: Type Expressions
  ATypeExpr =
   | ANamedType (Name) (SourceSpan)
   | AFunType (ATypeExpr) (ATypeExpr) (SourceSpan)
   | AAppType (ATypeExpr) (List ATypeExpr) (SourceSpan)
   | AEffectType (List Name) (List Text) (List Name) (ATypeExpr) (SourceSpan)
   | ABoundedIntType (ATypeExpr) (Integer) (Integer) (OverflowMode) (SourceSpan)
   | APropEqType (ATypeExpr) (ATypeExpr) (SourceSpan)
   | AConstrainedType (Name) (Name) (ATypeExpr) (SourceSpan)
   | ALinearType (ATypeExpr) (SourceSpan)
   | AForallType (Name) (ATypeExpr) (ATypeExpr) (SourceSpan)

Section: Definitions
  AParam = record {
   name : Name,
   span : SourceSpan
  }

  mutable ADef = record {
   name : Name,
   params : List AParam,
   declared-type : List ATypeExpr,
   body : AExpr,
   chapter-slug : Text,
   span : SourceSpan
  }

  ARecordFieldDef = record {
   name : Name,
   type-expr : ATypeExpr,
   span : SourceSpan
  }

  AVariantCtorDef = record {
   name : Name,
   fields : List ATypeExpr,
   return-type : List ATypeExpr,
   span : SourceSpan
  }

  ATypeDef =
   | ARecordTypeDef (Name) (List Name) (List ARecordFieldDef) (Boolean) (SourceSpan)
   | AVariantTypeDef (Name) (List Name) (List AVariantCtorDef) (SourceSpan)
   | AUnitTypeDef (Name) (ATypeExpr) (SourceSpan)

  AEffectOpDef = record {
   name : Name,
   type-expr : ATypeExpr,
   span : SourceSpan
  }

  AEffectDef = record {
   name : Name,
   ops : List AEffectOpDef,
   span : SourceSpan
  }

  AClassDef = record {
   name : Name,
   methods : List AEffectOpDef,
   span : SourceSpan
  }

  AInstanceMethodDef = record {
   name : Name,
   params : List Name,
   body : AExpr,
   span : SourceSpan
  }

  AInstanceDef = record {
   class-name : Name,
   type-name : Name,
   methods : List AInstanceMethodDef,
   span : SourceSpan
  }

Section: Chapter
  ACitesDecl = record {
   quire : Name,
   chapter-name : Name,
   selected-names : List Name,
   citing-chapter : Text,
   span : SourceSpan
  }

  AChapter = record {
   name : Name,
   defs : List ADef,
   type-defs : List ATypeDef,
   effect-defs : List AEffectDef,
   class-defs : List AClassDef,
   instance-defs : List AInstanceDef,
   citations : List ACitesDecl,
   ground-effects : List Text,
   chapter-title : Text,
   prose : Text,
   prose-blocks : List ProseBlock,
   annotations : List AnnotationNode,
   section-titles : List Text,
   rt-names : List Text,
   rt-budgets : List Integer,
   conversions : List Text,
   span : SourceSpan
  }

Section: Span Accessor
  aexpr-span : AExpr -> SourceSpan
  aexpr-span (e) =
   when e
    is ALitExpr (t) (k) (s) | ANameExpr (n) (s) | AApplyExpr (f) (a) (s) | ABinaryExpr (l) (op) (r) (s) | AUnaryExpr (x) (s) | AIfExpr (c) (t) (el) (s) | ALetExpr (bs) (b) (s) | ALambdaExpr (ps) (b) (s) | AMatchExpr (sc) (arms) (s) | AListExpr (es) (s) | ARecordExpr (n) (fs) (s) | AFieldAccess (r) (f) (s) | AActExpr (ss) (s) | AHandleExpr (eff) (b) (cs) (s) | AWithTimeoutExpr (timeout) (effs) (scopes) (b) (s) | ATryExpr (max) (body) (fb) (fail) (s) | AFieldAssignExpr (r) (f) (v) (s) | ALazyExpr (inner) (s) | AErrorExpr (m) (s) | AInductionExpr (sc) (arms) (s) -> s

Section: Deck Copies

 Deep-copy functions for the AST, used by the frontend keep deck
 to copy desugared survivors below the dead LEX/PARSE/DESUGAR
 decks. Same positional sharing rule as the CST copiers: values
 at or below the reservation base b are already in the keep
 region and shared in place; values above b are rebuilt. Leaf
 copiers (copy-sx-text, copy-sx-span, copy-sx-ov) live in
 SyntaxNodes. Enums (LiteralKind, BinaryOp) are nullary sums
 that heap-box, so they are rebuilt unconditionally.

  copy-as-name : Integer, Name -> Name
  copy-as-name (b) (n) = Name { value = copy-sx-text b (n.value) }

  copy-as-names : Integer, List Name -> List Name
  copy-as-names (b) (ns) = for n in ns -> copy-as-name b n

  copy-as-litk : LiteralKind -> LiteralKind
  copy-as-litk (k) =
   when k
    is IntLit -> IntLit
    is NumLit -> NumLit
    is TextLit -> TextLit
    is CharLit -> CharLit
    is BoolLit -> BoolLit

  copy-as-binop : BinaryOp -> BinaryOp
  copy-as-binop (op) =
   when op
    is OpAdd -> OpAdd
    is OpSub -> OpSub
    is OpMul -> OpMul
    is OpDiv -> OpDiv
    is OpPow -> OpPow
    is OpEq -> OpEq
    is OpNotEq -> OpNotEq
    is OpLt -> OpLt
    is OpGt -> OpGt
    is OpLtEq -> OpLtEq
    is OpGtEq -> OpGtEq
    is OpDefEq -> OpDefEq
    is OpAppend -> OpAppend
    is OpCons -> OpCons
    is OpAnd -> OpAnd
    is OpOr -> OpOr
    is OpApproxEq -> OpApproxEq
    is OpApproxEqExact -> OpApproxEqExact

  copy-as-actstmt : Integer, AActStmt -> AActStmt
  copy-as-actstmt (b) (s) =
   when s
    is AActBindStmt (n) (e) (sp) -> AActBindStmt (copy-as-name b n) (copy-as-expr b e) (copy-sx-span b sp)
    is AActExprStmt (e) (sp) -> AActExprStmt (copy-as-expr b e) (copy-sx-span b sp)

  copy-as-letbind : Integer, ALetBind -> ALetBind
  copy-as-letbind (b) (lb) = ALetBind { name = copy-as-name b (lb.name), value = copy-as-expr b (lb.value), span = copy-sx-span b (lb.span) }

  copy-as-pat : Integer, APat -> APat
  copy-as-pat (b) (p) =
   when p
    is AVarPat (n) (sp) -> AVarPat (copy-as-name b n) (copy-sx-span b sp)
    is ALitPat (t) (k) (sp) -> ALitPat (copy-sx-text b t) (copy-as-litk k) (copy-sx-span b sp)
    is ACtorPat (n) (args) (sp) -> ACtorPat (copy-as-name b n) (for a in args -> copy-as-pat b a) (copy-sx-span b sp)
    is AWildPat (sp) -> AWildPat (copy-sx-span b sp)
    is AVecPat (subs) (sp) -> AVecPat (for a in subs -> copy-as-pat b a) (copy-sx-span b sp)

  copy-as-matcharm : Integer, AMatchArm -> AMatchArm
  copy-as-matcharm (b) (a) = AMatchArm {
   pattern = copy-as-pat b (a.pattern),
   body = copy-as-expr b (a.body),
   guard = copy-as-expr b (a.guard),
   span = copy-sx-span b (a.span),
   alt-group = a.alt-group
  }

  copy-as-fieldexpr : Integer, AFieldExpr -> AFieldExpr
  copy-as-fieldexpr (b) (f) = AFieldExpr { name = copy-as-name b (f.name), value = copy-as-expr b (f.value), span = copy-sx-span b (f.span) }

  copy-as-handleclause : Integer, AHandleClause -> AHandleClause
  copy-as-handleclause (b) (c) = AHandleClause {
   op-name = copy-as-name b (c.op-name),
   params = copy-as-names b (c.params),
   resume-name = copy-as-name b (c.resume-name),
   body = copy-as-expr b (c.body),
   span = copy-sx-span b (c.span)
  }

  copy-as-expr : Integer, AExpr -> AExpr
  copy-as-expr (b) (e) =
   when e
    is ALitExpr (t) (k) (sp) -> ALitExpr (copy-sx-text b t) (copy-as-litk k) (copy-sx-span b sp)
    is ANameExpr (n) (sp) -> ANameExpr (copy-as-name b n) (copy-sx-span b sp)
    is AApplyExpr (f) (a) (sp) -> AApplyExpr (copy-as-expr b f) (copy-as-expr b a) (copy-sx-span b sp)
    is ABinaryExpr (l) (op) (r) (sp) -> ABinaryExpr (copy-as-expr b l) (copy-as-binop op) (copy-as-expr b r) (copy-sx-span b sp)
    is AUnaryExpr (x) (sp) -> AUnaryExpr (copy-as-expr b x) (copy-sx-span b sp)
    is AIfExpr (c) (t) (el) (sp) -> AIfExpr (copy-as-expr b c) (copy-as-expr b t) (copy-as-expr b el) (copy-sx-span b sp)
    is ALetExpr (bs) (body) (sp) -> ALetExpr (for lb in bs -> copy-as-letbind b lb) (copy-as-expr b body) (copy-sx-span b sp)
    is ALambdaExpr (ps) (body) (sp) -> ALambdaExpr (copy-as-names b ps) (copy-as-expr b body) (copy-sx-span b sp)
    is AMatchExpr (sc) (arms) (sp) -> AMatchExpr (copy-as-expr b sc) (for a in arms -> copy-as-matcharm b a) (copy-sx-span b sp)
    is AListExpr (es) (sp) -> AListExpr (for el in es -> copy-as-expr b el) (copy-sx-span b sp)
    is ARecordExpr (n) (fs) (sp) -> ARecordExpr (copy-as-name b n) (for f in fs -> copy-as-fieldexpr b f) (copy-sx-span b sp)
    is AFieldAccess (rec) (fld) (sp) -> AFieldAccess (copy-as-expr b rec) (copy-as-name b fld) (copy-sx-span b sp)
    is AActExpr (stmts) (sp) -> AActExpr (for s in stmts -> copy-as-actstmt b s) (copy-sx-span b sp)
    is AHandleExpr (eff) (body) (cs) (sp) -> AHandleExpr (copy-as-name b eff) (copy-as-expr b body) (for c in cs -> copy-as-handleclause b c) (copy-sx-span b sp)
    is AWithTimeoutExpr (timeout) (effs) (scopes) (body) (sp) -> AWithTimeoutExpr (copy-sx-text b timeout) (copy-as-names b effs) (copy-sx-texts b scopes) (copy-as-expr b body) (copy-sx-span b sp)
    is ATryExpr (max) (t-stmts) (c-stmts) (f-stmts) (sp) -> ATryExpr max (for ts in t-stmts -> copy-as-actstmt b ts) (for cs in c-stmts -> copy-as-actstmt b cs) (for fs in f-stmts -> copy-as-actstmt b fs) (copy-sx-span b sp)
    is AFieldAssignExpr (rec) (fld) (val) (sp) -> AFieldAssignExpr (copy-as-expr b rec) (copy-as-name b fld) (copy-as-expr b val) (copy-sx-span b sp)
    is ALazyExpr (inner) (sp) -> ALazyExpr (copy-as-expr b inner) (copy-sx-span b sp)
    is AErrorExpr (m) (sp) -> AErrorExpr (copy-sx-text b m) (copy-sx-span b sp)
    is AInductionExpr (sc) (arms) (sp) -> AInductionExpr (copy-as-expr b sc) (for a in arms -> copy-as-matcharm b a) (copy-sx-span b sp)

  copy-as-typeexpr : Integer, ATypeExpr -> ATypeExpr
  copy-as-typeexpr (b) (t) =
   when t
    is ANamedType (n) (sp) -> ANamedType (copy-as-name b n) (copy-sx-span b sp)
    is AFunType (a) (r) (sp) -> AFunType (copy-as-typeexpr b a) (copy-as-typeexpr b r) (copy-sx-span b sp)
    is AAppType (f) (args) (sp) -> AAppType (copy-as-typeexpr b f) (for a in args -> copy-as-typeexpr b a) (copy-sx-span b sp)
    is AEffectType (effs) (caps) (tail) (inner) (sp) -> AEffectType (copy-as-names b effs) (copy-sx-texts b caps) (copy-as-names b tail) (copy-as-typeexpr b inner) (copy-sx-span b sp)
    is ABoundedIntType (inner) (lo) (hi) (mode) (sp) -> ABoundedIntType (copy-as-typeexpr b inner) lo hi (copy-sx-ov mode) (copy-sx-span b sp)
    is APropEqType (l) (r) (sp) -> APropEqType (copy-as-typeexpr b l) (copy-as-typeexpr b r) (copy-sx-span b sp)
    is AConstrainedType (cls) (param) (inner) (sp) -> AConstrainedType (copy-as-name b cls) (copy-as-name b param) (copy-as-typeexpr b inner) (copy-sx-span b sp)
    is ALinearType (inner) (sp) -> ALinearType (copy-as-typeexpr b inner) (copy-sx-span b sp)
    is AForallType (v) (vt) (p) (sp) -> AForallType (copy-as-name b v) (copy-as-typeexpr b vt) (copy-as-typeexpr b p) (copy-sx-span b sp)

  copy-as-param : Integer, AParam -> AParam
  copy-as-param (b) (p) = AParam { name = copy-as-name b (p.name), span = copy-sx-span b (p.span) }

  copy-as-def : Integer, ADef -> ADef
  copy-as-def (b) (d) = ADef {
   name = copy-as-name b (d.name),
   params = for p in (d.params) -> copy-as-param b p,
   declared-type = for t in (d.declared-type) -> copy-as-typeexpr b t,
   body = copy-as-expr b (d.body),
   chapter-slug = copy-sx-text b (d.chapter-slug),
   span = copy-sx-span b (d.span)
  }

  copy-as-recordfielddef : Integer, ARecordFieldDef -> ARecordFieldDef
  copy-as-recordfielddef (b) (f) = ARecordFieldDef { name = copy-as-name b (f.name), type-expr = copy-as-typeexpr b (f.type-expr), span = copy-sx-span b (f.span) }

  copy-as-variantctordef : Integer, AVariantCtorDef -> AVariantCtorDef
  copy-as-variantctordef (b) (c) = AVariantCtorDef { name = copy-as-name b (c.name), fields = for f in (c.fields) -> copy-as-typeexpr b f, return-type = for r in (c.return-type) -> copy-as-typeexpr b r, span = copy-sx-span b (c.span) }

  copy-as-typedef : Integer, ATypeDef -> ATypeDef
  copy-as-typedef (b) (d) =
   when d
    is ARecordTypeDef (n) (ps) (fs) (m) (sp) -> ARecordTypeDef (copy-as-name b n) (copy-as-names b ps) (for f in fs -> copy-as-recordfielddef b f) m (copy-sx-span b sp)
    is AVariantTypeDef (n) (ps) (cs) (sp) -> AVariantTypeDef (copy-as-name b n) (copy-as-names b ps) (for c in cs -> copy-as-variantctordef b c) (copy-sx-span b sp)
    is AUnitTypeDef (n) (base) (sp) -> AUnitTypeDef (copy-as-name b n) (copy-as-typeexpr b base) (copy-sx-span b sp)

  copy-as-effectopdef : Integer, AEffectOpDef -> AEffectOpDef
  copy-as-effectopdef (b) (o) = AEffectOpDef { name = copy-as-name b (o.name), type-expr = copy-as-typeexpr b (o.type-expr), span = copy-sx-span b (o.span) }

  copy-as-effectdef : Integer, AEffectDef -> AEffectDef
  copy-as-effectdef (b) (d) = AEffectDef { name = copy-as-name b (d.name), ops = for o in (d.ops) -> copy-as-effectopdef b o, span = copy-sx-span b (d.span) }

  copy-as-classdef : Integer, AClassDef -> AClassDef
  copy-as-classdef (b) (d) = AClassDef { name = copy-as-name b (d.name), methods = for m in (d.methods) -> copy-as-effectopdef b m, span = copy-sx-span b (d.span) }

  copy-as-instmethod : Integer, AInstanceMethodDef -> AInstanceMethodDef
  copy-as-instmethod (b) (m) = AInstanceMethodDef {
   name = copy-as-name b (m.name),
   params = copy-as-names b (m.params),
   body = copy-as-expr b (m.body),
   span = copy-sx-span b (m.span)
  }

  copy-as-instancedef : Integer, AInstanceDef -> AInstanceDef
  copy-as-instancedef (b) (d) = AInstanceDef {
   class-name = copy-as-name b (d.class-name),
   type-name = copy-as-name b (d.type-name),
   methods = for m in (d.methods) -> copy-as-instmethod b m,
   span = copy-sx-span b (d.span)
  }

  copy-as-citesdecl : Integer, ACitesDecl -> ACitesDecl
  copy-as-citesdecl (b) (c) = ACitesDecl {
   quire = copy-as-name b (c.quire),
   chapter-name = copy-as-name b (c.chapter-name),
   selected-names = copy-as-names b (c.selected-names),
   citing-chapter = copy-sx-text b (c.citing-chapter),
   span = copy-sx-span b (c.span)
  }

  copy-as-chapter : Integer, AChapter -> AChapter
  copy-as-chapter (b) (ch) = AChapter {
   name = copy-as-name b (ch.name),
   defs = for d in (ch.defs) -> copy-as-def b d,
   type-defs = for t in (ch.type-defs) -> copy-as-typedef b t,
   effect-defs = for e in (ch.effect-defs) -> copy-as-effectdef b e,
   class-defs = for c in (ch.class-defs) -> copy-as-classdef b c,
   instance-defs = for i in (ch.instance-defs) -> copy-as-instancedef b i,
   citations = for c in (ch.citations) -> copy-as-citesdecl b c,
   ground-effects = copy-sx-texts b (ch.ground-effects),
   chapter-title = copy-sx-text b (ch.chapter-title),
   prose = copy-sx-text b (ch.prose),
   prose-blocks = for p in (ch.prose-blocks) -> copy-sx-proseblock b p,
   annotations = for a in (ch.annotations) -> copy-sx-annotation b a,
   section-titles = copy-sx-texts b (ch.section-titles),
   rt-names = copy-sx-texts b (ch.rt-names),
   rt-budgets = for x in (ch.rt-budgets) -> x,
   conversions = copy-sx-texts b (ch.conversions),
   span = copy-sx-span b (ch.span)
  }

 The frontier is __heap-save (R10), not __deck-pos: this copy runs inside
 a phase-wide deck-record extent, where __deck-exit writes the deck-pos
 cell back only when the nesting counter returns to zero, so the cell is
 frozen at the deck's base for the whole copy. Measured 2026-07-21 with a
 `deck-record (__heap-save)` probe on either side of the extent: R10
 inside it reads exactly fk-base at entry and exactly the post-exit cell
 value at exit, so it tracks the deck the cell cannot.

 On saturation an EMPTY chapter is returned, and it must be empty rather
 than the shared original -- this is DESUGAR's contract, not the
 PARSE-KEEP one, because the callers differ in what happens next.
 compile-parse ends its phase at its copy, so returning the shared scratch
 there is safe until the caller halts. compile-desugar-and-scope does NOT:
 it compacts the DESUGAR deck three lines later and runs SCOPE inside the
 same function, before any caller can read the bag. Measured by shipping
 the shared original: the selfhost against an 8 MB keep floor dies
 `!EXC=0d` in scope-adefs-ll, reading a chapter whose deck had been
 reclaimed underneath it. The empty wind-down is O(1) -- a name and a span
 -- so it cannot walk through the ceiling the way LEX's token conversion
 did.

  GuardedChapterCopy = record {
   chapter : AChapter,
   sat : Integer
  }

  copy-as-defs-guarded : Integer, Integer, List ADef, Integer, Integer, List ADef -> List ADef
  copy-as-defs-guarded (b) (ceiling) (ds) (i) (len) (acc) =
   if i == len then acc
   else if __heap-save >= ceiling then acc
   else copy-as-defs-guarded b ceiling ds (i + 1) len (list-push acc (copy-as-def b (list-at ds i)))

  copy-as-typedefs-guarded : Integer, Integer, List ATypeDef, Integer, Integer, List ATypeDef -> List ATypeDef
  copy-as-typedefs-guarded (b) (ceiling) (ts) (i) (len) (acc) =
   if i == len then acc
   else if __heap-save >= ceiling then acc
   else copy-as-typedefs-guarded b ceiling ts (i + 1) len (list-push acc (copy-as-typedef b (list-at ts i)))

  copy-as-proseblocks-guarded : Integer, Integer, List ProseBlock, Integer, Integer, List ProseBlock -> List ProseBlock
  copy-as-proseblocks-guarded (b) (ceiling) (ps) (i) (len) (acc) =
   if i == len then acc
   else if __heap-save >= ceiling then acc
   else copy-as-proseblocks-guarded b ceiling ps (i + 1) len (list-push acc (copy-sx-proseblock b (list-at ps i)))

  copy-as-annotations-guarded : Integer, Integer, List AnnotationNode, Integer, Integer, List AnnotationNode -> List AnnotationNode
  copy-as-annotations-guarded (b) (ceiling) (ns) (i) (len) (acc) =
   if i == len then acc
   else if __heap-save >= ceiling then acc
   else copy-as-annotations-guarded b ceiling ns (i + 1) len (list-push acc (copy-sx-annotation b (list-at ns i)))

  empty-as-chapter : Integer, AChapter -> AChapter
  empty-as-chapter (b) (ch) = AChapter {
   name = copy-as-name b (ch.name),
   defs = [],
   type-defs = [],
   effect-defs = [],
   class-defs = [],
   instance-defs = [],
   citations = [],
   ground-effects = [],
   chapter-title = "",
   prose = "",
   prose-blocks = [],
   annotations = [],
   section-titles = [],
   rt-names = [],
   rt-budgets = [],
   conversions = [],
   span = copy-sx-span b (ch.span)
  }

  copy-as-chapter-guarded : Integer, Integer, AChapter -> GuardedChapterCopy
  copy-as-chapter-guarded (b) (ceiling) (ch) =
   let defs2 = copy-as-defs-guarded b ceiling (ch.defs) 0 (list-length (ch.defs)) []
   in let tds2 = copy-as-typedefs-guarded b ceiling (ch.type-defs) 0 (list-length (ch.type-defs)) []
   in let pbs2 = copy-as-proseblocks-guarded b ceiling (ch.prose-blocks) 0 (list-length (ch.prose-blocks)) []
   in let anns2 = copy-as-annotations-guarded b ceiling (ch.annotations) 0 (list-length (ch.annotations)) []
   in if __heap-save >= ceiling
      then GuardedChapterCopy { chapter = empty-as-chapter b ch, sat = 1 }
      else GuardedChapterCopy { chapter = AChapter {
       name = copy-as-name b (ch.name),
       defs = defs2,
       type-defs = tds2,
       effect-defs = for e in (ch.effect-defs) -> copy-as-effectdef b e,
       class-defs = for c in (ch.class-defs) -> copy-as-classdef b c,
       instance-defs = for i in (ch.instance-defs) -> copy-as-instancedef b i,
       citations = for c in (ch.citations) -> copy-as-citesdecl b c,
       ground-effects = copy-sx-texts b (ch.ground-effects),
       chapter-title = copy-sx-text b (ch.chapter-title),
       prose = copy-sx-text b (ch.prose),
       prose-blocks = pbs2,
       annotations = anns2,
       section-titles = copy-sx-texts b (ch.section-titles),
       rt-names = copy-sx-texts b (ch.rt-names),
       rt-budgets = for x in (ch.rt-budgets) -> x,
       conversions = copy-sx-texts b (ch.conversions),
       span = copy-sx-span b (ch.span)
      }, sat = 0 }

Page 1


Chapter: Parsmi--IR Text Parser

   1. tokenize : Text -> List SExpToken
   2. build-tree : List SExpToken -> SExp
   3. walk-* : SExp -> {IRChapter, IRDef, IRExpr, ...}

Section: Token Types

  SExpToken =
   | TokOpen
   | TokClose
   | TokAtom (Text)
   | TokStr (Text)

Section: Tree Types

  SExp =
   | SAtom (Text)
   | SStr (Text)
   | SList (List SExp)

Section: Parse Result

  ParsedIR = record {
   chapter : IRChapter,
   meta : IRTextMeta,
   type-defs : List ATypeDef,
   effect-op-names : List Text
  }

Section: Tokenize

 Every recursion here is a SELF call, and that is load-bearing: the
 emitter turns only self tail calls into jumps (is-self-call gates the
 TCO), so a mutually tail-recursive loop pays one stack frame per hop.
 This tokenizer used to hop tokenize-loop -> tokenize-atom ->
 tokenize-loop per token and scan-string-body <-> scan-string-escape
 per escaped character, which is one frame per token of input: on a
 48 MB IR payload (ui-orchestrator-test, 2026-07-28) the plug VM
 double-faulted with the stack exhausted inside tokenize-atom. The
 helpers now RETURN to the one loop instead of continuing it, and the
 loop alone recurses.

  tokenize : Text -> List SExpToken
  tokenize (s) = tokenize-loop s 0 (text-length s) []

  tokenize-loop : Text, Integer, Integer, List SExpToken -> List SExpToken
  tokenize-loop (s) (i) (len) (acc) =
   if i >= len then acc
   else let c = char-code-at s i
   in if is-sexp-space c then tokenize-loop s (i + 1) len acc
   else if c == char-code-at "(" 0 then tokenize-loop s (i + 1) len (list-push acc TokOpen)
   else if c == char-code-at ")" 0 then tokenize-loop s (i + 1) len (list-push acc TokClose)
   else if c == char-code-at "\"" 0 then
    let r = scan-string-body s (i + 1) len []
    in tokenize-loop s (r.next) len (list-push acc (TokStr (r.value)))
   else
    let stop = scan-atom-end s i len
    in tokenize-loop s stop len (list-push acc (TokAtom (substring s i (stop - i))))

  is-sexp-space : Integer -> Boolean
  is-sexp-space (c) =
   if c == char-code-at " " 0 then True
   else if c == char-code-at "\n" 0 then True
   else False

  is-atom-char : Integer -> Boolean
  is-atom-char (c) =
   if c == char-code-at "(" 0 then False
   else if c == char-code-at ")" 0 then False
   else if c == char-code-at "\"" 0 then False
   else if is-sexp-space c then False
   else True

  scan-atom-end : Text, Integer, Integer -> Integer
  scan-atom-end (s) (i) (len) =
   if i >= len then i
   else if is-atom-char (char-code-at s i) then scan-atom-end s (i + 1) len
   else i

  StringScanResult = record {
   value : Text,
   next : Integer
  }

 The escape arm advances TWO characters inside the one self loop
 rather than handing off to a second function: a hop per escaped
 character is a frame per escaped character (see the tokenizer prose).

  scan-string-body : Text, Integer, Integer, List Text -> StringScanResult
  scan-string-body (s) (i) (len) (acc) =
   if i >= len then StringScanResult { value = text-concat-list acc, next = i }
   else let c = char-code-at s i
   in if c == char-code-at "\"" 0 then StringScanResult { value = text-concat-list acc, next = i + 1 }
   else if c == char-code-at "\\" 0 then
    (if i + 1 >= len then StringScanResult { value = text-concat-list acc, next = i + 1 }
     else scan-string-body s (i + 2) len (list-push acc (unescape-char-text (char-code-at s (i + 1)))))
   else scan-string-body s (i + 1) len (list-push acc (char-to-text (code-to-char c)))

  unescape-char-text : Integer -> Text
  unescape-char-text (c) =
   if c == char-code-at "\\" 0 then "\\"
   else if c == char-code-at "\"" 0 then "\""
   else if c == char-code-at "n" 0 then "\n"
   else char-to-text (code-to-char c)

Section: Tree Builder

  TreeResult = record {
   tree : SExp,
   next : Integer
  }

  build-tree : List SExpToken -> SExp
  build-tree (tokens) =
   let r = parse-sexp tokens 0 (list-length tokens)
   in r.tree

  parse-sexp : List SExpToken, Integer, Integer -> TreeResult
  parse-sexp (tokens) (i) (len) =
   if i >= len then TreeResult { tree = SAtom "", next = i }
   else let t = list-at tokens i
   in when t
    is TokOpen -> parse-list-body tokens (i + 1) len []
    is TokClose -> TreeResult { tree = SAtom "", next = i + 1 }
    is TokAtom (a) -> TreeResult { tree = SAtom a, next = i + 1 }
    is TokStr (s) -> TreeResult { tree = SStr s, next = i + 1 }

  parse-list-body : List SExpToken, Integer, Integer, List SExp -> TreeResult
  parse-list-body (tokens) (i) (len) (acc) =
   if i >= len then TreeResult { tree = SList acc, next = i }
   else let t = list-at tokens i
   in when t
    is TokClose -> TreeResult { tree = SList acc, next = i + 1 }
    is otherwise -> let r = parse-sexp tokens i len
     in parse-list-body tokens (r.next) len (list-push acc (r.tree))

Section: Tree Helpers

  sexp-atom : SExp -> Text
  sexp-atom (e) =
   when e
    is SAtom (a) -> a
    is otherwise -> ""

  sexp-str : SExp -> Text
  sexp-str (e) =
   when e
    is SStr (s) -> s
    is otherwise -> ""

  sexp-int : SExp -> Integer
  sexp-int (e) =
   when e
    is SAtom (a) -> sexp-atom-to-int a
    is otherwise -> 0

  sexp-atom-to-int : Text -> Integer
  sexp-atom-to-int (a) =
   if a == "i64-min" then i64-min else parse-int-text a

  sexp-list : SExp -> List SExp
  sexp-list (e) =
   when e
    is SList (xs) -> xs
    is otherwise -> []

  sexp-head : SExp -> Text
  sexp-head (e) =
   when e
    is SList (xs) -> if list-length xs == 0 then "" else sexp-atom (list-at xs 0)
    is SAtom (a) -> a
    is otherwise -> ""

  parse-int-text : Text -> Integer
  parse-int-text (s) =
   let len = text-length s
   in if len == 0 then 0
   else let first = char-code-at s 0
   in if first == char-code-at "-" 0 then 0 - parse-int-loop s 1 len 0
   else parse-int-loop s 0 len 0

  parse-int-loop : Text, Integer, Integer, Integer -> Integer
  parse-int-loop (s) (i) (len) (acc) =
   if i >= len then acc
   else let c = char-code-at s i
   in let zero = char-code-at "0" 0
   in let nine = char-code-at "9" 0
   in if c >= zero then if c <= nine then parse-int-loop s (i + 1) len (acc * 10 + (c - zero))
                                       else acc
   else acc

Section: OverflowMode + BinaryOp

  parse-ov-mode : Text -> OverflowMode
  parse-ov-mode (a) =
   if a == "ov-error" then OvError
   else if a == "ov-wrap" then OvWrapping
   else if a == "ov-clamp" then OvClamping
   else OvError

  parse-bin-op : Text -> IRBinaryOp
  parse-bin-op (a) =
   if a == "add-int" then IrAddInt
   else if a == "sub-int" then IrSubInt
   else if a == "mul-int" then IrMulInt
   else if a == "div-int" then IrDivInt
   else if a == "rem-int" then IrRemInt
   else if a == "pow-int" then IrPowInt
   else if a == "add-num" then IrAddNum
   else if a == "sub-num" then IrSubNum
   else if a == "mul-num" then IrMulNum
   else if a == "div-num" then IrDivNum
   else if a == "add-real-approx" then IrAddRealApprox
   else if a == "sub-real-approx" then IrSubRealApprox
   else if a == "mul-real-approx" then IrMulRealApprox
   else if a == "div-real-approx" then IrDivRealApprox
   else if a == "add-real-trapping" then IrAddRealTrapping
   else if a == "sub-real-trapping" then IrSubRealTrapping
   else if a == "mul-real-trapping" then IrMulRealTrapping
   else if a == "div-real-trapping" then IrDivRealTrapping
   else if a == "add-real-saturating" then IrAddRealSaturating
   else if a == "sub-real-saturating" then IrSubRealSaturating
   else if a == "mul-real-saturating" then IrMulRealSaturating
   else if a == "div-real-saturating" then IrDivRealSaturating
   else if a == "add-vec" then IrAddVec
   else if a == "sub-vec" then IrSubVec
   else if a == "mul-vec" then IrMulVec
   else if a == "div-vec" then IrDivVec
   else if a == "lt-vec" then IrLtVec
   else if a == "gt-vec" then IrGtVec
   else if a == "le-vec" then IrLtEqVec
   else if a == "ge-vec" then IrGtEqVec
   else if a == "eq" then IrEq
   else if a == "ne" then IrNotEq
   else if a == "lt" then IrLt
   else if a == "gt" then IrGt
   else if a == "le" then IrLtEq
   else if a == "ge" then IrGtEq
   else if a == "and" then IrAnd
   else if a == "or" then IrOr
   else if a == "append-text" then IrAppendText
   else if a == "append-list" then IrAppendList
   else if a == "cons-list" then IrConsList
   else if a == "approx-eq" then IrApproxEq
   else if a == "approx-eq-exact" then IrApproxEqExact
   else if a == "add-vec" then IrAddVec
   else if a == "sub-vec" then IrSubVec
   else if a == "mul-vec" then IrMulVec
   else if a == "div-vec" then IrDivVec
   else IrAddInt

Section: CodexType

  parse-type : SExp -> CodexType
  parse-type (e) =
   when e
    is SAtom (a) -> parse-type-atom a
    is SList (xs) -> parse-type-list xs
    is otherwise -> ErrorTy

  parse-type-atom : Text -> CodexType
  parse-type-atom (a) =
   if a == "int-default" then int-ty-default
   else if a == "real" then real-f64
   else if a == "real-approx" then real-f32
   else if a == "real-trapping" then real-f64-trapping
   else if a == "real-saturating" then real-f64-saturating
   else if a == "real-approx-trapping" then RealTy RwF32 RmTrapping
   else if a == "real-approx-saturating" then RealTy RwF32 RmSaturating
   else if a == "text" then TextTy
   else if a == "boolean" then BooleanTy
   else if a == "char" then CharTy
   else if a == "void" then VoidTy
   else if a == "nothing" then NothingTy
   else if a == "error" then ErrorTy
   else if a == "proof" then ProofTy
   else ErrorTy

  parse-type-list : List SExp -> CodexType
  parse-type-list (xs) =
   if list-length xs == 0 then ErrorTy
   else let head = sexp-atom (list-at xs 0)
   in if head == "int" then parse-type-int xs
   else if head == "fn" then parse-type-fn xs
   else if head == "list" then ListTy (parse-type (list-at xs 1))
   else if head == "llist" then LinkedListTy (parse-type (list-at xs 1))
   else if head == "tvar" then TypeVar (__narrow (sexp-int (list-at xs 1)))
   else if head == "forall" then ForAllTy (__narrow (sexp-int (list-at xs 1))) (parse-type (list-at xs 2))
   else if head == "sum" then parse-type-sum xs
   else if head == "record-ty" then parse-type-record xs
   else if head == "ctd" then parse-type-ctd xs
   else if head == "effectful" then parse-type-effectful xs
   else if head == "vector" then VectorTy (sexp-int (list-at xs 1)) (parse-type (list-at xs 2))
   else if head == "unit" then UnitTy (make-name (sexp-str (list-at xs 1))) (parse-type (list-at xs 2))
   else if head == "vector-mask" then VectorMaskTy (sexp-int (list-at xs 1))
   else if head == "propeq" then PropEqTy (parse-type (list-at xs 1)) (parse-type (list-at xs 2))
   else if head == "tycon" then TypeCon (make-name (sexp-str (list-at xs 1)))
   else if head == "tyapply" then TypeApply (parse-type (list-at xs 1)) (parse-type (list-at xs 2))
   else ErrorTy

  parse-type-fn : List SExp -> CodexType
  parse-type-fn (xs) =
   let row = if list-length xs > 3 then parse-row (list-at xs 3) else empty-row
   in FunTy (parse-type (list-at xs 1)) row (parse-type (list-at xs 2))

  parse-row : SExp -> EffectRow
  parse-row (e) =
   let xs = sexp-list e
   in if list-length xs < 4 then empty-row
   else let labels = parse-row-labels (sexp-list (list-at xs 1)) 1 []
   in EffectRow { labels = labels, tail-name = sexp-str (list-at xs 2), tail-id = __narrow (sexp-int (list-at xs 3)) }

  parse-row-labels : List SExp, Integer, List EffectLabel -> List EffectLabel
  parse-row-labels (xs) (i) (acc) =
   if i >= list-length xs then acc
   else let l = sexp-list (list-at xs i)
   in let lab = EffectLabel { name = make-name (sexp-str (list-at l 1)), scope = sexp-str (list-at l 2) }
   in parse-row-labels xs (i + 1) (list-push acc lab)

  parse-type-int : List SExp -> CodexType
  parse-type-int (xs) =
   IntegerTy (sexp-int (list-at xs 1)) (sexp-int (list-at xs 2)) (parse-ov-mode (sexp-atom (list-at xs 3)))

  parse-type-sum : List SExp -> CodexType
  parse-type-sum (xs) =
   let name = make-name (sexp-str (list-at xs 1))
   in let args = parse-type-args (sexp-list (list-at xs 2))
   in let ctors = if list-length xs > 3 then parse-sum-ctors (sexp-list (list-at xs 3)) else []
   in SumTy name args ctors

  parse-type-record : List SExp -> CodexType
  parse-type-record (xs) =
   let name = make-name (sexp-str (list-at xs 1))
   in let args = parse-type-args (sexp-list (list-at xs 2))
   in let fields = if list-length xs > 3 then parse-record-fields (sexp-list (list-at xs 3)) else []
   in RecordTy name args fields

  parse-type-ctd : List SExp -> CodexType
  parse-type-ctd (xs) =
   let name = make-name (sexp-str (list-at xs 1))
   in let args = parse-type-args (sexp-list (list-at xs 2))
   in ConstructedTy name args

  parse-type-effectful : List SExp -> CodexType
  parse-type-effectful (xs) =
   let effs = parse-name-list (sexp-list (list-at xs 1))
   in let scopes = parse-text-list (sexp-list (list-at xs 2))
   in let ret = parse-type (list-at xs 3)
   in EffectfulTy effs scopes ret

  parse-type-args : List SExp -> List CodexType
  parse-type-args (xs) = parse-type-args-loop xs 1 (list-length xs) []

  parse-type-args-loop : List SExp, Integer, Integer, List CodexType -> List CodexType
  parse-type-args-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-type-args-loop xs (i + 1) len (list-push acc (parse-type (list-at xs i)))

  parse-sum-ctors : List SExp -> List SumCtor
  parse-sum-ctors (xs) = parse-sum-ctors-loop xs 1 (list-length xs) []

  parse-sum-ctors-loop : List SExp, Integer, Integer, List SumCtor -> List SumCtor
  parse-sum-ctors-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else let inner = sexp-list (list-at xs i)
   in let name = make-name (sexp-str (list-at inner 1))
   in let fields = parse-type-args (sexp-list (list-at inner 2))
   in parse-sum-ctors-loop xs (i + 1) len (list-push acc (SumCtor { name = name, fields = fields, return-type = [] }))

  parse-record-fields : List SExp -> List RecordField
  parse-record-fields (xs) = parse-record-fields-loop xs 1 (list-length xs) []

  parse-record-fields-loop : List SExp, Integer, Integer, List RecordField -> List RecordField
  parse-record-fields-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else let inner = sexp-list (list-at xs i)
   in let name = make-name (sexp-str (list-at inner 1))
   in let ty = parse-type (list-at inner 2)
   in parse-record-fields-loop xs (i + 1) len (list-push acc (RecordField { name = name, type-val = ty }))

Section: Type Def Resolution

 The recovery is exact for an explicitly bounded integer and an
 approximation otherwise: a bare `Integer` and an unrecognised form both
 answer the default width, so a consumer can tell a declared band from a
 default one only by the band being present.

  is-real-atom-name : Text -> Boolean
  is-real-atom-name (n) =
   n == "real" | n == "real-approx" | n == "real-trapping" | n == "real-saturating"
   | n == "real-approx-trapping" | n == "real-approx-saturating"

  atype-to-codex-type : ATypeExpr -> CodexType
  atype-to-codex-type (at) =
   when at
    is ABoundedIntType (base) (lo) (hi) (mode) (sp) -> IntegerTy lo hi mode
    is ALinearType (inner) (sp) -> atype-to-codex-type inner
    is AAppType (ctor) (args) (sp) -> atype-app-to-codex-type ctor args
    is ANamedType (n) (sp) ->
     if is-real-atom-name (n.value) then parse-type-atom (n.value)
     else if n.value == "Boolean" then BooleanTy
     else if n.value == "Text" then TextTy
     else if n.value == "Integer" then int-ty-default
     else if n.value == "Real" then real-f64
     else if n.value == "Char" then CharTy
     else if n.value == "Nothing" then NothingTy
     else if n.value == "Proof" then ProofTy
     else ConstructedTy n []
    is otherwise -> int-ty-default

 A qualifier on a Real is an application ARGUMENT in the surface syntax, not a
 distinct node: `Real approximate` parses to `a-app (a-named "Real") (args
 (a-named "approximate"))`, and the words are interpreted only by
 `resolve-real-quals` in the type checker. This is the mirror of that
 interpretation, and it has to exist because the surface form is ambiguous on
 its own -- `approximate` is spelled exactly like a type variable, and the
 declaration even carries it as one. Keep the arms below in step with
 `TypeChecker.codex` `resolve-applied-type` / `resolve-real-quals`; the two
 are a pair, and drift between them is a silent wrong type rather than an error.

  atype-app-to-codex-type : ATypeExpr, List ATypeExpr -> CodexType
  atype-app-to-codex-type (ctor) (args) =
   when ctor
    is ANamedType (name) (s) ->
     if name.value == "List" then
      (if list-length args == 1 then ListTy (atype-to-codex-type (list-at args 0)) else ListTy ErrorTy)
     else if name.value == "LinkedList" then
      (if list-length args == 1 then LinkedListTy (atype-to-codex-type (list-at args 0)) else LinkedListTy ErrorTy)
     else if name.value == "Real" then atype-real-quals name args 0 RwF64 RmDefault True
     else if name.value == "Vector" then
      (if list-length args == 2 then VectorTy (atype-vector-len (list-at args 0)) (atype-to-codex-type (list-at args 1))
       else VectorTy 2 ErrorTy)
     else ConstructedTy name (atypes-to-codex-types args 0 [])
    is AAppType (inner-ctor) (inner-args) (s) -> atype-app-to-codex-type inner-ctor (inner-args & args)
    is otherwise -> atype-to-codex-type ctor

  atype-real-quals : Name, List ATypeExpr, Integer, RealWidth, RealMode, Boolean -> CodexType
  atype-real-quals (name) (args) (i) (w) (m) (all-quals) =
   if list-length args == 0 then real-f64
   else if i >= list-length args then
    (if all-quals then RealTy w m else ConstructedTy name (atypes-to-codex-types args 0 []))
   else let word = when (list-at args i) is ANamedType (qt) (qs) -> qt.value is otherwise -> ""
    in if word == "approximate" then atype-real-quals name args (i + 1) RwF32 m all-quals
    else if word == "trapping" then atype-real-quals name args (i + 1) w RmTrapping all-quals
    else if word == "saturating" then atype-real-quals name args (i + 1) w RmSaturating all-quals
    else atype-real-quals name args (i + 1) w m False

  atype-vector-len : ATypeExpr -> Integer
  atype-vector-len (a) =
   when a
    is ANamedType (n) (s) -> text-to-integer (n.value)
    is otherwise -> 0

  atypes-to-codex-types : List ATypeExpr, Integer, List CodexType -> List CodexType
  atypes-to-codex-types (as) (i) (acc) =
   if i >= list-length as then acc
   else atypes-to-codex-types as (i + 1) (list-push acc (atype-to-codex-type (list-at as i)))

  arec-fields-to-rfields : List ARecordFieldDef, Integer, List RecordField -> List RecordField
  arec-fields-to-rfields (afs) (i) (acc) =
   if i >= list-length afs then acc
   else let af = list-at afs i
   in arec-fields-to-rfields afs (i + 1) (list-push acc (RecordField { name = af.name, type-val = atype-to-codex-type (af.type-expr) }))

  record-fields-by-name : List ATypeDef, Text, Integer -> List RecordField
  record-fields-by-name (tds) (name) (i) =
   if i >= list-length tds then []
   else when list-at tds i
    is ARecordTypeDef (dn) (tparams) (afields) (recmut) (sp) ->
     if dn.value == name then arec-fields-to-rfields afields 0 []
     else record-fields-by-name tds name (i + 1)
    is otherwise -> record-fields-by-name tds name (i + 1)

  avar-ctors-to-sumctors : List AVariantCtorDef, Integer, List SumCtor -> List SumCtor
  avar-ctors-to-sumctors (acs) (i) (acc) =
   if i >= list-length acs then acc
   else let ac = list-at acs i
   in avar-ctors-to-sumctors acs (i + 1) (list-push acc (SumCtor { name = ac.name, fields = atypes-to-codex-types (ac.fields) 0 [], return-type = [] }))

  sum-ctors-by-name : List ATypeDef, Text, Integer -> List SumCtor
  sum-ctors-by-name (tds) (name) (i) =
   if i >= list-length tds then []
   else when list-at tds i
    is AVariantTypeDef (tn) (tps) (ctors) (sp) ->
     if tn.value == name then avar-ctors-to-sumctors ctors 0 []
     else sum-ctors-by-name tds name (i + 1)
    is otherwise -> sum-ctors-by-name tds name (i + 1)

  parse-text-list : List SExp -> List Text
  parse-text-list (xs) = parse-text-list-loop xs 1 (list-length xs) []

  parse-text-list-loop : List SExp, Integer, Integer, List Text -> List Text
  parse-text-list-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-text-list-loop xs (i + 1) len (list-push acc (sexp-str (list-at xs i)))

  parse-name-list : List SExp -> List Name
  parse-name-list (xs) = parse-name-list-loop xs 1 (list-length xs) []

  parse-name-list-loop : List SExp, Integer, Integer, List Name -> List Name
  parse-name-list-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-name-list-loop xs (i + 1) len (list-push acc (make-name (sexp-str (list-at xs i))))

Section: Prose Blocks and Annotations

  parse-prose-blocks : List SExp -> List ProseBlock
  parse-prose-blocks (xs) = parse-prose-blocks-loop xs 1 (list-length xs) []

  parse-prose-blocks-loop : List SExp, Integer, Integer, List ProseBlock -> List ProseBlock
  parse-prose-blocks-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-prose-blocks-loop xs (i + 1) len (list-push acc (parse-prose-block (list-at xs i)))

  parse-prose-block : SExp -> ProseBlock
  parse-prose-block (e) =
   let ys = sexp-list e
   in if list-length ys < 3 then ProseBlock { text = "", transition = PtNone, template = PtNoTemplate, anchor = "", offset = 0 }
   else ProseBlock {
     text = sexp-str (list-at ys 2),
     transition = PtNone,
     template = PtNoTemplate,
     anchor = sexp-str (list-at ys 1),
     offset = 0
    }

  parse-annotations : List SExp -> List AnnotationNode
  parse-annotations (xs) = parse-annotations-loop xs 1 (list-length xs) []

  parse-annotations-loop : List SExp, Integer, Integer, List AnnotationNode -> List AnnotationNode
  parse-annotations-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-annotations-loop xs (i + 1) len (list-push acc (parse-annotation (list-at xs i)))

  parse-annotation : SExp -> AnnotationNode
  parse-annotation (e) =
   let ys = sexp-list e
   in if list-length ys < 4 then AnnotationNode { kind = "", target = "", body = "" }
   else AnnotationNode {
     kind = sexp-str (list-at ys 1),
     target = sexp-str (list-at ys 2),
     body = sexp-str (list-at ys 3)
    }

Section: ATypeExpr

  parse-atype-expr : SExp -> ATypeExpr
  parse-atype-expr (e) =
   let xs = sexp-list e
   in if list-length xs == 0 then ANamedType (make-name "Unknown") synthetic-span
   else let head = sexp-atom (list-at xs 0)
   in if head == "a-named" then ANamedType (make-name (sexp-str (list-at xs 1))) synthetic-span
   else if head == "a-fun" then AFunType (parse-atype-expr (list-at xs 1)) (parse-atype-expr (list-at xs 2)) synthetic-span
   else if head == "a-app" then AAppType (parse-atype-expr (list-at xs 1)) (parse-atype-args (sexp-list (list-at xs 2))) synthetic-span
   else if head == "a-eff" then parse-atype-eff xs
   else if head == "a-bounded" then ABoundedIntType (parse-atype-expr (list-at xs 1)) (sexp-int (list-at xs 2)) (sexp-int (list-at xs 3)) (parse-ov-mode (sexp-atom (list-at xs 4))) synthetic-span
   else if head == "a-linear" then ALinearType (parse-atype-expr (list-at xs 1)) synthetic-span
   else if head == "a-propeq" then APropEqType (parse-atype-expr (list-at xs 1)) (parse-atype-expr (list-at xs 2)) synthetic-span
   else if head == "a-forall" then AForallType (make-name "") (ANamedType (make-name "Unknown") synthetic-span) (ANamedType (make-name "Unknown") synthetic-span) synthetic-span
   else ANamedType (make-name "Unknown") synthetic-span

  parse-atype-eff : List SExp -> ATypeExpr
  parse-atype-eff (xs) =
   let effs = parse-name-list (sexp-list (list-at xs 1))
   in let scopes = parse-text-list (sexp-list (list-at xs 2))
   in let r = parse-atype-expr (list-at xs 3)
   in AEffectType effs scopes [] r synthetic-span

  parse-atype-args : List SExp -> List ATypeExpr
  parse-atype-args (xs) = parse-atype-args-loop xs 1 (list-length xs) []

  parse-atype-args-loop : List SExp, Integer, Integer, List ATypeExpr -> List ATypeExpr
  parse-atype-args-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-atype-args-loop xs (i + 1) len (list-push acc (parse-atype-expr (list-at xs i)))

Section: ATypeDef

  parse-atype-defs : List SExp -> List ATypeDef
  parse-atype-defs (xs) = parse-atype-defs-loop xs 1 (list-length xs) []

  parse-atype-defs-loop : List SExp, Integer, Integer, List ATypeDef -> List ATypeDef
  parse-atype-defs-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-atype-defs-loop xs (i + 1) len (list-push acc (parse-atype-def (list-at xs i)))

  parse-atype-def : SExp -> ATypeDef
  parse-atype-def (e) =
   let xs = sexp-list e
   in let head = sexp-atom (list-at xs 0)
   in if head == "rec-def" then parse-rec-def xs
   else if head == "var-def" then parse-var-def xs
   else if head == "unit-def" then AUnitTypeDef (make-name (sexp-str (list-at xs 1))) (parse-atype-expr (list-at xs 2)) synthetic-span
   else ARecordTypeDef (make-name "Unknown") [] [] False synthetic-span

  parse-rec-def : List SExp -> ATypeDef
  parse-rec-def (xs) =
   let name = make-name (sexp-str (list-at xs 1))
   in let tparams = parse-name-list (sexp-list (list-at xs 2))
   in let fields = parse-rec-field-defs (sexp-list (list-at xs 3))
   in ARecordTypeDef name tparams fields (rec-def-mutable-p xs 4 (list-length xs)) synthetic-span

  rec-def-mutable-p : List SExp, Integer, Integer -> Boolean
  rec-def-mutable-p (xs) (i) (len) =
   if i >= len then False
   else if sexp-head (list-at xs i) == "mutable" then True
   else rec-def-mutable-p xs (i + 1) len

  parse-var-def : List SExp -> ATypeDef
  parse-var-def (xs) =
   let name = make-name (sexp-str (list-at xs 1))
   in let tparams = parse-name-list (sexp-list (list-at xs 2))
   in let ctors = parse-var-ctor-defs (sexp-list (list-at xs 3))
   in AVariantTypeDef name tparams ctors synthetic-span

  parse-rec-field-defs : List SExp -> List ARecordFieldDef
  parse-rec-field-defs (xs) = parse-rec-field-defs-loop xs 1 (list-length xs) []

  parse-rec-field-defs-loop : List SExp, Integer, Integer, List ARecordFieldDef -> List ARecordFieldDef
  parse-rec-field-defs-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else let inner = sexp-list (list-at xs i)
   in let name = make-name (sexp-str (list-at inner 1))
   in let te = parse-atype-expr (list-at inner 2)
   in parse-rec-field-defs-loop xs (i + 1) len (list-push acc (ARecordFieldDef { name = name, type-expr = te, span = synthetic-span }))

  parse-var-ctor-defs : List SExp -> List AVariantCtorDef
  parse-var-ctor-defs (xs) = parse-var-ctor-defs-loop xs 1 (list-length xs) []

  parse-var-ctor-defs-loop : List SExp, Integer, Integer, List AVariantCtorDef -> List AVariantCtorDef
  parse-var-ctor-defs-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else let inner = sexp-list (list-at xs i)
   in let name = make-name (sexp-str (list-at inner 1))
   in let fields = parse-atype-args (sexp-list (list-at inner 2))
   in parse-var-ctor-defs-loop xs (i + 1) len (list-push acc (AVariantCtorDef { name = name, fields = fields, return-type = [], span = synthetic-span }))

Section: IRPattern

  parse-pat : SExp -> IRPat
  parse-pat (e) =
   when e
    is SAtom (a) -> if a == "wild-pat" then IrWildPat synthetic-span
                    else IrWildPat synthetic-span
    is SList (xs) -> parse-pat-list xs
    is otherwise -> IrWildPat synthetic-span

  parse-pat-list : List SExp -> IRPat
  parse-pat-list (xs) =
   if list-length xs == 0 then IrWildPat synthetic-span
   else let head = sexp-atom (list-at xs 0)
   in if head == "var-pat" then IrVarPat (sexp-str (list-at xs 1)) (parse-type (list-at xs 2)) synthetic-span
   else if head == "lit-pat" then IrLitPat (sexp-str (list-at xs 1)) (parse-type (list-at xs 2)) synthetic-span
   else if head == "ctor-pat" then parse-ctor-pat xs
   else if head == "vec-pat" then parse-vec-pat xs
   else IrWildPat synthetic-span

  parse-ctor-pat : List SExp -> IRPat
  parse-ctor-pat (xs) =
   let name = sexp-str (list-at xs 1)
   in let subs = parse-pat-subs (sexp-list (list-at xs 2))
   in let ty = parse-type (list-at xs 3)
   in IrCtorPat name subs ty synthetic-span

  parse-vec-pat : List SExp -> IRPat
  parse-vec-pat (xs) =
   let lane-pats = parse-vec-lane-pats xs 1 (list-length xs) []
   in IrVecPat lane-pats ErrorTy synthetic-span

  parse-vec-lane-pats : List SExp, Integer, Integer, List IRPat -> List IRPat
  parse-vec-lane-pats (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-vec-lane-pats xs (i + 1) len (list-push acc (parse-pat (list-at xs i)))

  parse-pat-subs : List SExp -> List IRPat
  parse-pat-subs (xs) = parse-pat-subs-loop xs 1 (list-length xs) []

  parse-pat-subs-loop : List SExp, Integer, Integer, List IRPat -> List IRPat
  parse-pat-subs-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-pat-subs-loop xs (i + 1) len (list-push acc (parse-pat (list-at xs i)))

Section: IRExpr

  parse-expr : SExp -> IRExpr
  parse-expr (e) =
   let xs = sexp-list e
   in if list-length xs == 0 then IrError "empty-expr" ErrorTy synthetic-span
   else let head = sexp-atom (list-at xs 0)
   in dispatch-expr head xs

  dispatch-expr : Text, List SExp -> IRExpr
  dispatch-expr (head) (xs) =
   if head == "int-lit" then IrIntLit (sexp-int (list-at xs 1)) synthetic-span
   else if head == "num-lit" then IrNumLit (sexp-int (list-at xs 1)) synthetic-span
   else if head == "text-lit" then IrTextLit (sexp-str (list-at xs 1)) synthetic-span
   else if head == "bool-lit" then IrBoolLit (sexp-atom (list-at xs 1) == "true") synthetic-span
   else if head == "char-lit" then IrCharLit (sexp-int (list-at xs 1)) synthetic-span
   else if head == "name" then IrName (sexp-str (list-at xs 1)) (parse-type (list-at xs 2)) synthetic-span
   else if head == "binary" then parse-expr-binary xs
   else if head == "negate" then IrNegate (parse-expr (list-at xs 1)) (parse-type (list-at xs 2)) synthetic-span
   else if head == "if" then IrIf (parse-expr (list-at xs 1)) (parse-expr (list-at xs 2)) (parse-expr (list-at xs 3)) (parse-type (list-at xs 4)) synthetic-span
   else if head == "let" then IrLet (sexp-str (list-at xs 1)) (parse-type (list-at xs 2)) (parse-expr (list-at xs 3)) (parse-expr (list-at xs 4)) synthetic-span
   else if head == "apply" then IrApply (parse-expr (list-at xs 1)) (parse-expr (list-at xs 2)) (parse-type (list-at xs 3)) synthetic-span
   else if head == "lambda" then parse-expr-lambda xs
   else if head == "list-expr" then parse-expr-list xs
   else if head == "match" then parse-expr-match xs
   else if head == "act" then parse-expr-act xs
   else if head == "handle" then parse-expr-handle xs
   else if head == "with-timeout" then parse-expr-timeout xs
   else if head == "record" then parse-expr-record xs
   else if head == "field-access" then IrFieldAccess (parse-expr (list-at xs 1)) (sexp-str (list-at xs 2)) (parse-type (list-at xs 3)) synthetic-span
   else if head == "field-store" then IrFieldStore (parse-expr (list-at xs 1)) (sexp-str (list-at xs 2)) (parse-expr (list-at xs 3)) (parse-type (list-at xs 4)) synthetic-span
   else if head == "try" then parse-expr-try xs
   else if head == "fork" then IrFork (parse-expr (list-at xs 1)) (parse-type (list-at xs 2)) synthetic-span
   else if head == "await" then IrAwait (parse-expr (list-at xs 1)) (parse-type (list-at xs 2)) synthetic-span
   else if head == "error" then IrError (sexp-str (list-at xs 1)) (parse-type (list-at xs 2)) synthetic-span
   else IrError "unknown-form" ErrorTy synthetic-span

  parse-expr-binary : List SExp -> IRExpr
  parse-expr-binary (xs) =
   IrBinary (parse-bin-op (sexp-atom (list-at xs 1))) (parse-expr (list-at xs 2)) (parse-expr (list-at xs 3)) (parse-type (list-at xs 4)) synthetic-span

  parse-expr-lambda : List SExp -> IRExpr
  parse-expr-lambda (xs) =
   let params = parse-params (sexp-list (list-at xs 1))
   in let body = parse-expr (list-at xs 2)
   in let ty = parse-type (list-at xs 3)
   in IrLambda params body ty synthetic-span

  parse-expr-list : List SExp -> IRExpr
  parse-expr-list (xs) =
   let elems = parse-expr-elems (sexp-list (list-at xs 1))
   in let ty = parse-type (list-at xs 2)
   in IrList elems ty synthetic-span

  parse-expr-elems : List SExp -> List IRExpr
  parse-expr-elems (xs) = parse-expr-elems-loop xs 1 (list-length xs) []

  parse-expr-elems-loop : List SExp, Integer, Integer, List IRExpr -> List IRExpr
  parse-expr-elems-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-expr-elems-loop xs (i + 1) len (list-push acc (parse-expr (list-at xs i)))

  parse-expr-match : List SExp -> IRExpr
  parse-expr-match (xs) =
   let scrut = parse-expr (list-at xs 1)
   in let branches = parse-branches (sexp-list (list-at xs 2))
   in let ty = parse-type (list-at xs 3)
   in IrMatch scrut branches ty synthetic-span

  parse-branches : List SExp -> List IRBranch
  parse-branches (xs) = parse-branches-loop xs 1 (list-length xs) []

  parse-branches-loop : List SExp, Integer, Integer, List IRBranch -> List IRBranch
  parse-branches-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else let inner = sexp-list (list-at xs i)
   in let pat = parse-pat (list-at inner 1)
   in let body = parse-expr (list-at inner 2)
   in let guard = if list-length inner > 3 then parse-expr (list-at inner 3) else IrBoolLit True synthetic-span
   in parse-branches-loop xs (i + 1) len (list-push acc (IRBranch { pattern = pat, body = body, guard = guard, span = synthetic-span, alt-group = 0 }))

  parse-expr-act : List SExp -> IRExpr
  parse-expr-act (xs) =
   let stmts = parse-act-stmts (sexp-list (list-at xs 1))
   in let ty = parse-type (list-at xs 2)
   in IrAct stmts ty synthetic-span

  parse-act-stmts : List SExp -> List IRActStmt
  parse-act-stmts (xs) = parse-act-stmts-loop xs 1 (list-length xs) []

  parse-act-stmts-loop : List SExp, Integer, Integer, List IRActStmt -> List IRActStmt
  parse-act-stmts-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-act-stmts-loop xs (i + 1) len (list-push acc (parse-act-stmt (list-at xs i)))

  parse-act-stmt : SExp -> IRActStmt
  parse-act-stmt (e) =
   let xs = sexp-list e
   in let head = sexp-atom (list-at xs 0)
   in if head == "do-bind" then IrDoBind (sexp-str (list-at xs 1)) (parse-type (list-at xs 2)) (parse-expr (list-at xs 3)) synthetic-span
   else if head == "do-exec" then IrDoExec (parse-expr (list-at xs 1)) synthetic-span
   else IrDoExec (IrError "bad-stmt" ErrorTy synthetic-span) synthetic-span

  parse-expr-handle : List SExp -> IRExpr
  parse-expr-handle (xs) =
   let eff = sexp-str (list-at xs 1)
   in let body = parse-expr (list-at xs 2)
   in let clauses = parse-handle-clauses (sexp-list (list-at xs 3))
   in let ty = parse-type (list-at xs 4)
   in IrHandle eff body clauses ty synthetic-span

  parse-handle-clauses : List SExp -> List IRHandleClause
  parse-handle-clauses (xs) = parse-handle-clauses-loop xs 1 (list-length xs) []

  parse-handle-clauses-loop : List SExp, Integer, Integer, List IRHandleClause -> List IRHandleClause
  parse-handle-clauses-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else let inner = sexp-list (list-at xs i)
   in let op = sexp-str (list-at inner 1)
   in let params = parse-text-list (sexp-list (list-at inner 2))
   in let resume = sexp-str (list-at inner 3)
   in let body = parse-expr (list-at inner 4)
   in parse-handle-clauses-loop xs (i + 1) len (list-push acc (IRHandleClause { op-name = op, params = params, resume-name = resume, body = body, span = synthetic-span }))

  parse-expr-timeout : List SExp -> IRExpr
  parse-expr-timeout (xs) =
   let secs = sexp-int (list-at xs 1)
   in let effs = parse-text-list (sexp-list (list-at xs 2))
   in let scopes = parse-text-list (sexp-list (list-at xs 3))
   in let body = parse-expr (list-at xs 4)
   in let ty = parse-type (list-at xs 5)
   in IrWithTimeout secs effs scopes body ty synthetic-span

  parse-expr-record : List SExp -> IRExpr
  parse-expr-record (xs) =
   let name = sexp-str (list-at xs 1)
   in let fields = parse-field-vals (sexp-list (list-at xs 2))
   in let ty = parse-type (list-at xs 3)
   in IrRecord name fields ty synthetic-span

  parse-expr-try : List SExp -> IRExpr
  parse-expr-try (xs) =
   let max = sexp-int (list-at xs 1)
   in let body = parse-act-stmts (sexp-list (list-at xs 2))
   in let fb = parse-act-stmts (sexp-list (list-at xs 3))
   in let fail = parse-act-stmts (sexp-list (list-at xs 4))
   in let ty = parse-type (list-at xs 5)
   in IrTry max body fb fail ty synthetic-span

  parse-field-vals : List SExp -> List IRFieldVal
  parse-field-vals (xs) = parse-field-vals-loop xs 1 (list-length xs) []

  parse-field-vals-loop : List SExp, Integer, Integer, List IRFieldVal -> List IRFieldVal
  parse-field-vals-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else let inner = sexp-list (list-at xs i)
   in let name = sexp-str (list-at inner 1)
   in let val = parse-expr (list-at inner 2)
   in parse-field-vals-loop xs (i + 1) len (list-push acc (IRFieldVal { name = name, value = val, span = synthetic-span }))

Section: Params

  parse-params : List SExp -> List IRParam
  parse-params (xs) = parse-params-loop xs 1 (list-length xs) []

  parse-params-loop : List SExp, Integer, Integer, List IRParam -> List IRParam
  parse-params-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else let inner = sexp-list (list-at xs i)
   in let name = sexp-str (list-at inner 1)
   in let ty = parse-type (list-at inner 2)
   in parse-params-loop xs (i + 1) len (list-push acc (IRParam { name = name, type-val = ty, span = synthetic-span }))

Section: IRDef + Chapter

  parse-defs : List SExp -> List IRDef
  parse-defs (xs) = parse-defs-loop xs 1 (list-length xs) []

  parse-defs-loop : List SExp, Integer, Integer, List IRDef -> List IRDef
  parse-defs-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-defs-loop xs (i + 1) len (list-push acc (parse-def (list-at xs i)))

  parse-def : SExp -> IRDef
  parse-def (e) =
   let xs = sexp-list e
   in let name = sexp-str (list-at xs 1)
   in let slug = sexp-str (list-at xs 2)
   in let params = parse-params (sexp-list (list-at xs 3))
   in let ty = parse-type (list-at xs 4)
   in let body = parse-expr (list-at xs 5)
   in let punct = if list-length xs > 6 then sexp-int (list-at xs 6) > 0 else False
   in let budget = if list-length xs > 7 then sexp-int (list-at xs 7) else 0
   in let uniq = if list-length xs > 8 then parse-unique (sexp-list (list-at xs 8)) 1 [] else []
   in IRDef { name = name, params = params, type-val = ty, body = body, chapter-slug = slug, is-punctual = punct, wcet-budget = budget, unique-params = uniq, span = synthetic-span }

  parse-unique : List SExp, Integer, List Text -> List Text
  parse-unique (xs) (i) (acc) =
   if i >= list-length xs then acc
   else parse-unique xs (i + 1) (list-push acc (sexp-str (list-at xs i)))

  parse-ir-chapter : Text -> ParsedIR
  parse-ir-chapter (s) =
   let tokens = tokenize s
   in let tree = build-tree tokens
   in walk-chapter tree

  walk-chapter : SExp -> ParsedIR
  walk-chapter (e) =
   let xs = sexp-list e
   in let chap-name = make-name (sexp-str (list-at xs 1))
   in let title = walk-named-text xs "title"
   in let prose = walk-named-text xs "prose"
   in let sections = walk-named-strs xs "sections"
   in let ctors = walk-named-strs xs "ctors"
   in let eff-ops = walk-named-strs xs "eff-ops"
   in let ground-tbl = walk-named-strs xs "grounds"
   in let pblocks = parse-prose-blocks (walk-named-list xs "pblocks")
   in let anns = parse-annotations (walk-named-list xs "anns")
   in let type-defs = walk-named-list xs "type-defs"
   in let defs = walk-named-list xs "defs"
   in let parsed-tdefs = parse-atype-defs type-defs
   in let parsed-defs = parse-defs defs
   in let chapter = IRChapter {
       name = chap-name,
       defs = parsed-defs,
       effect-op-names = eff-ops,
       span = synthetic-span
      }
   in let meta = IRTextMeta {
       chapter-title = title,
       prose = prose,
       section-titles = sections,
       ctor-names = ctors,
       prose-blocks = pblocks,
       annotations = anns,
       ground-effects = ground-tbl
      }
   in ParsedIR { chapter = chapter, meta = meta, type-defs = parsed-tdefs, effect-op-names = eff-ops }

  walk-named-text : List SExp, Text -> Text
  walk-named-text (xs) (key) =
   let f = find-named-form xs key
   in if list-length f == 0 then "" else sexp-str (list-at f 1)

  walk-named-strs : List SExp, Text -> List Text
  walk-named-strs (xs) (key) =
   let f = find-named-form xs key
   in parse-text-list f

  walk-named-list : List SExp, Text -> List SExp
  walk-named-list (xs) (key) =
   find-named-form xs key

  find-named-form : List SExp, Text -> List SExp
  find-named-form (xs) (key) =
   find-named-form-loop xs key 0 (list-length xs)

  find-named-form-loop : List SExp, Text, Integer, Integer -> List SExp
  find-named-form-loop (xs) (key) (i) (len) =
   if i >= len then []
   else let inner = list-at xs i
   in when inner
    is SList (ys) -> if list-length ys == 0 then find-named-form-loop xs key (i + 1) len
                     else if sexp-atom (list-at ys 0) == key then ys
                     else find-named-form-loop xs key (i + 1) len
    is otherwise -> find-named-form-loop xs key (i + 1) len

Page 1


Chapter: Parsmi--IrmemHarness

Section: Sample

 The sample is lower.ir, decoded from its banked CCE bytes at
 generation time. The parser sees byte for byte what the plug sees on
 the wire, minus the transport.

  sample-ir : Text
