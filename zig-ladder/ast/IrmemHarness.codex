ecord-ty \"Token\" (args))))) (name \"tok\" (record-ty \"Token\" (args))) (llist (record-ty \"Token\" (args))))) (field-val \"collected-errors\" (field-access (name \"next\" (record-ty \"LexState\" (args))) \"errors/5\" (llist (record-ty \"Diagnostic\" (args)))))) (record-ty \"LexCollected\" (args))) (apply (apply (apply (name \"tokenize-collect\" (fn (record-ty \"LexState\" (args)) (fn (llist (record-ty \"Token\" (args))) (fn int-default (record-ty \"LexCollected\" (args)))))) (name \"next\" (record-ty \"LexState\" (args))) (fn (llist (record-ty \"Token\" (args))) (fn int-default (record-ty \"LexCollected\" (args))))) (apply (apply (name \"__linked-list-push\" (fn (llist (record-ty \"Token\" (args))) (fn (record-ty \"Token\" (args)) (llist (record-ty \"Token\" (args)))))) (name \"acc\" (llist (record-ty \"Token\" (args)))) (fn (record-ty \"Token\" (args)) (llist (record-ty \"Token\" (args))))) (name \"tok\" (record-ty \"Token\" (args))) (llist (record-ty \"Token\" (args)))) (fn int-default (record-ty \"LexCollected\" (args)))) (name \"ceiling\" int-default) (record-ty \"LexCollected\" (args))) (record-ty \"LexCollected\" (args))) (bool-lit true)) (branch (ctor-pat \"LexEnd\" (subs) (sum \"LexStep\" (args))) (record \"LexCollected\" (fields (field-val \"collected-tokens\" (apply (apply (name \"__linked-list-push\" (fn (llist (record-ty \"Token\" (args))) (fn (record-ty \"Token\" (args)) (llist (record-ty \"Token\" (args)))))) (name \"acc\" (llist (record-ty \"Token\" (args)))) (fn (record-ty \"Token\" (args)) (llist (record-ty \"Token\" (args))))) (apply (apply (apply (name \"make-token\" (fn (sum \"TokenKind\" (args)) (fn (int 0 4294967295 ov-error) (fn (record-ty \"LexState\" (args)) (record-ty \"Token\" (args)))))) (name \"EndOfFile\" (sum \"TokenKind\" (args))) (fn (int 0 4294967295 ov-error) (fn (record-ty \"LexState\" (args)) (record-ty \"Token\" (args))))) (int-lit 0) (fn (record-ty \"LexState\" (args)) (record-ty \"Token\" (args)))) (name \"st\" (record-ty \"LexState\" (args))) (record-ty \"Token\" (args))) (llist (record-ty \"Token\" (args))))) (field-val \"collected-errors\" (field-access (name \"st\" (record-ty \"LexState\" (args))) \"errors/5\" (llist (record-ty \"Diagnostic\" (args)))))) (record-ty \"LexCollected\" (args))) (bool-lit true))) (record-ty \"LexCollected\" (args))) (record-ty \"LexCollected\" (args))) 0 0)\n  (def \"tokenize\" \"Lexmi--Lexer\" (params (param \"src\" text) (param \"fid\" (int 0 65535 ov-error))) (fn text (fn (int 0 65535 ov-error) (record-ty \"TokenizeResult\" (args)))) (let \"raw\" (record-ty \"LexCollected\" (args)) (apply (apply (apply (name \"tokenize-collect\" (fn (record-ty \"LexState\" (args)) (fn (llist (record-ty \"Token\" (args))) (fn int-default (record-ty \"LexCollected\" (args)))))) (apply (apply (apply (name \"make-lex-state\" (fn text (fn (int 0 65535 ov-error) (fn (llist (record-ty \"Diagnostic\" (args))) (record-ty \"LexState\" (args)))))) (name \"src\" text) (fn (int 0 65535 ov-error) (fn (llist (record-ty \"Diagnostic\" (args))) (record-ty \"LexState\" (args))))) (name \"fid\" (int 0 65535 ov-error)) (fn (llist (record-ty \"Diagnostic\" (args))) (record-ty \"LexState\" (args)))) (apply (name \"__linked-list-empty\" (fn int-default (llist (record-ty \"Diagnostic\" (args))))) (int-lit 0) (llist (record-ty \"Diagnostic\" (args)))) (record-ty \"LexState\" (args))) (fn (llist (record-ty \"Token\" (args))) (fn int-default (record-ty \"LexCollected\" (args))))) (apply (name \"__linked-list-empty\" (fn int-default (llist (record-ty \"Token\" (args))))) (int-lit 0) (llist (record-ty \"Token\" (args)))) (fn int-default (record-ty \"LexCollected\" (args)))) (int-lit 0) (record-ty \"LexCollected\" (args))) (record \"TokenizeResult\" (fields (field-val \"tokens\" (apply (name \"__linked-list-to-list\" (fn (llist (record-ty \"Token\" (args))) (list (record-ty \"Token\" (args))))) (field-access (name \"raw\" (record-ty \"LexCollected\" (args))) \"collected-tokens/0\" (llist (record-ty \"Token\" (args)))) (list (record-ty \"Token\" (args))))) (field-val \"errors\" (apply (name \"__linked-list-to-list\" (fn (llist (record-ty \"Diagnostic\" (args))) (list (record-ty \"Diagnostic\" (args))))) (field-access (name \"raw\" (record-ty \"LexCollected\" (args))) \"collected-errors/1\" (llist (record-ty \"Diagnostic\" (args)))) (list (record-ty \"Diagnostic\" (args)))))) (record-ty \"TokenizeResult\" (args)))) 0 0)\n  (def \"subj-deck-record\" \"Lexmi--LexStubs\" (params (param \"x\" (tvar 2))) (fn (tvar 2) (tvar 2)) (name \"x\" (tvar 2)) 0 0)\n  (def \"subject-text\" \"Lexmi--LexHarness\" (params) text (text-lit \"Chapter: Lexer\\n\\nSection: Character Code Constants\\n  cc-newline : Integer = char-code '\\\\n'\\n  cc-cr : Integer = -1\\n  cc-space : Integer = char-code ' '\\n  cc-double-quote : Integer = char-code '\\\"'\\n  cc-single-quote : Integer = char-code '\\\\''\\n  cc-ampersand : Integer = char-code '&'\\n  cc-left-paren : Integer = char-code '('\\n  cc-right-paren : Integer = char-code ')'\\n  cc-star : Integer = char-code '*'\\n  cc-plus : Integer = char-code '+'\\n  cc-comma : Integer = char-code ','\\n  cc-minus : Integer = char-code '-'\\n  cc-dot : Integer = char-code '.'\\n  cc-slash : Integer = char-code '/'\\n  cc-zero : Integer = char-code '0'\\n  cc-nine : Integer = char-code '9'\\n  cc-colon : Integer = char-code ':'\\n  cc-less : Integer = char-code '<'\\n  cc-equals : Integer = char-code '='\\n  cc-greater : Integer = char-code '>'\\n  cc-first-upper : Integer = char-code 'E'\\n  cc-upper-z : Integer = char-code 'Z'\\n  cc-left-bracket : Integer = char-code '['\\n  cc-backslash : Integer = char-code '\\\\\\\\'\\n  cc-right-bracket : Integer = char-code ']'\\n  cc-caret : Integer = char-code '^'\\n  cc-underscore : Integer = char-code '_'\\n  cc-lower-a : Integer = char-code 'a'\\n  cc-lower-n : Integer = char-code 'n'\\n  cc-lower-r : Integer = char-code 'r'\\n  cc-lower-t : Integer = char-code 't'\\n  cc-lower-z : Integer = char-code 'z'\\n  cc-hash : Integer = char-code '#'\\n  cc-left-brace : Integer = char-code '{'\\n  cc-pipe : Integer = char-code '|'\\n  cc-right-brace : Integer = char-code '}'\\n  cc-tilde : Integer = char-code '~'\\n\\nSection: Character Classification (Integer)\\n  is-letter-code : Integer -> Boolean\\n  is-letter-code (c) = is-letter (code-to-char c)\\n\\n  is-digit-code : Integer -> Boolean\\n  is-digit-code (c) = is-digit (code-to-char c)\\n\\n  is-tier1-start : Integer -> Boolean\\n  is-tier1-start (b) = if bit-and b 224 == 192 then True else False\\n\\n  cce-decode-cp : Text, Integer -> Integer\\n  cce-decode-cp (s) (off) =\\n    let b0 = char-code-at s off\\n    in if bit-and b0 224 == 192 then\\n      let b1 = char-code-at s (off + 1)\\n      in 128 + bit-shl (bit-and b0 31) 6 + bit-and b1 63\\n    else if bit-and b0 240 == 224 then\\n      let b1 = char-code-at s (off + 1)\\n      in let b2 = char-code-at s (off + 2)\\n      in 2176 + bit-shl (bit-and b0 15) 12 + bit-shl (bit-and b1 63) 6 + bit-and b2 63\\n    else b0\\n\\n  cce-byte-len : Integer -> Integer\\n  cce-byte-len (b) =\\n    if bit-and b 128 == 0 then 1\\n    else if bit-and b 224 == 192 then 2\\n    else if bit-and b 240 == 224 then 3\\n    else 4\\n\\n  is-tier1-letter-cp : Integer -> Boolean\\n  is-tier1-letter-cp (cp) =\\n    let v = cp - 128\\n    in if v < 256 then True\\n    else if v < 896 then True\\n    else False\\n\\nSection: Lexer State\\n  mutable LexState = record {\\n   source : Text,\\n   offset : Integer between 0 and 4294967295,\\n   line : Integer between 0 and 131071,\\n   column : Integer between 0 and 4294967295,\\n   file-id : Integer between 0 and 65535,\\n   errors : LinkedList Diagnostic,\\n   prose-mode : Boolean\\n  }\\n\\n  make-lex-state : Text, Integer between 0 and 65535, LinkedList Diagnostic -> LexState\\n  make-lex-state (src) (fid) (pre-errors) =\\n   LexState {\\n    source = src,\\n    offset = 0,\\n    line = 1,\\n    column = 1,\\n    file-id = fid,\\n    errors = pre-errors,\\n    prose-mode = False\\n   }\\n\\n  make-lex-state-prose : Text, Integer between 0 and 65535, LinkedList Diagnostic, Boolean -> LexState\\n  make-lex-state-prose (src) (fid) (pre-errors) (prose) =\\n   LexState {\\n    source = src,\\n    offset = 0,\\n    line = 1,\\n    column = 1,\\n    file-id = fid,\\n    errors = pre-errors,\\n    prose-mode = prose\\n   }\\n\\n  add-lex-error : LexState, Integer between 0 and 65535, Text, SourceSpan -> LexState\\n  add-lex-error (st) (code) (msg) (span) =\\n   let __seq = st.errors = __linked-list-push (st.errors) (make-error code msg span)\\n   in st\\n\\n  is-at-end : LexState -> Boolean\\n  is-at-end (st) =\\n   st.offset >= text-length (st.source)\\n\\n  peek-code : LexState -> Integer\\n  peek-code (st) =\\n   if is-at-end st then 0\\n   else char-code-at (st.source) (st.offset)\\n\\n  advance-char : LexState -> LexState\\n  advance-char (st) =\\n   if peek-code st == cc-newline then LexState {\\n     source = st.source,\\n     offset = st.offset + 1,\\n     line = st.line + 1,\\n     column = 1,\\n     file-id = st.file-id,\\n     errors = st.errors,\\n     prose-mode = st.prose-mode\\n    }\\n    else LexState {\\n     source = st.source,\\n     offset = st.offset + 1,\\n     line = st.line,\\n     column = st.column + 1,\\n     file-id = st.file-id,\\n     errors = st.errors,\\n     prose-mode = st.prose-mode\\n    }\\n\\n  advance-bytes : LexState, Integer -> LexState\\n  advance-bytes (st) (n) =\\n   LexState {\\n     source = st.source,\\n     offset = st.offset + n,\\n     line = st.line,\\n     column = st.column + 1,\\n     file-id = st.file-id,\\n     errors = st.errors,\\n     prose-mode = st.prose-mode\\n   }\\n\\nSection: Whitespace\\n  skip-spaces-end : Text, Integer, Integer -> Integer\\n  skip-spaces-end (source) (offset) (len) =\\n   if offset >= len then offset\\n   else if char-code-at source offset == cc-space then skip-spaces-end source (offset + 1) len\\n   else offset\\n\\n  skip-spaces : LexState -> LexState\\n  skip-spaces (st) =\\n   let len = text-length (st.source)\\n   in let stop = skip-spaces-end (st.source) (st.offset) len\\n   in if stop == st.offset then st\\n      else let new-col = st.column + (stop - st.offset)\\n      in let __seq = st.offset = stop\\n      in let __seq = st.column = new-col\\n      in st\\n\\nSection: Character Scanning\\n\\n The minus binds to whatever it abuts, and that is what decides whether a\\n hyphen belongs to a name or is the subtraction operator. A hyphen touching\\n the character before it continues the name, whatever follows: `a-2` and\\n `a-b` are one name, and so is `a-`. A hyphen with a space before it is not\\n reached here at all, because the scan has already stopped at the space, so\\n `a - 2` is subtraction and `a -2` leaves the minus for the parser to read\\n as a negation.\\n\\n  scan-ident-end : Text, Integer, Integer -> Integer\\n  scan-ident-end (source) (offset) (len) =\\n   if offset >= len then offset\\n   else let c = char-code-at source offset\\n   in if is-letter-code c then scan-ident-end source (offset + 1) len\\n      else if is-digit-code c then scan-ident-end source (offset + 1) len\\n      else if c == cc-underscore then scan-ident-end source (offset + 1) len\\n      else if is-tier1-start c then\\n        let cp = cce-decode-cp source offset\\n        in if is-tier1-letter-cp cp then scan-ident-end source (offset + cce-byte-len c) len\\n        else offset\\n      else if c == cc-minus then\\n        if offset + 1 >= len then scan-ident-end source (offset + 1) len\\n        else if char-code-at source (offset + 1) == cc-greater then offset\\n        else scan-ident-end source (offset + 1) len\\n      else offset\\n\\n  scan-ident-rest : LexState -> LexState\\n  scan-ident-rest (st) =\\n   let len = text-length (st.source)\\n   in let stop = scan-ident-end (st.source) (st.offset) len\\n   in if stop == st.offset then st\\n      else let new-col = st.column + (stop - st.offset)\\n      in let __seq = st.offset = stop\\n      in let __seq = st.column = new-col\\n      in st\\n\\n  scan-digits-end : Text, Integer, Integer -> Integer\\n  scan-digits-end (source) (offset) (len) =\\n   if offset >= len then offset\\n   else let c = char-code-at source offset\\n   in if is-digit-code c then scan-digits-end source (offset + 1) len\\n      else if c == cc-underscore then scan-digits-end source (offset + 1) len\\n      else offset\\n\\n  scan-digits : LexState -> LexState\\n  scan-digits (st) =\\n   let len = text-length (st.source)\\n   in let stop = scan-digits-end (st.source) (st.offset) len\\n   in if stop == st.offset then st\\n      else let new-col = st.column + (stop - st.offset)\\n      in let __seq = st.offset = stop\\n      in let __seq = st.column = new-col\\n      in st\\n\\n  scan-hex-end : Text, Integer, Integer -> Integer\\n  scan-hex-end (source) (offset) (len) =\\n   if offset >= len then offset\\n   else let c = char-code-at source offset\\n   in if hex-digit-value c >= 0 then scan-hex-end source (offset + 1) len\\n      else if c == cc-underscore then scan-hex-end source (offset + 1) len\\n      else offset\\n\\n  scan-hex-digits : LexState -> LexState\\n  scan-hex-digits (st) =\\n   let len = text-length (st.source)\\n   in let stop = scan-hex-end (st.source) (st.offset) len\\n   in if stop == st.offset then st\\n      else let new-col = st.column + (stop - st.offset)\\n      in let __seq = st.offset = stop\\n      in let __seq = st.column = new-col\\n      in st\\n\\n  scan-string-end : Text, Integer, Integer -> Integer\\n  scan-string-end (source) (offset) (len) =\\n   if offset >= len then offset\\n   else let c = char-code-at source offset\\n   in if c == cc-double-quote then offset + 1\\n      else if c == cc-newline then offset\\n      else if c == cc-backslash then scan-string-end source (offset + 2) len\\n      else scan-string-end source (offset + 1) len\\n\\n  scan-string-body : LexState -> LexState\\n  scan-string-body (st) =\\n   let len = text-length (st.source)\\n   in let stop = scan-string-end (st.source) (st.offset) len\\n   in if stop == st.offset then st\\n      else let new-col = st.column + (stop - st.offset)\\n      in let __seq = st.offset = stop\\n      in let __seq = st.column = new-col\\n      in let terminated = stop <= len & stop > 0 & char-code-at (st.source) (stop - 1) == cc-double-quote\\n      in if terminated then st\\n         else let open-span = span-at (st.line) (st.column - 1) (st.offset - 1) 1 (st.file-id)\\n         in let err = make-error cdx-unterminated-text \\\"Unterminated text literal: hit end of line before closing '\\\\\\\"'\\\" open-span\\n         in let __seq = st.errors = __linked-list-push (st.errors) err\\n         in st\\n\\n  validate-escapes-into : Text, Integer between 0 and 131071, Integer between 0 and 4294967295, Integer between 0 and 4294967295, Integer between 0 and 65535, LinkedList Diagnostic -> LinkedList Diagnostic\\n  validate-escapes-into (s) (base-line) (base-col) (base-off) (fid) (errs) =\\n   validate-escapes-loop s 0 (text-length s) base-line base-col base-off fid errs\\n\\n  validate-escapes-loop : Text, Integer, Integer, Integer between 0 and 131071, Integer between 0 and 4294967295, Integer between 0 and 4294967295, Integer between 0 and 65535, LinkedList Diagnostic -> LinkedList Diagnostic\\n  validate-escapes-loop (s) (i) (len) (line) (col) (off) (fid) (errs) =\\n   if i >= len then errs\\n   else let c = char-code-at s i\\n   in if c == cc-backslash then if i + 1 < len then let nc = char-code-at s (i + 1)\\n   in let esc-span = span-at line (col + i) (off + i) 2 fid\\n   in if nc == cc-lower-t then validate-escapes-loop s (i + 2) len line col off fid (__linked-list-push errs (make-error cdx-invalid-tab-escape \\\"\\\\\\\\t escape is not valid in CCE; use spaces directly\\\" esc-span))\\n          else if nc == cc-lower-r then validate-escapes-loop s (i + 2) len line col off fid (__linked-list-push errs (make-error cdx-invalid-carriage-return-escape \\\"\\\\\\\\r escape is not valid in CCE; use \\\\\\\\n for newlines\\\" esc-span))\\n          else validate-escapes-loop s (i + 2) len line col off fid errs\\n       else errs\\n      else validate-escapes-loop s (i + 1) len line col off fid errs\\n\\n  decode-escapes : Text -> Text\\n  decode-escapes (s) =\\n   text-concat-list (decode-escapes-loop s 0 (text-length s) [])\\n\\n  decode-escapes-loop : Text, Integer, Integer, List Text -> List Text\\n  decode-escapes-loop (s) (i) (len) (acc) =\\n   if i >= len then acc\\n   else let c = char-code-at s i\\n   in if c == cc-backslash then if i + 1 < len then let nc = char-code-at s (i + 1)\\n   in if nc == cc-lower-n then decode-escapes-loop s (i + 2) len (list-push acc (char-to-text '\\\\n'))\\n          else if nc == cc-lower-t then decode-escapes-loop s (i + 2) len (list-push acc \\\"  \\\")\\n          else if nc == cc-lower-r then decode-escapes-loop s (i + 2) len acc\\n          else if nc == cc-backslash then decode-escapes-loop s (i + 2) len (list-push acc \\\"\\\\\\\\\\\")\\n          else if nc == cc-double-quote then decode-escapes-loop s (i + 2) len (list-push acc \\\"\\\\\\\"\\\")\\n          else decode-escapes-loop s (i + 2) len (list-push acc (char-to-text (char-at s (i + 1))))\\n       else list-push acc (char-to-text (char-at s i))\\n      else decode-escapes-loop s (i + 1) len (list-push acc (char-to-text (char-at s i)))\\n\\nSection: Keyword Classification\\n  classify-word : Text -> TokenKind\\n  classify-word (w) =\\n   subj-deck-record (\\n    if w == \\\"let\\\" then LetKeyword\\n    else if w == \\\"in\\\" then InKeyword\\n    else if w == \\\"between\\\" then BetweenKeyword\\n    else if w == \\\"if\\\" then IfKeyword\\n    else if w == \\\"is\\\" then IsKeyword\\n    else if w == \\\"otherwise\\\" then OtherwiseKeyword\\n    else if w == \\\"then\\\" then ThenKeyword\\n    else if w == \\\"else\\\" then ElseKeyword\\n    else if w == \\\"when\\\" then WhenKeyword\\n    else if w == \\\"where\\\" then WhereKeyword\\n    else if w == \\\"act\\\" then ActKeyword\\n    else if w == \\\"end\\\" then EndKeyword\\n    else if w == \\\"record\\\" then RecordKeyword\\n    else if w == \\\"cites\\\" then CitesKeyword\\n    else if w == \\\"grounds\\\" then GroundsKeyword\\n    else if w == \\\"quotes\\\" then QuotesKeyword\\n    else if w == \\\"trusting\\\" then TrustingKeyword\\n    else if w == \\\"above\\\" then AboveKeyword\\n    else if w == \\\"claim\\\" then ClaimKeyword\\n    else if w == \\\"proof\\\" then ProofKeyword\\n    else if w == \\\"qed\\\" then QedKeyword\\n    else if w == \\\"induction\\\" then InductionKeyword\\n    else if w == \\\"forall\\\" then ForAllKeyword\\n    else if w == \\\"exists\\\" then ThereExistsKeyword\\n    else if w == \\\"linear\\\" then LinearKeyword\\n    else if w == \\\"mutable\\\" then MutableKeyword\\n    else if w == \\\"punctual\\\" then PunctualKeyword\\n    else if w == \\\"unit\\\" then UnitKeyword\\n    else if w == \\\"effect\\\" then EffectKeyword\\n    else if w == \\\"class\\\" then ClassKeyword\\n    else if w == \\\"instance\\\" then InstanceKeyword\\n    else if w == \\\"with\\\" then WithKeyword\\n    else if w == \\\"with-timeout\\\" then WithTimeoutKeyword\\n    else if w == \\\"trying\\\" then TryingKeyword\\n    else if w == \\\"lazy\\\" then LazyKeyword\\n    else if w == \\\"revised\\\" then RevisedKeyword\\n    else if w == \\\"True\\\" then TrueKeyword\\n    else if w == \\\"False\\\" then FalseKeyword\\n    else let first-code = char-code-at w 0\\n    in if first-code >= cc-first-upper then if first-code <= cc-upper-z then TypeIdentifier\\n       else Identifier\\n       else Identifier\\n   )\\n\\nSection: Single Token Scanning\\n  LexStep =\\n   | LexToken (Token) (LexState)\\n   | LexEnd\\n\\n  make-token : TokenKind, Integer between 0 and 4294967295, LexState -> Token\\n  make-token (kind) (length) (st) =\\n   subj-deck-record (Token {\\n    kind = kind,\\n    source = st.source,\\n    offset = st.offset,\\n    length = length,\\n    line = st.line,\\n    column = st.column,\\n    file-id = st.file-id\\n   })\\n\\n  extract-text : LexState, Integer, LexState -> Text\\n  extract-text (st) (start) (end-st) =\\n   substring (st.source) start (end-st.offset - start)\\n\\n  scan-to-eol-end : Text, Integer between 0 and 4294967295, Integer -> Integer between 0 and 4294967295\\n  scan-to-eol-end (source) (offset) (len) =\\n   if offset >= len then offset\\n   else let c = char-code-at source offset\\n   in if c == cc-newline then offset\\n      else scan-to-eol-end source (offset + 1) len\\n\\n  scan-prose-text : LexState -> LexStep\\n  scan-prose-text (s) =\\n   let len = text-length (s.source)\\n   in let stop = scan-to-eol-end (s.source) (s.offset) len\\n   in let tok-len = stop - s.offset\\n   in if tok-len == 0 then LexToken (make-token (subj-deck-record ProseText) 0 s) s\\n      else let tok = make-token (subj-deck-record ProseText) tok-len s\\n   in let new-col = s.column + tok-len\\n   in let __seq = s.offset = stop\\n   in let __seq = s.column = new-col\\n   in LexToken tok s\\n\\n  skip-prose-line : LexState -> LexStep\\n  skip-prose-line (s) =\\n   let len = text-length (s.source)\\n   in let stop = scan-to-eol-end (s.source) (s.offset) len\\n   in let new-col = s.column + (stop - s.offset)\\n   in let __seq = s.offset = stop\\n   in let __seq = s.column = new-col\\n   in scan-token s\\n\\n  scan-token : LexState -> LexStep\\n  scan-token (st) =\\n   let s = skip-spaces st\\n   in if is-at-end s then LexEnd\\n   else let c = peek-code s\\n   in if c == cc-cr then scan-token (advance-char s)\\n         else if s.column == 2 & c /= cc-newline then\\n          if s.prose-mode then scan-prose-text s\\n          else skip-prose-line s\\n         else if c == cc-newline then LexToken (make-token (subj-deck-record Newline) 1 s) (advance-char s)\\n         else if c == cc-double-quote then let start = s.offset + 1\\n   in let after = scan-string-body (advance-char s)\\n   in let body-len = after.offset - start - 1\\n   in let safe-len = if body-len < 0 then 0 else body-len\\n   in let raw = substring (s.source) start safe-len\\n   in let merged-errs = validate-escapes-into raw (s.line) (s.column + 1) start (s.file-id) (after.errors)\\n   in let __seq = after.errors = merged-errs\\n   in LexToken (make-token (subj-deck-record TextLiteral) (after.offset - s.offset) s) after\\n         else if c == cc-single-quote then scan-char-literal s\\n         else if is-letter-code c then let start = s.offset\\n   in let after = scan-ident-rest (advance-char s)\\n   in let word = extract-text s start after\\n   in LexToken (make-token (classify-word word) (after.offset - start) s) after\\n         else if is-tier1-start c then\\n           let cp = cce-decode-cp (s.source) (s.offset)\\n           in if is-tier1-letter-cp cp then let start = s.offset\\n   in let blen = cce-byte-len c\\n   in let after = scan-ident-rest (advance-bytes s blen)\\n   in let word = extract-text s start after\\n   in LexToken (make-token (subj-deck-record Identifier) (after.offset - start) s) after\\n           else LexToken (make-token (subj-deck-record ErrorToken) 1 s) (advance-char s)\\n         else if c == cc-underscore then let start = s.offset\\n   in let after = scan-ident-rest (advance-char s)\\n   in let word-len = after.offset - start\\n   in if word-len == 1 then LexToken (make-token (subj-deck-record Underscore) 1 s) after\\n                 else LexToken (make-token (classify-word (extract-text s start after)) word-len s) after\\n         else if is-digit-code c then let start = s.offset\\n   in let after = scan-digits (advance-char s)\\n   in if is-at-end after then LexToken (make-token (subj-deck-record IntegerLiteral) (after.offset - start) s) after\\n                 else if peek-code after == cc-dot then\\n                  let after-dot = advance-char after\\n                  in if is-at-end after-dot then LexToken (make-token (subj-deck-record IntegerLiteral) (after.offset - start) s) after\\n                     else if peek-code after-dot == cc-dot then LexToken (make-token (subj-deck-record IntegerLiteral) (after.offset - start) s) after\\n                     else let after2 = scan-digits after-dot\\n                          in LexToken (make-token (subj-deck-record NumberLiteral) (after2.offset - start) s) after2\\n                else LexToken (make-token (subj-deck-record IntegerLiteral) (after.offset - start) s) after\\n         else if c == cc-hash then let start = s.offset\\n   in let after = scan-hex-digits (advance-char s)\\n   in if after.offset - start == 1 then LexToken (make-token (subj-deck-record ErrorToken) 1 s) after\\n      else LexToken (make-token (subj-deck-record IntegerLiteral) (after.offset - start) s) after\\n         else scan-operator s\\n\\n  scan-operator : LexState -> LexStep\\n  scan-operator (s) =\\n   let c = peek-code s\\n   in let next = advance-char s\\n   in if c == cc-left-paren then LexToken (make-token (subj-deck-record LeftParen) 1 s) next\\n      else if c == cc-right-paren then LexToken (make-token (subj-deck-record RightParen) 1 s) next\\n      else if c == cc-left-bracket then LexToken (make-token (subj-deck-record LeftBracket) 1 s) next\\n      else if c == cc-right-bracket then LexToken (make-token (subj-deck-record RightBracket) 1 s) next\\n      else if c == cc-left-brace then LexToken (make-token (subj-deck-record LeftBrace) 1 s) next\\n      else if c == cc-right-brace then LexToken (make-token (subj-deck-record RightBrace) 1 s) next\\n      else if c == cc-comma then LexToken (make-token (subj-deck-record Comma) 1 s) next\\n      else if c == cc-dot then LexToken (make-token (subj-deck-record Dot) 1 s) next\\n      else if c == cc-caret then LexToken (make-token (subj-deck-record Caret) 1 s) next\\n      else if c == cc-ampersand then LexToken (make-token (subj-deck-record Ampersand) 1 s) next\\n      else if c == cc-backslash then LexToken (make-token (subj-deck-record Backslash) 1 s) next\\n      else if c == cc-tilde then\\n       let nc2 = if is-at-end next then 0 else peek-code next\\n       in if nc2 == cc-zero then LexToken (make-token (subj-deck-record TildeZero) 2 s) (advance-char next)\\n       else LexToken (make-token (subj-deck-record Tilde) 1 s) next\\n      else scan-multi-char-operator s\\n\\n  scan-multi-char-operator : LexState -> LexStep\\n  scan-multi-char-operator (s) =\\n   let c = peek-code s\\n   in let next = advance-char s\\n   in let nc = if is-at-end next then 0 else peek-code next\\n   in if c == cc-plus then LexToken (make-token (subj-deck-record Plus) 1 s) next\\n        else if c == cc-minus then if nc == cc-greater then LexToken (make-token (subj-deck-record Arrow) 2 s) (advance-char next)\\n        else LexToken (make-token (subj-deck-record Minus) 1 s) next\\n        else if c == cc-star then LexToken (make-token (subj-deck-record Star) 1 s) next\\n        else if c == cc-slash then if nc == cc-equals then LexToken (make-token (subj-deck-record NotEquals) 2 s) (advance-char next)\\n        else LexToken (make-token (subj-deck-record Slash) 1 s) next\\n        else if c == cc-equals then if nc == cc-equals then let next2 = advance-char next\\n   in let nc2 = if is-at-end next2 then 0 else peek-code next2\\n   in if nc2 == cc-equals then LexToken (make-token (subj-deck-record TripleEquals) 3 s) (advance-char next2)\\n                else LexToken (make-token (subj-deck-record DoubleEquals) 2 s) next2\\n           else if nc == cc-greater then LexToken (make-token (subj-deck-record FatArrow) 2 s) (advance-char next)\\n           else LexToken (make-token (subj-deck-record Equals) 1 s) next\\n        else if c == cc-colon then if nc == cc-colon then LexToken (make-token (subj-deck-record ColonColon) 2 s) (advance-char next)\\n        else LexToken (make-token (subj-deck-record Colon) 1 s) next\\n        else if c == cc-pipe then if nc == cc-greater then LexToken (make-token (subj-deck-record PipeForward) 2 s) (advance-char next)\\n        else LexToken (make-token (subj-deck-record Pipe) 1 s) next\\n        else if c == cc-less then if nc == cc-equals then LexToken (make-token (subj-deck-record LessOrEqual) 2 s) (advance-char next)\\n        else if nc == cc-minus then LexToken (make-token (subj-deck-record LeftArrow) 2 s) (advance-char next)\\n        else LexToken (make-token (subj-deck-record LessThan) 1 s) next\\n        else if c == cc-greater then if nc == cc-equals then LexToken (make-token (subj-deck-record GreaterOrEqual) 2 s) (advance-char next)\\n        else LexToken (make-token (subj-deck-record GreaterThan) 1 s) next\\n        else LexToken (make-token (subj-deck-record ErrorToken) 1 s) next\\n\\nSection: Char Literal\\n  scan-char-literal : LexState -> LexStep\\n  scan-char-literal (s) =\\n   let s1 = advance-char s\\n   in if is-at-end s1 then LexToken (make-token (subj-deck-record ErrorToken) (s1.offset - s.offset) s) s1\\n      else if peek-code s1 == cc-backslash then let s2 = advance-char s1\\n   in if is-at-end s2 then LexToken (make-token (subj-deck-record ErrorToken) (s2.offset - s.offset) s) s2\\n   else let esc-code = peek-code s2\\n   in let s3 = advance-char s2\\n   in let s4 = if is-at-end s3 then s3 else if peek-code s3 == cc-single-quote then advance-char s3 else s3\\n   in let esc-span = span-at (s1.line) (s1.column) (s1.offset) 2 (s1.file-id)\\n   in let s5 = if esc-code == cc-lower-t then add-lex-error s4 cdx-invalid-tab-escape \\\"\\\\\\\\t escape is not valid in CCE; use a space character instead\\\" esc-span\\n               else if esc-code == cc-lower-r then add-lex-error s4 cdx-invalid-carriage-return-escape \\\"\\\\\\\\r escape is not valid in CCE; use '\\\\\\\\n' for newlines\\\" esc-span\\n               else s4\\n   in LexToken (make-token (subj-deck-record CharLiteral) (s5.offset - s.offset) s) s5\\n   else let s2 = advance-char s1\\n   in let s3 = if is-at-end s2 then s2 else if peek-code s2 == cc-single-quote then advance-char s2 else s2\\n   in LexToken (make-token (subj-deck-record CharLiteral) (s3.offset - s.offset) s) s3\\n\\nSection: Tokenize All\\n  TokenizeResult = record {\\n   tokens : List Token,\\n   errors : List Diagnostic\\n  }\\n\\n  LexCollected = record {\\n   collected-tokens : LinkedList Token,\\n   collected-errors : LinkedList Diagnostic\\n  }\\n\\n **The overflow path discards the tokens, and it has to.** This loop\\n used to hand back the accumulator it had built so far, on the reading\\n that the guard band left room for the wind-down. It does not:\\n `__linked-list-to-list` runs inside `subj-deck-record`, so it writes eight\\n bytes per collected token onto the same deck that just overflowed, and\\n the guard band is a flat megabyte. The band is therefore sized right\\n only while few tokens were collected -- `-Decks 5` fires early and\\n fits, and `-Decks 20` fires late and converted a token list far larger\\n than the band, straight through the ceiling and into the bivy holding\\n the linked list it was reading. That is the exact fault the guard was\\n written to prevent, moved one call later. Measured 2026-07-21: with\\n the phase trace on, `-Decks 20` crashed in `__linked_list_to_list`\\n having completed no phase at all.\\n Nothing downstream wants these tokens -- `compile-lex` returns\\n `tokens = []` the moment the bag has errors -- so the honest wind-down\\n allocates nothing and the band only has to cover the error record.\\n\\n  tokenize-collect : LexState, LinkedList Token, Integer -> LexCollected\\n  tokenize-collect (st) (acc) (ceiling) =\\n   if ceiling > 0 & __deck-pos + demand-lex-guard-band >= ceiling\\n    then LexCollected {\\n     collected-tokens = [],\\n     collected-errors = __linked-list-push (st.errors) (make-error cdx-deck-overflow \\\"Deck overflow in LEX; deck floor exceeded. The lexer's deck reservation ran out mid-stream. Raise demand-lex-floor, or compile this source with a larger -Decks percentage.\\\" synthetic-span)\\n    }\\n   else when scan-token st\\n    is LexToken (tok) (next) ->\\n     if tok.kind == EndOfFile then LexCollected { collected-tokens = __linked-list-push acc tok, collected-errors = next.errors }\\n      else tokenize-collect next (__linked-list-push acc tok) ceiling\\n    is LexEnd ->\\n     LexCollected { collected-tokens = __linked-list-push acc (make-token (subj-deck-record EndOfFile) 0 st), collected-errors = st.errors }\\n\\n  tokenize : Text, Integer between 0 and 65535 -> TokenizeResult\\n  tokenize (src) (fid) =\\n   let raw = tokenize-collect (make-lex-state src fid []) [] 0\\n   in TokenizeResult { tokens = __linked-list-to-list (raw.collected-tokens), errors = __linked-list-to-list (raw.collected-errors) }\\n\\n  tokenize-into : Text, Integer between 0 and 65535, Boolean, Integer -> TokenizeResult\\n  tokenize-into (src) (fid) (prose) (ceiling) =\\n   let raw = tokenize-collect (make-lex-state-prose src fid [] prose) [] ceiling\\n   in subj-deck-record (TokenizeResult { tokens = __linked-list-to-list (raw.collected-tokens), errors = __linked-list-to-list (raw.collected-errors) })\\n\\nPage 1\\n\\n\") 0 0)\n  (def \"show-kind\" \"Lexmi--LexHarness\" (params (param \"k\" (sum \"TokenKind\" (args)))) (fn (sum \"TokenKind\" (args)) text) (match (name \"k\" (sum \"TokenKind\" (args))) (branches (branch (ctor-pat \"EndOfFile\" (subs) (sum \"TokenKind\" (args))) (text-lit \"EndOfFile\") (bool-lit true)) (branch (ctor-pat \"Newline\" (subs) (sum \"TokenKind\" (args))) (text-lit \"Newline\") (bool-lit true)) (branch (ctor-pat \"Indent\" (subs) (sum \"TokenKind\" (args))) (text-lit \"Indent\") (bool-lit true)) (branch (ctor-pat \"Dedent\" (subs) (sum \"TokenKind\" (args))) (text-lit \"Dedent\") (bool-lit true)) (branch (ctor-pat \"IntegerLiteral\" (subs) (sum \"TokenKind\" (args))) (text-lit \"IntegerLiteral\") (bool-lit true)) (branch (ctor-pat \"NumberLiteral\" (subs) 