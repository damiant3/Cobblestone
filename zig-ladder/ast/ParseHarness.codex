Chapter: ParseHarness

Section: Subject
  subject-text : Text
  subject-text = "Chapter: Parser\n\n  cites Foreword chapter Maybe\n  cites Foreword chapter Tuple\n\nSection: Type Parsing\n  is-forall-start : ParseState -> Boolean\n  is-forall-start (st) =\n   when (current-kind st)\n    is ForAllKeyword -> True\n    is Identifier ->\n     if token-text (current st) == \"for\" then\n      let idx = (st.pos) + 1\n      in if idx >= list-length (st.tokens) then False\n      else token-text (list-at (st.tokens) idx) == \"all\"\n     else False\n    is otherwise -> False\n\n  parse-forall-type : ParseState -> ParseTypeResult\n  parse-forall-type (st) =\n   let qtok = current st\n   in let st1 = when (current-kind st) is ForAllKeyword -> advance st is otherwise -> advance (advance st)\n   in let st2 = expect LeftParen st1\n   in let var-tok = current st2\n   in let st3 = if is-ident (current-kind st2) then advance st2 else st2\n   in let st4 = expect Colon st3\n   in when (parse-type st4)\n    is TypeOk (vty) (st5) ->\n     let st6 = expect RightParen st5\n     in let st7 = expect Comma st6\n     in when (parse-type st7)\n      is TypeOk (pty) (st8) ->\n       TypeOk (deck-record (ForAllType var-tok vty pty)) st8\n\n  parse-type : ParseState -> ParseTypeResult\n  parse-type (st) =\n   if parse-fuel-exhausted st then TypeOk (deck-record (NamedType (current st))) (emit-parse-fuel-error st \"parse-type\")\n   else let st0 = consume-parse-fuel st\n   in if is-forall-start st0 then parse-forall-type st0\n   else when (current-kind st0)\n    is LinearKeyword ->\n     let atom-r = parse-type-atom (advance st0)\n     in unwrap-type-ok atom-r parse-linear-after\n    is MutableKeyword ->\n     let atom-r = parse-type-atom (advance st0)\n     in unwrap-type-ok atom-r parse-type-with-args\n    is otherwise ->\n     let atom-r = parse-type-atom st0\n     in unwrap-type-ok atom-r parse-type-with-args\n\n  parse-linear-after : TypeExpr, ParseState -> ParseTypeResult\n  parse-linear-after (atom) (st) =\n   let applied-r = parse-type-args atom st\n   in unwrap-type-ok applied-r wrap-linear-continue\n\n  wrap-linear-continue : TypeExpr, ParseState -> ParseTypeResult\n  wrap-linear-continue (applied) (st) =\n   parse-type-bound-or-continue (deck-record (LinearTypeExpr applied)) st\n\n  parse-type-with-args : TypeExpr, ParseState -> ParseTypeResult\n  parse-type-with-args (atom) (st) =\n   let applied-r = parse-type-args atom st\n   in unwrap-type-ok applied-r parse-type-bound-or-continue\n\n  parse-type-bound-or-continue : TypeExpr, ParseState -> ParseTypeResult\n  parse-type-bound-or-continue (left) (st) =\n   if is-between-keyword (current-kind st) then parse-bound-between left (advance st)\n   else unwrap-type-ok (parse-type-mul-tail left st) parse-type-add-tail\n\n  is-type-mul-op : TokenKind -> Boolean\n  is-type-mul-op (k) =\n   when k\n    is Star | Slash -> True\n    is otherwise -> False\n\n  is-type-add-op : TokenKind -> Boolean\n  is-type-add-op (k) =\n   when k\n    is Plus | Minus -> True\n    is otherwise -> False\n\n  parse-type-arith-operand : ParseState -> ParseTypeResult\n  parse-type-arith-operand (st) =\n   let atom-r = parse-type-atom st\n   in unwrap-type-ok atom-r parse-type-args\n\n  parse-type-mul-tail : TypeExpr, ParseState -> ParseTypeResult\n  parse-type-mul-tail (left) (st) =\n   if parse-fuel-exhausted st then TypeOk left (emit-parse-fuel-error st \"parse-type-mul-tail\")\n   else let st-fueled = consume-parse-fuel st\n   in if is-type-mul-op (current-kind st-fueled)\n    then let op-tok = current st-fueled\n     in unwrap-type-ok (parse-type-arith-operand (advance st-fueled)) (make-type-arith-mul left op-tok)\n    else TypeOk left st-fueled\n\n  make-type-arith-mul : TypeExpr, Token, TypeExpr, ParseState -> ParseTypeResult\n  make-type-arith-mul (left) (op-tok) (right) (st) =\n   parse-type-mul-tail (deck-record (AppType (deck-record (NamedType op-tok)) [left, right])) st\n\n  parse-type-add-tail : TypeExpr, ParseState -> ParseTypeResult\n  parse-type-add-tail (left) (st) =\n   unwrap-type-ok (parse-type-add-loop left st) parse-type-append-tail\n\n  parse-type-add-loop : TypeExpr, ParseState -> ParseTypeResult\n  parse-type-add-loop (left) (st) =\n   if parse-fuel-exhausted st then TypeOk left (emit-parse-fuel-error st \"parse-type-add-tail\")\n   else let st-fueled = consume-parse-fuel st\n   in if is-type-add-op (current-kind st-fueled)\n    then let op-tok = current st-fueled\n     in unwrap-type-ok (parse-type-add-operand (advance st-fueled)) (make-type-arith-add left op-tok)\n    else TypeOk left st-fueled\n\n  parse-type-add-operand : ParseState -> ParseTypeResult\n  parse-type-add-operand (st) =\n   unwrap-type-ok (parse-type-arith-operand st) parse-type-mul-tail\n\n  make-type-arith-add : TypeExpr, Token, TypeExpr, ParseState -> ParseTypeResult\n  make-type-arith-add (left) (op-tok) (right) (st) =\n   parse-type-add-loop (deck-record (AppType (deck-record (NamedType op-tok)) [left, right])) st\n\n  parse-type-append-tail : TypeExpr, ParseState -> ParseTypeResult\n  parse-type-append-tail (left) (st) =\n   if parse-fuel-exhausted st then TypeOk left (emit-parse-fuel-error st \"parse-type-append-tail\")\n   else let st-fueled = consume-parse-fuel st\n   in if current-kind st-fueled == Ampersand\n    then let op-tok = current st-fueled\n     in unwrap-type-ok (parse-type-append-operand (advance st-fueled)) (make-type-append left op-tok)\n    else parse-type-continue left st-fueled\n\n  parse-type-append-operand : ParseState -> ParseTypeResult\n  parse-type-append-operand (st) =\n   unwrap-type-ok (unwrap-type-ok (parse-type-arith-operand st) parse-type-mul-tail) parse-type-add-loop\n\n  make-type-append : TypeExpr, Token, TypeExpr, ParseState -> ParseTypeResult\n  make-type-append (left) (op-tok) (right) (st) =\n   parse-type-append-tail (deck-record (AppType (deck-record (NamedType op-tok)) [left, right])) st\n\n  parse-bound-int : ParseState -> (Integer, ParseState)\n  parse-bound-int (st) =\n   if is-minus (current-kind st) then\n    let st1 = advance st\n    in if is-literal (current-kind st1) then (-(lit-text-to-integer (token-text (current st1))), advance st1)\n    else (0, report-bound-int-error st1)\n   else if is-literal (current-kind st) then (lit-text-to-integer (token-text (current st)), advance st)\n   else (0, report-bound-int-error st)\n\n  report-bound-int-error : ParseState -> ParseState\n  report-bound-int-error (st) =\n   let tok = current st\n   in __record-set st \"bag\" (bag-add (st.bag) (make-error cdx-expected-token-kind (\"expected integer literal in bound annotation, got '\" & (token-text tok) & \"'\") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))\n\n  parse-bound-between : TypeExpr, ParseState -> ParseTypeResult\n  parse-bound-between (base) (st) =\n   let (lo, st-lo) = parse-bound-int st\n   in let st-and = expect-and-keyword st-lo\n   in let (hi, st-hi) = parse-bound-int st-and\n   in let mode-tok = current st-hi\n   in let (mode, st-mode) = parse-overflow-mode st-hi\n   in let st-mode-ok = check-wrapping-band lo hi mode mode-tok st-mode\n   in parse-type-continue (deck-record (BoundedIntType base lo hi mode)) st-mode-ok\n\n  check-wrapping-band : Integer, Integer, OverflowMode, Token, ParseState -> ParseState\n  check-wrapping-band (lo) (hi) (mode) (tok) (st) =\n   when mode\n    is OvWrapping ->\n     if bounds-are-hw-width lo hi then st\n     else __record-set st \"bag\" (bag-add (st.bag) (make-error cdx-wrapping-band-not-hw-width (\"a wrapping band must be exactly its hardware width, and \" & show lo & \" to \" & show hi & \" is not: the store wraps at the width, so the field can hold a value outside the declared range while the bounds prover still trusts that range. Widen the band to the whole width, or use clamping or error\") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))\n    is otherwise -> st\n\n  expect-and-keyword : ParseState -> ParseState\n  expect-and-keyword (st) =\n   if is-ident (current-kind st) & token-text (current st) == \"and\"\n   then advance st\n   else let tok = current st\n        in __record-set st \"bag\" (bag-add (st.bag) (make-error cdx-expected-token-kind (\"expected 'and' in bound annotation, got '\" & (token-text tok) & \"'\") (span-at (tok.line) (tok.column) (tok.offset) (tok.length) (tok.file-id))))\n\n  parse-overflow-mode : ParseState -> (OverflowMode, ParseState)\n  parse-overflow-mode (st) =\n   if is-ident (current-kind st) then\n    let txt = token-text (current st)\n    in if txt == \"wrapping\" then (deck-record OvWrapping, advance st)\n       else if txt == \"clamping\" then (deck-record OvClamping, advance st)\n       else if txt == \"error\" then (deck-record OvError, advance st)\n       else (deck-record OvError, st)\n   else (deck-record OvError, st)\n\n  parse-type-continue : TypeExpr, ParseState -> ParseTypeResult\n  parse-type-continue (left) (st) =\n   if parse-fuel-exhausted st then TypeOk left (emit-parse-fuel-error st \"parse-type-continue\")\n   else let st-fueled = consume-parse-fuel st\n   in if is-arrow (current-kind st-fueled) then let arrow-span = token-to-span (current st-fueled)\n     in let st2 = advance st-fueled\n     in let right-result = parse-type st2\n     in unwrap-type-ok right-result (make-fun-type-arrow left arrow-span)\n    else if is-fat-arrow (current-kind st-fueled) then let st2 = advance st-fueled\n     in let right-result = parse-type st2\n     in unwrap-type-ok right-result (make-constrained-type left)\n    else if current-kind st-fueled == TripleEquals then let eq-span = token-to-span (current st-fueled)\n     in let st2 = advance st-fueled\n     in let right-result = parse-type st2\n     in unwrap-type-ok right-result (make-prop-eq-type left eq-span)\n    else if is-comma (current-kind st-fueled) then if comma-starts-type-param st-fueled\n     then let st2 = skip-newlines (advance st-fueled)\n       in let right-result = parse-type st2\n       in unwrap-type-ok right-result (make-fun-type left)\n     else TypeOk left st-fueled\n    else TypeOk left st-fueled\n\n  comma-starts-type-param : ParseState -> Boolean\n  comma-starts-type-param (st) =\n   let next = peek-kind st 1\n   in if is-type-ident next then True\n      else if is-left-bracket next then True\n      else if is-left-paren next then True\n      else if is-ident next then if is-colon (peek-kind st 2) then False else True\n      else False\n\n  make-fun-type : TypeExpr, TypeExpr, ParseState -> ParseTypeResult\n  make-fun-type (left) (right) (st) =\n   TypeOk (deck-record (FunType left right)) st\n\n  make-prop-eq-type : TypeExpr, SourceSpan, TypeExpr, ParseState -> ParseTypeResult\n  make-prop-eq-type (left) (span) (right) (st) =\n   TypeOk (deck-record (PropEqType left right span)) st\n\n  make-constrained-type : TypeExpr, TypeExpr, ParseState -> ParseTypeResult\n  make-constrained-type (constraint) (body) (st) =\n   TypeOk (deck-record (ConstrainedType constraint body)) st\n\n  make-fun-type-arrow : TypeExpr, SourceSpan, TypeExpr, ParseState -> ParseTypeResult\n  make-fun-type-arrow (left) (arrow-span) (right) (st) =\n   let st2 = when right\n    is FunType (p) (r) -> __record-set st \"bag\" (bag-add (st.bag) (make-error cdx-chained-arrow-type \"Chained '->' in a type is not allowed; use commas for multiple parameters: 'A, B -> C' not 'A -> B -> C'\" arrow-span))\n    is otherwise -> st\n   in TypeOk (deck-record (FunType left right)) st2\n\n  unwrap-type-ok : ParseTypeResult, (TypeExpr, ParseState -> ParseTypeResult) -> ParseTypeResult\n  unwrap-type-ok (r) (f) =\n   when r\n    is TypeOk (t) (st) -> f t st\n\n  parse-type-atom : ParseState -> ParseTypeResult\n  parse-type-atom (st) =\n   if is-ident (current-kind st) then let tok = current st\n   in TypeOk (deck-record (NamedType tok)) (advance st)\n   else if is-type-ident (current-kind st) then let tok = current st\n   in TypeOk (deck-record (NamedType tok)) (advance st)\n   else if is-left-paren (current-kind st) then parse-paren-type (advance st)\n   else if is-left-bracket (current-kind st) then parse-effect-type (advance st)\n   else if is-signed-literal-atom st then parse-signed-literal-atom st\n   else let tok = current st\n   in TypeOk (deck-record (NamedType tok)) (advance st)\n\n Adjacency is what separates this from binary subtraction, and it has\n to be adjacency in the SOURCE rather than token order: `1 - 3` and\n `-2` produce the same two token kinds. The digits must begin at the\n byte immediately after the minus. That also makes the synthesized\n token honest -- its text is read straight out of the source across\n both tokens, so `token-text` answers \"-2\" without anything being\n fabricated.\n\n  is-signed-literal-atom : ParseState -> Boolean\n  is-signed-literal-atom (st) =\n   if current-kind st == Minus then\n    let nxt = peek-kind st 1\n    in if nxt == IntegerLiteral | nxt == NumberLiteral\n       then (list-at (st.tokens) (st.pos + 1)).offset == (current st).offset + 1\n       else False\n   else False\n\n  parse-signed-literal-atom : ParseState -> ParseTypeResult\n  parse-signed-literal-atom (st) =\n   let minus-tok = current st\n   in let num-tok = list-at (st.tokens) (st.pos + 1)\n   in let signed = deck-record (Token {\n    kind = num-tok.kind,\n    source = minus-tok.source,\n    offset = minus-tok.offset,\n    length = (num-tok.offset + num-tok.length) - minus-tok.offset,\n    line = minus-tok.line,\n    column = minus-tok.column,\n    file-id = minus-tok.file-id\n   })\n   in TypeOk (deck-record (NamedType signed)) (advance (advance st))\n\n  parse-paren-type : ParseState -> ParseTypeResult\n  parse-paren-type (st) =\n   if classify-paren-type st 0 False False == 2 then parse-tuple-type st\n   else let inner = parse-type st\n   in unwrap-type-ok inner finish-paren-type\n\n  classify-paren-type : ParseState, Integer, Boolean, Boolean -> Integer\n  classify-paren-type (st) (depth) (saw-arrow) (saw-comma) =\n   if is-done st then classify-paren-result saw-arrow saw-comma\n   else let k = current-kind st\n   in if is-left-paren k then classify-paren-type (advance st) (depth + 1) saw-arrow saw-comma\n    else if is-left-bracket k then classify-paren-type (advance st) (depth + 1) saw-arrow saw-comma\n    else if is-right-paren k then if depth == 0 then classify-paren-result saw-arrow saw-comma\n       else classify-paren-type (advance st) (depth - 1) saw-arrow saw-comma\n    else if is-right-bracket k then classify-paren-type (advance st) (depth - 1) saw-arrow saw-comma\n    else if depth == 0 then if is-arrow k then classify-paren-type (advance st) depth True saw-comma\n       else if is-comma k then classify-paren-type (advance st) depth saw-arrow True\n       else classify-paren-type (advance st) depth saw-arrow saw-comma\n    else classify-paren-type (advance st) depth saw-arrow saw-comma\n\n  classify-paren-result : Boolean, Boolean -> Integer\n  classify-paren-result (saw-arrow) (saw-comma) =\n   if saw-arrow then 1 else if saw-comma then 2 else 0\n\n  parse-tuple-type : ParseState -> ParseTypeResult\n  parse-tuple-type (st) =\n   let e = parse-tuple-type-elem st\n   in unwrap-type-ok e tuple-type-after-first\n\n  parse-tuple-type-elem : ParseState -> ParseTypeResult\n  parse-tuple-type-elem (st) =\n   let atom-r = parse-type-atom st\n   in unwrap-type-ok atom-r parse-type-args\n\n  tuple-type-after-first : TypeExpr, ParseState -> ParseTypeResult\n  tuple-type-after-first (first) (st) =\n   if is-comma (current-kind st) then collect-tuple-type (__linked-list-push [] first) (advance st)\n   else finish-paren-type first st\n\n  collect-tuple-type : LinkedList TypeExpr, ParseState -> ParseTypeResult\n  collect-tuple-type (acc) (st) =\n   let e = parse-tuple-type-elem st\n   in unwrap-type-ok e (after-tuple-type-elem acc)\n\n  after-tuple-type-elem : LinkedList TypeExpr, TypeExpr, ParseState -> ParseTypeResult\n  after-tuple-type-elem (acc) (e) (st) =\n   let acc2 = __linked-list-push acc e\n   in if is-comma (current-kind st) then collect-tuple-type acc2 (advance st)\n   else let st2 = expect RightParen st\n   in TypeOk (deck-record (TupleType (deck-record (__linked-list-to-list acc2)))) st2\n\n  finish-paren-type : TypeExpr, ParseState -> ParseTypeResult\n  finish-paren-type (t) (st) =\n   let st2 = expect RightParen st\n   in TypeOk (deck-record (ParenType t)) st2\n\n  parse-effect-type : ParseState -> ParseTypeResult\n  parse-effect-type (st) =\n   let (eff-names, st-effs, eff-scopes, eff-tail) = parse-effect-names st [] [] []\n   in let ret = parse-type st-effs\n   in unwrap-type-ok ret (finish-effect-type eff-names eff-scopes eff-tail)\n\n  finish-effect-type : List Token, List Token, List Token, TypeExpr, ParseState -> ParseTypeResult\n  finish-effect-type (effs) (scopes) (tail) (ret) (st) =\n   TypeOk (deck-record (EffectTypeExpr effs scopes tail ret)) st\n\n  empty-scope-tok : Token = Token {\n   kind = TextLiteral,\n   source = \"\",\n   offset = 0,\n   length = 0,\n   line = 0,\n   column = 0,\n   file-id = 0\n  }\n\n Inside effect brackets the identifier case is load-bearing:\n a PascalCase identifier is a concrete\n effect name; a lowercase identifier is the row's tail variable. A\n row names at most one tail (CDX1120), and a tail is bare -- no scope\n literal, no dotted sub-effect (CDX1121).\n\n  parse-effect-names : ParseState, List Token, List Token, List Token -> (List Token, ParseState, List Token, List Token)\n  parse-effect-names (st) (acc) (sacc) (tacc) =\n   if is-done st then (acc, st, sacc, tacc)\n   else if is-right-bracket (current-kind st) then (acc, advance st, sacc, tacc)\n   else if is-comma (current-kind st) then parse-effect-names (advance st) acc sacc tacc\n   else if is-ident (current-kind st) then parse-row-tail st acc sacc tacc\n   else if is-type-ident (current-kind st) then\n    let tok = current st\n    in let st2 = advance st\n    in if is-dot (current-kind st2) then parse-dotted-effect st2 tok acc sacc tacc\n       else parse-effect-with-scope st2 tok acc sacc tacc\n   else parse-effect-names (advance st) acc sacc tacc\n\n  parse-row-tail : ParseState, List Token, List Token, List Token -> (List Token, ParseState, List Token, List Token)\n  parse-row-tail (st) (acc) (sacc) (tacc) =\n   let tok = current st\n   in let st2 = advance st\n   in if is-dot (current-kind st2) then\n       let st3 = __record-set st2 \"bag\" (bag-add (st2.bag) (make-error cdx-row-tail-decorated (\"a row variable is a bare lowercase identifier; '\" & token-text tok & \"' cannot take a dotted sub-effect\") (token-to-span tok)))\n       in parse-dotted-effect st3 tok acc sacc tacc\n      else if is-text-lit (current-kind st2) then\n       let st3 = __record-set st2 \"bag\" (bag-add (st2.bag) (make-error cdx-row-tail-decorated (\"a row variable is a bare lowercase identifier; '\" & token-text tok & \"' cannot take a scope literal\") (token-to-span tok)))\n       in parse-effect-names (advance st3) acc sacc (list-push tacc tok)\n      else if list-length tacc > 0 then\n       let st3 = __record-set st2 \"bag\" (bag-add (st2.bag) (make-error cdx-row-two-tails (\"an effect row may name at most one row variable; found '\" & token-text tok & \"' after an earlier row variable\") (token-to-span tok)))\n       in parse-effect-names st3 acc sacc tacc\n      else parse-effect-names st2 acc sacc (list-push tacc tok)\n\n  parse-effect-with-scope : ParseState, Token, List Token, List Token, List Token -> (List Token, ParseState, List Token, List Token)\n  parse-effect-with-scope (st) (name-tok) (acc) (sacc) (tacc) =\n   if is-text-lit (current-kind st) then\n    let scope-tok = current st\n    in parse-effect-names (advance st) (list-push acc name-tok) (list-push sacc scope-tok) tacc\n   else parse-effect-names st (list-push acc name-tok) (list-push sacc empty-scope-tok) tacc\n\n  parse-dotted-effect : ParseState, Token, List Token, List Token, List Token -> (List Token, ParseState, List Token, List Token)\n  parse-dotted-effect (st) (base-tok) (acc) (sacc) (tacc) =\n   let st2 = advance st\n   in if is-ident (current-kind st2) | is-type-ident (current-kind st2) then\n    let sub = current st2\n    in let combined = deck-record (Token {\n     kind = Identifier,\n     source = base-tok.source,\n     offset = base-tok.offset,\n     length = sub.offset + sub.length - base-tok.offset,\n     line = base-tok.line,\n     column = base-tok.column,\n     file-id = base-tok.file-id\n    })\n    in parse-effect-with-scope (advance st2) combined acc sacc tacc\n   else parse-effect-names st2 (list-push acc base-tok) (list-push sacc empty-scope-tok) tacc\n\n  parse-type-args : TypeExpr, ParseState -> ParseTypeResult\n  parse-type-args (base-type) (st) =\n   if parse-fuel-exhausted st then TypeOk base-type (emit-parse-fuel-error st \"parse-type-args\")\n   else let st-fueled = consume-parse-fuel st\n   in if is-done st-fueled then TypeOk base-type st-fueled\n   else if is-type-arg-start (current-kind st-fueled) then parse-type-arg-next base-type st-fueled\n   else TypeOk base-type st-fueled\n\n  parse-type-arg-next : TypeExpr, ParseState -> ParseTypeResult\n  parse-type-arg-next (base-type) (st) =\n   let arg-result = parse-type-atom st\n   in unwrap-type-ok arg-result (continue-type-args base-type)\n\n  continue-type-args : TypeExpr, TypeExpr, ParseState -> ParseTypeResult\n  continue-type-args (base-type) (arg) (st) =\n   parse-type-args (deck-record (AppType base-type [arg])) st\n\nSection: Pattern Parsing\n  parse-pattern : ParseState -> ParsePatResult\n  parse-pattern (st) =\n   if parse-fuel-exhausted st then PatOk (deck-record (WildPat (current st))) (emit-parse-fuel-error st \"parse-pattern\")\n   else let st-fueled = consume-parse-fuel st\n   in if is-wildcard-pat (current-kind st-fueled) then PatOk (deck-record (WildPat (current st-fueled))) (advance st-fueled)\n   else if is-literal (current-kind st-fueled) then PatOk (deck-record (LitPat (current st-fueled))) (advance st-fueled)\n   else if is-type-ident (current-kind st-fueled) then let tok = current st-fueled\n       in parse-ctor-pattern-fields tok [] (advance st-fueled)\n   else if is-ident (current-kind st-fueled) then PatOk (deck-record (VarPat (current st-fueled))) (advance st-fueled)\n   else if is-keyword (current-kind st-fueled) then PatOk (deck-record (VarPat (current st-fueled))) (advance (report-reserved-keyword \"a pattern variable\" st-fueled))\n   else if is-left-paren (current-kind st-fueled) then parse-tuple-pattern (advance st-fueled)\n       else PatOk (deck-record (WildPat (current st-fueled))) (advance st-fueled)\n\n  parse-tuple-pattern : ParseState -> ParsePatResult\n  parse-tuple-pattern (st) =\n   let p = parse-pattern st\n   in unwrap-pat-ok p continue-tuple-pat\n\n  continue-tuple-pat : Pat, ParseState -> ParsePatResult\n  continue-tuple-pat (first) (st) =\n   if is-comma (current-kind st) then collect-tuple-pat (__linked-list-push [] first) (advance st)\n   else PatOk first (expect RightParen st)\n\n  collect-tuple-pat : LinkedList Pat, ParseState -> ParsePatResult\n  collect-tuple-pat (acc) (st) =\n   let p = parse-pattern st\n   in unwrap-pat-ok p (after-tuple-pat acc)\n\n  after-tuple-pat : LinkedList Pat, Pat, ParseState -> ParsePatResult\n  after-tuple-pat (acc) (p) (st) =\n   let acc2 = __linked-list-push acc p\n   in if is-comma (current-kind st) then collect-tuple-pat acc2 (advance st)\n   else PatOk (deck-record (TuplePat (deck-record (__linked-list-to-list acc2)))) (expect RightParen st)\n\n  parse-ctor-pattern-fields : Token, LinkedList Pat, ParseState -> ParsePatResult\n  parse-ctor-pattern-fields (ctor) (acc) (st) =\n   if parse-fuel-exhausted st then PatOk (deck-record (CtorPat ctor (deck-record (__linked-list-to-list acc)))) (emit-parse-fuel-error st \"parse-ctor-pattern-fields\")\n   else let st-fueled = consume-parse-fuel st\n   in if token-text ctor == \"Vector\" & is-left-bracket (current-kind st-fueled) then parse-vec-pat-elems [] (advance st-fueled)\n    else if is-left-paren (current-kind st-fueled) then let st2 = advance st-fueled\n     in let sub = parse-pattern st2\n     in unwrap-pat-ok sub (continue-ctor-fields ctor acc)\n    else PatOk (deck-record (CtorPat ctor (deck-record (__linked-list-to-list acc)))) st-fueled\n\n  continue-ctor-fields : Token, LinkedList Pat, Pat, ParseState -> ParsePatResult\n  continue-ctor-fields (ctor) (acc) (p) (st) =\n   let st2 = expect RightParen st\n   in parse-ctor-pattern-fields ctor (__linked-list-push acc p) st2\n\n  parse-vec-pat-elems : List Pat, ParseState -> ParsePatResult\n  parse-vec-pat-elems (acc) (st) =\n   if is-right-bracket (current-kind st) then PatOk (deck-record (VecPat acc)) (advance st)\n   else let p = parse-pattern st\n   in unwrap-pat-ok p (after-vec-pat-elem acc)\n\n  after-vec-pat-elem : List Pat, Pat, ParseState -> ParsePatResult\n  after-vec-pat-elem (acc) (p) (st) =\n   let acc2 = list-push acc p\n   in if is-comma (current-kind st) then parse-vec-pat-elems acc2 (advance st)\n   else PatOk (deck-record (VecPat acc2)) (expect RightBracket st)\n\n  unwrap-pat-ok : ParsePatResult, (Pat, ParseState -> ParsePatResult) -> ParsePatResult\n  unwrap-pat-ok (r) (f) =\n   when r\n    is PatOk (p) (st) -> f p st\n\nSection: Definition Parsing\n  parse-type-annotation : ParseState -> ParseTypeResult\n  parse-type-annotation (st) =\n   let st2 = advance st\n   in let st3 = expect Colon st2\n   in parse-type st3\n\n  parse-definition : ParseState -> ParseDefResult\n  parse-definition (st) =\n   if is-done st then ParseDefResult { maybe-def = None, state = st }\n   else if is-claim-keyword (current-kind st) then skip-claim-def st\n   else if is-proof-keyword (current-kind st) then parse-definition (advance st)\n   else if is-ident (current-kind st) then try-parse-def st\n   else if is-type-ident (current-kind st) then try-parse-def st\n     else ParseDefResult { maybe-def = None, state = st }\n\n  is-simple-claim : ParseState -> Boolean\n  is-simple-claim (st) =\n   if is-ident (peek-kind st 1) then is-colon (peek-kind st 2)\n   else False\n\n  parse-claim-annotation : ParseState -> AnnotationNode\n  parse-claim-annotation (st) =\n   let st1 = advance st\n   in if is-ident (current-kind st1) then\n    let name = token-text (current st1)\n    in let prop = collect-claim-prop (advance st1) \"\"\n    in deck-record (AnnotationNode { kind = \"claim\", target = name, body = prop })\n   else deck-record (AnnotationNode { kind = \"claim\", target = \"\", body = \"\" })\n\n  collect-claim-prop : ParseState, Text -> Text\n  collect-claim-prop (st) (acc) =\n   if is-done st then acc\n   else when current-kind st\n    is Newline -> acc\n    is otherwise -> collect-claim-prop (advance st) (acc & \" \" & token-text (current st))\n\n  skip-claim-def : ParseState -> ParseDefResult\n  skip-claim-def (st) =\n   let col = (current st).column\n   in let st2 = advance st\n   in let st3 = skip-claim-tokens st2 col\n   in parse-definition st3\n\n  skip-claim-tokens : ParseState, Integer -> ParseState\n  skip-claim-tokens (st) (col) =\n   if is-done st then st\n   else if (current st).column <= col & is-claim-or-def-start (current-kind st) then st\n   else skip-claim-tokens (advance st) col\n\n  is-claim-or-def-start : TokenKind -> Boolean\n  is-claim-or-def-start (k) =\n   when k\n    is Identifier | TypeIdentifier | ClaimKeyword | ProofKeyword -> True\n    is otherwise -> False\n\n  try-parse-def : ParseState -> ParseDefResult\n  try-parse-def (st) =\n   if is-colon (peek-kind st 1) then let first-name = current st\n     in let ann-result = parse-type-annotation st\n     in unwrap-type-for-def first-name ann-result\n    else parse-def-body-with-ann [] st\n\n  unwrap-type-for-def : Token, ParseTypeResult -> ParseDefResult\n  unwrap-type-for-def (first-name) (r) =\n   when r\n    is TypeOk (ann-type) (st) ->\n     if is-equals (current-kind st) then\n      let ann = deck-record ([deck-record (TypeAnn {\n       name = first-name,\n       type-expr = ann-type\n      })])\n      in let st2 = advance st\n      in let st3 = skip-newlines st2\n      in let body-result = parse-def-body-seq st3 (first-name.column)\n      in unwrap-def-body body-result ann first-name []\n     else\n      let name-tok = deck-record (Token {\n       kind = Identifier,\n       source = \"\",\n       offset = 0,\n       length = 0,\n       line = 0,\n       column = 0,\n       file-id = 0\n      })\n      in let ann = deck-record ([deck-record (TypeAnn {\n       name = name-tok,\n       type-expr = ann-type\n      })])\n      in let st2 = skip-newlines st\n      in parse-def-body-with-ann ann st2\n\n  parse-def-body-with-ann : List TypeAnn, ParseState -> ParseDefResult\n  parse-def-body-with-ann (ann) (st) =\n   let st-skip = if is-proof-keyword (current-kind st) then advance st else st\n   in let name-tok = current st-skip\n   in let st2 = advance st-skip\n   in parse-def-params-then ann name-tok [] st2\n\n  parse-def-params-then : List TypeAnn, Token, LinkedList Token, ParseState -> ParseDefResult\n  parse-def-params-then (ann) (name-tok) (acc) (st) =\n   if is-left-paren (current-kind st) then parse-def-params-after-lparen ann name-tok acc (advance st)\n   else finish-def ann name-tok (deck-record (__linked-list-to-list acc)) st\n\n  parse-def-params-after-lparen : List TypeAnn, Token, LinkedList Token, ParseState -> ParseDefResult\n  parse-def-params-after-lparen (ann) (name-tok) (acc) (st) =\n   if is-ident (current-kind st) then let param = current st\n     in let st2 = expect RightParen (advance st)\n     in parse-def-params-then ann name-tok (__linked-list-push acc param) st2\n    else if is-reserved-keyword (current-kind st) then\n     let st2 = report-reserved-keyword \"a parameter name\" st\n     in let st3 = expect RightParen (advance st2)\n     in parse-def-params-then ann name-tok acc st3\n      else finish-def ann name-tok (deck-record (__linked-list-to-list acc)) st\n\n  finish-def : List TypeAnn, Token, List Token, ParseState -> ParseDefResult\n  finish-def (ann) (name-tok) (params) (st) =\n   if is-equals (current-kind st) then\n    let st2 = advance st\n    in let st3 = skip-newlines st2\n    in let body-result = parse-def-body-seq st3 (name-tok.column)\n    in unwrap-def-body body-result ann name-tok params\n   else let tok = current st\n    in let err-st = expect Equals st\n    in let st2 = skip-body-tokens err-st (name-tok.column)\n    in ParseDefResult {\n     maybe-def = Just (deck-record (Def {\n      name = name-tok,\n      params = params,\n      ann = ann,\n      body = ErrExpr tok,\n      chapter-slug = \"\"\n     })),\n     state = st2\n    }\n\n  unwrap-def-body : ParseExprResult, List TypeAnn, Token, List Token -> ParseDefResult\n  unwrap-def-body (r) (ann) (name-tok) (params) =\n   when r\n    is ExprOk (b) (st) ->\n     ParseDefResult {\n      maybe-def = Just (deck-record (Def {\n       name = name-tok,\n       params = params,\n       ann = ann,\n       body = b,\n       chapter-slug = \"\"\n      })),\n      state = st\n     }\n\nSection: Type Definition Parsing\n  is-paren-type-param : ParseState -> Boolean\n  is-paren-type-param (st) =\n   if is-left-paren (current-kind st) then let k1 = peek-kind st 1\n   in if is-ident k1 then is-right-paren (peek-kind st 2)\n      else if is-type-ident k1 then is-right-paren (peek-kind st 2)\n      else False\n    else False\n\n  is-type-param-pattern : ParseState -> Boolean\n  is-type-param-pattern (st) =\n   if is-paren-type-param st then True\n   else is-ident (current-kind st)\n\n  parse-type-params : ParseState, LinkedList Token -> ParseState\n  parse-type-params (st) (acc) =\n   if is-paren-type-param st then parse-type-params (advance (advance (advance st))) (__linked-list-push acc (list-at (st.tokens) (st.pos + 1)))\n   else if is-ident (current-kind st) then parse-type-params (advance st) (__linked-list-push acc (current st))\n   else st\n\n  parse-unit-family : Token, List Token, ParseState -> ParseTypeDefResult\n  parse-unit-family (name-tok) (tparams) (st) =\n   let base-tok = current st\n   in let st2 = skip-newlines (advance st)\n   in let (members, st3) = parse-family-members st2 []\n   in ParseTypeDefResult {\n    maybe-type-def = Just (deck-record (TypeDef {\n     name = name-tok,\n     type-params = tparams,\n     body = UnitFamilyBody base-tok members,\n     is-mutable = False,\n     deriving = []\n    })),\n    state = st3\n   }\n\n  parse-family-members : ParseState, LinkedList UnitFamilyMember -> (List UnitFamilyMember, ParseState)\n  parse-family-members (st) (acc) =\n   if is-done st then (deck-record (__linked-list-to-list acc), st)\n   else if is-type-ident (current-kind st) then let mem-tok = current st\n     in let st2 = advance st\n     in if is-equals (current-kind st2) then let st3 = advance st2\n       in if current-kind st3 == IntegerLiteral then let factor = lit-text-to-integer (token-text (current st3))\n         in let member = deck-record (UnitFamilyMember { member-name = mem-tok, factor = factor })\n         in parse-family-members (skip-newlines (advance st3)) (__linked-list-push acc member)\n       else (deck-record (__linked-list-to-list acc), st)\n     else (deck-record (__linked-list-to-list acc), st)\n   else (deck-record (__linked-list-to-list acc), st)\n\n  collect-type-params : ParseState, LinkedList Token -> List Token\n  collect-type-params (st) (acc) =\n   if is-paren-type-param st then collect-type-params (advance (advance (advance st))) (__linked-list-push acc (list-at (st.tokens) (st.pos + 1)))\n   else if is-ident (current-kind st) then collect-type-params (advance st) (__linked-list-push acc (current st))\n   else deck-record (__linked-list-to-list acc)\n\n  parse-type-def : ParseState -> ParseTypeDefResult\n  parse-type-def (st) =\n   if is-mutable-keyword (current-kind st) then let st0 = advance st\n     in parse-type-def-inner True st0\n   else parse-type-def-inner False st\n\n  parse-type-def-inner : Boolean, ParseState -> ParseTypeDefResult\n  parse-type-def-inner (is-mut) (st) =\n   if is-type-ident (current-kind st) then let name-tok = current st\n     in let st2 = advance st\n     in let tparams = collect-type-params st2 []\n     in let st3 = parse-type-params st2 []\n     in if is-equals (current-kind st3) then let st4 = skip-newlines (advance st3)\n     in if is-unit-keyword (current-kind st4) then let st-after-unit = advance st4\n            in if is-ident (current-kind st-after-unit) & token-text (current st-after-unit) == \"family\" then parse-unit-family name-tok tparams (advance st-after-unit)\n            else when parse-type st-after-unit\n            is TypeOk (base-te) (st5) -> ParseTypeDefResult {\n             maybe-type-def = Just (deck-record (TypeDef {\n              name = name-tok,\n              type-params = tparams,\n              body = UnitBody base-te,\n              is-mutable = False,\n              deriving = []\n             })),\n             state = st5\n            }\n            else if is-record-keyword (current-kind st4) then attach-deriving (parse-record-type name-tok tparams is-mut st4)\n            else if is-pipe (current-kind st4) then attach-deriving (parse-variant-type name-tok tparams st4)\n            else if is-type-ident (current-kind st4) & looks-like-variant st4 then attach-deriving (parse-variant-type name-tok tparams st4)\n            else ParseTypeDefResult { maybe-type-def = None, state = st }\n         else ParseTypeDefResult { maybe-type-def = None, state = st }\n    else ParseTypeDefResult { maybe-type-def = None, state = st }\n\n  is-deriving-kw : ParseState -> Boolean\n  is-deriving-kw (st) =\n   if is-ident (current-kind st) then token-text (current st) == \"deriving\"\n   else False\n\n  parse-deriving-names : ParseState, LinkedList Token -> (List Token, ParseState)\n  parse-deriving-names (st) (acc) =\n   if is-type-ident (current-kind st) then let acc2 = __linked-list-push acc (current st)\n     in let st2 = advance st\n     in if is-comma (current-kind st2) then parse-deriving-names (skip-newlines (advance st2)) acc2\n        else (deck-record (__linked-list-to-list acc2), st2)\n   else (deck-record (__linked-list-to-list acc), st)\n\n  attach-deriving : ParseTypeDefResult -> ParseTypeDefResult\n  attach-deriving (r) =\n   when (r.maybe-type-def)\n    is None -> r\n    is Just (td) ->\n     let st1 = skip-newlines (r.state)\n     in if is-deriving-kw st1 then let (deriv-names, st-deriv) = parse-deriving-names (skip-newlines (advance st1)) []\n          in ParseTypeDefResult { maybe-type-def = Just (deck-record (__record-set td \"deriving\" deriv-names)), state = st-deriv }\n        else r\n\n  parse-record-type : Token, List Token, Boolean, ParseState -> ParseTypeDefResult\n  parse-record-type (name-tok) (tparams) (is-mut) (st) =\n   let st2 = advance st\n   in let st3 = expect LeftBrace st2\n   in let st4 = skip-newlines st3\n   in parse-record-fields-loop name-tok tparams is-mut [] st4\n\n  parse-record-fields-loop : Token, List Token, Boolean, LinkedList RecordFieldDef, ParseState -> ParseTypeDefResult\n  parse-record-fields-loop (name-tok) (tparams) (is-mut) (acc) (st) =\n   if is-right-brace (current-kind st) then ParseTypeDefResult {\n    maybe-type-def = Just (deck-record (TypeDef {\n     name = name-tok,\n     type-params = tparams,\n     body = RecordBody (deck-record (__linked-list-to-list acc)),\n     is-mutable = is-mut,\n     deriving = []\n    })),\n    state = advance st\n   }\n   else if is-field-name-token (current-kind st) then parse-one-record-field name-tok tparams is-mut acc st\n   else ParseTypeDefResult {\n    maybe-type-def = Just (deck-record (TypeDef {\n     name = name-tok,\n     type-params = tparams,\n     body = RecordBody (deck-record (__linked-list-to-list acc)),\n     is-mutable = is-mut,\n     deriving = []\n    })),\n    state = st\n   }\n\n  parse-one-record-field : Token, List Token, Boolean, LinkedList RecordFieldDef, ParseState -> ParseTypeDefResult\n  parse-one-record-field (name-tok) (tparams) (is-mut) (acc) (st) =\n   let field-name = current st\n   in let st2 = advance st\n   in let st3 = expect Colon st2\n   in let field-type-result = parse-type st3\n   in unwrap-record-field-type name-tok tparams is-mut acc field-name field-type-result\n\n  unwrap-record-field-type : Token, List Token, Boolean, LinkedList RecordFieldDef, Token, ParseTypeResult -> ParseTypeDefResult\n  unwrap-record-field-type (name-tok) (tparams) (is-mut) (acc) (field-name) (r) =\n   when r\n    is TypeOk (ft) (st) ->\n     let field = deck-record (RecordFieldDef {\n      name = field-name,\n      type-expr = ft\n     })\n     in let st2 = skip-newlines st\n     in if is-comma (current-kind st2) then parse-record-fields-loop name-tok tparams is-mut (__linked-list-push acc field) (skip-newlines (advance st2))\n         else parse-record-fields-loop name-tok tparams is-mut (__linked-list-push acc field) st2\n\n  looks-like-variant : ParseState -> Boolean\n  looks-like-variant (st) =\n   looks-like-variant-scan (st.tokens) (st.pos + 1) (list-length (st.tokens))\n\n  looks-like-variant-scan : List Token, Integer, Integer -> Boolean\n  looks-like-variant-scan (tokens) (i) (len) =\n   if i >= len then False\n   else let k = (list-at tokens i).kind\n   in if is-pipe k then True\n      else when k\n      is Newline | EndOfFile -> False\n      is otherwise -> looks-like-variant-scan tokens (i + 1) len\n\n  parse-variant-type : Token, List Token, ParseState -> ParseTypeDefResult\n  parse-variant-type (name-tok) (tparams) (st) =\n   if is-type-ident (current-kind st) then let ctor-name = current st\n     in let st2 = advance st\n     in parse-ctor-fields ctor-name [] st2 name-tok tparams []\n    else parse-variant-ctors name-tok tparams [] st\n\n  parse-variant-ctors : Token, List Token, LinkedList VariantCtorDef, ParseState -> ParseTypeDefResult\n  parse-variant-ctors (name-tok) (tparams) (acc) (st) =\n   if is-pipe (current-kind st) then let st2 = skip-newlines (advance st)\n     in let ctor-name = current st2\n     in let st3 = advance st2\n     in parse-ctor-fields ctor-name [] st3 name-tok tparams acc\n    else ParseTypeDefResult {\n     maybe-type-def = Just (deck-record (TypeDef {\n      name = name-tok,\n      type-params = tparams,\n      body = VariantBody (deck-record (__linked-list-to-list acc)),\n      is-mutable = False,\n      deriving = []\n     })),\n     state = st\n    }\n\n  parse-ctor-fields : Token, LinkedList TypeExpr, ParseState, Token, List Token, LinkedList VariantCtorDef -> ParseTypeDefResult\n  parse-ctor-fields (ctor-name) (fields) (st) (name-tok) (tparams) (acc) =\n   if is-left-paren (current-kind st) then let field-result = parse-type (advance st)\n     in unwrap-ctor-field field-result ctor-name fields name-tok tparams acc\n    else let st2 = skip-newlines st\n    in if is-colon (current-kind st2) then let ret-result = parse-type (advance st2) in unwrap-ctor-return ret-result ctor-name fields name-tok tparams acc else let ctor = deck-record (VariantCtorDef { name = ctor-name, fields = deck-record (__linked-list-to-list fields), return-type = [] }) in parse-variant-ctors name-tok tparams (__linked-list-push acc ctor) st2\n\n  unwrap-ctor-field : ParseTypeResult, Token, LinkedList TypeExpr, Token, List Token, LinkedList VariantCtorDef -> ParseTypeDefResult\n  unwrap-ctor-field (r) (ctor-name) (fields) (name-tok) (tparams) (acc) =\n   when r\n    is TypeOk (ty) (st) ->\n     let st2 = expect RightParen st\n      in parse-ctor-fields ctor-name (__linked-list-push fields ty) st2 name-tok tparams acc\n\n  unwrap-ctor-return : ParseTypeResult, Token, LinkedList TypeExpr, Token, List Token, LinkedList VariantCtorDef -> ParseTypeDefResult\n  unwrap-ctor-return (r) (ctor-name) (fields) (name-tok) (tparams) (acc) =\n   when r\n    is TypeOk (ty) (st) -> let ctor = deck-record (VariantCtorDef { name = ctor-name, fields = deck-record (__linked-list-to-list fields), return-type = [ty] }) in parse-variant-ctors name-tok tparams (__linked-list-push acc ctor) (skip-newlines st)\n\nSection: Document Parsing\n\n The ceiling is the PARSE scratch reservation's top. THREE walks write\n that deck here and all three are bounded, because guarding only the\n middle one does not keep the deck inside its floor -- measured\n 2026-07-21 by keying the phase's report on the post-hoc parse-ov flag\n alone, where a compile with parse-top-level guarded still raised\n CDX9002 at a 2.5 MB floor. scan-class-instance-defs and check-pagination\n each walk the whole token list again, after parse-top-level has stopped,\n and between them they carried the deck past the ceiling on their own.\n\n  parse-document : ParseState, Integer -> Document\n  parse-document (st) (ceiling) =\n   let st0 = __record-set st \"deck-ceiling\" ceiling\n   in let st2 = skip-newlines st0\n   in let (imp-list, imp-st) = parse-citations st2 \"\" []\n   in let doc = parse-top-level [] [] [] imp-list \"\" [] [] [] [] imp-st\n   in let short = deck-short-of ceiling demand-parse-scratch-guard-band\n   in let ci = if short then empty-class-instance-scan else scan-class-instance-defs (make-parse-state (st.tokens) \"\") [] []\n   in let pag-errs = if short then [] else check-pagination (scan-chapter-pages (make-parse-state (st.tokens) \"\") [])\n   in let doc2 = __record-set (__record-set doc \"class-defs\" (ci.class-defs)) \"instance-defs\" (ci.instance-defs)\n   in __record-set doc2 \"parse-bag\" (add-bag-diags (doc2.parse-bag) pag-errs 0 (list-length pag-errs))\n\n  deck-copy-text : Text -> Text\n  deck-copy-text (t) =\n   if text-length t == 0 then \"\" else deck-record (substring t 0 (text-length t))\n\n  collect-cite-title : ParseState, Text -> (Text, ParseState)\n  collect-cite-title (st) (acc) =\n   if is-done st then (deck-copy-text acc, st)\n    else when current-kind st\n     is Newline | LeftParen -> (deck-copy-text acc, st)\n     is otherwise -> let tok = current st\n      in collect-cite-title (advance st) (join-title-parts acc (token-text tok))\n\n  parse-citations : ParseState, Text, LinkedList CitesDecl -> (List CitesDecl, ParseState)\n  parse-citations (st) (citing) (acc) =\n   if is-cites-keyword (current-kind st) then let st2 = advance st\n     in let quire-tok = current st2\n     in let st3 = advance st2\n     in let st4 = advance st3\n     in let (cite-title, st5) = collect-cite-title st4 \"\"\n     in if is-left-paren (current-kind st5) then let (sel-names, st-sel) = parse-selected-names (advance st5) []\n     in let st6 = skip-newlines st-sel\n     in parse-citations st6 citing (__linked-list-push acc (deck-record (CitesDecl {\n           quire = quire-tok,\n           chapter-name = cite-title,\n           selected-names = sel-names,\n           citing-chapter = citing,\n           decl-kind = decl-cite,\n           content-hash = \"\",\n           trust-floor = 0\n          })))\n     else let st6 = skip-newlines st5\n     in parse-citations st6 citing (__linked-list-push acc (deck-record (CitesDecl {\n          quire = quire-tok,\n          chapter-name = cite-title,\n          selected-names = [],\n          citing-chapter = citing,\n          decl-kind = decl-cite,\n          content-hash = \"\",\n          trust-floor = 0\n         })))\n    else (deck-record (__linked-list-to-list acc), st)\n\nSection: Quotations\n\n  quote-body-text : Token -> Text\n  quote-body-text (tok) =\n   let n = tok.length\n   in if n < 2 then \"\"\n      else deck-record (substring (tok.source) (tok.offset + 1) (n - 2))\n\n  parse-quotation : ParseState, Text -> (CitesDecl, ParseState)\n  parse-quotation (st) (citing) =\n   let qtok = current st\n   in let st1 = advance st\n   in let hash-tok = current st1\n   in let st2 = advance st1\n   in let st3 = if is-ident (current-kind st2) then advance st2 else st2\n   in let name-tok = current st3\n   in let st4 = skip-newlines (advance st3)\n   in (deck-record (CitesDecl {\n        quire = qtok,\n        chapter-name = deck-copy-text (token-text name-tok),\n        selected-names = [],\n        citing-chapter = citing,\n        decl-kind = decl-quote,\n        content-hash = quote-body-text hash-tok,\n        trust-floor = 0\n       }), st4)\n\n  parse-trusting : ParseState, Text -> (CitesDecl, ParseState)\n  parse-trusting (st) (citing) =\n   let ttok = current st\n   in let st1 = advance st\n   in if is-text-lit (current-kind st1)\n      then parse-trusting-key ttok st1 citing\n      else parse-trusting-floor ttok st1 citing\n\n A trust FLOOR: trusting above N. The floor is the threshold every quoted\n work's signer must clear. The above word is optional.\n\n  parse-trusting-floor : Token, ParseState, Text -> (CitesDecl, ParseState)\n  parse-trusting-floor (ttok) (st1) (citing) =\n   let st2 = if is-above-keyword (current-kind st1) then advance st1 else st1\n   in let n-tok = current st2\n   in let st3 = skip-newlines (advance st2)\n   in (deck-record (CitesDecl {\n        quire = ttok,\n        chapter-name = \"\",\n        selected-names = [],\n        citing-chapter = citing,\n        decl-kind = decl-trust,\n        content-hash = \"\",\n        trust-floor = text-to-integer (token-text n-tok)\n       }), st3)\n\n A trusted KEY: trusting \"<fingerprint>\" \"<public-key-hex>\" <score>. The\n fingerprint is the lookup name a signed work will claim; the public key is\n the bytes its signature is verified against; the score is how far this\n source trusts that key. Because the key is named here in the source rather\n than in the offered works, a forged work signed by any other key is\n verified against the wrong bytes and refused -- the messenger cannot\n vouch for its own message. The two texts still carry their quotation\n marks in the token, so the body is what quote-body-text lifts out.\n\n  parse-trusting-key : Token, ParseState, Text -> (CitesDecl, ParseState)\n  parse-trusting-key (ttok) (st1) (citing) =\n   let fp-tok = current st1\n   in let st2 = advance st1\n   in let pub-tok = current st2\n   in let st3 = advance st2\n   in let score-tok = current st3\n   in let st4 = skip-newlines (advance st3)\n   in (deck-record (CitesDecl {\n        quire = ttok,\n        chapter-name = quote-body-text fp-tok,\n        selected-names = [],\n        citing-chapter = citing,\n        decl-kind = decl-trust-key,\n        content-hash = quote-body-text pub-tok,\n        trust-floor = text-to-integer (token-text score-tok)\n       }), st4)\n\nSection: Grounds\n\n A grounds declaration names the hardware effects a chapter is the\n SOURCE of -- the layer where the abstraction meets the metal. Its\n functions may perform those effects without declaring them (the\n internal exemption, no bookkeeping); a function that DECLARES the\n effect in its signature publishes it to out-of-kernel callers (a root).\n The exemption is scoped to the named effects, so a chapter grounding\n Device.Port that performs Device.Mmio is still rejected. Each named\n effect rides the header as a decl-grounds CitesDecl carrying the effect\n name (chapter-name) and the chapter that grounds it (citing-chapter);\n grounds-strings collects them into the Document as \"slug\\neffect\"\n entries the type checker reads. A dotted effect\n (Device.Mmio) is read base-dot-member, the same shape parse-effect-names\n reads inside a row.\n\n  parse-grounds : Token, ParseState, Text, LinkedList CitesDecl -> (List CitesDecl, ParseState)\n  parse-grounds (gtok) (st) (citing) (acc) =\n   if is-type-ident (current-kind st) | is-ident (current-kind st) then\n    let tok = current st\n    in let st2 = advance st\n    in if is-dot (current-kind st2) then\n        let st3 = advance st2\n        in let sub = current st3\n        in parse-grounds gtok (advance st3) citing (__linked-list-push acc (deck-record (CitesDecl {\n             quire = gtok,\n             chapter-name = deck-copy-text (token-text tok & \".\" & token-text sub),\n             selected-names = [],\n             citing-chapter = citing,\n             decl-kind = decl-grounds,\n             content-hash = \"\",\n             trust-floor = 0\n            })))\n       else parse-grounds gtok st2 citing (__linked-list-push acc (deck-record (CitesDecl {\n             quire = gtok,\n             chapter-name = deck-copy-text (token-text tok),\n             selected-names = [],\n             citing-chapter = citing,\n             decl-kind = decl-grounds,\n             content-hash = \"\",\n             trust-floor = 0\n            })))\n   else if is-comma (current-kind st) then parse-grounds gtok (advance st) citing acc\n   else (deck-record (__linked-list-to-list acc), skip-newlines st)\n\n  grounds-strings : List CitesDecl, Integer, Integer, List Text -> List Text\n  grounds-strings (ds) (i) (len) (acc) =\n   if i >= len then acc\n   else let d = list-at ds i\n   in if d.decl-kind == decl-grounds\n      then grounds-strings ds (i + 1) len (list-push acc (deck-record ((d.citing-chapter) & \"\\n\" & (d.chapter-name))))\n      else grounds-strings ds (i + 1) len acc\n\nSection: Sorting Out The Header\n\n  filter-decl-kind : List CitesDecl, Integer, Integer, Integer, List CitesDecl -> List CitesDecl\n  filter-decl-kind (ds) (want) (i) (len) (acc) =\n   if i >= len then acc\n   else let d = list-at ds i\n   in if d.decl-kind == want\n      then filter-decl-kind ds want (i + 1) len (list-push acc d)\n      else filter-decl-kind ds want (i + 1) len acc\n\n  header-trust-floor : List CitesDecl, Integer, Integer, Integer -> Integer\n  header-trust-floor (ds) (i) (len) (acc) =\n   if i >= len then acc\n   else let d = list-at ds i\n   in if d.decl-kind == decl-trust\n      then header-trust-floor ds (i + 1) len (d.trust-floor)\n      else header-trust-floor ds (i + 1) len acc\n\n  stamp-trust-floor : List CitesDecl, Integer, Integer, Integer, List CitesDecl -> List CitesDecl\n  stamp-trust-floor (qs) (floor) (i) (len) (acc) =\n   if i >= len then acc\n   else let q = list-at qs i\n   in let stamped = deck-record (__record-set q \"trust-floor\" floor)\n   in stamp-trust-floor qs floor (i + 1) len (list-push acc stamped)\n\n  parse-selected-names : ParseState, LinkedList Token -> (List Token, ParseState)\n  parse-selected-names (st) (acc) =\n   if is-ident (current-kind st) | is-type-ident (current-kind st) then let tok = current st\n     in let st2 = advance st\n     in let acc2 = __linked-list-push acc tok\n     in if is-comma (current-kind st2) then parse-selected-names (skip-newlines (advance st2)) acc2\n        else if is-right-paren (current-kind st2) then (deck-record (__linked-list-to-list acc2), advance st2)\n        else (deck-record (__linked-list-to-list acc2), st2)\n    else if is-right-paren (current-kind st) then (deck-record (__linked-list-to-list acc), advance st)\n    else (deck-record (__linked-list-to-list acc), st)\n\n  is-chapter-header : ParseState -> Boolean\n  is-chapter-header (st) =\n   if is-type-ident (current-kind st) then let tok = current st\n      in if tok.length == 7 then if (token-text tok) == \"Chapter\" then is-colon (peek-kind st 1)\n            else False\n         else False\n    else False\n\n  is-section-header : ParseState -> Boolean\n  is-section-header (st) =\n   if is-type-ident (current-kind st) then let tok = current st\n      in if tok.length == 7 then if (token-text tok) == \"Section\" then is-colon (peek-kind st 1)\n            else False\n         else False\n    else False\n\nSection: Chapter Pagination\n\n A chapter may span several files. Each file is a PAGE, and says so:\n `Page 3 of 13`. That is why a repeated `Chapter:` name is not an error\n -- the X86-64 code generator is one chapter across thirteen files, and\n the parser is right to merge them.\n\n So: a chapter that appears once needs nothing. A chapter that appears\n k > 1 times must have, on every page, `Page N of M` with M == k and\n the N distinct. Anything else is CDX3004.\n\n  PageOcc = record {\n   po-chapter : Text,\n   po-n : Integer,\n   po-m : Integer,\n   po-span : SourceSpan\n  }\n\n  page-marker-n : ParseState -> Integer\n  page-marker-n (st) = text-to-integer (token-text (current (advance st)))\n\n  page-marker-m : ParseState -> Integer\n  page-marker-m (st) =\n   let st2 = advance (advance st)\n   in if is-ident (current-kind st2) then\n       if (token-text (current st2)) == \"of\" then text-to-integer (token-text (current (advance st2)))\n       else 0\n      else 0\n\n  set-last-page : List PageOcc, Integer, Integer -> List PageOcc\n  set-last-page (occs) (n) (m) =\n   let len = list-length occs\n   in if len == 0 then occs\n   else let last = list-at occs (len - 1)\n   in list-set-at occs (len - 1) (deck-record (PageOcc {\n    po-chapter = last.po-chapter,\n    po-n = n,\n    po-m = m,\n    po-span = last.po-span\n   }))\n\n  scan-chapter-pages : ParseState, List PageOcc -> List PageOcc\n  scan-chapter-pages (st) (acc) =\n   if is-done st then acc\n   else if is-chapter-header st then\n    let tok = current st\n    in let title = extract-header-title st\n    in scan-chapter-pages (skip-to-next-line st) (list-push acc (deck-record (PageOcc {\n     po-chapter = title,\n     po-n = 0,\n     po-m = 0,\n     po-span = token-to-span tok\n    })))\n   else if is-page-marker st then\n    let n = page-marker-n st\n    in let m = page-marker-m st\n    in scan-chapter-pages (skip-to-next-line st) (set-last-page acc n m)\n   else scan-chapter-pages (advance st) acc\n\n  count-chapter-occs : List PageOcc, Text, Integer, Integer, Integer -> Integer\n  count-chapter-occs (occs) (name) (i) (len) (acc) =\n   if i == len then acc\n   else if (list-at occs i).po-chapter == name then count-chapter-occs occs name (i + 1) len (acc + 1)\n   else count-chapter-occs occs name (i + 1) len acc\n\n  count-chapter-page-n : List PageOcc, Text, Integer, Integer, Integer, Integer -> Integer\n  count-chapter-page-n (occs) (name) (n) (i) (len) (acc) =\n   if i == len then acc\n   else let o = list-at occs i\n   in if o.po-chapter == name then\n       if o.po-n == n then count-chapter-page-n occs name n (i + 1) len (acc + 1)\n       else count-chapter-page-n occs name n (i + 1) len acc\n      else count-chapter-page-n occs name n (i + 1) len acc\n\n  check-pagination : List PageOcc -> List Diagnostic\n  check-pagination (occs) = check-pagination-loop occs 0 (list-length occs) []\n\n  check-pagination-loop : List PageOcc, Integer, Integer, List Diagnostic -> List Diagnostic\n  check-pagination-loop (occs) (i) (len) (errs) =\n   if i == len then errs\n   else let o = list-at occs i\n   in let k = count-chapter-occs occs (o.po-chapter) 0 len 0\n   in if k <= 1 then check-pagination-loop occs (i + 1) len errs\n      else if o.po-m == 0\n       then check-pagination-loop occs (i + 1) len (errs & [make-error cdx-chapter-pagination (\"Chapter '\" & (o.po-chapter) & \"' spans \" & show k & \" files, but this page carries no 'Page N of M' marker. Number the pages, or an accidental duplicate chapter name is indistinguishable from a deliberate page and the two merge silently.\") (o.po-span)])\n      else if o.po-m /= k\n       then check-pagination-loop occs (i + 1) len (errs & [make-error cdx-chapter-pagination (\"Chapter '\" & (o.po-chapter) & \"' spans \" & show k & \" files but this page declares 'of \" & show (o.po-m) & \"'. The declared page count must equal the number of files the chapter spans.\") (o.po-span)])\n      else if count-chapter-page-n occs (o.po-chapter) (o.po-n) 0 len 0 > 1\n       then check-pagination-loop occs (i + 1) len (errs & [make-error cdx-chapter-pagination (\"Chapter '\" & (o.po-chapter) & \"' has two pages numbered \" & show (o.po-n) & \". Each page of a chapter needs a distinct number.\") (o.po-span)])\n      else check-pagination-loop occs (i + 1) len errs\n\n  add-bag-diags : DiagnosticBag, List Diagnostic, Integer, Integer -> DiagnosticBag\n  add-bag-diags (bag) (ds) (i) (len) =\n   if i == len then bag\n   else add-bag-diags (bag-add bag (list-at ds i)) ds (i + 1) len\n\n  is-page-number : TokenKind -> Boolean\n  is-page-number (k) =\n   when k\n    is IntegerLiteral -> True\n    is otherwise -> False\n\n  is-page-marker : ParseState -> Boolean\n  is-page-marker (st) =\n   if is-type-ident (current-kind st) then let tok = current st\n      in if tok.length == 4 then if (token-text tok) == \"Page\" then is-page-number (peek-kind st 1)\n         else False\n      else False\n    else False\n\n  extract-header-title : ParseState -> Text\n  extract-header-title (st) =\n   let st2 = advance (advance st)\n   in deck-copy-text (collect-title-tokens st2 \"\")\n\n  join-title-parts : Text, Text -> Text\n  join-title-parts (acc) (next) =\n   if text-length acc == 0 then next\n    else if text-length next == 0 then acc\n    else let prev-last = char-code-at acc (text-length acc - 1)\n     in let next-first = char-code-at next 0\n     in if (is-letter-code prev-last | is-digit-code prev-last) & (is-letter-code next-first | is-digit-code next-first)\n        then deck-record (acc & \" \" & next)\n        else deck-record (acc & next)\n\n  collect-title-tokens : ParseState, Text -> Text\n  collect-title-tokens (st) (acc) =\n   if is-done st then acc\n   else when current-kind st\n    is Newline -> acc\n    is otherwise -> let tok = current st\n     in collect-title-tokens (advance st) (join-title-parts acc (token-text tok))\n\n  is-prose-line : ParseState -> Boolean\n  is-prose-line (st) = (current st).column == 2\n\n  skip-body-lines : ParseState -> ParseState\n  skip-body-lines (st) =\n   let st2 = skip-newlines st\n   in if is-done st2 then st2\n   else if (current st2).column >= 3 then skip-body-lines (skip-to-next-line st2)\n   else st2\n\n  skip-prose-lines : ParseState -> ParseState\n  skip-prose-lines (st) =\n   let st2 = skip-newlines st\n   in if is-done st2 then st2\n      else if is-prose-line st2 then skip-prose-lines (skip-to-next-line st2)\n      else if (current st2).column > 3 then skip-prose-lines (skip-to-next-line st2)\n      else st2\n\n  is-prose-token : ParseState -> Boolean\n  is-prose-token (st) = current-kind st == ProseText\n\n  classify-transition : Text -> ProseTransition\n  classify-transition (line) =\n   if text-contains line \"We say:\" then PtWeSay\n   else if text-contains line \"This is written:\" then PtThisIsWritten\n   else PtNone\n\n  extract-template-name : Text, Text -> Text\n  extract-template-name (line) (marker) =\n   let parts = text-split line marker\n   in if list-length parts < 1 then \"\"\n      else let prefix = list-at parts 0\n   in let words = text-split prefix \" \"\n   in extract-last-word words (list-length words)\n\n  extract-last-word : List Text, Integer -> Text\n  extract-last-word (words) (len) =\n   if len == 0 then \"\"\n   else let w = list-at words (len - 1)\n   in if text-length w == 0 then extract-last-word words (len - 1)\n      else w\n\n  extract-function-name : Text -> Text\n  extract-function-name (line) =\n   let parts = text-split line \" \"\n   in if list-length parts < 2 then \"\"\n      else let second = list-at parts 1\n   in if text-length second == 0 then \"\" else second\n\n  classify-template : Text -> ProseTemplate\n  classify-template (line) =\n   if text-contains line \"is a record containing:\" then\n    PtRecordTemplate (extract-template-name line \"is a record containing:\")\n   else if text-contains line \"is one of:\" then\n    PtVariantTemplate (extract-template-name line \"is one of:\")\n   else if text-contains line \"is either:\" then\n    PtVariantTemplate (extract-template-name line \"is either:\")\n   else if text-starts-with line \"To \" then\n    PtFunctionTemplate (extract-function-name line)\n   else if text-starts-with line \"such that \" then PtConstraintTemplate\n   else if text-starts-with line \"where \" then PtConstraintTemplate\n   else if text-starts-with line \"provided that \" then PtConstraintTemplate\n   else if text-starts-with line \"claim:\" then PtProofTemplate\n   else if text-starts-with line \"Claim:\" then PtProofTemplate\n   else if text-starts-with line \"therefore,\" then PtProofTemplate\n   else if text-starts-with line \"it follows that \" then PtProofTemplate\n   else if text-starts-with line \"first,\" then PtProcedureTemplate\n   else if text-starts-with line \"First,\" then PtProcedureTemplate\n   else if text-starts-with line \"then,\" then PtProcedureTemplate\n   else if text-starts-with line \"Then,\" then PtProcedureTemplate\n   else if text-starts-with line \"finally,\" then PtProcedureTemplate\n   else if text-starts-with line \"Finally,\" then PtProcedureTemplate\n   else if text-starts-with line \"for every \" then PtQuantifiedTemplate\n   else if text-starts-with line \"For every \" then PtQuantifiedTemplate\n   else if text-starts-with line \"there exists \" then PtQuantifiedTemplate\n   else if text-starts-with line \"There exists \" then PtQuantifiedTemplate\n   else if text-starts-with line \"no \" then PtQuantifiedTemplate\n   else PtNoTemplate\n\n  classify-prose-line : Text, Integer -> ProseBlock\n  classify-prose-line (line) (off) =\n   deck-record (ProseBlock {\n    text = line,\n    transition = classify-transition line,\n    template = classify-template line,\n    anchor = \"\",\n    offset = off\n   })\n\n  CollectProseResult = record { state : ParseState, lines : LinkedList Text, blocks : LinkedList ProseBlock }\n\n  collect-prose-with-text : ParseState, LinkedList Text, LinkedList ProseBlock -> CollectProseResult\n  collect-prose-with-text (st) (acc) (blk-acc) =\n   let st2 = skip-newlines st\n   in if is-done st2 then CollectProseResult { state = st2, lines = acc, blocks = blk-acc }\n      else if is-prose-token st2 then let txt = token-text (current st2)\n        in let block = classify-prose-line txt ((current st2).offset)\n        in collect-prose-with-text (skip-to-next-line (advance st2)) (__linked-list-push acc (txt & \"\\n\")) (__linked-list-push blk-acc block)\n      else if is-prose-line st2 then collect-prose-with-text (skip-to-next-line st2) acc blk-acc\n      else if (current st2).column > 3 then collect-prose-with-text (skip-to-next-line st2) acc blk-acc\n      else CollectProseResult { state = st2, lines = acc, blocks = blk-acc }\n\n  skip-to-next-line : ParseState -> ParseState\n  skip-to-next-line (st) =\n   if is-done st then st\n   else when current-kind st\n    is Newline -> advance st\n    is otherwise -> skip-to-next-line (advance st)\n\n  is-conversion-decl : ParseState -> Boolean\n  is-conversion-decl (st) =\n   if current-kind st == IntegerLiteral then let st1 = advance st\n   in if is-done st1 then False\n   else if is-type-ident (current-kind st1) then let st2 = advance st1\n     in if is-done st2 then False\n     else is-equals (current-kind st2)\n   else False\n   else False\n\n  parse-conversion-decl : ParseState -> AnnotationNode\n  parse-conversion-decl (st) =\n   let from-val = token-text (current st)\n   in let st1 = advance st\n   in let from-unit = token-text (current st1)\n   in let st2 = advance (advance st1)\n   in let to-val = if is-done st2 then \"1\" else token-text (current st2)\n   in let st3 = if is-done st2 then st2 else advance st2\n   in let to-unit = if is-done st3 then from-unit else token-text (current st3)\n   in let factor = text-to-integer to-val / text-to-integer from-val\n   in deck-record (AnnotationNode { kind = \"conversion\", target = from-unit, body = integer-to-text factor & \" \" & to-unit })\n\n  empty-parse-document : DiagnosticBag -> Document\n  empty-parse-document (bag) =\n   deck-record (Document {\n    defs = [],\n    type-defs = [],\n    effect-defs = [],\n    class-defs = [],\n    instance-defs = [],\n    citations = [],\n    quotations = [],\n    trust-keys = [],\n    ground-effects = [],\n    chapter-title = \"\",\n    section-titles = [],\n    prose = \"\",\n    prose-blocks = [],\n    annotations = [],\n    parse-bag = bag\n   })\n\n  parse-top-level : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document\n  parse-top-level (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =\n   if deck-short-of (st.deck-ceiling) demand-parse-scratch-guard-band then empty-parse-document (st.bag)\n   else if is-done st then let prose-text = deck-record (text-concat-list (deck-record (__linked-list-to-list prose)))\n    in let hdr-len = list-length imports\n    in let floor = header-trust-floor imports 0 hdr-len (-1)\n    in let raw-quotes = filter-decl-kind imports decl-quote 0 hdr-len []\n    in let defs-list = deck-record (__linked-list-to-list defs)\n    in let type-defs-list = deck-record (__linked-list-to-list type-defs)\n    in let raw-blocks = deck-record (__linked-list-to-list blocks)\n    in deck-record (Document {\n    defs = defs-list,\n    type-defs = type-defs-list,\n    effect-defs = deck-record (__linked-list-to-list effect-defs),\n    class-defs = [],\n    instance-defs = [],\n    citations = deck-record (filter-decl-kind imports decl-cite 0 hdr-len []),\n    quotations = deck-record (stamp-trust-floor raw-quotes floor 0 (list-length raw-quotes) []),\n    trust-keys = deck-record (filter-decl-kind imports decl-trust-key 0 hdr-len []),\n    ground-effects = deck-record (grounds-strings imports 0 hdr-len []),\n    chapter-title = ch-title,\n    section-titles = deck-record (__linked-list-to-list sec-titles),\n    prose = prose-text,\n    prose-blocks = deck-record (anchor-prose-blocks raw-blocks defs-list type-defs-list),\n    annotations = deck-record (__linked-list-to-list anns),\n    parse-bag = st.bag\n   })\n   else if is-chapter-header st then let title = extract-header-title st\n     in let pr = collect-prose-with-text (skip-to-next-line st) prose blocks\n     in parse-top-level defs type-defs effect-defs imports title sec-titles (pr.lines) (pr.blocks) anns (pr.state)\n   else if is-section-header st then let title = extract-header-title st\n     in let pr = collect-prose-with-text (skip-to-next-line st) prose blocks\n     in parse-top-level defs type-defs effect-defs imports ch-title (__linked-list-push sec-titles title) (pr.lines) (pr.blocks) anns (pr.state)\n   else if is-page-marker st then parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-to-next-line st)\n   else if is-cites-keyword (current-kind st) then let (cite-imports, cite-st) = parse-citations st ch-title []\n     in parse-top-level defs type-defs effect-defs (deck-record (imports & cite-imports)) ch-title sec-titles prose blocks anns cite-st\n   else if is-quotes-keyword (current-kind st) then let (q, q-st) = parse-quotation st ch-title\n     in parse-top-level defs type-defs effect-defs (deck-record (imports & [q])) ch-title sec-titles prose blocks anns q-st\n   else if is-trusting-keyword (current-kind st) then let (t, t-st) = parse-trusting st ch-title\n     in parse-top-level defs type-defs effect-defs (deck-record (imports & [t])) ch-title sec-titles prose blocks anns t-st\n   else if is-grounds-keyword (current-kind st) then let (g, g-st) = parse-grounds (current st) (advance st) ch-title []\n     in parse-top-level defs type-defs effect-defs (deck-record (imports & g)) ch-title sec-titles prose blocks anns g-st\n   else if is-effect-keyword (current-kind st) then parse-top-level-effect defs type-defs effect-defs imports ch-title sec-titles prose blocks anns st\n   else if is-class-keyword (current-kind st) then let st-c1 = advance st\n    in let st-c2 = advance st-c1\n    in let st-c2b = if is-ident (current-kind st-c2) & is-fat-arrow (peek-kind st-c2 1)\n      then advance (advance (advance st-c2))\n      else st-c2\n    in let st-c3 = if is-where-keyword (current-kind st-c2b) then skip-newlines (advance st-c2b) else st-c2b\n    in let (_, ops-st) = parse-effect-ops st-c3 []\n    in parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines ops-st)\n   else if is-instance-keyword (current-kind st) then let st-i1 = advance st\n    in let st-i2 = advance st-i1\n    in let st-i3 = advance st-i2\n    in let st-i4 = if is-where-keyword (current-kind st-i3) then skip-newlines (advance st-i3) else st-i3\n    in parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-body-lines st-i4)\n   else if is-claim-keyword (current-kind st) then parse-claim-arm defs type-defs effect-defs imports ch-title sec-titles prose blocks anns st\n   else if is-proof-keyword (current-kind st) then try-top-level-def defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (advance st)\n   else if is-punctual-keyword (current-kind st) then let pst = advance st\n     in if is-done pst then parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns pst\n     else if current-kind pst == IntegerLiteral then let budget-text = token-text (current pst)\n       in let pst2 = advance pst\n       in let pname = if is-done pst2 then \"\" else token-text (current pst2)\n       in let pann = deck-record (AnnotationNode { kind = \"hard-realtime\", target = pname, body = budget-text })\n       in try-top-level-def defs type-defs effect-defs imports ch-title sec-titles prose blocks (__linked-list-push anns pann) pst2\n     else let pname = token-text (current pst)\n     in let pann = deck-record (AnnotationNode { kind = \"hard-realtime\", target = pname, body = \"\" })\n     in try-top-level-def defs type-defs effect-defs imports ch-title sec-titles prose blocks (__linked-list-push anns pann) pst\n   else if is-conversion-decl st then let conv-ann = parse-conversion-decl st\n     in parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks (__linked-list-push anns conv-ann) (skip-to-next-line st)\n   else if is-prose-line st then let pr = collect-prose-with-text st prose blocks\n     in parse-top-level defs type-defs effect-defs imports ch-title sec-titles (pr.lines) (pr.blocks) anns (pr.state)\n   else if (current st).column > 3 then parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-to-next-line st)\n   else try-top-level-type-def defs type-defs effect-defs imports ch-title sec-titles prose blocks anns st\n\n  parse-top-level-effect : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document\n  parse-top-level-effect (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =\n   let st1 = advance st\n   in let name-tok = current st1\n   in let st2 = advance st1\n   in let st3 = if is-where-keyword (current-kind st2) then skip-newlines (advance st2) else st2\n   in let (ops-list, ops-st) = parse-effect-ops st3 []\n   in let ed = deck-record (EffectDef {\n        name = name-tok,\n        ops = ops-list\n       })\n   in parse-top-level defs type-defs (__linked-list-push effect-defs ed) imports ch-title sec-titles prose blocks anns (skip-newlines ops-st)\n\n  parse-effect-ops : ParseState, LinkedList EffectOpDef -> (List EffectOpDef, ParseState)\n  parse-effect-ops (st) (acc) =\n   if is-ident (current-kind st) then if is-colon (peek-kind st 1) then let op-tok = current st\n      in let st2 = advance (advance st)\n      in let type-result = parse-type st2\n      in when type-result\n         is TypeOk (ty) (st3) ->\n          let op = deck-record (EffectOpDef {\n           name = op-tok,\n           type-expr = ty\n          })\n      in parse-effect-ops (skip-newlines st3) (__linked-list-push acc op)\n     else (deck-record (__linked-list-to-list acc), st)\n    else (deck-record (__linked-list-to-list acc), st)\n\n  ClassDefsResult = record { class-defs : List ClassDef, instance-defs : List InstanceDef }\n\n  empty-class-instance-scan : ClassDefsResult\n  empty-class-instance-scan = ClassDefsResult { class-defs = [], instance-defs = [] }\n\n  scan-class-instance-defs : ParseState, LinkedList ClassDef, LinkedList InstanceDef -> ClassDefsResult\n  scan-class-instance-defs (st) (cacc) (iacc) =\n   if is-done st then ClassDefsResult {\n    class-defs = deck-record (__linked-list-to-list cacc),\n    instance-defs = deck-record (__linked-list-to-list iacc)\n   }\n   else if is-class-keyword (current-kind st) & (is-ident (peek-kind st 1) | is-type-ident (peek-kind st 1)) then let st1 = advance st\n    in let name-tok = current st1\n    in let st2 = advance st1\n    in if is-ident (current-kind st2) & is-fat-arrow (peek-kind st2 1) then\n      let super-name = token-text name-tok\n      in let st3 = advance (advance st2)\n      in let real-name = current st3\n      in let st4 = advance st3\n      in let st5 = if is-where-keyword (current-kind st4) then skip-newlines (advance st4) else st4\n      in let (ops-list, ops-st) = parse-effect-ops st5 []\n      in let cd = deck-record (ClassDef { name = real-name, methods = ops-list, superclass = super-name })\n      in scan-class-instance-defs (skip-newlines ops-st) (__linked-list-push cacc cd) iacc\n    else let st3 = if is-where-keyword (current-kind st2) then skip-newlines (advance st2) else st2\n    in let (ops-list, ops-st) = parse-effect-ops st3 []\n    in let cd = deck-record (ClassDef { name = name-tok, methods = ops-list, superclass = \"\" })\n    in scan-class-instance-defs (skip-newlines ops-st) (__linked-list-push cacc cd) iacc\n   else if is-instance-keyword (current-kind st) & is-type-ident (peek-kind st 1) then let st1 = advance st\n    in let class-tok = current st1\n    in let st2 = advance st1\n    in let (it-head, it-st) = parse-instance-type-head st2\n    in let st4 = if is-where-keyword (current-kind it-st) then skip-newlines (advance it-st) else it-st\n    in let (method-defs, methods-st) = parse-instance-methods st4 []\n    in let id = deck-record (InstanceDef { class-name = class-tok, type-name = it-head, methods = method-defs })\n    in scan-class-instance-defs (skip-newlines methods-st) cacc (__linked-list-push iacc id)\n   else scan-class-instance-defs (advance st) cacc iacc\n\n  parse-instance-type-head : ParseState -> (Token, ParseState)\n  parse-instance-type-head (st) =\n   if is-left-paren (current-kind st)\n    then let st1 = advance st\n     in (current st1, skip-to-close-paren (advance st1) 1)\n   else (current st, advance st)\n\n  skip-to-close-paren : ParseState, Integer -> ParseState\n  skip-to-close-paren (st) (depth) =\n   if depth <= 0 then st\n   else when (current-kind st)\n    is EndOfFile -> st\n    is otherwise ->\n     if is-left-paren (current-kind st) then skip-to-close-paren (advance st) (depth + 1)\n     else if is-right-paren (current-kind st) then skip-to-close-paren (advance st) (depth - 1)\n     else skip-to-close-paren (advance st) depth\n\n  finish-instance-methods : LinkedList InstanceMethodDef, ParseState -> (List InstanceMethodDef, ParseState)\n  finish-instance-methods (acc) (st) =\n   (deck-record (__linked-list-to-list acc), st)\n\n  parse-instance-methods : ParseState, LinkedList InstanceMethodDef -> (List InstanceMethodDef, ParseState)\n  parse-instance-methods (st) (acc) =\n   if is-ident (current-kind st) then let name-tok = current st\n    in let st2 = advance st\n    in let (inst-params, params-st) = parse-instance-params st2 []\n    in if is-equals (current-kind params-st)\n     then let st3 = skip-newlines (advance params-st)\n      in let expr-result = parse-expr st3\n      in when expr-result\n       is ExprOk (body) (st4) ->\n        let md = deck-record (InstanceMethodDef { name = name-tok, params = inst-params, body = body })\n        in parse-instance-methods (skip-newlines st4) (__linked-list-push acc md)\n     else finish-instance-methods acc st\n   else finish-instance-methods acc st\n\n  parse-instance-params : ParseState, LinkedList Token -> (List Token, ParseState)\n  parse-instance-params (st) (acc) =\n   if is-left-paren (current-kind st) then let st2 = advance st\n    in let p = current st2\n    in let st3 = advance st2\n    in let st4 = if is-right-paren (current-kind st3) then advance st3 else st3\n    in parse-instance-params st4 (__linked-list-push acc p)\n   else (deck-record (__linked-list-to-list acc), st)\n\n  try-top-level-type-def : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document\n  try-top-level-type-def (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =\n   let td-result = parse-type-def st\n   in let st2 = td-result.state\n   in when td-result.maybe-type-def\n    is Just (td) ->\n     parse-top-level defs (__linked-list-push type-defs td) effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines st2)\n    is None ->\n     try-top-level-def defs type-defs effect-defs imports ch-title sec-titles prose blocks anns st\n\n  try-top-level-def : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document\n  try-top-level-def (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =\n   let def-result = parse-definition st\n   in let st2 = def-result.state\n   in when def-result.maybe-def\n    is Just (d) ->\n     let tagged = deck-record (Def {\n      name = d.name,\n      params = d.params,\n      ann = d.ann,\n      body = d.body,\n      chapter-slug = ch-title\n     })\n     in parse-top-level (__linked-list-push defs tagged) type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines st2)\n    is None ->\n     parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines (advance st2))\n\n  parse-claim-arm : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document\n  parse-claim-arm (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =\n   if is-simple-claim st then parse-simple-claim defs type-defs effect-defs imports ch-title sec-titles prose blocks anns st\n   else let claim-ann = parse-claim-annotation st\n    in parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks (__linked-list-push anns claim-ann) (skip-to-next-line st)\n\n  parse-simple-claim : LinkedList Def, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, LinkedList Text, LinkedList Text, LinkedList ProseBlock, LinkedList AnnotationNode, ParseState -> Document\n  parse-simple-claim (defs) (type-defs) (effect-defs) (imports) (ch-title) (sec-titles) (prose) (blocks) (anns) (st) =\n   let name-tok = current (advance st)\n   in when parse-type-annotation (advance st)\n    is TypeOk (prop-ty) (st4) ->\n     let ann = deck-record ([deck-record (TypeAnn { name = name-tok, type-expr = prop-ty })])\n     in let st5 = skip-newlines st4\n     in let st6 = if is-proof-keyword (current-kind st5) then advance st5 else st5\n     in let proof-name = current st6\n     in let dr = parse-def-params-then ann proof-name [] (advance st6)\n     in when dr.maybe-def\n      is Just (d) ->\n       let tagged = deck-record (Def {\n        name = d.name,\n        params = d.params,\n        ann = d.ann,\n        body = d.body,\n        chapter-slug = ch-title\n       })\n       in parse-top-level (__linked-list-push defs tagged) type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines (dr.state))\n      is None ->\n       parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-newlines (advance (dr.state)))\n    is otherwise ->\n     parse-top-level defs type-defs effect-defs imports ch-title sec-titles prose blocks anns (skip-to-next-line st)\n\nSection: Prose Anchoring\n\n  template-anchor : ProseTemplate -> Text\n  template-anchor (t) =\n   when t\n    is PtRecordTemplate (n) -> n\n    is PtVariantTemplate (n) -> n\n    is PtFunctionTemplate (n) -> n\n    is PtNoTemplate | PtConstraintTemplate | PtProofTemplate | PtProcedureTemplate | PtQuantifiedTemplate -> \"\"\n\n  def-name-offset : List Def, Integer -> Integer\n  def-name-offset (defs) (i) =\n   let tok = (list-at defs i).name\n   in tok.offset\n\n  type-def-name-offset : List TypeDef, Integer -> Integer\n  type-def-name-offset (type-defs) (i) =\n   let tok = (list-at type-defs i).name\n   in tok.offset\n\n  advance-defs-past : List Def, Integer, Integer, Integer -> Integer\n  advance-defs-past (defs) (di) (dlen) (off) =\n   if di >= dlen then di\n   else if def-name-offset defs di < off then advance-defs-past defs (di + 1) dlen off\n   else di\n\n  advance-type-defs-past : List TypeDef, Integer, Integer, Integer -> Integer\n  advance-type-defs-past (type-defs) (ti) (tlen) (off) =\n   if ti >= tlen then ti\n   else if type-def-name-offset type-defs ti < off then advance-type-defs-past type-defs (ti + 1) tlen off\n   else ti\n\n  following-def-name : List Def, List TypeDef, Integer, Integer, Integer, Integer -> Text\n  following-def-name (defs) (type-defs) (di) (ti) (dlen) (tlen) =\n   if di >= dlen then if ti >= tlen then \"\" else token-text ((list-at type-defs ti).name)\n   else if ti >= tlen then token-text ((list-at defs di).name)\n   else if def-name-offset defs di <= type-def-name-offset type-defs ti then token-text ((list-at defs di).name)\n   else token-text ((list-at type-defs ti).name)\n\n  anchor-one-block : ProseBlock, List Def, List TypeDef, Integer, Integer, Integer, Integer -> ProseBlock\n  anchor-one-block (block) (defs) (type-defs) (di) (ti) (dlen) (tlen) =\n   let claimed = template-anchor (block.template)\n   in let name = if text-length claimed > 0 then claimed\n      else following-def-name defs type-defs di ti dlen tlen\n   in deck-record (ProseBlock {\n    text = block.text,\n    transition = block.transition,\n    template = block.template,\n    anchor = name,\n    offset = block.offset\n   })\n\n  anchor-blocks-loop : List ProseBlock, List Def, List TypeDef, Integer, Integer, Integer, Integer, Integer, Integer, List ProseBlock -> List ProseBlock\n  anchor-blocks-loop (blocks) (defs) (type-defs) (i) (di) (ti) (blen) (dlen) (tlen) (acc) =\n   if i >= blen then acc\n   else let block = list-at blocks i\n   in let di2 = advance-defs-past defs di dlen (block.offset)\n   in let ti2 = advance-type-defs-past type-defs ti tlen (block.offset)\n   in anchor-blocks-loop blocks defs type-defs (i + 1) di2 ti2 blen dlen tlen (list-push acc (anchor-one-block block defs type-defs di2 ti2 dlen tlen))\n\n  anchor-prose-blocks : List ProseBlock, List Def, List TypeDef -> List ProseBlock\n  anchor-prose-blocks (blocks) (defs) (type-defs) =\n   anchor-blocks-loop blocks defs type-defs 0 0 0 (list-length blocks) (list-length defs) (list-length type-defs) []\n\nSection: Prose-Notation Consistency\n\n  find-type-def-named : List TypeDef, Text, Integer -> Integer\n  find-type-def-named (type-defs) (name) (i) =\n   if i >= list-length type-defs then 0 - 1\n   else if token-text ((list-at type-defs i).name) == name then i\n   else find-type-def-named type-defs name (i + 1)\n\n  check-prose-type-name : Text, List TypeDef, Integer between 0 and 65535, Text, List Diagnostic -> List Diagnostic\n  check-prose-type-name (template-name) (type-defs) (diag-code) (kind) (acc) =\n   let found = find-type-def-named type-defs template-name 0\n   in if found < 0 then list-push acc (make-warning diag-code (\"Prose declares \" & kind & \" '\" & template-name & \"' but no type definition with that name exists\") synthetic-span)\n   else acc\n\n  parser-find-def-index : List Def, Text, Integer, Integer -> Integer\n  parser-find-def-index (defs) (name) (i) (len) =\n   if i >= len then (-1)\n   else if token-text ((list-at defs i).name) == name then i\n   else parser-find-def-index defs name (i + 1) len\n\n  effect-op-declares : List EffectOpDef, Text, Integer, Integer -> Boolean\n  effect-op-declares (ops) (name) (i) (len) =\n   if i >= len then False\n   else if token-text ((list-at ops i).name) == name then True\n   else effect-op-declares ops name (i + 1) len\n\n  effect-defs-declare : List EffectDef, Text, Integer, Integer -> Boolean\n  effect-defs-declare (eds) (name) (i) (len) =\n   if i >= len then False\n   else let ops = (list-at eds i).ops\n   in if effect-op-declares ops name 0 (list-length ops) then True\n      else effect-defs-declare eds name (i + 1) len\n\n  check-prose-function : Text, List Def, List EffectDef, List Diagnostic -> List Diagnostic\n  check-prose-function (template-name) (defs) (effect-defs) (acc) =\n   if list-length defs == 0 then acc\n   else if parser-find-def-index defs template-name 0 (list-length defs) >= 0 then acc\n      else if effect-defs-declare effect-defs template-name 0 (list-length effect-defs) then acc\n      else list-push acc (make-warning cdx-prose-function-name-mismatch (\"Prose declares function '\" & template-name & \"' but no definition of that name appears in this chapter\") synthetic-span)\n\n  extract-prose-params : Text, Integer, Integer, List Text -> List Text\n  extract-prose-params (line) (i) (len) (acc) =\n   if i >= len then acc\n   else if char-at line i == '(' then extract-prose-param-name line (i + 1) len acc\n   else extract-prose-params line (i + 1) len acc\n\n  extract-prose-param-name : Text, Integer, Integer, List Text -> List Text\n  extract-prose-param-name (line) (i) (len) (acc) =\n   if i >= len then acc\n   else if char-at line i == ')' then\n    let name = extract-prose-param-word line i (i - 1)\n    in extract-prose-params line (i + 1) len (if text-length name > 0 then list-push acc name else acc)\n   else if char-at line i == ':' then\n    let name = extract-prose-param-word line i (i - 1)\n    in let skip = prose-skip-close-paren line (i + 1) len\n    in extract-prose-params line (skip + 1) len (if text-length name > 0 then list-push acc name else acc)\n   else extract-prose-param-name line (i + 1) len acc\n\n  extract-prose-param-word : Text, Integer, Integer -> Text\n  extract-prose-param-word (line) (limit) (j) =\n   if j < 0 then \"\"\n   else if char-at line j == '(' then substring line (j + 1) (limit - j - 1)\n   else if char-at line j == ' ' then substring line (j + 1) (limit - j - 1)\n   else extract-prose-param-word line limit (j - 1)\n\n  prose-skip-close-paren : Text, Integer, Integer -> Integer\n  prose-skip-close-paren (line) (i) (len) =\n   if i >= len then len\n   else if char-at line i == ')' then i\n   else prose-skip-close-paren line (i + 1) len\n\n  check-prose-params : Text, List Text, List Def, List Diagnostic -> List Diagnostic\n  check-prose-params (template-name) (prose-params) (defs) (acc) =\n   if list-length defs == 0 then acc\n   else let idx = parser-find-def-index defs template-name 0 (list-length defs)\n   in if idx >= 0 then\n    let matched-def = list-at defs idx\n    in let def-name = token-text (matched-def.name)\n    in let def-params = matched-def.params\n    in let def-count = list-length def-params\n    in let prose-count = list-length prose-params\n    in if prose-count == 0 then acc\n       else if prose-count == def-count then check-prose-param-names prose-params def-params 0 def-count acc\n       else list-push acc (make-warning cdx-prose-parameter-mismatch (\"Prose declares \" & show prose-count & \" parameters but '\" & def-name & \"' has \" & show def-count) synthetic-span)\n      else acc\n\n  check-prose-param-names : List Text, List Token, Integer, Integer, List Diagnostic -> List Diagnostic\n  check-prose-param-names (prose-params) (def-params) (i) (len) (acc) =\n   if i >= len then acc\n   else let prose-name = list-at prose-params i\n   in let def-name = token-text (list-at def-params i)\n   in if prose-name == def-name then check-prose-param-names prose-params def-params (i + 1) len acc\n      else list-push (check-prose-param-names prose-params def-params (i + 1) len acc) (make-warning cdx-prose-parameter-mismatch (\"Prose parameter \" & show (i + 1) & \" is '\" & prose-name & \"' but notation has '\" & def-name & \"'\") synthetic-span)\n\n  check-prose-block-against-defs : ProseBlock, List Def, List TypeDef, List EffectDef, List Diagnostic -> List Diagnostic\n  check-prose-block-against-defs (block) (defs) (type-defs) (effect-defs) (acc) =\n   when (block.template)\n    is PtFunctionTemplate (fn) ->\n     let name-diags = check-prose-function (block.anchor) defs effect-defs acc\n     in let prose-params = extract-prose-params (block.text) 0 (text-length (block.text)) []\n     in check-prose-params (block.anchor) prose-params defs name-diags\n    is PtRecordTemplate (rn) -> check-prose-type-name (block.anchor) type-defs cdx-prose-record-field-mismatch \"record\" acc\n    is PtVariantTemplate (vn) -> check-prose-type-name (block.anchor) type-defs cdx-prose-variant-ctor-mismatch \"variant\" acc\n    is PtNoTemplate | PtConstraintTemplate | PtProofTemplate | PtProcedureTemplate | PtQuantifiedTemplate -> acc\n\n  check-prose-consistency : Document -> List Diagnostic\n  check-prose-consistency (doc) =\n   check-prose-blocks-loop (doc.prose-blocks) (doc.defs) (doc.type-defs) (doc.effect-defs) 0 (list-length (doc.prose-blocks)) []\n\n  check-prose-blocks-loop : List ProseBlock, List Def, List TypeDef, List EffectDef, Integer, Integer, List Diagnostic -> List Diagnostic\n  check-prose-blocks-loop (blocks) (defs) (type-defs) (effect-defs) (i) (len) (acc) =\n   if i >= len then acc\n   else let block = list-at blocks i\n   in check-prose-blocks-loop blocks defs type-defs effect-defs (i + 1) len (check-prose-block-against-defs block defs type-defs effect-defs acc)\n\nSection: Banned Word Enforcement\n\n  BannedWord = record {\n   word : Text,\n   substitute : Text\n  }\n\n  banned-words : List BannedWord = [\n   BannedWord { word = \" it \", substitute = \"the named value\" },\n   BannedWord { word = \" this \", substitute = \"the named value\" },\n   BannedWord { word = \" they \", substitute = \"the named collection\" },\n   BannedWord { word = \" some \", substitute = \"a quantifier (all, every, exactly one, ...)\" },\n   BannedWord { word = \" many \", substitute = \"a quantifier or explicit bound\" },\n   BannedWord { word = \" few \", substitute = \"a quantifier or explicit bound\" },\n   BannedWord { word = \" etc.\", substitute = \"exhaust the list or use a type\" },\n   BannedWord { word = \" etc \", substitute = \"exhaust the list or use a type\" },\n   BannedWord { word = \" so \", substitute = \"'therefore' or 'in order to'\" },\n   BannedWord { word = \" since \", substitute = \"'because' (causal) or 'after' (temporal)\" },\n   BannedWord { word = \" while \", substitute = \"'during' or 'at the same time as'\" },\n   BannedWord { word = \" may \", substitute = \"'can' (possibility) or 'is permitted to' (permission)\" },\n   BannedWord { word = \" might \", substitute = \"'can' (possibility) or 'is permitted to' (permission)\" },\n   BannedWord { word = \" should \", substitute = \"'must' (obligation) or 'is recommended to' (recommendation)\" }\n  ]\n\n  check-banned-word : Text, BannedWord -> Maybe Diagnostic\n  check-banned-word (line) (bw) =\n   if text-contains line (bw.word) then\n    Just (make-warning cdx-prose-banned-word (\"Banned word '\" & bw.word & \"' in load-bearing prose; use \" & bw.substitute) synthetic-span)\n   else None\n\n  check-banned-words-in-line : Text, List BannedWord, Integer, Integer, List Diagnostic -> List Diagnostic\n  check-banned-words-in-line (line) (words) (i) (len) (acc) =\n   if i >= len then acc\n   else let bw = list-at words i\n   in when check-banned-word line bw\n    is Just (d) -> check-banned-words-in-line line words (i + 1) len (list-push acc d)\n    is None -> check-banned-words-in-line line words (i + 1) len acc\n\n  check-banned-in-blocks : List ProseBlock, Integer, Integer, Boolean, List Diagnostic -> List Diagnostic\n  check-banned-in-blocks (blocks) (i) (len) (in-we-say) (acc) =\n   if i >= len then acc\n   else let block = list-at blocks i\n   in let now-in-we-say = when (block.transition) is PtWeSay | PtThisIsWritten -> True is PtNone -> in-we-say\n   in if now-in-we-say then let diags = check-banned-words-in-line (block.text) banned-words 0 (list-length banned-words) acc\n      in check-banned-in-blocks blocks (i + 1) len now-in-we-say diags\n      else check-banned-in-blocks blocks (i + 1) len now-in-we-say acc\n\n  check-prose-banned : Document -> List Diagnostic\n  check-prose-banned (doc) =\n   check-banned-in-blocks (doc.prose-blocks) 0 (list-length (doc.prose-blocks)) False []\n\nSection: Header Scanning (streaming)\n\n  scan-document : ParseState -> ScanResult\n  scan-document (st) =\n   let st2 = skip-newlines st\n   in let (imp-list, imp-st) = parse-citations st2 \"\" []\n   in scan-top-level [] [] [] imp-list \"\" \"\" [] [] imp-st\n\n  scan-top-level : LinkedList DefHeader, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, Text, LinkedList Text, LinkedList Text, ParseState -> ScanResult\n  scan-top-level (headers) (type-defs) (effect-defs) (imports) (cur-chap) (ch-title) (sec-titles) (chap-names) (st) =\n   if is-done st then deck-record (ScanResult {\n    type-defs = deck-record (__linked-list-to-list type-defs),\n    effect-defs = deck-record (__linked-list-to-list effect-defs),\n    class-defs = [],\n    instance-defs = [],\n    def-headers = deck-record (__linked-list-to-list headers),\n    citations = imports,\n    chapter-title = ch-title,\n    section-titles = deck-record (__linked-list-to-list sec-titles),\n    chapter-names = deck-record (__linked-list-to-list chap-names)\n   })\n   else if is-chapter-header st then let title = extract-header-title st\n     in scan-top-level headers type-defs effect-defs imports title title sec-titles (__linked-list-push chap-names title) (skip-prose-lines (skip-to-next-line st))\n   else if is-section-header st then let title = extract-header-title st\n     in scan-top-level headers type-defs effect-defs imports cur-chap ch-title (__linked-list-push sec-titles title) chap-names (skip-prose-lines (skip-to-next-line st))\n   else if is-page-marker st then scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-to-next-line st)\n   else if is-cites-keyword (current-kind st) then let (cite-imports, cite-st) = parse-citations st cur-chap []\n     in scan-top-level headers type-defs effect-defs (deck-record (imports & cite-imports)) cur-chap ch-title sec-titles chap-names cite-st\n   else if is-quotes-keyword (current-kind st) | is-trusting-keyword (current-kind st) | is-grounds-keyword (current-kind st) then scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-to-next-line st)\n   else if is-effect-keyword (current-kind st) then scan-top-level-effect headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names st\n   else if is-class-keyword (current-kind st) then let st-c1 = advance st\n    in let st-c2 = advance st-c1\n    in let st-c2b = if is-ident (current-kind st-c2) & is-fat-arrow (peek-kind st-c2 1)\n      then advance (advance (advance st-c2))\n      else st-c2\n    in let st-c3 = if is-where-keyword (current-kind st-c2b) then skip-newlines (advance st-c2b) else st-c2b\n    in let (_, ops-st) = parse-effect-ops st-c3 []\n    in scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-newlines ops-st)\n   else if is-instance-keyword (current-kind st) then let st-i1 = advance st\n    in let st-i2 = advance st-i1\n    in let st-i3 = advance st-i2\n    in let st-i4 = if is-where-keyword (current-kind st-i3) then skip-newlines (advance st-i3) else st-i3\n    in scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-body-lines st-i4)\n   else if is-prose-line st then scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-prose-lines st)\n   else if (current st).column > 3 then scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-to-next-line st)\n   else try-scan-type-def headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names st\n\n  scan-top-level-effect : LinkedList DefHeader, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, Text, LinkedList Text, LinkedList Text, ParseState -> ScanResult\n  scan-top-level-effect (headers) (type-defs) (effect-defs) (imports) (cur-chap) (ch-title) (sec-titles) (chap-names) (st) =\n   let st1 = advance st\n   in let name-tok = current st1\n   in let st2 = advance st1\n   in let st3 = if is-where-keyword (current-kind st2) then skip-newlines (advance st2) else st2\n   in let (ops-list, ops-st) = parse-effect-ops st3 []\n   in let ed = deck-record (EffectDef {\n        name = name-tok,\n        ops = ops-list\n       })\n   in scan-top-level headers type-defs (__linked-list-push effect-defs ed) imports cur-chap ch-title sec-titles chap-names (skip-newlines ops-st)\n\n  try-scan-type-def : LinkedList DefHeader, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, Text, LinkedList Text, LinkedList Text, ParseState -> ScanResult\n  try-scan-type-def (headers) (type-defs) (effect-defs) (imports) (cur-chap) (ch-title) (sec-titles) (chap-names) (st) =\n   let td-result = parse-type-def st\n   in let st2 = td-result.state\n   in when td-result.maybe-type-def\n    is Just (td) ->\n     scan-top-level headers (__linked-list-push type-defs td) effect-defs imports cur-chap ch-title sec-titles chap-names (skip-newlines st2)\n    is None ->\n     try-scan-def-header headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names st\n\n  try-scan-def-header : LinkedList DefHeader, LinkedList TypeDef, LinkedList EffectDef, List CitesDecl, Text, Text, LinkedList Text, LinkedList Text, ParseState -> ScanResult\n  try-scan-def-header (headers) (type-defs) (effect-defs) (imports) (cur-chap) (ch-title) (sec-titles) (chap-names) (st) =\n   let hdr-result = scan-definition cur-chap st\n   in let st2 = hdr-result.state\n   in when hdr-result.maybe-header\n    is Just (hdr) ->\n     scan-top-level (__linked-list-push headers hdr) type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-newlines st2)\n    is None ->\n     scan-top-level headers type-defs effect-defs imports cur-chap ch-title sec-titles chap-names (skip-newlines (advance st2))\n\n  scan-definition : Text, ParseState -> ScanDefResult\n  scan-definition (cur-chap) (st) =\n   if is-done st then ScanDefResult { maybe-header = None, state = st }\n   else if is-ident (current-kind st) then try-scan-def cur-chap st\n   else if is-type-ident (current-kind st) then try-scan-def cur-chap st\n     else ScanDefResult { maybe-header = None, state = st }\n\n  try-scan-def : Text, ParseState -> ScanDefResult\n  try-scan-def (cur-chap) (st) =\n   if is-colon (peek-kind st 1) then let first-name = current st\n     in let ann-result = parse-type-annotation st\n     in unwrap-type-for-scan cur-chap first-name ann-result\n    else scan-def-body-with-ann cur-chap [] st\n\n  unwrap-type-for-scan : Text, Token, ParseTypeResult -> ScanDefResult\n  unwrap-type-for-scan (cur-chap) (first-name) (r) =\n   when r\n    is TypeOk (ann-type) (st) ->\n     if is-equals (current-kind st) then\n      let ann = deck-record ([deck-record (TypeAnn {\n       name = first-name,\n       type-expr = ann-type\n      })])\n      in let st2 = advance st\n      in let st3 = skip-newlines st2\n      in let body-pos = st3.pos\n      in let st4 = skip-body-tokens st3 (first-name.column)\n      in ScanDefResult {\n          maybe-header = Just (deck-record (DefHeader {\n           name = first-name,\n           params = [],\n           ann = ann,\n           body-pos = body-pos,\n           chapter-slug = cur-chap\n          })),\n          state = st4\n         }\n     else\n      let name-tok = deck-record (Token {\n       kind = Identifier,\n       source = \"\",\n       offset = 0,\n       length = 0,\n       line = 0,\n       column = 0,\n       file-id = 0\n      })\n      in let ann = deck-record ([deck-record (TypeAnn {\n       name = name-tok,\n       type-expr = ann-type\n      })])\n      in let st2 = skip-newlines st\n      in scan-def-body-with-ann cur-chap ann st2\n\n  scan-def-body-with-ann : Text, List TypeAnn, ParseState -> ScanDefResult\n  scan-def-body-with-ann (cur-chap) (ann) (st) =\n   let name-tok = current st\n   in let st2 = advance st\n   in scan-def-params-then cur-chap ann name-tok [] st2\n\n  scan-def-params-then : Text, List TypeAnn, Token, LinkedList Token, ParseState -> ScanDefResult\n  scan-def-params-then (cur-chap) (ann) (name-tok) (acc) (st) =\n   if is-left-paren (current-kind st) then let st2 = advance st\n   in if is-ident (current-kind st2) then let param = current st2\n   in let st3 = advance st2\n   in let st4 = expect RightParen st3\n   in scan-def-params-then cur-chap ann name-tok (__linked-list-push acc param) st4\n      else finish-def-scan cur-chap ann name-tok (deck-record (__linked-list-to-list acc)) st\n    else finish-def-scan cur-chap ann name-tok (deck-record (__linked-list-to-list acc)) st\n\n  finish-def-scan : Text, List TypeAnn, Token, List Token, ParseState -> ScanDefResult\n  finish-def-scan (cur-chap) (ann) (name-tok) (params) (st) =\n   if is-equals (current-kind st) == False then ScanDefResult { maybe-header = None, state = st }\n   else let st2 = advance st\n   in let st3 = skip-newlines st2\n   in let body-pos = st3.pos\n   in let st4 = skip-body-tokens st3 (name-tok.column)\n   in ScanDefResult {\n       maybe-header = Just (deck-record (DefHeader {\n        name = name-tok,\n        params = params,\n        ann = ann,\n        body-pos = body-pos,\n        chapter-slug = cur-chap\n       })),\n       state = st4\n      }\n\n  skip-body-tokens : ParseState, Integer -> ParseState\n  skip-body-tokens (st) (name-col) =\n   if is-done st then st\n   else let tok = current st\n   in when tok.kind\n     is Newline | Indent | Dedent -> skip-body-tokens (advance st) name-col\n     is otherwise -> if tok.column <= name-col then st\n      else skip-body-tokens (advance st) name-col\n\nPage 1 of 3\n\n"

Section: Show Lists
  show-texts : List Text, Integer, Integer, Text -> [Console] Nothing
  show-texts (xs) (i) (len) (label) = act
    if i >= len then print-line-uni "."
    else act
      print-line-uni (label & " " & list-at xs i)
      show-texts xs (i + 1) len label
    end
  end

  show-defs : List Def, Integer, Integer -> [Console] Nothing
  show-defs (ds) (i) (len) = act
    if i >= len then print-line-uni "."
    else act
      let d = list-at ds i
      in print-line-uni ("def " & token-text (d.name)
           & " params " & show (list-length (d.params))
           & " anns " & show (list-length (d.ann))
           & " L" & show ((d.name).line) & "C" & show ((d.name).column)
           & " slug " & d.chapter-slug)
      show-defs ds (i + 1) len
    end
  end

  show-type-defs : List TypeDef, Integer, Integer -> [Console] Nothing
  show-type-defs (ts) (i) (len) = act
    if i >= len then print-line-uni "."
    else act
      let t = list-at ts i
      in print-line-uni ("type-def " & token-text (t.name))
      show-type-defs ts (i + 1) len
    end
  end

  show-diags : List Diagnostic, Integer, Integer -> [Console] Nothing
  show-diags (gs) (i) (len) = act
    if i >= len then print-line-uni "."
    else act
      let g = list-at gs i
      in print-line-uni ("diag " & show (g.code) & " sev " & show (g.severity)
           & " |" & g.message & "|")
      show-diags gs (i + 1) len
    end
  end

Section: Driver
  opening : [Console] Nothing = act
    let toks = tokenize subject-text 1
    in let doc = parse-document (make-parse-state (toks.tokens) subject-text) 0
    in act
      print-line-uni ("lex-tokens " & show (list-length (toks.tokens)))
      print-line-uni ("lex-errors " & show (list-length (toks.errors)))
      print-line-uni ("chapter |" & doc.chapter-title & "|")
      print-line-uni ("prose-len " & show (text-length (doc.prose)))
      print-line-uni ("defs " & show (list-length (doc.defs)))
      show-defs (doc.defs) 0 (list-length (doc.defs))
      print-line-uni ("type-defs " & show (list-length (doc.type-defs)))
      show-type-defs (doc.type-defs) 0 (list-length (doc.type-defs))
      print-line-uni ("effect-defs " & show (list-length (doc.effect-defs)))
      print-line-uni ("class-defs " & show (list-length (doc.class-defs)))
      print-line-uni ("instance-defs " & show (list-length (doc.instance-defs)))
      print-line-uni ("citations " & show (list-length (doc.citations)))
      print-line-uni ("quotations " & show (list-length (doc.quotations)))
      print-line-uni ("ground-effects " & show (list-length (doc.ground-effects)))
      print-line-uni ("sections " & show (list-length (doc.section-titles)))
      show-texts (doc.section-titles) 0 (list-length (doc.section-titles)) "section"
      print-line-uni ("prose-blocks " & show (list-length (doc.prose-blocks)))
      print-line-uni ("annotations " & show (list-length (doc.annotations)))
      print-line-uni ("parse-errors " & show ((doc.parse-bag).error-count))
      show-diags ((doc.parse-bag).diagnostics) 0 (list-length ((doc.parse-bag).diagnostics))
      print-line-uni "---"
    end
  end
