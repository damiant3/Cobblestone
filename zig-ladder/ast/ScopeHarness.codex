Chapter: ScopeHarness

Section: Subject
  subject-text : Text
  subject-text = "Chapter: Name Resolution\n  cites Codex chapter Phase Allocator (deck-record, deck-short-of)\n  cites Codex chapter Build Settings (max-recursion-depth, demand-scope-guard-band)\n\nSection: Scope\n A scope is two lists. `names` is the chapter-level set -- top-level\n defs + ctors + builtins -- built once before resolving expressions\n and never mutated per-def. `locals` is the per-def set -- function\n params, `let` bindings, lambda params, pattern vars. Splitting them\n prevents the big `names` list (~2000 entries in self-host) from being\n cloned on every local binding via `list-insert-at`: without the split,\n each def's first `scope-add` fell off heap-top and allocated a fresh\n 16 KB copy. With locals on their own list, the main `names` is never\n touched after chapter-scope construction.\n\n  mutable Scope = record {\n   names : SkipListText,\n   locals : SkipListText,\n   chapter-renames : List RenameEntry\n  }\n\n  empty-scope : Scope = Scope { names = skip-list-text-empty, locals = skip-list-text-empty, chapter-renames = [] }\n\n  scope-has : Scope, Text -> Boolean\n  scope-has (sc) (name) =\n   if skip-list-text-has (sc.locals) name then True\n   else let resolved = rename-lookup (sc.chapter-renames) name\n   in skip-list-text-has (sc.names) resolved\n\n  scope-add : Scope, Text -> Scope\n  scope-add (sc) (name) =\n   let __seq = sc.names = skip-list-text-insert (sc.names) name\n   in sc\n\n  scope-add-local : Scope, Text -> Scope\n  scope-add-local (sc) (name) =\n   let __seq = sc.locals = skip-list-text-insert (sc.locals) name\n   in sc\n\n  scope-fork : Scope -> Scope\n  scope-fork (sc) =\n   Scope { names = sc.names, locals = skip-list-text-clone (sc.locals), chapter-renames = sc.chapter-renames }\n\nSection: Built-in Names\n\n  builtin-names : List Text\n  builtin-names = let bs = builtins in builtin-names-from bs 0 (list-length bs) []\n\nSection: Name Classification\n  is-type-name : Text -> Boolean\n  is-type-name (name) =\n   if text-length name == 0 then False\n   else is-letter (char-at name 0) & is-upper-char (char-at name 0)\n\n  is-upper-char : Char -> Boolean\n  is-upper-char (c) =\n   let code = char-code c\n   in code >= char-code 'E' & code <= char-code 'Z'\n\nSection: Resolution Result\n  ResolveResult = record {\n   bag : DiagnosticBag,\n   top-level-names : SkipListText,\n   type-names : SkipListText,\n   ctor-names : List Text\n  }\n\nSection: Scope Results\n  ResolveScopeResult = record {\n   scope : Scope,\n   errors : List Diagnostic\n  }\n\n  PatResult = record {\n   scope : Scope,\n   seen : SkipListText,\n   errors : List Diagnostic\n  }\n\nSection: Collect Names\n  collect-top-level-names : List ADef, Integer, Integer, SkipListText, List Diagnostic -> CollectResult\n  collect-top-level-names (defs) (i) (len) (acc) (errs) =\n   if i == len then deck-record (CollectResult {\n    names = acc,\n    errors = errs\n   })\n   else let def = list-at defs i\n   in let name = def.name.value\n   in if skip-list-text-has acc name\n      then collect-top-level-names defs (i + 1) len acc (errs & [make-error cdx-duplicate-definition (\"Duplicate definition: \" & name) (def.span)])\n      else collect-top-level-names defs (i + 1) len (skip-list-text-insert acc name) errs\n\n  CollectResult = record {\n   names : SkipListText,\n   errors : List Diagnostic\n  }\n\n  collect-ctor-names : List ATypeDef, Integer, Integer, SkipListText, SkipListText, List Diagnostic -> CtorCollectResult\n  collect-ctor-names (type-defs) (i) (len) (type-acc) (ctor-acc) (errs) =\n   if i == len then deck-record (CtorCollectResult {\n    type-names = type-acc,\n    ctor-names = ctor-acc,\n    errors = errs\n   })\n   else let td = list-at type-defs i\n   in when td\n     is AVariantTypeDef (name) (params) (ctors) (s) ->\n      let dup-check = check-type-name-dup type-acc (name.value) s errs\n   in let ctor-result = collect-variant-ctors ctors 0 (list-length ctors) ctor-acc (dup-check.errors)\n   in collect-ctor-names type-defs (i + 1) len (dup-check.type-acc) (ctor-result.ctor-acc) (ctor-result.errors)\n     is ARecordTypeDef (name) (params) (fields) (is-mut) (s) ->\n      let dup-check = check-type-name-dup type-acc (name.value) s errs\n   in collect-ctor-names type-defs (i + 1) len (dup-check.type-acc) ctor-acc (dup-check.errors)\n     is AUnitTypeDef (name) (base) (s) ->\n      let dup-check = check-type-name-dup type-acc (name.value) s errs\n   in let unit-ctor-acc = skip-list-text-insert ctor-acc (name.value)\n   in collect-ctor-names type-defs (i + 1) len (dup-check.type-acc) unit-ctor-acc (dup-check.errors)\n\n  CtorCollectResult = record {\n   type-names : SkipListText,\n   ctor-names : SkipListText,\n   errors : List Diagnostic\n  }\n\n  count-typecheck-units : List ATypeDef, Integer, Integer, Integer -> Integer\n  count-typecheck-units (tds) (i) (n) (acc) =\n   if i == n then acc\n   else let td = list-at tds i\n   in let c = when td\n      is AVariantTypeDef (name) (params) (ctors) (s) -> list-length ctors\n      is ARecordTypeDef (name) (params) (fields) (is-mut) (s) -> 1\n      is AUnitTypeDef (name) (base) (s) -> 1\n   in count-typecheck-units tds (i + 1) n (acc + c)\n\n  TypeNameDupResult = record {\n   type-acc : SkipListText,\n   errors : List Diagnostic\n  }\n\n  check-type-name-dup : SkipListText, Text, SourceSpan, List Diagnostic -> TypeNameDupResult\n  check-type-name-dup (type-acc) (name) (span) (errs) =\n   if skip-list-text-has type-acc name then deck-record (TypeNameDupResult {\n    type-acc = type-acc,\n    errors = errs & [make-error cdx-duplicate-definition (\"Duplicate type definition: '\" & name & \"' is already defined\") span]\n   })\n   else deck-record (TypeNameDupResult {\n    type-acc = skip-list-text-insert type-acc name,\n    errors = errs\n   })\n\n  VariantCtorResult = record {\n   ctor-acc : SkipListText,\n   errors : List Diagnostic\n  }\n\n  collect-variant-ctors : List AVariantCtorDef, Integer, Integer, SkipListText, List Diagnostic -> VariantCtorResult\n  collect-variant-ctors (ctors) (i) (len) (acc) (errs) =\n   if i == len then deck-record (VariantCtorResult { ctor-acc = acc, errors = errs })\n   else let c = list-at ctors i\n   in let name = c.name.value\n   in if skip-list-text-has acc name\n      then collect-variant-ctors ctors (i + 1) len acc (errs & [make-error cdx-duplicate-definition (\"Duplicate constructor: '\" & name & \"' is already defined\") (c.span)])\n      else collect-variant-ctors ctors (i + 1) len (skip-list-text-insert acc name) errs\n\nSection: Collect Effect Op Names\n  EffectOpCollectResult = record {\n   op-names : SkipListText,\n   errors : List Diagnostic\n  }\n\n  collect-effect-op-names : List AEffectDef, SkipListText, SkipListText, Integer, Integer, SkipListText, List Diagnostic -> EffectOpCollectResult\n  collect-effect-op-names (effs) (top-names) (ctor-names) (i) (len) (op-acc) (errs) =\n   if i == len then deck-record (EffectOpCollectResult { op-names = op-acc, errors = errs })\n   else let eff = list-at effs i\n   in let after = collect-ops-of-effect (eff.ops) top-names ctor-names 0 (list-length (eff.ops)) op-acc errs\n   in collect-effect-op-names effs top-names ctor-names (i + 1) len (after.op-names) (after.errors)\n\n  collect-ops-of-effect : List AEffectOpDef, SkipListText, SkipListText, Integer, Integer, SkipListText, List Diagnostic -> EffectOpCollectResult\n  collect-ops-of-effect (ops) (top-names) (ctor-names) (i) (len) (op-acc) (errs) =\n   if i == len then deck-record (EffectOpCollectResult { op-names = op-acc, errors = errs })\n   else let op = list-at ops i\n   in let name = op.name.value\n   in let op-is-dup = skip-list-text-has op-acc name\n   in let collides = op-is-dup | skip-list-text-has top-names name | skip-list-text-has ctor-names name\n   in let new-acc = if op-is-dup then op-acc else skip-list-text-insert op-acc name\n   in let new-errs = if collides then errs & [make-error cdx-duplicate-definition (\"Effect operation '\" & name & \"' conflicts with existing name\") (op.span)] else errs\n   in collect-ops-of-effect ops top-names ctor-names (i + 1) len new-acc new-errs\n\nSection: Build Initial Scope\n  build-all-names-scope : SkipListText, SkipListText, List Text -> Scope\n  build-all-names-scope (top-names) (ctor-names) (builtins) =\n   let top-list = skip-list-text-to-list top-names\n   in let sc = add-names-to-scope empty-scope top-list 0 (list-length top-list)\n   in let ctor-list = skip-list-text-to-list ctor-names\n   in let sc2 = add-names-to-scope sc ctor-list 0 (list-length ctor-list)\n   in add-names-to-scope sc2 builtins 0 (list-length builtins)\n\n  add-names-to-scope : Scope, List Text, Integer, Integer -> Scope\n  add-names-to-scope (sc) (names) (i) (len) =\n   if i == len then sc\n   else add-names-to-scope (scope-add sc (list-at names i)) names (i + 1) len\n\nSection: Resolve Expressions\n  resolve-expr : Scope, AExpr -> List Diagnostic\n  resolve-expr (sc) (expr) = resolve-expr-at sc expr 0\n\n  resolve-expr-at : Scope, AExpr, Integer -> List Diagnostic\n  resolve-expr-at (sc) (expr) (depth) =\n   if depth >= max-recursion-depth then [make-error cdx-resource-exhausted (\"compiler resource exhausted in name-resolver.resolve-expr (budget \" & integer-to-text max-recursion-depth & \")\") (aexpr-span expr)]\n   else when expr\n    is ALitExpr (val) (kind) (s) -> []\n    is ANameExpr (name) (s) ->\n     if scope-has sc (name.value) | is-type-name (name.value) then []\n     else [make-error cdx-undefined-name (\"Undefined name: \" & name.value) s]\n    is ABinaryExpr (left) (op) (right) (s) ->\n     resolve-expr-at sc left (depth + 1) & resolve-expr-at sc right (depth + 1)\n    is AUnaryExpr (operand) (s) -> resolve-expr-at sc operand (depth + 1)\n    is AApplyExpr (func) (arg) (s) ->\n     resolve-expr-at sc func (depth + 1) & resolve-expr-at sc arg (depth + 1)\n    is AIfExpr (cond) (then-e) (else-e) (s) ->\n     resolve-expr-at sc cond (depth + 1) & resolve-expr-at sc then-e (depth + 1) & resolve-expr-at sc else-e (depth + 1)\n    is ALetExpr (bindings) (body) (s) ->\n     resolve-let (scope-fork sc) bindings body\n    is ALambdaExpr (params) (body) (s) ->\n     let param-result = add-lambda-params sc params 0 (list-length params) s skip-list-text-empty []\n     in param-result.errors & resolve-expr-at (param-result.scope) body (depth + 1)\n    is AMatchExpr (scrutinee) (arms) (s) ->\n     resolve-expr-at sc scrutinee (depth + 1) & resolve-match-arms sc arms 0 (list-length arms) []\n    is AListExpr (elems) (s) ->\n     resolve-list-elems sc elems 0 (list-length elems) []\n    is ARecordExpr (name) (fields) (s) ->\n     resolve-record-fields sc fields 0 (list-length fields) []\n    is AFieldAccess (obj) (field) (s) -> resolve-expr-at sc obj (depth + 1)\n    is AActExpr (stmts) (s) -> resolve-act-stmts (scope-fork sc) stmts 0 (list-length stmts) skip-list-text-empty []\n    is AHandleExpr (eff) (body) (clauses) (s) ->\n     resolve-expr-at sc body (depth + 1) & resolve-handle-clauses sc clauses 0 (list-length clauses) []\n    is AWithTimeoutExpr (timeout) (effs) (scopes) (body) (s) ->\n     resolve-expr-at sc body (depth + 1)\n    is ATryExpr (max) (body) (fb) (fail) (s) ->\n     resolve-try-region sc body & resolve-try-region sc fb & resolve-try-region sc fail\n    is AFieldAssignExpr (rec) (field) (val) (s) ->\n     resolve-expr-at sc rec (depth + 1) & resolve-expr-at sc val (depth + 1)\n    is ALazyExpr (inner) (s) -> resolve-expr-at sc inner (depth + 1)\n    is AErrorExpr (msg) (s) -> []\n    is AInductionExpr (scrut) (arms) (s) ->\n     let sc2 = when scrut is ANameExpr (nm) (ss) -> scope-add-local (scope-fork sc) (nm.value) is otherwise -> sc\n     in resolve-match-arms sc2 arms 0 (list-length arms) []\n\n  resolve-try-region : Scope, List AActStmt -> List Diagnostic\n  resolve-try-region (sc) (stmts) =\n   resolve-act-stmts (scope-fork sc) stmts 0 (list-length stmts) skip-list-text-empty []\n\n  resolve-handle-clauses : Scope, List AHandleClause, Integer, Integer, List Diagnostic -> List Diagnostic\n  resolve-handle-clauses (sc) (clauses) (i) (len) (errs) =\n   if i == len then errs\n   else let c = list-at clauses i\n   in let clause-scope = scope-fork sc\n   in let sc2 = scope-add-local clause-scope (c.resume-name.value)\n   in let resume-seen = skip-list-text-insert skip-list-text-empty (c.resume-name.value)\n   in let param-result = scope-add-clause-params sc2 (c.params) 0 (list-length (c.params)) (c.span) resume-seen []\n   in let clause-errs = resolve-expr (param-result.scope) (c.body)\n   in resolve-handle-clauses sc clauses (i + 1) len (errs & param-result.errors & clause-errs)\n\n  scope-add-clause-params : Scope, List Name, Integer, Integer, SourceSpan, SkipListText, List Diagnostic -> ResolveScopeResult\n  scope-add-clause-params (sc) (ps) (i) (len) (clause-span) (seen) (errs) =\n   if i >= len then deck-record (ResolveScopeResult { scope = sc, errors = errs })\n   else let name = (list-at ps i).value\n   in if skip-list-text-has seen name\n      then scope-add-clause-params sc ps (i + 1) len clause-span seen (errs & [make-error cdx-duplicate-definition (\"Duplicate parameter: '\" & name & \"'\") clause-span])\n      else scope-add-clause-params (scope-add-local sc name) ps (i + 1) len clause-span (skip-list-text-insert seen name) errs\n\nSection: Resolve Let\n\n  resolve-let-binds : Scope, List ALetBind, Integer, Integer, SkipListText, List Diagnostic -> List Diagnostic\n  resolve-let-binds (sc) (bindings) (i) (len) (seen) (errs) =\n   if i == len then errs\n   else let b = list-at bindings i\n   in let name = b.name.value\n   in let bind-errs = resolve-expr sc (b.value)\n   in let dup-errs = if skip-list-text-has seen name then [make-error cdx-duplicate-definition (\"Duplicate binding: '\" & name & \"'\") (b.span)] else []\n   in let sc2 = scope-add-local sc name\n   in resolve-let-binds sc2 bindings (i + 1) len (skip-list-text-insert seen name) (errs & bind-errs & dup-errs)\n\n  resolve-let : Scope, List ALetBind, AExpr -> List Diagnostic\n  resolve-let (sc) (bindings) (body) =\n   let bind-errs = resolve-let-binds sc bindings 0 (list-length bindings) skip-list-text-empty []\n   in bind-errs & resolve-expr sc body\n\nSection: Resolve Lambda Parameters\n  add-lambda-params : Scope, List Name, Integer, Integer, SourceSpan, SkipListText, List Diagnostic -> ResolveScopeResult\n  add-lambda-params (sc) (params) (i) (len) (lam-span) (seen) (errs) =\n   if i == len then deck-record (ResolveScopeResult { scope = sc, errors = errs })\n   else let name = (list-at params i).value\n   in if skip-list-text-has seen name\n      then add-lambda-params sc params (i + 1) len lam-span seen (errs & [make-error cdx-duplicate-definition (\"Duplicate parameter: '\" & name & \"'\") lam-span])\n      else add-lambda-params (scope-add-local sc name) params (i + 1) len lam-span (skip-list-text-insert seen name) errs\n\nSection: Resolve Match Arms\n  resolve-match-arms : Scope, List AMatchArm, Integer, Integer, List Diagnostic -> List Diagnostic\n  resolve-match-arms (sc) (arms) (i) (len) (errs) =\n   if i == len then errs\n   else let arm = list-at arms i\n   in let arm-scope = scope-fork sc\n   in let pat-result = collect-pattern-names arm-scope (arm.pattern)\n   in let guard-errs = resolve-expr (pat-result.scope) (arm.guard)\n   in let arm-errs = resolve-expr (pat-result.scope) (arm.body)\n   in resolve-match-arms sc arms (i + 1) len (errs & pat-result.errors & guard-errs & arm-errs)\n\n  collect-pattern-names : Scope, APat -> ResolveScopeResult\n  collect-pattern-names (sc) (pat) =\n   let pr = collect-pattern-names-at sc pat 0 skip-list-text-empty []\n   in deck-record (ResolveScopeResult { scope = pr.scope, errors = pr.errors })\n\n  collect-pattern-names-at : Scope, APat, Integer, SkipListText, List Diagnostic -> PatResult\n  collect-pattern-names-at (sc) (pat) (depth) (seen) (errs) =\n   if depth >= max-recursion-depth then deck-record (PatResult { scope = sc, seen = seen, errors = errs })\n   else when pat\n    is AVarPat (name) (s) ->\n     if skip-list-text-has seen (name.value)\n     then deck-record (PatResult { scope = sc, seen = seen, errors = errs & [make-error cdx-duplicate-definition (\"Duplicate pattern variable: '\" & name.value & \"'\") s] })\n     else deck-record (PatResult { scope = scope-add-local sc (name.value), seen = skip-list-text-insert seen (name.value), errors = errs })\n    is ACtorPat (name) (subs) (s) -> collect-ctor-pat-names sc subs 0 (list-length subs) (depth + 1) seen errs\n    is AVecPat (subs) (s) -> collect-ctor-pat-names sc subs 0 (list-length subs) (depth + 1) seen errs\n    is ALitPat (val) (kind) (s) | AWildPat (s) -> deck-record (PatResult { scope = sc, seen = seen, errors = errs })\n\n  collect-ctor-pat-names : Scope, List APat, Integer, Integer, Integer, SkipListText, List Diagnostic -> PatResult\n  collect-ctor-pat-names (sc) (subs) (i) (len) (depth) (seen) (errs) =\n   if i == len then deck-record (PatResult { scope = sc, seen = seen, errors = errs })\n   else let sub = list-at subs i\n   in let result = collect-pattern-names-at sc sub depth seen errs\n   in collect-ctor-pat-names (result.scope) subs (i + 1) len depth (result.seen) (result.errors)\n\nSection: Resolve List Elements\n  resolve-list-elems : Scope, List AExpr, Integer, Integer, List Diagnostic -> List Diagnostic\n  resolve-list-elems (sc) (elems) (i) (len) (errs) =\n   if i == len then errs\n   else let errs2 = resolve-expr sc (list-at elems i)\n   in resolve-list-elems sc elems (i + 1) len (errs & errs2)\n\nSection: Resolve Record Fields\n  resolve-record-fields : Scope, List AFieldExpr, Integer, Integer, List Diagnostic -> List Diagnostic\n  resolve-record-fields (sc) (fields) (i) (len) (errs) =\n   if i == len then errs\n   else let f = list-at fields i\n   in let errs2 = resolve-expr sc (f.value)\n   in resolve-record-fields sc fields (i + 1) len (errs & errs2)\n\nSection: Resolve Act Statements\n  resolve-act-stmts : Scope, List AActStmt, Integer, Integer, SkipListText, List Diagnostic -> List Diagnostic\n  resolve-act-stmts (sc) (stmts) (i) (len) (seen) (errs) =\n   if i == len then errs\n   else let stmt = list-at stmts i\n   in when stmt\n     is AActExprStmt (e) (s) ->\n      when e\n       is ALetExpr (binds) (lbody) (ls) -> resolve-act-let sc binds lbody stmts i len seen errs\n       is otherwise ->\n        let errs2 = resolve-expr sc e\n        in resolve-act-stmts sc stmts (i + 1) len seen (errs & errs2)\n     is AActBindStmt (name) (e) (s) ->\n      let errs2 = resolve-expr sc e\n   in let dup-errs = if skip-list-text-has seen (name.value) then [make-error cdx-duplicate-definition (\"Duplicate binding: '\" & name.value & \"'\") s] else []\n   in let sc2 = scope-add-local sc (name.value)\n   in resolve-act-stmts sc2 stmts (i + 1) len (skip-list-text-insert seen (name.value)) (errs & errs2 & dup-errs)\n\n  resolve-act-let : Scope, List ALetBind, AExpr, List AActStmt, Integer, Integer, SkipListText, List Diagnostic -> List Diagnostic\n  resolve-act-let (sc) (binds) (body) (stmts) (i) (len) (seen) (errs) =\n   let bind-errs = resolve-let-binds sc binds 0 (list-length binds) skip-list-text-empty []\n   in when body\n    is ALetExpr (binds2) (body2) (ls2) -> resolve-act-let sc binds2 body2 stmts i len seen (errs & bind-errs)\n    is otherwise ->\n     let body-errs = resolve-expr sc body\n     in resolve-act-stmts sc stmts (i + 1) len seen (errs & bind-errs & body-errs)\n\nSection: Resolve All Definitions\n\n The ceiling is the SCOPE deck reservation's top, and this loop checks it\n because it is the phase's bulk deck writer -- not through its own records\n but through resolve-expr's pattern path, whose per-pattern-variable\n deck-record wraps the scope and seen skiplist inserts, so every insert\n node lands on the deck: measured 2026-07-21, 53.3 MB of the SCOPE deck's\n 56.3 is written under this walk, against 0.3 MB for scope-adefs-ll.\n Guarding only scope-adefs-ll left this walk free to grow through a\n starved reservation into the bivy that holds the scope's own skiplists,\n and the compile died in a divide error inside advance-while-less instead\n of raising CDX9002. A def's resolve writes kilobytes, so a per-definition\n check against an 8 MB band cannot be outrun. The stop returns the\n diagnostics collected so far; compile-desugar-and-scope reads\n deck-short-of again after the walk and raises CDX9002 from there.\n\n  resolve-all-defs : Scope, List ADef, Integer, Integer, List Diagnostic, SkipListText, List ChapterAssignment, List ACitesDecl, List Text, Text, List RenameEntry, Integer -> List Diagnostic\n  resolve-all-defs (sc) (defs) (i) (len) (errs) (colliding) (assignments) (citations) (slug-cache) (cur-slug) (cur-chapter-rn) (ceiling) =\n   if i == len then errs\n   else if deck-short-of ceiling demand-scope-guard-band then errs\n   else let def = list-at defs i\n   in let chapter-rn = if def.chapter-slug == cur-slug then cur-chapter-rn\n      else apply-cite-overrides (build-chapter-rename-map colliding assignments (def.chapter-slug)) citations colliding assignments slug-cache (def.chapter-slug) 0\n   in let fresh-scope = Scope { names = sc.names, locals = skip-list-text-empty, chapter-renames = chapter-rn }\n   in let param-result = add-def-params fresh-scope (def.params) 0 (list-length (def.params)) []\n   in let body-scope = add-forall-binders (param-result.scope) def\n   in let errs2 = resolve-expr body-scope (def.body)\n   in resolve-all-defs sc defs (i + 1) len (errs & param-result.errors & errs2) colliding assignments citations slug-cache (def.chapter-slug) chapter-rn ceiling\n\n  add-forall-binders : Scope, ADef -> Scope\n  add-forall-binders (sc) (def) =\n   if list-length (def.declared-type) == 0 then sc\n   else add-forall-binder-names sc (list-at (def.declared-type) 0)\n\n  add-forall-binder-names : Scope, ATypeExpr -> Scope\n  add-forall-binder-names (sc) (t) =\n   when t\n    is AForallType (v) (vt) (p) (s) -> add-forall-binder-names (scope-add-local sc (v.value)) p\n    is otherwise -> sc\n\n  add-def-params : Scope, List AParam, Integer, Integer, List Diagnostic -> ResolveScopeResult\n  add-def-params (sc) (params) (i) (len) (errs) =\n   if i == len then deck-record (ResolveScopeResult { scope = sc, errors = errs })\n   else let p = list-at params i\n   in let name = p.name.value\n   in if skip-list-text-has (sc.locals) name\n      then add-def-params sc params (i + 1) len (errs & [make-error cdx-duplicate-definition (\"Duplicate parameter: '\" & name & \"'\") (p.span)])\n      else add-def-params (scope-add-local sc name) params (i + 1) len errs\n\nSection: Resolve Chapter\n  resolve-chapter : AChapter, SkipListText, List ChapterAssignment, Integer -> ResolveResult\n  resolve-chapter (mod) (colliding) (assignments) (ceiling) =\n   resolve-chapter-with-citations mod [] colliding assignments ceiling\n\n  resolve-chapter-with-citations : AChapter, List ResolveResult, SkipListText, List ChapterAssignment, Integer -> ResolveResult\n  resolve-chapter-with-citations (mod) (imported) (colliding) (assignments) (ceiling) =\n   let top = collect-top-level-names (mod.defs) 0 (list-length (mod.defs)) skip-list-text-empty []\n   in let ctors = collect-ctor-names (mod.type-defs) 0 (list-length (mod.type-defs)) skip-list-text-empty skip-list-text-empty []\n   in let effect-ops = collect-effect-op-names (mod.effect-defs) (top.names) (ctors.ctor-names) 0 (list-length (mod.effect-defs)) skip-list-text-empty []\n   in let cited-names = collect-cited-names imported 0 (list-length imported) skip-list-text-empty\n   in let class-method-names = collect-class-method-names-nr (mod.class-defs) 0 (list-length (mod.class-defs)) skip-list-text-empty\n   in let dict-placeholder-names = collect-dict-placeholder-names-nr (mod.class-defs) (mod.instance-defs) 0 (list-length (mod.class-defs)) skip-list-text-empty\n   in let all-top = skip-list-text-union (skip-list-text-union (skip-list-text-union (skip-list-text-union (skip-list-text-clone (top.names)) (effect-ops.op-names)) cited-names) class-method-names) dict-placeholder-names\n   in let sc = build-all-names-scope all-top (ctors.ctor-names) builtin-names\n   in let slug-cache = for a in assignments -> cite-key (a.chapter-slug)\n   in let expr-errs = resolve-all-defs sc (mod.defs) 0 (list-length (mod.defs)) [] colliding assignments (mod.citations) slug-cache \"\" [] ceiling\n   in let ctor-list = deck-record (skip-list-text-to-list (ctors.ctor-names))\n   in deck-record (ResolveResult {\n     bag = deck-record (bag-from-list (top.errors & ctors.errors & effect-ops.errors & expr-errs)),\n     top-level-names = top.names,\n     type-names = ctors.type-names,\n     ctor-names = ctor-list\n    })\n\n  collect-cited-names : List ResolveResult, Integer, Integer, SkipListText -> SkipListText\n  collect-cited-names (results) (i) (len) (acc) =\n   if i == len then acc\n   else let r = list-at results i\n   in let acc2 = skip-list-text-union acc (r.top-level-names)\n   in let acc3 = skip-list-text-union acc2 (skip-list-text-from-list (r.ctor-names))\n   in collect-cited-names results (i + 1) len acc3\n\n  collect-class-method-names-nr : List AClassDef, Integer, Integer, SkipListText -> SkipListText\n  collect-class-method-names-nr (cds) (i) (len) (acc) =\n   if i == len then acc\n   else let cd = list-at cds i\n   in collect-class-method-names-nr cds (i + 1) len (add-class-method-names-nr (cd.methods) 0 (list-length (cd.methods)) acc)\n\n  add-class-method-names-nr : List AEffectOpDef, Integer, Integer, SkipListText -> SkipListText\n  add-class-method-names-nr (ops) (i) (len) (acc) =\n   if i == len then acc\n   else let op = list-at ops i\n   in add-class-method-names-nr ops (i + 1) len (skip-list-text-insert acc (op.name.value))\n\n  collect-dict-placeholder-names-nr : List AClassDef, List AInstanceDef, Integer, Integer, SkipListText -> SkipListText\n  collect-dict-placeholder-names-nr (cds) (ids) (i) (len) (acc) =\n   if i == len then acc\n   else let cd = list-at cds i\n   in let ic = count-instances-nr ids (cd.name.value) 0 (list-length ids) 0\n   in if ic > 1\n    then collect-dict-placeholder-names-nr cds ids (i + 1) len (skip-list-text-insert acc (\"__dict-of-\" & (cd.name.value)))\n    else collect-dict-placeholder-names-nr cds ids (i + 1) len acc\n\n  count-instances-nr : List AInstanceDef, Text, Integer, Integer, Integer -> Integer\n  count-instances-nr (ids) (cname) (i) (len) (acc) =\n   if i == len then acc\n   else let id = list-at ids i\n   in count-instances-nr ids cname (i + 1) len (if (id.class-name.value) == cname then acc + 1 else acc)\n\nPage 1\n\n"

Section: Show Lists
  show-texts : List Text, Integer, Integer, Text -> [Console] Nothing
  show-texts (xs) (i) (len) (label) = act
    if i >= len then print-line-uni "."
    else act
      print-line-uni (label & " " & list-at xs i)
      show-texts xs (i + 1) len label
    end
  end

  show-defs : List Def, Integer, Integer -> [Console] Nothing
  show-defs (ds) (i) (len) = act
    if i >= len then print-line-uni "."
    else act
      let d = list-at ds i
      in print-line-uni ("def " & token-text (d.name)
           & " params " & show (list-length (d.params))
           & " anns " & show (list-length (d.ann))
           & " L" & show ((d.name).line) & "C" & show ((d.name).column)
           & " slug " & d.chapter-slug)
      show-defs ds (i + 1) len
    end
  end

  show-adefs : List ADef, Integer, Integer -> [Console] Nothing
  show-adefs (ds) (i) (len) = act
    if i >= len then print-line-uni "."
    else act
      let d = list-at ds i
      in print-line-uni ("adef " & (d.name).value
           & " params " & show (list-length (d.params))
           & " dtype " & show (list-length (d.declared-type))
           & " L" & show (((d.span).start).line) & "C" & show (((d.span).start).column)
           & " slug " & d.chapter-slug)
      show-adefs ds (i + 1) len
    end
  end

Section: Driver
  opening : [Console] Nothing = act
    let toks = tokenize subject-text 1
    in let doc = parse-document (make-parse-state (toks.tokens) subject-text) 0
    in let dr = desugar-document subject-text doc (doc.chapter-title) 0
    in let ch0 = dr.dr-chapter
    in let ch = scope-achapter ch0 skip-list-text-empty [] 0
    in let rr = resolve-chapter ch skip-list-text-empty [] 0
    in act
      print-line-uni ("lex-tokens " & show (list-length (toks.tokens)))
      print-line-uni ("lex-errors " & show (list-length (toks.errors)))
      print-line-uni ("chapter |" & doc.chapter-title & "|")
      print-line-uni ("defs " & show (list-length (doc.defs)))
      show-defs (doc.defs) 0 (list-length (doc.defs))
      print-line-uni ("parse-errors " & show ((doc.parse-bag).error-count))
      print-line-uni "--- desugar ---"
      print-line-uni ("dr-sat " & show (dr.dr-sat))
      print-line-uni ("a-name |" & (ch.name).value & "|")
      print-line-uni ("a-chapter-title |" & ch.chapter-title & "|")
      print-line-uni ("a-prose-len " & show (text-length (ch.prose)))
      print-line-uni ("a-defs " & show (list-length (ch.defs)))
      show-adefs (ch.defs) 0 (list-length (ch.defs))
      print-line-uni ("a-type-defs " & show (list-length (ch.type-defs)))
      print-line-uni ("a-effect-defs " & show (list-length (ch.effect-defs)))
      print-line-uni ("a-class-defs " & show (list-length (ch.class-defs)))
      print-line-uni ("a-instance-defs " & show (list-length (ch.instance-defs)))
      print-line-uni ("a-citations " & show (list-length (ch.citations)))
      print-line-uni ("a-ground-effects " & show (list-length (ch.ground-effects)))
      print-line-uni ("a-prose-blocks " & show (list-length (ch.prose-blocks)))
      print-line-uni ("a-annotations " & show (list-length (ch.annotations)))
      print-line-uni ("a-sections " & show (list-length (ch.section-titles)))
      show-texts (ch.section-titles) 0 (list-length (ch.section-titles)) "a-section"
      print-line-uni ("a-rt-names " & show (list-length (ch.rt-names)))
      print-line-uni ("a-conversions " & show (list-length (ch.conversions)))
      print-line-uni "--- scope ---"
      print-line-uni ("resolve-errors " & show ((rr.bag).error-count))
      print-line-uni ("top-level-names " & show (skip-list-text-size (rr.top-level-names)))
      print-line-uni ("type-names " & show (skip-list-text-size (rr.type-names)))
      print-line-uni ("ctor-names " & show (list-length (rr.ctor-names)))
      show-texts (rr.ctor-names) 0 (list-length (rr.ctor-names)) "ctor"
      show-texts (skip-list-text-to-list (rr.top-level-names)) 0 (skip-list-text-size (rr.top-level-names)) "top"
      print-line-uni "---"
    end
  end
