Chapter: NameProbe

  scan-digits-end : Integer -> Integer
  scan-digits-end (n) =
   if n <= 0 then 0
   else scan-digits-end (n - 1) + 1

  scan-hex-digits-end : Integer -> Integer
  scan-hex-digits-end (n) =
   if n <= 0 then 0
   else scan-hex-digits-end (n - 1) + 2

  opening : [Console] Nothing = act
   print-line-uni (show (scan-digits-end 3 + scan-hex-digits-end 3))
  end
