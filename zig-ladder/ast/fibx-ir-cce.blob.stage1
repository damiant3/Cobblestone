   in EmitResult {
   state = st-append-code (rd.state) (li reg-rdi try-fail-flag-addr & li reg-rsi 1 & mov-store reg-rdi reg-rsi 0 & li (rd.reg) 0),
   reg = rd.reg
  }

  emit-heap-advance-builtin : CodegenState, List IRExpr -> EmitResult
  emit-heap-advance-builtin (st) (args) =
