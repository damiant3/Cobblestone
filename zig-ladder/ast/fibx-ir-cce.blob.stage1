  emit-print-line-raw-builtin : CodegenState, List IRExpr -> EmitResult
  emit-print-line-raw-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = emit-print-text-raw (r.state) (r.reg)
   in let rd = alloc-temp st1
   in EmitResult {
   state = st-append-code (rd.state) (li (rd.reg) 0),
   reg = rd.reg
  }

 print-text is print-line minus the terminator: the same raw CCE byte
 loop with NO trailing linefeed. It exists for wire emitters whose
 payload newlines are CCE bytes inside the Text -- a payload built in
 pieces cannot delegate any newline to print-line, whose terminator is
 the raw serial byte 10 and not the CCE newline, and whose extra byte
 lands inside any SIZE-framed payload region (measured 2026-07-28
 against the IR wire; the account is in red-workplan's outbox).

  emit-print-text-builtin : CodegenState, List IRExpr -> EmitResult
  emit-print-text-builtin (st) (args) =
    let r = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let st1 = emit-print-text-raw-no-newline (r.state) (r.reg)
   in let rd = alloc-temp st1
   in EmitResult {
   state = st-append-code (rd.state) (li (rd.reg) 0),
   reg = rd.reg
  }

