   let val = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (val.state)
   in EmitResult {
    state = st-append-code (rd.state) (movq-to-xmm 0 (val.reg) & cvttsd2si (rd.reg) 0),
    reg = rd.reg
   }

  emit-real-approx-from-int-builtin : CodegenState, List IRExpr -> EmitResult
  emit-real-approx-from-int-builtin (st) (args) =
   let val = emit-expr (st-set-tail-pos st False) (list-at args 0)
   in let rd = alloc-temp (val.state)
   in EmitResult {
    state = st-append-code (rd.state) (cvtsi2sd 0 (val.reg) & xorps-xmm 1 1 & cvtsd2ss-xmm 1 0 & movq-from-xmm (rd.reg) 1),
    reg = rd.reg
   }

