   in let st4 = st-append-code st3 (mov-rr reg-r14 reg-rsi)

   in let st5 = st-append-code st4 (mov-rr reg-r15 reg-r10)

   in let st11 = st-append-code st5 (li reg-rax uefi-systab-addr)

   in let st12 = 