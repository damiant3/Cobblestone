  proc-saved-rflags-offset : Integer = 168
  proc-saved-rax-offset : Integer = 176
  proc-saved-rcx-offset : Integer = 184
  proc-saved-rdx-offset : Integer = 192
  proc-saved-rsi-offset : Integer = 200
  proc-saved-rdi-offset : Integer = 208
  proc-saved-r8-offset : Integer = 216
  proc-saved-r9-offset : Integer = 224
  proc-saved-r11-offset : Integer = 232
  proc-max-ticks-offset : Integer = 240
  proc-blocked-on-offset : Integer = 248
  proc-state-free : Integer = 0
  proc-state-ready : Integer = 1
  proc-state-running : Integer = 2
  proc-state-blocked : Integer = 3
  proc-state-zombie : Integer = 4
  blocked-on-chan-send : Integer = 256
  blocked-on-chan-recv : Integer = 512
  proc-priority-kernel : Integer = 0
  proc-priority-system : Integer = 1
  proc-priority-normal : Integer = 2
