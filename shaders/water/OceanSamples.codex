Chapter: OceanSamples
  cites Water chapter OceanModel

Section: Driver

  fmt-geo : Real, Real -> Text
  fmt-geo (x) (z) =
    let s = eval-surface ocean-waves x z ocean-time
    in "  pos=(" & show s.px & ", " & show s.py & ", " & show s.pz & ")  n=(" & show s.nx & ", " & show s.ny & ", " & show s.nz & ")  foam=" & show s.foam

  fmt-shade : Real, Real -> Text
  fmt-shade (x) (z) =
    let s = eval-surface ocean-waves x z ocean-time
    in let c = shade-point s ocean-eye ocean-sun
    in "  rgb=(" & show c.x & ", " & show c.y & ", " & show c.z & ")"

  opening : [Console] Nothing
  opening = act
    print-line-uni "Ocean surface model  (sum-of-sines Gerstner, GGX, SSS, Jacobian foam)"
    print-line-uni ("time = " & show ocean-time)
    print-line-uni "sample (0, 0):"
    print-line-uni (fmt-geo 0.0 0.0)
    print-line-uni (fmt-shade 0.0 0.0)
    print-line-uni "sample (10, 0):"
    print-line-uni (fmt-geo 10.0 0.0)
    print-line-uni (fmt-shade 10.0 0.0)
    print-line-uni "sample (5, 5):"
    print-line-uni (fmt-geo 5.0 5.0)
    print-line-uni (fmt-shade 5.0 5.0)
    print-line-uni "sample (20, -8):"
    print-line-uni (fmt-geo 20.0 (0.0 - 8.0))
    print-line-uni (fmt-shade 20.0 (0.0 - 8.0))
  end
