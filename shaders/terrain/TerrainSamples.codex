Chapter: TerrainSamples
  cites Terrain chapter TerrainModel
  cites Clouds chapter CloudModel
  cites Water chapter OceanModel
  cites Foreword chapter Console

Section: Report

  say-height : Text, Real, Real -> Text
  say-height (label) (x) (z) =
    let h = t-height x z
    in let n = t-normal x z
    in label & " h = " & show h & "  n = " & show (n.x) & " " & show (n.y) & " " & show (n.z)

  say-weights : Text, V3 -> Text
  say-weights (label) (n) =
    let w = t-tri-weights (v-norm n)
    in let s = w.x + w.y + w.z
    in label & " w = " & show (w.x) & " " & show (w.y) & " " & show (w.z) & "  sum = " & show s

  say-shade : Text, Real, Real -> Text
  say-shade (label) (x) (z) =
    let h = t-height x z
    in let n = t-normal x z
    in let p = V3 { x = x, y = h, z = z }
    in let c = t-shade p n
    in label & " rgb = " & show (c.x) & " " & show (c.y) & " " & show (c.z)

  say-blend : Text, Real, Real, Real -> Text
  say-blend (label) (wa) (ha) (hb) =
    let a = Mat { col = V3 { x = 1.0, y = 0.0, z = 0.0 }, hgt = ha }
    in let b = Mat { col = V3 { x = 0.0, y = 0.0, z = 1.0 }, hgt = hb }
    in let c = t-height-blend a wa b (1.0 - wa)
    in label & " wa=" & show wa & " ha=" & show ha & " hb=" & show hb & " -> r=" & show (c.x) & " b=" & show (c.z)

  opening : [Console] Nothing
  opening = act
    print-line-uni (say-height "valley  " 0.0 0.0)
    print-line-uni (say-height "ridge   " 620.0 340.0)
    print-line-uni (say-height "slope   " 1180.0 900.0)
    print-line-uni (say-weights "flat    " (V3 { x = 0.0, y = 1.0, z = 0.0 }))
    print-line-uni (say-weights "wall-x  " (V3 { x = 1.0, y = 0.0, z = 0.0 }))
    print-line-uni (say-weights "wall-z  " (V3 { x = 0.0, y = 0.0, z = 1.0 }))
    print-line-uni (say-weights "diagonal" (V3 { x = 1.0, y = 1.0, z = 0.0 }))
    print-line-uni (say-blend "near " 0.40 0.55 0.45)
    print-line-uni (say-blend "near " 0.50 0.55 0.45)
    print-line-uni (say-blend "near " 0.60 0.55 0.45)
    print-line-uni (say-blend "far  " 0.50 0.80 0.20)
    print-line-uni (say-blend "far  " 0.50 0.20 0.80)
    print-line-uni (say-shade "valley  " 0.0 0.0)
    print-line-uni (say-shade "ridge   " 620.0 340.0)
    print-line-uni (say-shade "slope   " 1180.0 900.0)
  end
