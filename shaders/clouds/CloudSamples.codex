Chapter: CloudSamples
  cites Clouds chapter CloudModel
  cites Water chapter OceanModel
  cites Foreword chapter Console

 Marches a few rays through the cloud model and prints what came back.
 This is the model running, not a picture of it.

 The first block checks the kernel piece the ocean did not need, because
 everything downstream is an exponential and a wrong one would be
 invisible in an image.

Section: Report

  say-exp : Text, Real -> Text
  say-exp (label) (x) = label & " exp = " & show (c-exp x)

  say-ray : Text, V3, V3 -> Text
  say-ray (label) (origin) (dir) =
    let m = c-trace origin (v-norm dir)
    in label & " rgb = " & show m.r & " " & show m.g & " " & show m.b
      & "  alpha = " & show (1.0 - m.trans)

  say-density : Text, V3 -> Text
  say-density (label) (p) = label & " density = " & show (c-density p)

  opening : [Console] Nothing
  opening = act
    print-line-uni (say-exp "exp(0)   " 0.0)
    print-line-uni (say-exp "exp(1)   " 1.0)
    print-line-uni (say-exp "exp(-1)  " (0.0 - 1.0))
    print-line-uni (say-exp "exp(-10) " (0.0 - 10.0))
    print-line-uni (say-exp "exp(5)   " 5.0)
    print-line-uni (say-density "below slab " (V3 { x = 0.0, y = 500.0, z = 0.0 }))
    print-line-uni (say-density "above slab " (V3 { x = 2800.0, y = 5000.0, z = 4400.0 }))
    print-line-uni (say-density "in a gap   " (V3 { x = 700.0, y = 2600.0, z = 1100.0 }))
    print-line-uni (say-density "in a cloud " (V3 { x = 2800.0, y = 2600.0, z = 4400.0 }))
    print-line-uni (say-density "same, base " (V3 { x = 2800.0, y = 1800.0, z = 4400.0 }))
    print-line-uni (say-density "same, top  " (V3 { x = 2800.0, y = 3900.0, z = 4400.0 }))
    print-line-uni (say-ray "up      " (V3 { x = 0.0, y = 0.0, z = 0.0 }) (V3 { x = 0.0, y = 1.0, z = 0.0 }))
    print-line-uni (say-ray "sunward " (V3 { x = 0.0, y = 0.0, z = 0.0 }) (V3 { x = 0.6, y = 0.5, z = 0.62449979983984 }))
    print-line-uni (say-ray "shallow " (V3 { x = 0.0, y = 0.0, z = 0.0 }) (V3 { x = 0.0, y = 0.16, z = 1.0 }))
    print-line-uni (say-ray "down    " (V3 { x = 0.0, y = 0.0, z = 0.0 }) (V3 { x = 0.0, y = 0.0 - 1.0, z = 0.0 }))
  end
