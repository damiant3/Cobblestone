 First-boot experience. When Codex boots for the first time on a
 new machine (no identity keypair on disk), FirstBoot runs the
 first-boot wizard: generate identity, choose or acquire an agent,
 configure upstream, and enter the dev console or UI.

 The sequence is: detect first boot, generate Ed25519 keypair,
 show welcome screen, agent selection, upstream config, mode
 selection, save config, enter chosen mode.

 We say:

Section: First Boot State

  FirstBootPhase =
    | PhaseWelcome
    | PhaseIdentity
    | PhaseAgentSelect
    | PhaseAgentSetup
    | PhaseUpstream
    | PhaseModeSelect
    | PhaseSaveConfig
    | PhaseComplete

  FirstBootState = record {
    phase : FirstBootPhase,
    identity : Maybe Keypair,
    agent-package : Maybe AgentPackage,
    agent-runtime : AgentRuntimeState,
    upstream : UpstreamConfig,
    selected-mode : BootMode,
    config-saved : Boolean,
    status : Text
  }

  BootMode =
    | BootDevConsole
    | BootUi
    | BootSerialRepl

  boot-mode-label : BootMode -> Text
  boot-mode-label (m) = when m
    is BootDevConsole -> "Dev Console (UEFI text)"
    is BootUi -> "Graphical UI (GOP framebuffer)"
    is BootSerialRepl -> "Serial REPL (headless)"

Section: Initialization

  first-boot-init : FirstBootState
  first-boot-init = FirstBootState {
    phase = PhaseWelcome,
    identity = None,
    agent-package = None,
    agent-runtime = runtime-init,
    upstream = default-upstream,
    selected-mode = BootDevConsole,
    config-saved = False,
    status = ""
  }

  is-first-boot : Text -> Boolean
  is-first-boot (config-path) = file-exists config-path == False

Section: Welcome Screen

  welcome-lines : List Text
  welcome-lines = [
    "",
    "  ================================================================",
    "                      Welcome to Codex",
    "  ================================================================",
    "",
    "  A self-sustaining operating system, compiler, and development",
    "  environment. Everything on this device was compiled by itself.",
    "",
    "  This is first boot. We will:",
    "    1. Generate your identity (Ed25519 keypair)",
    "    2. Set up an AI agent (optional)",
    "    3. Choose your preferred interface",
    "",
    "  Press Enter to begin.",
    ""
  ]

Section: Identity Generation

  generate-boot-identity : List Integer -> Keypair
  generate-boot-identity (hardware-random) =
    generate-keypair hardware-random

  format-identity-created : Keypair -> List Text
  format-identity-created (kp) = [
    "",
    "  Identity created.",
    "  Fingerprint: " & kp.fingerprint,
    "  This key signs everything you create on this device.",
    ""
  ]

Section: Identity Persistence

 H4: save the freshly-generated identity to a filesystem path
 (the USB stick Damian named, an encrypted file, a hardware-token
 mount). On subsequent boots, try to import-from-path before
 generating a new identity.

  identity-key-default-path : Text = "/keys/identity.cdxkey"

  save-identity : Keypair, Text -> Nothing
  save-identity (kp) (path) = export-to-path kp path

  try-load-identity : Text -> Maybe Keypair
  try-load-identity (path) = import-from-path path

  format-identity-saved : Keypair, Text -> List Text
  format-identity-saved (kp) (path) = [
    "",
    "  Identity saved.",
    "  Fingerprint: " & kp.fingerprint,
    "  Path:        " & path,
    "  Keep this file safe. It is the only copy of your private key.",
    ""
  ]

  format-identity-loaded : Keypair, Text -> List Text
  format-identity-loaded (kp) (path) = [
    "",
    "  Welcome back.",
    "  Identity loaded from " & path,
    "  Fingerprint: " & kp.fingerprint,
    ""
  ]

  format-identity-not-found : Text -> List Text
  format-identity-not-found (path) = [
    "",
    "  No identity at " & path,
    "  A fresh keypair will be generated.",
    ""
  ]

Section: Agent Selection

  agent-select-lines : BundledAgentResult -> List Text
  agent-select-lines (bundled) = [
    "",
    "  AI Agent Setup",
    "  ==============",
    "",
    "  An agent helps you write code, navigate the codebase,",
    "  run builds, and debug problems. It runs locally on this",
    "  device. For harder problems it can escalate to a larger",
    "  model on a remote server.",
    "",
    "  Available agents:"
  ] & when bundled
    is BundledFound (path) -> ["    [B] Bundled agent at " & path]
    is BundledNone -> ["    (no bundled agent on this image)"]
  & [
    "    [L] Load from USB drive or disk path",
    "    [D] Download from network",
    "    [S] Skip (no agent)",
    ""
  ]

Section: Upstream Configuration

  upstream-config-lines : List Text
  upstream-config-lines = [
    "",
    "  Upstream Server (optional)",
    "  ==========================",
    "",
    "  For complex tasks, the local agent can escalate to a",
    "  full-size model on a remote server. Enter the server",
    "  address or press Enter to skip.",
    ""
  ]

Section: Mode Selection

  mode-select-menu : MenuState
  mode-select-menu = menu-new "Choose Interface" [
    menu-item "Dev Console (text menus, code browser, compiler)" "dev",
    menu-item "Graphical UI (framebuffer, widgets, mouse)" "ui",
    menu-item "Serial REPL (headless, for automation)" "serial"
  ]

Section: Configuration Persistence

  BootConfig = record {
    identity-fingerprint : Text,
    agent-name : Text,
    agent-model-path : Text,
    upstream-host : Text,
    upstream-port : Integer,
    boot-mode : BootMode
  }

  format-boot-config : BootConfig -> Text
  format-boot-config (cfg) =
    "identity=" & cfg.identity-fingerprint & "\n"
    & "agent=" & cfg.agent-name & "\n"
    & "model=" & cfg.agent-model-path & "\n"
    & "upstream=" & cfg.upstream-host & ":" & show (cfg.upstream-port) & "\n"
    & "mode=" & boot-mode-label (cfg.boot-mode)

  save-boot-config : BootConfig, Text -> Nothing
  save-boot-config (cfg) (path) =
    write-file path (format-boot-config cfg)

Section: Subsequent Boots

  load-boot-config : Text -> Maybe BootConfig
  load-boot-config (path) =
    if file-exists path then Just (BootConfig {
      identity-fingerprint = "",
      agent-name = "",
      agent-model-path = "",
      upstream-host = "",
      upstream-port = 443,
      boot-mode = BootDevConsole
    })
    else None

