 UEFI dev console. Hold a key during boot to enter. Menu-driven
 interface with code browser, editor, compiler, test runner,
 debugger, agent manager, hypervisor, and UI launcher. Runs on
 UEFI console I/O (ConOut/ConIn).

 We say:

Section: Console Mode

  ConsoleMode =
    | ModeMainMenu
    | ModeBrowse
    | ModeViewSource
    | ModeSearch
    | ModeEdit
    | ModeCompile
    | ModeSweep
    | ModeDebug
    | ModeVerify
    | ModeAnnotations
    | ModeAgent
    | ModeHypervisor
    | ModeUiLaunch

Section: Console State

  DevConsoleState = record {
    mode : ConsoleMode,
    source-index : SourceIndex,
    console : UefiConsoleState,
    menu : MenuState,
    search-query : Text,
    search-results : List SearchResult,
    editor : Maybe EditorState,
    view-scroll : Integer,
    view-chapter-idx : Integer,
    status : Text,
    running : Boolean
  }

  dev-console-init : UefiConsoleState -> DevConsoleState
  dev-console-init (con) =
    DevConsoleState {
      mode = ModeMainMenu,
      source-index = empty-source-index,
      console = con,
      menu = main-menu,
      search-query = "",
      search-results = [],
      editor = None,
      view-scroll = 0,
      view-chapter-idx = 0,
      status = "Codex Dev Console",
      running = True
    }

Section: Main Menu

  main-menu : MenuState
  main-menu = menu-new "Codex Dev Console" [
    menu-item "Browse Source" "browse",
    menu-item "Search Definitions" "search",
    menu-item "Edit File" "edit",
    menu-item "Compile" "compile",
    menu-item "Run Tests" "sweep",
    menu-item "Debugger" "debug",
    menu-item "Verify Seed" "verify",
    menu-item "Annotations" "annotations",
    menu-item "Agent Manager" "agent",
    menu-item "Launch VM" "vm",
    menu-item "Launch UI" "ui",
    menu-item "System Info" "info",
    menu-item "Boot Codex" "boot"
  ]

  browse-menu : List Text -> MenuState
  browse-menu (chapters) =
    menu-new "Source Chapters" (build-chapter-menu-items chapters 0 (list-length chapters) [])

  build-chapter-menu-items : List Text, Integer, Integer, List MenuItem -> List MenuItem
  build-chapter-menu-items (chapters) (i) (len) (acc) =
    if i >= len then acc
    else let name = list-at chapters i
    in build-chapter-menu-items chapters (i + 1) len (list-push acc (menu-item name name))

  compile-menu : MenuState
  compile-menu = menu-new "Compile" [
    menu-item "Compile File (CDX)" "cdx",
    menu-item "Compile File (ELF)" "elf",
    menu-item "Compile File (EFI)" "efi",
    menu-item "Build Disk Image (IMG)" "img",
    menu-item "Self-Compile (Pingpong)" "pingpong",
    menu-item "Back" "back"
  ]

  sweep-menu : MenuState
  sweep-menu = menu-new "Test Runner" [
    menu-item "Run All Samples" "all",
    menu-item "Run Single Sample" "single",
    menu-item "Run Failing Only" "failing",
    menu-item "Show Last Results" "results",
    menu-item "Back" "back"
  ]

Section: Menu Dispatch

  dispatch-main-menu : Text, DevConsoleState -> DevConsoleState
  dispatch-main-menu (key) (state) =
    if key == "browse" then
      let bm = browse-menu (state.source-index.chapter-names)
      in __record-set (__record-set (__record-set state "mode" ModeBrowse) "menu" bm) "status" ("Source: " & show (list-length (state.source-index.chapter-names)) & " chapters")
    else if key == "search" then __record-set (__record-set state "mode" ModeSearch) "status" "Enter search query:"
    else if key == "edit" then __record-set (__record-set state "mode" ModeEdit) "status" "Enter file path:"
    else if key == "compile" then __record-set (__record-set (__record-set state "mode" ModeCompile) "menu" compile-menu) "status" "Select compile target"
    else if key == "sweep" then __record-set (__record-set (__record-set state "mode" ModeSweep) "menu" sweep-menu) "status" "Test runner"
    else if key == "verify" then __record-set (__record-set state "mode" ModeVerify) "status" "Verifying seed..."
    else if key == "debug" then __record-set (__record-set (__record-set state "mode" ModeDebug) "menu" debug-menu) "status" "Debugger"
    else if key == "annotations" then __record-set (__record-set state "mode" ModeAnnotations) "status" "Annotations"
    else if key == "agent" then __record-set (__record-set (__record-set state "mode" ModeAgent) "menu" agent-menu) "status" "Agent Manager"
    else if key == "vm" then __record-set (__record-set (__record-set state "mode" ModeHypervisor) "menu" hypervisor-menu) "status" "Hypervisor"
    else if key == "ui" then __record-set (__record-set (__record-set state "mode" ModeUiLaunch) "menu" ui-launcher-menu) "status" "UI Launcher"
    else if key == "boot" then __record-set state "running" False
    else state

Section: Search Interface

  dev-console-search : DevConsoleState, Text -> DevConsoleState
  dev-console-search (state) (query) =
    let prefix-results = search-by-prefix (state.source-index) query
    in let sub-results = if list-length prefix-results > 0 then prefix-results
      else search-by-substring (state.source-index) query
    in let result-count = list-length sub-results
    in __record-set (__record-set (__record-set state "search-query" query) "search-results" sub-results) "status" (show result-count & " results for '" & query & "'")

Section: Rendering

  render-dev-console : DevConsoleState -> List Text
  render-dev-console (state) =
    let header = ["", "  Codex Dev Console", "  " & state.status, ""]
    in when state.mode
      is ModeMainMenu -> header & render-menu (state.menu)
      is ModeBrowse -> header & render-menu (state.menu)
      is ModeViewSource -> header & ["  (source viewer — see draw-console-screen)"]
      is ModeSearch ->
        let result-lines = format-search-result-lines (state.search-results) 0 (list-length (state.search-results)) []
        in header & ["  Search: " & state.search-query, ""] & result-lines
      is ModeCompile -> header & render-menu (state.menu)
      is ModeSweep -> header & render-menu (state.menu)
      is ModeDebug -> header & render-menu (state.menu)
      is ModeAgent -> header & render-menu (state.menu)
      is ModeHypervisor -> header & render-menu (state.menu)
      is ModeUiLaunch -> header & render-menu (state.menu)
      is ModeEdit -> header & render-editor-view state
      is ModeVerify -> header & ["  Verify Seed Integrity", ""] & render-menu (state.menu)
      is ModeAnnotations -> header & ["  Annotations", ""] & render-menu (state.menu)

  render-editor-view : DevConsoleState -> List Text
  render-editor-view (state) =
    when state.editor
      is Just (e) -> ["  Editing: " & e.file-path, "  " & editor-status-line e, ""] & editor-visible-lines e
      is None -> ["  No file open. Select a chapter to edit."]

  format-search-result-lines : List SearchResult, Integer, Integer, List Text -> List Text
  format-search-result-lines (rs) (i) (len) (acc) =
    if i >= len then acc
    else let r = list-at rs i
    in format-search-result-lines rs (i + 1) len (list-push acc ("  " & format-search-result r))

